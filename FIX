REC - Synthese - Validate Filters And Export




import static com.kms.katalon.core.testcase.TestCaseFactory.findTestCase

import java.io.File

import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI

import internal.GlobalVariable


// ======================================================
// MODULE CONFIG
// ======================================================

String targetEnvironment = 'REC'

String menuName = 'synthèse Justification Latent'
String menuResultName = 'synthèse Justification Latent'

String sectionFilterValue = '2LL'

String exportLabel = 'Synthese_Justification_Latent'

String loginTestCase =
	'Component/Authentication/Login ' +
	targetEnvironment

String closeApplicationTestCase =
	'Component/Authentication/Close Application'


// ======================================================
// RECHERCHE CONFIG
// ======================================================

String rechercheImageGroup = 'General'

String rechercheObjectGroup =
	'syntheseJustificationLatent'

String rechercheTabImageKey =
	'rechercheTab'

String rechercheTabObjectKey =
	'rechercheTab'

String rechercheInputObjectKey =
	'dateFilterInput'

String rechercheButtonObjectKey =
	'rechercherButton'


// ======================================================
// TIMEOUT CONFIG
// ======================================================

Integer menuTimeout = 20
Integer screenLoadTimeout = 90
Integer filterTimeout = 60
Integer rechercheTimeout = 60


// ======================================================
// AUTHENTICATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Authenticate and open application\n' +
	'Environment: ' +
	targetEnvironment
)

WebUI.callTestCase(
	findTestCase(loginTestCase),
	[:],
	FailureHandling.STOP_ON_FAILURE
)


// ======================================================
// OPEN SYNTHÈSE JUSTIFICATION LATENT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Open Synthèse Justification Latent screen\n' +
	'Search: ' +
	menuName +
	'\nResult: ' +
	menuResultName
)

CustomKeywords.'component.MenuNavigator.searchAndOpenMenuByText'(
	menuName,
	menuResultName,
	menuTimeout
)


// ======================================================
// VALIDATE SYNTHÈSE TAB
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Validate Synthèse Justification Latent tab\n' +
	'Environment: ' +
	targetEnvironment
)

CustomKeywords.
'pageObject.JustificationDesComptesDeLatentKeywords.validateSyntheseTabOpened'(
	screenLoadTimeout
)


// ======================================================
// APPLY SECTION FILTER
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Apply Synthèse Section filter\n' +
	'Value: ' +
	sectionFilterValue
)

CustomKeywords.
'pageObject.JustificationDesComptesDeLatentKeywords.applySyntheseSectionFilter'(
	sectionFilterValue,
	filterTimeout
)


// ======================================================
// RESOLVE CLOSING DATE
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Resolve closing date for Recherche filter'
)

if (GlobalVariable.arreteDate == null ||
	GlobalVariable.arreteDate
		.toString()
		.trim()
		.isEmpty()) {

	GlobalVariable.arreteDate =
		CustomKeywords.
		'general.MenuHandling.getArreteDateWithSlash'()
}

String closingDate =
	GlobalVariable.arreteDate
		.toString()
		.replace('/', '')

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Closing date resolved successfully\n' +
	'Value used in Recherche: ' +
	closingDate
)


// ======================================================
// OPEN RECHERCHE AND APPLY DATE FILTER
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Open Recherche tab and apply date filter\n' +
	'Closing date: ' +
	closingDate
)

Map rechercheResult =
	CustomKeywords.
	'component.RechercheKeywords.applyRechercheTextFilter'(
		rechercheImageGroup,
		rechercheObjectGroup,
		rechercheTabImageKey,
		rechercheTabObjectKey,
		rechercheInputObjectKey,
		rechercheButtonObjectKey,
		closingDate,
		rechercheTimeout
	)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Recherche filter applied successfully\n' +
	'Value: ' +
	rechercheResult.value
)


// ======================================================
// EXPORT SYNTHÈSE FILE
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Export Synthèse file\n' +
	'Environment: ' +
	targetEnvironment +
	'\nExport label: ' +
	exportLabel
)

CustomKeywords.'commands.ExportFile.exportFromTwoExportImagesToNo'(
	exportLabel,
	targetEnvironment
)

Map exportValidation =
	CustomKeywords.
	'commands.ExportFileValidationKeywords.validateExportedFileExistsAndHasRows'(
		targetEnvironment,
		exportLabel
	)

String exportPath =
	new File(
		exportValidation.folderPath.toString(),
		exportValidation.fileName.toString()
	).absolutePath

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Synthèse export validation passed\n' +
	'Environment: ' +
	targetEnvironment +
	'\nFile: ' +
	exportValidation.fileName +
	'\nPath: ' +
	exportPath +
	'\nData rows: ' +
	exportValidation.dataRows +
	'\nFile size: ' +
	exportValidation.fileSize +
	' bytes'
)


// ======================================================
// CLOSE APPLICATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Close application\n' +
	'Environment: ' +
	targetEnvironment
)

WebUI.callTestCase(
	findTestCase(closeApplicationTestCase),
	[:],
	FailureHandling.STOP_ON_FAILURE
)

KeywordUtil.markPassed(
	targetEnvironment +
	' Synthèse filters and export completed successfully.'
)























REC x PRD - Synthese - Validate Exports And Amounts
import java.io.File

