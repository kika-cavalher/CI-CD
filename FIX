    private String buildJavascript(String initialScenarioId) {
        StringBuilder js = new StringBuilder()

        js.append("function switchTab(tabName) {\n")
        js.append("  var testsBtn = document.getElementById('tabBtnTests');\n")
        js.append("  var chartsBtn = document.getElementById('tabBtnCharts');\n")
        js.append("  var testsSidebar = document.getElementById('testsSidebarPanel');\n")
        js.append("  var chartsSidebar = document.getElementById('chartsSidebarPanel');\n")
        js.append("  var testsMain = document.getElementById('testsMainPanel');\n")
        js.append("  var chartsMain = document.getElementById('chartsMainPanel');\n")
        js.append("  if (tabName === 'charts') {\n")
        js.append("    testsBtn.classList.remove('active');\n")
        js.append("    chartsBtn.classList.add('active');\n")
        js.append("    testsSidebar.classList.add('hidden');\n")
        js.append("    chartsSidebar.classList.remove('hidden');\n")
        js.append("    testsMain.classList.add('hidden');\n")
        js.append("    chartsMain.classList.remove('hidden');\n")
        js.append("  } else {\n")
        js.append("    chartsBtn.classList.remove('active');\n")
        js.append("    testsBtn.classList.add('active');\n")
        js.append("    chartsSidebar.classList.add('hidden');\n")
        js.append("    testsSidebar.classList.remove('hidden');\n")
        js.append("    chartsMain.classList.add('hidden');\n")
        js.append("    testsMain.classList.remove('hidden');\n")
        js.append("  }\n")
        js.append("}\n")

        js.append("function showScenario(scenarioId) {\n")
        js.append("  document.querySelectorAll('[data-scenario-panel]').forEach(function(panel) {\n")
        js.append("    panel.classList.remove('active');\n")
        js.append("    if (panel.getAttribute('data-scenario-panel') === scenarioId) {\n")
        js.append("      panel.classList.add('active');\n")
        js.append("    }\n")
        js.append("  });\n")
        js.append("  document.querySelectorAll('.scenario-item').forEach(function(item) {\n")
        js.append("    item.classList.remove('active');\n")
