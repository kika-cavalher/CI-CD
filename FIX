package commands

import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import com.katalon.ematch.helper.EmatchHelper
import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import internal.GlobalVariable

class ExportFile {

	@Keyword
	String downloadFromOutilsAndRegister(Integer intervalSeconds, Integer maxTimes, String exportLabel) {
		String currentEnvironment = getCurrentEnvironment()
		ArrayList compareFiles = getCompareFiles()

		Integer beforeDownloadSize = compareFiles.size()

		String downloadedFile = new EmatchHelper().downloadFileFromOutils(
			intervalSeconds,
			maxTimes
		)

		validateDownloadedFileName(downloadedFile, exportLabel)

		compareFiles.add(downloadedFile)

		validateDownloadWasRegistered(
			beforeDownloadSize,
			compareFiles.size(),
			downloadedFile,
			exportLabel,
			currentEnvironment
		)

		validateDownloadedFileExists(downloadedFile, exportLabel)

		return downloadedFile
	}

	@Keyword
	String getCurrentEnvironment() {
		try {
			String environmentText = Windows.getText(findWindowsObject('Object Repository/General/curEnv'))

			if (environmentText.equalsIgnoreCase('Recette')) {
				return 'Rec'
			}

			return 'PROD'
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop(
				'Could not identify current environment from Object Repository/General/curEnv. Reason: ' + e.getMessage()
			)
		}

		return null
	}

	@Keyword
	String getImageGroupByCurrentEnvironment(String imageGroupPrefix) {
		return imageGroupPrefix + '_' + getCurrentEnvironment()
	}

	@Keyword
	void validateDownloadedFileExists(String fileName, String exportLabel) {
		String filePath = getEvidenceFilePath(fileName)
		File exportedFile = new File(filePath)

		if (!exportedFile.exists()) {
			KeywordUtil.markFailedAndStop(
				exportLabel + ' file was registered but does not exist in Evidences folder.\n' +
				'Expected file: ' + filePath
			)
		}

		if (exportedFile.length() <= 0) {
			KeywordUtil.markFailedAndStop(
				exportLabel + ' file exists but is empty.\n' +
				'File: ' + filePath
			)
		}

		KeywordUtil.logInfo(exportLabel + ' file exists and is not empty: ' + filePath)
	}

	private ArrayList getCompareFiles() {
		ArrayList compareFiles = GlobalVariable.compareFiles as ArrayList

		if (compareFiles == null) {
			compareFiles = []
			GlobalVariable.compareFiles = compareFiles
		}

		return compareFiles
	}

	private void validateDownloadedFileName(String downloadedFile, String exportLabel) {
		if (downloadedFile == null || downloadedFile.trim().isEmpty()) {
			KeywordUtil.markFailedAndStop(
				exportLabel + ' file was not downloaded correctly. Downloaded file name is empty.'
			)
		}
	}

	private void validateDownloadWasRegistered(
		Integer beforeDownloadSize,
		Integer afterDownloadSize,
		String downloadedFile,
		String exportLabel,
		String currentEnvironment
	) {
		if (afterDownloadSize <= beforeDownloadSize) {
			KeywordUtil.markFailedAndStop(
				exportLabel + ' file was not registered correctly.\n' +
				'Environment: ' + currentEnvironment + '\n' +
				'Downloaded file: ' + downloadedFile
			)
		}

		KeywordUtil.markPassed(
			exportLabel + ' file downloaded and registered correctly: ' + downloadedFile
		)
	}

	private String getEvidenceFilePath(String fileName) {
		String evidenceDir = RunConfiguration.getReportFolder() + '\\Evidences\\'

		if (fileName.toLowerCase().endsWith('.xlsx') || fileName.toLowerCase().endsWith('.csv')) {
			return evidenceDir + fileName
		}

		return evidenceDir + fileName + '.xlsx'
	}
}
