import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.driver.DriverFactory
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI

import internal.GlobalVariable

class ValidationKeyword {

	// ========================================================================
	// Method to verify the page title of a section
	// ========================================================================
	@Keyword
	void verifyPageTitle(String title) {
		TestObject pageTitle = findTestObject('Object Repository/Common/Common PageTitle', [('title') : title])

		try {
			boolean isPresent = WebUI.verifyElementPresent(pageTitle, 100, FailureHandling.OPTIONAL)

			if (!isPresent) {
				KeywordUtil.markFailed("The page title '${title}' was not found.")
			}
		} catch (Exception e) {
			KeywordUtil.logInfo("The element '${title}' could not be verified. Error: ${e.getMessage()}")
		}
	}

	// ========================================================================
	// Method to verify if the message was successful
	// ========================================================================
	@Keyword
	void verifySuccessfulMessage() {
		try {
			TestObject successMessage = findTestObject('Object Repository/Settings/Context/Sucess Message')
			boolean isElementVisible = WebUI.waitForElementVisible(successMessage, 4, FailureHandling.OPTIONAL)

			if (isElementVisible) {
				String messageText = WebUI.getText(successMessage, FailureHandling.OPTIONAL)
				KeywordUtil.logInfo("The message '${messageText}' was found!")
			} else {
				throw new StepFailedException("Success message was not found.")
			}
		} catch (StepFailedException e) {
			KeywordUtil.markFailed("Error: " + e.getMessage())
		} catch (Exception e) {
			KeywordUtil.markFailed("Unexpected error while validating success message: " + e.getMessage())
		}
	}

	// ========================================================================
	// Method to wait for the download to complete
	// ========================================================================
	@Keyword
	void waitForFileDownload(String filename, int timeoutInSeconds) {
		String filePath = RunConfiguration.getProjectDir() + "/Downloads/" + filename
		File file = new File(filePath)

		long startTime = System.currentTimeMillis()
		long timeoutMillis = timeoutInSeconds * 1000L

		while (!file.exists()) {
			if (System.currentTimeMillis() - startTime > timeoutMillis) {
				KeywordUtil.markFailed("We couldn't find the file '${filename}' during the download attempt.")
				return
			}
			WebUI.delay(1)
		}

		KeywordUtil.logInfo("File downloaded successfully: ${file.getAbsolutePath()}")
	}

	// =================================
	// Search by context type
	// =================================
	@Keyword
	void filterByContextType(String contextType, String tableName, String showOrHide) {
		WebUI.verifyElementPresent(findTestObject("Object Repository/Settings/Context/Context Type Input"), 5)
		WebUI.setText(findTestObject("Object Repository/Settings/Context/Context Type Input"), contextType)

		TestObject firstResult = findTestObject('Object Repository/Common/FirstElement')

		try {
			boolean isVisible = WebUI.waitForElementVisible(firstResult, 5, FailureHandling.OPTIONAL)

			if (isVisible) {
				String elementText = WebUI.getText(firstResult, FailureHandling.OPTIONAL)
				if (elementText != null && elementText.contains(contextType)) {
					WebUI.click(firstResult)
				}
			} else {
				KeywordUtil.logInfo("The first result was not visible for context type '${contextType}'.")
			}
		} catch (NoSuchElementException e) {
			KeywordUtil.logInfo("The element '${firstResult}' was not found in the DOM. Error: ${e.getMessage()}")
		} catch (Exception e) {
			KeywordUtil.logInfo("The element '${firstResult}' could not be used. Error: ${e.getMessage()}")
		}

		WebUI.click(findTestObject('Object Repository/Common/Load'))
		filterByTableName(contextType, tableName, showOrHide)
		WebUI.executeJavaScript("location.reload(true);", null)
	}

	// =================================
	// Search by text field
	// =================================
	@Keyword
	void searchFilter(String tableName) {
		WebUI.executeJavaScript("window.scrollBy(0, 250);", null)
		WebUI.delay(2)
		WebUI.click(findTestObject('Object Repository/Common/Filters/Filters Button'))
		WebUI.click(findTestObject('Object Repository/Common/Table Name Filter Option'))
		WebUI.setText(findTestObject('Object Repository/Common/Filter Value'), tableName)
		WebUI.delay(1)
		WebUI.click(findTestObject('Object Repository/Common/Search Icon'))
	}

	// ============================
	// Search by table name filter
	// ============================
	@Keyword
	void filterByTableName(String contextType, String tableName, String showOrHide) {
		searchFilter(tableName)

		try {
			boolean result = WebUI.verifyElementPresent(
				findTestObject('Object Repository/Common/Table Rows', [('tableName') : tableName]),
				5,
				FailureHandling.OPTIONAL
			)

			if (showOrHide == 'NA') {
				if (result) {
					KeywordUtil.markFailed("Table '${tableName}' should not be present for this Context Type: '${contextType}'!")
				}
			} else if (showOrHide == 'C' || showOrHide == 'S') {
				if (!result) {
					KeywordUtil.markFailed("Table '${tableName}' should be present for this Context Type: '${contextType}'!")
				}
			}
		} catch (Exception e) {
			KeywordUtil.markWarning("The object 'Filter Result' could not be validated: " + e.getMessage())
		}
	}

	@Keyword
	void checkErrors(String tb, List<String> errors) {
		TestObject section = findTestObject('Object Repository/Correction/B2C CM/Correction Details/Invalid Records Section', [('tab') : tb])
		WebUI.scrollToElement(section, 10)
		WebUI.click(section)
		WebUI.delay(5)

		String table = tb.substring(0, 1).toUpperCase() + tb.substring(1).toLowerCase()

		if (table.equalsIgnoreCase("Others")) {
			table = "Autres"
		}

		for (int i = 0; i < errors.size(); i++) {
			if (errors.get(i).equalsIgnoreCase("Duplicates in file") || errors.get(i).equalsIgnoreCase("Duplicates")) {
				TestObject duplicateInFile = findTestObject(
					'Object Repository/Correction/B2C CM/Correction Details/Invalid Records Section',
					[('tab') : errors.get(i)]
				)
				WebUI.click(duplicateInFile)

				String globalTable = GlobalVariable."${table}"

				if (globalTable) {
					TestObject element = findTestObject(
						'Object Repository/Correction/B2C CM/Correction Details/Duplicated Li',
						[('element') : GlobalVariable."${table}"]
					)
					scroll()

					String text = WebUI.getText(element, FailureHandling.OPTIONAL)
					if (text == null || text.trim().isEmpty()) {
						KeywordUtil.logInfo("The error was not found!")
					} else {
						KeywordUtil.logInfo("The error was found correctly: " + text)
					}
				} else {
					List<String> rows = GlobalVariable.rowDuplicatedInUI

					for (int row = 0; row < rows.size(); row++) {
						TestObject element = findTestObject(
							'Object Repository/Correction/B2C CM/Correction Details/Duplicated Li',
							[('element') : rows.get(row)]
						)
						scroll()

						String text = WebUI.getText(element, FailureHandling.OPTIONAL)
						if (text == null || text.trim().isEmpty()) {
							KeywordUtil.logInfo("The error was not found!")
						} else {
							KeywordUtil.logInfo("The error was found correctly: " + text)
						}
					}
				}
			} else {
				TestObject tabEmpty = findTestObject(
					'Object Repository/Correction/B2C CM/Correction Details/Invalid Records Section',
					[('tab') : errors.get(i)]
				)

				String text = WebUI.getText(tabEmpty, FailureHandling.OPTIONAL)
				if (text == null || text.trim().isEmpty()) {
					KeywordUtil.logInfo("The error '${errors.get(i)}' was not found!")
				} else {
					KeywordUtil.logInfo("The error '${errors.get(i)}' was found correctly!")
				}
			}
		}
	}

	void scroll() {
		TestObject scrollObject = findTestObject('Object Repository/Correction/B2C CM/Correction Details/Errors Alert Popup')
		WebElement webElement = WebUI.findWebElement(scrollObject, 5)
		JavascriptExecutor js = (JavascriptExecutor) DriverFactory.getWebDriver()
		js.executeScript("arguments[0].scrollTop = arguments[0].scrollTop + 15;", webElement)
	}

	@Keyword
	List<String> getRowAsListOfStrings(int row_id) {
		String saveXpath = "//div[@role='row'][${row_id}]//div[@role='cell']"
		TestObject saveObject = new TestObject().addProperty('xpath', ConditionType.EQUALS, saveXpath)
		List<WebElement> cellElements = WebUI.findWebElements(saveObject, 5)
		List<String> cellValues = new ArrayList<String>()

		for (WebElement cell : cellElements) {
			String cellValue = cell.getText()
			if (cellValue == null || cellValue.isEmpty()) {
				cellValue = cell.getAttribute("value")
			}
			cellValues.add(cellValue)
		}

		return cellValues
	}
}
