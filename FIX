	@Keyword
	String findLatestExportedFilePath(
			String targetEnvironment,
			String exportLabel) {

		String environment = resolveEnvironmentName(
				targetEnvironment,
				exportLabel
				)

		String exportFolderPath = getCurrentExportFolderPath(
				targetEnvironment,
				exportLabel
				)

		File exportFolder = new File(
				exportFolderPath
				)

		if (!exportFolder.exists() ||
				!exportFolder.isDirectory()) {

			logInfo(
					'Export folder was not found. Folder: ' +
					exportFolderPath
					)

			return ''
		}

		String expectedSuffix = shortenFilePart(
				resolveExportLabelSuffixForFileName(
				exportLabel
				),
				MAX_LABEL_LENGTH
				)

		File[] folderFiles = exportFolder.listFiles()
		List<File> matchingFiles = []

		if (folderFiles != null) {
			for (File file : folderFiles) {

				if (file == null ||
						!file.exists() ||
						!file.isFile() ||
						file.length() <= 0 ||
						file.getName().startsWith('~$')) {

					continue
				}

				String lowerName =
						file.getName().toLowerCase()

				boolean excelFile =
						lowerName.endsWith('.xlsx') ||
						lowerName.endsWith('.xlsm') ||
						lowerName.endsWith('.xls')

				boolean environmentMatches =
						file.getName()
						.toUpperCase()
						.startsWith(
						environment +
						'_'
						)

				boolean suffixMatches =
						expectedSuffix == null ||
						expectedSuffix.trim().isEmpty() ||
						removeExcelExtension(
						file.getName()
						)
						.toLowerCase()
						.endsWith(
						'_' +
						expectedSuffix.toLowerCase()
						)

				if (excelFile &&
						environmentMatches &&
						suffixMatches) {

					matchingFiles.add(
							file
							)
				}
			}
		}

		if (matchingFiles.isEmpty()) {

			logInfo(
					'No exported file matched the expected values.\n' +
					'Environment: ' + environment + '\n' +
					'Export label: ' + safeLogText(exportLabel) + '\n' +
					'Expected suffix: ' + safeLogText(expectedSuffix) + '\n' +
					'Folder: ' + exportFolderPath
					)

			return ''
		}

		matchingFiles.sort { File first, File second ->

			second.lastModified() <=>
					first.lastModified()
		}

		File latestExportedFile =
				matchingFiles.first()

		logInfo(
				'Latest exported file resolved.\n' +
				'File: ' + latestExportedFile.getName() + '\n' +
				'Path: ' + latestExportedFile.getAbsolutePath() + '\n' +
				'Size bytes: ' + latestExportedFile.length()
				)

		return latestExportedFile.getAbsolutePath()
	}


	private void clickObjectFirstThenImage(
			String buttonDescription,
			String imageKey,
			String objectKey) {

		long startedAt =
				System.currentTimeMillis()

		boolean exportButton =
				buttonDescription.equalsIgnoreCase(
						'Export'
						)

		Integer maximumAttempts =
				exportButton
						? EXPORT_BUTTON_MAX_ATTEMPTS
						: 1

		for (
		Integer attempt = 1;
				attempt <= maximumAttempts;
				attempt++
				) {

			windowsElementChannelTimedOut = false

			logInfo(
					'Searching for ' +
					buttonDescription +
					' button.\n' +
					'Attempt: ' +
					attempt +
					' of ' +
					maximumAttempts +
					'\nObject key: ' +
					objectKey +
					'\nFunctional timeout: ' +
					ELEMENT_BUTTON_TIMEOUT_SECONDS +
					' seconds\nHard timeout: ' +
					ELEMENT_HARD_TIMEOUT_SECONDS +
					' seconds'
					)

			boolean clickedByObject =
					tryClickWindowsObjectProtected(
					objectKey,
					buttonDescription + ' button',
					ELEMENT_BUTTON_TIMEOUT_SECONDS
					)

			if (clickedByObject) {

				logInfo(
						buttonDescription +
						' button clicked using Windows object.\n' +
						'Attempt: ' +
						attempt +
						'\nElapsed milliseconds: ' +
						elapsedMilliseconds(
						startedAt
							)
						)

				return
			}

			// If the Export click opened the Save dialog but the Windows click
			// did not return before the hard timeout, treat the click as successful.
			if (exportButton) {

				try {
					boolean saveDialogVisible =
							imageLoader.waitForImage(
							GENERAL_IMAGE_GROUP,
							'saveDialog',
							2
							)

					if (saveDialogVisible) {

						logInfo(
								'Export click opened the Save dialog successfully.\n' +
								'Windows click did not return before the hard timeout, ' +
								'but the Save dialog confirms that the click succeeded.'
								)

						return
					}
				} catch (Throwable throwable) {

					logInfo(
							'Could not confirm Save dialog after Export object click timeout.\n' +
							'Message: ' +
							safeExceptionMessage(
							throwable
								)
							)
				}
			}

			logInfo(
					buttonDescription +
					' Windows object was not available or clickable.\n' +
					'Trying image fallback.\n' +
					'Image key: ' +
					imageKey +
					'\nImage timeout: ' +
					IMAGE_BUTTON_TIMEOUT_SECONDS +
					' seconds'
					)

			boolean imageFound = false

			try {
				imageFound =
						imageLoader.waitForImage(
						GENERAL_IMAGE_GROUP,
						imageKey,
						IMAGE_BUTTON_TIMEOUT_SECONDS
						)
			} catch (Throwable throwable) {

				logInfo(
						buttonDescription +
						' image search returned an exception.\n' +
						'Attempt: ' +
						attempt +
						'\nImage key: ' +
						imageKey +
						'\nMessage: ' +
						safeExceptionMessage(
						throwable
							)
						)
			}

			if (imageFound) {

				try {
					imageLoader.clickImageOrStop(
							GENERAL_IMAGE_GROUP,
							imageKey
							)

					logInfo(
							buttonDescription +
							' button clicked using image fallback.\n' +
							'Attempt: ' +
							attempt +
							'\nElapsed milliseconds: ' +
							elapsedMilliseconds(
							startedAt
								)
							)

					return
				} catch (Throwable throwable) {

					logInfo(
							buttonDescription +
							' image was found but could not be clicked.\n' +
							'The button may still be disabled because the screen is loading.\n' +
							'Attempt: ' +
							attempt +
							' of ' +
							maximumAttempts +
							'\nImage key: ' +
							imageKey +
							'\nMessage: ' +
							safeExceptionMessage(
							throwable
								)
							)
				}
			}

			if (attempt < maximumAttempts) {

				logInfo(
						buttonDescription +
						' button was not ready.\n' +
						'Waiting ' +
						EXPORT_BUTTON_RETRY_DELAY_SECONDS +
						' seconds before retrying.'
						)

				Windows.delay(
						EXPORT_BUTTON_RETRY_DELAY_SECONDS
						)
			}
		}

		imageLoader.takeEvidence(
				buttonDescription +
				'ButtonNotFoundAfterRetries.png'
				)

		KeywordUtil.markFailedAndStop(
				buttonDescription +
				' button was not found or could not be clicked after all attempts.\n' +
				'Attempts: ' +
				maximumAttempts +
				'\nWindows object key: ' +
				objectKey +
				'\nWindows functional timeout per attempt: ' +
				ELEMENT_BUTTON_TIMEOUT_SECONDS +
				' seconds\nWindows hard timeout per attempt: ' +
				ELEMENT_HARD_TIMEOUT_SECONDS +
				' seconds\nImage key: ' +
				imageKey +
				'\nImage timeout per attempt: ' +
				IMAGE_BUTTON_TIMEOUT_SECONDS +
				' seconds\nEvidence: ' +
				buttonDescription +
				'ButtonNotFoundAfterRetries.png'
				)
	}



	private File saveToShortExportFolder(
			String exportLabel,
			String targetEnvironment) {

		long startedAt =
				System.currentTimeMillis()

		String environment = resolveEnvironmentName(
				targetEnvironment,
				exportLabel
				)

		String collectionName = shortenFilePart(
				sanitizeFileName(
				resolveCurrentCollectionName()
				),
				MAX_COLLECTION_LENGTH
				)

		String featureName = shortenFilePart(
				sanitizeFileName(
				resolveCurrentFeatureName()
				),
				MAX_FEATURE_LENGTH
				)

		String exportLabelSuffix = shortenFilePart(
				resolveExportLabelSuffixForFileName(
				exportLabel
				),
				MAX_LABEL_LENGTH
				)

		File directory = resolveShortExportDirectory(
				environment,
				collectionName,
				featureName
				)

		if (!directory.exists()) {

			logInfo(
					'Export directory does not exist. Creating directory: ' +
					directory.getAbsolutePath()
					)

			boolean created =
					directory.mkdirs()

			if (!created &&
					!directory.exists()) {

				KeywordUtil.markFailedAndStop(
						'Could not create export directory. Directory: ' +
						directory.getAbsolutePath()
						)

				return null
			}
		}

		String fileName = buildAutomaticExportFileName(
				environment,
				featureName,
				exportLabelSuffix
				)

		File exportedFile = new File(
				directory,
				fileName
				)

		exportedFile = ensurePathIsShortEnough(
				exportedFile,
				environment,
				exportLabelSuffix
				)

		String exportDirectory =
				exportedFile
				.getParentFile()
				.getAbsolutePath()

		logInfo(
				'Save dialog configuration prepared.\n' +
				'Environment: ' + environment + '\n' +
				'Collection: ' + collectionName + '\n' +
				'Feature: ' + featureName + '\n' +
				'Export label: ' + exportLabelSuffix + '\n' +
				'Directory: ' + exportDirectory + '\n' +
				'File name: ' + exportedFile.getName() + '\n' +
				'Full path length: ' + exportedFile.getAbsolutePath().length()
				)

		waitForSaveDialog()

		setSaveDialogDirectory(
				exportDirectory
				)

		setSaveDialogFileName(
				exportedFile.getName()
				)

		clickRequiredWindowsObject(
				'saveButton',
				'Save button',
				SAVE_DIALOG_TIMEOUT_SECONDS
				)

		Windows.delay(
				SAVE_DIALOG_OPEN_DELAY_SECONDS
				)

		logInfo(
				'Save button clicked. Waiting for exported file. Timeout: ' +
				EXPORT_FILE_TIMEOUT_SECONDS +
				' seconds. Expected path: ' +
				exportedFile.getAbsolutePath()
				)

		waitForExportedFileOrStop(
				exportedFile,
				EXPORT_FILE_TIMEOUT_SECONDS
				)

		logInfo(
				'Save flow completed. Elapsed milliseconds: ' +
				elapsedMilliseconds(
				startedAt
				)
				)

		return exportedFile
	}


	private void waitForSaveDialog() {

		logInfo(
				'Waiting for Save dialog using Windows object first.\n' +
				'Object: export/fileNameField\n' +
				'Functional timeout: ' + SAVE_DIALOG_TIMEOUT_SECONDS + ' seconds\n' +
				'Hard timeout: ' + ELEMENT_HARD_TIMEOUT_SECONDS + ' seconds'
				)

		boolean foundByObject =
				isWindowsObjectPresentProtected(
				'fileNameField',
				'Save dialog file name field',
				SAVE_DIALOG_TIMEOUT_SECONDS
				)

		if (foundByObject) {

			logInfo(
					'Save dialog found using Windows object.'
					)

			return
		}

		logInfo(
				'Save dialog file name object was not found or did not answer.\n' +
				'Continuing with keyboard fallback using CTRL + L for the path and ' +
				FILE_NAME_FALLBACK_TAB_COUNT +
				' TAB presses for the file name when necessary.'
				)
	}


	private void setSaveDialogDirectory(
			String exportDirectory) {

		logInfo(
				'Focusing Save dialog address bar using CTRL + L.'
				)

		try {
			focusSaveDialogAddressBar()
		} catch (Exception exception) {

			imageLoader.takeEvidence(
					'SaveDialogAddressBarError.png'
					)

			KeywordUtil.markFailedAndStop(
					'Could not focus Save dialog address bar using CTRL + L. Message: ' +
					safeExceptionMessage(
					exception
					)
					)

			return
		}

		Windows.delay(
				SHORT_UI_DELAY_SECONDS
				)

		clearFocusedField()

		logInfo(
				'Entering export directory: ' +
				exportDirectory
				)

		pasteAndEnter(
				exportDirectory
				)

		Windows.delay(
				PANEL_OPEN_DELAY_SECONDS
				)

		logInfo(
				'Export directory entered successfully using CTRL + L.'
				)
	}


	private void setSaveDialogFileName(
			String fileName) {

		boolean remoteExecution =
				isRemoteExecution()

		Integer fileNameFallbackTabCount =
				remoteExecution
				? REMOTE_FILE_NAME_FALLBACK_TAB_COUNT
				: FILE_NAME_FALLBACK_TAB_COUNT

		logInfo(
				'Focusing file name field using object export/fileNameField. Timeout: ' +
				SAVE_DIALOG_TIMEOUT_SECONDS +
				' seconds.\n' +
				'Execution mode: ' +
				(remoteExecution ? 'REMOTE' : 'LOCAL') +
				'\nFallback TAB count: ' +
				fileNameFallbackTabCount
				)

		boolean focusedByObject =
				tryClickWindowsObject(
				'fileNameField',
				SAVE_DIALOG_TIMEOUT_SECONDS
				)

		if (!focusedByObject) {

			logInfo(
					'fileNameField was not focused using Windows object. Trying ' +
					fileNameFallbackTabCount +
					' TAB presses.'
					)

			try {
				pressTabTimes(
						fileNameFallbackTabCount
						)
			} catch (Exception exception) {

				imageLoader.takeEvidence(
						'FileNameFieldNotFocused.png'
						)

				KeywordUtil.markFailedAndStop(
						'Could not focus file name field using object or ' +
						fileNameFallbackTabCount +
						' TAB presses. Message: ' +
						safeExceptionMessage(
						exception
							)
						)

				return
			}
		}

		Windows.delay(
				SHORT_UI_DELAY_SECONDS
				)

		clearFocusedField()

		pasteText(
				fileName
				)

		Windows.delay(
				SHORT_UI_DELAY_SECONDS
				)

		logInfo(
				'File name entered successfully: ' +
				fileName
				)
	}



