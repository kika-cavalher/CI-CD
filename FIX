/*
 * Responsibility:
 * Self-contained Jenkins pipeline for Archive Mode desktop execution.
 * This version avoids shared runner/load complexity to reduce Pipeline context errors.
 * Edit only the variables below when you need to change paths or environment values.
 */

def GIT_URL               = 'https://bitbucket-mut.mycloud.intrabpce.fr/scm/gi5/ematch-r-tests.git'
def GIT_BRANCH            = '*/master'
def GIT_CREDENTIAL        = 'adgi5appjenkins/******'

def KATALON_EXE           = 'C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0\\katalonc.exe'
def PROJECT_FILE          = 'eMatch POC.prj'
def WIN_DRIVER_TASK       = 'startWinDriver'
def CLOSE_BAT_PATH        = 'D:\\Projects\\eMatchStarters\\closeEmatch.bat'
def NEXT_JOB_NAME         = 'Passerelle Bilan'

/*
 * Change these two values whenever you need to point to different Katalon assets.
 * Use the exact Katalon path as shown in Test Suites.
 */
def ARCHIVE_MODE_SUITE_PATH       = 'Test Suites/ArchiveMode/Archive Mode'
def ARCHIVE_MODE_COLLECTION_PATH  = 'Test Suites/ArchiveMode/Archive Mode Collection'

pipeline {
    agent { label 'GI5_SWDCFRNXGI55817' }

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        timeout(time: 180, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '15', daysToKeepStr: '20'))
    }

    environment {
        ENV_GIT_URL              = "${GIT_URL}"
        ENV_GIT_BRANCH           = "${GIT_BRANCH}"
        ENV_GIT_CREDENTIAL       = "${GIT_CREDENTIAL}"

        ENV_KATALON_EXE          = "${KATALON_EXE}"
        ENV_PROJECT_FILE         = "${PROJECT_FILE}"
        ENV_REPORTS_ROOT         = "${WORKSPACE}\\Reports"
        ENV_WIN_DRIVER_TASK      = "${WIN_DRIVER_TASK}"
        ENV_CLOSE_BAT_PATH       = "${CLOSE_BAT_PATH}"
        ENV_NEXT_JOB_NAME        = "${NEXT_JOB_NAME}"

        ENV_SUITE_PATH           = "${ARCHIVE_MODE_SUITE_PATH}"
        ENV_COLLECTION_PATH      = "${ARCHIVE_MODE_COLLECTION_PATH}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: env.ENV_GIT_BRANCH]],
                    userRemoteConfigs: [[url: env.ENV_GIT_URL, credentialsId: env.ENV_GIT_CREDENTIAL]],
                    extensions: [
                        [$class: 'CloneOption', shallow: false, noTags: false, timeout: 30]
                    ]
                ])
            }
        }

        stage('Validate Environment') {
            steps {
                bat """
@echo off
echo ------------------------------------------------------------
echo VALIDATING ENVIRONMENT
echo ------------------------------------------------------------

if not exist "%ENV_KATALON_EXE%" (
    echo [ERROR] Katalon executable not found
    echo %ENV_KATALON_EXE%
    exit /b 1
)

if not exist "%WORKSPACE%\\%ENV_PROJECT_FILE%" (
    echo [ERROR] Project file not found
    echo %WORKSPACE%\\%ENV_PROJECT_FILE%
    exit /b 1
)

if exist "%ENV_REPORTS_ROOT%" rmdir /s /q "%ENV_REPORTS_ROOT%"
mkdir "%ENV_REPORTS_ROOT%"
mkdir "%ENV_REPORTS_ROOT%\\logs"

echo [OK] Environment validated
echo ------------------------------------------------------------
"""
            }
        }

        stage('Run Archive Mode Suite') {
            steps {
                powershell '''
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

function Start-WinDriverTask {
    param([string]$TaskName)

    if ([string]::IsNullOrWhiteSpace($TaskName)) { return }

    Write-Host "[INFO] Starting WinDriver task: $TaskName"
    schtasks /run /tn $TaskName | Out-Host
    Start-Sleep -Seconds 3
}

function Stop-WinDriverTask {
    param([string]$TaskName)

    if ([string]::IsNullOrWhiteSpace($TaskName)) { return }

    try {
        Write-Host "[INFO] Stopping WinDriver task: $TaskName"
        schtasks /end /tn $TaskName 1>$null 2>$null
    }
    catch {
    }
}

function Run-CloseBatIfNeeded {
    param([string]$BatPath)

    if ([string]::IsNullOrWhiteSpace($BatPath)) { return }

    if (-not (Test-Path -LiteralPath $BatPath)) {
        Write-Host "[WARN] Close BAT not found: $BatPath"
        return
    }

    Write-Host "[INFO] Running close BAT: $BatPath"
    Start-Process -FilePath 'cmd.exe' -ArgumentList '/c', ('"' + $BatPath + '"') -Wait -NoNewWindow
    Start-Sleep -Seconds 2
}

Start-WinDriverTask -TaskName $env:ENV_WIN_DRIVER_TASK

try {
    & "$env:ENV_KATALON_EXE" `
        -noSplash `
        -runMode=console `
        -consoleLog `
        -projectPath="$env:WORKSPACE\\$env:ENV_PROJECT_FILE" `
        -retry=0 `
        -testSuitePath="$env:ENV_SUITE_PATH" `
        -browserType="Windows" `
        -reportFolder="$env:ENV_REPORTS_ROOT"

    if ($LASTEXITCODE -ne 0) {
        throw "Archive Mode suite failed with exit code $LASTEXITCODE"
    }
}
finally {
    Run-CloseBatIfNeeded -BatPath $env:ENV_CLOSE_BAT_PATH
    Stop-WinDriverTask -TaskName $env:ENV_WIN_DRIVER_TASK
}
'''
            }
        }

        stage('Run Archive Mode Collection') {
            steps {
                powershell '''
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

function Start-WinDriverTask {
    param([string]$TaskName)

    if ([string]::IsNullOrWhiteSpace($TaskName)) { return }

    Write-Host "[INFO] Starting WinDriver task: $TaskName"
    schtasks /run /tn $TaskName | Out-Host
    Start-Sleep -Seconds 3
}

function Stop-WinDriverTask {
    param([string]$TaskName)

    if ([string]::IsNullOrWhiteSpace($TaskName)) { return }

    try {
        Write-Host "[INFO] Stopping WinDriver task: $TaskName"
        schtasks /end /tn $TaskName 1>$null 2>$null
    }
    catch {
    }
}

function Run-CloseBatIfNeeded {
    param([string]$BatPath)

    if ([string]::IsNullOrWhiteSpace($BatPath)) { return }

    if (-not (Test-Path -LiteralPath $BatPath)) {
        Write-Host "[WARN] Close BAT not found: $BatPath"
        return
    }

    Write-Host "[INFO] Running close BAT: $BatPath"
    Start-Process -FilePath 'cmd.exe' -ArgumentList '/c', ('"' + $BatPath + '"') -Wait -NoNewWindow
    Start-Sleep -Seconds 2
}

Start-WinDriverTask -TaskName $env:ENV_WIN_DRIVER_TASK

try {
    & "$env:ENV_KATALON_EXE" `
        -noSplash `
        -runMode=console `
        -consoleLog `
        -projectPath="$env:WORKSPACE\\$env:ENV_PROJECT_FILE" `
        -retry=0 `
        -testSuiteCollectionPath="$env:ENV_COLLECTION_PATH" `
        -browserType="Windows" `
        -reportFolder="$env:ENV_REPORTS_ROOT"

    if ($LASTEXITCODE -ne 0) {
        throw "Archive Mode collection failed with exit code $LASTEXITCODE"
    }
}
finally {
    Run-CloseBatIfNeeded -BatPath $env:ENV_CLOSE_BAT_PATH
    Stop-WinDriverTask -TaskName $env:ENV_WIN_DRIVER_TASK
}
'''
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'Reports/**/JUnit_Report.xml'
            archiveArtifacts artifacts: 'Reports/**/*', allowEmptyArchive: true
        }

        success {
            script {
                if (env.ENV_NEXT_JOB_NAME?.trim()) {
                    build job: env.ENV_NEXT_JOB_NAME, wait: false, propagate: false
                }
            }
        }
    }
}












