	private String tableLiaisonReadObjectValue(
			String objectKey,
			Integer timeoutSeconds
	) {

		WindowsTestObject targetObject =
				object(
				objectKey
				)

		if (!Windows.waitForElementPresent(
				targetObject,
				safeTimeout(timeoutSeconds),
				FailureHandling.OPTIONAL
				)) {

			return ''
		}

		try {
			List<RemoteWebElement> elements =
					Windows.findElements(
					targetObject
					)

			if (elements == null ||
					elements.isEmpty()) {

				return ''
			}

			RemoteWebElement element =
					elements.get(0)

			List<String> attributes = [
				'Value.Value',
				'Value',
				'Text'
			]

			for (String attributeName : attributes) {
				String attributeValue =
						safeText(
						element.getAttribute(
						attributeName
						)
						)

				if (!attributeValue.isEmpty()) {
					return attributeValue
				}
			}

			String textValue =
					safeText(
					element.getText()
					)

			if (!textValue.isEmpty()) {
				return textValue
			}

			return safeText(
					element.getAttribute(
					'Name'
					)
					)
		} catch (Throwable ignored) {
			try {
				return safeText(
						Windows.getText(
						targetObject
						)
						)
			} catch (Throwable ignoredAgain) {
				return ''
			}
		}
	}


