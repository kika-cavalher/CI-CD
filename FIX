	private void doubleClickElementCenterWithMouse(
			RemoteWebElement element
	) {

		def elementRectangle =
				element.getRect()

		Integer clickX =
				elementRectangle.getX() +
				elementRectangle.getWidth().intdiv(2)

		Integer clickY =
				elementRectangle.getY() +
				elementRectangle.getHeight().intdiv(2)

		Robot robot = new Robot()

		robot.mouseMove(
				clickX,
				clickY
				)

		robot.mousePress(
				InputEvent.BUTTON1_DOWN_MASK
				)
		robot.mouseRelease(
				InputEvent.BUTTON1_DOWN_MASK
				)

		Thread.sleep(150L)

		robot.mousePress(
				InputEvent.BUTTON1_DOWN_MASK
				)
		robot.mouseRelease(
				InputEvent.BUTTON1_DOWN_MASK
				)
	}


