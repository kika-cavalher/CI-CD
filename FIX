package component

import java.awt.Robot
import java.awt.event.KeyEvent

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import commands.ImageLoader
import commands.WindowsObjectLoader


class FilterKeywords {

	private static final Integer DEFAULT_TIMEOUT = 10
	private static final Integer POLLING_DELAY_SECONDS = 1

	private final ImageLoader imageLoader =
		new ImageLoader()


	// ======================================================
	// OPEN FILTER
	// ======================================================

	@Keyword
	void openFilter(
			String imageGroup,
			String filterFieldImageKey,
			String filterButtonImageKey,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)

		waitForImagePresent(
			imageGroup,
			filterFieldImageKey,
			timeout,
			'Filter field was not displayed.'
		)

		WindowsImageKeywords.clickImage(
			image(imageGroup, filterFieldImageKey)
		)

		waitForImagePresent(
			imageGroup,
			filterButtonImageKey,
			timeout,
			'Filter button was not displayed after opening the filter field.'
		)

		WindowsImageKeywords.clickImage(
			image(imageGroup, filterButtonImageKey)
		)
	}


	// ======================================================
	// CLEAR CURRENT SELECTION
	// ======================================================

	@Keyword
	void clearCurrentSelection(
			String imageGroup,
			String selectAllImageKey,
			String emptySelectionImageKey,
			String closeFilterImageKey,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)

		waitForImagePresent(
			imageGroup,
			selectAllImageKey,
			timeout,
			'Select all option was not displayed.'
		)

		WindowsImageKeywords.doubleClickImage(
			image(imageGroup, selectAllImageKey)
		)

		Windows.delay(POLLING_DELAY_SECONDS)

		waitForImagePresent(
			imageGroup,
			emptySelectionImageKey,
			timeout,
			'Empty selection option was not displayed.'
		)

		WindowsImageKeywords.doubleClickImage(
			image(imageGroup, emptySelectionImageKey)
		)

		Windows.delay(POLLING_DELAY_SECONDS)

		waitForImagePresent(
			imageGroup,
			closeFilterImageKey,
			timeout,
			'Close filter button was not displayed.'
		)

		WindowsImageKeywords.clickImage(
			image(imageGroup, closeFilterImageKey)
		)

		Windows.delay(POLLING_DELAY_SECONDS)
	}


	// ======================================================
	// APPLY TEXT FILTER WITH CHECKBOX
	// ======================================================

	@Keyword
	void applyTextCheckboxFilter(
			String imageGroup,
			String filterFieldImageKey,
			String filterButtonImageKey,
			String textInputImageKey,
			String checkboxImageKey,
			String closeFilterImageKey,
			String appliedFilterImageKey,
			String filterValue,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)
		String value = safeText(filterValue)

		if (value.isEmpty()) {
			KeywordUtil.markFailedAndStop(
				'Filter value cannot be empty.'
			)

			return
		}

		openFilter(
			imageGroup,
			filterFieldImageKey,
			filterButtonImageKey,
			timeout
		)

		waitForImagePresent(
			imageGroup,
			textInputImageKey,
			timeout,
			'Filter text input was not displayed.'
		)

		replaceTextOnImage(
			image(imageGroup, textInputImageKey),
			value
		)

		Windows.delay(2)

		waitForImagePresent(
			imageGroup,
			checkboxImageKey,
			timeout,
			'Filter checkbox was not displayed for value: ' +
			value
		)

		WindowsImageKeywords.clickImage(
			image(imageGroup, checkboxImageKey)
		)

		Windows.delay(POLLING_DELAY_SECONDS)

		waitForImagePresent(
			imageGroup,
			closeFilterImageKey,
			timeout,
			'Close filter button was not displayed.'
		)

		WindowsImageKeywords.clickImage(
			image(imageGroup, closeFilterImageKey)
		)

		waitForImagePresent(
			imageGroup,
			appliedFilterImageKey,
			timeout,
			'Filter was not applied correctly for value: ' +
			value
		)

		KeywordUtil.logInfo(
			'[PASS] Text filter applied successfully. Value: ' +
			value
		)
	}


	// ======================================================
	// DRAG FILTER TO TARGET AREA
	// ======================================================

	@Keyword
	void dragFilterToTargetAndValidate(
			String imageGroup,
			String sourceFilterImageKey,
			String targetAreaImageKey,
			String appliedFilterImageKey,
			String availableFiltersValidationImageKey,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)

		waitForImagePresent(
			imageGroup,
			sourceFilterImageKey,
			timeout,
			'Source filter was not displayed before drag and drop.'
		)

		waitForImagePresent(
			imageGroup,
			targetAreaImageKey,
			timeout,
			'Filter target area was not displayed.'
		)

		WindowsImageKeywords.dragAndDrop(
			image(imageGroup, sourceFilterImageKey),
			image(imageGroup, targetAreaImageKey)
		)

		waitForImagePresent(
			imageGroup,
			appliedFilterImageKey,
			timeout,
			'Filter was not applied to the target area.'
		)

		waitForImagePresent(
			imageGroup,
			availableFiltersValidationImageKey,
			timeout,
			'Available filter list was not updated after drag and drop.'
		)

		KeywordUtil.logInfo(
			'[PASS] Filter drag and drop completed and validated.'
		)
	}


	// ======================================================
	// SELECT ALL EXCEPT BLANKS
	// ======================================================

	@Keyword
	void selectAllExceptBlanks(
			String imageGroup,
			String objectGroup,
			String hoverImageKey,
			String hoverObjectKey,
			String filterButtonImageKey,
			String filterButtonObjectKey,
			String valuesTitleImageKey,
			String valuesTitleObjectKey,
			String allCheckedImageKey,
			String allCheckedObjectKey,
			String closeButtonImageKey,
			String closeButtonObjectKey,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)

		// Hover over target header to display filter icon
		hoverImageFirstThenObject(
			imageGroup,
			objectGroup,
			hoverImageKey,
			hoverObjectKey,
			timeout
		)

		Windows.delay(POLLING_DELAY_SECONDS)

		// Open filter
		clickImageFirstThenObject(
			imageGroup,
			objectGroup,
			filterButtonImageKey,
			filterButtonObjectKey,
			'Filter button',
			timeout
		)

		// Validate Values tab
		waitForImageOrObjectPresent(
			imageGroup,
			objectGroup,
			valuesTitleImageKey,
			valuesTitleObjectKey,
			'Values tab was not displayed after opening the filter.',
			timeout
		)

		// Select all values
		pressDownAndSpace()

		Windows.delay(POLLING_DELAY_SECONDS)

		// Deselect blanks
		pressDownAndSpace()

		// Validate that All remains checked
		waitForImageOrObjectPresent(
			imageGroup,
			objectGroup,
			allCheckedImageKey,
			allCheckedObjectKey,
			'All values were not selected after removing blanks.',
			timeout
		)

		// Close filter
		clickImageFirstThenObject(
			imageGroup,
			objectGroup,
			closeButtonImageKey,
			closeButtonObjectKey,
			'Close filter button',
			timeout
		)

		Windows.delay(POLLING_DELAY_SECONDS)

		KeywordUtil.logInfo(
			'[PASS] Filter configured with all values selected except blanks.'
		)
	}


	// ======================================================
	// IMAGE VALIDATION
	// ======================================================

	@Keyword
	Boolean isImageDisplayed(
			String imageGroup,
			String imageKey,
			Integer timeoutSeconds
		) {

		return waitForImage(
			imageGroup,
			imageKey,
			safeTimeout(timeoutSeconds)
		)
	}


	// ======================================================
	// INTERNAL HELPERS
	// ======================================================


	private void hoverImageFirstThenObject(
			String imageGroup,
			String objectGroup,
			String imageKey,
			String objectKey,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)
		Integer imageTimeout = Math.min(timeout, 3)

		Boolean imageFound = false

		try {
			imageFound = imageLoader.waitForImage(
				imageGroup,
				imageKey,
				imageTimeout
			)
		} catch (Throwable ignored) {
			imageFound = false
		}

		WindowsTestObject targetObject =
			object(objectGroup, objectKey)

		if (!Windows.waitForElementPresent(
			targetObject,
			timeout,
			FailureHandling.OPTIONAL
		)) {
			KeywordUtil.markFailedAndStop(
				'Hover target was not found.\n' +
				'Image group: ' + imageGroup + '\n' +
				'Image key: ' + imageKey + '\n' +
				'Object group: ' + objectGroup + '\n' +
				'Object key: ' + objectKey
			)

			return
		}

		Windows.mouseOver(
			targetObject
		)

		KeywordUtil.logInfo(
			imageFound
				? '[IMAGE] Hover anchor found. Mouse over completed on the centralized Windows object.'
				: '[OBJECT] Image was not found. Mouse over completed using the centralized Windows object.'
		)
	}

	private void clickImageFirstThenObject(
			String imageGroup,
			String objectGroup,
			String imageKey,
			String objectKey,
			String description,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)
		Integer imageTimeout = Math.min(timeout, 3)

		try {
			if (imageLoader.waitForImage(
				imageGroup,
				imageKey,
				imageTimeout
			)) {
				WindowsImageKeywords.clickImage(
					image(imageGroup, imageKey)
				)

				KeywordUtil.logInfo(
					'[IMAGE] ' + description + ' clicked.'
				)

				return
			}
		} catch (Throwable imageError) {
			KeywordUtil.logInfo(
				'[IMAGE] Could not click ' +
					description +
					'. Trying Windows object.\n' +
					'Reason: ' +
					safeText(imageError.message)
			)
		}

		WindowsTestObject targetObject =
			object(objectGroup, objectKey)

		if (!Windows.waitForElementPresent(
			targetObject,
			timeout,
			FailureHandling.OPTIONAL
		)) {
			KeywordUtil.markFailedAndStop(
				description +
					' was not found by image or Windows object.\n' +
					'Image group: ' + imageGroup + '\n' +
					'Image key: ' + imageKey + '\n' +
					'Object group: ' + objectGroup + '\n' +
					'Object key: ' + objectKey
			)

			return
		}

		Windows.click(
			targetObject,
			FailureHandling.STOP_ON_FAILURE
		)

		KeywordUtil.logInfo(
			'[OBJECT] ' + description + ' clicked.'
		)
	}

	private void waitForImageOrObjectPresent(
			String imageGroup,
			String objectGroup,
			String imageKey,
			String objectKey,
			String failureMessage,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)
		Integer imageTimeout = Math.min(timeout, 5)

		try {
			if (imageLoader.waitForImage(
				imageGroup,
				imageKey,
				imageTimeout
			)) {
				KeywordUtil.logInfo(
					'[IMAGE] Expected filter state displayed. Key: ' +
						imageKey
				)

				return
			}
		} catch (Throwable ignored) {
		}

		WindowsTestObject targetObject =
			object(objectGroup, objectKey)

		if (Windows.waitForElementPresent(
			targetObject,
			timeout,
			FailureHandling.OPTIONAL
		)) {
			KeywordUtil.logInfo(
				'[OBJECT] Expected filter state displayed. Key: ' +
					objectKey
			)

			return
		}

		KeywordUtil.markFailedAndStop(
			failureMessage + '\n' +
				'Image group: ' + imageGroup + '\n' +
				'Image key: ' + imageKey + '\n' +
				'Object group: ' + objectGroup + '\n' +
				'Object key: ' + objectKey
		)
	}

	private void pressDownAndSpace() {
		Robot robot = new Robot()

		robot.keyPress(KeyEvent.VK_DOWN)
		robot.keyRelease(KeyEvent.VK_DOWN)

		Thread.sleep(200L)

		robot.keyPress(KeyEvent.VK_SPACE)
		robot.keyRelease(KeyEvent.VK_SPACE)

		Thread.sleep(300L)
	}

	private WindowsTestObject object(
			String objectGroup,
			String objectKey
		) {

		return WindowsObjectLoader.getObject(
			objectGroup,
			objectKey
		)
	}

	private void replaceTextOnImage(
			String imagePath,
			String value
		) {

		WindowsImageKeywords.clickImage(imagePath)

		Robot robot = new Robot()

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_CONTROL)

		robot.keyPress(KeyEvent.VK_BACK_SPACE)
		robot.keyRelease(KeyEvent.VK_BACK_SPACE)

		WindowsImageKeywords.typeOnImage(
			imagePath,
			value
		)
	}

	private Boolean waitForImage(
			String imageGroup,
			String imageKey,
			Integer timeoutSeconds
		) {

		return imageLoader.waitForImage(
			imageGroup,
			imageKey,
			timeoutSeconds
		)
	}

	private void waitForImagePresent(
			String imageGroup,
			String imageKey,
			Integer timeoutSeconds,
			String failureMessage
		) {

		if (!waitForImage(
			imageGroup,
			imageKey,
			timeoutSeconds
		)) {
			KeywordUtil.markFailedAndStop(
				failureMessage + '\n' +
				'Image group: ' + imageGroup + '\n' +
				'Image key: ' + imageKey
			)
		}
	}

	private String image(
			String imageGroup,
			String imageKey
		) {

		return imageLoader.getImage(
			imageGroup,
			imageKey
		)
	}

	private Integer safeTimeout(Integer timeoutSeconds) {
		return timeoutSeconds != null &&
			timeoutSeconds > 0
				? timeoutSeconds
				: DEFAULT_TIMEOUT
	}

	private String safeText(Object value) {
		return value == null
			? ''
			: value.toString().trim()
	}
}

