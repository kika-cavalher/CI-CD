	@Keyword
	String getImage(String imageGroup, String imageKey) {
		validateImage(imageGroup, imageKey)
		return getAbsolutePath(IMAGE_GROUPS[imageGroup][imageKey])
	}

	@Keyword
	Map<String, String> getImages(String imageGroup) {
		validateGroup(imageGroup)

		Map<String, String> images = [:]

		IMAGE_GROUPS[imageGroup].each { String key, String relativePath ->
			images[key] = getAbsolutePath(relativePath)
		}

		return images
	}

	@Keyword
	void validateGroupImagesExist(String imageGroup) {
		Map<String, String> images = getImages(imageGroup)

		images.each { String key, String path ->
			if (!new File(path).exists()) {
				KeywordUtil.markFailedAndStop(
					'Image file not found.\n' +
					'Group: ' + imageGroup + '\n' +
					'Key: ' + key + '\n' +
					'Path: ' + path
				)
			}
		}

		KeywordUtil.logInfo('All images exist for group: ' + imageGroup)
	}

	@Keyword
	boolean isVisible(String imageGroup, String imageKey) {
		String imagePath = getImage(imageGroup, imageKey)

		try {
			return isImageFound(WindowsImageKeywords.findImage(imagePath))
		} catch (Exception e) {
			return false
		}
	}

	@Keyword
	boolean isGroupVisible(String imageGroup) {
		validateGroup(imageGroup)

		for (String imageKey : IMAGE_GROUPS[imageGroup].keySet()) {
			if (isVisible(imageGroup, imageKey)) {
				KeywordUtil.logInfo('Visible image found: ' + imageGroup + ' / ' + imageKey)
				return true
			}
		}

		return false
	}

	@Keyword
	boolean waitForImage(String imageGroup, String imageKey, int timeoutSeconds) {
		String imagePath = getImage(imageGroup, imageKey)

		try {
			return WindowsImageKeywords.waitForImage(imagePath, timeoutSeconds)
		} catch (Exception e) {
			return false
		}
	}

	@Keyword
	void waitForImageOrStop(String imageGroup, String imageKey, int timeoutSeconds) {
		if (!waitForImage(imageGroup, imageKey, timeoutSeconds)) {
			KeywordUtil.markFailedAndStop(
				'Image was not visible before timeout.\n' +
				'Group: ' + imageGroup + '\n' +
				'Key: ' + imageKey + '\n' +
				'Timeout: ' + timeoutSeconds + ' seconds'
			)
		}
	}

	@Keyword
	void clickImageOrStop(String imageGroup, String imageKey) {
		String imagePath = getImage(imageGroup, imageKey)

		try {
			WindowsImageKeywords.clickImage(imagePath)
			KeywordUtil.logInfo('Clicked image: ' + imageGroup + ' / ' + imageKey)
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop(
				'Could not click image.\n' +
				'Group: ' + imageGroup + '\n' +
				'Key: ' + imageKey + '\n' +
				'Reason: ' + e.getMessage()
			)
		}
	}

	@Keyword
	void doubleClickImageOrStop(String imageGroup, String imageKey) {
		String imagePath = getImage(imageGroup, imageKey)

		try {
			WindowsImageKeywords.doubleClickImage(imagePath)
			KeywordUtil.logInfo('Double clicked image: ' + imageGroup + ' / ' + imageKey)
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop(
				'Could not double click image.\n' +
				'Group: ' + imageGroup + '\n' +
				'Key: ' + imageKey + '\n' +
				'Reason: ' + e.getMessage()
			)
		}
	}

	@Keyword
	boolean clickVisible(String imageGroup, String imageKey) {
		String imagePath = getImage(imageGroup, imageKey)

		try {
			if (isImageFound(WindowsImageKeywords.findImage(imagePath))) {
				WindowsImageKeywords.clickImage(imagePath)
				KeywordUtil.logInfo('Clicked visible image: ' + imageGroup + ' / ' + imageKey)
				return true
			}
		} catch (Exception e) {
		}

		return false
	}

	@Keyword
	boolean clickFirstVisibleInGroup(String imageGroup) {
		validateGroup(imageGroup)

		for (String imageKey : IMAGE_GROUPS[imageGroup].keySet()) {
			if (clickVisible(imageGroup, imageKey)) {
				return true
			}
		}

		return false
	}

	@Keyword
	void clickImageInsideImageOrStop(String imageGroup, String parentImageKey, String childImageKey) {
		String parentImage = getImage(imageGroup, parentImageKey)
		String childImage = getImage(imageGroup, childImageKey)

		try {
			WindowsImageKeywords.clickImageInImage(parentImage, childImage)
			KeywordUtil.logInfo('Clicked image inside image: ' + parentImageKey + ' / ' + childImageKey)
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop(
				'Could not click image inside image.\n' +
				'Group: ' + imageGroup + '\n' +
				'Parent image: ' + parentImageKey + '\n' +
				'Child image: ' + childImageKey + '\n' +
				'Reason: ' + e.getMessage()
			)
		}
	}

	@Keyword
	void takeEvidence(String fileName) {
		try {
			String evidenceDir = RunConfiguration.getReportFolder() + '\\Evidences\\'
			new File(evidenceDir).mkdirs()

			WindowsActionHelper
				.create(WindowsDriverFactory.getWindowsSession())
				.takeScreenshot(evidenceDir + fileName)

			KeywordUtil.logInfo('Evidence captured: ' + evidenceDir + fileName)
		} catch (Exception e) {
			KeywordUtil.logInfo('Could not capture evidence: ' + e.getMessage())
		}
	}

	private boolean isImageFound(def imageResult) {
		return imageResult != null && imageResult != false
	}

	private String getAbsolutePath(String relativePath) {
		return new File(RunConfiguration.getProjectDir(), relativePath).getAbsolutePath()
	}

	private void validateGroup(String imageGroup) {
		if (!IMAGE_GROUPS.containsKey(imageGroup)) {
			KeywordUtil.markFailedAndStop(
				'Image group not found: ' + imageGroup + '\n' +
				'Available groups: ' + IMAGE_GROUPS.keySet()
			)
		}
	}

	private void validateImage(String imageGroup, String imageKey) {
		validateGroup(imageGroup)

		if (!IMAGE_GROUPS[imageGroup].containsKey(imageKey)) {
			KeywordUtil.markFailedAndStop(
				'Image key not found: ' + imageKey + '\n' +
				'Group: ' + imageGroup + '\n' +
				'Available keys: ' + IMAGE_GROUPS[imageGroup].keySet()
			)
		}
	}
}
