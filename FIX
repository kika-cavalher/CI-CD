					)

			KeywordUtil.logInfo(
					'[PASS] First Grappe result row opened using Windows element.\n' +
					'Object: firstGroupResultRow'
					)

			return true
		} catch (Exception objectError) {
			KeywordUtil.logInfo(
					'[INFO] First Grappe result row could not be opened using Windows element.\n' +
					'Object: firstGroupResultRow\n' +
					'Reason: ' + safeMessage(objectError)
					)

			return false
		}
	}


	private boolean waitForSecondGroupResult(
			Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds, 10)

		String secondGroupImagePath = ''

		try {
			secondGroupImagePath =
					image(
					GUI_IMAGE_GROUP,
					'secondGroupResultPrefix'
					)
		} catch (Exception e) {
			KeywordUtil.logInfo(
					'[INFO] Could not load second Group By result image.\n' +
					'Image: secondGroupResultPrefix\n' +
					'Reason: ' + safeMessage(e)
					)
		}

		WindowsTestObject secondGroupObject = null

		try {
			secondGroupObject =
					object(
					'secondGroupResultPrefix'
					)
		} catch (Exception e) {
			KeywordUtil.logInfo(
					'[INFO] Could not load second Group By result object.\n' +
					'Object: secondGroupResultPrefix\n' +
					'Reason: ' + safeMessage(e)
					)
		}

		long endTime =
				System.currentTimeMillis() +
				(timeout * 1000L)

		while (System.currentTimeMillis() < endTime) {

			// ======================================================
			// IMAGE FIRST
			// ======================================================

			if (!secondGroupImagePath.isEmpty()) {
				try {
					def imageFound =
							WindowsImageKeywords.findImage(
							secondGroupImagePath
							)

					if (
					imageFound != null &&
							imageFound != false
							) {
						KeywordUtil.logInfo(
								'[PASS] Internal Group By row found using image.\n' +
								'Image: secondGroupResultPrefix'
								)

						return true
					}
				} catch (Exception ignored) {
				}
			}

			// ======================================================
			// WINDOWS ELEMENT FALLBACK
			// ======================================================

			if (secondGroupObject != null) {
				try {
					boolean secondGroupPresent =
							Windows.verifyElementPresent(
							secondGroupObject,
							1,
							FailureHandling.OPTIONAL
							)

					if (secondGroupPresent) {
						KeywordUtil.logInfo(
								'[PASS] Internal Group By row found using Windows element.\n' +
								'Object: secondGroupResultPrefix'
								)

						return true
					}
				} catch (Exception ignored) {
				}
			}

			Thread.sleep(250)
		}

		KeywordUtil.logInfo(
				'[INFO] Internal Group By row was not found before timeout.\n' +
				'Image: secondGroupResultPrefix\n' +
				'Object: secondGroupResultPrefix\n' +
				'Timeout: ' + timeout + ' seconds'
				)

		return false
	}



