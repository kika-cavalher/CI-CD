	@Keyword
	Map copyTableLiaisonRecordWithRandomAccount(
			String sourceAccountValue,
			Integer maximumAttempts,
			Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds)

		Integer attempts =
				maximumAttempts != null &&
				maximumAttempts > 0
				? maximumAttempts
				: 10

		String sourceAccount =
				tableLiaisonRequiredText(
				sourceAccountValue,
				'Source account'
				)

		readTableLiaisonRecordByFilter(
				sourceAccount,
				timeout
				)

		tableLiaisonClickObjectThenImage(
				'tableLiaisonCopyButton',
				IMAGE_GROUP,
				'btnCopier',
				'Copier button',
				timeout
				)

		Windows.delay(
				POLLING_DELAY_SECONDS
				)

		tableLiaisonPressTab(
				3
				)

		for (Integer attempt = 1;
				attempt <= attempts;
				attempt++) {

			String copiedAccount =
					tableLiaisonGenerateRandomAccount()

			if (attempt == 1) {
				tableLiaisonReplaceFocusedText(
						copiedAccount
						)
			} else {
				tableLiaisonReplaceObjectText(
						'tableLiaisonCompteBilanForm',
						copiedAccount,
						timeout
						)
			}

			tableLiaisonClickObjectThenImage(
					'tableLiaisonAddButton',
					IMAGE_GROUP,
					'btnAjouter',
					'Ajouter button',
					timeout
					)

			Windows.delay(
					3
					)

			if (tableLiaisonIsConfirmationDisplayed(3)) {
				KeywordUtil.logInfo(
						'[COPY] Generated account was rejected or already exists.\n' +
						'Attempt: ' +
						attempt +
						'/' +
						attempts +
						'\nGenerated account: ' +
						copiedAccount
						)

				tableLiaisonConfirmYesIfDisplayed(
						timeout
						)

				continue
			}

			Map validation =
					readTableLiaisonRecordByFilter(
					copiedAccount,
					timeout
					)

			takeEvidence(
					'TableDeLiaison_CopyRecord.png'
					)

			return [
				sourceAccount: sourceAccount,
				copiedAccount: copiedAccount,
				attemptsUsed : attempt,
				validation   : validation
			]
		}

		takeEvidence(
				'TableDeLiaison_CopyMaximumAttempts.png'
				)

		KeywordUtil.markFailedAndStop(
				'Table de Liaison COPY failed after all random account attempts.\n' +
				'Source account: ' +
				sourceAccount +
				'\nMaximum attempts: ' +
				attempts
				)

		return [:]
	}


	private void tableLiaisonApplyCompteBilanFilter(
			String account,
			Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds)
		Boolean openedByObject = false
		String objectFailureReason = ''

		WindowsTestObject filterCell =
				object(
				'tableLiaisonCompteBilanFilterCell'
				)

		try {
			if (Windows.waitForElementPresent(
					filterCell,
					Math.min(timeout, 6),
					FailureHandling.OPTIONAL
					)) {

				List<RemoteWebElement> filterElements =
						Windows.findElements(
						filterCell
						)

				if (filterElements != null &&
						!filterElements.isEmpty()) {

					RemoteWebElement filterElement =
							filterElements.get(0)

					String boundingRectangle =
							safeText(
							filterElement.getAttribute(
							'BoundingRectangle'
							)
							)

					List<String> coordinateValues =
							boundingRectangle.findAll(
							/-?\d+/
							)

					if (coordinateValues.size() >= 4) {
						Integer left =
								Integer.parseInt(
								coordinateValues.get(0)
								)

						Integer top =
								Integer.parseInt(
								coordinateValues.get(1)
								)

						Integer thirdValue =
								Integer.parseInt(
								coordinateValues.get(2)
								)

						Integer fourthValue =
								Integer.parseInt(
								coordinateValues.get(3)
								)

						Integer right =
								thirdValue > left
								? thirdValue
								: left + thirdValue

						Integer bottom =
								fourthValue > top
								? fourthValue
								: top + fourthValue

						Integer clickX =
								Math.max(
								left + 1,
								right - 12
								)

						Integer clickY =
								top +
								Math.max(
								1,
								(bottom - top).intdiv(2)
								)

						Robot robot = new Robot()

						robot.mouseMove(
								clickX,
								clickY
								)

						robot.mousePress(
								InputEvent.BUTTON1_DOWN_MASK
								)

						robot.mouseRelease(
								InputEvent.BUTTON1_DOWN_MASK
								)

						openedByObject = true

						KeywordUtil.logInfo(
								'[OBJECT] Compte de bilan filter icon clicked using BoundingRectangle.\n' +
								'BoundingRectangle: ' +
								boundingRectangle +
								'\nClick position: ' +
								clickX +
								',' +
								clickY
								)
					} else {
						objectFailureReason =
								'BoundingRectangle was empty or invalid: ' +
								boundingRectangle
					}
				} else {
					objectFailureReason =
							'No Windows element was returned for tableLiaisonCompteBilanFilterCell.'
				}
			} else {
				objectFailureReason =
						'tableLiaisonCompteBilanFilterCell was not displayed.'
			}
		} catch (Throwable objectError) {
			objectFailureReason =
					safeText(
					objectError.message
					)
		}

		if (!openedByObject) {
			KeywordUtil.logInfo(
					'[OBJECT] Compte de bilan filter could not be opened using the Windows object.\n' +
					'Reason: ' +
					objectFailureReason +
					'\nTrying image fallback.'
					)

			List<String> filterImageKeys = [
				'filterBtn',
				'filterButton'
			]

			for (String filterImageKey : filterImageKeys) {
				try {
					if (imageLoader.waitForImage(
							IMAGE_GROUP,
							filterImageKey,
							Math.min(
							timeout,
							10
							)
							)) {

						WindowsImageKeywords.clickImage(
								image(
								filterImageKey
								)
								)

						openedByObject = true

						KeywordUtil.logInfo(
								'[IMAGE] Compte de bilan filter icon clicked.\n' +
								'Image key: ' +
								filterImageKey
								)

						break
					}
				} catch (Throwable imageError) {
					KeywordUtil.logInfo(
							'[IMAGE] Could not click Compte de bilan filter using key: ' +
							filterImageKey +
							'\nReason: ' +
							safeText(
							imageError.message
							)
							)
				}
			}
		}

		if (!openedByObject) {
			takeEvidence(
					'TableDeLiaison_FilterButtonNotFound.png'
					)

			tableLiaisonStop(
					'Compte de bilan filter icon was not found by Windows object or image.\n' +
					'Object: ' +
					OBJECT_GROUP +
					'.tableLiaisonCompteBilanFilterCell\n' +
					'Images tried: ' +
					IMAGE_GROUP +
					'.filterBtn, ' +
					IMAGE_GROUP +
					'.filterButton'
					)
		}

		Windows.delay(
				POLLING_DELAY_SECONDS
				)

		WindowsTestObject filterInput =
				object(
				'filterSearchInput'
				)

		if (Windows.waitForElementPresent(
				filterInput,
				3,
				FailureHandling.OPTIONAL
				)) {

			Windows.click(
					filterInput,
					FailureHandling.OPTIONAL
					)
		}

		tableLiaisonReplaceFocusedText(
				account
				)

		tableLiaisonPressEnter()

		Windows.delay(
				2
				)
	}


	private Integer tableLiaisonWaitForResultCount(
			String account,
			Integer timeoutSeconds,
			Boolean shouldExist
	) {

		Integer timeout = safeTimeout(timeoutSeconds)

		long endTime =
				System.currentTimeMillis() +
				(timeout * 1000L)

		WindowsTestObject rowsObject =
				object(
				'tableLiaisonResultRows'
				)

		while (System.currentTimeMillis() <= endTime) {
			List<RemoteWebElement> rows = []

			try {
				rows =
						Windows.findElements(
						rowsObject
						)
			} catch (Throwable ignored) {
				rows = []
			}

			Integer count =
					rows == null
					? 0
					: rows.size()

			if (shouldExist && count > 0) {
				return count
			}

			if (!shouldExist && count == 0) {
				return 0
			}

			Windows.delay(
					POLLING_DELAY_SECONDS
					)
		}

		if (shouldExist) {
			takeEvidence(
					'TableDeLiaison_ResultNotFound.png'
					)

			tableLiaisonStop(
					'No Table de Liaison result was found.\n' +
					'Compte de bilan: ' +
					account
					)
		} else {
			takeEvidence(
					'TableDeLiaison_ResultStillPresent.png'
					)

			tableLiaisonStop(
					'The Table de Liaison result should be empty, but a record is still displayed.\n' +
					'Compte de bilan: ' +
					account
					)
		}

		return 0
	}


