    String importExecutionResults(String xmlPath) {
        if (isBlank(xmlPath)) {
            return 'ERROR: XML path is empty'
        }

        File xmlFile = new File(xmlPath)
        if (!xmlFile.exists() || !xmlFile.isFile() || xmlFile.length() <= 0) {
            return 'ERROR: XML file not found or empty'
        }

        String xmlText = xmlFile.getText('UTF-8')
        String url = owner.JIRA_BASE_URL + '/rest/raven/1.0/import/execution/junit?projectKey=' + encode(owner.PROJECT_KEY)

        Map response = sendRequest(
            'POST',
            url,
            'text/xml; charset=UTF-8',
            xmlText.getBytes(StandardCharsets.UTF_8),
            [
                'Authorization': 'Bearer ' + resolveToken(),
                'Accept'       : 'application/json'
            ]
        )

        KeywordUtil.logInfo("Import Results status: ${response.status}")
