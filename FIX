CustomKeywords.'component.RechercheFilterKeywords.applyElementValoriseAsOfDateFilter'(
	asOfDateValue,
	filterTimeout
)






package component

import java.awt.Robot
import java.awt.Toolkit
import java.awt.datatransfer.StringSelection
import java.awt.event.InputEvent
import java.awt.event.KeyEvent

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.testobject.WindowsTestObject.LocatorStrategy
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import commands.ImageLoader
import commands.WindowsObjectLoader

class RechercheFilterKeywords {

	private static final String IMAGE_GROUP = 'General'
	private static final String RECHERCHE_IMAGE_KEY = 'rechercheTab'

	private ImageLoader imageLoader = new ImageLoader()
	private Robot robot = new Robot()

	// ======================================================
	// EXISTING GENERIC FILTER FLOW
	// ======================================================

	@Keyword
	void applyFilterTestCase(
			String filterTestCase,
			String filterValue
	) {
		if (filterValue == null || filterValue.trim().isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Filter value is empty.'
					)
		}

		String safeFilterValue = filterValue.trim()

		addNote(
				'Apply Recherche filter\n' +
				'Filter value: ' + safeFilterValue + '\n' +
				'Input method: direct keyword execution\n' +
				'Note: the old FilterSection test case is not called to avoid focus issues with Katalon.'
				)

		applySectionFilter(
				safeFilterValue
				)
	}

	// ======================================================
	// EXISTING SECTION FILTER FLOW
	// ======================================================

	@Keyword
	void applySectionFilter(String sectionValue) {
		if (sectionValue == null || sectionValue.trim().isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Section value is empty.'
					)
		}

		String safeSectionValue = sectionValue.trim()

		robot.setAutoDelay(120)

		addNote(
				'Step 1. Focus eMatch application before opening Recherche tab'
				)

		focusEmatchApplication()

		addNote(
				'Step 2. Open Recherche tab'
				)

		openRechercheTab()

		addNote(
				'Step 3. Move focus to Section field using TAB\n' +
				'TAB count: 18'
				)

		focusEmatchApplication()
		pressTabTimes(18)

		addNote(
				'Step 4. Fill Section field\n' +
				'Value: ' + safeSectionValue
				)

		clearFocusedField()
		pasteText(safeSectionValue)

		addNote(
				'Step 5. Click Rechercher button'
				)

		clickRechercherButton()

		Windows.delay(10)

		imageLoader.takeEvidence(
				'Recherche_Filter_Applied.png'
				)
	}

	// ======================================================
	// ELEMENT VALORISE AS OF DATE FILTER FLOW
	// NEW ISOLATED COMMAND
	// ======================================================

	@Keyword
	void applyElementValoriseAsOfDateFilter(
			String asOfDateValue,
			Integer timeoutSeconds
	) {
		if (asOfDateValue == null || asOfDateValue.trim().isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'As Of Date value is empty.'
					)
		}

		String safeAsOfDateValue = asOfDateValue.trim()
		Integer safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0
				? 5
				: timeoutSeconds

		robot.setAutoDelay(120)

		addNote(
				'Apply Element Valorise As Of Date filter\n' +
				'Value: ' + safeAsOfDateValue + '\n' +
				'TAB count: 2'
				)

		addNote(
				'Step 1. Focus eMatch application'
				)

		focusEmatchApplication()

		addNote(
				'Step 2. Open Recherche tab'
				)

		openRechercheTab()

		addNote(
				'Step 3. Move focus to As Of Date field\n' +
				'TAB count: 2'
				)

		pressTabTimes(2)

		addNote(
				'Step 4. Clear As Of Date field'
				)

		clearFocusedField()

		addNote(
				'Step 5. Type As Of Date value\n' +
				'Value: ' + safeAsOfDateValue
				)

		typeTextForElementValorise(
				safeAsOfDateValue
				)

		addNote(
				'Step 6. Click Rechercher button'
				)

		clickRechercherButtonForElementValorise(
				safeTimeout
				)

		Windows.delay(safeTimeout)

		imageLoader.takeEvidence(
				'Recherche_ElementValorise_AsOfDate_Applied.png'
				)
	}

	// ======================================================
	// OPEN RECHERCHE TAB
	// EXISTING COMMAND
	// ======================================================

	private void openRechercheTab() {
		focusEmatchApplication()

		WindowsTestObject rechercheTabObject = buildXpathObject(
				"//*[@Name='Recherche' or contains(@Name,'Recherche')]"
				)

		if (Windows.verifyElementPresent(
				rechercheTabObject,
				3,
				FailureHandling.OPTIONAL
				)) {
			clickElementCenterByCoordinates(
					rechercheTabObject
					)

			Windows.delay(2)
			return
		}

		addNote(
				'Recherche tab was not found by element. Trying image fallback inside eMatch.'
				)

		if (!imageLoader.waitForImage(
				IMAGE_GROUP,
				RECHERCHE_IMAGE_KEY,
				5
				)) {
			imageLoader.takeEvidence(
					'RechercheTabNotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					'Recherche tab was not found.\n' +
					'Expected element name: Recherche\n' +
					'Expected image key: ' + RECHERCHE_IMAGE_KEY
					)
		}

		String rechercheImagePath = imageLoader.getImage(
				IMAGE_GROUP,
				RECHERCHE_IMAGE_KEY
				)

		WindowsImageKeywords.clickImage(
				rechercheImagePath
				)

		Windows.delay(2)

		focusEmatchApplication()
	}

	// ======================================================
	// EXISTING RECHERCHER BUTTON COMMAND
	// ======================================================

	private void clickRechercherButton() {
		focusEmatchApplication()

		WindowsTestObject rechercherButton = null

		try {
			rechercherButton = WindowsObjectLoader.getObject(
					'filter',
					'rechercherButton'
					)

			if (Windows.verifyElementPresent(
					rechercherButton,
					3,
					FailureHandling.OPTIONAL
					)) {
				clickElementCenterByCoordinates(
						rechercherButton
						)

				Windows.delay(2)
				return
			}
		} catch (Exception ignored) {
		}

		try {
			rechercherButton = WindowsObjectLoader.getObject(
					'filter',
					'rechercherButtonByName'
					)

			if (Windows.verifyElementPresent(
					rechercherButton,
					3,
					FailureHandling.OPTIONAL
					)) {
				clickElementCenterByCoordinates(
						rechercherButton
						)

				Windows.delay(2)
				return
			}
		} catch (Exception ignored) {
		}

		imageLoader.takeEvidence(
				'RechercherButtonNotFound.png'
				)

		KeywordUtil.markFailedAndStop(
				'Rechercher button was not found.'
				)
	}

	// ======================================================
	// ELEMENT VALORISE RECHERCHER BUTTON COMMAND
	// NEW ISOLATED COMMAND
	// ======================================================

	private void clickRechercherButtonForElementValorise(
			Integer timeoutSeconds
	) {
		Integer safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0
				? 5
				: timeoutSeconds

		List<String> objectNames = [
			'rechercherButton',
			'rechercherButtonByName'
		]

		for (String objectName : objectNames) {
			try {
				WindowsTestObject rechercherButton =
						WindowsObjectLoader.getObject(
						'filter',
						objectName
						)

				boolean isPresent = Windows.verifyElementPresent(
						rechercherButton,
						safeTimeout,
						FailureHandling.OPTIONAL
						)

				if (isPresent) {
					Windows.click(
							rechercherButton
							)

					Windows.delay(2)

					KeywordUtil.logInfo(
							'Element Valorise Rechercher button clicked.\n' +
							'Object: ' + objectName
							)

					return
				}
			} catch (Exception objectError) {
				KeywordUtil.logInfo(
						'Element Valorise Rechercher candidate was not available.\n' +
						'Object: ' + objectName + '\n' +
						'Reason: ' + objectError.getMessage()
						)
			}
		}

		imageLoader.takeEvidence(
				'ElementValoriseRechercherButtonNotFound.png'
				)

		KeywordUtil.markFailedAndStop(
				'Element Valorise Rechercher button was not found.'
				)
	}

	// ======================================================
	// FOCUS EMATCH APPLICATION
	// EXISTING COMMAND
	// ======================================================

	private void focusEmatchApplication() {
		List<WindowsTestObject> candidates = []

		candidates.add(
				buildXpathObject(
				"//*[contains(@Name,'eMatch') and (@LocalizedControlType='window' or contains(@ControlType,'Window'))]"
				)
				)

		candidates.add(
				buildXpathObject(
				"//*[contains(@Name,'eMatch')]"
				)
				)

		for (WindowsTestObject candidate : candidates) {
			try {
				if (Windows.verifyElementPresent(
						candidate,
						2,
						FailureHandling.OPTIONAL
						)) {
					clickElementCenterByCoordinates(
							candidate
							)

					Windows.delay(1)
					return
				}
			} catch (Exception ignored) {
			}
		}

		addNote(
				'eMatch window was not focused by object. Continuing with current Windows session.'
				)
	}

	// ======================================================
	// KEYBOARD COMMANDS
	// ======================================================

	private void pressTabTimes(Integer times) {
		int safeTimes = times == null || times <= 0
				? 1
				: times

		for (int index = 1; index <= safeTimes; index++) {
			robot.keyPress(
					KeyEvent.VK_TAB
					)

			robot.keyRelease(
					KeyEvent.VK_TAB
					)

			Thread.sleep(120)
		}
	}

	private void clearFocusedField() {
		robot.keyPress(
				KeyEvent.VK_CONTROL
				)

		robot.keyPress(
				KeyEvent.VK_A
				)

		robot.keyRelease(
				KeyEvent.VK_A
				)

		robot.keyRelease(
				KeyEvent.VK_CONTROL
				)

		Thread.sleep(150)

		robot.keyPress(
				KeyEvent.VK_BACK_SPACE
				)

		robot.keyRelease(
				KeyEvent.VK_BACK_SPACE
				)

		Thread.sleep(150)
	}

	private void pasteText(String text) {
		StringSelection selection = new StringSelection(
				text
				)

		Toolkit
				.getDefaultToolkit()
				.getSystemClipboard()
				.setContents(
				selection,
				null
				)

		robot.keyPress(
				KeyEvent.VK_CONTROL
				)

		robot.keyPress(
				KeyEvent.VK_V
				)

		robot.keyRelease(
				KeyEvent.VK_V
				)

		robot.keyRelease(
				KeyEvent.VK_CONTROL
				)

		Thread.sleep(300)
	}

	// ======================================================
	// ELEMENT VALORISE DIRECT TYPING
	// NEW ISOLATED COMMAND
	// ======================================================

	private void typeTextForElementValorise(String text) {
		if (text == null || text.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Element Valorise text value is empty.'
					)
		}

		for (int index = 0; index < text.length(); index++) {
			char character = text.charAt(index)

			int keyCode = KeyEvent.getExtendedKeyCodeForChar(
					character
					)

			if (keyCode == KeyEvent.VK_UNDEFINED) {
				KeywordUtil.markFailedAndStop(
						'Could not type character in Element Valorise field.\n' +
						'Character: ' + character
						)
			}

			robot.keyPress(
					keyCode
					)

			robot.keyRelease(
					keyCode
					)

			Thread.sleep(80)
		}

		Thread.sleep(300)
	}

	// ======================================================
	// WINDOWS OBJECT COMMANDS
	// ======================================================

	private void clickElementCenterByCoordinates(
			WindowsTestObject object
	) {
		def rect = Windows.getElementRect(
				object
				)

		int x = rect.getX() +
				Math.floor(
				rect.getWidth() / 2
				).intValue()

		int y = rect.getY() +
				Math.floor(
				getSafeHeight(rect) / 2
				).intValue()

		mouseClick(
				x,
				y
				)
	}

	private void mouseClick(
			int x,
			int y
	) {
		robot.mouseMove(
				x,
				y
				)

		Thread.sleep(100)

		robot.mousePress(
				InputEvent.BUTTON1_DOWN_MASK
				)

		Thread.sleep(100)

		robot.mouseRelease(
				InputEvent.BUTTON1_DOWN_MASK
				)

		Thread.sleep(200)
	}

	private int getSafeHeight(def rect) {
		int height = rect.getHeight()

		if (height <= 0) {
			return 20
		}

		return height
	}

	private WindowsTestObject buildXpathObject(
			String xpath
	) {
		WindowsTestObject object = new WindowsTestObject()

		object.setLocatorStrategy(
				LocatorStrategy.XPATH
				)

		object.setLocator(
				xpath
				)

		return object
	}

	// ======================================================
	// REPORT COMMAND
	// ======================================================

	private void addNote(String message) {
		try {
			new jiraIntegration.JiraReportSteps().note(
					message
					)
		} catch (Throwable ignored) {
			KeywordUtil.logInfo(
					message
					)
		}
	}
}
