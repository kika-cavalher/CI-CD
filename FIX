firstPresent
private Object firstPresent(Object... values) {
	if (values == null) {
		return null
	}

	for (Object value : values) {
		if (value == null) {
			continue
		}

		if (value instanceof CharSequence && safeValue(value).isEmpty()) {
			continue
		}

		return value
	}

	return null
}
firstNonBlank
private String firstNonBlank(Object... values) {
	if (values == null) {
		return ''
	}
	return firstNonBlankFromCollection(values.toList())
}
firstNonBlank(Collection values)
private String firstNonBlank(Collection values) {
	return firstNonBlankFromCollection(values)
}
firstNonBlankFromCollection
private String firstNonBlankFromCollection(Collection values) {
	if (values == null) {
		return ''
	}

	for (def value : values) {
		String text = safeValue(value)
		if (!text.isEmpty()) {
			return text
		}
	}

	return ''
}
normalizeEvidence
private List<Map> normalizeEvidence(Map item, Map model) {
	List rawEvidence = asList(firstPresent(
		item.evidence,
		item.evidences,
		item.images,
		item.attachments
	))

	String baseFolder = firstNonBlank(
		item.reportFolder,
		model.reportFolder,
		model.baseFolder,
		model.executionFolder
	)

	List<Map> result = []

	rawEvidence.each { def raw ->
		if (raw == null) {
			return
		}

		String name = ''
		String path = ''
		String href = ''
		String imgSrc = ''
		boolean image = false

		if (raw instanceof Map) {
			name = firstNonBlank(raw.name, raw.fileName, raw.title, raw.label)
			path = firstNonBlank(raw.path, raw.absolutePath, raw.file, raw.relativePath)
			href = firstNonBlank(raw.href)
			imgSrc = firstNonBlank(raw.imageSrc, raw.href)
			image = Boolean.TRUE.equals(raw.image)
		} else {
			path = safeValue(raw)
			name = new File(path).name
		}

		File resolved = resolveFile(path, baseFolder)

		if (resolved != null && resolved.exists()) {
			String resolvedHref = resolved.toURI().toString()

			if (href.isEmpty()) {
				href = resolvedHref
			}
			if (imgSrc.isEmpty()) {
				imgSrc = resolvedHref
			}
			if (!image) {
				image = isImageFile(resolved.name)
			}
			if (name.isEmpty()) {
				name = resolved.name
			}
		}

		if (name.isEmpty()) {
			name = 'Evidence'
		}

		boolean hasUsableLink = !safeValue(href).isEmpty() || !safeValue(imgSrc).isEmpty()
		if (!hasUsableLink) {
			return
		}

		result.add([
			name  : name,
			href  : href,
			image : image,
			imgSrc: imgSrc
		])
	}

	return result
}
resolveFile
private File resolveFile(String path, String baseFolder) {
	String raw = safeValue(path)
	if (raw.isEmpty()) {
		return null
	}

	try {
		if (raw.toLowerCase(Locale.ENGLISH).startsWith('file:/')) {
			File uriFile = new File(new URI(raw))
			if (uriFile.exists()) {
				return uriFile
			}
		}
	} catch (Exception ignored) {
	}

	File direct = new File(raw)
	if (direct.exists()) {
		return direct
	}

	if (!safeValue(baseFolder).isEmpty()) {
		File byBase = new File(baseFolder, raw)
		if (byBase.exists()) {
			return byBase
		}
	}

	return direct
}
