	private String limitVisualError(String text) {
		List<String> lines = safeValue(text)
				.readLines()
				.collect { safeValue(it) }
				.findAll { !it.isEmpty() }

		if (lines.isEmpty()) {
			return ''
		}

		int reasonIndex = lines.findIndexOf {
			String lower = it.toLowerCase(Locale.ENGLISH)
			lower == 'reason:' || lower.startsWith('reason:')
		}

		if (reasonIndex < 0) {
			int max = Math.min(lines.size(), 4)
			String summary = lines.take(max).join('\\n')
			if (lines.size() > max) {
				summary += '\\n...'
			}
			return summary
		}

		List<String> result = []

		if (reasonIndex > 0) {
			result << lines[0]
		}

		result << lines[reasonIndex]

		int start = reasonIndex + 1
		int end = Math.min(lines.size(), start + 3)

		for (int i = start; i < end; i++) {
			result << lines[i]
		}

		if (lines.size() > end) {
			result << '...'
		}

		return result.join('\\n')
	}
