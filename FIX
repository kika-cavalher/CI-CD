def runSuite(scriptRef, Map suite, int timeoutMinutes) {
    def suiteReportDir = "${scriptRef.env.REPORTS_DIR}\\${suite.folder}"
    def suiteLogFile   = "${scriptRef.env.LOGS_DIR}\\${suite.folder}.log"
    def exitCode       = 999
    def timedOut       = false

    scriptRef.catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
        try {
            scriptRef.echo '╔════════════════════════════════════════════════════════════╗'
            scriptRef.echo "║ 🚀 STARTING SUITE".padRight(60) + '║'
            scriptRef.echo "║ ${suite.label}".padRight(60) + '║'
            scriptRef.echo "║ 📁 ${suite.path}".padRight(60) + '║'
            scriptRef.echo "║ ⏱️ ${timeoutMinutes} min timeout".padRight(60) + '║'
            scriptRef.echo '╚════════════════════════════════════════════════════════════╝'

            scriptRef.bat """
                @echo off
                if exist "${suiteReportDir}" rmdir /s /q "${suiteReportDir}"
                mkdir "${suiteReportDir}"
                if exist "${suiteLogFile}" del /f /q "${suiteLogFile}" >nul 2>&1
            """

            scriptRef.timeout(time: timeoutMinutes, unit: 'MINUTES') {
                exitCode = scriptRef.bat(
                    returnStatus: true,
                    script: """
                        @echo off
                        call "${scriptRef.env.KATALON_EXE}" ^
                        -noSplash ^
                        -runMode=console ^
                        -consoleLog ^
                        -projectPath="${scriptRef.env.PROJECT_PATH}" ^
                        -retry=0 ^
                        -testSuitePath="${suite.path}" ^
                        -browserType="${scriptRef.env.BROWSER_TYPE}" ^
                        -executionProfile="${scriptRef.env.EXEC_PROFILE}" ^
                        -reportFolder="${suiteReportDir}" ^
                        -reportFileName="${suite.folder}" > "${suiteLogFile}" 2>&1

                        exit /b %%ERRORLEVEL%%
                    """
                )
            }
        } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException ex) {
            timedOut = true
            exitCode = 130
            throw ex
        } finally {
            def summary = summarizeSuite(scriptRef, suite, suiteReportDir, suiteLogFile, exitCode, timedOut)
            saveSuiteSummary(scriptRef, suite.folder, summary)
            printSuiteSummary(scriptRef, summary)
            printExecutionSummary(scriptRef)
        }

        if (exitCode != 0) {
            scriptRef.error("Suite ${suite.label} failed with exit code ${exitCode}")
        }
    }
}

def summarizeSuite(scriptRef, Map suite, String suiteReportDir, String suiteLogFile, int exitCode, boolean timedOut) {
    def junitFile = findJUnitFile(scriptRef, suiteReportDir)
    def htmlFile  = findHtmlReport(scriptRef, suiteReportDir)

    int executed = 0
    int passed = 0
    int failed = 0
    int skipped = 0
    String reason = ''
    String mood = ''
    String shortLine2 = ''

    if (junitFile) {
        def xml = new XmlSlurper(false, false).parseText(scriptRef.readFile(file: junitFile))
        def testcases = xml.'**'.findAll { it.name() == 'testcase' }
        def failedCases = testcases.findAll { it.failure.size() > 0 || it.error.size() > 0 }
        def skippedCases = testcases.findAll { it.skipped.size() > 0 }

        executed = testcases.size()
        failed   = failedCases.size()
        skipped  = skippedCases.size()
        passed   = Math.max(0, executed - failed - skipped)

        if (failedCases) {
            def firstFail = failedCases[0]
            def rawReason = ''
            if (firstFail.failure.size() > 0) {
                rawReason = firstFail.failure[0].@message?.text()
                if (!rawReason?.trim()) {
                    rawReason = firstFail.failure[0].text()
                }
            } else if (firstFail.error.size() > 0) {
                rawReason = firstFail.error[0].@message?.text()
                if (!rawReason?.trim()) {
                    rawReason = firstFail.error[0].text()
                }
            }
            reason = cleanReason(rawReason)
        }
    }

    if (timedOut) {
        mood = '⏰'
        shortLine2 = 'Execution timed out | Suite exceeded allowed time | Review timeout or slow steps'
        if (!reason) {
            reason = shortLine2
        }
    } else if (exitCode == 0) {
        mood = '✅'
        shortLine2 = executed > 0 ? "${passed}/${executed} test cases passed" : 'Suite finished successfully'
    } else {
        mood = '❌'
        shortLine2 = reason ? reason : "Suite failed | Exit code ${exitCode} | Review execution log"
    }

    return [
        label     : suite.label,
        path      : suite.path,
        folder    : suite.folder,
        exitCode  : exitCode,
        timedOut  : timedOut,
        status    : exitCode == 0 ? 'PASSED' : (timedOut ? 'TIMEOUT' : 'FAILED'),
        executed  : executed,
        passed    : passed,
        failed    : failed,
        skipped   : skipped,
        reason    : reason ?: '',
        mood      : mood,
        line2     : shortLine2,
        html      : htmlFile ?: '',
        junit     : junitFile ?: ''
    ]
}

def printSuiteSummary(scriptRef, Map summary) {
    scriptRef.echo '╔════════════════════════════════════════════════════════════╗'
    scriptRef.echo "║ ${summary.mood}".padRight(60) + '║'
    scriptRef.echo "║ ${summary.label}".padRight(60) + '║'
    scriptRef.echo "║ ${summary.line2 ?: ''}".padRight(60) + '║'
    scriptRef.echo "║ Executed: ${summary.executed} | Passed: ${summary.passed} | Failed: ${summary.failed} | Skipped: ${summary.skipped}".padRight(60) + '║'
    scriptRef.echo '╚════════════════════════════════════════════════════════════╝'
}

def printExecutionSummary(scriptRef) {
    def results = loadSuiteResults(scriptRef)
    def values = results.values() as List
    def passed = values.count { it.status == 'PASSED' }
    def failed = values.count { it.status == 'FAILED' }
    def timeout = values.count { it.status == 'TIMEOUT' }

    scriptRef.echo '============================================================'
    scriptRef.echo "📌 EXECUTION SUMMARY | Passed: ${passed} | Failed: ${failed} | Timeout: ${timeout}"
    scriptRef.echo '============================================================'
}

def saveSuiteSummary(scriptRef, String key, Map summary) {
    def current = loadSuiteResults(scriptRef)
    current[key] = summary
    writeFile file: scriptRef.env.RESULTS_JSON, text: JsonOutput.prettyPrint(JsonOutput.toJson(current))
}

def loadSuiteResults(scriptRef) {
    if (!scriptRef.fileExists(scriptRef.env.RESULTS_JSON)) {
        return [:]
    }
    def txt = scriptRef.readFile(file: scriptRef.env.RESULTS_JSON).trim()
    if (!txt) {
        return [:]
    }
    return new JsonSlurperClassic().parseText(txt) as Map
}

def findJUnitFile(scriptRef, String suiteReportDir) {
    def out = scriptRef.powershell(
        returnStdout: true,
        script: """
            \$base = "${suiteReportDir}"
            if (!(Test-Path \$base)) { exit 0 }
            \$f = Get-ChildItem -Path \$base -Recurse -File -Include 'JUnit_Report.xml','junit*.xml','JUnit*.xml','TEST-*.xml' -ErrorAction SilentlyContinue | Select-Object -First 1
            if (\$f) { Write-Output \$f.FullName }
        """
    ).trim()
    return out ?: ''
}

def findHtmlReport(scriptRef, String suiteReportDir) {
    def out = scriptRef.powershell(
        returnStdout: true,
        script: """
            \$base = "${suiteReportDir}"
            if (!(Test-Path \$base)) { exit 0 }
            \$f = Get-ChildItem -Path \$base -Recurse -File -Include '*.html' -ErrorAction SilentlyContinue |
                 Where-Object { \$_.Name -ne 'index.html' } |
                 Select-Object -First 1
            if (\$f) {
                \$full = \$f.FullName
                \$root = "${scriptRef.env.REPORTS_DIR}\\"
                if (\$full.StartsWith(\$root)) {
                    Write-Output (\$full.Substring(\$root.Length).Replace('\\\\','/'))
                }
            }
        """
    ).trim()
    return out ?: ''
}

def cleanReason(String raw) {
    if (!raw) {
        return ''
    }

    def text = raw
        .replace('\r', '\n')
        .split('\n')
        .collect { it.trim() }
        .findAll { it }
        .take(3)
        .join(' | ')

    text = text.replaceAll('\\s+', ' ').trim()

    if (text.toLowerCase().contains('timed out')) {
        return 'Execution timed out | Suite exceeded allowed time | Review timeout or slow steps'
    }
    if (text.toLowerCase().contains('not found')) {
        return 'Required item not found | A file, element, or object was missing | Review locators or test data'
    }
    if (text.toLowerCase().contains('unable to recognize image')) {
        return 'Visual validation failed | Expected image was not recognized on screen | Review image baseline or screen state'
    }
    if (text.toLowerCase().contains('stepfailedexception')) {
        return 'Validation step failed | One mandatory verification did not pass | Review failed test step'
    }

    return text
}

def buildDashboard(scriptRef) {
    if (!scriptRef.fileExists(scriptRef.env.REPORTS_DIR)) {
        return
    }

    def results = loadSuiteResults(scriptRef)
    def ordered = getTestSuites().collect { suite ->
        results[suite.folder] ?: [
            label    : suite.label,
            path     : suite.path,
            folder   : suite.folder,
            status   : 'NOT EXECUTED',
            executed : 0,
            passed   : 0,
            failed   : 0,
            skipped  : 0,
            line2    : '',
            html     : ''
        ]
    }

    def listHtml = ordered.collect { item ->
        def css = item.status == 'PASSED' ? 'pass' : (item.status == 'TIMEOUT' ? 'timeout' : (item.status == 'FAILED' ? 'fail' : 'neutral'))
        def reportLink = item.html ? "<a href='../${escapeHtml(item.html)}' target='_blank'>Open suite report</a>" : "<span>No remote report available</span>"

        return """
        <div class="card ${css}">
            <div class="title">${escapeHtml(item.label)}</div>
            <div class="line">${escapeHtml(item.mood ?: '')}</div>
            <div class="line">${escapeHtml(item.line2 ?: '')}</div>
            <div class="meta">Executed: ${item.executed} | Passed: ${item.passed} | Failed: ${item.failed} | Skipped: ${item.skipped}</div>
            <div class="meta">${reportLink}</div>
        </div>
        """
    }.join('\n')

    def html = """
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Gaia Test Report</title>
<style>
body { font-family: Arial, sans-serif; background:#f7f8fc; color:#1f2937; margin:0; padding:24px; }
h1 { margin:0 0 6px 0; font-size:28px; }
.sub { color:#6b7280; margin-bottom:24px; }
.grid { display:grid; grid-template-columns:repeat(2,minmax(320px,1fr)); gap:16px; }
.card { background:#fff; border-radius:16px; padding:18px; box-shadow:0 2px 8px rgba(0,0,0,.08); border-left:8px solid #cbd5e1; }
.card.pass { border-left-color:#22c55e; }
.card.fail { border-left-color:#ef4444; }
.card.timeout { border-left-color:#f59e0b; }
.card.neutral { border-left-color:#94a3b8; }
.title { font-size:18px; font-weight:700; margin-bottom:10px; }
.line { margin-bottom:8px; }
.meta { color:#475569; font-size:13px; margin-top:8px; }
a { color:#2563eb; text-decoration:none; font-weight:600; }
</style>
</head>
<body>
    <h1>Gaia Test Report</h1>
    <div class="sub">Build #${escapeHtml(scriptRef.env.BUILD_NUMBER)} | Gaia Corrections</div>
    <div class="grid">
        ${listHtml}
    </div>
</body>
</html>
"""
    writeFile file: "${scriptRef.env.DASHBOARD_DIR}\\index.html", text: html
}

def escapeHtml(String value) {
    if (value == null) {
        return ''
    }
    return value
        .replace('&', '&amp;')
        .replace('<', '&lt;')
        .replace('>', '&gt;')
        .replace('"', '&quot;')
        .replace("'", '&#39;')
}

def stopGaiaProcessesFast(scriptRef, String reason) {
    scriptRef.echo "🧹 Stopping Gaia processes | ${reason}"

    scriptRef.bat(
        returnStatus: true,
        script: """
            @echo off
            schtasks /end /tn "${scriptRef.env.GAIA_START_TASK}" >nul 2>&1

            taskkill /f /t /im katalonc.exe >nul 2>&1
            taskkill /f /t /im KatalonStudio.exe >nul 2>&1
            taskkill /f /t /im chrome.exe >nul 2>&1
            taskkill /f /t /im chromedriver.exe >nul 2>&1
            taskkill /f /t /im notepad.exe >nul 2>&1
            taskkill /f /t /im cmd.exe >nul 2>&1

            exit /b 0
        """
    )
}
