CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Logging through native controls')
CustomKeywords.'pageObject.authentication.loginThroughNativeControls'(GlobalVariable.env)







@Keyword
void loginThroughNativeControls() {
    loginThroughNativeControls(safe(GlobalVariable.env) ?: 'REC')
}

@Keyword
void loginThroughNativeControls(String env) {
    String resolvedEnv = safe(env) ?: safe(GlobalVariable.env) ?: 'REC'

    KeywordUtil.logInfo("Logging through native controls for env ${resolvedEnv}")

    selectEnvironment(resolvedEnv)
    sleepMs(1000)

    boolean isButtonPresent = isConnectButtonPresent()

    if (isButtonPresent) {
        KeywordUtil.logInfo("Connect button was present and will be clicked.")
        clickConnectButton()
    } else {
        KeywordUtil.logInfo("Connect button was not present. Continuing test execution.")
    }

    boolean mainScreenLoaded = waitForMainScreen()

    if (!mainScreenLoaded) {
        KeywordUtil.markFailedAndStop(
            "eMatch main screen was not loaded. Object 'General/txtSearch' not found."
        )
    }

    activateHomeTab()
    KeywordUtil.logInfo("eMatch startup flow completed successfully for environment ${resolvedEnv}")
}
