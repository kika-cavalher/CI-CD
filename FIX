    def timeout = results.count { it.status == 'TIMEOUT' }

    script.echo '============================================================'
    script.echo "📌 EXECUTION SUMMARY | Passed: ${passed} | Failed: ${failed} | Timeout: ${timeout}"
    script.echo '============================================================'
}

def printFinalSummary(script, List results, String currentResult) {
    def passed = results.count { it.status == 'PASSED' }
    def failed = results.count { it.status == 'FAILED' }
    def timeout = results.count { it.status == 'TIMEOUT' }

    script.echo '============================================================'

    if (currentResult == 'ABORTED') {
        script.echo '🛑 PIPELINE ABORTED'
    } else if (failed > 0 || timeout > 0) {
        script.echo '❌ PIPELINE FINISHED WITH ERRORS'
    } else {
        script.echo '✅ PIPELINE FINISHED SUCCESSFULLY'
    }

    script.echo "📌 FINAL SUMMARY | Passed: ${passed} | Failed: ${failed} | Timeout: ${timeout}"
    script.echo '============================================================'
}

def parseKeyValue(String text) {
    def map = [:]

    if (!text) {
        return map
    }

    text.readLines().each { line ->
        int idx = line.indexOf('=')
        if (idx > 0) {
            def key = line.substring(0, idx).trim()
            def value = line.substring(idx + 1).trim()
            map[key] = value
        }
    }

    return map
}

def splitCaseSummary(String value) {
    if (!value?.trim()) {
        return []
    }

    return value.split('\\|\\|').collect { it.trim() }.findAll { it }
}

def safeFileName(String value) {
    return (value ?: '').replaceAll(/[^A-Za-z0-9._ -]/, '').replace(' ', '_')
}

def fitText(String value, int width) {
    def text = (value ?: '').replaceAll(/\s+/, ' ').trim()

    if (text.size() > width) {
        return text.take(width - 3) + '...'
    }

    return text.padRight(width)
}

def escapeHtml(Object value) {
    def text = value == null ? '' : value.toString()
    text = text.replace('&', '&amp;')
    text = text.replace('<', '&lt;')
    text = text.replace('>', '&gt;')
    text = text.replace('"', '&quot;')
    text = text.replace("'", '&#39;')
    return text
}

