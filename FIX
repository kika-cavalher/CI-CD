pipeline {
    agent { label 'GI5_SWDCFRNXGI55817' }

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        timeout(time: 4, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    environment {
        EMATCH_STARTERS_DIR = 'D:\\Projects\\eMatchStarters'
        CTX_FILE            = 'D:\\Projects\\eMatchStarters\\run-context.properties'
        LOGS_DIR            = 'D:\\Projects\\eMatchStarters\\logs'
        TASK_NAME           = '\\eMatch Automation\\RunEmatchDesktop'
        BROWSER_TYPE        = 'Windows'
        RETRY               = '0'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Context') {
            steps {
                script {
                    def ws          = pwd()
                    def projectPath  = "${ws}\\eMatch Regression\\Archive Mode\\eMatch POC.prj"
                    def katalonExe   = "C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0\\katalonc.exe"
                    def collection   = "Test Suites/Archive Mode/Archive Mode Collection"

                    def ematchAppPath = env.EMATCH_APP_PATH ?: ''

                    bat """
                        if not exist "${env.LOGS_DIR}" mkdir "${env.LOGS_DIR}"

                        set "MARKER_FILE=${env.LOGS_DIR}\\__jenkins_task_exitcode_jenkins-GI5-eMatch_Regression-Archive_Mode-${env.BUILD_NUMBER}.txt"
                        set "LOG_FILE=${env.LOGS_DIR}\\katalon_${new Date().format('yyyyMMdd_HHmmss')}_${env.BUILD_NUMBER}.log"

                        del /f /q "%MARKER_FILE%" 2>nul

                        (
                            echo WORKSPACE=${ws}
                            echo PROJECT_PATH=${projectPath}
                            echo KATALON_EXE=${katalonExe}
                            echo COLLECTION_PATH=${collection}
                            echo BROWSER_TYPE=${env.BROWSER_TYPE}
                            echo RETRY=${env.RETRY}
                            echo LOG_FILE=%LOG_FILE%
                            echo MARKER_FILE=%MARKER_FILE%
                            echo EMATCH_APP_PATH=${ematchAppPath}
                        ) > "${env.CTX_FILE}"

                        type "${env.CTX_FILE}"
                    """
                }
            }
        }

        stage('Run Desktop (Task Scheduler)') {
            steps {
                script {
                    bat """
                        echo [INFO] Running Task Scheduler: ${env.TASK_NAME}
                        schtasks /run /tn "${env.TASK_NAME}"
                        echo [INFO] Task triggered.
                    """

                    def markerPath = "${env.LOGS_DIR}\\__jenkins_task_exitcode_jenkins-GI5-eMatch_Regression-Archive_Mode-${env.BUILD_NUMBER}.txt"

                    timeout(time: 3, unit: 'HOURS') {
                        waitUntil {
                            sleep(time: 3, unit: 'SECONDS')
                            return fileExists(markerPath)
                        }
                    }

                    def exitCodeRaw = readFile(markerPath).trim()
                    echo "[INFO] Exit code read: '${exitCodeRaw}'"

                    int code = 999
                    try {
                        code = Integer.parseInt(exitCodeRaw)
                    } catch (ignored) {
                        code = 999
                    }

                    if (code != 0) {
                        error("Desktop run failed. ExitCode=${code}. Check logs in ${env.LOGS_DIR}")
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                echo "[INFO] Archiving artifacts (safe mode)"

                try {
                    archiveArtifacts artifacts: 'Reports/**/*', allowEmptyArchive: true
                } catch (ignored) {
                    echo "[WARN] archiveArtifacts Reports failed (ignored)"
                }

                try {
                    archiveArtifacts artifacts: '**/*.log', allowEmptyArchive: true
                } catch (ignored) {
                    echo "[WARN] archiveArtifacts *.log failed (ignored)"
                }
            }
        }
    }
}
