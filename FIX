import java.io.File

import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil

String testCaseName = 'Export File Validation'

String baseExportFolderPath = resolveExecutionExportFolder().getAbsolutePath()

String requestedFileNames = ''
String includeSubFolders = 'true'
String minimumExpectedFiles = '3'

String defaultValidationType = 'Mixte'
String sheetIndex = '0'

String headerCurrency = 'Devise'
String headerCurrencyRef = 'Devise de ref.'
String headerAmountCcy = 'Montant ccy'
String headerAmountBaseCcy = 'Montant base ccy'

String discrepancyKeyHeaders = ''
String discrepancyCompareHeaders = 'Montant ccy|Montant base ccy'

String maxErrorsPerFile = '5'
String maxGeneralErrors = '10'

String allErrors = ''
String filesToValidate = ''
Boolean validationFailed = false

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'✅ [START] ' + testCaseName
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'⚙️ [CONFIG]\n' +
		'Base export folder: ' + baseExportFolderPath + '\n' +
		'Requested files: ' + (requestedFileNames?.trim() ? requestedFileNames : 'Auto resolve from folder') + '\n' +
		'Include subfolders: ' + includeSubFolders + '\n' +
		'Minimum expected files: ' + minimumExpectedFiles + '\n' +
		'Default validation type: ' + defaultValidationType + '\n' +
		'Sheet index: ' + sheetIndex
)

def reportValidation = { String validationName, String validationResult, String filesText ->
	String result = validationResult == null ? '' : validationResult.trim()
	List<File> files = parseFileList(filesText)

	String visualReport = buildVisualValidationReport(
			validationName,
			result,
			files,
			maxErrorsPerFile,
			maxGeneralErrors
	)

	if (isSkippedResult(result)) {
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
				'⚠️ [SKIPPED] ' + validationName + '\n' +
				visualReport
		)

		return
	}

	if (hasValidationFailure(result)) {
		validationFailed = true

		allErrors = allErrors +
				'\n\n========== ' + validationName + ' ==========\n' +
				visualReport

		KeywordUtil.markFailed(
				'❌ [FAIL] ' + validationName + '\n' +
				visualReport
		)

		return
	}

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
			'✅ [PASS] ' + validationName + '\n' +
			visualReport
	)
}

String validationResult = ''

validationResult = CustomKeywords.'commands.ExportFileValidationKeywords.validateEvidenceFolderExists'(
		baseExportFolderPath
)

String folderReport = buildFolderReport(baseExportFolderPath, validationResult)

if (hasValidationFailure(validationResult)) {
	validationFailed = true

	allErrors = allErrors +
			'\n\n========== Validate export folder exists ==========\n' +
			folderReport

	KeywordUtil.markFailed(
			'❌ [FAIL] Validate export folder exists\n' +
			folderReport
	)
} else {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
			'✅ [PASS] Validate export folder exists\n' +
			folderReport
	)
}

if (!hasValidationFailure(validationResult)) {
	filesToValidate = CustomKeywords.'commands.ExportFileValidationKeywords.resolveExcelFilesAsString'(
			baseExportFolderPath,
			requestedFileNames,
			includeSubFolders
	)

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
			'📄 [FILES RESOLVED]\n' +
			buildResolvedFilesReport(filesToValidate)
	)

	validationResult = CustomKeywords.'commands.ExportFileValidationKeywords.validateExcelFilesFound'(
			filesToValidate
	)
	reportValidation('Validate Excel files exist', validationResult, filesToValidate)

	validationResult = CustomKeywords.'commands.ExportFileValidationKeywords.validateMinimumExpectedFileQuantity'(
			filesToValidate,
			minimumExpectedFiles
	)
	reportValidation('Validate minimum expected files', validationResult, filesToValidate)

	if (!filesToValidate.trim().isEmpty()) {
		validationResult = CustomKeywords.'commands.ExportFileValidationKeywords.validateRequiredHeaders'(
				filesToValidate,
				defaultValidationType,
				sheetIndex,
				headerCurrency,
				headerCurrencyRef,
				headerAmountCcy,
				headerAmountBaseCcy
		)
		reportValidation('Validate required headers', validationResult, filesToValidate)

		validationResult = CustomKeywords.'commands.ExportFileValidationKeywords.validateRowsForValidationType'(
				filesToValidate,
				defaultValidationType,
				sheetIndex,
				headerCurrency,
				headerCurrencyRef
		)
		reportValidation('Validate currency columns', validationResult, filesToValidate)

		validationResult = CustomKeywords.'commands.ExportFileValidationKeywords.validateMontantCcyEqualsMontantBaseCcy'(
				filesToValidate,
				defaultValidationType,
				sheetIndex,
				headerCurrency,
				headerCurrencyRef,
				headerAmountCcy,
				headerAmountBaseCcy
		)
		reportValidation('Validate amount columns are equal', validationResult, filesToValidate)

		validationResult = CustomKeywords.'commands.ExportFileValidationKeywords.validateNoDiscrepanciesBetweenFiles'(
				filesToValidate,
				defaultValidationType,
				sheetIndex,
				discrepancyKeyHeaders,
				discrepancyCompareHeaders
		)
		reportValidation('Validate discrepancies between files', validationResult, filesToValidate)
	}
}

if (validationFailed) {
	KeywordUtil.markFailedAndStop(
			'❌ [END] ' + testCaseName + ' - FAILED\n' +
			'One or more export file validations failed.\n' +
			'Check the failed validation step above for the detailed file-by-file report.\n' +
			allErrors
	)
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'✅ [END] ' + testCaseName + ' - PASSED\n' +
		'All export file validations completed successfully.'
)

KeywordUtil.markPassed(
		'Export file validation completed successfully.'
)

File resolveExecutionExportFolder() {
	File executionRootFolder = resolveExecutionRootFolder()

	return new File(
			executionRootFolder,
			'Shared_REC_PRD_Exports'
	)
}

File resolveExecutionRootFolder() {
	String reportFolderPath = RunConfiguration.getReportFolder()

	if (reportFolderPath == null || reportFolderPath.trim().isEmpty()) {
		return new File(RunConfiguration.getProjectDir(), 'Reports\\Unknown_Execution')
	}

	File current = new File(reportFolderPath)

	while (current != null) {
		File parent = current.getParentFile()

		if (parent != null && parent.getName().equalsIgnoreCase('Reports')) {
			return current
		}

		current = parent
	}

	return new File(reportFolderPath)
}

String buildFolderReport(String folderPath, String validationResult) {
	File folder = new File(folderPath)

	String result = validationResult == null ? '' : validationResult.trim()

	if (hasValidationFailure(result)) {
		return '❌ Export folder was not found or is invalid.\n' +
				'Path: ' + folder.getAbsolutePath() + '\n' +
				'Details:\n' +
				result
	}

	return '✅ Export folder exists.\n' +
			'Path: ' + folder.getAbsolutePath()
}

String buildResolvedFilesReport(String filesText) {
	List<File> files = parseFileList(filesText)

	if (files.isEmpty()) {
		return '❌ No Excel files were resolved from the export folder.'
	}

	List<String> lines = []

	lines.add('Resolved Excel files: ' + files.size())

	for (int i = 0; i < files.size(); i++) {
		File file = files[i]

		lines.add(
				'✅ File ' + (i + 1) + ': ' + file.getName() + '\n' +
				'   Path: ' + file.getAbsolutePath()
		)
	}

	return lines.join('\n')
}

String buildVisualValidationReport(
		String validationName,
		String validationResult,
		List<File> files,
		String maxErrorsPerFileText,
		String maxGeneralErrorsText) {

	String result = validationResult == null ? '' : validationResult.trim()
	Integer maxPerFile = parseIntOrDefault(maxErrorsPerFileText, 5)
	Integer maxGeneral = parseIntOrDefault(maxGeneralErrorsText, 10)

	if (isSkippedResult(result)) {
		return '⚠️ Validation skipped.\n' +
				'Reason: ' + result.replace('[SKIPPED]', '').trim()
	}

	if (!hasValidationFailure(result)) {
		if (files == null || files.isEmpty()) {
			return '✅ Validation passed.'
		}

		List<String> passLines = []

		passLines.add('Result: ✅ Passed')
		passLines.add('Checked files: ' + files.size())

		for (int i = 0; i < files.size(); i++) {
			passLines.add('✅ File ' + (i + 1) + ': ' + files[i].getName())
		}

		return passLines.join('\n')
	}

	List<String> errorLines = extractErrorLines(result)

	List<String> reportLines = []

	reportLines.add('Result: ❌ Failed')

	if (files == null || files.isEmpty()) {
		reportLines.add('Affected files: not available')
		reportLines.add('')
		reportLines.add('Errors:')
		reportLines.addAll(limitLines(errorLines, maxGeneral))
		return reportLines.join('\n')
	}

	reportLines.add('Checked files: ' + files.size())
	reportLines.add('')

	for (int i = 0; i < files.size(); i++) {
		File file = files[i]
		List<String> fileErrors = findErrorsForFile(errorLines, file)

		if (fileErrors.isEmpty()) {
			reportLines.add('✅ File ' + (i + 1) + ': ' + file.getName())
		} else {
			reportLines.add('❌ File ' + (i + 1) + ': ' + file.getName())
			reportLines.add('   Error count: ' + fileErrors.size())

			List<String> limitedErrors = limitLines(fileErrors, maxPerFile)

			for (String error : limitedErrors) {
				reportLines.add('   - ' + cleanErrorLineForReport(error))
			}

			if (fileErrors.size() > maxPerFile) {
				reportLines.add('   - ... and ' + (fileErrors.size() - maxPerFile) + ' more error(s) in this file.')
			}
		}
	}

	List<String> generalErrors = findGeneralErrors(errorLines, files)

	if (!generalErrors.isEmpty()) {
		reportLines.add('')
		reportLines.add('General errors:')

		List<String> limitedGeneralErrors = limitLines(generalErrors, maxGeneral)

		for (String error : limitedGeneralErrors) {
			reportLines.add('- ' + cleanErrorLineForReport(error))
		}

		if (generalErrors.size() > maxGeneral) {
			reportLines.add('- ... and ' + (generalErrors.size() - maxGeneral) + ' more general error(s).')
		}
	}

	return reportLines.join('\n')
}

Boolean hasValidationFailure(String validationResult) {
	String result = validationResult == null ? '' : validationResult.trim()

	if (result.isEmpty()) {
		return false
	}

	if (isSkippedResult(result)) {
		return false
	}

	return true
}

Boolean isSkippedResult(String validationResult) {
	String result = validationResult == null ? '' : validationResult.trim()

	return result.startsWith('[SKIPPED]')
}

List<File> parseFileList(String filesText) {
	List<File> files = []

	String text = filesText == null ? '' : filesText.trim()

	if (text.isEmpty()) {
		return files
	}

	String normalized = text
			.replace('\r\n', '|')
			.replace('\n', '|')
			.replace(';', '|')

	String[] parts = normalized.split('\\|')

	for (String part : parts) {
		String clean = part == null ? '' : part.trim()

		if (!clean.isEmpty()) {
			files.add(new File(clean))
		}
	}

	return files.unique { File file ->
		file.getAbsolutePath().toLowerCase()
	}
}

List<String> extractErrorLines(String validationResult) {
	List<String> lines = []

	String result = validationResult == null ? '' : validationResult.trim()

	if (result.isEmpty()) {
		return lines
	}

	String normalized = result
			.replace('\r\n', '\n')
			.replace('\r', '\n')

	String[] parts = normalized.split('\n')

	for (String part : parts) {
		String clean = part == null ? '' : part.trim()

		if (!clean.isEmpty()) {
			lines.add(clean)
		}
	}

	if (lines.isEmpty()) {
		lines.add(result)
	}

	return lines
}

List<String> findErrorsForFile(List<String> errorLines, File file) {
	List<String> result = []

	if (file == null) {
		return result
	}

	String fileName = file.getName()
	String absolutePath = file.getAbsolutePath()

	for (String errorLine : errorLines) {
		String line = errorLine == null ? '' : errorLine

		if (line.contains(fileName) || line.contains(absolutePath)) {
			result.add(line)
		}
	}

	return result
}

List<String> findGeneralErrors(List<String> errorLines, List<File> files) {
	List<String> result = []

	for (String errorLine : errorLines) {
		Boolean belongsToFile = false

		for (File file : files) {
			if (errorLine.contains(file.getName()) || errorLine.contains(file.getAbsolutePath())) {
				belongsToFile = true
				break
			}
		}

		if (!belongsToFile) {
			result.add(errorLine)
		}
	}

	return result
}

List<String> limitLines(List<String> lines, Integer limit) {
	List<String> result = []

	if (lines == null || lines.isEmpty()) {
		return result
	}

	Integer safeLimit = limit == null || limit <= 0 ? 5 : limit

	for (int i = 0; i < lines.size() && i < safeLimit; i++) {
		result.add(lines[i])
	}

	return result
}

String cleanErrorLineForReport(String errorLine) {
	String line = errorLine == null ? '' : errorLine.trim()

	line = line.replace('[ERROR]', '').trim()

	return line
}

Integer parseIntOrDefault(String value, Integer defaultValue) {
	try {
		return Integer.parseInt(value == null ? '' : value.trim())
	} catch (Exception ignored) {
		return defaultValue
	}
}

