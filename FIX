String errors = ''

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Start investigations popup default dates validation')

menuImage = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/investigations.PNG').getAbsolutePath()
String menuName = 'investigations'
nMaxRecordsField = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/nMaxRecordsField.PNG').getAbsolutePath()

Robot robot = new Robot();

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Search investigations menu')
Windows.waitForElementPresent(findWindowsObject('General/txtSearch'), 10)
Windows.setText(findWindowsObject('General/txtSearch'), menuName)

Windows.delay(1)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Open investigations menu')
WindowsImageKeywords.clickImage(menuImage)

Windows.delay(50)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Read default selected dates from popup')
WindowsTestObject wo = new WindowsTestObject('')

wo.setLocatorStrategy(LocatorStrategy.XPATH)
wo.setLocator("//*[@AutomationId='LstSelection']/*")

List<WindowsTestObject> children = Windows.findElements(wo)

children.size()!=2 ? errors+='\\n PopUp Dates selection does not contain two records default selected\\n ' : KeywordUtil.markPassed("PopUp Dates to select does contains closing date and a quarter as default")

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Capture evidence of dates popup')
WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession()).takeScreenshot(RunConfiguration.getReportFolder() +
	'\\Evidences\\SearchFiltersPROD.PNG')

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Resolve closing date for validation')
GlobalVariable.arreteDate == '' ? GlobalVariable.arreteDate = CustomKeywords.'general.MenuHandling.getArreteDateWithSlash'() : GlobalVariable.arreteDate

println(GlobalVariable.arreteDate)

Boolean quartersValidationsFlag = false
Boolean ClosingDateValidationsFlag = false

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Validate closing date and quarter are selected by default')
for (RemoteWebElement child : children) {
	def properties = child.getText()
	println(properties)
	if (properties.equals(GlobalVariable.arreteDate)) {
		ClosingDateValidationsFlag = true
	} else {
		if (properties.contains('/03/') || properties.contains('/06/') || properties.contains('/09/') || properties.contains('/12/')) {
			quartersValidationsFlag = true
		}
	}
}

if (quartersValidationsFlag && ClosingDateValidationsFlag) {
	KeywordUtil.markPassed("Quarters and Closing date default selected on datesPopUp")
} else {
	if (!quartersValidationsFlag) {
		errors+='\\n Quarter is not default selected on datesPopUP \\n '
	}
	if (!ClosingDateValidationsFlag) {
		errors+='\\n ClosingDate is not default selected on datesPopUP \\n '
	}
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Apply selected dates')
Windows.click(findWindowsObject('Object Repository/PNL Comptable/applyBtn'))

Windows.delay(160)

if (errors != '') {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Investigations popup validation finished with errors')
	KeywordUtil.markFailed('\n' + errors)
} else {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Investigations popup validation finished successfully')
}
