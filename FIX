	findTestCase(currencySetupTestCase),
	[:],
	FailureHandling.STOP_ON_FAILURE
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Open PL Economique menu\n' +
	'Search: ' + menuName + '\n' +
	'Result: ' + menuResultName
)

CustomKeywords.'component.MenuNavigator.searchAndOpenExactMenuByText'(
	menuName,
	menuResultName,
	menuTimeout
)

