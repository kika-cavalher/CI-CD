    private String safeValue(def value) {
        if (value == null) {
            return ''
        }
        return String.valueOf(value).trim()
    }

    private boolean isBlank(def value) {
        return safeValue(value).isEmpty()
    }

    private long toMillis(def secondsValue) {
        String raw = safeValue(secondsValue)
        if (raw.isEmpty()) {
            return 0L
        }

        try {
            BigDecimal seconds = new BigDecimal(raw.replace(',', '.'))
            return (seconds * 1000G).longValue()
        } catch (Exception ignored) {
            return 0L
        }
    }

    private String formatDurationMillis(long durationMs) {
        long totalMs = Math.max(durationMs, 0L)
        long minutes = (long) (totalMs / 60000L)
        long seconds = (long) ((totalMs % 60000L) / 1000L)
        long millis = (long) (totalMs % 1000L)

        return "${minutes}m ${seconds}s ${millis}ms"
    }

    private String formatHeaderDate(Date date) {
        if (date == null) {
            return ''
        }
        return new SimpleDateFormat("EEE MMM dd HH:mm:ss z yyyy", Locale.ENGLISH).format(date)
    }

    private String htmlEscape(def value) {
        String text = safeValue(value)
        if (text.isEmpty()) {
            return ''
        }

        return text
            .replace('&', '&amp;')
            .replace('<', '&lt;')
            .replace('>', '&gt;')
            .replace('"', '&quot;')
            .replace("'", '&#39;')
    }

    private String getGaiaReportFileName() {
        try {
            String configured = safeValue(flow?.GAIA_REPORT_FILE_NAME)
            return configured.isEmpty() ? 'gaiaReport.html' : configured
        } catch (Exception ignored) {
            return 'gaiaReport.html'
        }
    }

    private List<File> collectFallbackImages(String reportFolder) {
        List<File> images = []

        if (isBlank(reportFolder)) {
            return images
        }

        File root = new File(reportFolder)
        if (!root.exists()) {
            return images
        }

        root.eachFileRecurse { File file ->
            if (!file.isFile()) {
                return
            }

            String name = file.name.toLowerCase(Locale.ENGLISH)
            if (name.endsWith('.png') || name.endsWith('.jpg') || name.endsWith('.jpeg')) {
                images.add(file)
            }
        }

        images.sort { File a, File b -> a.lastModified() <=> b.lastModified() }
        return images
    }

    private List<File> collectFailureImages(String reportFolder) {
        try {
            List<File> result = flow?.collectFailureImages(reportFolder)
            if (result != null) {
                return result
            }
        } catch (Exception ignored) {
        }

        return collectFallbackImages(reportFolder)
    }

    private String fileToBase64(File file) {
        if (file == null || !file.exists() || !file.isFile()) {
            return ''
        }

        try {
            byte[] bytes = Files.readAllBytes(file.toPath())
            return Base64.getEncoder().encodeToString(bytes)
        } catch (Exception ignored) {
            return ''
        }
    }

    private List<String> getFailureSummaryLines(String message, String details) {
        List<String> lines = []

        String safeMessage = safeValue(message)
        String safeDetails = safeValue(details)

        if (!safeMessage.isEmpty()) {
            lines.add(safeMessage)
        }

        safeDetails.readLines().each { String raw ->
            String line = safeValue(raw)

            if (line.isEmpty()) {
                return
            }

            if (line.startsWith('at ')) {
                return
            }

            if (line.startsWith('Caused by: at ')) {
                return
            }

            if (line.contains('com.kms.katalon') && line.length() > 120) {
                return
            }

            if (line.contains('org.openqa.selenium') && line.length() > 120) {
                return
            }

            lines.add(line)
        }

        List<String> cleaned = []
        lines.each { String item ->
            String normalized = safeValue(item).replaceAll(/\s+/, ' ').trim()
            if (!normalized.isEmpty() && !cleaned.contains(normalized)) {
                cleaned.add(normalized)
            }
        }

        if (cleaned.isEmpty() && !safeDetails.isEmpty()) {
            safeDetails.readLines().each { String raw ->
                String line = safeValue(raw)
                if (!line.isEmpty() && cleaned.size() < 3) {
                    cleaned.add(line)
                }
            }
        }

        return cleaned.size() > 3 ? cleaned.subList(0, 3) : cleaned
    }

