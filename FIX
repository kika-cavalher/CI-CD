	private void openCurrentFilterOperator(
			String imageGroup,
			String objectGroup,
			String currentFilterImageKey,
			String currentFilterOperatorObjectKey,
			Integer timeoutSeconds
	) {

		Integer timeout =
				safeTimeout(timeoutSeconds)

		WindowsTestObject filterRowObject =
				object(
				objectGroup,
				currentFilterOperatorObjectKey
				)

		if (!Windows.waitForElementPresent(
				filterRowObject,
				timeout,
				FailureHandling.OPTIONAL
				)) {
			KeywordUtil.markFailedAndStop(
					'Current Section filter row was not found.\n' +
					'Object group: ' +
					objectGroup +
					'\nObject key: ' +
					currentFilterOperatorObjectKey +
					'\nReference image key: ' +
					currentFilterImageKey
					)

			return
		}

		List<RemoteWebElement> filterRowElements =
				Windows.findElements(
				filterRowObject
				)

		if (filterRowElements == null ||
				filterRowElements.isEmpty()) {

			KeywordUtil.markFailedAndStop(
					'Current Section filter row coordinates could not be resolved.\n' +
					'Object group: ' +
					objectGroup +
					'\nObject key: ' +
					currentFilterOperatorObjectKey
					)

			return
		}

		String boundingRectangle =
				safeText(
				filterRowElements
				.get(0)
				.getAttribute(
				'BoundingRectangle'
				)
				)

		Map<String, Integer> coordinates =
				parseBoundingRectangle(
				boundingRectangle
				)

		if (coordinates.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Current Section filter row BoundingRectangle could not be parsed.\n' +
					'Object group: ' +
					objectGroup +
					'\nObject key: ' +
					currentFilterOperatorObjectKey +
					'\nBoundingRectangle: ' +
					boundingRectangle
					)

			return
		}

		Integer clickX =
				coordinates.left + 14

		Integer clickY =
				coordinates.top +
				(
				coordinates.bottom -
				coordinates.top
				).intdiv(2)

		Robot robot =
				new Robot()

		robot.mouseMove(
				clickX,
				clickY
				)

		Thread.sleep(250L)

		robot.mousePress(
				InputEvent.BUTTON1_DOWN_MASK
				)

		robot.mouseRelease(
				InputEvent.BUTTON1_DOWN_MASK
				)

		Windows.delay(
				POLLING_DELAY_SECONDS
				)

		KeywordUtil.logInfo(
				'[OBJECT COORDINATE] Current filter "=" operator clicked.\n' +
				'Click X: ' +
				clickX +
				'\nClick Y: ' +
				clickY +
				'\nOffset from row left: 14'
				)
	}


	private void hoverImageFirstThenObject(
			String imageGroup,
			String objectGroup,
			String imageKey,
			String objectKey,
			Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds)
		Integer imageTimeout = Math.min(timeout, 3)

		Boolean imageFound = false

		try {
			imageFound = imageLoader.waitForImage(
					imageGroup,
					imageKey,
					imageTimeout
					)
		} catch (Throwable ignored) {
			imageFound = false
		}

		WindowsTestObject targetObject =
				object(objectGroup, objectKey)

		if (!Windows.waitForElementPresent(
				targetObject,
				timeout,
				FailureHandling.OPTIONAL
				)) {
			KeywordUtil.markFailedAndStop(
					'Hover target was not found.\n' +
					'Image group: ' + imageGroup + '\n' +
					'Image key: ' + imageKey + '\n' +
					'Object group: ' + objectGroup + '\n' +
					'Object key: ' + objectKey
					)

			return
		}

		List<RemoteWebElement> targetElements =
				Windows.findElements(
				targetObject
				)

		if (targetElements == null ||
				targetElements.isEmpty()) {

			KeywordUtil.markFailedAndStop(
					'Hover target element was found but its screen coordinates could not be resolved.\n' +
					'Object group: ' + objectGroup + '\n' +
					'Object key: ' + objectKey
					)

			return
		}

		RemoteWebElement targetElement =
				targetElements.get(0)

		String boundingRectangle =
				safeText(
				targetElement.getAttribute(
				'BoundingRectangle'
				)
				)

		Map<String, Integer> coordinates =
				parseBoundingRectangle(
				boundingRectangle
				)

		if (coordinates.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Hover target was found but BoundingRectangle could not be parsed.\n' +
					'Object group: ' + objectGroup + '\n' +
					'Object key: ' + objectKey + '\n' +
					'BoundingRectangle: ' + boundingRectangle
					)

			return
		}

		Integer mouseX =
				coordinates.left +
				(
				coordinates.right -
				coordinates.left
				).intdiv(2)

		Integer mouseY =
				coordinates.top +
				(
				coordinates.bottom -
				coordinates.top
				).intdiv(2)

		Robot robot = new Robot()

		robot.mouseMove(
				mouseX,
				mouseY
				)

		Windows.delay(POLLING_DELAY_SECONDS)

		KeywordUtil.logInfo(
				imageFound
				? '[IMAGE] Hover anchor found. Physical mouse moved to the centralized Windows object.'
				: '[OBJECT] Image was not found. Physical mouse moved to the centralized Windows object.'
				)
	}

	private Map<String, Integer> parseBoundingRectangle(
			String boundingRectangle
	) {

		String value = safeText(
				boundingRectangle
				)

		if (value.isEmpty()) {
			return [:]
		}

		// Katalon 9 / WinAppDriver format:
		// Left:409 Top:204 Width:94 Height:26
		def leftTopSizeMatcher = value =~
				/(?i)left\s*[:=]\s*(-?\d+)\D+top\s*[:=]\s*(-?\d+)\D+width\s*[:=]\s*(\d+)\D+height\s*[:=]\s*(\d+)/

		if (leftTopSizeMatcher.find()) {
			Integer left =
					leftTopSizeMatcher.group(1).toInteger()

			Integer top =
					leftTopSizeMatcher.group(2).toInteger()

			Integer width =
					leftTopSizeMatcher.group(3).toInteger()

			Integer height =
					leftTopSizeMatcher.group(4).toInteger()

			return [
				left   : left,
				top    : top,
				right  : left + width,
				bottom : top + height
			]
		}

		// Alternative WinAppDriver format:
		// l=409,t=204,r=503,b=230
		def edgesMatcher = value =~
				/(?i)l\s*[:=]\s*(-?\d+)\D+t\s*[:=]\s*(-?\d+)\D+r\s*[:=]\s*(-?\d+)\D+b\s*[:=]\s*(-?\d+)/

		if (edgesMatcher.find()) {
			return [
				left   : edgesMatcher.group(1).toInteger(),
				top    : edgesMatcher.group(2).toInteger(),
				right  : edgesMatcher.group(3).toInteger(),
				bottom : edgesMatcher.group(4).toInteger()
			]
		}

		return [:]
	}

	private void clickImageFirstThenObject(
			String imageGroup,
			String objectGroup,
			String imageKey,
			String objectKey,
			String description,
			Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds)
		Integer imageTimeout = Math.min(timeout, 3)

		try {
			if (imageLoader.waitForImage(
					imageGroup,
					imageKey,
					imageTimeout
					)) {
				WindowsImageKeywords.clickImage(
						image(imageGroup, imageKey)
						)

				KeywordUtil.logInfo(
						'[IMAGE] ' + description + ' clicked.'
						)

				return
			}
		} catch (Throwable imageError) {
			KeywordUtil.logInfo(
					'[IMAGE] Could not click ' +
					description +
					'. Trying Windows object.\n' +
					'Reason: ' +
					safeText(imageError.message)
					)
		}

		WindowsTestObject targetObject =
				object(objectGroup, objectKey)

		if (!Windows.waitForElementPresent(
				targetObject,
				timeout,
				FailureHandling.OPTIONAL
				)) {
			KeywordUtil.markFailedAndStop(
					description +
					' was not found by image or Windows object.\n' +
					'Image group: ' + imageGroup + '\n' +
					'Image key: ' + imageKey + '\n' +
					'Object group: ' + objectGroup + '\n' +
					'Object key: ' + objectKey
					)

			return
		}

		Windows.click(
				targetObject,
				FailureHandling.STOP_ON_FAILURE
				)

		KeywordUtil.logInfo(
				'[OBJECT] ' + description + ' clicked.'
				)
	}

	private void waitForImageOrObjectPresent(
			String imageGroup,
			String objectGroup,
			String imageKey,
			String objectKey,
			String failureMessage,
			Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds)
		Integer imageTimeout = Math.min(timeout, 5)

		try {
			if (imageLoader.waitForImage(
					imageGroup,
					imageKey,
					imageTimeout
					)) {
				KeywordUtil.logInfo(
						'[IMAGE] Expected filter state displayed. Key: ' +
						imageKey
						)

				return
			}
		} catch (Throwable ignored) {
		}

		WindowsTestObject targetObject =
				object(objectGroup, objectKey)

		if (Windows.waitForElementPresent(
				targetObject,
				timeout,
				FailureHandling.OPTIONAL
				)) {
			KeywordUtil.logInfo(
					'[OBJECT] Expected filter state displayed. Key: ' +
					objectKey
					)

			return
		}

		KeywordUtil.markFailedAndStop(
				failureMessage + '\n' +
				'Image group: ' + imageGroup + '\n' +
				'Image key: ' + imageKey + '\n' +
				'Object group: ' + objectGroup + '\n' +
				'Object key: ' + objectKey
				)
	}

	private void pressDownAndSpace() {
		Robot robot = new Robot()

		robot.keyPress(KeyEvent.VK_DOWN)
		robot.keyRelease(KeyEvent.VK_DOWN)

		Thread.sleep(200L)

		robot.keyPress(KeyEvent.VK_SPACE)
		robot.keyRelease(KeyEvent.VK_SPACE)

		Thread.sleep(300L)
	}

	private WindowsTestObject object(
			String objectGroup,
			String objectKey
	) {

		return WindowsObjectLoader.getObject(
				objectGroup,
				objectKey
				)
	}



	private void clearAllFilterValues(
			String imageGroup,
			String objectGroup,
			String selectAllCheckedImageKey,
			String selectAllObjectKey,
			Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds)
		Integer imageTimeout = Math.min(timeout, 10)

		Boolean allCurrentlyChecked = false

		try {
			allCurrentlyChecked =
					imageLoader.waitForImage(
					imageGroup,
					selectAllCheckedImageKey,
					imageTimeout
					)
		} catch (Throwable ignored) {
			allCurrentlyChecked = false
		}

		if (allCurrentlyChecked) {
			WindowsImageKeywords.clickImage(
					image(
					imageGroup,
					selectAllCheckedImageKey
					)
					)

			Windows.delay(POLLING_DELAY_SECONDS)

			KeywordUtil.logInfo(
					'[IMAGE] All filter values deselected.'
					)

			return
		}

		WindowsTestObject selectAllObject =
				object(
				objectGroup,
				selectAllObjectKey
				)

		if (!Windows.waitForElementPresent(
				selectAllObject,
				timeout,
				FailureHandling.OPTIONAL
				)) {
			KeywordUtil.markFailedAndStop(
					'Select all filter option was not found.\n' +
					'Image group: ' + imageGroup + '\n' +
					'Image key: ' + selectAllCheckedImageKey + '\n' +
					'Object group: ' + objectGroup + '\n' +
					'Object key: ' + selectAllObjectKey
					)

			return
		}

		// Current state is partial or unchecked.
		// First click selects all.
		Windows.click(
				selectAllObject,
				FailureHandling.STOP_ON_FAILURE
				)

		Windows.delay(POLLING_DELAY_SECONDS)

		// Second click deselects all.
		Windows.click(
				selectAllObject,
				FailureHandling.STOP_ON_FAILURE
				)

		Windows.delay(POLLING_DELAY_SECONDS)

		KeywordUtil.logInfo(
				'[OBJECT] All filter values deselected.'
				)
	}


