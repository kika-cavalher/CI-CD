	/**
	 * Finds the first report file in the Katalon report folder
	 * that matches the given file extension (e.g. ".html" or ".pdf").
	 *
	 * @param ext File extension to search for (default ".html")
	 * @return The absolute path of the first matching file, or null if not found
	 */
	def getReportFile(String report = "eMatchReport.html") {
		String path = getReportPath()

		// ✅ Ensure trailing slash/backslash
		if (!path.endsWith(File.separator)) {
			path = path + File.separator
		}

		File reportDir = new File(path)

		if (!reportDir.exists()) {
			KeywordUtil.markWarning("⚠️ Report directory does not exist: ${reportDir.absolutePath}")
			return null
		}

		File foundFile = reportDir.listFiles().find {
			it.isFile() && it.name.equalsIgnoreCase(report)
		}

		if (foundFile) {
			KeywordUtil.logInfo("✅ Found report: ${foundFile.absolutePath}")
			return foundFile.absolutePath
		} else {
			KeywordUtil.markWarning("⚠️ Report '${report}' not found in: ${reportDir.absolutePath}")
			return null
		}
	}

	private File findReportRecursive(File dir, String filenameLower) {
		dir.eachFile { f ->
			if (f.isFile() && f.name.toLowerCase() == filenameLower) {
				return f
			}
		}
		dir.eachFile { f ->
			if (f.isDirectory()) {
				File result = findReportRecursive(f, filenameLower)
				if (result != null) return result
			}
		}
		return null
	}

	// ---------------------------------------
	// Helper method to detect locked files
	// ---------------------------------------
	def isFileLocked(File file) {
		try {
			def raf = new RandomAccessFile(file, "rw")
			raf.close()
			return false
		} catch (IOException e) {
			return true
		}
	}

	/*
	 * Actual Keyword to be called in the Import Test Case to Jira, it can be without inputs, if you have only one input file.
	 * Can use a Test Data as input, if you have more than one input file.
	 * Needs to be called in a test suite after the test suite that needs to be imported to Jira.
	 */

	@Keyword
	def updateJira(TestData td) {
		String results = ''; //To accumulate possible errors
		println 'Zipping Katalon Reports...';
		String zipReport = zipReports();
		println 'Zipping Evidences...';
		String zipEv = zipEvidences();
		println 'Creating test execution...';
		String execID = importExecutionResults(td); // Upload Junit and get ticket ID to be used for next actions
		Thread.sleep(3000)
		List<String> TestCasesIds  = importTestCaseKey(execID); //Gets list of Tests from a Test Execution

		//Checks if JUnit import was successful
		if (!execID.contains('ERROR')) {
			println 'JUnit report was imported successfully. New test execution ' + execID + ' created JIRA!'

			//Checks if updates to Jira ticket were done successfully, if response code status with 2, means success
			if (updateJiraTicketInfo(execID, td) < 299) results += 'Jira ticket ' + execID + ' successfully updated.\n'
			else results += '[ERROR] Could not update Jira ticket ' + execID + '.\n'

			//Checks if upload of reports to Jira ticket were done successfully, if response code status with 2, means success
			if (uploadAttachment(execID, zipReport) < 299) results += 'Reports successfully uploaded to ' + execID + '.\n'
			else results += '[ERROR] Could not upload the reports on Jira ' + execID + '.\n'

			//Checks if  upload of evidences to Jira ticket were done successfully, if response code status with 2, means success
			if (uploadAttachment(execID, zipEv) < 299) results += 'Reports successfully uploaded to ' + execID + '.\n'
			else results += '[ERROR] Could not upload the reports on Jira ' + execID + '.\n'

			// 🔹 Attach eMatchReport.html to Jira Execution and log clearly
			try {
				String htmlReport = getReportFile("eMatchReport.html")

				if (htmlReport != null) {
					KeywordUtil.logInfo("📌 Uploading eMatchReport.html to Execution Ticket: ${execID}")
					int uploadStatus = uploadAttachment(execID, htmlReport)

					if (uploadStatus < 299) {
						KeywordUtil.logInfo("✅ eMatchReport.html successfully uploaded to Jira Execution ${execID}")
						results += "HTML dashboard successfully uploaded to ${execID}.\n"
					} else {
						KeywordUtil.markWarning("⚠️ Failed to upload eMatchReport.html to Jira Execution ${execID} (status ${uploadStatus})")
						results += "[ERROR] Could not upload HTML dashboard to Jira ${execID}.\n"
					}
				} else {
					KeywordUtil.markWarning("⚠️ eMatchReport.html was not found in the report folder.")
				}
			} catch (Exception e) {
				KeywordUtil.markWarning("⚠️ Exception while uploading eMatchReport.html to Jira ${execID}: ${e.message}")
			}

			for (execIDTestCase in TestCasesIds) {

				def  response = WS.sendRequestAndVerify(findTestObject('Jira Integration/getIssue',[('issueID'):execIDTestCase]))
				def slurper = new JsonSlurper();
				Map parsedJson = slurper.parseText(response.getResponseBodyContent()).fields;
				String summaryName = parsedJson.summary
				String statusId = parsedJson.status.id;

				if(updateTestCaseStatusApproved(execIDTestCase) < 299) results += 'Test Case status successfuly updated in ' + execIDTestCase + '.\n'
				else results += '[ERROR] Could not update Test Case status on Jira ' + execIDTestCase + '.\n'

				if(updateTestCaseStatusInUse(execIDTestCase) < 299) results += 'Test Case status successfuly updated in ' + execIDTestCase + '.\n'
				else results += '[ERROR] Could not update Test Case status on Jira ' + execIDTestCase + '.\n'

				if(updateTestExecutionStatus(execID) < 299) results += 'Test Execution status successfuly updated in ' + execID + '.\n'
				else results += 'Test Execution already In Progress status ' + execID + '.\n'

				if(updateSummaryTestCase(execIDTestCase, summaryName) < 299) results += 'Test Cases name successfuly updated in ' + execIDTestCase + '.\n'
				else results += '[ERROR] Could not update Test Cases name on Jira ' + execIDTestCase + '.\n'

				if(updateTestCasePath(execIDTestCase, summaryName) < 299) results += 'Test Case Path status successfuly updated in ' + execIDTestCase + '.\n'
				else results += '[ERROR] Could not update Test RepositoryPath status on Jira ' + execIDTestCase + '.\n'
			}
		} else KeywordUtil.markFailed('[ERROR]Test execution creation has failed with code ' + execID + '.')
	}

