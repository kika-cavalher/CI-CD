    String createGaiaHtmlReport(String reportFolder, String suiteName, String xmlPath, String executionSummary) {
        if (owner.isBlank(reportFolder) || owner.isBlank(xmlPath)) {
            return ''
        }

        File reportDir = new File(reportFolder)
        if (!reportDir.exists() || !reportDir.isDirectory()) {
            return ''
        }

        Map parsedXml = parseXmlResults(xmlPath)
        List<Map> executionEntries = parseExecutionLog(reportFolder)
        List<File> screenshots = owner.collectFailureImages(reportFolder)

        List<Map> screenshotModels = screenshots.collect { File file ->
            [
                name: file.name,
                relativePath: owner.relativeUri(reportDir, file)
            ]
        }

        Map model = [
            suiteName        : suiteName,
            executionSummary : executionSummary,
            environment      : owner.ENVIRONMENT,
            projectKey       : owner.PROJECT_KEY,
            generatedAt      : new Date(),
            xmlPath          : xmlPath,
            totals           : parsedXml.totals,
            testCases        : parsedXml.testCases,
            executionEntries : executionEntries,
            screenshots      : screenshotModels
        ]

        String html = templateBuilder.build(model)

        File output = new File(reportDir, owner.GAIA_REPORT_FILE_NAME)
        output.setText(html, 'UTF-8')

        return output.absolutePath
    }

    Map parseXmlResults(String xmlPath) {
        List<Map> testCases = []
        int totalTests = 0
        int totalFailures = 0
        int totalSkipped = 0
        BigDecimal totalTime = 0

        def root = new XmlSlurper(false, false).parse(new File(xmlPath))
        String rootName = owner.safe(root.name())

        List suiteNodes = []
        if (rootName.equalsIgnoreCase('testsuites')) {
            suiteNodes.addAll(root.testsuite)
        } else if (rootName.equalsIgnoreCase('testsuite')) {
            suiteNodes << root
        } else {
            suiteNodes << root
        }

        suiteNodes.each { suiteNode ->
            String suiteNodeName = owner.safe(suiteNode.@name?.text())

            suiteNode.testcase.each { testCaseNode ->
                String name = owner.safe(testCaseNode.@name?.text())
                String className = owner.safe(testCaseNode.@classname?.text())
                String timeValue = owner.safe(testCaseNode.@time?.text())

                boolean failed = testCaseNode.failure?.size() > 0 || testCaseNode.error?.size() > 0
                boolean skipped = testCaseNode.skipped?.size() > 0

                String failureMessage = ''
                if (failed) {
                    def failureNode = testCaseNode.failure?.size() > 0 ? testCaseNode.failure[0] : testCaseNode.error[0]
                    failureMessage = owner.safe(failureNode.@message?.text())
                    if (owner.isBlank(failureMessage)) {
                        failureMessage = owner.safe(failureNode.text())
                    }
                }

                BigDecimal caseTime = 0
                try {
                    caseTime = new BigDecimal(owner.safe(timeValue == '' ? '0' : timeValue))
                } catch (Exception ignored) {
                    caseTime = 0
                }

                totalTests++
                if (failed) totalFailures++
                if (skipped) totalSkipped++
                totalTime += caseTime

                testCases << [
                    suite         : suiteNodeName,
                    name          : name,
                    className     : className,
                    status        : skipped ? 'SKIPPED' : (failed ? 'FAILED' : 'PASSED'),
                    duration      : formatSeconds(caseTime),
                    durationRaw   : caseTime,
                    failureMessage: failureMessage
                ]
            }
        }

        return [
            totals: [
                tests   : totalTests,
                failures: totalFailures,
                passed  : Math.max(totalTests - totalFailures - totalSkipped, 0),
                skipped : totalSkipped,
                duration: formatSeconds(totalTime)
            ],
            testCases: testCases
        ]
    }

    List<Map> parseExecutionLog(String reportFolder) {
        List<Map> entries = []

        File logFile = owner.findFileInReportTree(reportFolder, 'execution0.log')
        if (logFile == null || !logFile.exists() || !logFile.isFile()) {
            return entries
        }

        List<String> lines = []
        try {
            lines = logFile.readLines('UTF-8')
        } catch (Exception ignored) {
            lines = logFile.readLines()
        }

        lines.each { String line ->
            String safeLine = owner.safe(line)

            if (safeLine.contains('TEST CASE:')) {
                entries << [
                    type  : 'CASE',
                    status: safeLine.toUpperCase().contains('FAILED') ? 'FAILED' : 'INFO',
                    text  : extractAfter(safeLine, 'TEST CASE:')
                ]
                return
            }

            if (safeLine.contains('TEST STEP:')) {
                entries << [
                    type  : 'STEP',
                    status: safeLine.toUpperCase().contains('FAILED') || safeLine.toUpperCase().contains('STOP_ON_FAILURE') ? 'FAILED' : 'INFO',
                    text  : extractAfter(safeLine, 'TEST STEP:')
                ]
                return
            }

            if (safeLine.startsWith('Caused by:') || safeLine.startsWith('Reason:')) {
                entries << [
                    type  : 'ERROR',
                    status: 'FAILED',
                    text  : safeLine
                ]
            }
        }

        return entries
    }

    String extractAfter(String line, String token) {
        int index = line.indexOf(token)
        if (index < 0) {
            return owner.safe(line)
        }
        return owner.safe(line.substring(index + token.length()))
    }

    String formatSeconds(def seconds) {
        BigDecimal value = 0
        try {
            value = new BigDecimal(owner.safe(seconds == null ? '0' : seconds.toString()))
        } catch (Exception ignored) {
            value = 0
        }

        DecimalFormat df = new DecimalFormat('0.###')
        return df.format(value) + 's'
    }
