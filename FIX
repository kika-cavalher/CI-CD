	@Keyword
	void openEnvironmentDropdown() {
		KeywordUtil.logInfo("Opening environment dropdown")

		focusLoginWindow(detectedWindowTitle)
		sleepMs(800)

		String dropdownImage = getGeneralImagePath('dropdownEnvironnement.png')

		if (clickImageWithRetry(dropdownImage, 5, 1200, 'Opening environment dropdown by image')) {
			sleepMs(1200)
			return
		}

		WindowsTestObject combo = envComboObj()
		if (waitPresent(combo, 5)) {
			KeywordUtil.logInfo("Opening environment dropdown by object click")
			Windows.click(combo)
			sleepMs(1200)
			return
		}

		KeywordUtil.markFailedAndStop("Environment dropdown could not be opened")
	}

	@Keyword
	void selectEnvironment(String env) {
		String envCode = normalizeEnvCode(env)
		String envImage = getEnvironmentImagePath(envCode)

		KeywordUtil.logInfo("Selecting environment ${envCode} by image")

		focusLoginWindow(detectedWindowTitle)
		sleepMs(500)

		openEnvironmentDropdown()
		sleepMs(1000)

		if (clickImageWithRetry(envImage, 5, 1200, "Selecting environment ${envCode} by image")) {
			sleepMs(1200)
			return
		}

		KeywordUtil.markFailedAndStop(
			"Environment image was not found or could not be clicked for ${envCode}. Path ${envImage}"
		)
	}

	@Keyword
	boolean isConnectButtonPresent() {
		String connectImage = getGeneralImagePath('seconnecter.png')
		if (fileExists(connectImage)) {
			return true
		}
		return waitPresent(connectBtnObj(), 3)
	}

	@Keyword
	void clickConnectButton() {
		KeywordUtil.logInfo("Clicking connect button")

		focusLoginWindow(detectedWindowTitle)
		sleepMs(500)

		String connectImage = getGeneralImagePath('seconnecter.png')

		if (clickImageWithRetry(connectImage, 5, 1500, 'Clicking connect button by image')) {
			sleepMs(1500)
			return
		}

		WindowsTestObject btn = connectBtnObj()
		if (waitPresent(btn, 5)) {
			KeywordUtil.logInfo("Clicking connect button by object")
			Windows.click(btn)
			sleepMs(1500)
			return
		}

		KeywordUtil.markFailedAndStop("Connect button could not be clicked")
	}

	@Keyword
	boolean waitForMainScreen() {
		KeywordUtil.logInfo("Waiting for main eMatch screen")

		String homeGreyImage = getGeneralImagePath('HomeGrey.png')
		long end = System.currentTimeMillis() + 60000L

		while (System.currentTimeMillis() < end) {
			focusLoginWindow(detectedWindowTitle)

			if (clickImageNoFail(homeGreyImage, 'Checking main screen with HomeGrey image')) {
				sleepMs(1000)
				return true
			}

			if (waitPresent(mainSearchObj(), 2)) {
				return true
			}

			if (waitPresent(homeTabObj(), 2)) {
				return true
			}

			sleepMs(1000)
		}

		return false
	}

	@Keyword
	void activateHomeTab() {
		try {
			String homeGreyImage = getGeneralImagePath('HomeGrey.png')
			if (clickImageNoFail(homeGreyImage, 'Activating Home tab with HomeGrey image')) {
				sleepMs(1000)
				return
			}
		} catch (Throwable ignored) {
		}

		try {
			WindowsTestObject homeTab = homeTabObj()
			if (waitPresent(homeTab, 5)) {
				Windows.click(homeTab)
				sleepMs(800)
			}
		} catch (Throwable ignored) {
		}
	}

	@Keyword
	void loginThroughNativeControls() {
		loginThroughNativeControls(safe(GlobalVariable.env) ?: 'REC')
	}

	@Keyword
	void loginThroughNativeControls(String env) {
		String resolvedEnv = safe(env) ?: safe(GlobalVariable.env) ?: 'REC'

		KeywordUtil.logInfo("Logging through native controls for env ${resolvedEnv}")

		selectEnvironment(resolvedEnv)
		sleepMs(1000)

		clickConnectButton()

		boolean mainScreenLoaded = waitForMainScreen()

		if (!mainScreenLoaded) {
			KeywordUtil.markFailedAndStop(
				"eMatch main screen was not loaded. HomeGrey image and main objects were not found."
			)
		}

		activateHomeTab()
		KeywordUtil.logInfo("eMatch startup flow completed successfully for environment ${resolvedEnv}")
	}





