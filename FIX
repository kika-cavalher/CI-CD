	def importExecutionResults() {
		println 'Importing XML file to Jira...'

		String xmlFile = getXmlFilePath()

		if (xmlFile == null) {
			return 'ERROR_XML_NOT_FOUND'
		}

		def response = WS.sendRequest(findTestObject(REQUEST_IMPORT_JUNIT, [
			('junitFile'): xmlFile,
			('project')  : getProject(),
			('token')    : JIRA_TOKEN
		]))

		def slurper = new JsonSlurper()
		int status = WS.getResponseStatusCode(response)
		String body = response.getResponseBodyContent()

		KeywordUtil.logInfo("Import results status: " + status)
		KeywordUtil.logInfo("Import results response: " + body)

		if (!(status == 200 || status == 204)) {
			return 'ERROR' + status.toString()
		}

		def parsedJson = slurper.parseText(body)
		String execID = parsedJson?.testExecIssue?.key

		if (execID == null || execID.trim().isEmpty()) {
			return 'ERROR_EXEC_ID_NOT_FOUND'
		}

		KeywordUtil.logInfo("Jira Execution ID: " + execID)
		return execID
	}

	def findExistingTestPlan() {
		try {
			String summary = getTestPlanName()

			KeywordUtil.logInfo("Searching existing Test Plan by name: " + summary)

			def response = WS.sendRequest(findTestObject(REQUEST_GET_TEST_PLAN, [
				('project') : getProject(),
				('summary') : summary,
				('parent')  : EPIC_KEY,
				('token')   : JIRA_TOKEN
			]))

			int status = WS.getResponseStatusCode(response)
			String body = response.getResponseBodyContent()

			KeywordUtil.logInfo("Get Test Plan status: " + status)
			KeywordUtil.logInfo("Get Test Plan response: " + body)

			if (status != 200) {
				return ''
			}

			def parsedJson = new JsonSlurper().parseText(body)
			def total = parsedJson?.total ?: 0

			if (total >= 1 && parsedJson?.issues && parsedJson.issues.size() > 0) {
				String foundKey = parsedJson.issues[0].key
				KeywordUtil.logInfo("Existing Test Plan found: " + foundKey)
				return foundKey
			}

			return ''
		} catch (Exception e) {
			KeywordUtil.markWarning("Could not search existing Test Plan: " + e.message)
			return ''
		}
	}

	def createTestPlan() {
		String summary = getTestPlanName()

		KeywordUtil.logInfo("Creating new Test Plan: " + summary)

		def response = WS.sendRequest(findTestObject(REQUEST_CREATE_TEST_PLAN, [
			('project') : getProject(),
			('summary') : summary,
			('labels')  : getLabels(),
			('env')     : getEnv(),
			('epic')    : EPIC_KEY,
			('token')   : JIRA_TOKEN
		]))

		def slurper = new JsonSlurper()
		int status = WS.getResponseStatusCode(response)
		String body = response.getResponseBodyContent()

		KeywordUtil.logInfo("Create Test Plan status: " + status)
		KeywordUtil.logInfo("Create Test Plan response: " + body)

		if (!(status == 200 || status == 201)) {
			return 'ERROR' + status.toString()
		}

		def parsedJson = slurper.parseText(body)
		String key = parsedJson?.key

		if (key == null || key.trim().isEmpty()) {
			return 'ERROR_TEST_PLAN_KEY_NOT_FOUND'
		}

		KeywordUtil.logInfo("New Test Plan created: " + key)
		return key
	}

	def getOrCreateTestPlan() {
		if (MANUAL_TEST_PLAN_KEY != null && !MANUAL_TEST_PLAN_KEY.trim().isEmpty()) {
			KeywordUtil.logInfo("Using manual Test Plan key from configuration: " + MANUAL_TEST_PLAN_KEY)
			return MANUAL_TEST_PLAN_KEY.trim()
		}

		if (RESET_SAVED_TEST_PLAN_KEY) {
			KeywordUtil.logInfo("RESET_SAVED_TEST_PLAN_KEY is enabled.")
			resetTestPlanKey()
		}

		if (FORCE_CREATE_NEW_TEST_PLAN) {
			KeywordUtil.logInfo("FORCE_CREATE_NEW_TEST_PLAN is enabled.")
			String newKey = createTestPlan()

			if (newKey != null && !newKey.contains('ERROR')) {
				saveTestPlanKey(newKey)
			}

			return newKey
		}

		String savedKey = getSavedTestPlanKey()

		if (savedKey != null && !savedKey.trim().isEmpty()) {
			KeywordUtil.logInfo("Using saved Test Plan key: " + savedKey)
			return savedKey
		}

		String existingKey = findExistingTestPlan()

		if (existingKey != null && !existingKey.trim().isEmpty()) {
			saveTestPlanKey(existingKey)
			return existingKey
		}

		String newKey = createTestPlan()

		if (newKey != null && !newKey.contains('ERROR')) {
			saveTestPlanKey(newKey)
		}

		return newKey
	}

