pipeline {
    agent { label 'GI5_SWDCFRNXGI55817' }

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        timeout(time: 75, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10', daysToKeepStr: '14'))
        skipDefaultCheckout(true)
    }

    parameters {
        choice(
            name: 'RUN_MODE',
            choices: ['VISIBLE', 'HEADLESS'],
            description: 'Choose how Chrome should run'
        )
        string(
            name: 'STARTUP_WAIT_SECONDS',
            defaultValue: '45',
            description: 'Seconds to wait after Gaia backend/frontend start'
        )
    }

    environment {
        KATALON_HOME = 'C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0'
        GIT_URL      = 'https://bitbucket-mut.mycloud.intrabpce.fr/scm/gi5/gaia-portal.git'
        GIT_CRED     = '965eceec-b3a3-4ec5-8820-a857c87dd80f'
        PROJECT_FILE = 'Gaia.prj'
        REPORTS_DIR  = 'Reports'
        DISPLAY_WIDTH  = '1920'
        DISPLAY_HEIGHT = '1080'
    }

    stages {

        stage('Environment Setup') {
            steps {
                script {
                    echo "========================================"
                    echo "Starting Gaia Pipeline"
                    echo "Build Number : ${env.BUILD_NUMBER}"
                    echo "Node         : ${env.NODE_NAME}"
                    echo "Workspace    : ${env.WORKSPACE}"
                    echo "Run Mode     : ${params.RUN_MODE}"
                    echo "========================================"

                    bat """
                        @echo off
                        echo Preparing reports directory...
                        if exist "${env.REPORTS_DIR}" (
                            echo Cleaning existing reports...
                            rmdir /s /q "${env.REPORTS_DIR}"
                        )
                        mkdir "${env.REPORTS_DIR}"
                        mkdir "${env.REPORTS_DIR}\\_jenkins_summary"
                        echo Reports directory ready
                    """

                    writeFile file: "${env.REPORTS_DIR}\\_jenkins_summary\\build_description.txt", text: ""
                    echo "Environment setup completed"
                }
            }
        }

        stage('Start Gaia Backend + Frontend') {
            steps {
                script {
                    echo "========================================"
                    echo "Starting Gaia backend and frontend"
                    echo "Task Name: GaiaBackFrontSetup"
                    echo "========================================"

                    bat 'schtasks /run /tn "GaiaBackFrontSetup"'

                    echo "Waiting ${params.STARTUP_WAIT_SECONDS}s for Gaia to become available..."
                    sleep(time: params.STARTUP_WAIT_SECONDS.toInteger(), unit: 'SECONDS')

                    echo "Gaia startup wait finished"
                }
            }
        }

        stage('Checkout gaia-portal') {
            steps {
                script {
                    echo "========================================"
                    echo "Checking out repository"
                    echo "Branch: master"
                    echo "Repo  : ${env.GIT_URL}"
                    echo "========================================"
                }

                deleteDir()

                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/master']],
                    userRemoteConfigs: [[url: env.GIT_URL, credentialsId: env.GIT_CRED]],
                    extensions: [
                        [$class: 'WipeWorkspace'],
                        [$class: 'CloneOption', shallow: false, noTags: false, timeout: 30]
                    ]
                ])

                script {
                    echo "Checkout completed successfully"
                }
            }
        }

        stage('Execute Gaia Suites') {
            steps {
                script {
                    def suites = [
                        [name: 'GAIA_LOGIN',       path: 'Test Suites/GAIA/login_suite'],
                        [name: 'GAIA_SETTINGS',    path: 'Test Suites/GAIA/settings_suite'],
                        [name: 'GAIA_CORRECTION',  path: 'Test Suites/GAIA/correction_suite']
                    ]

                    for (suite in suites) {
                        stage("Run ${suite.name}") {
                            executeGaiaSuite(suite)
                        }
                    }
                }
            }
        }

        stage('Final Summary') {
            steps {
                script {
                    echo "========================================"
                    echo "Pipeline execution finished"
                    echo "Check individual suite stages above"
                    echo "========================================"
                }
            }
        }
    }

    post {
        always {
            script {
                echo "Reading execution summary..."

                def summaryText = ""
                try {
                    summaryText = readFile("${env.REPORTS_DIR}\\_jenkins_summary\\build_description.txt")
                } catch (Exception e) {
                    summaryText = "No summary file generated"
                    echo "Warning reading summary file: ${e.message}"
                }

                if (summaryText?.trim()) {
                    def escapedText = summaryText
                        .replace("&", "&amp;")
                        .replace("<", "&lt;")
                        .replace(">", "&gt;")

                    currentBuild.description = "<pre style='margin:0; white-space:pre-wrap; font-family:monospace; font-size:12px;'>" + escapedText + "</pre>"
                } else {
                    currentBuild.description = "No test results available"
                }

                echo "Archiving reports..."
                archiveArtifacts artifacts: "${env.REPORTS_DIR}/**/*", allowEmptyArchive: true, excludes: '**/*.lck'

                echo "Publishing JUnit XML..."
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                    junit allowEmptyResults: true, testResults: "${env.REPORTS_DIR}/**/JUnit_Report.xml, ${env.REPORTS_DIR}/**/junit*.xml, ${env.REPORTS_DIR}/**/TEST-*.xml"
                }

                echo "Final cleanup of Katalon and browser processes..."
                powershell """
                    \$ErrorActionPreference = 'SilentlyContinue'

                    Get-CimInstance Win32_Process | Where-Object {
                        \$_.Name -match 'katalon|katalonc|chrome|chromedriver' -or
                        (\$_.Name -eq 'java.exe' -and \$_.CommandLine -like '*katalon*')
                    } | ForEach-Object {
                        try {
                            Stop-Process -Id \$_.ProcessId -Force
                            Write-Host "Stopped process: \$($_.Name) PID=\$($_.ProcessId)"
                        } catch {}
                    }

                    Write-Host "Cleanup completed"
                """
            }
        }

        success {
            echo "SUCCESS: Pipeline completed successfully"
        }

        unstable {
            echo "UNSTABLE: Pipeline completed with test failures"
        }

        failure {
            echo "FAILURE: Pipeline failed"
        }

        aborted {
            echo "ABORTED: Pipeline canceled by user"
        }
    }
}

def executeGaiaSuite(suiteConfig) {
    def projectPath = "${env.WORKSPACE}\\${env.PROJECT_FILE}"
    def reportDir   = "${env.WORKSPACE}\\${env.REPORTS_DIR}\\${suiteConfig.name}\\${env.BUILD_NUMBER}"

    echo "========================================"
    echo "Starting suite execution"
    echo "Suite Name   : ${suiteConfig.name}"
    echo "Suite Path   : ${suiteConfig.path}"
    echo "Run Mode     : ${params.RUN_MODE}"
    echo "Report Dir   : ${reportDir}"
    echo "========================================"

    bat """
        @echo off
        if not exist "${reportDir}" mkdir "${reportDir}"
    """

    def browserType = 'Chrome'
    def chromeArgs = buildChromeArgs(params.RUN_MODE)
    def katalonArgs =
        "-projectPath=\"${projectPath}\" " +
        "-testSuitePath=\"${suiteConfig.path}\" " +
        "-browserType=\"${browserType}\" " +
        "-consoleLog -logLevel=DEBUG " +
        "-reportFolder=\"${reportDir}\" " +
        chromeArgs

    echo "Katalon execution prepared"
    echo "Browser Type : ${browserType}"
    echo "Chrome Mode  : ${params.RUN_MODE}"

    def katalonError = null

    catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
        try {
            echo "Launching Katalon for suite ${suiteConfig.name}..."
            executeKatalon(
                location: "${env.KATALON_HOME}",
                executeArgs: katalonArgs,
                version: '',
                x11Display: '',
                xvfbConfiguration: ''
            )
            echo "Katalon execution finished for suite ${suiteConfig.name}"
        } catch (Exception e) {
            katalonError = e.getMessage()
            echo "Katalon execution error in suite ${suiteConfig.name}: ${katalonError}"
            throw e
        }
    }

    echo "Collecting extra generated files for suite ${suiteConfig.name}..."

    bat """
        @echo off
        echo.
        echo ========================================
        echo Moving generated files for ${suiteConfig.name}
        echo ========================================

        echo Moving CSV files...
        for %%f in ("${env.WORKSPACE}\\ExecutionResults_*.csv") do (
            if exist "%%f" (
                echo   Moving CSV: %%~nxf
                move "%%f" "${reportDir}\\" >nul 2>&1
            )
        )

        echo Moving report folders...
        for /d %%d in ("${env.WORKSPACE}\\Reports\\202*") do (
            if exist "%%d" (
                echo   Moving report folder: %%~nxd
                robocopy "%%d" "${reportDir}" /E /MOVE /NFL /NDL /NJH /NJS >nul 2>&1
                if exist "%%d" rmdir "%%d" 2>nul
            )
        )

        echo Moving log/html/json files...
        for %%f in ("${env.WORKSPACE}\\*.log" "${env.WORKSPACE}\\*.html" "${env.WORKSPACE}\\*.json") do (
            if exist "%%f" (
                echo   Moving: %%~nxf
                move "%%f" "${reportDir}\\" >nul 2>&1
            )
        )

        echo.
        echo Files currently inside:
        dir "${reportDir}" 2>nul
        echo ========================================
    """

    generateSummary(suiteConfig, reportDir, katalonError)
}

def buildChromeArgs(runMode) {
    if (runMode == 'HEADLESS') {
        def args = [
            '--headless=new',
            "--window-size=${env.DISPLAY_WIDTH},${env.DISPLAY_HEIGHT}",
            '--disable-gpu',
            '--disable-dev-shm-usage',
            '--no-sandbox'
        ]
        return "--config -webui.chrome.args='${args.join(' ')}'"
    }

    def args = [
        "--window-size=${env.DISPLAY_WIDTH},${env.DISPLAY_HEIGHT}",
        '--start-maximized'
    ]
    return "--config -webui.chrome.args='${args.join(' ')}'"
}

def generateSummary(suiteConfig, reportDir, katalonError) {
    def threwVal = katalonError ? "1" : "0"
    def errVal = (katalonError ?: "").replace("'", "''")
    def suiteName = suiteConfig.name

    powershell """
        \$ErrorActionPreference = 'SilentlyContinue'

        \$reportDir = '${reportDir}'
        \$suiteName = '${suiteName}'
        \$threw = ${threwVal}
        \$fallback = '${errVal}'
        \$globalFile = '${env.WORKSPACE}\\\\${env.REPORTS_DIR}\\\\_jenkins_summary\\\\build_description.txt'

        if (!(Test-Path (Split-Path \$globalFile))) {
            New-Item -ItemType Directory -Path (Split-Path \$globalFile) -Force | Out-Null
        }

        Write-Host "========================================"
        Write-Host "Analyzing reports for suite: \$suiteName"
        Write-Host "Report directory: \$reportDir"
        Write-Host "========================================"

        \$suiteIcon = "UNKNOWN"
        \$statusText = "UNKNOWN"

        if (\$threw -eq 1) {
            \$suiteIcon = "FAILED"
            \$statusText = "SYSTEM ERROR"
        } else {
            \$csvFiles = Get-ChildItem -Path \$reportDir -Filter "ExecutionResults_*.csv" -Recurse -ErrorAction SilentlyContinue
            \$xmlFiles = Get-ChildItem -Path \$reportDir -Filter "*.xml" -Recurse -ErrorAction SilentlyContinue
            \$htmlFiles = Get-ChildItem -Path \$reportDir -Filter "*.html" -Recurse -ErrorAction SilentlyContinue

            Write-Host "CSV files found : \$(\$csvFiles.Count)"
            Write-Host "XML files found : \$(\$xmlFiles.Count)"
            Write-Host "HTML files found: \$(\$htmlFiles.Count)"

            if (\$csvFiles.Count -gt 0) {
                \$latestCsv = \$csvFiles | Sort-Object LastWriteTime -Descending | Select-Object -First 1
                Write-Host "Reading latest CSV: \$(\$latestCsv.FullName)"

                try {
                    \$lines = Get-Content \$latestCsv.FullName -Encoding UTF8 | Select-Object -Skip 1
                    \$testsTotal = 0
                    \$testsPassed = 0
                    \$testsFailed = 0

                    foreach (\$line in \$lines) {
                        if (![string]::IsNullOrWhiteSpace(\$line)) {
                            \$cols = \$line -split ','
                            if (\$cols.Count -ge 4) {
                                \$testsTotal++
                                \$status = \$cols[3].Trim()
                                if (\$status -eq 'PASSED') {
                                    \$testsPassed++
                                } else {
                                    \$testsFailed++
                                }
                            }
                        }
                    }

                    Write-Host "Total tests : \$testsTotal"
                    Write-Host "Passed      : \$testsPassed"
                    Write-Host "Failed      : \$testsFailed"

                    if (\$testsTotal -eq 0) {
                        \$suiteIcon = "NO TESTS"
                        \$statusText = "NO TESTS FOUND"
                    } elseif (\$testsFailed -eq 0) {
                        \$suiteIcon = "PASSED"
                        \$statusText = "PASSED (\$testsPassed/\$testsTotal)"
                    } else {
                        \$suiteIcon = "FAILED"
                        \$statusText = "FAILED (\$testsPassed/\$testsTotal)"
                    }
                } catch {
                    \$suiteIcon = "EXECUTED"
                    \$statusText = "EXECUTED BUT CSV COULD NOT BE PARSED"
                    Write-Host "Error parsing CSV: \$(\$_.Exception.Message)"
                }
            } else {
                \$suiteIcon = "EXECUTED"
                \$statusText = "EXECUTED WITHOUT CSV"
            }
        }

        \$summaryLines = New-Object System.Collections.Generic.List[string]
        \$summaryLines.Add("\$suiteIcon \$suiteName - \$statusText")

        if (\$threw -eq 1 -and ![string]::IsNullOrWhiteSpace(\$fallback)) {
            \$summaryLines.Add("   ERROR: \$fallback")
        }

        \$summaryLines.Add("")
        Add-Content -Path \$globalFile -Value (\$summaryLines -join "`n") -Encoding UTF8

        Write-Host "Final suite status: \$suiteIcon \$suiteName - \$statusText"
    """
}
