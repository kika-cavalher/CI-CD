package keywords

import static com.kms.katalon.core.testobject.ObjectRepository.findTestObject

import java.text.SimpleDateFormat
import java.util.zip.ZipEntry
import java.util.zip.ZipOutputStream

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webservice.keyword.WSBuiltInKeywords as WS

import groovy.io.FileType
import groovy.json.JsonOutput
import groovy.json.JsonSlurper

public class JiraIntegration {

    /*
     * Includes:
     * - Detects current Test Suite name automatically
     * - Builds automatic Test Plan and Execution names
     * - Uses one saved Test Plan key per suite
     * - Searches existing Test Plan before creating a new one
     * - Creates Test Plan with a minimal valid payload
     * - Imports XML results into Jira/Xray
     * - Uploads ZIP reports, evidence ZIP and HTML report
     * - Updates Jira issue status
     */

    // =========================================================
    // CONFIGURATION
    // Update all values here
    // =========================================================

    String PROJECT_KEY              = 'L96B2C'
    String BASE_URL                 = 'https://jira-mtu.d.bb'
    String ACCESS_TOKEN             = 'your-token-here'
    String ENVIRONMENT              = 'UAT'
    String LABELS                   = 'automate'
    String TEST_PLAN_ISSUE_TYPE     = 'Test Plan'

    String XML_FILE_NAME_CONTAINS   = 'cucumber.xml'
    String HTML_REPORT_FILE_NAME    = 'eMatchReport.html'
    String REPORT_ZIP_NAME          = 'Results.zip'
    String EVIDENCE_FOLDER_NAME     = 'Evidences'
    String EVIDENCE_ZIP_NAME        = 'Evidences.zip'

    String TRANSITION_EXECUTION_ID  = '11'
    String TRANSITION_TEST_PLAN_ID  = ''

    String TEST_PLAN_KEYS_FOLDER    = RunConfiguration.projectDir + '\\testplan_keys'

    // =========================================================
    // OBJECT REPOSITORY PATHS
    // =========================================================

    String REQUEST_IMPORT_RESULTS        = 'Jira Integration/import Results'
    String REQUEST_GET_TEST_PLAN         = 'Jira Integration/Get Test Plan'
    String REQUEST_CREATE_TEST_PLAN      = 'Jira Integration/Create Test Plan'
    String REQUEST_UPDATE_TEST_PLAN      = 'Jira Integration/Update Test Plan'
    String REQUEST_UPDATE_TEST_EXECUTION = 'Jira Integration/Update Test Execution Name'
    String REQUEST_UPLOAD_ATTACHMENT     = 'Jira Integration/Evidence attachment'
    String REQUEST_TRANSITION_STATUS     = 'Jira Integration/Transition Issue Status'

    // =========================================================
    // BASIC GET METHODS
    // =========================================================

    def getReportPath() {
        return RunConfiguration.getReportFolder()
    }

    def getProject() {
        return PROJECT_KEY
    }

    def getBaseUrl() {
        return BASE_URL
    }

    def getAccessToken() {
        return ACCESS_TOKEN
    }

    def getEnvironment() {
        return ENVIRONMENT
    }

    def getLabels() {
        return LABELS
    }

    def getTimestamp() {
        return new SimpleDateFormat("yyyy-MM-dd HH.mm.ss").format(new Date())
    }

    // =========================================================
    // TEST SUITE NAME
    // =========================================================

    def getCurrentTestSuiteName() {
        String reportPath = getReportPath()

        if (reportPath == null || reportPath.trim().isEmpty()) {
            KeywordUtil.markWarning("Report path is empty. Using fallback test suite name.")
            return 'UnknownTestSuite'
        }

        File currentReportFolder = new File(reportPath)

        if (!currentReportFolder.exists()) {
            KeywordUtil.markWarning("Report folder does not exist. Using fallback test suite name.")
            return 'UnknownTestSuite'
        }

        File suiteFolder = currentReportFolder.getParentFile()

        if (suiteFolder == null || suiteFolder.getName() == null || suiteFolder.getName().trim().isEmpty()) {
            KeywordUtil.markWarning("Could not detect suite folder from report path. Using fallback test suite name.")
            return 'UnknownTestSuite'
        }

        String suiteName = suiteFolder.getName().trim()

        KeywordUtil.logInfo("Detected report path: ${reportPath}")
        KeywordUtil.logInfo("Detected suite folder: ${suiteFolder.absolutePath}")
        KeywordUtil.logInfo("Current Test Suite name detected: ${suiteName}")

        return suiteName
    }

    def getSanitizedSuiteName() {
        return getCurrentTestSuiteName().replaceAll('[\\\\/:*?"<>|]', '_')
    }

    def getTestPlanName() {
        return getCurrentTestSuiteName() + ' Test Plan'
    }

    def getExecutionSummary() {
        return getCurrentTestSuiteName() + ' ' + getTimestamp()
    }

    // =========================================================
    // FILE PATHS
    // =========================================================

    def getSuiteTestPlanFilePath() {
        File folder = new File(TEST_PLAN_KEYS_FOLDER)

        if (!folder.exists()) {
            folder.mkdirs()
        }

        return folder.absolutePath + '\\' + getSanitizedSuiteName() + '.txt'
    }

    def getXmlFilePath() {
        File reportDir = new File(getReportPath())

        if (!reportDir.exists() || !reportDir.isDirectory()) {
            KeywordUtil.markFailed("Report folder does not exist: ${reportDir.absolutePath}")
            return null
        }

        String xmlPath = null

        reportDir.eachFileRecurse(FileType.FILES) { file ->
            if (file.name.toLowerCase().contains(XML_FILE_NAME_CONTAINS.toLowerCase())) {
                xmlPath = file.absolutePath
            }
        }

        if (xmlPath == null) {
            KeywordUtil.markFailed("No XML file containing '${XML_FILE_NAME_CONTAINS}' was found in: ${reportDir.absolutePath}")
            return null
        }

        KeywordUtil.logInfo("XML file found: ${xmlPath}")
        return xmlPath
    }

    def getEvidenceFolderPath() {
        String evidencePath = getReportPath() + File.separator + EVIDENCE_FOLDER_NAME
        File evidenceFolder = new File(evidencePath)

        if (!evidenceFolder.exists() || !evidenceFolder.isDirectory()) {
            KeywordUtil.markWarning("Evidence folder was not found: ${evidenceFolder.absolutePath}")
            return null
        }

        return evidenceFolder.absolutePath
    }

    def getHtmlReportFile(String reportName = HTML_REPORT_FILE_NAME) {
        File reportDir = new File(getReportPath())

        if (!reportDir.exists() || !reportDir.isDirectory()) {
            KeywordUtil.markWarning("Report directory does not exist: ${reportDir.absolutePath}")
            return null
        }

        File foundFile = reportDir.listFiles()?.find {
            it.isFile() && it.name.equalsIgnoreCase(reportName)
        }

        if (foundFile != null) {
            KeywordUtil.logInfo("HTML report found: ${foundFile.absolutePath}")
            return foundFile.absolutePath
        }

        KeywordUtil.markWarning("HTML report '${reportName}' was not found in: ${reportDir.absolutePath}")
        return null
    }

    // =========================================================
    // TEST PLAN PERSISTENCE
    // =========================================================

    def getSavedTestPlanKey() {
        File file = new File(getSuiteTestPlanFilePath())

        if (!file.exists()) {
            return ''
        }

        String savedKey = file.text?.trim()

        if (savedKey == null || savedKey.isEmpty()) {
            return ''
        }

        KeywordUtil.logInfo("Saved Test Plan key found for suite '${getCurrentTestSuiteName()}': ${savedKey}")
        return savedKey
    }

    def saveTestPlanKey(String testPlanKey) {
        if (testPlanKey == null || testPlanKey.trim().isEmpty()) {
            return
        }

        File file = new File(getSuiteTestPlanFilePath())
        file.write(testPlanKey.trim(), 'UTF-8')

        KeywordUtil.logInfo("Test Plan key saved successfully for suite '${getCurrentTestSuiteName()}': ${testPlanKey}")
    }

    @Keyword
    def resetTestPlanKey() {
        File file = new File(getSuiteTestPlanFilePath())

        if (!file.exists()) {
            KeywordUtil.logInfo("Test Plan key file does not exist for this suite. Nothing to reset.")
            return
        }

        file.write('', 'UTF-8')
        KeywordUtil.logInfo("Saved Test Plan key was cleared successfully for suite '${getCurrentTestSuiteName()}'.")
    }

    // =========================================================
    // JIRA / XRAY ACTIONS
    // =========================================================

    def importExecutionResults() {
        String xmlFile = getXmlFilePath()

        if (xmlFile == null) {
            return 'ERROR_XML_NOT_FOUND'
        }

        KeywordUtil.logInfo("Importing XML results into Jira...")
        KeywordUtil.logInfo("Using project key: ${getProject()}")

        def response = WS.sendRequest(findTestObject(REQUEST_IMPORT_RESULTS, [
            ('filePath') : xmlFile,
            ('project')  : getProject(),
            ('baseUrl')  : getBaseUrl(),
            ('token')    : getAccessToken()
        ]))

        int status = WS.getResponseStatusCode(response)
        String body = response.getResponseBodyContent()

        KeywordUtil.logInfo("Import results status: ${status}")
        KeywordUtil.logInfo("Import results response: ${body}")

        if (!(status in [200, 204])) {
            return 'ERROR_' + status.toString()
        }

        def parsedJson = new JsonSlurper().parseText(body)
        String execID = parsedJson?.testExecIssue?.key

        if (execID == null || execID.trim().isEmpty()) {
            return 'ERROR_EXEC_ID_NOT_FOUND'
        }

        KeywordUtil.logInfo("Test Execution created successfully: ${execID}")
        return execID
    }

    def getTestPlanByName() {
        String testPlanName = getTestPlanName()
        KeywordUtil.logInfo("Searching Test Plan by name: ${testPlanName}")

        def response = WS.sendRequest(findTestObject(REQUEST_GET_TEST_PLAN, [
            ('project') : getProject(),
            ('token')   : getAccessToken(),
            ('summary') : testPlanName
        ]))

        int status = WS.getResponseStatusCode(response)
        String body = response.getResponseBodyContent()

        KeywordUtil.logInfo("Get Test Plan status: ${status}")
        KeywordUtil.logInfo("Get Test Plan response: ${body}")

        if (status != 200) {
            return 'ERROR_' + status.toString()
        }

        def parsedJson = new JsonSlurper().parseText(body)
        int total = parsedJson?.total ?: 0

        if (total == 0) {
            KeywordUtil.logInfo("No existing Test Plan found with this name.")
            return null
        }

        if (total >= 1) {
            String testPlanKey = parsedJson.issues[0].key
            KeywordUtil.logInfo("Existing Test Plan found: ${testPlanKey}")
            return testPlanKey
        }

        return null
    }

    def createTestPlan() {
        String testPlanName = getTestPlanName()
        KeywordUtil.logInfo("Creating new Test Plan: ${testPlanName}")

        def response = WS.sendRequest(findTestObject(REQUEST_CREATE_TEST_PLAN, [
            ('project')       : getProject(),
            ('summary')       : testPlanName,
            ('issueTypeName') : TEST_PLAN_ISSUE_TYPE,
            ('token')         : getAccessToken()
        ]))

        int status = WS.getResponseStatusCode(response)
        String body = response.getResponseBodyContent()

        KeywordUtil.logInfo("Create Test Plan status: ${status}")
        KeywordUtil.logInfo("Create Test Plan response: ${body}")

        if (!(status in [200, 201])) {
            return 'ERROR_' + status.toString()
        }

        def parsedJson = new JsonSlurper().parseText(body)
        String testPlanKey = parsedJson?.key

        if (testPlanKey == null || testPlanKey.trim().isEmpty()) {
            return 'ERROR_TEST_PLAN_KEY_NOT_FOUND'
        }

        KeywordUtil.logInfo("New Test Plan created successfully: ${testPlanKey}")
        return testPlanKey
    }

    def getOrCreateTestPlan() {
        String savedTestPlanKey = getSavedTestPlanKey()

        if (savedTestPlanKey != '') {
            KeywordUtil.logInfo("Using saved Test Plan key: ${savedTestPlanKey}")
            return savedTestPlanKey
        }

        String existingTestPlanKey = getTestPlanByName()

        if (existingTestPlanKey != null && !existingTestPlanKey.startsWith('ERROR')) {
            saveTestPlanKey(existingTestPlanKey)
            return existingTestPlanKey
        }

        if (existingTestPlanKey != null && existingTestPlanKey.startsWith('ERROR')) {
            return existingTestPlanKey
        }

        String newTestPlanKey = createTestPlan()

        if (newTestPlanKey != null && !newTestPlanKey.startsWith('ERROR')) {
            saveTestPlanKey(newTestPlanKey)
        }

        return newTestPlanKey
    }

    def updateTestPlan(String testPlanKey, String execID) {
        KeywordUtil.logInfo("Linking Test Execution ${execID} to Test Plan ${testPlanKey}...")

        def jsonBody = [
            addTestsToPlan: true,
            add           : [execID]
        ]

        def response = WS.sendRequest(findTestObject(REQUEST_UPDATE_TEST_PLAN, [
            ('token')       : getAccessToken(),
            ('testPlanKey') : testPlanKey,
            ('jsonBody')    : JsonOutput.toJson(jsonBody)
        ]))

        int status = WS.getResponseStatusCode(response)
        KeywordUtil.logInfo("Update Test Plan status: ${status}")
        return status
    }

    def updateJiraTicketInfo(String execID) {
        String executionSummary = getExecutionSummary()
        KeywordUtil.logInfo("Updating Jira issue information for ${execID} with summary: ${executionSummary}")

        def response = WS.sendRequest(findTestObject(REQUEST_UPDATE_TEST_EXECUTION, [
            ('issueID') : execID,
            ('token')   : getAccessToken(),
            ('summary') : executionSummary,
            ('labels')  : getLabels(),
            ('env')     : getEnvironment()
        ]))

        int status = WS.getResponseStatusCode(response)
        KeywordUtil.logInfo("Update Test Execution status: ${status}")
        return status
    }

    def uploadAttachment(String execID, String filePath) {
        KeywordUtil.logInfo("Uploading attachment to ${execID}: ${filePath}")

        def response = WS.sendRequest(findTestObject(REQUEST_UPLOAD_ATTACHMENT, [
            ('token')     : getAccessToken(),
            ('evidences') : new File(filePath),
            ('execID')    : execID
        ]))

        int status = WS.getResponseStatusCode(response)
        KeywordUtil.logInfo("Upload attachment status: ${status}")
        return status
    }

    def updateIssueStatus(String issueKey, String transitionId) {
        KeywordUtil.logInfo("Updating status for ${issueKey} using transition ${transitionId}...")

        def response = WS.sendRequest(findTestObject(REQUEST_TRANSITION_STATUS, [
            ('token')        : getAccessToken(),
            ('issueID')      : issueKey,
            ('transitionID') : transitionId
        ]))

        int status = WS.getResponseStatusCode(response)
        KeywordUtil.logInfo("Transition status response: ${status}")
        return status
    }

    // =========================================================
    // FILE HELPERS
    // =========================================================

    def isFileAllowedInZip(File file, String zipFileName) {
        if (file == null || !file.isFile()) {
            return false
        }

        String fileNameLower = file.name.toLowerCase()

        if (fileNameLower.endsWith('.lck')) {
            return false
        }

        if (fileNameLower.endsWith('.zip')) {
            return false
        }

        if (file.name.equalsIgnoreCase(zipFileName)) {
            return false
        }

        return true
    }

    // =========================================================
    // ZIP METHODS
    // =========================================================

    def zipReports() {
        String reportPath = getReportPath()
        String zippedFile = reportPath + File.separator + REPORT_ZIP_NAME

        def output = new ZipOutputStream(new FileOutputStream(zippedFile))
        KeywordUtil.logInfo("Creating report ZIP: ${zippedFile}")

        new File(reportPath).eachFile { file ->
            if (!isFileAllowedInZip(file, REPORT_ZIP_NAME)) {
                KeywordUtil.logInfo("Skipping file from report ZIP: ${file.name}")
                return
            }

            try {
                output.putNextEntry(new ZipEntry(file.name))
                KeywordUtil.logInfo("Adding report file to ZIP: ${file.name}")

                def input = new FileInputStream(file)
                byte[] buffer = new byte[1024]
                int bytesRead

                while ((bytesRead = input.read(buffer)) != -1) {
                    output.write(buffer, 0, bytesRead)
                }

                input.close()
                output.closeEntry()
            } catch (Exception e) {
                KeywordUtil.logWarning("Could not add file to report ZIP: ${file.name} - ${e.message}")
            }
        }

        output.close()
        KeywordUtil.logInfo("Report ZIP created successfully: ${zippedFile}")
        return zippedFile
    }

    def zipEvidences() {
        String evidencePath = getEvidenceFolderPath()

        if (evidencePath == null) {
            return null
        }

        String zippedFile = evidencePath + File.separator + EVIDENCE_ZIP_NAME

        def output = new ZipOutputStream(new FileOutputStream(zippedFile))
        KeywordUtil.logInfo("Creating evidence ZIP: ${zippedFile}")

        new File(evidencePath).eachFileRecurse(FileType.FILES) { file ->
            if (!isFileAllowedInZip(file, EVIDENCE_ZIP_NAME)) {
                KeywordUtil.logInfo("Skipping file from evidence ZIP: ${file.name}")
                return
            }

            try {
                String relativePath = new File(evidencePath).toPath().relativize(file.toPath()).toString().replace("\\", "/")

                output.putNextEntry(new ZipEntry(relativePath))
                KeywordUtil.logInfo("Adding evidence file to ZIP: ${relativePath}")

                def input = new FileInputStream(file)
                byte[] buffer = new byte[1024]
                int bytesRead

                while ((bytesRead = input.read(buffer)) != -1) {
                    output.write(buffer, 0, bytesRead)
                }

                input.close()
                output.closeEntry()
            } catch (Exception e) {
                KeywordUtil.logWarning("Could not add file to evidence ZIP: ${file.name} - ${e.message}")
            }
        }

        output.close()
        KeywordUtil.logInfo("Evidence ZIP created successfully: ${zippedFile}")
        return zippedFile
    }

    // =========================================================
    // MAIN KEYWORD
    // =========================================================

    @Keyword
    def updateJira() {
        String results = ''

        // Uncomment the line below if you want to clear the saved Test Plan key
        // and force the creation of a new Test Plan for this suite.
        // resetTestPlanKey()

        KeywordUtil.logInfo("Starting Jira integration flow...")
        KeywordUtil.logInfo("Using project key: ${getProject()}")
        KeywordUtil.logInfo("Detected Test Suite name: ${getCurrentTestSuiteName()}")
        KeywordUtil.logInfo("Automatic Test Plan name: ${getTestPlanName()}")
        KeywordUtil.logInfo("Automatic Execution summary: ${getExecutionSummary()}")

        String zipReport = zipReports()
        String zipEvidence = zipEvidences()
        String execID = importExecutionResults()

        if (execID == null || execID.startsWith('ERROR')) {
            KeywordUtil.markFailed("Test Execution creation failed: ${execID}")
            return
        }

        String testPlanKey = getOrCreateTestPlan()

        if (testPlanKey == null || testPlanKey.startsWith('ERROR')) {
            KeywordUtil.markFailed("Test Plan could not be created or found: ${testPlanKey}")
            return
        }

        if (updateTestPlan(testPlanKey, execID) < 299) {
            results += "Test Execution ${execID} linked to Test Plan ${testPlanKey} successfully.\n"
        } else {
            results += "[ERROR] Could not link Test Execution ${execID} to Test Plan ${testPlanKey}.\n"
        }

        if (updateJiraTicketInfo(execID) < 299) {
            results += "Jira issue ${execID} updated successfully.\n"
        } else {
            results += "[ERROR] Could not update Jira issue ${execID}.\n"
        }

        if (zipReport != null && uploadAttachment(execID, zipReport) < 299) {
            results += "Report ZIP uploaded successfully to ${execID}.\n"
        } else {
            results += "[ERROR] Could not upload report ZIP to ${execID}.\n"
        }

        if (zipEvidence != null && uploadAttachment(execID, zipEvidence) < 299) {
            results += "Evidence ZIP uploaded successfully to ${execID}.\n"
        } else {
            results += "[ERROR] Could not upload evidence ZIP to ${execID}.\n"
        }

        try {
            String htmlReport = getHtmlReportFile()

            if (htmlReport != null) {
                int htmlUploadStatus = uploadAttachment(execID, htmlReport)

                if (htmlUploadStatus < 299) {
                    results += "HTML report uploaded successfully to ${execID}.\n"
                } else {
                    results += "[ERROR] Could not upload HTML report to ${execID}.\n"
                }
            }
        } catch (Exception e) {
            KeywordUtil.markWarning("Exception while uploading HTML report: ${e.message}")
        }

        if (TRANSITION_EXECUTION_ID != null && !TRANSITION_EXECUTION_ID.trim().isEmpty()) {
            if (updateIssueStatus(execID, TRANSITION_EXECUTION_ID) < 299) {
                results += "Test Execution ${execID} status updated successfully.\n"
            } else {
                results += "[ERROR] Could not update Test Execution status ${execID}.\n"
            }
        }

        if (TRANSITION_TEST_PLAN_ID != null && !TRANSITION_TEST_PLAN_ID.trim().isEmpty()) {
            if (updateIssueStatus(testPlanKey, TRANSITION_TEST_PLAN_ID) < 299) {
                results += "Test Plan ${testPlanKey} status updated successfully.\n"
            } else {
                results += "[ERROR] Could not update Test Plan status ${testPlanKey}.\n"
            }
        }

        KeywordUtil.logInfo("Jira integration summary:\n${results}")
    }

    @Keyword
    def jiraImport() {
        updateJira()
    }
}
