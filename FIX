					inputStream
				)

			if (workbook.numberOfSheets <= 0) {
				KeywordUtil.markFailedAndStop(
					'Main investigations export has no worksheet: ' +
						mainFile.name
				)
			}

			Sheet sheet =
				workbook.getSheetAt(0)

			HeaderLocation sourceHeader =
				findHeader(
					sheet,
					'Source'
				)

			if (sourceHeader == null) {
				KeywordUtil.markFailedAndStop(
					'Column Source was not found in main export: ' +
						mainFile.name
				)
			}

			DataFormatter formatter =
				new DataFormatter()

			List<String> sourceValues = []

			for (Integer rowIndex =
					sourceHeader.rowIndex + 1;
				rowIndex <= sheet.lastRowNum;
				rowIndex++) {

				Row row =
					sheet.getRow(rowIndex)

				if (row == null) {
					continue
				}

				String sourceValue =
					safeText(
						formatter.formatCellValue(
							row.getCell(
								sourceHeader.columnIndex
							)
						)
					).toUpperCase()

				if (sourceValue.isEmpty()) {
