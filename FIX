String errors=''

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Start Ref Compta filter validation')

refComptaFilter = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/refComptaFilter.PNG').getAbsolutePath()

dragDropDropReference = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/dragDropDropReference.PNG').getAbsolutePath()
filterWithRefComptaReference = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/filterWithRefComptaReference.PNG').getAbsolutePath()
filtersCollectionAfterAddRefCompta = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/filtersCollectionAfterAddRefCompta.PNG').getAbsolutePath()
filterBtn = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/filterBtn.PNG').getAbsolutePath()
selectAllFilter = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/selectAllFilter.PNG').getAbsolutePath()
emptyFilter = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/emptyFilter.PNG').getAbsolutePath()
closeFiltersBtn = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/closeFiltersBtn.PNG').getAbsolutePath()

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Open Ref Compta filter options')
WindowsImageKeywords.clickImage(refComptaFilter)
Windows.delay(1)
WindowsImageKeywords.clickImage(filterBtn)
Windows.delay(13)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Clear current filter selection')
WindowsImageKeywords.doubleClickImage(selectAllFilter)
Windows.delay(9)
WindowsImageKeywords.doubleClickImage(emptyFilter)
Windows.delay(15)
WindowsImageKeywords.clickImage(closeFiltersBtn)
Windows.delay(20)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Drag Ref Compta filter to target drop area')
WindowsImageKeywords.dragAndDrop(refComptaFilter, dragDropDropReference)

Windows.delay(40)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Validate Ref Compta filter was applied and removed from top list')
def isFilterApplyed = WindowsImageKeywords.findImage(filterWithRefComptaReference)
def isfilterListwithoutRefCompta = WindowsImageKeywords.findImage(filtersCollectionAfterAddRefCompta)

if (isFilterApplyed == false) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Ref Compta filter was not applied correctly')
	WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession()).takeScreenshot(RunConfiguration.getReportFolder() + "\\Evidences\\" + 'FilterRefComptaNotApplyed.PNG')
	errors += "Ref Compta Filter not applyed correctly to the table"
} else {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Ref Compta filter applied correctly')
	WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession()).takeScreenshot(RunConfiguration.getReportFolder() + "\\Evidences\\" + 'FilterRefComptaApplyed.PNG')
	KeywordUtil.markPassed("Ref Compta Filter applyed correctly")
}
	
if (filtersCollectionAfterAddRefCompta == false) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Ref Compta filter still appears in top list after selection')
	errors += '\\n Ref Compta Filter present in the top list to be selected \\n'
} else {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Ref Compta filter no longer appears in top list after selection')
	KeywordUtil.markPassed("Ref Compta Filter not present on the top after selection")
}

if (errors != '') {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Ref Compta filter validation finished with errors')
	KeywordUtil.markFailed(errors)
} else {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Ref Compta filter validation finished successfully')
	KeywordUtil.markPassed('Test OK')
}
