class authentication {

	private static final String EMATCH_LNK_PATH = 'D:\\RunAseMatchReq\\eMatch.lnk'
	private static final String EMATCH_APPLICATION_PATH = '\\\\cib.net\\shareparis\\Soft\\ematch\\IHM\\Livraisons\\REC\\IXIS.Ematch.IHM.application'
	private static final String WINAPPDRIVER_EXE = 'C:\\Program Files (x86)\\Windows Application Driver\\WinAppDriver.exe'
	private static final String RESOLUTION_SCRIPT_PATH = 'D:\\setResolution.ps1'

	private static final int WINDOW_ATTACH_TIMEOUT_SEC = 90
	private static final int WINDOW_ATTACH_RETRY_SEC = 2
	private static final int AFTER_START_DELAY_SEC = 8
	private static final int AFTER_ENV_DROPDOWN_DELAY_SEC = 20
	private static final int AFTER_ENV_SELECTION_DELAY_SEC = 7
	private static final int MAIN_SCREEN_TIMEOUT_SEC = 60
	private static final int AFTER_MAIN_SCREEN_DELAY_SEC = 10
	private static final int AFTER_HOME_CLICK_DELAY_SEC = 5
	private static final int WINAPPDRIVER_START_TIMEOUT_SEC = 15

	@Keyword
	String getCurrentWindowsUser() {
		return System.getProperty('user.name') ?: ''
	}

	@Keyword
	String getShortcutPath() {
		return EMATCH_LNK_PATH
	}

	@Keyword
	String getApplicationPath() {
		return EMATCH_APPLICATION_PATH
	}

	@Keyword
	String getWinAppDriverPath() {
		return WINAPPDRIVER_EXE
	}

	@Keyword
	String getResolutionScriptPath() {
		return RESOLUTION_SCRIPT_PATH
	}

	@Keyword
	String resolveWindowTitle() {
		String version = GlobalVariable.version?.toString()?.trim()
		String versionProd = GlobalVariable.versionProd?.toString()?.trim()

		if (version) {
			return version
		}

		if (versionProd) {
			return versionProd
		}

		KeywordUtil.markFailedAndStop('GlobalVariable.version and GlobalVariable.versionProd are both empty.')
		return ''
	}

	private boolean fileExists(String path) {
		try {
			return path?.trim() && new File(path).exists()
		}
		catch (Exception ignored) {
			return false
		}
	}

	private boolean isWinAppDriverListening() {
		Socket socket = null

		try {
			socket = new Socket('127.0.0.1', 4723)
			return true
		}
		catch (Exception ignored) {
			return false
		}
		finally {
			try {
				socket?.close()
			}
			catch (Exception ignored) {
			}
		}
	}

	private void waitForWinAppDriver() {
		int elapsed = 0

		while (elapsed < WINAPPDRIVER_START_TIMEOUT_SEC) {
			if (isWinAppDriverListening()) {
				return
			}

			Windows.delay(1)
			elapsed++
		}

		KeywordUtil.markFailedAndStop("WinAppDriver did not start listening on 127.0.0.1:4723 within ${WINAPPDRIVER_START_TIMEOUT_SEC} seconds.")
	}

	@Keyword
	void runResolutionScriptIfAvailable() {
		try {
			if (fileExists(RESOLUTION_SCRIPT_PATH)) {
				String cmd = "Powershell.exe -executionpolicy remotesigned -File \"${RESOLUTION_SCRIPT_PATH}\""
				Runtime.getRuntime().exec(cmd)
				KeywordUtil.logInfo("Resolution script started: ${RESOLUTION_SCRIPT_PATH}")
			}
			else {
				KeywordUtil.logInfo("Resolution script not found. Continuing without it.")
			}
		}
		catch (Exception e) {
			KeywordUtil.logInfo("Resolution script failed but flow will continue: ${e.getMessage()}")
		}
	}

	private void startUsingShortcut(String targetWindowTitle) {
		if (!fileExists(EMATCH_LNK_PATH)) {
			throw new Exception("Shortcut not found: ${EMATCH_LNK_PATH}")
		}

		KeywordUtil.logInfo("Starting eMatch using visible shortcut flow: ${EMATCH_LNK_PATH}")
		runResolutionScriptIfAvailable()
		Windows.startApplicationWithTitle(EMATCH_LNK_PATH, targetWindowTitle)
		Windows.delay(AFTER_START_DELAY_SEC)
	}

	private void startUsingApplicationAndWinAppDriver() {
		if (!isWinAppDriverListening()) {
			if (!fileExists(WINAPPDRIVER_EXE)) {
				throw new Exception("WinAppDriver.exe not found: ${WINAPPDRIVER_EXE}")
			}

			KeywordUtil.logInfo("Starting WinAppDriver from: ${WINAPPDRIVER_EXE}")
			new ProcessBuilder(WINAPPDRIVER_EXE).inheritIO().start()
			waitForWinAppDriver()
		}
		else {
			KeywordUtil.logInfo('WinAppDriver already listening on 127.0.0.1:4723')
		}

		KeywordUtil.logInfo("Starting eMatch using application path: ${EMATCH_APPLICATION_PATH}")
		Windows.startApplication(EMATCH_APPLICATION_PATH)
		Windows.delay(AFTER_START_DELAY_SEC)
	}

	@Keyword
	void startEmatch(String currentUser, String targetWindowTitle) {
		KeywordUtil.logInfo('============================================================')
		KeywordUtil.logInfo('eMatch startup context')
		KeywordUtil.logInfo("Windows user        : ${currentUser}")
		KeywordUtil.logInfo("Global username     : ${GlobalVariable.username}")
		KeywordUtil.logInfo("Window title        : ${targetWindowTitle}")
		KeywordUtil.logInfo("Shortcut path       : ${EMATCH_LNK_PATH}")
		KeywordUtil.logInfo("Application path    : ${EMATCH_APPLICATION_PATH}")
		KeywordUtil.logInfo("WinAppDriver path   : ${WINAPPDRIVER_EXE}")
		KeywordUtil.logInfo('============================================================')

		Exception shortcutError = null

		try {
			startUsingShortcut(targetWindowTitle)
			KeywordUtil.logInfo('eMatch started successfully using shortcut flow.')
			return
		}
		catch (Exception e) {
			shortcutError = e
			KeywordUtil.logInfo("Shortcut flow failed: ${e.getMessage()}")
		}

		try {
			startUsingApplicationAndWinAppDriver()
			KeywordUtil.logInfo('eMatch started successfully using application + WinAppDriver fallback flow.')
			return
		}
		catch (Exception e) {
			KeywordUtil.markFailed("Failed to start eMatch using shortcut flow. Error: ${shortcutError?.getMessage()}")
			KeywordUtil.markFailed("Failed to start eMatch using fallback flow. Error: ${e.getMessage()}")
			KeywordUtil.markFailedAndStop('Stopping test case due to startup failure.')
		}
	}

	private WindowsTestObject buildWindowByName(String windowTitle) {
		WindowsTestObject obj = new WindowsTestObject()
		obj.setLocatorStrategy(LocatorStrategy.NAME)
		obj.setLocator(windowTitle)
		return obj
	}

	private WindowsTestObject buildWindowByXPathContains(String windowTitle) {
		WindowsTestObject obj = new WindowsTestObject()
		obj.setLocatorStrategy(LocatorStrategy.XPATH)
		obj.setLocator("//*[contains(@Name,'${windowTitle}')]")
		return obj
	}

	@Keyword
	void attachToLoginWindow(String targetWindowTitle) {
		WindowsTestObject exactWindow = buildWindowByName(targetWindowTitle)
		WindowsTestObject containsWindow = buildWindowByXPathContains(targetWindowTitle)

		int elapsedTime = 0
		boolean windowFound = false

		while (elapsedTime < WINDOW_ATTACH_TIMEOUT_SEC) {
			try {
				Windows.switchToDesktop()

				try {
					Windows.switchToWindow(exactWindow)
				}
				catch (Exception ignored) {
					Windows.switchToWindow(containsWindow)
				}

				windowFound = true
				KeywordUtil.logInfo("Attached to target window: ${targetWindowTitle}")
				break
			}
			catch (Exception e) {
				Windows.delay(WINDOW_ATTACH_RETRY_SEC)
				elapsedTime += WINDOW_ATTACH_RETRY_SEC
			}
		}

		if (!windowFound) {
			KeywordUtil.markFailedAndStop("Target window '${targetWindowTitle}' could not be found within ${WINDOW_ATTACH_TIMEOUT_SEC} seconds.")
		}
	}

	@Keyword
	void openEnvironmentDropdown() {
		WinRetry.clickWithRetry('Login Page/optEnv', 3, 10)
		Windows.delay(AFTER_ENV_DROPDOWN_DELAY_SEC)
	}

	@Keyword
	int resolveEnvironmentIndex(String environment) {
		int env = 3

		switch (environment) {
			case 'PROD':
				env = 1
				break
			case 'PREX':
				env = 2
				break
			case 'REC2':
				env = 3
				break
			case 'REC':
				env = 4
				break
			case 'DEV2':
				env = 5
				break
			case 'DEV':
				env = 6
				break
		}

		return env
	}

	@Keyword
	void selectEnvironment(String environment) {
		int env = resolveEnvironmentIndex(environment)

		for (int i = 0; i < env; i++) {
			Windows.sendKeys(findWindowsObject('Login Page/optEnv'), Keys.chord(Keys.ARROW_DOWN))
		}

		Windows.sendKeys(findWindowsObject('Login Page/optEnv'), Keys.chord(Keys.ENTER))
		Windows.delay(AFTER_ENV_SELECTION_DELAY_SEC)
	}

	@Keyword
	boolean isConnectButtonPresent() {
		return Windows.verifyElementPresent(
			findWindowsObject('Login Page/btnConnecter'),
			1,
			FailureHandling.OPTIONAL
		)
	}

	@Keyword
	void clickConnectButton() {
		Windows.click(findWindowsObject('Login Page/btnConnecter'))
	}

	@Keyword
	boolean waitForMainScreen() {
		try {
			boolean loaded = Windows.waitForElementPresent(
				findWindowsObject('General/txtSearch'),
				MAIN_SCREEN_TIMEOUT_SEC,
				FailureHandling.OPTIONAL
			)

			if (loaded) {
				Windows.delay(AFTER_MAIN_SCREEN_DELAY_SEC)
			}

			return loaded
		}
		catch (Exception ignored) {
			return false
		}
	}

	@Keyword
	void activateHomeTab() {
		String home = new File(RunConfiguration.getProjectDir(), 'Images/General/Home.PNG').getAbsolutePath()
		String homeGrey = new File(RunConfiguration.getProjectDir(), 'Images/General/HomeGrey.PNG').getAbsolutePath()
		String homeWhite = new File(RunConfiguration.getProjectDir(), 'Images/General/HomeWhite.PNG').getAbsolutePath()

		try {
			if (new File(home).exists()) {
				WindowsImageKeywords.clickImage(home)
				Windows.delay(AFTER_HOME_CLICK_DELAY_SEC)
				return
			}
		}
		catch (Exception ignored) {
		}

		try {
			if (new File(homeGrey).exists()) {
				def activeTab = WindowsImageKeywords.findImage(homeGrey)
				if (activeTab != null) {
					return
				}
			}
		}
		catch (Exception ignored) {
		}

		try {
			if (new File(homeWhite).exists()) {
				def inactiveTab = WindowsImageKeywords.findImage(homeWhite)
				if (inactiveTab != null) {
					Windows.click(inactiveTab)
					Windows.delay(AFTER_HOME_CLICK_DELAY_SEC)
					return
				}
			}
		}
		catch (Exception ignored) {
		}
	}
}





