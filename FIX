	@Keyword
	void openEnvironmentDropdown() {
		KeywordUtil.logInfo("Opening environment dropdown")

		focusLoginWindow(detectedWindowTitle)
		sleepMs(600)

		if (clickFirstAvailableImage(dropdownImageCandidates(), 3, 900, "Opening environment dropdown by image")) {
			sleepMs(1200)
			return
		}

		WindowsTestObject combo = envComboObj()

		if (waitPresent(combo, 5)) {
			try {
				Windows.click(combo)
				sleepMs(1200)
				return
			} catch (Throwable ignored) {
			}
		}

		KeywordUtil.logInfo("Environment combo not opened by image/object. Trying keyboard fallback.")
		robotCombo(KeyEvent.VK_ALT, KeyEvent.VK_DOWN)
		sleepMs(1200)
	}

	@Keyword
	int resolveEnvironmentIndex(String env) {
		String normalized = normalizeEnvCode(env)

		Map<String, Integer> indexes = [
			'PROD' : 1,
			'PREPO': 2,
			'REC2' : 3,
			'REC'  : 4,
			'DEV2' : 5,
			'DEV'  : 6
		]

		return indexes.containsKey(normalized) ? indexes[normalized] : 4
	}

	@Keyword
	void selectEnvironment(String env) {
		String normalizedEnv = normalizeEnvCode(env)
		String displayValue = resolveEnvironmentDisplayValue(env)
		int legacyIndex = resolveEnvironmentIndex(env)

		KeywordUtil.logInfo("Selecting environment ${displayValue}")

		focusLoginWindow(detectedWindowTitle)
		sleepMs(600)

		openEnvironmentDropdown()
		sleepMs(1000)

		// 1) REC by image, exactly as requested
		if (normalizedEnv == 'REC') {
			if (clickFirstAvailableImage(recImageCandidates(), 4, 900, "Selecting REC environment by image")) {
				sleepMs(1200)
				return
			}
		}

		// 2) direct click on visible list item by object
		try {
			WindowsTestObject itemObj = comboListItemObj(displayValue)
			if (waitPresent(itemObj, 3)) {
				KeywordUtil.logInfo("Selecting environment by direct object click ${displayValue}")
				Windows.click(itemObj)
				sleepMs(1200)
				return
			}
		} catch (Throwable ignored) {
		}

		// 3) legacy combo logic
		try {
			WindowsTestObject combo = envComboObj()
			if (waitPresent(combo, 3)) {
				KeywordUtil.logInfo("Selecting environment with legacy combo keyboard fallback")
				Windows.click(combo)
				sleepMs(500)

				for (int i = 0; i < legacyIndex; i++) {
					Windows.sendKeys(combo, Keys.chord(Keys.ARROW_DOWN))
					sleepMs(300)
				}

				Windows.sendKeys(combo, Keys.chord(Keys.ENTER))
				sleepMs(1200)
				return
			}
		} catch (Throwable ignored) {
		}

		// 4) hard fallback with Robot
		KeywordUtil.logInfo("Pressing ARROW_DOWN ${legacyIndex} times")
		for (int i = 0; i < legacyIndex; i++) {
			robotKey(KeyEvent.VK_DOWN)
			sleepMs(300)
		}

		KeywordUtil.logInfo("Confirming selected environment with ENTER")
		robotKey(KeyEvent.VK_ENTER)
		sleepMs(1200)
	}

	@Keyword
	boolean isConnectButtonPresent() {
		if (firstExistingImage(connectImageCandidates())) {
			return true
		}
		return waitPresent(connectBtnObj(), 5)
	}

	@Keyword
	void clickConnectButton() {
		KeywordUtil.logInfo("Confirming login")

		focusLoginWindow(detectedWindowTitle)
		sleepMs(500)

		// 1) image first
		if (clickFirstAvailableImage(connectImageCandidates(), 4, 1000, "Clicking connect button by image")) {
			sleepMs(1500)
			return
		}

		// 2) object fallback
		WindowsTestObject btn = connectBtnObj()
		if (waitPresent(btn, 5)) {
			try {
				Windows.click(btn)
				sleepMs(1500)
				return
			} catch (Throwable ignored) {
			}
		}

		// 3) ENTER fallback
		KeywordUtil.logInfo("Connect button not clicked by image/object. Trying ENTER fallback.")
		robotKey(KeyEvent.VK_ENTER)
		sleepMs(1500)
	}

	@Keyword
	boolean waitForMainScreen() {
		KeywordUtil.logInfo("Waiting for main eMatch screen")

		// 1) definitive confirmation by HomeGrey image
		if (waitForHomeGrey(40)) {
			return true
		}

		// 2) object fallback
		long end = System.currentTimeMillis() + 30000L

		while (System.currentTimeMillis() < end) {
			if (waitPresent(mainSearchObj(), 2)) {
				return true
			}

			if (waitPresent(homeTabObj(), 2)) {
				return true
			}

			sleepMs(1000)
		}

		return false
	}

	@Keyword
	void activateHomeTab() {
		try {
			if (clickFirstAvailableImage(homeGreyImageCandidates(), 2, 800, "Activating Home tab by image")) {
				sleepMs(800)
				return
			}
		} catch (Throwable ignored) {
		}

		try {
			WindowsTestObject homeTab = homeTabObj()
			if (waitPresent(homeTab, 5)) {
				Windows.click(homeTab)
				sleepMs(800)
				return
			}
		} catch (Throwable ignored) {
		}

		try {
			String home = new File(RunConfiguration.getProjectDir(), 'Images/General/Home.PNG').getAbsolutePath()
			if (new File(home).exists()) {
				WindowsImageKeywords.clickImage(home)
				sleepMs(1000)
			}
		} catch (Throwable ignored) {
		}
	}

	@Keyword
	void loginThroughNativeControls() {
		loginThroughNativeControls(safe(GlobalVariable.env) ?: 'REC')
	}

	@Keyword
	void loginThroughNativeControls(String env) {
		String resolvedEnv = safe(env) ?: safe(GlobalVariable.env) ?: 'REC'

		KeywordUtil.logInfo("Logging through native controls for env ${resolvedEnv}")

		focusLoginWindow(detectedWindowTitle)
		sleepMs(700)

		// first dropdown
		openEnvironmentDropdown()
		sleepMs(1000)

		// then select REC or requested env
		selectEnvironment(resolvedEnv)
		sleepMs(1200)

		// then confirm login
		clickConnectButton()
		sleepMs(1500)

		boolean mainScreenLoaded = waitForMainScreen()

		if (!mainScreenLoaded) {
			KeywordUtil.markFailedAndStop("eMatch main screen was not loaded. HomeGrey / txtSearch not found.")
		}

		activateHomeTab()
		KeywordUtil.logInfo("eMatch startup flow completed successfully for environment ${resolvedEnv}")
	}






