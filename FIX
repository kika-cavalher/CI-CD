    private String safeValue(def value) {
        if (value == null) {
            return ''
        }
        return String.valueOf(value).trim()
    }

    private String htmlEscape(def value) {
        String text = safeValue(value)
        return text
            .replace('&', '&amp;')
            .replace('<', '&lt;')
            .replace('>', '&gt;')
            .replace('"', '&quot;')
            .replace("'", '&#39;')
    }

    private int toInt(def value) {
        try {
            return Integer.parseInt(safeValue(value))
        } catch (Exception ignored) {
            return 0
        }
    }

    private String resolveStatusClass(def value) {
        String status = safeValue(value).toLowerCase()

        if (status == 'failed' || status == 'fail') {
            return 'fail'
        }
        if (status == 'skipped' || status == 'skip') {
            return 'skip'
        }
        if (status == 'info') {
            return 'info'
        }

        return 'pass'
    }

    private String resolveStatusLabel(def value) {
        String status = safeValue(value).toLowerCase()

        if (status == 'failed' || status == 'fail') {
            return 'Fail'
        }
        if (status == 'skipped' || status == 'skip') {
            return 'Skipped'
        }
        if (status == 'info') {
            return 'Info'
        }

        return 'Pass'
    }

    private String buildTag(String text, String cssClass) {
        StringBuilder html = new StringBuilder()
        html.append('<span class="header-tag ')
        html.append(htmlEscape(cssClass))
        html.append('">')
        html.append(htmlEscape(text))
        html.append('</span>')
        return html.toString()
    }

    private String buildSidebarLine(Map item, boolean active) {
        String itemStatusClass = resolveStatusClass(item.statusClass ?: item.status)
        String itemStatusLabel = resolveStatusLabel(item.statusLabel ?: item.status)

        String searchValue = (
            safeValue(item.shortName) + ' ' +
            safeValue(item.name) + ' ' +
            safeValue(item.status) + ' ' +
            safeValue(item.durationText)
        ).toLowerCase()

        StringBuilder html = new StringBuilder()

        html.append('<button type="button" class="test-line ')
        if (active) {
            html.append('active ')
        }
        html.append(itemStatusClass)
        html.append('" ')
        html.append('data-target="')
        html.append(htmlEscape(item.id))
        html.append('" ')
        html.append('data-search="')
        html.append(htmlEscape(searchValue))
        html.append('">')

        html.append('<div class="test-line-left">')
        html.append('<div class="test-line-title">')
        html.append(htmlEscape(item.shortName))
        html.append('</div>')
        html.append('</div>')

        html.append('<div class="test-line-right">')
        html.append('<span class="line-badge ')
        html.append(itemStatusClass)
        html.append('">')
        html.append(htmlEscape(itemStatusLabel))
        html.append('</span>')
        html.append('<span class="line-duration">')
        html.append(htmlEscape(item.durationText))
        html.append('</span>')
        html.append('</div>')

        html.append('</button>')

        return html.toString()
    }

    private String buildChartPanel(Map model) {
        int executed = toInt(model.executed)
        int passed = toInt(model.passed)
        int failed = toInt(model.failed)
        int skipped = toInt(model.skipped)

        if (executed <= 0) {
            executed = 1
        }

        double passPct = (passed * 100.0d) / executed
        double failPct = (failed * 100.0d) / executed
        double skipPct = (skipped * 100.0d) / executed

        double passEnd = passPct
        double failEnd = passPct + failPct
        double skipEnd = passPct + failPct + skipPct

        String donutStyle = "background: conic-gradient(" +
            STATUS_PASS + " 0% " + String.format(Locale.ENGLISH, '%.2f', passEnd) + "%, " +
            STATUS_FAIL + " " + String.format(Locale.ENGLISH, '%.2f', passEnd) + "% " + String.format(Locale.ENGLISH, '%.2f', failEnd) + "%, " +
            STATUS_SKIP + " " + String.format(Locale.ENGLISH, '%.2f', failEnd) + "% " + String.format(Locale.ENGLISH, '%.2f', skipEnd) + "%, " +
            "#dfe8f1 " + String.format(Locale.ENGLISH, '%.2f', skipEnd) + "% 100%)"

        StringBuilder html = new StringBuilder()

        html.append('<div class="chart-panel">')

        html.append('<div class="donut-wrap">')
        html.append('<div class="donut-chart" style="')
        html.append(htmlEscape(donutStyle))
        html.append('">')
        html.append('<div class="donut-inner">')
        html.append('<div class="donut-total">')
        html.append(htmlEscape(String.valueOf(toInt(model.executed))))
        html.append('</div>')
        html.append('<div class="donut-label">Tests</div>')
        html.append('</div>')
        html.append('</div>')
        html.append('</div>')

        html.append('<div class="chart-legend">')
        html.append('<div class="legend-row"><span class="legend-dot pass"></span><span>Passed</span><strong>')
        html.append(htmlEscape(String.valueOf(passed)))
        html.append('</strong></div>')

        html.append('<div class="legend-row"><span class="legend-dot fail"></span><span>Failed</span><strong>')
        html.append(htmlEscape(String.valueOf(failed)))
        html.append('</strong></div>')

        html.append('<div class="legend-row"><span class="legend-dot skip"></span><span>Skipped</span><strong>')
        html.append(htmlEscape(String.valueOf(skipped)))
        html.append('</strong></div>')
        html.append('</div>')

        html.append('<div class="chart-bars">')
        html.append(buildHorizontalMetric('Passed', passed, toInt(model.executed), 'pass'))
        html.append(buildHorizontalMetric('Failed', failed, toInt(model.executed), 'fail'))
        html.append(buildHorizontalMetric('Skipped', skipped, toInt(model.executed), 'skip'))
        html.append('</div>')

        html.append('</div>')

        return html.toString()
    }

    private String buildHorizontalMetric(String label, int value, int total, String cssClass) {
        int safeTotal = total <= 0 ? 1 : total
        double pct = (value * 100.0d) / safeTotal

        StringBuilder html = new StringBuilder()
        html.append('<div class="metric-row">')
        html.append('<div class="metric-head"><span>')
        html.append(htmlEscape(label))
        html.append('</span><strong>')
        html.append(htmlEscape(String.valueOf(value)))
        html.append('</strong></div>')
        html.append('<div class="metric-track"><div class="metric-fill ')
        html.append(htmlEscape(cssClass))
        html.append('" style="width:')
        html.append(htmlEscape(String.format(Locale.ENGLISH, '%.2f', pct)))
        html.append('%"></div></div>')
        html.append('</div>')
        return html.toString()
    }

    private List<Map> buildEventRows(Map item) {
        List<Map> rows = []

        String testTime = safeValue(item.timeText)
        String statusClass = resolveStatusClass(item.status)
        String statusLabel = resolveStatusLabel(item.status)

        rows.add([
            badge : 'info',
            time  : testTime,
            detail: 'Test execution started'
        ])

        rows.add([
            badge : statusClass,
            time  : testTime,
            detail: 'Final status: ' + statusLabel
        ])

        rows.add([
            badge : 'info',
            time  : testTime,
            detail: 'Duration: ' + safeValue(item.durationText)
        ])

        List<String> summaryLines = (item.summaryLines ?: []) as List<String>
        summaryLines.each { String line ->
            rows.add([
                badge : statusClass == 'pass' ? 'info' : statusClass,
                time  : testTime,
                detail: safeValue(line)
            ])
        }

        if (summaryLines.isEmpty() && statusClass == 'pass') {
            rows.add([
                badge : 'pass',
                time  : testTime,
                detail: 'Test passed successfully'
            ])
        }

        if (summaryLines.isEmpty() && statusClass == 'skip') {
            rows.add([
                badge : 'skip',
                time  : testTime,
                detail: 'Test skipped'
            ])
        }

        return rows
    }

    private String buildStepsTable(Map item) {
        List<Map> rows = buildEventRows(item)
        StringBuilder html = new StringBuilder()

        html.append('<table class="steps-table">')
        html.append('<thead>')
        html.append('<tr>')
        html.append('<th>Status</th>')
        html.append('<th>Timestamp</th>')
        html.append('<th>Details</th>')
        html.append('</tr>')
        html.append('</thead>')
        html.append('<tbody>')

        rows.each { Map row ->
            String badgeClass = resolveStatusClass(row.badge)
            String badgeLabel = resolveStatusLabel(row.badge)

            html.append('<tr>')
            html.append('<td><span class="step-badge ')
            html.append(htmlEscape(badgeClass))
            html.append('">')
            html.append(htmlEscape(badgeLabel))
            html.append('</span></td>')
            html.append('<td>')
            html.append(htmlEscape(row.time))
            html.append('</td>')
            html.append('<td>')
            html.append(htmlEscape(row.detail))
            html.append('</td>')
            html.append('</tr>')
        }

        html.append('</tbody>')
        html.append('</table>')

        return html.toString()
    }

    private String buildVisualErrorLog(Map item) {
        List<String> summaryLines = (item.summaryLines ?: []) as List<String>
        String statusClass = resolveStatusClass(item.status)

        if (summaryLines.isEmpty() && statusClass == 'pass') {
            return ''
        }

        StringBuilder html = new StringBuilder()
        html.append('<div class="log-card ')
        html.append(htmlEscape(statusClass))
        html.append('">')
        html.append('<div class="section-title">Visual Error Log</div>')

        if (summaryLines.isEmpty()) {
            html.append('<div class="log-line">No summarized error lines available.</div>')
        } else {
            summaryLines.each { String line ->
                html.append('<div class="log-line">')
                html.append(htmlEscape(line))
                html.append('</div>')
            }
        }

        html.append('</div>')
        return html.toString()
    }

    private String buildRawErrorSection(Map item) {
        String details = safeValue(item.details)
        if (details.isEmpty()) {
            return ''
        }

        StringBuilder html = new StringBuilder()
        html.append('<div class="raw-card">')
        html.append('<details class="raw-details">')
        html.append('<summary>Open full technical log</summary>')
        html.append('<pre>')
        html.append(htmlEscape(details))
        html.append('</pre>')
        html.append('</details>')
        html.append('</div>')
        return html.toString()
    }

    private String buildEvidenceSection(Map item) {
        List<Map> evidences = []

        if (item.evidences instanceof Collection) {
            item.evidences.eachWithIndex { def ev, int index ->
                if (ev instanceof Map && safeValue(ev.src)) {
                    evidences.add([
                        name: safeValue(ev.name) ?: "Evidence ${index + 1}",
                        src : safeValue(ev.src)
                    ])
                }
            }
        }

        if (evidences.isEmpty() && safeValue(item.imageData)) {
            evidences.add([
                name: safeValue(item.imageName) ?: 'Evidence 1',
                src : safeValue(item.imageData)
            ])
        }

        if (evidences.isEmpty()) {
            return ''
        }

        StringBuilder html = new StringBuilder()
        html.append('<div class="evidence-card">')
        html.append('<div class="section-title">Evidences</div>')

        evidences.eachWithIndex { Map ev, int index ->
            html.append('<details class="evidence-row" ')
            if (index == 0) {
                html.append('open ')
            }
            html.append('>')
            html.append('<summary>')
            html.append('<span>')
            html.append(htmlEscape(ev.name))
            html.append('</span>')
            html.append('<span class="evidence-summary-text">Click to expand</span>')
            html.append('</summary>')
            html.append('<div class="evidence-content">')
            html.append('<img src="')
            html.append(htmlEscape(ev.src))
            html.append('" alt="Evidence image" class="evidence-image">')
            html.append('</div>')
            html.append('</details>')
        }

        html.append('</div>')
        return html.toString()
    }

    private String buildDetailPanel(Map model, Map item, boolean active) {
        String itemStatusClass = resolveStatusClass(item.status)
        String itemStatusLabel = resolveStatusLabel(item.status)

        StringBuilder html = new StringBuilder()
        html.append('<section class="detail-panel ')
        if (active) {
            html.append('active')
        }
        html.append('" id="')
        html.append(htmlEscape(item.id))
        html.append('">')

        html.append('<div class="detail-main-title">')
        html.append(htmlEscape(REPORT_TITLE_PREFIX + safeValue(model.suiteName)))
        html.append('</div>')

        html.append('<div class="detail-subtitle">')
        html.append(htmlEscape(item.name))
        html.append('</div>')

        html.append('<div class="detail-tags">')
        html.append(buildTag('Suite: ' + safeValue(model.suiteName), 'neutral'))
        html.append(buildTag('Status: ' + itemStatusLabel, itemStatusClass))
        html.append(buildTag('Start: ' + safeValue(item.startDateText), 'neutral'))
        html.append(buildTag('Duration: ' + safeValue(item.durationText), 'neutral'))
        html.append('</div>')

        html.append('<div class="detail-section">')
        html.append('<div class="section-title">Steps</div>')
        html.append(buildStepsTable(item))
        html.append('</div>')

        html.append(buildVisualErrorLog(item))
        html.append(buildRawErrorSection(item))
        html.append(buildEvidenceSection(item))

        html.append('</section>')
        return html.toString()
    }

