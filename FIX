@echo off
setlocal EnableExtensions EnableDelayedExpansion

REM ============================================================
REM  eMatch - Desktop execution entrypoint (Interactive session)
REM  Reads:  D:\Projects\eMatchStarters\run-context.properties
REM  Writes: logs\katalon_*.log
REM  Writes: %MARKER_FILE% with exit code (for Jenkins to stop waiting)
REM ============================================================

set "CTX_FILE=D:\Projects\eMatchStarters\run-context.properties"
set "LOG_DIR=D:\Projects\eMatchStarters\logs"

if not exist "%LOG_DIR%" (
  mkdir "%LOG_DIR%" >nul 2>&1
)

if not exist "%CTX_FILE%" (
  echo [ERROR] Missing context file: "%CTX_FILE%"
  exit /b 2
)

REM ---- Load properties (key=value) ----
for /f "usebackq tokens=1,* delims==" %%A in ("%CTX_FILE%") do (
  set "K=%%A"
  set "V=%%B"
  if not "!K!"=="" set "!K!=!V!"
)

REM ---- Required vars ----
if "%WORKSPACE%"=="" (
  echo [ERROR] WORKSPACE is empty in run-context.properties
  exit /b 3
)

if "%KATALON_EXE%"=="" (
  echo [ERROR] KATALON_EXE is empty in run-context.properties
  exit /b 4
)

if "%COLLECTION_PATH%"=="" (
  echo [ERROR] COLLECTION_PATH is empty in run-context.properties
  exit /b 5
)

if "%PROJECT_PATH%"=="" (
  echo [ERROR] PROJECT_PATH is empty in run-context.properties
  exit /b 6
)

if "%MARKER_FILE%"=="" (
  echo [ERROR] MARKER_FILE is empty in run-context.properties
  exit /b 7
)

if "%BROWSER_TYPE%"=="" set "BROWSER_TYPE=Windows"
if "%RETRY%"=="" set "RETRY=0"

REM ---- Log file name ----
for /f "tokens=1-3 delims=/: " %%a in ("%date%") do set "D=%%c%%b%%a"
for /f "tokens=1-3 delims=:." %%a in ("%time%") do set "T=%%a%%b%%c"

set "LOG_FILE=%LOG_DIR%\katalon_%D%_%T%.log"

echo [INFO] WORKSPACE      = "%WORKSPACE%"
echo [INFO] PROJECT_PATH   = "%PROJECT_PATH%"
echo [INFO] KATALON_EXE    = "%KATALON_EXE%"
echo [INFO] COLLECTION     = "%COLLECTION_PATH%"
echo [INFO] BROWSER_TYPE   = "%BROWSER_TYPE%"
echo [INFO] RETRY          = "%RETRY%"
echo [INFO] LOG_FILE       = "%LOG_FILE%"
echo [INFO] MARKER_FILE    = "%MARKER_FILE%"
echo.

REM ---- Clean marker before running ----
del /f /q "%MARKER_FILE%" >nul 2>&1

REM ---- Execute Katalon (console visible) ----
"%KATALON_EXE%" ^
  -noSplash ^
  -runMode=console ^
  -projectPath="%PROJECT_PATH%" ^
  -testSuiteCollectionPath="%COLLECTION_PATH%" ^
  -executionProfile="default" ^
  -browserType="%BROWSER_TYPE%" ^
  -retry="%RETRY%" ^
  > "%LOG_FILE%" 2>&1

set "KEX=%errorlevel%"

echo.
echo [INFO] Katalon exit code = %KEX%

echo %KEX%> "%MARKER_FILE%"

exit /b %KEX%


cmd /k "D:\Projects\eMatchStarters\run-ematch-command.bat"
