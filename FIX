    @Keyword
    int resolveEnvironmentIndex(String env) {
        switch (normalizeEnv(env)) {
            case 'PROD':
                return 0
            case 'PREO':
                return 1
            case 'REC2':
                return 2
            case 'REC':
                return 3
            case 'DEV2':
                return 4
            case 'DEV':
                return 5
            default:
                return 3
        }
    }

    @Keyword
    void selectEnvironment(String env) {
        WindowsTestObject combo = getEnvironmentCombo()
        if (!waitForPresent(combo, 20)) {
            KeywordUtil.markFailedAndStop("Environment combo was not found before selection.")
        }

        int envIndex = resolveEnvironmentIndex(env)

        Windows.click(combo)
        sleep(800)

        Robot robot = new Robot()
        robot.setAutoDelay(120)

        pressKey(robot, KeyEvent.VK_HOME)

        for (int i = 0; i < envIndex; i++) {
            pressKey(robot, KeyEvent.VK_DOWN)
        }

        pressKey(robot, KeyEvent.VK_ENTER)
        sleep(1000)
    }

    @Keyword
    boolean isConnectButtonPresent() {
        return waitForPresent(getConnectButton(), 5)
    }

    @Keyword
    void clickConnectButton() {
        WindowsTestObject btn = getConnectButton()
        if (!waitForPresent(btn, 10)) {
            KeywordUtil.markFailedAndStop("Connect button was not found.")
        }

        Windows.click(btn)
        sleep(1500)
    }

    @Keyword
    boolean waitForMainScreen() {
        WindowsTestObject refreshBtn = getRefreshButton()
        WindowsTestObject loginBtn = getConnectButton()

        long end = System.currentTimeMillis() + (90 * 1000)

        while (System.currentTimeMillis() < end) {
            try {
                if (waitForPresent(refreshBtn, 2)) {
                    return true
                }

                if (!waitForPresent(loginBtn, 1)) {
                    if (waitForPresent(refreshBtn, 5)) {
                        return true
                    }
                }
            } catch (Throwable ignored) {
            }

            sleep(1000)
        }

        return false
    }

    @Keyword
    void activateHomeTab() {
        WindowsTestObject homeTab = getHomeTab()

        if (waitForPresent(homeTab, 5)) {
            Windows.click(homeTab)
            sleep(700)
        }
    }

