	@Keyword
	void applySectionFilter(
		String filterValue,
		String language,
		Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds, 3)
		String normalizedLanguage =
			safeText(language).equalsIgnoreCase('en')
				? 'en'
				: 'fr'

		String textFilterKey =
			normalizedLanguage == 'en'
				? 'textFilterEN'
				: 'textFilterFR'

		String closeFilterKey =
			normalizedLanguage == 'en'
				? 'closeFiltersButtonEN'
				: 'closeFiltersButtonFR'

		logStep(
			'SECTION FILTER',
			'Apply section filter value: ' + filterValue
		)

		clickImage(
			GUI_IMAGE_GROUP,
			'sectionFilter',
			timeout
		)

		clickImage(
			GUI_IMAGE_GROUP,
			'filterButton',
			timeout
		)

