package jiraIntegration

import java.io.File
import java.nio.file.Files
import java.text.SimpleDateFormat
import java.util.Base64
import java.util.Date
import java.util.Locale

import groovy.json.JsonSlurper
import groovy.xml.XmlSlurper

class JiraGaiaReportBuilder {

    JiraFlowCoordinator flow
    JiraGaiaHtmlTemplateBuilder templateBuilder

    JiraGaiaReportBuilder(JiraFlowCoordinator flow) {
        this.flow = flow
        this.templateBuilder = new JiraGaiaHtmlTemplateBuilder()
    }

    String createGaiaHtmlReport(String reportFolder, String suiteName, String xmlPath) {
        if (isBlank(reportFolder)) {
            return ''
        }

        List<Map> cases = parseCucumberCases(reportFolder)

        if (cases.isEmpty()) {
            cases = parseXmlCases(xmlPath)
        }

        Map<String, List<Map>> scenarioEvents = parseScenarioEvents(reportFolder)
        enrichCasesWithScenarioEvents(cases, scenarioEvents)

        attachEvidenceImages(cases, reportFolder)
        calculateCaseTimes(cases, reportFolder)
        fillCaseSummaries(cases)

        Map counts = calculateCounts(cases)
        String logoDataUri = resolveLogoDataUri(reportFolder)

        Map model = [
            suiteName    : safeValue(suiteName),
            generatedAt  : formatDateTime(new Date()),
            total        : counts.total,
            passed       : counts.passed,
            failed       : counts.failed,
            skipped      : counts.skipped,
            startAt      : cases ? safeValue(cases.first().startAt) : '',
            endAt        : cases ? safeValue(cases.last().endAt) : '',
            durationText : formatDurationMillis(sumDuration(cases)),
            logoDataUri  : logoDataUri,
            cases        : cases
        ]

        String html = templateBuilder.buildHtml(model)

        File htmlFile = new File(reportFolder + File.separator + flow.GAIA_REPORT_FILE_NAME)
        htmlFile.setText(html, 'UTF-8')
        return htmlFile.absolutePath
    }

    private List<Map> parseCucumberCases(String reportFolder) {
        List<Map> result = []

        File cucumberJson = findFirstFileByNames(reportFolder, ['cucumber.json', 'k-cucumber.json'])
        if (cucumberJson == null || !cucumberJson.exists()) {
            return result
        }

        def parsed
        try {
            parsed = new JsonSlurper().parse(cucumberJson)
        } catch (Exception ignored) {
            return result
        }

        if (!(parsed instanceof List)) {
            return result
        }

        parsed.each { feature ->
            List elements = feature?.elements instanceof List ? feature.elements : []
            elements.each { scenario ->
                String scenarioType = safeValue(scenario?.type)
                if (scenarioType == 'background') {
                    return
                }

                String scenarioName = safeValue(scenario?.name)
                List stepItems = []
                long totalDurationMs = 0L
                String finalStatus = 'passed'
                String errorSummary = ''
                String errorFull = ''

                List steps = scenario?.steps instanceof List ? scenario.steps : []
                steps.each { step ->
                    String keyword = safeValue(step?.keyword)
                    String name = safeValue(step?.name)
                    String detail = (keyword + ' ' + name).trim()

                    Map resultNode = step?.result instanceof Map ? step.result : [:]
                    String rawStatus = safeValue(resultNode?.status).toLowerCase(Locale.ENGLISH)
                    long durationNs = toLong(resultNode?.duration)
                    long durationMs = durationNs > 0L ? (long) (durationNs / 1_000_000L) : 0L
                    totalDurationMs += durationMs

                    String mappedStatus = mapCucumberStatus(rawStatus)
                    String errorMessage = safeValue(resultNode?.error_message)

                    if (mappedStatus == 'fail') {
                        finalStatus = 'fail'
                        if (isBlank(errorSummary)) {
                            errorSummary = firstMeaningfulErrorLine(errorMessage)
                        }
                        if (isBlank(errorFull)) {
                            errorFull = errorMessage
                        }
                    } else if (mappedStatus == 'skip' && finalStatus != 'fail') {
                        finalStatus = 'skip'
                    }

                    Map row = [
                        status     : mappedStatus,
                        timestamp  : '',
                        details    : detail,
                        fullText   : errorMessage,
                        durationMs : durationMs
                    ]

                    stepItems.add(row)
                }

                Map caseRow = [
                    id           : 'case_' + (result.size() + 1),
                    name         : scenarioName,
                    shortName    : scenarioName,
                    status       : finalStatus,
                    durationMs   : totalDurationMs,
                    durationText : formatDurationMillis(totalDurationMs),
                    steps        : stepItems,
                    summary      : '',
                    errorSummary : errorSummary,
                    errorFull    : errorFull,
                    evidences    : [],
                    startAt      : '',
                    endAt        : ''
                ]

                result.add(caseRow)
            }
        }

        return result
    }

    private List<Map> parseXmlCases(String xmlPath) {
        List<Map> result = []

        if (isBlank(xmlPath)) {
            return result
        }

        File xmlFile = new File(xmlPath)
        if (!xmlFile.exists()) {
            return result
        }

        def xml
        try {
            xml = new XmlSlurper().parse(xmlFile)
        } catch (Exception ignored) {
            return result
        }

        List testcaseNodes = []
        String rootName = safeValue(xml.name())

        if (rootName == 'testsuite') {
            testcaseNodes.addAll(xml.testcase)
        } else if (rootName == 'testsuites') {
            xml.testsuite.each { suite ->
                testcaseNodes.addAll(suite.testcase)
            }
        }

        testcaseNodes.each { tc ->
            String className = safeValue(tc.@classname?.toString())
            String testName = safeValue(tc.@name?.toString())
            long durationMs = toMillis(tc.@time?.toString())

            def failureNode = tc.failure?.size() > 0 ? tc.failure[0] : null
            def errorNode = tc.error?.size() > 0 ? tc.error[0] : null
            def skippedNode = tc.skipped?.size() > 0 ? tc.skipped[0] : null

            boolean failed = failureNode != null || errorNode != null
            boolean skipped = skippedNode != null

            String message = ''
            String details = ''

            if (failureNode != null) {
                message = safeValue(failureNode.@message?.toString())
                details = safeValue(failureNode.text())
            } else if (errorNode != null) {
                message = safeValue(errorNode.@message?.toString())
                details = safeValue(errorNode.text())
            } else if (skippedNode != null) {
                message = safeValue(skippedNode.@message?.toString())
                details = safeValue(skippedNode.text())
            }

            String displayName = ''
            if (!isBlank(className) && !isBlank(testName)) {
                displayName = className + '/' + testName
            } else if (!isBlank(testName)) {
                displayName = testName
            } else {
                displayName = className
            }

            Map row = [
                id           : 'case_' + (result.size() + 1),
                name         : displayName,
                shortName    : isBlank(testName) ? displayName : testName,
                status       : skipped ? 'skip' : (failed ? 'fail' : 'pass'),
                durationMs   : durationMs,
                durationText : formatDurationMillis(durationMs),
                steps        : [],
                summary      : '',
                errorSummary : firstMeaningfulErrorLine(message + '\n' + details),
                errorFull    : details,
                evidences    : [],
                startAt      : '',
                endAt        : ''
            ]

            result.add(row)
        }

        return result
    }

    private Map<String, List<Map>> parseScenarioEvents(String reportFolder) {
        Map<String, List<Map>> scenarioEvents = [:]

        File logFile = findFirstExecutionLog(reportFolder)
        if (logFile == null || !logFile.exists()) {
            return scenarioEvents
        }

        String currentScenario = ''
        List<String> lines = []

        try {
            lines = logFile.readLines('UTF-8')
        } catch (Exception ignored) {
            return scenarioEvents
        }

        lines.each { String rawLine ->
            String line = stripAnsi(rawLine)
            String time = extractTime(line)
            String message = extractMessage(line)

            if (message.contains('SCENARIO ')) {
                currentScenario = safeValue(message.substring(message.indexOf('SCENARIO ') + 'SCENARIO '.length()))
                if (!scenarioEvents.containsKey(currentScenario)) {
                    scenarioEvents[currentScenario] = []
                }
                return
            }

            if (isBlank(currentScenario)) {
                return
            }

            if (message.startsWith('Failed scenarios:')) {
                currentScenario = ''
                return
            }

            if (!isInterestingScenarioLine(message)) {
                return
            }

            Map eventRow = [
                status    : classifyEventStatus(message),
                timestamp : time,
                details   : oneLine(message, 180),
                fullText  : safeValue(message),
                durationMs: 0L
            ]

            scenarioEvents[currentScenario].add(eventRow)
        }

        return scenarioEvents
    }

    private void enrichCasesWithScenarioEvents(List<Map> cases, Map<String, List<Map>> scenarioEvents) {
        if (cases == null || cases.isEmpty() || scenarioEvents == null || scenarioEvents.isEmpty()) {
            return
        }

        cases.each { Map caseRow ->
            String caseNameKey = normalizeKey(caseRow.name)
            String matchedKey = ''

            scenarioEvents.keySet().each { String scenarioName ->
                String scenarioKey = normalizeKey(scenarioName)
                if (caseNameKey == scenarioKey || caseNameKey.contains(scenarioKey) || scenarioKey.contains(caseNameKey)) {
                    matchedKey = scenarioName
                }
            }

            if (!isBlank(matchedKey)) {
                List<Map> events = scenarioEvents[matchedKey]
                if (events != null && !events.isEmpty()) {
                    caseRow.steps = events
                }
            }
        }
    }

    private void attachEvidenceImages(List<Map> cases, String reportFolder) {
        List<File> images = collectImages(reportFolder)
        if (images.isEmpty() || cases == null || cases.isEmpty()) {
            return
        }

        List<Map> failedCases = cases.findAll { Map item -> safeValue(item.status) == 'fail' }

        if (failedCases.size() == 1) {
            failedCases[0].evidences = images.collect { File img ->
                [
                    name    : img.name,
                    dataUri : toImageDataUri(img)
                ]
            }
            return
        }

        int index = 0
        failedCases.each { Map item ->
            List evidences = []
            if (index < images.size()) {
                evidences.add([
                    name    : images[index].name,
                    dataUri : toImageDataUri(images[index])
                ])
                index++
            }
            item.evidences = evidences
        }
    }

    private void calculateCaseTimes(List<Map> cases, String reportFolder) {
        if (cases == null || cases.isEmpty()) {
            return
        }

        long totalDurationMs = sumDuration(cases)
        File reportDir = new File(reportFolder)

        long endMillis = reportDir.exists() ? reportDir.lastModified() : System.currentTimeMillis()
        long startMillis = endMillis - totalDurationMs

        long cursor = startMillis
        cases.each { Map caseRow ->
            long caseDuration = toLong(caseRow.durationMs)

            Date startDate = new Date(cursor)
            Date endDate = new Date(cursor + caseDuration)

            caseRow.startAt = formatTime(startDate)
            caseRow.endAt = formatTime(endDate)

            List<Map> steps = caseRow.steps instanceof List ? caseRow.steps : []
            long stepCursor = cursor

            steps.each { Map step ->
                long stepDuration = toLong(step.durationMs)
                if (isBlank(step.timestamp)) {
                    step.timestamp = formatTime(new Date(stepCursor))
                }
                stepCursor += stepDuration
            }

            cursor += caseDuration
        }
    }

    private void fillCaseSummaries(List<Map> cases) {
        cases.each { Map caseRow ->
            String summary = ''

            if (!isBlank(caseRow.errorSummary)) {
                summary = caseRow.errorSummary
            } else {
                List steps = caseRow.steps instanceof List ? caseRow.steps : []
                if (!steps.isEmpty()) {
                    Map firstFail = steps.find { Map row -> safeValue(row.status) == 'fail' }
                    if (firstFail != null) {
                        summary = safeValue(firstFail.details)
                    } else {
                        Map firstStep = steps[0]
                        summary = safeValue(firstStep.details)
                    }
                }
            }

            caseRow.summary = oneLine(summary, 92)
        }
    }

    private Map calculateCounts(List<Map> cases) {
        int passed = 0
        int failed = 0
        int skipped = 0

        cases.each { Map caseRow ->
            String status = safeValue(caseRow.status)
            if (status == 'pass') {
                passed++
            } else if (status == 'fail') {
                failed++
            } else {
                skipped++
            }
        }

        return [
            total  : cases.size(),
            passed : passed,
            failed : failed,
            skipped: skipped
        ]
    }

    private String resolveLogoDataUri(String reportFolder) {
        List<File> candidates = []

        candidates.add(new File(System.getProperty('user.dir') + File.separator + JiraGaiaHtmlTemplateBuilder.LOGO_PROJECT_PATH))
        candidates.add(new File(reportFolder + File.separator + JiraGaiaHtmlTemplateBuilder.LOGO_PROJECT_PATH))
        candidates.add(new File(System.getProperty('user.dir') + File.separator + 'Image' + File.separator + 'gaia-logo.png'))
        candidates.add(new File(System.getProperty('user.dir') + File.separator + 'image' + File.separator + 'gaia-logo.png'))

        File chosen = candidates.find { File file -> file.exists() && file.isFile() }

        if (chosen == null) {
            return ''
        }

        try {
            byte[] bytes = Files.readAllBytes(chosen.toPath())
            String base64 = Base64.encoder.encodeToString(bytes)
            return 'data:image/png;base64,' + base64
        } catch (Exception ignored) {
            return ''
        }
    }

    private File findFirstExecutionLog(String reportFolder) {
        List<File> matches = []
        new File(reportFolder).eachFileRecurse { File file ->
            if (file.isFile() && file.name.toLowerCase(Locale.ENGLISH).startsWith('execution') && file.name.toLowerCase(Locale.ENGLISH).endsWith('.log')) {
                matches.add(file)
            }
        }

        matches.sort { File a, File b -> a.lastModified() <=> b.lastModified() }
        return matches ? matches[0] : null
    }

    private File findFirstFileByNames(String root, List<String> names) {
        List<File> matches = []
        List<String> lowered = names.collect { String item -> item.toLowerCase(Locale.ENGLISH) }

        new File(root).eachFileRecurse { File file ->
            if (file.isFile() && lowered.contains(file.name.toLowerCase(Locale.ENGLISH))) {
                matches.add(file)
            }
        }

        matches.sort { File a, File b -> a.absolutePath <=> b.absolutePath }
        return matches ? matches[0] : null
    }

    private List<File> collectImages(String reportFolder) {
        List<File> matches = []
        new File(reportFolder).eachFileRecurse { File file ->
            if (!file.isFile()) {
                return
            }

            String lower = file.name.toLowerCase(Locale.ENGLISH)
            if (lower.endsWith('.png') || lower.endsWith('.jpg') || lower.endsWith('.jpeg') || lower.endsWith('.webp')) {
                matches.add(file)
            }
        }

        matches.sort { File a, File b -> a.lastModified() <=> b.lastModified() }
        return matches
    }

    private String toImageDataUri(File file) {
        try {
            byte[] bytes = Files.readAllBytes(file.toPath())
            String base64 = Base64.encoder.encodeToString(bytes)

            String lower = file.name.toLowerCase(Locale.ENGLISH)
            String mime = 'image/png'
            if (lower.endsWith('.jpg') || lower.endsWith('.jpeg')) {
                mime = 'image/jpeg'
            } else if (lower.endsWith('.webp')) {
                mime = 'image/webp'
            }

            return 'data:' + mime + ';base64,' + base64
        } catch (Exception ignored) {
            return ''
        }
    }

    private boolean isInterestingScenarioLine(String message) {
        String value = safeValue(message)

        if (isBlank(value)) {
            return false
        }

        if (value.startsWith('at ') || value.startsWith('Caused by: at ')) {
            return false
        }

        List<String> keywords = [
            'Opening browser',
            'Navigating to',
            'Waiting for',
            'Trying to click',
            'Clicked',
            'Home page loaded',
            'Element is visible',
            'search',
            'select option',
            'Create Correction',
            'Import file',
            'Assert visible',
            'ERROR',
            'Exception',
            'Unable to',
            'not clickable',
            'intercepted',
            'passed',
            'failed'
        ]

        boolean containsKeyword = keywords.any { String item ->
            value.toLowerCase(Locale.ENGLISH).contains(item.toLowerCase(Locale.ENGLISH))
        }

        if (containsKeyword) {
            return true
        }

        return value ==~ /^\\d+\\s*[-:].*$/ || value.startsWith('Given ') || value.startsWith('When ') || value.startsWith('Then ') || value.startsWith('And ')
    }

    private String classifyEventStatus(String message) {
        String value = safeValue(message).toLowerCase(Locale.ENGLISH)

        if (value.contains('error') || value.contains('exception') || value.contains('unable to') || value.contains('not clickable') || value.contains('intercepted') || value.contains('failed')) {
            return 'fail'
        }

        if (value.contains('clicked') || value.contains('loaded successfully') || value.contains('is visible') || value.contains('verified') || value.contains('passed')) {
            return 'pass'
        }

        if (value.contains('skip') || value.contains('pending') || value.contains('undefined')) {
            return 'skip'
        }

        return 'info'
    }

    private String mapCucumberStatus(String rawStatus) {
        String value = safeValue(rawStatus)
        if (value == 'passed') {
            return 'pass'
        }
        if (value == 'failed' || value == 'undefined' || value == 'ambiguous') {
            return 'fail'
        }
        if (value == 'skipped' || value == 'pending') {
            return 'skip'
        }
        return 'info'
    }

    private String firstMeaningfulErrorLine(String value) {
        List<String> lines = safeValue(value).readLines()

        for (String raw : lines) {
            String line = safeValue(raw)
            if (isBlank(line)) {
                continue
            }
            if (line.startsWith('at ') || line.startsWith('Caused by: at ')) {
                continue
            }
            return oneLine(line, 180)
        }

        return oneLine(value, 180)
    }

    private String extractTime(String line) {
        def matcher = (safeValue(line) =~ /^(\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2}\\.\\d{3})/)
        if (!matcher.find()) {
            return ''
        }

        try {
            Date parsed = new SimpleDateFormat('yyyy-MM-dd HH:mm:ss.SSS').parse(matcher.group(1))
            return new SimpleDateFormat('hh:mm:ss a', Locale.ENGLISH).format(parsed)
        } catch (Exception ignored) {
            return ''
        }
    }

    private String extractMessage(String line) {
        String value = safeValue(line)
        int idx = value.indexOf(' - ')
        if (idx >= 0) {
            return safeValue(value.substring(idx + 3))
        }
        return value
    }

    private String stripAnsi(String value) {
        return safeValue(value).replaceAll('\\u001B\\[[;\\d]*m', '')
    }

    private long sumDuration(List<Map> cases) {
        long total = 0L
        cases.each { Map item ->
            total += toLong(item.durationMs)
        }
        return total
    }

    private long toMillis(def secondsValue) {
        String raw = safeValue(secondsValue)
        if (raw.isEmpty()) {
            return 0L
        }

        try {
            return (long) (Double.parseDouble(raw) * 1000D)
        } catch (Exception ignored) {
            return 0L
        }
    }

    private long toLong(def value) {
        try {
            return Long.parseLong(safeValue(value))
        } catch (Exception ignored) {
            return 0L
        }
    }

    private String oneLine(def value, int maxSize) {
        String text = safeValue(value).replaceAll('\\s+', ' ').trim()
        if (text.size() <= maxSize) {
            return text
        }
        return text.substring(0, Math.max(0, maxSize - 1)).trim() + '…'
    }

    private String normalizeKey(def value) {
        return safeValue(value).toLowerCase(Locale.ENGLISH).replaceAll('[^a-z0-9]', '')
    }

    private String safeValue(def value) {
        return value == null ? '' : String.valueOf(value).trim()
    }

    private boolean isBlank(def value) {
        return safeValue(value).isEmpty()
    }

    private String formatTime(Date date) {
        return new SimpleDateFormat('MMM dd, yyyy hh:mm:ss a', Locale.ENGLISH).format(date)
    }

    private String formatDateTime(Date date) {
        return new SimpleDateFormat('MMM dd, yyyy hh:mm:ss a', Locale.ENGLISH).format(date)
    }

    private String formatDurationMillis(long millis) {
        long hours = (long) (millis / 3600000L)
        long minutes = (long) ((millis % 3600000L) / 60000L)
        long seconds = (long) ((millis % 60000L) / 1000L)
        long ms = (long) (millis % 1000L)

        if (hours > 0L) {
            return hours + 'h ' + minutes + 'm ' + seconds + 's'
        }
        if (minutes > 0L) {
            return minutes + 'm ' + seconds + 's ' + ms + 'ms'
        }
        if (seconds > 0L) {
            return seconds + 's ' + ms + 'ms'
        }
        return ms + 'ms'
    }
