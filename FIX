String buildGaiaReport() {
	String xmlPath = getXmlFilePath()

	if (isBlank(xmlPath)) {
		KeywordUtil.logInfo('Gaia HTML report was not created because XML file was not found.')
		return null
	}

	String reportPath = getResolvedReportPath()

	if (isBlank(reportPath)) {
		KeywordUtil.logInfo('Gaia HTML report was not created because report folder was not found.')
		return null
	}

	Map suiteData = parseSuiteData(xmlPath)
	String html = buildGaiaReportHtml(suiteData)

	File htmlFile = new File(reportPath + File.separator + GAIA_REPORT_FILE_NAME)
	htmlFile.write(html, 'UTF-8')

	KeywordUtil.logInfo("Gaia HTML report created successfully: ${htmlFile.absolutePath}")
	return htmlFile.absolutePath
}








// =========================================================
// SUITE NAME RESOLUTION
// =========================================================

boolean isIgnorableFolderName(String folderName) {
	if (isBlank(folderName)) {
		return true
	}

	String name = folderName.trim()

	if (name.equalsIgnoreCase('Reports')) return true
	if (name.equalsIgnoreCase('logs')) return true
	if (name.equalsIgnoreCase('videos')) return true
	if (name.equalsIgnoreCase('cucumber_report')) return true
	if (name.equalsIgnoreCase('PreLoad')) return true
	if (name.equalsIgnoreCase(EVIDENCE_FOLDER_NAME)) return true
	if (isTimestampFolderName(name)) return true

	return false
}

String extractSuiteNameFromReportPath(String reportPath) {
	if (isBlank(reportPath)) {
		return ''
	}

	File current = new File(reportPath)

	// If current path already points to the suite folder, use it
	if (current.exists() && current.isDirectory() && !isIgnorableFolderName(current.getName())) {
		return normalizeSuiteName(current.getName())
	}

	// Walk up parents looking for the first valid suite folder
	File walker = current
	while (walker != null) {
		if (!isIgnorableFolderName(walker.getName())) {
			return normalizeSuiteName(walker.getName())
		}
		walker = walker.getParentFile()
	}

	return ''
}

String extractSuiteNameFromTimestampFolder(String reportPath) {
	if (isBlank(reportPath)) {
		return ''
	}

	File root = new File(reportPath)

	if (!root.exists() || !root.isDirectory()) {
		return ''
	}

	// Common case:
	// Reports\20260310_084240\Correction- Add Correction
	if (isTimestampFolderName(root.getName())) {
		List<File> candidates = root.listFiles()?.findAll {
			it.isDirectory() && !isIgnorableFolderName(it.getName())
		} ?: []

		if (!candidates.isEmpty()) {
			File best = candidates.max { it.lastModified() }
			return normalizeSuiteName(best.getName())
		}
	}

	return ''
}

String getCurrentSuiteName() {
	// 1) First try the report path itself
	String reportPath = getResolvedReportPath()

	if (!isBlank(reportPath)) {
		String suiteFromTimestampRoot = extractSuiteNameFromTimestampFolder(reportPath)
		if (!isBlank(suiteFromTimestampRoot)) {
			KeywordUtil.logInfo("Suite name detected from timestamp folder child: ${suiteFromTimestampRoot}")
			return suiteFromTimestampRoot
		}

		String suiteFromPath = extractSuiteNameFromReportPath(reportPath)
		if (!isBlank(suiteFromPath)) {
			KeywordUtil.logInfo("Suite name detected from report path: ${suiteFromPath}")
			return suiteFromPath
		}
	}

	// 2) Fallback from LastRun.xlsx path
	String lastRunPath = readLastRunPath()
	if (!isBlank(lastRunPath)) {
		String suiteFromLastRunTimestampRoot = extractSuiteNameFromTimestampFolder(lastRunPath)
		if (!isBlank(suiteFromLastRunTimestampRoot)) {
			KeywordUtil.logInfo("Suite name detected from LastRun timestamp folder child: ${suiteFromLastRunTimestampRoot}")
			return suiteFromLastRunTimestampRoot
		}

		String suiteFromLastRun = extractSuiteNameFromReportPath(lastRunPath)
		if (!isBlank(suiteFromLastRun)) {
			KeywordUtil.logInfo("Suite name detected from LastRun path: ${suiteFromLastRun}")
			return suiteFromLastRun
		}
	}

	return 'UnknownTestSuite'
}

String getSanitizedSuiteName() {
	return getCurrentSuiteName().replaceAll('[\\\\/:*?"<>|]', '_')
}

String getExecutionSummary() {
	return getCurrentSuiteName() + ' ' + nowExecution()
}

String getTestPlanName() {
	return getCurrentSuiteName() + TEST_PLAN_SUFFIX
}
