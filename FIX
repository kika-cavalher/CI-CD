            }
            echo "${stageName} completed successfully."
        } catch (err) {
            if (isManualAbortError(err)) {
                manualAborted = true
                currentBuild.result = 'ABORTED'
                echo "${stageName} was manually aborted."
            } else if (isTimeoutError(err)) {
                failedStages << "${stageName} -> timeout after 5 hours"
                echo "${stageName} exceeded the 5 hour limit and was stopped."
            } else {
                failedStages << "${stageName} -> ${err}"
                echo "${stageName} failed: ${err}"
            }
        } finally {
            stage("Stop ${stageName}") {
                stopCurrentExecution()
            }
        }
    }
}

node(NODE_LABEL) {
    ws(SHORT_WORKSPACE) {
        stage('Checkout') {
            deleteDir()
            checkout scm
        }

        runCollection('Cube Rapp Detail V2 Collection', 'CubeRappDetailV2.cmd')
        runCollection('Cube Rapp Detail V2 Synthese Collection', 'CubeRappDetailV2Synthese.cmd')

        stage('Execution Summary') {
            if (failedStages.isEmpty()) {
                echo 'All collections finished without Jenkins wrapper errors.'
            } else {
                echo 'Collections with wrapper failure:'
                failedStages.each { item ->
                    echo " - ${item}"
                }
            }
        }
    }
}

stage('Trigger next pipeline') {
    if (manualAborted) {
        echo 'Current pipeline was manually aborted. Next pipeline will not be scheduled.'
    } else if (RUN_NEXT_JOB && NEXT_JOB?.trim()) {
        echo "Scheduling next pipeline: ${NEXT_JOB}"
        build job: NEXT_JOB, wait: false, propagate: false
    } else {
        echo 'Next pipeline disabled.'
    }
}

if (!manualAborted) {
    currentBuild.result = 'SUCCESS'
}

return
