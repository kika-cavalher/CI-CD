private List<Map> normalizeEvidence(Map item, Map model) {
    List rawEvidence = []

    if (item?.evidence instanceof Collection) {
        rawEvidence.addAll(item.evidence as Collection)
    }
    if (item?.evidences instanceof Collection) {
        rawEvidence.addAll(item.evidences as Collection)
    }
    if (item?.images instanceof Collection) {
        rawEvidence.addAll(item.images as Collection)
    }
    if (item?.attachments instanceof Collection) {
        rawEvidence.addAll(item.attachments as Collection)
    }

    if (rawEvidence.isEmpty()) {
        return []
    }

    String baseFolder = firstNonBlank(
        item?.reportFolder,
        model?.reportFolder,
        model?.baseFolder,
        model?.executionFolder
    )

    List<Map> result = []

    rawEvidence.each { def raw ->
        String name = ''
        String href = ''
        String imgSrc = ''
        boolean image = false

        if (raw instanceof Map) {
            name = firstNonBlank(raw.name, raw.fileName, raw.title, raw.label)
            href = firstNonBlank(raw.href, raw.url, raw.path, raw.file, raw.absolutePath, raw.relativePath)
            imgSrc = firstNonBlank(raw.imgSrc, raw.imageSrc, raw.imageDataUri)

            def imageFlag = raw.image != null ? raw.image : raw.isImage
            if (imageFlag != null) {
                image = Boolean.valueOf(String.valueOf(imageFlag))
            }
        } else {
            href = safeValue(raw)
            name = new File(href).name
        }

        if (!imgSrc.isEmpty() && imgSrc.startsWith('data:image')) {
            image = true
        }

        File resolved = null

        if (imgSrc.isEmpty()) {
            if (!href.isEmpty() &&
                !href.startsWith('data:') &&
                !href.startsWith('file:') &&
                !href.startsWith('http://') &&
                !href.startsWith('https://')) {
                resolved = resolveFile(href, baseFolder)
            }
        }

        if (resolved != null && resolved.exists()) {
            if (name.isEmpty()) {
                name = resolved.name
            }
            if (href.isEmpty()) {
                href = resolved.toURI().toString()
            }
            if (!image) {
                image = isImageFile(resolved.name)
            }
            if (imgSrc.isEmpty() && image) {
                imgSrc = resolved.toURI().toString()
            }
        }

        if (name.isEmpty()) {
            name = 'Evidence'
        }

        if (!href.isEmpty() || !imgSrc.isEmpty()) {
            result << [
                name  : name,
                href  : href,
                image : image,
                imgSrc: imgSrc
            ]
        }
    }

    return result
}
