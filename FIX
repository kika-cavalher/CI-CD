    @Keyword
    void startEmatch(String currentUser, String targetWindowTitle) {
        String env = resolveEnvironment()

        String configuredRemoteShortcut = getShortcutPath(env)
        String resolvedRemoteShortcut = resolveExistingFileByBaseName(configuredRemoteShortcut)

        String configuredLocalAppRef = getLocalAppRefPath(env)
        String resolvedLocalAppRef = resolveExistingFileByBaseName(configuredLocalAppRef)

        String launcherBat = getLauncherBat(env)
        boolean launcherBatExists = new File(launcherBat).exists()

        String applicationPath = getApplicationPath(env)

        KeywordUtil.logInfo("Starting eMatch for environment: ${env}")
        KeywordUtil.logInfo("Current Windows user: ${currentUser}")
        KeywordUtil.logInfo("Target window title: ${targetWindowTitle}")
        KeywordUtil.logInfo("Configured remote shortcut: ${configuredRemoteShortcut}")
        KeywordUtil.logInfo("Resolved remote shortcut: ${resolvedRemoteShortcut}")
        KeywordUtil.logInfo("Configured local appref: ${configuredLocalAppRef}")
        KeywordUtil.logInfo("Resolved local appref: ${resolvedLocalAppRef}")
        KeywordUtil.logInfo("Application path: ${applicationPath}")
        KeywordUtil.logInfo("Launcher BAT: ${launcherBat}")
        KeywordUtil.logInfo("Launcher BAT exists: ${launcherBatExists}")

        runResolutionScriptIfExists()

        boolean launched = false
        Exception lastLaunchError = null

        if (resolvedRemoteShortcut) {
            try {
                KeywordUtil.logInfo('Trying remote shortcut first...')
                startDetachedCommand("start \"\" \"${resolvedRemoteShortcut}\"")
                launched = true
                Windows.delay(AFTER_START_DELAY_SEC)
            } catch (Exception e) {
                lastLaunchError = e
                KeywordUtil.logInfo("Remote shortcut launch failed: ${e.message}")
            }
        }

        if (!launched && resolvedLocalAppRef) {
            try {
                KeywordUtil.logInfo('Trying local Start Menu appref...')
                startDetachedCommand("start \"\" \"${resolvedLocalAppRef}\"")
                launched = true
                Windows.delay(AFTER_START_DELAY_SEC)
            } catch (Exception e) {
                lastLaunchError = e
                KeywordUtil.logInfo("Local appref launch failed: ${e.message}")
            }
        }

        if (!launched && launcherBatExists) {
            KeywordUtil.logInfo('Trying launcher BAT...')
            Map launcherResult = runCommand("call \"${launcherBat}\"", COMMAND_TIMEOUT_SEC)

            if (launcherResult.output) {
                KeywordUtil.logInfo("Launcher BAT output:\n${launcherResult.output}")
            }

            if (launcherResult.exitCode == 0) {
                launched = true
                Windows.delay(AFTER_START_DELAY_SEC)
            } else {
                KeywordUtil.logInfo("Launcher BAT failed with exit code ${launcherResult.exitCode}")
            }
        }

        if (!launched) {
            KeywordUtil.logInfo('Trying direct ClickOnce launch...')
            runCommand("\"${DFSVC_EXE}\"", 30)

            try {
                startDetachedCommand("\"${RUNDLL32_EXE}\" dfshim.dll,ShOpenVerbApplication \"${applicationPath}\"")
                launched = true
                Windows.delay(AFTER_START_DELAY_SEC)
            } catch (Exception e) {
                lastLaunchError = e
                KeywordUtil.logInfo("Direct ClickOnce launch failed: ${e.message}")
            }
        }

        if (!launched) {
            KeywordUtil.markFailedAndStop(
                "Could not launch eMatch for environment '${env}'. " +
                "Remote shortcut='${configuredRemoteShortcut}', local appref='${configuredLocalAppRef}', " +
                "launcherBat='${launcherBat}', application='${applicationPath}', lastError='${lastLaunchError?.message}'."
            )
        }

        KeywordUtil.logInfo('Launch command executed. Ensuring WinAppDriver is available...')
        ensureWinAppDriverRunning()
    }

    @Keyword
    void attachToLoginWindow(String targetWindowTitle) {
        String exactWindow = targetWindowTitle
        String containsWindow = targetWindowTitle?.contains(' - ') ? targetWindowTitle.split(' - ')[0] : targetWindowTitle

        boolean windowFound = false
        int elapsedTime = 0

        while (!windowFound && elapsedTime < WINDOW_ATTACH_TIMEOUT_SEC) {
            try {
                try {
                    Windows.startExistingApplication(exactWindow)
                } catch (Exception ignored) {
                    Windows.startExistingApplication(containsWindow)
                }

                windowFound = true
                KeywordUtil.logInfo("Attached to target window: ${targetWindowTitle}")
                break
            } catch (Exception e) {
                Windows.delay(WINDOW_ATTACH_RETRY_SEC)
                elapsedTime += WINDOW_ATTACH_RETRY_SEC
            }
        }

        if (!windowFound) {
            KeywordUtil.markFailedAndStop("Target window '${targetWindowTitle}' could not be found within ${WINDOW_ATTACH_TIMEOUT_SEC} seconds.")
        }
    }

