	String zipReports() {
		String reportPath = getResolvedReportPath()
		if (isBlank(reportPath)) return ''

		String zippedFile = reportPath + File.separator + RESULTS_ZIP_FILE_NAME
		ZipOutputStream output = new ZipOutputStream(new FileOutputStream(zippedFile))

		try {
			new File(reportPath).eachFile { file ->
				if (!file.isFile()) return
				if (file.name.equalsIgnoreCase(RESULTS_ZIP_FILE_NAME)) return

				output.putNextEntry(new ZipEntry(file.name))
				FileInputStream input = new FileInputStream(file)

				try {
					byte[] buffer = new byte[4096]
					int read
					while ((read = input.read(buffer)) != -1) {
						output.write(buffer, 0, read)
					}
				} finally {
					input.close()
				}

				output.closeEntry()
			}
		} finally {
			output.close()
		}

		return zippedFile
	}

	String zipEvidences() {
		String reportPath = getResolvedReportPath()
		if (isBlank(reportPath)) return ''

		String evidencePath = reportPath + File.separator + EVIDENCE_FOLDER_NAME
		File evidenceFolder = new File(evidencePath)

		if (!evidenceFolder.exists()) {
			return ''
		}

		String zippedFile = evidencePath + File.separator + EVIDENCE_ZIP_FILE_NAME
		ZipOutputStream output = new ZipOutputStream(new FileOutputStream(zippedFile))

		try {
			evidenceFolder.eachFileRecurse(FileType.FILES) { File file ->
				if (file.name.equalsIgnoreCase(EVIDENCE_ZIP_FILE_NAME)) return

				String relativeName = evidenceFolder.toPath().relativize(file.toPath()).toString().replace('\\', '/')
				output.putNextEntry(new ZipEntry(relativeName))

				FileInputStream input = new FileInputStream(file)
				try {
					byte[] buffer = new byte[4096]
					int read
					while ((read = input.read(buffer)) != -1) {
						output.write(buffer, 0, read)
					}
				} finally {
					input.close()
				}

				output.closeEntry()
			}
		} finally {
			output.close()
		}

		return zippedFile
	}

