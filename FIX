                margin-top: 22px;
                background: #ffffff;
                border: 1px solid var(--border);
                border-radius: 14px;
                padding: 16px 18px;
                box-shadow: var(--shadow);
            }

            .evidence-title {
                font-size: 14px;
                font-weight: 700;
                margin-bottom: 12px;
            }

            .evidence-item {
                border-top: 1px solid var(--border);
                padding-top: 12px;
                margin-top: 12px;
            }

            .evidence-item:first-child {
                border-top: none;
                padding-top: 0;
                margin-top: 0;
            }

            .evidence-name {
                font-size: 13px;
                font-weight: 600;
                color: #334155;
            }

            .evidence-link {
                display: inline-block;
                margin-top: 8px;
