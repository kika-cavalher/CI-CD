pipeline {
  agent { label 'GI5_SWDCFRNXGI55817' }

  options {
    timestamps()
    ansiColor('xterm')
    timeout(time: 3, unit: 'HOURS')
  }

  environment {
    KATALON_EXE = 'C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0\\katalonc.exe'
    PROJECT_PATH = "${WORKSPACE}\\eMatch POC.prj"
    BROWSER_TYPE = 'Windows'
    REPORTS_DIR = "${WORKSPACE}\\Reports"
  }

  stages {
    stage('Run Katalon') {
      steps {
        bat """
          @echo on
          if not exist "%REPORTS_DIR%" mkdir "%REPORTS_DIR%"

          "%KATALON_EXE%" ^
            -noSplash ^
            -runMode=console ^
            -retry=0 ^
            -projectPath="%PROJECT_PATH%" ^
            -testSuiteCollectionPath="Test Suites/Archive Mode/Archive Mode Collection" ^
            -browserType="%BROWSER_TYPE%" ^
            -reportFolder="%REPORTS_DIR%" ^
            -reportFileName="JUnit_Report" ^
            -reportFormat="JUnit"

          set EC=%ERRORLEVEL%
          echo KATALON_EXITCODE=%EC%
          exit /b %EC%
        """
      }
    }

    stage('Collect Reports') {
      steps {
        junit allowEmptyResults: true, testResults: 'Reports/**/JUnit_Report.xml, Reports/**/JUnit_Report.*.xml, Reports/**/JUnit_Report.xml'
        archiveArtifacts allowEmptyArchive: true, artifacts: 'Reports/**/*'
      }
    }
  }
}










