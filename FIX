// ==================================================
// CLICK CREATE FAVORITE BY IMAGE
// Stop immediately when image is not found.
// ==================================================

KeywordUtil.logInfo(
	'[FAVORITE][02] Searching Create Favorite image.\n' +
	'Image group: ' + GENERAL_IMAGE_GROUP + '\n' +
	'Image key: createFavoriteIcon\n' +
	'File expected: Images/general/icomFavorite.png\n' +
	'Timeout: ' + controlTimeout + ' seconds'
)

long createFavoriteImageStart =
	System.currentTimeMillis()

boolean createFavoriteClicked =
	clickFirstVisibleImage(
		GENERAL_IMAGE_GROUP,
		[
			'createFavoriteIcon'
		],
		controlTimeout
	)

long createFavoriteImageDuration =
	System.currentTimeMillis() -
	createFavoriteImageStart

KeywordUtil.logInfo(
	'[FAVORITE][03] Create Favorite image search completed.\n' +
	'Found and clicked: ' + createFavoriteClicked + '\n' +
	'Duration: ' + createFavoriteImageDuration + ' ms'
)

if (!createFavoriteClicked) {
	takeEvidence(
		'GUI_CreateFavoriteImageNotFound.png'
	)

	KeywordUtil.markFailedAndStop(
		'Create Favorite image was not found.\n' +
		'Image group: ' + GENERAL_IMAGE_GROUP + '\n' +
		'Image key: createFavoriteIcon\n' +
		'Expected file: Images/general/icomFavorite.png\n' +
		'Search duration: ' +
		createFavoriteImageDuration +
		' ms\n' +
		'The test was stopped without trying the WindowsObject.'
	)

	return
}

KeywordUtil.logInfo(
	'[FAVORITE][04] Create Favorite clicked successfully by image.'
)

Windows.delay(1)

// ==================================================
// FAVORITE TITLE
// ==================================================

KeywordUtil.logInfo(
	'[FAVORITE][05] Filling favorite title.\n' +
	'Image key: favoriteFilterField\n' +
	'Title: ' + favoriteTitle
)

typeOnImage(
	GUI_IMAGE_GROUP,
	'favoriteFilterField',
	favoriteTitle,
	controlTimeout
)

KeywordUtil.logInfo(
	'[FAVORITE][06] Favorite title filled successfully.'
)

Windows.delay(1)
