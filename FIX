	private void hoverImageFirstThenObject(
			String imageGroup,
			String objectGroup,
			String imageKey,
			String objectKey,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)

		try {
			WindowsImageKeywords.moveToImage(
				image(
					imageGroup,
					imageKey
				)
			)

			Windows.delay(POLLING_DELAY_SECONDS)

			KeywordUtil.logInfo(
				'[IMAGE] Hover completed on the requested header. No object fallback and no second hover.'
			)
		} catch (Throwable imageError) {
			KeywordUtil.markFailedAndStop(
				'Hover image was not found. The mouse was not moved to another header.\n' +
					'Image group: ' + imageGroup + '\n' +
					'Image key: ' + imageKey + '\n' +
					'Reason: ' +
					safeText(imageError.message)
			)
		}
	}


	private void clickGrayFilterButtonWithoutLeavingHover(
			String imageGroup,
			String hoverImageKey
		) {

		String hoverImagePath =
			image(
				imageGroup,
				hoverImageKey
			)

		java.awt.Point currentMousePosition =
			java.awt.MouseInfo
				.getPointerInfo()
				.getLocation()

		Integer horizontalOffset = 18

		try {
			java.awt.image.BufferedImage hoverImage =
				javax.imageio.ImageIO.read(
					new java.io.File(
						hoverImagePath
					)
				)

			if (hoverImage != null) {
				horizontalOffset =
					Math.max(
						12,
						Math.min(
							30,
							hoverImage.getWidth().intdiv(2) - 4
						)
					)
			}
		} catch (Throwable ignored) {
			horizontalOffset = 18
		}

		Robot robot = new Robot()

		// Move only inside the same hovered header, toward its right side.
		// There is no image search and no object lookup here.
		robot.mouseMove(
			currentMousePosition.x +
				horizontalOffset,
			currentMousePosition.y
		)

		Thread.sleep(300L)

		robot.mousePress(
			InputEvent.BUTTON1_DOWN_MASK
		)

		robot.mouseRelease(
			InputEvent.BUTTON1_DOWN_MASK
		)

		Windows.delay(POLLING_DELAY_SECONDS)

		KeywordUtil.logInfo(
			'[COORDINATE] Gray filter button clicked without leaving the current hover.'
		)
	}

	private Map<String, Integer> parseBoundingRectangle(
			String boundingRectangle
		) {

		String value = safeText(
			boundingRectangle
		)

		if (value.isEmpty()) {
			return [:]
		}

		// Katalon 9 / WinAppDriver format:
		// Left:409 Top:204 Width:94 Height:26
		def leftTopSizeMatcher = value =~
			/(?i)left\s*[:=]\s*(-?\d+)\D+top\s*[:=]\s*(-?\d+)\D+width\s*[:=]\s*(\d+)\D+height\s*[:=]\s*(\d+)/

		if (leftTopSizeMatcher.find()) {
			Integer left =
				leftTopSizeMatcher.group(1).toInteger()

			Integer top =
				leftTopSizeMatcher.group(2).toInteger()

			Integer width =
				leftTopSizeMatcher.group(3).toInteger()

			Integer height =
				leftTopSizeMatcher.group(4).toInteger()

			return [
				left   : left,
				top    : top,
				right  : left + width,
				bottom : top + height
			]
		}

		// Alternative WinAppDriver format:
		// l=409,t=204,r=503,b=230
		def edgesMatcher = value =~
			/(?i)l\s*[:=]\s*(-?\d+)\D+t\s*[:=]\s*(-?\d+)\D+r\s*[:=]\s*(-?\d+)\D+b\s*[:=]\s*(-?\d+)/

		if (edgesMatcher.find()) {
			return [
				left   : edgesMatcher.group(1).toInteger(),
				top    : edgesMatcher.group(2).toInteger(),
				right  : edgesMatcher.group(3).toInteger(),
				bottom : edgesMatcher.group(4).toInteger()
			]
		}

		return [:]
	}

	private void clickImageFirstThenObject(
			String imageGroup,
			String objectGroup,
			String imageKey,
			String objectKey,
			String description,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)
		Integer imageTimeout = Math.min(timeout, 3)

		try {
			if (imageLoader.waitForImage(
				imageGroup,
				imageKey,
				imageTimeout
			)) {
				WindowsImageKeywords.clickImage(
					image(imageGroup, imageKey)
				)

				KeywordUtil.logInfo(
					'[IMAGE] ' + description + ' clicked.'
				)

				return
			}
		} catch (Throwable imageError) {
			KeywordUtil.logInfo(
				'[IMAGE] Could not click ' +
					description +
					'. Trying Windows object.\n' +
					'Reason: ' +
					safeText(imageError.message)
			)
		}

		WindowsTestObject targetObject =
			object(objectGroup, objectKey)

		if (!Windows.waitForElementPresent(
			targetObject,
			timeout,
			FailureHandling.OPTIONAL
		)) {
			KeywordUtil.markFailedAndStop(
				description +
					' was not found by image or Windows object.\n' +
					'Image group: ' + imageGroup + '\n' +
					'Image key: ' + imageKey + '\n' +
					'Object group: ' + objectGroup + '\n' +
					'Object key: ' + objectKey
			)

			return
		}

		Windows.click(
			targetObject,
			FailureHandling.STOP_ON_FAILURE
		)

		KeywordUtil.logInfo(
			'[OBJECT] ' + description + ' clicked.'
		)
	}

	private void waitForImageOrObjectPresent(
			String imageGroup,
			String objectGroup,
			String imageKey,
			String objectKey,
			String failureMessage,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)
		Integer imageTimeout = Math.min(timeout, 5)

		try {
			if (imageLoader.waitForImage(
				imageGroup,
				imageKey,
				imageTimeout
			)) {
				KeywordUtil.logInfo(
					'[IMAGE] Expected filter state displayed. Key: ' +
						imageKey
				)

				return
			}
		} catch (Throwable ignored) {
		}

		WindowsTestObject targetObject =
			object(objectGroup, objectKey)

		if (Windows.waitForElementPresent(
			targetObject,
			timeout,
			FailureHandling.OPTIONAL
		)) {
			KeywordUtil.logInfo(
				'[OBJECT] Expected filter state displayed. Key: ' +
					objectKey
			)

			return
		}

		KeywordUtil.markFailedAndStop(
			failureMessage + '\n' +
				'Image group: ' + imageGroup + '\n' +
				'Image key: ' + imageKey + '\n' +
				'Object group: ' + objectGroup + '\n' +
				'Object key: ' + objectKey
		)
	}

	private void pressDownAndSpace() {
		Robot robot = new Robot()

		robot.keyPress(KeyEvent.VK_DOWN)
		robot.keyRelease(KeyEvent.VK_DOWN)

		Thread.sleep(200L)

		robot.keyPress(KeyEvent.VK_SPACE)
		robot.keyRelease(KeyEvent.VK_SPACE)

		Thread.sleep(300L)
	}

	private WindowsTestObject object(
			String objectGroup,
			String objectKey
		) {

		return WindowsObjectLoader.getObject(
			objectGroup,
			objectKey
		)
	}



	private void clearAllFilterValues(
			String imageGroup,
			String objectGroup,
			String selectAllCheckedImageKey,
			String selectAllObjectKey,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)
		Integer imageTimeout = Math.min(timeout, 10)

		Boolean allCurrentlyChecked = false

		try {
			allCurrentlyChecked =
				imageLoader.waitForImage(
					imageGroup,
					selectAllCheckedImageKey,
					imageTimeout
				)
		} catch (Throwable ignored) {
			allCurrentlyChecked = false
		}

		if (allCurrentlyChecked) {
			WindowsImageKeywords.clickImage(
				image(
					imageGroup,
					selectAllCheckedImageKey
				)
			)

			Windows.delay(POLLING_DELAY_SECONDS)

			KeywordUtil.logInfo(
				'[IMAGE] All filter values deselected.'
			)

			return
		}

		WindowsTestObject selectAllObject =
			object(
				objectGroup,
				selectAllObjectKey
			)

		if (!Windows.waitForElementPresent(
			selectAllObject,
			timeout,
			FailureHandling.OPTIONAL
		)) {
			KeywordUtil.markFailedAndStop(
				'Select all filter option was not found.\n' +
					'Image group: ' + imageGroup + '\n' +
					'Image key: ' + selectAllCheckedImageKey + '\n' +
					'Object group: ' + objectGroup + '\n' +
					'Object key: ' + selectAllObjectKey
			)

			return
		}

		// Current state is partial or unchecked.
		// First click selects all.
		Windows.click(
			selectAllObject,
			FailureHandling.STOP_ON_FAILURE
		)

		Windows.delay(POLLING_DELAY_SECONDS)

		// Second click deselects all.
		Windows.click(
			selectAllObject,
			FailureHandling.STOP_ON_FAILURE
		)

		Windows.delay(POLLING_DELAY_SECONDS)

		KeywordUtil.logInfo(
			'[OBJECT] All filter values deselected.'
		)
	}


	private void hoverAndOpenFilterOnSameHeader(
			String imageGroup,
			String objectGroup,
			String hoverImageKey,
			String hoverObjectKey,
			List<String> filterButtonImageKeys,
			String filterButtonObjectKey,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)

		WindowsTestObject headerObject =
			object(
				objectGroup,
				hoverObjectKey
			)

		if (!Windows.waitForElementPresent(
			headerObject,
			timeout,
			FailureHandling.OPTIONAL
		)) {
			KeywordUtil.markFailedAndStop(
				'Filter header was not found.\n' +
					'Image group: ' + imageGroup + '\n' +
					'Image key: ' + hoverImageKey + '\n' +
					'Object group: ' + objectGroup + '\n' +
					'Object key: ' + hoverObjectKey
			)

			return
		}

		List<RemoteWebElement> headerElements =
			Windows.findElements(
				headerObject
			)

		if (headerElements == null ||
			headerElements.isEmpty()) {

			KeywordUtil.markFailedAndStop(
				'Filter header coordinates could not be resolved.\n' +
					'Object group: ' + objectGroup + '\n' +
					'Object key: ' + hoverObjectKey
			)

			return
		}

		RemoteWebElement headerElement =
			headerElements.get(0)

		String boundingRectangle =
			safeText(
				headerElement.getAttribute(
					'BoundingRectangle'
				)
			)

		Map<String, Integer> coordinates =
			parseBoundingRectangle(
				boundingRectangle
			)

		if (coordinates.isEmpty()) {
			KeywordUtil.markFailedAndStop(
				'Filter header BoundingRectangle could not be parsed.\n' +
					'Object group: ' + objectGroup + '\n' +
					'Object key: ' + hoverObjectKey + '\n' +
					'BoundingRectangle: ' + boundingRectangle
			)

			return
		}

		Integer headerWidth =
			coordinates.right -
				coordinates.left

		Integer headerCenterX =
			coordinates.left +
				headerWidth.intdiv(2)

		Integer headerCenterY =
			coordinates.top +
				(
					coordinates.bottom -
					coordinates.top
				).intdiv(2)

		Integer filterClickX =
			coordinates.right -
				Math.max(
					5,
					Math.min(
						9,
						headerWidth.intdiv(6)
					)
				)

		Robot robot = new Robot()

		robot.mouseMove(
			headerCenterX,
			headerCenterY
		)

		Windows.delay(POLLING_DELAY_SECONDS)

		robot.mouseMove(
			filterClickX,
			headerCenterY
		)

		Thread.sleep(300L)

		robot.mousePress(
			InputEvent.BUTTON1_DOWN_MASK
		)

		robot.mouseRelease(
			InputEvent.BUTTON1_DOWN_MASK
		)

		Windows.delay(POLLING_DELAY_SECONDS)

		KeywordUtil.logInfo(
			'[COORDINATE] Filter icon clicked on the same hovered header: ' +
				hoverObjectKey
		)
	}

	private void clickFirstAvailableImageThenObject(
			String imageGroup,
			String objectGroup,
			List<String> imageKeys,
			String objectKey,
			String description,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)
		Integer imageTimeout = Math.min(timeout, 10)

		List<String> safeImageKeys =
			imageKeys == null
				? []
				: imageKeys.findAll {
					String key ->
						!safeText(key).isEmpty()
				}

		for (String imageKey : safeImageKeys) {
			try {
				if (imageLoader.waitForImage(
					imageGroup,
					imageKey,
					imageTimeout
				)) {
					WindowsImageKeywords.clickImage(
						image(
							imageGroup,
							imageKey
						)
					)

					KeywordUtil.logInfo(
						'[IMAGE] ' +
							description +
							' clicked using key: ' +
							imageKey
					)

					return
				}
			} catch (Throwable imageError) {
				KeywordUtil.logInfo(
					'[IMAGE] Could not click ' +
						description +
						' using key ' +
						imageKey +
						'.\nReason: ' +
						safeText(imageError.message)
				)
			}
		}

		WindowsTestObject targetObject =
			object(
				objectGroup,
				objectKey
			)

		if (!Windows.waitForElementPresent(
			targetObject,
			timeout,
			FailureHandling.OPTIONAL
		)) {
			KeywordUtil.markFailedAndStop(
				description +
					' was not found by any image or Windows object.\n' +
					'Image group: ' + imageGroup + '\n' +
					'Image keys: ' + safeImageKeys + '\n' +
					'Object group: ' + objectGroup + '\n' +
					'Object key: ' + objectKey
			)

			return
		}

		Windows.click(
			targetObject,
			FailureHandling.STOP_ON_FAILURE
		)

		KeywordUtil.logInfo(
			'[OBJECT] ' +
				description +
				' clicked.'
		)
	}


	private void replaceTextObjectFirstThenImage(
			String imageGroup,
			String objectGroup,
			String imageKey,
			String objectKey,
			String value,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)

		WindowsTestObject inputObject =
			object(
				objectGroup,
				objectKey
			)

		if (Windows.waitForElementPresent(
			inputObject,
			timeout,
			FailureHandling.OPTIONAL
		)) {
			Windows.click(
				inputObject,
				FailureHandling.STOP_ON_FAILURE
			)

			Robot robot = new Robot()

			robot.keyPress(KeyEvent.VK_CONTROL)
			robot.keyPress(KeyEvent.VK_A)
			robot.keyRelease(KeyEvent.VK_A)
			robot.keyRelease(KeyEvent.VK_CONTROL)

			robot.keyPress(KeyEvent.VK_BACK_SPACE)
			robot.keyRelease(KeyEvent.VK_BACK_SPACE)

			Windows.setText(
				inputObject,
				value
			)

			KeywordUtil.logInfo(
				'[OBJECT] Filter text entered successfully: ' +
					value
			)

			return
		}

		Integer imageTimeout =
			Math.min(
				timeout,
				10
			)

		try {
			if (imageLoader.waitForImage(
				imageGroup,
				imageKey,
				imageTimeout
			)) {
				replaceTextOnImage(
					image(
						imageGroup,
						imageKey
					),
					value
				)

				KeywordUtil.logInfo(
					'[IMAGE] Filter text entered successfully: ' +
						value
				)

				return
			}
		} catch (Throwable imageError) {
			KeywordUtil.logInfo(
				'[IMAGE] Could not use filter text input.\n' +
					'Reason: ' +
					safeText(imageError.message)
			)
		}

		KeywordUtil.markFailedAndStop(
			'Filter text input was not found by Windows object or image.\n' +
				'Object group: ' + objectGroup + '\n' +
				'Object key: ' + objectKey + '\n' +
				'Image group: ' + imageGroup + '\n' +
				'Image key: ' + imageKey
		)
	}

