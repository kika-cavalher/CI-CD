	private WindowsTestObject envComboObj() {
		WindowsTestObject repoObj = firstExistingObject([
			'Login Page/optEnv',
			'Connection/cmbEnvironment',
			'General/cmbEnvironment',
			'Login/cmbEnvironment'
		])
		if (repoObj != null) {
			return repoObj
		}

		return winObj(
			'envCombo',
			"(//*[@LocalizedControlType='combo box'])[1]"
		)
	}

	private WindowsTestObject comboArrowObj() {
		return winObj(
			'envComboArrow',
			"(//*[@LocalizedControlType='button' and (@Name='Ouvrir' or @Name='Fermer' or @Name='Open' or @Name='Close')])[1]"
		)
	}

	private WindowsTestObject comboListItemObj(String displayValue) {
		return winObj(
			'envListItem',
			"//*[@Name=${xpathLiteral(displayValue)} and (@LocalizedControlType='list item' or @LocalizedControlType='text')]"
		)
	}

	private WindowsTestObject connectBtnObj() {
		WindowsTestObject repoObj = firstExistingObject([
			'Login Page/btnConnecter',
			'Connection/btnConnect',
			'General/btnConnect',
			'Login/btnConnect'
		])
		if (repoObj != null) {
			return repoObj
		}

		return winObj(
			'connectBtn',
			"//*[@Name='Se connecter' or @Name='Connect' or @Name='Log in']"
		)
	}

	private WindowsTestObject mainSearchObj() {
		WindowsTestObject repoObj = firstExistingObject([
			'General/txtSearch'
		])
		if (repoObj != null) {
			return repoObj
		}

		return winObj(
			'mainSearch',
			"//*[@Name='Type keywords here' or contains(@Name,'keywords')]"
		)
	}

	private WindowsTestObject homeTabObj() {
		WindowsTestObject repoObj = firstExistingObject([
			'General/tabHome',
			'General/homeTab'
		])
		if (repoObj != null) {
			return repoObj
		}

		return winObj(
			'homeTab',
			"//*[@Name='Accueil' or @Name='Home']"
		)
	}

	private WindowsTestObject firstExistingObject(List<String> objectIds) {
		for (String id : objectIds) {
			try {
				WindowsTestObject obj = findWindowsObject(id)
				if (obj != null) {
					return obj
				}
			} catch (Throwable ignored) {
			}
		}
		return null
	}

	private WindowsTestObject winObj(String id, String xpath) {
		WindowsTestObject obj = new WindowsTestObject(id)
		obj.setLocatorStrategy(LocatorStrategy.XPATH)
		obj.setLocator(xpath)
		return obj
	}

	private boolean waitPresent(WindowsTestObject obj, int timeoutSeconds) {
		try {
			return obj != null && Windows.waitForElementPresent(obj, timeoutSeconds, FailureHandling.OPTIONAL)
		} catch (Throwable ignored) {
			return false
		}
	}





