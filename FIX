	private void validateExportedFile(
			File exportedFile) {

		if (exportedFile == null) {

			KeywordUtil.markFailedAndStop(
					'Exported file reference is null.'
					)

			return
		}

		if (!exportedFile.exists() ||
				!exportedFile.isFile() ||
				exportedFile.length() <= 0) {

			KeywordUtil.markFailedAndStop(
					'Exported file is invalid.\n' +
					'Path: ' + exportedFile.getAbsolutePath() + '\n' +
					'Exists: ' + exportedFile.exists() + '\n' +
					'Size bytes: ' + (exportedFile.exists() ? exportedFile.length() : 0)
					)

			return
		}

		String lowerName =
				exportedFile
				.getName()
				.toLowerCase()

		if (!lowerName.endsWith('.xlsx') &&
				!lowerName.endsWith('.xlsm') &&
				!lowerName.endsWith('.xls')) {

			KeywordUtil.markFailedAndStop(
					'Exported file does not have a supported Excel extension. File: ' +
					exportedFile.getName()
					)

			return
		}

		logInfo(
				'Exported file validated successfully.\n' +
				'File: ' + exportedFile.getName() + '\n' +
				'Size bytes: ' + exportedFile.length()
				)
	}


	private File resolveShortExportDirectory(
			String environment,
			String collectionName,
			String featureName) {

		File executionDirectory =
				resolveShortExportRoot()

		File collectionDirectory = new File(
				executionDirectory,
