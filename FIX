<script>
const payload = ${json};
const allCases = Array.isArray(payload.cases) ? payload.cases.slice() : [];
let filteredCases = allCases.slice();
let selectedCaseId = filteredCases.length ? filteredCases[0].caseId : null;

const searchBox = document.getElementById('searchBox');
const caseList = document.getElementById('caseList');
const caseTitle = document.getElementById('caseTitle');
const suitePill = document.getElementById('suitePill');
const statusPill = document.getElementById('statusPill');
const startPill = document.getElementById('startPill');
const endPill = document.getElementById('endPill');
const durationPill = document.getElementById('durationPill');
const stepsBody = document.getElementById('stepsBody');
const errorSection = document.getElementById('errorSection');
const compactError = document.getElementById('compactError');
const fullErrorDetails = document.getElementById('fullErrorDetails');
const fullError = document.getElementById('fullError');
const evidenceSection = document.getElementById('evidenceSection');
const evidenceList = document.getElementById('evidenceList');
const suiteLabel = document.getElementById('suiteLabel');
const logoWrap = document.getElementById('logoWrap');

suiteLabel.textContent = payload.suiteName || '';

if (payload.logoDataUri) {
    const logo = document.createElement('img');
    logo.src = payload.logoDataUri;
    logo.alt = 'Logo';
    logoWrap.appendChild(logo);
}

searchBox.addEventListener('input', function () {
    const query = this.value.trim().toLowerCase();

    filteredCases = allCases.filter(function (item) {
        const haystack = (
            (item.displayName || '') + ' ' +
            (item.status || '')
        ).toLowerCase();

        return haystack.indexOf(query) >= 0;
    });

    if (!filteredCases.some(function (item) { return item.caseId === selectedCaseId; })) {
        selectedCaseId = filteredCases.length ? filteredCases[0].caseId : null;
    }

    renderCaseList();
    renderSelectedCase();
});

function renderCaseList() {
    caseList.innerHTML = '';

    if (!filteredCases.length) {
        const empty = document.createElement('div');
        empty.className = 'empty-text';
        empty.textContent = 'No matching test cases.';
        caseList.appendChild(empty);
        return;
    }

    filteredCases.forEach(function (item) {
        const card = document.createElement('div');
        card.className = 'case-item' + (item.caseId === selectedCaseId ? ' selected' : '');

        const title = document.createElement('div');
        title.className = 'case-item-title';
        title.textContent = item.displayName || item.caseId || '';

        const footer = document.createElement('div');
        footer.className = 'case-item-footer';

        const status = document.createElement('span');
        status.className = 'status-badge ' + item.status;
        status.textContent = item.status;

        const duration = document.createElement('span');
        duration.className = 'empty-text';
        duration.textContent = item.durationText || '';

        footer.appendChild(status);
        footer.appendChild(duration);

        card.appendChild(title);
        card.appendChild(footer);

        card.addEventListener('click', function () {
            selectedCaseId = item.caseId;
            renderCaseList();
            renderSelectedCase();
        });

        caseList.appendChild(card);
    });
}

function renderSelectedCase() {
    if (!selectedCaseId) {
        caseTitle.textContent = 'No test case selected';
        stepsBody.innerHTML = '';
        compactError.textContent = '';
        fullError.textContent = '';
        evidenceList.innerHTML = '<div class="empty-text">No evidence was found for this scenario.</div>';
        return;
    }

    const item = allCases.find(function (entry) {
        return entry.caseId === selectedCaseId;
    });

    if (!item) {
        return;
    }

    caseTitle.textContent = item.displayName || item.caseId || '';
    suitePill.textContent = 'Suite: ' + (payload.suiteName || '');
    statusPill.textContent = 'Status: ' + (item.status || '');
    statusPill.className = 'pill status-' + (item.status || 'PASSED');
    startPill.textContent = 'Start: ' + (item.startText || '');
    endPill.textContent = 'End: ' + (item.endText || '');
    durationPill.textContent = 'Duration: ' + (item.durationText || '');

    stepsBody.innerHTML = '';

    const steps = Array.isArray(item.steps) ? item.steps : [];
    steps.forEach(function (step) {
        const tr = document.createElement('tr');

        const tdStatus = document.createElement('td');
        const badge = document.createElement('span');
        badge.className = 'status-badge ' + (step.status || 'PASSED');
        badge.textContent = step.status || '';
        tdStatus.appendChild(badge);

        const tdTime = document.createElement('td');
        tdTime.textContent = step.timestamp || '';

        const tdDetails = document.createElement('td');
        tdDetails.textContent = step.details || '';

        tr.appendChild(tdStatus);
        tr.appendChild(tdTime);
        tr.appendChild(tdDetails);

        stepsBody.appendChild(tr);
    });

    const hasError = !!(item.shortError || item.fullError);

    if (hasError) {
        errorSection.style.display = 'block';
        compactError.textContent = item.shortError || '';
        fullError.textContent = item.fullError || '';
        fullErrorDetails.style.display = item.fullError ? 'block' : 'none';
    } else {
        errorSection.style.display = 'none';
        compactError.textContent = '';
        fullError.textContent = '';
    }

    evidenceList.innerHTML = '';

    const evidence = Array.isArray(item.evidence) ? item.evidence : [];

    if (!evidence.length) {
        evidenceList.innerHTML = '<div class="empty-text">No evidence was found for this scenario.</div>';
        return;
    }

    evidence.forEach(function (ev) {
        const card = document.createElement('div');
        card.className = 'evidence-card';

        const name = document.createElement('div');
        name.className = 'evidence-name';
        name.textContent = ev.name || 'Evidence';

        card.appendChild(name);

        if (ev.openPath) {
            const link = document.createElement('a');
            link.className = 'evidence-link';
            link.textContent = 'Open evidence';
            link.href = ev.openPath;
            link.target = '_blank';
            link.rel = 'noopener';
            if (ev.name) {
                link.download = ev.name;
            }
            card.appendChild(link);

            const img = document.createElement('img');
            img.className = 'evidence-image';
            img.src = ev.preview || ev.openPath;
            img.alt = ev.name || 'Evidence';
            card.appendChild(img);
        } else {
            const empty = document.createElement('div');
            empty.className = 'empty-text';
            empty.textContent = 'Evidence file was registered, but could not be loaded.';
            card.appendChild(empty);
        }

        evidenceList.appendChild(card);
    });
}

renderCaseList();
renderSelectedCase();
</script>
</body>
</html>
