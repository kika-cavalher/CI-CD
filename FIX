    private static final String STATUS_PASS = '#63b85b'
    private static final String STATUS_FAIL = '#d85b61'
    private static final String STATUS_SKIP = '#f0ad4e'
    private static final String STATUS_INFO = '#4da3ff'
    private static final String STATUS_NEUTRAL = '#6b7280'

    private String safeValue(def value) {
        return value == null ? '' : String.valueOf(value).trim()
    }

    private String htmlEscape(def value) {
        String text = safeValue(value)
        return text
            .replace('&', '&amp;')
            .replace('<', '&lt;')
            .replace('>', '&gt;')
            .replace('"', '&quot;')
            .replace("'", '&#39;')
    }

    private int toInt(def value) {
        try {
            return Integer.parseInt(safeValue(value))
        } catch (Exception ignored) {
            return 0
        }
    }

    private String oneLine(def value, int max = 64) {
        String text = safeValue(value).replaceAll(/[\\r\\n]+/, ' ').replaceAll(/\\s+/, ' ').trim()
        if (text.length() <= max) {
            return text
        }
        return text.substring(0, Math.max(0, max - 3)).trim() + '...'
    }

    private String colorForStatus(String status) {
        String s = safeValue(status).toLowerCase()
        if (s == 'pass') return STATUS_PASS
        if (s == 'fail') return STATUS_FAIL
        if (s == 'skip') return STATUS_SKIP
        return STATUS_INFO
    }

    private String labelForStatus(String status) {
        String s = safeValue(status).toLowerCase()
        if (s == 'pass') return 'Pass'
        if (s == 'fail') return 'Fail'
        if (s == 'skip') return 'Skip'
        return 'Info'
    }

