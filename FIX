pipeline {
  agent { label 'GI5_SWDCFRNXGI55817' }

  parameters {
    string(name: 'SUITE_COLLECTION_PATH', defaultValue: 'Test Suites/GAIA TSC', description: 'Katalon Test Suite Collection path')
  }

  environment {
    PROJECT_PATH = 'D:/jenkins/work/workspace/GI5/Gaia/Gaia'
  }

  stages {

    stage('Start Gaia Backend and Frontend') {
      steps {
        bat 'schtasks /run /tn "GaiaBackFrontSetup"'
        sleep(time: 300, unit: 'SECONDS')
      }
    }

    stage('Get bitbucket source code') {
      steps {
        cleanWs(deleteDirs: true, disableDeferredWipeout: true, notFailBuild: true)
        git credentialsId: '965eceec-b3a3-4ec5-8820-a857c87dd80f',
            url: 'https://bitbucket-mut.mycloud.intrabpce.fr/scm/gi5/gaia-portal.git'
      }
    }

    stage('Run Visible (Jenkins triggers task)') {
      steps {
        // Pass variables to the scheduled task environment via cmd /c set VAR=... && schtasks /run ...
        bat """
          set PROJECT_PATH=${env.PROJECT_PATH}&& ^
          set SUITE_COLLECTION_PATH=${params.SUITE_COLLECTION_PATH}&& ^
          set BROWSER_TYPE=Chrome&& ^
          set EXTRA_ARGS=&& ^
          schtasks /run /tn "GaiaKatalon_Visible"
        """
      }
    }
  }
}
