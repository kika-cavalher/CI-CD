	// ======================================================
	// DEFAULT DATES POPUP
	// ======================================================

	@Keyword
	Map validateDefaultDatesAndApply(
			Integer timeoutSeconds,
			Integer screenLoadTimeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)
		Integer screenLoadTimeout =
			safeTimeout(screenLoadTimeoutSeconds)

		List<RemoteWebElement> selectedDates =
			waitForDefaultDateElements(timeout)

		if (selectedDates.size() != 2) {
			KeywordUtil.markFailedAndStop(
				'Dates popup must contain exactly 2 selected records. ' +
				'Actual records: ' + selectedDates.size()
			)
		}

		String expectedClosingDate = resolveClosingDate()
		Boolean closingDateFound = false
		Boolean quarterDateFound = false
		List<String> actualDates = []

		selectedDates.each { RemoteWebElement element ->
			String dateText = safeText(element.getText())
			actualDates.add(dateText)

			if (dateText.equals(expectedClosingDate)) {
				closingDateFound = true
			}

			if (isQuarterDate(dateText)) {
				quarterDateFound = true
			}
		}

		if (!closingDateFound || !quarterDateFound) {
			String errors = ''

			if (!closingDateFound) {
				errors +=
					'\nClosing date was not selected by default. ' +
					'Expected: ' + expectedClosingDate
			}

			if (!quarterDateFound) {
				errors +=
					'\nQuarter date was not selected by default.'
			}

			KeywordUtil.markFailedAndStop(
				errors +
				'\nActual selected dates: ' + actualDates
			)
		}

		takeEvidence('Investigations_DefaultDates.png')

		if (!Windows.waitForElementPresent(
			findWindowsObject('PNL Comptable/applyBtn'),
			timeout
		)) {
			KeywordUtil.markFailedAndStop(
				'Apply button was not displayed in dates popup.'
			)
		}

		Windows.click(
			findWindowsObject('PNL Comptable/applyBtn')
		)

		waitForImagePresent(
			image('totalCCYHeader.PNG'),
			screenLoadTimeout,
			'Investigations screen did not finish loading after applying dates.'
		)

		return [
			closingDate : expectedClosingDate,
			selectedDates: actualDates,
			totalRecords : selectedDates.size()
		]
	}


