    @Keyword
    String resolveVersionFromRefLogin(String env) {
        List<String> ids = [
            'refLogin',
            'Data Files/refLogin',
            'Login',
            'Data Files/Login'
        ]

        String envValue = safe(env).toUpperCase()
        if (!envValue) {
            envValue = readEnv()
        }

        for (String id : ids) {
            try {
                TestData data = TestDataFactory.findTestData(id)
                if (data == null) {
                    continue
                }

                int rows = data.getRowNumbers()
                for (int row = 1; row <= rows; row++) {
                    String version = safe(data.getValue(1, row))
                    String dataEnv = safe(data.getValue(2, row)).toUpperCase()

                    if (version && dataEnv == envValue) {
                        return version.replaceFirst(/(?i)^ematch\s+/, '').trim()
                    }
                }
            } catch (Throwable ignored) {
            }
        }

        return ''
    }

    @Keyword
    String resolveWindowTitle() {
        String env = readEnv()

        String rawVersion = resolveVersionFromRefLogin(env)
        if (!rawVersion) {
            try {
                rawVersion = safe(GlobalVariable.version)
            } catch (Throwable ignored) {
            }
        }

        if (!rawVersion) {
            rawVersion = DEFAULT_VERSION
        }

        rawVersion = rawVersion.replaceFirst(/(?i)^ematch\s+/, '').trim()
        return normalizeTitle("eMatch ${rawVersion}")
    }

