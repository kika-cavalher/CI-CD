def publishPrimaryArtifact(script, String reportsRoot, Map result) {
    if (!(result?.screenshotRel ?: '').trim()) {
        return
    }

    def parts = result.screenshotRel.tokenize('/')
    if (!parts) {
        return
    }

    def suiteKey = safeFileName(result.name)
    def timestampPart = (parts.size() >= 2) ? parts[parts.size() - 2] : new Date().format('yyyyMMdd_HHmmss')
    def fileName = parts[parts.size() - 1]
    def srcFile = "${reportsRoot}\\${result.screenshotRel.replace('/', '\\')}"
    def destRel = "suite-artifacts/${suiteKey}/${timestampPart}/${fileName}"
    def destDir = "${reportsRoot}\\suite-artifacts\\${suiteKey}\\${timestampPart}"
    def destFile = "${reportsRoot}\\${destRel.replace('/', '\\')}"

    script.withEnv([
        "SRC_FILE=${srcFile}",
        "DEST_DIR=${destDir}",
        "DEST_FILE=${destFile}"
    ]) {
        script.powershell(
            returnStatus: true,
            script: '''
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

if (-not [string]::IsNullOrWhiteSpace($env:SRC_FILE) -and (Test-Path -LiteralPath $env:SRC_FILE)) {
    New-Item -ItemType Directory -Path $env:DEST_DIR -Force | Out-Null
    Copy-Item -LiteralPath $env:SRC_FILE -Destination $env:DEST_FILE -Force
}
'''
        )
    }

    result.primaryArtifactRel = destRel
}

def normalizeKatalonRuntimeSettings(script) {
    script.withEnv([
        "WORKSPACE_DIR=${script.pwd()}"
    ]) {
        script.powershell(
            returnStatus: true,
            script: '''
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

$workspace = $env:WORKSPACE_DIR

Write-Host '------------------------------------------------------------'
Write-Host '[INFO ] NORMALIZING KATALON RUNTIME SETTINGS FOR JENKINS'
Write-Host '------------------------------------------------------------'

function Update-PropertyFileFlags {
    param([string]$Path)

    if (-not (Test-Path -LiteralPath $Path)) {
        return
    }

    $lines = Get-Content -LiteralPath $Path -ErrorAction SilentlyContinue
    if ($null -eq $lines) {
        return
    }

    $changed = $false
    $newLines = @()

    foreach ($line in $lines) {
        $trimmed = $line.Trim()
        $lower = $trimmed.ToLowerInvariant()
        $newLine = $line

        if ($lower.Contains('self') -and $lower.Contains('heal') -and $lower.EndsWith('=true')) {
            $newLine = $line -replace '=true', '=false'
            $changed = $true
        }
        elseif ($lower.Contains('smart') -and $lower.Contains('locator') -and $lower.EndsWith('=true')) {
            $newLine = $line -replace '=true', '=false'
            $changed = $true
        }
        elseif ($lower.Contains('time') -and $lower.Contains('capsule') -and $lower.EndsWith('=true')) {
            $newLine = $line -replace '=true', '=false'
            $changed = $true
        }

        $newLines += $newLine
    }

    if ($changed) {
        Set-Content -LiteralPath $Path -Value $newLines -Encoding UTF8
        Write-Host ('[OK   ] Patched property file: ' + $Path)
    }
}

function Update-TestSuiteXml {
    param([string]$Path)

    if (-not (Test-Path -LiteralPath $Path)) {
        return
    }

    try {
        [xml]$xml = Get-Content -LiteralPath $Path -ErrorAction Stop
        $changed = $false

        $node = $xml.SelectSingleNode('//numberOfRerun')
        if ($node -and $node.InnerText -ne '0') {
            $node.InnerText = '0'
            $changed = $true
        }

        $node = $xml.SelectSingleNode('//rerunImmediately')
        if ($node -and $node.InnerText -ne 'false') {
            $node.InnerText = 'false'
            $changed = $true
        }

        $node = $xml.SelectSingleNode('//rerunFailedTestCasesOnly')
        if ($node -and $node.InnerText -ne 'false') {
            $node.InnerText = 'false'
            $changed = $true
        }

        $node = $xml.SelectSingleNode('//retryCount')
        if ($node -and $node.InnerText -ne '0') {
            $node.InnerText = '0'
            $changed = $true
        }

        if ($changed) {
            $xml.Save($Path)
            Write-Host ('[OK   ] Patched test suite xml: ' + $Path)
        }
    }
    catch {
        Write-Host ('[WARN ] Could not patch test suite xml: ' + $Path)
    }
}

$settingsDir = Join-Path $workspace 'settings'
if (Test-Path -LiteralPath $settingsDir) {
    Get-ChildItem -Path $settingsDir -Recurse -File -ErrorAction SilentlyContinue | ForEach-Object {
        Update-PropertyFileFlags -Path $_.FullName
    }
}

$consoleFile = Join-Path $workspace 'console.properties'
if (Test-Path -LiteralPath $consoleFile) {
    Update-PropertyFileFlags -Path $consoleFile
}

$testSuitesDir = Join-Path $workspace 'Test Suites'
if (Test-Path -LiteralPath $testSuitesDir) {
    Get-ChildItem -Path $testSuitesDir -Recurse -File -ErrorAction SilentlyContinue | ForEach-Object {
        Update-TestSuiteXml -Path $_.FullName
    }
}

Write-Host '[OK   ] Runtime normalization finished'
Write-Host '------------------------------------------------------------'
'''
        )
    }
}

def emergencyStopApplication(script, List stopPorts) {
    script.withEnv([
        "STOP_PORTS=${stopPorts.join(',')}"
    ]) {
        script.powershell(
            returnStatus: true,
            script: '''
$ErrorActionPreference = 'SilentlyContinue'
$ProgressPreference = 'SilentlyContinue'

function Stop-ProcessListeningOnPort {
    param([int]$Port)

    try {
        $owners = Get-NetTCPConnection -LocalPort $Port -ErrorAction SilentlyContinue |
            Select-Object -ExpandProperty OwningProcess -Unique

        foreach ($ownerPid in $owners) {
            if ($ownerPid) {
                Stop-Process -Id $ownerPid -Force -ErrorAction SilentlyContinue
            }
        }
    }
    catch {
    }
}

$ports = @()
if (-not [string]::IsNullOrWhiteSpace($env:STOP_PORTS)) {
    $ports = $env:STOP_PORTS.Split(',') | Where-Object { -not [string]::IsNullOrWhiteSpace($_) }
}

foreach ($port in $ports) {
    Stop-ProcessListeningOnPort -Port ([int]$port)
}

exit 0
'''
        )
    }
}

pipeline {
    agent {
        node {
            label 'GI5_SWDCFRNXGI55817'
            customWorkspace 'D:\\jenkins\\work\\workspace\\GI5\\Gaia\\Gaia_Corrections'
        }
    }

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 120, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '15', daysToKeepStr: '20'))
    }

    parameters {
        string(name: 'STARTUP_WAIT_SECONDS', defaultValue: '40', description: 'Seconds to wait after application startup')
        string(name: 'SUITE_TIMEOUT_MINUTES', defaultValue: '10', description: 'Timeout in minutes for the suite')
        string(name: 'BROWSER', defaultValue: 'Chrome', description: 'Katalon browser type')
    }

    environment {
        KATALON_EXE = 'C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0\\katalonc.exe'
        GIT_URL     = 'https://bitbucket-mut.mycloud.intrabpce.fr/scm/gi5/gaia-portal.git'
        GIT_BRANCH  = '*/master'
        GIT_CRED    = '965eceec-b3a3-4ec5-8820-a857c87dd80f'
    }

    stages {
        stage('Bootstrap Support Files') {
            steps {
                script {
                    bootstrapSupportFiles(this)

                    echo '------------------------------------------------------------'
                    echo '[OK] BOOTSTRAP CHECKOUT COMPLETED'
                    echo "Workspace: ${pwd()}"
                    echo '------------------------------------------------------------'
                }
            }
        }

        stage('Validate Tools') {
            steps {
                script {
                    bat """
@echo off
echo ------------------------------------------------------------
echo VALIDATING TOOLS AND SUPPORT FILES
echo ------------------------------------------------------------

if not exist "${env.KATALON_EXE}" (
    echo [ERROR] Katalon executable not found
    echo ${env.KATALON_EXE}
    exit /b 1
)

if not exist "${pwd()}\\jenkinsIntegration\\JenkinsAppManager.groovy" (
    echo [ERROR] JenkinsAppManager.groovy not found
    exit /b 1
)

if not exist "${pwd()}\\jenkinsIntegration\\JenkinsLiveLogger.groovy" (
    echo [ERROR] JenkinsLiveLogger.groovy not found
    exit /b 1
)

if not exist "${pwd()}\\jenkinsIntegration\\JenkinsPaths.groovy" (
    echo [ERROR] JenkinsPaths.groovy not found
    exit /b 1
)

if not exist "${pwd()}\\jenkinsIntegration\\JenkinsConsoleView.groovy" (
    echo [ERROR] JenkinsConsoleView.groovy not found
    exit /b 1
)

if not exist "${pwd()}\\jenkinsIntegration\\JenkinsResultStore.groovy" (
    echo [ERROR] JenkinsResultStore.groovy not found
    exit /b 1
)

echo [OK] Katalon executable found
echo [OK] Jenkins support files found
echo ------------------------------------------------------------
"""
                }
            }
        }

        stage('Start Application') {
            steps {
                script {
                    def appManager = loadAppManager(this)

                    appManager.start(this, [
                        taskName    : PIPELINE_CONFIG.application.startTask,
                        waitSeconds : params.STARTUP_WAIT_SECONDS.toInteger(),
                        startupPorts: PIPELINE_CONFIG.application.startupPorts,
                        healthUrl   : PIPELINE_CONFIG.application.healthUrl
                    ])
                }
            }
        }

        stage('Full Checkout Repository') {
            steps {
                script {
                    fullCheckout(this)

                    echo '------------------------------------------------------------'
                    echo '[OK] FULL CHECKOUT COMPLETED'
                    echo "Workspace: ${pwd()}"
                    echo '------------------------------------------------------------'
                }
            }
        }

        stage('Normalize Runtime Settings') {
            steps {
                script {
                    normalizeKatalonRuntimeSettings(this)
                }
            }
        }

        stage('Prepare Artifacts') {
            steps {
                script {
                    def paths = loadPaths(this)
                    def resultStore = loadResultStore(this)

                    bat """
@echo off
if exist "${paths.reportsRoot(this)}" rmdir /s /q "${paths.reportsRoot(this)}"
mkdir "${paths.reportsRoot(this)}"
mkdir "${paths.logsRoot(this)}"
mkdir "${paths.artifactsRoot(this)}"
"""

                    resultStore.saveSuiteResults(this, paths.reportsRoot(this), [])
                }
            }
        }

        stage('Execute Suite') {
            steps {
                script {
                    def paths = loadPaths(this)
                    def consoleView = loadConsoleView(this)
                    def resultStore = loadResultStore(this)
                    def liveLogger = loadLiveLogger(this)

                    def suite = [
                        name: PIPELINE_CONFIG.suiteName,
                        path: PIPELINE_CONFIG.suitePath
                    ]

                    def projectPath = paths.projectPath(this, PIPELINE_CONFIG.projectFileName)

                    consoleView.printSuiteHeader(this, suite.name, suite.path, params.SUITE_TIMEOUT_MINUTES)

                    int exitCode = liveLogger.runSuite(this, [
                        katalonExe         : env.KATALON_EXE,
                        projectPath        : projectPath,
                        reportsRoot        : paths.reportsRoot(this),
                        browser            : params.BROWSER,
                        suiteTimeoutMinutes: params.SUITE_TIMEOUT_MINUTES.toInteger()
                    ], suite)

                    def meta = resultStore.readSuiteMeta(this, paths.reportsRoot(this), suite.name)

                    def result = [
                        name              : suite.name,
                        path              : suite.path,
                        status            : meta['STATUS'] ?: (exitCode == 0 ? 'PASSED' : (exitCode == 124 ? 'TIMEOUT' : 'FAILED')),
                        icon              : meta['ICON'] ?: (exitCode == 0 ? '✅' : (exitCode == 124 ? '⏰' : '❌')),
                        exitCode          : meta['EXIT_CODE'] ?: "${exitCode}",
                        executed          : meta['EXECUTED'] ?: '0',
                        passed            : meta['PASSED'] ?: '0',
                        failed            : meta['FAILED'] ?: '0',
                        skipped           : meta['SKIPPED'] ?: '0',
                        durationSeconds   : meta['DURATION_SECONDS'] ?: '0',
                        reason            : meta['REASON'] ?: '',
                        screenshotRel     : meta['SCREENSHOT_REL'] ?: '',
                        primaryArtifactRel: '',
                        logRel            : meta['LOG_REL'] ?: '',
                        caseSummary       : resultStore.splitSummary(meta['CASE_SUMMARY'] ?: ''),
                        stepSummary       : resultStore.splitSummary(meta['STEP_SUMMARY'] ?: '')
                    ]

                    publishPrimaryArtifact(this, paths.reportsRoot(this), result)
                    resultStore.saveSuiteResults(this, paths.reportsRoot(this), [result])

                    consoleView.printSuiteResult(this, result)

                    if (result.status != 'PASSED') {
                        currentBuild.result = 'FAILURE'
                        error("${result.name} finished with status ${result.status}")
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                def suiteResults = []
                def reportsRoot = "${pwd()}\\Reports"

                try {
                    if (fileExists('jenkinsIntegration/JenkinsPaths.groovy') && fileExists('jenkinsIntegration/JenkinsResultStore.groovy')) {
                        def paths = loadPaths(this)
                        def resultStore = loadResultStore(this)
                        reportsRoot = paths.reportsRoot(this)
                        suiteResults = resultStore.loadSuiteResults(this, reportsRoot)
                    }
                }
                catch (Throwable ignored) {
                    suiteResults = []
                }

                try {
                    if (fileExists('jenkinsIntegration/JenkinsConsoleView.groovy')) {
                        def consoleView = loadConsoleView(this)
                        consoleView.printFinalSummary(this, suiteResults, currentBuild.currentResult)
                    }
                }
                catch (Throwable ignored) {
                    echo '============================================================'
                    echo 'PIPELINE FINISHED'
                    echo '============================================================'
                }

                try {
                    if (fileExists('jenkinsIntegration/JenkinsAppManager.groovy')) {
                        def appManager = loadAppManager(this)
                        appManager.stop(this, [
                            stopPorts      : PIPELINE_CONFIG.application.stopPorts,
                            processPatterns: PIPELINE_CONFIG.application.processPatterns
                        ])
                    }
                    else {
                        emergencyStopApplication(this, PIPELINE_CONFIG.application.stopPorts)
                    }
                }
                catch (Throwable ignored) {
                    emergencyStopApplication(this, PIPELINE_CONFIG.application.stopPorts)
                }
            }

            catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                archiveArtifacts(
                    artifacts: 'Reports/suite-artifacts/**/*.png',
                    allowEmptyArchive: true
                )
            }

            catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                junit allowEmptyResults: true, testResults: 'Reports/**/JUnit_Report.xml,Reports/logs/*.junit.xml'
            }
        }

        success {
            script {
                if (PIPELINE_CONFIG.triggerNextJob && (PIPELINE_CONFIG.nextJobName ?: '').trim()) {
                    echo "Triggering next Jenkins job as a separate build: ${PIPELINE_CONFIG.nextJobName}"

                    build job: PIPELINE_CONFIG.nextJobName,
                          wait: false,
                          propagate: false

                    echo "Next Jenkins job triggered successfully: ${PIPELINE_CONFIG.nextJobName}"
                }
                else {
                    echo 'No next Jenkins job configured.'
                }
            }
        }

        failure {
            echo '[X] PIPELINE FINISHED WITH ERRORS'
        }

        aborted {
            echo '[TO] PIPELINE ABORTED'
        }
    }
}
