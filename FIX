// File: jenkinsIntegration/JenkinsDesktopPipelineRunner.groovy
package jenkinsIntegration

class JenkinsDesktopPipelineRunner implements Serializable {

    static void runDesktopCollection(def steps, Map cfg) {
        String taskWinDriver = cfg.taskWinDriver as String
        String taskDesktop   = cfg.taskDesktop as String

        String engineExe     = cfg.katalonExe as String
        String projectFile   = cfg.projectFile as String
        String collectionPath= cfg.collectionPath as String
        String browserType   = (cfg.browserType ?: 'Windows') as String
        int    retry         = (cfg.retry ?: 0) as int

        String fixedContextPath = (cfg.contextFile ?: 'D:\\Projects\\eMatchStarters\\run-context.properties') as String

        String ws = steps.pwd()

        // Always use the CURRENT Jenkins workspace (even if it becomes @2)
        String reportsDir = ws + "\\Reports"
        String logsDir    = "D:\\Projects\\eMatchStarters\\logs"

        steps.echo "============================================================"
        steps.echo "START ASSET: ${cfg.assetName}"
        steps.echo "TASK: ${taskDesktop}"
        steps.echo "WORKSPACE: ${ws}"
        steps.echo "COLLECTION: ${collectionPath}"
        steps.echo "============================================================"

        // Clean previous artifacts
        steps.bat("""@echo off
        if exist "${reportsDir}" (
          echo Cleaning previous Reports folder...
          rmdir /s /q "${reportsDir}" 2>nul
        )
        mkdir "${reportsDir}" 2>nul
        if exist "${reportsDir}\\_jenkins_task_exitcode.txt" del /f /q "${reportsDir}\\_jenkins_task_exitcode.txt" 2>nul
        """)

        // Write run-context.properties (fixed location that the scheduled task always finds)
        steps.writeFile file: fixedContextPath, text: [
                "WORKSPACE=${ws}",
                "PROJECT_FILE=${projectFile}",
                "KATALON_EXE=${engineExe}",
                "COLLECTION_PATH=${collectionPath}",
                "REPORTS_DIR=${reportsDir}",
                "LOG_DIR=${logsDir}",
                "BROWSER_TYPE=${browserType}",
                "RETRY=${retry}"
        ].join("\r\n") + "\r\n"

        steps.echo "run-context.properties written: ${fixedContextPath}"

        // Start WinDriver first (if needed)
        steps.bat("""@echo off
        schtasks /run /tn "${taskWinDriver}"
        if errorlevel 1 (
          echo ERROR: Failed to start WinDriver task: ${taskWinDriver}
          exit /b 1
        )
        """)

        // Start desktop task
        steps.bat("""@echo off
        schtasks /run /tn "${taskDesktop}"
        if errorlevel 1 (
          echo ERROR: Failed to start desktop task: ${taskDesktop}
          exit /b 1
        )
        """)

        // Wait the task to finish (poll schtasks status)
        int maxMinutes = (cfg.maxMinutes ?: 120) as int
        int maxLoops = (maxMinutes * 60) / 5

        steps.echo "Waiting desktop task to finish (max ${maxMinutes} min)..."

        for (int i = 0; i < maxLoops; i++) {
            String status = steps.bat(
                    script: """@echo off
                    for /f "tokens=2 delims=: " %%f in ('schtasks /query /tn "${taskDesktop}" /fo list ^| find "Status:"') do echo %%f
                    """,
                    returnStdout: true
            ).trim()

            if (status.equalsIgnoreCase("Ready")) {
                steps.echo "Desktop task finished. STATUS=${status}"
                break
            }

            steps.sleep time: 5, unit: 'SECONDS'

            if (i == maxLoops - 1) {
                steps.echo "ERROR: Timeout waiting task to finish: ${taskDesktop}"
                // try to stop it
                steps.bat("""@echo off
                schtasks /end /tn "${taskDesktop}" 2>nul
                """)
                throw new RuntimeException("Timeout waiting scheduled task")
            }
        }

        // Stop WinDriver
        steps.bat("""@echo off
        schtasks /end /tn "${taskWinDriver}" 2>nul
        """)

        // Read exit code produced by bat
        String exitFile = reportsDir + "\\_jenkins_task_exitcode.txt"
        if (!steps.fileExists(exitFile)) {
            steps.echo "ERROR: Desktop task exit code file not found: ${exitFile}"
            throw new RuntimeException("Exitcode file not found")
        }

        String exitCodeStr = steps.readFile(exitFile).trim()
        steps.echo "Desktop task exit code: ${exitCodeStr}"

        int exitCode = 0
        try { exitCode = Integer.parseInt(exitCodeStr) } catch (Throwable ignored) { exitCode = 999 }

        if (exitCode != 0) {
            steps.echo "⚠️ Katalon returned non-zero exit code: ${exitCode}"
            // don't fail immediately if you want pipeline continue; if you want fail, throw
            if (cfg.failOnNonZero == true) {
                throw new RuntimeException("Katalon exit code: " + exitCode)
            }
        }
    }
}
