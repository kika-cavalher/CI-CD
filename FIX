import static com.kms.katalon.core.testcase.TestCaseFactory.findTestCase

import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import commands.WindowsObjectLoader

String targetEnvironment = 'REC'

String menuName = 'PL économique Brut'
String menuResultName = 'PL économique Brut'
String openedTabName = menuResultName

Integer menuOpenTimeout = 90
Integer delayAfterMenuOpen = 10
Integer tabOpenTimeout = 180
Integer closeTabTimeout = 30

String loginTestCase = 'Component/Authentication/Login ' + targetEnvironment

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'🚀 Archive Mode validation\n' +
	'Menu search: ' + menuName + '\n' +
	'Menu result: ' + menuResultName + '\n' +
	'Validation: open menu, apply startup modals, validate tab and close tab'
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Authenticate and open application'
)

WebUI.callTestCase(
	findTestCase(loginTestCase),
	[:],
	FailureHandling.STOP_ON_FAILURE
)

CustomKeywords.'component.SettingsArchiveModeKeywords.enableArchiveModeFromSettings'(
	30
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Open Archive Mode menu\n' +
	'Search: ' + menuName + '\n' +
	'Result: ' + menuResultName + '\n' +
	'Menu open timeout: ' + menuOpenTimeout + ' seconds'
)

CustomKeywords.'component.MenuNavigator.searchAndOpenMenuByText'(
	menuName,
	menuResultName,
	menuOpenTimeout
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Handle Dates à afficher popup\n' +
	'Step 1: wait Dates à afficher popup\n' +
	'Step 2: click >\n' +
	'Step 3: validate selected date list is not empty\n' +
	'Step 4: click Appliquer'
)

handleDatesPopup(menuOpenTimeout, delayAfterMenuOpen)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Handle Choix des colonnes à afficher popup\n' +
	'Step 1: wait Choix des colonnes à afficher popup\n' +
	'Step 2: click Appliquer'
)

handleColumnsPopup(menuOpenTimeout, delayAfterMenuOpen)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Wait after startup modals\n' +
	'Delay: ' + delayAfterMenuOpen + ' seconds'
)

Windows.delay(delayAfterMenuOpen)

WindowsTestObject openedTab = WindowsObjectLoader.getTabByName(openedTabName)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Validate opened tab\n' +
	'Expected tab: ' + openedTabName + '\n' +
	'Tab timeout: ' + tabOpenTimeout + ' seconds'
)

if (!Windows.waitForElementPresent(openedTab, tabOpenTimeout, FailureHandling.OPTIONAL)) {
	CustomKeywords.'commands.ImageLoader.takeEvidence'(
		'PLEconomiqueBrutTabNotOpened.png'
	)

	KeywordUtil.markFailedAndStop(
		'Archive Mode tab was not opened after startup modals.\n' +
		'Expected tab: ' + openedTabName + '\n' +
		'Menu search: ' + menuName + '\n' +
		'Menu result: ' + menuResultName + '\n' +
		'Timeout: ' + tabOpenTimeout + ' seconds'
	)
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'✅ Archive Mode tab opened successfully\n' +
	'Tab: ' + openedTabName
)

CustomKeywords.'component.CloseTabKeywords.closeTabByName'(
	openedTabName,
	closeTabTimeout
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Close application'
)

WebUI.callTestCase(
	findTestCase('Component/Authentication/Close Application'),
	[:],
	FailureHandling.STOP_ON_FAILURE
)

KeywordUtil.markPassed(
	targetEnvironment + ' Archive Mode validation completed successfully. Menu: ' + menuResultName
)

void handleDatesPopup(Integer menuOpenTimeout, Integer delayAfterMenuOpen) {

	WindowsTestObject datesPopup = WindowsObjectLoader.getObject('menu', 'datesPopup')

	if (!Windows.waitForElementPresent(datesPopup, menuOpenTimeout, FailureHandling.OPTIONAL)) {
		CustomKeywords.'commands.ImageLoader.takeEvidence'(
			'PLEconomiqueBrutDatesPopupNotOpened.png'
		)

		KeywordUtil.markFailedAndStop(
			'Dates à afficher popup was not opened.\n' +
			'Timeout: ' + menuOpenTimeout + ' seconds'
		)
	}

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'✅ Dates à afficher popup opened'
	)

	clickMenuObject(
		'datesPopupAddButton',
		menuOpenTimeout,
		'Click > on Dates à afficher popup'
	)

	Windows.delay(1)

	WindowsTestObject selectedDateItem = WindowsObjectLoader.getObject('menu', 'datesPopupSelectedListItem')

	if (!Windows.waitForElementPresent(selectedDateItem, menuOpenTimeout, FailureHandling.OPTIONAL)) {
		CustomKeywords.'commands.ImageLoader.takeEvidence'(
			'PLEconomiqueBrutSelectedDateListEmpty.png'
		)

		KeywordUtil.markFailedAndStop(
			'Selected date list is empty after clicking >.\n' +
			'Expected: at least 1 selected date item\n' +
			'Timeout: ' + menuOpenTimeout + ' seconds'
		)
	}

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'✅ Selected date list is not empty\n' +
		'Validation: at least 1 selected date item exists'
	)

	clickMenuObject(
		'datesPopupApplyButton',
		menuOpenTimeout,
		'Click Appliquer on Dates à afficher popup'
	)

	Windows.delay(delayAfterMenuOpen)
}

void handleColumnsPopup(Integer menuOpenTimeout, Integer delayAfterMenuOpen) {

	WindowsTestObject columnsPopup = WindowsObjectLoader.getObject('menu', 'columnsPopup')

	if (!Windows.waitForElementPresent(columnsPopup, menuOpenTimeout, FailureHandling.OPTIONAL)) {
		CustomKeywords.'commands.ImageLoader.takeEvidence'(
			'PLEconomiqueBrutColumnsPopupNotOpened.png'
		)

		KeywordUtil.markFailedAndStop(
			'Choix des colonnes à afficher popup was not opened after applying Dates à afficher.\n' +
			'Timeout: ' + menuOpenTimeout + ' seconds'
		)
	}

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'✅ Choix des colonnes à afficher popup opened'
	)

	clickMenuObject(
		'columnsPopupApplyButton',
		menuOpenTimeout,
		'Click Appliquer on Choix des colonnes à afficher popup'
	)

	Windows.delay(delayAfterMenuOpen)
}

void clickMenuObject(String objectName, Integer timeoutSeconds, String actionDescription) {

	WindowsTestObject object = WindowsObjectLoader.getObject('menu', objectName)

	if (!Windows.waitForElementPresent(object, timeoutSeconds, FailureHandling.OPTIONAL)) {
		CustomKeywords.'commands.ImageLoader.takeEvidence'(
			objectName + 'NotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Object not found for action.\n' +
			'Object: ' + objectName + '\n' +
			'Action: ' + actionDescription + '\n' +
			'Timeout: ' + timeoutSeconds + ' seconds'
		)
	}

	Windows.click(object, FailureHandling.STOP_ON_FAILURE)

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'✅ ' + actionDescription
	)
}







