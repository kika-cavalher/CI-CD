		line = line.replace('\t', ' ')
		line = line.replaceAll(/\s+/, ' ').trim()

		def prefixed = (line =~ /^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3}\s+[A-Z]+\s+.+?\s+-\s+(.*)$/)
		if (prefixed.find()) {
			line = safeValue(prefixed.group(1))
		}

		return line
	}

	private String extractTimeLabel(String rawLine) {
		String raw = safeValue(rawLine)
		def matcher = (raw =~ /^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3})/)
		if (!matcher.find()) {
			return ''
		}

		try {
			Date value = new SimpleDateFormat('yyyy-MM-dd HH:mm:ss.SSS', Locale.ENGLISH).parse(matcher.group(1))
			return new SimpleDateFormat('HH:mm:ss', Locale.ENGLISH).format(value)
		} catch (Exception ignored) {
			return ''
		}
	}

	private long extractTimeMillis(String rawLine) {
		String raw = safeValue(rawLine)
		def matcher = (raw =~ /^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3})/)
		if (!matcher.find()) {
			return 0L
		}

		try {
			Date value = new SimpleDateFormat('yyyy-MM-dd HH:mm:ss.SSS', Locale.ENGLISH).parse(matcher.group(1))
			return value.time
		} catch (Exception ignored) {
			return 0L
		}
	}

	private List<Map> parseXmlCases(String xmlPath) {
		File xmlFile = new File(xmlPath)
		if (!xmlFile.exists()) {
			return []
		}

		String xmlText = ''
		try {
			xmlText = xmlFile.getText('UTF-8')
		} catch (Exception ignored) {
			return []
		}

		List<Map> cases = []
		def matcher = (xmlText =~ /<testcase\b([^>]*)>(.*?)<\/testcase>|<testcase\b([^>]*)\/>/s)

		int index = 0
		while (matcher.find()) {
			index++

			String attrs = safeValue(matcher.group(1))
			if (isBlank(attrs)) {
				attrs = safeValue(matcher.group(3))
			}
			String body = safeValue(matcher.group(2))

			String name = extractAttribute(attrs, 'name')
			String className = extractAttribute(attrs, 'classname')
			String time = extractAttribute(attrs, 'time')

			boolean failed = body.contains('<failure')
			boolean skipped = body.contains('<skipped')

			String details = ''
			String message = ''

			def failureMatcher = (body =~ /<failure\b([^>]*)>(.*?)<\/failure>/s)
			if (failureMatcher.find()) {
				message = extractAttribute(safeValue(failureMatcher.group(1)), 'message')
				details = stripXmlTags(safeValue(failureMatcher.group(2)))
			}

			cases << [
				index      : index,
				name       : !isBlank(name) ? name : className,
				shortName  : !isBlank(name) ? name : className,
				durationMs : toMillisFromCompactSeconds(time),
				status     : skipped ? 'skipped' : (failed ? 'failed' : 'passed'),
				message    : message,
				details    : details
			]
		}

		return cases
	}

	private String extractAttribute(String attrs, String name) {
		def matcher = (safeValue(attrs) =~ /${name}="([^"]*)"/)
		if (matcher.find()) {
			return safeValue(matcher.group(1))
		}
		return ''
	}

	private String stripXmlTags(String value) {
		return safeValue(value).replaceAll(/<[^>]+>/, '').trim()
	}

	private List<Map> buildFallbackScenarios(List<Map> xmlCases) {
		List<Map> scenarios = []

		xmlCases.eachWithIndex { Map xmlCase, int index ->
			String title = safeValue(xmlCase.shortName)
			if (isBlank(title)) {
				title = 'Test ' + (index + 1)
			}

			scenarios << [
				id             : 'scenario-' + (index + 1),
				title          : title,
				status         : safeValue(xmlCase.status),
				startLabel     : '',
				endLabel       : '',
				durationMs     : toLong(xmlCase.durationMs),
				durationLabel  : formatDurationFull(toLong(xmlCase.durationMs)),
				steps          : [[
					id           : 'step-' + (index + 1) + '-1',
					title        : title,
					status       : safeValue(xmlCase.status),
					timeLabel    : '',
					durationMs   : toLong(xmlCase.durationMs) > 0L ? toLong(xmlCase.durationMs) : 1000L,
					durationLabel: formatDurationFull(toLong(xmlCase.durationMs) > 0L ? toLong(xmlCase.durationMs) : 1000L),
					detailText   : title,
					shortError   : extractShortError(xmlCase.message ?: xmlCase.details),
					errorFull    : safeValue(xmlCase.details),
					emoji        : resolveStepEmoji(title)
				]],
				errorShort     : extractShortError(xmlCase.message ?: xmlCase.details),
				errorFull      : safeValue(xmlCase.details),
				sidebarSubtitle: extractShortError(xmlCase.message ?: xmlCase.details),
				evidences      : []
			]
		}

		return scenarios
	}

	private void normalizeScenarioSteps(List<Map> scenarios) {
		scenarios.each { Map scenario ->
			List<Map> currentSteps = (scenario.steps ?: []) as List<Map>

			currentSteps.eachWithIndex { Map step, int idx ->
				step.id = isBlank(step.id) ? (scenario.id + '-step-' + (idx + 1)) : step.id
				step.title = cleanupStepTitle(step.title ?: step.detailText)
				step.emoji = resolveStepEmoji(step.title)
				step.durationMs = toLong(step.durationMs) > 0L ? toLong(step.durationMs) : 1000L
				step.durationLabel = formatDurationFull(toLong(step.durationMs))
				step.timeLabel = safeValue(step.timeLabel)
				step.detailText = isBlank(step.detailText) ? safeValue(step.title) : safeValue(step.detailText)
				step.shortError = safeValue(step.shortError)
				step.errorFull = safeValue(step.errorFull)

				if (isBlank(step.status)) {
					step.status = 'passed'
				}
			}

			List<Map> steps = (scenario.steps ?: []) as List<Map>
			scenario.status = resolveScenarioStatus(steps)
			scenario.errorShort = resolveScenarioErrorShort(steps)
			scenario.errorFull = resolveScenarioErrorFull(steps)
			scenario.sidebarSubtitle = isBlank(scenario.errorShort) ? safeValue(scenario.title) : scenario.errorShort
			scenario.durationMs = toLong(scenario.durationMs) > 0L ? toLong(scenario.durationMs) : sumStepDurations(steps)
			scenario.durationLabel = formatDurationFull(toLong(scenario.durationMs))
		}
	}

	private String cleanupStepTitle(String value) {
		String text = safeValue(value)
		text = text.replaceAll(/\s+\(\d+[.,]\d+s\)$/, '').trim()
		text = text.replaceAll(/[.]{2,}$/, '').trim()
		return text
	}

	private String resolveScenarioStatus(List<Map> steps) {
		boolean hasFailed = steps.any { Map item -> safeValue(item.status) == 'failed' }
		if (hasFailed) {
			return 'failed'
		}

		boolean hasPassed = steps.any { Map item -> safeValue(item.status) == 'passed' }
		if (hasPassed) {
			return 'passed'
		}

		boolean hasInfo = steps.any { Map item -> safeValue(item.status) == 'info' }
		if (hasInfo) {
			return 'info'
		}

		return 'skipped'
	}

	private String resolveScenarioErrorShort(List<Map> steps) {
		Map failedStep = steps.find { Map item -> safeValue(item.status) == 'failed' }
		if (failedStep == null) {
			return ''
		}
		return extractShortError(failedStep.shortError ?: failedStep.errorFull ?: failedStep.detailText)
	}

	private String resolveScenarioErrorFull(List<Map> steps) {
		Map failedStep = steps.find { Map item -> safeValue(item.status) == 'failed' }
		if (failedStep == null) {
			return ''
		}
		return safeValue(failedStep.errorFull ?: failedStep.detailText)
	}

	private void applySequentialTimingFallback(File reportDir, List<Map> scenarios) {
		if (scenarios.isEmpty()) {
			return
		}

		scenarios.each { Map scenario ->
			long stepTotal = sumStepDurations((scenario.steps ?: []) as List<Map>)
			if (stepTotal > toLong(scenario.durationMs)) {
				scenario.durationMs = stepTotal
			}
			scenario.durationLabel = formatDurationFull(toLong(scenario.durationMs))
		}

		long totalDurationMs = 0L
		scenarios.each { Map item ->
			totalDurationMs += toLong(item.durationMs)
		}

		Date suiteEnd = new Date(reportDir.lastModified())
		Date suiteStart = new Date(suiteEnd.time - totalDurationMs)

		long cursor = suiteStart.time

		scenarios.each { Map scenario ->
			long scenarioDuration = toLong(scenario.durationMs)
			if (scenarioDuration <= 0L) {
				scenarioDuration = Math.max(1000L, sumStepDurations((scenario.steps ?: []) as List<Map>))
			}

			if (isBlank(scenario.startLabel)) {
				scenario.startLabel = formatTimeOnly(new Date(cursor))
			}

			if (isBlank(scenario.endLabel)) {
				scenario.endLabel = formatTimeOnly(new Date(cursor + scenarioDuration))
			}

			fillStepTimeLabels(scenario)
			scenario.durationMs = scenarioDuration
			scenario.durationLabel = formatDurationFull(scenarioDuration)

			cursor += scenarioDuration
		}
	}

	private void fillStepTimeLabels(Map scenario) {
		List<Map> steps = (scenario.steps ?: []) as List<Map>
		if (steps.isEmpty()) {
			return
		}

		Date scenarioStart = parseTimeOnly(safeValue(scenario.startLabel))
		if (scenarioStart == null) {
			return
		}

		long cursor = scenarioStart.time

		steps.each { Map step ->
			if (isBlank(step.timeLabel)) {
				step.timeLabel = formatTimeOnly(new Date(cursor))
			}

			long stepDuration = toLong(step.durationMs)
			if (stepDuration <= 0L) {
				stepDuration = 1000L
			}

			cursor += stepDuration
		}
	}

	private Date parseTimeOnly(String raw) {
		if (isBlank(raw)) {
			return null
		}

		try {
			return new SimpleDateFormat('HH:mm:ss', Locale.ENGLISH).parse(raw)
		} catch (Exception ignored) {
			return null
		}
	}

	private long sumStepDurations(List<Map> steps) {
		long value = 0L
		steps.each { Map item ->
			value += toLong(item.durationMs)
		}
		return value
	}

	private long toMillisFromCompactSeconds(String rawValue) {
		String raw = safeValue(rawValue).replace(',', '.').replace('s', '').trim()
		if (isBlank(raw)) {
			return 0L
		}

		try {
			double seconds = Double.parseDouble(raw)
			return Math.round(seconds * 1000d)
		} catch (Exception ignored) {
			return 0L
		}
	}

	private String formatDurationFull(long durationMs) {
		long totalSeconds = durationMs > 0L ? Math.round(durationMs / 1000d) : 0L
		long hours = (long) Math.floor(totalSeconds / 3600L)
		long minutes = (long) Math.floor((totalSeconds % 3600L) / 60L)
		long seconds = totalSeconds % 60L
		return String.format(Locale.ENGLISH, '%02dh %02dm %02ds', hours, minutes, seconds)
	}

	private String formatDisplayDate(Date value) {
		return new SimpleDateFormat('MM.dd.yyyy hh:mm:ss a', Locale.ENGLISH).format(value)
	}

	private String formatTimeOnly(Date value) {
		return new SimpleDateFormat('HH:mm:ss', Locale.ENGLISH).format(value)
	}

	private boolean looksLikeErrorLine(String line) {
		String lower = safeValue(line).toLowerCase(Locale.ENGLISH)

		boolean error = false
		error = error || lower.contains('stepfailedexception')
		error = error || lower.contains('root cause')
		error = error || lower.contains('caused by:')
		error = error || lower.contains('exception')
		error = error || lower.contains('unable to ')
		error = error || lower.contains('classnotfoundexception')
		error = error || lower.startsWith('at ')
		return error
	}

	private String extractShortError(def source) {
		String text = safeValue(source)
		if (isBlank(text)) {
			return ''
		}

		List<String> lines = text.readLines().collect { safeValue(it) }.findAll { !isBlank(it) }
		if (lines.isEmpty()) {
			return ''
		}

		String preferred = lines.find { String line ->
			String lower = line.toLowerCase(Locale.ENGLISH)
			boolean match = false
			match = match || lower.contains('unable to ')
			match = match || lower.contains('element click intercepted')
			match = match || lower.contains('object repository')
			match = match || lower.contains('no such element')
			match = match || lower.contains('timeout')
			match = match || lower.contains('classnotfoundexception')
			return match
		}

		String value = safeValue(preferred ?: lines.first())
		value = value.replace('com.kms.katalon.core.exception.StepFailedException:', '').trim()
		value = value.replace('(Root cause:', '').trim()

		int atIndex = value.indexOf(' at ')
		if (atIndex > 0) {
			value = value.substring(0, atIndex).trim()
		}

		if (value.length() > 180) {
			value = value.substring(0, 177) + '...'
		}

		return value
	}

	private void attachEvidenceToFailedScenarios(File reportDir, List<Map> scenarios) {
		scenarios.each { Map scenario ->
			scenario.evidences = []
		}

		List<File> candidates = findEvidenceImages(reportDir)
		if (candidates.isEmpty()) {
			return
		}

		candidates.sort { File a, File b -> a.lastModified() <=> b.lastModified() }

		List<Map> failedScenarios = scenarios.findAll { Map item ->
			safeValue(item.status) == 'failed'
		}

		failedScenarios.each { Map scenario ->
			File selected = pickEvidenceForScenario(reportDir, candidates, scenario)
			if (selected == null || !selected.exists()) {
				return
			}

			File bundled = ensureEvidenceInReportFolder(reportDir, selected)
			String href = buildEvidenceHref(bundled, reportDir)
			String previewSrc = buildEvidencePreviewSrc(bundled)

			scenario.evidences = [[
				name         : bundled.name,
				fileName     : bundled.name,
				href         : href,
				imgSrc       : previewSrc,
				imageSrc     : previewSrc,
				imageDataUri : previewSrc,
				image        : true
			]]
		}
	}

	private List<File> findEvidenceImages(File reportDir) {
		List<File> roots = []
		Set<String> seen = [] as Set
		List<File> images = []

		if (reportDir != null && reportDir.exists()) {
			roots << reportDir
		}

		if (reportDir?.parentFile != null && reportDir.parentFile.exists()) {
			roots << reportDir.parentFile
		}

		roots.unique { File item -> item.absolutePath }.each { File root ->
			root.eachFileRecurse { File file ->
				if (!file.isFile()) {
					return
				}

				if (!isImageFile(file.name)) {
					return
				}

				try {
					String key = file.canonicalPath
					if (seen.add(key)) {
						images << file
					}
				} catch (Exception ignored) {
					if (seen.add(file.absolutePath)) {
						images << file
					}
				}
			}
		}

		images.sort { File a, File b -> a.lastModified() <=> b.lastModified() }
		return images
	}

	private File pickEvidenceForScenario(File reportDir, List<File> candidates, Map scenario) {
		if (candidates == null || candidates.isEmpty()) {
			return null
		}

		return candidates.last()
	}

	private File ensureEvidenceInReportFolder(File reportDir, File source) {
		if (source == null || !source.exists()) {
			return source
		}

		File evidenceDir = new File(reportDir, safeValue(flow.EVIDENCE_FOLDER_NAME))
		if (!evidenceDir.exists()) {
			evidenceDir.mkdirs()
		}

		File target = new File(evidenceDir, source.name)

		try {
			if (!target.exists() || target.length() != source.length()) {
				Files.copy(source.toPath(), target.toPath(), StandardCopyOption.REPLACE_EXISTING)
				target.setLastModified(source.lastModified())
			}
		} catch (Exception ignored) {
			return source
		}

		return target
	}

	private String buildEvidenceHref(File file, File reportDir) {
		if (file == null || !file.exists()) {
			return ''
		}

		try {
			String reportBase = reportDir.canonicalPath.replace('\\', '/') + '/'
			String filePath = file.canonicalPath.replace('\\', '/')

			if (filePath.startsWith(reportBase)) {
				return filePath.substring(reportBase.length())
			}
		} catch (Exception ignored) {
		}

		return file.toURI().toString()
	}

	private String buildEvidencePreviewSrc(File file) {
		if (file == null || !file.exists()) {
			return ''
		}

		if (!isImageFile(file.name)) {
			return ''
		}

		try {
			byte[] content = Files.readAllBytes(file.toPath())
			String mime = resolveImageMime(file.name)
			return 'data:' + mime + ';base64,' + Base64.encoder.encodeToString(content)
		} catch (Exception ignored) {
			return file.toURI().toString()
		}
	}

	private String resolveImageMime(String fileName) {
		String lower = safeValue(fileName).toLowerCase(Locale.ENGLISH)

		if (lower.endsWith('.png')) return 'image/png'
		if (lower.endsWith('.jpg') || lower.endsWith('.jpeg')) return 'image/jpeg'
		if (lower.endsWith('.webp')) return 'image/webp'
		if (lower.endsWith('.gif')) return 'image/gif'
		if (lower.endsWith('.bmp')) return 'image/bmp'

		return 'image/png'
	}

	private boolean isImageFile(String fileName) {
		String lower = safeValue(fileName).toLowerCase(Locale.ENGLISH)
		return lower.endsWith('.png') ||
				lower.endsWith('.jpg') ||
				lower.endsWith('.jpeg') ||
				lower.endsWith('.webp') ||
				lower.endsWith('.gif') ||
				lower.endsWith('.bmp')
	}

	private String resolveAssetUrl(File reportDir, String relativePath) {
		if (isBlank(relativePath)) {
			return ''
		}

		File projectRoot = findProjectRoot(reportDir)
		File asset = new File(projectRoot, relativePath)
		if (asset.exists()) {
			return asset.toURI().toString()
		}
		return ''
	}

	private File findProjectRoot(File reportDir) {
		File current = reportDir
		while (current != null) {
			if ('Reports'.equalsIgnoreCase(current.name)) {
				return current.parentFile != null ? current.parentFile : current
			}
			current = current.parentFile
		}
		return reportDir
	}

	private String resolveStepEmoji(String title) {
		String lower = safeValue(title).toLowerCase(Locale.ENGLISH)

		if (lower.contains('wait') || lower.contains('search') || lower.contains('find')) return '🔎'
		if (lower.contains('click') || lower.contains('select')) return '🖱️'
		if (lower.contains('fill') || lower.contains('input') || lower.contains('settext') || lower.contains('write')) return '⌨️'
		if (lower.contains('open') || lower.contains('navigate') || lower.contains('calltestcase')) return '🌐'
		if (lower.contains('verify') || lower.contains('assert')) return '✅'
		return '🔹'
	}

	private String escapeXml(String value) {
		return safeValue(value)
				.replace('&', '&amp;')
				.replace('<', '&lt;')
				.replace('>', '&gt;')
				.replace('"', '&quot;')
				.replace("'", '&apos;')
	}
