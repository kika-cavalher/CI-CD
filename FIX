Cole o Jenkinsfile inteiro assim:

pipeline {
  agent any

  options {
    timestamps()
    ansiColor('xterm')
    disableConcurrentBuilds()
    timeout(time: 2, unit: 'HOURS')
  }

  environment {
    CTX_FILE = 'D:\\Projects\\eMatchStarters\\run-context.properties'
    TASK_RUN = '\\eMatch Automation\\RunEMatchDesktop'
    TASK_DRIVER = 'startWinDriver'
  }

  stages {

    stage('Prepare Run Context') {
      steps {
        script {
          def wsPath = pwd()

          def content = """WORKSPACE=${wsPath}
PROJECT_FILE=eMatch POC.prj
KATALON_EXE=C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0\\katalonc.exe
COLLECTION_PATH=Test Suites/Archive Mode/Archive Mode Collection
REPORTS_DIR=${wsPath}\\Reports
LOG_DIR=D:\\Projects\\eMatchStarters\\logs
BROWSER_TYPE=Windows
RETRY=0
"""
          writeFile file: env.CTX_FILE, text: content

          echo "✅ run-context.properties written: ${env.CTX_FILE}"
          echo "📌 WORKSPACE: ${wsPath}"
          echo "📌 COLLECTION: Test Suites/Archive Mode/Archive Mode Collection"
        }
      }
    }

    stage('Run - Archive Mode Collection') {
      steps {
        bat """
          schtasks /run /tn "${env.TASK_DRIVER}"
          schtasks /run /tn "${env.TASK_RUN}"

          :loop
          for /f "tokens=2 delims=: " %%f in ('schtasks /query /tn "${env.TASK_RUN}" /fo list ^| find "Status:"') do (
              if "%%f"=="Running" (
                  ping -n 6 localhost >nul 2>nul
                  goto loop
              )
          )

          schtasks /end /tn "${env.TASK_DRIVER}"
        """
      }
    }

    stage('Collect Reports') {
      steps {
        script {
          def exitFile = "${pwd()}\\Reports\\_jenkins_task_exitcode.txt"
          if (fileExists(exitFile)) {
            def rc = readFile(exitFile).trim()
            echo "🧾 Desktop task exit code: ${rc}"
            if (rc != '0') {
              echo "⚠️ Katalon returned non-zero exit code: ${rc}"
            }
          } else {
            echo "⚠️ Exit code file not found: ${exitFile}"
          }
        }

        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
          junit testResults: 'Reports/**/JUnit_Report.xml', allowEmptyResults: true
        }

        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
          archiveArtifacts artifacts: 'Reports/**/*', allowEmptyArchive: true
        }
      }
    }

    stage('Trigger Next Job') {
      steps {
        echo "Triggering next Jenkins job: Passerelle Bilan"
        build job: 'Passerelle Bilan', wait: false
      }
    }
  }
}
