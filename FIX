				'[FAVORITE][18] OK image was not found. Pressing ENTER.'
			)
	
			pressKeyboardKey(
				KeyEvent.VK_ENTER
			)
		}
	
		Windows.delay(2)
	
		KeywordUtil.markPassed(
			'Favorite created successfully.\n' +
			'Title: ' + favoriteTitle + '\n' +
			'Save method: ' +
			(saveFavoriteClicked ? 'image' : 'TAB + ENTER')
		)
	}
	

