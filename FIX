package jiraIntegration

import java.io.File
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale
import java.net.URI

class JiraHtmlTemplateBuilder {

	private static final String DEFAULT_APP_NAME = 'Execution'
	private static final String REPORT_TITLE_PREFIX = 'Test report - '

	private static final String STATUS_PASS = '#68b84b'
	private static final String STATUS_FAIL = '#e05b4d'
	private static final String STATUS_SKIP = '#d7b436'

	JiraHtmlTemplateBuilder() {
	}

	String build(Map model) {
		return buildHtml(model)
	}

	String render(Map model) {
		return buildHtml(model)
	}

	String buildHtml(Map model) {
		Map view = normalizeModel(model)

		StringBuilder html = new StringBuilder()

		html.append('<!DOCTYPE html>\n')
		html.append('<html lang="en">\n')
		html.append('<head>\n')
		html.append('<meta charset="UTF-8">\n')
		html.append('<meta name="viewport" content="width=device-width, initial-scale=1.0">\n')
		html.append('<title>')
		html.append(htmlEscape(view.reportTitle))
		html.append('</title>\n')
		html.append(buildStyles(view))
		html.append('</head>\n')
		html.append('<body>\n')

		html.append('<header class="top-banner">\n')
		html.append('  <div class="top-banner-left">\n')

		if (!safeValue(view.logoSrc).isEmpty()) {
			html.append('    <img class="brand-logo" src="')
			html.append(htmlEscape(resolveLogoHref(view)))
			html.append('" alt="')
			html.append(htmlEscape(view.appName))
			html.append(' logo">\n')
		}

		html.append('    <div class="brand-copy">\n')
		html.append('      <div class="banner-title">')
		html.append(htmlEscape(view.reportTitle))
		html.append('</div>\n')
		html.append('      <div class="banner-subtitle">')
		html.append(htmlEscape(view.subtitle))
		html.append('</div>\n')
		html.append('    </div>\n')
		html.append('  </div>\n')

		html.append('  <div class="top-banner-right">\n')
		html.append('    <div>')
		html.append(htmlEscape(view.generatedLabel))
		html.append('</div>\n')
		html.append('    <div>Project ')
		html.append(htmlEscape(view.appName))
		html.append('</div>\n')
		html.append('  </div>\n')
		html.append('</header>\n')

		html.append('<div class="page">\n')

		html.append('  <aside class="sidebar">\n')
		html.append('    <div class="sidebar-tabs">\n')
		html.append('      <button id="tab-tests" class="sidebar-tab active" type="button" onclick="showTab(\'tests\')">Tests</button>\n')
		html.append('      <button id="tab-charts" class="sidebar-tab" type="button" onclick="showTab(\'charts\')">Charts</button>\n')
		html.append('    </div>\n')

		html.append('    <div id="tests-sidebar-block">\n')
		html.append('      <div class="search-wrap">\n')
		html.append('        <input id="scenarioSearch" class="search-input" type="text" placeholder="Search test name, path, or status." onkeyup="filterScenarios()">\n')
		html.append('      </div>\n')
		html.append('      <div id="scenarioList" class="scenario-list">\n')
		view.scenarios.eachWithIndex { Map scenario, int index ->
			html.append(buildScenarioListItem(scenario, index == 0))
		}
		html.append('      </div>\n')
		html.append('    </div>\n')

		html.append('    <div id="charts-sidebar-block" class="hidden">\n')
		html.append(buildChartsSidebar(view))
		html.append('    </div>\n')

		html.append('  </aside>\n')

		html.append('  <main class="content">\n')
		view.scenarios.eachWithIndex { Map scenario, int index ->
			html.append(buildScenarioPanel(scenario, view, index == 0))
		}
		html.append(buildChartsPanel(view))
		html.append('  </main>\n')

		html.append('</div>\n')
		html.append(buildScripts())
		html.append('</body>\n')
		html.append('</html>\n')

		return html.toString()
	}

	// =========================================================================
	// NORMALIZATION
	// =========================================================================

	private Map normalizeModel(Map model) {
		Map safeModel = model ?: [:]

		String appName = pickFirst(
				safeModel.appName,
				safeModel.projectName,
				DEFAULT_APP_NAME
				)

		String suiteName = pickFirst(
				safeModel.suiteName,
				safeModel.testSuiteName,
				safeModel.suite,
				safeModel.executionName,
				safeModel.title,
				'Execution'
				)

		String reportTitle = REPORT_TITLE_PREFIX + suiteName
		List<Map> scenarios = normalizeScenarios(safeModel)

		int passedCount = scenarios.count { it.status == 'passed' }
		int failedCount = scenarios.count { it.status == 'failed' }
		int skippedCount = scenarios.count { it.status == 'skipped' }
		int totalCount = scenarios.size()

		return [
			appName          : appName,
			reportTitle      : reportTitle,
			suiteName        : suiteName,
			subtitle         : pickFirst(safeModel.subtitle, appName + ' execution overview'),
			generatedLabel   : buildGeneratedLabel(safeModel),
			reportFolder     : pickFirst(safeModel.reportFolder, safeModel.baseFolder, safeModel.executionFolder),
			logoSrc          : pickFirst(safeModel.logoSrc),
			headerBackground : safeColor(pickFirst(safeModel.headerBackground), '#4C1D95'),
			accentColor      : safeColor(pickFirst(safeModel.accentColor), '#6D28D9'),
			accentSoftColor  : safeColor(pickFirst(safeModel.accentSoftColor), '#F3E8FF'),
			infoColor        : safeColor(pickFirst(safeModel.infoColor), '#7C3AED'),
			scenarios        : scenarios,
			passedCount      : passedCount,
			failedCount      : failedCount,
			skippedCount     : skippedCount,
			totalCount       : totalCount
		]
	}

	private List<Map> normalizeScenarios(Map model) {
		List rawList = asList(pickFirstObject(
				model.scenarios,
				model.tests,
				model.cases,
				model.executions,
				model.items
				))

		List<Map> result = []

		rawList.eachWithIndex { def rawItem, int index ->
			Map item = rawItem instanceof Map ? rawItem : [name: safeValue(rawItem)]

			String scenarioName = pickFirst(
					item.scenarioName,
					item.title,
					item.name,
					item.displayName,
					item.shortName,
					item.caseName,
					item.testName,
					"Scenario ${index + 1}"
					)

			String scenarioId = pickFirst(item.id, item.key, "scenario-${index + 1}")
			String status = normalizeStatus(pickFirst(item.status, item.result, item.outcome, item.finalStatus))

			String shortError = shorten(pickFirst(
					item.visualError,
					item.errorSummary,
					item.errorShort,
					item.failureMessage,
					item.message,
					item.sidebarSubtitle
					), 95)

			String rawStart = pickFirst(
					item.startLong,
					item.startLabel,
					item.startTime,
					item.startDateTime,
					item.startDate,
					item.startShort,
					item.startClock
					)

			String rawEnd = pickFirst(
					item.endLong,
					item.endLabel,
					item.endTime,
					item.endDateTime,
					item.endDate,
					item.endShort,
					item.endClock
					)

			long durationMs = normalizeDurationMs(item, rawStart, rawEnd)
			String durationLabel = formatDuration(durationMs)

			List<Map> steps = normalizeSteps(item)
			if (steps.isEmpty()) {
				steps = parseStepsFromRawText(pickFirst(
						item.fullError,
						item.errorFull,
						item.errorDetail,
						item.stackTrace,
						item.stacktrace,
						item.details,
						item.rawLog,
						item.stepTrace
						))
			}

			List<Map> evidence = normalizeEvidence(item, model)
			if (status == 'failed' && evidence.size() > 1) {
				evidence = [evidence.last()]
			}

			result << [
				id           : scenarioId,
				name         : scenarioName,
				summary      : shortError,
				status       : status,
				startShort   : extractClockLabel(rawStart),
				endShort     : extractClockLabel(rawEnd),
				startLong    : formatDateTimeLabel(rawStart),
				endLong      : formatDateTimeLabel(rawEnd),
				durationLabel: durationLabel,
				visualError  : pickFirst(
				item.visualError,
				item.errorSummary,
				item.errorShort,
				item.failureMessage,
				item.message,
				item.sidebarSubtitle
				),
				fullError    : pickFirst(
				item.errorFull,
				item.fullError,
				item.errorDetail,
				item.stackTrace,
				item.stacktrace,
				item.details,
				item.errorLog
				),
				steps        : steps,
				evidence     : evidence
			]
		}

		return result
	}

	private List<Map> normalizeSteps(Map item) {
		List rawSteps = asList(pickFirstObject(
				item.steps,
				item.stepRows,
				item.stepItems,
				item.timeline,
				item.events,
				item.logs
				))

		List<Map> result = []

		rawSteps.each { def raw ->
			Map row = raw instanceof Map ? raw : [detail: safeValue(raw)]

			String status = normalizeStatus(pickFirst(
					row.status,
					row.result,
					row.outcome,
					row.level
					))

			String detail = pickFirst(
					row.detail,
					row.detailText,
					row.message,
					row.text,
					row.title,
					row.name
					)

			if (detail.isEmpty()) {
				return
			}

			String timestamp = extractClockLabel(pickFirst(
					row.timestamp,
					row.timeLabel,
					row.time,
					row.at,
					row.label,
					row.startLabel
					))

			result << [
				status   : status,
				timestamp: timestamp,
				detail   : detail,
				icon     : resolveStepIcon(detail, status)
			]
		}

		return result
	}

	private List<Map> parseStepsFromRawText(String rawText) {
		List<Map> result = []

		if (rawText.isEmpty()) {
			return result
		}

		rawText.readLines().each { String rawLine ->
			String line = safeValue(rawLine)
			if (line.isEmpty()) {
				return
			}

			def matcherA = (line =~ /^(\d{2}:\d{2}:\d{2}(?:\.\d{3})?)\s+(PASSED|FAILED|ERROR|INFO|SKIPPED)\s+(.*)$/)
			if (matcherA.find()) {
				String status = normalizeStatus(matcherA.group(2))
				String detail = safeValue(matcherA.group(3))

				result << [
					status   : status,
					timestamp: cleanClock(matcherA.group(1)),
					detail   : detail,
					icon     : resolveStepIcon(detail, status)
				]
				return
			}

			def matcherB = (line =~ /^(Given|When|Then|And)\s+(.+?)(?:\.{2,}|\s+)(passed|failed|skipped)$/)
			if (matcherB.find()) {
				String detail = matcherB.group(1) + ' ' + matcherB.group(2)
				String status = normalizeStatus(matcherB.group(3))

				result << [
					status   : status,
					timestamp: '',
					detail   : detail,
					icon     : resolveStepIcon(detail, status)
				]
				return
			}

			def matcherC = (line =~ /^TEST STEP:\s+(.*)$/)
			if (matcherC.find()) {
				String detail = safeValue(matcherC.group(1))
				if (!detail.isEmpty()) {
					result << [
						status   : 'info',
						timestamp: '',
						detail   : detail,
						icon     : resolveStepIcon(detail, 'info')
					]
				}
			}
		}

		return result
	}

	private List<Map> normalizeEvidence(Map item, Map model) {
		List rawEvidence = []

		if (item?.evidence instanceof Collection) {
			rawEvidence.addAll(item.evidence as Collection)
		}
		if (item?.evidences instanceof Collection) {
			rawEvidence.addAll(item.evidences as Collection)
		}
		if (item?.images instanceof Collection) {
			rawEvidence.addAll(item.images as Collection)
		}
		if (item?.attachments instanceof Collection) {
			rawEvidence.addAll(item.attachments as Collection)
		}

		if (rawEvidence.isEmpty()) {
			return []
		}

		String baseFolder = firstNonBlank(
				item?.reportFolder,
				model?.reportFolder,
				model?.baseFolder,
				model?.executionFolder
				)

		List<Map> result = []

		rawEvidence.each { def raw ->
			String name = ''
			String href = ''
			String imgSrc = ''
			boolean image = false

			if (raw instanceof Map) {
				name = firstNonBlank(raw.name, raw.fileName, raw.title, raw.label)
				href = firstNonBlank(raw.href, raw.url, raw.path, raw.file, raw.absolutePath, raw.relativePath)
				imgSrc = firstNonBlank(raw.imgSrc, raw.imageSrc, raw.imageDataUri)

				def imageFlag = raw.image != null ? raw.image : raw.isImage
				if (imageFlag != null) {
					image = Boolean.valueOf(String.valueOf(imageFlag))
				}
			} else {
				href = safeValue(raw)
				name = new File(href).name
			}

			if (!imgSrc.isEmpty() && imgSrc.startsWith('data:image')) {
				image = true
			}

			File resolved = null

			if (imgSrc.isEmpty()) {
				if (!href.isEmpty() &&
						!href.startsWith('data:') &&
						!href.startsWith('file:') &&
						!href.startsWith('http://') &&
						!href.startsWith('https://')) {
					resolved = resolveFile(href, baseFolder)
				}
			}

			if (resolved != null && resolved.exists()) {
				if (name.isEmpty()) {
					name = resolved.name
				}
				if (href.isEmpty()) {
					href = resolved.toURI().toString()
				}
				if (!image) {
					image = isImageFile(resolved.name)
				}
				if (imgSrc.isEmpty() && image) {
					imgSrc = resolved.toURI().toString()
				}
			}

			if (name.isEmpty()) {
				name = 'Evidence'
			}

			if (!href.isEmpty() || !imgSrc.isEmpty()) {
				result << [
					name  : name,
					href  : href,
					image : image,
					imgSrc: imgSrc
				]
			}
		}

		return result
	}

