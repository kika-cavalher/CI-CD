	private Map resolveLatestRecPrdFiles(
			File exportRoot,
			String expectedGroupFolder,
			String expectedFeatureFolder) {

		Map result = [
			recFile       : null,
			prdFile       : null,
			selectedFolder: null
		]

		List<Map> validPairs = []
		List<File> matchingFeatureFolders = []

		collectMatchingFeatureFolders(
				exportRoot,
				expectedGroupFolder,
				expectedFeatureFolder,
				matchingFeatureFolders
				)

		for (File featureFolder : matchingFeatureFolders) {
			collectPairCandidates(
					featureFolder,
					validPairs
					)
		}

		if (validPairs.isEmpty()) {
			KeywordUtil.logInfo(
					'[REC X PRD SEARCH] No REC/PRD pair was found inside the exact feature folder. ' +
					'Fallback search will match the feature name in folders and file names.'
					)

			collectFallbackPairCandidates(
					exportRoot,
					expectedGroupFolder,
					expectedFeatureFolder,
					validPairs
					)
		}

		if (validPairs.isEmpty()) {
			return result
		}

		validPairs.sort { Map first, Map second ->

			(second.pairTimestamp as Long) <=>
					(first.pairTimestamp as Long)
		}

		Map latestPair = validPairs.get(0)

		result.recFile = latestPair.recFile
		result.prdFile = latestPair.prdFile
		result.selectedFolder = latestPair.selectedFolder

		return result
	}


	private void collectPairCandidates(
			File currentFolder,
			List<Map> validPairs) {

		if (currentFolder == null ||
				!currentFolder.exists() ||
				!currentFolder.isDirectory()) {

			return
		}

		addPairCandidateFromFolder(
				currentFolder,
				validPairs
				)

		File[] children = currentFolder.listFiles()

		if (children == null) {
			return
		}

		for (File child : children) {
			if (child != null &&
					child.isDirectory()) {

				collectPairCandidates(
						child,
						validPairs
						)
			}
		}
	}


	private void addPairCandidateFromFolder(
			File folder,
			List<Map> validPairs) {

		File[] folderFiles = folder.listFiles()

		if (folderFiles == null) {
			return
		}

		List<File> recFiles =
				folderFiles.findAll { File file ->

					isEnvironmentExcelFile(file, 'REC')
				}

		List<File> prdFiles =
				folderFiles.findAll { File file ->

					isEnvironmentExcelFile(file, 'PRD')
				}

		if (recFiles.isEmpty() ||
				prdFiles.isEmpty()) {

			return
		}

		recFiles.sort { File first, File second ->

			second.lastModified() <=>
					first.lastModified()
		}

		prdFiles.sort { File first, File second ->

			second.lastModified() <=>
					first.lastModified()
		}

		File recFile = recFiles.get(0)
		File prdFile = prdFiles.get(0)

		boolean pairAlreadyAdded =
				validPairs.any { Map existingPair ->

					File existingFolder =
							existingPair.selectedFolder as File

					existingFolder != null &&
							existingFolder.getAbsolutePath().equalsIgnoreCase(
							folder.getAbsolutePath()
							)
				}

		if (pairAlreadyAdded) {
			return
		}

		validPairs.add([
			recFile       : recFile,
			prdFile       : prdFile,
			selectedFolder: folder,
			pairTimestamp : Math.max(
			recFile.lastModified(),
			prdFile.lastModified()
			)
		])
	}


	private void collectFallbackPairCandidates(
			File currentFolder,
			String expectedGroupFolder,
			String expectedFeatureFolder,
			List<Map> validPairs) {

		if (currentFolder == null ||
				!currentFolder.exists() ||
				!currentFolder.isDirectory()) {

			return
		}

		File[] folderFiles = currentFolder.listFiles()

		if (folderFiles == null) {
			return
		}

		List<File> recFiles =
				folderFiles.findAll { File file ->

					isEnvironmentExcelFile(file, 'REC')
				}

		List<File> prdFiles =
				folderFiles.findAll { File file ->

					isEnvironmentExcelFile(file, 'PRD')
				}

		if (!recFiles.isEmpty() &&
				!prdFiles.isEmpty() &&
				matchesExpectedExportFeature(
				currentFolder,
				recFiles,
				prdFiles,
				expectedGroupFolder,
				expectedFeatureFolder
				)) {

			addPairCandidateFromFolder(
					currentFolder,
					validPairs
					)
		}

		for (File child : folderFiles) {
			if (child != null &&
					child.isDirectory()) {

				collectFallbackPairCandidates(
						child,
						expectedGroupFolder,
						expectedFeatureFolder,
						validPairs
						)
			}
		}
	}


	private boolean matchesExpectedExportFeature(
			File folder,
			List<File> recFiles,
			List<File> prdFiles,
			String expectedGroupFolder,
			String expectedFeatureFolder) {

		StringBuilder candidateText = new StringBuilder()

		candidateText
				.append(folder.getAbsolutePath())
				.append(' ')

		for (File file : recFiles) {
			candidateText
					.append(file.getName())
					.append(' ')
		}

		for (File file : prdFiles) {
			candidateText
					.append(file.getName())
					.append(' ')
		}

		String normalizedCandidate =
				normalizeSearchToken(
				candidateText.toString()
				)

		List<String> featureTokens =
				buildSearchTokens(
				expectedFeatureFolder
				)

		if (!matchesAnySearchToken(
				normalizedCandidate,
				featureTokens
				)) {

			return false
		}

		List<String> groupTokens =
				buildSearchTokens(
				expectedGroupFolder
				)

		return groupTokens.isEmpty() ||
				matchesAnySearchToken(
				normalizedCandidate,
				groupTokens
				)
	}


	private List<String> buildSearchTokens(
			String value) {

		List<String> tokens = []
		String normalized =
				normalizeSearchToken(value)

		if (normalized.isEmpty()) {
			return tokens
		}

		tokens.add(normalized)

		if (normalized.endsWith('s') &&
				normalized.length() > 1) {

			tokens.add(
					normalized.substring(
					0,
					normalized.length() - 1
					)
					)
		}

		if (normalized.endsWith('ee') &&
				normalized.length() > 2) {

			tokens.add(
					normalized.substring(
					0,
					normalized.length() - 1
					)
					)
		}

		return tokens.unique()
	}


	private boolean matchesAnySearchToken(
			String candidate,
			List<String> tokens) {

		for (String token : tokens) {
			if (!safeText(token).isEmpty() &&
					candidate.contains(token)) {

				return true
			}
		}

		return false
	}


	private String normalizeSearchToken(
			Object value) {

		return normalizeText(value)
				.replace('_', '')
	}


	private void collectMatchingFeatureFolders(
			File currentFolder,
			String expectedGroupFolder,
			String expectedFeatureFolder,
			List<File> result) {

		if (currentFolder == null ||
				!currentFolder.exists() ||
				!currentFolder.isDirectory()) {

			return
		}

		File parentFolder = currentFolder.getParentFile()

		boolean featureMatches =
				normalizeText(
				currentFolder.getName()
				).equals(
				normalizeText(expectedFeatureFolder)
				)

		boolean groupMatches =
				parentFolder != null &&
				normalizeText(
				parentFolder.getName()
				).equals(
				normalizeText(expectedGroupFolder)
				)

		if (featureMatches &&
				groupMatches) {

			result.add(currentFolder)
			return
		}

		File[] children = currentFolder.listFiles()

		if (children == null) {
			return
		}

		for (File child : children) {
			if (child != null &&
					child.isDirectory()) {

				collectMatchingFeatureFolders(
						child,
						expectedGroupFolder,
						expectedFeatureFolder,
						result
						)
			}
		}
	}


	private boolean isEnvironmentExcelFile(
			File file,
			String environment) {

		if (file == null ||
				!file.exists() ||
				!file.isFile()) {

			return false
		}

		String fileName = file.getName()

		if (fileName.startsWith('~$')) {
			return false
		}

		return fileName
				.toUpperCase()
				.startsWith(
				safeText(environment)
				.toUpperCase() +
				'_'
				) &&
				isExcelFileName(fileName)
	}


	private boolean isExcelFileName(String fileName) {

		String normalizedName =
				safeText(fileName)
				.toLowerCase()

		return normalizedName.endsWith('.xlsx') ||
				normalizedName.endsWith('.xls') ||
				normalizedName.endsWith('.xlsm')
	}


	private String readHeaderName(
			Sheet sheet,
			int columnIndex,
			DataFormatter formatter) {

		if (sheet == null ||
				columnIndex < 0) {

			return ''
		}

		Row headerRow = sheet.getRow(0)

		if (headerRow == null) {
			return ''
		}

		Cell headerCell = headerRow.getCell(columnIndex)

		if (headerCell == null) {
			return ''
		}

		return formatter
				.formatCellValue(headerCell)
				.trim()
	}


	private BigDecimal getCellNumber(
			Row row,
			int columnIndex,
			DataFormatter formatter,
			FormulaEvaluator evaluator) {

		if (row == null ||
				columnIndex < 0) {

			return null
		}

		Cell cell = row.getCell(columnIndex)

		if (cell == null) {
			return null
		}

		try {
			CellType cellType = cell.getCellType()

			if (cellType == CellType.NUMERIC) {
				return BigDecimal.valueOf(
						cell.getNumericCellValue()
						)
			}

			if (cellType == CellType.STRING) {
				String stringValue =
						cell.getStringCellValue()

				BigDecimal parsedStringValue =
						parseNumber(stringValue)

				if (parsedStringValue != null) {
					return parsedStringValue
				}

				if (isZeroPlaceholder(stringValue)) {
					return BigDecimal.ZERO
				}
			}

			if (cellType == CellType.FORMULA) {
				CellType cachedResultType =
						cell.getCachedFormulaResultType()

				if (cachedResultType == CellType.NUMERIC) {
					return BigDecimal.valueOf(
							cell.getNumericCellValue()
							)
				}

				if (cachedResultType == CellType.STRING) {
					String cachedText =
							cell.getStringCellValue()

					BigDecimal cachedStringValue =
							parseNumber(cachedText)

					if (cachedStringValue != null) {
						return cachedStringValue
					}

					if (isZeroPlaceholder(cachedText)) {
						return BigDecimal.ZERO
					}
				}

				if (evaluator != null) {
					try {
						CellValue evaluatedValue =
								evaluator.evaluate(cell)

						if (evaluatedValue != null) {
							if (evaluatedValue.getCellType() ==
									CellType.NUMERIC) {

								return BigDecimal.valueOf(
										evaluatedValue
										.getNumberValue()
										)
							}

							if (evaluatedValue.getCellType() ==
									CellType.STRING) {

								String evaluatedText =
										evaluatedValue
										.getStringValue()

								BigDecimal evaluatedStringValue =
										parseNumber(evaluatedText)

								if (evaluatedStringValue != null) {
									return evaluatedStringValue
								}

								if (isZeroPlaceholder(evaluatedText)) {
									return BigDecimal.ZERO
								}
							}
						}

						String formattedFormulaText =
								formatter.formatCellValue(
								cell,
								evaluator
								)

						BigDecimal formattedFormulaValue =
								parseNumber(formattedFormulaText)

						if (formattedFormulaValue != null) {
							return formattedFormulaValue
						}

						if (isZeroPlaceholder(formattedFormulaText)) {
							return BigDecimal.ZERO
						}
					} catch (Exception ignored) {
					}
				}
			}

			String formattedText = ''

			try {
				formattedText =
						evaluator == null
						? formatter.formatCellValue(cell)
						: formatter.formatCellValue(
						cell,
						evaluator
						)
			} catch (Exception ignored) {
				formattedText =
						formatter.formatCellValue(cell)
			}

			BigDecimal formattedValue =
					parseNumber(formattedText)

			if (formattedValue != null) {
				return formattedValue
			}

			if (isZeroPlaceholder(formattedText)) {
				return BigDecimal.ZERO
			}

			return null
		} catch (Exception exception) {
			KeywordUtil.logInfo(
					'[EXCEL VALUE WARNING] Value could not be read.\n' +
					'Row: ' +
					(row.getRowNum() + 1) +
					'\nColumn index: ' +
					columnIndex +
					'\nCell type: ' +
					safeText(cell.getCellType()) +
					'\nReason: ' +
					safeText(exception.getMessage())
					)

			return null
		}
	}


	private String readCellDisplayText(
			Cell cell,
			DataFormatter formatter,
			FormulaEvaluator evaluator) {

		if (cell == null) {
			return ''
		}

		try {
			if (evaluator != null) {
				return safeText(
						formatter.formatCellValue(
						cell,
						evaluator
						)
						)
			}
		} catch (Exception ignored) {
		}

		try {
			return safeText(
					formatter.formatCellValue(cell)
					)
		} catch (Exception ignored) {
			return ''
		}
	}


	private boolean isBlankCell(
			Cell cell,
			String displayText) {

		if (cell == null) {
			return true
		}

		try {
			if (cell.getCellType() == CellType.BLANK) {
				return true
			}
		} catch (Exception ignored) {
		}

		return safeText(displayText).isEmpty()
	}


	private boolean isZeroPlaceholder(String value) {

		String text = safeText(value)

		if (text.isEmpty()) {
			return false
		}

		text = text
				.replace('\u00A0', ' ')
				.replace('\u202F', ' ')
				.replace('\u2212', '-')
				.replace('\u2012', '-')
				.replace('\u2013', '-')
				.replace('\u2014', '-')
				.replace('\u2015', '-')
				.trim()

		String compact =
				text
				.replaceAll('\\s+', '')
				.replaceAll('[€$£¥%]', '')

		if (compact.matches('^-+$')) {
			return true
		}

		return compact.matches(
				'^\\(?[+-]?0([\\.,]0+)?\\)?$'
				)
	}


	private boolean isRowEmpty(
			Row row,
			DataFormatter formatter) {

		if (row == null ||
				row.getLastCellNum() <= 0) {

			return true
		}

		for (int columnIndex = 0;
				columnIndex < row.getLastCellNum();
				columnIndex++) {

			Cell cell = row.getCell(columnIndex)

			if (cell == null) {
				continue
			}

			if (!formatter
					.formatCellValue(cell)
					.trim()
					.isEmpty()) {

				return false
			}
		}

		return true
	}


	private void appendColumnContentComparison(
			StringBuilder errors,
			StringBuilder passedDetails,
			String columnName,
			Integer recNumericValues,
			Integer prdNumericValues,
			Integer recUnreadableValues,
			Integer prdUnreadableValues,
			String recNonNumericDigest,
			String prdNonNumericDigest,
			String recNonNumericRawDigest,
			String prdNonNumericRawDigest,
			Map recNonNumericValueCounts,
			Map prdNonNumericValueCounts,
			Map recNonNumericSamples,
			Map prdNonNumericSamples,
			String recColumnStatus,
			String prdColumnStatus) {

		int recNumeric =
				recNumericValues == null
				? 0
				: recNumericValues.intValue()

		int prdNumeric =
				prdNumericValues == null
				? 0
				: prdNumericValues.intValue()

		int recUnreadable =
				recUnreadableValues == null
				? 0
				: recUnreadableValues.intValue()

		int prdUnreadable =
				prdUnreadableValues == null
				? 0
				: prdUnreadableValues.intValue()

		if (recNumeric != prdNumeric) {
			errors.append(
					'[ERROR] Number of numeric values is different.\n'
					)
					.append('Column: ')
					.append(columnName)
					.append('\nREC: ')
					.append(recNumeric)
					.append('\nPRD: ')
					.append(prdNumeric)
					.append('\n')
		} else {
			passedDetails.append(
					'[PASS] Number of numeric values is equal.\n'
					)
					.append('Column: ')
					.append(columnName)
					.append('\nREC: ')
					.append(recNumeric)
					.append('\nPRD: ')
					.append(prdNumeric)
					.append('\n')
		}

		boolean sameNonNumericValues =
				recUnreadable == prdUnreadable &&
				safeText(recNonNumericDigest).equals(
				safeText(prdNonNumericDigest)
				)

		if (!sameNonNumericValues) {
			errors.append(
					'[ERROR] REC and PRD non-numeric values are different after normalization.\n'
					)
					.append('Column: ')
					.append(columnName)
					.append('\nREC non-numeric values: ')
					.append(recUnreadable)
					.append('\nPRD non-numeric values: ')
					.append(prdUnreadable)
					.append('\n')

			appendConfirmedNonNumericDifferences(
					errors,
					recNonNumericValueCounts,
					prdNonNumericValueCounts,
					recNonNumericSamples,
					prdNonNumericSamples
					)

			return
		}

		if (recUnreadable > 0) {
			boolean formattingIsDifferent =
					!safeText(recNonNumericRawDigest).equals(
					safeText(prdNonNumericRawDigest)
					)

			if (formattingIsDifferent) {
				passedDetails.append(
						'[WARNING] REC and PRD non-numeric values are equal after normalization but use different formatting.\n'
						)
			} else if (recNumeric == 0 &&
					prdNumeric == 0) {

				passedDetails.append(
						'[WARNING] No numeric values were found. REC and PRD contain the same non-numeric values.\n'
						)
			} else {
				passedDetails.append(
						'[PASS] REC and PRD contain the same non-numeric values.\n'
						)
			}

			passedDetails
					.append('Column: ')
					.append(columnName)
					.append('\nREC non-numeric values: ')
					.append(recUnreadable)
					.append('\nPRD non-numeric values: ')
					.append(prdUnreadable)
					.append('\n')

			return
		}

		if (recNumeric == 0 &&
				prdNumeric == 0) {

			passedDetails.append(
					'[WARNING] No numeric values were found in REC or PRD.\n'
					)
					.append('Column: ')
					.append(columnName)
					.append('\nREC status: ')
					.append(safeText(recColumnStatus))
					.append('\nPRD status: ')
					.append(safeText(prdColumnStatus))
					.append('\n')
		}
	}


	private void appendConfirmedNonNumericDifferences(
			StringBuilder errors,
			Map recValueCounts,
			Map prdValueCounts,
			Map recSamples,
			Map prdSamples) {

		Map recCounts =
				recValueCounts == null
				? [:]
				: recValueCounts

		Map prdCounts =
				prdValueCounts == null
				? [:]
				: prdValueCounts

		Set<String> allValues = new TreeSet<String>()

		for (Object value : recCounts.keySet()) {
			allValues.add(safeText(value))
		}

		for (Object value : prdCounts.keySet()) {
			allValues.add(safeText(value))
		}

		int displayedDifferences = 0

		for (String normalizedValue : allValues) {
			int recOccurrences =
					readValueCount(
					recCounts,
					normalizedValue
					)

			int prdOccurrences =
					readValueCount(
					prdCounts,
					normalizedValue
					)

			if (recOccurrences == prdOccurrences) {
				continue
			}

			displayedDifferences++

			errors.append('Difference ')
					.append(displayedDifferences)
					.append(':\nNormalized value: "')
					.append(normalizedValue)
					.append('"\nREC occurrences: ')
					.append(recOccurrences)
					.append('\nPRD occurrences: ')
					.append(prdOccurrences)

			String recExample =
					safeText(
					recSamples == null
					? null
					: recSamples.get(normalizedValue)
					)

			String prdExample =
					safeText(
					prdSamples == null
					? null
					: prdSamples.get(normalizedValue)
					)

			if (!recExample.isEmpty()) {
				errors.append('\nREC example: "')
						.append(recExample)
						.append('"')
			}

			if (!prdExample.isEmpty()) {
				errors.append('\nPRD example: "')
						.append(prdExample)
						.append('"')
			}

			errors.append('\n')

			if (displayedDifferences >= 3) {
				break
			}
		}

		if (displayedDifferences == 0) {
			errors.append(
					'No concrete normalized value difference could be listed.\n'
					)
		}
	}


	private int readValueCount(
			Map valueCounts,
			String value) {

		if (valueCounts == null ||
				!valueCounts.containsKey(value)) {

			return 0
		}

		Object count = valueCounts.get(value)

		return count instanceof Number
				? ((Number) count).intValue()
				: 0
	}


	private void incrementValueCount(
			Map<String, Integer> valueCounts,
			String value) {

		String key = safeText(value)

		Integer currentCount =
				valueCounts.containsKey(key)
				? valueCounts.get(key)
				: 0

		valueCounts.put(
				key,
				currentCount + 1
				)
	}


	private String digestValueCounts(
			Map<String, Integer> valueCounts) {

		if (valueCounts == null ||
				valueCounts.isEmpty()) {

			return ''
		}

		MessageDigest digest =
				MessageDigest.getInstance('SHA-256')

		List<String> sortedValues =
				new ArrayList<String>(
				valueCounts.keySet()
				)

		Collections.sort(sortedValues)

		for (String value : sortedValues) {
			String entry =
					value +
					'|' +
					valueCounts.get(value) +
					'\n'

			digest.update(
					entry.getBytes('UTF-8')
					)
		}

		return toHex(digest.digest())
	}


	private String normalizeNonNumericValue(
			String value) {

		String text = safeText(value)

		if (text.isEmpty()) {
			return ''
		}

		text = text
				.replace('\u00A0', ' ')
				.replace('\u202F', ' ')
				.replace('\u2212', '-')
				.replace('\u2012', '-')
				.replace('\u2013', '-')
				.replace('\u2014', '-')
				.replace('\u2015', '-')
				.trim()

		BigDecimal numericValue = parseNumber(text)

		if (numericValue != null) {
			return 'number:' +
					numericValue
					.stripTrailingZeros()
					.toPlainString()
		}

		text = Normalizer.normalize(
				text,
				Normalizer.Form.NFD
				)

		text = text.replaceAll(
				'\\p{InCombiningDiacriticalMarks}+',
				''
				)

		return text
				.toLowerCase()
				.replaceAll('\\s+', ' ')
				.trim()
	}


	private String toHex(byte[] bytes) {

		if (bytes == null ||
				bytes.length == 0) {

			return ''
		}

		StringBuilder result = new StringBuilder()

		for (byte currentByte : bytes) {
			result.append(
					String.format(
					'%02x',
					currentByte & 0xff
					)
					)
		}

		return result.toString()
	}


