@Keyword
void focusLoginWindow() {
	String expectedTitle = normalizeTitle(safe(detectedWindowTitle) ?: resolveWindowTitle())

	KeywordUtil.logInfo("Focusing login window ${expectedTitle}")

	Windows.switchToDesktop()

	WindowsTestObject targetWindow = new WindowsTestObject('eMatchMainWindow')
	targetWindow.setLocatorStrategy(LocatorStrategy.NAME)
	targetWindow.setLocator(expectedTitle)

	Windows.switchToWindow(targetWindow)
	sleepMs(1000)
}

@Keyword
boolean waitLoginControlsReady(int timeoutSeconds) {
	long end = System.currentTimeMillis() + (timeoutSeconds * 1000L)

	while (System.currentTimeMillis() < end) {
		try {
			focusLoginWindow()
		} catch (Throwable ignored) {
		}

		WindowsTestObject combo = envComboObj()
		if (waitPresent(combo, 1)) {
			KeywordUtil.logInfo("Environment combo detected")
			return true
		}

		WindowsTestObject btn = connectBtnObj()
		if (waitPresent(btn, 1)) {
			KeywordUtil.logInfo("Connect button detected")
			return true
		}

		sleepMs(500)
	}

	return false
}

@Keyword
void openEnvironmentDropdown() {
	KeywordUtil.logInfo("Opening environment dropdown")

	if (!waitLoginControlsReady(20)) {
		KeywordUtil.markFailedAndStop("Environment combo was not found")
	}

	WindowsTestObject combo = envComboObj()

	Windows.click(combo)
	sleepMs(1200)
}

@Keyword
void selectEnvironment(String env) {
	String normalized = normalizeEnvCode(env)
	int targetIndex = resolveEnvironmentIndex(normalized)

	KeywordUtil.logInfo("Selecting environment ${normalized} with legacy logic and index ${targetIndex}")

	if (!waitLoginControlsReady(20)) {
		KeywordUtil.markFailedAndStop("Environment combo was not found")
	}

	WindowsTestObject combo = envComboObj()

	Windows.click(combo)
	sleepMs(1000)

	for (int i = 0; i < targetIndex; i++) {
		Windows.sendKeys(combo, Keys.chord(Keys.ARROW_DOWN))
		sleepMs(300)
	}

	Windows.sendKeys(combo, Keys.chord(Keys.ENTER))
	sleepMs(7000)
}

@Keyword
void loginThroughNativeControls() {
	loginThroughNativeControls(safe(GlobalVariable.env) ?: 'REC')
}

@Keyword
void loginThroughNativeControls(String env) {
	String resolvedEnv = safe(env) ?: safe(GlobalVariable.env) ?: 'REC'

	KeywordUtil.logInfo("Logging through native controls for env ${resolvedEnv}")

	focusLoginWindow()
	selectEnvironment(resolvedEnv)

	focusLoginWindow()

	boolean isButtonPresent = isConnectButtonPresent()

	if (isButtonPresent) {
		KeywordUtil.logInfo("Connect button was present and will be clicked.")
		clickConnectButton()
	} else {
		KeywordUtil.logInfo("Connect button was not present. Continuing test execution.")
	}

	boolean mainScreenLoaded = waitForMainScreen()

	if (!mainScreenLoaded) {
		KeywordUtil.markFailedAndStop(
			"eMatch main screen was not loaded. Object 'General/txtSearch' not found."
		)
	}

	activateHomeTab()
	KeywordUtil.logInfo("eMatch startup flow completed successfully for environment ${resolvedEnv}")
}


private WindowsTestObject envComboObj() {
	WindowsTestObject repoObj = firstExistingObject([
		'Login Page/optEnv',
		'Connection/cmbEnvironment',
		'General/cmbEnvironment',
		'Login/cmbEnvironment'
	])
	if (repoObj != null) {
		return repoObj
	}

	return winObj(
		'envCombo',
		"(//*[@LocalizedControlType='combo box' or contains(@ClassName,'ComboBox')])[1]"
	)
}


