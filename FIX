class JiraReportBuilder {

    JiraFlowCoordinator owner
    JiraHtmlTemplateBuilder templateBuilder

    JiraReportBuilder(JiraFlowCoordinator owner) {
        this.owner = owner
        this.templateBuilder = new JiraHtmlTemplateBuilder()
    }

    String createHtmlReport(String reportFolder, String suiteName, String executionSummary) {
        if (owner.isBlank(reportFolder)) {
            return ''
        }

        File reportDir = new File(reportFolder)
        if (!reportDir.exists() || !reportDir.isDirectory()) {
            return ''
        }

        List<Map> scenarios = parseExecutionLog(reportDir)
        List<Map> evidences = extractEvidenceFromNativeHtml(reportDir)

        attachEvidenceToFailedScenarios(scenarios, evidences)

        Map model = [
            appName         : owner.PROJECT_KEY,
            suiteName       : suiteName,
            executionSummary: executionSummary,
            subtitle        : owner.REPORT_SUBTITLE,
            reportFolder    : reportDir.absolutePath,
            headerBackground: owner.REPORT_HEADER_BACKGROUND,
            accentColor     : owner.REPORT_ACCENT_COLOR,
            accentSoftColor : owner.REPORT_ACCENT_SOFT_COLOR,
            infoColor       : owner.REPORT_INFO_COLOR,
            scenarios       : scenarios,
            generatedAt     : new SimpleDateFormat('dd.MM.yyyy HH:mm:ss').format(new Date())
        ]

        String html = templateBuilder.build(model)

        File output = new File(reportDir, owner.REPORT_FILE_NAME)
        output.setText(html, 'UTF-8')

        return output.absolutePath
    }

    String createRuntimeJUnitXmlFromKatalonLog(String reportFolder, String suiteName) {
        if (owner.isBlank(reportFolder)) {
            return ''
        }

        File reportDir = new File(reportFolder)
        if (!reportDir.exists() || !reportDir.isDirectory()) {
            return ''
        }

        List<Map> scenarios = parseExecutionLog(reportDir)
        if (scenarios.isEmpty()) {
            return ''
        }

        int tests = scenarios.size()
        int failures = scenarios.count { Map item -> owner.safe(item.status) == 'failed' }
        int skipped = scenarios.count { Map item -> owner.safe(item.status) == 'skipped' }
        BigDecimal totalSeconds = BigDecimal.ZERO

        StringBuilder xml = new StringBuilder()
        xml.append('<?xml version="1.0" encoding="UTF-8"?>\n')
        xml.append('<testsuite')
        xml.append(' name="').append(escapeXml(owner.safe(suiteName))).append('"')
        xml.append(' tests="').append(tests).append('"')
        xml.append(' failures="').append(failures).append('"')
        xml.append(' skipped="').append(skipped).append('"')
        xml.append(' errors="0"')

        scenarios.each { Map scenario ->
            totalSeconds = totalSeconds.add(toSecondsBigDecimal(scenario.durationMs))
        }

        xml.append(' time="').append(formatSeconds(totalSeconds)).append('">\n')

        scenarios.each { Map scenario ->
            BigDecimal scenarioSeconds = toSecondsBigDecimal(scenario.durationMs)
            String caseName = owner.safe(scenario.name)
            String className = owner.safe(suiteName)
            String status = owner.safe(scenario.status)
            String fullError = owner.safe(scenario.fullError)
            String visualError = owner.safe(scenario.visualError)

            xml.append('  <testcase')
            xml.append(' classname="').append(escapeXml(className)).append('"')
            xml.append(' name="').append(escapeXml(caseName)).append('"')
            xml.append(' time="').append(formatSeconds(scenarioSeconds)).append('">')

            if (status == 'failed') {
                xml.append('\n')
                xml.append('    <failure message="').append(escapeXml(visualError)).append('">')
                xml.append(escapeXml(fullError))
                xml.append('</failure>\n')
                xml.append('  </testcase>\n')
            } else if (status == 'skipped') {
                xml.append('\n')
                xml.append('    <skipped/>\n')
                xml.append('  </testcase>\n')
            } else {
                xml.append('</testcase>\n')
            }
        }

        xml.append('</testsuite>\n')

        File output = new File(reportDir, owner.RUNTIME_XML_FILE_NAME)
        output.setText(xml.toString(), 'UTF-8')
        return output.absolutePath
    }

    // ============================================================
    // EXECUTION LOG PARSING
    // ============================================================
    private List<Map> parseExecutionLog(File reportDir) {
        File logFile = findExecutionLog(reportDir)
        if (logFile == null || !logFile.exists()) {
            return []
        }

        List<String> lines = readLines(logFile)
        if (lines.isEmpty()) {
            return []
        }

        List<Map> scenarios = []
        Map current = null

        lines.each { String raw ->
            String line = sanitizeLine(raw)
            if (owner.isBlank(line)) {
                return
            }

            String timestamp = extractTimestamp(line)
            String message = stripTimestampPrefix(line)

            if (message.startsWith('START Test Cases/')) {
                if (current != null) {
                    finalizeScenario(current)
                    scenarios << current
                }

                current = newScenario(message.replaceFirst(/^START\s+/, ''))
                if (!owner.isBlank(timestamp)) {
                    current.startLong = timestamp
                    current.startShort = extractClock(timestamp)
                }
                return
            }

            if (message.startsWith('END Test Cases/')) {
                String endName = owner.safe(message.replaceFirst(/^END\s+/, ''))
                if (current == null) {
                    current = newScenario(endName)
                }

                if (!owner.safe(current.status).equals('failed')) {
                    current.status = 'passed'
                }

                if (!owner.isBlank(timestamp)) {
                    current.endLong = timestamp
                    current.endShort = extractClock(timestamp)
                }

                finalizeScenario(current)
                scenarios << current
                current = null
                return
            }

            Matcher failedCaseMatcher = (message =~ /(Test Cases\/.+?) FAILED\./)
            if (failedCaseMatcher.find()) {
                String failedName = owner.safe(failedCaseMatcher.group(1))
                if (current == null) {
                    current = newScenario(failedName)
                }
                current.status = 'failed'
                return
            }

            if (current == null) {
                return
            }

            Map step = parseStep(message, timestamp)
            if (step != null) {
                current.steps << step
                long currentDuration = toLong(current.durationMs)
                long stepDuration = toLong(step.durationMs)
                current.durationMs = currentDuration + stepDuration

                if (owner.safe(step.status) == 'failed') {
                    current.status = 'failed'
                    if (owner.isBlank(current.visualError)) {
                        current.visualError = owner.safe(step.detail)
                    }
                    current.fullError = appendLine(owner.safe(current.fullError), owner.safe(step.detail))
                }
                return
            }

            if (looksLikeError(message)) {
                current.status = 'failed'
                if (owner.isBlank(current.visualError)) {
                    current.visualError = shorten(message, 180)
                }
                current.fullError = appendLine(owner.safe(current.fullError), message)
                return
            }

            if (message.startsWith('Reason:')) {
                current.status = 'failed'
                String reason = owner.safe(message.replaceFirst(/^Reason:\s*/, ''))
                if (owner.isBlank(current.visualError)) {
                    current.visualError = shorten(reason, 180)
                }
                current.fullError = appendLine(owner.safe(current.fullError), reason)
                return
            }

            if (message.startsWith('Caused by:')) {
                current.status = 'failed'
                String reason = owner.safe(message)
                if (owner.isBlank(current.visualError)) {
                    current.visualError = shorten(reason, 180)
                }
                current.fullError = appendLine(owner.safe(current.fullError), reason)
                return
            }
        }

        if (current != null) {
            finalizeScenario(current)
            scenarios << current
        }

        return scenarios
    }

    private Map newScenario(String name) {
        return [
            id           : 'scenario-' + UUID.randomUUID().toString(),
            name         : owner.safe(name),
            status       : 'info',
            startShort   : '',
            endShort     : '',
            startLong    : '',
            endLong      : '',
            durationMs   : 0L,
            durationLabel: '00h 00m 00s',
            visualError  : '',
            fullError    : '',
            steps        : [],
            evidence     : []
        ]
    }

    private void finalizeScenario(Map scenario) {
        if (owner.isBlank(scenario.status) || owner.safe(scenario.status) == 'info') {
            boolean hasFailedStep = (scenario.steps ?: []).any { Map item -> owner.safe(item.status) == 'failed' }
            boolean hasSkippedStep = (scenario.steps ?: []).any { Map item -> owner.safe(item.status) == 'skipped' }

            if (hasFailedStep) {
                scenario.status = 'failed'
            } else if (hasSkippedStep) {
                scenario.status = 'skipped'
            } else {
                scenario.status = 'passed'
            }
        }

        scenario.durationLabel = formatDuration(toLong(scenario.durationMs))

        if (owner.isBlank(scenario.visualError) && !owner.isBlank(scenario.fullError)) {
            scenario.visualError = shorten(firstMeaningfulLine(scenario.fullError), 180)
        }

        if (scenario.steps == null) {
            scenario.steps = []
        }
    }

    private Map parseStep(String message, String timestamp) {
        Matcher compactStep = (message =~ /^\d+\s*-\s*(.+?)\s*\(([\d.,]+s)\)$/)
        if (compactStep.find()) {
            String detail = owner.safe(compactStep.group(1))
            long durationMs = secondsTextToMillis(compactStep.group(2))
            String status = inferStepStatus(detail)

            return [
                status   : status,
                timestamp: extractClock(timestamp),
                detail   : detail,
                icon     : resolveStepIcon(detail, status),
                durationMs: durationMs
            ]
        }

        Matcher verboseStep = (message =~ /^TEST STEP:\s*(.+)$/)
        if (verboseStep.find()) {
            String detail = owner.safe(verboseStep.group(1))
            String status = inferStepStatus(detail)

            return [
                status   : status,
                timestamp: extractClock(timestamp),
                detail   : detail,
                icon     : resolveStepIcon(detail, status),
                durationMs: 0L
            ]
        }

        Matcher statusLine = (message =~ /^(\d{2}:\d{2}:\d{2}(?:\.\d{3})?)\s+(PASSED|FAILED|ERROR|INFO|SKIPPED)\s+(.*)$/)
        if (statusLine.find()) {
            String status = normalizeStatus(statusLine.group(2))
            String detail = owner.safe(statusLine.group(3))

            return [
                status   : status,
                timestamp: extractClock(statusLine.group(1)),
                detail   : detail,
                icon     : resolveStepIcon(detail, status),
                durationMs: 0L
            ]
        }

        return null
    }

    private String inferStepStatus(String detail) {
        String lower = owner.safe(detail).toLowerCase(Locale.ENGLISH)

        if (lower.contains('failed')) return 'failed'
        if (lower.contains('error')) return 'failed'
        if (lower.contains('skipped')) return 'skipped'
        if (lower.contains('stop_on_failure')) return 'failed'

        return 'info'
    }

    private boolean looksLikeError(String text) {
        String lower = owner.safe(text).toLowerCase(Locale.ENGLISH)
        return lower.contains('exception') ||
               lower.contains('root cause') ||
               lower.contains('stepfailedexception') ||
               lower.contains('missingmethodexception') ||
               lower.contains('classnotfoundexception') ||
               lower.startsWith('at ') ||
               lower.contains('caused by:')
    }

    private File findExecutionLog(File reportDir) {
        File[] files = reportDir.listFiles()
        if (files == null) {
            return null
        }

        List<File> candidates = []
        for (File file : files) {
            if (file != null && file.isFile()) {
                String lower = owner.safe(file.name).toLowerCase(Locale.ENGLISH)
                if (lower.startsWith('execution') && lower.endsWith('.log')) {
                    candidates << file
                }
            }
        }

        if (candidates.isEmpty()) {
            return null
        }

        candidates.sort { a, b -> b.lastModified() <=> a.lastModified() }
        return candidates[0]
    }

    private List<String> readLines(File file) {
        try {
            return Files.readAllLines(file.toPath(), StandardCharsets.UTF_8)
        } catch (Exception ignored) {
            try {
                return file.readLines()
            } catch (Exception ignoredAgain) {
                return []
            }
        }
    }

    private String sanitizeLine(String raw) {
        String line = owner.safe(raw)
        if (owner.isBlank(line)) {
            return ''
        }

        line = line.replaceAll(/\u001B\[[;\d]*m/, '')
        line = line.replace('\t', ' ')
        return line.trim()
    }

    private String extractTimestamp(String line) {
        Matcher matcher = (line =~ /^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3})/)
        if (matcher.find()) {
            return owner.safe(matcher.group(1))
        }
        return ''
    }

    private String stripTimestampPrefix(String line) {
        Matcher matcher = (line =~ /^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3}\s+[A-Z]+\s+.+?\s+-\s+(.*)$/)
        if (matcher.find()) {
            return owner.safe(matcher.group(1))
        }
        return owner.safe(line)
    }

    private String extractClock(String raw) {
        String text = owner.safe(raw)
        if (owner.isBlank(text)) {
            return ''
        }

        Matcher matcher = (text =~ /(\d{2}:\d{2}:\d{2})/)
        if (matcher.find()) {
            return owner.safe(matcher.group(1))
        }

        return text
    }

    // ============================================================
    // EVIDENCE FROM NATIVE HTML
    // ============================================================
    private List<Map> extractEvidenceFromNativeHtml(File reportDir) {
        File nativeHtml = findNativeKatalonHtml(reportDir)
        if (nativeHtml == null || !nativeHtml.exists()) {
            return []
        }

        String html = readWholeFile(nativeHtml)
        if (owner.isBlank(html)) {
            return []
        }

        List<Map> result = []
        Set<String> seen = new LinkedHashSet<String>()

        Pattern dataUriPattern = Pattern.compile(/data:image\/(?:png|jpeg|jpg|webp|gif|bmp);base64,[A-Za-z0-9+\/=]+/)
        Matcher dataMatcher = dataUriPattern.matcher(html)

        int index = 1
        while (dataMatcher.find()) {
            String dataUri = owner.safe(dataMatcher.group())
            if (owner.isBlank(dataUri) || seen.contains(dataUri)) {
                continue
            }

            seen.add(dataUri)
            result << [
                name  : "Native Screenshot ${index}",
                href  : dataUri,
                image : true,
                imgSrc: dataUri
            ]
            index++
        }

        Pattern imageSrcPattern = Pattern.compile(/<img[^>]+src=["']([^"']+)["']/)
        Matcher imgMatcher = imageSrcPattern.matcher(html)

        while (imgMatcher.find()) {
            String src = owner.safe(imgMatcher.group(1))
            if (owner.isBlank(src) || src.startsWith('data:') || seen.contains(src)) {
                continue
            }

            File resolved = resolveRelativeFile(reportDir, src)
            if (resolved != null && resolved.exists() && isImageFile(resolved.name)) {
                String href = owner.relativeUri(reportDir, resolved)
                seen.add(src)
                result << [
                    name  : resolved.name,
                    href  : href,
                    image : true,
                    imgSrc: href
                ]
            }
        }

        return result
    }

    private void attachEvidenceToFailedScenarios(List<Map> scenarios, List<Map> evidenceList) {
        if (scenarios == null || scenarios.isEmpty()) {
            return
        }

        scenarios.each { Map scenario ->
            scenario.evidence = []
        }

        if (evidenceList == null || evidenceList.isEmpty()) {
            return
        }

        List<Map> failedScenarios = scenarios.findAll { Map item ->
            owner.safe(item.status) == 'failed'
        }

        for (int i = 0; i < failedScenarios.size(); i++) {
            if (i >= evidenceList.size()) {
                break
            }
            failedScenarios[i].evidence = [evidenceList[i]]
        }
    }

    private File findNativeKatalonHtml(File reportDir) {
        File[] files = reportDir.listFiles()
        if (files == null) {
            return null
        }

        List<File> htmlFiles = []
        for (File file : files) {
            if (file == null || !file.isFile()) {
                continue
            }

            String lower = owner.safe(file.name).toLowerCase(Locale.ENGLISH)
            if (!lower.endsWith('.html')) {
                continue
            }

            if (lower == owner.safe(owner.REPORT_FILE_NAME).toLowerCase(Locale.ENGLISH)) {
                continue
            }

            htmlFiles << file
        }

        if (htmlFiles.isEmpty()) {
            return null
        }

        File preferred = htmlFiles.find { File file ->
            owner.safe(file.name).equalsIgnoreCase('eMatchReport.html')
        }

        if (preferred != null) {
            return preferred
        }

        htmlFiles.sort { a, b -> b.lastModified() <=> a.lastModified() }
        return htmlFiles[0]
    }

    private String readWholeFile(File file) {
        try {
            return new String(Files.readAllBytes(file.toPath()), StandardCharsets.UTF_8)
        } catch (Exception ignored) {
            try {
                return file.getText('UTF-8')
            } catch (Exception ignoredAgain) {
                return ''
            }
        }
    }

    private File resolveRelativeFile(File baseDir, String rawPath) {
        String path = owner.safe(rawPath)
        if (owner.isBlank(path)) {
            return null
        }

        try {
            if (path.toLowerCase(Locale.ENGLISH).startsWith('file:/')) {
                File file = new File(new URI(path))
                if (file.exists()) {
                    return file
                }
            }
        } catch (Exception ignored) {
        }

        File direct = new File(path)
        if (direct.exists()) {
            return direct
        }

        File relative = new File(baseDir, path)
        if (relative.exists()) {
            return relative
        }

        return direct
    }

    private boolean isImageFile(String name) {
        String lower = owner.safe(name).toLowerCase(Locale.ENGLISH)
        return lower.endsWith('.png') ||
               lower.endsWith('.jpg') ||
               lower.endsWith('.jpeg') ||
               lower.endsWith('.webp') ||
               lower.endsWith('.gif') ||
               lower.endsWith('.bmp')
    }

    // ============================================================
    // GENERIC HELPERS
    // ============================================================
    private String resolveStepIcon(String detail, String status) {
        String lower = owner.safe(detail).toLowerCase(Locale.ENGLISH)

        if (status == 'failed') return '❌'
        if (status == 'skipped') return '⏭️'
        if (lower.contains('wait')) return '🔎'
        if (lower.contains('click') || lower.contains('select') || lower.contains('fill') || lower.contains('import')) return '🖱️'
        if (lower.contains('open') || lower.contains('navigate')) return '🌐'
        return 'ℹ️'
    }

    private String normalizeStatus(String raw) {
        String text = owner.safe(raw).toLowerCase(Locale.ENGLISH)

        switch (text) {
            case 'pass':
            case 'passed':
            case 'success':
                return 'passed'
            case 'fail':
            case 'failed':
            case 'error':
                return 'failed'
            case 'skip':
            case 'skipped':
                return 'skipped'
            default:
                return 'info'
        }
    }

    private long secondsTextToMillis(String raw) {
        String text = owner.safe(raw).replace(',', '.').replace('s', '')
        if (owner.isBlank(text)) {
            return 0L
        }

        try {
            return Math.round(Double.parseDouble(text) * 1000d)
        } catch (Exception ignored) {
            return 0L
        }
    }

    private long toLong(def value) {
        if (value == null) {
            return 0L
        }

        try {
            return Long.parseLong(value.toString())
        } catch (Exception ignored) {
            return 0L
        }
    }

    private String formatDuration(long durationMs) {
        if (durationMs < 0L) {
            durationMs = 0L
        }

        long totalSeconds = Math.round(durationMs / 1000d)
        long hours = (long) (totalSeconds / 3600L)
        long minutes = (long) ((totalSeconds % 3600L) / 60L)
        long seconds = (long) (totalSeconds % 60L)

        return String.format(Locale.ENGLISH, '%02dh %02dm %02ds', hours, minutes, seconds)
    }

    private String appendLine(String current, String extra) {
        String left = owner.safe(current)
        String right = owner.safe(extra)

        if (owner.isBlank(left)) return right
        if (owner.isBlank(right)) return left
        return left + '\n' + right
    }

    private String shorten(String text, int max) {
        String value = owner.safe(text)
        if (value.length() <= max) {
            return value
        }
        return value.substring(0, Math.max(0, max - 3)) + '...'
    }

    private String firstMeaningfulLine(String text) {
        List<String> lines = owner.safe(text).readLines().collect { owner.safe(it) }.findAll { !owner.isBlank(it) }
        if (lines.isEmpty()) {
            return ''
        }
        return lines[0]
    }

    private String escapeXml(String value) {
        return owner.safe(value)
            .replace('&', '&amp;')
            .replace('<', '&lt;')
            .replace('>', '&gt;')
            .replace('"', '&quot;')
            .replace("'", '&apos;')
    }

    private BigDecimal toSecondsBigDecimal(def durationMs) {
        long millis = toLong(durationMs)
        return new BigDecimal(millis).divide(new BigDecimal(1000), 3, BigDecimal.ROUND_HALF_UP)
    }

    private String formatSeconds(BigDecimal seconds) {
        DecimalFormat df = new DecimalFormat('0.000')
        return df.format(seconds)
    }
}











































