		)

		return object
	}

	private void clickNoUntilOpenFileModalCloses(Integer interval, Integer maxTimes) {
		Integer safeInterval = interval == null || interval <= 0 ? 1 : interval
		Integer safeMaxTimes = maxTimes == null || maxTimes <= 0 ? 5 : Math.min(maxTimes, 5)

		for (int attempt = 1; attempt <= safeMaxTimes; attempt++) {
			KeywordUtil.logInfo(
					'Trying to close open-file modal.\n' +
					'Attempt: ' + attempt + '/' + safeMaxTimes
			)

			boolean modalVisible = isOpenFileModalVisible()

			if (!modalVisible) {
				KeywordUtil.logInfo(
						'Open-file modal was not detected yet. Waiting before next attempt.'
				)

				Windows.delay(safeInterval)
				continue
			}

			KeywordUtil.logInfo(
					'Open-file modal detected. Trying to click Non by Katalon element.'
			)

			if (clickNoButtonUsingKatalonElement()) {
				return
			}

			KeywordUtil.logInfo(
					'Katalon Windows.click did not close the modal. Trying direct Windows driver click.'
			)

			if (clickNoButtonUsingDriverElement()) {
				return
			}

			KeywordUtil.logInfo(
					'Element clicks did not close the modal. Trying TAB + ENTER because modal is confirmed open.'
			)

			if (closeOpenFileModalByKeyboardFallback()) {
				return
			}

			Windows.delay(safeInterval)
		}

		imageLoader.takeEvidence('OpenFileModalNonButtonNotClicked.png')

		KeywordUtil.markFailedAndStop(
				'Could not close open-file modal.\n' +
				'Expected modal: Export de données\n' +
				'Expected question: Voulez-vous ouvrir le fichier ?\n' +
				'Expected button: Non\n' +
				'Timeout attempts: ' + safeMaxTimes
		)
	}

	private boolean isOpenFileModalVisible() {
		List<WindowsTestObject> modalCandidates = []

		try {
			modalCandidates.add(WindowsObjectLoader.getObject('export', 'openFileModalWindow'))
		} catch (Exception ignored) {
		}

		try {
			modalCandidates.add(WindowsObjectLoader.getObject('export', 'openFileModalTitleBar'))
		} catch (Exception ignored) {
		}

		try {
			modalCandidates.add(WindowsObjectLoader.getObject('export', 'openFileModalQuestion'))
		} catch (Exception ignored) {
		}

		modalCandidates.add(buildXpathObject('''//*[@Name='Export de données']'''))
		modalCandidates.add(buildXpathObject('''//*[contains(@Name,'Export de données')]'''))
		modalCandidates.add(buildXpathObject('''//*[contains(@Name,'Voulez-vous ouvrir le fichier')]'''))
		modalCandidates.add(buildXpathObject('''//*[contains(@Name,'ouvrir le fichier')]'''))

		for (WindowsTestObject modalCandidate : modalCandidates) {
			try {
				if (Windows.verifyElementPresent(
						modalCandidate,
						1,
						FailureHandling.OPTIONAL
				)) {
					KeywordUtil.logInfo('Open-file modal detected by Katalon Windows object.')
					return true
				}
			} catch (Exception ignored) {
			}
		}

		if (driverElementExistsByXpath('''//*[@Name='Export de données']''')) {
			KeywordUtil.logInfo('Open-file modal detected by direct driver XPath: Export de données.')
			return true
		}

		if (driverElementExistsByXpath('''//*[contains(@Name,'Export de données')]''')) {
			KeywordUtil.logInfo('Open-file modal detected by direct driver XPath: contains Export de données.')
			return true
		}

		if (driverElementExistsByXpath('''//*[contains(@Name,'Voulez-vous ouvrir le fichier')]''')) {
			KeywordUtil.logInfo('Open-file modal detected by direct driver XPath: question text.')
			return true
		}

		if (driverElementExistsByXpath('''//*[contains(@Name,'ouvrir le fichier')]''')) {
			KeywordUtil.logInfo('Open-file modal detected by direct driver XPath: partial question text.')
			return true
		}

		return false
	}

	private boolean clickNoButtonUsingKatalonElement() {
		List<WindowsTestObject> noButtonCandidates = []

		try {
			noButtonCandidates.add(WindowsObjectLoader.getObject('export', 'openFileNoInsideModal'))
		} catch (Exception ignored) {
		}

		try {
			noButtonCandidates.add(WindowsObjectLoader.getObject('export', 'openFileNoButton'))
		} catch (Exception ignored) {
		}

		try {
			noButtonCandidates.add(WindowsObjectLoader.getObject('export', 'openFileNoButtonByName'))
		} catch (Exception ignored) {
		}

		noButtonCandidates.add(buildNameObject('Non'))
		noButtonCandidates.add(buildXpathObject('''//*[@Name='Export de données']//*[@Name='Non']'''))
		noButtonCandidates.add(buildXpathObject('''//*[contains(@Name,'Export de données')]//*[@Name='Non']'''))
		noButtonCandidates.add(buildXpathObject('''//*[@Name='Non' and @LocalizedControlType='button']'''))
		noButtonCandidates.add(buildXpathObject('''//*[@Name='Non' and contains(@ControlType,'Button')]'''))
		noButtonCandidates.add(buildXpathObject('''//*[@Name='Non']'''))

		for (WindowsTestObject noButton : noButtonCandidates) {
			try {
				if (Windows.verifyElementPresent(
						noButton,
						1,
						FailureHandling.OPTIONAL
				)) {
					KeywordUtil.logInfo(
							'Non button found by Katalon object. Clicking with Windows.click.'
					)

					Windows.click(noButton)
					Windows.delay(1)

					if (!isOpenFileModalVisible()) {
						KeywordUtil.logInfo(
								'Open-file modal closed successfully by Katalon Windows.click.'
						)

						return true
					}

					KeywordUtil.logInfo(
							'Windows.click was executed, but the modal is still visible.'
					)
				}
			} catch (Exception e) {
				KeywordUtil.logInfo(
						'Katalon Non button candidate failed.\n' +
						'Reason: ' + e.getMessage()
				)
			}
		}

		return false
	}

	private boolean clickNoButtonUsingDriverElement() {
		List<String> xpathCandidates = [
			'''//*[@Name='Export de données']//*[@Name='Non' and (@LocalizedControlType='button' or contains(@ControlType,'Button'))]''',
			'''//*[contains(@Name,'Export de données')]//*[@Name='Non' and (@LocalizedControlType='button' or contains(@ControlType,'Button'))]''',
			'''//*[@Name='Non' and (@LocalizedControlType='button' or contains(@ControlType,'Button'))]''',
			'''//*[@Name='Non']'''
		]

		for (String xpath : xpathCandidates) {
			try {
				def driver = WindowsDriverFactory.getWindowsSession()
				WebElement element = driver.findElement(By.xpath(xpath))

				if (element != null) {
					KeywordUtil.logInfo(
							'Non button found by direct Windows driver XPath. Clicking element.\n' +
							'XPath: ' + xpath
					)

					element.click()
					Windows.delay(1)

					if (!isOpenFileModalVisible()) {
						KeywordUtil.logInfo(
								'Open-file modal closed successfully by direct Windows driver click.'
						)

						return true
					}

					KeywordUtil.logInfo(
							'Direct driver click was executed, but the modal is still visible.'
					)
				}
			} catch (Exception e) {
				KeywordUtil.logInfo(
						'Direct driver XPath click failed.\n' +
						'XPath: ' + xpath + '\n' +
						'Reason: ' + e.getMessage()
				)
			}
		}

		try {
			def driver = WindowsDriverFactory.getWindowsSession()
			WebElement element = driver.findElement(By.name('Non'))

			if (element != null) {
				KeywordUtil.logInfo(
						'Non button found by direct Windows driver Name. Clicking element.'
				)

				element.click()
				Windows.delay(1)

				if (!isOpenFileModalVisible()) {
					KeywordUtil.logInfo(
							'Open-file modal closed successfully by direct Windows driver Name click.'
					)

					return true
				}

				KeywordUtil.logInfo(
						'Direct driver Name click was executed, but the modal is still visible.'
				)
			}
		} catch (Exception e) {
			KeywordUtil.logInfo(
					'Direct driver Name click failed for Non.\n' +
					'Reason: ' + e.getMessage()
			)
		}

		return false
	}

	private boolean closeOpenFileModalByKeyboardFallback() {
		if (!isOpenFileModalVisible()) {
			KeywordUtil.logInfo(
					'Keyboard fallback skipped because open-file modal is not visible.'
			)

			return false
		}

		try {
			KeywordUtil.logInfo(
					'Keyboard fallback: pressing TAB then ENTER to select Non.'
			)

			Robot robot = new Robot()
			robot.setAutoDelay(120)

			robot.keyPress(KeyEvent.VK_TAB)
			robot.keyRelease(KeyEvent.VK_TAB)

			Windows.delay(1)

			robot.keyPress(KeyEvent.VK_ENTER)
			robot.keyRelease(KeyEvent.VK_ENTER)

			Windows.delay(1)

			if (!isOpenFileModalVisible()) {
				KeywordUtil.logInfo(
						'Open-file modal closed successfully by TAB + ENTER fallback.'
				)

				return true
			}

			KeywordUtil.logInfo(
					'TAB + ENTER fallback did not close the modal.'
			)
		} catch (Exception e) {
			KeywordUtil.logInfo(
					'Keyboard fallback failed.\n' +
					'Reason: ' + e.getMessage()
			)
		}

		return false
	}

	private boolean driverElementExistsByXpath(String xpath) {
		try {
			def driver = WindowsDriverFactory.getWindowsSession()
			WebElement element = driver.findElement(By.xpath(xpath))

			return element != null
		} catch (Exception ignored) {
		}

		return false
	}

	private WindowsTestObject buildNameObject(String name) {
		WindowsTestObject object = new WindowsTestObject('dynamicName_' + sanitizeObjectName(name))
		object.setLocatorStrategy(LocatorStrategy.NAME)
		object.setLocator(name)

		return object
	}

	private WindowsTestObject buildXpathObject(String xpath) {
		WindowsTestObject object = new WindowsTestObject('dynamic_' + sanitizeObjectName(xpath))
		object.setLocatorStrategy(LocatorStrategy.XPATH)
		object.setLocator(xpath)

		return object
	}

	private String sanitizeObjectName(String text) {
		if (text == null) {
			return 'empty'
		}

		return text.replaceAll('[^a-zA-Z0-9]', '_')
	}

	private void focusFileNameFieldWithShortcut() {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_ALT)
		robot.keyPress(KeyEvent.VK_N)
		robot.keyRelease(KeyEvent.VK_N)
		robot.keyRelease(KeyEvent.VK_ALT)
	}

	private void clearFocusedField() {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_CONTROL)

		Windows.delay(1)

		robot.keyPress(KeyEvent.VK_BACK_SPACE)
		robot.keyRelease(KeyEvent.VK_BACK_SPACE)
	}

	private void pasteAndEnter(String text) {
		pasteText(text)

		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_ENTER)
		robot.keyRelease(KeyEvent.VK_ENTER)
	}

	private void pasteText(String text) {
		StringSelection selection = new StringSelection(text)
		Toolkit.getDefaultToolkit().getSystemClipboard().setContents(selection, null)

		Windows.delay(1)

		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_V)
		robot.keyRelease(KeyEvent.VK_V)
		robot.keyRelease(KeyEvent.VK_CONTROL)
	}
