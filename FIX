package utils

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.util.KeywordUtil

import jiraIntegration.JiraImagesEvidence

class Steps {

	public static final String MARK = '[STEP]'

	@Keyword
	def note(String msg) {
		String detail = safe(msg)
		if (detail.isEmpty()) {
			return
		}

		// visible in Katalon log
		KeywordUtil.logInfo("${MARK} ${detail}")

		// controlled trace used by the custom HTML report
		try {
			new JiraImagesEvidence().note(detail)
		} catch (Throwable ignored) {
		}
	}

	@Keyword
	def snap(String message) {
		String detail = safe(message)
		if (detail.isEmpty()) {
			return
		}

		// register step text
		note(detail)

		// capture evidence linked to the current test case
		try {
			new JiraImagesEvidence().captureNow(sanitizeLabel(detail))
		} catch (Throwable ignored) {
		}
	}

	@Keyword
	def noteAndSnap(String message) {
		snap(message)
	}

	private String sanitizeLabel(String value) {
		String text = safe(value)
			.replace('\\', '_')
			.replace('/', '_')
			.replaceAll('[^A-Za-z0-9._-]+', '_')
			.replaceAll('_+', '_')
			.replaceAll('^_+', '')
			.replaceAll('_+$', '')

		return text.isEmpty() ? 'step' : text
	}

	private String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}
}






