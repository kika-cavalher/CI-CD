            html.append('</div>')

            if (!fullDetail.isEmpty() && fullDetail != shortDetail) {
                html.append('<details class="more-block">')
                html.append('<summary>🔎 View full detail</summary>')
                html.append('<pre>')
                html.append(htmlEscape(fullDetail))
                html.append('</pre>')
                html.append('</details>')
            }

            html.append('</td>')
            html.append('</tr>')
        }

        html.append('</tbody>')
        html.append('</table>')

        return html.toString()
    }

    private String renderEvidenceSection(Map scenario) {
        String imagePath = safeValue(scenario.imagePath)
        String imageName = safeValue(scenario.imageName)

        if (imagePath.isEmpty()) {
            return ''
        }

        StringBuilder html = new StringBuilder()
        html.append('<details class="evidence-block">')
        html.append('<summary>📎 Evidence</summary>')
        html.append('<div class="evidence-grid">')
        html.append('<a class="evidence-card" href="')
        html.append(htmlEscape(imagePath))
        html.append('" target="_blank">')
        html.append('<img src="')
        html.append(htmlEscape(imagePath))
