package commands

import java.io.File
import java.io.FileInputStream
import java.math.RoundingMode
import java.text.Normalizer

import org.apache.poi.ss.usermodel.Cell
import org.apache.poi.ss.usermodel.CellType
import org.apache.poi.ss.usermodel.CellValue
import org.apache.poi.ss.usermodel.DataFormatter
import org.apache.poi.ss.usermodel.FormulaEvaluator
import org.apache.poi.ss.usermodel.Row
import org.apache.poi.ss.usermodel.Sheet
import org.apache.poi.ss.usermodel.Workbook
import org.apache.poi.ss.usermodel.WorkbookFactory

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.util.KeywordUtil


class RecPrdExportValidationKeywords {

	@Keyword
	Map validateLatestRecPrdExport(
			String exportRootFolder,
			String exportGroupFolder,
			String exportFeatureFolder,
			Integer columnIndex,
			String expectedColumnName) {

		Map result = createEmptyResult(
				exportRootFolder,
				exportGroupFolder,
				exportFeatureFolder,
				columnIndex,
				expectedColumnName
		)

		StringBuilder errors = new StringBuilder()
		StringBuilder passedDetails = new StringBuilder()

		FileInputStream recInput = null
		FileInputStream prdInput = null
		Workbook recWorkbook = null
		Workbook prdWorkbook = null

		try {
			File exportRoot = new File(safeText(exportRootFolder))
			int validatedColumnIndex = columnIndex == null ? -1 : columnIndex.intValue()

			if (!exportRoot.exists()) {
				errors.append('[ERROR] Export root folder does not exist.\n')
						.append('Folder: ')
						.append(exportRoot.getAbsolutePath())

				return finalizeResult(result, errors, passedDetails)
			}

			if (!exportRoot.isDirectory()) {
				errors.append('[ERROR] Export root path is not a folder.\n')
						.append('Path: ')
						.append(exportRoot.getAbsolutePath())

				return finalizeResult(result, errors, passedDetails)
			}

			if (validatedColumnIndex < 0) {
				errors.append('[ERROR] Invalid column index.\n')
						.append('Column index: ')
						.append(validatedColumnIndex)

				return finalizeResult(result, errors, passedDetails)
			}

			KeywordUtil.logInfo(
					'[REC X PRD SEARCH] root=' + exportRoot.getAbsolutePath() +
					' | group=' + safeText(exportGroupFolder) +
					' | feature=' + safeText(exportFeatureFolder)
			)

			Map selectedFiles = resolveLatestRecPrdFiles(
					exportRoot,
					exportGroupFolder,
					exportFeatureFolder
			)

			File recFile = selectedFiles.recFile as File
			File prdFile = selectedFiles.prdFile as File
			File selectedFolder = selectedFiles.selectedFolder as File

			result.recFileName = recFile == null ? 'NOT FOUND' : recFile.getName()
			result.prdFileName = prdFile == null ? 'NOT FOUND' : prdFile.getName()
			result.selectedFolderPath = selectedFolder == null ? '' : selectedFolder.getAbsolutePath()

			if (recFile == null) {
				errors.append('[ERROR] REC exported file was not found.\n')
						.append('Search root: ')
						.append(exportRoot.getAbsolutePath())
						.append('\nExpected folder: ')
						.append(safeText(exportGroupFolder))
						.append('\\')
						.append(safeText(exportFeatureFolder))
						.append('\n')
			}

			if (prdFile == null) {
				errors.append('[ERROR] PRD exported file was not found.\n')
						.append('Search root: ')
						.append(exportRoot.getAbsolutePath())
						.append('\nExpected folder: ')
						.append(safeText(exportGroupFolder))
						.append('\\')
						.append(safeText(exportFeatureFolder))
						.append('\n')
			}

			if (errors.length() > 0) {
				return finalizeResult(result, errors, passedDetails)
			}

			KeywordUtil.logInfo(
					'[REC X PRD SEARCH] selectedFolder=' + selectedFolder.getAbsolutePath() +
					' | REC=' + recFile.getName() +
					' | PRD=' + prdFile.getName()
			)

			recInput = new FileInputStream(recFile)
			prdInput = new FileInputStream(prdFile)

			recWorkbook = WorkbookFactory.create(recInput)
			prdWorkbook = WorkbookFactory.create(prdInput)

			if (recWorkbook.getNumberOfSheets() == 0) {
				errors.append('[ERROR] REC workbook does not contain worksheets.\n')
						.append('File: ')
						.append(recFile.getName())
						.append('\n')
			}

			if (prdWorkbook.getNumberOfSheets() == 0) {
				errors.append('[ERROR] PRD workbook does not contain worksheets.\n')
						.append('File: ')
						.append(prdFile.getName())
						.append('\n')
			}

			if (errors.length() > 0) {
				return finalizeResult(result, errors, passedDetails)
			}

			Sheet recSheet = recWorkbook.getSheetAt(0)
			Sheet prdSheet = prdWorkbook.getSheetAt(0)

			DataFormatter recFormatter = new DataFormatter()
			DataFormatter prdFormatter = new DataFormatter()

			FormulaEvaluator recEvaluator = recWorkbook
					.getCreationHelper()
					.createFormulaEvaluator()

			FormulaEvaluator prdEvaluator = prdWorkbook
					.getCreationHelper()
					.createFormulaEvaluator()

			String recColumnName = readHeaderName(
					recSheet,
					validatedColumnIndex,
					recFormatter
			)

			String prdColumnName = readHeaderName(
					prdSheet,
					validatedColumnIndex,
					prdFormatter
			)

			String resolvedColumnName = !recColumnName.isEmpty()
					? recColumnName
					: safeText(expectedColumnName)

			result.columnName = resolvedColumnName
			result.recColumnName = recColumnName
			result.prdColumnName = prdColumnName

			validateColumnName(
					errors,
					'REC',
					recColumnName,
					expectedColumnName,
					validatedColumnIndex
			)

			validateColumnName(
					errors,
					'PRD',
					prdColumnName,
					expectedColumnName,
					validatedColumnIndex
			)

			if (!recColumnName.isEmpty() &&
					!prdColumnName.isEmpty() &&
					!normalizeText(recColumnName).equals(normalizeText(prdColumnName))) {

				errors.append('[ERROR] REC and PRD column headers are different.\n')
						.append('REC: ')
						.append(recColumnName)
						.append('\nPRD: ')
						.append(prdColumnName)
						.append('\n')
			}

			int recRows = countNonEmptyDataRows(
					recSheet,
					recFormatter,
					recEvaluator
			)

			int prdRows = countNonEmptyDataRows(
					prdSheet,
					prdFormatter,
					prdEvaluator
			)

			result.recRows = recRows
			result.prdRows = prdRows

			if (recRows != prdRows) {
				errors.append('[ERROR] Number of rows is different.\n')
						.append('REC: ')
						.append(recRows)
						.append('\nPRD: ')
						.append(prdRows)
						.append('\n')
			} else {
				passedDetails.append('[PASS] Number of rows is equal.\n')
						.append('REC: ')
						.append(recRows)
						.append('\nPRD: ')
						.append(prdRows)
						.append('\n')
			}

			Map recStatistics = calculateColumnStatistics(
					recSheet,
					validatedColumnIndex,
					recFormatter,
					recEvaluator
			)

			Map prdStatistics = calculateColumnStatistics(
					prdSheet,
					validatedColumnIndex,
					prdFormatter,
					prdEvaluator
			)

			int recNumericValues = recStatistics.numericValues as int
			int prdNumericValues = prdStatistics.numericValues as int

			result.recNumericValues = recNumericValues
			result.prdNumericValues = prdNumericValues

			if (recNumericValues == 0) {
				errors.append('[ERROR] REC column does not contain numeric values.\n')
						.append('Column: ')
						.append(resolvedColumnName)
						.append('\n')
			}

			if (prdNumericValues == 0) {
				errors.append('[ERROR] PRD column does not contain numeric values.\n')
						.append('Column: ')
						.append(resolvedColumnName)
						.append('\n')
			}

			if (recNumericValues == 0 || prdNumericValues == 0) {
				return finalizeResult(result, errors, passedDetails)
			}

			BigDecimal recSum = round2(recStatistics.sum as BigDecimal)
			BigDecimal prdSum = round2(prdStatistics.sum as BigDecimal)
			BigDecimal recMinimum = round2(recStatistics.minimum as BigDecimal)
			BigDecimal prdMinimum = round2(prdStatistics.minimum as BigDecimal)
			BigDecimal recMaximum = round2(recStatistics.maximum as BigDecimal)
			BigDecimal prdMaximum = round2(prdStatistics.maximum as BigDecimal)

			result.recSum = recSum
			result.prdSum = prdSum
			result.recMinimum = recMinimum
			result.prdMinimum = prdMinimum
			result.recMaximum = recMaximum
			result.prdMaximum = prdMaximum

			appendComparison(
					errors,
					passedDetails,
					'Column sum',
					resolvedColumnName,
					recSum,
					prdSum
			)

			appendComparison(
					errors,
					passedDetails,
					'Minimum value',
					resolvedColumnName,
					recMinimum,
					prdMinimum
			)

			appendComparison(
					errors,
					passedDetails,
					'Maximum value',
					resolvedColumnName,
					recMaximum,
					prdMaximum
			)

		} catch (Exception e) {
			errors.append('[ERROR] REC x PRD export validation failed.\n')
					.append('Exception: ')
					.append(e.getClass().getSimpleName())
					.append('\nMessage: ')
					.append(safeText(e.getMessage()))
		} finally {
			closeWorkbook(recWorkbook)
			closeWorkbook(prdWorkbook)
			closeInput(recInput)
			closeInput(prdInput)
		}

		return finalizeResult(result, errors, passedDetails)
	}


	private Map createEmptyResult(
			String exportRootFolder,
			String exportGroupFolder,
			String exportFeatureFolder,
			Integer columnIndex,
			String expectedColumnName) {

		return [
			success             : false,
			errors              : '',
			passedDetails       : '',
			exportRootFolder    : safeText(exportRootFolder),
			exportGroupFolder   : safeText(exportGroupFolder),
			exportFeatureFolder : safeText(exportFeatureFolder),
			columnIndex         : columnIndex,
			columnName          : safeText(expectedColumnName),
			recColumnName       : '',
			prdColumnName       : '',
			selectedFolderPath  : '',
			recFileName         : 'NOT FOUND',
			prdFileName         : 'NOT FOUND',
			recRows             : null,
			prdRows             : null,
			recNumericValues    : null,
			prdNumericValues    : null,
			recSum              : null,
			prdSum              : null,
			recMinimum          : null,
			prdMinimum          : null,
			recMaximum          : null,
			prdMaximum          : null
		]
	}


	private Map finalizeResult(
			Map result,
			StringBuilder errors,
			StringBuilder passedDetails) {

		result.errors = errors.toString().trim()
		result.passedDetails = passedDetails.toString().trim()
		result.success = result.errors.isEmpty()

		return result
	}


	private Map resolveLatestRecPrdFiles(
			File exportRoot,
			String expectedGroupFolder,
			String expectedFeatureFolder) {

		Map result = [
			recFile        : null,
			prdFile        : null,
			selectedFolder : null
		]

		List<File> matchingFeatureFolders = []

		collectMatchingFeatureFolders(
				exportRoot,
				expectedGroupFolder,
				expectedFeatureFolder,
				matchingFeatureFolders
		)

		KeywordUtil.logInfo(
				'[REC X PRD SEARCH] matchingFeatureFolders=' +
				matchingFeatureFolders.size()
		)

		List<Map> validPairs = []

		for (File featureFolder : matchingFeatureFolders) {
			File[] folderFiles = featureFolder.listFiles()

			if (folderFiles == null) {
				continue
			}

			List<File> recFiles = folderFiles.findAll { File file ->
				isEnvironmentExcelFile(file, 'REC')
			}

			List<File> prdFiles = folderFiles.findAll { File file ->
				isEnvironmentExcelFile(file, 'PRD')
			}

			if (recFiles.isEmpty() || prdFiles.isEmpty()) {
				continue
			}

			recFiles.sort { File first, File second ->
				second.lastModified() <=> first.lastModified()
			}

			prdFiles.sort { File first, File second ->
				second.lastModified() <=> first.lastModified()
			}

			File recFile = recFiles.get(0)
			File prdFile = prdFiles.get(0)

			validPairs.add([
				recFile        : recFile,
				prdFile        : prdFile,
				selectedFolder : featureFolder,
				pairTimestamp  : Math.max(
						recFile.lastModified(),
						prdFile.lastModified()
				)
			])
		}

		if (validPairs.isEmpty()) {
			return result
		}

		validPairs.sort { Map first, Map second ->
			(second.pairTimestamp as Long) <=>
			(first.pairTimestamp as Long)
		}

		Map latestPair = validPairs.get(0)

		result.recFile = latestPair.recFile
		result.prdFile = latestPair.prdFile
		result.selectedFolder = latestPair.selectedFolder

		return result
	}


	private void collectMatchingFeatureFolders(
			File currentFolder,
			String expectedGroupFolder,
			String expectedFeatureFolder,
			List<File> result) {

		if (currentFolder == null ||
				!currentFolder.exists() ||
				!currentFolder.isDirectory()) {

			return
		}

		File parentFolder = currentFolder.getParentFile()

		boolean featureMatches =
				normalizeText(currentFolder.getName()).equals(
						normalizeText(expectedFeatureFolder)
				)

		boolean groupMatches =
				parentFolder != null &&
				normalizeText(parentFolder.getName()).equals(
						normalizeText(expectedGroupFolder)
				)

		if (featureMatches && groupMatches) {
			result.add(currentFolder)
			return
		}

		File[] children = currentFolder.listFiles()

		if (children == null) {
			return
		}

		for (File child : children) {
			if (child != null && child.isDirectory()) {
				collectMatchingFeatureFolders(
						child,
						expectedGroupFolder,
						expectedFeatureFolder,
						result
				)
			}
		}
	}


	private boolean isEnvironmentExcelFile(
			File file,
			String environment) {

		if (file == null ||
				!file.exists() ||
				!file.isFile()) {

			return false
		}

		String fileName = file.getName()

		if (fileName.startsWith('~$')) {
			return false
		}

		return fileName.toUpperCase().startsWith(
				safeText(environment).toUpperCase() + '_'
		) && isExcelFileName(fileName)
	}


	private boolean isExcelFileName(String fileName) {

		String normalizedName = safeText(fileName).toLowerCase()

		return normalizedName.endsWith('.xlsx') ||
			normalizedName.endsWith('.xls') ||
			normalizedName.endsWith('.xlsm')
	}


	private void validateColumnName(
			StringBuilder errors,
			String environment,
			String actualColumnName,
			String expectedColumnName,
			int columnIndex) {

		if (actualColumnName.isEmpty()) {
			errors.append('[ERROR] ')
					.append(environment)
					.append(' column header was not found.\n')
					.append('Column index: ')
					.append(columnIndex)
					.append('\n')

			return
		}

		String normalizedExpected = normalizeText(expectedColumnName)

		if (!normalizedExpected.isEmpty() &&
				!normalizeText(actualColumnName).equals(normalizedExpected)) {

			errors.append('[ERROR] Unexpected ')
					.append(environment)
					.append(' column header.\n')
					.append('Expected: ')
					.append(safeText(expectedColumnName))
					.append('\nFound: ')
					.append(actualColumnName)
					.append('\n')
		}
	}


	private String readHeaderName(
			Sheet sheet,
			int columnIndex,
			DataFormatter formatter) {

		if (sheet == null || columnIndex < 0) {
			return ''
		}

		Row headerRow = sheet.getRow(0)

		if (headerRow == null) {
			return ''
		}

		Cell headerCell = headerRow.getCell(columnIndex)

		if (headerCell == null) {
			return ''
		}

		return formatter.formatCellValue(headerCell).trim()
	}


	private int countNonEmptyDataRows(
			Sheet sheet,
			DataFormatter formatter,
			FormulaEvaluator evaluator) {

		if (sheet == null) {
			return 0
		}

		int count = 0

		for (int rowIndex = 1;
				rowIndex <= sheet.getLastRowNum();
				rowIndex++) {

			Row row = sheet.getRow(rowIndex)

			if (row != null &&
					!isRowEmpty(row, formatter, evaluator)) {

				count++
			}
		}

		return count
	}


	private Map calculateColumnStatistics(
			Sheet sheet,
			int columnIndex,
			DataFormatter formatter,
			FormulaEvaluator evaluator) {

		BigDecimal sum = BigDecimal.ZERO
		BigDecimal minimum = null
		BigDecimal maximum = null
		int numericValues = 0

		for (int rowIndex = 1;
				rowIndex <= sheet.getLastRowNum();
				rowIndex++) {

			Row row = sheet.getRow(rowIndex)

			if (row == null) {
				continue
			}

			BigDecimal value = getCellNumber(
					row,
					columnIndex,
					formatter,
					evaluator
			)

			if (value == null) {
				continue
			}

			sum = sum.add(value)

			if (minimum == null || value.compareTo(minimum) < 0) {
				minimum = value
			}

			if (maximum == null || value.compareTo(maximum) > 0) {
				maximum = value
			}

			numericValues++
		}

		return [
			sum           : sum,
			minimum       : minimum,
			maximum       : maximum,
			numericValues : numericValues
		]
	}


	private void appendComparison(
			StringBuilder errors,
			StringBuilder passedDetails,
			String validationLabel,
			String columnName,
			BigDecimal recValue,
			BigDecimal prdValue) {

		if (recValue.compareTo(prdValue) != 0) {
			errors.append('[ERROR] ')
					.append(validationLabel)
					.append(' is different.\n')
					.append('Column: ')
					.append(columnName)
					.append('\nREC: ')
					.append(recValue)
					.append('\nPRD: ')
					.append(prdValue)
					.append('\n')
		} else {
			passedDetails.append('[PASS] ')
					.append(validationLabel)
					.append(' is equal.\n')
					.append('Column: ')
					.append(columnName)
					.append('\nValue: ')
					.append(recValue)
					.append('\n')
		}
	}


	private BigDecimal getCellNumber(
			Row row,
			int columnIndex,
			DataFormatter formatter,
			FormulaEvaluator evaluator) {

		if (row == null || columnIndex < 0) {
			return null
		}

		Cell cell = row.getCell(columnIndex)

		if (cell == null) {
			return null
		}

		try {
			if (cell.getCellType() == CellType.NUMERIC) {
				return BigDecimal.valueOf(cell.getNumericCellValue())
			}

			if (cell.getCellType() == CellType.FORMULA) {
				CellValue evaluatedValue = evaluator.evaluate(cell)

				if (evaluatedValue != null &&
						evaluatedValue.getCellType() == CellType.NUMERIC) {

					return BigDecimal.valueOf(
							evaluatedValue.getNumberValue()
					)
				}
			}

			return parseNumber(
					getCellText(cell, formatter, evaluator)
			)
		} catch (Exception ignored) {
			return parseNumber(
					getCellText(cell, formatter, evaluator)
			)
		}
	}


	private String getCellText(
			Cell cell,
			DataFormatter formatter,
			FormulaEvaluator evaluator) {

		if (cell == null) {
			return ''
		}

		try {
			return formatter
					.formatCellValue(cell, evaluator)
					.trim()
		} catch (Exception ignored) {
			return formatter
					.formatCellValue(cell)
					.trim()
		}
	}


	private boolean isRowEmpty(
			Row row,
			DataFormatter formatter,
			FormulaEvaluator evaluator) {

		if (row == null || row.getLastCellNum() <= 0) {
			return true
		}

		for (int columnIndex = 0;
				columnIndex < row.getLastCellNum();
				columnIndex++) {

			Cell cell = row.getCell(columnIndex)

			if (cell == null) {
				continue
			}

			if (!getCellText(cell, formatter, evaluator).isEmpty()) {
				return false
			}
		}

		return true
	}


	private BigDecimal parseNumber(String value) {

		String text = safeText(value)

		if (text.isEmpty()) {
			return null
		}

		text = text
				.replace('\u00A0', ' ')
				.replace('\u202F', ' ')
				.replace('\u2212', '-')
				.replace('\u2012', '-')
				.replace('\u2013', '-')
				.replace('\u2014', '-')
				.replace('\u2015', '-')
				.trim()

		boolean negativeByParentheses =
				text.startsWith('(') &&
				text.endsWith(')')

		boolean negativeByTrailingMinus =
				text.endsWith('-')

		text = text
				.replaceAll('[^0-9,\\.\\-\\(\\)]', '')
				.replace('(', '')
				.replace(')', '')

		if (negativeByTrailingMinus && text.endsWith('-')) {
			text = text.substring(0, text.length() - 1)
		}

		boolean negative =
				text.startsWith('-') ||
				negativeByParentheses ||
				negativeByTrailingMinus

		text = text.replace('-', '')

		if (text.isEmpty()) {
			return null
		}

		String normalizedNumber = normalizeNumericSeparators(text)

		if (normalizedNumber.isEmpty()) {
			return null
		}

		try {
			BigDecimal result = new BigDecimal(normalizedNumber)

			if (negative && result.compareTo(BigDecimal.ZERO) > 0) {
				result = result.negate()
			}

			return result
		} catch (Exception ignored) {
			return null
		}
	}


	private String normalizeNumericSeparators(String value) {

		int commaCount = countOccurrences(value, ',')
		int dotCount = countOccurrences(value, '.')

		if (commaCount > 0 && dotCount > 0) {
			int lastComma = value.lastIndexOf(',')
			int lastDot = value.lastIndexOf('.')

			if (lastComma > lastDot) {
				return value
						.replace('.', '')
						.replace(',', '.')
			}

			return value.replace(',', '')
		}

		if (commaCount > 0) {
			return normalizeSingleSeparatorNumber(value, ',')
		}

		if (dotCount > 0) {
			return normalizeSingleSeparatorNumber(value, '.')
		}

		return value
	}


	private String normalizeSingleSeparatorNumber(
			String value,
			String separator) {

		int separatorCount = countOccurrences(value, separator)

		if (separatorCount == 0) {
			return value
		}

		if (separatorCount > 1) {
			int lastSeparator = value.lastIndexOf(separator)
			String decimals = value.substring(lastSeparator + 1)

			if (decimals.length() == 1 || decimals.length() == 2) {
				String integerPart = value
						.substring(0, lastSeparator)
						.replace(separator, '')

				return integerPart + '.' + decimals
			}

			return value.replace(separator, '')
		}

		int separatorIndex = value.indexOf(separator)
		String before = value.substring(0, separatorIndex)
		String after = value.substring(separatorIndex + 1)

		if (after.length() == 3 &&
				before.length() >= 1 &&
				before.length() <= 3) {

			return before + after
		}

		if (separator == ',') {
			return before + '.' + after
		}

		return value
	}


	private BigDecimal round2(BigDecimal value) {

		if (value == null) {
			return null
		}

		return value.setScale(
				2,
				RoundingMode.HALF_EVEN
		)
	}


	private int countOccurrences(
			String text,
			String token) {

		int count = 0
		int index = 0

		while (index >= 0) {
			index = text.indexOf(token, index)

			if (index >= 0) {
				count++
				index += token.length()
			}
		}

		return count
	}


	private String normalizeText(Object value) {

		String text = safeText(value)

		if (text.isEmpty()) {
			return ''
		}

		text = Normalizer.normalize(
				text,
				Normalizer.Form.NFD
		)

		text = text.replaceAll(
				'\\p{InCombiningDiacriticalMarks}+',
				''
		)

		return text
				.toLowerCase()
				.replace(' ', '_')
				.replace('-', '_')
				.replaceAll('_+', '_')
				.trim()
	}


	private String safeText(Object value) {

		if (value == null) {
			return ''
		}

		return value.toString().trim()
	}


	private void closeWorkbook(Workbook workbook) {

		try {
			if (workbook != null) {
				workbook.close()
			}
		} catch (Exception ignored) {
		}
	}


	private void closeInput(FileInputStream input) {

		try {
			if (input != null) {
				input.close()
			}
		} catch (Exception ignored) {
		}
	}
