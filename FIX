	private List<Map> buildScenariosFromJUnit(
			File junitFile,
			File reportRoot,
			Map<String, Map> traceByCase,
			Map<String, List<File>> evidenceByCase
	) {
		List<Map> scenarios = []
		Document xml = parseXml(junitFile)

		if (xml == null) {
			return scenarios
		}

		NodeList testcases = xml.getElementsByTagName('testcase')

		for (int i = 0; i < testcases.getLength(); i++) {
			Node node = testcases.item(i)
			if (!(node instanceof Element)) {
				continue
			}

			Element testcase = (Element) node

			String rawName = safe(testcase.getAttribute('name'))
			String className = safe(testcase.getAttribute('classname'))
			String displayName = buildDisplayName(className, rawName)
			String scenarioId = buildScenarioId(displayName, i + 1)

			String status = 'passed'
			String fullError = ''
			String visualError = ''

			NodeList children = testcase.getChildNodes()
			for (int c = 0; c < children.getLength(); c++) {
				Node child = children.item(c)
				if (!(child instanceof Element)) {
					continue
				}

				String childName = safe(child.getNodeName()).toLowerCase(Locale.ENGLISH)

				if ('failure'.equals(childName) || 'error'.equals(childName)) {
					status = 'failed'
					fullError = safe(child.getTextContent())
					visualError = buildShortError(safe(((Element) child).getAttribute('message')), fullError, displayName)
					break
				}

				if ('skipped'.equals(childName)) {
					status = 'skipped'
					fullError = safe(child.getTextContent())
					visualError = buildShortError(safe(((Element) child).getAttribute('message')), fullError, displayName)
				}
			}

			long junitDurationMs = toDurationMillis(safe(testcase.getAttribute('time')))
			Map trace = resolveTrace(traceByCase, [displayName, className, rawName])

			long startMs = asLong(trace.startMs)
			long endMs = asLong(trace.endMs)
			long durationMs = 0L

			if (startMs > 0L && endMs >= startMs) {
				durationMs = endMs - startMs
			} else {
				durationMs = junitDurationMs
			}

			String traceStatus = normalizeScenarioStatus(safe(trace.status))
			if (!traceStatus.isEmpty()) {
				status = traceStatus
			}

			if (visualError.isEmpty() && !safe(trace.failure).isEmpty()) {
				visualError = safe(trace.failure)
			}

			if (fullError.isEmpty() && !safe(trace.failure).isEmpty()) {
				fullError = safe(trace.failure)
			}

			List<Map> steps = normalizeStepRows(trace.steps)
			if (steps.isEmpty() && 'failed'.equals(status) && !visualError.isEmpty()) {
				steps << [
					status    : 'failed',
					timestamp : endMs > 0L ? formatClock(endMs) : '--',
					detail    : visualError,
					icon      : resolveStepIcon(visualError, 'failed')
				]
			}

			List<Map> evidence = collectEvidence(reportRoot, [displayName, className, rawName], evidenceByCase)

			scenarios << [
				id            : scenarioId,
				name          : displayName,
				scenarioName  : displayName,
				status        : status,
				result        : status,
				durationMs    : durationMs,
				durationLabel : formatDuration(durationMs),
				startTime     : startMs > 0L ? formatDateTime(startMs) : '',
				endTime       : endMs > 0L ? formatDateTime(endMs) : '',
				startLabel    : startMs > 0L ? formatDateTime(startMs) : '--',
				endLabel      : endMs > 0L ? formatDateTime(endMs) : '--',
				startShort    : startMs > 0L ? formatClock(startMs) : '--',
				endShort      : endMs > 0L ? formatClock(endMs) : '--',
				startLong     : startMs > 0L ? formatDateTime(startMs) : '--',
				endLong       : endMs > 0L ? formatDateTime(endMs) : '--',
				visualError   : visualError,
				errorSummary  : visualError,
				fullError     : fullError,
				errorDetail   : fullError,
				reportFolder  : reportRoot.absolutePath,
				steps         : steps,
				evidence      : evidence
			]
		}

		return scenarios
	}

	private List<Map> buildFallbackFromTrace(
			File reportRoot,
			Map<String, Map> traceByCase,
			Map<String, List<File>> evidenceByCase
	) {
		List<Map> scenarios = []

		traceByCase.eachWithIndex { String caseId, Map trace, int index ->
			long startMs = asLong(trace.startMs)
			long endMs = asLong(trace.endMs)
			long durationMs = startMs > 0L && endMs >= startMs ? (endMs - startMs) : 0L

			String status = normalizeScenarioStatus(safe(trace.status))
			if (status.isEmpty()) {
				status = 'passed'
			}

			List<Map> steps = normalizeStepRows(trace.steps)
			String failure = safe(trace.failure)
			List<Map> evidence = collectEvidence(reportRoot, [caseId], evidenceByCase)

			scenarios << [
				id            : buildScenarioId(caseId, index + 1),
				name          : caseId,
				scenarioName  : caseId,
				status        : status,
				result        : status,
				durationMs    : durationMs,
				durationLabel : formatDuration(durationMs),
				startTime     : startMs > 0L ? formatDateTime(startMs) : '',
				endTime       : endMs > 0L ? formatDateTime(endMs) : '',
				startLabel    : startMs > 0L ? formatDateTime(startMs) : '--',
				endLabel      : endMs > 0L ? formatDateTime(endMs) : '--',
				startShort    : startMs > 0L ? formatClock(startMs) : '--',
				endShort      : endMs > 0L ? formatClock(endMs) : '--',
				startLong     : startMs > 0L ? formatDateTime(startMs) : '--',
				endLong       : endMs > 0L ? formatDateTime(endMs) : '--',
				visualError   : failure,
				errorSummary  : failure,
				fullError     : failure,
				errorDetail   : failure,
				reportFolder  : reportRoot.absolutePath,
				steps         : steps,
				evidence      : evidence
			]
		}

		return scenarios
	}

	private Map<String, Map> readTrace(File root) {
		Map<String, Map> result = new LinkedHashMap<String, Map>()

		TRACE_FILE_NAMES.each { String traceName ->
			File traceFile = new File(root, traceName)

			if (!traceFile.exists()) {
				return
			}

			eachLineSafely(traceFile) { String line ->
				List<String> parts = line.split('\t', 4) as List<String>
				if (parts.size() < 4) {
					return
				}

				String type = ''
				long millis = 0L
				String caseId = ''
				String payload = ''

				if (parts[1]?.isLong()) {
					type = safe(parts[0])
					millis = asLong(parts[1])
					caseId = safe(parts[2])
					payload = decode64(parts[3])
				} else {
					millis = parseDateToMillis(parts[0])
					type = safe(parts[1])
					caseId = decode64(parts[2])
					payload = decode64(parts[3])
				}

				if (caseId.isEmpty()) {
					return
				}

				Map row = result.containsKey(caseId) ? result[caseId] : [
					startMs : 0L,
					endMs   : 0L,
					status  : '',
					failure : '',
					steps   : []
				]

				if ('CASE_START'.equals(type)) {
					row.startMs = millis
				} else if ('CASE_END'.equals(type)) {
					row.endMs = millis
				} else if ('STATUS'.equals(type)) {
					row.status = safe(payload)
				} else if ('STEP'.equals(type) || 'REPORT_STEP'.equals(type)) {
					row.steps << [
						status    : 'passed',
						timestamp : formatClock(millis),
						timeMs    : millis,
						detail    : safe(payload),
						icon      : resolveStepIcon(safe(payload), 'passed')
					]
				} else if ('STEP_FAIL'.equals(type)) {
					row.failure = safe(payload)
					row.status = 'FAILED'
					row.steps << [
						status    : 'failed',
						timestamp : formatClock(millis),
						timeMs    : millis,
						detail    : safe(payload),
						icon      : resolveStepIcon(safe(payload), 'failed')
					]
				}
				result[caseId] = row
			}
		}

		return result
	}

	private Map<String, List<File>> readEvidenceTrace(File root) {
		Map<String, List<File>> result = [:].withDefault { [] }

		File traceFile = new File(root, EVIDENCE_TRACE_FILE)
		if (!traceFile.exists()) {
			return result
		}

		eachLineSafely(traceFile) { String line ->
			List<String> parts = line.split('\t', 3) as List<String>
			if (parts.size() < 3) {
				return
			}

			String caseId = decode64(parts[1])
			String filePath = decode64(parts[2])

			if (caseId.isEmpty() || filePath.isEmpty()) {
				return
			}

			File file = new File(filePath)
			if (!file.exists() || !file.isFile() || file.length() <= 0L) {
				return
			}

			String key = normalizeKey(caseId)
			result[key] << file
		}

		result.each { String key, List<File> files ->
			result[key] = files.unique { File f -> f.absolutePath }
		}

		return result
	}

	private List<Map> collectEvidence(File reportRoot, List<String> keys, Map<String, List<File>> evidenceByCase) {
		Set<File> files = new LinkedHashSet<File>()

		List<String> cleanKeys = (keys ?: [])
				.collect { String value -> safe(value) }
				.findAll { String value -> !value.isEmpty() }

		File evidenceRoot = new File(reportRoot, EVIDENCE_FOLDER_NAME)

		cleanKeys.each { String key ->
			String normalized = normalizeKey(key)

			List<File> traced = evidenceByCase[normalized] ?: []
			traced.each { File file ->
				if (file != null && file.exists() && file.isFile() && file.length() > 0L) {
					files << file
				}
			}
		}

		cleanKeys.each { String key ->
			File caseFolder = new File(evidenceRoot, sanitizeForPath(key))

			if (caseFolder.exists() && caseFolder.isDirectory()) {
				caseFolder.eachFileRecurse { File file ->
					if (file != null && file.isFile() && isImageFile(file.name) && file.length() > 0L) {
						files << file
					}
				}
			}
		}

		if (files.isEmpty() && evidenceRoot.exists()) {
			List<Map> scored = []

			evidenceRoot.eachFileRecurse { File file ->
				if (file == null || !file.isFile() || file.length() <= 0L || !isImageFile(file.name)) {
					return
				}

				String normalizedPath = normalizeKey(file.absolutePath)
				int score = 0

				cleanKeys.each { String key ->
					String normalizedKey = normalizeKey(key)
					if (!normalizedKey.isEmpty() && normalizedPath.contains(normalizedKey)) {
						score = Math.max(score, 100)
					}
				}

				if (score > 0) {
					scored << [file: file, score: score]
				}
			}

			scored = scored.sort { Map a, Map b ->
				int byScore = (b.score as int) <=> (a.score as int)
				if (byScore != 0) {
					return byScore
				}
				return ((b.file as File).lastModified()) <=> ((a.file as File).lastModified())
			}

			scored.each { Map row ->
				files << (row.file as File)
			}
		}

		List<File> ordered = files.toList().sort { File a, File b ->
			b.lastModified() <=> a.lastModified()
		}

		return ordered.take(6).collect { File file ->
			[
				name   : file.name,
				href   : file.toURI().toString(),
				image  : true,
				imgSrc : file.toURI().toString()
			]
		}
	}

	private List<Map> normalizeStepRows(def rawSteps) {
		List<Map> result = []

		if (!(rawSteps instanceof Collection)) {
			return result
		}

		(rawSteps as Collection).each { def item ->
			if (!(item instanceof Map)) {
				return
			}

			String detail = safe(item.detail)
			if (detail.isEmpty()) {
				return
			}

			String status = normalizeStepStatus(safe(item.status))
			String timestamp = safe(item.timestamp)
			long timeMs = asLong(item.timeMs)

			result << [
				status    : status,
				timestamp : !timestamp.isEmpty() ? timestamp : (timeMs > 0L ? formatClock(timeMs) : '--'),
				detail    : detail,
				icon      : resolveStepIcon(detail, status),
				timeMs    : timeMs
			]
		}

		result = result
				.unique { Map row -> safe(row.status) + '|' + safe(row.timestamp) + '|' + safe(row.detail) }
				.sort { Map a, Map b -> asLong(a.timeMs) <=> asLong(b.timeMs) }

