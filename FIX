package commands

import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import java.awt.Robot
import java.awt.Toolkit
import java.awt.datatransfer.StringSelection
import java.awt.event.KeyEvent
import java.text.SimpleDateFormat

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

class ExportFile {

	private ImageLoader imageLoader = new ImageLoader()

	@Keyword
	void exportFromOutilsToNo(String exportLabel) {
		KeywordUtil.logInfo('Step 1. Open Outils menu.')
		imageLoader.waitForImageOrStop('General', 'outilsMenu', 15)
		imageLoader.clickImageOrStop('General', 'outilsMenu')
		Windows.delay(2)

		KeywordUtil.logInfo('Step 2. Validate Export button and click it.')
		imageLoader.waitForImageOrStop('General', 'exportButton', 15)
		imageLoader.clickImageOrStop('General', 'exportButton')
		Windows.delay(3)

		KeywordUtil.logInfo('Step 3. Save export inside report Evidences folder.')
		saveToReportEvidencePath(exportLabel)

		KeywordUtil.logInfo('Step 4. If open-file dialog appears, click No.')
		waitForNoOpenFilePopUp(2, 10, 0)

		KeywordUtil.logInfo('Export flow finished without opening exported file.')
	}

	private void saveToReportEvidencePath(String exportLabel) {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		String directory = RunConfiguration.getReportFolder() + '\\Evidences'
		String fileName = buildExportFileName(exportLabel)

		new File(directory).mkdirs()

		KeywordUtil.logInfo('Export directory: ' + directory)
		KeywordUtil.logInfo('Export file name: ' + fileName)

		Windows.click(findWindowsObject('Object Repository/Acapulco/filePath'))
		Windows.delay(2)

		pasteText(directory)

		robot.keyPress(KeyEvent.VK_ENTER)
		robot.keyRelease(KeyEvent.VK_ENTER)

		Windows.delay(2)

		setFileNameIfAvailable(fileName)

		Windows.click(findWindowsObject('General/btnSave'))

		Windows.delay(5)

		confirmOverwriteIfVisible()
	}

	private String buildExportFileName(String exportLabel) {
		String featureName = resolveCurrentFeatureName()

		if (featureName == null || featureName.trim().isEmpty()) {
			featureName = exportLabel
		}

		if (featureName == null || featureName.trim().isEmpty()) {
			featureName = 'Export'
		}

		String timestamp = new SimpleDateFormat('yyyyMMdd_HHmmss').format(new Date())

		return sanitizeFileName(featureName) + '_' + timestamp + '.xlsx'
	}

	private String resolveCurrentFeatureName() {
		String reportFolder = RunConfiguration.getReportFolder()

		if (reportFolder == null || reportFolder.trim().isEmpty()) {
			return null
		}

		List<String> parts = reportFolder.replace('/', '\\').split('\\\\') as List<String>

		for (int i = parts.size() - 1; i >= 0; i--) {
			String part = parts[i] == null ? '' : parts[i].trim()

			if (part.isEmpty()) {
				continue
			}

			if (part ==~ /\d{8}_\d{6}/ || part ==~ /\d{14}/) {
				continue
			}

			if (part.equalsIgnoreCase('Reports') ||
					part.equalsIgnoreCase('Evidences') ||
					part.equalsIgnoreCase('Exports')) {
				continue
			}

			return part
		}

		return null
	}

	private String sanitizeFileName(String text) {
		return text
				.replaceAll('[\\\\/:*?"<>|]', '_')
				.replaceAll('\\s+', '_')
				.trim()
	}

	private void setFileNameIfAvailable(String fileName) {
		boolean fieldFocused = false

		try {
			Windows.click(findWindowsObject('General/txtFileName'))
			Windows.delay(1)
			fieldFocused = true
			KeywordUtil.logInfo('File name field focused using General/txtFileName.')
		} catch (Exception ignored) {
			KeywordUtil.logInfo('General/txtFileName was not available. Trying ALT + N fallback.')
		}

		if (!fieldFocused) {
			try {
				focusFileNameFieldWithShortcut()
				Windows.delay(1)
				fieldFocused = true
				KeywordUtil.logInfo('File name field focused using ALT + N.')
			} catch (Exception ignored) {
				KeywordUtil.logInfo('Could not focus file name field. Keeping default exported file name.')
			}
		}

		if (fieldFocused) {
			clearFocusedField()
			pasteText(fileName)
			Windows.delay(1)
		}
	}

	private void focusFileNameFieldWithShortcut() {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_ALT)
		robot.keyPress(KeyEvent.VK_N)
		robot.keyRelease(KeyEvent.VK_N)
		robot.keyRelease(KeyEvent.VK_ALT)
	}

	private void confirmOverwriteIfVisible() {
		if (imageLoader.waitForImage('General', 'yes', 3)) {
			imageLoader.clickImageOrStop('General', 'yes')
			Windows.delay(2)
			KeywordUtil.logInfo('Overwrite confirmation clicked using yes.')
			return
		}

		if (imageLoader.waitForImage('General', 'yesEn', 3)) {
			imageLoader.clickImageOrStop('General', 'yesEn')
			Windows.delay(2)
			KeywordUtil.logInfo('Overwrite confirmation clicked using yesEn.')
			return
		}

		if (imageLoader.waitForImage('General', 'yesUnderline', 3)) {
			imageLoader.clickImageOrStop('General', 'yesUnderline')
			Windows.delay(2)
			KeywordUtil.logInfo('Overwrite confirmation clicked using yesUnderline.')
			return
		}

		KeywordUtil.logInfo('Overwrite confirmation did not appear.')
	}

	private void waitForNoOpenFilePopUp(Integer interval, Integer maxTimes, Integer count) {
		Integer safeInterval = interval == null || interval <= 0 ? 2 : interval
		Integer safeMaxTimes = maxTimes == null || maxTimes <= 0 ? 10 : maxTimes
		Integer safeCount = count == null ? 0 : count

		if (imageLoader.waitForImage('General', 'no', safeInterval)) {
			imageLoader.clickImageOrStop('General', 'no')
			Windows.delay(2)
			KeywordUtil.logInfo('Open file dialog closed with No.')
			return
		}

		if (imageLoader.waitForImage('General', 'noEn', safeInterval)) {
			imageLoader.clickImageOrStop('General', 'noEn')
			Windows.delay(2)
			KeywordUtil.logInfo('Open file dialog closed with NoEN.')
			return
		}

		if (safeCount < safeMaxTimes) {
			waitForNoOpenFilePopUp(safeInterval, safeMaxTimes, safeCount + 1)
			return
		}

		KeywordUtil.logInfo('Open file dialog did not appear. Continuing.')
	}

	private void clearFocusedField() {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_CONTROL)

		Windows.delay(1)

		robot.keyPress(KeyEvent.VK_BACK_SPACE)
		robot.keyRelease(KeyEvent.VK_BACK_SPACE)
	}

	private void pasteText(String text) {
		StringSelection selection = new StringSelection(text)
		Toolkit.getDefaultToolkit().getSystemClipboard().setContents(selection, null)

		Windows.delay(1)

		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_V)
		robot.keyRelease(KeyEvent.VK_V)
		robot.keyRelease(KeyEvent.VK_CONTROL)
	}
}
