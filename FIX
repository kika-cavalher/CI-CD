class authenticationKeywords {

	@Keyword
	def launchApplication(String targetEnvironment) {
		String environment = normalizeEnvironment(targetEnvironment)

		if (System.getProperty('user.name') == GlobalVariable.username) {
			if (environment == 'REC') {
				String cmd = 'Powershell.exe -executionpolicy remotesigned -File D:\\setResolution.ps1'
				Runtime.getRuntime().exec(cmd)
			}

			Windows.startApplicationWithTitle(
					getShortcutPath(environment),
					getVersion(environment)
					)
		} else {
			if (environment == 'REC') {
				startWinAppDriver()
			}

			Windows.startApplication(getApplicationPath(environment))
		}
	}

	@Keyword
	def switchToVersionWindow(String targetEnvironment) {
		String environment = normalizeEnvironment(targetEnvironment)

		WindowsTestObject targetWindow = new WindowsTestObject()
		targetWindow.setLocatorStrategy(LocatorStrategy.NAME)
		targetWindow.setLocator(getVersion(environment))

		try {
			Windows.switchToDesktop()
			Windows.switchToWindow(targetWindow)

			KeywordUtil.logInfo("Successfully switched to window: " + targetWindow.getLocator())
			return true
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop(
					"Target window '" + targetWindow.getLocator() + "' was not found.\n" +
					"Check if the selected environment/version is correct.\n" +
					"Environment received: " + targetEnvironment + "\n" +
					"Normalized environment: " + environment + "\n" +
					"Expected window title: " + targetWindow.getLocator() + "\n" +
					"Original error: " + e.getMessage()
					)
			return false
		}
	}

	@Keyword
	def openEnvironmentSelector(String targetEnvironment) {
		String environment = normalizeEnvironment(targetEnvironment)

		if (!requiresEnvironmentSelection(environment)) {
			KeywordUtil.logInfo("Environment selector is not required for " + environment + ".")
			return
		}

		focusApplicationWindow(targetEnvironment)

		try {
			WindowsTestObject envObject = findWindowsObject('Login Page/optEnv')
			clickComboArrow(envObject)
			KeywordUtil.logInfo("Environment selector was focused/opened.")
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop(
					"Failed to focus/open environment selector.\n" +
					"Reason: " + e.getMessage()
					)
		}
	}

	@Keyword
	def selectEnvironment(String targetEnvironment) {
		String environment = normalizeEnvironment(targetEnvironment)

		if (!requiresEnvironmentSelection(environment)) {
			KeywordUtil.logInfo("Environment selection is not required for " + environment + ".")
			return
		}

		WindowsTestObject envObject = findWindowsObject('Login Page/optEnv')

		try {
			focusApplicationWindow(targetEnvironment)

			KeywordUtil.logInfo("Selecting environment: " + environment)

			if (trySelectEnvironmentByKatalonCombo(envObject, environment)) {
				KeywordUtil.logInfo("Environment selected using Windows.selectOptionByLabel: " + environment)
			} else {
				KeywordUtil.logInfo("selectOptionByLabel did not work. Trying real keyboard selection on first combo.")
				selectComboWithKeyboard(envObject, environment)
			}

			Windows.delay(2)

			if (!isConnectButtonEnabled()) {
				KeywordUtil.logInfo("Connect button is still not enabled. Trying to select the second environment combo as fallback.")
				selectSecondComboBelowFirst(envObject, environment)
				Windows.delay(2)
			}

			if (!isConnectButtonEnabled()) {
				KeywordUtil.markFailedAndStop(
						"Environment was not applied correctly.\n" +
						"The Connect button is still disabled after selecting: " + environment + "\n" +
						"Check if 'Login Page/optEnv' is pointing to the correct environment ComboBox."
						)
			}

			KeywordUtil.logInfo("Environment applied and Connect button is enabled: " + environment)

		} catch (Exception e) {
			KeywordUtil.markFailedAndStop(
					"Failed to select environment: " + environment + "\n" +
					"Reason: " + e.getMessage()
					)
		}
	}

	@Keyword
	def clickConnectIfPresent(String targetEnvironment) {
		focusApplicationWindow(targetEnvironment)

		WindowsTestObject connectButton = findWindowsObject('Login Page/btnConnecter')

		boolean isButtonPresent = Windows.verifyElementPresent(
				connectButton,
				5,
				FailureHandling.OPTIONAL
				)

		if (!isButtonPresent) {
			KeywordUtil.logInfo('Connect button was not present. Continuing test execution.')
			return
		}

		if (!isConnectButtonEnabled()) {
			KeywordUtil.markFailedAndStop(
					"Connect button is present but disabled.\n" +
					"The environment was probably not selected correctly."
					)
		}

		try {
			clickElementCenter(connectButton)
			KeywordUtil.logInfo('Connect button was clicked using center/offset click.')
			Windows.delay(5)

			if (isStillOnLoginScreen()) {
				KeywordUtil.logInfo('Login screen is still visible after click. Trying ENTER fallback.')
				pressKey(KeyEvent.VK_ENTER)
				Windows.delay(5)
			}

		} catch (Exception e) {
			KeywordUtil.logInfo('Center click failed. Trying normal click and ENTER fallback. Reason: ' + e.getMessage())

			try {
				Windows.click(connectButton, FailureHandling.OPTIONAL)
				Windows.delay(3)
			} catch (Exception ignored) {
			}

			pressKey(KeyEvent.VK_ENTER)
			Windows.delay(5)
		}
	}

	@Keyword
	def waitForMainScreen(String targetEnvironment) {
		boolean isMainScreenVisible = Windows.waitForElementPresent(
				findWindowsObject('General/txtSearch'),
				60,
				FailureHandling.OPTIONAL
				)

		if (isMainScreenVisible) {
			KeywordUtil.logInfo("Main screen loaded successfully.")
			Windows.delay(10)
			return
		}

		if (isStillOnLoginScreen()) {
			KeywordUtil.logInfo("Application is still on login screen. Trying Connect one final time.")

			focusApplicationWindow(targetEnvironment)

			if (isConnectButtonEnabled()) {
				try {
					clickElementCenter(findWindowsObject('Login Page/btnConnecter'))
					Windows.delay(7)
				} catch (Exception e) {
					KeywordUtil.logInfo("Final Connect click failed. Trying ENTER. Reason: " + e.getMessage())
					pressKey(KeyEvent.VK_ENTER)
					Windows.delay(7)
				}
			}
		}

		isMainScreenVisible = Windows.waitForElementPresent(
				findWindowsObject('General/txtSearch'),
				45,
				FailureHandling.OPTIONAL
				)

		if (!isMainScreenVisible) {
			KeywordUtil.markFailedAndStop(
					"Main screen was not loaded after login.\n" +
					"The application is still on the login screen or the connection was not completed.\n" +
					"Expected element was not found: General/txtSearch"
					)
		}

		KeywordUtil.logInfo("Main screen loaded successfully.")
		Windows.delay(10)
	}

	@Keyword
	def clickHomeTab(String targetEnvironment) {
		String home = new File(RunConfiguration.getProjectDir(), 'Images/General/Home.PNG').getAbsolutePath()
		String homeGrey = new File(RunConfiguration.getProjectDir(), 'Images/General/HomeGrey.PNG').getAbsolutePath()
		String homeWhite = new File(RunConfiguration.getProjectDir(), 'Images/General/HomeWhite.PNG').getAbsolutePath()

		try {
			def activeTab = WindowsImageKeywords.findImage(homeGrey)
			if (activeTab != null) {
				KeywordUtil.logInfo('Home tab is already active.')
				return
			}
		} catch (Exception e) {
		}

		try {
			def inactiveTab = WindowsImageKeywords.findImage(homeWhite)
			if (inactiveTab != null) {
				KeywordUtil.logInfo('Inactive Home tab found. Clicking to activate.')
				WindowsImageKeywords.clickImage(homeWhite)
				Windows.delay(5)
				return
			}
		} catch (Exception e) {
		}

		WindowsImageKeywords.clickImage(home)
		Windows.delay(5)
	}

	private boolean trySelectEnvironmentByKatalonCombo(WindowsTestObject envObject, String environment) {
		List<String> labels = getEnvironmentLabelCandidates(environment)

		for (String label : labels) {
			try {
				KeywordUtil.logInfo("Trying selectOptionByLabel with label: " + label)

				Windows.selectOptionByLabel(
						envObject,
						label,
						3,
						FailureHandling.OPTIONAL
						)

				Windows.delay(2)
				pressKey(KeyEvent.VK_TAB)
				Windows.delay(1)

				if (isConnectButtonEnabled()) {
					return true
				}
			} catch (Exception e) {
				KeywordUtil.logInfo("selectOptionByLabel failed for label '" + label + "'. Reason: " + e.getMessage())
			}
		}

		return false
	}

	private void selectComboWithKeyboard(WindowsTestObject comboObject, String environment) {
		int envIndex = getEnvironmentIndex(environment)

		clickComboArrow(comboObject)
		Windows.delay(1)

		typeText(environment)
		Windows.delay(1)

		pressKey(KeyEvent.VK_ENTER)
		Windows.delay(1)

		pressKey(KeyEvent.VK_TAB)
		Windows.delay(2)

		if (isConnectButtonEnabled()) {
			return
		}

		KeywordUtil.logInfo("Typing environment did not enable Connect. Trying arrow navigation.")

		clickComboArrow(comboObject)
		Windows.delay(1)

		pressKey(KeyEvent.VK_HOME)
		Windows.delay(1)

		for (int i = 1; i < envIndex; i++) {
			pressKey(KeyEvent.VK_DOWN)
			Windows.delay(300 / 1000)
		}

		pressKey(KeyEvent.VK_ENTER)
		Windows.delay(1)

		pressKey(KeyEvent.VK_TAB)
		Windows.delay(2)
	}

	private void selectSecondComboBelowFirst(WindowsTestObject firstComboObject, String environment) {
		def rect = Windows.getElementRect(firstComboObject, FailureHandling.OPTIONAL)

		int x = rect.getX() + rect.getWidth() - 8
		int y = rect.getY() + rect.getHeight() + 8 + Math.floor(rect.getHeight() / 2).intValue()

		mouseClick(x, y)
		Windows.delay(1)

		typeText(environment)
		Windows.delay(1)

		pressKey(KeyEvent.VK_ENTER)
		Windows.delay(1)

		pressKey(KeyEvent.VK_TAB)
		Windows.delay(2)

		if (isConnectButtonEnabled()) {
			return
		}

		KeywordUtil.logInfo("Typing environment on second combo did not enable Connect. Trying arrow navigation on second combo.")

		mouseClick(x, y)
		Windows.delay(1)

		pressKey(KeyEvent.VK_HOME)
		Windows.delay(1)

		int envIndex = getEnvironmentIndex(environment)

		for (int i = 1; i < envIndex; i++) {
			pressKey(KeyEvent.VK_DOWN)
			Windows.delay(300 / 1000)
		}

		pressKey(KeyEvent.VK_ENTER)
		Windows.delay(1)

		pressKey(KeyEvent.VK_TAB)
		Windows.delay(2)
	}

	private void clickComboArrow(WindowsTestObject comboObject) {
		def rect = Windows.getElementRect(comboObject, FailureHandling.OPTIONAL)

		int offsetX = Math.max(rect.getWidth() - 8, 1)
		int offsetY = Math.max(Math.floor(rect.getHeight() / 2).intValue(), 1)

		try {
			Windows.clickElementOffset(
					comboObject,
					offsetX,
					offsetY,
					FailureHandling.OPTIONAL
					)
			Windows.delay(1)
		} catch (Exception e) {
			KeywordUtil.logInfo("clickElementOffset failed. Trying Robot click. Reason: " + e.getMessage())

			int x = rect.getX() + offsetX
			int y = rect.getY() + offsetY

			mouseClick(x, y)
			Windows.delay(1)
		}
	}

	private void clickElementCenter(WindowsTestObject object) {
		def rect = Windows.getElementRect(object, FailureHandling.OPTIONAL)

		int offsetX = Math.max(Math.floor(rect.getWidth() / 2).intValue(), 1)
		int offsetY = Math.max(Math.floor(rect.getHeight() / 2).intValue(), 1)

		try {
			Windows.clickElementOffset(
					object,
					offsetX,
					offsetY,
					FailureHandling.OPTIONAL
					)
		} catch (Exception e) {
			KeywordUtil.logInfo("clickElementOffset center failed. Trying Robot click. Reason: " + e.getMessage())

			int x = rect.getX() + offsetX
			int y = rect.getY() + offsetY

			mouseClick(x, y)
		}
	}

	private void focusApplicationWindow(String targetEnvironment) {
		String environment = normalizeEnvironment(targetEnvironment)

		WindowsTestObject targetWindow = new WindowsTestObject()
		targetWindow.setLocatorStrategy(LocatorStrategy.NAME)
		targetWindow.setLocator(getVersion(environment))

		try {
			Windows.switchToDesktop()
			Windows.switchToWindow(targetWindow)
			Windows.delay(1)
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop(
					"Could not focus application window.\n" +
					"Expected window title: " + getVersion(environment) + "\n" +
					"Reason: " + e.getMessage()
					)
		}
	}

	private boolean isConnectButtonEnabled() {
		WindowsTestObject connectButton = findWindowsObject('Login Page/btnConnecter')

		boolean isButtonPresent = Windows.verifyElementPresent(
				connectButton,
				2,
				FailureHandling.OPTIONAL
				)

		if (!isButtonPresent) {
			return false
		}

		String enabled = safeGetAttribute(connectButton, "IsEnabled")

		if (enabled == null || enabled.trim().isEmpty()) {
			enabled = safeGetAttribute(connectButton, "Enabled")
		}

		if (enabled == null || enabled.trim().isEmpty()) {
			KeywordUtil.logInfo("Could not read Connect button enabled attribute. Assuming it is clickable because it is present.")
			return true
		}

		KeywordUtil.logInfo("Connect button enabled attribute: " + enabled)

		return enabled.equalsIgnoreCase("true")
	}

	private String safeGetAttribute(WindowsTestObject object, String attributeName) {
		try {
			return Windows.getAttribute(
					object,
					attributeName,
					FailureHandling.OPTIONAL
					)
		} catch (Exception e) {
			return null
		}
	}

	private boolean isStillOnLoginScreen() {
		return Windows.verifyElementPresent(
				findWindowsObject('Login Page/btnConnecter'),
				2,
				FailureHandling.OPTIONAL
				)
	}

	private void pressKey(int keyCode) {
		Robot robot = new Robot()
		robot.setAutoDelay(250)

		robot.keyPress(keyCode)
		robot.keyRelease(keyCode)
	}

	private void typeText(String text) {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		for (char character : text.toUpperCase().toCharArray()) {
			int keyCode = KeyEvent.getExtendedKeyCodeForChar(character)

			if (keyCode == KeyEvent.VK_UNDEFINED) {
				KeywordUtil.logInfo("Could not type character: " + character)
				continue
			}

			robot.keyPress(keyCode)
			robot.keyRelease(keyCode)
		}
	}

	private void mouseClick(int x, int y) {
		Robot robot = new Robot()
		robot.setAutoDelay(200)

		robot.mouseMove(x, y)
		robot.mousePress(InputEvent.BUTTON1_DOWN_MASK)
		robot.mouseRelease(InputEvent.BUTTON1_DOWN_MASK)
	}

	private List<String> getEnvironmentLabelCandidates(String environment) {
		switch (environment) {
			case 'PROD':
				return ['PROD', 'Prod', 'prod']
			case 'PRD':
				return ['PRD', 'PRD ', 'PROD', 'Prod']
			case 'PREX':
				return ['PREX', 'Prex', 'prex']
			case 'REC2':
				return ['REC2', 'Rec2', 'rec2']
			case 'REC':
				return ['REC', 'Rec', 'rec']
			case 'DEV2':
				return ['DEV2', 'Dev2', 'dev2']
			case 'DEV':
				return ['DEV', 'Dev', 'dev']
			default:
				return [environment, environment.capitalize(), environment.toLowerCase()]
		}
	}

	private String normalizeEnvironment(String targetEnvironment) {
		if (targetEnvironment == null || targetEnvironment.trim().isEmpty()) {
			return 'REC'
		}

		return targetEnvironment.trim().toUpperCase()
	}

	private boolean requiresEnvironmentSelection(String environment) {
		return environment != 'PRD'
	}

	private int getEnvironmentIndex(String environment) {
		switch (environment) {
			case 'PROD':
				return 1
			case 'PREX':
				return 2
			case 'REC2':
				return 3
			case 'REC':
				return 4
			case 'DEV2':
				return 5
			case 'DEV':
				return 6
			default:
				return 4
		}
	}

	private String getVersion(String environment) {
		switch (environment) {
			case 'PRD':
				return GlobalVariable.versionProd
			default:
				return GlobalVariable.version
		}
	}

	private String getShortcutPath(String environment) {
		switch (environment) {
			case 'PRD':
				return 'D:\\RunAseMatchPRD\\eMatch.lnk'
			default:
				return 'D:\\RunAseMatchReq\\eMatch.lnk'
		}
	}

	private String getApplicationPath(String environment) {
