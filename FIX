    @Keyword
    String getInstalledExePath() {
        String currentUser = getCurrentWindowsUser()

        List<String> candidates = [
            "C:\\Users\\${currentUser}\\AppData\\Local\\Apps\\2.0",
            "C:\\Users\\${currentUser}\\AppData\\Local\\Microsoft\\Windows\\INetCache\\IE"
        ]

        for (String basePath : candidates) {
            File baseDir = new File(basePath)
            if (!baseDir.exists()) {
                continue
            }

            List<File> matches = []
            baseDir.eachFileRecurse { File file ->
                try {
                    if (file.isFile() && file.name.equalsIgnoreCase('IXIS.eMatch.IHM.exe')) {
                        matches << file
                    }
                } catch (Throwable ignored) {
                }
            }

            if (!matches.isEmpty()) {
                matches.sort { a, b -> b.lastModified() <=> a.lastModified() }
                String resolved = matches.first().absolutePath
                KeywordUtil.logInfo("Installed exe path resolved: ${resolved}")
                return resolved
            }
        }

        return ''
    }

