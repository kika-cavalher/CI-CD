import java.awt.Dimension
import java.awt.GraphicsDevice
import java.awt.GraphicsEnvironment
import java.awt.Rectangle
import java.awt.Robot
import java.awt.Toolkit
import java.awt.image.BufferedImage
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale

import javax.imageio.ImageIO

class JiraImagesEvidence {

	private static final ThreadLocal<String> CURRENT_CASE_ID = new ThreadLocal<String>()

	private static final SimpleDateFormat FILE_TS =
			new SimpleDateFormat('yyyyMMdd_HHmmss_SSS', Locale.ENGLISH)

	private static final String INDEX_FILE_NAME = 'jira_images_evidence.tsv'

	@Keyword
	void startCase(String caseId) {
		CURRENT_CASE_ID.set(safe(caseId))
	}

	@Keyword
	String autoFailure(String caseId = '') {
		String effectiveCaseId = !safe(caseId).isEmpty() ? safe(caseId) : safe(CURRENT_CASE_ID.get())

		if (effectiveCaseId.isEmpty()) {
			KeywordUtil.logInfo('Evidence capture skipped because caseId is empty.')
			return ''
		}

		File reportFolder = resolveCurrentReportFolder()
		File evidenceDir = new File(reportFolder, 'Evidences')

		if (!evidenceDir.exists()) {
			evidenceDir.mkdirs()
		}

		String fileName =
				FILE_TS.format(new Date()) + '_' +
				sanitizeCaseId(effectiveCaseId) +
				'_auto_failure.png'

		File target = new File(evidenceDir, fileName)

		File savedFile = captureFromDriver(target)

		if (savedFile == null || !savedFile.exists() || savedFile.length() == 0L) {
			savedFile = capturePrimaryScreen(target)
		}

		if (savedFile == null || !savedFile.exists() || savedFile.length() == 0L) {
			KeywordUtil.logInfo('Evidence capture failed. No image was saved for case: ' + effectiveCaseId)
			return ''
		}

		KeywordUtil.logInfo('Evidence saved: ' + savedFile.absolutePath)

		appendIndex(reportFolder, effectiveCaseId, savedFile.absolutePath)

		try {
			CustomKeywords.'jiraIntegration.JiraReportSteps.evidence'(savedFile.absolutePath)
		} catch (Throwable t) {
			KeywordUtil.logInfo('Could not append evidence to trace: ' + safe(t.message))
		}

		return savedFile.absolutePath
	}

	@Keyword
	void finishCase() {
		CURRENT_CASE_ID.remove()
	}

	private File captureFromDriver(File target) {
		try {
			def driver = WindowsDriverFactory.getWindowsDriver()

			if (driver == null) {
				KeywordUtil.logInfo('Evidence capture by driver skipped: WindowsDriver is null.')
				return null
			}

			if (!(driver instanceof TakesScreenshot)) {
				KeywordUtil.logInfo('Evidence capture by driver skipped: current driver does not implement TakesScreenshot.')
				return null
			}

			byte[] bytes = ((TakesScreenshot) driver).getScreenshotAs(OutputType.BYTES)

			if (bytes == null || bytes.length == 0) {
				KeywordUtil.logInfo('Evidence capture by driver returned empty bytes.')
				return null
			}

			if (target.parentFile != null && !target.parentFile.exists()) {
				target.parentFile.mkdirs()
			}

			target.withOutputStream { os ->
				os.write(bytes)
			}

			return target.exists() && target.length() > 0L ? target : null
		} catch (Throwable t) {
			KeywordUtil.logInfo('Evidence capture by driver failed: ' + safe(t.message))
			return null
		}
	}

	private File capturePrimaryScreen(File target) {
		try {
			Rectangle rect = resolvePrimaryScreenBounds()
			Robot robot = new Robot()
			BufferedImage image = robot.createScreenCapture(rect)

			if (target.parentFile != null && !target.parentFile.exists()) {
				target.parentFile.mkdirs()
			}

			ImageIO.write(image, 'png', target)

			return target.exists() && target.length() > 0L ? target : null
		} catch (Throwable t) {
			KeywordUtil.logInfo('Evidence capture by primary screen failed: ' + safe(t.message))
			return null
		}
	}

	private Rectangle resolvePrimaryScreenBounds() {
		try {
			GraphicsDevice device = GraphicsEnvironment.getLocalGraphicsEnvironment().getDefaultScreenDevice()
			Rectangle bounds = device != null ? device.getDefaultConfiguration().getBounds() : null

			if (bounds != null && bounds.width > 0 && bounds.height > 0) {
				return bounds
			}
		} catch (Throwable ignored) {
		}

		Dimension size = Toolkit.getDefaultToolkit().getScreenSize()
		return new Rectangle(0, 0, size.width, size.height)
	}

	private File resolveCurrentReportFolder() {
		String reportFolderPath = safe(RunConfiguration.getReportFolder())

		if (!reportFolderPath.isEmpty()) {
			File reportFolder = new File(reportFolderPath)
			if (!reportFolder.exists()) {
				reportFolder.mkdirs()
			}
			return reportFolder
		}

		File fallback = new File(RunConfiguration.getProjectDir(), 'Reports')
		if (!fallback.exists()) {
			fallback.mkdirs()
		}

		return fallback
	}

	private void appendIndex(File reportFolder, String caseId, String absolutePath) {
		try {
			File indexFile = new File(reportFolder, INDEX_FILE_NAME)

			if (indexFile.parentFile != null && !indexFile.parentFile.exists()) {
				indexFile.parentFile.mkdirs()
			}

			String line =
					System.currentTimeMillis() + '\t' +
					safe(caseId) + '\t' +
					safe(absolutePath) +
					System.lineSeparator()

			indexFile.append(line, 'UTF-8')
		} catch (Throwable t) {
			KeywordUtil.logInfo('Could not update evidence index: ' + safe(t.message))
		}
	}

	private String sanitizeCaseId(String caseId) {
		String cleaned = safe(caseId)
				.replace('\\', '_')
				.replace('/', '_')
				.replace(':', '_')
				.replace('*', '_')
				.replace('?', '_')
				.replace('"', '_')
				.replace('<', '_')
				.replace('>', '_')
				.replace('|', '_')
				.replace(' ', '_')

		return cleaned.length() > 140 ? cleaned.substring(0, 140) : cleaned
	}

	private String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}
}
