package pageObject

import java.awt.Robot
import java.awt.event.InputEvent
import java.awt.event.KeyEvent

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.exception.StepFailedException
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.testobject.WindowsTestObject.LocatorStrategy
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import commands.WindowsObjectLoader
import internal.GlobalVariable

class authenticationKeywords {

	private static boolean fatalWrongVersionDetected = false
	private static String fatalWrongVersionMessage = ''

	@Keyword
	def launchApplication(String targetEnvironment) {
		stopImmediatelyIfWrongVersionWasAlreadyDetected()

		String environment = normalizeEnvironment(targetEnvironment)

		if (System.getProperty('user.name') == GlobalVariable.username) {
			if (environment == 'REC') {
				String cmd = 'Powershell.exe -executionpolicy remotesigned -File D:\\setResolution.ps1'
				Runtime.getRuntime().exec(cmd)
			}

			Windows.startApplicationWithTitle(
					getShortcutPath(environment),
					getVersion(environment)
					)
		} else {
			if (environment == 'REC') {
				startWinAppDriver()
			}

			Windows.startApplication(getApplicationPath(environment))
		}
	}

	@Keyword
	def validateProductionVersionOnly(String targetEnvironment) {
		stopImmediatelyIfWrongVersionWasAlreadyDetected()

		String environment = normalizeEnvironment(targetEnvironment)

		if (!isProductionEnvironment(environment)) {
			KeywordUtil.markFailedAndStop(
					"validateProductionVersionOnly can only be used for PRD/PROD.\n" +
					"Received environment: " + environment
					)
		}

		validateCorrectVersionWindowOrStop(environment)

		saveCurrentEnvironment(environment)

		KeywordUtil.logInfo(
				"PRD version validated successfully. " +
				"Credential modal, environment selector and connect button are not required for PRD."
				)
	}

	@Keyword
	def switchToVersionWindow(String targetEnvironment) {
		stopImmediatelyIfWrongVersionWasAlreadyDetected()

		String environment = normalizeEnvironment(targetEnvironment)
		String expectedVersion = getVersion(environment)

		WindowsTestObject targetWindow = new WindowsTestObject()
		targetWindow.setLocatorStrategy(LocatorStrategy.NAME)
		targetWindow.setLocator(expectedVersion)

		try {
			Windows.switchToDesktop()

			boolean windowExists = Windows.verifyElementPresent(
					targetWindow,
					20,
					FailureHandling.OPTIONAL
					)

			if (!windowExists) {
				throw new StepFailedException("Expected version window was not found within timeout.")
			}

			Windows.switchToWindow(targetWindow)

			KeywordUtil.logInfo("Successfully switched to eMatch version window: " + expectedVersion)
			return true
		} catch (Exception e) {
			stopBecauseWrongVersion(environment, expectedVersion, e)
		}
	}

	@Keyword
	def openEnvironmentSelector(String targetEnvironment) {
		stopImmediatelyIfWrongVersionWasAlreadyDetected()

		String environment = normalizeEnvironment(targetEnvironment)

		if (isProductionEnvironment(environment)) {
			KeywordUtil.logInfo("PRD does not use credential modal or environment selector. Skipping environment selector.")
			return
		}

		validateCorrectVersionWindowOrStop(environment)

		tryFocusApplicationWindow(targetEnvironment, true)

		if (!isLoginScreenVisibleSafely()) {
			KeywordUtil.markFailedAndStop(
					"Login screen is not visible, but it was expected before selecting environment.\n" +
					"Environment: " + environment
					)
		}

		WindowsTestObject environmentCombo = WindowsObjectLoader.getObject('authentication', 'environmentCombo')

		boolean isComboPresent = Windows.verifyElementPresent(
				environmentCombo,
				10,
				FailureHandling.OPTIONAL
				)

		if (!isComboPresent) {
			KeywordUtil.markFailedAndStop(
					"Environment combo was not found by NAME.\n" +
					"Expected Name: Environnement eMatch\n" +
					"Environment: " + environment
					)
		}

		clickElementCenterByCoordinates(environmentCombo)
		Windows.delay(1)

		KeywordUtil.logInfo("Environment eMatch combo focused.")
	}

	@Keyword
	def selectEnvironment(String targetEnvironment) {
		stopImmediatelyIfWrongVersionWasAlreadyDetected()

		String environment = normalizeEnvironment(targetEnvironment)

		if (isProductionEnvironment(environment)) {
			KeywordUtil.logInfo("PRD does not use credential modal or environment selection. Skipping environment selection.")
			saveCurrentEnvironment(environment)
			return
		}

		validateCorrectVersionWindowOrStop(environment)

		tryFocusApplicationWindow(targetEnvironment, true)

		if (!isLoginScreenVisibleSafely()) {
			KeywordUtil.markFailedAndStop(
					"Login screen is not visible, but it was expected for environment selection.\n" +
					"Environment: " + environment
					)
		}

		WindowsTestObject environmentCombo = WindowsObjectLoader.getObject('authentication', 'environmentCombo')

		boolean isComboPresent = Windows.verifyElementPresent(
				environmentCombo,
				10,
				FailureHandling.OPTIONAL
				)

		if (!isComboPresent) {
			KeywordUtil.markFailedAndStop(
					"Environment combo was not found by NAME.\n" +
					"Expected Name: Environnement eMatch\n" +
					"Environment: " + environment
					)
		}

		KeywordUtil.logInfo("Selecting only Environment eMatch: " + environment)

		clickElementCenterByCoordinates(environmentCombo)
		Windows.delay(1)

		selectFocusedEMatchComboByKeyboard(environment)

		saveCurrentEnvironment(environment)

		KeywordUtil.logInfo("Environment eMatch selected: " + environment)
	}

	@Keyword
	def clickConnectIfPresent(String targetEnvironment) {
		stopImmediatelyIfWrongVersionWasAlreadyDetected()

		String environment = normalizeEnvironment(targetEnvironment)

		if (isProductionEnvironment(environment)) {
			KeywordUtil.logInfo("PRD does not use connect button. Skipping connect action.")
			saveCurrentEnvironment(environment)
			return
		}

		validateCorrectVersionWindowOrStop(environment)

		tryFocusApplicationWindow(targetEnvironment, true)

		if (!isLoginScreenVisibleSafely()) {
			KeywordUtil.markFailedAndStop(
					"Login screen is not visible before clicking connect.\n" +
					"Environment: " + environment
					)
		}

		WindowsTestObject connectButton = WindowsObjectLoader.getObject('authentication', 'connectButton')

		boolean isButtonPresent = Windows.verifyElementPresent(
				connectButton,
				10,
				FailureHandling.OPTIONAL
				)

		if (!isButtonPresent) {
			KeywordUtil.markFailedAndStop(
					"Connect button was not found by NAME.\n" +
					"Expected Name: Se connecter\n" +
					"Environment: " + environment
					)
		}

		try {
			clickElementCenterByCoordinates(connectButton)
		} catch (Exception e) {
			KeywordUtil.logInfo("Coordinate click failed. Trying normal click. Reason: " + e.getMessage())
			Windows.click(connectButton, FailureHandling.OPTIONAL)
		}

		Windows.delay(8)

		if (isLoginScreenVisibleSafely()) {
			KeywordUtil.markFailedAndStop(
					"Connect button was clicked, but login screen is still visible.\n" +
					"Environment: " + environment
					)
		}

		saveCurrentEnvironment(environment)

		KeywordUtil.logInfo("Connect button clicked and login screen closed.")
	}

	@Keyword
	def waitForMainScreen(String targetEnvironment) {
		stopImmediatelyIfWrongVersionWasAlreadyDetected()

		String environment = normalizeEnvironment(targetEnvironment)

		validateCorrectVersionWindowOrStop(environment)

		boolean loginClosed = waitUntilLoginScreenIsClosed(60)

		if (!loginClosed) {
			KeywordUtil.markFailedAndStop(
					"Main screen was not validated after login.\n" +
					"Login screen is still visible.\n" +
					"Environment: " + environment
					)
		}

		saveCurrentEnvironment(environment)

		KeywordUtil.logInfo(
				"Main screen validated because login screen is closed.\n" +
				"Current environment saved from targetEnvironment: " + environment
				)

		Windows.delay(3)
	}

	@Keyword
	def multiFormatScreen(String targetEnvironment) {
		stopImmediatelyIfWrongVersionWasAlreadyDetected()
		waitForMainScreen(targetEnvironment)
	}

	@Keyword
	def clickHomeTab(String targetEnvironment) {
		stopImmediatelyIfWrongVersionWasAlreadyDetected()

		String environment = normalizeEnvironment(targetEnvironment)

		validateCorrectVersionWindowOrStop(environment)

		WindowsTestObject homeTab = WindowsObjectLoader.getObject('common', 'homeTab')

		boolean isHomePresent = Windows.verifyElementPresent(
				homeTab,
				10,
				FailureHandling.OPTIONAL
				)

		if (!isHomePresent) {
			KeywordUtil.markFailedAndStop(
					"Home tab was not found by NAME.\n" +
					"Expected Name: Modules\n" +
					"Environment: " + environment
					)
		}

		try {
			clickElementCenterByCoordinates(homeTab)
		} catch (Exception e) {
			KeywordUtil.logInfo("Coordinate click on Home tab failed. Trying normal click. Reason: " + e.getMessage())
			Windows.click(homeTab, FailureHandling.OPTIONAL)
		}

		saveCurrentEnvironment(environment)

		KeywordUtil.logInfo("Home tab Modules clicked.")
		Windows.delay(1)
	}

	private void validateCorrectVersionWindowOrStop(String environment) {
		stopImmediatelyIfWrongVersionWasAlreadyDetected()

		String expectedVersion = getVersion(environment)

		WindowsTestObject targetWindow = new WindowsTestObject()
		targetWindow.setLocatorStrategy(LocatorStrategy.NAME)
		targetWindow.setLocator(expectedVersion)

		try {
			Windows.switchToDesktop()

			boolean windowExists = Windows.verifyElementPresent(
					targetWindow,
					20,
					FailureHandling.OPTIONAL
					)

			if (!windowExists) {
				throw new StepFailedException("Expected version window was not found within timeout.")
			}

			Windows.switchToWindow(targetWindow)
			Windows.delay(1)

			KeywordUtil.logInfo("Correct eMatch version window found: " + expectedVersion)
		} catch (Exception e) {
			stopBecauseWrongVersion(environment, expectedVersion, e)
		}
	}

	private void stopBecauseWrongVersion(String environment, String expectedVersion, Exception e) {
		fatalWrongVersionDetected = true

		fatalWrongVersionMessage =
				"WRONG EMATCH VERSION DETECTED.\n" +
				"The expected eMatch version window was not found.\n" +
				"Execution will be stopped now.\n" +
				"The login will not be restarted because the application version is wrong.\n\n" +
				"Environment: " + environment + "\n" +
				"Expected version/window title: " + expectedVersion + "\n" +
				"Original error: " + e.getMessage()

		KeywordUtil.markFailed(fatalWrongVersionMessage)

		throw new StepFailedException(fatalWrongVersionMessage)
	}

	private void stopImmediatelyIfWrongVersionWasAlreadyDetected() {
		if (fatalWrongVersionDetected) {
			KeywordUtil.markFailed(fatalWrongVersionMessage)
			throw new StepFailedException(fatalWrongVersionMessage)
		}
	}

	private boolean waitUntilLoginScreenIsClosed(int timeoutSeconds) {
		int elapsedSeconds = 0

		while (elapsedSeconds < timeoutSeconds) {
			boolean loginVisible = isLoginScreenVisibleSafely()

			if (!loginVisible) {
				return true
			}

			Windows.delay(2)
			elapsedSeconds = elapsedSeconds + 2
		}

		return false
	}

	private boolean isLoginScreenVisibleSafely() {
		try {
			WindowsTestObject environmentCombo = WindowsObjectLoader.getObject('authentication', 'environmentCombo')

			boolean comboVisible = Windows.verifyElementPresent(
					environmentCombo,
					2,
					FailureHandling.OPTIONAL
					)

			if (comboVisible) {
				return true
			}

			WindowsTestObject connectButton = WindowsObjectLoader.getObject('authentication', 'connectButton')

			boolean buttonVisible = Windows.verifyElementPresent(
					connectButton,
					2,
					FailureHandling.OPTIONAL
					)

			return buttonVisible
		} catch (Exception e) {
			return false
		}
	}

	private void selectFocusedEMatchComboByKeyboard(String environment) {
		int downCount = getEMatchDownCount(environment)

		KeywordUtil.logInfo("Selecting Environment eMatch with keyboard. Environment: " + environment + ", down count: " + downCount)

		pressAltDown()
		Windows.delay(1)

		pressKey(KeyEvent.VK_HOME)
		Windows.delay(1)

		for (int i = 0; i < downCount; i++) {
			pressKey(KeyEvent.VK_DOWN)
			Windows.delay(1)
		}

		pressKey(KeyEvent.VK_ENTER)
		Windows.delay(2)

		KeywordUtil.logInfo("Environment eMatch selected with keyboard: " + environment)
	}

	private int getEMatchDownCount(String environment) {
		switch (environment) {
			case 'PRD':
			case 'PROD':
				return 0
			case 'PREX':
				return 1
			case 'REC2':
				return 2
			case 'REC':
				return 3
			case 'DEV2':
				return 4
			case 'DEV':
				return 5
			default:
				return 3
		}
	}

	private boolean isProductionEnvironment(String environment) {
		return environment == 'PRD' || environment == 'PROD'
	}

	private void pressAltDown() {
		Robot robot = new Robot()
		robot.setAutoDelay(200)

		robot.keyPress(KeyEvent.VK_ALT)
		robot.keyPress(KeyEvent.VK_DOWN)
		robot.keyRelease(KeyEvent.VK_DOWN)
		robot.keyRelease(KeyEvent.VK_ALT)
	}

	private void clickElementCenterByCoordinates(WindowsTestObject object) {
		def rect = Windows.getElementRect(object)

		int x = rect.getX() + Math.floor(rect.getWidth() / 2).intValue()
		int y = rect.getY() + Math.floor(getSafeHeight(rect) / 2).intValue()

		mouseClick(x, y)
	}

	private boolean tryFocusApplicationWindow(String targetEnvironment, boolean stopOnFailure) {
		stopImmediatelyIfWrongVersionWasAlreadyDetected()

		String environment = normalizeEnvironment(targetEnvironment)
		String expectedVersion = getVersion(environment)

		WindowsTestObject targetWindow = new WindowsTestObject()
		targetWindow.setLocatorStrategy(LocatorStrategy.NAME)
		targetWindow.setLocator(expectedVersion)

		try {
			Windows.switchToDesktop()

			boolean windowExists = Windows.verifyElementPresent(
					targetWindow,
					20,
					FailureHandling.OPTIONAL
					)

			if (!windowExists) {
				throw new StepFailedException("Expected application window was not found within timeout.")
			}

			Windows.switchToWindow(targetWindow)
			Windows.delay(1)
			return true
		} catch (Exception e) {
			if (stopOnFailure) {
				stopBecauseWrongVersion(environment, expectedVersion, e)
			}

			KeywordUtil.logInfo(
					"Could not focus application window, continuing without fatal error.\n" +
					"Expected window title: " + expectedVersion + "\n" +
					"Reason: " + e.getMessage()
					)

			return false
		}
	}

	private int getSafeHeight(def rect) {
		int height = rect.getHeight()

		if (height <= 0) {
			return 20
		}

		return height
	}

	private void pressKey(int keyCode) {
		Robot robot = new Robot()
		robot.setAutoDelay(200)

		robot.keyPress(keyCode)
		robot.keyRelease(keyCode)
	}

	private void mouseClick(int x, int y) {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.mouseMove(x, y)
		Thread.sleep(150)

		robot.mousePress(InputEvent.BUTTON1_DOWN_MASK)
		Thread.sleep(150)
		robot.mouseRelease(InputEvent.BUTTON1_DOWN_MASK)

		Thread.sleep(300)
	}

	private String normalizeEnvironment(String targetEnvironment) {
		if (targetEnvironment == null || targetEnvironment.trim().isEmpty()) {
			return 'REC'
		}

		return targetEnvironment.trim().toUpperCase()
	}

	private void saveCurrentEnvironment(String environment) {
		String normalizedEnvironment = normalizeEnvironment(environment)

		if (normalizedEnvironment == 'PROD') {
			normalizedEnvironment = 'PRD'
		}

		try {
			GlobalVariable.currentEnvironment = normalizedEnvironment
			KeywordUtil.logInfo("Current environment saved after login: " + normalizedEnvironment)
		} catch (Exception saveError) {
			KeywordUtil.logInfo(
					"Could not save GlobalVariable.currentEnvironment. " +
					"Create this variable in the execution profile if needed. Reason: " + saveError.getMessage()
					)
		}
	}

	private String getVersion(String environment) {
		switch (environment) {
			case 'PRD':
			case 'PROD':
				return GlobalVariable.versionProd
			default:
				return GlobalVariable.version
		}
	}

	private String getShortcutPath(String environment) {
		switch (environment) {
			case 'PRD':
			case 'PROD':
				return 'D:\\RunAseMatchPRD\\eMatch.lnk'
			default:
				return 'D:\\RunAseMatchReq\\eMatch.lnk'
		}
	}

