        String donutStyle = 'background: conic-gradient(' +
            STATUS_FAIL + ' 0 ' + failPercent + '%,' +
            STATUS_PASS + ' ' + failPercent + '% ' + (failPercent + passPercent) + '%,' +
            STATUS_SKIP + ' ' + (failPercent + passPercent) + '% 100%);'

        StringBuilder sb = new StringBuilder()
        sb.append('<div class="chart-side-wrap">')
        sb.append('<div class="chart-side-title">Execution Status</div>')
        sb.append('<div class="donut-card">')
        sb.append('<div class="donut" style="')
        sb.append(donutStyle)
        sb.append('">')
        sb.append('<div class="donut-center">')
        sb.append('<div class="donut-number">')
        sb.append(String.valueOf(view.totalCount))
        sb.append('</div>')
        sb.append('<div class="donut-label">Tests</div>')
        sb.append('</div>')
        sb.append('</div>')
        sb.append('</div>')

        sb.append('<div class="legend-list">')
        sb.append(buildLegendLine('Passed', STATUS_PASS, view.passedCount))
        sb.append(buildLegendLine('Failed', STATUS_FAIL, view.failedCount))
        sb.append(buildLegendLine('Skipped', STATUS_SKIP, view.skippedCount))
        sb.append('</div>')
        sb.append('</div>')

        return sb.toString()
    }

