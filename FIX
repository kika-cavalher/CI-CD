// ======================================================
	// CREATE FAVORITE
	// ======================================================
	
	@Keyword
	void createFavoriteFromCurrentModule(
		String favoriteTitle,
		Integer controlTimeoutSeconds,
		Integer popupTimeoutSeconds
	) {
	
		Integer controlTimeout = safeTimeout(
			controlTimeoutSeconds,
			5
		)
	
		Integer popupTimeout = safeTimeout(
			popupTimeoutSeconds,
			5
		)
	
		logStep(
			'CREATE FAVORITE',
			'Favorite title: ' + favoriteTitle
		)
	
		KeywordUtil.logInfo(
			'[FAVORITE][01] Method started.'
		)
	
		Windows.delay(2)
	
		// ==================================================
		// CLICK CREATE FAVORITE BY IMAGE
		// ==================================================
	
		KeywordUtil.logInfo(
			'[FAVORITE][02] Searching Create Favorite by image.\n' +
			'Image group: ' + GENERAL_IMAGE_GROUP + '\n' +
			'Image key: createFavoriteIcon\n' +
			'Timeout: ' + controlTimeout + ' seconds'
		)
	
		long imageSearchStart =
			System.currentTimeMillis()
	
		boolean createFavoriteClickedByImage =
			clickFirstVisibleImage(
				GENERAL_IMAGE_GROUP,
				[
					'createFavoriteIcon'
				],
				controlTimeout
			)
	
		KeywordUtil.logInfo(
			'[FAVORITE][03] Create Favorite image search finished.\n' +
			'Clicked by image: ' +
			createFavoriteClickedByImage +
			'\nDuration: ' +
			(System.currentTimeMillis() - imageSearchStart) +
			' ms'
		)
	
		// ==================================================
		// FALLBACK: CLICK BY WINDOWS OBJECT
		// ==================================================
	
		if (!createFavoriteClickedByImage) {
	
			KeywordUtil.logInfo(
				'[FAVORITE][04] Create Favorite image was not found.\n' +
				'Starting WindowsObject fallback.'
			)
	
			KeywordUtil.logInfo(
				'[FAVORITE][05] Loading WindowsObject: ' +
				'createFavoriteTopBar'
			)
	
			WindowsTestObject createFavoriteButton
	
			try {
				createFavoriteButton =
					object('createFavoriteTopBar')
			} catch (Throwable error) {
				takeEvidence(
					'GUI_CreateFavoriteObjectLoadError.png'
				)
	
				KeywordUtil.markFailedAndStop(
					'Create Favorite image was not found and the ' +
					'WindowsObject could not be loaded.\n' +
					'Image key: createFavoriteIcon\n' +
					'WindowsObject: createFavoriteTopBar\n' +
					'Error: ' + error.getMessage()
				)
	
				return
			}
	
			KeywordUtil.logInfo(
				'[FAVORITE][06] WindowsObject loaded successfully.'
			)
	
			KeywordUtil.logInfo(
				'[FAVORITE][07] Waiting for Create Favorite ' +
				'WindowsObject.\n' +
				'Timeout: ' + controlTimeout + ' seconds'
			)
	
			long objectSearchStart =
				System.currentTimeMillis()
	
			boolean createFavoritePresent =
				Windows.waitForElementPresent(
					createFavoriteButton,
					controlTimeout,
					FailureHandling.OPTIONAL
				)
	
			KeywordUtil.logInfo(
				'[FAVORITE][08] WindowsObject search finished.\n' +
				'Present: ' + createFavoritePresent +
				'\nDuration: ' +
				(System.currentTimeMillis() - objectSearchStart) +
				' ms'
			)
	
			if (!createFavoritePresent) {
				takeEvidence(
					'GUI_CreateFavoriteButtonNotFound.png'
				)
	
				KeywordUtil.markFailedAndStop(
					'Create Favorite was not found by image or ' +
					'WindowsObject.\n' +
					'Image key: createFavoriteIcon\n' +
					'WindowsObject: createFavoriteTopBar'
				)
	
				return
			}
	
			KeywordUtil.logInfo(
				'[FAVORITE][09] Clicking Create Favorite by ' +
				'WindowsObject.'
			)
	
			Windows.click(
				createFavoriteButton,
				FailureHandling.STOP_ON_FAILURE
			)
	
			KeywordUtil.logInfo(
				'[FAVORITE][10] Create Favorite clicked by ' +
				'WindowsObject.'
			)
	
		} else {
			KeywordUtil.logInfo(
				'[FAVORITE][10] Create Favorite clicked successfully ' +
				'by image.'
			)
		}
	
		Windows.delay(1)
	
		// ==================================================
		// FAVORITE TITLE
		// ==================================================
	
		KeywordUtil.logInfo(
			'[FAVORITE][11] Filling favorite title.\n' +
			'Image key: favoriteFilterField\n' +
			'Title: ' + favoriteTitle
		)
	
		typeOnImage(
			GUI_IMAGE_GROUP,
			'favoriteFilterField',
			favoriteTitle,
			controlTimeout
		)
	
		KeywordUtil.logInfo(
			'[FAVORITE][12] Favorite title filled successfully.'
		)
	
		Windows.delay(1)
	
		// ==================================================
		// SAVE FAVORITE
		// ==================================================
	
		KeywordUtil.logInfo(
			'[FAVORITE][13] Loading WindowsObject: ' +
			'favoriteSaveTopBar'
		)
	
		WindowsTestObject saveFavoriteButton =
			object('favoriteSaveTopBar')
	
		KeywordUtil.logInfo(
			'[FAVORITE][14] Waiting for Save Favorite button.\n' +
			'Timeout: ' + controlTimeout + ' seconds'
		)
	
		boolean saveFavoritePresent =
			Windows.waitForElementPresent(
				saveFavoriteButton,
				controlTimeout,
				FailureHandling.OPTIONAL
			)
	
		KeywordUtil.logInfo(
			'[FAVORITE][15] Save Favorite presence result: ' +
			saveFavoritePresent
		)
	
		if (!saveFavoritePresent) {
			takeEvidence(
				'GUI_SaveFavoriteButtonNotFound.png'
			)
	
			KeywordUtil.markFailedAndStop(
				'Save Favorite button was not found.'
			)
	
			return
		}
	
		String saveEnabled = safeText(
			Windows.getAttribute(
				saveFavoriteButton,
				'IsEnabled',
				FailureHandling.OPTIONAL
			)
		)
	
		KeywordUtil.logInfo(
			'[FAVORITE][16] Save Favorite IsEnabled: ' +
			saveEnabled
		)
	
		if (!saveEnabled.equalsIgnoreCase('True')) {
			takeEvidence(
				'GUI_SaveFavoriteButtonDisabled.png'
			)
	
			KeywordUtil.markFailedAndStop(
				'Save Favorite button is disabled after filling ' +
				'the title.\n' +
				'IsEnabled: ' + saveEnabled
			)
	
			return
		}
	
		KeywordUtil.logInfo(
			'[FAVORITE][17] Clicking Save Favorite button.'
		)
	
		Windows.click(
			saveFavoriteButton,
			FailureHandling.STOP_ON_FAILURE
		)
	
		KeywordUtil.logInfo(
			'[FAVORITE][18] Save Favorite button clicked.'
		)
	
		// ==================================================
		// CONFIRMATION
		// ==================================================
	
		KeywordUtil.logInfo(
			'[FAVORITE][19] Waiting for favorite confirmation.'
		)
	
		String modalDetection =
			waitForFavoriteConfirmation(
				favoriteTitle,
				popupTimeout
			)
	
		KeywordUtil.logInfo(
			'[FAVORITE][20] Confirmation detection result: ' +
			modalDetection
		)
	
		if (modalDetection.isEmpty()) {
			takeEvidence(
				'GUI_FavoriteConfirmationModalNotFound.png'
			)
	
			KeywordUtil.markFailedAndStop(
				'Favorite confirmation modal was not found.\n' +
				'Favorite: ' + favoriteTitle
			)
	
			return
		}
	
		takeEvidence(
			'GUI_FavoriteConfirmationModal.png'
		)
	
		Windows.delay(5)
	
		KeywordUtil.logInfo(
			'[FAVORITE][21] Closing favorite confirmation.'
		)
	
		boolean confirmationClosed =
			clickFirstVisibleImage(
				GENERAL_IMAGE_GROUP,
				[
					'okModal',
					'okModal2Version'
				],
				3
			)
	
		if (!confirmationClosed) {
			KeywordUtil.logInfo(
				'[FAVORITE][22] OK image was not found. ' +
				'Pressing ENTER.'
			)
	
			pressKeyboardKey(
				KeyEvent.VK_ENTER
			)
		}
	
		Windows.delay(2)
	
		KeywordUtil.markPassed(
			'Favorite created successfully.\n' +
			'Title: ' + favoriteTitle + '\n' +
			'Confirmation detected by: ' + modalDetection
		)
	}
