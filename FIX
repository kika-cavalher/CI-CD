	boolean isLockedOrUnreadable(File file) {
		if (file == null || !file.exists() || !file.isFile()) {
			return true
		}

		RandomAccessFile raf = null
		try {
			raf = new RandomAccessFile(file, 'r')
			return false
		} catch (Exception ignored) {
			return true
		} finally {
			try { raf?.close() } catch (Exception ignored) {}
		}
	}

	boolean shouldSkipReportEntry(File file) {
		String name = safe(file?.name).toLowerCase()

		if (isBlank(name)) return true
		if (name == safe(RESULT_ZIP_NAME).toLowerCase()) return true
		if (name == safe(EVIDENCE_ZIP_NAME).toLowerCase()) return true
		if (name == safe(GAIA_REPORT_FILE_NAME).toLowerCase()) return true
		if (name == safe(EVIDENCE_FOLDER_NAME).toLowerCase()) return true
		if (name == 'videos') return true
		if (name == 'requests') return true
		if (name.endsWith('.lck')) return true
		if (name.endsWith('.lock')) return true

		return false
	}

	boolean shouldSkipEvidenceEntry(File file) {
		String name = safe(file?.name).toLowerCase()

		if (isBlank(name)) return true
		if (name == safe(EVIDENCE_ZIP_NAME).toLowerCase()) return true
		if (name.endsWith('.lck')) return true
		if (name.endsWith('.lock')) return true

		return false
	}

	void addFileToZip(ZipOutputStream output, File rootFolder, File currentFile) {
		if (currentFile == null || !currentFile.exists()) {
			return
		}

		if (currentFile.isDirectory()) {
			File[] children = currentFile.listFiles()
			if (children != null) {
				children.each { child ->
					addFileToZip(output, rootFolder, child)
				}
			}
			return
		}

		if (isLockedOrUnreadable(currentFile)) {
			KeywordUtil.logInfo("Skipping locked file from ZIP: ${currentFile.absolutePath}")
			return
		}

		String relativePath = rootFolder.toURI().relativize(currentFile.toURI()).getPath()
		if (isBlank(relativePath)) {
			return
		}

		FileInputStream input = null
		try {
			output.putNextEntry(new ZipEntry(relativePath))
			input = new FileInputStream(currentFile)

			byte[] buffer = new byte[8192]
			int readBytes = 0

			while ((readBytes = input.read(buffer)) != -1) {
				output.write(buffer, 0, readBytes)
			}

			output.closeEntry()
			KeywordUtil.logInfo("Adding file to ZIP: ${relativePath}")
		} catch (Exception e) {
			try { output.closeEntry() } catch (Exception ignored) {}
			KeywordUtil.logInfo("Skipping file from ZIP due to error: ${currentFile.absolutePath} | ${e.message}")
		} finally {
			try { input?.close() } catch (Exception ignored) {}
		}
	}

	String zipReports() {
		String reportFolder = getResolvedReportFolder()
		File sourceFolder = new File(reportFolder)

		if (!sourceFolder.exists() || !sourceFolder.isDirectory()) {
			KeywordUtil.logInfo("Report ZIP skipped. Folder not found: ${reportFolder}")
			return ''
		}

		String zipPath = reportFolder + File.separator + RESULT_ZIP_NAME
		File zipFile = new File(zipPath)
		if (zipFile.exists()) {
			zipFile.delete()
		}

		ZipOutputStream output = null
		try {
			output = new ZipOutputStream(new FileOutputStream(zipFile))

			File[] children = sourceFolder.listFiles()
			if (children != null) {
				children.each { file ->
					if (!shouldSkipReportEntry(file)) {
						addFileToZip(output, sourceFolder, file)
					}
				}
			}

			KeywordUtil.logInfo("Report ZIP created successfully: ${zipPath}")
			return zipPath
		} finally {
			try { output?.close() } catch (Exception ignored) {}
		}
	}

	String zipEvidences() {
		String evidenceFolderPath = getResolvedReportFolder() + File.separator + EVIDENCE_FOLDER_NAME
		File sourceFolder = new File(evidenceFolderPath)

		if (!sourceFolder.exists() || !sourceFolder.isDirectory()) {
			KeywordUtil.logInfo("Evidence ZIP skipped. Folder not found: ${evidenceFolderPath}")
			return ''
		}

		File[] evidenceChildren = sourceFolder.listFiles()
		if (evidenceChildren == null || evidenceChildren.length == 0) {
			KeywordUtil.logInfo("Evidence ZIP skipped. Evidence folder is empty.")
			return ''
		}

		String zipPath = evidenceFolderPath + File.separator + EVIDENCE_ZIP_NAME
		File zipFile = new File(zipPath)
		if (zipFile.exists()) {
			zipFile.delete()
		}

		ZipOutputStream output = null
		try {
			output = new ZipOutputStream(new FileOutputStream(zipFile))

			evidenceChildren.each { file ->
				if (!shouldSkipEvidenceEntry(file)) {
					addFileToZip(output, sourceFolder, file)
				}
			}

			KeywordUtil.logInfo("Evidence ZIP created successfully: ${zipPath}")
			return zipPath
		} finally {
			try { output?.close() } catch (Exception ignored) {}
		}
	}

	Map uploadExecutionAttachments(String executionKey) {
		Map result = [
			gaiaReport: 0,
			evidences : 0,
			results   : 0
		]

		String gaiaReportPath = getGaiaReportFilePath()
		String evidencesZipPath = zipEvidences()
		String resultsZipPath = zipReports()

		if (!isBlank(gaiaReportPath) && new File(gaiaReportPath).exists()) {
			KeywordUtil.logInfo("Uploading Gaia report attachment: ${gaiaReportPath}")
			result.gaiaReport = uploadAttachment(executionKey, gaiaReportPath)
		} else {
			KeywordUtil.logInfo("Gaia report attachment skipped. File not found.")
		}

		if (!isBlank(evidencesZipPath) && new File(evidencesZipPath).exists()) {
			KeywordUtil.logInfo("Uploading Evidences ZIP attachment: ${evidencesZipPath}")
			result.evidences = uploadAttachment(executionKey, evidencesZipPath)
		} else {
			KeywordUtil.logInfo("Evidences ZIP attachment skipped.")
		}

		if (!isBlank(resultsZipPath) && new File(resultsZipPath).exists()) {
			KeywordUtil.logInfo("Uploading Results ZIP attachment: ${resultsZipPath}")
			result.results = uploadAttachment(executionKey, resultsZipPath)
		} else {
			KeywordUtil.logInfo("Results ZIP attachment skipped.")
		}

		return result
	}

