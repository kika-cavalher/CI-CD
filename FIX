String testCaseName = 'Export File Validation'

// ======================================================
// VALUES RECEIVED FROM THE EXPORT TC
// ======================================================
String targetEnvironment = readTcVariable('targetEnvironment', readTcVariable('environment', ''))
String exportLabel = readTcVariable('exportLabel', '')
String requiredHeadersText = readTcVariable('requiredHeaders', '')
String currencyHeadersText = readTcVariable('currencyHeaders', '')
String amountHeadersText = readTcVariable('amountHeaders', '')

// ======================================================
// FIXED VALIDATION CONFIG
// ======================================================
String shortExportRoot = 'C:\\KatalonExports'
String includeSubFolders = 'false'
String minimumExpectedFiles = '1'
String defaultValidationType = 'Mixte'
String sheetIndex = '0'
String amountDifferenceTolerancePercent = '3'
String maxErrorsPerFile = '999'
String maxGeneralErrors = '999'

List<String> requiredHeaders = parseHeaderList(requiredHeadersText)
List<String> currencyHeaders = parseHeaderList(currencyHeadersText)
List<String> amountHeaders = parseHeaderList(amountHeadersText)

File baseExportFolder = resolveCurrentFeatureExportFolder(shortExportRoot)
String baseExportFolderPath = baseExportFolder.getAbsolutePath()

Boolean validationFailed = false
File exportFileToValidate = null
String fileToValidateText = ''

def reportStep = { String status, String title, String body ->
	String message = '[' + status + '] ' + title + '\n' + (body == null ? '' : body.trim())

	if ('FAIL'.equals(status)) {
		KeywordUtil.markFailed(message)
	} else {
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'(message)
	}
}

if (exportLabel.trim().isEmpty()) {
	KeywordUtil.markFailedAndStop('Export File Validation failed. Missing required TC variable: exportLabel.')
}

if (requiredHeaders.isEmpty()) {
	KeywordUtil.markFailedAndStop('Export File Validation failed. Missing required TC variable: requiredHeaders.')
}

reportStep(
		'PASS',
		'Export validation setup',
		'Environment: ' + (targetEnvironment.trim().isEmpty() ? 'Not configured' : targetEnvironment) + '\n' +
		'Export label: ' + exportLabel + '\n' +
		'Required headers: ' + requiredHeaders.join(' | ') + '\n' +
		'Currency headers: ' + (currencyHeaders.isEmpty() ? 'Not configured' : currencyHeaders.join(' | ')) + '\n' +
		'Amount headers: ' + (amountHeaders.isEmpty() ? 'Not configured' : amountHeaders.join(' | ')) + '\n' +
		'Accepted amount difference: <= ' + amountDifferenceTolerancePercent + '%'
)

String validationResult = CustomKeywords.'commands.ExportFileValidationKeywords.validateEvidenceFolderExists'(
		baseExportFolderPath
)

String folderReport = buildFolderReport(baseExportFolderPath, validationResult)

if (hasValidationFailure(validationResult)) {
	validationFailed = true
	reportStep('FAIL', 'Export folder', folderReport)
} else {
	reportStep('PASS', 'Export folder', folderReport)
}

if (!validationFailed) {
	String resolvedFilesText = CustomKeywords.'commands.ExportFileValidationKeywords.resolveExcelFilesAsString'(
			baseExportFolderPath,
			'',
			includeSubFolders
	)

	Map selectedExport = selectExportFile(resolvedFilesText, targetEnvironment, exportLabel)
	exportFileToValidate = selectedExport.file as File
	fileToValidateText = exportFileToValidate == null ? '' : exportFileToValidate.getAbsolutePath()

	String fileValidationResult = ''

	if (exportFileToValidate == null) {
		fileValidationResult = selectedExport.error as String
	} else {
		String fileFoundResult = CustomKeywords.'commands.ExportFileValidationKeywords.validateExcelFilesFound'(
				fileToValidateText
		)

		String minimumFilesResult = CustomKeywords.'commands.ExportFileValidationKeywords.validateMinimumExpectedFileQuantity'(
				fileToValidateText,
				minimumExpectedFiles
		)

		fileValidationResult = combineValidationResults(fileFoundResult, minimumFilesResult)
	}

	String exportFileReport = buildExportFileReport(
			selectedExport,
			fileValidationResult,
			targetEnvironment,
			exportLabel,
			minimumExpectedFiles,
			maxGeneralErrors
	)

	if (hasValidationFailure(fileValidationResult)) {
		validationFailed = true
		reportStep('FAIL', 'Export file', exportFileReport)
	} else {
		reportStep('PASS', 'Export file', exportFileReport)
	}
}

if (!validationFailed && !fileToValidateText.trim().isEmpty()) {
	Map requiredHeadersValidation = validateHeadersInFile(
			exportFileToValidate,
			parseIntOrDefault(sheetIndex, 0),
			requiredHeaders
	)

	String requiredHeadersReport = buildDynamicHeadersReport(
			requiredHeadersValidation,
			exportFileToValidate,
			'Required headers'
	)

	if (Boolean.TRUE.equals(requiredHeadersValidation.failed)) {
		validationFailed = true
		reportStep('FAIL', 'Required headers', requiredHeadersReport)
	} else {
		reportStep('PASS', 'Required headers', requiredHeadersReport)
	}

	if (currencyHeaders.size() >= 2) {
		validationResult = CustomKeywords.'commands.ExportFileValidationKeywords.validateRowsForValidationType'(
				fileToValidateText,
				defaultValidationType,
				sheetIndex,
				currencyHeaders[0],
				currencyHeaders[1]
		)

		String currencyHeadersReport = buildCurrencyHeadersReport(
				validationResult,
				exportFileToValidate,
				currencyHeaders,
				parseIntOrDefault(maxGeneralErrors, 999)
		)

		if (hasValidationFailure(validationResult)) {
			validationFailed = true
			reportStep('FAIL', 'Currency headers', currencyHeadersReport)
		} else {
			reportStep('PASS', 'Currency headers', currencyHeadersReport)
		}
	} else {
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
				'[SKIPPED] Currency headers\n' +
				'Currency validation was not executed.\n' +
				'Reason: currencyHeaders must contain 2 headers. Current value: ' +
				(currencyHeaders.isEmpty() ? 'Not configured' : currencyHeaders.join(' | '))
		)
	}

	if (!amountHeaders.isEmpty()) {
		if (currencyHeaders.size() < 2) {
			validationFailed = true

			reportStep(
					'FAIL',
					'Amount columns comparison',
					'Amount comparison cannot run because currencyHeaders must contain 2 headers.\n' +
					'Current currencyHeaders: ' + (currencyHeaders.isEmpty() ? 'Not configured' : currencyHeaders.join(' | '))
			)
		} else if (amountHeaders.size() < 2 || amountHeaders.size() % 2 != 0) {
			validationFailed = true

			reportStep(
					'FAIL',
					'Amount columns comparison',
					'Amount comparison cannot run because amountHeaders must contain pairs.\n' +
					'Example: Montant ccy|Montant base ccy\n' +
					'Current amountHeaders: ' + amountHeaders.join(' | ')
			)
		} else {
			for (int i = 0; i < amountHeaders.size(); i += 2) {
				String amountHeader = amountHeaders[i]
				String baseAmountHeader = amountHeaders[i + 1]

				validationResult = CustomKeywords.'commands.ExportFileValidationKeywords.validateMontantCcyEqualsMontantBaseCcy'(
						fileToValidateText,
						defaultValidationType,
						sheetIndex,
						currencyHeaders[0],
						currencyHeaders[1],
						amountHeader,
						baseAmountHeader
				)

				Boolean amountComparisonFailed = shouldFailAmountComparison(
						validationResult,
						exportFileToValidate,
						amountDifferenceTolerancePercent
				)

				String amountComparisonReport = buildAmountComparisonReport(
						validationResult,
						exportFileToValidate,
						amountHeader,
						baseAmountHeader,
						amountDifferenceTolerancePercent,
						parseIntOrDefault(maxErrorsPerFile, 999),
						parseIntOrDefault(maxGeneralErrors, 999)
				)

				String amountStepTitle = 'Amount columns comparison: ' + amountHeader + ' vs ' + baseAmountHeader

				if (amountComparisonFailed) {
					validationFailed = true
					reportStep('FAIL', amountStepTitle, amountComparisonReport)
				} else {
					reportStep('PASS', amountStepTitle, amountComparisonReport)
				}
			}
		}
	} else {
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
				'[SKIPPED] Amount columns comparison\n' +
				'Amount comparison was not executed.\n' +
				'Reason: amountHeaders was not configured.'
		)
	}
}

if (validationFailed) {
	reportStep(
			'FAIL',
			'End of export validation',
			'Environment: ' + (targetEnvironment.trim().isEmpty() ? 'Not configured' : targetEnvironment) + '\n' +
			'Export label: ' + exportLabel + '\n' +
			'Result: FAILED\n' +
			'Validated file: ' + (exportFileToValidate == null ? 'Not available' : exportFileToValidate.getName())
	)

	KeywordUtil.markFailedAndStop(
			testCaseName + ' failed for export ' + exportLabel + '. Check the validation report above.'
	)
}

reportStep(
		'PASS',
		'End of export validation',
		'Environment: ' + (targetEnvironment.trim().isEmpty() ? 'Not configured' : targetEnvironment) + '\n' +
		'Export label: ' + exportLabel + '\n' +
		'Result: PASSED\n' +
		'Validated file: ' + (exportFileToValidate == null ? 'Not available' : exportFileToValidate.getName())
)

KeywordUtil.markPassed(testCaseName + ' completed successfully for export ' + exportLabel + '.')

File resolveCurrentFeatureExportFolder(String configuredRoot) {
	File baseRoot = resolveWritableBaseExportRoot(configuredRoot)
	File executionRoot = resolveExecutionRootFolder()
	String executionName = executionRoot == null ? '' : executionRoot.getName()

	if (executionName == null || executionName.trim().isEmpty()) {
		executionName = 'Unknown_Execution'
	}

	File executionFolder = new File(baseRoot, shortenFilePart(sanitizeFileName(executionName), 48))
	String collectionName = shortenFilePart(sanitizeFileName(resolveCurrentCollectionName()), 20)
	String featureName = shortenFilePart(sanitizeFileName(resolveCurrentFeatureName()), 28)
	return new File(new File(executionFolder, collectionName), featureName)
}

File resolveWritableBaseExportRoot(String configuredRoot) {
	File preferredRoot = new File(configuredRoot)

	try {
		if (!preferredRoot.exists()) {
			preferredRoot.mkdirs()
		}

		if (preferredRoot.exists() && preferredRoot.isDirectory() && preferredRoot.canWrite()) {
			return preferredRoot
		}
	} catch (Exception ignored) {
	}

	File temporaryRoot = new File(System.getProperty('java.io.tmpdir'), 'KatalonExports')

	if (!temporaryRoot.exists()) {
		temporaryRoot.mkdirs()
	}

	return temporaryRoot
}

File resolveExecutionRootFolder() {
	String reportFolderPath = RunConfiguration.getReportFolder()

	if (reportFolderPath == null || reportFolderPath.trim().isEmpty()) {
		return new File(RunConfiguration.getProjectDir(), 'Reports\\Unknown_Execution')
	}

	File current = new File(reportFolderPath)

	while (current != null) {
		File parent = current.getParentFile()

		if (parent != null && parent.getName().equalsIgnoreCase('Reports')) {
			return current
		}

		current = parent
	}

	return new File(reportFolderPath)
}

String resolveCurrentCollectionName() {
	List<String> validParts = getValidReportFolderParts()
	return validParts.isEmpty() ? 'Collection' : validParts[0]
}

String resolveCurrentFeatureName() {
	List<String> validParts = getValidReportFolderParts()
	return validParts.isEmpty() ? 'Export' : validParts.last()
}

List<String> getValidReportFolderParts() {
	List<String> validParts = []
	String reportFolderPath = RunConfiguration.getReportFolder()

	if (reportFolderPath == null || reportFolderPath.trim().isEmpty()) {
		return validParts
	}

	File executionRootFolder = resolveExecutionRootFolder()
	String fullPath = new File(reportFolderPath).getAbsolutePath()
	String rootPath = executionRootFolder.getAbsolutePath()

	if (!fullPath.toLowerCase().startsWith(rootPath.toLowerCase())) {
		return validParts
	}

	String relativePath = fullPath.substring(rootPath.length()).replaceAll('^\\\\+', '')

	if (relativePath.trim().isEmpty()) {
		return validParts
	}

	List<String> parts = relativePath.replace('/', '\\').split('\\\\') as List<String>

	for (String part : parts) {
		if (isValidFeatureNamePart(part)) {
			validParts.add(part.trim())
		}
	}

	return validParts
}

Boolean isValidFeatureNamePart(String part) {
	if (part == null || part.trim().isEmpty()) {
		return false
	}

	String value = part.trim()
	String lower = value.toLowerCase()

	if (value ==~ /\d{8}_\d{6}/ || value ==~ /\d{14}/ || value ==~ /^\d+\.\s*.*/) {
		return false
	}

	List<String> ignoredExactValues = [
		'reports', 'evidences', 'exports', 'test cases', 'test suites',
		'connection', 'authentication', 'login rec', 'login prd', 'katalon', 'temp'
	]

	if (ignoredExactValues.contains(lower)) {
		return false
	}

	List<String> ignoredContainsValues = [
		'export', 'validation', 'validations', 'validate', 'compare',
		'close application', 'open module', 'login'
	]

	for (String ignored : ignoredContainsValues) {
		if (lower.contains(ignored)) {
			return false
		}
	}

	return true
}

String sanitizeFileName(String text) {
	if (text == null || text.trim().isEmpty()) {
		return 'Export'
	}

	String normalized = Normalizer.normalize(text, Normalizer.Form.NFD)
			.replaceAll('\\p{InCombiningDiacriticalMarks}+', '')

	String cleaned = normalized
			.replaceAll('[\\\\/:*?"<>|]', '_')
			.replaceAll('\\s+', '_')
			.replaceAll('_+', '_')
			.replaceAll('^_|_$', '')
			.trim()

	return cleaned.isEmpty() ? 'Export' : cleaned
}

String shortenFilePart(String value, Integer maximumLength) {
	if (value == null || value.trim().isEmpty()) {
		return ''
	}

	int safeMaximum = maximumLength == null || maximumLength <= 0 ? 20 : maximumLength
	String cleanValue = sanitizeFileName(value)
	return cleanValue.length() <= safeMaximum ? cleanValue : cleanValue.substring(0, safeMaximum)
}

Map selectExportFile(String resolvedFilesText, String targetEnvironment, String exportLabel) {
	List<File> allFiles = parseFileList(resolvedFilesText)

	allFiles = allFiles.findAll { File file ->
		file != null &&
		file.exists() &&
		file.isFile() &&
		file.length() > 0 &&
		file.getName().toLowerCase(Locale.ENGLISH).endsWith('.xlsx') &&
		!file.getName().startsWith('~$')
	}

	if (allFiles.isEmpty()) {
		return [
			file        : null,
			allFiles    : allFiles,
			matchedFiles: [],
			error       : 'No valid Excel files were found in the current suite feature folder.'
		]
	}

	String normalizedEnvironment = normalizeEnvironment(targetEnvironment)
	String normalizedLabel = exportLabel == null ? '' : exportLabel.trim().toLowerCase(Locale.ENGLISH)
	List<File> matchedFiles = []

	for (File file : allFiles) {
		String fileName = file.getName().toLowerCase(Locale.ENGLISH)
		boolean environmentMatches = normalizedEnvironment.isEmpty() ||
				fileName.startsWith(normalizedEnvironment.toLowerCase(Locale.ENGLISH) + '_')
		boolean labelMatches = normalizedLabel.isEmpty() || fileName.contains(normalizedLabel)

		if (environmentMatches && labelMatches) {
			matchedFiles.add(file)
		}
	}

	if (matchedFiles.isEmpty()) {
		String expectedDescription = (normalizedEnvironment.isEmpty() ? '' : normalizedEnvironment + '_') +
				'*' + exportLabel + '*.xlsx'

		return [
			file        : null,
			allFiles    : allFiles,
			matchedFiles: matchedFiles,
			error       : 'No Excel file matched the expected environment and export label.\n' +
					'Expected format: ' + expectedDescription
		]
	}

	List<File> sortedMatches = matchedFiles.sort { File a, File b -> b.lastModified() <=> a.lastModified() }

	return [
		file        : sortedMatches[0],
		allFiles    : allFiles,
		matchedFiles: matchedFiles,
		error       : ''
	]
}

String normalizeEnvironment(String value) {
	if (value == null || value.trim().isEmpty()) {
		return ''
	}

	String environment = value.trim().toUpperCase(Locale.ENGLISH)

	if (environment == 'REC' || environment == 'RECETTE') {
		return 'REC'
	}

	if (environment == 'PRD' || environment == 'PROD' || environment == 'PRODUCTION') {
		return 'PRD'
	}

	return environment
}

Map validateHeadersInFile(File file, Integer sheetIndex, List<String> headers) {
	List<String> foundHeaders = []
	List<String> missingHeaders = []
	List<String> errors = []
	Workbook workbook = null

	try {
		if (file == null || !file.exists() || !file.isFile()) {
			return [
				failed        : true,
				headerRow     : '',
				foundHeaders  : foundHeaders,
				missingHeaders: headers,
				errors        : ['File was not found.']
			]
		}

		workbook = WorkbookFactory.create(file)

		if (sheetIndex < 0 || sheetIndex >= workbook.getNumberOfSheets()) {
			return [
				failed        : true,
				headerRow     : '',
				foundHeaders  : foundHeaders,
				missingHeaders: headers,
				errors        : ['Sheet index ' + sheetIndex + ' was not found. Available sheets: ' + workbook.getNumberOfSheets()]
			]
		}

		Sheet sheet = workbook.getSheetAt(sheetIndex)
		DataFormatter formatter = new DataFormatter(Locale.ENGLISH)
		def evaluator = workbook.getCreationHelper().createFormulaEvaluator()
		Map headerInfo = findBestHeaderRow(sheet, formatter, evaluator, headers)

		foundHeaders.addAll(headerInfo.foundHeaders as List<String>)
		missingHeaders.addAll(headerInfo.missingHeaders as List<String>)

		return [
			failed        : !missingHeaders.isEmpty(),
			headerRow     : headerInfo.headerRow,
			foundHeaders  : foundHeaders,
			missingHeaders: missingHeaders,
			errors        : errors
		]
	} catch (Throwable throwable) {
		errors.add(throwable.getClass().getSimpleName() + ': ' + safeText(throwable.getMessage()))

		return [
			failed        : true,
			headerRow     : '',
			foundHeaders  : foundHeaders,
			missingHeaders: headers,
			errors        : errors
		]
	} finally {
		try {
			workbook?.close()
		} catch (Throwable ignored) {
		}
	}
}

Map findBestHeaderRow(Sheet sheet, DataFormatter formatter, def evaluator, List<String> headers) {
	Integer maxHeaderScanRows = Math.min(sheet.getLastRowNum(), 50)
	List<String> bestFound = []
	List<String> bestMissing = headers
	Integer bestHeaderRow = -1

	for (int rowIndex = 0; rowIndex <= maxHeaderScanRows; rowIndex++) {
		Row row = sheet.getRow(rowIndex)

		if (row == null || row.getFirstCellNum() < 0 || row.getLastCellNum() < 0) {
			continue
		}

		Set<String> rowValues = [] as Set<String>

		for (int cellIndex = row.getFirstCellNum(); cellIndex < row.getLastCellNum(); cellIndex++) {
			Cell cell = row.getCell(cellIndex, Row.MissingCellPolicy.RETURN_BLANK_AS_NULL)
			String value = cellText(cell, formatter, evaluator)

			if (!value.isEmpty()) {
				rowValues.add(normalizeHeader(value))
			}
		}

		List<String> currentFound = []
		List<String> currentMissing = []

		for (String header : headers) {
			if (rowValues.contains(normalizeHeader(header))) {
				currentFound.add(header)
			} else {
				currentMissing.add(header)
			}
		}

		if (currentFound.size() > bestFound.size()) {
			bestFound = currentFound
			bestMissing = currentMissing
			bestHeaderRow = rowIndex + 1
		}

		if (currentMissing.isEmpty()) {
			break
		}
	}

	return [
		headerRow     : bestHeaderRow < 0 ? '' : String.valueOf(bestHeaderRow),
		foundHeaders  : bestFound,
		missingHeaders: bestMissing
	]
}

String buildDynamicHeadersReport(Map validation, File file, String title) {
	List<String> foundHeaders = validation.foundHeaders as List<String>
	List<String> missingHeaders = validation.missingHeaders as List<String>
	List<String> errors = validation.errors as List<String>
	List<String> lines = []

	lines.add('Checked file: ' + (file == null ? 'Not available' : file.getName()))
	lines.add('Header row: ' + (safeText(validation.headerRow).isEmpty() ? 'Not found' : safeText(validation.headerRow)))
	lines.add('Headers found: ' + foundHeaders.size())
	lines.add('Headers missing: ' + missingHeaders.size())
	lines.add('')
	lines.add('Header feedback:')

	Integer index = 1

	for (String header : foundHeaders) {
		lines.add('Header ' + index + ': PASSED - ' + header)
		index++
	}

	for (String header : missingHeaders) {
		lines.add('Header ' + index + ': FAILED - ' + header)
		index++
	}

	if (!errors.isEmpty()) {
		lines.add('')
		lines.add('Errors:')

		for (String error : errors) {
			lines.add('- ' + error)
		}
	}

	return lines.join('\n')
}

String buildFolderReport(String folderPath, String validationResult) {
	File folder = new File(folderPath)
	String result = validationResult == null ? '' : validationResult.trim()

	if (hasValidationFailure(result)) {
		return 'Folder: ' + folder.getName() + '\n' +
				'Result: Not available\n' +
				'Details: ' + cleanErrorLineForReport(result, [])
	}

	return 'Folder: ' + folder.getName() + '\nResult: Available'
}

String buildExportFileReport(
		Map selectedExport,
		String validationResult,
		String targetEnvironment,
		String exportLabel,
		String minimumExpectedFilesText,
		String maxGeneralErrorsText
) {
	List<File> allFiles = selectedExport.allFiles as List<File>
	List<File> matchedFiles = selectedExport.matchedFiles as List<File>
	File selectedFile = selectedExport.file as File
	Integer minimum = parseIntOrDefault(minimumExpectedFilesText, 1)
	List<String> lines = []

	lines.add('Expected environment: ' +
			(targetEnvironment.trim().isEmpty() ? 'Not configured' : normalizeEnvironment(targetEnvironment)))
	lines.add('Expected export label: ' + exportLabel)
	lines.add('Required files: ' + minimum)
	lines.add('Valid Excel files found: ' + (allFiles == null ? 0 : allFiles.size()))
	lines.add('Matched files: ' + (matchedFiles == null ? 0 : matchedFiles.size()))
	lines.add('')

	if (selectedFile != null) {
		lines.add('File 1: PASSED - ' + selectedFile.getName())
		lines.add('Selected file: ' + selectedFile.getName())

		if (matchedFiles != null && matchedFiles.size() > 1) {
			lines.add('')
			lines.add('Note: more than one matching file was found. The latest file was selected.')
		}
	} else {
		lines.add('File 1: FAILED - Expected export file was not found.')
	}

	if (hasValidationFailure(validationResult)) {
		List<String> errors = extractErrorLines(validationResult)

		if (!errors.isEmpty()) {
			lines.add('')
			lines.add('Errors:')

			for (String error : limitLines(errors, parseIntOrDefault(maxGeneralErrorsText, 999))) {
				lines.add('- ' + cleanErrorLineForReport(error, allFiles))
			}
		}

		if (allFiles != null && !allFiles.isEmpty()) {
			lines.add('')
			lines.add('Available files:')

			for (File file : allFiles) {
				lines.add('- ' + file.getName())
			}
		}
	}

	return lines.join('\n')
}

String buildCurrencyHeadersReport(
		String validationResult,
		File file,
		List<String> currencyHeaders,
		Integer maxGeneral
) {
	List<File> files = file == null ? [] : [file]
	List<String> lines = []

	lines.add('Headers checked: ' + currencyHeaders.join(' | '))
	lines.add('Checked files: ' + files.size())
	lines.add('')

	if (file != null) {
		lines.add('File 1: ' + (hasValidationFailure(validationResult) ? 'FAILED' : 'PASSED') + ' - ' + file.getName())
	}

	if (hasValidationFailure(validationResult)) {
		List<String> errors = extractErrorLines(validationResult)
		lines.add('')
		lines.add('Errors:')

		for (String error : limitLines(errors, maxGeneral)) {
			lines.add('- ' + cleanErrorLineForReport(error, files))
		}
	}

	return lines.join('\n')
}

String buildAmountComparisonReport(
		String validationResult,
		File file,
		String amountHeader,
		String baseAmountHeader,
		String tolerancePercentText,
		Integer maxPerFile,
		Integer maxGeneral
) {
	List<File> files = file == null ? [] : [file]
	BigDecimal tolerancePercent = parseDecimalOrDefault(tolerancePercentText, new BigDecimal('3'))
	List<Map> parsedRows = parseAmountComparisonRows(validationResult, files, tolerancePercent)
	List<Map> rejectedRows = parsedRows.findAll { Map row -> Boolean.FALSE.equals(row.accepted) }
	List<Map> acceptedRows = parsedRows.findAll { Map row -> Boolean.TRUE.equals(row.accepted) }
	Boolean shouldFail = shouldFailAmountComparison(validationResult, file, tolerancePercentText)
	List<String> lines = []

	lines.add('Headers compared: ' + amountHeader + ' | ' + baseAmountHeader)
	lines.add('Accepted difference: <= ' + formatDecimal(tolerancePercent) + '%')
	lines.add('Checked files: ' + files.size())
	lines.add('')

	if (file != null) {
		if (shouldFail) {
			if (!rejectedRows.isEmpty()) {
				lines.add('File 1: FAILED - ' + file.getName() + ' - ' + rejectedRows.size() + ' wrong row(s) above tolerance.')
			} else {
				lines.add('File 1: FAILED - ' + file.getName() + ' - Amount comparison returned an error.')
			}
		} else if (!acceptedRows.isEmpty()) {
			lines.add('File 1: PASSED WITH ACCEPTED DIFFERENCES - ' + file.getName() + ' - ' + acceptedRows.size() + ' difference(s) within tolerance.')
		} else {
			lines.add('File 1: PASSED - ' + file.getName() + ' - No amount errors returned.')
		}
	}

	if (!hasValidationFailure(validationResult)) {
		lines.add('')
		lines.add('Result: all amount values are equal.')
		return lines.join('\n')
	}

	if (parsedRows.isEmpty()) {
		lines.add('')
		lines.add('Result: failed.')
		lines.add('Reason: the keyword returned an error, but no row-level values were available.')
		lines.add('')
		lines.add('Raw errors:')

		for (String error : limitLines(extractErrorLines(validationResult), maxGeneral)) {
			lines.add('- ' + cleanErrorLineForReport(error, files))
		}

		return lines.join('\n')
	}

	if (!rejectedRows.isEmpty()) {
		lines.add('')
		lines.add('Wrong values:')
		lines.add('')
		lines.add(file == null ? 'Unknown file' : file.getName())
		lines.add('Row | Devise | Montant ccy | Montant base ccy | Difference | Difference % | Reason')
		lines.add('--- | --- | --- | --- | --- | --- | ---')

		for (Map row : rejectedRows.take(maxPerFile)) {
			lines.add(
					tableValue(row.rowNumber) + ' | ' +
					tableValue(row.devise) + ' | ' +
					tableValue(row.amountCcy) + ' | ' +
					tableValue(row.amountBaseCcy) + ' | ' +
					tableValue(row.difference) + ' | ' +
					tableValue(row.differencePercent) + ' | ' +
					tableValue(row.reason)
			)
		}

		if (rejectedRows.size() > maxPerFile) {
			lines.add('... and ' + (rejectedRows.size() - maxPerFile) + ' more wrong row(s) in this file.')
		}
	}

	if (!acceptedRows.isEmpty()) {
		lines.add('')
		lines.add('Accepted differences:')
		lines.add('')
		lines.add(file == null ? 'Unknown file' : file.getName())
		lines.add('Row | Devise | Montant ccy | Montant base ccy | Difference | Difference % | Reason')
		lines.add('--- | --- | --- | --- | --- | --- | ---')

		for (Map row : acceptedRows.take(maxPerFile)) {
			lines.add(
					tableValue(row.rowNumber) + ' | ' +
					tableValue(row.devise) + ' | ' +
					tableValue(row.amountCcy) + ' | ' +
					tableValue(row.amountBaseCcy) + ' | ' +
					tableValue(row.difference) + ' | ' +
					tableValue(row.differencePercent) + ' | ' +
					tableValue(row.reason)
			)
		}

		if (acceptedRows.size() > maxPerFile) {
			lines.add('... and ' + (acceptedRows.size() - maxPerFile) + ' more accepted row(s) in this file.')
		}
	}

	return lines.join('\n')
}

Boolean shouldFailAmountComparison(String validationResult, File file, String tolerancePercentText) {
	if (!hasValidationFailure(validationResult)) {
		return false
	}

	BigDecimal tolerancePercent = parseDecimalOrDefault(tolerancePercentText, new BigDecimal('3'))
	List<File> files = file == null ? [] : [file]
	List<Map> parsedRows = parseAmountComparisonRows(validationResult, files, tolerancePercent)

	if (parsedRows.any { Map row -> Boolean.FALSE.equals(row.accepted) }) {
		return true
	}

	return parsedRows.isEmpty()
}

List<Map> parseAmountComparisonRows(String validationResult, List<File> files, BigDecimal tolerancePercent) {
	List<Map> rows = []
	String text = cleanErrorLineForReport(validationResult, files)
			.replace('\r\n', ' ')
			.replace('\n', ' ')
			.replace('\r', ' ')

	def matcher = text =~ /(?is)(?:^|[\s\-])File\s+'?([^'\s|]+\.xlsx)'?\s+row\s+(\d+)\s+has\s+different\s+amounts\.?\s*(.*?)(?=(?:[\s\-]File\s+'?[^'\s|]+\.xlsx'?\s+row\s+\d+\s+has\s+different\s+amounts)|$)/

	while (matcher.find()) {
		String fileName = matcher.group(1).trim()
		String rowNumber = matcher.group(2).trim()
		String details = matcher.group(3).trim()
		String devise = extractByRegex(details, "Devise\\s*=\\s*'([^']*)'")
		String amountCcy = extractByRegex(details, "Montant ccy\\s*=\\s*'([^']*)'")
		String amountBaseCcy = extractByRegex(details, "Montant base ccy\\s*=\\s*'([^']*)'")
		BigDecimal amountCcyNumber = parseDecimalOrNull(amountCcy)
		BigDecimal amountBaseCcyNumber = parseDecimalOrNull(amountBaseCcy)
		BigDecimal difference = null
		BigDecimal differencePercent = null
		Boolean accepted = false
		String reason = ''

		if (amountCcyNumber == null || amountBaseCcyNumber == null) {
			reason = 'Cannot calculate difference because one amount is missing or not numeric.'
			accepted = false
		} else {
			difference = amountCcyNumber.subtract(amountBaseCcyNumber).abs()

			if (amountBaseCcyNumber.compareTo(BigDecimal.ZERO) == 0) {
				differencePercent = difference.compareTo(BigDecimal.ZERO) == 0 ? BigDecimal.ZERO : new BigDecimal('100')
			} else {
				differencePercent = difference
						.divide(amountBaseCcyNumber.abs(), 10, RoundingMode.HALF_UP)
						.multiply(new BigDecimal('100'))
			}

			accepted = differencePercent.compareTo(tolerancePercent) <= 0
			reason = accepted ? 'Accepted within tolerance.' : 'Difference is above the accepted tolerance.'
		}

		rows.add([
			fileName         : fileName,
			rowNumber        : rowNumber,
			devise           : devise,
			amountCcy        : amountCcy,
			amountBaseCcy    : amountBaseCcy,
			difference       : difference == null ? '-' : formatDecimal(difference),
			differencePercent: differencePercent == null ? '-' : formatDecimal(differencePercent) + '%',
			accepted         : accepted,
			reason           : reason
		])
	}

	return rows
}

String cellText(Cell cell, DataFormatter formatter, def evaluator) {
	if (cell == null) {
		return ''
	}

	try {
		return formatter.formatCellValue(cell, evaluator).trim()
	} catch (Throwable ignored) {
		try {
			return formatter.formatCellValue(cell).trim()
		} catch (Throwable ignoredAgain) {
			return ''
		}
	}
}

String normalizeHeader(String value) {
	return safeText(value)
			.toLowerCase(Locale.ENGLISH)
			.replaceAll('[^a-z0-9]+', '')
}

String combineValidationResults(Object... values) {
	List<String> results = []

	if (values == null) {
		return ''
	}

	for (Object value : values) {
		String text = value == null ? '' : String.valueOf(value).trim()

		if (!text.isEmpty()) {
			results.add(text)
		}
	}

	return results.join('\n')
}

Boolean hasValidationFailure(String validationResult) {
	String result = validationResult == null ? '' : validationResult.trim()

	if (result.isEmpty() || isSkippedResult(result)) {
		return false
	}

	String upper = result.toUpperCase(Locale.ENGLISH)

	if (upper == 'PASS' || upper == 'PASSED' || upper == 'SUCCESS') {
		return false
	}

	if (upper.startsWith('[PASS]') || upper.startsWith('[PASSED]') || upper.startsWith('[SUCCESS]')) {
		return false
	}

	return !upper.contains('RESULT: PASSED')
}

Boolean isSkippedResult(String validationResult) {
	String result = validationResult == null ? '' : validationResult.trim()
	result = result.replaceFirst('^\\s*[^A-Za-z0-9\\[]+\\s*', '')
	return result.startsWith('[SKIPPED]')
}

List<String> parseHeaderList(String text) {
	List<String> result = []
	String value = text == null ? '' : text.trim()

	if (value.isEmpty()) {
		return result
	}

	String[] parts = value.split('\\|')

	for (String part : parts) {
		String clean = part == null ? '' : part.trim()

		if (!clean.isEmpty()) {
			result.add(clean)
		}
	}

	return result
}

List<File> parseFileList(String filesText) {
	List<File> files = []
	String text = filesText == null ? '' : filesText.trim()

	if (text.isEmpty()) {
		return files
	}

	String normalized = text.replace('\r\n', '|').replace('\n', '|').replace(';', '|')
	String[] parts = normalized.split('\\|')

	for (String part : parts) {
		String clean = part == null ? '' : part.trim()

		if (!clean.isEmpty()) {
			files.add(new File(clean))
		}
	}

	return files.unique { File file -> file.getAbsolutePath().toLowerCase(Locale.ENGLISH) }
}

List<String> extractErrorLines(String validationResult) {
	List<String> lines = []
	String result = validationResult == null ? '' : validationResult.trim()

	if (result.isEmpty()) {
		return lines
	}

	String normalized = result.replace('\r\n', '\n').replace('\r', '\n')
	String[] parts = normalized.split('\n')

	for (String part : parts) {
		String clean = part == null ? '' : part.trim()

		if (!clean.isEmpty()) {
			lines.add(clean)
		}
	}

	if (lines.isEmpty()) {
		lines.add(result)
	}

	return lines
}

List<String> limitLines(List<String> lines, Integer limit) {
	List<String> result = []

	if (lines == null || lines.isEmpty()) {
		return result
	}

	Integer safeLimit = limit == null || limit <= 0 ? 999 : limit

	for (int i = 0; i < lines.size() && i < safeLimit; i++) {
		result.add(lines[i])
	}

	return result
}

String cleanErrorLineForReport(String errorLine, List<File> files) {
	String line = errorLine == null ? '' : errorLine.trim()

	line = line.replace('[ERROR]', '').trim()
	line = line.replace('[FAIL]', '').trim()
	line = line.replace('[FAILED]', '').trim()
	line = line.replace('[PASS]', '').trim()
	line = line.replace('[PASSED]', '').trim()
	line = line.replace('[SKIPPED]', '').trim()
	line = line.replaceFirst('^\\s*[^A-Za-z0-9\\[]+\\s*', '').trim()
	line = line.replaceAll('^com\\.kms\\.katalon\\.core\\.exception\\.StepFailedException:\\s*', '').trim()
	line = line.replaceAll('^Reason:\\s*com\\.kms\\.katalon\\.core\\.exception\\.StepFailedException:\\s*', 'Reason: ').trim()

	for (File file : files ?: []) {
		line = line.replace(file.getAbsolutePath(), file.getName())
		line = line.replace(file.getPath(), file.getName())
	}

	return stripPathsKeepingFileNames(line).trim()
}

String stripPathsKeepingFileNames(String value) {
	String line = value == null ? '' : value
	line = line.replace('\\', '/')
	line = line.replaceAll('[A-Za-z]:/[^\\s|"]*/([^/\\s|"]+\\.xlsx)', '$1')
	line = line.replaceAll('[A-Za-z]:/[^\\s|"]*/([^/\\s|"]+\\.xls)', '$1')
	return line
}

BigDecimal parseDecimalOrNull(String value) {
	String text = value == null ? '' : value.trim()

	if (text.isEmpty() || text == '-') {
		return null
	}

	String clean = text.replace(' ', '').replace("'", '')

	if (clean.startsWith('(') && clean.endsWith(')')) {
		clean = '-' + clean.substring(1, clean.length() - 1)
	}

	if (clean.contains(',') && clean.contains('.')) {
		Integer lastComma = clean.lastIndexOf(',')
		Integer lastDot = clean.lastIndexOf('.')

		if (lastComma > lastDot) {
			clean = clean.replace('.', '').replace(',', '.')
		} else {
			clean = clean.replace(',', '')
		}
	} else if (clean.contains(',') && !clean.contains('.')) {
		clean = clean.replace(',', '.')
	}

	try {
		return new BigDecimal(clean)
	} catch (Throwable ignored) {
		return null
	}
}

BigDecimal parseDecimalOrDefault(String value, BigDecimal defaultValue) {
	BigDecimal parsed = parseDecimalOrNull(value)
	return parsed == null ? defaultValue : parsed
}

String extractByRegex(String text, String pattern) {
	try {
		def matcher = text =~ pattern

		if (matcher.find()) {
			return matcher.group(1).trim()
		}
	} catch (Throwable ignored) {
	}

	return ''
}

String formatDecimal(BigDecimal value) {
	if (value == null) {
		return '-'
	}

	BigDecimal normalized = value.setScale(4, RoundingMode.HALF_UP).stripTrailingZeros()
	return normalized.toPlainString()
}

String safeText(Object value) {
	String text = value == null ? '' : String.valueOf(value).trim()
	return text.isEmpty() ? '' : text
}

String tableValue(Object value) {
	String text = safeText(value)
	return text.isEmpty() ? '-' : text.replace('|', '/')
}

Integer parseIntOrDefault(String value, Integer defaultValue) {
	try {
		return Integer.parseInt(value == null ? '' : value.trim())
	} catch (Exception ignored) {
		return defaultValue
	}
}

String readTcVariable(String variableName, String defaultValue) {
	try {
		if (getBinding() != null && getBinding().hasVariable(variableName)) {
			Object raw = getBinding().getVariable(variableName)
			String value = raw == null ? '' : String.valueOf(raw).trim()

			if (!value.isEmpty()) {
				return value
			}
		}
	} catch (Throwable ignored) {
	}

	return defaultValue
}

