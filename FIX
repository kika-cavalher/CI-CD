Cole o arquivo inteiro assim:

@echo off
setlocal EnableExtensions EnableDelayedExpansion

REM ============================================================
REM eMatch Desktop runner
REM Reads: D:\Projects\eMatchStarters\run-context.properties
REM Writes:
REM   - %REPORTS_DIR%\_jenkins_task_exitcode.txt
REM   - %LOG_DIR%\katalon_YYYYMMDD_HHMMSS.log
REM ============================================================

set "CTX_FILE=D:\Projects\eMatchStarters\run-context.properties"

if not exist "%CTX_FILE%" (
  echo [ERROR] Context file not found: %CTX_FILE%
  exit /b 2
)

REM ---- Read properties
for /f "usebackq tokens=1,* delims==" %%A in ("%CTX_FILE%") do (
  set "K=%%A"
  set "V=%%B"
  set "K=!K: =!"
  if not "!K!"=="" set "!K!=!V!"
)

REM ---- Validate required keys
if "%WORKSPACE%"=="" (
  echo [ERROR] WORKSPACE is empty in %CTX_FILE%
  exit /b 2
)
if "%PROJECT_FILE%"=="" (
  echo [ERROR] PROJECT_FILE is empty in %CTX_FILE%
  exit /b 2
)
if "%KATALON_EXE%"=="" (
  echo [ERROR] KATALON_EXE is empty in %CTX_FILE%
  exit /b 2
)
if "%COLLECTION_PATH%"=="" (
  echo [ERROR] COLLECTION_PATH is empty in %CTX_FILE%
  exit /b 2
)
if "%REPORTS_DIR%"=="" (
  echo [ERROR] REPORTS_DIR is empty in %CTX_FILE%
  exit /b 2
)
if "%LOG_DIR%"=="" (
  echo [ERROR] LOG_DIR is empty in %CTX_FILE%
  exit /b 2
)
if "%BROWSER_TYPE%"=="" (
  echo [ERROR] BROWSER_TYPE is empty in %CTX_FILE%
  exit /b 2
)
if "%RETRY%"=="" set "RETRY=0"

REM ---- Ensure folders
if not exist "%LOG_DIR%" mkdir "%LOG_DIR%" >nul 2>nul
if not exist "%REPORTS_DIR%" mkdir "%REPORTS_DIR%" >nul 2>nul

REM ---- Timestamp
for /f %%i in ('powershell -NoProfile -Command "Get-Date -Format yyyyMMdd_HHmmss"') do set "TS=%%i"
set "LOG_FILE=%LOG_DIR%\katalon_%TS%.log"
set "EXIT_FILE=%REPORTS_DIR%\_jenkins_task_exitcode.txt"

REM ---- Force exit file reset
if exist "%EXIT_FILE%" del /f /q "%EXIT_FILE%" >nul 2>nul

REM ---- Resolve project full path
set "PROJECT_PATH=%WORKSPACE%\%PROJECT_FILE%"

echo ===========================================================> "%LOG_FILE%"
echo [INFO] WORKSPACE      = %WORKSPACE%>> "%LOG_FILE%"
echo [INFO] PROJECT_PATH   = %PROJECT_PATH%>> "%LOG_FILE%"
echo [INFO] COLLECTION     = %COLLECTION_PATH%>> "%LOG_FILE%"
echo [INFO] REPORTS_DIR    = %REPORTS_DIR%>> "%LOG_FILE%"
echo [INFO] BROWSER_TYPE   = %BROWSER_TYPE%>> "%LOG_FILE%"
echo [INFO] RETRY          = %RETRY%>> "%LOG_FILE%"
echo ===========================================================>> "%LOG_FILE%"

if not exist "%PROJECT_PATH%" (
  echo [ERROR] Project file not found: %PROJECT_PATH%>> "%LOG_FILE%"
  echo 3> "%EXIT_FILE%"
  exit /b 3
)

REM ---- Run Katalon (console mode)
echo [INFO] Launching Katalon...>> "%LOG_FILE%"

"%KATALON_EXE%" ^
  -noSplash ^
  -runMode=console ^
  -retry=%RETRY% ^
  -projectPath="%PROJECT_PATH%" ^
  -testSuiteCollectionPath="%COLLECTION_PATH%" ^
  -browserType="%BROWSER_TYPE%" ^
  -reportFolder="%REPORTS_DIR%" >> "%LOG_FILE%" 2>&1

set "RC=%ERRORLEVEL%"

echo [INFO] Katalon exit code: %RC%>> "%LOG_FILE%"
echo %RC%> "%EXIT_FILE%"

exit /b 0

