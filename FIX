	@Keyword
	def calculatePercentageDifference(double value1, double value2) {
		return Math.abs((value1 - value2) / ((value1 + value2) / 2)) * 100
	}

	@Keyword
	def BigDecimal totalSum(Sheet sheet, int pos) {
		BigDecimal sum = new BigDecimal(0);

		for (Row row : sheet) {
			if (row.getCell(pos) != null) {
				if (row.getCell(pos).cellTypeEnum == CellType.NUMERIC) sum += row.getCell(pos).getNumericCellValue();
			}
		}
		return sum;
	}

	@Keyword
	def BigDecimal minAmount(Sheet sheet, int pos) {
		BigDecimal min = new BigDecimal(0);
		BigDecimal temp = new BigDecimal(0);

		for (Row row : sheet) {
			if (row.getCell(pos) != null) {
				println row.getCell(pos);
				if (row.getCell(pos).cellTypeEnum ==  CellType.NUMERIC) temp = row.getCell(pos).getNumericCellValue();

				if (temp < min) min = temp;
			}
		}
		return min;
	}

	@Keyword
	def BigDecimal maxAmount(Sheet sheet, int pos) {
		BigDecimal max = new BigDecimal(0);
		BigDecimal temp = new BigDecimal(0);

		for (Row row : sheet) {
			if (row.getCell(pos) != null) {
				if (row.getCell(pos).cellTypeEnum ==  CellType.NUMERIC) temp = row.getCell(pos).getNumericCellValue();

				if (temp > max) max = temp;
			}
		}
		return max;
	}

	@Keyword
	def isNumeric(String val) {
		try {
			Double.parseDouble(val)
			return true
		} catch (NumberFormatException e) {
			return false
		}
	}


	@Keyword
	def BigDecimal firstAmmount(Sheet sheet, int pos) {
		BigDecimal first = new BigDecimal(0);

		def cellValue = sheet.getRow(0).getCell(pos).getNumericCellValue()
		if (cellValue instanceof Double) {
			first = new BigDecimal(cellValue)
		}
		return first
	}

