	@Keyword
	void applySourceFilter(
			String sourceValue,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)
		String normalizedSource =
			normalizeSource(sourceValue)

		if (!normalizedSource.equals('bilan') &&
			!normalizedSource.equals('resultat')) {

			KeywordUtil.markFailedAndStop(
				'Unsupported source filter value: ' +
				sourceValue +
				'. Allowed values: bilan or resultat.'
			)

			return
		}

		new EmatchHelper().filterBySourceInvestigations(
			normalizedSource
		)

		Windows.delay(POLLING_DELAY_SECONDS)

		String validationImageKey =
			normalizedSource.equals('bilan')
				? 'sourceFilterAppliedBilan'
				: 'sourceFilterAppliedResultat'

		waitForImagePresent(
			validationImageKey,
			timeout,
			normalizedSource.capitalize() +
				' source filter was not applied correctly.'
		)

		takeEvidence(
			'Investigations_Source_' +
				normalizedSource.capitalize() +
				'_Applied.png'
		)
	}


