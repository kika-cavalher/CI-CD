			asOfDateValue.trim().isEmpty()) {

			KeywordUtil.markFailedAndStop(
					'As Of Date value is empty.'
					)

			return
		}

		String safeAsOfDateValue =
				asOfDateValue.trim()

		Integer safeTimeout =
				timeoutSeconds == null ||
				timeoutSeconds <= 0
					? 5
					: timeoutSeconds

		addNote(
				'Apply generic Recherche As Of Date filter\n' +
				'As Of Date: ' +
				safeAsOfDateValue
				)

		addNote(
				'Step 1. Open Recherche tab'
				)

		openRechercheTab()

		Windows.delay(2)

		WindowsTestObject asOfDateField =
				findWindowsObject(
				'Object Repository/PNL Comptable/asOfDateFilterPNLEco'
				)

		if (!Windows.waitForElementPresent(
				asOfDateField,
				safeTimeout,
				FailureHandling.OPTIONAL
				)) {

