	// =========================================================================
	// PUBLIC API
	// =========================================================================

	// Backward compatible alias
	String createGaiaHtmlReport(String reportFolder, String suiteName, String xmlPath) {
		return createHtmlReport(reportFolder, suiteName, xmlPath)
	}

	String createHtmlReport(String reportFolder, String suiteName, String xmlPath) {
		if (isBlank(reportFolder)) {
			return ''
		}

		File reportDir = new File(reportFolder)
		if (!reportDir.exists() || !reportDir.isDirectory()) {
			return ''
		}

		List<Map> xmlCases = parseXmlCases(xmlPath)
		List<Map> logScenarios = parseExecutionLogScenarios(reportDir)
		List<Map> scenarios = mergeXmlAndLog(xmlCases, logScenarios)

		if (scenarios.isEmpty()) {
			return ''
		}

		applySequentialTimingFallback(reportDir, scenarios)

		File nativeHtml = findNativeKatalonHtmlReport(reportDir)
		attachEvidenceFromNativeHtml(reportDir, nativeHtml, scenarios)

		String resolvedSuiteName = resolveSuiteName(reportDir, suiteName)

		Map model = [
			appName          : flow.getAppDisplayName(),
			suiteName        : resolvedSuiteName,
			reportTitle      : 'Test report - ' + resolvedSuiteName,
			subtitle         : flow.getReportSubtitle(),
			generatedAt      : formatDisplayDate(new Date()),
			logoSrc          : resolveAssetUrl(reportDir, flow.getReportLogoRelativePath()),
			reportFolder     : reportDir.absolutePath,
			headerBackground : flow.getReportHeaderBackground(),
			accentColor      : flow.getReportAccentColor(),
			accentSoftColor  : flow.getReportAccentSoftColor(),
			infoColor        : flow.getReportInfoColor(),
			scenarios        : scenarios
		]

		String html = new JiraGaiaHtmlTemplateBuilder().build(model)

		File htmlFile = new File(reportDir, resolveReportFileName())
		htmlFile.setText(html, 'UTF-8')
		return htmlFile.absolutePath
	}

	// IMPORTANT:
	// JiraFlowCoordinator is calling this method statically with 2 arguments.
	static String createRuntimeJUnitXmlFromKatalonLog(String reportFolder, String suiteName) {
		if (isBlankStatic(reportFolder)) {
			return ''
		}

		File reportDir = new File(reportFolder)
		if (!reportDir.exists() || !reportDir.isDirectory()) {
			return ''
		}

		File logFile = findExecutionLogStatic(reportDir)
		if (logFile == null || !logFile.exists()) {
			return ''
		}

		List<Map> scenarios = parseExecutionLogScenariosStatic(logFile)
		if (scenarios.isEmpty()) {
			return ''
		}

		int failures = scenarios.count { Map item -> safeValueStatic(item.status) == 'failed' }
		int skipped = scenarios.count { Map item -> safeValueStatic(item.status) == 'skipped' }
		long totalDurationMs = 0L

		scenarios.each { Map item ->
			totalDurationMs += toLongStatic(item.durationMs)
		}

		String suite = isBlankStatic(suiteName) ? (reportDir.parentFile != null ? reportDir.parentFile.name : 'Execution') : safeValueStatic(suiteName)

		StringBuilder xml = new StringBuilder()
		xml.append('<?xml version="1.0" encoding="UTF-8"?>\n')
		xml.append('<testsuite')
		xml.append(' name="').append(xmlEscapeStatic(suite)).append('"')
		xml.append(' tests="').append(String.valueOf(scenarios.size())).append('"')
		xml.append(' failures="').append(String.valueOf(failures)).append('"')
		xml.append(' errors="0"')
		xml.append(' skipped="').append(String.valueOf(skipped)).append('"')
		xml.append(' time="').append(formatSecondsStatic(totalDurationMs)).append('">\n')

		scenarios.each { Map scenario ->
			String caseName = firstNonBlankStatic(
				scenario.name,
				scenario.title,
				'Unnamed test'
			)

			long durationMs = toLongStatic(scenario.durationMs)
			String status = safeValueStatic(scenario.status)
			String errorShort = safeValueStatic(scenario.errorShort)
			String errorFull = safeValueStatic(scenario.errorFull)

			xml.append('  <testcase')
			xml.append(' classname="').append(xmlEscapeStatic(suite)).append('"')
			xml.append(' name="').append(xmlEscapeStatic(caseName)).append('"')
			xml.append(' time="').append(formatSecondsStatic(durationMs)).append('"')
			xml.append('>')

			if (status == 'failed') {
				xml.append('<failure')
				if (!isBlankStatic(errorShort)) {
					xml.append(' message="').append(xmlEscapeStatic(errorShort)).append('"')
				}
				xml.append('><![CDATA[').append(errorFull ?: errorShort ?: 'Failed').append(']]></failure>')
			} else if (status == 'skipped') {
				xml.append('<skipped')
				if (!isBlankStatic(errorShort)) {
					xml.append(' message="').append(xmlEscapeStatic(errorShort)).append('"')
				}
				xml.append('><![CDATA[').append(errorFull ?: errorShort ?: 'Skipped').append(']]></skipped>')
			}

			xml.append('</testcase>\n')
		}

		xml.append('</testsuite>\n')

		File junitFile = new File(reportDir, 'JUnit_Report.xml')
		junitFile.setText(xml.toString(), 'UTF-8')
		return junitFile.absolutePath
	}

	// =========================================================================
	// REPORT NAME
	// =========================================================================

	private String resolveReportFileName() {
		String value = ''

		try {
			value = safeValue(flow?.REPORT_FILE_NAME)
		} catch (Exception ignored) {
		}

		if (isBlank(value)) {
			try {
				value = safeValue(flow?.GAIA_REPORT_FILE_NAME)
			} catch (Exception ignored) {
			}
		}

		return isBlank(value) ? DEFAULT_REPORT_FILE_NAME : value
	}

	// =========================================================================
	// XML
	// =========================================================================

	private List<Map> parseXmlCases(String xmlPath) {
		List<Map> result = []

		if (isBlank(xmlPath)) {
			return result
		}

		File xmlFile = new File(xmlPath)
		if (!xmlFile.exists() || !xmlFile.isFile()) {
			return result
		}

		Document document = parseXmlDocument(xmlFile)
		if (document == null) {
			return result
		}

		NodeList testcases = document.getElementsByTagName('testcase')

		for (int index = 0; index < testcases.length; index++) {
			Element testcase = (Element) testcases.item(index)

			String className = safeValue(testcase.getAttribute('classname'))
			String testName = safeValue(testcase.getAttribute('name'))
			long durationMs = toMillisFromSeconds(testcase.getAttribute('time'))

			Element failureNode = firstChildElement(testcase, 'failure')
			Element errorNode = firstChildElement(testcase, 'error')
			Element skippedNode = firstChildElement(testcase, 'skipped')

			boolean failed = failureNode != null || errorNode != null
			boolean skipped = skippedNode != null

			String message = ''
			String details = ''

			if (failureNode != null) {
				message = safeValue(failureNode.getAttribute('message'))
				details = safeValue(failureNode.getTextContent())
			} else if (errorNode != null) {
				message = safeValue(errorNode.getAttribute('message'))
				details = safeValue(errorNode.getTextContent())
			} else if (skippedNode != null) {
				message = safeValue(skippedNode.getAttribute('message'))
				details = safeValue(skippedNode.getTextContent())
			}

			result << [
				index      : index + 1,
				name       : buildDisplayName(className, testName),
				shortName  : isBlank(testName) ? buildDisplayName(className, testName) : testName,
				durationMs : durationMs,
				status     : skipped ? 'skipped' : (failed ? 'failed' : 'passed'),
				message    : message,
				details    : details
			]
		}

		return result
	}

	private Document parseXmlDocument(File xmlFile) {
		try {
			def factory = DocumentBuilderFactory.newInstance()
			factory.setNamespaceAware(false)
			factory.setFeature('http://apache.org/xml/features/disallow-doctype-decl', true)
			factory.setFeature('http://xml.org/sax/features/external-general-entities', false)
			factory.setFeature('http://xml.org/sax/features/external-parameter-entities', false)
			factory.setFeature('http://apache.org/xml/features/nonvalidating/load-external-dtd', false)
			factory.setExpandEntityReferences(false)

			def builder = factory.newDocumentBuilder()
			return builder.parse(xmlFile)
		} catch (Exception ignored) {
			return null
		}
	}

	private Element firstChildElement(Element parent, String tagName) {
		NodeList nodes = parent.getElementsByTagName(tagName)
		if (nodes == null || nodes.length == 0) {
			return null
		}
		return (Element) nodes.item(0)
	}

	private String buildDisplayName(String className, String testName) {
		if (!isBlank(className) && !isBlank(testName)) {
			return className + '/' + testName
		}
		if (!isBlank(testName)) {
			return testName
		}
		return className
	}

	// =========================================================================
	// LOG PARSING
	// =========================================================================

	private List<Map> parseExecutionLogScenarios(File reportDir) {
		File logFile = findExecutionLog(reportDir)
		if (logFile == null || !logFile.exists()) {
			return []
		}
		return parseExecutionLogScenariosStatic(logFile)
	}

	private File findExecutionLog(File reportDir) {
		return findExecutionLogStatic(reportDir)
	}

	private static File findExecutionLogStatic(File reportDir) {
		if (reportDir == null || !reportDir.exists() || !reportDir.isDirectory()) {
			return null
		}

		List<File> candidates = []

		File[] files = reportDir.listFiles()
		if (files != null) {
			files.each { File file ->
				if (file != null &&
						file.isFile() &&
						safeValueStatic(file.name).toLowerCase(Locale.ENGLISH).startsWith('execution') &&
						safeValueStatic(file.name).toLowerCase(Locale.ENGLISH).endsWith('.log')) {
					candidates << file
				}
			}
		}

		if (candidates.isEmpty()) {
			return null
		}

		candidates.sort { File a, File b -> a.lastModified() <=> b.lastModified() }
		return candidates.last()
	}

	private static List<Map> parseExecutionLogScenariosStatic(File logFile) {
		List<Map> scenarios = []
		List<String> lines = readFileLinesStatic(logFile)

		if (lines.isEmpty()) {
			return scenarios
		}

		Map currentScenario = null

		lines.each { String rawLine ->
			String line = sanitizeLogLineStatic(rawLine)
			if (isBlankStatic(line)) {
				return
			}

			String startedCase = extractStartedCaseStatic(line)
			if (!isBlankStatic(startedCase)) {
				if (currentScenario != null) {
					finalizeScenarioStatic(currentScenario, scenarios)
				}

				currentScenario = [
					id            : 'scenario-' + (scenarios.size() + 1),
					title         : startedCase,
					name          : startedCase,
					status        : 'passed',
					startLabel    : '',
					endLabel      : '',
					durationMs    : 0L,
					durationLabel : '00h 00m 00s',
					steps         : [],
					errorShort    : '',
					errorFull     : '',
					evidence      : []
				]
				return
			}

			if (currentScenario == null) {
				return
			}

			Map parsedStep = parseStepLineStatic(line, currentScenario)
			if (parsedStep != null) {
				currentScenario.steps << parsedStep
				currentScenario.durationMs = toLongStatic(currentScenario.durationMs) + toLongStatic(parsedStep.durationMs)
				return
			}

			if (looksLikeFailureLineStatic(line)) {
				currentScenario.status = 'failed'
				currentScenario.errorFull = appendTextStatic(currentScenario.errorFull, line)
				if (isBlankStatic(currentScenario.errorShort)) {
					currentScenario.errorShort = extractShortErrorStatic(line)
				}

				List<Map> steps = currentScenario.steps as List<Map>
				if (!steps.isEmpty()) {
					Map lastStep = steps.last()
					lastStep.status = 'failed'
					if (isBlankStatic(lastStep.shortError)) {
						lastStep.shortError = extractShortErrorStatic(line)
					}
					lastStep.errorFull = appendTextStatic(lastStep.errorFull, line)
				}
				return
			}

			if (line.startsWith('Reason:')) {
				currentScenario.status = 'failed'
				String reason = safeValueStatic(line.replaceFirst(/^Reason:\s*/, ''))
				currentScenario.errorFull = appendTextStatic(currentScenario.errorFull, reason)
				if (isBlankStatic(currentScenario.errorShort)) {
					currentScenario.errorShort = extractShortErrorStatic(reason)
				}

				List<Map> steps = currentScenario.steps as List<Map>
				if (!steps.isEmpty()) {
					Map lastStep = steps.last()
					lastStep.status = 'failed'
					lastStep.errorFull = appendTextStatic(lastStep.errorFull, reason)
					if (isBlankStatic(lastStep.shortError)) {
						lastStep.shortError = extractShortErrorStatic(reason)
					}
				}
			}
		}

		if (currentScenario != null) {
			finalizeScenarioStatic(currentScenario, scenarios)
		}

		return scenarios
	}

	private static void finalizeScenarioStatic(Map scenario, List<Map> scenarios) {
		if (scenario == null) {
			return
		}

		List<Map> steps = (scenario.steps ?: []) as List<Map>

		if (steps.isEmpty()) {
			steps << [
				id           : scenario.id + '-step-1',
				title        : safeValueStatic(scenario.title),
				detail       : safeValueStatic(scenario.title),
				status       : safeValueStatic(scenario.status),
				timestamp    : '',
				timeLabel    : '',
				durationMs   : toLongStatic(scenario.durationMs),
				durationLabel: formatDurationFullStatic(toLongStatic(scenario.durationMs)),
				shortError   : safeValueStatic(scenario.errorShort),
				errorFull    : safeValueStatic(scenario.errorFull),
				icon         : resolveStepIconStatic(safeValueStatic(scenario.title), safeValueStatic(scenario.status))
			]
		}

		if (safeValueStatic(scenario.status) != 'failed') {
			boolean hasFailedStep = steps.any { Map item -> safeValueStatic(item.status) == 'failed' }
			if (hasFailedStep) {
				scenario.status = 'failed'
			}
		}

		if (isBlankStatic(scenario.errorShort) && safeValueStatic(scenario.status) == 'failed') {
			Map failedStep = steps.find { Map item -> safeValueStatic(item.status) == 'failed' }
			scenario.errorShort = extractShortErrorStatic(
				failedStep != null ? (failedStep.shortError ?: failedStep.errorFull ?: failedStep.detail) : scenario.errorFull
			)
		}

		scenario.durationLabel = formatDurationFullStatic(toLongStatic(scenario.durationMs))
		scenarios << scenario
	}

	private static String extractStartedCaseStatic(String line) {
		def matcher = (line =~ /^START\s+(Test Cases\/.+)$/)
		if (matcher.find()) {
			return safeValueStatic(matcher.group(1))
		}

		matcher = (line =~ /^START\s+(Test Cases\\.+)$/)
		if (matcher.find()) {
			return safeValueStatic(matcher.group(1)).replace('\\', '/')
		}

		return ''
	}

	private static Map parseStepLineStatic(String line, Map currentScenario) {
		def matcher = (line =~ /^(\d+)\s*-\s*(.+?)\s*\(([\d.,]+)s\)\s*$/)
		if (!matcher.find()) {
			return null
		}

		int nextIndex = ((currentScenario.steps ?: []).size()) + 1
		String rawTitle = safeValueStatic(matcher.group(2))
		long durationMs = toMillisFromCompactSecondsStatic(matcher.group(3))

		return [
			id           : currentScenario.id + '-step-' + nextIndex,
			title        : rawTitle,
			detail       : rawTitle,
			status       : 'passed',
			timestamp    : '',
			timeLabel    : '',
			durationMs   : durationMs,
			durationLabel: formatDurationFullStatic(durationMs),
			shortError   : '',
			errorFull    : '',
			icon         : resolveStepIconStatic(rawTitle, 'passed')
		]
	}

	private static boolean looksLikeFailureLineStatic(String line) {
		String lower = safeValueStatic(line).toLowerCase(Locale.ENGLISH)

		return lower.contains('exception') ||
				lower.contains('stepfailedexception') ||
				lower.contains('steperrorexception') ||
				lower.contains('classnotfoundexception') ||
				lower.contains('caused by:') ||
				lower.contains('missingmethodexception') ||
				lower.contains('assertion failed') ||
				lower.contains(' object not found ') ||
				lower.contains(' unable to ') ||
				lower.startsWith('reason:') ||
				lower.contains(' failed.')
	}

	private static List<String> readFileLinesStatic(File file) {
		try {
			return Files.readAllLines(file.toPath(), StandardCharsets.UTF_8)
		} catch (Exception ignored) {
			try {
				return file.readLines()
			} catch (Exception ignoredAgain) {
				return []
			}
		}
	}

	private static String sanitizeLogLineStatic(String rawLine) {
		String line = safeValueStatic(rawLine)
		if (isBlankStatic(line)) {
			return ''
		}

		line = line.replaceAll(/\u001B\[[;\d]*m/, '')
		line = line.replace('\t', ' ')
		line = line.replaceAll(/\s+/, ' ').trim()

		def prefixed = (line =~ /^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3}\s+[A-Z]+\s+.+?\s+-\s+(.*)$/)
		if (prefixed.find()) {
			line = safeValueStatic(prefixed.group(1))
		}

		return line
	}

	// =========================================================================
	// MERGE
	// =========================================================================

	private List<Map> mergeXmlAndLog(List<Map> xmlCases, List<Map> logScenarios) {
		List<Map> result = []
		List<Map> availableLogs = new ArrayList<Map>(logScenarios ?: [])

		if (xmlCases == null || xmlCases.isEmpty()) {
			availableLogs.eachWithIndex { Map logScenario, int index ->
				result << cloneScenario(logScenario, index + 1)
			}
			return result
		}

		xmlCases.eachWithIndex { Map xmlCase, int index ->
			Map matched = findMatchingScenario(xmlCase, availableLogs)
			if (matched != null) {
				availableLogs.remove(matched)
			}

			Map scenario = matched != null ? cloneScenario(matched, index + 1) : buildScenarioFromXmlCase(xmlCase, index + 1)

			String resolvedName = firstNonBlank(
				matched?.name,
				matched?.title,
				xmlCase?.name,
				xmlCase?.shortName,
				"Scenario ${index + 1}"
			)

			scenario.name = resolvedName
			scenario.title = resolvedName

			long xmlDuration = toLong(xmlCase?.durationMs)
			if (xmlDuration > 0L) {
				scenario.durationMs = xmlDuration
				scenario.durationLabel = formatDurationFull(xmlDuration)
			}

			String xmlStatus = safeValue(xmlCase?.status)
			if (!isBlank(xmlStatus)) {
				scenario.status = xmlStatus
			}

			String xmlErrorShort = extractShortError(xmlCase?.message ?: xmlCase?.details)
			String xmlErrorFull = safeValue(xmlCase?.details)

			if (scenario.status == 'failed') {
				if (isBlank(scenario.errorShort)) {
					scenario.errorShort = xmlErrorShort
				}
				if (isBlank(scenario.errorFull)) {
					scenario.errorFull = xmlErrorFull
				}

				List<Map> steps = (scenario.steps ?: []) as List<Map>
				if (!steps.isEmpty() && steps.every { Map step -> safeValue(step.status) != 'failed' }) {
					Map lastStep = steps.last()
					lastStep.status = 'failed'
					lastStep.shortError = isBlank(safeValue(lastStep.shortError)) ? scenario.errorShort : lastStep.shortError
					lastStep.errorFull = isBlank(safeValue(lastStep.errorFull)) ? scenario.errorFull : lastStep.errorFull
					lastStep.icon = resolveStepIcon(safeValue(lastStep.detail ?: lastStep.title), 'failed')
				}
			}

			scenario.durationLabel = formatDurationFull(toLong(scenario.durationMs))
			result << scenario
		}

		return result
	}

	private Map buildScenarioFromXmlCase(Map xmlCase, int index) {
		String title = firstNonBlank(
			xmlCase?.name,
			xmlCase?.shortName,
			"Scenario ${index}"
		)

		long durationMs = toLong(xmlCase?.durationMs)
		String status = safeValue(xmlCase?.status)

		Map step = [
			id           : 'scenario-' + index + '-step-1',
			title        : title,
			detail       : title,
			status       : status,
			timestamp    : '',
			timeLabel    : '',
			durationMs   : durationMs,
			durationLabel: formatDurationFull(durationMs),
			shortError   : extractShortError(xmlCase?.message ?: xmlCase?.details),
			errorFull    : safeValue(xmlCase?.details),
			icon         : resolveStepIcon(title, status)
		]

		return [
			id            : 'scenario-' + index,
			title         : title,
			name          : title,
			status        : status,
			startLabel    : '',
			endLabel      : '',
			durationMs    : durationMs,
			durationLabel : formatDurationFull(durationMs),
			steps         : [step],
			errorShort    : extractShortError(xmlCase?.message ?: xmlCase?.details),
			errorFull     : safeValue(xmlCase?.details),
			evidence      : []
		]
	}

	private Map cloneScenario(Map source, int index) {
		List<Map> steps = []
		(source.steps ?: []).eachWithIndex { Map step, int stepIndex ->
			steps << [
				id           : 'scenario-' + index + '-step-' + (stepIndex + 1),
				title        : safeValue(step.title),
				detail       : firstNonBlank(step.detail, step.title),
				status       : safeValue(step.status),
				timestamp    : firstNonBlank(step.timestamp, step.timeLabel),
				timeLabel    : firstNonBlank(step.timeLabel, step.timestamp),
				durationMs   : toLong(step.durationMs),
				durationLabel: formatDurationFull(toLong(step.durationMs)),
				shortError   : safeValue(step.shortError),
				errorFull    : safeValue(step.errorFull),
				icon         : resolveStepIcon(firstNonBlank(step.detail, step.title), safeValue(step.status))
			]
		}

		return [
			id            : 'scenario-' + index,
			title         : firstNonBlank(source.title, source.name),
			name          : firstNonBlank(source.name, source.title),
			status        : safeValue(source.status),
			startLabel    : safeValue(source.startLabel),
			endLabel      : safeValue(source.endLabel),
			durationMs    : toLong(source.durationMs),
			durationLabel : formatDurationFull(toLong(source.durationMs)),
			steps         : steps,
			errorShort    : safeValue(source.errorShort),
			errorFull     : safeValue(source.errorFull),
			evidence      : []
		]
	}

	private Map findMatchingScenario(Map xmlCase, List<Map> logScenarios) {
		if (xmlCase == null || logScenarios == null || logScenarios.isEmpty()) {
			return null
		}

		String xmlName = normalizeTitle(firstNonBlank(xmlCase.name, xmlCase.shortName))
		if (isBlank(xmlName)) {
			return null
		}

		Map exact = logScenarios.find { Map item ->
			String logName = normalizeTitle(firstNonBlank(item.name, item.title))
			return !isBlank(logName) && logName == xmlName
		}

		if (exact != null) {
			return exact
		}

		String xmlLeaf = normalizeTitle(lastPathToken(firstNonBlank(xmlCase.name, xmlCase.shortName)))

		Map partial = logScenarios.find { Map item ->
			String logName = normalizeTitle(firstNonBlank(item.name, item.title))
			String logLeaf = normalizeTitle(lastPathToken(firstNonBlank(item.name, item.title)))
			return (!isBlank(xmlLeaf) && xmlLeaf == logLeaf) ||
					(!isBlank(xmlLeaf) && logName.contains(xmlLeaf)) ||
					(!isBlank(logLeaf) && xmlName.contains(logLeaf))
		}

		return partial
	}

	// =========================================================================
	// EVIDENCE FROM NATIVE KATALON HTML
	// =========================================================================

	private File findNativeKatalonHtmlReport(File reportDir) {
		if (reportDir == null || !reportDir.exists() || !reportDir.isDirectory()) {
			return null
		}

		String customName = safeValue(resolveReportFileName()).toLowerCase(Locale.ENGLISH)

		List<File> htmlFiles = []
		File[] files = reportDir.listFiles()

		if (files != null) {
			files.each { File file ->
				if (file != null && file.isFile()) {
					String lower = safeValue(file.name).toLowerCase(Locale.ENGLISH)
					if (lower.endsWith('.html') && lower != customName) {
						htmlFiles << file
					}
				}
			}
		}

		if (htmlFiles.isEmpty()) {
			return null
		}

		File preferred = htmlFiles.find { File file ->
			safeValue(file.name) ==~ /\d{8,}_\d+\.html/i
		}

		if (preferred != null) {
			return preferred
		}

		htmlFiles.sort { File a, File b -> a.lastModified() <=> b.lastModified() }
		return htmlFiles.last()
	}

	private void attachEvidenceFromNativeHtml(File reportDir, File nativeHtml, List<Map> scenarios) {
		scenarios.each { Map scenario ->
			scenario.evidence = []
		}

		if (nativeHtml == null || !nativeHtml.exists()) {
			return
		}

		String html = readFileText(nativeHtml)
		if (isBlank(html)) {
			return
		}

		List<String> allImageSources = extractAllImageSources(html)
		Set<String> used = new LinkedHashSet<String>()

		List<Map> failedScenarios = scenarios.findAll { Map item ->
			safeValue(item.status) == 'failed'
		}

		failedScenarios.each { Map scenario ->
			String imageSource = findImageNearScenario(html, firstNonBlank(scenario.name, scenario.title))

			if (isBlank(imageSource)) {
				imageSource = allImageSources.find { String src -> !used.contains(src) }
			}

			if (isBlank(imageSource)) {
				return
			}

			used.add(imageSource)

			Map evidence = buildEvidenceEntryFromSource(reportDir, imageSource, firstNonBlank(scenario.name, scenario.title))
			if (evidence != null) {
				scenario.evidence = [evidence]
			}
		}
	}

	private String findImageNearScenario(String html, String scenarioTitle) {
		if (isBlank(html) || isBlank(scenarioTitle)) {
			return ''
		}

		List<String> candidates = []
		candidates << safeValue(scenarioTitle)
		candidates << lastPathToken(scenarioTitle)

		for (String candidate : candidates.findAll { !isBlank(it) }) {
			int index = indexOfIgnoreCase(html, candidate)
			if (index >= 0) {
				int end = Math.min(html.length(), index + 220000)
				String slice = html.substring(index, end)
				String src = firstUsefulImageFromHtml(slice)
				if (!isBlank(src)) {
					return src
				}
			}
		}

		return ''
	}

	private String firstUsefulImageFromHtml(String htmlSlice) {
		List<String> sources = extractAllImageSources(htmlSlice)
		return sources.isEmpty() ? '' : safeValue(sources[0])
	}

	private List<String> extractAllImageSources(String html) {
		List<String> sources = []
		if (isBlank(html)) {
			return sources
		}

		def matcher = (html =~ /(?is)<img\b[^>]*\bsrc\s*=\s*["']([^"']+)["'][^>]*>/)
		while (matcher.find()) {
			String src = safeValue(matcher.group(1))
			if (isUsefulImageSource(src)) {
				sources << src
			}
		}

		return sources.unique()
	}

	private boolean isUsefulImageSource(String src) {
		String value = safeValue(src)
		if (isBlank(value)) {
			return false
		}

		String lower = value.toLowerCase(Locale.ENGLISH)

		if (lower.startsWith('data:image/') && value.length() > 200) {
			return true
		}

		return lower.endsWith('.png') ||
				lower.endsWith('.jpg') ||
				lower.endsWith('.jpeg') ||
				lower.endsWith('.webp') ||
				lower.endsWith('.gif') ||
				lower.endsWith('.bmp')
	}

	private Map buildEvidenceEntryFromSource(File reportDir, String src, String scenarioTitle) {
		String value = safeValue(src)
		if (isBlank(value)) {
			return null
		}

		if (value.startsWith('data:image/')) {
			return [
				name  : 'Failure Evidence',
				href  : value,
				image : true,
				imgSrc: value
			]
		}

		File imageFile = resolveImageFile(reportDir, value)
		if (imageFile != null && imageFile.exists() && imageFile.isFile()) {
			String dataUri = fileToDataUri(imageFile)
			String href = imageFile.toURI().toString()

			return [
				name  : imageFile.name,
				href  : href,
				image : true,
				imgSrc: isBlank(dataUri) ? href : dataUri
			]
		}

		return [
			name  : 'Failure Evidence',
			href  : value,
			image : true,
			imgSrc: value
		]
	}

	private File resolveImageFile(File reportDir, String rawPath) {
		String value = safeValue(rawPath)
		if (isBlank(value)) {
			return null
		}

		try {
			if (value.toLowerCase(Locale.ENGLISH).startsWith('file:/')) {
				File file = new File(new URI(value))
				if (file.exists()) {
					return file
				}
			}
		} catch (Exception ignored) {
		}

		File direct = new File(value)
		if (direct.exists()) {
			return direct
		}

		if (reportDir != null) {
			File relative = new File(reportDir, value)
			if (relative.exists()) {
				return relative
			}
		}

		return null
	}

	private String fileToDataUri(File file) {
		if (file == null || !file.exists() || !file.isFile()) {
			return ''
		}

		try {
			byte[] content = Files.readAllBytes(file.toPath())
			String mime = resolveImageMime(file.name)
			return 'data:' + mime + ';base64,' + Base64.encoder.encodeToString(content)
		} catch (Exception ignored) {
			return ''
		}
	}

	private String resolveImageMime(String fileName) {
		String lower = safeValue(fileName).toLowerCase(Locale.ENGLISH)

		if (lower.endsWith('.png')) {
			return 'image/png'
		}
		if (lower.endsWith('.jpg') || lower.endsWith('.jpeg')) {
			return 'image/jpeg'
		}
		if (lower.endsWith('.webp')) {
			return 'image/webp'
		}
		if (lower.endsWith('.gif')) {
			return 'image/gif'
		}
		if (lower.endsWith('.bmp')) {
			return 'image/bmp'
		}

		return 'image/png'
	}

	// =========================================================================
	// TIMING
	// =========================================================================

	private void applySequentialTimingFallback(File reportDir, List<Map> scenarios) {
		if (scenarios == null || scenarios.isEmpty()) {
			return
		}

		long totalDurationMs = 0L
		scenarios.each { Map item ->
			totalDurationMs += toLong(item.durationMs)
		}

		Date suiteEnd = new Date(reportDir.lastModified())
		Date suiteStart = new Date(suiteEnd.time - totalDurationMs)
		long cursor = suiteStart.time

		scenarios.each { Map scenario ->
			long scenarioDuration = toLong(scenario.durationMs)
			if (scenarioDuration <= 0L) {
				scenarioDuration = Math.max(1000L, sumStepDurations((scenario.steps ?: []) as List<Map>))
				scenario.durationMs = scenarioDuration
			}

			if (isBlank(scenario.startLabel)) {
				scenario.startLabel = formatTimeOnly(new Date(cursor))
			}
			if (isBlank(scenario.endLabel)) {
				scenario.endLabel = formatTimeOnly(new Date(cursor + scenarioDuration))
			}

			fillStepTimes(scenario, cursor)
			scenario.durationLabel = formatDurationFull(scenarioDuration)
			cursor += scenarioDuration
		}
	}

	private void fillStepTimes(Map scenario, long scenarioStartMillis) {
		List<Map> steps = (scenario.steps ?: []) as List<Map>
		if (steps.isEmpty()) {
			return
		}

		long cursor = scenarioStartMillis

		steps.each { Map step ->
			if (isBlank(step.timestamp) && isBlank(step.timeLabel)) {
				step.timestamp = formatTimeOnly(new Date(cursor))
				step.timeLabel = step.timestamp
			}

			long durationMs = toLong(step.durationMs)
			if (durationMs <= 0L) {
				durationMs = 1000L
				step.durationMs = durationMs
			}

			step.durationLabel = formatDurationFull(durationMs)
			cursor += durationMs
		}
	}

	private long sumStepDurations(List<Map> steps) {
		long total = 0L
		steps.each { Map item ->
			total += toLong(item.durationMs)
		}
		return total
	}

