	@Keyword
	void validateLandingPage(Integer timeoutSeconds) {

		Integer timeout = safeTimeout(timeoutSeconds, 3)
		List<String> errors = []

		logStep(
			'LANDING PAGE',
			'Validate bottom bar, calendar and top bar controls'
		)

		validateBottomBar(errors)
		validateCalendar(timeout, errors)
		validateLandingTopBar(timeout, errors)

		takeEvidence('GUI_LandingPageValidation.png')

		finishValidation(
			'Landing page validation',
			errors
		)
	}


	private void validateBottomBar(List<String> errors) {

		logObjectSearch(
			'bottomBarFields',
			'Bottom bar information'
		)

		List<RemoteWebElement> fields = []

		try {
			fields = Windows.findElements(
				object('bottomBarFields')
			) as List<RemoteWebElement>
		} catch (Exception e) {
			errors.add('Bottom bar elements could not be read.')

			KeywordUtil.logInfo(
				'[FAIL] Bottom bar elements could not be read.\n' +
				'Reason: ' + safeMessage(e)
			)

			return
		}

		List<String> values = fields.collect { RemoteWebElement element ->
			safeText(element?.getText())
		}.findAll { String value ->
			!value.isEmpty()
		}

		KeywordUtil.logInfo(
			'[INFO] Bottom bar values found: ' + values
		)

		if (values.isEmpty()) {
			errors.add('Bottom bar does not contain readable information.')
			return
		}

		boolean environmentFound = values.any { String value ->
			value.equalsIgnoreCase('Recette') ||
			value.equalsIgnoreCase('Production') ||
			value.equalsIgnoreCase('REC') ||
			value.equalsIgnoreCase('PRD')
		}

		boolean closingDateFound = values.any { String value ->
			value ==~ /.*\d{2}\/\d{2}\/\d{4}.*/
		}

		boolean currencyFound = values.any { String value ->
			value ==~ /(?i).*\b[A-Z]{3}\b.*/
		}

		reportBooleanResult(
			environmentFound,
			'Environment is displayed in the bottom bar.',
			'Environment is not displayed in the bottom bar.',
			errors
		)

		reportBooleanResult(
			closingDateFound,
			'Closing date is displayed in the bottom bar.',
			'Closing date is not correctly displayed.',
			errors
		)

		reportBooleanResult(
			currencyFound,
			'Currency is displayed in the bottom bar.',
			'Currency is not correctly displayed.',
			errors
		)
	}


