import java.math.RoundingMode

import org.apache.poi.ss.usermodel.Sheet
import org.apache.poi.ss.usermodel.Workbook
import org.apache.poi.ss.usermodel.WorkbookFactory

import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil

import internal.GlobalVariable

// ======================================================
// VALIDATION CONFIG
// ======================================================

Integer columnIndex = 28
String validationName = 'Élément Valorisé'
String expectedColumnName = 'Valo Finale CCY'

List compareRows = GlobalVariable.compareRows as ArrayList
List compareFiles = GlobalVariable.compareFiles as ArrayList

// ======================================================
// TEST FLOW
// ======================================================

String errors = ''
String passedDetails = ''

FileInputStream inputRec = null
FileInputStream inputPrd = null

Workbook workbookRec = null
Workbook workbookPrd = null

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Start REC x PRD validation\n' +
	'Feature: ' + validationName + '\n' +
	'Column index: ' + columnIndex + '\n' +
	'Expected column: ' + expectedColumnName
)

try {
	if (compareRows != null && compareRows.size() > 0) {
		if (compareRows.size() < 2) {
			KeywordUtil.markFailedAndStop(
				'Rows validation cannot be executed.\n' +
				'Expected row results: 2\n' +
				'Available row results: ' + compareRows.size()
			)
		}

		String recRows = String.valueOf(compareRows.get(0))
		String prdRows = String.valueOf(compareRows.get(1))

		if (recRows != prdRows) {
			errors +=
				'\n[ERROR] Number of rows is different between environments.' +
				'\nREC: ' + recRows +
				'\nPRD: ' + prdRows
		} else {
			passedDetails +=
				'\n[PASS] Number of rows is equal.' +
				'\nREC: ' + recRows +
				'\nPRD: ' + prdRows
		}

		CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
			(errors.isEmpty() ? '[PASS] ' : '[FAIL] ') +
			'Rows validation\n' +
			'REC rows: ' + recRows + '\n' +
			'PRD rows: ' + prdRows
		)
	} else {
		if (compareFiles == null || compareFiles.size() < 2) {
			KeywordUtil.markFailedAndStop(
				'Exported files validation cannot be executed.\n' +
				'Expected files: 2\n' +
				'Available files: ' +
				(compareFiles == null ? 0 : compareFiles.size())
			)
		}

		File recFile = resolveExportedFile(compareFiles.get(0))
		File prdFile = resolveExportedFile(compareFiles.get(1))

		if (recFile == null || !recFile.exists()) {
			KeywordUtil.markFailedAndStop(
				'REC exported file was not found.\n' +
				'File: ' + fileNameOnly(compareFiles.get(0))
			)
		}

		if (prdFile == null || !prdFile.exists()) {
			KeywordUtil.markFailedAndStop(
				'PRD exported file was not found.\n' +
				'File: ' + fileNameOnly(compareFiles.get(1))
			)
		}

		CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
			'[PASS] Files selected for validation\n' +
			'REC file: ' + recFile.getName() + '\n' +
			'PRD file: ' + prdFile.getName()
		)

		inputRec = new FileInputStream(recFile)
		inputPrd = new FileInputStream(prdFile)

		workbookRec = WorkbookFactory.create(inputRec)
		workbookPrd = WorkbookFactory.create(inputPrd)

		Sheet sheetRec = workbookRec.getSheetAt(0)
		Sheet sheetPrd = workbookPrd.getSheetAt(0)

		Integer recLastRow = sheetRec.getLastRowNum()
		Integer prdLastRow = sheetPrd.getLastRowNum()

		String columnName = expectedColumnName

		if (sheetRec.getRow(0) != null &&
			sheetRec.getRow(0).getCell(columnIndex) != null) {

			columnName = sheetRec
				.getRow(0)
				.getCell(columnIndex)
				.toString()
		}

		if (recLastRow != prdLastRow) {
			errors +=
				'\n[ERROR] Number of rows is different.' +
				'\nREC: ' + recLastRow +
				'\nPRD: ' + prdLastRow
		} else {
			passedDetails +=
				'\n[PASS] Number of rows is equal: ' + recLastRow
		}

		BigDecimal recSum =
			CustomKeywords.'com.katalon.keywords.excelHandling.ExcelValidations.totalSum'(
				sheetRec,
				columnIndex
			)

		BigDecimal prdSum =
			CustomKeywords.'com.katalon.keywords.excelHandling.ExcelValidations.totalSum'(
				sheetPrd,
				columnIndex
			)

		recSum = recSum.setScale(2, RoundingMode.HALF_EVEN)
		prdSum = prdSum.setScale(2, RoundingMode.HALF_EVEN)

		if (recSum.compareTo(prdSum) != 0) {
			errors +=
				'\n[ERROR] Column sum is different.' +
				'\nColumn: ' + columnName +
				'\nREC: ' + recSum +
				'\nPRD: ' + prdSum
		} else {
			passedDetails +=
				'\n[PASS] Column sum is equal.' +
				'\nColumn: ' + columnName +
				'\nValue: ' + recSum
		}

		BigDecimal recMin =
			CustomKeywords.'com.katalon.keywords.excelHandling.ExcelValidations.minAmount'(
				sheetRec,
				columnIndex
			)

		BigDecimal prdMin =
			CustomKeywords.'com.katalon.keywords.excelHandling.ExcelValidations.minAmount'(
				sheetPrd,
				columnIndex
			)

		recMin = recMin.setScale(2, RoundingMode.HALF_EVEN)
		prdMin = prdMin.setScale(2, RoundingMode.HALF_EVEN)

		if (recMin.compareTo(prdMin) != 0) {
			errors +=
				'\n[ERROR] Minimum value is different.' +
				'\nColumn: ' + columnName +
				'\nREC: ' + recMin +
				'\nPRD: ' + prdMin
		} else {
			passedDetails +=
				'\n[PASS] Minimum value is equal.' +
				'\nColumn: ' + columnName +
				'\nValue: ' + recMin
		}

		BigDecimal recMax =
			CustomKeywords.'com.katalon.keywords.excelHandling.ExcelValidations.maxAmount'(
				sheetRec,
				columnIndex
			)

		BigDecimal prdMax =
			CustomKeywords.'com.katalon.keywords.excelHandling.ExcelValidations.maxAmount'(
				sheetPrd,
				columnIndex
			)

		recMax = recMax.setScale(2, RoundingMode.HALF_EVEN)
		prdMax = prdMax.setScale(2, RoundingMode.HALF_EVEN)

		if (recMax.compareTo(prdMax) != 0) {
			errors +=
				'\n[ERROR] Maximum value is different.' +
				'\nColumn: ' + columnName +
				'\nREC: ' + recMax +
				'\nPRD: ' + prdMax
		} else {
			passedDetails +=
				'\n[PASS] Maximum value is equal.' +
				'\nColumn: ' + columnName +
				'\nValue: ' + recMax
		}

		CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
			(errors.isEmpty() ? '[PASS] ' : '[FAIL] ') +
			'Excel validation result\n' +
			'Column: ' + columnName + '\n' +
			'REC rows: ' + recLastRow + '\n' +
			'PRD rows: ' + prdLastRow + '\n' +
			'REC sum: ' + recSum + '\n' +
			'PRD sum: ' + prdSum + '\n' +
			'REC minimum: ' + recMin + '\n' +
			'PRD minimum: ' + prdMin + '\n' +
			'REC maximum: ' + recMax + '\n' +
			'PRD maximum: ' + prdMax
		)
	}
} finally {
	try {
		if (workbookRec != null) {
			workbookRec.close()
		}
	} catch (Exception ignored) {
	}

	try {
		if (workbookPrd != null) {
			workbookPrd.close()
		}
	} catch (Exception ignored) {
	}

	try {
		if (inputRec != null) {
			inputRec.close()
		}
	} catch (Exception ignored) {
	}

	try {
		if (inputPrd != null) {
			inputPrd.close()
		}
	} catch (Exception ignored) {
	}
}

if (!errors.isEmpty()) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[FAIL] Final validation result\n' +
		errors.trim() + '\n\n' +
		passedDetails.trim()
	)

	KeywordUtil.markFailed(
		'REC x PRD validation failed for ' + validationName + '.\n' +
		errors.trim()
	)
} else {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[PASS] Final validation result\n' +
		'REC x PRD validation completed successfully.\n' +
		passedDetails.trim()
	)

	KeywordUtil.markPassed(
		'REC x PRD validation completed successfully for ' +
		validationName + '.'
	)
}

File resolveExportedFile(Object fileValue) {
	if (fileValue == null) {
		return null
	}

	String receivedValue = String.valueOf(fileValue).trim()

	if (receivedValue.isEmpty()) {
		return null
	}

	File receivedFile = new File(receivedValue)

	if (receivedFile.exists() && receivedFile.isFile()) {
		return receivedFile
	}

	String expectedFileName = receivedFile.getName()

	List<File> searchRoots = [
		new File(RunConfiguration.getReportFolder()),
		new File(RunConfiguration.getProjectDir(), 'Reports')
	]

	for (File root : searchRoots) {
		File foundFile = findFileRecursively(root, expectedFileName)

		if (foundFile != null) {
			return foundFile
		}
	}

	return null
}

File findFileRecursively(File directory, String expectedFileName) {
	if (directory == null ||
		!directory.exists() ||
		!directory.isDirectory()) {

		return null
	}

	File[] files = directory.listFiles()

	if (files == null) {
		return null
	}

	for (File file : files) {
		if (file.isFile() &&
			file.getName().equalsIgnoreCase(expectedFileName)) {

			return file
		}
	}

	for (File file : files) {
		if (file.isDirectory()) {
			File foundFile = findFileRecursively(
				file,
				expectedFileName
			)

			if (foundFile != null) {
				return foundFile
			}
		}
	}

	return null
}

String fileNameOnly(Object value) {
	if (value == null) {
		return 'NOT FOUND'
	}

	return new File(String.valueOf(value)).getName()
}
