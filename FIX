class RechercheKeywords {
	private static final Integer DEFAULT_TIMEOUT = 20
	private static final Integer POLLING_DELAY_SECONDS = 1
	private final ImageLoader imageLoader = new ImageLoader()

	@Keyword
	Map applyRechercheTextFilter(String imageGroup, String objectGroup, String rechercheTabImageKey, String rechercheTabObjectKey, String inputObjectKey, String searchButtonObjectKey, String filterValue, Integer timeoutSeconds) {
		Integer timeout = safeTimeout(timeoutSeconds)
		String value = safeText(filterValue)
		if (value.isEmpty()) { KeywordUtil.markFailedAndStop('Recherche filter value cannot be empty.'); return [:] }

		openRechercheTab(imageGroup, objectGroup, rechercheTabImageKey, rechercheTabObjectKey, timeout)
		WindowsTestObject inputObject = object(objectGroup, inputObjectKey)
		if (!Windows.waitForElementPresent(inputObject, timeout, FailureHandling.OPTIONAL)) {
			KeywordUtil.markFailedAndStop('Recherche input was not found.\nObject group: ' + objectGroup + '\nObject key: ' + inputObjectKey)
			return [:]
		}
		replaceText(inputObject, value)
		Windows.delay(POLLING_DELAY_SECONDS)

		WindowsTestObject searchButton = object(objectGroup, searchButtonObjectKey)
		if (!Windows.waitForElementPresent(searchButton, timeout, FailureHandling.OPTIONAL)) {
			KeywordUtil.markFailedAndStop('Recherche button was not found.\nObject group: ' + objectGroup + '\nObject key: ' + searchButtonObjectKey)
			return [:]
		}
		Windows.click(searchButton, FailureHandling.STOP_ON_FAILURE)
		Windows.delay(2)
		KeywordUtil.logInfo('[PASS] Recherche filter applied successfully. Value: ' + value)
		return [value: value, objectGroup: objectGroup]
	}

	private void openRechercheTab(String imageGroup, String objectGroup, String imageKey, String objectKey, Integer timeoutSeconds) {
		Integer timeout = safeTimeout(timeoutSeconds)
		try {
			if (imageLoader.waitForImage(imageGroup, imageKey, Math.min(timeout, 5))) {
				WindowsImageKeywords.clickImage(imageLoader.getImage(imageGroup, imageKey))
				Windows.delay(POLLING_DELAY_SECONDS)
				return
			}
		} catch (Throwable imageError) { KeywordUtil.logInfo('[IMAGE] Recherche tab could not be opened by image. Trying Windows object.\nReason: ' + safeText(imageError.message)) }

		WindowsTestObject tabObject = object(objectGroup, objectKey)
		if (!Windows.waitForElementPresent(tabObject, timeout, FailureHandling.OPTIONAL)) {
			KeywordUtil.markFailedAndStop('Recherche tab was not found.\nImage group: ' + imageGroup + '\nImage key: ' + imageKey + '\nObject group: ' + objectGroup + '\nObject key: ' + objectKey)
			return
		}
		Windows.click(tabObject, FailureHandling.STOP_ON_FAILURE)
		Windows.delay(POLLING_DELAY_SECONDS)
	}

	private void replaceText(WindowsTestObject inputObject, String value) {
		Windows.click(inputObject, FailureHandling.STOP_ON_FAILURE)
		Robot robot = new Robot()
		robot.keyPress(KeyEvent.VK_CONTROL); robot.keyPress(KeyEvent.VK_A); robot.keyRelease(KeyEvent.VK_A); robot.keyRelease(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_BACK_SPACE); robot.keyRelease(KeyEvent.VK_BACK_SPACE)
		Windows.setText(inputObject, value)
	}

	private WindowsTestObject object(String objectGroup, String objectKey) { return WindowsObjectLoader.getObject(objectGroup, objectKey) }
	private Integer safeTimeout(Integer timeoutSeconds) { return timeoutSeconds != null && timeoutSeconds > 0 ? timeoutSeconds : DEFAULT_TIMEOUT }
	private String safeText(Object value) { return value == null ? '' : value.toString().trim() }
}


































































