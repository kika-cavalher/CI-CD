	private Map readFileData(
			File file,
			int columnIndex,
			String expectedColumnName,
			String environment,
			boolean treatBlankCellsAsZero) {

		Map result = [
			columnName                 : '',
			rows                       : 0,
			numericValues              : 0,
			zeroValues                 : 0,
			nonZeroValues              : 0,
			blankValues                : 0,
			blankValuesTreatedAsZero   : 0,
			unreadableValues           : 0,
			unreadableSamples          : [],
			onlyZeroValues             : false,
			columnStatus               : 'NOT_ANALYSED',
			sum                        : null,
			minimum                    : null,
			maximum                    : null,
			errors                     : ''
		]

		StringBuilder errors = new StringBuilder()
		FileInputStream input = null
		Workbook workbook = null

		try {
			input = new FileInputStream(file)
			workbook = WorkbookFactory.create(input)

			if (workbook.getNumberOfSheets() == 0) {
				errors.append('[ERROR] ')
						.append(environment)
						.append(
						' workbook does not contain worksheets.\n'
						)
						.append('File: ')
						.append(file.getName())

				result.errors = errors.toString()
				return result
			}

			Sheet sheet = workbook.getSheetAt(0)
			DataFormatter formatter = new DataFormatter()

			FormulaEvaluator evaluator =
					workbook
					.getCreationHelper()
					.createFormulaEvaluator()

			String columnName =
					readHeaderName(
					sheet,
					columnIndex,
					formatter
					)

			result.columnName = columnName

			if (columnName.isEmpty()) {
				errors.append('[ERROR] ')
						.append(environment)
						.append(
						' column header was not found.\n'
						)
						.append('Column index: ')
						.append(columnIndex)
						.append('\n')
			} else if (!normalizeText(columnName).equals(
					normalizeText(expectedColumnName))) {

				errors.append('[ERROR] Unexpected ')
						.append(environment)
						.append(
						' column header.\n'
						)
						.append('Expected: ')
						.append(safeText(expectedColumnName))
						.append('\nFound: ')
						.append(columnName)
						.append('\n')
			}

			BigDecimal sum = BigDecimal.ZERO
			BigDecimal minimum = null
			BigDecimal maximum = null

			int numericValues = 0
			int zeroValues = 0
			int nonZeroValues = 0
			int blankValues = 0
			int blankValuesTreatedAsZero = 0
			int unreadableValues = 0
			int rows = 0
			List<String> unreadableSamples = []

			for (int rowIndex = 1;
					rowIndex <= sheet.getLastRowNum();
					rowIndex++) {

				Row row = sheet.getRow(rowIndex)

				if (row == null ||
						isRowEmpty(row, formatter)) {

					continue
				}

				rows++

				Cell targetCell = row.getCell(columnIndex)

				BigDecimal value =
						getCellNumber(
						row,
						columnIndex,
						formatter,
						evaluator
						)

				if (value == null) {
					String displayText =
							readCellDisplayText(
							targetCell,
							formatter,
							evaluator
							)

					if (isBlankCell(targetCell, displayText)) {
						blankValues++

						if (treatBlankCellsAsZero) {
							value = BigDecimal.ZERO
							blankValuesTreatedAsZero++
						} else {
							continue
						}
					} else {
						unreadableValues++

						if (unreadableSamples.size() < 5) {
							unreadableSamples.add(
									'Row ' +
									(rowIndex + 1) +
									': "' +
									displayText +
									'"'
									)
						}

						continue
					}
				}

				sum = sum.add(value)

				if (minimum == null ||
						value.compareTo(minimum) < 0) {

					minimum = value
				}

				if (maximum == null ||
						value.compareTo(maximum) > 0) {

					maximum = value
				}

				if (value.compareTo(BigDecimal.ZERO) == 0) {
					zeroValues++
				} else {
					nonZeroValues++
				}

				numericValues++
			}

			result.rows = rows
			result.numericValues = numericValues
			result.zeroValues = zeroValues
			result.nonZeroValues = nonZeroValues
			result.blankValues = blankValues
			result.blankValuesTreatedAsZero =
					blankValuesTreatedAsZero
			result.unreadableValues = unreadableValues
			result.unreadableSamples = unreadableSamples

			if (rows == 0) {
				result.columnStatus = 'NO_DATA_ROWS'

				errors.append('[ERROR] ')
						.append(environment)
						.append(' export does not contain data rows.\n')
						.append('Column: ')
						.append(columnName)
						.append('\nRows analysed: 0\n')
			} else {
				if (numericValues > 0) {
					result.sum = round2(sum)
					result.minimum = round2(minimum)
					result.maximum = round2(maximum)
					result.onlyZeroValues = nonZeroValues == 0

					if (result.onlyZeroValues) {
						result.columnStatus =
								blankValuesTreatedAsZero > 0
								? 'ONLY_ZERO_VALUES_WITH_BLANKS_AS_ZERO'
								: 'ONLY_ZERO_VALUES'
					} else {
						result.columnStatus = 'NUMERIC_VALUES_FOUND'
					}
				}

				if (unreadableValues > 0) {

					result.columnStatus =
							numericValues > 0
							? 'NUMERIC_VALUES_WITH_NON_NUMERIC_CELLS'
							: 'NON_NUMERIC_VALUES'

					errors.append('[ERROR] ')
							.append(environment)
							.append(
							' column contains non-numeric values.\n'
							)
							.append('Column: ')
							.append(columnName)
							.append('\n')
				} else if (numericValues == 0 &&
						blankValues == rows) {

					result.columnStatus = 'EMPTY_COLUMN'

					errors.append('[ERROR] ')
							.append(environment)
							.append(
							' column is empty in every analysed data row.\n'
							)
							.append('Column: ')
							.append(columnName)
							.append('\n')
				} else if (numericValues == 0) {

					result.columnStatus = 'NO_NUMERIC_VALUES'

					errors.append('[ERROR] ')
							.append(environment)
							.append(
							' column contains no numeric values.\n'
							)
							.append('Column: ')
							.append(columnName)
							.append('\n')
				}
			}

			result.errors = errors.toString().trim()
			return result
		} finally {
			closeWorkbook(workbook)
			closeInput(input)
		}
	}


