String cleanErrorLineForReport(
		String errorLine,
		List<File> files
) {
	String line =
			errorLine == null ?
				'' :
				errorLine.trim()

	line =
			line.replace(
			'[ERROR]',
			''
				).trim()

	line =
			line.replace(
			'[FAIL]',
			''
				).trim()

	line =
			line.replace(
			'[FAILED]',
			''
				).trim()

	line =
			line.replace(
			'[PASS]',
			''
				).trim()

	line =
			line.replace(
			'[PASSED]',
			''
				).trim()

	line =
			line.replace(
			'[SKIPPED]',
			''
				).trim()

	line =
			line.replaceFirst(
			'^\\s*[^A-Za-z0-9\\[]+\\s*',
			''
				).trim()

	line =
			line.replaceAll(
			'^com\\.kms\\.katalon\\.core\\.exception\\.StepFailedException:\\s*',
			''
				).trim()

	line =
			line.replaceAll(
			'^Reason:\\s*com\\.kms\\.katalon\\.core\\.exception\\.StepFailedException:\\s*',
			'Reason: '
				).trim()

	for (File file : files ?: []) {
		line =
				line.replace(
				file.getAbsolutePath(),
				file.getName()
					)

		line =
				line.replace(
				file.getPath(),
				file.getName()
					)
	}

	line =
			stripPathsKeepingFileNames(
			line
				)

	return line.trim()
}

String stripPathsKeepingFileNames(
		String value
) {
	String line =
			value == null ?
				'' :
				value

	line =
			line.replace(
			'\\',
			'/'
				)

	line =
			line.replaceAll(
			'[A-Za-z]:/[^\\s|"]*/([^/\\s|"]+\\.xlsx)',
			'$1'
				)

	line =
			line.replaceAll(
			'[A-Za-z]:/[^\\s|"]*/([^/\\s|"]+\\.xls)',
			'$1'
				)

	return line
}

BigDecimal parseDecimalOrNull(
		String value
) {
	String text =
			value == null ?
				'' :
				value.trim()

	if (text.isEmpty() ||
			text == '-') {
		return null
	}

	String clean =
			text
			.replace(
			' ',
			''
				)
			.replace(
			"'",
			''
				)

	if (clean.startsWith(
			'('
			) &&
			clean.endsWith(
			')'
			)) {
		clean =
				'-' +
				clean.substring(
				1,
				clean.length() - 1
					)
	}

	if (clean.contains(
			','
			) &&
			clean.contains(
			'.'
			)) {
		Integer lastComma =
				clean.lastIndexOf(
				','
					)

		Integer lastDot =
				clean.lastIndexOf(
				'.'
					)

		if (lastComma >
				lastDot) {
			clean =
				clean
					.replace(
					'.',
					''
						)
					.replace(
					',',
					'.'
						)
		} else {
			clean =
				clean.replace(
				',',
				''
					)
		}
	} else if (clean.contains(
			','
			) &&
			!clean.contains(
			'.'
			)) {
		clean =
			clean.replace(
				',',
				'.'
					)
	}

	try {
		return new BigDecimal(
				clean
				)
	} catch (Throwable ignored) {
		return null
	}
}

BigDecimal parseDecimalOrDefault(
		String value,
		BigDecimal defaultValue
) {
	BigDecimal parsed =
			parseDecimalOrNull(
			value
				)

	return parsed == null ?
			defaultValue :
			parsed
}

String extractByRegex(
		String text,
		String pattern
) {
	try {
		def matcher =
				text =~ pattern

		if (matcher.find()) {
			return matcher
					.group(
					1
						)
					.trim()
		}
	} catch (Throwable ignored) {
	}

	return ''
}

String formatDecimal(
		BigDecimal value
) {
	if (value == null) {
		return '-'
	}

	BigDecimal normalized =
			value
			.setScale(
			4,
			RoundingMode.HALF_UP
				)
			.stripTrailingZeros()

	return normalized.toPlainString()
}

String safeText(
		Object value
) {
	String text =
			value == null ?
				'' :
				String.valueOf(
				value
					).trim()

	return text.isEmpty() ?
			'' :
			text
}

String tableValue(
		Object value
) {
	String text =
			safeText(
			value
				)

	if (text.isEmpty()) {
		return '-'
	}

	return text.replace(
			'|',
			'/'
			)
}

Integer parseIntOrDefault(
		String value,
		Integer defaultValue
) {
	try {
		return Integer.parseInt(
				value == null ?
					'' :
					value.trim()
				)
	} catch (Exception ignored) {
		return defaultValue
	}
}

String readTcVariable(
		String variableName,
		String defaultValue
) {
	try {
		if (getBinding() != null &&
				getBinding().hasVariable(
				variableName
					)) {
			Object raw =
					getBinding().getVariable(
					variableName
						)

			String value =
					raw == null ?
						'' :
						String.valueOf(
						raw
							).trim()

			if (!value.isEmpty()) {
				return value
			}
		}
	} catch (Throwable ignored) {
	}

	return defaultValue
}









