@Keyword
void closeAllTabsAndOpenFavorite(
	String favoriteTitle,
	String openedTabName,
	String favoriteImageKey,
	Integer timeoutSeconds
) {

	Integer timeout =
		timeoutSeconds == null || timeoutSeconds <= 0
			? 40
			: timeoutSeconds

	Integer shortTimeout = 5
	Integer maxCloseAttempts = 3

	logStep(
		'OPEN FAVORITE',
		'Favorite title: ' + favoriteTitle + '\n' +
		'Tab to close: ' + openedTabName + '\n' +
		'Image fallback: ' + favoriteImageKey
	)

	WindowsTestObject openedTab =
		WindowsObjectLoader.getTabByName(
			openedTabName
		)

	// ======================================================
	// DISMISS PREVIOUS FAVORITE MODAL
	// ======================================================

	KeywordUtil.logInfo(
		'[KEYBOARD] Dismissing any previous modal before closing tabs.'
	)

	pressKeyboardKey(
		KeyEvent.VK_ENTER
	)

	Windows.delay(2)

	// ======================================================
	// CLOSE ALL OPENED TABS
	// ======================================================

	boolean tabClosed = false

	for (
		Integer attempt = 1;
		attempt <= maxCloseAttempts;
		attempt++
	) {

		boolean tabStillPresent =
			Windows.waitForElementPresent(
				openedTab,
				1,
				FailureHandling.OPTIONAL
			)

		if (!tabStillPresent) {
			tabClosed = true

			KeywordUtil.logInfo(
				'[PASS] Target tab is already closed.\n' +
				'Tab: ' + openedTabName
			)

			break
		}

		KeywordUtil.logInfo(
			'[OBJECT] Closing all tabs.\n' +
			'Attempt: ' + attempt + '/' + maxCloseAttempts
		)

		WindowsTestObject closeAllTabsButton =
			object('closeAllTabsTopBar')

		if (!Windows.waitForElementPresent(
			closeAllTabsButton,
			shortTimeout,
			FailureHandling.OPTIONAL
		)) {
			takeEvidence(
				'GUI_CloseAllTabsButtonNotFound.png'
			)

			KeywordUtil.markFailedAndStop(
				'Close All Tabs button was not found.\n' +
				'Attempt: ' + attempt
			)

			return
		}

		Windows.click(
			closeAllTabsButton,
			FailureHandling.STOP_ON_FAILURE
		)

		Windows.delay(2)

		// Wait for REC or PRD confirmation modal.
		boolean closeModalFound =
			imageLoader.waitForImage(
				GENERAL_IMAGE_GROUP,
				'iconeModal',
				shortTimeout
			)

		String detectedModal = 'iconeModal'

		if (!closeModalFound) {
			closeModalFound =
				imageLoader.waitForImage(
					GENERAL_IMAGE_GROUP,
					'iconeModalPRD',
					shortTimeout
				)

			detectedModal = 'iconeModalPRD'
		}

		if (closeModalFound) {
			KeywordUtil.logInfo(
				'[IMAGE] Close All Tabs confirmation modal found.\n' +
				'Image: General.' + detectedModal
			)
		} else {
			KeywordUtil.logInfo(
				'[INFO] Close confirmation modal image was not matched.\n' +
				'ENTER will still be pressed because the modal may already have focus.'
			)
		}

		takeEvidence(
			'GUI_CloseAllTabsConfirmation_' +
			attempt +
			'.png'
		)

		pressKeyboardKey(
			KeyEvent.VK_ENTER
		)

		Windows.delay(3)

		tabStillPresent =
			Windows.waitForElementPresent(
				openedTab,
				2,
				FailureHandling.OPTIONAL
			)

		if (!tabStillPresent) {
			tabClosed = true

			KeywordUtil.logInfo(
				'[PASS] Target tab closed successfully.\n' +
				'Tab: ' + openedTabName + '\n' +
				'Attempt: ' + attempt
			)

			break
		}

		KeywordUtil.logInfo(
			'[INFO] Target tab is still open after confirmation.\n' +
				'The close flow will be retried.'
		)

		Windows.delay(2)
	}

	if (!tabClosed) {
		takeEvidence(
			'GUI_TargetTabStillOpen.png'
		)

		KeywordUtil.markFailedAndStop(
			'Target tab was not closed after retry attempts.\n' +
				'Tab: ' + openedTabName + '\n' +
				'Attempts: ' + maxCloseAttempts
		)

		return
	}

	// ======================================================
	// OPEN FAVORITES TAB
	// ======================================================

	WindowsTestObject favoritesTab =
		object('favoritesTab')

	if (!Windows.waitForElementPresent(
		favoritesTab,
		shortTimeout,
		FailureHandling.OPTIONAL
	)) {
		takeEvidence(
			'GUI_FavoritesTabNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorites tab was not found.'
		)

		return
	}

	KeywordUtil.logInfo(
		'[OBJECT] Clicking Favorites tab.'
	)

	Windows.click(
		favoritesTab,
		FailureHandling.STOP_ON_FAILURE
	)

	Windows.delay(2)

	// ======================================================
	// FIND CREATED FAVORITE
	// ======================================================

	WindowsTestObject favoriteItem =
		WindowsObjectLoader.getTreeItemByName(
			favoriteTitle
		)

	KeywordUtil.logInfo(
		'[OBJECT] Waiting for created favorite.\n' +
		'Favorite: ' + favoriteTitle + '\n' +
		'Timeout: ' + timeout + ' seconds'
	)

	boolean favoriteFoundByObject =
		Windows.waitForElementPresent(
			favoriteItem,
			timeout,
			FailureHandling.OPTIONAL
		)

	if (favoriteFoundByObject) {

		KeywordUtil.logInfo(
			'[PASS] Favorite found by tree-item XPath.\n' +
				'Favorite: ' + favoriteTitle
		)

		Windows.click(
			favoriteItem,
			FailureHandling.STOP_ON_FAILURE
		)

	} else {

		KeywordUtil.logInfo(
			'[INFO] Favorite was not found by XPath.\n' +
				'Trying image fallback: guiBehavior.' +
				favoriteImageKey
		)

		boolean favoriteFoundByImage =
			imageLoader.waitForImage(
				GUI_IMAGE_GROUP,
				favoriteImageKey,
				shortTimeout
			)

		if (!favoriteFoundByImage) {
			takeEvidence(
				'GUI_CreatedFavoriteNotFound.png'
			)

			KeywordUtil.markFailedAndStop(
				'Created favorite was not found by XPath or image.\n' +
					'Favorite: ' + favoriteTitle + '\n' +
					'Image fallback: guiBehavior.' +
					favoriteImageKey
			)

			return
		}

		WindowsImageKeywords.clickImage(
			image(
				GUI_IMAGE_GROUP,
				favoriteImageKey
			)
		)
	}

	// ======================================================
	// WAIT FOR FAVORITE MODULE
	// ======================================================

	KeywordUtil.logInfo(
		'[OBJECT] Favorite selected.\n' +
		'Waiting for module tab to reopen.\n' +
		'Expected tab: ' + openedTabName
	)

	if (!Windows.waitForElementPresent(
		openedTab,
		timeout,
		FailureHandling.OPTIONAL
	)) {
		takeEvidence(
			'GUI_FavoriteModuleTabNotOpened.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorite was selected, but the module tab was not opened.\n' +
				'Favorite: ' + favoriteTitle + '\n' +
				'Expected tab: ' + openedTabName
		)

		return
	}

	takeEvidence(
		'GUI_CreatedFavoriteOpened.png'
	)

	KeywordUtil.markPassed(
		'Created favorite opened successfully.\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'Opened tab: ' + openedTabName
	)
}
