			textFilterKey,
			filterValue,
			timeout
		)

		clickImage(
			GUI_IMAGE_GROUP,
			'checkbox',
			timeout
		)

		Windows.delay(2)

		clickImage(
			GUI_IMAGE_GROUP,
			closeFilterKey,
			timeout
		)

		Windows.delay(3)

		boolean filterApplied =
			imageLoader.waitForImage(
