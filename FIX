    def suiteName = suiteConfig.name

    powershell """
        \$ErrorActionPreference = 'SilentlyContinue'

        \$reportDir = '${reportDir}'
        \$suiteName = '${suiteName}'
        \$threw = ${threwVal}
        \$fallback = '${errVal}'
        \$globalFile = '${env.WORKSPACE}\\\\Reports\\\\_jenkins_summary\\\\build_description.txt'

        if (!(Test-Path (Split-Path \$globalFile))) {
            New-Item -ItemType Directory -Path (Split-Path \$globalFile) -Force | Out-Null
        }

        Write-Host "Analyzing CSV reports for: \$suiteName (HEADLESS MODE)"
        
        \$suiteIcon = "?"
        \$statusText = "UNKNOWN"
        
        if (\$threw -eq 1) {
            \$suiteIcon = "SYSTEM ERROR"
            \$statusText = "SYSTEM ERROR"
        } else {
            \$csvFiles = Get-ChildItem -Path "${env.WORKSPACE}" -Filter "ExecutionResults_*.csv" -Recurse -ErrorAction SilentlyContinue
            \$logFiles = Get-ChildItem -Path \$reportDir -Filter "*.log" -Recurse -ErrorAction SilentlyContinue
            
            Write-Host "Found files:"
            Write-Host "  - CSV files: \$(\$csvFiles.Count)"
            Write-Host "  - LOG files: \$(\$logFiles.Count)"
            
            if (\$csvFiles) {
                \$testsPassed = 0
                \$testsFailed = 0
                \$testsTotal = 0
                \$hasResults = \$false
                
                \$latestCsv = \$csvFiles | Sort-Object LastWriteTime -Descending | Select-Object -First 1
                Write-Host "Reading CSV: \$(\$latestCsv.Name)"
                
                try {
                    \$csvContent = Get-Content \$latestCsv.FullName -Encoding UTF8
                    \$suiteLines = \$csvContent | Where-Object { 
                        \$_ -like "*\$suiteName*" -and \$_ -notlike "Timestamp,*" 
                    }
                    
                    Write-Host "Found \$(\$suiteLines.Count) test records for suite '\$suiteName'"
                    
                    if (\$suiteLines) {
                        \$hasResults = \$true
                        \$testsTotal = \$suiteLines.Count
                        
                        foreach (\$line in \$suiteLines) {
                            \$columns = \$line -split ','
                            if (\$columns.Count -ge 4) {
                                \$status = \$columns[3].Trim()
                                if (\$status -eq 'PASSED') {
                                    \$testsPassed++
                                } else {
                                    \$testsFailed++
                                }
                            }
                        }
                        
                        Write-Host "Results: Total=\$testsTotal, Passed=\$testsPassed, Failed=\$testsFailed"
                    }
                } catch {
                    Write-Host "Error reading CSV: \$(\$_.Exception.Message)"
                }
                
                if (\$hasResults) {
                    if (\$testsFailed -eq 0 -and \$testsTotal -gt 0) {
                        \$suiteIcon = "PASSED"
                        \$statusText = "PASSED (\$testsPassed/\$testsTotal) - HEADLESS"
                    } elseif (\$testsFailed -gt 0) {
                        \$suiteIcon = "FAILED"
                        \$statusText = "FAILED (\$testsPassed/\$testsTotal) - HEADLESS"
                    } else {
                        \$suiteIcon = "NO TESTS"
                        \$statusText = "NO TESTS - HEADLESS"
                    }
                } else {
                    \$suiteIcon = "EXECUTED"
                    \$statusText = "EXECUTED - HEADLESS"
                }
            } else {
                \$suiteIcon = "NO CSV"
                \$statusText = "NO CSV REPORTS - HEADLESS"
            }
        }
        
        \$summaryLines = New-Object System.Collections.Generic.List[string]
        \$summaryLines.Add("\$suiteIcon \$suiteName - \$statusText")
        
        if (\$threw -eq 1 -and ![string]::IsNullOrWhiteSpace(\$fallback)) {
            \$summaryLines.Add("   ERROR: \$fallback")
        }
        
        \$summaryLines.Add("")

        Add-Content -Path \$globalFile -Value (\$summaryLines -join "`n") -Encoding UTF8
        Write-Host "\$suiteIcon \$suiteName - \$statusText"
    """
}

def convertCsvToJunitAndPublish() {
    powershell '''
        $ErrorActionPreference = 'SilentlyContinue'
        
        Write-Host "Converting CSV reports to JUnit XML format (HEADLESS MODE)..."
        
        $csvFiles = Get-ChildItem -Path "${env:WORKSPACE}" -Filter "ExecutionResults_*.csv" -Recurse
        
        if ($csvFiles) {
            Write-Host "Found $($csvFiles.Count) CSV files"
            
            $junitDir = "${env:WORKSPACE}\\Reports\\junit"
            if (!(Test-Path $junitDir)) {
                New-Item -ItemType Directory -Path $junitDir -Force | Out-Null
            }
            
            foreach ($csvFile in $csvFiles) {
                try {
                    Write-Host "Processing: $($csvFile.Name)"
                    $csvContent = Get-Content $csvFile.FullName -Encoding UTF8
                    $testLines = $csvContent | Select-Object -Skip 1
                    
                    if ($testLines) {
                        $suiteGroups = $testLines | ForEach-Object {
                            $columns = $_ -split ','
                            if ($columns.Count -ge 4) {
                                [PSCustomObject]@{
                                    TestSuite = $columns[1].Trim()
                                    TestCase = $columns[2].Trim()
                                    Status = $columns[3].Trim()
                                    FailureReason = if ($columns.Count -gt 4) { $columns[4].Trim() } else { "" }
                                    Timestamp = $columns[0].Trim()
                                }
                            }
                        } | Group-Object TestSuite
                        
                        foreach ($suiteGroup in $suiteGroups) {
                            $suiteName = $suiteGroup.Name
                            $tests = $suiteGroup.Group
                            
                            $totalTests = $tests.Count
                            $failedTests = ($tests | Where-Object { $_.Status -ne 'PASSED' }).Count
                            $passedTests = $totalTests - $failedTests
                            
                            $timestamp = Get-Date -Format 'yyyy-MM-ddTHH:mm:ss'
                            $junitXml = @"
<?xml version="1.0" encoding="UTF-8"?>
<testsuite name="$suiteName (HEADLESS)" tests="$totalTests" failures="$failedTests" errors="0" time="0" timestamp="$timestamp">
"@
                            
                            foreach ($test in $tests) {
                                $testCaseName = $test.TestCase -replace '.*/', ''
                                $testCaseNameEscaped = $testCaseName -replace '&', '&amp;' -replace '<', '&lt;' -replace '>', '&gt;' -replace '"', '&quot;' -replace "'", '&apos;'
                                $suiteNameEscaped = $suiteName -replace '&', '&amp;' -replace '<', '&lt;' -replace '>', '&gt;' -replace '"', '&quot;' -replace "'", '&apos;'
                                
                                $junitXml += "`n  <testcase name=`"$testCaseNameEscaped (HEADLESS)`" classname=`"$suiteNameEscaped`" time=`"0`">"
                                
                                if ($test.Status -ne 'PASSED') {
                                    $reason = $test.FailureReason -replace '&', '&amp;' -replace '<', '&lt;' -replace '>', '&gt;' -replace '"', '&quot;' -replace "'", '&apos;'
                                    $statusEscaped = $test.Status -replace '&', '&amp;' -replace '<', '&lt;' -replace '>', '&gt;' -replace '"', '&quot;' -replace "'", '&apos;'
                                    $junitXml += "`n    <failure message=`"$statusEscaped (HEADLESS)`" type=`"AssertionError`">$reason</failure>"
                                }
                                
                                $junitXml += "`n  </testcase>"
                            }
                            
                            $junitXml += "`n</testsuite>"
                            
                            $junitFileName = "TEST-$suiteName-HEADLESS.xml" -replace '[\\/:*?"<>|]', '_'
                            $junitFilePath = Join-Path $junitDir $junitFileName
                            Set-Content -Path $junitFilePath -Value $junitXml -Encoding UTF8
                            
                            Write-Host "Generated JUnit XML: $junitFileName ($totalTests tests, $failedTests failures) - HEADLESS"
                        }
                    }
                } catch {
                    Write-Host "Error processing $($csvFile.Name): $($_.Exception.Message)"
                }
            }
        } else {
            Write-Host "No CSV files found for conversion"
        }
    '''
    
    catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
        junit allowEmptyResults: true, testResults: "Reports/junit/*.xml"
        echo "JUnit XML files published successfully (HEADLESS MODE)"
    }
}
