    if /I "!K!"=="RUNNER_WINDOW_TITLE"      set "RUNNER_WINDOW_TITLE=!V!"
    if /I "!K!"=="LIVE_LOG_WINDOW_TITLE"    set "LIVE_LOG_WINDOW_TITLE=!V!"
