	String buildGaiaReport() {
		String xmlPath = getXmlFilePath()
		if (isBlank(xmlPath)) {
			KeywordUtil.logInfo('Gaia report not created because XML was not found.')
			return ''
		}

		String reportPath = getResolvedReportPath()
		if (isBlank(reportPath)) {
			KeywordUtil.logInfo('Gaia report not created because report folder was not found.')
			return ''
		}

		Map suiteData = parseSuiteData(xmlPath)
		String html = buildGaiaReportHtml(suiteData)

		File file = new File(reportPath + File.separator + GAIA_REPORT_FILE_NAME)
		file.write(html, 'UTF-8')

		KeywordUtil.logInfo("Gaia report created: ${file.absolutePath}")
		return file.absolutePath
	}

