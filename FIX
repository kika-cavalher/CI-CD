import static com.kms.katalon.core.testcase.TestCaseFactory.findTestCase

import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI


// ======================================================
// MODULE CONFIG
// ======================================================

String targetEnvironment = 'REC'
String expectedLanguage = 'French'

String loginTestCase =
	'Component/Authentication/Login ' + targetEnvironment

String closeApplicationTestCase =
	'Component/Authentication/Close Application'


// ======================================================
// AUTHENTICATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Authenticate and open application\n' +
	'Environment: ' + targetEnvironment
)

WebUI.callTestCase(
	findTestCase(loginTestCase),
	[:],
	FailureHandling.STOP_ON_FAILURE
)

// ======================================================
// LANGUAGE VALIDATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Change application language\n' +
	'Expected language: ' + expectedLanguage + '\n' +
	'Validate selected and deselected language states'
)

CustomKeywords.'component.menuConfiguration.openMenuConfiguration'(5)

CustomKeywords.'pageObject.guiValidation.changeLanguageToFrench'()

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	targetEnvironment + '_GUI_LanguageSelectedFrench.png'
)


// ======================================================
// CLOSE APPLICATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Close application\n' +
	'Environment: ' + targetEnvironment
)

WebUI.callTestCase(
	findTestCase(closeApplicationTestCase),
	[:],
	FailureHandling.STOP_ON_FAILURE
)

KeywordUtil.markPassed(
	targetEnvironment +
	' language validation completed successfully for ' +
	expectedLanguage + '.'
)




Keyword:
	// ======================================================
	// LANGUAGE
	// ======================================================

	@Keyword
	void changeLanguageToFrench(Integer timeoutSeconds) {

		Integer timeout = safeTimeout(timeoutSeconds, 3)
		List<String> errors = []

		logStep(
				'LANGUAGE',
				'Change application language to French'
				)

		clickImage(GENERAL_IMAGE_GROUP, 'settings', timeout)
		clickImage(GUI_IMAGE_GROUP, 'frenchOption', timeout)

		boolean frenchSelected =
				imageLoader.waitForImage(
				GUI_IMAGE_GROUP,
				'frenchSelected',
				timeout
				)

		reportBooleanResult(
				frenchSelected,
				'French language is selected.',
				'French language was not selected.',
				errors
				)

		takeEvidence('GUI_LanguageSelectedFrench.png')

		if (errors.isEmpty()) {
			GlobalVariable.language = 'fr'
		}

		clickImage(GENERAL_IMAGE_GROUP, 'home', timeout)

		finishValidation(
				'Language validation',
				errors
				)
	}
