	// ======================================================
	// DISCREPANCY VALIDATION
	// ======================================================

	@Keyword
	String validateNoDiscrepanciesBetweenFiles(
			String filesToValidate,
			String defaultValidationType,
			String sheetIndexText,
			String keyHeadersText,
			String compareHeadersText) {

		String keyHeadersClean =
				safeText(keyHeadersText)

		String compareHeadersClean =
				safeText(compareHeadersText)

		if (
		keyHeadersClean.isEmpty() ||
				compareHeadersClean.isEmpty()
				) {

			return '[SKIPPED] Discrepancy validation was not executed because key headers or compare headers were not configured.'
		}

		StringBuilder errors =
				new StringBuilder()

		List<File> files =
				parseFiles(filesToValidate)

		int sheetIndex =
				parseIntOrZero(sheetIndexText)

		if (files.size() < 2) {

			return '[SKIPPED] Discrepancy validation needs at least 2 files.'
		}

		List<String> keyHeaders =
				splitText(keyHeadersText)

		List<String> compareHeaders =
				splitText(compareHeadersText)

		Map<String, String> expectedValuesByKey =
				[:]

		Map<String, String> sourceByKey =
				[:]

		for (File file : files) {

			String validationType =
					resolveValidationTypeForFile(
					file,
					defaultValidationType
					)

			String fileErrors =
					collectDiscrepanciesFromFile(
					file,
					validationType,
					sheetIndex,
					keyHeaders,
					compareHeaders,
					expectedValuesByKey,
					sourceByKey
					)

			if (!fileErrors.trim().isEmpty()) {
				errors.append(fileErrors)
			}
		}

		return errors.toString()
	}


