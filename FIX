3. REC - Generer Corrections - Validate Filter And Export
import static com.kms.katalon.core.testcase.TestCaseFactory.findTestCase
import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import java.io.File

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows


// ======================================================
// EXPORT CONFIG
// ======================================================

String targetEnvironment = 'REC'
String exportLabel = 'GenererCorrections'
String statusFilterValue = '1'

String menuName = 'ecarts de cours dérivés organisés'
String menuResultName = 'ecarts de cours dérivés organisés'
String openedTabName = menuResultName

String scenarioName =
	targetEnvironment +
	' Generer Corrections Validate Filter And Export'

String loginTestCase =
	'Component/Authentication/Login ' + targetEnvironment

String switchUserTestCase =
	'Component/Authentication/Switch User REC'

String closeApplicationTestCase =
	'Component/Authentication/Close Application'

String statusFilterAppliedImage =
	new File(
		RunConfiguration.getProjectDir(),
		'Images/Derives Organises/isStatusFilterApplied.PNG'
	).getAbsolutePath()


// ======================================================
// TIMEOUT CONFIG
// ======================================================

Integer menuTimeout = 60
Integer openedTabTimeout = 60
Integer statusFilterLoadDelay = 4
Integer exportLoadDelay = 3


// ======================================================
// AUTHENTICATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Authenticate and open application\n' +
	'Environment: ' + targetEnvironment
)

WebUI.callTestCase(
	findTestCase(loginTestCase),
	[:],
	FailureHandling.STOP_ON_FAILURE
)


// ======================================================
// SWITCH USER
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Switch application user\n' +
	'Test case: ' + switchUserTestCase + '\n' +
	'Environment: ' + targetEnvironment
)

WebUI.callTestCase(
	findTestCase(switchUserTestCase),
	[:],
	FailureHandling.STOP_ON_FAILURE
)


// ======================================================
// MENU NAVIGATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Open Ecarts De Cours menu\n' +
	'Search: ' + menuName + '\n' +
	'Result: ' + menuResultName
)

CustomKeywords.'component.MenuNavigator.searchAndOpenMenuByText'(
	menuName,
	menuResultName,
	menuTimeout
)


// ======================================================
// OPENED SCREEN VALIDATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Validate opened tab\n' +
	'Expected tab: ' + openedTabName
)

if (!Windows.waitForElementPresent(
	CustomKeywords.'commands.WindowsObjectLoader.getTabByName'(
		openedTabName
	),
	openedTabTimeout,
	FailureHandling.OPTIONAL
)) {
	CustomKeywords.'commands.ImageLoader.takeEvidence'(
		targetEnvironment +
		'_GenererCorrections_TabNotOpened.png'
	)

	KeywordUtil.markFailedAndStop(
		'Ecarts De Cours tab was not opened for the Generer Corrections flow.\n' +
		'Expected tab: ' + openedTabName
	)
}

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	targetEnvironment +
	'_GenererCorrections_ScreenOpened.png'
)


// ======================================================
// STATUS FILTER
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Apply status filter\n' +
	'Filter: Status\n' +
	'Value: ' + statusFilterValue
)

Windows.setText(
	findWindowsObject(
		'Object Repository/Derives Organizes/statusFilterTxt'
	),
	statusFilterValue
)

Windows.delay(statusFilterLoadDelay)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	targetEnvironment +
	'_GenererCorrections_StatusFilter.png'
)


// ======================================================
// STATUS FILTER VALIDATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Validate applied status filter\n' +
	'Expected value: ' + statusFilterValue + '\n' +
	'Validation image: isStatusFilterApplied.PNG'
)

def statusFilterMatch =
	WindowsImageKeywords.findImage(
		statusFilterAppliedImage
	)

if (!statusFilterMatch) {
	CustomKeywords.'commands.ImageLoader.takeEvidence'(
		targetEnvironment +
		'_GenererCorrections_StatusFilterNotApplied.png'
	)

	KeywordUtil.markFailedAndStop(
		'Status filter was not applied correctly.\n' +
		'Expected value: ' + statusFilterValue + '\n' +
		'Validation image was not found: ' +
		statusFilterAppliedImage
	)
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Status filter validation passed\n' +
	'Applied value: ' + statusFilterValue
)


// ======================================================
// EXPORT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Wait for filtered content before export\n' +
	'Delay: ' + exportLoadDelay + ' seconds'
)

Windows.delay(exportLoadDelay)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Export filtered Generer Corrections table\n' +
	'Flow: Exports tab > Export button > Save > Non\n' +
	'Environment: ' + targetEnvironment + '\n' +
	'Export label: ' + exportLabel
)

CustomKeywords.'commands.ExportFile.exportFromTwoExportImagesToNo'(
	exportLabel,
	targetEnvironment
)


// ======================================================
// CLOSE APPLICATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Close application\n' +
	'Environment: ' + targetEnvironment
)

WebUI.callTestCase(
	findTestCase(closeApplicationTestCase),
	[:],
	FailureHandling.STOP_ON_FAILURE
)


// ======================================================
// FILE VALIDATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Validate downloaded export\n' +
	'Environment: ' + targetEnvironment + '\n' +
	'Export label: ' + exportLabel + '\n' +
	'Validations:\n' +
	'- File exists\n' +
	'- File is not empty\n' +
	'- Data row quantity is greater than zero'
)

Map exportValidation =
	CustomKeywords.'commands.ExportFileValidationKeywords.validateExportedFileExistsAndHasRows'(
		targetEnvironment,
		exportLabel
	)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Downloaded export validation passed\n' +
	'File: ' + exportValidation.fileName + '\n' +
	'Data rows: ' + exportValidation.dataRows + '\n' +
	'File size: ' + exportValidation.fileSize + ' bytes\n' +
	'Folder: ' + exportValidation.folderPath
)

KeywordUtil.markPassed(
	scenarioName + ' completed successfully.'
)
