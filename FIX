				}
			} catch (Throwable ignored) {
			}
		}
		return null
	}

	private WindowsTestObject winObj(String id, String xpath) {
		WindowsTestObject obj = new WindowsTestObject(id)
		obj.setLocatorStrategy(LocatorStrategy.XPATH)
		obj.setLocator(xpath)
		return obj
	}

	private boolean waitPresent(WindowsTestObject obj, int timeoutSeconds) {
