@echo off
setlocal EnableExtensions

set "BASE_DIR=D:\Projects\eMatchStarters"
set "COMMAND_FILE=%BASE_DIR%\visible_katalon_command.bat"
set "STATUS_FILE=%BASE_DIR%\visible_katalon_status.txt"
set "ENV_FILE=%BASE_DIR%\current-env.txt"
set "LOG_FILE=%BASE_DIR%\run-ematch-command.log"

if not exist "%BASE_DIR%" mkdir "%BASE_DIR%"

echo ==================================================>> "%LOG_FILE%"
echo [%DATE% %TIME%] RunEMatchDesktop started >> "%LOG_FILE%"

> "%STATUS_FILE%" echo STARTING [%DATE% %TIME%]

if not exist "%COMMAND_FILE%" (
    echo [ERROR] Command file not found: %COMMAND_FILE% >> "%LOG_FILE%"
    > "%STATUS_FILE%" echo ERROR command file not found
    exit /b 1
)

if not exist "%ENV_FILE%" (
    echo REC> "%ENV_FILE%"
)

call "%COMMAND_FILE%" >> "%LOG_FILE%" 2>&1
set "RC=%ERRORLEVEL%"

if "%RC%"=="0" (
    echo [%DATE% %TIME%] SUCCESS exit code 0 >> "%LOG_FILE%"
    > "%STATUS_FILE%" echo SUCCESS [%DATE% %TIME%]
) else (
    echo [%DATE% %TIME%] ERROR exit code %RC% >> "%LOG_FILE%"
    > "%STATUS_FILE%" echo ERROR %RC% [%DATE% %TIME%]
)

exit /b %RC%





