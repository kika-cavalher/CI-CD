	private File resolveCurrentFeatureExportFolder(String configuredRoot) {
		File baseRoot = resolveWritableBaseExportRoot(configuredRoot)
		File executionRoot = resolveExecutionRootFolder()
		String executionName = executionRoot == null ? '' : executionRoot.getName()

		if (safeText(executionName).isEmpty()) {
			executionName = 'Unknown_Execution'
		}

		File executionFolder = new File(
				baseRoot,
				shortenFilePart(sanitizeFileName(executionName), 48)
				)

		String collectionName = shortenFilePart(
				sanitizeFileName(resolveCurrentCollectionName()),
				20
				)

		String featureName = shortenFilePart(
				sanitizeFileName(resolveCurrentFeatureName()),
				28
				)

		return new File(
				new File(executionFolder, collectionName),
				featureName
				)
	}

	private File resolveWritableBaseExportRoot(String configuredRoot) {
		File preferredRoot = new File(safeText(configuredRoot))

		try {
			if (!preferredRoot.exists()) {
				preferredRoot.mkdirs()
			}

			if (preferredRoot.exists() &&
					preferredRoot.isDirectory() &&
					preferredRoot.canWrite()) {

				return preferredRoot
			}
		} catch (Exception ignored) {
		}

		File temporaryRoot = new File(
				System.getProperty('java.io.tmpdir'),
				'KatalonExports'
				)

		if (!temporaryRoot.exists()) {
			temporaryRoot.mkdirs()
		}

		return temporaryRoot
	}

	private File resolveExecutionRootFolder() {
		String reportFolderPath = RunConfiguration.getReportFolder()

		if (safeText(reportFolderPath).isEmpty()) {
			return new File(
					RunConfiguration.getProjectDir(),
					'Reports\\Unknown_Execution'
					)
		}

		File current = new File(reportFolderPath)

		while (current != null) {
			File parent = current.getParentFile()

			if (parent != null && parent.getName().equalsIgnoreCase('Reports')) {
				return current
			}

			current = parent
		}

		return new File(reportFolderPath)
	}

	private String resolveCurrentCollectionName() {
		List<String> validParts = getValidReportFolderParts()
		return validParts.isEmpty() ? 'Collection' : validParts[0]
	}

	private String resolveCurrentFeatureName() {
		List<String> validParts = getValidReportFolderParts()
		return validParts.isEmpty() ? 'Export' : validParts.last()
	}

	private List<String> getValidReportFolderParts() {
		List<String> validParts = []
		String reportFolderPath = RunConfiguration.getReportFolder()

		if (safeText(reportFolderPath).isEmpty()) {
			return validParts
		}

		File executionRootFolder = resolveExecutionRootFolder()
		String fullPath = new File(reportFolderPath).getAbsolutePath()
		String rootPath = executionRootFolder.getAbsolutePath()

		if (!fullPath.toLowerCase().startsWith(rootPath.toLowerCase())) {
			return validParts
		}

		String relativePath = fullPath
				.substring(rootPath.length())
				.replaceAll('^\\\\+', '')

		if (relativePath.trim().isEmpty()) {
			return validParts
		}

		List<String> parts = relativePath
				.replace('/', '\\')
				.split('\\\\') as List<String>

		for (String part : parts) {
			if (isValidFeatureNamePart(part)) {
				validParts.add(part.trim())
			}
		}

		return validParts
	}

	private Boolean isValidFeatureNamePart(String part) {
		if (safeText(part).isEmpty()) {
			return false
		}

		String value = part.trim()
		String lower = value.toLowerCase()

		if (value ==~ /\d{8}_\d{6}/ ||
				value ==~ /\d{14}/ ||
				value ==~ /^\d+\.\s*.*/) {

			return false
		}

		List<String> ignoredExactValues = [
			'reports',
			'evidences',
			'exports',
			'test cases',
			'test suites',
			'connection',
			'authentication',
			'login rec',
			'login prd',
			'katalon',
			'temp'
		]

		if (ignoredExactValues.contains(lower)) {
			return false
		}

		List<String> ignoredContainsValues = [
			'export',
			'validation',
			'validations',
			'validate',
			'compare',
			'close application',
			'open module',
			'login'
		]

		for (String ignored : ignoredContainsValues) {
			if (lower.contains(ignored)) {
				return false
			}
		}

		return true
	}

	private String sanitizeFileName(String text) {
		if (safeText(text).isEmpty()) {
			return 'Export'
		}

		String normalized = Normalizer.normalize(
				text,
				Normalizer.Form.NFD
				).replaceAll('\\p{InCombiningDiacriticalMarks}+', '')

		String cleaned = normalized
				.replaceAll('[\\\\/:*?"<>|]', '_')
				.replaceAll('\\s+', '_')
				.replaceAll('_+', '_')
				.replaceAll('^_|_$', '')
				.trim()

		return cleaned.isEmpty() ? 'Export' : cleaned
	}

	private String shortenFilePart(
			String value,
			Integer maximumLength) {

		if (safeText(value).isEmpty()) {
			return ''
		}

		int safeMaximum = maximumLength == null || maximumLength <= 0
				? 20
				: maximumLength

		String cleanValue = sanitizeFileName(value)

		return cleanValue.length() <= safeMaximum
				? cleanValue
				: cleanValue.substring(0, safeMaximum)
	}

	private Map selectExportFile(
			String resolvedFilesText,
			String targetEnvironment,
			String exportLabel) {

		List<File> allFiles = parseFiles(resolvedFilesText)

		allFiles = allFiles.findAll { File file ->
			file != null &&
					file.exists() &&
					file.isFile() &&
					file.length() > 0 &&
					file.getName().toLowerCase(Locale.ENGLISH).endsWith('.xlsx') &&
					!file.getName().startsWith('~$')
		}

		if (allFiles.isEmpty()) {
			return [
				file        : null,
				allFiles    : allFiles,
				matchedFiles: [],
				error       : 'No valid Excel files were found in the current suite feature folder.'
			]
		}

		String normalizedEnvironment = normalizeEnvironment(targetEnvironment)
		String normalizedLabel = safeText(exportLabel).toLowerCase(Locale.ENGLISH)
		List<File> matchedFiles = []

		for (File file : allFiles) {
			String fileName = file.getName().toLowerCase(Locale.ENGLISH)

			boolean environmentMatches = normalizedEnvironment.isEmpty() ||
					fileName.startsWith(
					normalizedEnvironment.toLowerCase(Locale.ENGLISH) + '_'
					)

			boolean labelMatches = normalizedLabel.isEmpty() ||
					fileName.contains(normalizedLabel)

			if (environmentMatches && labelMatches) {
				matchedFiles.add(file)
			}
		}

		if (matchedFiles.isEmpty()) {
			String expectedDescription =
					(normalizedEnvironment.isEmpty() ? '' : normalizedEnvironment + '_') +
					'*' + exportLabel + '*.xlsx'

			return [
				file        : null,
				allFiles    : allFiles,
				matchedFiles: matchedFiles,
				error       : 'No Excel file matched the expected environment and export label.\n' +
				'Expected format: ' + expectedDescription
			]
		}

		List<File> sortedMatches = matchedFiles.sort { File a, File b ->
			b.lastModified() <=> a.lastModified()
		}

		return [
			file        : sortedMatches[0],
			allFiles    : allFiles,
			matchedFiles: matchedFiles,
			error       : ''
		]
	}

	private String normalizeEnvironment(String value) {
		if (safeText(value).isEmpty()) {
			return ''
		}

		String environment = value.trim().toUpperCase(Locale.ENGLISH)

		if (environment == 'REC' || environment == 'RECETTE') {
			return 'REC'
		}

		if (environment == 'PRD' ||
				environment == 'PROD' ||
				environment == 'PRODUCTION') {

			return 'PRD'
		}

		return environment
	}


