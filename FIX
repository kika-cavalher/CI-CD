File resolveExportedFile(Object fileValue) {
	if (fileValue == null) {
		return null
	}

	String receivedValue = String.valueOf(fileValue).trim()

	if (receivedValue.isEmpty()) {
		return null
	}

	File receivedFile = new File(receivedValue)

	if (receivedFile.exists() && receivedFile.isFile()) {
		return receivedFile
	}

	String expectedFileName = receivedFile.getName()

	List<File> searchRoots = [
		new File(RunConfiguration.getReportFolder()),
		new File(RunConfiguration.getProjectDir(), 'Reports')
	]

	for (File root : searchRoots) {
		File foundFile = findFileRecursively(root, expectedFileName)

		if (foundFile != null) {
			return foundFile
		}
	}

	return null
}

File findFileRecursively(File directory, String expectedFileName) {
	if (directory == null ||
		!directory.exists() ||
		!directory.isDirectory()) {

		return null
	}

	File[] files = directory.listFiles()

	if (files == null) {
		return null
	}

	for (File file : files) {
		if (file.isFile() &&
			file.getName().equalsIgnoreCase(expectedFileName)) {

			return file
		}
	}

	for (File file : files) {
		if (file.isDirectory()) {
			File foundFile = findFileRecursively(
				file,
				expectedFileName
			)

			if (foundFile != null) {
				return foundFile
			}
		}
	}

	return null
}

String fileNameOnly(Object value) {
	if (value == null) {
		return 'NOT FOUND'
	}

	return new File(String.valueOf(value)).getName()
}



