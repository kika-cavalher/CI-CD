
WindowsTestObject openedFavoriteTab =
	WindowsObjectLoader.getTabByName(
		openedTabName
	)

Integer maxOpenAttempts = 5
Integer waitPerAttemptSeconds = 60

boolean favoriteOpened = false

for (
	Integer attempt = 1;
	attempt <= maxOpenAttempts;
	attempt++
) {
	KeywordUtil.logInfo(
		'[OPEN FAVORITE] Waiting for favorite tab.\n' +
		'Favorite: ' + favoriteTitle + '\n' +
		'Expected tab: ' + openedTabName + '\n' +
		'Attempt: ' + attempt + '/' + maxOpenAttempts + '\n' +
		'Wait time: ' + waitPerAttemptSeconds + ' seconds'
	)

	try {
		favoriteOpened =
			Windows.waitForElementPresent(
				openedFavoriteTab,
				waitPerAttemptSeconds,
				FailureHandling.OPTIONAL
			)
	} catch (Exception e) {
		KeywordUtil.logInfo(
			'[INFO] Favorite tab was not available during attempt ' +
			attempt + '.\n' +
			'Reason: ' + safeMessage(e)
		)

		favoriteOpened = false
	}

	if (favoriteOpened) {
		KeywordUtil.logInfo(
			'[PASS] Favorite tab opened successfully.\n' +
			'Attempt: ' + attempt + '/' + maxOpenAttempts + '\n' +
			'Tab: ' + openedTabName
		)

		break
	}

	if (attempt < maxOpenAttempts) {
		KeywordUtil.logInfo(
			'[INFO] Favorite tab has not opened yet.\n' +
			'Waiting for the next 60-second validation.'
		)
	}
}

if (!favoriteOpened) {
	takeEvidence(
		'GUI_FavoriteTabNotOpened.png'
	)

	KeywordUtil.markFailedAndStop(
		'Favorite tab was not opened after maximum waiting time.\n' +
		'Favorite: ' + favoriteTitle + '\n' +
		'Expected tab: ' + openedTabName + '\n' +
		'Attempts: ' + maxOpenAttempts + '\n' +
		'Wait per attempt: ' + waitPerAttemptSeconds + ' seconds\n' +
		'Total maximum wait: 300 seconds'
	)

	return
}

Windows.delay(3)

takeEvidence(
	'GUI_CreatedFavoriteOpened.png'
)

KeywordUtil.markPassed(
	'Created favorite was opened successfully.\n' +
	'Favorite: ' + favoriteTitle + '\n' +
	'Opened tab: ' + openedTabName
)
