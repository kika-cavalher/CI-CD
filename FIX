    private String buildScripts() {
        return '''
<script>
function showScenario(id) {
    var buttons = document.querySelectorAll('.scenario-list-item');
    var panels = document.querySelectorAll('.scenario-panel');

    buttons.forEach(function(btn) {
        if (btn.getAttribute('data-sid') === id) {
            btn.classList.add('selected');
        } else {
            btn.classList.remove('selected');
        }
    });

    panels.forEach(function(panel) {
        if (panel.id === 'panel-' + id) {
            panel.classList.add('active');
        } else {
            panel.classList.remove('active');
        }
    });
}

function filterScenarios() {
    var input = document.getElementById('scenarioSearch');
    var filter = input.value.toLowerCase();
    var items = document.querySelectorAll('.scenario-list-item');

    items.forEach(function(item) {
        var text = item.textContent.toLowerCase();
        if (text.indexOf(filter) > -1) {
            item.style.display = '';
        } else {
            item.style.display = 'none';
        }
    });
}
</script>
