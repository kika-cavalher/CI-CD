	@Keyword
	void applyFormulaireFilter(
			String filterValue
	) {

		Integer imageTimeout = 5

		String cleanFilterValue =
				safeText(
				filterValue
				)

		if (cleanFilterValue.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Formulaire filter value is empty.'
					)

			return
		}

		logStep(
				'APPLY FORMULAIRE FILTER',
				'Filter value: ' + cleanFilterValue + '\n' +
				'Flow:\n' +
				'- Click Formulaire title\n' +
				'- Press TAB twice\n' +
				'- Clear input field\n' +
				'- Enter filter value\n' +
				'- Click Actualiser\n' +
				'- Wait 10 seconds'
				)

		boolean formulaireTitleClicked =
				clickFirstVisibleImage(
				GUI_IMAGE_GROUP,
				[
					'formulaireTitle'
				],
				imageTimeout
				)

		if (!formulaireTitleClicked) {
			takeEvidence(
					'GUI_FormulaireTitleNotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					'Formulaire title image was not found.\n' +
					'Image key: formulaireTitle'
					)

			return
		}

		KeywordUtil.logInfo(
				'[FORMULAIRE FILTER] Formulaire title clicked.'
				)

		Windows.delay(1)

		pressKeyboardKey(
				KeyEvent.VK_TAB
				)

		Windows.delay(1)

		pressKeyboardKey(
				KeyEvent.VK_TAB
				)

		Windows.delay(1)

		KeywordUtil.logInfo(
				'[FORMULAIRE FILTER] TAB pressed twice. Input field should be focused.'
				)

		Robot robot =
				new Robot()

		robot.setAutoDelay(
				100
				)

		robot.keyPress(
				KeyEvent.VK_CONTROL
				)

		robot.keyPress(
				KeyEvent.VK_A
				)

		robot.keyRelease(
				KeyEvent.VK_A
				)

		robot.keyRelease(
				KeyEvent.VK_CONTROL
				)

		Windows.delay(1)

		robot.keyPress(
				KeyEvent.VK_BACK_SPACE
				)

		robot.keyRelease(
				KeyEvent.VK_BACK_SPACE
				)

		Windows.delay(1)

		StringSelection filterSelection =
				new StringSelection(
				cleanFilterValue
				)

		Toolkit
				.getDefaultToolkit()
				.getSystemClipboard()
				.setContents(
				filterSelection,
				null
				)

		robot.keyPress(
				KeyEvent.VK_CONTROL
				)

		robot.keyPress(
				KeyEvent.VK_V
				)

		robot.keyRelease(
				KeyEvent.VK_V
				)

		robot.keyRelease(
				KeyEvent.VK_CONTROL
				)

		Windows.delay(1)

		KeywordUtil.logInfo(
				'[FORMULAIRE FILTER] Input field cleared and value entered.\n' +
				'Value: ' + cleanFilterValue
				)

		boolean actualiserClicked =
				clickFirstVisibleImage(
				GUI_IMAGE_GROUP,
				['ActualiserBtn'],
				imageTimeout
				)

		if (!actualiserClicked) {
			takeEvidence(
					'GUI_ActualiserButtonNotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					'Actualiser button image was not found.\n' +
					'Image key: ActualiserBtn\n' +
					'Filter value: ' + cleanFilterValue
					)

			return
		}

		KeywordUtil.logInfo(
				'[FORMULAIRE FILTER] Actualiser button clicked.\n' +
				'Waiting 10 seconds for refresh.'
				)

		Windows.delay(10)

		takeEvidence(
				'GUI_FormulaireFilterApplied.png'
				)

		KeywordUtil.markPassed(
				'Formulaire filter applied successfully.\n' +
				'Filter value: ' + cleanFilterValue + '\n' +
				'Actualiser was clicked and the system waited 10 seconds.'
				)
	}


	// ======================================================
	// SECTION FILTER
	// ======================================================

	@Keyword
	void applySectionFilter(
			String filterValue,
			String language,
			Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds, 3)
		String normalizedLanguage =
				safeText(language).equalsIgnoreCase('en') ? 'en' : 'fr'

		String textFilterKey =
				normalizedLanguage == 'en' ? 'textFilterEN' : 'textFilterFR'

		String closeFilterKey =
				normalizedLanguage == 'en' ? 'closeFiltersButtonEN' : 'closeFiltersButtonFR'

		logStep(
				'SECTION FILTER',
				'Apply section filter value: ' + filterValue
				)

		clickImage(GUI_IMAGE_GROUP, 'sectionFilter', timeout)
		clickImage(GUI_IMAGE_GROUP, 'filterButton', timeout)

		typeOnImage(
				GUI_IMAGE_GROUP,
				textFilterKey,
				filterValue,
				timeout
				)

		clickImage(GUI_IMAGE_GROUP, 'checkbox', timeout)
		Windows.delay(2)

		clickImage(GUI_IMAGE_GROUP, closeFilterKey, timeout)
		Windows.delay(3)

		boolean filterApplied = imageLoader.waitForImage(
				GUI_IMAGE_GROUP,
				'isSectionFilterApplied',
				timeout
				)

		takeEvidence('GUI_FilterApplied.png')

		if (!filterApplied) {
			KeywordUtil.markFailedAndStop(
					'Section filter was not applied.\n' +
					'Value: ' + filterValue
					)

			return
		}

		KeywordUtil.markPassed(
				'Section filter applied successfully.\n' +
				'Value: ' + filterValue
				)
	}


