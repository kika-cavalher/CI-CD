        border-bottom: 1px solid #e2e5f0;
    }
    .panel-header {
        flex-direction: column;
    }
    .panel-badges {
        justify-content: flex-start;
    }
}
"""
    }

    private String buildJs() {
        return """
function filterCases() {
    var input = document.getElementById('caseFilter');
    var filter = (input.value || '').toLowerCase();
    var items = document.querySelectorAll('.case-link');

    items.forEach(function(item) {
        var name = (item.getAttribute('data-case-name') || '').toLowerCase();
        var status = (item.getAttribute('data-case-status') || '').toLowerCase();
        var visible = name.indexOf(filter) !== -1 || status.indexOf(filter) !== -1;
        item.style.display = visible ? 'block' : 'none';
    });
}
"""
    }

    private String badgeClass(String status) {
        if (!status) {
            return "badge-incomplete"
        }

        switch (status.trim().toLowerCase()) {
            case "passed":
                return "badge-passed"
            case "failed":
                return "badge-failed"
            case "skipped":
                return "badge-skipped"
            default:
                return "badge-incomplete"
        }
    }

    private String escapeHtml(Object value) {
        String text = value == null ? "" : value.toString()
        return text
            .replace("&", "&amp;")
            .replace("<", "&lt;")
            .replace(">", "&gt;")
            .replace("\"", "&quot;")
            .replace("'", "&#39;")
    }

    private String escapeHtmlAttribute(Object value) {
        return escapeHtml(value)
    }
}

