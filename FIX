C:\Gaia\run_katalon_visible_from_jenkins.bat
@echo off
setlocal
title GAIA_VISIBLE_RUNNER

set COMMAND_FILE=C:\Gaia\visible_katalon_command.bat
set STATUS_FILE=C:\Gaia\gaia_visible_status.txt
set LOG_FILE=C:\Gaia\gaia_visible_console.log

if exist "%STATUS_FILE%" del /f /q "%STATUS_FILE%"
if exist "%LOG_FILE%" del /f /q "%LOG_FILE%"

if not exist "%COMMAND_FILE%" (
    > "%STATUS_FILE%" echo EXIT_CODE=999
    exit /b 999
)

call "%COMMAND_FILE%" > "%LOG_FILE%" 2>&1
set EXIT_CODE=%ERRORLEVEL%

> "%STATUS_FILE%" echo EXIT_CODE=%EXIT_CODE%
exit /b %EXIT_CODE%






