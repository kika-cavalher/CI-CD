@Keyword
def selectEnvironment(String targetEnvironment) {
	String environment = normalizeEnvironment(targetEnvironment)

	if (!requiresEnvironmentSelection(environment)) {
		KeywordUtil.logInfo("Environment selection is not required for " + environment + ".")
		return
	}

	int env = getEnvironmentIndex(environment)

	try {
		KeywordUtil.logInfo("Selecting environment: " + environment)

		java.awt.Robot robot = new java.awt.Robot()
		robot.setAutoDelay(250)

		Windows.click(findWindowsObject('Login Page/optEnv'), FailureHandling.OPTIONAL)
		Windows.delay(1)

		robot.keyPress(java.awt.event.KeyEvent.VK_ALT)
		robot.keyPress(java.awt.event.KeyEvent.VK_DOWN)
		robot.keyRelease(java.awt.event.KeyEvent.VK_DOWN)
		robot.keyRelease(java.awt.event.KeyEvent.VK_ALT)

		Windows.delay(1)

		robot.keyPress(java.awt.event.KeyEvent.VK_HOME)
		robot.keyRelease(java.awt.event.KeyEvent.VK_HOME)

		Windows.delay(1)

		for (int i = 1; i < env; i++) {
			robot.keyPress(java.awt.event.KeyEvent.VK_DOWN)
			robot.keyRelease(java.awt.event.KeyEvent.VK_DOWN)
		}

		Windows.delay(1)

		robot.keyPress(java.awt.event.KeyEvent.VK_ENTER)
		robot.keyRelease(java.awt.event.KeyEvent.VK_ENTER)

		Windows.delay(3)

		KeywordUtil.logInfo("Environment selected: " + environment)

	} catch (Exception e) {
		KeywordUtil.markFailedAndStop(
			"Failed to select environment: " + environment + "\n" +
			"Reason: " + e.getMessage()
		)
	}
}


@Keyword
def clickConnectIfPresent(String targetEnvironment) {
	try {
		boolean isButtonPresent = Windows.verifyElementPresent(
				findWindowsObject('Login Page/btnConnecter'),
				10,
				FailureHandling.OPTIONAL
		)

		if (!isButtonPresent) {
			KeywordUtil.logInfo("Connect button was not present. Trying ENTER fallback.")
			pressEnter()
			Windows.delay(5)
			return
		}

		KeywordUtil.logInfo("Connect button found. Trying normal click.")

		try {
			Windows.click(findWindowsObject('Login Page/btnConnecter'), FailureHandling.OPTIONAL)
			Windows.delay(5)
		} catch (Exception e) {
			KeywordUtil.logInfo("Normal click failed. Trying ENTER fallback. Reason: " + e.getMessage())
			pressEnter()
			Windows.delay(5)
		}

	} catch (Exception e) {
		KeywordUtil.logInfo("Connect action had an issue. Trying ENTER fallback. Reason: " + e.getMessage())
		pressEnter()
		Windows.delay(5)
	}
}


@Keyword
def waitForMainScreen(String targetEnvironment) {
	KeywordUtil.logInfo("Waiting for main screen after login.")

	boolean isMainScreenVisible = Windows.waitForElementPresent(
			findWindowsObject('General/txtSearch'),
			60,
			FailureHandling.OPTIONAL
	)

	if (isMainScreenVisible) {
		KeywordUtil.logInfo("Main screen loaded successfully.")
		Windows.delay(5)
		return
	}

	KeywordUtil.logInfo("Main screen was not found. Trying to confirm login again with ENTER.")

	pressEnter()
	Windows.delay(10)

	isMainScreenVisible = Windows.waitForElementPresent(
			findWindowsObject('General/txtSearch'),
			45,
			FailureHandling.OPTIONAL
	)

	if (isMainScreenVisible) {
		KeywordUtil.logInfo("Main screen loaded successfully after ENTER fallback.")
		Windows.delay(5)
		return
	}

	KeywordUtil.markFailedAndStop(
		"Main screen was not loaded after login.\n" +
		"The application is probably still on the login window.\n" +
		"Expected element was not found: General/txtSearch"
	)
}


private void pressEnter() {
	java.awt.Robot robot = new java.awt.Robot()
	robot.setAutoDelay(250)

	robot.keyPress(java.awt.event.KeyEvent.VK_ENTER)
	robot.keyRelease(java.awt.event.KeyEvent.VK_ENTER)
}
