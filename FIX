function Print-Line {
    param([string]$Text)
    if (-not [string]::IsNullOrWhiteSpace($Text)) {
        Write-Host $Text
    }
}

function Emit-Scenario {
    param([string]$Scenario)

    $scenario = Short-Text $Scenario 170
    if (-not $scenario) { return }

    if ($script:LastScenario -ne $scenario) {
        $script:CurrentScenario = $scenario
        $script:LastScenario = $scenario
        $script:CurrentStep = ''
        $script:LastStepSignature = ''
        Print-Line ("🎬 SCENARIO | " + $scenario)
    }
}

function Emit-Step {
    param(
        [string]$Prefix,
        [string]$Step
    )

    $step = Short-Text $Step 170
    if (-not $step) { return }

    $signature = $Prefix + '|' + $step
    $script:CurrentStep = $step

    if ($script:LastStepSignature -ne $signature) {
        $script:LastStepSignature = $signature
        Print-Line ($Prefix + ' ' + $step)
    }
}

function Emit-Detail {
    param([string]$Text)

    $detail = Short-Text $Text 220
    if (-not $detail) { return }

    if ($script:LastDetail -ne $detail) {
        $script:LastDetail = $detail
        Print-Line ("❌ DETAIL   | " + $detail)
    }
}

function Parse-LiveLine {
    param([string]$Line)

    $text = Clean-Text $Line
    if (-not $text) { return }

    if ($text -match '(?i)Scenario(?: Outline)?\\s*[:\\-]?\\s*(.+)$') {
        Emit-Scenario $Matches[1]
        return
    }

    if ($text -match '(?i)\\b(Given|When|Then|And|But)\\b\\s+(.+)$') {
        $step = ($Matches[1] + ' ' + $Matches[2]).Trim()
        $step = $step -replace '(?i)\\s*(PASSED|FAILED|SKIPPED|ERROR|SUCCESS).*$', ''
        $step = Short-Text $step 170

        if ($text -match '(?i)\\bFAILED\\b|\\bERROR\\b|\\bEXCEPTION\\b|STEPFAILEDEXCEPTION|ASSERTIONFAILEDERROR|TIMED OUT|TIMEOUT|NOT FOUND') {
            Emit-Step '❌ STEP     |' $step
            return
        }

        if ($text -match '(?i)\\bSKIPPED\\b') {
            Emit-Step '⏭️ STEP     |' $step
            return
        }

        if ($text -match '(?i)\\bPASSED\\b|\\bSUCCESS\\b') {
            Emit-Step '✅ STEP     |' $step
            return
        }

        Emit-Step '➡️ STEP     |' $step
        return
    }

    if ($script:CurrentStep -and $text -match '(?i)StepFailedException|AssertionFailedError|Unable to|not found|timed out|Timeout|ERROR|FAILED|Exception') {
        Emit-Detail $text
        return
    }

    if ($text -match '(?i)Start Test Cases|End Test Cases|Start action|Start application|browser|Chrome|execution0\\.log|JUnit_Report|report\\.html') {
        Print-Line ("📝 INFO     | " + (Short-Text $text 220))
        return
    }
}

function Flush-File {
    param(
        [string]$Path,
        [ref]$Offset
    )

    $lines = Read-NewLines -Path $Path -Offset $Offset
    foreach ($line in $lines) {
        Parse-LiveLine -Line $line
    }
}

function Discover-ExecutionLog {
    param([string]$Root)

    if ($script:ExecutionLogPath -and (Test-Path $script:ExecutionLogPath)) {
        return $script:ExecutionLogPath
    }

    $candidate = Get-ChildItem -Path $Root -Filter 'execution0.log' -File -Recurse -ErrorAction SilentlyContinue |
        Where-Object {
            $_.FullName -notmatch '\\\\dashboard\\\\' -and
            $_.FullName -notmatch '\\\\logs\\\\'
        } |
        Sort-Object LastWriteTime -Descending |
        Select-Object -First 1

    if ($candidate) {
        $script:ExecutionLogPath = $candidate.FullName
        Print-Line ("📄 EXECUTION | " + $script:ExecutionLogPath)
        return $script:ExecutionLogPath
    }

    return ''
}

