import javax.xml.parsers.DocumentBuilderFactory

import org.w3c.dom.Document
import org.w3c.dom.Element
import org.w3c.dom.Node
import org.w3c.dom.NodeList

class JiraReportBuilder {

	private static final String APP_NAME = 'EMATCH'
	private static final String LOGO_SRC = 'Images/General/logo.png'

	private static final SimpleDateFormat OUTPUT_DATE_TIME =
	new SimpleDateFormat('dd/MM/yyyy HH:mm:ss', Locale.ENGLISH)

	private static final SimpleDateFormat OUTPUT_CLOCK =
	new SimpleDateFormat('HH:mm:ss', Locale.ENGLISH)

	private static final List<String> DATE_PATTERNS = [
		'yyyy-MM-dd HH:mm:ss.SSS',
		'yyyy-MM-dd HH:mm:ss',
		"yyyy-MM-dd'T'HH:mm:ss.SSSXXX",
		"yyyy-MM-dd'T'HH:mm:ss.SSS",
		"yyyy-MM-dd'T'HH:mm:ss",
		'dd/MM/yyyy HH:mm:ss',
		'dd/MM/yyyy HH:mm:ss.SSS',
		'HH:mm:ss'
	]

	File buildReport(String reportFolderPath) {
		return buildReport(new File(safe(reportFolderPath).isEmpty() ? '.' : reportFolderPath), '', '')
	}

	File buildReport(String reportFolderPath, String suiteName, String executionTitle) {
		return buildReport(new File(safe(reportFolderPath).isEmpty() ? '.' : reportFolderPath), suiteName, executionTitle)
	}

	File buildReport(File reportFolder) {
		return buildReport(reportFolder, '', '')
	}

	File buildReport(File reportFolder, String suiteName, String executionTitle) {
		File root = reportFolder ?: new File('.')
		Map model = buildModel(root, suiteName, executionTitle)

		JiraHtmlTemplateBuilder htmlBuilder = new JiraHtmlTemplateBuilder()
		String html = htmlBuilder.build(model)

		File target = new File(root, 'eMatchReport.html')
		target.setText(html, 'UTF-8')
		return target
	}

	private Map buildModel(File reportFolder, String suiteName, String executionTitle) {
		File root = reportFolder ?: new File('.')

		Map<String, Map> traceByCase = readTrace(root)
		List<File> junitFiles = collectJUnitFiles(root)
		List<Map> scenarios = []

		junitFiles.each { File junitFile ->
			scenarios.addAll(buildScenariosFromJUnit(junitFile, root, traceByCase))
		}

		if (scenarios.isEmpty()) {
			scenarios = buildFallbackFromTrace(root, traceByCase)
		}

		String resolvedSuiteName = !safe(suiteName).isEmpty() ? safe(suiteName) : detectSuiteName(root, scenarios)
		String resolvedExecutionTitle = !safe(executionTitle).isEmpty() ? safe(executionTitle) : resolvedSuiteName

		int passedCount = scenarios.count { Map row -> safe(row.status) == 'passed' }
		int failedCount = scenarios.count { Map row -> safe(row.status) == 'failed' }
		int blockedCount = scenarios.count { Map row -> safe(row.status) == 'blocked' }

		return [
			appName        : APP_NAME,
			logoSrc        : LOGO_SRC,
			reportTitle    : 'Test report - ' + resolvedExecutionTitle,
			suiteName      : resolvedSuiteName,
			executionName  : resolvedExecutionTitle,
			generatedLabel : 'Generated ' + OUTPUT_DATE_TIME.format(new Date()),
			reportFolder   : root.absolutePath,
			scenarios      : scenarios,
			passedCount    : passedCount,
			failedCount    : failedCount,
			blockedCount   : blockedCount,
			totalCount     : scenarios.size()
		]
	}

	private List<Map> buildScenariosFromJUnit(File junitFile, File reportRoot, Map<String, Map> traceByCase) {
		List<Map> scenarios = []
		Document xml = parseXml(junitFile)

		if (xml == null) {
			return scenarios
		}

		NodeList testcases = xml.getElementsByTagName('testcase')

		for (int i = 0; i < testcases.getLength(); i++) {
			Node node = testcases.item(i)
			if (!(node instanceof Element)) {
				continue
			}

			Element testcase = (Element) node

			String rawName = safe(testcase.getAttribute('name'))
			String className = safe(testcase.getAttribute('classname'))
			String displayName = buildDisplayName(className, rawName)
			String scenarioId = buildScenarioId(displayName, i + 1)

			String status = 'passed'
			String fullError = ''
			String visualError = ''

			NodeList children = testcase.getChildNodes()
			for (int c = 0; c < children.getLength(); c++) {
				Node child = children.item(c)
				if (!(child instanceof Element)) {
					continue
				}

				String childName = safe(child.getNodeName()).toLowerCase(Locale.ENGLISH)

				if ('failure'.equals(childName) || 'error'.equals(childName)) {
					status = 'failed'
					fullError = safe(child.getTextContent())
					visualError = buildShortError(safe(((Element) child).getAttribute('message')), fullError, displayName)
					break
				}

				if ('skipped'.equals(childName)) {
					status = 'blocked'
					fullError = safe(child.getTextContent())
					visualError = buildShortError(safe(((Element) child).getAttribute('message')), fullError, displayName)
				}
			}

			long junitDurationMs = toDurationMillis(safe(testcase.getAttribute('time')))
			Map trace = resolveTrace(traceByCase, displayName)

			long startMs = asLong(trace.startMs)
			long endMs = asLong(trace.endMs)
			long durationMs = 0L

			if (startMs > 0L && endMs >= startMs) {
				durationMs = endMs - startMs
			} else {
				durationMs = junitDurationMs
			}

			List<Map> steps = normalizeStepRows(trace.steps)
			if (steps.isEmpty() && 'failed'.equals(status) && !visualError.isEmpty()) {
				steps << [
					status   : 'failed',
					timestamp: endMs > 0L ? formatClock(endMs) : '--',
					detail   : visualError,
					icon     : resolveStepIcon(visualError, 'failed')
				]
			}

			List<Map> evidence = collectEvidence(reportRoot, displayName)

			scenarios << [
				id           : scenarioId,
				name         : displayName,
				scenarioName : displayName,
				status       : status,
				result       : status,
				durationMs   : durationMs,
				durationLabel: formatDuration(durationMs),
				startTime    : startMs > 0L ? formatDateTime(startMs) : '',
				endTime      : endMs > 0L ? formatDateTime(endMs) : '',
				startLabel   : startMs > 0L ? formatDateTime(startMs) : '--',
				endLabel     : endMs > 0L ? formatDateTime(endMs) : '--',
				startShort   : startMs > 0L ? formatDateTime(startMs) : '--',
				endShort     : endMs > 0L ? formatDateTime(endMs) : '--',
				startLong    : startMs > 0L ? formatDateTime(startMs) : '--',
				endLong      : endMs > 0L ? formatDateTime(endMs) : '--',
				visualError  : visualError,
				errorSummary : visualError,
				fullError    : fullError,
				errorDetail  : fullError,
				reportFolder : reportRoot.absolutePath,
				steps        : steps,
				evidence     : evidence
			]
		}

		return scenarios
	}

	private List<Map> buildFallbackFromTrace(File reportRoot, Map<String, Map> traceByCase) {
		List<Map> scenarios = []

		traceByCase.eachWithIndex { String caseId, Map trace, int index ->
			long startMs = asLong(trace.startMs)
			long endMs = asLong(trace.endMs)
			long durationMs = startMs > 0L && endMs >= startMs ? (endMs - startMs) : 0L

			String rawStatus = safe(trace.status)
			String status = normalizeScenarioStatus(rawStatus)
			List<Map> steps = normalizeStepRows(trace.steps)
			String failure = safe(trace.failure)
			List<Map> evidence = collectEvidence(reportRoot, caseId)

			scenarios << [
				id           : buildScenarioId(caseId, index + 1),
				name         : caseId,
				scenarioName : caseId,
				status       : status,
				result       : status,
				durationMs   : durationMs,
				durationLabel: formatDuration(durationMs),
				startTime    : startMs > 0L ? formatDateTime(startMs) : '',
				endTime      : endMs > 0L ? formatDateTime(endMs) : '',
				startLabel   : startMs > 0L ? formatDateTime(startMs) : '--',
				endLabel     : endMs > 0L ? formatDateTime(endMs) : '--',
				startShort   : startMs > 0L ? formatDateTime(startMs) : '--',
				endShort     : endMs > 0L ? formatDateTime(endMs) : '--',
				startLong    : startMs > 0L ? formatDateTime(startMs) : '--',
				endLong      : endMs > 0L ? formatDateTime(endMs) : '--',
				visualError  : failure,
				errorSummary : failure,
				fullError    : failure,
				errorDetail  : failure,
				reportFolder : reportRoot.absolutePath,
				steps        : steps,
				evidence     : evidence
			]
		}

		return scenarios
	}

	private Map<String, Map> readTrace(File root) {
		Map<String, Map> result = new LinkedHashMap<String, Map>()
		File traceFile = new File(root, '_custom_report_trace.log')

		if (!traceFile.exists()) {
			return result
		}

		eachLineSafely(traceFile) { String line ->
			List<String> parts = line.split('\t', 4) as List<String>
			if (parts.size() < 4) {
				return
			}

			String type = safe(parts[0])
			long millis = asLong(parts[1])
			String caseId = safe(parts[2])
			String payload = ''

			try {
				payload = new String(Base64.decoder.decode(safe(parts[3])), 'UTF-8')
			} catch (Throwable ignored) {
				payload = ''
			}

			if (caseId.isEmpty()) {
				return
			}

			Map row = result.containsKey(caseId) ? result[caseId] : [
				startMs : 0L,
				endMs   : 0L,
				status  : '',
				failure : '',
				steps   : []
			]

			if ('CASE_START'.equals(type)) {
				row.startMs = millis
			} else if ('CASE_END'.equals(type)) {
				row.endMs = millis
				row.status = safe(payload)
			} else if ('STEP'.equals(type)) {
				row.steps << [
					status   : 'passed',
					timestamp: formatClock(millis),
					timeMs   : millis,
					detail   : safe(payload),
					icon     : resolveStepIcon(safe(payload), 'passed')
				]
			} else if ('STEP_FAIL'.equals(type)) {
				row.failure = safe(payload)
				row.steps << [
					status   : 'failed',
					timestamp: formatClock(millis),
					timeMs   : millis,
					detail   : safe(payload),
					icon     : resolveStepIcon(safe(payload), 'failed')
				]
			}

			result[caseId] = row
		}

		return result
	}

	private List<Map> normalizeStepRows(def rawSteps) {
		List<Map> result = []

		if (!(rawSteps instanceof Collection)) {
			return result
		}

		(rawSteps as Collection).each { def item ->
			if (!(item instanceof Map)) {
				return
			}

			String detail = safe(item.detail)
			if (detail.isEmpty()) {
				return
			}

			String status = normalizeStepStatus(safe(item.status))
			String timestamp = safe(item.timestamp)
			long timeMs = asLong(item.timeMs)

			result << [
				status   : status,
				timestamp: !timestamp.isEmpty() ? timestamp : (timeMs > 0L ? formatClock(timeMs) : '--'),
				detail   : detail,
				icon     : resolveStepIcon(detail, status),
				timeMs   : timeMs
			]
		}

		result = result
				.unique { Map row -> safe(row.status) + '|' + safe(row.timestamp) + '|' + safe(row.detail) }
				.sort { Map a, Map b -> asLong(a.timeMs) <=> asLong(b.timeMs) }

		return result
	}

	private Map resolveTrace(Map<String, Map> traceByCase, String displayName) {
		if (traceByCase.containsKey(displayName)) {
			return traceByCase[displayName]
		}

		String normalizedTarget = normalizeKey(displayName)

		traceByCase.each { String key, Map row ->
			if (normalizeKey(key) == normalizedTarget) {
				return row
			}
		}

		for (String key : traceByCase.keySet()) {
			if (normalizeKey(key) == normalizedTarget) {
				return traceByCase[key]
			}
		}

		return [
			startMs : 0L,
			endMs   : 0L,
			status  : '',
			failure : '',
			steps   : []
		]
	}

	private List<Map> collectEvidence(File reportRoot, String scenarioName) {
		List<File> images = []
		File evidenceRoot = new File(reportRoot, 'Evidences')

		if (!evidenceRoot.exists()) {
			return []
		}

		evidenceRoot.eachFileRecurse { File file ->
			if (!file.isFile()) {
				return
			}

			String lower = safe(file.name).toLowerCase(Locale.ENGLISH)
			if (lower.endsWith('.png') || lower.endsWith('.jpg') || lower.endsWith('.jpeg') || lower.endsWith('.gif') || lower.endsWith('.bmp') || lower.endsWith('.webp')) {
				images << file
			}
		}

		String scenarioKey = normalizeKey(scenarioName)
		List<String> tokens = tokenize(scenarioName)

		List<Map> scored = []
		images.each { File image ->
			String pathKey = normalizeKey(image.absolutePath)
			int score = 0

			if (!scenarioKey.isEmpty() && pathKey.contains(scenarioKey)) {
				score += 50
			}

			tokens.each { String token ->
				if (token.length() >= 4 && pathKey.contains(token.toLowerCase(Locale.ENGLISH))) {
					score += 5
				}
			}

			scored << [
				file : image,
				score: score
			]
		}

		scored = scored.sort { Map a, Map b ->
			int byScore = (b.score as int) <=> (a.score as int)
			if (byScore != 0) {
				return byScore
			}
			return ((b.file as File).lastModified()) <=> ((a.file as File).lastModified())
		}

		List<Map> result = []
		scored.each { Map row ->
			File file = row.file as File
			int score = row.score as int

			if (result.size() >= 6) {
				return
			}

			if (score <= 0 && !result.isEmpty()) {
				return
			}

			result << [
				name   : file.name,
				href   : file.toURI().toString(),
				image  : true,
				imgSrc : file.toURI().toString()
			]
		}

		return result
	}

	private List<File> collectJUnitFiles(File root) {
		List<File> result = []

		if (root == null || !root.exists()) {
			return result
		}

		root.eachFileRecurse { File file ->
			if (!file.isFile()) {
				return
			}

			String lower = safe(file.name).toLowerCase(Locale.ENGLISH)
			if (lower == 'junit_report.xml' || lower == 'junit.xml' || lower == 'junitreport.xml' || lower == 'junit-report.xml' || lower == 'cucumber.xml') {
				result << file
			}
		}

		result = result
				.unique { File file -> file.absolutePath }
				.sort { File a, File b -> a.absolutePath.toLowerCase(Locale.ENGLISH) <=> b.absolutePath.toLowerCase(Locale.ENGLISH) }

		return result
	}

	private Document parseXml(File file) {
		if (file == null || !file.exists()) {
			return null
		}

		try {
			DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance()
			factory.setNamespaceAware(false)
			factory.setXIncludeAware(false)
			factory.setExpandEntityReferences(false)
			factory.setFeature(XMLConstants.FEATURE_SECURE_PROCESSING, true)

			try {
				factory.setFeature('http://apache.org/xml/features/disallow-doctype-decl', true)
			} catch (Throwable ignored) {
			}

			DocumentBuilder builder = factory.newDocumentBuilder()
			Document document = builder.parse(file)
			document.getDocumentElement().normalize()
			return document
		} catch (Throwable ignored) {
			return null
		}
	}

	private String buildDisplayName(String className, String rawName) {
		String cleanClass = safe(className)
		String cleanName = safe(rawName)

		if (!cleanClass.isEmpty()) {
			if (cleanClass.startsWith('Test Cases/')) {
				if (!cleanName.isEmpty() && !cleanClass.endsWith(cleanName)) {
					return cleanClass + '/' + cleanName
				}
				return cleanClass
			}

			if (cleanClass.contains('/')) {
				if (!cleanName.isEmpty() && !cleanClass.endsWith(cleanName)) {
					return cleanClass + '/' + cleanName
				}
				return cleanClass
			}
		}

		return cleanName
	}

	private String detectSuiteName(File root, List<Map> scenarios) {
		String folderName = root != null ? safe(root.name) : ''
		if (!folderName.isEmpty() && !folderName.matches('\\d+')) {
			return folderName
		}

		if (root != null && root.parentFile != null) {
			String parent = safe(root.parentFile.name)
			if (!parent.isEmpty() && !parent.matches('\\d+')) {
				return parent
			}
		}

		if (scenarios != null && !scenarios.isEmpty()) {
			return safe(scenarios[0].name)
		}

		return 'Execution'
	}

	private String buildScenarioId(String value, int index) {
		String text = safe(value)
				.replace('\\', '/')
				.replaceAll('[^A-Za-z0-9/_-]+', '-')
				.replaceAll('-+', '-')
				.replaceAll('^[-/]+', '')
				.replaceAll('[-/]+$', '')

		return text.isEmpty() ? 'scenario-' + index : text
	}

	private String buildShortError(String message, String fullError, String displayName) {
		List<String> candidates = [
			safe(message),
			firstMeaningfulLine(fullError),
			safe(displayName) + ' FAILED.'
		].findAll { String value -> !safe(value).isEmpty() }

		return candidates.isEmpty() ? '' : candidates[0]
	}

	private String firstMeaningfulLine(String text) {
		List<String> lines = safe(text).readLines()
		for (String line : lines) {
			String current = safe(line)
			if (!current.isEmpty() && !'Reason:'.equalsIgnoreCase(current)) {
				return current
			}
		}
		return ''
	}

	private String normalizeScenarioStatus(String raw) {
		String upper = safe(raw).toUpperCase(Locale.ENGLISH)
		if (upper == 'PASSED' || upper == 'PASS' || upper == 'SUCCESS') {
			return 'passed'
		}
		if (upper == 'FAILED' || upper == 'FAIL' || upper == 'ERROR') {
			return 'failed'
		}
		if (upper == 'BLOCKED' || upper == 'SKIPPED' || upper == 'SKIP') {
			return 'blocked'
		}
		return 'passed'
	}

	private String normalizeStepStatus(String raw) {
		String lower = safe(raw).toLowerCase(Locale.ENGLISH)
		if (lower == 'passed' || lower == 'pass' || lower == 'success') {
			return 'passed'
		}
		if (lower == 'failed' || lower == 'fail' || lower == 'error') {
			return 'failed'
		}
		if (lower == 'blocked' || lower == 'skipped' || lower == 'skip') {
			return 'blocked'
		}
		return 'info'
	}

	private String resolveStepIcon(String detail, String status) {
		String lower = safe(detail).toLowerCase(Locale.ENGLISH)

		if ('failed'.equals(status)) {
			return '❌'
		}
		if ('passed'.equals(status)) {
			if (lower.contains('open') || lower.contains('screen') || lower.contains('page')) {
				return '🌐'
			}
			if (lower.contains('select') || lower.contains('choose')) {
				return '🖱️'
			}
			if (lower.contains('verify') || lower.contains('validate') || lower.contains('check')) {
				return '✅'
			}
			if (lower.contains('credential') || lower.contains('username') || lower.contains('password')) {
				return '🔐'
			}
			return '✅'
		}
		if ('blocked'.equals(status)) {
			return '⛔'
		}

		if (lower.contains('open') || lower.contains('screen') || lower.contains('page')) {
			return '🌐'
		}
		if (lower.contains('select') || lower.contains('choose')) {
			return '🖱️'
		}
		if (lower.contains('verify') || lower.contains('validate') || lower.contains('check')) {
			return '🔎'
		}
		return 'ℹ️'
	}

	private List<String> tokenize(String value) {
		return safe(value)
				.toLowerCase(Locale.ENGLISH)
				.split('[^a-z0-9]+')
				.findAll { String token -> token != null && token.trim().length() >= 4 }
	}

	private String normalizeKey(String value) {
		return safe(value)
				.toLowerCase(Locale.ENGLISH)
				.replaceAll('[^a-z0-9]+', '')
	}

	private long toDurationMillis(String secondsValue) {
		String value = safe(secondsValue)
		if (value.isEmpty()) {
			return 0L
		}

		try {
			BigDecimal seconds = new BigDecimal(value.replace(',', '.'))
			return seconds.multiply(new BigDecimal('1000')).longValue()
		} catch (Throwable ignored) {
			return 0L
		}
	}

	private long asLong(def value) {
		try {
			return Long.parseLong(String.valueOf(value))
		} catch (Throwable ignored) {
			return 0L
		}
	}

	private String formatDateTime(long millis) {
		if (millis <= 0L) {
			return '--'
		}
		return OUTPUT_DATE_TIME.format(new Date(millis))
	}

	private String formatClock(long millis) {
		if (millis <= 0L) {
			return '--'
		}
		return OUTPUT_CLOCK.format(new Date(millis))
	}

	private String formatDuration(long durationMs) {
		long value = durationMs < 0L ? 0L : durationMs
		long totalSeconds = Math.round(value / 1000.0d)
		long hours = (long) (totalSeconds / 3600L)
		long minutes = (long) ((totalSeconds % 3600L) / 60L)
		long seconds = (long) (totalSeconds % 60L)

		return String.format(Locale.ENGLISH, '%02dh %02dm %02ds', hours, minutes, seconds)
	}

	private void eachLineSafely(File file, Closure consumer) {
		BufferedReader reader = null
		try {
			reader = new BufferedReader(new InputStreamReader(new FileInputStream(file), 'UTF-8'))
			String line
			while ((line = reader.readLine()) != null) {
				consumer.call(line)
			}
		} catch (Throwable ignored) {
		} finally {
			try {
				reader?.close()
			} catch (Throwable ignored) {
			}
		}
	}

	private String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}
}




package jiraIntegration

import com.kms.katalon.core.util.KeywordUtil

import java.util.Locale

class JiraTestPlanManager {

	private final JiraGateway gateway
	private final String projectKey
	private final String issueTypeId
	private final String epicFieldId
	private final String epicKey
	private final String assigneeName

	JiraTestPlanManager(
	JiraGateway gateway,
	String projectKey,
	String issueTypeId,
	String epicFieldId,
	String epicKey,
	String assigneeName
	) {
		this.gateway = gateway
		this.projectKey = safe(projectKey)
		this.issueTypeId = safe(issueTypeId)
		this.epicFieldId = safe(epicFieldId)
		this.epicKey = safe(epicKey)
		this.assigneeName = safe(assigneeName)
	}

	String getOrCreateTestPlanKey(String suiteName, String manualTestPlanKey, boolean forceCreateNew) {
		if (!blank(manualTestPlanKey)) {
			KeywordUtil.logInfo('Using saved Test Plan key for suite ' + suiteName + ': ' + manualTestPlanKey)
			ensureTestPlanFields(manualTestPlanKey)
			return manualTestPlanKey
		}

		String summary = buildTestPlanSummary(suiteName)

		if (!forceCreateNew) {
			String existing = findExistingTestPlanKey(summary)

			if (!blank(existing)) {
				KeywordUtil.logInfo('Found existing Test Plan with summary ' + summary + ': ' + existing)
				ensureTestPlanFields(existing)
				return existing
			}
		}

		return createNewTestPlan(summary)
	}

	String findExistingTestPlanKey(String summary) {
		String escapedSummary = escapeForJql(summary)

		String jql =
				'project = "' + projectKey + '" ' +
				'AND issuetype = "Test Plan" ' +
				'AND summary ~ "\\"' + escapedSummary + '\\"" ' +
				'ORDER BY created DESC'

		Map response = gateway.searchIssuesByJql(jql, 200)

		KeywordUtil.logInfo('Search Test Plan status: ' + response.status)
		KeywordUtil.logInfo('Search Test Plan response: ' + safe(response.body))

		if ((response.status as int) != 200) {
			return ''
		}

		List issues = (response.json instanceof Map && response.json.issues instanceof List)
				? (response.json.issues as List)
				: []

		def exact = issues.find { Object raw ->
			Map issue = raw instanceof Map ? (Map) raw : [:]
			String currentSummary = safe(issue?.fields?.summary)
			return normalize(currentSummary) == normalize(summary)
		}

		return safe(exact?.key)
	}

	String createNewTestPlan(String summary) {
		KeywordUtil.logInfo('Creating new Test Plan with summary: ' + summary)

		Map response = gateway.createTestPlan(
				projectKey,
				summary,
				issueTypeId,
				epicFieldId,
				epicKey,
				assigneeName
				)

		KeywordUtil.logInfo('Create Test Plan status: ' + response.status)
		KeywordUtil.logInfo('Create Test Plan response: ' + safe(response.body))

		if ((response.status as int) != 201 && shouldRetryWithoutOptionalFields(response)) {
			KeywordUtil.logInfo('Create with Epic/Assignee failed on create screen. Retrying base create, then forcing fields with update.')

			response = gateway.createTestPlan(
					projectKey,
					summary,
					issueTypeId,
					'',
					'',
					''
					)

			KeywordUtil.logInfo('Retry Create Test Plan status: ' + response.status)
			KeywordUtil.logInfo('Retry Create Test Plan response: ' + safe(response.body))
		}

		if ((response.status as int) != 201) {
			throw new RuntimeException('Create Test Plan failed with status ' + response.status + '. Body: ' + safe(response.body))
		}

		String key = safe(response?.json?.key)

		if (blank(key)) {
			throw new RuntimeException('Create Test Plan succeeded but no key was returned. Body: ' + safe(response.body))
		}

		ensureTestPlanFields(key)

		KeywordUtil.logInfo('New Test Plan created successfully: ' + key)
		return key
	}

	void ensureTestPlanFields(String issueKey) {
		Map fields = [:]

		if (!blank(epicFieldId) && !blank(epicKey)) {
			fields[epicFieldId] = epicKey
		}

		if (!blank(assigneeName) && !isAutomaticAssignee(assigneeName)) {
			fields.assignee = [name: assigneeName]
		}

		if (fields.isEmpty()) {
			return
		}

		Map response = gateway.updateIssueFields(issueKey, fields)

		KeywordUtil.logInfo('Update Test Plan fields status: ' + response.status)
		KeywordUtil.logInfo('Update Test Plan fields response: ' + safe(response.body))

		if (!((response.status as int) in [200, 204])) {
			throw new RuntimeException('Update Test Plan fields failed for ' + issueKey + ' with status ' + response.status + '. Body: ' + safe(response.body))
		}
	}

	String buildTestPlanSummary(String suiteName) {
		return safe(suiteName) + ' Test Plan'
	}

	private boolean shouldRetryWithoutOptionalFields(Map response) {
		String body = safe(response?.body).toLowerCase(Locale.ENGLISH)
		String epicField = safe(epicFieldId).toLowerCase(Locale.ENGLISH)

		return body.contains('cannot be set') &&
				(
				body.contains('assignee') ||
				body.contains('customfield_') ||
				(!blank(epicField) && body.contains(epicField))
				)
	}

	private boolean isAutomaticAssignee(String value) {
		String text = safe(value).toLowerCase(Locale.ENGLISH)
		return text == '-1' || text == 'automatic'
	}

	private String escapeForJql(String value) {
		return safe(value).replace('\\', '\\\\').replace('"', '\\"')
	}

	private String normalize(String value) {
		return safe(value).replaceAll(/\s+/, ' ').trim().toLowerCase(Locale.ENGLISH)
	}

	private boolean blank(String value) {
		return safe(value).isEmpty()
	}

	private String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}
}
