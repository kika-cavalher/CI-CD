	}

	String nowExecution() {
		return new SimpleDateFormat('yyyy-MM-dd HH.mm.ss').format(new Date())
	}

	String sanitizeFileName(String value) {
		return safe(value).replaceAll('[\\\\/:*?"<>|]', '_').trim()
	}

	boolean isTimestampFolderName(String name) {
		if (isBlank(name)) return false
		return name ==~ /\d{8}_\d{6}/ || name ==~ /\d{14}/
	}

	boolean isMetaFolderName(String name) {
		if (isBlank(name)) return true

		String n = name.trim()
		if (n.equalsIgnoreCase('Reports')) return true
		if (n.equalsIgnoreCase('logs')) return true
		if (n.equalsIgnoreCase('videos')) return true
		if (n.equalsIgnoreCase('cucumber_report')) return true
		if (n.equalsIgnoreCase('PreLoad')) return true
		if (n.equalsIgnoreCase(EVIDENCE_FOLDER_NAME)) return true
		if (isTimestampFolderName(n)) return true

		return false
	}

	String formatDurationSeconds(BigDecimal totalSeconds) {
		if (totalSeconds == null) return '0m 0s'

		long millis = (totalSeconds * 1000).longValue()
		long hours = (long) (millis / 3600000)
		long minutes = (long) ((millis % 3600000) / 60000)
		long seconds = (long) ((millis % 60000) / 1000)
		long ms = (long) (millis % 1000)

		if (hours > 0) return "${hours}h ${minutes}m ${seconds}s ${ms}ms"
		if (minutes > 0) return "${minutes}m ${seconds}s ${ms}ms"
		return "${seconds}s ${ms}ms"
	}

	String readLastRunExcelPath() {
		File file = new File(RunConfiguration.projectDir + File.separator + 'LastRun.xlsx')
		if (!file.exists()) return ''

		FileInputStream fis = null
		XSSFWorkbook wb = null

		try {
			fis = new FileInputStream(file)
			wb = new XSSFWorkbook(fis)
			XSSFSheet sheet = wb.getSheetAt(0)
			XSSFRow row = sheet.getRow(0)
			if (row == null || row.getCell(0) == null) return ''
			return safe(row.getCell(0).stringCellValue)
		} catch (Exception ignored) {
			return ''
		} finally {
			try { if (wb != null) wb.close() } catch (Exception ignored) {}
			try { if (fis != null) fis.close() } catch (Exception ignored) {}
		}
	}

	boolean folderLooksLikeLeafReport(File folder) {
		if (folder == null || !folder.exists() || !folder.isDirectory()) return false

		File[] files = folder.listFiles()
		if (files == null) return false

		boolean hasExecutionProperties = files.find { it.isFile() && it.name.equalsIgnoreCase('execution.properties') } != null
		boolean hasXml = files.find { it.isFile() && (it.name.equalsIgnoreCase(PRIMARY_XML_FILE_NAME) || it.name.equalsIgnoreCase(SECONDARY_XML_FILE_NAME)) } != null
		boolean hasCucumberFolder = files.find { it.isDirectory() && it.name.equalsIgnoreCase('cucumber_report') } != null

		return hasExecutionProperties || hasXml || hasCucumberFolder
	}

	void collectLeafReportFolders(File start, List<File> result) {
		if (start == null || !start.exists() || !start.isDirectory()) return

		if (folderLooksLikeLeafReport(start)) {
			result.add(start)
		}

		File[] children = start.listFiles()
		if (children == null) return

		children.findAll { it.isDirectory() }.each { File child ->
			collectLeafReportFolders(child, result)
		}
	}

	String getReportPath() {
		List<File> candidates = []

		try {
			String currentRunFolder = safe(RunConfiguration.getReportFolder())
			if (!isBlank(currentRunFolder)) {
				File current = new File(currentRunFolder)
				if (current.exists()) {
					if (folderLooksLikeLeafReport(current)) {
						candidates.add(current)
					} else {
						collectLeafReportFolders(current, candidates)
					}
				}
			}
		} catch (Exception ignored) {}

		String lastRunFromExcel = readLastRunExcelPath()
		if (!isBlank(lastRunFromExcel)) {
			File lastRun = new File(lastRunFromExcel)
			if (lastRun.exists()) {
				if (folderLooksLikeLeafReport(lastRun)) {
					candidates.add(lastRun)
				} else {
					collectLeafReportFolders(lastRun, candidates)
				}
			}
		}

		File reportsRoot = new File(RunConfiguration.projectDir + File.separator + 'Reports')
		if (reportsRoot.exists()) {
			collectLeafReportFolders(reportsRoot, candidates)
		}

		candidates = candidates.findAll { it != null && it.exists() }.unique { it.absolutePath }
		if (candidates.isEmpty()) return ''

		candidates.sort { a, b -> b.lastModified() <=> a.lastModified() }

		return candidates[0].absolutePath
	}

	String extractSuiteNameFromReportPath(String reportPath) {
		if (isBlank(reportPath)) return ''

		String normalized = reportPath.replace('/', File.separator).replace('\\', File.separator)
		List<String> parts = normalized.split(java.util.regex.Pattern.quote(File.separator)).findAll { !isBlank(it) }

		for (int i = parts.size() - 1; i >= 0; i--) {
			String name = safe(parts[i])
			if (!isMetaFolderName(name)) {
				return name
			}
		}

		return ''
	}

