	private void attachEvidenceToFailedScenarios(File reportDir, List<Map> scenarios) {
		scenarios.each { Map scenario ->
			scenario.evidences = []
		}

		List<File> candidates = findEvidenceImages(reportDir)
		if (candidates.isEmpty()) {
			return
		}

		candidates.sort { File a, File b -> a.lastModified() <=> b.lastModified() }

		List<Map> failedScenarios = scenarios.findAll { Map item ->
			safeValue(item.status) == 'failed'
		}

		failedScenarios.each { Map scenario ->
			File selected = pickEvidenceForScenario(reportDir, candidates, scenario)
			if (selected == null || !selected.exists()) {
				return
			}

			File bundled = ensureEvidenceInReportFolder(reportDir, selected)
			String href = buildEvidenceHref(bundled, reportDir)
			String previewSrc = buildEvidencePreviewSrc(bundled)

			scenario.evidences = [[
				name         : bundled.name,
				fileName     : bundled.name,
				href         : href,
				imgSrc       : previewSrc,
				imageSrc     : previewSrc,
				imageDataUri : previewSrc,
				image        : true
			]]
		}
	}

	private List<File> findEvidenceImages(File reportDir) {
		List<File> roots = []
		Set<String> seen = [] as Set
		List<File> images = []

		if (reportDir != null && reportDir.exists()) {
			roots << reportDir
		}

		if (reportDir?.parentFile != null && reportDir.parentFile.exists()) {
			roots << reportDir.parentFile
		}

		roots.unique { File item -> item.absolutePath }.each { File root ->
			root.eachFileRecurse { File file ->
				if (!file.isFile()) {
					return
				}

				if (!isImageFile(file.name)) {
					return
				}

				try {
					String key = file.canonicalPath
					if (seen.add(key)) {
						images << file
					}
				} catch (Exception ignored) {
					if (seen.add(file.absolutePath)) {
						images << file
					}
				}
			}
		}

		images.sort { File a, File b -> a.lastModified() <=> b.lastModified() }
		return images
	}

	private File pickEvidenceForScenario(File reportDir, List<File> candidates, Map scenario) {
		if (candidates == null || candidates.isEmpty()) {
			return null
		}

		long startMillis = resolveScenarioAbsoluteTime(reportDir, safeValue(scenario.startLabel))
		long endMillis = resolveScenarioAbsoluteTime(reportDir, safeValue(scenario.endLabel))

		if (startMillis > 0L && endMillis >= startMillis) {
			List<File> insideWindow = candidates.findAll { File file ->
				long modified = file.lastModified()
				return modified >= (startMillis - 5000L) && modified <= (endMillis + 15000L)
			}

			if (!insideWindow.isEmpty()) {
				insideWindow.sort { File a, File b -> a.lastModified() <=> b.lastModified() }
				return insideWindow.last()
			}
		}

		return candidates.last()
	}

	private long resolveScenarioAbsoluteTime(File reportDir, String timeLabel) {
		if (isBlank(timeLabel)) {
			return 0L
		}

		String raw = safeValue(timeLabel)

		try {
			List<String> patterns = [
				'yyyy-MM-dd HH:mm:ss',
				'yyyy-MM-dd HH:mm:ss.SSS',
				'MM.dd.yyyy hh:mm:ss a',
				'dd.MM.yyyy HH:mm:ss',
				'HH:mm:ss'
			]

			for (String pattern : patterns) {
				try {
					Date parsed = new SimpleDateFormat(pattern, Locale.ENGLISH).parse(raw)
					return parsed.time
				} catch (Exception ignored) {
				}
			}

			String baseDate = new SimpleDateFormat('yyyy-MM-dd', Locale.ENGLISH).format(new Date(reportDir.lastModified()))
			Date clockDate = new SimpleDateFormat('yyyy-MM-dd HH:mm:ss', Locale.ENGLISH).parse(baseDate + ' ' + raw)
			return clockDate.time
		} catch (Exception ignored) {
			return 0L
		}
	}

	private File ensureEvidenceInReportFolder(File reportDir, File source) {
		if (source == null || !source.exists()) {
			return source
		}

		File evidenceDir = new File(reportDir, safeValue(flow.EVIDENCE_FOLDER_NAME))
		if (!evidenceDir.exists()) {
			evidenceDir.mkdirs()
		}

		File target = new File(evidenceDir, source.name)

		try {
			if (!target.exists() || target.length() != source.length()) {
				Files.copy(source.toPath(), target.toPath(), StandardCopyOption.REPLACE_EXISTING)
				target.setLastModified(source.lastModified())
			}
		} catch (Exception ignored) {
			return source
		}

		return target
	}

	private String buildEvidenceHref(File file, File reportDir) {
		if (file == null || !file.exists()) {
			return ''
		}

		try {
			String reportBase = reportDir.canonicalPath.replace('\\', '/') + '/'
			String filePath = file.canonicalPath.replace('\\', '/')

			if (filePath.startsWith(reportBase)) {
				return filePath.substring(reportBase.length())
			}
		} catch (Exception ignored) {
		}

		return file.toURI().toString()
	}

	private String buildEvidencePreviewSrc(File file) {
		if (file == null || !file.exists()) {
			return ''
		}

		if (!isImageFile(file.name)) {
			return ''
		}

		try {
			byte[] content = Files.readAllBytes(file.toPath())
			String mime = resolveImageMime(file.name)
			return 'data:' + mime + ';base64,' + Base64.encoder.encodeToString(content)
		} catch (Exception ignored) {
			return file.toURI().toString()
		}
	}

