package common

import static com.kms.katalon.core.testobject.ObjectRepository.findTestObject

import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.TestObject
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI

import cucumber.api.java.en.Given
import cucumber.api.java.en.Then
import cucumber.api.java.en.When
import internal.GlobalVariable

class Login {

	private static final int LOGIN_TIMEOUT = 10
	private static final int PAGE_TIMEOUT = 60
	private static final int HUE_READY_TIMEOUT = 90

	private static final String OBJ_LOGIN_USERNAME = 'Login/input_Username'
	private static final String OBJ_LOGIN_PASSWORD = 'Login/input_Password'
	private static final String OBJ_LOGIN_BUTTON = 'Login/button_SignIn'

	private static final String OBJ_BREADCRUMB_DEFAULT = 'Navigation/breadcrumb_DefaultDatabase'
	private static final String OBJ_BREADCRUMB_HIVE = 'Navigation/breadcrumb_Hive'
	private static final String OBJ_DATABASE_SEARCH = 'Navigation/input_DatabaseSearch'

	@Given("user opens DEV login page")
	def userOpensDevLoginPageStep() {
		openDevLoginPage()
	}

	@When("the user logs in with the correct profile credentials.")
	def userLogsInWithDefaultProfileCredentialsStep() {
		loginIfRequired()
	}

	@Then("Hue home should be opened")
	def hueHomeShouldBeOpenedStep() {
		waitUntilHueScreenIsReady()
	}

	@Given("DEV user is authenticated")
	def devUserIsAuthenticatedStep() {
		openDevLoginPage()
		loginIfRequired()
		waitUntilHueScreenIsReady()
	}

	@Given("DEV user logguin")
	def devUserLogguinStep() {
		openDevLoginPage()
		loginIfRequired()
		waitUntilHueScreenIsReady()
	}

	private void openDevLoginPage() {
		KeywordUtil.logInfo("Opening DEV login page")

		WebUI.openBrowser('')
		WebUI.maximizeWindow()
		WebUI.navigateToUrl(GlobalVariable.DEV_URL.toString())

		WebUI.waitForPageLoad(PAGE_TIMEOUT)
	}

	private void loginIfRequired() {
		KeywordUtil.logInfo("Checking login screen")

		boolean loginVisible = isObjectPresent(OBJ_LOGIN_USERNAME, LOGIN_TIMEOUT)

		if (!loginVisible) {
			KeywordUtil.logInfo("Login screen was not displayed. User is already authenticated or SSO is still processing.")
			return
		}

		KeywordUtil.logInfo("Login screen is visible. Filling credentials.")

		WebUI.setText(
			findTestObject(OBJ_LOGIN_USERNAME),
			GlobalVariable.DEV_USERNAME.toString()
		)

		WebUI.setEncryptedText(
			findTestObject(OBJ_LOGIN_PASSWORD),
			GlobalVariable.DEV_PASSWORD.toString()
		)

		WebUI.click(findTestObject(OBJ_LOGIN_BUTTON))

		WebUI.waitForPageLoad(PAGE_TIMEOUT)
	}

	private void waitUntilHueScreenIsReady() {
		KeywordUtil.logInfo("Waiting until Hue screen is fully loaded")

		for (int i = 0; i < HUE_READY_TIMEOUT; i++) {
			boolean defaultBreadcrumbVisible = isObjectPresent(OBJ_BREADCRUMB_DEFAULT, 1)
			boolean hiveBreadcrumbVisible = isObjectPresent(OBJ_BREADCRUMB_HIVE, 1)
			boolean databaseSearchVisible = isObjectPresent(OBJ_DATABASE_SEARCH, 1)

			if (defaultBreadcrumbVisible) {
				KeywordUtil.logInfo("Hue screen is ready. Default breadcrumb is visible.")
				return
			}

			if (hiveBreadcrumbVisible) {
				KeywordUtil.logInfo("Hue screen is ready. Hive breadcrumb is visible.")
				return
			}

			if (databaseSearchVisible) {
				KeywordUtil.logInfo("Hue screen is ready. Database search input is visible.")
				return
			}

			WebUI.delay(1)
		}

		KeywordUtil.markFailedAndStop("Hue screen was not fully loaded after login.")
	}

	private boolean isObjectPresent(String objectPath, int timeoutInSeconds) {
		try {
			TestObject testObject = findTestObject(objectPath)

			if (testObject == null) {
				KeywordUtil.logInfo("Object Repository item was not found: " + objectPath)
				return false
			}

			return WebUI.verifyElementPresent(
				testObject,
				timeoutInSeconds,
				FailureHandling.OPTIONAL
			)
		} catch (Exception ignored) {
			return false
		}
	}
}
