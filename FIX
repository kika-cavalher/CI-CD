	private void typeDateWithRobot(
			String dateValue
	) {

		if (dateValue == null ||
			dateValue.trim().isEmpty()) {

			KeywordUtil.markFailedAndStop(
					'Date value is empty.'
					)

			return
		}

		String safeDateValue =
				dateValue.trim()

		for (Integer index = 0;
			index < safeDateValue.length();
			index++) {

			char currentCharacter =
					safeDateValue.charAt(
					index
					)

			switch (currentCharacter) {
				case '0':
					pressAndRelease(KeyEvent.VK_0)
					break
				case '1':
					pressAndRelease(KeyEvent.VK_1)
					break
				case '2':
					pressAndRelease(KeyEvent.VK_2)
					break
				case '3':
					pressAndRelease(KeyEvent.VK_3)
					break
				case '4':
					pressAndRelease(KeyEvent.VK_4)
					break
				case '5':
					pressAndRelease(KeyEvent.VK_5)
					break
				case '6':
					pressAndRelease(KeyEvent.VK_6)
					break
				case '7':
					pressAndRelease(KeyEvent.VK_7)
					break
				case '8':
					pressAndRelease(KeyEvent.VK_8)
					break
				case '9':
					pressAndRelease(KeyEvent.VK_9)
					break
				case '/':
					pressAndRelease(KeyEvent.VK_DIVIDE)
					break
				default:
					KeywordUtil.markFailedAndStop(
							'Unsupported character in date value.\n' +
							'Character: ' +
							currentCharacter +
							'\nDate: ' +
							safeDateValue
							)

					return
			}

			Thread.sleep(100)
		}
	}


	private void pressAndRelease(
			Integer keyCode
	) {

		robot.keyPress(
				keyCode
				)

		robot.keyRelease(
				keyCode
				)
	}


	private void focusEmatchApplication() {

		List<WindowsTestObject> candidates = []

		candidates.add(
				buildXpathObject(
				"//*[contains(@Name,'eMatch') and " +
				"(@LocalizedControlType='window' or contains(@ControlType,'Window'))]"
				)
				)

		candidates.add(
				buildXpathObject(
				"//*[contains(@Name,'eMatch')]"
				)
				)

		for (WindowsTestObject candidate : candidates) {
			try {
				if (Windows.verifyElementPresent(
						candidate,
						2,
						FailureHandling.OPTIONAL
						)) {

					Windows.click(
							candidate,
							FailureHandling.OPTIONAL
							)

					Windows.delay(1)

					return
				}
			} catch (Throwable ignored) {
			}
		}

		addNote(
				'eMatch window was not focused by object. Continuing with current Windows session.'
				)
	}


	private void pressTabTimes(
			Integer times
	) {

		Integer safeTimes =
				times == null ||
				times <= 0
					? 1
					: times

		for (Integer index = 1;
			index <= safeTimes;
			index++) {

			robot.keyPress(
					KeyEvent.VK_TAB
					)

			robot.keyRelease(
					KeyEvent.VK_TAB
					)

			Thread.sleep(150)
		}
	}


	private void clearFocusedField() {

		robot.keyPress(
				KeyEvent.VK_CONTROL
				)

		robot.keyPress(
				KeyEvent.VK_A
				)

		robot.keyRelease(
				KeyEvent.VK_A
				)

		robot.keyRelease(
				KeyEvent.VK_CONTROL
				)

		Thread.sleep(200)

		robot.keyPress(
				KeyEvent.VK_BACK_SPACE
				)

		robot.keyRelease(
				KeyEvent.VK_BACK_SPACE
				)

		Thread.sleep(200)
	}


	private void pasteText(
			String text
	) {

		StringSelection selection =
				new StringSelection(
				text
				)

		Toolkit
				.getDefaultToolkit()
				.getSystemClipboard()
				.setContents(
				selection,
				null
				)

		robot.keyPress(
				KeyEvent.VK_CONTROL
				)

		robot.keyPress(
				KeyEvent.VK_V
				)

		robot.keyRelease(
				KeyEvent.VK_V
				)

		robot.keyRelease(
				KeyEvent.VK_CONTROL
				)

		Thread.sleep(300)
	}


	private void clickElementCenterByCoordinates(
			WindowsTestObject object
	) {

		def rect =
				Windows.getElementRect(
				object
				)

		Integer x =
				rect.getX() +
				Math.floor(
				rect.getWidth() / 2
				).intValue()

		Integer y =
				rect.getY() +
				Math.floor(
				getSafeHeight(rect) / 2
				).intValue()

		mouseClick(
				x,
				y
				)
	}


	private void mouseClick(
			Integer x,
			Integer y
	) {

		robot.mouseMove(
				x,
				y
				)

		Thread.sleep(100)

		robot.mousePress(
				InputEvent.BUTTON1_DOWN_MASK
				)

		Thread.sleep(100)

		robot.mouseRelease(
				InputEvent.BUTTON1_DOWN_MASK
				)

		Thread.sleep(200)
	}


	private Integer getSafeHeight(
			def rect
	) {

		Integer height =
				rect.getHeight()

		if (height <= 0) {
			return 20
		}

		return height
	}


	private WindowsTestObject buildXpathObject(
			String xpath
	) {

		WindowsTestObject object =
				new WindowsTestObject()

		object.setLocatorStrategy(
				LocatorStrategy.XPATH
				)

		object.setLocator(
				xpath
				)

		return object
	}


	private void addNote(
			String message
	) {

		try {
			new jiraIntegration.JiraReportSteps()
				.note(
				message
				)
		} catch (Throwable ignored) {
			KeywordUtil.logInfo(
					message
					)
		}
	}
