	String readLastRunPath() {
		File file = new File(RunConfiguration.projectDir + File.separator + 'LastRun.xlsx')
		if (!file.exists()) {
			return ''
		}

		FileInputStream fis = null
		XSSFWorkbook wb = null

		try {
			fis = new FileInputStream(file)
			wb = new XSSFWorkbook(fis)
			XSSFSheet sheet = wb.getSheetAt(0)
			XSSFRow row = sheet.getRow(0)

			if (row == null || row.getCell(0) == null) {
				return ''
			}

			return row.getCell(0).stringCellValue
		} finally {
			if (wb != null) wb.close()
			if (fis != null) fis.close()
		}
	}

	String getResolvedReportPath() {
		String current = RunConfiguration.getReportFolder()
		if (!isBlank(current) && new File(current).exists()) {
			return current
		}

		String lastRun = readLastRunPath()
		if (!isBlank(lastRun) && new File(lastRun).exists()) {
			return lastRun
		}

		return ''
	}

