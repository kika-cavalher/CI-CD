@echo off
setlocal EnableExtensions EnableDelayedExpansion

REM ============================================================
REM Katalon Browser Toggle Runner
REM Purpose:
REM   - ONLY toggles: visible Chrome vs headless Chrome
REM   - Test suites / collections MUST come from Jenkins (KATALON_ARGS)
REM Required env vars (set by Jenkins):
REM   - KATALON_HOME   (folder that contains katalonc.exe)
REM   - KATALON_ARGS   (all args except browser/headless)
REM Optional env var:
REM   - SHOW_BROWSER   (true/false). Default: false
REM ============================================================

if "%KATALON_HOME%"=="" (
  echo [bat] ERROR: KATALON_HOME is empty.
  exit /b 2
)

if not exist "%KATALON_HOME%\katalonc.exe" (
  echo [bat] ERROR: katalonc.exe not found at: "%KATALON_HOME%\katalonc.exe"
  exit /b 3
)

if "%KATALON_ARGS%"=="" (
  echo [bat] ERROR: KATALON_ARGS is empty.
  exit /b 4
)

set "SHOW=%SHOW_BROWSER%"
if "%SHOW%"=="" set "SHOW=false"

REM Choose browser mode based on SHOW_BROWSER
set "BROWSER_ARGS=-browserType=""Chrome (headless)"""

if /I "%SHOW%"=="true" (
  set "BROWSER_ARGS=-browserType=""Chrome"" -noHeadless"
)

echo [bat] SHOW_BROWSER=%SHOW%
echo [bat] KATALON_HOME=%KATALON_HOME%
echo [bat] BROWSER_ARGS=%BROWSER_ARGS%
echo [bat] Running katalonc...

"%KATALON_HOME%\katalonc.exe" -noSplash -runMode=console %KATALON_ARGS% %BROWSER_ARGS%
exit /b %ERRORLEVEL%
