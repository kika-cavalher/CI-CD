	private File findExecutionLog(File reportDir) {
		File exact = new File(reportDir, 'execution0.log')
		if (exact.exists() && exact.isFile()) {
			return exact
		}

		List<File> candidates = []
		File[] files = reportDir.listFiles()

		if (files != null) {
			files.each { File file ->
				if (file != null &&
						file.isFile() &&
						file.name.toLowerCase(Locale.ENGLISH).startsWith('execution') &&
						file.name.toLowerCase(Locale.ENGLISH).endsWith('.log')) {
					candidates << file
				}
			}
		}

		if (candidates.isEmpty()) {
			return null
		}

		candidates.sort { File a, File b -> a.lastModified() <=> b.lastModified() }
		return candidates.last()
	}

