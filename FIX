import com.kms.katalon.core.util.KeywordUtil


// ======================================================
// VALIDATION CONFIG
// ======================================================

// Montant ccy is the 11th Excel column.
// Apache POI and the comparison keyword use zero-based indexes.
Integer expectedColumnIndex = 10
String expectedColumnName = 'Montant ccy'

String validationName = 'PNL Comptable Matisse Brut'

String exportRootFolder = 'C:\\KatalonExports'
String exportGroupFolder = 'PNL_Comptable'
String exportFeatureFolder = 'Consultation_PNL_Comptable_Matisse_Brut'


// ======================================================
// TEST FLOW
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Start REC x PRD validation\n' +
	'Feature: ' +
	validationName +
	'\nValidations:\n' +
	'- Compare table row count\n' +
	'- Compare table headers\n' +
	'- Compare sum of Montant ccy\n' +
	'Expected Excel column: 11\n' +
	'Expected zero-based column index: ' +
	expectedColumnIndex +
	'\nExpected column name: ' +
	expectedColumnName +
	'\nExport root: ' +
	exportRootFolder +
	'\nExport folder: ' +
	exportGroupFolder +
	'\\' +
	exportFeatureFolder
)

Map result =
	CustomKeywords.
	'commands.RecPrdExportValidationKeywords.validateLatestRecPrdExportTreatBlankAsZero'(
		exportRootFolder,
		exportGroupFolder,
		exportFeatureFolder,
		expectedColumnIndex,
		expectedColumnName
	)

Boolean success =
	result != null &&
	result.success == true

String errors =
	result == null
		? '[ERROR] Validation keyword returned no result.'
		: safeText(
			result.errors
			)

String passedDetails =
	result == null
		? ''
		: safeText(
			result.passedDetails
			)

String resolvedColumnName =
	result == null
		? expectedColumnName
		: safeText(
			result.columnName
			)

if (resolvedColumnName.isEmpty()) {
	resolvedColumnName =
		expectedColumnName
}

String recFileName =
	result == null
		? 'NOT FOUND'
		: displayValue(
			result.recFileName
			)

String prdFileName =
	result == null
		? 'NOT FOUND'
		: displayValue(
			result.prdFileName
			)

String selectedFolderPath =
	result == null
		? 'NOT FOUND'
		: displayValue(
			result.selectedFolderPath
			)


// ======================================================
// REPORT SELECTED FILES
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	(success ? '[PASS] ' : '[FAIL] ') +
	'Files selected for validation\n' +
	'Folder: ' +
	selectedFolderPath +
	'\nREC file: ' +
	recFileName +
	'\nPRD file: ' +
	prdFileName
)


// ======================================================
// REPORT TABLE VALIDATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	(success ? '[PASS] ' : '[FAIL] ') +
	'Table validation result\n' +
	'Feature: ' +
	validationName +
	'\nREC rows: ' +
	displayValue(
		result?.recRows
		) +
	'\nPRD rows: ' +
	displayValue(
		result?.prdRows
		) +
	'\nREC headers: ' +
	displayValue(
		result?.recHeaders
		) +
	'\nPRD headers: ' +
	displayValue(
		result?.prdHeaders
		)
)


// ======================================================
// REPORT MONTANT CCY RESULT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	(success ? '[PASS] ' : '[FAIL] ') +
	'Montant ccy validation result\n' +
	'Feature: ' +
	validationName +
	'\nColumn: ' +
	resolvedColumnName +
	'\nExcel column: 11' +
	'\nZero-based column index: ' +
	expectedColumnIndex +
	'\nREC numeric values: ' +
	displayValue(
		result?.recNumericValues
		) +
	'\nPRD numeric values: ' +
	displayValue(
		result?.prdNumericValues
		) +
	'\nREC sum: ' +
	displayValue(
		result?.recSum
		) +
	'\nPRD sum: ' +
	displayValue(
		result?.prdSum
		) +
	'\nREC minimum: ' +
	displayValue(
		result?.recMinimum
		) +
	'\nPRD minimum: ' +
	displayValue(
		result?.prdMinimum
		) +
	'\nREC maximum: ' +
	displayValue(
		result?.recMaximum
		) +
	'\nPRD maximum: ' +
	displayValue(
		result?.prdMaximum
		)
)


// ======================================================
// FINAL RESULT
// ======================================================

if (!success) {

	String finalErrorMessage =
		errors.isEmpty()
			? 'REC x PRD validation returned an unsuccessful result.'
			: errors

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[FAIL] Final validation result\n' +
		finalErrorMessage +
		(
			passedDetails.isEmpty()
				? ''
				: '\n\nSuccessful validations\n' +
					passedDetails
		)
	)

	KeywordUtil.markFailed(
		'REC x PRD validation failed for ' +
		validationName +
		'.\n' +
		finalErrorMessage
	)

} else {

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[PASS] Final validation result\n' +
		'REC x PRD validation completed successfully.\n' +
		passedDetails
	)

	KeywordUtil.markPassed(
		'REC x PRD validation completed successfully for ' +
		validationName +
		'.'
	)
}


// ======================================================
// HELPERS
// ======================================================

String displayValue(
		Object value
) {

	String text =
		safeText(
			value
			)

	return text.isEmpty()
		? 'NOT AVAILABLE'
		: text
}


String safeText(
		Object value
) {

	if (value == null) {
		return ''
	}

	return value
		.toString()
		.trim()
}
