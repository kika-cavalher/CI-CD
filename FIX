	// ============================================================
	// INTERNAL HELPERS
	// ============================================================
	private String safe(def value) {
		return owner.safe(value)
	}

	private boolean isBlank(def value) {
		return owner.isBlank(value)
	}

	String resolveEpicFieldId() {
		if (!isBlank(cachedEpicFieldId)) {
			return cachedEpicFieldId
		}

		if (!isBlank(owner.EPIC_FIELD_ID)) {
			cachedEpicFieldId = safe(owner.EPIC_FIELD_ID)
			KeywordUtil.logInfo("Using configured Epic field id: ${cachedEpicFieldId}")
			return cachedEpicFieldId
		}

		if (owner.SKIP_EPIC_LINK_IF_FIELD_NOT_AVAILABLE) {
			KeywordUtil.logInfo('Epic field auto resolution skipped by configuration.')
			return ''
		}

		try {
			RequestObject request = new RequestObject('Runtime Get Jira Fields')
			request.setRestUrl(owner.JIRA_BASE_URL + '/rest/api/2/field')
			request.setRestRequestMethod('GET')
			request.setHttpHeaderProperties(defaultGetHeaders())

			ResponseObject response = WS.sendRequest(request)
			int status = response.getStatusCode()
			String body = safeBody(response)

			KeywordUtil.logInfo("Get Jira Fields status: ${status}")

			if (status != 200) {
				KeywordUtil.logInfo("Epic field resolution skipped. Status: ${status}")
				return ''
			}

			def parsed = parseJson(body)
			if (!(parsed instanceof List)) {
				KeywordUtil.logInfo('Epic field resolution skipped. Response is not a list.')
				return ''
			}

			def epicField = parsed.find { field ->
				String fieldName = safe(field?.name)
				String customKey = safe(field?.schema?.custom)

				return owner.normalizeTitle(fieldName) == 'epic link' ||
					   customKey == 'com.pyxis.greenhopper.jira:gh-epic-link'
			}

			cachedEpicFieldId = safe(epicField?.id)

			if (isBlank(cachedEpicFieldId)) {
				KeywordUtil.logInfo('Epic field id not found.')
				return ''
			}

			KeywordUtil.logInfo("Resolved Epic field id: ${cachedEpicFieldId}")
			return cachedEpicFieldId
		} catch (Exception e) {
			KeywordUtil.logInfo("Epic field resolution skipped: ${e.message}")
			return ''
		}
	}

	private String resolveToken() {
		try {
			def direct = GlobalVariable.JIRA_TOKEN
			if (!isBlank(direct)) {
				return safe(direct)
			}
		} catch (Exception ignored) {
		}

		try {
			def fallback = GlobalVariable.token
			if (!isBlank(fallback)) {
				return safe(fallback)
			}
		} catch (Exception ignored) {
		}

		return safe(owner.JIRA_TOKEN)
	}

	private List<TestObjectProperty> defaultGetHeaders() {
		return [
			header('Authorization', 'Bearer ' + resolveToken()),
			header('Accept', 'application/json')
		]
	}

	private List<TestObjectProperty> jsonHeaders() {
		return [
			header('Authorization', 'Bearer ' + resolveToken()),
			header('Accept', 'application/json'),
			header('Content-Type', 'application/json')
		]
	}

	private TestObjectProperty header(String name, String value) {
		return new TestObjectProperty(name, ConditionType.EQUALS, value)
	}

	private HttpTextBodyContent jsonBody(Object payload) {
		String text = new JsonBuilder(payload).toString()
		return new HttpTextBodyContent(text, 'UTF-8', 'application/json')
	}

	private Object parseJson(String body) {
		if (isBlank(body)) {
			return [:]
		}

		try {
			return jsonSlurper.parseText(body)
		} catch (Exception ignored) {
			return [:]
		}
	}

	private String safeBody(ResponseObject response) {
		try {
			return safe(response?.getResponseBodyContent())
		} catch (Exception ignored) {
			return ''
		}
	}

	private String encode(String value) {
		return URLEncoder.encode(safe(value), StandardCharsets.UTF_8.toString())
	}
