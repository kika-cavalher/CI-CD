		sb.append(String.format(Locale.ENGLISH, '%.2f', width))
		sb.append('%; background:')
		sb.append(color)
		sb.append('"></div>')
		sb.append('</div>')
		sb.append('<div class="bar-foot">')
		sb.append(String.valueOf(total == 0 ? 0 : Math.round(width)))
		sb.append('% of execution')
		sb.append('</div>')
		sb.append('</div>')
		return sb.toString()
	}

	private String buildGeneratedLabel(Map model) {
		String raw = pickFirst(
				model.generatedAt,
				model.generatedLabel,
				model.createdAt,
				model.executionDate
				)

		if (!raw.isEmpty()) {
			return 'Generated ' + raw
		}

		return 'Generated ' + new SimpleDateFormat('dd/MM/yyyy HH:mm:ss').format(new Date())
	}

	private String resolveStepIcon(String detail, String status) {
		String lower = safeValue(detail).toLowerCase(Locale.ENGLISH)
		String normalizedStatus = safeValue(status).toLowerCase(Locale.ENGLISH)

		if (normalizedStatus == 'failed') {
			return '❌'
		}

		if (normalizedStatus == 'skipped') {
			return '⚠️'
		}

		if (normalizedStatus == 'blocked') {
			return '⛔'
		}

		if (lower.contains('environment')) {
			return '🌍'
		}

		if (lower.contains('authenticate') || lower.contains('login') || lower.contains('credential') || lower.contains('username') || lower.contains('password')) {
			return '🔐'
		}

		if (lower.contains('configure') || lower.contains('config') || lower.contains('parameter') || lower.contains('setting')) {
			return '🛠️'
		}

		if (lower.contains('export') || lower.contains('download')) {
			return '⬇️'
		}

		if (lower.contains('amount') || lower.contains('currency') || lower.contains('montant')) {
			return '🧮'
		}

		if (lower.contains('verify') || lower.contains('validate') || lower.contains('check') || lower.contains('comparison')) {
			return '🔎'
		}

		if (lower.contains('file') || lower.contains('folder')) {
			return '📄'
		}

		if (lower.contains('open') || lower.contains('navigate') || lower.contains('screen') || lower.contains('page') || lower.contains('menu')) {
			return '🌐'
		}

		if (lower.contains('click') || lower.contains('select') || lower.contains('choose') || lower.contains('tap')) {
			return '🖱️'
		}

		if (lower.contains('wait')) {
			return '⏳'
		}

		if (lower.contains('fill') || lower.contains('input') || lower.contains('type')) {
			return '⌨️'
		}

		if (lower.contains('close')) {
			return '🚪'
		}

		if (lower.contains('start')) {
			return '▶️'
		}

		return 'ℹ️'
	}

	private String shortScenarioName(String value) {
		String text = safeValue(value)
				.replace('\\', '/')
				.replaceAll('/+$', '')

		if (text.isEmpty()) {
			return ''
		}

		List<String> parts = text.tokenize('/')
				.collect { String part -> safeValue(part) }
				.findAll { String part -> !part.isEmpty() }

		if (parts.isEmpty()) {
			return text
		}

		return parts.last()
	}

	private String resolveStatusFromDetail(String detail) {
		String text = safeValue(detail)

		if (text.isEmpty()) {
			return ''
		}

		def matcher = text =~ '^\\s*\\[([^\\]]+)\\]'
		if (!matcher.find()) {
			return ''
		}

		String marker = safeValue(matcher.group(1)).toLowerCase(Locale.ENGLISH)

		if (marker in ['pass', 'passed', 'success']) {
			return 'passed'
		}

		if (marker in ['fail', 'failed', 'error']) {
			return 'failed'
		}

		if (marker in ['skip', 'skipped']) {
			return 'skipped'
		}

		if (marker == 'blocked') {
			return 'blocked'
		}

		if (marker == 'info') {
			return 'info'
		}

		return ''
	}

	private String cleanStepDetail(String detail) {
		String text = safeValue(detail)

		boolean changed = true
		while (changed) {
			String before = text

			text = text.replaceFirst('^\\s*[^A-Za-z0-9\\[]+\\s*', '')
			text = text.replaceFirst('^\\s*\\[(?i:PASS|PASSED|SUCCESS|FAIL|FAILED|ERROR|BLOCKED|SKIP|SKIPPED|INFO|START|END|CONFIG|FILES|FILE|STEP|EXPORT|VALIDATION)\\]\\s*', '')

			changed = before != text
		}

		return text.trim()
	}

	private String normalizeStatus(String raw) {
		String text = safeValue(raw).toLowerCase(Locale.ENGLISH)

		switch (text) {
			case 'pass':
			case 'passed':
			case 'success':
				return 'passed'
			case 'fail':
			case 'failed':
			case 'error':
				return 'failed'
			case 'skip':
			case 'skipped':
				return 'skipped'
			case 'blocked':
				return 'blocked'
			default:
				return 'info'
		}
	}

	private String statusLabel(String status) {
		switch (safeValue(status)) {
			case 'passed':
				return 'Passed'
			case 'failed':
				return 'Failed'
			case 'skipped':
				return 'Skipped'
			case 'blocked':
				return 'Blocked'
			default:
				return 'Info'
		}
	}

	private String resolveLogoHref(Map view) {
		String logoSrc = pickFirst(view.logoSrc, LOGO_SRC)

		if (logoSrc.toLowerCase(Locale.ENGLISH).startsWith('data:')) {
			return logoSrc
		}

		File logoFile = resolveFile(logoSrc, pickFirst(view.reportFolder))
		if (logoFile != null && logoFile.exists()) {
			return logoFile.toURI().toString()
		}

		return logoSrc
	}

	private File resolveFile(String path, String baseFolder) {
		String raw = safeValue(path)
		if (raw.isEmpty()) {
			return null
		}

		try {
			if (raw.toLowerCase(Locale.ENGLISH).startsWith('file:/')) {
				File uriFile = new File(new URI(raw))
				if (uriFile.exists()) {
					return uriFile
				}
			}
		} catch (Exception ignored) {
		}

		File direct = new File(raw)
		if (direct.exists()) {
			return direct
		}

		if (!safeValue(baseFolder).isEmpty()) {
			File byBase = new File(baseFolder, raw)
			if (byBase.exists()) {
				return byBase
			}
		}

		return direct
	}

	private boolean isImageFile(String fileName) {
		String lower = safeValue(fileName).toLowerCase(Locale.ENGLISH)
		return lower.endsWith('.png') ||
				lower.endsWith('.jpg') ||
				lower.endsWith('.jpeg') ||
				lower.endsWith('.gif') ||
				lower.endsWith('.webp') ||
				lower.endsWith('.bmp')
	}

	private List asList(def value) {
		if (value == null) {
			return []
		}

		if (value instanceof Collection) {
			return new ArrayList(value as Collection)
		}

		if (value.getClass().isArray()) {
			return (value as Object[]).toList()
		}

		return [value]
	}

	private double percent(int value, int total) {
		if (total <= 0) {
			return 0d
		}
		return ((double) value / (double) total) * 100d
	}

	private String shorten(String text, int max) {
		String value = safeValue(text)
		if (value.length() <= max) {
			return value
		}
		return value.substring(0, Math.max(0, max - 3)) + '...'
	}

	private String safeValue(def value) {
		return value == null ? '' : String.valueOf(value).trim()
	}

	private String pickFirst(Object... values) {
		if (values == null) {
			return ''
		}

		for (Object value : values) {
			String text = safeValue(value)
			if (!text.isEmpty()) {
				return text
			}
		}

		return ''
	}

	private String htmlEscape(def value) {
		String text = safeValue(value)
		return text
				.replace('&', '&amp;')
				.replace('<', '&lt;')
				.replace('>', '&gt;')
				.replace('"', '&quot;')
				.replace("'", '&#39;')
	}

	private String jsEscape(def value) {
		String text = safeValue(value)
		return text
				.replace('\\', '\\\\')
				.replace("'", "\\'")
				.replace('\r', '')
				.replace('\n', '\\n')
	}

