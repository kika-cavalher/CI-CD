    color: #15212b;
}
.donut-label {
    font-size: 14px;
    color: #708091;
}
.legend-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}
.legend-line {
    display: grid;
    grid-template-columns: 12px 1fr auto;
    gap: 10px;
    align-items: center;
    font-size: 13px;
    color: #1f2b37;
}
.legend-dot {
    width: 10px;
