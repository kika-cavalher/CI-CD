	@Keyword
	String validateExcelFilesFound(
			String filesToValidate) {

		StringBuilder errors =
			new StringBuilder()

		List<File> files =
			parseFiles(filesToValidate)

		if (files.isEmpty()) {

			errors.append(
				'[ERROR] No Excel files found to validate.\n'
			)
		}

		for (File file : files) {

			if (!file.exists()) {

				errors.append(
					'[ERROR] File not found: '
				)
				.append(file.getAbsolutePath())
				.append('\n')

			} else if (!file.isFile()) {

				errors.append(
					'[ERROR] Path is not a file: '
				)
				.append(file.getAbsolutePath())
				.append('\n')

			} else if (!isExcelFile(file.getName())) {

				errors.append(
					'[ERROR] File is not Excel: '
				)
				.append(file.getAbsolutePath())
				.append('\n')
			}
		}

		return errors.toString()
	}


	@Keyword
	String validateMinimumExpectedFileQuantity(
			String filesToValidate,
			String minimumExpectedFilesText) {

		int minimumExpectedFiles =
			parseIntOrZero(
				minimumExpectedFilesText
			)

		if (minimumExpectedFiles <= 0) {

			return '[SKIPPED] Minimum expected file quantity was not configured.'
		}

		StringBuilder errors =
			new StringBuilder()

		List<File> files =
			parseFiles(filesToValidate)

		KeywordUtil.logInfo(
			'📄 [FILE COUNT] found=' +
			files.size() +
			' | minimumExpected=' +
			minimumExpectedFiles
		)

		if (files.size() < minimumExpectedFiles) {

			errors.append(
				'[ERROR] Expected at least '
			)
			.append(minimumExpectedFiles)
			.append(
				' Excel files, but found '
			)
			.append(files.size())
			.append('.\n')
		}

		return errors.toString()
	}


