String buildGaiaReport() {
	String xmlPath = getXmlFilePath()
	if (isBlank(xmlPath)) {
		KeywordUtil.logInfo('Gaia report was not created because XML file was not found.')
		return ''
	}

	String reportPath = getResolvedReportPath()
	if (isBlank(reportPath)) {
		KeywordUtil.logInfo('Gaia report was not created because report folder was not found.')
		return ''
	}

	Map suiteData = parseSuiteData(xmlPath)
	String html = buildGaiaReportHtml(suiteData)

	File gaiaReportFile = new File(reportPath + File.separator + GAIA_REPORT_FILE_NAME)
	gaiaReportFile.withWriter('UTF-8') { writer ->
		writer.write(html)
	}

	if (!waitUntilFileReady(gaiaReportFile.absolutePath, 12, 500)) {
		KeywordUtil.logInfo("Gaia report file still looks busy after creation: ${gaiaReportFile.absolutePath}")
	}

	KeywordUtil.logInfo("Gaia report created: ${gaiaReportFile.absolutePath}")
	return gaiaReportFile.absolutePath
}

String zipReports() {
	String reportPath = getResolvedReportPath()
	if (isBlank(reportPath)) {
		return ''
	}

	String zippedFile = reportPath + File.separator + RESULTS_ZIP_FILE_NAME

	new File(zippedFile).delete()

	ZipOutputStream output = new ZipOutputStream(new FileOutputStream(zippedFile))
	try {
		new File(reportPath).eachFile { File file ->
			if (!file.isFile()) return
			if (file.name.equalsIgnoreCase(RESULTS_ZIP_FILE_NAME)) return
			if (file.name.equalsIgnoreCase(EVIDENCE_ZIP_FILE_NAME)) return

			output.putNextEntry(new ZipEntry(file.name))
			FileInputStream input = new FileInputStream(file)

			try {
				byte[] buffer = new byte[4096]
				int read
				while ((read = input.read(buffer)) != -1) {
					output.write(buffer, 0, read)
				}
			} finally {
				input.close()
			}

			output.closeEntry()
		}
	} finally {
		output.close()
	}

	waitUntilFileReady(zippedFile, 12, 500)
	return zippedFile
}

String zipEvidences() {
	String reportPath = getResolvedReportPath()
	if (isBlank(reportPath)) {
		return ''
	}

	String evidencePath = reportPath + File.separator + EVIDENCE_FOLDER_NAME
	File evidenceFolder = new File(evidencePath)

	if (!evidenceFolder.exists()) {
		return ''
	}

	String zippedFile = evidencePath + File.separator + EVIDENCE_ZIP_FILE_NAME

	new File(zippedFile).delete()

	ZipOutputStream output = new ZipOutputStream(new FileOutputStream(zippedFile))
	try {
		evidenceFolder.eachFileRecurse(FileType.FILES) { File file ->
			if (file.name.equalsIgnoreCase(EVIDENCE_ZIP_FILE_NAME)) return

			String relativeName = evidenceFolder.toPath().relativize(file.toPath()).toString().replace('\\', '/')
			output.putNextEntry(new ZipEntry(relativeName))

			FileInputStream input = new FileInputStream(file)
			try {
				byte[] buffer = new byte[4096]
				int read
				while ((read = input.read(buffer)) != -1) {
					output.write(buffer, 0, read)
				}
			} finally {
				input.close()
			}

			output.closeEntry()
		}
	} finally {
		output.close()
	}

	waitUntilFileReady(zippedFile, 12, 500)
	return zippedFile
}

int uploadAttachment(String issueKey, String filePath) {
	if (isBlank(filePath)) {
		return 0
	}

	File originalFile = new File(filePath)
	if (!originalFile.exists() || originalFile.length() == 0) {
		KeywordUtil.logInfo("Skipping attachment upload because file is missing or empty: ${filePath}")
		return 0
	}

	if (!waitUntilFileReady(originalFile.absolutePath, 12, 500)) {
		KeywordUtil.logInfo("File still locked before upload, creating safe copy: ${originalFile.absolutePath}")
	}

	String safeUploadPath = createSafeUploadCopy(originalFile.absolutePath, originalFile.name)
	if (isBlank(safeUploadPath)) {
		KeywordUtil.logInfo("Could not create safe upload copy for: ${originalFile.absolutePath}")
		return 0
	}

	File safeUploadFile = new File(safeUploadPath)

	def response = WS.sendRequest(findTestObject('Jira Integration/Evidence attachment', [
		('token')     : JIRA_TOKEN,
		('evidences') : safeUploadFile,
		('execID')    : issueKey
	]))

	int status = WS.getResponseStatusCode(response)
	KeywordUtil.logInfo("Upload attachment status: ${status}")
	KeywordUtil.logInfo("Upload attachment response: ${response.getResponseBodyContent()}")

	return status
}


