class MenuNavigator {

	private ImageLoader imageLoader = new ImageLoader()

	@Keyword
	boolean searchAndOpenMenu(String menuName, String imageGroup, int timeoutSeconds) {
		return searchAndOpenMenu(menuName, imageGroup, '', timeoutSeconds)
	}

	@Keyword
	boolean searchAndOpenMenu(String menuName, String imageGroup, String expectedObjectPath, int timeoutSeconds) {
		int effectiveTimeout = timeoutSeconds <= 0 ? 20 : timeoutSeconds
		int maxAttempts = 3

		KeywordUtil.logInfo(
				'Searching and opening menu.\n' +
				'Menu name: ' + menuName + '\n' +
				'Image group: ' + imageGroup + '\n' +
				'Expected object path: ' + expectedObjectPath + '\n' +
				'Timeout per attempt: ' + effectiveTimeout + ' seconds\n' +
				'Max attempts: ' + maxAttempts
				)

		imageLoader.validateGroupImagesExist(imageGroup)

		Map<String, String> images = imageLoader.getImages(imageGroup)

		if (!images.containsKey('menuImage')) {
			KeywordUtil.markFailedAndStop(
					'Image group does not contain required key menuImage.\n' +
					'Image group: ' + imageGroup + '\n' +
					'Available keys: ' + images.keySet()
					)
		}

		String menuImagePath = images['menuImage']
		String openedTabImagePath = images.containsKey('openedTab') ? images['openedTab'] : ''

		WindowsTestObject searchBox = resolveSearchBox()

		for (int attempt = 1; attempt <= maxAttempts; attempt++) {
			KeywordUtil.logInfo('Starting menu open attempt ' + attempt + ' of ' + maxAttempts + '.')

			clickElementCenterByCoordinates(searchBox)
			Windows.delay(1)

			clearFocusedField()
			pasteText(menuName)
			Windows.delay(2)

			boolean openedByObject = tryOpenByObject(expectedObjectPath, openedTabImagePath)

			if (openedByObject) {
				KeywordUtil.logInfo('Menu opened successfully by Object Repository.')
				return true
			}

			boolean openedByImage = tryOpenByImage(menuImagePath, expectedObjectPath, openedTabImagePath, effectiveTimeout)

			if (openedByImage) {
				KeywordUtil.logInfo('Menu opened successfully by image.')
				return true
			}

			KeywordUtil.logInfo(
					'Attempt finished and menu is still not open.\n' +
					'Attempt: ' + attempt + '/' + maxAttempts
					)
		}

		takeEvidence('MenuNotOpened.png')

		KeywordUtil.markFailedAndStop(
				'Menu was not opened after maximum retry attempts.\n' +
				'Menu name: ' + menuName + '\n' +
				'Image group: ' + imageGroup + '\n' +
				'Menu image path: ' + menuImagePath + '\n' +
				'Opened tab image path: ' + openedTabImagePath + '\n' +
				'Expected object path: ' + expectedObjectPath + '\n' +
				'Attempts: ' + maxAttempts
				)

		return false
	}

	private boolean tryOpenByObject(String expectedObjectPath, String openedTabImagePath) {
		if (expectedObjectPath == null || expectedObjectPath.trim().isEmpty()) {
			KeywordUtil.logInfo('Expected object path not provided. Skipping Object Repository click.')
			return false
		}

		String cleanPath = expectedObjectPath
				.replace('Object Repository/', '')
				.replace('Object Repository\\', '')

		try {
			WindowsTestObject targetObject = findWindowsObject(cleanPath)

			boolean isPresent = Windows.verifyElementPresent(
					targetObject,
					3,
					FailureHandling.OPTIONAL
					)

			if (!isPresent) {
				KeywordUtil.logInfo('Expected object was not visible for click: ' + cleanPath)
				return false
			}

			KeywordUtil.logInfo('Expected object found. Trying normal click: ' + cleanPath)

			try {
				Windows.click(targetObject)
			} catch (Exception clickError) {
				KeywordUtil.logInfo('Normal object click failed. Trying coordinate click. Reason: ' + clickError.getMessage())
				clickElementCenterByCoordinates(targetObject)
			}

			Windows.delay(3)

			if (isMenuOpened(expectedObjectPath, openedTabImagePath, 8)) {
				return true
			}

			KeywordUtil.logInfo('Object click executed, but menu is still not open.')
			return false
		} catch (Exception e) {
			KeywordUtil.logInfo(
					'Object Repository click failed.\n' +
					'Object: ' + cleanPath + '\n' +
					'Reason: ' + e.getMessage()
					)
			return false
		}
	}

	private boolean tryOpenByImage(String menuImagePath, String expectedObjectPath, String openedTabImagePath, int timeoutSeconds) {
		int elapsedSeconds = 0

		while (elapsedSeconds < timeoutSeconds) {
			try {
				def imageFound = WindowsImageKeywords.findImage(menuImagePath)

				if (imageFound != null && imageFound != false) {
					KeywordUtil.logInfo(
							'Menu image found.\n' +
							'Image path: ' + menuImagePath + '\n' +
							'Elapsed seconds: ' + elapsedSeconds
							)

					try {
						WindowsImageKeywords.clickImage(menuImagePath)
						KeywordUtil.logInfo('clickImage executed on menu image.')
						Windows.delay(3)

						if (isMenuOpened(expectedObjectPath, openedTabImagePath, 8)) {
							return true
						}
					} catch (Exception clickError) {
						KeywordUtil.logInfo('clickImage failed. Reason: ' + clickError.getMessage())
					}

					try {
						WindowsImageKeywords.doubleClickImage(menuImagePath)
						KeywordUtil.logInfo('doubleClickImage executed on menu image.')
						Windows.delay(4)

						if (isMenuOpened(expectedObjectPath, openedTabImagePath, 10)) {
							return true
						}
					} catch (Exception doubleClickError) {
						KeywordUtil.logInfo('doubleClickImage failed. Reason: ' + doubleClickError.getMessage())
					}

					return false
				}
			} catch (Exception imageError) {
				KeywordUtil.logInfo(
						'Image search attempt failed.\n' +
						'Reason: ' + imageError.getMessage()
						)
			}

			Windows.delay(1)
			elapsedSeconds = elapsedSeconds + 1
		}

		KeywordUtil.logInfo('Menu image was not visible before timeout: ' + menuImagePath)
		return false
	}

	private boolean isMenuOpened(String expectedObjectPath, String openedTabImagePath, int timeoutSeconds) {
		int elapsedSeconds = 0

		while (elapsedSeconds < timeoutSeconds) {
			if (openedTabImagePath != null && !openedTabImagePath.trim().isEmpty()) {
				try {
					def openedTabFound = WindowsImageKeywords.findImage(openedTabImagePath)

					if (openedTabFound != null && openedTabFound != false) {
						KeywordUtil.logInfo('Opened tab image is visible: ' + openedTabImagePath)
						return true
					}
				} catch (Exception ignored) {
				}
			}

			if (expectedObjectPath != null && !expectedObjectPath.trim().isEmpty()) {
				String cleanPath = expectedObjectPath
						.replace('Object Repository/', '')
						.replace('Object Repository\\', '')

				try {
					boolean isPresent = Windows.verifyElementPresent(
							findWindowsObject(cleanPath),
							1,
							FailureHandling.OPTIONAL
							)

					if (isPresent) {
						KeywordUtil.logInfo('Expected object is visible: ' + cleanPath)
						return true
					}
				} catch (Exception ignored) {
				}
			}

			Windows.delay(1)
			elapsedSeconds = elapsedSeconds + 1
		}

		return false
	}

	private WindowsTestObject resolveSearchBox() {
		List<WindowsTestObject> candidates = []

		try {
			candidates.add(findWindowsObject('General/txtSearch'))
		} catch (Exception ignored) {
		}

		candidates.add(buildXpathObject("//*[contains(@Name,'Type keywords here')]"))
		candidates.add(buildXpathObject("//*[contains(@Name,'Type keywords')]"))
		candidates.add(buildXpathObject("//*[@LocalizedControlType='combo box' and contains(@Name,'Type')]"))
		candidates.add(buildXpathObject("//*[@LocalizedControlType='edit' and contains(@Name,'Type')]"))
		candidates.add(buildXpathObject("//*[contains(@ClassName,'ComboBox') and contains(@Name,'Type')]"))

		for (WindowsTestObject candidate : candidates) {
			try {
				boolean isPresent = Windows.verifyElementPresent(
						candidate,
						2,
						FailureHandling.OPTIONAL
						)

				if (isPresent) {
					KeywordUtil.logInfo('Search field found.')
					return candidate
				}
			} catch (Exception ignored) {
			}
		}

		takeEvidence('SearchFieldNotFound.png')

		KeywordUtil.markFailedAndStop(
				'Search field was not found.\n' +
				'Tried Object Repository: General/txtSearch\n' +
				'Tried fallback XPath candidates.'
				)

		return null
	}

	private WindowsTestObject buildXpathObject(String xpath) {
		WindowsTestObject object = new WindowsTestObject()
		object.setLocatorStrategy(LocatorStrategy.XPATH)
		object.setLocator(xpath)
		return object
	}

	private void clickElementCenterByCoordinates(WindowsTestObject object) {
		def rect = Windows.getElementRect(object)

		int x = rect.getX() + Math.floor(rect.getWidth() / 2).intValue()
		int y = rect.getY() + Math.floor(getSafeHeight(rect) / 2).intValue()

		mouseClick(x, y)
	}

	private void clearFocusedField() {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_CONTROL)

		Windows.delay(1)

		robot.keyPress(KeyEvent.VK_BACK_SPACE)
		robot.keyRelease(KeyEvent.VK_BACK_SPACE)
	}

	private void pasteText(String text) {
		StringSelection selection = new StringSelection(text)
		Toolkit.getDefaultToolkit().getSystemClipboard().setContents(selection, null)

		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_V)
		robot.keyRelease(KeyEvent.VK_V)
		robot.keyRelease(KeyEvent.VK_CONTROL)

		Windows.delay(1)
	}

	private void mouseClick(int x, int y) {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.mouseMove(x, y)
		Thread.sleep(150)

		robot.mousePress(InputEvent.BUTTON1_DOWN_MASK)
		Thread.sleep(150)
		robot.mouseRelease(InputEvent.BUTTON1_DOWN_MASK)

		Thread.sleep(300)
	}

	private int getSafeHeight(def rect) {
		int height = rect.getHeight()

		if (height <= 0) {
			return 20
		}

		return height
	}

	private void takeEvidence(String fileName) {
		try {
			String evidenceDir = RunConfiguration.getReportFolder() + '\\Evidences\\'
			new File(evidenceDir).mkdirs()

			WindowsActionHelper
					.create(WindowsDriverFactory.getWindowsSession())
					.takeScreenshot(evidenceDir + fileName)

			KeywordUtil.logInfo('Evidence captured: ' + evidenceDir + fileName)
		} catch (Exception e) {
			KeywordUtil.logInfo('Could not capture evidence: ' + e.getMessage())
		}
	}
}









package pageObject

import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import java.awt.Dimension
import java.awt.MouseInfo
import java.awt.Point
import java.awt.Robot
import java.awt.Toolkit
import java.awt.event.InputEvent
import java.awt.event.KeyEvent

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import commands.DimensionsNavigator
import commands.ExportFile
import commands.ImageLoader
import commands.MenuNavigator

class ModuleDesResponsabiliteKeywords {

	private static final String MENU_NAME = 'cube balance des responsabilités'
	private static final String MENU_IMAGE_GROUP = 'ModuleDesResponsabilite'
	private static final String EXPECTED_TAB = 'BDR/BalanceDesResponsabilitesTab'
	private static final String EXPORT_LABEL = 'ExportExpandedTable'

	private ImageLoader imageLoader = new ImageLoader()
	private MenuNavigator menuNavigator = new MenuNavigator()
	private DimensionsNavigator dimensionsNavigator = new DimensionsNavigator()
	private ExportFile exportFile = new ExportFile()

	@Keyword
	String getMenuName() {
		return MENU_NAME
	}

	@Keyword
	String getExportLabel() {
		return EXPORT_LABEL
	}

	@Keyword
	String getDimensionsImageGroup() {
		return MENU_IMAGE_GROUP
	}

	@Keyword
	void openMenu(Integer timeoutSeconds) {
		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 60 : timeoutSeconds

		menuNavigator.searchAndOpenMenu(
				MENU_NAME,
				MENU_IMAGE_GROUP,
				EXPECTED_TAB,
				safeTimeout
				)
	}

	@Keyword
	void validateOpenedMenu(Integer timeoutSeconds) {
		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 60 : timeoutSeconds

		boolean tabPresent = false

		try {
			tabPresent = Windows.verifyElementPresent(
					findWindowsObject(EXPECTED_TAB),
					safeTimeout,
					FailureHandling.OPTIONAL
					)
		} catch (Exception ignored) {
		}

		if (!tabPresent && !imageLoader.waitForImage(MENU_IMAGE_GROUP, 'openedTab', 5)) {
			imageLoader.takeEvidence('OpenedMenuNotValidated.png')

			KeywordUtil.markFailedAndStop(
					'Opened menu was not validated.\n' +
					'Menu: ' + MENU_NAME + '\n' +
					'Expected tab object: ' + EXPECTED_TAB
					)
		}

		KeywordUtil.logInfo('Opened menu validated successfully: ' + MENU_NAME)
	}


	@Keyword
	void validateDimensionsImagesExist(String imageGroup) {
		dimensionsNavigator.validateDimensionsImagesExist(imageGroup)
	}

	@Keyword
	void validateMeasuresOpen(String imageGroup, Integer timeoutSeconds) {
		dimensionsNavigator.validateMeasuresOpen(imageGroup, timeoutSeconds)
	}

	@Keyword
	void clickFirstDimension(String imageGroup) {
		dimensionsNavigator.clickFirstDimension(imageGroup)
	}

	@Keyword
	void openDimensionsUntilProvic(String imageGroup, Integer maxCycles) {
		dimensionsNavigator.openDimensionsUntilProvic(imageGroup, maxCycles)
	}

	@Keyword
	void validateProvicOpen(String imageGroup, Integer timeoutSeconds) {
		dimensionsNavigator.validateProvicOpen(imageGroup, timeoutSeconds)
	}

	@Keyword
	void validateLastDimension(String imageGroup, Integer timeoutSeconds) {
		dimensionsNavigator.validateLastDimension(imageGroup, timeoutSeconds)
	}

	@Keyword
	void scrollDimensionsToTop(String imageGroup) {
		dimensionsNavigator.scrollDimensionsToTop(imageGroup)
	}

	@Keyword
	void scrollDimensionsToTop(String imageGroup, Integer maxScrollMoves) {
		dimensionsNavigator.scrollDimensionsToTop(imageGroup, maxScrollMoves)
	}

	@Keyword
	void validateFirstPageReference(String imageGroup, Integer timeoutSeconds) {
		dimensionsNavigator.validateFirstPageReference(imageGroup, timeoutSeconds)
	}

	@Keyword
	void prepareExpandedTableForExport(String imageGroup) {
		imageLoader.validateGroupImagesExist(imageGroup)
		validateRequiredExportImageKeys(imageGroup)

		KeywordUtil.logInfo('Step 1. Validate Phase image on current screen.')
		imageLoader.waitForImageOrStop(imageGroup, 'phase', 15)

		KeywordUtil.logInfo('Step 2. Click Measures and capture target position.')
		imageLoader.clickImageOrStop(imageGroup, 'firstDimension')
		Windows.delay(1)
		Point measuresPoint = getCurrentMouseLocation()

		KeywordUtil.logInfo(
				'Measures position captured.\n' +
				'X: ' + measuresPoint.x + '\n' +
				'Y: ' + measuresPoint.y
				)

		KeywordUtil.logInfo('Step 3. Click Phase.')
		imageLoader.clickImageOrStop(imageGroup, 'phase')
		Windows.delay(1)

		KeywordUtil.logInfo('Step 4. Press DOWN 3 times from Phase.')
		pressDownTimes(3)

		KeywordUtil.logInfo('Step 5. Validate moisDArrete becomes visible.')
		imageLoader.waitForImageOrStop(imageGroup, 'moisDArrete', 15)

		KeywordUtil.logInfo('Step 6. Click moisDArrete and capture source position.')
		imageLoader.clickImageOrStop(imageGroup, 'moisDArrete')
		Windows.delay(1)
		Point moisDArretePoint = getCurrentMouseLocation()

		KeywordUtil.logInfo(
				'Mois d arrete position captured.\n' +
				'X: ' + moisDArretePoint.x + '\n' +
				'Y: ' + moisDArretePoint.y
				)

		KeywordUtil.logInfo('Step 7. Drag moisDArrete to Measures.')
		dragAndDrop(moisDArretePoint.x, moisDArretePoint.y, measuresPoint.x, measuresPoint.y)
		Windows.delay(3)

		KeywordUtil.logInfo('Step 8. Scroll to the end and validate moisDArrete in list.')
		validateMoisDArreteInListAfterDrag(imageGroup, measuresPoint)
	}


	private void validateRequiredExportImageKeys(String imageGroup) {
		Map<String, String> images = imageLoader.getImages(imageGroup)

		List<String> requiredKeys = [
			'phase',
			'firstDimension',
			'moisDArrete',
			'moisDArreteInList'
		]

		List<String> missingKeys = []

		requiredKeys.each { String key ->
			if (!images.containsKey(key)) {
				missingKeys.add(key)
			}
		}

		if (!missingKeys.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Export image group is missing required keys.\n' +
					'Image group: ' + imageGroup + '\n' +
					'Missing keys: ' + missingKeys.join(', ')
					)
		}
	}

	private void validateMoisDArreteInListAfterDrag(String imageGroup, Point measuresPoint) {
		scrollCurrentPageToBottom(35)

		if (imageLoader.waitForImage(imageGroup, 'moisDArreteInList', 10)) {
			KeywordUtil.logInfo('moisDArreteInList image found after page scroll.')
			return
		}

		KeywordUtil.logInfo(
				'moisDArreteInList was not found after page scroll.\n' +
				'Focusing Measures position and navigating down with keyboard.'
				)

		clickAt(measuresPoint.x, measuresPoint.y)
		pressDownTimes(80)
		Windows.delay(1)

		if (imageLoader.waitForImage(imageGroup, 'moisDArreteInList', 15)) {
			KeywordUtil.logInfo('moisDArreteInList image found after keyboard DOWN navigation.')
			return
		}

		imageLoader.takeEvidence('MoisDArreteInListNotFound.png')

		KeywordUtil.markFailedAndStop(
				'Could not validate moisDArrete in the expanded list after drag and drop.\n' +
				'Image group: ' + imageGroup + '\n' +
				'Expected image: moisDArreteInList'
				)
	}

	private void pressDownTimes(int count) {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		for (int i = 0; i < count; i++) {
			robot.keyPress(KeyEvent.VK_DOWN)
			robot.keyRelease(KeyEvent.VK_DOWN)
		}
	}

	private Point getCurrentMouseLocation() {
		return MouseInfo.getPointerInfo().getLocation()
	}

	private void dragAndDrop(Number startXValue, Number startYValue, Number endXValue, Number endYValue) {
		int startX = startXValue.intValue()
		int startY = startYValue.intValue()
		int endX = endXValue.intValue()
		int endY = endYValue.intValue()

		Robot robot = new Robot()
		robot.setAutoDelay(120)

		robot.mouseMove(startX, startY)
		Windows.delay(1)

		robot.mousePress(InputEvent.BUTTON1_DOWN_MASK)
		Windows.delay(1)

		int steps = 20

		for (int i = 1; i <= steps; i++) {
			int currentX = startX + Math.floor((endX - startX) * i / steps).intValue()
			int currentY = startY + Math.floor((endY - startY) * i / steps).intValue()

			robot.mouseMove(currentX, currentY)
			Thread.sleep(60)
		}

		robot.mouseRelease(InputEvent.BUTTON1_DOWN_MASK)
		Windows.delay(2)
	}

	private void scrollCurrentPageToBottom(int maxMoves) {
		moveMouseToMainPageScrollArea()
		Windows.delay(1)

		for (int i = 0; i < maxMoves; i++) {
			scrollWheel(4)
			Windows.delay(1)
		}
	}

	private void moveMouseToMainPageScrollArea() {
		Dimension screenSize = Toolkit.getDefaultToolkit().getScreenSize()

		int x = Math.floor(screenSize.width * 0.78).intValue()
		int y = Math.floor(screenSize.height * 0.72).intValue()

		moveMouse(x, y)
	}

	private void moveMouse(int x, int y) {
		Robot robot = new Robot()
		robot.setAutoDelay(100)
		robot.mouseMove(x, y)
	}

	private void clickAt(Number xValue, Number yValue) {
		int x = xValue.intValue()
		int y = yValue.intValue()

		Robot robot = new Robot()
		robot.setAutoDelay(100)

		robot.mouseMove(x, y)
		Windows.delay(1)

		robot.mousePress(InputEvent.BUTTON1_DOWN_MASK)
		robot.mouseRelease(InputEvent.BUTTON1_DOWN_MASK)
	}

	private void scrollWheel(int amount) {
		Robot robot = new Robot()
		robot.setAutoDelay(100)
		robot.mouseWheel(amount)
	}
}

