package jiraIntegration

import java.io.File
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale
import java.net.URI

class JiraHtmlTemplateBuilder {

	private static final String APP_NAME = 'EMATCH'
	private static final String REPORT_TITLE_PREFIX = 'Test report - '

	/*
	 * Change only this variable if you want to change the logo.
	 */
	private static final String LOGO_SRC = 'Images/General/logo.png'

	private static final String BRAND_PURPLE = '#5a1ea6'
	private static final String STATUS_PASS = '#68b84b'
	private static final String STATUS_FAIL = '#e05b4d'
	private static final String STATUS_BLOCK = '#d7b436'
	private static final String STATUS_INFO = '#8c35ff'

	JiraHtmlTemplateBuilder() {
	}

	String build(Map model) {
		return buildHtml(model)
	}

	String render(Map model) {
		return buildHtml(model)
	}

	String buildHtml(Map model) {
		Map view = normalizeModel(model)

		StringBuilder html = new StringBuilder()

		html.append('<!DOCTYPE html>\n')
		html.append('<html lang="en">\n')
		html.append('<head>\n')
		html.append('<meta charset="UTF-8">\n')
		html.append('<meta name="viewport" content="width=device-width, initial-scale=1.0">\n')
		html.append('<title>')
		html.append(htmlEscape(view.reportTitle))
		html.append('</title>\n')
		html.append(buildStyles())
		html.append('</head>\n')
		html.append('<body>\n')

		html.append('<header class="top-banner">\n')
		html.append('  <div class="top-banner-left">\n')
		html.append('    <img class="brand-logo" src="')
		html.append(htmlEscape(resolveLogoHref(view)))
		html.append('" alt="EMATCH logo">\n')
		html.append('    <div class="brand-copy">\n')
		html.append('      <div class="banner-title">')
		html.append(htmlEscape(view.reportTitle))
		html.append('</div>\n')
		html.append('      <div class="banner-subtitle">EMATCH execution overview</div>\n')
		html.append('    </div>\n')
		html.append('  </div>\n')
		html.append('  <div class="top-banner-right">\n')
		html.append('    <div>')
		html.append(htmlEscape(view.generatedLabel))
		html.append('</div>\n')
		html.append('    <div>Project ')
		html.append(htmlEscape(APP_NAME))
		html.append('</div>\n')
		html.append('  </div>\n')
		html.append('</header>\n')

		html.append('<div class="page">\n')

		html.append('  <aside class="sidebar">\n')
		html.append('    <div class="sidebar-tabs">\n')
		html.append('      <button id="tab-tests" class="sidebar-tab active" type="button" onclick="showTab(\'tests\')">Tests</button>\n')
		html.append('      <button id="tab-charts" class="sidebar-tab" type="button" onclick="showTab(\'charts\')">Charts</button>\n')
		html.append('    </div>\n')

		html.append('    <div id="tests-sidebar-block">\n')
		html.append('      <div class="search-wrap">\n')
		html.append('        <input id="scenarioSearch" class="search-input" type="text" placeholder="Search test name or status." onkeyup="filterScenarios()">\n')
		html.append('      </div>\n')
		html.append('      <div id="scenarioList" class="scenario-list">\n')

		if (view.scenarios.isEmpty()) {
			html.append('<div class="empty-state">No scenarios were found for this execution.</div>')
		} else {
			view.scenarios.eachWithIndex { scenario, index ->
				html.append(buildScenarioListItem(scenario as Map, index == 0))
			}
		}

		html.append('      </div>\n')
		html.append('    </div>\n')

		html.append('    <div id="charts-sidebar-block" class="hidden">\n')
		html.append(buildChartsSidebar(view))
		html.append('    </div>\n')
		html.append('  </aside>\n')

		html.append('  <main class="content">\n')

		if (view.scenarios.isEmpty()) {
			html.append('<section class="scenario-panel active">')
			html.append('<div class="scenario-title">No execution data found</div>')
			html.append('</section>')
		} else {
			view.scenarios.eachWithIndex { scenario, index ->
				html.append(buildScenarioPanel(scenario as Map, view, index == 0))
			}
		}

		html.append(buildChartsPanel(view))
		html.append('  </main>\n')

		html.append('</div>\n')
		html.append(buildScripts())
		html.append('</body>\n')
		html.append('</html>\n')

		return html.toString()
	}

	private Map normalizeModel(Map model) {
		Map safeModel = model ?: [:]

		String suiteName = pickFirst(
				safeModel.suiteName,
				safeModel.testSuiteName,
				safeModel.suite,
				safeModel.executionName,
				safeModel.title,
				'Execution'
				)

		List<Map> scenarios = []
		asList(safeModel.scenarios).eachWithIndex { rawItem, index ->
			Map item = rawItem instanceof Map ? (rawItem as Map) : [name: safeValue(rawItem)]

			List<Map> normalizedEvidence = normalizeEvidence(item.evidence, safeModel)

			scenarios << [
				id            : pickFirst(item.id, "scenario-${index + 1}"),
				name          : pickFirst(item.name, item.scenarioName, item.title, "Scenario ${index + 1}"),
				summary       : pickFirst(item.summary, item.shortError, item.visualError, item.errorSummary, ''),
				status        : normalizeStatus(pickFirst(item.status, 'info')),
				startShort    : pickFirst(item.startShort, item.startLabel, '--'),
				endShort      : pickFirst(item.endShort, item.endLabel, '--'),
				startLong     : pickFirst(item.startLong, item.startTime, item.startLabel, '--'),
				endLong       : pickFirst(item.endLong, item.endTime, item.endLabel, '--'),
				durationLabel : pickFirst(item.durationLabel, '00h 00m 00s'),
				visualError   : pickFirst(item.shortError, item.visualError, item.summary, ''),
				fullError     : pickFirst(item.fullError, item.errorDetail, item.visualError, ''),
				steps         : normalizeSteps(item.steps),
				evidence      : normalizedEvidence
			]
		}

		int passedCount = scenarios.count { Map it -> it.status == 'passed' }
		int failedCount = scenarios.count { Map it -> it.status == 'failed' }
		int blockedCount = scenarios.count { Map it -> it.status == 'blocked' }
		int totalCount = scenarios.size()

		return [
			reportTitle   : REPORT_TITLE_PREFIX + suiteName,
			suiteName     : suiteName,
			generatedLabel: buildGeneratedLabel(safeModel),
			reportFolder  : pickFirst(safeModel.reportFolder, safeModel.baseFolder, safeModel.executionFolder),
			logoSrc       : pickFirst(safeModel.logoSrc, LOGO_SRC),
			scenarios     : scenarios,
			passedCount   : passedCount,
			failedCount   : failedCount,
			blockedCount  : blockedCount,
			totalCount    : totalCount
		]
	}

	private List<Map> normalizeSteps(def rawSteps) {
		List<Map> result = []

		asList(rawSteps).each { raw ->
			Map row = raw instanceof Map ? (raw as Map) : [detail: safeValue(raw)]

			String detail = pickFirst(row.detail, row.message, row.text, row.title, row.name)
			if (detail.isEmpty()) {
				return
			}

			String status = normalizeStatus(pickFirst(row.status, row.result, row.outcome, 'info'))
			String timestamp = pickFirst(row.timestamp, row.time, row.label, '--')

			result << [
				status   : status,
				timestamp: timestamp,
				detail   : detail,
				icon     : pickFirst(row.icon, resolveStepIcon(detail, status))
			]
		}

		return result
	}

	private List<Map> normalizeEvidence(def rawEvidence, Map model) {
		List<Map> result = []

		asList(rawEvidence).each { raw ->
			if (raw instanceof Map) {
				Map item = raw as Map
				result << [
					name  : pickFirst(item.name, item.fileName, 'Evidence'),
					href  : pickFirst(item.href, item.url, item.path, ''),
					image : Boolean.valueOf(String.valueOf(item.image)),
					imgSrc: pickFirst(item.imgSrc, item.imageSrc, item.href, item.url, '')
				]
			} else if (!safeValue(raw).isEmpty()) {
				String href = safeValue(raw)
				result << [
					name  : new File(href).name,
					href  : href,
					image : isImageFile(href),
					imgSrc: isImageFile(href) ? href : ''
				]
			}
		}

		return result
				.findAll { Map item -> !pickFirst(item.href, item.imgSrc).isEmpty() }
				.unique { Map item -> pickFirst(item.href, item.imgSrc) }
	}

	private String buildScenarioListItem(Map scenario, boolean selected) {
		String borderClass = selected ? 'scenario-list-item selected' : 'scenario-list-item'
		String shortName = shorten(scenario.name, 68)

		StringBuilder sb = new StringBuilder()
		sb.append('<button type="button" class="')
		sb.append(borderClass)
		sb.append('" data-sid="')
		sb.append(htmlEscape(scenario.id))
		sb.append('" onclick="showScenario(\'')
		sb.append(jsEscape(scenario.id))
		sb.append('\')">')

		sb.append('<div class="scenario-list-main">')
		sb.append('<div class="scenario-list-title">')
		sb.append(htmlEscape(shortName))
		sb.append('</div>')
		sb.append('</div>')

		sb.append('<div class="scenario-list-side">')
		sb.append('<span class="status-pill ')
		sb.append(htmlEscape(scenario.status))
		sb.append('">')
		sb.append(htmlEscape(statusLabel(scenario.status)))
		sb.append('</span>')
		sb.append('<div class="scenario-list-duration">')
		sb.append(htmlEscape(pickFirst(scenario.durationLabel, '00h 00m 00s')))
		sb.append('</div>')
		sb.append('</div>')

		sb.append('</button>')
		return sb.toString()
	}

	private String buildScenarioPanel(Map scenario, Map view, boolean selected) {
		String panelClass = selected ? 'scenario-panel active' : 'scenario-panel'

		String suiteLabel = safeValue(view.suiteName)
		String scenarioName = safeValue(scenario.name)
		String scenarioStatus = safeValue(scenario.status)

		String visualError = pickFirst(scenario.visualError, scenario.summary, '')
		String fullError = pickFirst(scenario.fullError, visualError)

		String startLabel = pickFirst(scenario.startLong, scenario.startShort, '--')
		String endLabel = pickFirst(scenario.endLong, scenario.endShort, '--')
		String durationLabel = pickFirst(scenario.durationLabel, '00h 00m 00s')

		List<Map> evidenceList = scenario.evidence instanceof List ? (scenario.evidence as List<Map>) : []

		Map firstEvidence = null
		if ('failed'.equalsIgnoreCase(scenarioStatus) && !evidenceList.isEmpty()) {
			firstEvidence = evidenceList[0]
		}

		StringBuilder sb = new StringBuilder()

		sb.append('<section class="')
		sb.append(panelClass)
		sb.append('" id="panel-')
		sb.append(htmlEscape(safeValue(scenario.id)))
		sb.append('">')

		sb.append('<div class="scenario-header">')
		sb.append('<div class="scenario-title">')
		sb.append(htmlEscape(scenarioName))
		sb.append('</div>')

		sb.append('<div class="scenario-meta-row">')
		sb.append(buildMetaChip('Suite', suiteLabel, 'plain'))
		sb.append(buildMetaChip('Status', statusLabel(scenarioStatus), scenarioStatus))
		sb.append(buildMetaChip('Start', startLabel, 'gradient'))
		sb.append(buildMetaChip('End', endLabel, 'gradient'))
		sb.append(buildMetaChip('Duration', durationLabel, 'gradient'))
		sb.append('</div>')
		sb.append('</div>')

		sb.append('<div class="section-title">Steps</div>')

		List<Map> steps = scenario.steps instanceof List ? (scenario.steps as List<Map>) : []

		if (steps.isEmpty()) {
			sb.append('<div class="steps-empty">No step details available.</div>')
		} else {
			sb.append('<div class="steps-table">')
			sb.append('<div class="steps-head">')
			sb.append('<div class="col-status">STATUS</div>')
			sb.append('<div class="col-time">TIMESTAMP</div>')
			sb.append('<div class="col-detail">DETAILS</div>')
			sb.append('</div>')

			steps.each { Map step ->
				sb.append(buildStepRow(step))
			}

			sb.append('</div>')
		}

		if ('failed'.equalsIgnoreCase(scenarioStatus) && (!visualError.isEmpty() || !fullError.isEmpty())) {
			sb.append('<div class="error-block">')
			sb.append('<div class="error-title">Visual Error Log</div>')
			sb.append('<div class="error-summary">')
			sb.append(htmlEscape(limitVisualError(visualError)))
			sb.append('</div>')

			if (!safeValue(fullError).isEmpty()) {
				sb.append('<details class="details-box">')
				sb.append('<summary>🔎 View full error</summary>')
				sb.append('<pre>')
				sb.append(htmlEscape(fullError))
				sb.append('</pre>')
				sb.append('</details>')
			}

			sb.append('</div>')
		}

		if ('failed'.equalsIgnoreCase(scenarioStatus)) {
			sb.append('<div class="evidence-block">')
			sb.append('<div class="evidence-title">Evidence</div>')

			if (firstEvidence != null) {
				sb.append('<details class="evidence-item" open>')
				sb.append('<summary>🖼 ')
				sb.append(htmlEscape(pickFirst(firstEvidence.name, 'Open evidence')))
				sb.append('</summary>')

				if (!pickFirst(firstEvidence.href, '').isEmpty()) {
					sb.append('<div class="evidence-links">')
					sb.append('<a href="')
					sb.append(htmlEscape(firstEvidence.href))
					sb.append('" target="_blank" rel="noopener noreferrer">🔎 Open evidence</a>')
					sb.append('</div>')
				}

				if (Boolean.TRUE.equals(firstEvidence.image) && !pickFirst(firstEvidence.imgSrc, '').isEmpty()) {
					sb.append('<img class="evidence-image" src="')
					sb.append(htmlEscape(firstEvidence.imgSrc))
					sb.append('" alt="Evidence">')
				}

				sb.append('</details>')
			} else {
				sb.append('<div class="evidence-empty">No evidence was found for this scenario.</div>')
			}

			sb.append('</div>')
		}

		sb.append('</section>')

		return sb.toString()
	}

	private String limitVisualError(String text) {
		List<String> lines = safeValue(text)
				.readLines()
				.collect { safeValue(it) }
				.findAll { !it.isEmpty() }

		if (lines.isEmpty()) {
			return ''
		}

		List<String> result = []

		for (String line : lines) {
			String lower = line.toLowerCase(Locale.ENGLISH)

			if (line.startsWith('at ')) {
				break
			}

			if (lower.startsWith('original error:')) {
				break
			}

			result << line

			if (lower.startsWith('expected window title:')) {
				break
			}
		}

		if (result.isEmpty()) {
			int max = Math.min(lines.size(), 4)
			result = lines.take(max)
		}

		return result.join('\\n')
	}

	private String buildStepRow(Map step) {
		StringBuilder sb = new StringBuilder()

		sb.append('<div class="step-row">')
		sb.append('<div class="col-status">')
		sb.append('<span class="status-pill ')
		sb.append(htmlEscape(step.status))
		sb.append('">')
		sb.append(htmlEscape(statusLabel(step.status)))
		sb.append('</span>')
		sb.append('</div>')

		sb.append('<div class="col-time">')
		sb.append(htmlEscape(pickFirst(step.timestamp, '--')))
		sb.append('</div>')

		sb.append('<div class="col-detail">')
		sb.append('<span class="step-icon">')
		sb.append(htmlEscape(pickFirst(step.icon, 'ℹ️')))
		sb.append('</span> ')
		sb.append(htmlEscape(pickFirst(step.detail, '')))
		sb.append('</div>')
		sb.append('</div>')

		return sb.toString()
	}

