	@Keyword
	void validateSyntheseTabOpened(
			String openedTabName,
			Integer timeoutSeconds
		) {

		Integer timeout =
			safeTimeout(timeoutSeconds)

		String tabName =
			safeText(openedTabName)

		if (tabName.isEmpty()) {
			KeywordUtil.markFailedAndStop(
