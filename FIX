package keywords

import com.kms.katalon.core.annotation.Keyword
import jiraIntegration.JiraFlowCoordinator

class JiraIntegration {

    @Keyword
    def jiraImport() {
        return new JiraFlowCoordinator().jiraImport('')
    }

    @Keyword
    def jiraImport(String epicKeyOverride) {
        return new JiraFlowCoordinator().jiraImport(epicKeyOverride)
    }
}
