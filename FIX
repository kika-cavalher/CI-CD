package jiraIntegration

import com.kms.katalon.core.util.KeywordUtil
import groovy.json.JsonOutput
import groovy.json.JsonSlurper

import javax.net.ssl.HostnameVerifier
import javax.net.ssl.HttpsURLConnection
import javax.net.ssl.SSLContext
import javax.net.ssl.SSLSession
import javax.net.ssl.TrustManager
import javax.net.ssl.X509TrustManager
import java.nio.charset.StandardCharsets
import java.security.SecureRandom
import java.security.cert.X509Certificate

class JiraGateway {

	private final def owner
	private final Map config = [:]

	private static boolean RELAXED_SSL_INITIALIZED = false

	JiraGateway() {
		this(null, [:])
	}

	JiraGateway(def owner) {
		this(owner, [:])
	}

	JiraGateway(Map config) {
		this(null, config ?: [:])
	}

	JiraGateway(def owner, Map config) {
		this.owner = owner
		if (config != null) {
			this.config.putAll(config)
		}
	}

	// =========================================================================
	// PUBLIC API
	// =========================================================================

	Map validateRequiredConfiguration() {
		String baseUrl = resolveBaseUrl()
		String authHeader = resolveAuthorizationHeader()

		if (blank(baseUrl)) {
			throw new IllegalStateException('JIRA_BASE_URL is required.')
		}

		if (blank(authHeader)) {
			throw new IllegalStateException('JIRA authorization token/header is required.')
		}

		return [
			baseUrl   : baseUrl,
			authHeader: authHeader
		]
	}

	Map getIssueByKey(String issueKey) {
		validateRequiredConfiguration()
		requireText(issueKey, 'Issue key')
		return doJsonRequest('GET', '/rest/api/2/issue/' + urlEncode(issueKey))
	}

	Map searchIssues(String jql) {
		return searchIssues(jql, 200, 0)
	}

	Map searchIssues(String jql, int maxResults) {
		return searchIssues(jql, maxResults, 0)
	}

	Map searchIssues(String jql, int maxResults, int startAt) {
		validateRequiredConfiguration()
		requireText(jql, 'JQL')

		String path = '/rest/api/2/search' + buildQueryString([
			jql       : jql,
			maxResults: String.valueOf(maxResults),
			startAt   : String.valueOf(startAt)
		])

		return doJsonRequest('GET', path)
	}

	Map searchTestPlans(String projectKey, String summary) {
		List<String> clauses = []

		if (notBlank(projectKey)) {
			clauses << 'project = "' + escapeJql(projectKey) + '"'
		}

		clauses << 'issuetype = "Test Plan"'

		if (notBlank(summary)) {
			clauses << 'summary ~ "' + escapeJql(summary) + '"'
		}

		String jql = clauses.join(' AND ') + ' ORDER BY created DESC'
		return searchIssues(jql, 200, 0)
	}

	Map createIssue(Map payload) {
		validateRequiredConfiguration()
		if (!(payload instanceof Map) || payload.isEmpty()) {
			throw new IllegalArgumentException('Create issue payload is required.')
		}
		return doJsonRequest('POST', '/rest/api/2/issue', payload)
	}

	Map createTestPlan(String projectKey, String summary) {
		return createTestPlan(projectKey, summary, '', '', '')
	}

	Map createTestPlan(String projectKey, String summary, String epicFieldId, String epicKey, String description) {
		validateRequiredConfiguration()
		requireText(projectKey, 'Project key')
		requireText(summary, 'Test Plan summary')

		Map fields = [
			project  : [key: projectKey],
			summary  : summary,
			issuetype: [name: 'Test Plan']
		]

		if (notBlank(description)) {
			fields.description = description
		}

		if (notBlank(epicFieldId) && notBlank(epicKey)) {
			fields[epicFieldId] = epicKey
		}

		return createIssue([fields: fields])
	}

	Map importExecutionResults(File junitXmlFile, String projectKey, String testPlanKey) {
		return importExecutionResults(junitXmlFile, projectKey, testPlanKey, '')
	}

	Map importExecutionResults(File junitXmlFile, String projectKey, String testPlanKey, String testExecKey) {
		validateRequiredConfiguration()

		if (junitXmlFile == null || !junitXmlFile.exists() || !junitXmlFile.isFile()) {
			throw new IllegalArgumentException('JUnit XML file was not found: ' + safePath(junitXmlFile))
		}

		Map query = [:]
		if (notBlank(projectKey)) {
			query.projectKey = projectKey
		}
		if (notBlank(testPlanKey)) {
			query.testPlanKey = testPlanKey
		}
		if (notBlank(testExecKey)) {
			query.testExecKey = testExecKey
		}

		String path = '/rest/raven/1.0/import/execution/junit' + buildQueryString(query)

		return doMultipartFileRequest(
			'POST',
			path,
			junitXmlFile,
			'file',
			'application/xml',
			[:]
		)
	}

	List addExecutionToTestPlan(String testPlanKey, String testExecutionKey) {
		validateRequiredConfiguration()
		requireText(testPlanKey, 'Test Plan key')
		requireText(testExecutionKey, 'Test Execution key')

		Map response = doJsonRequest(
			'POST',
			'/rest/raven/2.0/api/testplan/' + urlEncode(testPlanKey) + '/testexecution',
			[testExecutionKey]
		)

		def parsed = response.json
		if (parsed instanceof List) {
			return parsed as List
		}

		if (parsed == null) {
			return []
		}

		return [parsed]
	}

	Map addAttachment(String issueKey, File file) {
		validateRequiredConfiguration()
		requireText(issueKey, 'Issue key')

		if (file == null || !file.exists() || !file.isFile()) {
			throw new IllegalArgumentException('Attachment file was not found: ' + safePath(file))
		}

		return doMultipartFileRequest(
			'POST',
			'/rest/api/2/issue/' + urlEncode(issueKey) + '/attachments',
			file,
			'file',
			guessContentType(file),
			[
				'X-Atlassian-Token': 'no-check'
			]
		)
	}

	Map addAttachmentById(String issueIdOrKey, File file) {
		return addAttachment(issueIdOrKey, file)
	}

	Map doJsonRequest(String method, String path) {
		return doJsonRequest(method, path, null, [:], 'application/json')
	}

	Map doJsonRequest(String method, String path, Object payload) {
		return doJsonRequest(method, path, payload, [:], 'application/json')
	}

	Map doJsonRequest(String method, String path, Object payload, Map extraHeaders) {
		return doJsonRequest(method, path, payload, extraHeaders, 'application/json')
	}

	Map doJsonRequest(String method, String path, Object payload, Map extraHeaders, String contentType) {
		validateRequiredConfiguration()

		HttpURLConnection connection = openConnection(path, safe(method).toUpperCase(Locale.ENGLISH))
		connection.setRequestProperty('Accept', 'application/json')

		if (extraHeaders != null) {
			extraHeaders.each { String key, def value ->
				if (notBlank(key) && value != null) {
					connection.setRequestProperty(key, String.valueOf(value))
				}
			}
		}

		if (payload != null) {
			connection.doOutput = true
			connection.setRequestProperty('Content-Type', blank(contentType) ? 'application/json' : contentType)

			String body = payload instanceof String ? String.valueOf(payload) : JsonOutput.toJson(payload)
			byte[] bytes = body.getBytes(StandardCharsets.UTF_8)

			connection.setRequestProperty('Content-Length', String.valueOf(bytes.length))
			connection.outputStream.withCloseable { OutputStream os ->
				os.write(bytes)
				os.flush()
			}
		}

		return buildResponse(connection)
	}

	Map doMultipartFileRequest(String method, String path, File file, String fieldName, String contentType, Map extraHeaders) {
		validateRequiredConfiguration()

		if (file == null || !file.exists() || !file.isFile()) {
			throw new IllegalArgumentException('Multipart file was not found: ' + safePath(file))
		}

		String boundary = '----OpenAIJiraBoundary' + System.currentTimeMillis()
		HttpURLConnection connection = openConnection(path, safe(method).toUpperCase(Locale.ENGLISH))

		connection.doOutput = true
		connection.setRequestProperty('Accept', 'application/json')
		connection.setRequestProperty('Content-Type', 'multipart/form-data; boundary=' + boundary)

		if (extraHeaders != null) {
			extraHeaders.each { String key, def value ->
				if (notBlank(key) && value != null) {
					connection.setRequestProperty(key, String.valueOf(value))
				}
			}
		}

		connection.outputStream.withCloseable { OutputStream os ->
			writeMultipartFile(os, boundary, blank(fieldName) ? 'file' : fieldName, file, contentType)
			os.write(('--' + boundary + '--\r\n').getBytes(StandardCharsets.UTF_8))
			os.flush()
		}

		return buildResponse(connection)
	}

	// =========================================================================
	// CONNECTION / RESPONSE
	// =========================================================================

	private HttpURLConnection openConnection(String pathOrUrl, String method) {
		ensureRelaxedSsl()

		String absoluteUrl = buildAbsoluteUrl(pathOrUrl)
		URL url = new URL(absoluteUrl)
		HttpURLConnection connection = (HttpURLConnection) url.openConnection()

		connection.setRequestMethod(method)
		connection.setConnectTimeout(60000)
		connection.setReadTimeout(60000)
		connection.setUseCaches(false)
		connection.setDoInput(true)
		connection.setInstanceFollowRedirects(false)

		String authHeader = resolveAuthorizationHeader()
		if (notBlank(authHeader)) {
			connection.setRequestProperty('Authorization', authHeader)
		}

		return connection
	}

	private Map buildResponse(HttpURLConnection connection) {
		int status = connection.responseCode
		String body = readResponseBody(connection)
		Map headers = readHeaders(connection)
		def json = parseJson(body)

		return [
			status : status,
			body   : body,
			json   : json,
			headers: headers,
			success: status >= 200 && status < 300
		]
	}

	private String readResponseBody(HttpURLConnection connection) {
		InputStream stream = null

		try {
			stream = connection.responseCode >= 400 ? connection.errorStream : connection.inputStream
		} catch (Exception ignored) {
			stream = connection.errorStream
		}

		if (stream == null) {
			return ''
		}

		return stream.getText('UTF-8')
	}

	private Map readHeaders(HttpURLConnection connection) {
		Map result = [:]

		connection.headerFields?.each { def key, def values ->
			if (key != null) {
				result[String.valueOf(key)] = values
			}
		}

		return result
	}

	private def parseJson(String body) {
		String text = safe(body)
		if (blank(text)) {
			return null
		}

		String trimmed = text.trim()
		if (!(trimmed.startsWith('{') || trimmed.startsWith('['))) {
			return null
		}

		try {
			return new JsonSlurper().parseText(trimmed)
		} catch (Exception ignored) {
			return null
		}
	}

	private void writeMultipartFile(OutputStream os, String boundary, String fieldName, File file, String contentType) {
		StringBuilder header = new StringBuilder()
		header.append('--').append(boundary).append('\r\n')
		header.append('Content-Disposition: form-data; name="').append(fieldName).append('"; filename="').append(file.name).append('"\r\n')
		header.append('Content-Type: ').append(blank(contentType) ? 'application/octet-stream' : contentType).append('\r\n\r\n')

		os.write(header.toString().getBytes(StandardCharsets.UTF_8))
		file.withInputStream { InputStream input ->
			byte[] buffer = new byte[8192]
			int len
			while ((len = input.read(buffer)) != -1) {
				os.write(buffer, 0, len)
			}
		}
		os.write('\r\n'.getBytes(StandardCharsets.UTF_8))
	}

	// =========================================================================
	// CONFIG / AUTH
	// =========================================================================

	private String resolveBaseUrl() {
		String baseUrl = firstNonBlank(
			config?.JIRA_BASE_URL,
			config?.baseUrl,
			readOwnerText('JIRA_BASE_URL'),
			readOwnerText('baseUrl'),
			System.getenv('JIRA_BASE_URL'),
			System.getProperty('JIRA_BASE_URL')
		)

		if (blank(baseUrl)) {
			return ''
		}

		return baseUrl.endsWith('/') ? baseUrl.substring(0, baseUrl.length() - 1) : baseUrl
	}

	private String resolveAuthorizationHeader() {
		String raw = firstNonBlank(
			config?.AUTHORIZATION_HEADER,
			config?.authorizationHeader,
			readOwnerText('AUTHORIZATION_HEADER'),
			readOwnerText('authorizationHeader'),
			config?.JIRA_AUTH_HEADER,
			readOwnerText('JIRA_AUTH_HEADER'),
			config?.JIRA_TOKEN,
			readOwnerText('JIRA_TOKEN'),
			config?.JIRA_AUTH,
			readOwnerText('JIRA_AUTH'),
			System.getenv('JIRA_AUTH_HEADER'),
			System.getenv('JIRA_TOKEN'),
			System.getenv('JIRA_AUTH')
		)

		if (blank(raw)) {
			return ''
		}

		if (raw.startsWith('Basic ') || raw.startsWith('Bearer ')) {
			return raw
		}

		return 'Basic ' + raw
	}

	private String buildAbsoluteUrl(String pathOrUrl) {
		String raw = safe(pathOrUrl)
		if (raw.startsWith('http://') || raw.startsWith('https://')) {
			return raw
		}

		String baseUrl = resolveBaseUrl()
		if (blank(baseUrl)) {
			throw new IllegalStateException('JIRA_BASE_URL is required.')
		}

		if (!raw.startsWith('/')) {
			raw = '/' + raw
		}

		return baseUrl + raw
	}

	private String readOwnerText(String propertyName) {
		if (owner == null || blank(propertyName)) {
			return ''
		}

		try {
			return safe(owner."${propertyName}")
		} catch (MissingPropertyException ignored) {
			return ''
		} catch (Exception ignored) {
			return ''
		}
	}

	// =========================================================================
	// SSL
	// =========================================================================

	private static synchronized void ensureRelaxedSsl() {
		if (RELAXED_SSL_INITIALIZED) {
			return
		}

		TrustManager[] trustAllCerts = [
			new X509TrustManager() {
				@Override
				void checkClientTrusted(X509Certificate[] chain, String authType) {
				}

				@Override
				void checkServerTrusted(X509Certificate[] chain, String authType) {
				}

				@Override
				X509Certificate[] getAcceptedIssuers() {
					return new X509Certificate[0]
				}
			}
		] as TrustManager[]

		SSLContext sslContext = SSLContext.getInstance('TLS')
		sslContext.init(null, trustAllCerts, new SecureRandom())

		HttpsURLConnection.setDefaultSSLSocketFactory(sslContext.socketFactory)
		HttpsURLConnection.setDefaultHostnameVerifier(new HostnameVerifier() {
			@Override
			boolean verify(String hostname, SSLSession session) {
				return true
			}
		})

		RELAXED_SSL_INITIALIZED = true
	}

	// =========================================================================
	// HELPERS
	// =========================================================================

	String safe(def value) {
		return value == null ? '' : String.valueOf(value).trim()
	}

	boolean blank(def value) {
		return safe(value).isEmpty()
	}

	boolean notBlank(def value) {
		return !blank(value)
	}

	String firstNonBlank(Object... values) {
		if (values == null) {
			return ''
		}

		for (Object value : values) {
			String text = safe(value)
			if (!text.isEmpty()) {
				return text
			}
		}

		return ''
	}

	private void requireText(String value, String label) {
		if (blank(value)) {
			throw new IllegalArgumentException(label + ' is required.')
		}
	}

	private String buildQueryString(Map params) {
		if (!(params instanceof Map) || params.isEmpty()) {
			return ''
		}

		List<String> parts = []

		params.each { def key, def value ->
			if (key == null || value == null) {
				return
			}

			String text = String.valueOf(value)
			if (text.trim().isEmpty()) {
				return
			}

			parts << urlEncode(String.valueOf(key)) + '=' + urlEncode(text)
		}

		return parts.isEmpty() ? '' : '?' + parts.join('&')
	}

	private String urlEncode(String value) {
		return java.net.URLEncoder.encode(safe(value), 'UTF-8').replace('+', '%20')
	}

	private String escapeJql(String value) {
		return safe(value).replace('\\', '\\\\').replace('"', '\\"')
	}

	private String guessContentType(File file) {
		String name = safe(file?.name).toLowerCase(Locale.ENGLISH)

		if (name.endsWith('.xml')) {
			return 'application/xml'
		}
		if (name.endsWith('.html') || name.endsWith('.htm')) {
			return 'text/html'
		}
		if (name.endsWith('.json')) {
			return 'application/json'
		}
		if (name.endsWith('.zip')) {
			return 'application/zip'
		}
		if (name.endsWith('.png')) {
			return 'image/png'
		}
		if (name.endsWith('.jpg') || name.endsWith('.jpeg')) {
			return 'image/jpeg'
		}
		if (name.endsWith('.gif')) {
			return 'image/gif'
		}
		if (name.endsWith('.txt') || name.endsWith('.log')) {
			return 'text/plain'
		}

		return 'application/octet-stream'
	}

	private String safePath(File file) {
		return file == null ? '' : safe(file.absolutePath)
	}
}
