// ======================================================
// DELETE FAVORITE
// ======================================================

@Keyword
void deleteCreatedFavorite(
	String favoriteTitle,
	String favoriteImageKey
) {

	Integer maximumSearchAttempts = 5
	Integer waitPerSearchAttemptSeconds = 20

	Integer maximumDeleteChecks = 5
	Integer waitPerDeleteCheckSeconds = 20

	Integer controlTimeout = 5

	logStep(
		'DELETE FAVORITE',
		'Favorite title: ' + favoriteTitle + '\n' +
		'Favorite image key: ' + favoriteImageKey
	)


	// ======================================================
	// LOCAL CLOSE ALL TABS FLOW
	// ======================================================

	def closeAllTabs = { String phase ->

		KeywordUtil.logInfo(
			'[CLOSE TABS] Phase: ' + phase
		)

		pressKeyboardKey(
			KeyEvent.VK_ESCAPE
		)

		Windows.delay(1)

		WindowsTestObject closeAllTabsButton =
			object(
				'closeAllTabsTopBar'
			)

		boolean closeButtonFound =
			Windows.waitForElementPresent(
				closeAllTabsButton,
				controlTimeout,
				FailureHandling.OPTIONAL
			)

		if (!closeButtonFound) {
			KeywordUtil.logInfo(
				'[CLOSE TABS] Close All Tabs button was not found.\n' +
				'No closing action was executed.'
			)

			return
		}

		String enabledValue =
			safeText(
				Windows.getAttribute(
					closeAllTabsButton,
					'IsEnabled',
					FailureHandling.OPTIONAL
				)
			)

		if (enabledValue.equalsIgnoreCase('False')) {
			KeywordUtil.logInfo(
				'[CLOSE TABS] Close All Tabs button is disabled.\n' +
				'There are no opened tabs to close.'
			)

			return
		}

		Windows.click(
			closeAllTabsButton,
			FailureHandling.STOP_ON_FAILURE
		)

		Windows.delay(2)

		boolean closeConfirmed =
			clickFirstVisibleImage(
				GENERAL_IMAGE_GROUP,
				[
					'yes',
					'yesUnderline',
					'yesButton',
					'oui'
				],
				3
			)

		if (!closeConfirmed) {
			KeywordUtil.logInfo(
				'[CLOSE TABS] Confirmation image was not found.\n' +
				'Pressing ENTER.'
			)

			pressKeyboardKey(
				KeyEvent.VK_ENTER
			)
		}

		Windows.delay(5)

		KeywordUtil.logInfo(
			'[CLOSE TABS] Closing flow completed.\n' +
				'Phase: ' + phase
		)
	}


	// ======================================================
	// 1. CLOSE CURRENT OPENED TABS
	// ======================================================

	closeAllTabs(
		'BEFORE FAVORITE DELETION'
	)

	pressKeyboardKey(
		KeyEvent.VK_ESCAPE
	)

	Windows.delay(2)


	// ======================================================
	// 2. OPEN FAVORITES TAB
	// ======================================================

	WindowsTestObject favoritesTab =
		object(
			'favoritesTab'
		)

	if (!Windows.waitForElementPresent(
		favoritesTab,
		10,
		FailureHandling.OPTIONAL
	)) {
		takeEvidence(
			'GUI_FavoritesTabNotFoundForDelete.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorites tab was not found before deletion.'
		)

		return
	}

	KeywordUtil.logInfo(
		'[DELETE FAVORITE] Clicking Favorites tab.'
	)

	Windows.click(
		favoritesTab,
		FailureHandling.STOP_ON_FAILURE
	)

	Windows.delay(3)


	// ======================================================
	// 3. FIND FAVORITE AND RIGHT CLICK
	// SAME SEARCH USED WHEN OPENING THE FAVORITE
	// ======================================================

	boolean contextMenuOpened = false

	for (
		Integer searchAttempt = 1;
		searchAttempt <= maximumSearchAttempts;
		searchAttempt++
	) {

		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Searching for favorite.\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'Attempt: ' +
				searchAttempt +
				'/' +
				maximumSearchAttempts
		)

		WindowsTestObject favoriteItem =
			WindowsObjectLoader.getTreeItemByName(
				favoriteTitle
			)

		boolean favoriteFoundByElement =
			Windows.waitForElementPresent(
				favoriteItem,
				3,
				FailureHandling.OPTIONAL
			)

		if (favoriteFoundByElement) {
			KeywordUtil.logInfo(
				'[DELETE FAVORITE] Favorite found by element.\n' +
				'Opening context menu with right click.'
			)

			Windows.rightClick(
				favoriteItem,
				FailureHandling.STOP_ON_FAILURE
			)

			contextMenuOpened = true
			break
		}

		if (!safeText(favoriteImageKey).isEmpty()) {

			String favoriteImagePath =
				optionalImage(
					GUI_IMAGE_GROUP,
					favoriteImageKey
				)

			if (!favoriteImagePath.isEmpty()) {
				try {
					def foundImage =
						WindowsImageKeywords.findImage(
							favoriteImagePath
						)

					if (
						foundImage != null &&
						foundImage != false
					) {
						Integer centerX = null
						Integer centerY = null

						try {
							def center =
								foundImage.getCenter()

							centerX =
								(center.x as Number)
									.intValue()

							centerY =
								(center.y as Number)
									.intValue()
						} catch (Throwable ignored) {
						}

						if (
							centerX == null ||
							centerY == null
						) {
							try {
								Integer imageX =
									(foundImage.x as Number)
										.intValue()

								Integer imageY =
									(foundImage.y as Number)
										.intValue()

								Integer imageWidth =
									(foundImage.w as Number)
										.intValue()

								Integer imageHeight =
									(foundImage.h as Number)
										.intValue()

								centerX =
									imageX +
									imageWidth.intdiv(2)

								centerY =
									imageY +
									imageHeight.intdiv(2)
							} catch (Throwable ignored) {
							}
						}

						if (
							centerX != null &&
							centerY != null
						) {
							Robot robot =
								new Robot()

							robot.setAutoDelay(100)

							robot.mouseMove(
								centerX,
								centerY
							)

							robot.mousePress(
								java.awt.event.InputEvent
									.BUTTON3_DOWN_MASK
							)

							robot.mouseRelease(
								java.awt.event.InputEvent
									.BUTTON3_DOWN_MASK
							)

							KeywordUtil.logInfo(
								'[DELETE FAVORITE] Favorite found by image.\n' +
								'Context menu opened with right click.\n' +
								'Image key: ' +
									favoriteImageKey
							)

							contextMenuOpened = true
							break
						}
					}
				} catch (Throwable imageError) {
					KeywordUtil.logInfo(
						'[DELETE FAVORITE] Image search failed.\n' +
						'Reason: ' +
							safeText(
								imageError.getMessage()
							)
					)
				}
			}
		}

		if (searchAttempt < maximumSearchAttempts) {
			KeywordUtil.logInfo(
				'[DELETE FAVORITE] Favorite was not found yet.\n' +
				'Waiting another ' +
				waitPerSearchAttemptSeconds +
				' seconds.'
			)

			Windows.delay(
				waitPerSearchAttemptSeconds
			)

			pressKeyboardKey(
				KeyEvent.VK_ESCAPE
			)

			if (Windows.waitForElementPresent(
				favoritesTab,
				2,
				FailureHandling.OPTIONAL
			)) {
				Windows.click(
					favoritesTab,
					FailureHandling.OPTIONAL
				)

				Windows.delay(2)
			}
		}
	}

	if (!contextMenuOpened) {
		takeEvidence(
			'GUI_FavoriteNotFoundForDelete.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorite was not found for deletion by element or image.\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'Image key: ' + favoriteImageKey + '\n' +
			'Attempts: ' + maximumSearchAttempts
		)

		return
	}

	Windows.delay(2)


	// ======================================================
	// 4. CLICK SUPPRIMER LE FAVORI
	// ELEMENT FIRST, IMAGE FALLBACK
	// ======================================================

	boolean deleteCommandClicked = false

	WindowsTestObject deleteFavoriteButton =
		buildXpathObject(
			"//*[@Name='Supprimer le favori' and " +
			"(@LocalizedControlType='button' or " +
			"contains(@ControlType,'Button'))]"
		)

	boolean deleteButtonFound =
		Windows.waitForElementPresent(
			deleteFavoriteButton,
			controlTimeout,
			FailureHandling.OPTIONAL
		)

	if (deleteButtonFound) {
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Clicking Supprimer le favori by element.'
		)

		Windows.click(
			deleteFavoriteButton,
			FailureHandling.STOP_ON_FAILURE
		)

		deleteCommandClicked = true
	} else {
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Delete element was not found.\n' +
			'Trying image fallback: deleteFavoriteBtn'
		)

		deleteCommandClicked =
			clickFirstVisibleImage(
				GUI_IMAGE_GROUP,
				[
					'deleteFavoriteBtn'
				],
				controlTimeout
			)
	}

	if (!deleteCommandClicked) {
		takeEvidence(
			'GUI_DeleteFavoriteButtonNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Delete Favorite command was not found by element or image.\n' +
			'Expected command: Supprimer le favori\n' +
			'Image key: deleteFavoriteBtn'
		)

		return
	}


	// ======================================================
	// 5. WAIT UNTIL FAVORITE DISAPPEARS
	// 5 ATTEMPTS OF 20 SECONDS
	// ======================================================

	boolean favoriteDeleted = false

	for (
		Integer deleteCheckAttempt = 1;
		deleteCheckAttempt <= maximumDeleteChecks;
		deleteCheckAttempt++
	) {

		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Waiting for deletion.\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'Attempt: ' +
				deleteCheckAttempt +
				'/' +
				maximumDeleteChecks + '\n' +
			'Wait time: ' +
				waitPerDeleteCheckSeconds +
				' seconds'
		)

		Windows.delay(
			waitPerDeleteCheckSeconds
		)

		pressKeyboardKey(
			KeyEvent.VK_ESCAPE
		)

		if (Windows.waitForElementPresent(
			favoritesTab,
			2,
			FailureHandling.OPTIONAL
		)) {
			Windows.click(
				favoritesTab,
				FailureHandling.OPTIONAL
			)

			Windows.delay(2)
		}

		WindowsTestObject currentFavoriteItem =
			WindowsObjectLoader.getTreeItemByName(
				favoriteTitle
			)

		boolean favoriteStillPresentByElement =
			Windows.waitForElementPresent(
				currentFavoriteItem,
				2,
				FailureHandling.OPTIONAL
			)

		boolean favoriteStillPresentByImage = false

		if (!safeText(favoriteImageKey).isEmpty()) {
			favoriteStillPresentByImage =
				isOptionalImageVisible(
					GUI_IMAGE_GROUP,
					favoriteImageKey
				)
		}

		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Presence check.\n' +
			'Found by element: ' +
				favoriteStillPresentByElement + '\n' +
			'Found by image: ' +
				favoriteStillPresentByImage
		)

		if (
			!favoriteStillPresentByElement &&
			!favoriteStillPresentByImage
		) {
			favoriteDeleted = true

			KeywordUtil.logInfo(
				'[PASS] Favorite is no longer displayed.\n' +
				'Attempt: ' +
				deleteCheckAttempt +
				'/' +
				maximumDeleteChecks
			)

			break
		}
	}

	takeEvidence(
		'GUI_FavoriteAfterDelete.png'
	)

	if (!favoriteDeleted) {
		KeywordUtil.markFailedAndStop(
			'Favorite is still visible after deletion.\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'Image key: ' + favoriteImageKey + '\n' +
			'Attempts: ' + maximumDeleteChecks + '\n' +
			'Maximum total wait: 100 seconds'
		)

		return
	}


	// ======================================================
	// 6. CLOSE TABS AGAIN
	// ======================================================

	closeAllTabs(
		'AFTER FAVORITE DELETION'
	)

	takeEvidence(
		'GUI_AllTabsClosedAfterFavoriteDelete.png'
	)

	KeywordUtil.markPassed(
		'Favorite deleted successfully.\n' +
		'Favorite: ' + favoriteTitle + '\n' +
		'Favorite is no longer displayed.\n' +
		'Tabs were closed before and after deletion.'
	)
}








