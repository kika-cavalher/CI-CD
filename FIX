		}

		String lower = safe(file.name).toLowerCase(Locale.ENGLISH)

		return lower.endsWith('.png') ||
				lower.endsWith('.jpg') ||
				lower.endsWith('.jpeg') ||
				lower.endsWith('.gif') ||
				lower.endsWith('.bmp') ||
				lower.endsWith('.webp')
