		Map<String, String> imagesGeneral = imageLoader.loadImagesGeneral()
		def yesImage1 = imagesGeneral.yesEn
		def yesImage2 = imagesGeneral.yesUnderline

		int maxWaitTime = 20
		int delayInterval = 2
		int elapsedTime = 0
		boolean imageFound = false

		while (elapsedTime < maxWaitTime) {
			if (WindowsImageKeywords.findImage(yesImage1)) {
