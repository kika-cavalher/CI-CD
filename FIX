	private void closeAllTabs(
			Integer timeoutSeconds
	) {

		Integer timeout =
				safeTimeout(
				timeoutSeconds,
				5
				)

		logStep(
				'CLOSE ALL TABS',
				'Image key: closeTabs\n' +
				'Object fallback: closeAllTabsTopBar\n' +
				'Timeout for each search: ' +
				timeout +
				' seconds'
				)

		KeywordUtil.logInfo(
				'[IMAGE] Searching for Close All Tabs.\n' +
				'Image key: closeTabs\n' +
				'Timeout: ' + timeout + ' seconds'
				)

		boolean closeAllTabsClicked =
				clickFirstVisibleImage(
				GENERAL_IMAGE_GROUP,
				['closeTabs'],
				timeout
				)

		if (!closeAllTabsClicked) {
			KeywordUtil.logInfo(
					'[OBJECT] Close All Tabs image was not found. Searching by object.\n' +
					'Object key: closeAllTabsTopBar\n' +
					'Timeout: ' + timeout + ' seconds'
					)

			WindowsTestObject closeAllTabsButton =
					object(
					'closeAllTabsTopBar'
					)

			boolean closeAllTabsFound =
					Windows.waitForElementPresent(
					closeAllTabsButton,
					timeout,
					FailureHandling.OPTIONAL
					)

			if (!closeAllTabsFound) {
				takeEvidence(
						'GUI_CloseAllTabsNotFound.png'
						)

				KeywordUtil.logInfo(
						'[FAIL] Close All Tabs was not found by image or object.'
						)

				KeywordUtil.markFailedAndStop(
						'Close All Tabs was not found.\n' +
						'Image key: closeTabs\n' +
						'Object key: closeAllTabsTopBar\n' +
						'Image timeout: ' + timeout + ' seconds\n' +
						'Object timeout: ' + timeout + ' seconds'
						)

				return
			}

			String enabledValue =
					safeText(
					Windows.getAttribute(
					closeAllTabsButton,
					'IsEnabled',
					FailureHandling.OPTIONAL
					)
					)

			if (enabledValue.equalsIgnoreCase('False')) {
				KeywordUtil.logInfo(
						'[PASS] Close All Tabs is disabled. There are no opened tabs.'
						)

				return
			}

			Windows.click(
					closeAllTabsButton,
					FailureHandling.STOP_ON_FAILURE
					)

			closeAllTabsClicked = true

			KeywordUtil.logInfo(
					'[OBJECT] Close All Tabs clicked.'
					)
		}

		KeywordUtil.logInfo(
				'[IMAGE] Waiting for the Close All Tabs confirmation.\n' +
				'Timeout: ' + timeout + ' seconds'
				)

		boolean confirmationClicked =
				clickFirstVisibleImage(
				GENERAL_IMAGE_GROUP,
				[
					'yes',
					'yesUnderline',
					'yesButton',
					'oui',
					'okModal',
					'okModal2Version'
				],
				timeout
				)

		if (!confirmationClicked) {
			takeEvidence(
					'GUI_CloseAllTabsConfirmationNotFound.png'
					)

			KeywordUtil.logInfo(
					'[FAIL] Close All Tabs confirmation image was not found.'
					)

			KeywordUtil.markFailedAndStop(
					'Close All Tabs was clicked, but its confirmation image was not found within ' +
					timeout +
					' seconds.'
					)

			return
		}

		KeywordUtil.logInfo(
				'[PASS] Close All Tabs confirmation clicked.'
				)
	}


	private void clickRequiredObject(
			String objectKey,
			String description,
			Integer timeoutSeconds,
			String evidenceName
	) {

		Integer timeout =
				safeTimeout(
				timeoutSeconds,
				5
				)

		KeywordUtil.logInfo(
				'[OBJECT] Waiting for ' + description + '.\n' +
				'Timeout: ' + timeout + ' seconds'
				)

		WindowsTestObject targetObject =
				object(
				objectKey
				)

		boolean found =
				Windows.waitForElementPresent(
				targetObject,
				timeout,
				FailureHandling.OPTIONAL
				)

		if (!found) {
			takeEvidence(
					evidenceName
					)

			KeywordUtil.markFailedAndStop(
					description +
					' was not found within ' +
					timeout +
					' seconds.\n' +
					'Object key: ' + objectKey
					)

			return
		}

		KeywordUtil.logInfo(
				'[OBJECT] ' + description + ' found. Clicking it now.'
				)

		Windows.click(
				targetObject,
				FailureHandling.STOP_ON_FAILURE
				)
	}


	private boolean clickImageWithAttempts(
			String groupName,
			List<String> imageKeys,
			Integer attempts,
			Integer timeoutPerAttemptSeconds
	) {

		for (
		Integer attempt = 1;
				attempt <= attempts;
				attempt++
				) {

			KeywordUtil.logInfo(
					'Searching for confirmation image.\n' +
					'Attempt: ' + attempt + ' of ' + attempts + '\n' +
					'Timeout for this attempt: ' +
					timeoutPerAttemptSeconds +
					' seconds'
					)

			boolean clicked =
					clickFirstVisibleImage(
					groupName,
					imageKeys,
					timeoutPerAttemptSeconds
					)

			if (clicked) {
				return true
			}
		}

		return false
	}




	private boolean rightClickImageWithinTimeout(
			String imagePath,
			Integer timeoutSeconds
	) {

		Integer timeout =
				safeTimeout(
				timeoutSeconds,
				5
				)

		for (
		Integer second = 1;
				second <= timeout;
				second++
				) {
			try {
				def found =
						WindowsImageKeywords.findImage(
						imagePath
						)

				if (found != null && found != false) {
					WindowsImageKeywords.rightClickImage(
							imagePath
							)

					KeywordUtil.logInfo(
							'Favorite image found. Right click completed.'
							)

					return true
				}
			} catch (Throwable ignored) {
			}

			if (second < timeout) {
				Windows.delay(1)
			}
		}

		return false
	}


	private boolean waitForImageToDisappear(
			String imagePath,
			Integer timeoutSeconds
	) {

		Integer timeout =
				safeTimeout(
				timeoutSeconds,
				5
				)

		for (
		Integer second = 1;
				second <= timeout;
				second++
				) {

			boolean visible = false

			try {
				def found =
						WindowsImageKeywords.findImage(
						imagePath
						)

				visible =
						found != null &&
						found != false
			} catch (Throwable ignored) {
				visible = false
			}

			if (!visible) {
				return true
			}

			if (second < timeout) {
				Windows.delay(1)
			}
		}

		return false
	}


