	@Keyword
	void activateHomeTab() {
		String home = new File(RunConfiguration.getProjectDir(), 'Images/General/Home.PNG').getAbsolutePath()
		String homeGrey = new File(RunConfiguration.getProjectDir(), 'Images/General/HomeGrey.PNG').getAbsolutePath()
		String homeWhite = new File(RunConfiguration.getProjectDir(), 'Images/General/HomeWhite.PNG').getAbsolutePath()

		try {
			if (new File(home).exists()) {
				WindowsImageKeywords.clickImage(home)
				Windows.delay(AFTER_HOME_CLICK_DELAY_SEC)
				return
			}
		}
		catch (Exception ignored) {
		}

		try {
			if (new File(homeGrey).exists()) {
				def activeTab = WindowsImageKeywords.findImage(homeGrey)
				if (activeTab != null) {
					return
				}
			}
		}
		catch (Exception ignored) {
		}

		try {
			if (new File(homeWhite).exists()) {
				def inactiveTab = WindowsImageKeywords.findImage(homeWhite)
				if (inactiveTab != null) {
					Windows.click(inactiveTab)
					Windows.delay(AFTER_HOME_CLICK_DELAY_SEC)
					return
				}
			}
		}
		catch (Exception ignored) {
		}
	}

	private void ensureWinAppDriverRunning() {
		if (isPortOpen(WINAPPDRIVER_HOST, WINAPPDRIVER_PORT, 500)) {
			KeywordUtil.logInfo("WinAppDriver already listening on ${WINAPPDRIVER_HOST}:${WINAPPDRIVER_PORT}")
			return
		}

		String resolvedPath = getWinAppDriverPath()

		try {
			if (!blank(resolvedPath) && new File(resolvedPath).exists()) {
				KeywordUtil.logInfo("Starting WinAppDriver from file: ${resolvedPath}")
				new ProcessBuilder(
					'cmd',
					'/c',
					'start "" "' + resolvedPath + '"'
				).start()
			}
			else {
				KeywordUtil.logInfo("Starting WinAppDriver by PATH command.")
				new ProcessBuilder(
					'cmd',
					'/c',
					'start "" WinAppDriver.exe'
				).start()
			}
		}
		catch (Exception e) {
			KeywordUtil.markFailedAndStop("Failed to start WinAppDriver. ${e.getMessage()}")
		}

		int elapsed = 0

		while (elapsed < WINAPPDRIVER_START_TIMEOUT_SEC) {
			if (isPortOpen(WINAPPDRIVER_HOST, WINAPPDRIVER_PORT, 500)) {
				KeywordUtil.logInfo("WinAppDriver is ready on ${WINAPPDRIVER_HOST}:${WINAPPDRIVER_PORT}")
				return
			}

			Windows.delay(WINAPPDRIVER_POLL_SEC)
			elapsed += WINAPPDRIVER_POLL_SEC
		}

		KeywordUtil.markFailedAndStop("WinAppDriver did not start listening within ${WINAPPDRIVER_START_TIMEOUT_SEC} seconds.")
	}

	private void launchDetached(String targetPath) {
		if (blank(targetPath)) {
			throw new RuntimeException('Target path is empty.')
		}

		new ProcessBuilder(
			'cmd',
			'/c',
			'start "" "' + targetPath + '"'
		).start()
	}

	private boolean isPortOpen(String host, int port, int timeoutMs) {
		Socket socket = null

		try {
			socket = new Socket()
			socket.connect(new InetSocketAddress(host, port), timeoutMs)
			return true
		}
		catch (Exception ignored) {
			return false
		}
		finally {
			try {
				socket?.close()
			}
			catch (Exception ignored) {
			}
		}
	}

	private String escapeXpathText(String value) {
		return safe(value).replace("'", "&apos;")
	}

	private String readGlobal(String name) {
		try {
			def value = GlobalVariable."${name}"
			return value == null ? '' : String.valueOf(value).trim()
		}
		catch (Exception ignored) {
			return ''
		}
	}

	private String firstNonBlank(String... values) {
		if (values == null) {
			return ''
		}

		for (String value : values) {
			if (!blank(value)) {
				return value
			}
		}

		return ''
	}

	private boolean blank(String value) {
		return safe(value).isEmpty()
	}

	private String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}
}
