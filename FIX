@echo off
setlocal EnableExtensions EnableDelayedExpansion

set "JOB_LABEL=Archive Mode"
set "TEST_SUITE_COLLECTION=Test Suites/Archive Mode/Archive Mode Collection"
set "EXECUTION_PROFILE=default"
set "BROWSER_TYPE=Windows"

set "STARTER_DIR=D:\Projects\eMatchStarters"
set "GENERIC_TASK=\eMatch Automation\RunEMatchCommand"
set "WIN_DRIVER_TASK=startWinDriver"
set "WAIT_SECONDS=5"
set "MAX_WAIT_CYCLES=720"

echo.
echo ==================================================
echo [INFO] Starting %JOB_LABEL%
echo [INFO] WORKSPACE=%WORKSPACE%
echo [INFO] TEST_SUITE_COLLECTION=%TEST_SUITE_COLLECTION%
echo ==================================================
echo.

if "%WORKSPACE%"=="" (
    echo [ERROR] WORKSPACE is empty.
    exit /b 1
)

if not exist "%STARTER_DIR%" (
    echo [ERROR] STARTER_DIR not found: %STARTER_DIR%
    exit /b 1
)

if not exist "%STARTER_DIR%\logs" mkdir "%STARTER_DIR%\logs"

> "%STARTER_DIR%\run-context.properties" (
    echo JOB_LABEL=%JOB_LABEL%
    echo WORKSPACE=%WORKSPACE%
    echo TEST_SUITE_COLLECTION=%TEST_SUITE_COLLECTION%
    echo EXECUTION_PROFILE=%EXECUTION_PROFILE%
    echo BROWSER_TYPE=%BROWSER_TYPE%
    echo KATALON_HOME=C:\Users\adgi5appjenkins\Documents\Katalon_Studio_Engine_Windows_64-8.1.0
)

> "%STARTER_DIR%\run-result.properties" (
    echo STATUS=QUEUED
    echo EXIT_CODE=999
    echo UPDATED_AT=%date% %time%
)

echo [INFO] Starting WinAppDriver task...
schtasks /run /tn "%WIN_DRIVER_TASK%" >nul 2>nul
if errorlevel 1 (
    echo [ERROR] Could not start scheduled task "%WIN_DRIVER_TASK%".
    exit /b 1
)

echo [INFO] Starting visible Katalon task...
schtasks /run /tn "%GENERIC_TASK%" >nul 2>nul
if errorlevel 1 (
    echo [ERROR] Could not start scheduled task "%GENERIC_TASK%".
    schtasks /end /tn "%WIN_DRIVER_TASK%" >nul 2>nul
    exit /b 1
)

ping -n 4 127.0.0.1 >nul

set /a WAIT_COUNT=0
set /a PING_WAIT=%WAIT_SECONDS%+1

:waitLoop
set "TASK_STATUS="

for /f "tokens=2,* delims=: " %%A in ('schtasks /query /tn "%GENERIC_TASK%" /fo list ^| findstr /i /b /c:"Status:"') do (
    set "TASK_STATUS=%%B"
)

if /i "!TASK_STATUS!"=="Running" (
    set /a WAIT_COUNT+=1

    if !WAIT_COUNT! EQU 1 echo [INFO] Visible task is running...
    if !WAIT_COUNT! EQU 2 echo [INFO] Waiting for visible task to finish...
    if !WAIT_COUNT! EQU 3 echo [INFO] Still running...
    if !WAIT_COUNT! EQU 4 echo [INFO] Still running...
    if !WAIT_COUNT! EQU 5 echo [INFO] Still running...

    if !WAIT_COUNT! GEQ %MAX_WAIT_CYCLES% (
        echo [ERROR] Timeout waiting for "%GENERIC_TASK%".
        schtasks /end /tn "%GENERIC_TASK%" >nul 2>nul
        schtasks /end /tn "%WIN_DRIVER_TASK%" >nul 2>nul
        exit /b 1
    )

    ping -n !PING_WAIT! 127.0.0.1 >nul
    goto waitLoop
)

echo [INFO] Visible task finished.
echo.

echo [INFO] Scheduled task result:
schtasks /query /tn "%GENERIC_TASK%" /fo list | findstr /i /b /c:"Last Run Time:" /c:"Last Result:"
echo.

schtasks /end /tn "%WIN_DRIVER_TASK%" >nul 2>nul

ping -n 3 127.0.0.1 >nul

if not exist "%STARTER_DIR%\run-result.properties" (
    echo [ERROR] run-result.properties not found.
    exit /b 1
)

for /f "usebackq tokens=1,* delims==" %%A in ("%STARTER_DIR%\run-result.properties") do (
    set "%%A=%%B"
)

echo [INFO] STATUS=!STATUS!
echo [INFO] EXIT_CODE=!EXIT_CODE!

if "!EXIT_CODE!"=="999" (
    echo [ERROR] run-ematch-command.bat did not update the result file correctly.

    if exist "%STARTER_DIR%\logs\run-ematch-command.log" (
        echo.
        echo [INFO] Last lines from run-ematch-command.log:
        powershell -NoProfile -Command "Get-Content -Path '%STARTER_DIR%\logs\run-ematch-command.log' -Tail 20"
        echo.
    )

    exit /b 1
)

if not "!EXIT_CODE!"=="0" (
    if exist "%STARTER_DIR%\logs\run-ematch-command.log" (
        echo.
        echo [INFO] Last lines from run-ematch-command.log:
        powershell -NoProfile -Command "Get-Content -Path '%STARTER_DIR%\logs\run-ematch-command.log' -Tail 20"
        echo.
    )

    exit /b !EXIT_CODE!
)

echo [INFO] %JOB_LABEL% finished successfully.
exit /b 0
