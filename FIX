@Keyword
void closeAllTabsAndOpenFavorite(
	String favoriteTitle,
	String openedTabName,
	String favoriteImageKey,
	Integer timeoutSeconds
) {

	Integer favoriteTimeout =
		timeoutSeconds == null || timeoutSeconds <= 0
			? 40
			: timeoutSeconds

	Integer maxCloseAttempts = 3

	logStep(
		'OPEN FAVORITE',
		'Favorite: ' + favoriteTitle + '\n' +
		'Tab to close: ' + openedTabName
	)

	WindowsTestObject openedTab =
		WindowsObjectLoader.getTabByName(
			openedTabName
		)

	WindowsTestObject closeAllTabsButton =
		object('closeAllTabsTopBar')

	// ======================================================
	// CLOSE FAVORITE CREATION MODAL
	// ======================================================

	KeywordUtil.logInfo(
		'[WAIT] Waiting 5 seconds before closing favorite modal.'
	)

	Windows.delay(5)

	KeywordUtil.logInfo(
		'[KEYBOARD] Pressing ENTER to close favorite creation modal.'
	)

	pressKeyboardKey(
		KeyEvent.VK_ENTER
	)

	Windows.delay(3)

	// ======================================================
	// CLOSE ALL TABS
	// ======================================================

	boolean tabClosed = false

	for (
		Integer attempt = 1;
		attempt <= maxCloseAttempts;
		attempt++
	) {

		boolean tabStillVisible =
			Windows.waitForElementPresent(
				openedTab,
				2,
				FailureHandling.OPTIONAL
			)

		if (!tabStillVisible) {
			tabClosed = true

			KeywordUtil.logInfo(
				'[PASS] Target tab is closed.\n' +
				'Tab: ' + openedTabName
			)

			break
		}

		KeywordUtil.logInfo(
			'[OBJECT] Target tab is still visible.\n' +
			'Clicking Close All Tabs.\n' +
			'Attempt: ' + attempt + '/' + maxCloseAttempts
		)

		if (!Windows.waitForElementPresent(
			closeAllTabsButton,
			5,
			FailureHandling.OPTIONAL
		)) {
			takeEvidence(
				'GUI_CloseAllTabsButtonNotFound_' +
				attempt +
				'.png'
			)

			KeywordUtil.logInfo(
				'[FAIL] Close All Tabs button was not found.\n' +
				'Attempt: ' + attempt
			)

			continue
		}

		Windows.click(
			closeAllTabsButton,
			FailureHandling.STOP_ON_FAILURE
		)

		Windows.delay(5)

		KeywordUtil.logInfo(
			'[KEYBOARD] Pressing ENTER on Close All Tabs confirmation.\n' +
			'Attempt: ' + attempt
		)

		pressKeyboardKey(
			KeyEvent.VK_ENTER
		)

		Windows.delay(5)

		tabStillVisible =
			Windows.waitForElementPresent(
				openedTab,
				2,
				FailureHandling.OPTIONAL
			)

		if (!tabStillVisible) {
			tabClosed = true

			KeywordUtil.logInfo(
				'[PASS] Target tab closed successfully.\n' +
				'Attempt: ' + attempt
			)

			break
		}

		KeywordUtil.logInfo(
			'[INFO] Target tab is still visible after attempt ' +
				attempt +
				'. Retrying.'
		)
	}

	if (!tabClosed) {
		takeEvidence(
			'GUI_TargetTabStillOpen.png'
		)

		KeywordUtil.markFailedAndStop(
			'Target tab is still open after 3 attempts.\n' +
				'Tab: ' + openedTabName
		)

		return
	}

	// ======================================================
	// OPEN FAVORITES TAB
	// ======================================================

	WindowsTestObject favoritesTab =
		object('favoritesTab')

	if (!Windows.waitForElementPresent(
		favoritesTab,
		5,
		FailureHandling.OPTIONAL
	)) {
		takeEvidence(
			'GUI_FavoritesTabNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorites tab was not found.'
		)

		return
	}

	KeywordUtil.logInfo(
		'[OBJECT] Clicking Favorites tab.'
	)

	Windows.click(
		favoritesTab,
		FailureHandling.STOP_ON_FAILURE
	)

	Windows.delay(3)

	// ======================================================
	// OPEN CREATED FAVORITE
	// ======================================================

	WindowsTestObject favoriteItem =
		WindowsObjectLoader.getTreeItemByName(
			favoriteTitle
		)

	KeywordUtil.logInfo(
		'[OBJECT] Waiting for created favorite.\n' +
		'Favorite: ' + favoriteTitle + '\n' +
		'Timeout: ' + favoriteTimeout + ' seconds'
	)

	boolean favoriteFound =
		Windows.waitForElementPresent(
			favoriteItem,
			favoriteTimeout,
			FailureHandling.OPTIONAL
		)

	if (favoriteFound) {

		KeywordUtil.logInfo(
			'[PASS] Favorite found by XPath.'
		)

		Windows.click(
			favoriteItem,
			FailureHandling.STOP_ON_FAILURE
		)

	} else {

		KeywordUtil.logInfo(
			'[INFO] Favorite not found by XPath. Trying image.\n' +
			'Image: guiBehavior.' + favoriteImageKey
		)

		boolean favoriteImageFound =
			imageLoader.waitForImage(
				GUI_IMAGE_GROUP,
				favoriteImageKey,
				5
			)

		if (!favoriteImageFound) {
			takeEvidence(
				'GUI_CreatedFavoriteNotFound.png'
			)

			KeywordUtil.markFailedAndStop(
				'Created favorite was not found.\n' +
					'Favorite: ' + favoriteTitle
			)

			return
		}

		WindowsImageKeywords.clickImage(
			image(
				GUI_IMAGE_GROUP,
				favoriteImageKey
			)
		)
	}

	Windows.delay(5)

	// ======================================================
	// VALIDATE OPENED TAB
	// ======================================================

	if (!Windows.waitForElementPresent(
		openedTab,
		favoriteTimeout,
		FailureHandling.OPTIONAL
	)) {
		takeEvidence(
			'GUI_FavoriteTabNotOpened.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorite was clicked, but target tab did not open.\n' +
				'Favorite: ' + favoriteTitle + '\n' +
				'Expected tab: ' + openedTabName
		)

		return
	}

	takeEvidence(
		'GUI_CreatedFavoriteOpened.png'
	)

	KeywordUtil.markPassed(
		'Favorite opened successfully.\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'Tab: ' + openedTabName
	)
}
