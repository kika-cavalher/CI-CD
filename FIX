package common

import static com.kms.katalon.core.testobject.ObjectRepository.findTestObject

import java.util.Arrays

import org.openqa.selenium.Keys

import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.TestObject
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI

import cucumber.api.java.en.Given
import cucumber.api.java.en.Then
import cucumber.api.java.en.When

class Navigation {

	private static final int DEFAULT_TIMEOUT = 60
	private static final int SHORT_TIMEOUT = 10

	private String currentDatabaseName = ''

	@Given("Hue home is opened")
	def hueHomeIsOpenedStep() {
		verifyHueIsAlreadyOpened()
	}

	@Given("Hue editor page is opened")
	def hueEditorPageIsOpenedStep() {
		verifyHueEditorIsAlreadyOpened()
	}

	@When('^user searches for database "([^"]*)"$')
	def userSearchesForDatabaseStep(String databaseName) {
		searchDatabase(databaseName)
	}

	@When("user searches for the configured default database")
	def userSearchesForConfiguredDefaultDatabaseStep() {
		searchDatabase(currentDatabaseName)
	}

	@When('^user selects database "([^"]*)"$')
	def userSelectsDatabaseStep(String databaseName) {
		selectDatabase(databaseName)
	}

	@When("user selects the first database result")
	def userSelectsFirstDatabaseResultStep() {
		selectDatabase(currentDatabaseName)
	}

	@Then('^selected database title should be "([^"]*)"$')
	def selectedDatabaseTitleShouldBeStep(String databaseName) {
		validateSelectedDatabaseTitle(databaseName)
	}

	@Then("selected database title should be displayed")
	def selectedDatabaseTitleShouldBeDisplayedStep() {
		validateSelectedDatabaseTitle(currentDatabaseName)
	}

	@Given('^database menu "([^"]*)" is selected$')
	def databaseMenuIsSelectedStep(String databaseName) {
		KeywordUtil.logInfo("Starting database menu selection flow for: " + databaseName)

		verifyHueIsAlreadyOpened()
		searchDatabase(databaseName)
		selectDatabase(databaseName)
		validateSelectedDatabaseTitle(databaseName)

		KeywordUtil.logInfo("Database menu selection flow completed successfully for: " + databaseName)
	}

	private void verifyHueIsAlreadyOpened() {
		KeywordUtil.logInfo("Verifying Hue is already opened")

		WebUI.waitForPageLoad(DEFAULT_TIMEOUT)

		String currentUrl = WebUI.getUrl()
		KeywordUtil.logInfo("Current URL: " + currentUrl)

		if (!currentUrl.contains('/hue/')) {
			KeywordUtil.markFailedAndStop("Hue is not opened. Current URL: " + currentUrl)
		}

		KeywordUtil.logInfo("Hue is already opened")
	}

	private void verifyHueEditorIsAlreadyOpened() {
		KeywordUtil.logInfo("Verifying Hue editor page is already opened")

		WebUI.waitForPageLoad(DEFAULT_TIMEOUT)

		String currentUrl = WebUI.getUrl()
		KeywordUtil.logInfo("Current URL: " + currentUrl)

		if (!currentUrl.contains('/hue/editor')) {
			KeywordUtil.markFailedAndStop("Hue editor page is not opened. Current URL: " + currentUrl)
		}

		KeywordUtil.logInfo("Hue editor page is already opened")
	}

	private void searchDatabase(String databaseName) {
		databaseName = normalizeDatabaseName(databaseName)
		currentDatabaseName = databaseName

		KeywordUtil.logInfo("Searching database: " + databaseName)

		WebUI.waitForElementVisible(
			findTestObject('Home/input_DatabaseSearch'),
			DEFAULT_TIMEOUT,
			FailureHandling.STOP_ON_FAILURE
		)

		WebUI.click(findTestObject('Home/input_DatabaseSearch'))

		clearDatabaseSearchInput()

		WebUI.sendKeys(
			findTestObject('Home/input_DatabaseSearch'),
			databaseName
		)

		WebUI.delay(1)

		WebUI.waitForElementPresent(
			findTestObject('Home/option_DatabaseByName', [('databaseName') : databaseName]),
			DEFAULT_TIMEOUT,
			FailureHandling.STOP_ON_FAILURE
		)

		KeywordUtil.logInfo("Database was found in the result list: " + databaseName)
	}

	private void selectDatabase(String databaseName) {
		databaseName = normalizeDatabaseName(databaseName)
		currentDatabaseName = databaseName

		KeywordUtil.logInfo("Selecting database: " + databaseName)

		TestObject databaseOption = findTestObject(
			'Home/option_DatabaseByName',
			[('databaseName') : databaseName]
		)

		WebUI.waitForElementPresent(
			databaseOption,
			DEFAULT_TIMEOUT,
			FailureHandling.STOP_ON_FAILURE
		)

		try {
			WebUI.waitForElementClickable(
				databaseOption,
				SHORT_TIMEOUT,
				FailureHandling.STOP_ON_FAILURE
			)

			WebUI.click(databaseOption)
		} catch (Exception e) {
			KeywordUtil.logInfo("Normal click failed. Trying JavaScript click.")

			WebUI.executeJavaScript(
				"arguments[0].click();",
				Arrays.asList(WebUI.findWebElement(databaseOption, DEFAULT_TIMEOUT))
			)
		}

		WebUI.delay(2)
		WebUI.waitForPageLoad(DEFAULT_TIMEOUT)

		KeywordUtil.logInfo("Database was selected: " + databaseName)
	}

	private void validateSelectedDatabaseTitle(String databaseName) {
		databaseName = normalizeDatabaseName(databaseName)
		currentDatabaseName = databaseName

		KeywordUtil.logInfo("Validating selected database title")
		KeywordUtil.logInfo("Expected database: " + databaseName)

		TestObject selectedTitleObject = findTestObject(
			'Home/title_SelectedDatabase',
			[('databaseName') : databaseName]
		)

		WebUI.waitForElementVisible(
			selectedTitleObject,
			DEFAULT_TIMEOUT,
			FailureHandling.STOP_ON_FAILURE
		)

		String actualTitle = WebUI.getAttribute(
			selectedTitleObject,
			'title'
		)

		if (actualTitle == null || actualTitle.trim().length() == 0) {
			actualTitle = WebUI.getText(selectedTitleObject)
		}

		actualTitle = actualTitle.trim()

		KeywordUtil.logInfo("Actual selected database title: " + actualTitle)

		if (!actualTitle.equals(databaseName)) {
			KeywordUtil.markFailedAndStop(
				"Wrong selected database. Expected: " + databaseName + " | Actual: " + actualTitle
			)
		}

		KeywordUtil.logInfo("Selected database title was validated successfully")
	}

	private void clearDatabaseSearchInput() {
		KeywordUtil.logInfo("Clearing database search input")

		TestObject searchInput = findTestObject('Home/input_DatabaseSearch')

		WebUI.click(searchInput)

		WebUI.sendKeys(searchInput, Keys.chord(Keys.CONTROL, 'a'))
		WebUI.sendKeys(searchInput, Keys.DELETE)

		WebUI.delay(1)
	}

	private String normalizeDatabaseName(String databaseName) {
		String normalizedDatabaseName = databaseName == null ? '' : databaseName.trim()

		if (normalizedDatabaseName.length() == 0) {
			KeywordUtil.markFailedAndStop("Database name is empty")
		}

		return normalizedDatabaseName
	}
}




