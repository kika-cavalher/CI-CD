package jiraIntegration

import java.util.Locale

class JiraHtmlTemplateBuilder {

	String build(Map model) {
		Map summary = model?.summary instanceof Map ? model.summary as Map : [:]
		List<Map> scenarios = model?.scenarios instanceof List ? model.scenarios as List<Map> : []

		StringBuilder html = new StringBuilder()

		html << '<!DOCTYPE html>'
		html << '<html lang="en">'
		html << '<head>'
		html << '<meta charset="UTF-8">'
		html << '<meta name="viewport" content="width=device-width, initial-scale=1.0">'
		html << '<title>' << escape(model?.reportTitle ?: 'Test report') << '</title>'
		html << buildStyle()
		html << '</head>'
		html << '<body>'

		html << '<main class="app-shell">'
		html << buildSidebar(model, scenarios)
		html << '<section class="content-area">'
		html << buildHeader(model)
		html << buildSummary(summary)
		html << buildScenarioContent(scenarios)
		html << '</section>'
		html << '</main>'

		html << '</body>'
		html << '</html>'

		return html.toString()
	}

	private String buildSidebar(Map model, List<Map> scenarios) {
		StringBuilder html = new StringBuilder()

		String suiteName = safe(model?.suiteName ?: 'Execution')
		String generatedAt = safe(model?.generatedAt)
		String logoSrc = safe(model?.logoSrc)

		html << '<aside class="sidebar">'
		html << '<div class="brand-block">'

		if (!isBlank(logoSrc)) {
			html << '<img class="brand-logo-img" src="' << attr(logoSrc) << '" alt="Project logo">'
		} else {
			html << '<div class="brand-logo-text">Hue</div>'
		}

		html << '<div class="brand-info">'
		html << '<strong>' << escape(suiteName) << '</strong>'
		html << '<span>Automated report</span>'
		html << '</div>'
		html << '</div>'

		html << '<div class="sidebar-section">'
		html << '<div class="sidebar-title">Execution</div>'
		html << '<div class="sidebar-meta">'
		html << '<span>Generated</span>'
		html << '<strong>' << escape(generatedAt) << '</strong>'
		html << '</div>'
		html << '</div>'

		html << '<div class="sidebar-section">'
		html << '<div class="sidebar-title">Tests</div>'
		html << '<div class="test-list">'

		if (scenarios == null || scenarios.isEmpty()) {
			html << '<div class="test-list-empty">No tests found</div>'
		} else {
			scenarios.eachWithIndex { Map scenario, int index ->
				html << buildSidebarScenarioItem(scenario, index + 1)
			}
		}

		html << '</div>'
		html << '</div>'

		html << '</aside>'

		return html.toString()
	}

	private String buildSidebarScenarioItem(Map scenario, int index) {
		StringBuilder html = new StringBuilder()

		String status = normalizeStatus(scenario?.status)
		String title = safe(scenario?.title)
		String duration = safe(scenario?.durationLabel)

		html << '<a class="test-list-item ' << attr(status) << '" href="#scenario-' << index << '">'
		html << '<div>'
		html << '<strong>' << escape(title) << '</strong>'
		if (!isBlank(duration)) {
			html << '<span>' << escape(duration) << '</span>'
		}
		html << '</div>'
		html << '<em class="' << attr(status) << '">' << escape(status) << '</em>'
		html << '</a>'

		return html.toString()
	}

	private String buildHeader(Map model) {
		StringBuilder html = new StringBuilder()

		String reportTitle = safe(model?.reportTitle ?: 'Test report')
		String subtitle = safe(model?.subtitle ?: 'Execution overview')
		String reportFolder = safe(model?.reportFolder)

		html << '<header class="hero-banner">'
		html << '<div class="hero-content">'
		html << '<div class="hero-kicker">'
		html << '<span class="hue-dot"></span>'
		html << '<span>Hue automation report</span>'
		html << '</div>'
		html << '<h1>' << escape(reportTitle) << '</h1>'
		html << '<p>' << escape(subtitle) << '</p>'
		html << '</div>'

		if (!isBlank(reportFolder)) {
			html << '<div class="hero-folder">'
			html << '<span>Report folder</span>'
			html << '<strong>' << escape(reportFolder) << '</strong>'
			html << '</div>'
		}

		html << '</header>'

		return html.toString()
	}

	private String buildSummary(Map summary) {
		StringBuilder html = new StringBuilder()

		html << '<section class="summary-grid">'
		html << buildSummaryCard('Total tests', summary?.total, 'total')
		html << buildSummaryCard('Passed', summary?.passed, 'passed')
		html << buildSummaryCard('Failed', summary?.failed, 'failed')
		html << buildSummaryCard('Skipped', summary?.skipped, 'skipped')
		html << buildSummaryCard('Duration', summary?.durationLabel, 'duration')
		html << buildSummaryCard('Start', summary?.startLabel, 'start')
		html << buildSummaryCard('End', summary?.endLabel, 'end')
		html << '</section>'

		return html.toString()
	}

	private String buildSummaryCard(String label, def value, String type) {
		String displayValue = safe(value)

		if (isBlank(displayValue)) {
			displayValue = '0'
		}

		StringBuilder html = new StringBuilder()
		html << '<article class="summary-card ' << attr(type) << '">'
		html << '<span>' << escape(label) << '</span>'
		html << '<strong>' << escape(displayValue) << '</strong>'
		html << '</article>'

		return html.toString()
	}

	private String buildScenarioContent(List<Map> scenarios) {
		StringBuilder html = new StringBuilder()

		html << '<section class="section-heading">'
		html << '<div>'
		html << '<span>Execution details</span>'
		html << '<h2>Tests</h2>'
		html << '</div>'
		html << '</section>'

		html << '<section class="scenario-list">'

		if (scenarios == null || scenarios.isEmpty()) {
			html << '<article class="empty-state">'
			html << '<h3>No scenarios were found</h3>'
			html << '<p>The report could not read scenarios from the execution log or XML result.</p>'
			html << '</article>'
		} else {
			scenarios.eachWithIndex { Map scenario, int index ->
				html << buildScenarioCard(scenario, index + 1)
			}
		}

		html << '</section>'

		return html.toString()
	}

	private String buildScenarioCard(Map scenario, int index) {
		StringBuilder html = new StringBuilder()

		String status = normalizeStatus(scenario?.status)
		String title = safe(scenario?.title)
		String duration = safe(scenario?.durationLabel)
		String start = safe(scenario?.startLabel)
		String end = safe(scenario?.endLabel)
		String errorShort = safe(scenario?.errorShort)
		String errorFull = safe(scenario?.errorFull)

		List<Map> steps = scenario?.steps instanceof List ? scenario.steps as List<Map> : []
		List<Map> evidences = scenario?.evidences instanceof List ? scenario.evidences as List<Map> : []

		html << '<article id="scenario-' << index << '" class="scenario-card ' << attr(status) << '">'

		html << '<div class="scenario-header">'
		html << '<div>'
		html << '<div class="scenario-number">Scenario #' << index << '</div>'
		html << '<h3>' << escape(title) << '</h3>'
		html << '</div>'
		html << '<span class="status-pill ' << attr(status) << '">' << escape(statusIcon(status) + ' ' + status.toUpperCase(Locale.ENGLISH)) << '</span>'
		html << '</div>'

		html << '<div class="scenario-pills">'
		html << buildScenarioPill('Suite', safe(scenario?.suiteName), 'suite')
		html << buildScenarioPill('Status', status.toUpperCase(Locale.ENGLISH), status)
		html << buildScenarioPill('Start', start, 'start')
		html << buildScenarioPill('End', end, 'end')
		html << buildScenarioPill('Duration', duration, 'duration')
		html << '</div>'

		if (!isBlank(errorShort)) {
			html << '<div class="error-box">'
			html << '<strong>Error summary</strong>'
			html << '<p>' << escape(errorShort) << '</p>'
			html << '</div>'
		}

		if (!isBlank(errorFull)) {
			html << '<details class="details-box">'
			html << '<summary>Full error details</summary>'
			html << '<pre>' << escape(errorFull) << '</pre>'
			html << '</details>'
		}

		html << buildEvidenceBlock(evidences)
		html << buildStepsBlock(steps)

		html << '</article>'

		return html.toString()
	}

	private String buildScenarioPill(String label, String value, String type) {
		if (isBlank(value)) {
			return ''
		}

		StringBuilder html = new StringBuilder()
		html << '<div class="scenario-pill ' << attr(type) << '">'
		html << '<span>' << escape(label) << '</span>'
		html << '<strong>' << escape(value) << '</strong>'
		html << '</div>'

		return html.toString()
	}

	private String buildEvidenceBlock(List<Map> evidences) {
		if (evidences == null || evidences.isEmpty()) {
			return ''
		}

		StringBuilder html = new StringBuilder()

		html << '<div class="evidence-section">'
		html << '<h4>Visual evidence</h4>'
		html << '<div class="evidence-grid">'

		evidences.each { Map evidence ->
			html << buildEvidenceItem(evidence)
		}

		html << '</div>'
		html << '</div>'

		return html.toString()
	}

	private String buildEvidenceItem(Map evidence) {
		StringBuilder html = new StringBuilder()

		String name = safe(evidence?.name ?: evidence?.fileName ?: 'Evidence')
		String href = safe(evidence?.href)
		String imgSrc = safe(evidence?.imgSrc ?: evidence?.imageSrc ?: evidence?.imageDataUri)

		html << '<figure class="evidence-item">'

		if (!isBlank(href)) {
			html << '<a href="' << attr(href) << '" target="_blank">'
		}

		if (!isBlank(imgSrc)) {
			html << '<img src="' << attr(imgSrc) << '" alt="' << attr(name) << '">'
		} else {
			html << '<div class="evidence-placeholder">Image evidence</div>'
		}

		if (!isBlank(href)) {
			html << '</a>'
		}

		html << '<figcaption>' << escape(name) << '</figcaption>'
		html << '</figure>'

		return html.toString()
	}

	private String buildStepsBlock(List<Map> steps) {
		StringBuilder html = new StringBuilder()

		html << '<div class="steps-section">'
		html << '<h4>Steps</h4>'

		if (steps == null || steps.isEmpty()) {
			html << '<p class="muted">No step details were found.</p>'
		} else {
			html << '<div class="steps-table">'
			html << '<div class="steps-table-header">'
			html << '<span>Status</span>'
			html << '<span>Timestamp</span>'
			html << '<span>Details</span>'
			html << '</div>'

			steps.eachWithIndex { Map step, int index ->
				html << buildStepRow(step, index + 1)
			}

			html << '</div>'
		}

		html << '</div>'

		return html.toString()
	}

	private String buildStepRow(Map step, int index) {
		StringBuilder html = new StringBuilder()

		String status = normalizeStatus(step?.status)
		String title = safe(step?.title)
		String emoji = safe(step?.emoji)
		String time = safe(step?.timeLabel)
		String duration = safe(step?.durationLabel)
		String shortError = safe(step?.shortError)
		String detailText = safe(step?.detailText)
		String errorFull = safe(step?.errorFull)

		if (isBlank(emoji)) {
			emoji = '🔹'
		}

		html << '<div class="steps-table-row ' << attr(status) << '">'
		html << '<div>'
		html << '<span class="row-status ' << attr(status) << '">' << escape(status) << '</span>'
		html << '</div>'

		html << '<div class="row-time">'
		html << escape(time)
		if (!isBlank(duration)) {
			html << '<small>' << escape(duration) << '</small>'
		}
		html << '</div>'

		html << '<div class="row-details">'
		html << '<strong>' << escape(emoji) << ' ' << index << '. ' << escape(title) << '</strong>'

		if (!isBlank(shortError)) {
			html << '<p class="step-error">' << escape(shortError) << '</p>'
		}

		if (!isBlank(errorFull)) {
			html << '<details class="step-details">'
			html << '<summary>Error details</summary>'
			html << '<pre>' << escape(errorFull) << '</pre>'
			html << '</details>'
		} else if (!isBlank(detailText)) {
			html << '<details class="step-details">'
			html << '<summary>Step details</summary>'
			html << '<pre>' << escape(detailText) << '</pre>'
			html << '</details>'
		}

		html << '</div>'
		html << '</div>'

		return html.toString()
	}

	private String normalizeStatus(def value) {
		String status = safe(value).toLowerCase(Locale.ENGLISH)

		if (status == 'passed') return 'passed'
		if (status == 'failed') return 'failed'
		if (status == 'skipped') return 'skipped'
		if (status == 'info') return 'info'

		return 'skipped'
	}

	private String statusIcon(String status) {
		if (status == 'passed') return '✓'
		if (status == 'failed') return '✕'
		if (status == 'skipped') return '↷'
		if (status == 'info') return 'i'
		return 'i'
	}

	private String safe(def value) {
		return value == null ? '' : String.valueOf(value).trim()
	}

	private boolean isBlank(def value) {
		return safe(value).isEmpty()
	}

	private String escape(def value) {
		String text = safe(value)
		return text
				.replace('&', '&amp;')
				.replace('<', '&lt;')
				.replace('>', '&gt;')
				.replace('"', '&quot;')
				.replace("'", '&#39;')
	}

	private String attr(def value) {
		return escape(value)
	}

