        """
    }.join('\n')

    def passWidth  = total ? (passed  * 100.0 / total) : 0
    def failWidth  = total ? (failed  * 100.0 / total) : 0
    def abortWidth = total ? (aborted * 100.0 / total) : 0

    def html = """
