pipeline {
  agent { label 'GI5_SWDCFRNXGI55817' }

  options {
    timestamps()                 // Add timestamps to Jenkins console output
    disableConcurrentBuilds()    // Prevent parallel runs on the same agent
    timeout(time: 75, unit: 'MINUTES')
  }

  environment {
    // Single source of truth for Katalon Engine location
    KATALON_HOME   = 'C:/Users/adgi5appjenkins/Documents/Katalon_Studio_Engine_Windows_64-8.1.0'

    // Project path used by Katalon
    PROJECT_PATH   = 'D:/jenkins/work/workspace/GI5/Gaia/Gaia'

    // Suite Collection to run (fixed, not a parameter)
    TSC_PATH       = 'Test Suites/GAIA TSC'

    // Where Jenkins will keep reports
    REPORT_FOLDER  = 'Reports'
  }

  stages {

    stage('Start Gaia Backend and Frontend') {
      steps {
        // Start backend/frontend via Scheduled Task
        bat 'schtasks /run /tn "GaiaBackFrontSetup"'

        // Short wait for services to boot (1 minute)
        sleep(time: 60, unit: 'SECONDS')
      }
    }

    stage('Checkout gaia-portal') {
      steps {
        // Clean workspace (best effort)
        cleanWs(deleteDirs: true, disableDeferredWipeout: true, notFailBuild: true)

        // Clone repository
        git credentialsId: '965eceec-b3a3-4ec5-8820-a857c87dd80f',
            url: 'https://bitbucket-mut.mycloud.intrabpce.fr/scm/gi5/gaia-portal.git'
      }
    }

    stage('Run GAIA TSC (Katalon)') {
      steps {
        // Run Katalon from Jenkins and stream logs in Console Output
        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
          executeKatalon(
            location: "${env.KATALON_HOME}",
            executeArgs:
              "-projectPath=\"${env.PROJECT_PATH}\" " +
              "-testSuiteCollectionPath=\"${env.TSC_PATH}\" " +
              "-browserType=\"Chrome\" " +
              "-noHeadless " +
              "-consoleLog -logLevel=DEBUG " +
              "-reportFolder=\"${env.PROJECT_PATH}\\\\${env.REPORT_FOLDER}\"",
            version: '',
            x11Display: '',
            xvfbConfiguration: ''
          )
        }
      }
    }
  }

  post {
    always {
      // Archive Katalon reports so you can download them from Jenkins
      archiveArtifacts artifacts: 'Reports/**/*.*', allowEmptyArchive: true

      // Publish JUnit results in Jenkins (best effort)
      junit testResults: 'Reports/**/JUnit_Report.xml', allowEmptyResults: true

      // Quick tail of the latest execution log if it exists (best effort)
      powershell '''
        $ErrorActionPreference="SilentlyContinue"
        $rep = Join-Path $env:WORKSPACE "Reports"
        if (Test-Path $rep) {
          $lastLog = Get-ChildItem $rep -Recurse -Filter "execution*.log" -ErrorAction SilentlyContinue |
                     Sort-Object LastWriteTime -Descending |
                     Select-Object -First 1
          if ($lastLog) {
            Write-Host "[post] Last execution log: $($lastLog.FullName)"
            Get-Content $lastLog.FullName -Tail 120 | ForEach-Object { Write-Host $_ }
          } else {
            Write-Host "[post] No execution*.log found."
          }
        } else {
          Write-Host "[post] Reports folder not found."
        }
        exit 0
      '''
    }
  }
}
