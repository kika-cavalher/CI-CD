	// ---------------------------------------------------------
	// validateMontantCcyBetweenExports
	// ---------------------------------------------------------
	// Uses:
	// Excel columns: Total (ccy), Montant ccy
	// Helpers: validateExcelFile, readMainTotalCcy,
	// detailContainsMontantCcy

	@Keyword
	Map validateMontantCcyBetweenExports(
			String mainFilePath,
			String bilanDetailFilePath,
			String resultatDetailFilePath
		) {

		// Validate input files
		File mainFile = validateExcelFile(
			mainFilePath,
			'Main investigations export'
		)

		File bilanFile = validateExcelFile(
			bilanDetailFilePath,
			'Bilan detail export'
		)

		File resultatFile = validateExcelFile(
			resultatDetailFilePath,
			'Resultat detail export'
		)

		// Read Total (ccy) reference
		BigDecimal mainReference = readMainTotalCcy(mainFile)

		// Compare Bilan detail
		Boolean bilanMatch = detailContainsMontantCcy(
			bilanFile,
			mainReference
		)

		// Compare Resultat detail
		Boolean resultatMatch = detailContainsMontantCcy(
			resultatFile,
			mainReference
		)

		// Validate comparison result
		if (!bilanMatch || !resultatMatch) {
			String errors = ''

			if (!bilanMatch) {
				errors +=
					'\nBilan detail export does not contain Montant ccy matching the main Total (ccy).'
			}

			if (!resultatMatch) {
				errors +=
					'\nResultat detail export does not contain Montant ccy matching the main Total (ccy).'
			}

			KeywordUtil.markFailedAndStop(
				errors +
				'\nExpected absolute rounded value: ' +
				mainReference.abs().setScale(0, RoundingMode.HALF_UP)
			)
		}

		// Result
		return [
			mainFileName     : mainFile.name,
			bilanFileName    : bilanFile.name,
			resultatFileName : resultatFile.name,
			mainTotalCcy     : mainReference,
			bilanMatch       : bilanMatch,
			resultatMatch    : resultatMatch
		]
	}


	// ---------------------------------------------------------
	// validateMontantCcyBetweenExports - Excel helpers
	// ---------------------------------------------------------

	// ---------------------------------------------------------
	// readMainTotalCcy
	// Used by: validateMontantCcyBetweenExports
	// ---------------------------------------------------------

	private BigDecimal readMainTotalCcy(File file) {
		Workbook workbook = null
		FileInputStream inputStream = null

		try {
			inputStream = new FileInputStream(file)
			workbook = WorkbookFactory.create(inputStream)

			if (workbook.numberOfSheets <= 0) {
				KeywordUtil.markFailedAndStop(
					'Main investigations export has no worksheet: ' +
					file.name
				)
			}

			Sheet sheet = workbook.getSheetAt(0)
			HeaderLocation header = findHeader(
				sheet,
				'Total (ccy)'
			)

			if (header == null) {
				KeywordUtil.markFailedAndStop(
					'Column Total (ccy) was not found in main export: ' +
					file.name
				)
			}

			FormulaEvaluator evaluator =
				workbook.creationHelper.createFormulaEvaluator()

			for (Integer rowIndex = header.rowIndex + 1;
				rowIndex <= sheet.lastRowNum;
				rowIndex++) {

				Row row = sheet.getRow(rowIndex)

				if (row == null) {
					continue
				}

				BigDecimal value = numericCellValue(
					row.getCell(header.columnIndex),
					evaluator
				)

				if (value != null) {
					return value
				}
			}

			KeywordUtil.markFailedAndStop(
				'No numeric value was found below Total (ccy) in main export: ' +
				file.name
			)
		} finally {
			try {
				workbook?.close()
			} catch (Throwable ignored) {
			}

			try {
				inputStream?.close()
			} catch (Throwable ignored) {
			}
		}

		return null
	}

	// ---------------------------------------------------------
	// detailContainsMontantCcy
	// Used by: validateMontantCcyBetweenExports
	// ---------------------------------------------------------

	private Boolean detailContainsMontantCcy(
			File file,
			BigDecimal reference
		) {

		Workbook workbook = null
		FileInputStream inputStream = null

		try {
			inputStream = new FileInputStream(file)
			workbook = WorkbookFactory.create(inputStream)

			if (workbook.numberOfSheets <= 0) {
				KeywordUtil.markFailedAndStop(
					'Detail export has no worksheet: ' + file.name
				)
			}

			Sheet sheet = workbook.getSheetAt(0)
			HeaderLocation header = findHeader(
				sheet,
				'Montant ccy'
			)

			if (header == null) {
				KeywordUtil.markFailedAndStop(
					'Column Montant ccy was not found in detail export: ' +
					file.name
				)
			}

			FormulaEvaluator evaluator =
				workbook.creationHelper.createFormulaEvaluator()

			BigDecimal expected = reference.abs().setScale(
				0,
				RoundingMode.HALF_UP
			)

			for (Integer rowIndex = header.rowIndex + 1;
				rowIndex <= sheet.lastRowNum;
				rowIndex++) {

				Row row = sheet.getRow(rowIndex)

				if (row == null) {
					continue
				}

				BigDecimal value = numericCellValue(
					row.getCell(header.columnIndex),
					evaluator
				)

				if (value == null) {
					continue
				}

				BigDecimal actual = value.abs().setScale(
					0,
					RoundingMode.HALF_UP
				)

				if (actual.compareTo(expected) == 0) {
					return true
				}
			}

			return false
		} finally {
			try {
				workbook?.close()
			} catch (Throwable ignored) {
			}

			try {
				inputStream?.close()
			} catch (Throwable ignored) {
			}
		}
	}

	// ---------------------------------------------------------
	// findHeader
	// Used by: readMainTotalCcy, detailContainsMontantCcy
	// ---------------------------------------------------------

	private HeaderLocation findHeader(
			Sheet sheet,
			String expectedHeader
		) {

		DataFormatter formatter =
			new DataFormatter()

		Integer maxRow = Math.min(
			sheet.lastRowNum,
			20
		)

		for (Integer rowIndex = 0;
			rowIndex <= maxRow;
			rowIndex++) {

			Row row = sheet.getRow(rowIndex)

			if (row == null) {
				continue
			}

			for (Cell cell : row) {
				String headerText = safeText(
					formatter.formatCellValue(cell)
				)

				if (headerText.equalsIgnoreCase(expectedHeader)) {
					return new HeaderLocation(
						rowIndex,
						cell.columnIndex
					)
				}
			}
		}

		return null
	}

	// ---------------------------------------------------------
	// numericCellValue
	// Used by: readMainTotalCcy, detailContainsMontantCcy
	// ---------------------------------------------------------

	private BigDecimal numericCellValue(
			Cell cell,
			FormulaEvaluator evaluator
		) {

		if (cell == null) {
			return null
		}

		try {
			if (cell.cellType == CellType.NUMERIC) {
				return BigDecimal.valueOf(
					cell.numericCellValue
				)
			}

			if (cell.cellType == CellType.FORMULA) {
				CellValue evaluated = evaluator.evaluate(cell)

				if (evaluated != null &&
					evaluated.cellType == CellType.NUMERIC) {

					return BigDecimal.valueOf(
						evaluated.numberValue
					)
				}

				if (evaluated != null &&
					evaluated.cellType == CellType.STRING) {

					return parseBigDecimal(
						evaluated.stringValue
					)
				}
			}

			if (cell.cellType == CellType.STRING) {
				return parseBigDecimal(
					cell.stringCellValue
				)
			}

			DataFormatter formatter =
				new DataFormatter()

			return parseBigDecimal(
				formatter.formatCellValue(cell, evaluator)
			)
		} catch (Throwable ignored) {
			return null
		}
	}

	// ---------------------------------------------------------
	// parseBigDecimal
	// Used by: numericCellValue
	// ---------------------------------------------------------

	private BigDecimal parseBigDecimal(Object rawValue) {
		String value = safeText(rawValue)

		if (value.isEmpty()) {
			return null
		}

		value = value
			.replace('\u00A0', '')
			.replace(' ', '')
			.replaceAll('[^0-9,.-]', '')

		if (value.isEmpty() ||
			value.equals('-') ||
			value.equals('.') ||
			value.equals(',')) {

			return null
		}

		Integer lastComma = value.lastIndexOf(',')
		Integer lastDot = value.lastIndexOf('.')

		if (lastComma >= 0 && lastDot >= 0) {
			if (lastComma > lastDot) {
				value = value.replace('.', '')
				value = value.replace(',', '.')
			} else {
				value = value.replace(',', '')
			}
		} else if (lastComma >= 0) {
			value = value.replace(',', '.')
		}

		try {
			return new BigDecimal(value)
		} catch (Throwable ignored) {
			return null
		}
	}





