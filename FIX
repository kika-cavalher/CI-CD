	String buildGaiaReport() {
		String xmlPath = getXmlFilePath()
		if (isBlank(xmlPath)) {
			KeywordUtil.logInfo('Gaia report was not created because XML file was not found.')
			return ''
		}

		String reportPath = getResolvedReportPath()
		if (isBlank(reportPath)) {
			KeywordUtil.logInfo('Gaia report was not created because report folder was not found.')
			return ''
		}

		Map suiteData = parseSuiteData(xmlPath)
		String html = buildGaiaReportHtml(suiteData)

		File output = new File(reportPath + File.separator + GAIA_REPORT_FILE_NAME)
		output.write(html, 'UTF-8')

		KeywordUtil.logInfo("Gaia report created: ${output.absolutePath}")
		return output.absolutePath
	}

