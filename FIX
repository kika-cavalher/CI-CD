				Math.min(timeout, 5)
				)

		if (!expectedRecordAlreadySelected) {
			readTableLiaisonRecordByFilter(
					account,
					timeout
					)
		} else {
			KeywordUtil.logInfo(
					'[MODIFY] Expected Table de Liaison record is already filtered and selected. ' +
					'Reusing the current selection without reopening or clearing the filter.\n' +
					'Compte de bilan: ' +
					account
					)
		}

		tableLiaisonClickObjectThenImage(
				'tableLiaisonModifyButton',
				IMAGE_GROUP,
				'btnModify',
				'Modifier button',
				timeout
				)

		Windows.delay(
				POLLING_DELAY_SECONDS
				)

		tableLiaisonPressTab(
				6
				)

		tableLiaisonReplaceFocusedText(
				newGrappe
				)

		tableLiaisonClickObjectThenImage(
				'tableLiaisonModifyButton',
				IMAGE_GROUP,
				'btnModify',
				'Modifier button',
				timeout
				)

		Windows.delay(
				3
				)

		tableLiaisonFailIfUnexpectedModal(
				'MODIFY',
				timeout
				)

		String actualGrappeColumn = ''
		String actualGrappeForm = ''

		long validationEndTime =
				System.currentTimeMillis() +
				(timeout * 1000L)

		while (System.currentTimeMillis() <= validationEndTime) {
			actualGrappeColumn =
					tableLiaisonReadObjectValue(
					'tableLiaisonGrappeColumn',
					Math.min(timeout, 3)
					)

			actualGrappeForm =
					tableLiaisonReadObjectValue(
					'tableLiaisonGrappeForm',
					Math.min(timeout, 3)
					)

			if (actualGrappeColumn.contains(newGrappe) ||
					actualGrappeForm.contains(newGrappe)) {

				break
			}

			Windows.delay(
					POLLING_DELAY_SECONDS
					)
		}

		if (!actualGrappeColumn.contains(newGrappe) &&
				!actualGrappeForm.contains(newGrappe)) {

			takeEvidence(
					'TableDeLiaison_ModifyWrongGrappe.png'
					)

			KeywordUtil.markFailedAndStop(
