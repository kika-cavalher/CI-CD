1) BAT completo (com quebras de linha) ✅

Cria ou substitui este arquivo:

D:\Projects\eMatchStarters\run-ematch-command.bat

@echo off
setlocal EnableExtensions EnableDelayedExpansion

rem ------------------------------------------------------------------
rem 1) Load context file written by Jenkins
rem ------------------------------------------------------------------
set "CTX_FILE=D:\Projects\eMatchStarters\run-context.properties"

if not exist "%CTX_FILE%" (
  echo [ERROR] Context file not found: "%CTX_FILE%"
  exit /b 2
)

for /f "usebackq tokens=1* delims==" %%A in ("%CTX_FILE%") do (
  set "K=%%A"
  set "V=%%B"
  if not "!K!"=="" set "!K!=!V!"
)

if "%WORKSPACE%"=="" (
  echo [ERROR] WORKSPACE is empty in "%CTX_FILE%"
  exit /b 3
)

rem ------------------------------------------------------------------
rem 2) Prepare folders
rem ------------------------------------------------------------------
set "REPORTS_DIR=%WORKSPACE%\Reports"
set "LOGS_DIR=%REPORTS_DIR%\logs"
set "MARKER=%REPORTS_DIR%\__jenkins_task_exitcode.txt"
set "LOG_FILE=%LOGS_DIR%\desktop_katalon.log"

if not exist "%REPORTS_DIR%" mkdir "%REPORTS_DIR%" >nul 2>&1
if not exist "%LOGS_DIR%"    mkdir "%LOGS_DIR%"    >nul 2>&1

del /f /q "%MARKER%"  >nul 2>&1

echo [INFO] WORKSPACE="%WORKSPACE%"
echo [INFO] PROJECT_FILE="%PROJECT_FILE%"
echo [INFO] KATALON_EXE="%KATALON_EXE%"
echo [INFO] COLLECTION_PATH="%COLLECTION_PATH%"
echo [INFO] BROWSER_TYPE="%BROWSER_TYPE%"
echo [INFO] RETRY="%RETRY%"
echo [INFO] LOG_FILE="%LOG_FILE%"
echo [INFO] MARKER="%MARKER%"

rem ------------------------------------------------------------------
rem 3) Go to workspace and run Katalon
rem ------------------------------------------------------------------
cd /d "%WORKSPACE%"
if errorlevel 1 (
  echo [ERROR] Failed to cd into WORKSPACE: "%WORKSPACE%"
  exit /b 4
)

set "PROJECT_PATH=%WORKSPACE%\%PROJECT_FILE%"

echo [INFO] Running Katalon... > "%LOG_FILE%"

"%KATALON_EXE%" ^
  -noSplash ^
  -runMode=console ^
  -consoleLog ^
  -projectPath="%PROJECT_PATH%" ^
  -testSuiteCollectionPath="%COLLECTION_PATH%" ^
  -browserType="%BROWSER_TYPE%" ^
  -retry=%RETRY% ^
  -reportFolder="%REPORTS_DIR%" ^
  1>> "%LOG_FILE%" 2>&1

set "EC=%ERRORLEVEL%"

echo [INFO] Katalon ExitCode=%EC% >> "%LOG_FILE%"

rem ------------------------------------------------------------------
rem 4) Write marker for Jenkins and exit
rem ------------------------------------------------------------------
> "%MARKER%" echo %EC%

exit /b %EC%
O que esse BAT corrige
não usa pause
não deixa janela aberta por cmd /k
sempre cria Reports\logs
sempre grava o marker com só um número (ex: 0, 1, 4)
