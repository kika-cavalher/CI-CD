package jiraIntegration

import java.text.SimpleDateFormat
import java.util.Locale
import java.util.TimeZone

import com.kms.katalon.core.util.KeywordUtil

class JiraTestPlanManager {

	JiraFlowCoordinator owner
	JiraGateway gateway

	JiraTestPlanManager(JiraFlowCoordinator owner, JiraGateway gateway) {
		this.owner = owner
		this.gateway = gateway
	}

	String findExistingTestPlanKey(String summary) {
		if (owner.FORCE_CREATE_NEW_TEST_PLAN) {
			KeywordUtil.logInfo("FORCE_CREATE_NEW_TEST_PLAN enabled. A new Test Plan will be created.")
			return ''
		}

		if (!owner.isBlank(owner.MANUAL_TEST_PLAN_KEY)) {
			KeywordUtil.logInfo("Using manual Test Plan key: ${owner.MANUAL_TEST_PLAN_KEY}")
			return owner.MANUAL_TEST_PLAN_KEY
		}

		String expectedSummary = owner.normalizeTitle(summary)
		String expectedEpicKey = owner.normalizeTitle(owner.EPIC_KEY)

		List issues = gateway.searchTestPlans(summary, owner.EPIC_KEY)

		if (!(issues instanceof List) || issues.isEmpty()) {
			KeywordUtil.logInfo("No existing Test Plan found for summary '${summary}' inside epic '${owner.EPIC_KEY}'.")
			return ''
		}

		List exactMatches = issues.findAll { issue ->
			isExactMatchingTestPlan(issue, expectedSummary, expectedEpicKey)
		}

		if (exactMatches.isEmpty()) {
			KeywordUtil.logInfo("No exact Test Plan match found for summary '${summary}' inside epic '${owner.EPIC_KEY}'.")
			return ''
		}

		if (exactMatches.size() == 1) {
			String foundKey = owner.safe(exactMatches[0]?.key)
			if (!owner.isBlank(foundKey)) {
				KeywordUtil.logInfo("Exact existing Test Plan found: ${foundKey}")
				return foundKey
			}
			return ''
		}

		List sortedMatches = exactMatches.sort { a, b ->
			long createdA = extractIssueCreatedMillis(a)
			long createdB = extractIssueCreatedMillis(b)

			if (createdA != createdB) {
				return createdB <=> createdA
			}

			long keyA = extractIssueKeyNumber(owner.safe(a?.key))
			long keyB = extractIssueKeyNumber(owner.safe(b?.key))
			return keyB <=> keyA
		}

		Map newest = sortedMatches[0]
		String newestKey = owner.safe(newest?.key)

		KeywordUtil.logInfo("Multiple exact Test Plans found for summary '${summary}' inside epic '${owner.EPIC_KEY}'. Using newest created one: ${newestKey}")
		sortedMatches.each { issue ->
			KeywordUtil.logInfo(
				"Candidate -> key=${owner.safe(issue?.key)}, summary=${owner.safe(issue?.fields?.summary)}, created=${extractIssueCreatedRaw(issue)}"
			)
		}

		return newestKey
	}

	String getOrCreateTestPlanKey() {
		String summary = owner.getTestPlanName()

		String existingKey = findExistingTestPlanKey(summary)
		if (!owner.isBlank(existingKey) && !existingKey.startsWith('ERROR')) {
			KeywordUtil.logInfo("Resolved existing Test Plan for suite ${owner.getCurrentSuiteName()}: ${existingKey}")
			return existingKey
		}

		String createdKey = gateway.createTestPlan(summary, owner.EPIC_KEY)
		if (!owner.isBlank(createdKey) && !createdKey.startsWith('ERROR')) {
			KeywordUtil.logInfo("Created new Test Plan for suite ${owner.getCurrentSuiteName()}: ${createdKey}")
		}

		return createdKey
	}

	private boolean isExactMatchingTestPlan(def issue, String expectedSummary, String expectedEpicKey) {
		String issueSummary = owner.normalizeTitle(owner.safe(issue?.fields?.summary))
		if (issueSummary != expectedSummary) {
			return false
		}

		String issueEpicKey = owner.normalizeTitle(extractEpicKey(issue))

		if (owner.isBlank(expectedEpicKey)) {
			return true
		}

		return !owner.isBlank(issueEpicKey) && issueEpicKey == expectedEpicKey
	}

	private String extractEpicKey(def issue) {
		def fields = issue?.fields

		String parentKey = owner.safe(fields?.parent?.key)
		if (!owner.isBlank(parentKey)) {
			return parentKey
		}

		if (fields instanceof Map) {
			def epicCandidates = [
				fields['customfield_10014'],
				fields['customfield_10008'],
				fields['customfield_10100']
			]

			for (def candidate : epicCandidates) {
				String resolved = extractEpicCandidateValue(candidate)
				if (!owner.isBlank(resolved)) {
					return resolved
				}
			}
		}

		return ''
	}

	private String extractEpicCandidateValue(def candidate) {
		if (candidate == null) {
			return ''
		}

		if (candidate instanceof CharSequence) {
			return owner.safe(candidate)
		}

		if (candidate instanceof Map) {
			String key = owner.safe(candidate.key)
			if (!owner.isBlank(key)) {
				return key
			}

			String value = owner.safe(candidate.value)
			if (!owner.isBlank(value)) {
				return value
			}
		}

		if (candidate instanceof Collection) {
			for (def item : candidate) {
				String resolved = extractEpicCandidateValue(item)
				if (!owner.isBlank(resolved)) {
					return resolved
				}
			}
		}

		return ''
	}

	private String extractIssueCreatedRaw(def issue) {
		return owner.safe(issue?.fields?.created)
	}

	private long extractIssueCreatedMillis(def issue) {
		String raw = extractIssueCreatedRaw(issue)
		if (owner.isBlank(raw)) {
			return 0L
		}

		List<String> patterns = [
			"yyyy-MM-dd'T'HH:mm:ss.SSSZ",
			"yyyy-MM-dd'T'HH:mm:ss.SSSXXX",
			"yyyy-MM-dd'T'HH:mm:ssZ",
			"yyyy-MM-dd'T'HH:mm:ssXXX",
			"yyyy-MM-dd HH:mm:ss.SSS",
			"yyyy-MM-dd HH:mm:ss"
		]

		for (String pattern : patterns) {
			try {
				SimpleDateFormat sdf = new SimpleDateFormat(pattern, Locale.ENGLISH)
				sdf.setLenient(false)
				return sdf.parse(raw).time
			} catch (Exception ignored) {
			}
		}

		return 0L
	}

	private long extractIssueKeyNumber(String issueKey) {
		String value = owner.safe(issueKey)
		if (owner.isBlank(value) || !value.contains('-')) {
			return 0L
		}

		try {
			return Long.parseLong(value.substring(value.lastIndexOf('-') + 1))
		} catch (Exception ignored) {
			return 0L
		}
	}
}

