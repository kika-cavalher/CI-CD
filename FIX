    private static boolean waitForLoginDialog(int timeoutSeconds) {
        long end = System.currentTimeMillis() + (timeoutSeconds * 1000L)
        while (System.currentTimeMillis() < end) {
            try {
                if (Windows.waitForElementPresent(loginDialogObj(), 2)) {
                    return true
                }
            } catch (Throwable ignored) {
            }
            sleepMs(500)
        }
        return false
    }

