	private List<String> getDownloadedFiles() {
		List<String> files = []

		if (GlobalVariable.compareFiles instanceof Collection) {
			files.addAll(
				(GlobalVariable.compareFiles as Collection).collect {
					Object value -> safeText(value)
				}.findAll {
					String value -> !value.isEmpty()
				}
			)
		}

		return files
	}

	private File resolveDownloadedFile(String storedValue) {
		File directFile = new File(storedValue)

		if (directFile.isAbsolute()) {
			return directFile
		}

		File evidenceFolder = new File(
			RunConfiguration.getReportFolder(),
			'Evidences'
		)

		return new File(evidenceFolder, storedValue)
	}


