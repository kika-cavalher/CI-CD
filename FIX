	// ======================================================
	// GROUP BY
	// ======================================================
	
	@Keyword
	void dragAndDropImage(
			String sourceImageKey,
			String targetImageKey,
			Integer waitSeconds
		) {
	
		Integer waitTime = safeTimeout(waitSeconds, 2)
	
		logStep(
				'DRAG AND DROP',
				'Source: ' + sourceImageKey + '\n' +
				'Target: ' + targetImageKey
				)
	
		try {
			WindowsImageKeywords.dragAndDrop(
					image(
					GUI_IMAGE_GROUP,
					sourceImageKey
					),
					image(
					GUI_IMAGE_GROUP,
					targetImageKey
					)
					)
	
			Windows.delay(waitTime)
	
			KeywordUtil.logInfo(
					'[PASS] Drag and drop completed.\n' +
					'Source: ' + sourceImageKey + '\n' +
					'Target: ' + targetImageKey
					)
		} catch (Exception e) {
			takeEvidence(
					'GUI_DragAndDropFailed_' +
					sourceImageKey +
					'.png'
					)
	
			KeywordUtil.markFailedAndStop(
					'Drag and drop failed.\n' +
					'Source: ' + sourceImageKey + '\n' +
					'Target: ' + targetImageKey + '\n' +
					'Reason: ' + safeMessage(e)
					)
		}
	}
	
	
	@Keyword
	void validateGroupByResult(Integer timeoutSeconds) {
	
		List<String> errors = []
	
		logStep(
				'GROUP BY RESULT',
				'Click the first Grappe result row\n' +
				'Validate the first internal row\n' +
				'Expected image or element: secondGroupResultPrefix'
				)
	
		// ======================================================
		// OPEN FIRST GROUP RESULT
		// ======================================================
	
		boolean firstGroupOpened =
				clickGroupByImageOrElement(
				'firstGroupResultRow'
				)
	
		if (!firstGroupOpened) {
			errors.add(
					'The first Group By result row could not be opened.\n' +
					'Image: firstGroupResultRow\n' +
					'Object: firstGroupResultRow'
					)
		}
	
		// ======================================================
		// VALIDATE FIRST INTERNAL ROW
		// ======================================================
	
		if (errors.isEmpty()) {
			boolean secondGroupFound =
					clickGroupByImageOrElement(
					'secondGroupResultPrefix'
					)
	
			if (!secondGroupFound) {
				errors.add(
						'The internal Group By row was not found.\n' +
						'Expected: Ecart bilan vs. compte de résultat ccy\n' +
						'Image: secondGroupResultPrefix\n' +
						'Object: secondGroupResultPrefix'
						)
			}
		}
	
		takeEvidence(
				'GUI_GroupByResultValidated.png'
				)
	
		finishValidation(
				'Group By result validation',
				errors
				)
	}
	
	
	private boolean clickGroupByImageOrElement(
			String imageAndObjectKey
		) {
	
		// ======================================================
		// IMAGE FIRST
		// ======================================================
	
		try {
			WindowsImageKeywords.clickImage(
					image(
					GUI_IMAGE_GROUP,
					imageAndObjectKey
					)
					)
	
			KeywordUtil.logInfo(
					'[PASS] Group By item clicked using image.\n' +
					'Image: ' + imageAndObjectKey
					)
	
			return true
		} catch (Exception imageError) {
			KeywordUtil.logInfo(
					'[INFO] Group By image was not found.\n' +
					'Trying the Windows element.\n' +
					'Image: ' + imageAndObjectKey + '\n' +
					'Reason: ' + safeMessage(imageError)
					)
		}
	
		// ======================================================
		// WINDOWS ELEMENT FALLBACK
		// ======================================================
	
		try {
			WindowsTestObject targetObject =
					object(
					imageAndObjectKey
					)
	
			Windows.click(
					targetObject,
					FailureHandling.STOP_ON_FAILURE
					)
	
			KeywordUtil.logInfo(
					'[PASS] Group By item clicked using Windows element.\n' +
					'Object: ' + imageAndObjectKey
					)
	
			return true
		} catch (Exception objectError) {
			KeywordUtil.logInfo(
					'[INFO] Group By Windows element was not found.\n' +
					'Object: ' + imageAndObjectKey + '\n' +
					'Reason: ' + safeMessage(objectError)
					)
	
			return false
		}
	}
