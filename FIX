package commands

import java.awt.Robot
import java.awt.Toolkit
import java.awt.datatransfer.StringSelection
import java.awt.event.KeyEvent
import java.text.SimpleDateFormat

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

class ExportFile {

	private static final String GENERAL_GROUP = 'General'

	private ImageLoader imageLoader = new ImageLoader()

	@Keyword
	void openExportFromOutils() {
		imageLoader.waitForImageOrStop(GENERAL_GROUP, 'outilsMenu', 15)
		imageLoader.clickImageOrStop(GENERAL_GROUP, 'outilsMenu')
		Windows.delay(2)

		imageLoader.waitForImageOrStop(GENERAL_GROUP, 'exportButton', 15)
		imageLoader.clickImageOrStop(GENERAL_GROUP, 'exportButton')
		Windows.delay(3)

		KeywordUtil.logInfo('Outils menu opened and Export button clicked successfully.')
	}

	@Keyword
	String saveExportedFileWithoutOpening(String baseFileName) {
		String exportPath = buildExportPath(baseFileName)

		waitForFileNameField()
		writeFullPath(exportPath)
		confirmSave()

		handlePossibleSaveConfirmation()
		handleOpenFilePrompt()

		waitForExportedFileOrStop(exportPath, 30)

		KeywordUtil.logInfo('Exported file saved successfully: ' + exportPath)
		return exportPath
	}

	@Keyword
	String executeExportFromOutilsWithoutOpening(String baseFileName) {
		openExportFromOutils()
		return saveExportedFileWithoutOpening(baseFileName)
	}

	private void waitForFileNameField() {
		imageLoader.waitForImageOrStop(GENERAL_GROUP, 'fileName', 20)
		imageLoader.clickImageOrStop(GENERAL_GROUP, 'fileName')
		Windows.delay(1)
	}

	private void writeFullPath(String fullPath) {
		clickCurrentField()
		selectAll()
		pasteText(fullPath)
		Windows.delay(1)
	}

	private void confirmSave() {
		pressEnter()
		Windows.delay(2)
	}

	private void handlePossibleSaveConfirmation() {
		if (imageLoader.isVisible(GENERAL_GROUP, 'saveDialog')) {
			imageLoader.clickImageOrStop(GENERAL_GROUP, 'saveDialog')
			Windows.delay(2)
			KeywordUtil.logInfo('Additional save confirmation handled.')
		}
	}

	private void handleOpenFilePrompt() {
		for (int i = 0; i < 10; i++) {
			if (imageLoader.isVisible(GENERAL_GROUP, 'no')) {
				imageLoader.clickImageOrStop(GENERAL_GROUP, 'no')
				Windows.delay(2)
				KeywordUtil.logInfo('Open file popup handled with "No".')
				return
			}

			if (imageLoader.isVisible(GENERAL_GROUP, 'noEn')) {
				imageLoader.clickImageOrStop(GENERAL_GROUP, 'noEn')
				Windows.delay(2)
				KeywordUtil.logInfo('Open file popup handled with "NoEN".')
				return
			}

			Windows.delay(1)
		}

		KeywordUtil.logInfo('Open file popup did not appear. Continuing.')
	}

	private void waitForExportedFileOrStop(String exportPath, int timeoutSeconds) {
		int elapsed = 0
		File exportedFile = new File(exportPath)

		while (elapsed < timeoutSeconds) {
			if (exportedFile.exists() && exportedFile.length() > 0) {
				return
			}

			Windows.delay(1)
			elapsed++
		}

		imageLoader.takeEvidence('ExportedFileNotCreated.png')

		KeywordUtil.markFailedAndStop(
				'Exported file was not created before timeout.\n' +
				'Expected path: ' + exportPath + '\n' +
				'Timeout: ' + timeoutSeconds + ' seconds'
				)
	}

	private String buildExportPath(String baseFileName) {
		String safeBaseName = sanitizeFileName(baseFileName)
		String timestamp = new SimpleDateFormat('yyyyMMdd_HHmmss').format(new Date())

		String exportDir = RunConfiguration.getReportFolder() + '\\Exports\\'
		new File(exportDir).mkdirs()

		return exportDir + safeBaseName + '_' + timestamp + '.xlsx'
	}

	private String sanitizeFileName(String value) {
		if (value == null || value.trim().isEmpty()) {
			return 'ExportExpandedTable'
		}

		return value.replaceAll('[\\\\/:*?"<>|\\s]+', '_')
	}

	private void clickCurrentField() {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.mousePress(java.awt.event.InputEvent.BUTTON1_DOWN_MASK)
		robot.mouseRelease(java.awt.event.InputEvent.BUTTON1_DOWN_MASK)
	}

	private void selectAll() {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_CONTROL)
	}

	private void pasteText(String text) {
		StringSelection selection = new StringSelection(text)
		Toolkit.getDefaultToolkit().getSystemClipboard().setContents(selection, null)

		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_V)
		robot.keyRelease(KeyEvent.VK_V)
		robot.keyRelease(KeyEvent.VK_CONTROL)
	}

	private void pressEnter() {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_ENTER)
		robot.keyRelease(KeyEvent.VK_ENTER)
	}
}
