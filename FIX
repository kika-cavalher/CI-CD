CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Start Section filter search flow')

def compareFiles = GlobalVariable.compareFiles as ArrayList

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Resolve closing date value')
GlobalVariable.arreteDate == '' ? GlobalVariable.arreteDate = CustomKeywords.'general.MenuHandling.getArreteDateWithSlash'() : GlobalVariable.arreteDate

filterBtn = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/filterBtn.PNG').getAbsolutePath()
selectAllFilter = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/selectAllFilter.PNG').getAbsolutePath()
textFilter = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/textFilter.PNG').getAbsolutePath()
LL2SelectedFilter = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/2llSelectedFilter.PNG').getAbsolutePath()
closeFiltersBtn = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/closeFiltersBtn.PNG').getAbsolutePath()
search = new File(RunConfiguration.getProjectDir(), 'Images/General/Recherce.PNG').getAbsolutePath();

String errors = ''

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Move to Section header area')
WebElement fromElement = Windows.findElement(findWindowsObject('Object Repository/Justification des Comptes de Latent/sectionHeader'))
AppiumDriver<?> driver = Windows.getDriver()
Actions action = new Actions(driver)
action.moveToElement(fromElement).perform()

Windows.delay(3)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Open filter options')
WindowsImageKeywords.clickImage(filterBtn)
Windows.delay(5)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Clear existing filter selection')
WindowsImageKeywords.doubleClickImage(selectAllFilter)
Windows.delay(1)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Type filter value 2LL')
WindowsImageKeywords.typeOnImage(textFilter,"2LL")
Windows.delay(2)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Select 2LL filter value')
WindowsImageKeywords.doubleClickImage(LL2SelectedFilter)
Windows.delay(2)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Close filter popup')
WindowsImageKeywords.clickImage(closeFiltersBtn)
Windows.delay(2)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Open search section')
WindowsImageKeywords.clickImage(search)
Windows.delay(1)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Fill date filter with closing date')
Windows.setText(findWindowsObject('Object Repository/Justification des Comptes de Latent/txtDateFilter'), GlobalVariable.arreteDate.replace('/',''))
Windows.delay(2)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Run search')
Windows.click(findWindowsObject('Object Repository/General/btnSearch'))
Windows.delay(2)
