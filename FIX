Adicione na configuração:

String favoriteExportScenarioName =
	'GUI_FavoriteView'
3. Substitua a parte do download no Test Case

Remova:

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Download favorite view\n' +
	'Test Case: Component/Export Files/Export Current Table By Outils\n' +
	'Purpose: export the favorite data for comparison'
)

WebUI.callTestCase(
	findTestCase(
		'Component/Export Files/Export Current Table By Outils'
	),
	[:],
	FailureHandling.STOP_ON_FAILURE
)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	targetEnvironment +
	'_GUI_FavoriteViewDownloaded.png'
)

