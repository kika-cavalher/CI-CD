				imageFound = true
				break
			}
			Windows.delay(delayInterval)
			elapsedTime += delayInterval
		}

		if (!imageFound) {
			KeywordUtil.logInfo("The 'Yes' image was not found within the timeout period. Proceeding without clicking 'Yes'.")
		}
	}

