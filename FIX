//At this test when after opening the investigations screen when double clicking on the first record if the refCompta filter is not applyed an error message
//should be returned.

String errors=''

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Start validation of alert when REF COMPTA is not selected')

totalCCYHeader = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/totalCCYHeader.PNG').getAbsolutePath()
errorCriticHeader = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/CriticalErrorTopBar.PNG').getAbsolutePath()
OKErrorBtn = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/OKErrorBtn.PNG').getAbsolutePath()

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Open investigation from Total CCY header')
WindowsImageKeywords.doubleclickImageWithCoorinates(totalCCYHeader, 100, 35)

Windows.delay(5)
try{
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Validate critical error popup is displayed')
	WindowsImageKeywords.clickImage(errorCriticHeader)
	Windows.delay(3)
	
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Capture evidence of missing REF COMPTA alert')
	WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession()).takeScreenshot(RunConfiguration.getReportFolder()+"\\Evidences\\"+'AlertNoRefCompta.PNG')
	
	Windows.delay(3)

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Return focus to popup confirmation')
	Robot robot = new Robot();
	
	robot.keyPress(KeyEvent.VK_ALT)
	robot.keyPress(KeyEvent.VK_TAB)
	
	Windows.delay(1)
	
	robot.keyRelease(KeyEvent.VK_ALT)
	robot.keyRelease(KeyEvent.VK_TAB)
	Windows.delay(1)
	
	robot.keyPress(KeyEvent.VK_ENTER);
	
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Expected error message displayed successfully')
	KeywordUtil.markPassed("Error message displayed when REF COMPTA not selected")
	
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Close error popup')
	WindowsImageKeywords.clickImage(OKErrorBtn)
	
} catch (Exception e) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Expected error message was not displayed')
	errors+='\n Error message not displayed when REF COMPTA not selected \n'
}

println('Done')
