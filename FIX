@Keyword
void dragAndDropImage(
		String sourceImageKey,
		String targetImageKey,
		Integer waitSeconds
	) {

	Integer waitTime = safeTimeout(waitSeconds, 2)

	logStep(
			'DRAG AND DROP',
			'Source: ' + sourceImageKey + '\n' +
			'Target: ' + targetImageKey
			)

	try {
		WindowsImageKeywords.dragAndDrop(
				image(
						GUI_IMAGE_GROUP,
						sourceImageKey
				),
				image(
						GUI_IMAGE_GROUP,
						targetImageKey
				)
		)

		Windows.delay(waitTime)

		KeywordUtil.logInfo(
				'[PASS] Drag and drop completed.\n' +
				'Source: ' + sourceImageKey + '\n' +
				'Target: ' + targetImageKey
				)
	} catch (Exception e) {
		takeEvidence(
				'GUI_DragAndDropFailed_' +
				sourceImageKey +
				'.png'
				)

		KeywordUtil.markFailedAndStop(
				'Drag and drop failed.\n' +
				'Source: ' + sourceImageKey + '\n' +
				'Target: ' + targetImageKey + '\n' +
				'Reason: ' + safeMessage(e)
				)
	}
}


@Keyword
void validateGroupByResult(Integer timeoutSeconds) {

	Integer timeout = safeTimeout(timeoutSeconds, 10)
	List<String> errors = []

	logStep(
			'GROUP BY RESULT',
			'Open the first Grappe result row\n' +
			'Validate the first internal row\n' +
			'Expected image or object: secondGroupResultPrefix'
			)

	// ======================================================
	// TRY TO OPEN FIRST ROW USING IMAGE
	// ======================================================

	boolean firstRowClickedByImage =
			openFirstGroupResultByImage()

	boolean secondGroupVisible = false

	if (firstRowClickedByImage) {
		secondGroupVisible =
				waitForSecondGroupResult(
						timeout
				)
	}

	// ======================================================
	// ELEMENT FALLBACK IF IMAGE DID NOT OPEN THE ROW
	// ======================================================

	if (!secondGroupVisible) {
		KeywordUtil.logInfo(
				'[INFO] The internal Group By row was not visible after the image click.\n' +
				'Trying to open the first row using the Windows element.'
				)

		boolean firstRowOpenedByElement =
				openFirstGroupResultByElement(
						timeout
				)

		if (firstRowOpenedByElement) {
			secondGroupVisible =
				waitForSecondGroupResult(
						timeout
				)
		}
	}

	// ======================================================
	// FINAL VALIDATION
	// ======================================================

	if (!secondGroupVisible) {
		errors.add(
				'The first internal Group By row was not found.\n' +
				'The first Grappe row may not have opened.\n' +
				'Expected image: secondGroupResultPrefix\n' +
				'Expected object: secondGroupResultPrefix\n' +
				'Expected text: Ecart bilan vs. compte de résultat ccy'
				)
	} else {
		KeywordUtil.logInfo(
				'[PASS] First internal Group By row was found.\n' +
				'Image or object: secondGroupResultPrefix'
				)
	}

	takeEvidence(
			'GUI_GroupByResultValidated.png'
			)

	finishValidation(
			'Group By result validation',
			errors
			)
}


private boolean openFirstGroupResultByImage() {

	String firstGroupImagePath

	try {
		firstGroupImagePath =
			image(
					GUI_IMAGE_GROUP,
					'firstGroupResultRow'
			)
	} catch (Exception e) {
		KeywordUtil.logInfo(
				'[INFO] Could not load first Group By result image.\n' +
				'Image: firstGroupResultRow\n' +
				'Reason: ' + safeMessage(e)
				)

		return false
	}

	try {
		/*
		 * Two consecutive clicks reproduce the original behavior
		 * that was opening the first Grappe row successfully.
		 */
		WindowsImageKeywords.clickImage(
				firstGroupImagePath
				)

		Thread.sleep(150)

		try {
			WindowsImageKeywords.clickImage(
					firstGroupImagePath
					)
		} catch (Exception secondClickError) {
			KeywordUtil.logInfo(
					'[INFO] Second image click was not required or the image changed after opening.\n' +
					'Reason: ' + safeMessage(secondClickError)
					)
		}

		KeywordUtil.logInfo(
				'[PASS] First Grappe result row clicked using image.\n' +
				'Image: firstGroupResultRow'
				)

		return true
	} catch (Exception imageError) {
		KeywordUtil.logInfo(
				'[INFO] First Grappe result image was not found or could not be clicked.\n' +
				'Image: firstGroupResultRow\n' +
				'Reason: ' + safeMessage(imageError)
				)

		return false
	}
}


private boolean openFirstGroupResultByElement(
		Integer timeoutSeconds
	) {

	Integer timeout = safeTimeout(timeoutSeconds, 10)

	try {
		WindowsTestObject firstGroupObject =
			object(
					'firstGroupResultRow'
			)

		boolean firstGroupPresent =
			Windows.waitForElementPresent(
					firstGroupObject,
					timeout,
					FailureHandling.OPTIONAL
			)

		if (!firstGroupPresent) {
			KeywordUtil.logInfo(
					'[INFO] First Grappe result Windows element was not found.\n' +
					'Object: firstGroupResultRow'
					)

			return false
		}

		Windows.doubleClick(
				firstGroupObject,
				FailureHandling.STOP_ON_FAILURE
				)

		KeywordUtil.logInfo(
				'[PASS] First Grappe result row opened using Windows element.\n' +
				'Object: firstGroupResultRow'
				)

		return true
	} catch (Exception objectError) {
		KeywordUtil.logInfo(
				'[INFO] First Grappe result row could not be opened using Windows element.\n' +
				'Object: firstGroupResultRow\n' +
				'Reason: ' + safeMessage(objectError)
				)

		return false
	}
}


private boolean waitForSecondGroupResult(
		Integer timeoutSeconds
	) {

	Integer timeout = safeTimeout(timeoutSeconds, 10)

	String secondGroupImagePath = ''

	try {
		secondGroupImagePath =
			image(
					GUI_IMAGE_GROUP,
					'secondGroupResultPrefix'
			)
	} catch (Exception e) {
		KeywordUtil.logInfo(
				'[INFO] Could not load second Group By result image.\n' +
				'Image: secondGroupResultPrefix\n' +
				'Reason: ' + safeMessage(e)
				)
	}

	WindowsTestObject secondGroupObject = null

	try {
		secondGroupObject =
			object(
					'secondGroupResultPrefix'
			)
	} catch (Exception e) {
		KeywordUtil.logInfo(
				'[INFO] Could not load second Group By result object.\n' +
				'Object: secondGroupResultPrefix\n' +
				'Reason: ' + safeMessage(e)
				)
	}

	long endTime =
			System.currentTimeMillis() +
			(timeout * 1000L)

	while (System.currentTimeMillis() < endTime) {

		// ======================================================
		// IMAGE FIRST
		// ======================================================

		if (!secondGroupImagePath.isEmpty()) {
			try {
				def imageFound =
					WindowsImageKeywords.findImage(
							secondGroupImagePath
					)

				if (
					imageFound != null &&
					imageFound != false
					) {
					KeywordUtil.logInfo(
							'[PASS] Internal Group By row found using image.\n' +
							'Image: secondGroupResultPrefix'
							)

					return true
				}
			} catch (Exception ignored) {
			}
		}

		// ======================================================
		// WINDOWS ELEMENT FALLBACK
		// ======================================================

		if (secondGroupObject != null) {
			try {
				boolean secondGroupPresent =
					Windows.verifyElementPresent(
							secondGroupObject,
							1,
							FailureHandling.OPTIONAL
					)

				if (secondGroupPresent) {
					KeywordUtil.logInfo(
							'[PASS] Internal Group By row found using Windows element.\n' +
							'Object: secondGroupResultPrefix'
							)

					return true
				}
			} catch (Exception ignored) {
			}
		}

		Thread.sleep(250)
	}

	KeywordUtil.logInfo(
			'[INFO] Internal Group By row was not found before timeout.\n' +
			'Image: secondGroupResultPrefix\n' +
			'Object: secondGroupResultPrefix\n' +
			'Timeout: ' + timeout + ' seconds'
			)

	return false
}
