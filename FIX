	private Boolean readRadioSelectedState(
			WindowsTestObject radioButton,
			String objectName
	) {
		List<String> attributes = [
			'SelectionItem.IsSelected',
			'IsSelected',
			'Toggle.ToggleState',
			'ToggleState'
		]

		for (String attributeName : attributes) {
			try {
				String attributeValue =
						Windows.getAttribute(
						radioButton,
						attributeName,
						FailureHandling.OPTIONAL
						)

				if (
				attributeValue == null ||
						attributeValue.trim().isEmpty()
						) {
					continue
				}

				String normalizedValue =
						attributeValue
						.trim()
						.toLowerCase()

				KeywordUtil.logInfo(
						'Radio button attribute read.\n' +
						'Object: ' + objectName + '\n' +
						'Attribute: ' + attributeName + '\n' +
						'Value: ' + attributeValue
						)

				if (
				normalizedValue == 'true' ||
						normalizedValue == '1' ||
						normalizedValue == 'selected' ||
						normalizedValue == 'checked' ||
						normalizedValue == 'on'
						) {
					return true
				}

				if (
				normalizedValue == 'false' ||
						normalizedValue == '0' ||
						normalizedValue == 'unselected' ||
						normalizedValue == 'unchecked' ||
						normalizedValue == 'off'
						) {
					return false
				}
			} catch (Exception ignored) {
			}
		}

		KeywordUtil.logInfo(
				'Could not determine radio button selection state.\n' +
				'Object: ' + objectName
				)

		return null
	}

