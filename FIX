if exist "%MARKER_FILE%.tmp" del /f /q "%MARKER_FILE%.tmp" >nul 2>&1
if exist "%CURRENT_LOG_FILE%" del /f /q "%CURRENT_LOG_FILE%" >nul 2>&1
if exist "%LIVE_LOG_PID_FILE%" del /f /q "%LIVE_LOG_PID_FILE%" >nul 2>&1
if exist "%LIVE_LOG_SCRIPT_FILE%" del /f /q "%LIVE_LOG_SCRIPT_FILE%" >nul 2>&1

type nul > "%CURRENT_LOG_FILE%"

for /f %%I in ('powershell -NoProfile -Command "Get-Date -Format yyyyMMdd_HHmmss"') do set "TS=%%I"
set "FINAL_LOG_FILE=%LOG_DIR%\katalon_%TS%.log"

title %RUNNER_WINDOW_TITLE%

call :appendlog ============================================================
call :appendlog eMatch Desktop Run
call :appendlog ============================================================
call :appendlog [INFO] RUN_LABEL       = "%RUN_LABEL%"
call :appendlog [INFO] WORKSPACE       = "%WORKSPACE%"
call :appendlog [INFO] PROJECT_PATH    = "%PROJECT_PATH%"
call :appendlog [INFO] KATALON_EXE     = "%KATALON_EXE%"
call :appendlog [INFO] ASSET_TYPE      = "%ASSET_TYPE%"
call :appendlog [INFO] ASSET_PATH      = "%ASSET_PATH%"
call :appendlog [INFO] BROWSER_TYPE    = "%BROWSER_TYPE%"
call :appendlog [INFO] RETRY           = "%RETRY%"
call :appendlog [INFO] REPORTS_DIR     = "%REPORTS_DIR%"
call :appendlog [INFO] CURRENT_LOG     = "%CURRENT_LOG_FILE%"
call :appendlog [INFO] FINAL_LOG       = "%FINAL_LOG_FILE%"
call :appendlog [INFO] MARKER_FILE     = "%MARKER_FILE%"
call :appendlog ============================================================
call :appendlog.

> "%LIVE_LOG_SCRIPT_FILE%" (
    echo $Host.UI.RawUI.WindowTitle = '%LIVE_LOG_WINDOW_TITLE%'
    echo Get-Content -LiteralPath '%CURRENT_LOG_FILE%' -Wait -Tail 40
)

powershell -NoProfile -ExecutionPolicy Bypass -Command ^
    "$p = Start-Process powershell.exe -WindowStyle Minimized -ArgumentList '-NoProfile','-ExecutionPolicy','Bypass','-File','%LIVE_LOG_SCRIPT_FILE%' -PassThru; Set-Content -LiteralPath '%LIVE_LOG_PID_FILE%' -Value $p.Id"

powershell -NoProfile -ExecutionPolicy Bypass -Command ^
    "$sig='[DllImport(\"user32.dll\")] public static extern bool ShowWindowAsync(IntPtr hWnd, int nCmdShow);'; Add-Type -MemberDefinition $sig -Name Win32Show -Namespace Native; $title='%RUNNER_WINDOW_TITLE%'; 1..10 | ForEach-Object { $p = Get-Process | Where-Object { $_.MainWindowTitle -eq $title } | Select-Object -First 1; if ($p) { [Native.Win32Show]::ShowWindowAsync($p.MainWindowHandle, 2) | Out-Null; break }; Start-Sleep -Milliseconds 200 }" >nul 2>&1

if /I "%AUTO_START_WINAPPDRIVER%"=="true" (
    tasklist /FI "IMAGENAME eq WinAppDriver.exe" | find /I "WinAppDriver.exe" >nul

    if errorlevel 1 (
        if exist "%WINAPPDRIVER_EXE%" (
            call :appendlog [INFO] WinAppDriver is not running. Starting it now...
            start "WinAppDriver" "%WINAPPDRIVER_EXE%"
            timeout /t 3 >nul
        ) else (
            call :appendlog [WARN] WinAppDriver executable not found: "%WINAPPDRIVER_EXE%"
        )
    ) else (
        call :appendlog [INFO] WinAppDriver is already running
    )
) else (
    call :appendlog [INFO] AUTO_START_WINAPPDRIVER=false
)

cd /d "%WORKSPACE%"

if /I "%ASSET_TYPE%"=="COLLECTION" (
    call :appendlog [INFO] Running Katalon test suite collection...

    "%KATALON_EXE%" ^
      -noSplash ^
      -runMode=console ^
      -consoleLog ^
      -projectPath="%PROJECT_PATH%" ^
      -retry=%RETRY% ^
      -testSuiteCollectionPath="%ASSET_PATH%" ^
      -browserType="%BROWSER_TYPE%" ^
      -reportFolder="%REPORTS_DIR%" ^
      >> "%CURRENT_LOG_FILE%" 2>&1
) else (
    call :appendlog [INFO] Running Katalon test suite...

    "%KATALON_EXE%" ^
      -noSplash ^
      -runMode=console ^
      -consoleLog ^
      -projectPath="%PROJECT_PATH%" ^
      -retry=%RETRY% ^
      -testSuitePath="%ASSET_PATH%" ^
      -browserType="%BROWSER_TYPE%" ^
      -reportFolder="%REPORTS_DIR%" ^
      >> "%CURRENT_LOG_FILE%" 2>&1
)

set "EXITCODE=%ERRORLEVEL%"

copy /Y "%CURRENT_LOG_FILE%" "%FINAL_LOG_FILE%" >nul 2>&1

call :appendlog.
call :appendlog [INFO] Katalon ExitCode = %EXITCODE%
call :appendlog [INFO] Writing marker file...

(
    echo %EXITCODE%
) > "%MARKER_FILE%.tmp"

move /Y "%MARKER_FILE%.tmp" "%MARKER_FILE%" >nul 2>&1

call :appendlog [INFO] Marker file written: "%MARKER_FILE%"
call :appendlog [INFO] Final log saved   : "%FINAL_LOG_FILE%"
call :appendlog.

call :closelivelog

if exist "%LIVE_LOG_SCRIPT_FILE%" del /f /q "%LIVE_LOG_SCRIPT_FILE%" >nul 2>&1

exit /b %EXITCODE%

:closelivelog
if exist "%LIVE_LOG_PID_FILE%" (
    set "LIVE_LOG_PID="
    for /f "usebackq delims=" %%P in ("%LIVE_LOG_PID_FILE%") do set "LIVE_LOG_PID=%%P"

    if defined LIVE_LOG_PID (
        taskkill /PID !LIVE_LOG_PID! /T /F >nul 2>&1
    )

    del /f /q "%LIVE_LOG_PID_FILE%" >nul 2>&1
)

taskkill /FI "WINDOWTITLE eq %LIVE_LOG_WINDOW_TITLE%" /T /F >nul 2>&1
exit /b 0

:appendlog
echo %*
>> "%CURRENT_LOG_FILE%" echo %*
exit /b 0











import groovy.json.JsonSlurperClassic

def readJunitSummary(script, String reportsDir) {
    def raw = script.powershell(
        returnStdout: true,
        script: """
\$root = '${reportsDir}'
\$result = [ordered]@{
    path = ''
    executed = 0
    failed = 0
    skipped = 0
    passed = 0
}

\$junit = Get-ChildItem -Path \$root -Filter 'JUnit_Report.xml' -File -Recurse -ErrorAction SilentlyContinue |
    Sort-Object LastWriteTime -Descending |
    Select-Object -First 1

if (\$junit) {
    \$result.path = \$junit.FullName

    try {
        [xml]\$xml = Get-Content -LiteralPath \$junit.FullName -Raw

        \$testcases = @()

        if (\$xml.testsuite) {
            \$testcases = @(\$xml.testsuite.testcase)
        }
        elseif (\$xml.testsuites) {
            foreach (\$ts in @(\$xml.testsuites.testsuite)) {
                \$testcases += @(\$ts.testcase)
            }
        }

        \$testcases = @(\$testcases | Where-Object { \$_ })
        \$result.executed = \$testcases.Count
        \$result.failed = @(\$testcases | Where-Object { \$_.failure -or \$_.error }).Count
        \$result.skipped = @(\$testcases | Where-Object { \$_.skipped }).Count
        \$result.passed = \$result.executed - \$result.failed - \$result.skipped
    }
    catch {
    }
}

\$result | ConvertTo-Json -Compress
"""
    ).trim()

    if (!raw) {
        return [path: '', executed: 0, failed: 0, skipped: 0, passed: 0]
    }

    return new JsonSlurperClassic().parseText(raw) as Map
}

