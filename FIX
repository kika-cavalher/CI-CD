'iconeModalPRD' : 'Images/General/iconeModalPRD.png',
Substitua completamente o método closeOpenFileModal() por este
private void closeOpenFileModal() {

	List<String> modalImageKeys = [
		'iconeModal',
		'iconeModal2',
		'iconeModalPRD'
	]

	logInfo(
			'Searching for open-file modal.\n' +
			'Possible images: ' +
			modalImageKeys +
			'\nTimeout per image: ' +
			OPEN_FILE_MODAL_TIMEOUT_SECONDS +
			' seconds.'
			)

	String detectedModalImage = null

	for (String modalImageKey : modalImageKeys) {

		try {
			boolean modalFound =
					imageLoader.waitForImage(
					GENERAL_IMAGE_GROUP,
					modalImageKey,
					OPEN_FILE_MODAL_TIMEOUT_SECONDS
					)

			if (modalFound) {

				detectedModalImage =
						modalImageKey

				logInfo(
						'Open-file modal detected.\n' +
						'Image key: ' +
						detectedModalImage
						)

				break
			}
		} catch (Throwable throwable) {

			logInfo(
					'Open-file modal image search returned an exception.\n' +
					'Image key: ' +
					modalImageKey +
					'\nMessage: ' +
					safeExceptionMessage(
					throwable
					)
					)
		}
	}

	if (detectedModalImage == null) {

		logInfo(
				'Open-file modal was not detected.\n' +
				'No modal close action is required. Continuing the export flow.'
				)

		return
	}

	Integer maximumCloseAttempts = 2

	for (
	Integer attempt = 1;
			attempt <= maximumCloseAttempts;
			attempt++
			) {

		logInfo(
				'Closing open-file modal.\n' +
				'Attempt: ' +
				attempt +
				' of ' +
				maximumCloseAttempts +
				'\nDetected image: ' +
				detectedModalImage
				)

		/*
		 * Click the detected modal image before using the keyboard.
		 * This restores focus to eMatch when WinAppDriver or another
		 * window is in front of the application.
		 */
		try {
			imageLoader.clickImageOrStop(
					GENERAL_IMAGE_GROUP,
					detectedModalImage
					)

			logInfo(
					'Open-file modal clicked to restore application focus.\n' +
					'Image key: ' +
					detectedModalImage
					)
		} catch (Throwable throwable) {

			logInfo(
					'Could not click the modal image to restore focus.\n' +
					'The keyboard close action will still be attempted.\n' +
					'Image key: ' +
					detectedModalImage +
					'\nMessage: ' +
					safeExceptionMessage(
					throwable
					)
					)
		}

		Windows.delay(
				SHORT_UI_DELAY_SECONDS
				)

		try {
			Robot robot =
					new Robot()

			robot.setAutoDelay(
					150
					)

			robot.keyPress(
					KeyEvent.VK_TAB
					)

			robot.keyRelease(
					KeyEvent.VK_TAB
					)

			Thread.sleep(
					300
					)

			robot.keyPress(
					KeyEvent.VK_ENTER
					)

			robot.keyRelease(
					KeyEvent.VK_ENTER
					)
		} catch (Exception exception) {

			imageLoader.takeEvidence(
					'OpenFileModalKeyboardError_Attempt' +
					attempt +
					'.png'
					)

			if (attempt < maximumCloseAttempts) {

				logInfo(
						'Could not execute TAB and ENTER.\n' +
						'The modal close action will be tried again.\n' +
						'Attempt: ' +
						attempt +
						' of ' +
						maximumCloseAttempts +
						'\nMessage: ' +
						safeExceptionMessage(
						exception
						)
						)

				Windows.delay(
						SHORT_UI_DELAY_SECONDS
						)

				continue
			}

			KeywordUtil.markFailedAndStop(
					'Could not close open-file modal after two keyboard attempts.\n' +
					'Last message: ' +
					safeExceptionMessage(
					exception
					)
					)

			return
		}

		Windows.delay(
				SHORT_UI_DELAY_SECONDS
				)

		boolean modalStillVisible = false
		String visibleModalImage = null

		for (String modalImageKey : modalImageKeys) {

			try {
				boolean currentImageVisible =
						imageLoader.isVisible(
						GENERAL_IMAGE_GROUP,
						modalImageKey
						)

				if (currentImageVisible) {

					modalStillVisible = true
					visibleModalImage = modalImageKey
					break
				}
			} catch (Throwable throwable) {

				logInfo(
						'Could not verify modal image visibility.\n' +
						'Image key: ' +
						modalImageKey +
						'\nMessage: ' +
						safeExceptionMessage(
						throwable
						)
						)
			}
		}

		if (!modalStillVisible) {

			logInfo(
					'Open-file modal closed successfully.\n' +
					'Attempt used: ' +
					attempt +
					' of ' +
					maximumCloseAttempts
					)

			return
		}

		detectedModalImage =
				visibleModalImage

		if (attempt < maximumCloseAttempts) {

			logInfo(
					'Open-file modal is still visible.\n' +
					'Visible image: ' +
					detectedModalImage +
					'\nThe modal will be focused and closed again.'
					)

			Windows.delay(
					SHORT_UI_DELAY_SECONDS
					)
		}
	}

	imageLoader.takeEvidence(
			'OpenFileModalStillVisibleAfterRetry.png'
			)

	KeywordUtil.markFailedAndStop(
			'Open-file modal is still visible after two TAB and ENTER attempts.\n' +
			'Last detected image: ' +
			detectedModalImage +
			'\nEvidence: OpenFileModalStillVisibleAfterRetry.png'
			)
}
