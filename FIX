	@Keyword
	void dragAndDropImage(
			String sourceImageKey,
			String targetImageKey,
			Integer waitSeconds
	) {

		Integer waitTime = safeTimeout(waitSeconds, 2)

		logStep(
				'DRAG AND DROP',
				'Source: ' + sourceImageKey + '\n' +
				'Target: ' + targetImageKey
				)

		try {
			WindowsImageKeywords.dragAndDrop(
					image(GUI_IMAGE_GROUP, sourceImageKey),
					image(GUI_IMAGE_GROUP, targetImageKey)
					)

			Windows.delay(waitTime)

			KeywordUtil.logInfo(
					'[PASS] Drag and drop completed.'
					)
		} catch (Exception e) {
			takeEvidence(
					'GUI_DragAndDropFailed_' +
					sourceImageKey +
					'.png'
					)

			KeywordUtil.markFailedAndStop(
					'Drag and drop failed.\n' +
					'Source: ' + sourceImageKey + '\n' +
					'Target: ' + targetImageKey + '\n' +
					'Reason: ' + safeMessage(e)
					)
		}
	}


