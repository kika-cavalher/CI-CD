	private File saveToShortExportFolder(
			String exportLabel,
			String targetEnvironment) {

		String environment = resolveEnvironmentName(
				targetEnvironment,
				exportLabel
		)

		String collectionName = shortenFilePart(
				sanitizeFileName(resolveCurrentCollectionName()),
				MAX_COLLECTION_LENGTH
		)

		String featureName = shortenFilePart(
				sanitizeFileName(resolveCurrentFeatureName()),
				MAX_FEATURE_LENGTH
		)

		String exportLabelSuffix = shortenFilePart(
				resolveExportLabelSuffixForFileName(exportLabel),
				MAX_LABEL_LENGTH
		)

		File directory = resolveShortExportDirectory(
				environment,
				collectionName,
				featureName
		)

		if (!directory.exists()) {
			boolean created = directory.mkdirs()

			if (!created && !directory.exists()) {
				KeywordUtil.markFailedAndStop(
						'Could not create short export directory.\n' +
						'Directory: ' +
						directory.getAbsolutePath()
				)
			}
		}

		String fileName = buildAutomaticExportFileName(
				environment,
				featureName,
				exportLabelSuffix
		)

		File exportedFile = new File(
				directory,
				fileName
		)

		exportedFile = ensurePathIsShortEnough(
				exportedFile,
				environment,
				exportLabelSuffix
		)

		KeywordUtil.logInfo(
				'Short export configuration.\n' +
				'Environment: ' + environment + '\n' +
				'Collection: ' + collectionName + '\n' +
				'Feature: ' + featureName + '\n' +
				'Export label: ' + exportLabelSuffix + '\n' +
				'Directory: ' +
				exportedFile.getParentFile().getAbsolutePath() + '\n' +
				'File name: ' +
				exportedFile.getName() + '\n' +
				'Full path length: ' +
				exportedFile.getAbsolutePath().length()
		)

		Windows.click(
				findWindowsObject(
						'Object Repository/Acapulco/filePath'
				)
		)

		Windows.delay(1)

		clearFocusedField()

		pasteAndEnter(
				exportedFile
				.getParentFile()
				.getAbsolutePath()
		)

		Windows.delay(2)

		setFileName(
				exportedFile.getName()
		)

		Windows.click(
				findWindowsObject(
						'General/btnSave'
				)
		)

		Windows.delay(3)

		waitForExportedFileOrStop(
				exportedFile,
				EXPORT_FILE_TIMEOUT_SECONDS
		)

		return exportedFile
	}


	private File resolveShortExportDirectory(
			String environment,
			String collectionName,
			String featureName) {

		File executionDirectory = resolveShortExportRoot()
		File collectionDirectory = new File(
				executionDirectory,
				collectionName
		)

		return new File(
				collectionDirectory,
				featureName
		)
	}


	private File resolveShortExportRoot() {

		File baseRoot = resolveWritableBaseExportRoot()
		File executionRoot = resolveExecutionRootFolder()

		String executionName =
				executionRoot == null
					? ''
					: executionRoot.getName()

		if (executionName == null ||
			executionName.trim().isEmpty()) {

			executionName = 'Unknown_Execution'
		}

		File executionDirectory = new File(
				baseRoot,
				shortenFilePart(
						sanitizeFileName(executionName),
						48
				)
		)

		if (!executionDirectory.exists()) {
			boolean created = executionDirectory.mkdirs()

			if (!created && !executionDirectory.exists()) {
				KeywordUtil.markFailedAndStop(
						'Could not create suite execution export directory.\n' +
						'Directory: ' +
						executionDirectory.getAbsolutePath()
				)
			}
		}

		return executionDirectory
	}


	private File resolveWritableBaseExportRoot() {

		File preferredRoot = new File(SHORT_EXPORT_ROOT)

		try {
			if (!preferredRoot.exists()) {
				preferredRoot.mkdirs()
			}

			if (preferredRoot.exists() &&
				preferredRoot.isDirectory() &&
				preferredRoot.canWrite()) {

				return preferredRoot
			}
		} catch (Exception ignored) {
		}

		File temporaryRoot = new File(
				System.getProperty('java.io.tmpdir'),
				'KatalonExports'
		)

		if (!temporaryRoot.exists()) {
			temporaryRoot.mkdirs()
		}

		return temporaryRoot
	}


	private File resolveExecutionRootFolder() {

		String reportFolderPath =
				RunConfiguration.getReportFolder()

		if (reportFolderPath == null ||
			reportFolderPath.trim().isEmpty()) {

			return new File(
					RunConfiguration.getProjectDir(),
					'Reports\\Unknown_Execution'
			)
		}

		File current = new File(reportFolderPath)

		while (current != null) {
			File parent = current.getParentFile()

			if (parent != null &&
				parent.getName().equalsIgnoreCase('Reports')) {

				return current
			}

			current = parent
		}

		return new File(reportFolderPath)
	}


	private File ensurePathIsShortEnough(
			File proposedFile,
			String environment,
			String exportLabelSuffix) {

		if (proposedFile.getAbsolutePath().length() <=
				MAX_WINDOWS_PATH_LENGTH) {

			return proposedFile
		}

		String timestamp =
				new SimpleDateFormat(
						'yyyyMMdd_HHmmss'
				).format(new Date())

		String shortEnvironment = shortenFilePart(
				sanitizeFileName(environment),
				6
		)

		String shortLabel = shortenFilePart(
				sanitizeFileName(exportLabelSuffix),
				12
		)

		String shortFileName =
				shortEnvironment +
				'_' +
				timestamp

		if (shortLabel != null &&
			!shortLabel.trim().isEmpty()) {

			shortFileName +=
					'_' +
					shortLabel
		}

		File shortFile = new File(
				proposedFile.getParentFile(),
				shortFileName + '.xlsx'
		)

		if (shortFile.getAbsolutePath().length() >
				MAX_WINDOWS_PATH_LENGTH) {

			KeywordUtil.markFailedAndStop(
					'Could not create an export path shorter than the configured limit.\n' +
					'Path: ' +
					shortFile.getAbsolutePath()
			)
		}

		return shortFile
	}


	private void waitForExportedFileOrStop(
			File exportedFile,
			Integer timeoutSeconds) {

		int safeTimeout =
				timeoutSeconds == null ||
				timeoutSeconds <= 0
					? EXPORT_FILE_TIMEOUT_SECONDS
					: timeoutSeconds

		int elapsedSeconds = 0
		long previousSize = -1
		int stableSizeChecks = 0

		while (elapsedSeconds < safeTimeout) {

			if (exportedFile.exists() &&
				exportedFile.isFile() &&
				exportedFile.length() > 0) {

				long currentSize = exportedFile.length()

				if (currentSize == previousSize) {
					stableSizeChecks++
				} else {
					stableSizeChecks = 0
					previousSize = currentSize
				}

				if (stableSizeChecks >= 3) {
					KeywordUtil.logInfo(
							'Exported file found and write completed.\n' +
							'Path: ' +
							exportedFile.getAbsolutePath() + '\n' +
							'Size bytes: ' +
							currentSize
					)

					return
				}
			}

			Windows.delay(1)
			elapsedSeconds++
		}

		imageLoader.takeEvidence(
				'ExportedFileNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
				'Exported file was not found, is empty or did not finish writing.\n' +
				'Expected path: ' +
				exportedFile.getAbsolutePath() + '\n' +
				'Timeout seconds: ' +
				safeTimeout
		)
	}


	private void closeOpenFileModal() {

		KeywordUtil.logInfo(
				'Waiting for REC or PRD open-file modal image.'
		)

		String detectedModalImage = null

		if (imageLoader.waitForImage(
				'General',
				'iconeModal',
				5)) {

			detectedModalImage = 'iconeModal'
		} else if (imageLoader.waitForImage(
				'General',
				'iconeModalPRD',
				5)) {

			detectedModalImage = 'iconeModalPRD'
		}

		if (detectedModalImage == null) {
			Windows.delay(1)

			if (imageLoader.waitForImage(
					'General',
					'iconeModal',
					3)) {

				detectedModalImage = 'iconeModal'
			} else if (imageLoader.waitForImage(
					'General',
					'iconeModalPRD',
					3)) {

				detectedModalImage = 'iconeModalPRD'
			}
		}

		if (detectedModalImage == null) {
			imageLoader.takeEvidence(
					'OpenFileModalNotFound.png'
			)

			KeywordUtil.markFailedAndStop(
					'Open-file modal was not found.\n' +
					'Expected REC image: General/iconeModal\n' +
					'Expected PRD image: General/iconeModalPRD'
			)
		}

		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_TAB)
		robot.keyRelease(KeyEvent.VK_TAB)

		Thread.sleep(300)

		robot.keyPress(KeyEvent.VK_ENTER)
		robot.keyRelease(KeyEvent.VK_ENTER)

		Windows.delay(1)

		if (imageLoader.isVisible('General', 'iconeModal') ||
			imageLoader.isVisible('General', 'iconeModalPRD')) {

			imageLoader.takeEvidence(
					'OpenFileModalStillVisible.png'
			)

			KeywordUtil.markFailedAndStop(
					'Open-file modal is still visible after TAB and ENTER.'
			)
		}
	}


	private void validateExportedFile(File exportedFile) {

		if (exportedFile == null) {
			KeywordUtil.markFailedAndStop(
					'Exported file reference is null.'
			)
		}

		if (!exportedFile.exists() ||
			!exportedFile.isFile() ||
			exportedFile.length() <= 0) {

			KeywordUtil.markFailedAndStop(
					'Exported file is invalid.\n' +
					'Path: ' +
					exportedFile.getAbsolutePath()
			)
		}

		String lowerName =
				exportedFile
				.getName()
				.toLowerCase()

		if (!lowerName.endsWith('.xlsx') &&
			!lowerName.endsWith('.xlsm') &&
			!lowerName.endsWith('.xls')) {

			KeywordUtil.markFailedAndStop(
					'Exported file does not have a supported Excel extension.\n' +
					'File: ' +
					exportedFile.getName()
			)
		}
	}


	private String buildAutomaticExportFileName(
			String environment,
			String featureName,
			String exportLabelSuffix) {

		String timestamp =
				new SimpleDateFormat(
						'yyyyMMdd_HHmmss'
				).format(new Date())

		String safeEnvironment = shortenFilePart(
				sanitizeFileName(
						environment == null ||
						environment.trim().isEmpty()
							? 'REC'
							: environment
				),
				6
		)

		String safeFeatureName = shortenFilePart(
				sanitizeFileName(
						featureName == null ||
						featureName.trim().isEmpty()
							? 'Export'
							: featureName
				),
				MAX_FEATURE_LENGTH
		)

		String safeExportLabelSuffix = shortenFilePart(
				sanitizeFileName(
						exportLabelSuffix == null
							? ''
							: exportLabelSuffix
				),
				MAX_LABEL_LENGTH
		)

		String baseFileName =
				safeEnvironment +
				'_' +
				timestamp +
				'_' +
				safeFeatureName

		if (safeExportLabelSuffix != null &&
			!safeExportLabelSuffix.trim().isEmpty() &&
			safeExportLabelSuffix != 'Export') {

			baseFileName +=
					'_' +
					safeExportLabelSuffix
		}

		return baseFileName + '.xlsx'
	}


	private String resolveExportLabelSuffixForFileName(
			String exportLabel) {

		if (exportLabel == null ||
			exportLabel.trim().isEmpty()) {

			return ''
		}

		String value = sanitizeFileName(exportLabel)

		value = value.replaceFirst('(?i)^REC_', '')
		value = value.replaceFirst('(?i)^PRD_', '')
		value = value.replaceFirst('(?i)^REC-', '')
		value = value.replaceFirst('(?i)^PRD-', '')
		value = value.replaceFirst('(?i)^REC ', '')
		value = value.replaceFirst('(?i)^PRD ', '')

		return value == null ||
				value.trim().isEmpty()
					? ''
					: value
	}


	private String resolveEnvironmentName(
			String targetEnvironment,
			String exportLabel) {

		String environment =
				normalizeEnvironmentNameStrict(targetEnvironment)

		if (environment != null) {
			return environment
		}

		List<String> globalVariableNames = [
			'targetEnvironment',
			'currentEnvironment',
			'environment',
			'env',
			'ENV',
			'currentEnv',
			'environmentName'
		]

		for (String variableName : globalVariableNames) {
			environment = normalizeEnvironmentNameStrict(
					getGlobalVariableValue(variableName)
			)

			if (environment != null) {
				return environment
			}
		}

		environment = normalizeEnvironmentNameStrict(
				RunConfiguration.getExecutionProfile()
		)

		if (environment != null) {
			return environment
		}

		environment = normalizeEnvironmentNamePrefixOnly(
				exportLabel
		)

		return environment == null
				? 'REC'
				: environment
	}


	private String normalizeEnvironmentNameStrict(
			String rawEnvironment) {

		if (rawEnvironment == null ||
			rawEnvironment.trim().isEmpty()) {

			return null
		}

		String value =
				rawEnvironment
				.trim()
				.toUpperCase()

		if (value == 'PRD' ||
			value == 'PROD' ||
			value == 'PRODUCTION' ||
			value.startsWith('PRD_') ||
			value.startsWith('PRD-') ||
			value.startsWith('PRD ')) {

			return 'PRD'
		}

		if (value == 'REC' ||
			value == 'RECETTE' ||
			value.startsWith('REC_') ||
			value.startsWith('REC-') ||
			value.startsWith('REC ')) {

			return 'REC'
		}

		return null
	}


	private String normalizeEnvironmentNamePrefixOnly(
			String rawEnvironment) {

		return normalizeEnvironmentNameStrict(
				rawEnvironment
		)
	}


	private String getGlobalVariableValue(
			String variableName) {

		try {
			def value =
					GlobalVariable."${variableName}"

			if (value != null &&
				!value.toString().trim().isEmpty()) {

				return value.toString()
			}
		} catch (Exception ignored) {
		}

		return null
	}


	private String resolveCurrentCollectionName() {

		List<String> validParts =
				getValidReportFolderParts()

		return validParts.isEmpty()
				? 'Collection'
				: validParts[0]
	}


	private String resolveCurrentFeatureName() {

		List<String> validParts =
				getValidReportFolderParts()

		return validParts.isEmpty()
				? 'Export'
				: validParts.last()
	}


	private List<String> getValidReportFolderParts() {

		List<String> validParts = []

		String reportFolderPath =
				RunConfiguration.getReportFolder()

		if (reportFolderPath == null ||
			reportFolderPath.trim().isEmpty()) {

			return validParts
		}

		File executionRootFolder =
				resolveExecutionRootFolder()

		String fullPath =
				new File(reportFolderPath)
				.getAbsolutePath()

		String rootPath =
				executionRootFolder
				.getAbsolutePath()

		if (!fullPath.toLowerCase().startsWith(
				rootPath.toLowerCase())) {

			return validParts
		}

		String relativePath =
				fullPath
				.substring(rootPath.length())
				.replaceAll('^\\\\+', '')

		if (relativePath.trim().isEmpty()) {
			return validParts
		}

		List<String> parts =
				relativePath
				.replace('/', '\\')
				.split('\\\\') as List<String>

		for (String part : parts) {
			if (isValidFeatureNamePart(part)) {
				validParts.add(part.trim())
			}
		}

		return validParts
	}


	private boolean isValidFeatureNamePart(String part) {

		if (part == null ||
			part.trim().isEmpty()) {

			return false
		}

		String value = part.trim()
		String lower = value.toLowerCase()

		if (value ==~ /\d{8}_\d{6}/ ||
			value ==~ /\d{14}/ ||
			value ==~ /^\d+\.\s*.*/) {

			return false
		}

		List<String> ignoredExactValues = [
			'reports',
			'evidences',
			'exports',
			'test cases',
			'test suites',
			'connection',
			'authentication',
			'login rec',
			'login prd',
			'katalon',
			'temp'
		]

		if (ignoredExactValues.contains(lower)) {
			return false
		}

		List<String> ignoredContainsValues = [
			'filter export and validate',
			'validation compare rec x prd',
			'test tool validation',
			'close application',
			'open module',
			'login'
		]

		for (String ignored : ignoredContainsValues) {
			if (lower.contains(ignored)) {
				return false
			}
		}

		return true
	}


	private String sanitizeFileName(String text) {

		if (text == null ||
			text.trim().isEmpty()) {

			return 'Export'
		}

		String normalized =
				Normalizer
				.normalize(
						text,
						Normalizer.Form.NFD
				)
				.replaceAll(
						'\\p{InCombiningDiacriticalMarks}+',
						''
				)

		String cleaned =
				normalized
				.replaceAll('[\\\\/:*?"<>|]', '_')
				.replaceAll('\\s+', '_')
				.replaceAll('_+', '_')
				.replaceAll('^_|_$', '')
				.trim()

		return cleaned.isEmpty()
				? 'Export'
				: cleaned
	}


	private String shortenFilePart(
			String value,
			Integer maximumLength) {

		if (value == null ||
			value.trim().isEmpty()) {

			return ''
		}

		int safeMaximum =
				maximumLength == null ||
				maximumLength <= 0
					? 20
					: maximumLength

		String cleanValue =
				sanitizeFileName(value)

		return cleanValue.length() <= safeMaximum
				? cleanValue
				: cleanValue.substring(0, safeMaximum)
	}


	private void setFileName(String fileName) {

		if (!focusFileNameField()) {
			imageLoader.takeEvidence(
					'FileNameFieldNotFocused.png'
			)

			KeywordUtil.markFailedAndStop(
					'Could not focus export file name field before saving.\n' +
					'Expected file name: ' +
					fileName
			)
		}

		clearFocusedField()
		pasteText(fileName)
		Windows.delay(1)
	}


	private boolean focusFileNameField() {

		List<WindowsTestObject> candidateObjects = [
			buildFileNameFieldByAutomationId(),
			buildFileNameFieldByName('File name'),
			buildFileNameFieldByName('Nom du fichier'),
			buildFileNameFieldByName('Nome do ficheiro'),
			buildFileNameFieldByName('Nome do arquivo')
		]

		for (WindowsTestObject object : candidateObjects) {
			try {
				if (Windows.verifyElementPresent(
						object,
						1,
						FailureHandling.OPTIONAL)) {

					Windows.click(object)
					Windows.delay(1)
					return true
				}
			} catch (Exception ignored) {
			}
		}

		try {
			Windows.click(
					findWindowsObject(
							'General/txtFileName'
					)
			)

			Windows.delay(1)
			return true
		} catch (Exception ignored) {
		}

		try {
			focusFileNameFieldWithShortcut()
			Windows.delay(1)
			return true
		} catch (Exception ignored) {
		}

		return false
	}


	private WindowsTestObject buildFileNameFieldByAutomationId() {

		WindowsTestObject object =
				new WindowsTestObject(
						'fileNameFieldAutomationId'
				)

		object.setLocatorStrategy(
				LocatorStrategy.XPATH
		)

		object.setLocator(
				"//*[@AutomationId='FileNameControlHost']"
		)

		return object
	}


	private WindowsTestObject buildFileNameFieldByName(
			String name) {

		WindowsTestObject object =
				new WindowsTestObject(
						'fileNameField_' +
						sanitizeObjectName(name)
				)

		object.setLocatorStrategy(
				LocatorStrategy.XPATH
		)

		object.setLocator(
				"//*[contains(" +
				"translate(@Name, " +
				"'abcdefghijklmnopqrstuvwxyz', " +
				"'ABCDEFGHIJKLMNOPQRSTUVWXYZ'), " +
				"'" + name.toUpperCase() + "')]"
		)

		return object
	}


	private WindowsTestObject buildXpathObject(String xpath) {

		WindowsTestObject object =
				new WindowsTestObject()

		object.setLocatorStrategy(
				LocatorStrategy.XPATH
		)

		object.setLocator(xpath)

		return object
	}


	private String sanitizeObjectName(String text) {

		return text == null
				? 'empty'
				: text.replaceAll(
						'[^a-zA-Z0-9]',
						'_'
				)
	}


	private void focusFileNameFieldWithShortcut() {

		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_ALT)
		robot.keyPress(KeyEvent.VK_N)
		robot.keyRelease(KeyEvent.VK_N)
		robot.keyRelease(KeyEvent.VK_ALT)
	}


	private void clearFocusedField() {

		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_CONTROL)

		Windows.delay(1)

		robot.keyPress(KeyEvent.VK_BACK_SPACE)
		robot.keyRelease(KeyEvent.VK_BACK_SPACE)
	}


	private void pasteAndEnter(String text) {

		pasteText(text)

		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_ENTER)
		robot.keyRelease(KeyEvent.VK_ENTER)
	}


	private void pasteText(String text) {

		StringSelection selection =
				new StringSelection(text)

		Toolkit
			.getDefaultToolkit()
			.getSystemClipboard()
			.setContents(
					selection,
					null
			)

		Windows.delay(1)

		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_V)
		robot.keyRelease(KeyEvent.VK_V)
		robot.keyRelease(KeyEvent.VK_CONTROL)
	}
}
