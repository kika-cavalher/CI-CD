	private void closeOpenFileModalOrStop(Integer maxAttempts) {
		Integer safeMaxAttempts = maxAttempts == null || maxAttempts <= 0 ? 5 : maxAttempts
		boolean modalWasDetected = false

		for (int attempt = 1; attempt <= safeMaxAttempts; attempt++) {
			KeywordUtil.logInfo('Trying to close open-file modal. Attempt: ' + attempt + '/' + safeMaxAttempts)

			if (!isOpenFileModalDetected(1)) {
				KeywordUtil.logInfo('Open-file modal was not detected yet. Waiting before next attempt.')
				shortSleep(400)
				continue
			}

			modalWasDetected = true

			KeywordUtil.logInfo('Open-file modal detected. Trying to click Non button.')

			if (clickNonButtonInsideOpenFileModal()) {
				shortSleep(500)

				if (!isOpenFileModalDetected(1)) {
					KeywordUtil.logInfo('Open-file modal closed successfully by clicking Non.')
					return
				}

				KeywordUtil.logInfo('Non button was clicked, but modal is still visible. Retrying.')
			}

			KeywordUtil.logInfo('Could not click Non by element in this attempt. Retrying.')
			shortSleep(400)
		}

		if (modalWasDetected) {
			KeywordUtil.logInfo('Open-file modal was detected but Non was not clicked. Trying safe ESC fallback.')
			pressEscapeAfterModalDetected()

			shortSleep(500)

			if (!isOpenFileModalDetected(1)) {
				KeywordUtil.logInfo('Open-file modal closed successfully using ESC fallback.')
				return
			}
		}

		imageLoader.takeEvidence('OpenFileModalNonNotClicked.png')

		KeywordUtil.markFailedAndStop(
				'Could not close open-file modal.\n' +
				'Modal detected: ' + modalWasDetected + '\n' +
				'Expected modal: Export de données\n' +
				'Expected button: Non\n' +
				'Attempts: ' + safeMaxAttempts
				)
	}

	private boolean clickNonButtonInsideOpenFileModal() {
		if (clickFirstAvailableElement(OPEN_FILE_NON_BUTTON_XPATHS, 1, 'Open-file modal Non button')) {
			return true
		}

		if (clickFirstAvailableElementUsingDriverAndWindowHandles(OPEN_FILE_NON_BUTTON_XPATHS, 'Open-file modal Non button')) {
			return true
		}

		return false
	}

	private boolean isOpenFileModalDetected(Integer timeoutSeconds) {
		Integer safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 1 : timeoutSeconds
		long endTime = System.currentTimeMillis() + (safeTimeout * 1000L)

		while (System.currentTimeMillis() <= endTime) {
			if (isAnyElementPresent(OPEN_FILE_MODAL_XPATHS, 1, 'Open-file modal')) {
				return true
			}

			if (isAnyElementPresentUsingDriverAndWindowHandles(OPEN_FILE_MODAL_XPATHS)) {
				return true
			}

			shortSleep(200)
		}

		return false
	}

	private void pressEscapeAfterModalDetected() {
		if (!isOpenFileModalDetected(1)) {
			KeywordUtil.logInfo('ESC fallback was skipped because modal is not detected.')
			return
		}

		try {
			focusOpenFileModal()
		} catch (Exception e) {
			KeywordUtil.logInfo('Could not focus open-file modal before ESC fallback. Reason: ' + e.getMessage())
		}

		try {
			Robot robot = new Robot()
			robot.setAutoDelay(80)

			robot.keyPress(KeyEvent.VK_ESCAPE)
			robot.keyRelease(KeyEvent.VK_ESCAPE)

			KeywordUtil.logInfo('ESC key sent after confirming open-file modal exists.')
		} catch (Exception e) {
			KeywordUtil.logInfo('Could not send ESC fallback. Reason: ' + e.getMessage())
		}
	}

