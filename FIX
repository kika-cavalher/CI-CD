''')
        html.append('</head>\n')
        html.append('<body>\n')
        html.append('<h1>Windows Test Execution Report | Gaia</h1>\n')

        html.append('<div class="header-grid">\n')
        html.append(buildHeaderCard('Suite', flow.safe(suiteName)))
        html.append(buildHeaderCard('Start', flow.formatHeaderDate(startDate)))
        html.append(buildHeaderCard('End', flow.formatHeaderDate(endDate)))
        html.append(buildHeaderCard('Suite Duration', flow.formatDurationMillis(totalDurationMs)))
        html.append(buildHeaderCard('Executed', String.valueOf(executed)))
        html.append(buildHeaderCard('Passed', String.valueOf(passedCases.size())))
        html.append(buildHeaderCard('Failed', String.valueOf(failedCases.size())))
        html.append(buildHeaderCard('Avg/Test', avgTest))
        html.append('</div>\n')

        html.append('<div class="section-title failed">✘ Failed (')
        html.append(String.valueOf(failedCases.size()))
        html.append(')</div>\n')

        if (failedCases.isEmpty()) {
            html.append('<div class="empty-text">No failed tests.</div>\n')
        } else {
            failedCases.each { Map item ->
                html.append(buildFailedCaseHtml(item, baseDir))
            }
        }

        html.append('<div class="section-title passed">✔ Passed (')
        html.append(String.valueOf(passedCases.size()))
        html.append(')</div>\n')

        if (passedCases.isEmpty()) {
            html.append('<div class="empty-text">No passed tests.</div>\n')
        } else {
            passedCases.each { Map item ->
                html.append(buildPassedCaseHtml(item))
            }
        }

        if (!skippedCases.isEmpty()) {
            html.append('<div class="section-title skipped">Skipped (')
            html.append(String.valueOf(skippedCases.size()))
            html.append(')</div>\n')

            skippedCases.each { Map item ->
                html.append(buildSkippedCaseHtml(item))
            }
        }

        html.append('</body>\n')
        html.append('</html>\n')

        htmlFile.setText(html.toString(), 'UTF-8')
        return htmlFile.absolutePath
    }
}
