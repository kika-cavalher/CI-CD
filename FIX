	def isTimestampFolderName(String name) {
		if (name == null) {
			return false
		}

		return name ==~ /\d{8,}_\d{4,}/
	}

	def getCurrentSuiteName() {
		String reportPath = getResolvedReportPath()

		if (reportPath == null || reportPath.trim().isEmpty()) {
			KeywordUtil.markWarning("Report path is empty. Using fallback suite name.")
			return 'UnknownTestSuite'
		}

		File currentDir = new File(reportPath)

		if (!currentDir.exists()) {
			KeywordUtil.markWarning("Report folder does not exist: ${reportPath}")
			return 'UnknownTestSuite'
		}

		File pointer = currentDir

		while (pointer != null) {
			String folderName = pointer.getName()

			if (folderName != null
				&& !folderName.equalsIgnoreCase('Reports')
				&& !folderName.equalsIgnoreCase('PreLoad')
				&& !folderName.equalsIgnoreCase('logs')
				&& !folderName.equalsIgnoreCase('videos')
				&& !isTimestampFolderName(folderName)) {
				KeywordUtil.logInfo("Current Test Suite name detected: ${folderName}")
				return folderName
			}

			pointer = pointer.getParentFile()
		}

		return 'UnknownTestSuite'
	}

	def getSanitizedSuiteName() {
		return getCurrentSuiteName().replaceAll('[\\\\/:*?"<>|]', '_')
	}

	def getTimestamp() {
		return new SimpleDateFormat("yyyy-MM-dd HH.mm.ss").format(new Date())
	}

	def getSummaryName() {
		return getCurrentSuiteName() + ' ' + getTimestamp()
	}

	def getTestPlanName() {
		return getCurrentSuiteName() + TEST_PLAN_SUFFIX
	}

	def getAutoDescription() {
		String configuredDescription = getDescription()

		if (configuredDescription == null || configuredDescription.trim().isEmpty()) {
			return getCurrentSuiteName()
		}

		return configuredDescription
	}

