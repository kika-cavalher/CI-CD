            .detail-view.active,
            .chart-view.active {
                display: block;
            }

            .scenario-heading {
                font-size: 24px;
                font-weight: 700;
                margin-bottom: 14px;
            }

            .meta-chips {
                display: flex;
                gap: 10px;
                flex-wrap: wrap;
                margin-bottom: 22px;
            }

            .chip {
                display: inline-flex;
                align-items: center;
                padding: 8px 14px;
                border-radius: 999px;
                font-size: 12px;
                font-weight: 700;
                line-height: 1;
                border: 1px solid transparent;
            }

            .chip.meta {
                color: #17456d;
                background: #eef5ff;
                border-color: #cadef2;
            }

            .chip.suite {
                color: #114465;
                background: #eaf4fb;
                border-color: #d7e7f3;
            }

            .section-title {
                font-size: 13px;
                font-weight: 700;
                margin: 0 0 10px 0;
                color: #26384c;
            }

            .steps-table {
                width: 100%;
                border-collapse: collapse;
                background: var(--bg-panel);
                border: 1px solid var(--border);
