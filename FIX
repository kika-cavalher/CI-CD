
import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import java.awt.Robot
import java.awt.event.KeyEvent

import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.testobject.WindowsTestObject.LocatorStrategy
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

// ======================================================
// CHANGE ONLY THIS VALUE
// ======================================================
String exportLabel = 'EUR'

// ======================================================
// ELEMENT CONFIG
// ======================================================
String settingsElementName = 'MNU_FILE'
String menuElementName = 'Contre-valorisation'
String homeElementName = 'Modules'

// ======================================================
// TEST FLOW
// ======================================================
Robot robot = new Robot()

def buildNameObject = { String elementName ->
	WindowsTestObject object = new WindowsTestObject()
	object.setLocatorStrategy(LocatorStrategy.NAME)
	object.setLocator(elementName)
	return object
}

def clickByName = { String elementName ->
	WindowsTestObject object = buildNameObject(elementName)

	Windows.waitForElementPresent(
		object,
		10,
		FailureHandling.STOP_ON_FAILURE
	)

	Windows.click(object)
	Windows.delay(2)
}

def typeTextByKeyboard = { String value ->
	value.toUpperCase().each { String letter ->
		int keyCode = KeyEvent."VK_${letter}"

		robot.keyPress(keyCode)
		robot.keyRelease(keyCode)

		Windows.delay(1)
	}
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Open Settings\n' +
	'Element: ' + settingsElementName
)

clickByName(settingsElementName)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Open Cotre Parameters\n' +
	'Element: ' + menuElementName
)

clickByName(menuElementName)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Select currency\n' +
	'Currency: ' + exportLabel
)

typeTextByKeyboard(exportLabel)

robot.keyPress(KeyEvent.VK_TAB)
robot.keyRelease(KeyEvent.VK_TAB)

Windows.delay(1)

robot.keyPress(KeyEvent.VK_ENTER)
robot.keyRelease(KeyEvent.VK_ENTER)

Windows.delay(5)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Return to Modules\n' +
	'Element: ' + homeElementName
)

clickByName(homeElementName)

KeywordUtil.markPassed(
	'Cotre Parameters ' + exportLabel + ' configured successfully.'
)
