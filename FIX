    String resolveEpicFieldId() {
        if (!owner.isBlank(cachedEpicFieldId)) {
            return cachedEpicFieldId
        }

        try {
            RequestObject request = new RequestObject('Runtime Get Jira Fields')
            request.setRestUrl(owner.JIRA_BASE_URL + '/rest/api/2/field')
            request.setRestRequestMethod('GET')
            request.setHttpHeaderProperties(defaultGetHeaders())

            ResponseObject response = WS.sendRequest(request)
            int status = response.getStatusCode()
            String body = safeBody(response)

            if (status != 200) {
                KeywordUtil.logInfo("Get fields failed with status: ${status}")
                return ''
            }

            def parsed = parseJson(body)
            if (!(parsed instanceof List)) {
                return ''
            }

            def epicField = parsed.find { def field ->
                String name = owner.safe(field?.name)
                String custom = owner.safe(field?.schema?.custom)
                return owner.normalizeTitle(name) == 'epic link' ||
                       custom == 'com.pyxis.greenhopper.jira:gh-epic-link'
            }

            cachedEpicFieldId = owner.safe(epicField?.id)
            KeywordUtil.logInfo("Resolved Epic Link field id: ${cachedEpicFieldId}")

            return cachedEpicFieldId
        } catch (Exception e) {
            KeywordUtil.logInfo("Epic field resolution skipped: ${e.message}")
            return ''
        }
    }

    private List<Map> buildAssigneePayloads() {
        List<Map> payloads = new ArrayList<Map>()
        Set<String> seen = new LinkedHashSet<String>()

        String accountId = owner.safe(owner.ASSIGNEE_ACCOUNT_ID)
        String name = owner.safe(owner.ASSIGNEE_NAME)
        String displayName = owner.safe(owner.ASSIGNEE_DISPLAY_NAME)

        if (!owner.isBlank(accountId) && seen.add('accountId:' + accountId)) {
            payloads.add([accountId: accountId])
        }
        if (!owner.isBlank(name) && seen.add('name:' + name)) {
            payloads.add([name: name])
        }
        if (!owner.isBlank(displayName) && seen.add('name:' + displayName)) {
            payloads.add([name: displayName])
        }

        return payloads
    }

    private String resolveToken() {
        try {
            def direct = GlobalVariable.JIRA_TOKEN
            if (!owner.isBlank(direct)) {
                return owner.safe(direct)
            }
        } catch (Exception ignored) {
        }

        try {
            def fallback = GlobalVariable.token
            if (!owner.isBlank(fallback)) {
                return owner.safe(fallback)
            }
        } catch (Exception ignored) {
        }

        return owner.safe(owner.JIRA_TOKEN)
    }

    private List<TestObjectProperty> defaultGetHeaders() {
        return [
            header('Authorization', 'Bearer ' + resolveToken()),
            header('Accept', 'application/json')
        ]
    }

    private List<TestObjectProperty> jsonHeaders() {
        return [
            header('Authorization', 'Bearer ' + resolveToken()),
            header('Accept', 'application/json'),
            header('Content-Type', 'application/json')
        ]
    }

    private TestObjectProperty header(String name, String value) {
        return new TestObjectProperty(name, ConditionType.EQUALS, value)
    }

    private HttpTextBodyContent jsonBody(Object payload) {
        String text = new JsonBuilder(payload).toString()
        return new HttpTextBodyContent(text, 'UTF-8', 'application/json')
    }

    private Object parseJson(String body) {
        if (owner.isBlank(body)) {
            return [:]
        }
        try {
            return jsonSlurper.parseText(body)
        } catch (Exception ignored) {
            return [:]
        }
    }

    private String safeBody(ResponseObject response) {
        try {
            return owner.safe(response?.getResponseBodyContent())
        } catch (Exception ignored) {
            return ''
        }
    }

    private String encode(String value) {
        return URLEncoder.encode(owner.safe(value), StandardCharsets.UTF_8.toString())
    }
