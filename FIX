@Keyword
def openEnvironmentSelector(String targetEnvironment) {
	stopImmediatelyIfWrongVersionWasAlreadyDetected()

	String environment = normalizeEnvironment(targetEnvironment)

	if (isProductionEnvironment(environment)) {
		KeywordUtil.logInfo("PRD does not use credential modal or environment selector. Skipping environment selector.")
		return
	}

	validateCorrectVersionWindowOrStop(environment)

	tryFocusApplicationWindow(targetEnvironment, true)

	if (!isLoginScreenVisibleSafely()) {
		KeywordUtil.markFailedAndStop(
				"Login screen is not visible, but it was expected before selecting environment.\n" +
				"Environment: " + environment
				)
	}

	WindowsTestObject environmentCombo = WindowsObjectLoader.getObject('authentication', 'environmentCombo')

	boolean isComboPresent = Windows.verifyElementPresent(
			environmentCombo,
			10,
			FailureHandling.OPTIONAL
			)

	if (!isComboPresent) {
		KeywordUtil.markFailedAndStop(
				"Environment combo was not found by NAME.\n" +
				"Expected Name: Environnement eMatch\n" +
				"Environment: " + environment
				)
	}

	KeywordUtil.logInfo("Environment eMatch combo found. Selection will be done in selectEnvironment.")
}
