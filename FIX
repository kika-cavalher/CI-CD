    private String buildEvidenceSection(List<Map> evidences) {
        if (evidences == null || evidences.isEmpty()) {
            return ''
        }

        StringBuilder html = new StringBuilder()
        html.append('<div class="evidence-block">')
        html.append('<div class="section-title">Evidence</div>')

        evidences.each { Map evidence ->
            String href = safeValue(evidence.href)
            String imageSrc = safeValue(evidence.imageSrc)
            String fileName = safeValue(evidence.fileName)

            html.append('<div class="evidence-item">')
            html.append('<div class="evidence-name">')
            html.append(htmlEscape(fileName))
            html.append('</div>')
            html.append('<a class="evidence-link" target="_blank" rel="noopener noreferrer" href="')
            html.append(htmlEscape(href))
            html.append('">🔎 Open evidence</a>')

            if (!isBlank(imageSrc)) {
                html.append('<div class="evidence-image-wrap">')
                html.append('<img class="evidence-image" src="')
                html.append(htmlEscape(imageSrc))
                html.append('" alt="Evidence" onerror="this.style.display=\'none\';">')
                html.append('</div>')
            }

            html.append('</div>')
        }

        html.append('</div>')
        return html.toString()
    }

