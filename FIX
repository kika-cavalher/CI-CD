import groovy.transform.Field

@Field int PIPELINE_TIMEOUT_MINUTES = 240

@Field Map SUITE = [
    NODE_LABEL              : 'GI5_SWDCFRNXGI55817',
    CUSTOM_WORKSPACE_PATH   : 'D:/jenkins/work/workspace/GI5/eMatch_Regression/Passerelle Bilan',

    STARTERS_DIR            : 'D:/Projects/eMatchStarters',
    TASK_NAME               : '\\eMatch Automation\\RunEMatchDesktop',

    WINAPPDRIVER_EXE        : 'C:/Program Files (x86)/Windows Application Driver/WinAppDriver.exe',
    AUTO_START_WINAPPDRIVER : true,

    KATALON_EXE             : 'C:/Users/adgi5appjenkins/Documents/Katalon_Studio_Engine_Windows_64-8.1.0/katalonc.exe',
    PROJECT_FILE            : 'eMatch POC.prj',

    SUITE_NAME              : 'Passerelle Bilan',
    SUITE_TYPE              : 'COLLECTION',
    SUITE_PATH              : 'Test Suites/Passerelle Bilan/Passerelle Bilan Collection',

    BROWSER_TYPE            : 'Windows',
    RETRY                   : '0',
    TIMEOUT_MINUTES         : 180,

    NEXT_JOB_NAME           : '',
    WAIT_FOR_NEXT_JOB       : false,
    PROPAGATE_NEXT_JOB_FAIL : false
]

pipeline {
    agent {
        node {
            label SUITE.NODE_LABEL
            customWorkspace SUITE.CUSTOM_WORKSPACE_PATH
        }
    }

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        timeout(time: PIPELINE_TIMEOUT_MINUTES, unit: 'MINUTES')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "Workspace: ${pwd()}"
            }
        }

        stage('Run Desktop Suite') {
            steps {
                script {
                    def consoleView = load 'jenkinsIntegration/JenkinsConsoleView.groovy'
                    def taskLogger = load 'jenkinsIntegration/JenkinsDesktopTaskLogger.groovy'
                    def paths = load 'jenkinsIntegration/JenkinsPaths.groovy'
                    def resultStore = load 'jenkinsIntegration/JenkinsResultStore.groovy'

                    String workspace = paths.workspace(this)
                    String reportsRoot = paths.reportsRoot(this)
                    String logsRoot = paths.desktopLogsRoot(this)
                    String projectPath = paths.projectPath(this, SUITE.PROJECT_FILE)

                    Map asset = [
                        name          : SUITE.SUITE_NAME,
                        type          : SUITE.SUITE_TYPE,
                        path          : SUITE.SUITE_PATH,
                        timeoutMinutes: SUITE.TIMEOUT_MINUTES
                    ]

                    Map runnerCfg = [
                        workspace             : workspace,
                        reportsRoot           : reportsRoot,
                        logsDir               : logsRoot,
                        startersDir           : SUITE.STARTERS_DIR,
                        desktopRunnerTask     : SUITE.TASK_NAME,
                        winAppDriverExe       : SUITE.WINAPPDRIVER_EXE,
                        autoStartWinAppDriver : SUITE.AUTO_START_WINAPPDRIVER.toString(),
                        katalonExe            : SUITE.KATALON_EXE,
                        projectPath           : projectPath,
                        browserType           : SUITE.BROWSER_TYPE,
                        retry                 : SUITE.RETRY,
                        runLabel              : "${SUITE.SUITE_NAME} Build ${env.BUILD_NUMBER}"
                    ]

                    Map result = [
                        name           : asset.name,
                        type           : asset.type,
                        status         : 'FAILED',
                        icon           : '❌',
                        executed       : 0,
                        passed         : 0,
                        failed         : 0,
                        skipped        : 0,
                        reason         : 'Pipeline failed before desktop result was generated',
                        logRel         : '_desktop_logs/katalon_current.log',
                        durationSeconds: 0,
                        caseSummary    : []
                    ]

                    consoleView.printAssetHeader(this, asset, SUITE.TIMEOUT_MINUTES.toString())

                    try {
                        result = taskLogger.runAsset(this, runnerCfg, asset)
                    }
                    finally {
                        resultStore.saveSuiteResults(this, reportsRoot, [result])
                        consoleView.printAssetResult(this, result)
                        consoleView.printRunningSummary(this, [result])
                    }

                    if ((result.status ?: '').toString().trim().toUpperCase() != 'PASSED') {
                        error(result.reason ?: 'Desktop execution failed.')
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                def consoleView = load 'jenkinsIntegration/JenkinsConsoleView.groovy'
                def paths = load 'jenkinsIntegration/JenkinsPaths.groovy'
                def resultStore = load 'jenkinsIntegration/JenkinsResultStore.groovy'

                String reportsRoot = paths.reportsRoot(this)
                List results = resultStore.loadSuiteResults(this, reportsRoot)

                consoleView.printFinalSummary(this, results, currentBuild.currentResult ?: 'UNKNOWN')
            }

            archiveArtifacts allowEmptyArchive: true, artifacts: 'Reports/**/*'
            junit allowEmptyResults: true, testResults: 'Reports/**/JUnit_Report
