	private void dragMoisArreteToMeasures() {
		WindowsTestObject sourceObject = findMoisArreteObject()
		WindowsTestObject targetObject = findMeasuresObject()

		if (sourceObject == null) {
			imageLoader.takeEvidence('MoisArreteObjectNotFound.png')

			KeywordUtil.markFailedAndStop(
					'Could not find source object for drag and drop.\n' +
					'Expected source: Mois d\'arrêté'
					)
		}

		if (targetObject == null) {
			imageLoader.takeEvidence('MeasuresObjectNotFound.png')

			KeywordUtil.markFailedAndStop(
					'Could not find target object for drag and drop.\n' +
					'Expected target: Mesures'
					)
		}

		def sourceRect = Windows.getElementRect(sourceObject)
		def targetRect = Windows.getElementRect(targetObject)

		int startX = sourceRect.getX() + Math.floor(sourceRect.getWidth() / 2).intValue()
		int startY = sourceRect.getY() + Math.floor(getSafeHeight(sourceRect) / 2).intValue()

		int endX = targetRect.getX() + Math.floor(targetRect.getWidth() / 2).intValue()
		int endY = targetRect.getY() + Math.floor(getSafeHeight(targetRect) / 2).intValue()

		dragAndDrop(startX, startY, endX, endY)
		Windows.delay(3)
	}

	private WindowsTestObject findMoisArreteObject() {
		List<WindowsTestObject> candidates = [
			buildXpathObject("//*[contains(@Name,\"Mois d'arrêt\")]"),
			buildXpathObject("//*[contains(@Name,\"Mois d'arret\")]"),
			buildXpathObject("//*[contains(@Name,\"Mois d’arrêt\")]"),
			buildXpathObject("//*[contains(@Name,\"Mois d arre\")]")
		]

		for (WindowsTestObject candidate : candidates) {
			try {
				boolean isPresent = Windows.verifyElementPresent(
						candidate,
						3,
						FailureHandling.OPTIONAL
						)

				if (isPresent) {
					return candidate
				}
			} catch (Exception ignored) {
			}
		}

		return null
	}

	private WindowsTestObject findMeasuresObject() {
		List<WindowsTestObject> candidates = [
			buildXpathObject("//*[contains(@Name,\"Mesures\")]"),
			buildXpathObject("//*[contains(@Name,\"Measures\")]")
		]

		for (WindowsTestObject candidate : candidates) {
			try {
				boolean isPresent = Windows.verifyElementPresent(
						candidate,
						3,
						FailureHandling.OPTIONAL
						)

				if (isPresent) {
					return candidate
				}
			} catch (Exception ignored) {
			}
		}

		return null
	}

	private boolean scrollUntilImageVisible(String imageGroup, String imageKey, boolean scrollUp, int maxScrollMoves) {
		for (int i = 0; i < maxScrollMoves; i++) {
			if (imageLoader.isVisible(imageGroup, imageKey)) {
				KeywordUtil.logInfo(
						'Image found during scroll.\n' +
						'Image group: ' + imageGroup + '\n' +
						'Image key: ' + imageKey + '\n' +
						'Scroll direction: ' + (scrollUp ? 'UP' : 'DOWN') + '\n' +
						'Scroll step: ' + i
						)
				return true
			}

			scrollOneStep(scrollUp)
			Windows.delay(1)
		}

		return false
	}

	private WindowsTestObject buildXpathObject(String xpath) {
		WindowsTestObject object = new WindowsTestObject()
		object.setLocatorStrategy(LocatorStrategy.XPATH)
		object.setLocator(xpath)

		return object
	}

	private void dragAndDrop(int startX, int startY, int endX, int endY) {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.mouseMove(startX, startY)
		Windows.delay(1)

		robot.mousePress(InputEvent.BUTTON1_DOWN_MASK)
		Windows.delay(1)

		robot.mouseMove(endX, endY)
		Windows.delay(1)

		robot.mouseRelease(InputEvent.BUTTON1_DOWN_MASK)
		Windows.delay(1)
	}

	private void scrollOneStep(boolean scrollUp) {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		if (scrollUp) {
			robot.mouseWheel(-3)
		} else {
			robot.mouseWheel(3)
		}
	}

	private int getSafeHeight(def rect) {
		int height = rect.getHeight()

		if (height <= 0) {
			return 20
		}

		return height
	}
