import com.kms.katalon.core.util.KeywordUtil


// ======================================================
// COMPARISON CONFIG
// ======================================================

String recEnvironment = 'REC'
String prdEnvironment = 'PRD'

String exportLabel = 'Synthese_Justification_Latent'

Integer reportStepDelayMilliseconds = 1200


// ======================================================
// REPORT HELPER
// ======================================================

def reportStep = { String details ->

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		details
	)

	Thread.sleep(reportStepDelayMilliseconds)
}


// ======================================================
// RESOLVE REC EXPORT
// ======================================================

reportStep(
	'Resolve REC Synthèse export\n' +
	'Environment: ' +
	recEnvironment +
	'\nExport label: ' +
	exportLabel
)

Map recExportValidation =
	CustomKeywords.
	'commands.ExportFileValidationKeywords.validateExportedFileExistsAndHasRows'(
		recEnvironment,
		exportLabel
	)

if (recExportValidation == null ||
		recExportValidation.success != true) {

	String recErrors =
		recExportValidation == null
			? 'Validation returned no result.'
			: String.valueOf(recExportValidation.errors ?: '').trim()

	KeywordUtil.markFailedAndStop(
		'REC Synthèse export could not be resolved.\n' +
		'Environment: ' +
		recEnvironment +
		'\nExport label: ' +
		exportLabel +
		(
			recErrors.isEmpty()
				? ''
				: '\nDetails: ' + recErrors
		)
	)
}

String recExportPath =
	String.valueOf(
		recExportValidation.filePath
	).trim()

if (recExportPath.isEmpty()) {
	KeywordUtil.markFailedAndStop(
		'REC Synthèse export path was not returned.\n' +
		'Environment: ' +
		recEnvironment +
		'\nExport label: ' +
		exportLabel
	)
}

reportStep(
	'REC Synthèse export resolved successfully\n' +
	'File: ' +
	recExportValidation.fileName +
	'\nPath: ' +
	recExportPath +
	'\nData rows: ' +
	recExportValidation.dataRows +
	'\nFile size: ' +
	recExportValidation.fileSize +
	' bytes'
)


// ======================================================
// RESOLVE PRD EXPORT
// ======================================================

reportStep(
	'Resolve PRD Synthèse export\n' +
	'Environment: ' +
	prdEnvironment +
	'\nExport label: ' +
	exportLabel
)

Map prdExportValidation =
	CustomKeywords.
	'commands.ExportFileValidationKeywords.validateExportedFileExistsAndHasRows'(
		prdEnvironment,
		exportLabel
	)

if (prdExportValidation == null ||
		prdExportValidation.success != true) {

	String prdErrors =
		prdExportValidation == null
			? 'Validation returned no result.'
			: String.valueOf(prdExportValidation.errors ?: '').trim()

	KeywordUtil.markFailedAndStop(
		'PRD Synthèse export could not be resolved.\n' +
		'Environment: ' +
		prdEnvironment +
		'\nExport label: ' +
		exportLabel +
		(
			prdErrors.isEmpty()
				? ''
				: '\nDetails: ' + prdErrors
		)
	)
}

String prdExportPath =
	String.valueOf(
		prdExportValidation.filePath
	).trim()

if (prdExportPath.isEmpty()) {
	KeywordUtil.markFailedAndStop(
		'PRD Synthèse export path was not returned.\n' +
		'Environment: ' +
		prdEnvironment +
		'\nExport label: ' +
		exportLabel
	)
}

reportStep(
	'PRD Synthèse export resolved successfully\n' +
	'File: ' +
	prdExportValidation.fileName +
	'\nPath: ' +
	prdExportPath +
	'\nData rows: ' +
	prdExportValidation.dataRows +
	'\nFile size: ' +
	prdExportValidation.fileSize +
	' bytes'
)


// ======================================================
// COMPARE REC AND PRD EXPORTS
// ======================================================

reportStep(
	'Compare Synthèse REC and PRD exports\n' +
	'REC file: ' +
	recExportValidation.fileName +
	'\nPRD file: ' +
	prdExportValidation.fileName +
	'\nValidations:\n' +
	'- Number of table headers\n' +
	'- Header names and order\n' +
	'- Number of data rows\n' +
	'- Numeric data count\n' +
	'- Numeric data checksum'
)

Map comparison =
	CustomKeywords.
	'commands.RecPrdExportValidationKeywords.validateSyntheseRecPrdExports'(
		recExportPath,
		prdExportPath
	)

if (comparison == null ||
		comparison.success != true) {

	String comparisonErrors =
		comparison == null
			? 'Comparison returned no result.'
			: String.valueOf(comparison.errors ?: '').trim()

	KeywordUtil.markFailedAndStop(
		'Synthèse REC x PRD comparison failed.\n' +
		(
			comparisonErrors.isEmpty()
				? 'No comparison error details were returned.'
				: comparisonErrors
		)
	)
}

reportStep(
	'Synthèse REC x PRD comparison passed\n' +
	'REC file: ' +
	comparison.recFileName +
	'\nPRD file: ' +
	comparison.prdFileName +
	'\nREC headers: ' +
	comparison.recHeaders +
	'\nPRD headers: ' +
	comparison.prdHeaders +
	'\nREC data rows: ' +
	comparison.recRows +
	'\nPRD data rows: ' +
	comparison.prdRows +
	'\nREC numeric data count: ' +
	comparison.recNumericValueCount +
	'\nPRD numeric data count: ' +
	comparison.prdNumericValueCount +
	'\nREC numeric data checksum: ' +
	comparison.recNumericChecksum +
	'\nPRD numeric data checksum: ' +
	comparison.prdNumericChecksum
)

reportStep(
	'Synthèse REC x PRD validation completed successfully\n' +
	'Export label: ' +
	exportLabel +
	'\nResult: PASSED'
)

KeywordUtil.markPassed(
	'Synthèse REC x PRD export and amount validations completed successfully.'
)
