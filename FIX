package pageObject

import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import java.awt.Robot
import java.awt.Toolkit
import java.awt.datatransfer.StringSelection
import java.awt.event.InputEvent
import java.awt.event.KeyEvent

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.testobject.WindowsTestObject.LocatorStrategy
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import commands.ImageLoader
import internal.GlobalVariable

class authenticationKeywords {

	private static final String IMAGE_GROUP = 'authentication'
	private ImageLoader imageLoader = new ImageLoader()

	@Keyword
	def launchApplication(String targetEnvironment) {
		String environment = normalizeEnvironment(targetEnvironment)

		saveCurrentEnvironment(environment)
		note('Environment: ' + environment)
		note('Verify if the app is open')

		switchToVersionWindow(environment)
		openEnvironmentSelector(environment)
		selectEnvironment(environment)
		clickConnectIfPresent(environment)
		waitForMainScreen(environment)
		validateAndStoreCurrentEnvironment(environment)
		clickHomeTab(environment)

		note('Application launched successfully')
	}

	@Keyword
	def switchToVersionWindow(String targetEnvironment) {
		String environment = normalizeEnvironment(targetEnvironment)
		saveCurrentEnvironment(environment)

		note('Verify if the version is correct')
		Windows.delay(2)
	}

	@Keyword
	def openEnvironmentSelector(String targetEnvironment) {
		String environment = normalizeEnvironment(targetEnvironment)
		saveCurrentEnvironment(environment)

		note('Opened environment selector')
		Windows.delay(1)

		List<String> candidates = [
			'Login Page/environmentSelector',
			'Login Page/cmbEnvironment',
			'Authentication/environmentSelector',
			'Authentication/cmbEnvironment'
		]

		boolean clicked = tryClickFirstPresentObject(candidates)

		if (!clicked) {
			KeywordUtil.logInfo(
				'Environment selector was not found by Object Repository. ' +
				'Continuing without hard failure.'
			)
		}
	}

	@Keyword
	def selectEnvironment(String targetEnvironment) {
		String environment = normalizeEnvironment(targetEnvironment)
		saveCurrentEnvironment(environment)

		note('Select the environment and the Username')

		boolean clickedField = tryClickFirstPresentObject([
			'Login Page/environmentSelector',
			'Login Page/cmbEnvironment',
			'Authentication/environmentSelector',
			'Authentication/cmbEnvironment'
		])

		if (clickedField) {
			Windows.delay(1)
			selectEnvironmentByKeyboard(environment)
			return
		}

		KeywordUtil.logInfo(
			'Environment field was not found by Object Repository. ' +
			'Trying keyboard selection only.'
		)

		selectEnvironmentByKeyboard(environment)
	}

	@Keyword
	def clickConnectIfPresent(String targetEnvironment) {
		String environment = normalizeEnvironment(targetEnvironment)
		saveCurrentEnvironment(environment)

		boolean clicked = tryClickFirstPresentObject([
			'Login Page/btnConnect',
			'Login Page/connectBtn',
			'Authentication/btnConnect',
			'Authentication/connectBtn'
		])

		if (clicked) {
			note('Connect button clicked')
			Windows.delay(2)
			return
		}

		KeywordUtil.logInfo(
			'Connect button was not found by Object Repository. ' +
			'Trying ENTER as fallback.'
		)

		pressEnter()
		Windows.delay(2)
	}

	@Keyword
	def waitForMainScreen(String targetEnvironment) {
		String environment = normalizeEnvironment(targetEnvironment)
		saveCurrentEnvironment(environment)

		boolean mainScreenVisible = waitForMainScreenByImageAndLoginClosed(60)

		if (!mainScreenVisible) {
			KeywordUtil.markFailedAndStop(
				'Main screen was not validated after login.\n' +
				'Expected at least one visible image from group: ' + IMAGE_GROUP
			)
		}

		note('Opened login screen')
		KeywordUtil.logInfo('Main screen validated successfully using image group: ' + IMAGE_GROUP)
	}

	@Keyword
	def clickHomeTab(String targetEnvironment) {
		String environment = normalizeEnvironment(targetEnvironment)
		saveCurrentEnvironment(environment)

		boolean clicked = false

		try {
			clicked = imageLoader.clickFirstVisibleInGroup(IMAGE_GROUP, 8)
		} catch (Exception e) {
			KeywordUtil.logInfo('Could not click home tab image. Reason: ' + e.getMessage())
		}

		if (clicked) {
			KeywordUtil.logInfo('First visible image clicked successfully.')
			return
		}

		KeywordUtil.logInfo(
			'Home tab image was not clicked, but main screen is already visible. ' +
			'Continuing without hard failure.'
		)
	}

	private void saveCurrentEnvironment(String environment) {
		String normalizedEnvironment = normalizeEnvironment(environment)
		GlobalVariable.currentEnvironment = normalizedEnvironment

		KeywordUtil.logInfo(
			'Current environment saved from authentication flow: ' +
			GlobalVariable.currentEnvironment
		)
	}

	private void validateAndStoreCurrentEnvironment(String expectedEnvironment) {
		String normalizedExpected = normalizeEnvironment(expectedEnvironment)
		String detectedEnvironment = detectCurrentEnvironment()

		if (!detectedEnvironment.equalsIgnoreCase(normalizedExpected)) {
			KeywordUtil.markFailedAndStop(
				'Wrong environment detected after login.\n' +
				'Expected: ' + normalizedExpected + '\n' +
				'Detected: ' + detectedEnvironment
			)
		}

		GlobalVariable.currentEnvironment = detectedEnvironment

		KeywordUtil.logInfo(
			'Environment validated successfully after login: ' +
			GlobalVariable.currentEnvironment
		)
	}

	private String detectCurrentEnvironment() {
		try {
			String currentEnvText = Windows.getText(findWindowsObject('General/curEnv'))
			return normalizeEnvironment(currentEnvText)
		} catch (Exception e) {
			KeywordUtil.logInfo(
				'Could not read current environment using Object Repository General/curEnv. ' +
				'Trying image fallback. Reason: ' + e.getMessage()
			)
		}

		try {
			if (imageLoader.isVisible('General', 'envImage') || imageLoader.isVisible('General', 'envImagr')) {
				return 'Rec'
			}
		} catch (Exception e) {
			KeywordUtil.logInfo('Environment image fallback failed. Reason: ' + e.getMessage())
		}

		return normalizeEnvironment(GlobalVariable.currentEnvironment)
	}

	private boolean waitForMainScreenByImageAndLoginClosed(int timeoutSeconds) {
		int elapsedSeconds = 0

		while (elapsedSeconds < timeoutSeconds) {
			boolean homeImageVisible = imageLoader.isGroupVisible(IMAGE_GROUP)

			if (homeImageVisible) {
				return true
			}

			Windows.delay(2)
			elapsedSeconds = elapsedSeconds + 2
		}

		return imageLoader.isGroupVisible(IMAGE_GROUP)
	}

	private boolean tryClickFirstPresentObject(List<String> objectPaths) {
		for (String objectPath : objectPaths) {
			try {
				WindowsTestObject obj = findWindowsObject(objectPath)

				boolean present = Windows.verifyElementPresent(
					obj,
					2,
					FailureHandling.OPTIONAL
				)

				if (present) {
					try {
						Windows.click(obj)
					} catch (Exception clickError) {
						clickElementCenterByCoordinates(obj)
					}

					return true
				}
			} catch (Exception ignored) {
			}
		}

		return false
	}

	private void selectEnvironmentByKeyboard(String environment) {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_HOME)
		robot.keyRelease(KeyEvent.VK_HOME)
		Windows.delay(1)

		if (environment.equalsIgnoreCase('PROD')) {
			robot.keyPress(KeyEvent.VK_DOWN)
			robot.keyRelease(KeyEvent.VK_DOWN)
			Windows.delay(1)
		}

		robot.keyPress(KeyEvent.VK_ENTER)
		robot.keyRelease(KeyEvent.VK_ENTER)
		Windows.delay(1)
	}

	private void pressEnter() {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_ENTER)
		robot.keyRelease(KeyEvent.VK_ENTER)
	}

	private void clickElementCenterByCoordinates(WindowsTestObject object) {
		def rect = Windows.getElementRect(object)

		int x = rect.getX() + Math.floor(rect.getWidth() / 2).intValue()
		int y = rect.getY() + Math.floor(getSafeHeight(rect) / 2).intValue()

		mouseClick(x, y)
	}

	private void mouseClick(int x, int y) {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.mouseMove(x, y)
		Windows.delay(1)

		robot.mousePress(InputEvent.BUTTON1_DOWN_MASK)
		Windows.delay(1)
		robot.mouseRelease(InputEvent.BUTTON1_DOWN_MASK)

		Windows.delay(1)
	}

	private int getSafeHeight(def rect) {
		int height = rect.getHeight()

		if (height <= 0) {
			return 20
		}

		return height
	}

	private String normalizeEnvironment(String environmentText) {
		String cleanValue = environmentText == null ? '' : environmentText.toString().trim()

		if (
			cleanValue.equalsIgnoreCase('Rec') ||
			cleanValue.equalsIgnoreCase('REC') ||
			cleanValue.equalsIgnoreCase('Recette')
		) {
			return 'Rec'
		}

		return 'PROD'
	}

	private void note(String message) {
		try {
			CustomKeywords.'jiraIntegration.JiraReportSteps.note'(message)
		} catch (Exception ignored) {
			KeywordUtil.logInfo(message)
		}
	}
}
