	// ---------------------------------------------------------
	// closeDetailAndReturnToMain
	// ---------------------------------------------------------
	// Uses:
	// Global variable: GlobalVariable.version
	// Helpers: safeTimeout, safeText, switchToAnyWindowTitle

	@Keyword
	String closeDetailAndReturnToMain(
			String targetEnvironment,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)

		// Close detail window
		Windows.closeApplication()
		Windows.delay(POLLING_DELAY_SECONDS)

		// Build possible main window titles
		List<String> possibleMainTitles = []
		String versionTitle =
			safeText(GlobalVariable.version)

		if (!versionTitle.isEmpty()) {
			possibleMainTitles.add(versionTitle)
		}

		// Resolve environment
		String environment =
			safeText(targetEnvironment)
				.toUpperCase(Locale.ROOT)

		if (environment.equals('REC')) {
			possibleMainTitles.addAll([
				'eMatch REC2',
				'eMatch REC',
				'eMatch RECETTE'
			])
		} else if (environment.equals('PRD')) {
			possibleMainTitles.addAll([
				'eMatch PRD',
				'eMatch PRODUCTION'
			])
		}

		// Remove duplicate titles
		possibleMainTitles =
			possibleMainTitles.unique()

		// Return to main eMatch window
		String openedTitle =
			switchToAnyWindowTitle(
				possibleMainTitles,
				timeout
			)

		if (openedTitle.isEmpty()) {
			KeywordUtil.markFailedAndStop(
				'Could not return to the eMatch main window. ' +
				'Expected one of: ' +
				possibleMainTitles
			)

			return ''
		}

		return openedTitle
	}



	// ---------------------------------------------------------
	// validateMontantCcyBetweenExports
	// ---------------------------------------------------------
	// Uses:
	// Excel columns: Total (ccy), Montant ccy
	// Helpers: validateExcelFile, readMainTotalCcy,
	// detailContainsMontantCcy

	@Keyword
	Map validateMontantCcyBetweenExports(
			String mainFilePath,
			String bilanDetailFilePath,
			String resultatDetailFilePath
		) {

		// Validate input files
		File mainFile = validateExcelFile(
			mainFilePath,
			'Main investigations export'
		)

		File bilanFile = validateExcelFile(
			bilanDetailFilePath,
			'Bilan detail export'
		)

		File resultatFile = validateExcelFile(
			resultatDetailFilePath,
			'Resultat detail export'
		)

		// Read Total (ccy) reference
		BigDecimal mainReference = readMainTotalCcy(mainFile)

		// Compare Bilan detail
		Boolean bilanMatch = detailContainsMontantCcy(
			bilanFile,
			mainReference
		)

		// Compare Resultat detail
		Boolean resultatMatch = detailContainsMontantCcy(
			resultatFile,
			mainReference
		)

		// Validate comparison result
		if (!bilanMatch || !resultatMatch) {
			String errors = ''

			if (!bilanMatch) {
				errors +=
					'\nBilan detail export does not contain Montant ccy matching the main Total (ccy).'
			}

			if (!resultatMatch) {
				errors +=
					'\nResultat detail export does not contain Montant ccy matching the main Total (ccy).'
			}

			KeywordUtil.markFailedAndStop(
				errors +
				'\nExpected absolute rounded value: ' +
				mainReference.abs().setScale(0, RoundingMode.HALF_UP)
			)
		}

		// Result
		return [
			mainFileName     : mainFile.name,
			bilanFileName    : bilanFile.name,
			resultatFileName : resultatFile.name,
			mainTotalCcy     : mainReference,
			bilanMatch       : bilanMatch,
			resultatMatch    : resultatMatch
		]
	}


