@echo off
setlocal EnableExtensions EnableDelayedExpansion

rem ==========================================================
rem eMatch generic runner (called by Task Scheduler)
rem Reads: D:\Projects\eMatchStarters\run-context.properties
rem Writes:
rem   %WORKSPACE%\Reports\_jenkins_task_exitcode.txt
rem   %WORKSPACE%\Reports\**\JUnit_Report.xml (Katalon)
rem ==========================================================

set "CTX_FILE=D:\Projects\eMatchStarters\run-context.properties"

if not exist "%CTX_FILE%" (
  echo [ERROR] Context file not found: "%CTX_FILE%"
  exit /b 2
)

rem ---------- Load properties ----------
for /f "usebackq tokens=1,* delims==" %%A in ("%CTX_FILE%") do (
  set "K=%%A"
  set "V=%%B"
  if not "!K!"=="" set "!K!=!V!"
)

rem Expected keys:
rem   WORKSPACE
rem   PROJECT_FILE
rem   COLLECTION_PATH
rem   REPORT_FOLDER

if "%WORKSPACE%"=="" (
  echo [ERROR] WORKSPACE missing in context file
  exit /b 3
)

if "%PROJECT_FILE%"=="" (
  echo [ERROR] PROJECT_FILE missing in context file
  exit /b 3
)

if "%COLLECTION_PATH%"=="" (
  echo [ERROR] COLLECTION_PATH missing in context file
  exit /b 3
)

if "%REPORT_FOLDER%"=="" (
  set "REPORT_FOLDER=%WORKSPACE%\Reports"
)

rem ---------- Paths ----------
set "KATALON_HOME=C:\Users\adgj5appjenkins\Documents\Katalon_Studio_Engine_Windows_64-8.1.0"
set "KATALON_EXE=%KATALON_HOME%\katalonc.exe"

set "PROJECT_PATH=%WORKSPACE%\%PROJECT_FILE%"
set "EXIT_FILE=%REPORT_FOLDER%\_jenkins_task_exitcode.txt"

rem ---------- Ensure report folder ----------
if not exist "%REPORT_FOLDER%" mkdir "%REPORT_FOLDER%" >nul 2>nul

echo ==========================================================
echo RUNNING KATALON (Task Scheduler)
echo WORKSPACE      : %WORKSPACE%
echo PROJECT        : %PROJECT_PATH%
echo COLLECTION     : %COLLECTION_PATH%
echo REPORT_FOLDER  : %REPORT_FOLDER%
echo ==========================================================

if not exist "%KATALON_EXE%" (
  echo [ERROR] Katalon executable not found: "%KATALON_EXE%"
  echo 10>"%EXIT_FILE%"
  exit /b 10
)

if not exist "%PROJECT_PATH%" (
  echo [ERROR] Katalon project not found: "%PROJECT_PATH%"
  echo 11>"%EXIT_FILE%"
  exit /b 11
)

rem ---------- Run ----------
pushd "%WORKSPACE%"

"%KATALON_EXE%" ^
  -noSplash ^
  -runMode=console ^
  -projectPath="%PROJECT_PATH%" ^
  -retry=0 ^
  -testSuiteCollectionPath="%COLLECTION_PATH%" ^
  -executionProfile="default" ^
  -reportFolder="%REPORT_FOLDER%" ^
  -reportFileName="report" ^
  -apiKey="" 

set "RC=%ERRORLEVEL%"

popd

echo ==========================================================
echo KATALON EXIT CODE: %RC%
echo ==========================================================
echo %RC%>"%EXIT_FILE%"

exit /b %RC%










/*
  Archive Mode - SIMPLE PIPELINE
  - No custom DSL methods
  - Uses only built-in Jenkins steps
  - Runs Windows Scheduled Tasks and waits for completion
*/

def CFG = [
  agentLabel: 'GI5_SWDCFRNXGI55817',

  // Katalon project file inside the workspace root
  projectFile: 'eMatch POC.prj',

  // Katalon collection path (must match exactly what exists in Katalon)
  collectionPath: 'Test Suites/Archive Mode/Archive Mode Collection',

  // Scheduled tasks
  winDriverTask: 'startWinDriver',
  desktopTask: '\\eMatch Automation\\RunEMatchDesktop',

  // Fixed context file location read by run-ematch-command.bat
  contextFile: 'D:\\Projects\\eMatchStarters\\run-context.properties',

  // Where we want Katalon to generate output
  reportFolderRel: 'Reports',

  // Next job
  nextJobName: 'Passerelle Bilan'
]

node(CFG.agentLabel) {
  timestamps {
    ansiColor('xterm') {
      timeout(time: 180, unit: 'MINUTES') {

        stage('Checkout') {
          checkout scm
        }

        stage('Validate') {
          echo "============================================================"
          echo "VALIDATING TOOLS AND SUPPORT FILES"
          echo "============================================================"

          bat """
            @echo off
            if not exist "D:\\\\Projects\\\\eMatchStarters\\\\run-ematch-command.bat" (
              echo [ERROR] Missing: D:\\Projects\\eMatchStarters\\run-ematch-command.bat
              exit /b 2
            )
            schtasks /query /tn "${CFG.winDriverTask}" >nul 2>nul || (echo [ERROR] Scheduled task not found: ${CFG.winDriverTask} & exit /b 2)
            schtasks /query /tn "${CFG.desktopTask}" >nul 2>nul || (echo [ERROR] Scheduled task not found: ${CFG.desktopTask} & exit /b 2)
            echo [OK] Support files and scheduled tasks found
          """
        }

        stage('Prepare Run Context') {
          def ws = pwd()
          def reportFolderAbs = "${ws}\\${CFG.reportFolderRel}"

          def content = """WORKSPACE=${ws}
PROJECT_FILE=${CFG.projectFile}
COLLECTION_PATH=${CFG.collectionPath}
REPORT_FOLDER=${reportFolderAbs}
"""

          writeFile file: 'run-context.properties.tmp', text: content

          bat """
            @echo off
            copy /Y "run-context.properties.tmp" "${CFG.contextFile}" >nul
            echo [OK] run-context.properties written: ${CFG.contextFile}
          """
        }

        stage('Run - Archive Mode Collection') {
          echo "============================================================"
          echo "START ASSET: Archive Mode Collection"
          echo "TASK: ${CFG.desktopTask}"
          echo "============================================================"

          bat """
            @echo off
            schtasks /run /tn "${CFG.winDriverTask}"
            if errorlevel 1 exit /b 10

            schtasks /run /tn "${CFG.desktopTask}"
            if errorlevel 1 exit /b 11

            :loop
            for /f "tokens=2 delims=: " %%f in ('schtasks /query /tn "${CFG.desktopTask}" /fo list ^| find "Status:"') do (
                if /I "%%f"=="Running" (
                    ping -n 6 localhost >nul 2>nul
                    goto loop
                )
            )

            schtasks /end /tn "${CFG.winDriverTask}" >nul 2>nul
            exit /b 0
          """
        }

        stage('Collect Reports') {
          catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
            junit allowEmptyResults: true, testResults: 'Reports/**/JUnit_Report.xml'
          }

          catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
            archiveArtifacts allowEmptyArchive: true, artifacts: 'Reports/**/*'
          }

          def exitFile = "${pwd()}\\Reports\\_jenkins_task_exitcode.txt"
          if (fileExists(exitFile)) {
            def rc = readFile(exitFile).trim()
            echo "Desktop task exit code: ${rc}"
          } else {
            echo "Desktop task exit code file not found: ${exitFile}"
          }
        }

        stage('Trigger Next Job') {
          echo "Triggering next Jenkins job: ${CFG.nextJobName}"
          build job: CFG.nextJobName, wait: false
        }
      }
    }
  }
}




