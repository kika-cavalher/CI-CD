@Keyword
void attachToLoginWindow(String targetWindowTitle) {
    String expectedTitle = normalizeTitle(safe(detectedWindowTitle) ? detectedWindowTitle : targetWindowTitle)

    KeywordUtil.logInfo("Attaching to login window. Expected title ${expectedTitle}")

    ensureWinAppDriverRunning()

    Map<String, String> found = waitForWindow(expectedTitle, 30)
    if (!safe(found.title)) {
        KeywordUtil.markFailedAndStop("Could not find eMatch window with title ${expectedTitle}")
    }

    detectedWindowTitle = normalizeTitle(found.title)
    KeywordUtil.logInfo("Detected main window title ${detectedWindowTitle}")

    try {
        Windows.switchToWindowTitle(detectedWindowTitle)
        sleepMs(2000)

        if (Windows.waitForElementPresent(loginDialogObj(), 10)) {
            KeywordUtil.logInfo("Login dialog attached successfully by title")
            return
        }
    } catch (Throwable t) {
        KeywordUtil.logInfo("Direct title attach failed: ${safe(t.message)}")
    }

    List<String> attachPaths = []
    String shortcutPath = getShortcutPath()
    String installedExePath = getInstalledExePath()
    String applicationPath = getApplicationPath()

    if (fileExists(shortcutPath)) {
        attachPaths << shortcutPath
    }
    if (fileExists(installedExePath)) {
        attachPaths << installedExePath
    }
    if (fileExists(applicationPath)) {
        attachPaths << applicationPath
    }

    Throwable lastError = null

    for (String attachPath : attachPaths) {
        try {
            KeywordUtil.logInfo("Trying attach path ${attachPath}")
            Windows.startApplicationWithTitle(attachPath, detectedWindowTitle)
            sleepMs(2500)

            if (Windows.waitForElementPresent(loginDialogObj(), 10)) {
                KeywordUtil.logInfo("Login dialog attached successfully using ${attachPath}")
                return
            }
        } catch (Throwable t) {
            lastError = t
            KeywordUtil.logInfo("Attach by path failed: ${safe(t.message)}")
        }
    }

    KeywordUtil.markFailedAndStop(
        "Could not attach to login window ${detectedWindowTitle}. ${safe(lastError?.message)}"
    )
}
