@echo off
setlocal EnableExtensions EnableDelayedExpansion

rem ==========================================================
rem   eMatch - Generic runner (Task Scheduler)
rem   Reads:  D:\Projects\eMatchStarters\run-context.properties
rem   Writes: LOG_FILE (streaming)  +  MARKER_FILE (exit code)
rem ==========================================================

set "SCRIPT_DIR=%~dp0"
cd /d "%SCRIPT_DIR%"

set "CTX_FILE=%SCRIPT_DIR%run-context.properties"

if not exist "%CTX_FILE%" (
  echo [ERROR] Context file not found: "%CTX_FILE%"
  exit /b 2
)

rem ---------- Load key=value from run-context.properties ----------
for /f "usebackq tokens=1,* delims==" %%A in ("%CTX_FILE%") do (
  set "K=%%A"
  set "V=%%B"
  if not "!K!"=="" set "!K!=!V!"
)

rem ---------- Basic sanitize (remove quotes if Jenkins added them) ----------
for %%V in (WORKSPACE PROJECT_PATH KATALON_EXE COLLECTION_PATH BROWSER_TYPE LOG_FILE MARKER_FILE RETRY) do (
  if defined %%V (
    set "TMP=!%%V!"
    set "TMP=!TMP:"=!"
    set "%%V=!TMP!"
  )
)

echo.
echo [INFO] WORKSPACE        = "%WORKSPACE%"
echo [INFO] PROJECT_PATH     = "%PROJECT_PATH%"
echo [INFO] KATALON_EXE      = "%KATALON_EXE%"
echo [INFO] COLLECTION_PATH  = "%COLLECTION_PATH%"
echo [INFO] BROWSER_TYPE     = "%BROWSER_TYPE%"
echo [INFO] RETRY            = "%RETRY%"
echo [INFO] LOG_FILE         = "%LOG_FILE%"
echo [INFO] MARKER_FILE      = "%MARKER_FILE%"
echo.

rem ---------- Validate required fields (do NOT hardcode anything) ----------
if not defined PROJECT_PATH (
  echo [ERROR] PROJECT_PATH is empty in run-context.properties
  goto :FAIL_FAST
)

if not defined KATALON_EXE (
  echo [ERROR] KATALON_EXE is empty in run-context.properties
  goto :FAIL_FAST
)

if not defined COLLECTION_PATH (
  echo [ERROR] COLLECTION_PATH is empty in run-context.properties
  goto :FAIL_FAST
)

if not exist "%KATALON_EXE%" (
  echo [ERROR] KATALON_EXE not found: "%KATALON_EXE%"
  goto :FAIL_FAST
)

if not exist "%PROJECT_PATH%" (
  echo [ERROR] PROJECT_PATH not found: "%PROJECT_PATH%"
  goto :FAIL_FAST
)

rem ---------- Defaults ----------
if not defined RETRY set "RETRY=0"

if not defined LOG_FILE (
  if not exist "%SCRIPT_DIR%logs" mkdir "%SCRIPT_DIR%logs" >nul 2>&1
  set "LOG_FILE=%SCRIPT_DIR%logs\katalon_%DATE:~-4%%DATE:~3,2%%DATE:~0,2%_%TIME:~0,2%%TIME:~3,2%%TIME:~6,2%.log"
  set "LOG_FILE=%LOG_FILE: =0%"
)

rem If MARKER_FILE not provided, fallback to script folder (keeps Jenkins from waiting forever)
if not defined MARKER_FILE (
  set "MARKER_FILE=%SCRIPT_DIR%__jenkins_task_exitcode.txt"
)

rem Ensure marker folder exists
for %%D in ("%MARKER_FILE%") do (
  if not exist "%%~dpD" mkdir "%%~dpD" >nul 2>&1
)

echo [INFO] Starting Katalon with live log streaming...
echo [INFO] (You should see output here AND in "%LOG_FILE%")
echo.

rem ---------- Run Katalon with live streaming + file logging ----------
rem Using PowerShell Tee-Object so the cmd shows logs in real time
powershell -NoProfile -ExecutionPolicy Bypass -Command ^
  "& { ^
      $exe = '%KATALON_EXE%'; ^
      $args = @(
        '-noSplash',
        '-runMode=console',
        ('-projectPath=' + '\"%PROJECT_PATH%\"'),
        ('-testSuiteCollectionPath=' + '\"%COLLECTION_PATH%\"'),
        ('-browserType=' + '%BROWSER_TYPE%'),
        ('-retry=' + '%RETRY%')
      ); ^
      & $exe $args 2>&1 | Tee-Object -FilePath '%LOG_FILE%'; ^
      exit $LASTEXITCODE ^
    }"

set "EC=%ERRORLEVEL%"

echo.
echo [INFO] Katalon finished with exit code: %EC%
echo %EC%> "%MARKER_FILE%"

exit /b %EC%

:FAIL_FAST
echo.
echo [INFO] Writing failure exit code 2 to marker file...
echo 2> "%MARKER_FILE%"
exit /b 2
