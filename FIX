package jiraIntegration

import static com.kms.katalon.core.testobject.ObjectRepository.findTestObject

import java.io.File
import java.net.URLEncoder
import java.nio.charset.StandardCharsets

import com.kms.katalon.core.testobject.ConditionType
import com.kms.katalon.core.testobject.RequestObject
import com.kms.katalon.core.testobject.ResponseObject
import com.kms.katalon.core.testobject.TestObjectProperty
import com.kms.katalon.core.testobject.impl.HttpTextBodyContent
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webservice.keyword.WSBuiltInKeywords as WS

import groovy.json.JsonBuilder
import groovy.json.JsonSlurper
import internal.GlobalVariable

class JiraGateway {

	JiraFlowCoordinator owner
	JsonSlurper jsonSlurper = new JsonSlurper()
	private String cachedEpicFieldId = ''

	JiraGateway(JiraFlowCoordinator owner) {
		this.owner = owner
	}

	// ============================================================
	// VALIDATION
	// ============================================================

	void validateRequiredConfiguration() {
		List missing = []

		if (isBlank(resolveToken())) {
			missing << 'JIRA token'
		}
		if (isBlank(ownerString('PROJECT_KEY'))) {
			missing << 'PROJECT_KEY'
		}
		if (isBlank(ownerString('JIRA_BASE_URL'))) {
			missing << 'JIRA_BASE_URL'
		}

		if (!missing.isEmpty()) {
			KeywordUtil.markFailedAndStop('Missing Jira configuration: ' + missing.join(', '))
		}
	}

	// ============================================================
	// EXECUTION IMPORT
	// ============================================================

	String importExecutionResults(String xmlPath) {
		if (isBlank(xmlPath)) {
			return 'ERROR: XML path is empty'
		}

		File xmlFile = new File(xmlPath)
		if (!xmlFile.exists() || !xmlFile.isFile() || xmlFile.length() <= 0) {
			return 'ERROR: XML file not found or empty'
		}

		String xmlText = readFileText(xmlFile)
		if (isBlank(xmlText)) {
			return 'ERROR: XML file is empty'
		}

		try {
			RequestObject request = new RequestObject('Runtime Import Results')
			request.setRestUrl(ownerString('JIRA_BASE_URL') + '/rest/raven/1.0/import/execution/junit?projectKey=' + encode(ownerString('PROJECT_KEY')))
			request.setRestRequestMethod('POST')
			request.setHttpHeaderProperties([
				header('Authorization', 'Bearer ' + resolveToken()),
				header('Accept', 'application/json'),
				header('Content-Type', 'text/xml; charset=UTF-8')
			])
			request.setBodyContent(new HttpTextBodyContent(xmlText, 'UTF-8', 'text/xml'))

			ResponseObject response = WS.sendRequest(request)
			int status = response.getStatusCode()
			String body = safeBody(response)

			KeywordUtil.logInfo("Import Results status: ${status}")
			KeywordUtil.logInfo("Import Results response: ${body}")

			if (status < 200 || status >= 300) {
				return "ERROR: import execution failed with status ${status}"
			}

			def parsed = parseJson(body)
			String key = safe(parsed?.testExecIssue?.key)
			if (isBlank(key)) {
				key = safe(parsed?.key)
			}
			if (isBlank(key)) {
				return 'ERROR: execution key not found in import response'
			}

			return key
		} catch (Exception e) {
			KeywordUtil.logInfo("Import Results request failed: ${e.message}")
			return "ERROR: import execution request failed - ${e.message}"
		}
	}

	int addExecutionToTestPlan(String testPlanKey, String executionKey) {
		if (isBlank(testPlanKey) || isBlank(executionKey)) {
			return 0
		}

		try {
			Map payload = [
				add: [executionKey]
			]

			RequestObject request = new RequestObject('Runtime Add Execution To Test Plan')
			request.setRestUrl(ownerString('JIRA_BASE_URL') + '/rest/raven/2.0/api/testplan/' + encode(testPlanKey) + '/testexecution')
			request.setRestRequestMethod('POST')
			request.setHttpHeaderProperties(jsonHeaders())
			request.setBodyContent(jsonBody(payload))

			ResponseObject response = WS.sendRequest(request)
			int status = response.getStatusCode()

			KeywordUtil.logInfo("Add execution to Test Plan status: ${status}")
			KeywordUtil.logInfo("Add execution to Test Plan response: ${safeBody(response)}")

			return status
		} catch (Exception e) {
			KeywordUtil.logInfo("Add execution to Test Plan failed: ${e.message}")
			return 0
		}
	}

	int updateTestExecution(String issueKey, String summary, String labels, String environment) {
		if (isBlank(issueKey)) {
			return 0
		}

		try {
			List labelList = []
			if (!isBlank(labels)) {
				labelList = labels
					.split(',')
					.collect { item -> safe(item) }
					.findAll { item -> !isBlank(item) }
			}

			Map fields = [
				summary: safe(summary),
				labels : labelList
			]

			if (!isBlank(environment)) {
				fields.environment = safe(environment)
			}

			RequestObject request = new RequestObject('Runtime Update Test Execution')
			request.setRestUrl(ownerString('JIRA_BASE_URL') + '/rest/api/2/issue/' + encode(issueKey))
			request.setRestRequestMethod('PUT')
			request.setHttpHeaderProperties(jsonHeaders())
			request.setBodyContent(jsonBody([fields: fields]))

			ResponseObject response = WS.sendRequest(request)
			int status = response.getStatusCode()

			KeywordUtil.logInfo("Update Test Execution status: ${status}")
			KeywordUtil.logInfo("Update Test Execution response: ${safeBody(response)}")

			return status
		} catch (Exception e) {
			KeywordUtil.logInfo("Update Test Execution failed: ${e.message}")
			return 0
		}
	}

	int uploadAttachment(String issueKey, String filePath) {
		if (isBlank(issueKey) || isBlank(filePath)) {
			return 0
		}

		File file = new File(filePath)
		if (!file.exists() || !file.isFile() || file.length() <= 0) {
			KeywordUtil.logInfo("Skipping attachment upload because file is missing or empty: ${filePath}")
			return 0
		}

		try {
			ResponseObject response = WS.sendRequest(findTestObject('Jira Integration/Evidence attachment', [
				('token')    : resolveToken(),
				('evidences'): file,
				('execID')   : issueKey
			]))

			int status = response.getStatusCode()
			String body = safeBody(response)

			KeywordUtil.logInfo("Upload attachment status (${filePath}): ${status}")
			KeywordUtil.logInfo("Upload attachment response: ${body}")

			return status
		} catch (Exception e) {
			KeywordUtil.logInfo("Upload attachment request failed: ${e.message}")
			return 0
		}
	}

	// ============================================================
	// TEST PLAN
	// ============================================================

	String createTestPlan(String summary, String epicKey) {
		try {
			String epicFieldId = resolveEpicFieldId()

			Map fields = [
				project  : [key: ownerString('PROJECT_KEY')],
				summary  : safe(summary),
				issuetype: [name: 'Test Plan']
			]

			if (!isBlank(epicKey) && !isBlank(epicFieldId)) {
				fields[epicFieldId] = safe(epicKey)
			}

			String assigneeAccountId = ownerString('ASSIGNEE_ACCOUNT_ID')
			String assigneeName = ownerString('ASSIGNEE_NAME')

			if (!isBlank(assigneeAccountId)) {
				fields.assignee = [accountId: assigneeAccountId]
			} else if (!isBlank(assigneeName)) {
				fields.assignee = [name: assigneeName]
			}

			RequestObject request = new RequestObject('Runtime Create Test Plan')
			request.setRestUrl(ownerString('JIRA_BASE_URL') + '/rest/api/2/issue')
			request.setRestRequestMethod('POST')
			request.setHttpHeaderProperties(jsonHeaders())
			request.setBodyContent(jsonBody([fields: fields]))

			ResponseObject response = WS.sendRequest(request)
			int status = response.getStatusCode()
			String body = safeBody(response)

			KeywordUtil.logInfo("Create Test Plan status: ${status}")
			KeywordUtil.logInfo("Create Test Plan response: ${body}")

			if (status < 200 || status >= 300) {
				return "ERROR: create test plan failed with status ${status}"
			}

			def parsed = parseJson(body)
			String key = safe(parsed?.key)

			if (isBlank(key)) {
				return 'ERROR: created Test Plan key not found in response'
			}

			return key
		} catch (Exception e) {
			KeywordUtil.logInfo("Create Test Plan failed: ${e.message}")
			return "ERROR: create test plan request failed - ${e.message}"
		}
	}

	Map searchTestPlans(String summary, String epicKey) {
		String jql =
			'project = "' + ownerString('PROJECT_KEY') + '" ' +
			'AND issuetype = "Test Plan" ' +
			'ORDER BY created DESC'

		KeywordUtil.logInfo("Searching Test Plan using JQL: ${jql}")

		List fields = ['summary', 'created', 'issuetype']
		String epicFieldId = resolveEpicFieldId()
		if (!isBlank(epicFieldId)) {
			fields << epicFieldId
		}

		Map response = searchIssues('Runtime Search Test Plan', jql, fields, 200)
		response.epicFieldId = epicFieldId
		return response
	}

	Map getIssueByKey(String issueKey) {
		if (isBlank(issueKey)) {
			return [statusCode: 0, issue: null, body: '', epicFieldId: '']
		}

		try {
			String epicFieldId = resolveEpicFieldId()
			List fields = ['summary', 'created', 'issuetype']
			if (!isBlank(epicFieldId)) {
				fields << epicFieldId
			}

			String url =
				ownerString('JIRA_BASE_URL') +
				'/rest/api/2/issue/' + encode(issueKey) +
				'?fields=' + encode(fields.join(','))

			RequestObject request = new RequestObject('Runtime Get Issue By Key')
			request.setRestUrl(url)
			request.setRestRequestMethod('GET')
			request.setHttpHeaderProperties(defaultGetHeaders())

			ResponseObject response = WS.sendRequest(request)
			int status = response.getStatusCode()
			String body = safeBody(response)

			KeywordUtil.logInfo("Get Issue By Key status: ${status}")
			KeywordUtil.logInfo("Get Issue By Key response: ${body}")

			def parsed = parseJson(body)

			return [
				statusCode : status,
				body       : body,
				issue      : parsed,
				epicFieldId: epicFieldId
			]
		} catch (Exception e) {
			KeywordUtil.logInfo("Get Issue By Key failed: ${e.message}")
			return [statusCode: 0, issue: null, body: '', epicFieldId: '']
		}
	}

	String findEpicKeyBySummary(String epicSummary) {
		if (isBlank(epicSummary)) {
			return ''
		}

		String jql =
			'project = "' + ownerString('PROJECT_KEY') + '" ' +
			'AND issuetype = Epic ' +
			'ORDER BY created DESC'

		Map response = searchIssues('Runtime Search Epic', jql, ['summary', 'created', 'issuetype'], 200)
		int statusCode = (response?.statusCode ?: 0) as int

		if (statusCode != 200) {
			KeywordUtil.logInfo("Search Epic failed with status: ${statusCode}")
			return ''
		}

		List issues = response?.issues instanceof List ? (response.issues as List) : []
		if (issues.isEmpty()) {
			return ''
		}

		def matched = issues.find { issue ->
			return normalizeTitle(issue?.fields?.summary) == normalizeTitle(epicSummary)
		}

		return safe(matched?.key)
	}

	// ============================================================
	// SEARCH HELPERS
	// ============================================================

	private Map searchIssues(String requestName, String jql, List fields, int maxResults) {
		try {
			String url =
				ownerString('JIRA_BASE_URL') +
				'/rest/api/2/search' +
				'?jql=' + encode(jql) +
				'&maxResults=' + String.valueOf(maxResults) +
				'&fields=' + encode(fields.join(','))

			RequestObject request = new RequestObject(requestName)
			request.setRestUrl(url)
			request.setRestRequestMethod('GET')
			request.setHttpHeaderProperties(defaultGetHeaders())

			ResponseObject response = WS.sendRequest(request)
			int status = response.getStatusCode()
			String body = safeBody(response)

			KeywordUtil.logInfo("${requestName} status: ${status}")
			KeywordUtil.logInfo("${requestName} response: ${body}")

			def parsed = parseJson(body)

			return [
				statusCode: status,
				body      : body,
				issues    : parsed?.issues instanceof List ? parsed.issues : []
			]
		} catch (Exception e) {
			KeywordUtil.logInfo("${requestName} failed: ${e.message}")
			return [
				statusCode: 0,
				body      : '',
				issues    : []
			]
		}
	}

	// ============================================================
	// EPIC FIELD RESOLUTION
	// ============================================================

	String resolveEpicFieldId() {
		if (!isBlank(cachedEpicFieldId)) {
			return cachedEpicFieldId
		}

		String configuredEpicFieldId = ownerString('EPIC_FIELD_ID')
		if (!isBlank(configuredEpicFieldId)) {
			cachedEpicFieldId = configuredEpicFieldId
			KeywordUtil.logInfo("Using configured Epic field id: ${cachedEpicFieldId}")
			return cachedEpicFieldId
		}

		boolean skipAutoResolve = ownerBoolean('SKIP_EPIC_LINK_IF_FIELD_NOT_AVAILABLE', true)
		if (skipAutoResolve) {
			KeywordUtil.logInfo('Epic field auto resolution skipped by configuration.')
			return ''
		}

		try {
			RequestObject request = new RequestObject('Runtime Get Jira Fields')
			request.setRestUrl(ownerString('JIRA_BASE_URL') + '/rest/api/2/field')
			request.setRestRequestMethod('GET')
			request.setHttpHeaderProperties(defaultGetHeaders())

			ResponseObject response = WS.sendRequest(request)
			int status = response.getStatusCode()
			String body = safeBody(response)

			KeywordUtil.logInfo("Get Jira Fields status: ${status}")

			if (status != 200) {
				KeywordUtil.logInfo("Epic field resolution skipped. Status: ${status}")
				return ''
			}

			def parsed = parseJson(body)
			if (!(parsed instanceof List)) {
				KeywordUtil.logInfo('Epic field resolution skipped. Response is not a list.')
				return ''
			}

			def epicField = parsed.find { field ->
				String fieldName = safe(field?.name)
				String customKey = safe(field?.schema?.custom)

				return normalizeTitle(fieldName) == 'epic link' ||
					customKey == 'com.pyxis.greenhopper.jira:gh-epic-link'
			}

			cachedEpicFieldId = safe(epicField?.id)

			if (isBlank(cachedEpicFieldId)) {
				KeywordUtil.logInfo('Epic field id not found.')
				return ''
			}

			KeywordUtil.logInfo("Resolved Epic field id: ${cachedEpicFieldId}")
			return cachedEpicFieldId
		} catch (Exception e) {
			KeywordUtil.logInfo("Epic field resolution skipped: ${e.message}")
			return ''
		}
	}

	// ============================================================
	// INTERNAL HELPERS
	// ============================================================

	private String resolveToken() {
		try {
			def direct = GlobalVariable.JIRA_TOKEN
			if (!isBlank(direct)) {
				return safe(direct)
			}
		} catch (Exception ignored) {
		}

		try {
			def fallback = GlobalVariable.token
			if (!isBlank(fallback)) {
				return safe(fallback)
			}
		} catch (Exception ignored) {
		}

		return ownerString('JIRA_TOKEN')
	}

	private String ownerString(String propertyName) {
		try {
			def prop = owner?.metaClass?.hasProperty(owner, propertyName)
			if (prop != null) {
				return safe(owner."${propertyName}")
			}
		} catch (Exception ignored) {
		}
		return ''
	}

	private boolean ownerBoolean(String propertyName, boolean fallbackValue) {
		try {
			def prop = owner?.metaClass?.hasProperty(owner, propertyName)
			if (prop != null) {
				def rawValue = owner."${propertyName}"
				if (rawValue instanceof Boolean) {
					return ((Boolean) rawValue).booleanValue()
				}
				String text = safe(rawValue).toLowerCase()
				if (text == 'true') {
					return true
				}
				if (text == 'false') {
					return false
				}
			}
		} catch (Exception ignored) {
		}
		return fallbackValue
	}

	private String normalizeTitle(def value) {
		return safe(value)
			.replace('\u00A0', ' ')
			.replaceAll(/\s+/, ' ')
			.trim()
			.toLowerCase()
	}

	private String safe(def value) {
		return value == null ? '' : value.toString().trim()
	}

	private boolean isBlank(def value) {
		return safe(value).isEmpty()
	}

	private String readFileText(File file) {
		try {
			return file.getText('UTF-8')
		} catch (Exception ignored) {
			try {
				return file.getText()
			} catch (Exception ignoredAgain) {
				return ''
			}
		}
	}

	private List<TestObjectProperty> defaultGetHeaders() {
		return [
			header('Authorization', 'Bearer ' + resolveToken()),
			header('Accept', 'application/json')
		]
	}

	private List<TestObjectProperty> jsonHeaders() {
		return [
			header('Authorization', 'Bearer ' + resolveToken()),
			header('Accept', 'application/json'),
			header('Content-Type', 'application/json')
		]
	}

	private TestObjectProperty header(String name, String value) {
		return new TestObjectProperty(name, ConditionType.EQUALS, value)
	}

	private HttpTextBodyContent jsonBody(Object payload) {
		String text = new JsonBuilder(payload).toString()
		return new HttpTextBodyContent(text, 'UTF-8', 'application/json')
	}

	private Object parseJson(String body) {
		if (isBlank(body)) {
			return [:]
		}

		try {
			return jsonSlurper.parseText(body)
		} catch (Exception ignored) {
			return [:]
		}
	}

	private String safeBody(ResponseObject response) {
		try {
			return safe(response?.getResponseBodyContent())
		} catch (Exception ignored) {
			return ''
		}
	}

	private String encode(String value) {
		return URLEncoder.encode(safe(value), StandardCharsets.UTF_8.toString())
	}
}
