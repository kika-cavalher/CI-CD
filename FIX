			}
			if (file.name.equalsIgnoreCase(PRIMARY_XML_FILE_NAME) || file.name.equalsIgnoreCase(SECONDARY_XML_FILE_NAME)) {
				found = file.absolutePath
			}
		}

		return found
	}

	List<File> getFailureEvidenceImages() {
		String reportPath = getResolvedReportPath()
		if (isBlank(reportPath)) {
			return []
		}

		File folder = new File(reportPath)
		if (!folder.exists()) {
			return []
		}

		List<File> images = []

		folder.eachFileRecurse(FileType.FILES) { File file ->
			String name = file.name.toLowerCase()
			if (
				name.endsWith('.png')
				|| name.endsWith('.jpg')
				|| name.endsWith('.jpeg')
			) {
				if (
					!name.contains('navbar')
					&& !name.contains('homepage')
					&& !name.contains('logo')
				) {
					images.add(file)
				}
			}
		}

		images.sort { a, b -> a.lastModified() <=> b.lastModified() }
		return images
	}

	String fileToBase64DataUri(File file) {
		if (file == null || !file.exists()) {
			return ''
		}

		String mime = 'image/png'
		String lower = file.name.toLowerCase()
		if (lower.endsWith('.jpg') || lower.endsWith('.jpeg')) {
			mime = 'image/jpeg'
		}

		byte[] bytes = Files.readAllBytes(file.toPath())
		String base64 = bytes.encodeBase64().toString()
		return "data:${mime};base64,${base64}"
	}

	String getShortErrorLog(String stackTrace) {
		if (isBlank(stackTrace)) {
			return ''
		}

		List<String> lines = stackTrace.readLines()
			.collect { it?.trim() }
			.findAll { !isBlank(it) }

		List<String> selected = []

		for (String line : lines) {
			String lower = line.toLowerCase()
			if (
				lower.contains('exception')
				|| lower.contains('error')
				|| lower.contains('caused by')
				|| lower.contains('timed out')
				|| lower.contains('not found')
				|| lower.contains('not clickable')
				|| lower.contains('unable')
				|| lower.contains('failed')
			) {
				selected.add(line)
			}
			if (selected.size() >= 3) {
				break
			}
		}

		if (selected.isEmpty()) {
			selected = lines.take(3)
		}

		return selected.join('\n')
	}

	Map parseSuiteData(String xmlPath) {
		def xml = new XmlSlurper(false, false).parse(new File(xmlPath))

		List suiteNodes = []
		if (xml.name() == 'testsuite') {
			suiteNodes.add(xml)
		} else {
			suiteNodes.addAll(xml.testsuite)
		}

		BigDecimal totalTime = 0
		List<Map> failedTests = []
		List<Map> passedTests = []
		int executed = 0
		int failed = 0
		int skipped = 0

		List<File> evidenceImages = getFailureEvidenceImages()
		int evidenceIndex = 0

		suiteNodes.each { suite ->
			suite.testcase.each { tc ->
				executed++

				String className = safe(tc.@classname?.text())
				String testName = safe(tc.@name?.text())
				BigDecimal timeSeconds = 0
				try {
					timeSeconds = new BigDecimal(safe(tc.@time?.text() ?: '0'))
				} catch (Exception ignored) {
					timeSeconds = 0
				}

				totalTime = totalTime + timeSeconds

				boolean hasFailure = tc.failure.size() > 0 || tc.error.size() > 0
				boolean hasSkipped = tc.skipped.size() > 0

				if (hasSkipped) {
					skipped++
				}

				if (hasFailure) {
					failed++

					def failNode = tc.failure.size() > 0 ? tc.failure[0] : tc.error[0]
					String message = safe(failNode.@message?.text())
					String stackTrace = safe(failNode.text())

					File imageFile = null
					if (evidenceIndex < evidenceImages.size()) {
						imageFile = evidenceImages[evidenceIndex]
						evidenceIndex++
					}

					failedTests.add([
						className     : className,
						testName      : testName,
						failureMessage: message,
						stackTrace    : stackTrace,
						timeSeconds   : timeSeconds,
						imageData     : imageFile != null ? fileToBase64DataUri(imageFile) : ''
					])
				} else if (!hasSkipped) {
					passedTests.add([
						className   : className,
						testName    : testName,
						timeSeconds : timeSeconds
					])
				}
			}
		}

		int passed = executed - failed - skipped
		if (passed < 0) {
			passed = 0
		}

		return [
			suiteName   : getCurrentSuiteName(),
			startText   : new SimpleDateFormat('EEE MMM dd HH:mm:ss z yyyy').format(new Date()),
			endText     : new SimpleDateFormat('EEE MMM dd HH:mm:ss z yyyy').format(new Date()),
			suiteTime   : totalTime,
			executed    : executed,
			passed      : passed,
			failed      : failed,
			skipped     : skipped,
			failedTests : failedTests,
			passedTests : passedTests
		]
	}

