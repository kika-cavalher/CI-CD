@echo off
setlocal EnableExtensions EnableDelayedExpansion

REM ============================================================
REM Generic runner
REM - Reads D:\Projects\eMatchStarters\run-context.properties
REM - Runs Katalon console
REM - Writes marker file for Jenkins with exit code + log file
REM ============================================================

set "BASE_DIR=%~dp0"
set "CTX_FILE=%BASE_DIR%run-context.properties"

if not exist "%CTX_FILE%" (
  echo [ERROR] Missing context file: "%CTX_FILE%"
  exit /b 2
)

REM --------------------------
REM Load key=value from ctx
REM --------------------------
for /f "usebackq tokens=1,* delims==" %%A in ("%CTX_FILE%") do (
  set "RAW_KEY=%%A"
  set "RAW_VAL=%%B"

  REM skip empty keys
  if not "!RAW_KEY!"=="" (
    REM skip comments
    if /i not "!RAW_KEY:~0,1!"=="#" (
      set "!RAW_KEY!=!RAW_VAL!"
    )
  )
)

REM --------------------------
REM Allow suite BAT override
REM --------------------------
if not "%COLLECTION_PATH%"=="" (
  set "CTX_COLLECTION_PATH=%COLLECTION_PATH%"
) else (
  set "CTX_COLLECTION_PATH=%COLLECTION_PATH%"
)

REM --------------------------
REM Validate required vars
REM --------------------------
if "%WORKSPACE%"=="" (
  echo [ERROR] WORKSPACE is empty in run-context.properties
  exit /b 2
)

if "%PROJECT_PATH%"=="" (
  echo [ERROR] PROJECT_PATH is empty in run-context.properties
  exit /b 2
)

if "%KATALON_EXE%"=="" (
  echo [ERROR] KATALON_EXE is empty in run-context.properties
  exit /b 2
)

if "%CTX_COLLECTION_PATH%"=="" (
  echo [ERROR] COLLECTION_PATH is empty (ctx or suite bat)
  exit /b 2
)

if "%MARKER_FILE%"=="" (
  echo [ERROR] MARKER_FILE is empty in run-context.properties
  exit /b 2
)

if "%LOG_DIR%"=="" (
  set "LOG_DIR=%BASE_DIR%logs"
)

if not exist "%LOG_DIR%" (
  mkdir "%LOG_DIR%" 1>nul 2>nul
)

REM --------------------------
REM Build log file name
REM --------------------------
set "TS=%DATE:~-4%%DATE:~3,2%%DATE:~0,2%_%TIME:~0,2%%TIME:~3,2%%TIME:~6,2%"
set "TS=%TS: =0%"

if "%LOG_FILE%"=="" (
  set "LOG_FILE=%LOG_DIR%\katalon_%TS%.log"
)

REM --------------------------
REM Optional: start WinAppDriver
REM --------------------------
if /i "%START_WINAPPDRIVER%"=="true" (
  tasklist /fi "imagename eq WinAppDriver.exe" | find /i "WinAppDriver.exe" >nul
  if errorlevel 1 (
    echo [INFO] Starting WinAppDriver...
    start "" "C:\Program Files (x86)\Windows Application Driver\WinAppDriver.exe" >nul 2>&1
    timeout /t 2 /nobreak >nul
  ) else (
    echo [INFO] WinAppDriver already running
  )
)

REM --------------------------
REM Echo context
REM --------------------------
echo [INFO] WORKSPACE:      "%WORKSPACE%"
echo [INFO] PROJECT_PATH:   "%PROJECT_PATH%"
echo [INFO] KATALON_EXE:    "%KATALON_EXE%"
echo [INFO] COLLECTION:     "%CTX_COLLECTION_PATH%"
echo [INFO] PROFILE:        "%EXECUTION_PROFILE%"
echo [INFO] BROWSER_TYPE:   "%BROWSER_TYPE%"
echo [INFO] LOG_FILE:       "%LOG_FILE%"
echo [INFO] MARKER_FILE:    "%MARKER_FILE%"

REM --------------------------
REM Run Katalon
REM --------------------------
set "PROFILE_ARG="
if not "%EXECUTION_PROFILE%"=="" (
  set "PROFILE_ARG=-executionProfile=%EXECUTION_PROFILE%"
)

set "BROWSER_ARG="
if not "%BROWSER_TYPE%"=="" (
  set "BROWSER_ARG=-browserType=%BROWSER_TYPE%"
)

"%KATALON_EXE%" ^
  -runMode=console ^
  -projectPath="%PROJECT_PATH%" ^
  -testSuiteCollectionPath="%CTX_COLLECTION_PATH%" ^
  %PROFILE_ARG% ^
  %BROWSER_ARG% ^
  -retry=0 ^
  -retryFailedTestCases=false ^
  -consoleLog ^
  -logFile="%LOG_FILE%"

set "EXEC=%ERRORLEVEL%"

REM --------------------------
REM Write marker for Jenkins
REM --------------------------
(
  echo exitcode=%EXEC%
  echo logfile=%LOG_FILE%
  echo collection=%CTX_COLLECTION_PATH%
) > "%MARKER_FILE%"

echo [INFO] Done. exitcode=%EXEC%
exit /b %EXEC%
