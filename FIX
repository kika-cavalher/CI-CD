import com.kms.katalon.core.util.KeywordUtil

// ======================================================
// TEST TOOL CONFIG
// ======================================================

String validationName = 'Élément Valorisé Test Tool Validation'

String dataFileRelativePath = 'Data Files/TestTool/source_tables.xlsx'

String screenName = 'Élément Valorisé'
String expectedSourceTable = 'data_section_emission_element_valorise'

// ======================================================
// REPORT CONFIG
// ======================================================

String evidenceName = 'TestTool_ElementValorise_Validation.png'

// ======================================================
// TEST FLOW
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'🔎 Test Tool validation started\n' +
		'Validation: ' + validationName + '\n' +
		'Screen: ' + screenName + '\n' +
		'Expected source table: ' + expectedSourceTable + '\n' +
		'Source file: source_tables.xlsx'
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'📄 Validate Test Tool source file\n' +
		'Verify that the Excel file exists and contains the required information.'
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'📋 Validate required columns\n' +
		'Expected columns:\n' +
		'• Screen Name\n' +
		'• Source Table'
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'🔍 Search screen configuration\n' +
		'Screen to find: ' + screenName + '\n' +
		'Expected occurrences: 1'
)

Map validationResult =
		CustomKeywords.'testTool.TestToolValidationKeywords.validateSourceTable'(
				dataFileRelativePath,
				screenName,
				expectedSourceTable
		)

Boolean validationPassed = validationResult.passed as Boolean

String actualFileName =
		validationResult.fileName == null
		? 'Not available'
		: validationResult.fileName.toString()

String actualScreenName =
		validationResult.screenName == null
		? screenName
		: validationResult.screenName.toString()

String actualSourceTable =
		validationResult.actualSourceTable == null
		? 'NOT FOUND'
		: validationResult.actualSourceTable.toString()

Integer screenOccurrences =
		validationResult.screenOccurrences == null
		? 0
		: validationResult.screenOccurrences as Integer

Integer totalDataRows =
		validationResult.totalDataRows == null
		? 0
		: validationResult.totalDataRows as Integer

String validationMessage =
		validationResult.message == null
		? 'No validation message returned.'
		: validationResult.message.toString()

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'📊 Test Tool file result\n' +
		'File: ' + actualFileName + '\n' +
		'Rows with data: ' + totalDataRows + '\n' +
		'Screen occurrences: ' + screenOccurrences
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		(validationPassed ? '✅ ' : '❌ ') +
		'Screen configuration result\n' +
		'Screen: ' + actualScreenName + '\n' +
		'Expected source table: ' + expectedSourceTable + '\n' +
		'Actual source table: ' + actualSourceTable + '\n' +
		'Status: ' + (validationPassed ? 'PASSED' : 'FAILED')
)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
		evidenceName
)

if (!validationPassed) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
			'❌ Test Tool validation failed\n' +
			'Validation: ' + validationName + '\n' +
			'Screen: ' + screenName + '\n' +
			'Expected source table: ' + expectedSourceTable + '\n' +
			'Actual source table: ' + actualSourceTable + '\n' +
			'Occurrences found: ' + screenOccurrences + '\n' +
			'Reason: ' + validationMessage
	)

	KeywordUtil.markFailedAndStop(
			'Test Tool validation failed.\n' +
			'Screen: ' + screenName + '\n' +
			'Expected: ' + expectedSourceTable + '\n' +
			'Actual: ' + actualSourceTable + '\n' +
			'Reason: ' + validationMessage
	)
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'✅ Test Tool validation completed\n' +
		'Validation: ' + validationName + '\n' +
		'Screen: ' + screenName + '\n' +
		'Source table: ' + actualSourceTable + '\n' +
		'Occurrences found: ' + screenOccurrences + '\n' +
		'Result: configuration is valid.'
)

KeywordUtil.markPassed(
		validationName + ' completed successfully.\n' +
		'Screen: ' + screenName + '\n' +
		'Source table: ' + actualSourceTable
)
