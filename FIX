	Document parseXmlDocument(String xmlFilePath) {
		DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance()
		factory.setNamespaceAware(false)
		factory.setIgnoringComments(true)
		factory.setIgnoringElementContentWhitespace(true)

		def builder = factory.newDocumentBuilder()
		Document document = builder.parse(new File(xmlFilePath))
		document.getDocumentElement().normalize()

		return document
	}

	String getAttribute(Element element, String name) {
		if (element == null || !element.hasAttribute(name)) {
			return ''
		}
		return element.getAttribute(name)
	}

	String getChildElementText(Element parent, String tagName) {
		if (parent == null) {
			return ''
		}

		NodeList list = parent.getElementsByTagName(tagName)

		if (list == null || list.getLength() == 0) {
			return ''
		}

		def node = list.item(0)
		return node == null ? '' : (node.getTextContent() ?: '')
	}

	List<Element> getDirectTestCaseElements(Document document) {
		List<Element> items = []
		NodeList nodes = document.getElementsByTagName('testcase')

		for (int i = 0; i < nodes.getLength(); i++) {
			def node = nodes.item(i)
			if (node instanceof Element) {
				items.add((Element) node)
			}
		}

		return items
	}

	List<File> getFailureImages() {
		List<File> images = []
		String reportPath = getResolvedReportPath()

		if (isBlank(reportPath)) {
			return images
		}

		File reportDir = new File(reportPath)

		reportDir.eachFileRecurse(FileType.FILES) { file ->
			String lower = file.name.toLowerCase()

			if (lower.endsWith('.png') || lower.endsWith('.jpg') || lower.endsWith('.jpeg') || lower.endsWith('.webp')) {
				images.add(file)
			}
		}

		images.sort { a, b -> a.lastModified() <=> b.lastModified() }
		return images
	}

	Map parseSuiteData(String xmlFilePath) {
		Document document = parseXmlDocument(xmlFilePath)

		String suiteName = getCurrentSuiteName()
		String xmlRootName = document?.documentElement?.tagName

		if ('testsuite'.equalsIgnoreCase(xmlRootName) && document.documentElement.hasAttribute('name')) {
			String xmlSuiteName = document.documentElement.getAttribute('name')
			if (!isBlank(xmlSuiteName) && !xmlSuiteName.toLowerCase().contains('cucumber')) {
				suiteName = normalizeSuiteName(xmlSuiteName)
			}
		}

		BigDecimal suiteTime = 0
		List<Map> failedTests = []
		List<Map> passedTests = []
		List<File> failureImages = getFailureImages()
		int imageIndex = 0

		List<Element> testCases = getDirectTestCaseElements(document)

		for (Element tc : testCases) {
			String className = getAttribute(tc, 'classname')
			String testName = getAttribute(tc, 'name')

			BigDecimal timeSeconds = 0
			try {
				timeSeconds = new BigDecimal(getAttribute(tc, 'time') ?: '0')
			} catch (Exception ignored) {
				timeSeconds = 0
			}

			suiteTime += timeSeconds

			NodeList failureNodes = tc.getElementsByTagName('failure')
			NodeList errorNodes = tc.getElementsByTagName('error')
			NodeList skippedNodes = tc.getElementsByTagName('skipped')

			boolean failed = failureNodes.getLength() > 0 || errorNodes.getLength() > 0
			boolean skipped = skippedNodes.getLength() > 0

			String failureMessage = ''
			String stackTrace = ''
			String imageData = ''

			if (failed) {
				Element node = failureNodes.getLength() > 0 ? (Element) failureNodes.item(0) : (Element) errorNodes.item(0)
				failureMessage = getAttribute(node, 'message')
				stackTrace = node.getTextContent() ?: ''

				if (imageIndex < failureImages.size()) {
					imageData = toDataUri(failureImages[imageIndex])
					imageIndex++
				}
			}

			Map item = [
				className      : className,
				testName       : testName,
				timeSeconds    : timeSeconds,
				failureMessage : failureMessage,
				stackTrace     : stackTrace,
				imageData      : imageData,
				skipped        : skipped
			]

			if (failed) {
				failedTests.add(item)
			} else if (!skipped) {
				passedTests.add(item)
			}
		}

		Date nowDate = new Date()

		return [
			suiteName   : suiteName,
			startText   : formatUiDate(nowDate),
			endText     : formatUiDate(nowDate),
			suiteTime   : suiteTime,
			executed    : failedTests.size() + passedTests.size(),
			passed      : passedTests.size(),
			failed      : failedTests.size(),
			skipped     : 0,
			failedTests : failedTests,
			passedTests : passedTests
		]
	}

