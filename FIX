CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Validate source filter application')

File validationImage = new File(RunConfiguration.getProjectDir(), imageRelativePath)

if (!validationImage.exists() || !validationImage.isFile()) {
    KeywordUtil.markFailed("Validation image not found: ${validationImage.absolutePath}")
}

boolean filterApplied = false
int maxAttempts = 1
int waitSeconds = 2

for (int attempt = 1; attempt <= maxAttempts; attempt++) {
    try {
        if (WindowsImageKeywords.findImage(validationImage.absolutePath)) {
            filterApplied = true
            break
        }
    } catch (Throwable ignored) {
    }

    Windows.delay(waitSeconds)
}

if (!filterApplied) {
    KeywordUtil.markFailed("Bilan filter not applied or image not found on screen: ${validationImage.name}")
} else {
    KeywordUtil.markPassed('Bilan filter applied correctly')
}


