File resolveShortExportRoot(
		String configuredRoot
) {
	File preferredRoot =
			new File(
			configuredRoot
				)

	if (preferredRoot.exists() &&
			preferredRoot.isDirectory()) {
		return preferredRoot
	}

	File temporaryRoot =
			new File(
			System.getProperty('java.io.tmpdir'),
			'KatalonExports'
				)

	if (temporaryRoot.exists() &&
			temporaryRoot.isDirectory()) {
		return temporaryRoot
	}

	return preferredRoot
}

Map selectExportFile(
		String resolvedFilesText,
		String targetEnvironment,
		String exportLabel
) {
	List<File> allFiles =
			parseFileList(
			resolvedFilesText
				)

	allFiles = allFiles.findAll {
		File file ->
			file != null &&
			file.exists() &&
			file.isFile() &&
			file.length() > 0 &&
			file.getName()
					.toLowerCase(
					Locale.ENGLISH
						)
					.endsWith(
					'.xlsx'
						) &&
			!file.getName().startsWith(
					'~$'
						)
	}

	if (allFiles.isEmpty()) {
		return [
			file        : null,
			allFiles    : allFiles,
			matchedFiles: [],
			error       : 'No valid Excel files were found under the export folder.'
		]
	}

	String normalizedEnvironment =
			normalizeEnvironment(
			targetEnvironment
				)

	String normalizedLabel =
			exportLabel == null ?
				'' :
				exportLabel
					.trim()
					.toLowerCase(
					Locale.ENGLISH
						)

	List<File> matchedFiles = []

	for (File file : allFiles) {
		String fileName =
				file.getName()
					.toLowerCase(
					Locale.ENGLISH
						)

		boolean environmentMatches =
				normalizedEnvironment.isEmpty() ||
				fileName.startsWith(
				normalizedEnvironment.toLowerCase(
				Locale.ENGLISH
					) + '_'
					)

		boolean labelMatches =
				normalizedLabel.isEmpty() ||
				fileName.contains(
				normalizedLabel
					)

		if (environmentMatches &&
				labelMatches) {
			matchedFiles.add(
					file
					)
		}
	}

	if (matchedFiles.isEmpty()) {
		String expectedDescription =
				(normalizedEnvironment.isEmpty() ?
					'' :
					normalizedEnvironment + '_') +
				'*' +
				exportLabel +
				'*.xlsx'

		return [
			file        : null,
			allFiles    : allFiles,
			matchedFiles: matchedFiles,
			error       :
				'No Excel file matched the expected environment and export label.\n' +
				'Expected format: ' +
				expectedDescription
		]
	}

	List<File> sortedMatches =
			matchedFiles.sort {
				File a,
				File b ->

					b.lastModified() <=>
					a.lastModified()
			}

	return [
		file        : sortedMatches[0],
		allFiles    : allFiles,
		matchedFiles: matchedFiles,
		error       : ''
	]
}

String normalizeEnvironment(
		String value
) {
	if (value == null ||
			value.trim().isEmpty()) {
		return ''
	}

	String environment =
			value
				.trim()
				.toUpperCase(
				Locale.ENGLISH
					)

	if (environment == 'REC' ||
			environment == 'RECETTE') {
		return 'REC'
	}

	if (environment == 'PRD' ||
			environment == 'PROD' ||
			environment == 'PRODUCTION') {
		return 'PRD'
	}

	return environment
}

Map validateHeadersInFile(
		File file,
		Integer sheetIndex,
		List<String> headers
) {
	List<String> foundHeaders = []
	List<String> missingHeaders = []
	List<String> errors = []

	Workbook workbook = null

	try {
		if (file == null ||
				!file.exists() ||
				!file.isFile()) {
			return [
				failed        : true,
				headerRow     : '',
				foundHeaders  : foundHeaders,
				missingHeaders: headers,
				errors        : [
					'File was not found.'
				]
			]
		}

		workbook =
				WorkbookFactory.create(
				file
					)

		if (sheetIndex < 0 ||
				sheetIndex >=
				workbook.getNumberOfSheets()) {
			return [
				failed        : true,
				headerRow     : '',
				foundHeaders  : foundHeaders,
				missingHeaders: headers,
				errors        : [
					'Sheet index ' +
					sheetIndex +
					' was not found. Available sheets: ' +
					workbook.getNumberOfSheets()
				]
			]
		}

		Sheet sheet =
				workbook.getSheetAt(
				sheetIndex
					)

		DataFormatter formatter =
				new DataFormatter(
				Locale.ENGLISH
					)

		def evaluator =
				workbook
				.getCreationHelper()
				.createFormulaEvaluator()

		Map headerInfo =
				findBestHeaderRow(
				sheet,
				formatter,
				evaluator,
				headers
					)

		foundHeaders.addAll(
				headerInfo.foundHeaders as List<String>
				)

		missingHeaders.addAll(
				headerInfo.missingHeaders as List<String>
				)

		return [
			failed        : !missingHeaders.isEmpty(),
			headerRow     : headerInfo.headerRow,
			foundHeaders  : foundHeaders,
			missingHeaders: missingHeaders,
			errors        : errors
		]
	} catch (Throwable throwable) {
		errors.add(
				throwable
					.getClass()
					.getSimpleName() +
				': ' +
				safeText(
				throwable.getMessage()
					)
				)

		return [
			failed        : true,
			headerRow     : '',
			foundHeaders  : foundHeaders,
			missingHeaders: headers,
			errors        : errors
		]
	} finally {
		try {
			workbook?.close()
		} catch (Throwable ignored) {
		}
	}
}

Map findBestHeaderRow(
		Sheet sheet,
		DataFormatter formatter,
		def evaluator,
		List<String> headers
) {
	Integer maxHeaderScanRows =
			Math.min(
			sheet.getLastRowNum(),
			50
				)

	List<String> bestFound = []
	List<String> bestMissing = headers
	Integer bestHeaderRow = -1

	for (int rowIndex = 0;
			rowIndex <= maxHeaderScanRows;
			rowIndex++) {
		Row row =
				sheet.getRow(
				rowIndex
					)

		if (row == null ||
				row.getFirstCellNum() < 0 ||
				row.getLastCellNum() < 0) {
			continue
		}

		Set<String> rowValues =
				[] as Set<String>

		for (int cellIndex =
				row.getFirstCellNum();
				cellIndex <
				row.getLastCellNum();
				cellIndex++) {
			Cell cell =
					row.getCell(
					cellIndex,
					Row.MissingCellPolicy.RETURN_BLANK_AS_NULL
						)

			String value =
					cellText(
					cell,
					formatter,
					evaluator
						)

			if (!value.isEmpty()) {
				rowValues.add(
						normalizeHeader(
						value
							)
						)
			}
		}

		List<String> currentFound = []
		List<String> currentMissing = []

		for (String header : headers) {
			if (rowValues.contains(
					normalizeHeader(
					header
						)
					)) {
				currentFound.add(
						header
						)
			} else {
				currentMissing.add(
						header
						)
			}
		}

		if (currentFound.size() >
				bestFound.size()) {
			bestFound =
					currentFound

			bestMissing =
					currentMissing

			bestHeaderRow =
					rowIndex + 1
		}

		if (currentMissing.isEmpty()) {
			break
		}
	}

	return [
		headerRow     :
				bestHeaderRow < 0 ?
					'' :
					String.valueOf(
					bestHeaderRow
						),
		foundHeaders  : bestFound,
		missingHeaders: bestMissing
	]
}

