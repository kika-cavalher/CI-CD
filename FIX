String errors = ''

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Start Investigation Bilan Detail export validation')

totalCCYHeader = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/totalCCYHeader.PNG').getAbsolutePath()
errorCriticHeader = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/CriticalErrorTopBar.PNG').getAbsolutePath()

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Open Investigation Bilan Detail from Total CCY header')
WindowsImageKeywords.doubleclickImageWithCoorinates(totalCCYHeader, 100, 35)

try {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Waiting for Investigation window to open')
	Windows.delay(30)
	Windows.switchToWindowTitle("Investigations (Détail - Bilan)")
} catch (Exception e) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('First attempt failed, retrying switch to Investigation window')
	Windows.delay(60)
	Windows.switchToWindowTitle("Investigations (Détail - Bilan)")
}

def compareFiles = GlobalVariable.compareFiles as ArrayList
Integer deforeDownloadLen = compareFiles.size()

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Prepare export image references')
String slaveExportSection = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/slaveExportSection.PNG').getAbsolutePath();
String export = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/exportChild.PNG').getAbsolutePath();
String export2 = new File(RunConfiguration.getProjectDir(), 'Images/General/Exports2.PNG').getAbsolutePath();

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Open export menu and select export option')
WindowsImageKeywords.clickImageInImage(slaveExportSection, export)
Windows.delay(3);
WindowsImageKeywords.clickImage(export2);
Windows.delay(2);

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Read exported file name')
String file = Windows.getText(findWindowsObject('General/txtFileName'));

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Save exported file to report path')
CustomKeywords.'com.katalon.ematch.helper.EmatchHelper.saveToPath'()

Integer ct = 0
CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Wait for export popup confirmation to close')
CustomKeywords.'com.katalon.ematch.helper.EmatchHelper.waitForNonOpenBtnPopUp'(25, 5, ct)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Add exported file to compareFiles list')
compareFiles.add(file)

Integer afterDownloadLen = compareFiles.size()

if (deforeDownloadLen == afterDownloadLen) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Investigation Bilan Detail file download validation failed')
	KeywordUtil.markFailed('Investigation Bilan Detail file not downloaded correctly')
} else {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Investigation Bilan Detail file downloaded successfully')
	KeywordUtil.markPassed("Investigation Bilan Detail file downloaded correctly")
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Close Investigation window')
Windows.closeApplication()
Windows.delay(20)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Switch back to eMatch main window')
def testData = findTestData('Data Files/refLogin')
def value = testData.getValue("Env 1", 1)

if (value == "REC2") {
	Windows.switchToWindowTitle("eMatch REC2")
} else {
	Windows.switchToWindowTitle(GlobalVariable.version)
}
