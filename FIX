import static com.kms.katalon.core.testcase.TestCaseFactory.findTestCase

import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testcase.TestCase
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

String targetEnvironment = 'REC'
String exportLabel = 'Mixte'

String currencySetupTestCase = 'Feature/Contre-valorisation IHM/Settings/Cotre Parameters - Mixte'

String menuName = 'Comparatif Inter'
String menuResultName = 'Comparatif inter-arrêtés'

// Debug
TestCase tc = findTestCase(currencySetupTestCase)

println('TestCase Object = ' + tc)

if (tc != null) {
	println('TestCase ID = ' + tc.getTestCaseId())
} else {
	KeywordUtil.markFailedAndStop(
		'findTestCase returned NULL.\n' +
		'Path: ' + currencySetupTestCase
	)
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Authenticate and open application\n' +
	'Environment: ' + targetEnvironment
)

WebUI.callTestCase(
	findTestCase('Component/Authentication/Login REC'),
	[:],
	FailureHandling.STOP_ON_FAILURE
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Configure Cotre Parameters Mixte\n' +
	'Test case: ' + currencySetupTestCase
)

WebUI.callTestCase(
	tc,
	[:],
	FailureHandling.STOP_ON_FAILURE
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Open Comparatif Inter menu\n' +
	'Search: ' + menuName + '\n' +
	'Result: ' + menuResultName
)

CustomKeywords.'component.MenuNavigator.searchAndOpenMenuByText'(
	menuName,
	menuResultName,
	60
)

Windows.delay(40)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Export Comparatif Inter file for Mixte\n' +
	'Export label: ' + exportLabel
)

CustomKeywords.'commands.ExportFile.exportFromTwoExportImagesToNo'(
	exportLabel,
	targetEnvironment
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Close application'
)

WebUI.callTestCase(
	findTestCase('Component/Authentication/Close Application'),
	[:],
	FailureHandling.STOP_ON_FAILURE
)

KeywordUtil.markPassed(
	'REC Cotre Parameters Mixte export completed successfully.'
)
