package jiraIntegration

import java.io.File
import java.math.BigDecimal
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale
import java.util.regex.Matcher
import java.util.regex.Pattern

import javax.xml.parsers.DocumentBuilderFactory

import org.w3c.dom.Document
import org.w3c.dom.Element
import org.w3c.dom.Node
import org.w3c.dom.NodeList

class JiraGaiaReportBuilder {

    JiraFlowCoordinator flow

    JiraGaiaReportBuilder(JiraFlowCoordinator flow) {
        this.flow = flow
    }

    private String safeValue(def value) {
        return value == null ? '' : String.valueOf(value).trim()
    }

    private boolean isBlank(def value) {
        return safeValue(value).isEmpty()
    }

    private long toMillis(def secondsValue) {
        String raw = safeValue(secondsValue).replace(',', '.')
        if (raw.isEmpty()) {
            return 0L
        }

        try {
            BigDecimal seconds = new BigDecimal(raw)
            return seconds.multiply(new BigDecimal('1000')).longValue()
        } catch (Exception ignored) {
            return 0L
        }
    }

    private String formatDateTime(Date date) {
        if (date == null) {
            return ''
        }
        return new SimpleDateFormat("MMM dd, yyyy hh:mm:ss a", Locale.ENGLISH).format(date)
    }

    private String formatTimeOnly(Date date) {
        if (date == null) {
            return ''
        }
        return new SimpleDateFormat("hh:mm:ss a", Locale.ENGLISH).format(date)
    }

    private String formatDuration(long millis) {
        long hours = millis / 3600000L
        long minutes = (millis % 3600000L) / 60000L
        long seconds = (millis % 60000L) / 1000L
        long ms = millis % 1000L

        List<String> parts = []

        if (hours > 0L) {
            parts.add(hours + 'h')
        }
        if (minutes > 0L || hours > 0L) {
            parts.add(minutes + 'm')
        }
        if (seconds > 0L || minutes > 0L || hours > 0L) {
            parts.add(seconds + 's')
        }
        parts.add(ms + 'ms')

        return parts.join(' ')
    }

    private String oneLine(def text, int maxSize) {
        String value = safeValue(text).replaceAll(/\s+/, ' ').trim()
        if (value.length() <= maxSize) {
            return value
        }
        return value.substring(0, Math.max(0, maxSize - 3)) + '...'
    }

    private String stripAnsi(String value) {
        return safeValue(value).replaceAll("\\u001B\\[[;\\d]*m", '')
    }

    private String normalizeScenarioKey(def text) {
        String value = safeValue(text)

        value = value.replaceFirst(/(?i)^SCENARIO\s+/, '')
        value = value.replaceFirst(/(?i)^Start Test Case\s*:\s*/, '')
        value = value.replaceAll(/\s+/, ' ').trim()

        return value
            .toLowerCase(Locale.ENGLISH)
            .replaceAll(/[^a-z0-9]+/, ' ')
            .trim()
    }

    private String outputFileName() {
        try {
            String configured = safeValue(flow?.GAIA_REPORT_FILE_NAME)
            if (!isBlank(configured)) {
                return configured
            }
        } catch (Exception ignored) {
        }
        return 'gaiaReport.html'
    }

    private String relativeUri(File baseDir, File target) {
        if (baseDir == null || target == null) {
            return ''
        }

        try {
            String relative = baseDir.toURI().relativize(target.toURI()).toString()
            if (!isBlank(relative)) {
                return relative
            }
        } catch (Exception ignored) {
        }

        return target.name
    }

    private Document parseXmlDocument(File xmlFile) {
        DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance()
        factory.setNamespaceAware(false)
        factory.setExpandEntityReferences(false)

        try {
            factory.setFeature("http://apache.org/xml/features/disallow-doctype-decl", true)
        } catch (Exception ignored) {
        }

        try {
            factory.setFeature("http://xml.org/sax/features/external-general-entities", false)
        } catch (Exception ignored) {
        }

        try {
            factory.setFeature("http://xml.org/sax/features/external-parameter-entities", false)
        } catch (Exception ignored) {
        }

        Document document = factory.newDocumentBuilder().parse(xmlFile)
        document.documentElement.normalize()
        return document
    }

    private List<Element> getTestcaseElements(Document document) {
        List<Element> result = []

        if (document == null) {
            return result
        }

        NodeList nodes = document.getElementsByTagName('testcase')
        for (int i = 0; i < nodes.length; i++) {
            Node current = nodes.item(i)
            if (current != null && current.getNodeType() == Node.ELEMENT_NODE) {
                result.add((Element) current)
            }
        }

        return result
    }

    private Element findFirstDirectChild(Element parent, String tagName) {
        if (parent == null) {
            return null
        }

        NodeList children = parent.getChildNodes()
        for (int i = 0; i < children.length; i++) {
            Node current = children.item(i)
            if (current != null &&
                current.getNodeType() == Node.ELEMENT_NODE &&
                tagName.equals(current.getNodeName())) {
                return (Element) current
            }
        }

        return null
    }

    private File findLatestExecutionLog(File baseDir) {
        List<File> candidates = []

        if (baseDir == null || !baseDir.exists()) {
            return null
        }

        baseDir.eachFileRecurse { File file ->
            if (file.isFile() && file.name.toLowerCase(Locale.ENGLISH).matches(/execution\d*\.log/)) {
                candidates.add(file)
            }
        }

        if (candidates.isEmpty()) {
            return null
        }

        candidates.sort { File a, File b ->
            b.lastModified() <=> a.lastModified()
        }

        return candidates[0]
    }

    private List<File> collectAllEvidenceImages(File baseDir) {
        List<File> images = []

        if (baseDir == null || !baseDir.exists()) {
            return images
        }

        baseDir.eachFileRecurse { File file ->
            if (!file.isFile()) {
                return
            }

            String lower = file.name.toLowerCase(Locale.ENGLISH)
            boolean isImage =
                lower.endsWith('.png') ||
                lower.endsWith('.jpg') ||
                lower.endsWith('.jpeg') ||
                lower.endsWith('.webp')

            if (!isImage) {
                return
            }

            if (file.name.equalsIgnoreCase('gaia-logo.png')) {
                return
            }

            if (file.absolutePath.toLowerCase(Locale.ENGLISH).contains(File.separator + 'requests' + File.separator)) {
                return
            }

            images.add(file)
        }

        images.sort { File a, File b ->
            a.lastModified() <=> b.lastModified()
        }

        return images
    }

    private String cleanFailureMessage(String message) {
        String value = safeValue(message)

        if (value.contains('(Root cause:')) {
            value = value.substring(0, value.indexOf('(Root cause:')).trim()
        }

        if (value.contains('Root cause:')) {
            value = value.substring(0, value.indexOf('Root cause:')).trim()
        }

        return oneLine(value, 150)
    }

    private String cleanInfoMessage(String message) {
        String value = safeValue(message)
        value = value.replaceAll(/\s+/, ' ').trim()
        return oneLine(value, 140)
    }

    private String resolveIcon(String text, String status) {
        String lower = safeValue(text).toLowerCase(Locale.ENGLISH)
        String safeStatus = safeValue(status).toLowerCase(Locale.ENGLISH)

        if (safeStatus == 'fail') {
            return '❌'
        }

        if (lower.contains('wait')) {
            return '🔎'
        }

        if (lower.contains('search')) {
            return '🔍'
        }

        if (lower.contains('click') || lower.contains('select') || lower.contains('open')) {
            return '🖱️'
        }

        if (lower.contains('visible') || lower.contains('display')) {
            return '👁️'
        }

        if (lower.contains('import') || lower.contains('file') || lower.contains('upload')) {
            return '📄'
        }

        if (lower.contains('tab')) {
            return '📑'
        }

        if (lower.contains('browser') || lower.contains('navigate') || lower.contains('portal') || lower.contains('page')) {
            return '🌐'
        }

        if (safeStatus == 'pass') {
            return '✅'
        }

        if (safeStatus == 'skip') {
            return '⏭️'
        }

        return 'ℹ️'
    }

    private String convertLogTime(String raw) {
        String value = safeValue(raw)
        if (isBlank(value)) {
            return ''
        }

        try {
            Date parsed = new SimpleDateFormat('HH:mm:ss.SSS', Locale.ENGLISH).parse(value)
            return formatTimeOnly(parsed)
        } catch (Exception ignored) {
            return value
        }
    }

    private Map<String, Map> parseExecutionLog(String reportFolder) {
        Map<String, Map> result = [:]

        File logFile = findLatestExecutionLog(new File(reportFolder))
        if (logFile == null || !logFile.exists()) {
            return result
        }

        List<String> lines = []
        try {
            lines = logFile.readLines('UTF-8')
        } catch (Exception ignored) {
            return result
        }

        Pattern scenarioPattern = Pattern.compile(/TEST STEP:\s*Start Test Case\s*:\s*(.+)$/)
        Pattern genericStepPattern = Pattern.compile(/TEST STEP:\s*(.+)$/)
        Pattern statusPattern = Pattern.compile(/^(\d{2}:\d{2}:\d{2}\.\d{3})\s+(PASSED|FAILED|INFO|WARNING)\s+(.*)$/)

        String currentScenarioKey = null
        Integer lastScenarioStepIndex = null

        for (int i = 0; i < lines.size(); i++) {
            String rawLine = stripAnsi(lines[i])
            String line = safeValue(rawLine)

            if (isBlank(line)) {
                continue
            }

            Matcher scenarioMatcher = scenarioPattern.matcher(line)
            if (scenarioMatcher.find()) {
                String scenarioName = normalizeScenarioKey(scenarioMatcher.group(1))
                currentScenarioKey = scenarioName
                lastScenarioStepIndex = null

                if (!result.containsKey(currentScenarioKey)) {
                    result[currentScenarioKey] = [
                        rows          : [],
                        visualSummary : '',
                        visualDetails : ''
                    ]
                }
                continue
            }

            if (isBlank(currentScenarioKey)) {
                continue
            }

            Matcher genericMatcher = genericStepPattern.matcher(line)
            if (genericMatcher.find()) {
                String stepText = safeValue(genericMatcher.group(1))

                if (stepText.toLowerCase(Locale.ENGLISH).startsWith('start test case')) {
                    continue
                }
                if (stepText.toLowerCase(Locale.ENGLISH).startsWith('start listener action')) {
                    continue
                }
                if (stepText.toLowerCase(Locale.ENGLISH).startsWith('glue')) {
                    continue
                }
                if (stepText.toLowerCase(Locale.ENGLISH).startsWith('runfeaturefile')) {
                    continue
                }

                Map row = [
                    status      : 'info',
                    statusLabel : 'Info',
                    timestamp   : '',
                    text        : stepText,
                    shortText   : oneLine(stepText, 140),
                    fullText    : stepText,
                    icon        : resolveIcon(stepText, 'info'),
                    expandable  : false
                ]

                result[currentScenarioKey].rows.add(row)
                lastScenarioStepIndex = result[currentScenarioKey].rows.size() - 1
                continue
            }

            Matcher statusMatcher = statusPattern.matcher(line)
            if (statusMatcher.find()) {
                String timestamp = convertLogTime(statusMatcher.group(1))
                String statusRaw = safeValue(statusMatcher.group(2)).toLowerCase(Locale.ENGLISH)
                String message = safeValue(statusMatcher.group(3))

                String status = 'info'
                if (statusRaw == 'passed') {
                    status = 'pass'
                } else if (statusRaw == 'failed') {
                    status = 'fail'
                }

                String shortText = status == 'fail'
                    ? cleanFailureMessage(message)
                    : cleanInfoMessage(message)

                String fullText = message

                if (status == 'fail') {
                    StringBuilder fullError = new StringBuilder(message)

                    int j = i + 1
                    while (j < lines.size()) {
                        String nextRaw = stripAnsi(lines[j])
                        String next = safeValue(nextRaw)

                        if (isBlank(next)) {
                            j++
                            continue
                        }

                        if (scenarioPattern.matcher(next).find()) {
                            break
                        }

                        if (genericStepPattern.matcher(next).find()) {
                            break
                        }

                        if (statusPattern.matcher(next).find()) {
                            break
                        }

                        fullError.append('\n').append(next)
                        j++
                    }

                    fullText = fullError.toString()
                    i = j - 1

                    result[currentScenarioKey].visualSummary = shortText
                    result[currentScenarioKey].visualDetails = fullText

                    if (lastScenarioStepIndex != null &&
                        lastScenarioStepIndex >= 0 &&
                        lastScenarioStepIndex < result[currentScenarioKey].rows.size()) {
                        Map lastRow = result[currentScenarioKey].rows[lastScenarioStepIndex]
                        lastRow.status = 'fail'
                        lastRow.statusLabel = 'Fail'
                        lastRow.timestamp = timestamp
                        lastRow.icon = resolveIcon(lastRow.text, 'fail')
                    }
                } else if (status == 'pass') {
                    if (lastScenarioStepIndex != null &&
                        lastScenarioStepIndex >= 0 &&
                        lastScenarioStepIndex < result[currentScenarioKey].rows.size()) {
                        Map lastRow = result[currentScenarioKey].rows[lastScenarioStepIndex]
                        if (safeValue(lastRow.status) == 'info') {
                            lastRow.status = 'pass'
                            lastRow.statusLabel = 'Pass'
                            if (isBlank(lastRow.timestamp)) {
                                lastRow.timestamp = timestamp
                            }
                            lastRow.icon = resolveIcon(lastRow.text, 'pass')
                        }
                    }
                }

                Map actionRow = [
                    status      : status,
                    statusLabel : status == 'pass' ? 'Pass' : (status == 'fail' ? 'Fail' : 'Info'),
                    timestamp   : timestamp,
                    text        : shortText,
                    shortText   : shortText,
                    fullText    : fullText,
                    icon        : resolveIcon(shortText, status),
                    expandable  : status == 'fail'
                ]

                result[currentScenarioKey].rows.add(actionRow)
            }
        }

        return result
    }

    private List<Map> parseXmlCases(String xmlPath) {
        List<Map> cases = []

        if (isBlank(xmlPath)) {
            return cases
        }

        File xmlFile = new File(xmlPath)
        if (!xmlFile.exists()) {
            return cases
        }

        Document document
        try {
            document = parseXmlDocument(xmlFile)
        } catch (Exception ignored) {
            return cases
        }

        List<Element> testcaseElements = getTestcaseElements(document)

        testcaseElements.each { Element testcase ->
            String className = safeValue(testcase.getAttribute('classname'))
            String testName = safeValue(testcase.getAttribute('name'))
            long durationMs = toMillis(testcase.getAttribute('time'))

            Element failureNode = findFirstDirectChild(testcase, 'failure')
            Element errorNode = findFirstDirectChild(testcase, 'error')
            Element skippedNode = findFirstDirectChild(testcase, 'skipped')

            boolean failed = failureNode != null || errorNode != null
            boolean skipped = skippedNode != null

            String message = ''
            String details = ''

            if (failureNode != null) {
                message = safeValue(failureNode.getAttribute('message'))
                details = safeValue(failureNode.getTextContent())
            } else if (errorNode != null) {
                message = safeValue(errorNode.getAttribute('message'))
                details = safeValue(errorNode.getTextContent())
            } else if (skippedNode != null) {
                message = safeValue(skippedNode.getAttribute('message'))
                details = safeValue(skippedNode.getTextContent())
            }

            String displayName = ''
            if (!isBlank(className) && !isBlank(testName)) {
                displayName = className + '/' + testName
            } else if (!isBlank(testName)) {
                displayName = testName
            } else {
                displayName = className
            }

            cases.add([
                key             : normalizeScenarioKey(testName),
                name            : displayName,
                scenarioName    : isBlank(testName) ? displayName : testName,
                shortName       : isBlank(testName) ? displayName : testName,
                className       : className,
                status          : skipped ? 'skip' : (failed ? 'fail' : 'pass'),
                statusLabel     : skipped ? 'Skipped' : (failed ? 'Failed' : 'Passed'),
                durationMs      : durationMs,
                durationText    : formatDuration(durationMs),
                xmlMessage      : message,
                xmlDetails      : details,
                shortSummary    : oneLine(isBlank(message) ? testName : message, 120),
                rows            : [],
                visualSummary   : '',
                visualDetails   : '',
                startDate       : null,
                endDate         : null,
                startText       : '',
                endText         : '',
                startTag        : '',
                endTag          : '',
                evidences       : []
            ])
        }

        return cases
    }

    private void applyCaseTimes(List<Map> cases, Date suiteEndDate) {
        long totalDuration = 0L
        cases.each { Map item ->
            totalDuration += ((item.durationMs ?: 0L) as long)
        }

        long cursor = suiteEndDate.time - totalDuration

        cases.each { Map item ->
            long duration = ((item.durationMs ?: 0L) as long)
            Date startDate = new Date(cursor)
            Date endDate = new Date(cursor + duration)

            item.startDate = startDate
            item.endDate = endDate
            item.startText = formatDateTime(startDate)
            item.endText = formatDateTime(endDate)
            item.startTag = new SimpleDateFormat("MM.dd.yyyy hh:mm:ss a", Locale.ENGLISH).format(startDate)
            item.endTag = new SimpleDateFormat("MM.dd.yyyy hh:mm:ss a", Locale.ENGLISH).format(endDate)

            cursor += duration
        }
    }

    private void attachLogRowsToCases(List<Map> cases, Map<String, Map> logData) {
        cases.each { Map testCase ->
            String key = safeValue(testCase.key)
            Map scenarioLog = logData[key]

            if (scenarioLog != null) {
                List<Map> copiedRows = []
                (scenarioLog.rows ?: []).each { Map row ->
                    copiedRows.add([
                        status      : safeValue(row.status),
                        statusLabel : safeValue(row.statusLabel),
                        timestamp   : safeValue(row.timestamp),
                        text        : safeValue(row.text),
                        shortText   : safeValue(row.shortText),
                        fullText    : safeValue(row.fullText),
                        icon        : safeValue(row.icon),
                        expandable  : row.expandable == true
                    ])
                }

                testCase.rows = copiedRows
                testCase.visualSummary = safeValue(scenarioLog.visualSummary)
                testCase.visualDetails = safeValue(scenarioLog.visualDetails)
            }

            if ((testCase.rows ?: []).isEmpty()) {
                String fallbackSummary = safeValue(testCase.xmlMessage)
                String fallbackDetails = safeValue(testCase.xmlDetails)

                testCase.rows = [[
                    status      : safeValue(testCase.status),
                    statusLabel : safeValue(testCase.statusLabel),
                    timestamp   : '',
                    text        : oneLine(isBlank(fallbackSummary) ? safeValue(testCase.shortName) : fallbackSummary, 140),
                    shortText   : oneLine(isBlank(fallbackSummary) ? safeValue(testCase.shortName) : fallbackSummary, 140),
                    fullText    : fallbackDetails,
                    icon        : resolveIcon(fallbackSummary, safeValue(testCase.status)),
                    expandable  : !isBlank(fallbackDetails)
                ]]

                if (safeValue(testCase.status) == 'fail') {
                    testCase.visualSummary = oneLine(isBlank(fallbackSummary) ? 'Test failed' : fallbackSummary, 150)
                    testCase.visualDetails = fallbackDetails
                }
            }

            if (safeValue(testCase.status) == 'fail' && isBlank(testCase.visualSummary)) {
                String fallback = safeValue(testCase.xmlMessage)
                testCase.visualSummary = oneLine(isBlank(fallback) ? 'Test failed' : fallback, 150)
                testCase.visualDetails = safeValue(testCase.xmlDetails)
            }
        }
    }

    private void assignEvidences(String reportFolder, List<Map> cases) {
        File reportDir = new File(reportFolder)
        List<File> images = collectAllEvidenceImages(reportDir)
        int imageIndex = 0

        cases.each { Map testCase ->
            List<Map> evidences = []

            if (safeValue(testCase.status) == 'fail' && imageIndex < images.size()) {
                File evidence = images[imageIndex]
                evidences.add([
                    name : evidence.name,
                    src  : relativeUri(reportDir, evidence),
                    type : 'image'
                ])
                imageIndex++
            }

            testCase.evidences = evidences
        }
    }

    String createGaiaHtmlReport(String reportFolder, String suiteName, String xmlPath) {
        if (isBlank(reportFolder) || isBlank(xmlPath)) {
            return ''
        }

        File reportDir = new File(reportFolder)
        if (!reportDir.exists()) {
            return ''
        }

        List<Map> cases = parseXmlCases(xmlPath)
        Map<String, Map> logData = parseExecutionLog(reportFolder)

        Date suiteEndDate = new Date(reportDir.lastModified() > 0L ? reportDir.lastModified() : System.currentTimeMillis())

        applyCaseTimes(cases, suiteEndDate)
        attachLogRowsToCases(cases, logData)
        assignEvidences(reportFolder, cases)

        List<Map> passedCases = cases.findAll { Map item -> safeValue(item.status) == 'pass' }
        List<Map> failedCases = cases.findAll { Map item -> safeValue(item.status) == 'fail' }
        List<Map> skippedCases = cases.findAll { Map item -> safeValue(item.status) == 'skip' }

        long totalDuration = 0L
        cases.each { Map item ->
            totalDuration += ((item.durationMs ?: 0L) as long)
        }

        Date suiteStartDate = new Date(suiteEndDate.time - totalDuration)

        Map model = [
            projectName  : 'GAIA',
            suiteName    : safeValue(suiteName),
            title        : 'Test report - ' + safeValue(suiteName),
            subtitle     : 'GAIA execution overview',
            generatedAt  : formatDateTime(new Date()),
            startText    : formatDateTime(suiteStartDate),
            endText      : formatDateTime(suiteEndDate),
            durationText : formatDuration(totalDuration),
            totalCount   : cases.size(),
            passedCount  : passedCases.size(),
            failedCount  : failedCases.size(),
            skippedCount : skippedCases.size(),
            cases        : cases
        ]

        String html = new JiraGaiaHtmlTemplateBuilder().buildHtml(model)

        File htmlFile = new File(reportDir, outputFileName())
        htmlFile.setText(html, 'UTF-8')
        return htmlFile.absolutePath
    }
}





















