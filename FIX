package common

import static com.kms.katalon.core.testobject.ObjectRepository.findTestObject

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.TestObject
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI

class Login {

    @Given("User opens the Gaia Portal")
    def goToGaiaPortal() {
        WebUI.openBrowser('')
        WebUI.navigateToUrl(GlobalVariable.localhost)

        TestObject natixisButton = findTestObject('Authentication/Natixis')

        if (WebUI.waitForElementPresent(natixisButton, 10, FailureHandling.OPTIONAL)) {
            WebUI.click(natixisButton)
        }

        WebUI.takeScreenshot(RunConfiguration.getReportFolder() + "/gaia_homepage.png")
    }
}
