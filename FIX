package jiraIntegration

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import org.openqa.selenium.OutputType

import javax.imageio.ImageIO

import java.awt.GraphicsEnvironment
import java.awt.Rectangle
import java.awt.Robot
import java.awt.Toolkit
import java.awt.image.BufferedImage
import java.text.SimpleDateFormat
import java.util.Locale

class JiraImagesEvidence {

    private static final ThreadLocal<File> CURRENT_CASE_FOLDER = new ThreadLocal<File>()
    private static final ThreadLocal<String> CURRENT_CASE_ID = new ThreadLocal<String>()

    private static final SimpleDateFormat FILE_STAMP =
        new SimpleDateFormat('yyyyMMdd_HHmmss_SSS', Locale.ENGLISH)

    @Keyword
    def startCase(String caseId) {
        String safeCaseId = sanitizeCaseId(caseId)
        File evidencesRoot = new File(RunConfiguration.getReportFolder(), 'Evidences')
        File caseFolder = new File(evidencesRoot, safeCaseId)

        if (!caseFolder.exists()) {
            caseFolder.mkdirs()
        }

        CURRENT_CASE_FOLDER.set(caseFolder)
        CURRENT_CASE_ID.set(safe(caseId))
        return caseFolder
    }

    @Keyword
    def finishCase() {
        CURRENT_CASE_FOLDER.remove()
        CURRENT_CASE_ID.remove()
    }

    @Keyword
    def note(String message) {
        String text = safe(message)
        if (!text.isEmpty()) {
            KeywordUtil.logInfo('[REPORT_STEP] ' + text)
        }
    }

    @Keyword
    def checkpoint(String message) {
        String text = safe(message)
        if (!text.isEmpty()) {
            KeywordUtil.logInfo('[REPORT_STEP] ' + text)
        }
    }

    @Keyword
    String captureNow(String label = 'capture') {
        File targetFolder = resolveCurrentCaseFolder()
        if (targetFolder == null) {
            return ''
        }

        String safeLabel = sanitizeCaseId(label)
        if (safeLabel.isEmpty()) {
            safeLabel = 'capture'
        }

        File output = new File(targetFolder, FILE_STAMP.format(new Date()) + '_' + safeLabel + '.png')

        byte[] driverBytes = captureDriverBytes()
        if (driverBytes != null && driverBytes.length > 0) {
            output.bytes = driverBytes
            KeywordUtil.logInfo('Evidence screenshot saved from driver: ' + output.absolutePath)
            return output.absolutePath
        }

        BufferedImage desktop = captureDesktopImage()
        if (desktop != null) {
            ImageIO.write(desktop, 'png', output)
            KeywordUtil.logInfo('Evidence screenshot saved from desktop: ' + output.absolutePath)
            return output.absolutePath
        }

        return ''
    }

    @Keyword
    String noteAndCapture(String message, String label = 'capture') {
        note(message)
        return captureNow(label)
    }

    @Keyword
    String autoFailure(String caseId = '') {
        if (CURRENT_CASE_FOLDER.get() == null && !safe(caseId).isEmpty()) {
            startCase(caseId)
        }
        return captureNow('auto-failure')
    }

    private File resolveCurrentCaseFolder() {
        File folder = CURRENT_CASE_FOLDER.get()
        if (folder != null) {
            return folder
        }

        String caseId = safe(CURRENT_CASE_ID.get())
        if (caseId.isEmpty()) {
            return null
        }

        File evidencesRoot = new File(RunConfiguration.getReportFolder(), 'Evidences')
        File caseFolder = new File(evidencesRoot, sanitizeCaseId(caseId))
        if (!caseFolder.exists()) {
            caseFolder.mkdirs()
        }

        CURRENT_CASE_FOLDER.set(caseFolder)
        return caseFolder
    }

    private byte[] captureDriverBytes() {
        try {
            def driver = Windows.getDriver()
            if (driver != null) {
                return driver.getScreenshotAs(OutputType.BYTES)
            }
        } catch (Throwable ignored) {
        }
        return null
    }

    private BufferedImage captureDesktopImage() {
        try {
            if (GraphicsEnvironment.isHeadless()) {
                return null
            }

            Robot robot = new Robot()
            Rectangle rect = new Rectangle(Toolkit.getDefaultToolkit().getScreenSize())
            return robot.createScreenCapture(rect)
        } catch (Throwable ignored) {
            return null
        }
    }

    private String sanitizeCaseId(String value) {
        return safe(value)
            .replace('\\', '_')
            .replace('/', '_')
            .replace(':', '_')
            .replace('*', '_')
            .replace('?', '_')
            .replace('"', '_')
            .replace('<', '_')
            .replace('>', '_')
            .replace('|', '_')
            .replaceAll(/[^A-Za-z0-9._-]+/, '_')
            .replaceAll(/_+/, '_')
            .replaceAll(/^_+|_+$/, '')
    }

    private String safe(Object value) {
        return value == null ? '' : String.valueOf(value).trim()
    }
}














import com.kms.katalon.core.annotation.AfterTestCase
import com.kms.katalon.core.annotation.BeforeTestCase
import com.kms.katalon.core.context.TestCaseContext
import com.kms.katalon.core.util.KeywordUtil

import java.text.SimpleDateFormat
import java.util.Locale
import java.util.concurrent.ConcurrentHashMap

class ematchReport {

    private static final Map<String, Long> CASE_START_MS = new ConcurrentHashMap<String, Long>()

    private static final SimpleDateFormat MARKER_TIME =
        new SimpleDateFormat('yyyy-MM-dd HH:mm:ss', Locale.ENGLISH)

    @BeforeTestCase
    def beforeCase(TestCaseContext testCaseContext) {
        String caseId = safe(testCaseContext?.getTestCaseId())
        long startMs = System.currentTimeMillis()

        CASE_START_MS.put(caseId, startMs)

        appendMarker('[REPORT_CASE_START]', caseId, MARKER_TIME.format(new Date(startMs)))

        try {
            CustomKeywords.'jiraIntegration.JiraImagesEvidence.startCase'(caseId)
        } catch (Throwable t) {
            KeywordUtil.logInfo('Report listener startCase skipped: ' + safe(t.message))
        }
    }

    @AfterTestCase
    def afterCase(TestCaseContext testCaseContext) {
        String caseId = safe(testCaseContext?.getTestCaseId())
        String rawStatus = safe(testCaseContext?.getTestCaseStatus())
        String reportStatus = normalizeStatus(rawStatus)

        long endMs = System.currentTimeMillis()
        long startMs = CASE_START_MS.containsKey(caseId) ? CASE_START_MS.get(caseId) : endMs
        long durationMs = Math.max(0L, endMs - startMs)

        appendMarker('[REPORT_CASE_END]', caseId, MARKER_TIME.format(new Date(endMs)))
        appendMarker('[REPORT_STATUS]', caseId, reportStatus)
        appendMarker('[REPORT_DURATION]', caseId, String.valueOf(durationMs))

        String failureSummary = buildFailureSummary(safe(testCaseContext?.getMessage()))
        if (!failureSummary.isEmpty() && reportStatus != 'PASSED') {
            appendMarker('[REPORT_FAILURE]', caseId, failureSummary)
        }

        if (reportStatus == 'FAILED') {
            try {
                CustomKeywords.'jiraIntegration.JiraImagesEvidence.autoFailure'(caseId)
            } catch (Throwable t) {
                KeywordUtil.logInfo('Report listener autoFailure skipped: ' + safe(t.message))
            }
        }

        try {
            CustomKeywords.'jiraIntegration.JiraImagesEvidence.finishCase'()
        } catch (Throwable t) {
            KeywordUtil.logInfo('Report listener finishCase skipped: ' + safe(t.message))
        }

        CASE_START_MS.remove(caseId)
    }

    private void appendMarker(String marker, String caseId, String value) {
        KeywordUtil.logInfo(marker + ' ' + safe(caseId) + ' | ' + safe(value))
    }

    private String normalizeStatus(String rawStatus) {
        String value = safe(rawStatus).toUpperCase(Locale.ENGLISH)

        if (value == 'PASSED' || value == 'PASS' || value == 'SUCCESS') {
            return 'PASSED'
        }
        if (value == 'FAILED' || value == 'FAIL' || value == 'ERROR') {
            return 'FAILED'
        }
        if (value == 'SKIPPED' || value == 'SKIP' || value == 'NOT_RUN' || value == 'BLOCKED') {
            return 'BLOCKED'
        }

        return 'BLOCKED'
    }

    private String buildFailureSummary(String rawMessage) {
        String text = safe(rawMessage)
        if (text.isEmpty()) {
            return ''
        }

        int reasonIndex = text.indexOf('Reason:')
        if (reasonIndex >= 0) {
            String tail = text.substring(reasonIndex + 'Reason:'.length()).trim()
            List<String> lines = tail.readLines().findAll { String line ->
                String clean = safe(line)
                !clean.isEmpty() && !clean.startsWith('at ')
            }
            if (!lines.isEmpty()) {
                return lines[0]
            }
        }

        List<String> lines = text.readLines().findAll { String line ->
            String clean = safe(line)
            !clean.isEmpty() && !clean.startsWith('at ')
        }

        return lines.isEmpty() ? '' : lines[0]
    }

    private String safe(Object value) {
        return value == null ? '' : String.valueOf(value).trim()
    }
}













package jiraIntegration

class JiraHtmlTemplateBuilder {

    private static final String APP_NAME = 'EMATCH'
    private static final String REPORT_TITLE_PREFIX = 'Test report - '
    private static final String LOGO_SRC = 'Image/ematch-logo.png'

    private static final String STATUS_PASS = '#68b84b'
    private static final String STATUS_FAIL = '#d65a4a'
    private static final String STATUS_BLOCKED = '#8c35ff'

    String build(Map model) {
        return buildHtml(model)
    }

    String render(Map model) {
        return buildHtml(model)
    }

    String buildHtml(Map model) {
        Map view = normalizeModel(model)

        StringBuilder html = new StringBuilder()
        html.append('<!DOCTYPE html>\n')
        html.append('<html lang="en">\n')
        html.append('<head>\n')
        html.append('<meta charset="UTF-8">\n')
        html.append('<meta name="viewport" content="width=device-width, initial-scale=1.0">\n')
        html.append('<title>').append(htmlEscape(view.reportTitle)).append('</title>\n')
        html.append(buildStyles())
        html.append('</head>\n')
        html.append('<body>\n')

        html.append('<header class="top-banner">\n')
        html.append('  <div class="top-banner-left">\n')
        html.append('    <img class="brand-logo" src="').append(htmlEscape(safe(view.logoSrc))).append('" alt="EMATCH logo">\n')
        html.append('    <div class="brand-copy">\n')
        html.append('      <div class="banner-title">').append(htmlEscape(view.reportTitle)).append('</div>\n')
        html.append('      <div class="banner-subtitle">EMATCH execution overview</div>\n')
        html.append('    </div>\n')
        html.append('  </div>\n')
        html.append('</header>\n')

        html.append('<div class="page">\n')

        html.append('<aside class="sidebar">\n')
        html.append('  <div class="sidebar-tabs">\n')
        html.append('    <button id="tab-tests" class="sidebar-tab active" type="button" onclick="showTab(\'tests\')">Tests</button>\n')
        html.append('    <button id="tab-charts" class="sidebar-tab" type="button" onclick="showTab(\'charts\')">Charts</button>\n')
        html.append('  </div>\n')

        html.append('  <div id="tests-sidebar-block">\n')
        html.append('    <div class="search-wrap">\n')
        html.append('      <input id="scenarioSearch" class="search-input" type="text" placeholder="Search test name, path, or status." onkeyup="filterScenarios()">\n')
        html.append('    </div>\n')
        html.append('    <div id="scenarioList" class="scenario-list">\n')

        if (view.scenarios.isEmpty()) {
            html.append('<div class="empty-state">No scenarios were found for this execution.</div>')
        } else {
            view.scenarios.eachWithIndex { Map scenario, int index ->
                html.append(buildScenarioListItem(scenario, index == 0))
            }
        }

        html.append('    </div>\n')
        html.append('  </div>\n')

        html.append('  <div id="charts-sidebar-block" class="hidden">\n')
        html.append(buildChartsSidebar(view))
        html.append('  </div>\n')
        html.append('</aside>\n')

        html.append('<main class="content">\n')

        if (view.scenarios.isEmpty()) {
            html.append('<section class="scenario-panel active"><div class="scenario-title">No execution data found</div></section>')
        } else {
            view.scenarios.eachWithIndex { Map scenario, int index ->
                html.append(buildScenarioPanel(scenario, view, index == 0))
            }
        }

        html.append(buildChartsPanel(view))
        html.append('</main>\n')
        html.append('</div>\n')
        html.append(buildScripts())
        html.append('</body>\n')
        html.append('</html>\n')

        return html.toString()
    }

    private Map normalizeModel(Map model) {
        Map safeModel = model ?: [:]

        String suiteName = pickFirst(
            safeModel.suiteName,
            safeModel.executionName,
            safeModel.title,
            'Execution'
        )

        List<Map> scenarios = []
        asList(safeModel.scenarios).eachWithIndex { def rawItem, int index ->
            Map item = rawItem instanceof Map ? (Map) rawItem : [:]

            scenarios << [
                id           : pickFirst(item.id, "scenario-${index + 1}"),
                name         : pickFirst(item.name, item.scenarioName, "Scenario ${index + 1}"),
                status       : normalizeStatus(pickFirst(item.status, 'blocked')),
                durationLabel: pickFirst(item.durationLabel, '00h 00m 00s'),
                startLabel   : pickFirst(item.startLabel, '--'),
                endLabel     : pickFirst(item.endLabel, '--'),
                visualError  : pickFirst(item.visualError, ''),
                fullError    : pickFirst(item.fullError, ''),
                steps        : normalizeSteps(item.steps),
                evidence     : normalizeEvidence(item.evidence)
            ]
        }

        int passedCount = scenarios.count { Map row -> row.status == 'passed' }
        int failedCount = scenarios.count { Map row -> row.status == 'failed' }
        int blockedCount = scenarios.count { Map row -> row.status == 'blocked' }

        return [
            reportTitle  : REPORT_TITLE_PREFIX + suiteName,
            suiteName    : suiteName,
            logoSrc      : pickFirst(safeModel.logoSrc, LOGO_SRC),
            scenarios    : scenarios,
            passedCount  : passedCount,
            failedCount  : failedCount,
            blockedCount : blockedCount,
            totalCount   : scenarios.size()
        ]
    }

    private List<Map> normalizeSteps(def rawSteps) {
        List<Map> result = []
        asList(rawSteps).each { def raw ->
            if (raw instanceof Map) {
                String detail = pickFirst(raw.detail, raw.message, raw.text)
                if (!detail.isEmpty()) {
                    result << [detail: detail]
                }
            } else {
                String detail = safe(raw)
                if (!detail.isEmpty()) {
                    result << [detail: detail]
                }
            }
        }
        return result
    }

    private List<Map> normalizeEvidence(def rawEvidence) {
        List<Map> result = []
        asList(rawEvidence).each { def raw ->
            if (raw instanceof Map) {
                result << [
                    name  : pickFirst(raw.name, 'Evidence'),
                    href  : pickFirst(raw.href, ''),
                    image : Boolean.valueOf(String.valueOf(raw.image)),
                    imgSrc: pickFirst(raw.imgSrc, raw.href, '')
                ]
            }
        }
        return result
    }

    private String buildScenarioListItem(Map scenario, boolean selected) {
        String css = selected ? 'scenario-list-item selected' : 'scenario-list-item'

        StringBuilder sb = new StringBuilder()
        sb.append('<button type="button" class="')
        sb.append(css)
        sb.append('" data-sid="')
        sb.append(htmlEscape(scenario.id))
        sb.append('" onclick="showScenario(\'')
        sb.append(jsEscape(scenario.id))
        sb.append('\')">')

        sb.append('<div class="scenario-list-main">')
        sb.append('<div class="scenario-list-title">').append(htmlEscape(scenario.name)).append('</div>')
        sb.append('</div>')

        sb.append('<div class="scenario-list-side">')
        sb.append('<span class="status-pill ').append(htmlEscape(scenario.status)).append('">')
        sb.append(htmlEscape(statusLabel(scenario.status)))
        sb.append('</span>')
        sb.append('<div class="scenario-list-duration">').append(htmlEscape(scenario.durationLabel)).append('</div>')
        sb.append('</div>')

        sb.append('</button>')
        return sb.toString()
    }

    private String buildScenarioPanel(Map scenario, Map view, boolean selected) {
        String panelCss = selected ? 'scenario-panel active' : 'scenario-panel'
        boolean showFailureBlocks = scenario.status != 'passed'

        StringBuilder sb = new StringBuilder()
        sb.append('<section class="').append(panelCss).append('" id="panel-').append(htmlEscape(scenario.id)).append('">')

        sb.append('<div class="scenario-header">')
        sb.append('<div class="scenario-title">').append(htmlEscape(scenario.name)).append('</div>')
        sb.append('<div class="scenario-meta-row">')
        sb.append(buildMetaChip('Suite', view.suiteName, 'plain'))
        sb.append(buildMetaChip('Status', statusLabel(scenario.status), scenario.status))
        sb.append(buildMetaChip('Start', scenario.startLabel, 'plain-dark'))
        sb.append(buildMetaChip('End', scenario.endLabel, 'plain-dark'))
        sb.append(buildMetaChip('Duration', scenario.durationLabel, 'plain-dark'))
        sb.append('</div>')
        sb.append('</div>')

        sb.append('<div class="section-title">Steps</div>')
        sb.append('<div class="steps-card">')

        List<Map> steps = scenario.steps instanceof List ? (List<Map>) scenario.steps : []

        if (steps.isEmpty()) {
            sb.append('<div class="empty-inline">No step details available.</div>')
        } else {
            sb.append('<ul class="step-list">')
            steps.each { Map step ->
                sb.append('<li class="step-item">')
                sb.append('<span class="step-bullet">•</span>')
                sb.append('<span class="step-text">').append(htmlEscape(step.detail)).append('</span>')
                sb.append('</li>')
            }
            sb.append('</ul>')
        }

        sb.append('</div>')

        if (showFailureBlocks && !safe(scenario.visualError).isEmpty()) {
            sb.append('<div class="error-block">')
            sb.append('<div class="error-title">Visual Error Log</div>')
            sb.append('<div class="error-summary">').append(htmlEscape(scenario.visualError)).append('</div>')

            if (!safe(scenario.fullError).isEmpty()) {
                sb.append('<details class="details-box">')
                sb.append('<summary>🔎 View full error</summary>')
                sb.append('<pre>').append(htmlEscape(scenario.fullError)).append('</pre>')
                sb.append('</details>')
            }

            sb.append('</div>')
        }

        if (showFailureBlocks) {
            List<Map> evidenceList = scenario.evidence instanceof List ? (List<Map>) scenario.evidence : []

            sb.append('<div class="evidence-block">')
            sb.append('<div class="evidence-title">Evidence</div>')

            if (evidenceList.isEmpty()) {
                sb.append('<div class="empty-inline">No evidence was found for this scenario.</div>')
            } else {
                evidenceList.each { Map ev ->
                    sb.append('<div class="evidence-item">')
                    sb.append('<div class="evidence-name">').append(htmlEscape(ev.name)).append('</div>')

                    if (!safe(ev.href).isEmpty()) {
                        sb.append('<div class="evidence-links"><a href="')
                        sb.append(htmlEscape(ev.href))
                        sb.append('" target="_blank" rel="noopener noreferrer">🔎 Open evidence</a></div>')
                    }

                    if (Boolean.TRUE.equals(ev.image) && !safe(ev.imgSrc).isEmpty()) {
                        sb.append('<img class="evidence-image" src="')
                        sb.append(htmlEscape(ev.imgSrc))
                        sb.append('" alt="Evidence">')
                    }

                    sb.append('</div>')
                }
            }

            sb.append('</div>')
        }

        sb.append('</section>')
        return sb.toString()
    }

    private String buildMetaChip(String label, String value, String type) {
        StringBuilder sb = new StringBuilder()
        sb.append('<div class="meta-chip ').append(htmlEscape(type)).append('">')
        sb.append('<span class="meta-label">').append(htmlEscape(label)).append(':</span> ')
        sb.append('<span class="meta-value">').append(htmlEscape(value)).append('</span>')
        sb.append('</div>')
        return sb.toString()
    }

    private String buildChartsSidebar(Map view) {
        StringBuilder sb = new StringBuilder()
        sb.append('<div class="chart-side-wrap">')
        sb.append('<div class="chart-side-title">Execution Status</div>')
        sb.append('<div class="legend-list">')
        sb.append(buildLegendLine('Passed', STATUS_PASS, view.passedCount as int))
        sb.append(buildLegendLine('Failed', STATUS_FAIL, view.failedCount as int))
        sb.append(buildLegendLine('Blocked', STATUS_BLOCKED, view.blockedCount as int))
        sb.append('</div>')
        sb.append('</div>')
        return sb.toString()
    }

    private String buildChartsPanel(Map view) {
        int total = view.totalCount as int
        StringBuilder sb = new StringBuilder()
        sb.append('<section id="charts-panel" class="charts-panel hidden">')
        sb.append('<div class="chart-main-title">Global Overview</div>')
        sb.append('<div class="chart-bars">')
        sb.append(buildBarRow('Passed', view.passedCount as int, total, STATUS_PASS))
        sb.append(buildBarRow('Failed', view.failedCount as int, total, STATUS_FAIL))
        sb.append(buildBarRow('Blocked', view.blockedCount as int, total, STATUS_BLOCKED))
        sb.append('</div>')
        sb.append('</section>')
        return sb.toString()
    }

    private String buildLegendLine(String label, String color, int value) {
        StringBuilder sb = new StringBuilder()
        sb.append('<div class="legend-line">')
        sb.append('<span class="legend-dot" style="background:').append(color).append('"></span>')
        sb.append('<span class="legend-text">').append(htmlEscape(label)).append('</span>')
        sb.append('<span class="legend-value">').append(String.valueOf(value)).append('</span>')
        sb.append('</div>')
        return sb.toString()
    }

    private String buildBarRow(String label, int value, int total, String color) {
        double width = total <= 0 ? 0d : (((double) value / (double) total) * 100d)

        StringBuilder sb = new StringBuilder()
        sb.append('<div class="bar-row">')
        sb.append('<div class="bar-row-top">')
        sb.append('<span class="bar-label">').append(htmlEscape(label)).append('</span>')
        sb.append('<span class="bar-value">').append(String.valueOf(value)).append('</span>')
        sb.append('</div>')
        sb.append('<div class="bar-track"><div class="bar-fill" style="width:')
        sb.append(String.format(Locale.ENGLISH, '%.2f', width))
        sb.append('%; background:').append(color).append('"></div></div>')
        sb.append('</div>')
        return sb.toString()
    }

    private String normalizeStatus(String raw) {
        String value = safe(raw).toLowerCase(Locale.ENGLISH)
        if (value == 'passed' || value == 'pass' || value == 'success') {
            return 'passed'
        }
        if (value == 'failed' || value == 'fail' || value == 'error') {
            return 'failed'
        }
        return 'blocked'
    }

    private String statusLabel(String status) {
        switch (safe(status)) {
            case 'passed':
                return 'Passed'
            case 'failed':
                return 'Failed'
            default:
                return 'Blocked'
        }
    }

    private List asList(def value) {
        if (value == null) {
            return []
        }
        if (value instanceof Collection) {
            return new ArrayList(value as Collection)
        }
        if (value.getClass().isArray()) {
            return (value as Object[]).toList()
        }
        return [value]
    }

    private String pickFirst(Object... values) {
        if (values == null) {
            return ''
        }
        for (Object value : values) {
            String text = safe(value)
            if (!text.isEmpty()) {
                return text
            }
        }
        return ''
    }

    private String safe(def value) {
        return value == null ? '' : String.valueOf(value).trim()
    }

    private String htmlEscape(def value) {
        String text = safe(value)
        return text
            .replace('&', '&amp;')
            .replace('<', '&lt;')
            .replace('>', '&gt;')
            .replace('"', '&quot;')
            .replace("'", '&#39;')
    }

    private String jsEscape(def value) {
        String text = safe(value)
        return text
            .replace('\\', '\\\\')
            .replace("'", "\\'")
            .replace('\r', '')
            .replace('\n', '\\n')
    }

