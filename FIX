package jiraIntegration

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil

import java.awt.GraphicsDevice
import java.awt.GraphicsEnvironment
import java.awt.Rectangle
import java.awt.Robot
import java.awt.Toolkit
import java.awt.image.BufferedImage
import java.text.SimpleDateFormat
import java.util.Base64
import java.util.Date
import java.util.LinkedHashSet
import java.util.Locale

import javax.imageio.ImageIO

class JiraImagesEvidence {

	private static final String EVIDENCE_DIR_NAME = 'Evidences'
	private static final String EVIDENCE_INDEX_FILE_NAME = 'jira_images_evidence.tsv'
	private static final ThreadLocal<String> CURRENT_CASE_ID = new ThreadLocal<String>()

	@Keyword
	String startCase(String caseId) {
		String effectiveCaseId = safe(caseId)

		if (!effectiveCaseId.isEmpty()) {
			CURRENT_CASE_ID.set(effectiveCaseId)
		}

		File reportFolder = resolveReportFolder()

		if (reportFolder == null) {
			KeywordUtil.logInfo('Evidence startCase skipped because report folder was not resolved.')
			return ''
		}

		ensureDir(new File(reportFolder, EVIDENCE_DIR_NAME))
		ensureFile(new File(reportFolder, EVIDENCE_INDEX_FILE_NAME))

		return effectiveCaseId
	}

	@Keyword
	String autoFailure(String caseId = '', String failureMessage = '') {
		String effectiveCaseId = safe(caseId)

		if (effectiveCaseId.isEmpty()) {
			effectiveCaseId = safe(CURRENT_CASE_ID.get())
		}

		if (effectiveCaseId.isEmpty()) {
			KeywordUtil.logInfo('Evidence autoFailure skipped because caseId is empty.')
			return ''
		}

		File reportFolder = resolveReportFolder()

		if (reportFolder == null) {
			KeywordUtil.logInfo('Evidence autoFailure skipped because report folder was not resolved.')
			return ''
		}

		File evidencesRoot = new File(reportFolder, EVIDENCE_DIR_NAME)
		ensureDir(evidencesRoot)

		File caseFolder = new File(evidencesRoot, sanitizeFolderName(effectiveCaseId))
		ensureDir(caseFolder)

		String timestamp = new SimpleDateFormat('yyyyMMdd_HHmmss_SSS', Locale.ENGLISH).format(new Date())
		File imageFile = new File(caseFolder, timestamp + '_auto_failure.png')

		BufferedImage capture = captureWholeDesktop()

		if (capture == null) {
			KeywordUtil.logInfo('Evidence screenshot capture returned null for case: ' + effectiveCaseId)
			return ''
		}

		ImageIO.write(capture, 'png', imageFile)

		appendEvidenceIndex(reportFolder, effectiveCaseId, imageFile, failureMessage)

		KeywordUtil.logInfo('Evidence image saved: ' + imageFile.absolutePath)
		return imageFile.absolutePath
	}

	@Keyword
	void finishCase() {
		CURRENT_CASE_ID.remove()
	}

	private File resolveReportFolder() {
		try {
			String current = safe(RunConfiguration.getReportFolder())

			if (!current.isEmpty()) {
				File currentFolder = new File(current)
				if (currentFolder.exists()) {
					return currentFolder
				}
			}
		} catch (Throwable ignored) {
		}

		File reportsRoot = new File(RunConfiguration.getProjectDir(), 'Reports')
		if (!reportsRoot.exists()) {
			return null
		}

		List<File> leafFolders = []
		reportsRoot.eachFileRecurse { File file ->
			if (file.isDirectory()) {
				boolean hasExecutionProps = new File(file, 'execution.properties').exists()
				boolean hasJUnit = new File(file, 'JUnit_Report.xml').exists()
				boolean hasExecutionLog = new File(file, 'execution0.log').exists() || new File(file, 'execution.log').exists()

				if (hasExecutionProps || hasJUnit || hasExecutionLog) {
					leafFolders << file
				}
			}
		}

		if (leafFolders.isEmpty()) {
			return reportsRoot
		}

		leafFolders = leafFolders.sort { File a, File b ->
			b.lastModified() <=> a.lastModified()
		}

		return leafFolders[0]
	}

	private BufferedImage captureWholeDesktop() {
		try {
			Rectangle allBounds = buildAllScreensBounds()

			if (allBounds == null || allBounds.width <= 0 || allBounds.height <= 0) {
				allBounds = new Rectangle(Toolkit.defaultToolkit.screenSize)
			}

			Robot robot = new Robot()
			return robot.createScreenCapture(allBounds)
		} catch (Throwable t) {
			KeywordUtil.logInfo('Evidence capture failed: ' + safe(t.message))
			return null
		}
	}

	private Rectangle buildAllScreensBounds() {
		try {
			GraphicsEnvironment ge = GraphicsEnvironment.localGraphicsEnvironment
			GraphicsDevice[] devices = ge.screenDevices

			if (devices == null || devices.length == 0) {
				return null
			}

			Integer minX = null
			Integer minY = null
			Integer maxX = null
			Integer maxY = null

			for (GraphicsDevice device : devices) {
				Rectangle bounds = device.defaultConfiguration.bounds

				if (bounds == null) {
					continue
				}

				minX = minX == null ? bounds.x : Math.min(minX, bounds.x)
				minY = minY == null ? bounds.y : Math.min(minY, bounds.y)
				maxX = maxX == null ? (bounds.x + bounds.width) : Math.max(maxX, bounds.x + bounds.width)
				maxY = maxY == null ? (bounds.y + bounds.height) : Math.max(maxY, bounds.y + bounds.height)
			}

			if (minX == null || minY == null || maxX == null || maxY == null) {
				return null
			}

			return new Rectangle(minX, minY, maxX - minX, maxY - minY)
		} catch (Throwable ignored) {
			return null
		}
	}

	private void appendEvidenceIndex(File reportFolder, String caseId, File imageFile, String failureMessage) {
		File indexFile = new File(reportFolder, EVIDENCE_INDEX_FILE_NAME)
		ensureFile(indexFile)

		String line =
				System.currentTimeMillis() + '\t' +
				encode64(caseId) + '\t' +
				encode64(imageFile.absolutePath) + '\t' +
				encode64(safe(failureMessage)) + System.lineSeparator()

		indexFile.append(line, 'UTF-8')
	}

	private void ensureDir(File dir) {
		if (dir != null && !dir.exists()) {
			dir.mkdirs()
		}
	}

	private void ensureFile(File file) {
		if (file == null) {
			return
		}

		if (!file.parentFile.exists()) {
			file.parentFile.mkdirs()
		}

		if (!file.exists()) {
			file.createNewFile()
		}
	}

	private String sanitizeFolderName(String value) {
		return safe(value)
				.replace('\\', '_')
				.replace('/', '_')
				.replace(':', '_')
				.replace('*', '_')
				.replace('?', '_')
				.replace('"', '_')
				.replace('<', '_')
				.replace('>', '_')
				.replace('|', '_')
				.replaceAll('_+', '_')
				.replaceAll('^_+', '')
				.replaceAll('_+$', '')
	}

	private String encode64(String value) {
		String text = safe(value)
		return text.isEmpty() ? '' : Base64.encoder.encodeToString(text.getBytes('UTF-8'))
	}

	private String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}
}
