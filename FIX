        "APP_LNK_PATH=${appLnkPath}",
        "APP_EXE_PATH=${appExePath}",
        "APP_WINDOW_TITLE=${appWindowTitle}",
        "KATALON_EXTRA_ARGS=${katalonExtraArgs}"
    ]) {
        script.powershell(
            returnStatus: true,
            script: '''
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
$stopwatch = [System.Diagnostics.Stopwatch]::StartNew()

function Clean-Text {
    param([string]$Value)

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return ''
    }

    return (($Value -replace '[\\r\\n]+', ' ') -replace '\\s+', ' ').Trim()
}

function Short-Text {
    param(
        [string]$Value,
        [int]$Max = 250
    )

    $text = Clean-Text $Value

    if ($text.Length -gt $Max) {
        return $text.Substring(0, $Max - 3) + '...'
    }

    return $text
}

function Ensure-ParentDirectory {
    param([string]$Path)

    $parent = Split-Path -Path $Path -Parent

    if (-not [string]::IsNullOrWhiteSpace($parent) -and -not (Test-Path -LiteralPath $parent)) {
        New-Item -ItemType Directory -Path $parent -Force | Out-Null
    }
}

function Read-NewContent {
    param(
        [string]$Path,
        [ref]$Offset
    )

    if (-not (Test-Path -LiteralPath $Path)) {
        return @()
    }

    $fs = $null
    $sr = $null

    try {
        $fs = [System.IO.File]::Open($Path, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, [System.IO.FileShare]::ReadWrite)
        [void]$fs.Seek($Offset.Value, [System.IO.SeekOrigin]::Begin)
        $sr = New-Object System.IO.StreamReader($fs)
        $content = $sr.ReadToEnd()
        $Offset.Value = $fs.Position

        if ([string]::IsNullOrWhiteSpace($content)) {
            return @()
        }

        return @($content -split "`r?`n")
    }
    catch {
        return @()
    }
    finally {
        if ($sr) { $sr.Close() }
        if ($fs) { $fs.Close() }
    }
}

function Find-LatestJunit {
    param([string]$Root)

    if (-not (Test-Path -LiteralPath $Root)) {
        return ''
    }

    $candidate = Get-ChildItem -Path $Root -Filter 'JUnit_Report.xml' -File -Recurse -ErrorAction SilentlyContinue |
        Sort-Object LastWriteTime -Descending |
        Select-Object -First 1

    if ($candidate) {
        return $candidate.FullName
    }

    return ''
}

function Get-JUnitSummary {
    param([string]$JunitFile)

    $result = [ordered]@{
        Executed = 0
        Passed   = 0
        Failed   = 0
        Skipped  = 0
        Reason   = ''
    }

    if ([string]::IsNullOrWhiteSpace($JunitFile) -or -not (Test-Path -LiteralPath $JunitFile)) {
        return $result
    }

    try {
        [xml]$xml = Get-Content -LiteralPath $JunitFile -Raw

        $testcases = @()

        if ($xml.testsuite) {
            $testcases = @($xml.testsuite.testcase)
        }
        elseif ($xml.testsuites) {
            foreach ($ts in @($xml.testsuites.testsuite)) {
                $testcases += @($ts.testcase)
            }
        }

        $testcases = @($testcases | Where-Object { $_ })
        $result.Executed = $testcases.Count

        $failedNodes = @($testcases | Where-Object { $_.failure -or $_.error })
        $skippedNodes = @($testcases | Where-Object { $_.skipped })

        $result.Failed = $failedNodes.Count
        $result.Skipped = $skippedNodes.Count
        $result.Passed = $result.Executed - $result.Failed - $result.Skipped

        if ($failedNodes.Count -gt 0) {
            $firstBad = $failedNodes[0]

            if ($firstBad.failure) {
                $result.Reason = Short-Text (($firstBad.failure.message + ' ' + $firstBad.failure.InnerText)) 400
            }
            elseif ($firstBad.error) {
                $result.Reason = Short-Text (($firstBad.error.message + ' ' + $firstBad.error.InnerText)) 400
            }
        }
    }
    catch {
        $result.Reason = Short-Text $_.Exception.Message 400
    }

    return $result
}

function To-RelativeLog {
    param(
        [string]$FullPath,
        [string]$ReportsRoot
    )

    if ([string]::IsNullOrWhiteSpace($FullPath) -or [string]::IsNullOrWhiteSpace($ReportsRoot)) {
        return ''
    }

    try {
        $full = [System.IO.Path]::GetFullPath($FullPath)
        $root = [System.IO.Path]::GetFullPath($ReportsRoot)

        if ($full.ToLowerInvariant().StartsWith($root.ToLowerInvariant())) {
            return $full.Substring($root.Length).TrimStart('\\').Replace('\\', '/')
        }
    }
    catch {
    }

    return ''
}

function Write-ResultJson {
    param(
        [string]$Status,
        [string]$Icon,
        [int]$ExitCode,
        [int]$Executed,
        [int]$Passed,
        [int]$Failed,
        [int]$Skipped,
        [string]$Reason,
        [string]$CurrentLog,
        [string]$JunitFile,
        [string]$ResultFile,
        [string]$AssetName,
        [string]$AssetType,
        [long]$DurationSeconds
    )

    Ensure-ParentDirectory -Path $ResultFile

    $obj = [ordered]@{
        name            = $AssetName
        type            = $AssetType
        status          = $Status
        icon            = $Icon
        exitCode        = $ExitCode
        executed        = $Executed
        passed          = $Passed
        failed          = $Failed
        skipped         = $Skipped
        reason          = $Reason
        currentLog      = $CurrentLog
        junitFile       = $JunitFile
        resultFile      = $ResultFile
        logRel          = (To-RelativeLog -FullPath $CurrentLog -ReportsRoot $env:REPORTS_ROOT)
        durationSeconds = [string]$DurationSeconds
    }

    $json = $obj | ConvertTo-Json -Depth 5
    Set-Content -LiteralPath $ResultFile -Value $json -Encoding UTF8
}

try {
    Ensure-ParentDirectory -Path $env:CTX_FILE
    Ensure-ParentDirectory -Path $env:MARKER_FILE
    Ensure-ParentDirectory -Path $env:CURRENT_LOG_FILE
    Ensure-ParentDirectory -Path $env:RESULT_FILE

    if (-not (Test-Path -LiteralPath $env:REPORTS_ROOT)) {
        New-Item -ItemType Directory -Path $env:REPORTS_ROOT -Force | Out-Null
    }

    if (-not (Test-Path -LiteralPath $env:LOGS_DIR)) {
        New-Item -ItemType Directory -Path $env:LOGS_DIR -Force | Out-Null
    }

    Remove-Item -LiteralPath $env:MARKER_FILE -Force -ErrorAction SilentlyContinue
    Remove-Item -LiteralPath ($env:MARKER_FILE + '.tmp') -Force -ErrorAction SilentlyContinue
    Remove-Item -LiteralPath $env:CURRENT_LOG_FILE -Force -ErrorAction SilentlyContinue
    Remove-Item -LiteralPath $env:RESULT_FILE -Force -ErrorAction SilentlyContinue

    Set-Content -LiteralPath $env:CURRENT_LOG_FILE -Value '' -Encoding UTF8

    $ctxLines = @()
    $ctxLines += ('WORKSPACE=' + $env:WORKSPACE)
    $ctxLines += ('PROJECT_PATH=' + $env:PROJECT_PATH)
    $ctxLines += ('KATALON_EXE=' + $env:KATALON_EXE)
    $ctxLines += ('ASSET_TYPE=' + $env:ASSET_TYPE)
    $ctxLines += ('ASSET_PATH=' + $env:ASSET_PATH)
    $ctxLines += ('BROWSER_TYPE=' + $env:BROWSER_TYPE)
    $ctxLines += ('RETRY=' + $env:RETRY)
    $ctxLines += ('REPORTS_DIR=' + $env:REPORTS_ROOT)
    $ctxLines += ('LOG_DIR=' + $env:LOGS_DIR)
    $ctxLines += ('CURRENT_LOG_FILE=' + $env:CURRENT_LOG_FILE)
    $ctxLines += ('MARKER_FILE=' + $env:MARKER_FILE)
    $ctxLines += ('RUN_LABEL=' + $env:RUN_LABEL)
    $ctxLines += ('WINAPPDRIVER_EXE=' + $env:WINAPPDRIVER_EXE)
    $ctxLines += ('AUTO_START_WINAPPDRIVER=' + $env:AUTO_START_WINAPPDRIVER)
    $ctxLines += ('OPEN_VISIBLE_APP=' + $env:OPEN_VISIBLE_APP)
    $ctxLines += ('APP_LNK_PATH=' + $env:APP_LNK_PATH)
    $ctxLines += ('APP_EXE_PATH=' + $env:APP_EXE_PATH)
    $ctxLines += ('APP_WINDOW_TITLE=' + $env:APP_WINDOW_TITLE)
    $ctxLines += ('KATALON_EXTRA_ARGS=' + $env:KATALON_EXTRA_ARGS)

    Set-Content -LiteralPath $env:CTX_FILE -Value $ctxLines -Encoding ASCII

    Write-Host '------------------------------------------------------------'
    Write-Host ('🚀 DESKTOP START | ' + $env:ASSET_NAME)
    Write-Host ('📁 WORKSPACE     | ' + $env:WORKSPACE)
    Write-Host ('📄 PROJECT       | ' + $env:PROJECT_PATH)
    Write-Host ('🧪 TYPE          | ' + $env:ASSET_TYPE)
    Write-Host ('🗂️ PATH          | ' + $env:ASSET_PATH)
    Write-Host ('📜 LOG           | ' + $env:CURRENT_LOG_FILE)
    Write-Host ('⏱️ TIMEOUT       | ' + $env:ASSET_TIMEOUT_MINUTES + ' min')
    Write-Host ('🖥️ TASK          | ' + $env:DESKTOP_RUNNER_TASK)
    Write-Host '------------------------------------------------------------'

    $taskOutput = & schtasks /run /tn $env:DESKTOP_RUNNER_TASK 2>&1
    $taskExitCode = $LASTEXITCODE

    foreach ($line in @($taskOutput)) {
        if (-not [string]::IsNullOrWhiteSpace($line)) {
            Write-Host ('[TASK] ' + (Clean-Text $line))
        }
    }

    if ($taskExitCode -ne 0) {
        throw ('Failed to start scheduled task. ExitCode=' + $taskExitCode)
    }

    $stdoutOffset = 0L
    $deadline = (Get-Date).AddMinutes([int]$env:ASSET_TIMEOUT_MINUTES)
    $lastHeartbeat = Get-Date
    $exitCode = 124

    while ((Get-Date) -lt $deadline) {
        $stdoutLines = Read-NewContent -Path $env:CURRENT_LOG_FILE -Offset ([ref]$stdoutOffset)

        if ($stdoutLines.Count -gt 0) {
            foreach ($line in $stdoutLines) {
                $text = Clean-Text $line
                if (-not [string]::IsNullOrWhiteSpace($text)) {
                    Write-Host ('[KATALON] ' + $text)
                }
            }

            $lastHeartbeat = Get-Date
        }
        else {
            if ((New-TimeSpan -Start $lastHeartbeat -End (Get-Date)).TotalSeconds -ge 15) {
                Write-Host '[WAIT] Desktop run still in progress...'
                $lastHeartbeat = Get-Date
            }
        }

        if (Test-Path -LiteralPath $env:MARKER_FILE) {
            try {
                $exitLine = Get-Content -LiteralPath $env:MARKER_FILE -ErrorAction Stop | Select-Object -First 1
                $exitCode = [int]$exitLine.ToString().Trim()
            }
            catch {
                $exitCode = 1
            }

            break
        }

        Start-Sleep -Seconds 2
    }

    $stdoutLines = Read-NewContent -Path $env:CURRENT_LOG_FILE -Offset ([ref]$stdoutOffset)
    foreach ($line in $stdoutLines) {
        $text = Clean-Text $line
        if (-not [string]::IsNullOrWhiteSpace($text)) {
            Write-Host ('[KATALON] ' + $text)
        }
    }

    $junitFile = Find-LatestJunit -Root $env:REPORTS_ROOT
    $junitSummary = Get-JUnitSummary -JunitFile $junitFile

    $status = 'PASSED'
    $icon = '✅'

    $allowExitCode3 = (($env:ALLOW_EXITCODE_3_IF_GREEN + '') -eq 'true')

    if ($exitCode -eq 124) {
        $status = 'TIMEOUT'
        $icon = '⏰'
    }
    elseif ($exitCode -eq 3 -and $allowExitCode3 -and $junitSummary.Failed -eq 0) {
        $status = 'PASSED'
        $icon = '✅'
    }
    elseif ($exitCode -ne 0 -or $junitSummary.Failed -gt 0) {
        $status = 'FAILED'
        $icon = '❌'
    }

    $reason = $junitSummary.Reason
    if ([string]::IsNullOrWhiteSpace($reason) -and $status -eq 'TIMEOUT') {
        $reason = 'Desktop execution exceeded timeout'
    }
    if ([string]::IsNullOrWhiteSpace($reason) -and $status -eq 'FAILED') {
        $reason = 'Desktop execution failed without explicit JUnit reason'
    }

    $stopwatch.Stop()
    $durationSeconds = [int][Math]::Floor($stopwatch.Elapsed.TotalSeconds)

    Write-ResultJson `
        -Status $status `
        -Icon $icon `
        -ExitCode $exitCode `
        -Executed $junitSummary.Executed `
        -Passed $junitSummary.Passed `
        -Failed $junitSummary.Failed `
        -Skipped $junitSummary.Skipped `
        -Reason $reason `
        -CurrentLog $env:CURRENT_LOG_FILE `
        -JunitFile $junitFile `
        -ResultFile $env:RESULT_FILE `
        -AssetName $env:ASSET_NAME `
        -AssetType $env:ASSET_TYPE `
        -DurationSeconds $durationSeconds

    Write-Host '------------------------------------------------------------'
    Write-Host ($icon + ' DESKTOP END   | ' + $env:ASSET_NAME)
    Write-Host ('📌 STATUS       | ' + $status)
    Write-Host ('📊 EXECUTED     | ' + $junitSummary.Executed)
    Write-Host ('✅ PASSED       | ' + $junitSummary.Passed)
    Write-Host ('❌ FAILED       | ' + $junitSummary.Failed)
    Write-Host ('⏭️ SKIPPED      | ' + $junitSummary.Skipped)

    if (-not [string]::IsNullOrWhiteSpace($reason)) {
        Write-Host ('🧾 REASON       | ' + $reason)
    }

    Write-Host ('📜 LOG          | ' + $env:CURRENT_LOG_FILE)
    Write-Host '------------------------------------------------------------'

    if ($status -eq 'PASSED') {
        exit 0
    }
    elseif ($status -eq 'TIMEOUT') {
        exit 124
    }
    else {
        exit 1
    }
}
catch {
    $stopwatch.Stop()
    $durationSeconds = [int][Math]::Floor($stopwatch.Elapsed.TotalSeconds)
    $reason = Short-Text (($_ | Out-String)) 500

    Write-Host ('[ERROR] ' + $reason)

    Write-ResultJson `
        -Status 'FAILED' `
        -Icon '❌' `
        -ExitCode 1 `
        -Executed 0 `
        -Passed 0 `
        -Failed 0 `
        -Skipped 0 `
        -Reason $reason `
        -CurrentLog $env:CURRENT_LOG_FILE `
        -JunitFile '' `
        -ResultFile $env:RESULT_FILE `
        -AssetName $env:ASSET_NAME `
        -AssetType $env:ASSET_TYPE `
        -DurationSeconds $durationSeconds

    exit 1
}
'''
        )
    }

    Map result = loadResultFile(script, resultFile, fallback)
    result.psExitCode = psExit

    if (!result.status) {
        result.status = (psExit == 0 ? 'PASSED' : (psExit == 124 ? 'TIMEOUT' : 'FAILED'))
    }

    if (!result.icon) {
        result.icon = (result.status == 'PASSED' ? '✅' : (result.status == 'TIMEOUT' ? '⏰' : '❌'))
    }

    if (!result.durationSeconds) {
        result.durationSeconds = '0'
    }

    return result
}

return this
