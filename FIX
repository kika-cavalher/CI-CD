properties([
    disableConcurrentBuilds(),
    buildDiscarder(logRotator(numToKeepStr: '15'))
])

/* ============================================================================
   CONFIG - CHANGE ONLY THIS BLOCK FOR EACH PIPELINE
   ============================================================================ */

def NODE_LABEL = 'GI5_SWDCFRNXGI55817'
def SHORT_WORKSPACE = 'D:\\jenkins\\ws\\CHANGE_ME'

def RUN_NEXT_JOB = true
def NEXT_JOB = 'GI5/eMatch_Regression/CHANGE_ME'

def COLLECTIONS = [
    [stage: 'Collection 1', cmd: 'Change1.cmd'],
    [stage: 'Collection 2', cmd: 'Change2.cmd']
]

/* ============================================================================
   FIXED LOGIC - DO NOT CHANGE BELOW
   ============================================================================ */

def executionFailed = false
def manualAborted = false

def asErrorText = { Throwable err ->
    def parts = []
    def current = err

    while (current != null) {
        parts << "${current.getClass().getName()}: ${current.getMessage() ?: ''}"
        current = current.getCause()
    }

    return parts.join(' | ').toLowerCase()
}

def isTimeoutError = { Throwable err ->
    def text = asErrorText(err)
    return text.contains('timeout') ||
           text.contains('timeoutexpired') ||
           text.contains('exceededtimeout') ||
           text.contains('org.jenkinsci.plugins.workflow.steps.timeout')
}

def isManualAbortError = { Throwable err ->
    def text = asErrorText(err)
    return text.contains('flowinterruptedexception') ||
           text.contains('aborted by') ||
           text.contains('userinterruption') ||
           text.contains('aborted')
}

def stopCurrentExecution = {
    bat '''
@echo off
schtasks /end /tn "\\eMatch Automation\\RunEMatchCommand" >nul 2>&1
schtasks /end /tn "startWinDriver" >nul 2>&1
taskkill /f /im WinAppDriver.exe >nul 2>&1
taskkill /f /im katalonc.exe >nul 2>&1
taskkill /f /im KatalonStudio.exe >nul 2>&1
taskkill /f /im java.exe >nul 2>&1
ping -n 3 127.0.0.1 >nul
exit /b 0
'''
}

def runCollection = { String stageName, String cmdFile ->
    stage(stageName) {
        try {
            timeout(time: 5, unit: 'HOURS') {
                bat "call \"${env.WORKSPACE}\\jenkins\\${cmdFile}\""
            }

            echo "${stageName} completed successfully."
        } catch (Throwable err) {
            if (isManualAbortError(err)) {
                manualAborted = true
                currentBuild.result = 'ABORTED'
                echo "${stageName} was manually aborted. Stopping the whole pipeline now."

                stopCurrentExecution()
                throw err
            }

            executionFailed = true

            if (isTimeoutError(err)) {
                echo "${stageName} reached the 5 hour limit and was stopped."
            } else {
                echo "${stageName} failed: ${err}"
            }
        } finally {
            stage("Stop ${stageName}") {
                stopCurrentExecution()
            }
        }
    }
}

try {
    node(NODE_LABEL) {
        ws(SHORT_WORKSPACE) {
            stage('Checkout') {
                deleteDir()
                checkout scm
            }

            COLLECTIONS.each { item ->
                runCollection(item.stage as String, item.cmd as String)
            }
        }
    }
} catch (Throwable err) {
    if (manualAborted) {
        currentBuild.result = 'ABORTED'
        echo 'Build was manually aborted. Next pipeline will not be scheduled.'
        return
    }

    throw err
}

stage('Trigger next pipeline') {
    if (manualAborted) {
        echo 'Build was manually aborted. Next pipeline will not be scheduled.'
        return
    }

    if (RUN_NEXT_JOB && NEXT_JOB?.trim()) {
        if (executionFailed) {
            echo 'Current pipeline failed. Next pipeline will not be scheduled.'
        } else {
            echo "Scheduling next pipeline: ${NEXT_JOB}"
            build job: NEXT_JOB, wait: false, propagate: false
        }
    } else {
        echo 'Next pipeline disabled.'
    }
}

currentBuild.result = executionFailed ? 'FAILURE' : 'SUCCESS'
return
