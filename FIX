boolean isFileReady(String filePath) {
	if (isBlank(filePath)) return false

	File file = new File(filePath)
	if (!file.exists() || !file.isFile()) return false

	RandomAccessFile raf = null
	try {
		raf = new RandomAccessFile(file, 'rw')
		return true
	} catch (Exception ignored) {
		return false
	} finally {
		if (raf != null) {
			try { raf.close() } catch (Exception ignored) {}
		}
	}
}

void waitUntilFileIsReady(String filePath, int retries = 20, long sleepMs = 500) {
	for (int i = 0; i < retries; i++) {
		if (isFileReady(filePath)) {
			return
		}
		Thread.sleep(sleepMs)
	}
	throw new RuntimeException("File is locked or unavailable: ${filePath}")
}

String createUploadSnapshot(String originalFilePath) {
	if (isBlank(originalFilePath)) return ''

	File original = new File(originalFilePath)
	if (!original.exists() || !original.isFile()) return ''

	waitUntilFileIsReady(original.absolutePath)

	File tempDir = new File(RunConfiguration.projectDir + File.separator + 'tmp_jira_upload')
	if (!tempDir.exists()) {
		tempDir.mkdirs()
	}

	String safeName = System.currentTimeMillis() + '_' + original.name
	File snapshot = new File(tempDir, safeName)

	Files.copy(
		original.toPath(),
		snapshot.toPath(),
		StandardCopyOption.REPLACE_EXISTING
	)

	waitUntilFileIsReady(snapshot.absolutePath)
	return snapshot.absolutePath
}





