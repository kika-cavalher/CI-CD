	String safe(def value) {
		return value == null ? '' : value.toString().trim()
	}

	boolean isBlank(def value) {
		return safe(value).isEmpty()
	}

	boolean isTimestampFolderName(String name) {
		String value = safe(name)
		return value ==~ /\d{8}_\d{6}/ || value ==~ /\d{14}/
	}

	String sanitizeFileName(String value) {
		return safe(value).replaceAll(/[\\\/:*?"<>|]/, '_').trim()
	}

	String nowExecution() {
		return new SimpleDateFormat('yyyy-MM-dd HH.mm.ss').format(new Date())
	}

	String readCellAsString(def cell) {
		if (cell == null) {
			return ''
		}

		try {
			cell.setCellType(org.apache.poi.ss.usermodel.CellType.STRING)
		} catch (Exception ignored) {
		}

		return safe(cell.toString())
	}

	String getAppDisplayName() {
		return isBlank(APP_DISPLAY_NAME) ? PROJECT_KEY : safe(APP_DISPLAY_NAME)
	}

	String getReportSubtitle() {
		return isBlank(REPORT_SUBTITLE) ? (getAppDisplayName() + ' execution overview') : safe(REPORT_SUBTITLE)
	}

	String getReportLogoRelativePath() {
