		String startLabel = pickFirst(scenario.startLong, scenario.startShort, '--')
		String endLabel = pickFirst(scenario.endLong, scenario.endShort, '--')
		String durationLabel = pickFirst(scenario.durationLabel, '00h 00m 00s')

