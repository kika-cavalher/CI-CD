package keywords

import static com.kms.katalon.core.testdata.TestDataFactory.findTestData
import static com.kms.katalon.core.testobject.ObjectRepository.findTestObject

import java.nio.file.*
import java.text.SimpleDateFormat
import java.util.zip.*

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webservice.keyword.WSBuiltInKeywords as WS

import groovy.io.FileType
import groovy.json.JsonOutput
import groovy.json.JsonSlurper
import internal.GlobalVariable as GlobalVariable


public class JiraIntegration {
	String testSuiteName
	def testData = findTestData('Data Files/JIRA')
	def testDataJira = findTestData('Data Files/Jira Details')

	String baseUrl = testData.getValue('JIRA_API_URL',1)
	String ACCESS_TOKEN = testData.getValue('ACCESS_TOKEN',1)
	String project = testData.getValue('PROJ_KEY',1)
	String reportBasePath = testData.getValue('REPORT_FILE',1)
	String env = testDataJira.getValue('environment',1)
	String labels = testDataJira.getValue('labels',1)
	String epic = testDataJira.getValue('epic',1)



	def setTestSuiteName() {
		String testSuiteId = GlobalVariable.testSuiteGlobal
		def testSuite = testSuiteId.replace("Test Suites/", "")

		String suffixToRemove = "Jira Integration"

		// Remove suffix
		if (testSuite.endsWith(suffixToRemove)) {
			testSuiteName =  testSuite.substring(0, testSuite.length() - suffixToRemove.length()).trim()
		}
	}

	private File getLatestReportDirectory(File reportDir) {
		return reportDir.listFiles()?.findAll {
			it.isDirectory()
		}?.max {
			it.lastModified()
		}
	}

	def getTestSuiteReport() {
		File reportDir = new File(reportBasePath)


		// Get the last report directory generated
		File latestReportDir = getLatestReportDirectory(reportDir)
		if (latestReportDir == null) {
			KeywordUtil.markFailed("No report folder found in the directory: ${reportDir}")
			return
		}

		File testSuiteDir = new File(latestReportDir,testSuiteName)

		return testSuiteDir
	}

	def getXmlFile(File testSuiteDir) {
		if (testSuiteDir.exists() && testSuiteDir.isDirectory()) {
			String junitXmlPath = null

			testSuiteDir.eachFileRecurse(FileType.ANY) { file ->
				KeywordUtil.logInfo("Existing files:" + file.name)
				if (file.name.contains("cucumber.xml")) {
					KeywordUtil.logInfo("Cucumber file path: " + file.absolutePath)
					junitXmlPath = file.absolutePath
					return
				}
			}
			KeywordUtil.logInfo("Junit report file path"+junitXmlPath)
			return junitXmlPath
		} else {
			KeywordUtil.markFailed("Test Suite directory does not exist: ${testSuiteDir.absolutePath}")
			return
		}
	}


	def importResults (String junitXmlPath){
		def response = WS.sendRequest(findTestObject('Jira Integration/import Results',[('filePath'): junitXmlPath ,('project'):project, ('baseUrl'): baseUrl, ('token'): ACCESS_TOKEN]));
		def slurper = new JsonSlurper();

		int status = WS.getResponseStatusCode(response)
		KeywordUtil.logInfo("status" +status)
		def parsedJson = slurper.parseText(response.getResponseBodyContent());


		if (status == 200 || status == 204) {
			KeywordUtil.logInfo("Importing results..."+parsedJson.toString())
			def testExecIssue = parsedJson.testExecIssue
			def testExecKeys = [testExecIssue.key]
			return testExecKeys
		}
		else {
			return 'ERROR' + status.toString();
		}
	}

	def getTestPlanName(String testSuiteName) {
		def testData = findTestData('Data Files/Test Plan Names')
		for (def index = 1; index <= testData.getRowNumbers(); index++) {
			KeywordUtil.logInfo("columns"+testData.columnNames)
			if (testData.getValue('Test Suite', index) == testSuiteName) {
				return testData.getValue('Test Plan Name',index)
			}
		}
	}

	def getTestPlan() {
		String summary = getTestPlanName(testSuiteName)

		KeywordUtil.logInfo("Test Suite Name: "+summary)

		String escaped = summary.replace("[", "\\\\[").replace("]", "\\\\]");

		def response = WS.sendRequest(findTestObject('Jira Integration/Get Test Plan',[('project'):project,('token'): ACCESS_TOKEN,('summary'): escaped, ('parent'): epic]))
		def slurper = new JsonSlurper();

		int status = WS.getResponseStatusCode(response)
		KeywordUtil.logInfo("status" +status)
		def parsedJson = slurper.parseText(response.getResponseBodyContent());


		if (status == 200) {
			def total = parsedJson.total
			KeywordUtil.logInfo("test plan with this name founded" +total)

			if (total < 1) {
				return createTestPlan(summary)
			}
			else if(total == 1) {
				def issues = parsedJson.issues
				return issues[0].key
			}
			else {
				KeywordUtil.logInfo('Exists 2 or more test plans with the same name')
			}
		}
		else {
			KeywordUtil.logInfo('ERROR' + status.toString());
		}
	}

	def createTestPlan(String summary) {
		def response = WS.sendRequest(findTestObject('Jira Integration/Create Test Plan',[('token'): ACCESS_TOKEN,('env'):env,('project'):project ,('summary'): summary, ('labels'): labels,('epic'):epic]));
		def slurper = new JsonSlurper();

		int status = WS.getResponseStatusCode(response)
		KeywordUtil.logInfo("status" +status)
		def parsedJson = slurper.parseText(response.getResponseBodyContent());

		if (status == 201) {
			KeywordUtil.logInfo(parsedJson.toString())
			return parsedJson.key
		}
		else {
			KeywordUtil.logInfo('ERROR' + status.toString());
		}
	}

	def UpdateTestPlan(String testPlanKey, List<String> testExecKeys) {
		def jsonBody = [
			addTestsToPlan: true,
			add: testExecKeys
		]

		def jsonBodyString = JsonOutput.toJson(jsonBody)

		def response = WS.sendRequest(findTestObject('Jira Integration/Update Test Plan',[('token'): ACCESS_TOKEN,('testPlanKey'):testPlanKey,('jsonBody'): jsonBodyString]));

		int status = WS.getResponseStatusCode(response)

		if (status == 200) {
			return KeywordUtil.logInfo('Test executions added to the Test Plan!')
		}
		else {
			return 'ERROR' + status.toString()
		}
	}

	def UpdateTestExecution(List<String> testExecKeys) {
		String timestamp =  new SimpleDateFormat("yyyy-MM-dd HH.mm.ss").format(new Date());

		String summary = getTestPlanName(testSuiteName) + ' ' + timestamp
		String labels_execution = testDataJira.getValue('labels',1)

		KeywordUtil.logInfo('\nUpdating information on Jira issue ' + testExecKeys.get(0) + '.')

		def response = WS.sendRequest(findTestObject('Jira Integration/Update Test Execution Name',[('issueID'): testExecKeys.get(0),('token'): ACCESS_TOKEN,('summary'):summary,('labels'): labels_execution,('env'):env]));

		int status = WS.getResponseStatusCode(response)

		if (status == 204) {
			return KeywordUtil.logInfo("Updating Test Execution Information "+status.toString())
		}
		else {
			return 'ERROR' + status.toString()
		}
	}


	def zipEvidences(String folderPath) {
		String zippedFile = folderPath + '\\Evidences.zip'
		ZipOutputStream output = new ZipOutputStream(new FileOutputStream(zippedFile));

		File folderToZip = new File(folderPath)

		File [] subfolders = folderToZip.listFiles().findAll { file -> file.isDirectory() }

		subfolders[0].eachFileRecurse() { file ->
			KeywordUtil.logInfo("File to be added: "+file)
			if (file.isDirectory()) {
				String zipEntryName = file.relativePath(subfolders[0]).toString().replace("\\", "/") + "/"
				output.putNextEntry(new ZipEntry(zipEntryName))
				output.closeEntry()
			}
			else if (file.isFile()) {
				if (!file.toString().equalsIgnoreCase(zippedFile)) {
					output.putNextEntry(new ZipEntry(file.name.toString()))
					Files.copy(file.toPath(), output);
					output.closeEntry();
				}
			}
		}
		output.close();
		return zippedFile
	}


	def addAttachment(File filePath,List<String> execID){
		def response = WS.sendRequest(findTestObject('Jira Integration/Evidence attachment',[('token'): ACCESS_TOKEN,('evidences'): filePath, ('execID'):execID.get(0)]));
		def slurper = new JsonSlurper();

		int status = WS.getResponseStatusCode(response)
		def parsedJson = slurper.parseText(response.getResponseBodyContent());

		if (status == 200) {
			return KeywordUtil.logInfo("Adding result.zip..."+parsedJson.toString())
		}
		else {
			return 'ERROR' + status.toString()
		}
	}

	def updateTestExecutionStatus(String execID, String transitionActionId) {
		def response = WS.sendRequest(findTestObject('Jira Integration/Transition Issue Status', [('token'): ACCESS_TOKEN,('issueID'): execID, ('transitionID'): transitionActionId]));
		return WS.getResponseStatusCode(response);
	}


	@Keyword
	def jiraImport() {
		KeywordUtil.logInfo("Getting the Test Suite Name...")
		setTestSuiteName()
		KeywordUtil.logInfo("Getting the Test Suite File Path...")
		File testSuiteDir = getTestSuiteReport()
		KeywordUtil.logInfo("Getting the Junit xml file...")
		String junitXmlPath = getXmlFile(testSuiteDir)
		KeywordUtil.logInfo("Importing all the tests of the test suite and create a test execution for each...")
		/* Note: If the test is already create, just create a test execution for the test.*/

		List<String> testExecKeys = importResults(junitXmlPath)

		/*Create or update test plan with the executed tests*/
		String updateTestPlanInExcelKey = getTestPlan()
		UpdateTestPlan(updateTestPlanInExcelKey,testExecKeys)
		KeywordUtil.logInfo("Updating Test Execution Information...")
		UpdateTestExecution(testExecKeys)
		KeywordUtil.logInfo("Zip files...")
		def folderToZip = testSuiteDir.absolutePath
		KeywordUtil.logInfo("Adding evidences to test execution...")
		zipEvidences(folderToZip)
		addAttachment(new File(testSuiteDir.absolutePath.concat("\\evidences.zip")),testExecKeys)

		KeywordUtil.logInfo("Update Test Execution Status (In progress)....")

		updateTestExecutionStatus(testExecKeys.get(0),"11")

		KeywordUtil.logInfo("Update Test Execution Status (In progress)....")

		updateTestExecutionStatus(updateTestPlanInExcelKey,"11")
	}
}
