pipeline {
  agent { label 'GI5_SWDCFRNXGI55817' }

  options {
    timestamps()
    ansiColor('xterm')
    disableConcurrentBuilds()
    timeout(time: 4, unit: 'HOURS')
  }

  environment {
    CTX_FILE   = 'D:\\Projects\\eMatchStarters\\run-context.properties'
    TASK_NAME  = '\\eMatch Automation\\RunEMatchDesktop'
    PROJECT_FILE = 'eMatch POC.prj'
    KATALON_EXE  = 'C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0\\katalonc.exe'
    COLLECTION_PATH = 'Test Suites/Archive Mode/Archive Mode Collection'
    BROWSER_TYPE = 'Windows'
    RETRY = '0'
  }

  stages {
    stage('Prepare Context') {
      steps {
        script {
          def marker = "${env.WORKSPACE}\\Reports\\__jenkins_task_exitcode.txt"

          bat """@echo off
if not exist "%WORKSPACE%\\Reports" mkdir "%WORKSPACE%\\Reports"
if exist "${marker}" del /f /q "${marker}"
exit /b 0
"""

          def ctx =
            "WORKSPACE=${env.WORKSPACE}\r\n" +
            "PROJECT_FILE=${env.PROJECT_FILE}\r\n" +
            "KATALON_EXE=${env.KATALON_EXE}\r\n" +
            "COLLECTION_PATH=${env.COLLECTION_PATH}\r\n" +
            "BROWSER_TYPE=${env.BROWSER_TYPE}\r\n" +
            "RETRY=${env.RETRY}\r\n"

          writeFile file: env.CTX_FILE, text: ctx, encoding: 'ASCII'

          env.DESKTOP_MARKER = marker
        }
      }
    }

    stage('Run Desktop') {
      steps {
        script {
          echo "Running Task Scheduler: ${env.TASK_NAME}"

          bat """@echo off
schtasks /run /tn "${env.TASK_NAME}"
exit /b %ERRORLEVEL%
"""

          timeout(time: 180, unit: 'MINUTES') {
            echo "Waiting marker file: ${env.DESKTOP_MARKER}"

            while (true) {
              if (fileExists(env.DESKTOP_MARKER)) {
                break
              }
              sleep time: 3, unit: 'SECONDS'
            }
          }

          def ecText = readFile(env.DESKTOP_MARKER).trim()
          int ec = 1
          try {
            ec = Integer.parseInt(ecText)
          } catch (ignored) {
            ec = 1
          }

          echo "Desktop task finished. ExitCode=${ec}"

          if (ec != 0) {
            error("Desktop execution failed. ExitCode=${ec}")
          }
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'Reports/**', allowEmptyArchive: true
    }
  }
}
