		def matcherB = (raw =~ /^(\d{2}:\d{2}:\d{2}\.\d{3})/)
		if (matcherB.find()) {
			return cleanClock(safeValue(matcherB.group(1)))
		}

		def matcherC = (raw =~ /^(\d{2}\.\d{3})/)
		if (matcherC.find()) {
			try {
				Date value = new SimpleDateFormat('ss.SSS', Locale.ENGLISH).parse(matcherC.group(1))
				return new SimpleDateFormat('HH:mm:ss', Locale.ENGLISH).format(value)
			} catch (Exception ignored) {
			}
		}

		return ''
	}

