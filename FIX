	private List<String> readBottomBarFields() {
		WindowsTestObject bottomBarObject =
			new WindowsTestObject('bottomBarFields')

		bottomBarObject.setLocatorStrategy(LocatorStrategy.XPATH)
		bottomBarObject.setLocator('//Window/Pane[2]/*')

		List<RemoteWebElement> children =
			Windows.findElements(bottomBarObject) as List<RemoteWebElement>

		List<String> fieldNames = []

		for (RemoteWebElement child : children) {
			String text = safeText(child.getText())

			if (!text.isEmpty()) {
				fieldNames.add(text)
			}
		}

		return fieldNames
	}

	private void validateCalendar(
		Integer timeoutSeconds,
		List<String> errors
	) {
		boolean calendarPresent = Windows.verifyElementPresent(
			findWindowsObject('GUI behavior/widgetCalendar'),
			timeoutSeconds,
			FailureHandling.OPTIONAL
		)

		if (!calendarPresent) {
			errors.add('Calendar widget is not present.')
			return
		}

		Map<String, String> requiredCalendarObjects = [
			'GUI behavior/topBarCalendar':
				'Calendar widget does not contain top controls.',
			'GUI behavior/ClosureArreteCalendar':
				'Calendar widget does not contain Clôture arrêté.',
			'GUI behavior/ClosureComptableCalendar':
				'Calendar widget does not contain Clôture comptable.',
			'GUI behavior/ClosureInvetaireCalendar':
				'Calendar widget does not contain Clôture inventaire.',
			'GUI behavior/CRSHebdoCalendar':
				'Calendar widget does not contain CRS Hebdo.',
			'GUI behavior/currentArreteCalendar':
				'Calendar widget does not contain Arrêté courant.',
			'GUI behavior/EndOfAlimCalendar':
				'Calendar widget does not contain Fin alim PL Eco Système.'
		]

		requiredCalendarObjects.each {
			String objectPath,
			String errorMessage ->

			boolean present = Windows.verifyElementPresent(
				findWindowsObject(objectPath),
				timeoutSeconds,
				FailureHandling.OPTIONAL
			)

			if (!present) {
				errors.add(errorMessage)
			}
		}
	}

