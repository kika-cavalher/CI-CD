        js.append("      item.classList.add('active');\n")
        js.append("    }\n")
        js.append("  });\n")
        js.append("}\n")

        js.append("function filterScenarios() {\n")
        js.append("  var input = document.getElementById('scenarioSearch');\n")
        js.append("  var term = input.value.toLowerCase();\n")
        js.append("  document.querySelectorAll('.scenario-item').forEach(function(item) {\n")
        js.append("    var text = (item.getAttribute('data-search') || '').toLowerCase();\n")
