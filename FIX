	private String extractErrorBlock(String plainText, List<String> keys) {
		String fullText = safe(plainText)
		if (fullText.isEmpty()) {
			return ''
		}

		for (String key : keys) {
			if (key.isEmpty()) {
				continue
			}

			int start = fullText.indexOf(key)
			if (start < 0) {
				continue
			}

			int reasonIndex = fullText.indexOf('Reason:', start)
			int messageIndex = fullText.indexOf('Message:', start)
			int blockStart = reasonIndex >= 0 ? reasonIndex : messageIndex

			if (blockStart < 0) {
				continue
			}

			int end = nearestPositive([
				fullText.indexOf('TEST STEP:', blockStart + 1),
				fullText.indexOf('TEST CASE:', blockStart + 1),
				fullText.indexOf('TEST SUITE:', blockStart + 1),
				fullText.indexOf('Video', blockStart + 1)
			])

			if (end < 0) {
				end = Math.min(fullText.length(), blockStart + 8000)
			}

			String block = safe(fullText.substring(blockStart, end))
			if (!block.isEmpty()) {
				return cleanupErrorBlock(block)
			}
		}

		return ''
	}

	private int nearestPositive(List<Integer> values) {
		List<Integer> positives = values.findAll { Integer it -> it != null && it >= 0 }
		if (positives.isEmpty()) {
			return -1
		}
		return positives.min()
	}

	private String cleanupErrorBlock(String block) {
