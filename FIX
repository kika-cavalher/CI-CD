	private String firstExistingImage(List<String> relativePaths) {
		for (String relativePath : relativePaths) {
			try {
				String fullPath = new File(RunConfiguration.getProjectDir(), relativePath).getAbsolutePath()
				if (new File(fullPath).exists()) {
					return fullPath
				}
			} catch (Throwable ignored) {
			}
		}
		return ''
	}

	private boolean clickFirstAvailableImage(List<String> relativePaths, int attempts, long waitMs, String logMessage) {
		String imagePath = firstExistingImage(relativePaths)

		if (!imagePath) {
			KeywordUtil.logInfo("Image file was not found for action: ${logMessage}")
			return false
		}

		for (int i = 1; i <= attempts; i++) {
			try {
				KeywordUtil.logInfo("${logMessage}. Attempt ${i}/${attempts} using ${imagePath}")
				WindowsImageKeywords.clickImage(imagePath)
				sleepMs(waitMs)
				return true
			} catch (Throwable ignored) {
				sleepMs(waitMs)
			}
		}

		return false
	}

	private boolean waitForHomeGrey(int timeoutSeconds) {
		long end = System.currentTimeMillis() + (timeoutSeconds * 1000L)
		String imagePath = firstExistingImage(homeGreyImageCandidates())

		if (!imagePath) {
			return false
		}

		while (System.currentTimeMillis() < end) {
			try {
				WindowsImageKeywords.clickImage(imagePath)
				sleepMs(1000)
				return true
			} catch (Throwable ignored) {
				sleepMs(1000)
			}
		}

		return false
	}

	private void sleepMs(long ms) {
		try {
			Thread.sleep(ms)
		} catch (InterruptedException ignored) {
			Thread.currentThread().interrupt()
		}
	}

	private String normalizeTitle(String value) {
		return safe(value).replaceAll('\\s+', ' ').trim()
	}

	private String safe(Object value) {
		return value == null ? '' : value.toString().trim()
	}

	private String escapePowerShell(String value) {
		return safe(value).replace("'", "''")
	}

	private String xpathLiteral(String value) {
		String v = safe(value)

		if (!v.contains("'")) {
			return "'${v}'"
		}

		if (!v.contains('"')) {
			return "\"${v}\""
		}

		List<String> parts = v.split("'").collect { "'${it}'" }
		return "concat(${parts.join(", \"'\", ")})"
	}
