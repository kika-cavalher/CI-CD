	@Keyword
	String findLatestExportedFilePath(
			String targetEnvironment,
			String exportLabel) {

		String environment = resolveEnvironmentName(
				targetEnvironment,
				exportLabel
				)

		String exportFolderPath = getCurrentExportFolderPath(
				targetEnvironment,
				exportLabel
				)

		File exportFolder = new File(
				exportFolderPath
				)

		if (!exportFolder.exists() ||
				!exportFolder.isDirectory()) {

			logInfo(
					'Export folder was not found.\n' +
						'Folder: ' +
						exportFolderPath
					)

			return ''
		}

		String expectedSuffix = shortenFilePart(
				resolveExportLabelSuffixForFileName(
				exportLabel
				),
				MAX_LABEL_LENGTH
				)

		File[] folderFiles = exportFolder.listFiles()

		List<File> matchingFiles = []

		if (folderFiles != null) {
			for (File file : folderFiles) {

				if (file == null ||
						!file.exists() ||
						!file.isFile() ||
						file.length() <= 0 ||
						file.getName().startsWith('~$')) {

					continue
				}

				String lowerName =
						file.getName().toLowerCase()

				boolean excelFile =
						lowerName.endsWith('.xlsx') ||
						lowerName.endsWith('.xlsm') ||
						lowerName.endsWith('.xls')

				boolean environmentMatches =
						file.getName()
						.toUpperCase()
						.startsWith(
						environment +
							'_'
						)

				boolean suffixMatches =
						expectedSuffix == null ||
						expectedSuffix.trim().isEmpty() ||
						removeExcelExtension(
						file.getName()
						)
						.toLowerCase()
						.endsWith(
						'_' +
							expectedSuffix.toLowerCase()
						)

				if (excelFile &&
						environmentMatches &&
						suffixMatches) {

					matchingFiles.add(file)
				}
			}
		}

		if (matchingFiles.isEmpty()) {

			logInfo(
					'No exported file matched the expected values.\n' +
						'Environment: ' +
						environment + '\n' +
						'Export label: ' +
						safeLogText(exportLabel) + '\n' +
						'Expected suffix: ' +
						safeLogText(expectedSuffix) + '\n' +
						'Folder: ' +
						exportFolderPath
					)

			return ''
		}

		matchingFiles.sort {
			File first,
			File second ->

			second.lastModified() <=>
					first.lastModified()
		}

		File latestExportedFile =
				matchingFiles.first()

		logInfo(
				'Latest exported file resolved.\n' +
					'File: ' +
					latestExportedFile.getName() + '\n' +
					'Path: ' +
					latestExportedFile.getAbsolutePath() + '\n' +
					'Size bytes: ' +
					latestExportedFile.length()
				)

		return latestExportedFile.getAbsolutePath()
	}


