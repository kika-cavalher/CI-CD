String displayValue(Object value) {

	if (value == null) {
		return 'NOT AVAILABLE'
	}

	String text =
		value.toString().trim()

	if (text.isEmpty()) {
		return 'EMPTY'
	}

	if (text == '0') {
		return 'NOT AVAILABLE'
	}

	return text
}
