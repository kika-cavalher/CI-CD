	String getXmlFilePath() {
		String reportPath = getResolvedReportPath()

		if (isBlank(reportPath)) {
			return null
		}

		File reportDir = new File(reportPath)
		String xmlPath = null

		reportDir.eachFileRecurse(FileType.FILES) { file ->
			if (file.name.equalsIgnoreCase(PRIMARY_XML_FILE_NAME)) {
				xmlPath = file.absolutePath
			}
		}

		if (xmlPath == null) {
			reportDir.eachFileRecurse(FileType.FILES) { file ->
				if (file.name.toLowerCase().contains(SECONDARY_XML_FILE_NAME.toLowerCase())) {
					xmlPath = file.absolutePath
				}
			}
		}

		if (xmlPath == null) {
			KeywordUtil.markFailed("No XML file found inside report directory: ${reportDir.absolutePath}")
			return null
		}

		KeywordUtil.logInfo("XML file found: ${xmlPath}")
		return xmlPath
	}

	String getHtmlReportFilePath() {
		String reportPath = getResolvedReportPath()

		if (isBlank(reportPath)) {
			return null
		}

		File reportDir = new File(reportPath)

		File exact = null
		File fallback = null

		reportDir.eachFileRecurse(FileType.FILES) { file ->
			if (file.name.equalsIgnoreCase(HTML_REPORT_NAME)) {
				exact = file
			}

			if (fallback == null
				&& file.name.toLowerCase().endsWith('.html')
				&& !file.name.toLowerCase().contains('preload')) {
				fallback = file
			}
		}

		if (exact != null) {
			KeywordUtil.logInfo("HTML report found by configured name: ${exact.absolutePath}")
			return exact.absolutePath
		}

		if (fallback != null) {
			KeywordUtil.logInfo("HTML report found by fallback search: ${fallback.absolutePath}")
			return fallback.absolutePath
		}

		KeywordUtil.logInfo("No HTML report found.")
		return null
	}

	boolean isFileAllowedInZip(File file, String zipFileName) {
		if (file == null || !file.isFile()) {
			return false
		}

		String lowerName = file.name.toLowerCase()

		if (lowerName.endsWith('.lck')) {
			return false
		}

		if (lowerName.endsWith('.zip')) {
			return false
		}

		if (file.name.equalsIgnoreCase(zipFileName)) {
			return false
		}

		return true
	}

	String zipReports() {
		String reportPath = getResolvedReportPath()

		if (isBlank(reportPath)) {
			return null
		}

		String zippedFile = reportPath + File.separator + REPORT_ZIP_NAME
		def output = new ZipOutputStream(new FileOutputStream(zippedFile))

		new File(reportPath).eachFile { file ->
			if (!isFileAllowedInZip(file, REPORT_ZIP_NAME)) {
				return
			}

			try {
				output.putNextEntry(new ZipEntry(file.name))

				def zipInput = new FileInputStream(file)
				byte[] buffer = new byte[1024]
				int bytesRead

				while ((bytesRead = zipInput.read(buffer)) != -1) {
					output.write(buffer, 0, bytesRead)
				}

				output.closeEntry()
				zipInput.close()

				KeywordUtil.logInfo("Added report file to ZIP: ${file.name}")
			} catch (Exception e) {
				KeywordUtil.markWarning("Could not add report file to ZIP: ${file.name} - ${e.message}")
			}
		}

		output.close()
		KeywordUtil.logInfo("Report ZIP created successfully: ${zippedFile}")
		return zippedFile
	}

	String zipEvidences() {
		String reportPath = getResolvedReportPath()

		if (isBlank(reportPath)) {
			return null
		}

		String evidencePath = reportPath + File.separator + EVIDENCE_FOLDER_NAME
		File evidenceFolder = new File(evidencePath)

		if (!evidenceFolder.exists() || !evidenceFolder.isDirectory()) {
			KeywordUtil.logInfo("Evidence folder not found: ${evidenceFolder.absolutePath}")
			return null
		}

		String zippedFile = evidencePath + File.separator + EVIDENCE_ZIP_NAME
		def output = new ZipOutputStream(new FileOutputStream(zippedFile))

		evidenceFolder.eachFileRecurse(FileType.FILES) { file ->
			if (!isFileAllowedInZip(file, EVIDENCE_ZIP_NAME)) {
				return
			}

			try {
				String relativePath = evidenceFolder.toPath().relativize(file.toPath()).toString().replace("\\", "/")

				output.putNextEntry(new ZipEntry(relativePath))

				def zipInput = new FileInputStream(file)
				byte[] buffer = new byte[1024]
				int bytesRead

				while ((bytesRead = zipInput.read(buffer)) != -1) {
					output.write(buffer, 0, bytesRead)
				}

				output.closeEntry()
				zipInput.close()

				KeywordUtil.logInfo("Added evidence file to ZIP: ${relativePath}")
			} catch (Exception e) {
				KeywordUtil.markWarning("Could not add evidence file to ZIP: ${file.name} - ${e.message}")
			}
		}

		output.close()
		KeywordUtil.logInfo("Evidence ZIP created successfully: ${zippedFile}")
		return zippedFile
	}

