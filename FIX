class JiraGaiaReportBuilder {

    private static final String REPORT_FILE_NAME = 'gaiaReport.html'
    private static final String DEFAULT_LOGO_RELATIVE_PATH = 'Image/gaia-logo.png'

    JiraFlowCoordinator flow

    JiraGaiaReportBuilder(JiraFlowCoordinator flow) {
        this.flow = flow
    }

    String createGaiaHtmlReport(String reportFolder, String suiteName, String xmlPath) {
        if (isBlank(reportFolder) || isBlank(xmlPath)) {
            return ''
        }

        File reportDir = new File(reportFolder)
        if (!reportDir.exists()) {
            return ''
        }

        String resolvedSuiteName = resolveSuiteName(reportDir, suiteName)
        List<Map> xmlCases = parseXmlCases(xmlPath)
        List<Map> scenarios = parseExecutionScenarios(reportDir)

        if (scenarios.isEmpty()) {
            scenarios = buildFallbackScenarios(xmlCases)
        } else {
            enrichScenariosWithFallbackData(scenarios, xmlCases)
        }

        normalizeScenarioSteps(scenarios)
        attachEvidenceToFailedScenarios(reportDir, scenarios)

        Map summary = buildSummary(reportDir, scenarios)
        String logoSrc = resolveAssetUrl(reportDir, DEFAULT_LOGO_RELATIVE_PATH)

        Map model = [
            suiteName  : resolvedSuiteName,
            reportTitle: 'Test report - ' + resolvedSuiteName,
            subtitle   : 'GAIA execution overview',
            generatedAt: formatDisplayDate(new Date()),
            logoSrc    : logoSrc,
            summary    : summary,
            scenarios  : scenarios
        ]

        String html = new JiraGaiaHtmlTemplateBuilder().build(model)

        File htmlFile = new File(reportDir, REPORT_FILE_NAME)
        htmlFile.setText(html, 'UTF-8')
        return htmlFile.absolutePath
    }

    // =========================================================================
    // SUITE / SUMMARY
    // =========================================================================

    private String resolveSuiteName(File reportDir, String suiteName) {
        String candidate = safeValue(suiteName)
        if (!isBlank(candidate)) {
            return candidate
        }

        File parent = reportDir.parentFile
        if (parent != null && !isBlank(parent.name)) {
            return safeValue(parent.name)
        }

        return 'GAIA Execution'
    }

    private Map buildSummary(File reportDir, List<Map> scenarios) {
        int passed = scenarios.count { Map item -> safeValue(item.status) == 'passed' }
        int failed = scenarios.count { Map item -> safeValue(item.status) == 'failed' }
        int skipped = scenarios.count { Map item -> safeValue(item.status) == 'skipped' }
        int info = scenarios.count { Map item -> safeValue(item.status) == 'info' }

        long totalDurationMs = 0L
        scenarios.each { Map item ->
            totalDurationMs += toLong(item.durationMs)
        }

        String startLabel = ''
        String endLabel = ''

        List<String> starts = scenarios.collect { safeValue(it.startLabel) }.findAll { !isBlank(it) }
        List<String> ends = scenarios.collect { safeValue(it.endLabel) }.findAll { !isBlank(it) }

        if (!starts.isEmpty()) {
            startLabel = starts.first()
        }
        if (!ends.isEmpty()) {
            endLabel = ends.last()
        }

        if (isBlank(startLabel) || isBlank(endLabel)) {
            Date endDate = new Date(reportDir.lastModified())
            Date startDate = new Date(endDate.time - totalDurationMs)

            if (isBlank(startLabel)) {
                startLabel = formatTimeOnly(startDate)
            }
            if (isBlank(endLabel)) {
                endLabel = formatTimeOnly(endDate)
            }
        }

        return [
            total         : scenarios.size(),
            passed        : passed,
            failed        : failed,
            skipped       : skipped,
            info          : info,
            totalDuration : totalDurationMs,
            durationLabel : formatDurationFull(totalDurationMs),
            startLabel    : startLabel,
            endLabel      : endLabel
        ]
    }

    // =========================================================================
    // XML FALLBACK
    // =========================================================================

    private List<Map> parseXmlCases(String xmlPath) {
        List<Map> result = []

        File xmlFile = new File(xmlPath)
        if (!xmlFile.exists()) {
            return result
        }

        Document document = parseXmlDocument(xmlFile)
        if (document == null) {
            return result
        }

        def testcases = document.getElementsByTagName('testcase')
        for (int index = 0; index < testcases.length; index++) {
            Element testcase = (Element) testcases.item(index)

            String className = safeValue(testcase.getAttribute('classname'))
            String testName = safeValue(testcase.getAttribute('name'))
            long durationMs = toMillisFromSeconds(testcase.getAttribute('time'))

            Element failureNode = firstChildElement(testcase, 'failure')
            Element errorNode = firstChildElement(testcase, 'error')
            Element skippedNode = firstChildElement(testcase, 'skipped')

            boolean failed = failureNode != null || errorNode != null
            boolean skipped = skippedNode != null

            String message = ''
            String details = ''

            if (failureNode != null) {
                message = safeValue(failureNode.getAttribute('message'))
                details = safeValue(failureNode.getTextContent())
            } else if (errorNode != null) {
                message = safeValue(errorNode.getAttribute('message'))
                details = safeValue(errorNode.getTextContent())
            } else if (skippedNode != null) {
                message = safeValue(skippedNode.getAttribute('message'))
                details = safeValue(skippedNode.getTextContent())
            }

            result << [
                index      : index + 1,
                name       : buildDisplayName(className, testName),
                shortName  : isBlank(testName) ? buildDisplayName(className, testName) : testName,
                durationMs : durationMs,
                status     : skipped ? 'skipped' : (failed ? 'failed' : 'passed'),
                message    : message,
                details    : details
            ]
        }

        return result
    }

    private Document parseXmlDocument(File xmlFile) {
        try {
            def factory = DocumentBuilderFactory.newInstance()
            factory.setNamespaceAware(false)
            factory.setFeature('http://apache.org/xml/features/disallow-doctype-decl', true)
            factory.setFeature('http://xml.org/sax/features/external-general-entities', false)
            factory.setFeature('http://xml.org/sax/features/external-parameter-entities', false)
            factory.setFeature('http://apache.org/xml/features/nonvalidating/load-external-dtd', false)
            factory.setExpandEntityReferences(false)

            def builder = factory.newDocumentBuilder()
            return builder.parse(xmlFile)
        } catch (Exception ignored) {
            return null
        }
    }

    private Element firstChildElement(Element parent, String tagName) {
        def nodes = parent.getElementsByTagName(tagName)
        if (nodes == null || nodes.length == 0) {
            return null
        }
        return (Element) nodes.item(0)
    }

    private String buildDisplayName(String className, String testName) {
        if (!isBlank(className) && !isBlank(testName)) {
            return className + '/' + testName
        }
        if (!isBlank(testName)) {
            return testName
        }
        return className
    }

    private List<Map> buildFallbackScenarios(List<Map> xmlCases) {
        List<Map> scenarios = []

        xmlCases.eachWithIndex { Map xmlCase, int index ->
            String title = safeValue(xmlCase.shortName)

            Map failedStep = [
                id           : 'step-' + (index + 1) + '-1',
                title        : title,
                status       : safeValue(xmlCase.status),
                timeLabel    : '',
                startLabel   : '',
                endLabel     : '',
                durationMs   : toLong(xmlCase.durationMs),
                durationLabel: formatDurationFull(toLong(xmlCase.durationMs)),
                detailText   : safeValue(xmlCase.details),
                shortError   : extractShortError(xmlCase.message ?: xmlCase.details),
                errorFull    : safeValue(xmlCase.details),
                emoji        : resolveStepEmoji(title)
            ]

            scenarios << [
                id             : 'scenario-' + (index + 1),
                title          : title,
                status         : safeValue(xmlCase.status),
                startLabel     : '',
                endLabel       : '',
                durationMs     : toLong(xmlCase.durationMs),
                durationLabel  : formatDurationFull(toLong(xmlCase.durationMs)),
                steps          : [failedStep],
                errorShort     : extractShortError(xmlCase.message ?: xmlCase.details),
                errorFull      : safeValue(xmlCase.details),
                sidebarSubtitle: extractShortError(xmlCase.message ?: xmlCase.details),
                evidences      : []
            ]
        }

        return scenarios
    }

    private void enrichScenariosWithFallbackData(List<Map> scenarios, List<Map> xmlCases) {
        scenarios.eachWithIndex { Map scenario, int index ->
            if (index >= xmlCases.size()) {
                return
            }

            Map xmlCase = xmlCases[index]

            if (toLong(scenario.durationMs) <= 0L) {
                scenario.durationMs = toLong(xmlCase.durationMs)
                scenario.durationLabel = formatDurationFull(toLong(xmlCase.durationMs))
            }

            if (isBlank(scenario.errorShort)) {
                scenario.errorShort = extractShortError(xmlCase.message ?: xmlCase.details)
            }

            if (isBlank(scenario.errorFull)) {
                scenario.errorFull = safeValue(xmlCase.details)
            }

            if (isBlank(scenario.sidebarSubtitle)) {
                scenario.sidebarSubtitle = scenario.errorShort
            }
        }
    }

    // =========================================================================
    // EXECUTION LOG PARSING
    // =========================================================================

    private List<Map> parseExecutionScenarios(File reportDir) {
        File logFile = findExecutionLog(reportDir)
        if (logFile == null || !logFile.exists()) {
            return []
        }

        List<String> lines = readFileLines(logFile)
        if (lines.isEmpty()) {
            return []
        }

        List<Map> scenarios = []
        Map currentScenario = null
        Map currentStep = null

        Closure finalizeStep = {
            if (currentScenario == null || currentStep == null) {
                return
            }

            if (currentStep.status == 'info' && currentStep.detailText.toLowerCase(Locale.ENGLISH).contains('skipped')) {
                currentStep.status = 'skipped'
            }

            if (currentStep.status == 'pending') {
                currentStep.status = 'skipped'
            }

            currentStep.detailText = normalizeText(currentStep.detailLines)
            currentStep.errorFull = normalizeText(currentStep.errorLines)

            if (isBlank(currentStep.shortError)) {
                currentStep.shortError = extractShortError(currentStep.errorFull ?: currentStep.detailText)
            }

            currentStep.durationLabel = formatDurationFull(toLong(currentStep.durationMs))
            currentStep = null
        }

        Closure finalizeScenario = {
            if (currentScenario == null) {
                return
            }

            if (currentScenario.steps.isEmpty()) {
                currentScenario = null
                return
            }

            currentScenario.status = resolveScenarioStatus(currentScenario.steps)
            currentScenario.errorShort = resolveScenarioErrorShort(currentScenario.steps)
            currentScenario.errorFull = resolveScenarioErrorFull(currentScenario.steps)
            currentScenario.sidebarSubtitle = isBlank(currentScenario.errorShort)
                ? safeValue(currentScenario.title)
                : currentScenario.errorShort
            currentScenario.durationLabel = formatDurationFull(toLong(currentScenario.durationMs))
            scenarios << currentScenario
            currentScenario = null
        }

        lines.each { String rawLine ->
            String line = safeValue(rawLine)
            if (isBlank(line)) {
                return
            }

            String scenarioTitleVerbose = extractScenarioTitleFromVerboseLine(line)
            if (!isBlank(scenarioTitleVerbose)) {
                finalizeStep.call()
                finalizeScenario.call()

                currentScenario = newScenarioMap('scenario-' + (scenarios.size() + 1), scenarioTitleVerbose)
                return
            }

            Map scenarioCompact = parseCompactScenarioLine(line, scenarios.size() + 1)
            if (scenarioCompact != null) {
                finalizeStep.call()
                finalizeScenario.call()

                currentScenario = scenarioCompact
                return
            }

            if (currentScenario == null) {
                return
            }

            if (line.startsWith('Start / End / Elapsed:')) {
                if (currentStep == null) {
                    applyTimingInfo(currentScenario, line)
                } else {
                    applyTimingInfo(currentStep, line)
                }
                return
            }

            Map compactStep = parseCompactStepLine(line, currentScenario.steps.size() + 1)
            if (compactStep != null) {
                finalizeStep.call()
                currentStep = compactStep
                currentScenario.steps << currentStep
                return
            }

            String testStepTitle = extractStepTitleFromVerboseLine(line)
            if (!isBlank(testStepTitle)) {
                if (shouldIgnoreStep(testStepTitle)) {
                    return
                }

                finalizeStep.call()

                currentStep = [
                    id           : currentScenario.id + '-step-' + (currentScenario.steps.size() + 1),
                    title        : testStepTitle,
                    status       : 'pending',
                    timeLabel    : '',
                    startLabel   : '',
                    endLabel     : '',
                    durationMs   : 0L,
                    durationLabel: formatDurationFull(0L),
                    detailLines  : [],
                    errorLines   : [],
                    detailText   : '',
                    errorFull    : '',
                    shortError   : '',
                    emoji        : resolveStepEmoji(testStepTitle)
                ]
                currentScenario.steps << currentStep
                return
            }

            if (currentStep == null) {
                return
            }

            Map event = parseEventLine(line)
            if (event != null) {
                if (isBlank(currentStep.timeLabel)) {
                    currentStep.timeLabel = event.timeLabel
                }

                currentStep.detailLines << safeValue(event.message)

                if (event.status == 'failed') {
                    currentStep.status = 'failed'
                    currentStep.errorLines << safeValue(event.message)
                    currentStep.shortError = extractShortError(event.message)
                } else if (event.status == 'passed') {
                    if (currentStep.status != 'failed') {
                        currentStep.status = 'passed'
                    }
                } else if (event.status == 'skipped') {
                    if (currentStep.status != 'failed' && currentStep.status != 'passed') {
                        currentStep.status = 'skipped'
                    }
                } else {
                    if (currentStep.status == 'pending') {
                        currentStep.status = 'info'
                    }
                }

                return
            }

            currentStep.detailLines << line

            if (looksLikeErrorLine(line)) {
                currentStep.errorLines << line
                if (currentStep.status != 'failed') {
                    currentStep.status = 'failed'
                }
                if (isBlank(currentStep.shortError)) {
                    currentStep.shortError = extractShortError(line)
                }
            }
        }

        finalizeStep.call()
        finalizeScenario.call()

        applySequentialTimingFallback(reportDir, scenarios)
        return scenarios
    }

    private Map newScenarioMap(String id, String title) {
        return [
            id             : id,
            title          : title,
            status         : 'skipped',
            startLabel     : '',
            endLabel       : '',
            durationMs     : 0L,
            durationLabel  : formatDurationFull(0L),
            steps          : [],
            errorShort     : '',
            errorFull      : '',
            sidebarSubtitle: '',
            evidences      : []
        ]
    }

    private String extractScenarioTitleFromVerboseLine(String line) {
        String marker = 'TEST STEP: Start Test Case : SCENARIO '
        if (!line.contains(marker)) {
            return ''
        }

        String title = line.substring(line.indexOf(marker) + marker.length()).trim()
        return cleanupScenarioTitle(title)
    }

    private Map parseCompactScenarioLine(String line, int scenarioIndex) {
        def matcher = (line =~ /^SCENARIO\s+(.+?)\s*\(([^)]*)\)$/)
        if (!matcher.find()) {
            return null
        }

        String title = cleanupScenarioTitle(safeValue(matcher.group(1)))
        long durationMs = toMillisFromCompactSeconds(matcher.group(2))

        return [
            id             : 'scenario-' + scenarioIndex,
            title          : title,
            status         : 'skipped',
            startLabel     : '',
            endLabel       : '',
            durationMs     : durationMs,
            durationLabel  : formatDurationFull(durationMs),
            steps          : [],
            errorShort     : '',
            errorFull      : '',
            sidebarSubtitle: '',
            evidences      : []
        ]
    }

    private Map parseCompactStepLine(String line, int stepIndex) {
        def matcher = (line =~ /^\d+\s*-\s*(.+?)\s*\(([^)]*)\)$/)
        if (!matcher.find()) {
            return null
        }

        String stepTitle = safeValue(matcher.group(1))
        long durationMs = toMillisFromCompactSeconds(matcher.group(2))

        return [
            id           : 'step-' + stepIndex,
            title        : stepTitle,
            status       : inferStatusFromCompactStepTitle(stepTitle),
            timeLabel    : '',
            startLabel   : '',
            endLabel     : '',
            durationMs   : durationMs,
            durationLabel: formatDurationFull(durationMs),
            detailLines  : [],
            errorLines   : [],
            detailText   : '',
            errorFull    : '',
            shortError   : '',
            emoji        : resolveStepEmoji(stepTitle)
        ]
    }

    private String extractStepTitleFromVerboseLine(String line) {
        String marker = 'TEST STEP: '
        if (!line.contains(marker)) {
            return ''
        }

        String value = line.substring(line.indexOf(marker) + marker.length()).trim()
        return safeValue(value)
    }

    private String inferStatusFromCompactStepTitle(String title) {
        String lower = safeValue(title).toLowerCase(Locale.ENGLISH)

        if (lower.contains('failed')) {
            return 'failed'
        }
        if (lower.contains('passed')) {
            return 'passed'
        }
        if (lower.contains('skipped')) {
            return 'skipped'
        }

        return 'info'
    }

    private void applyTimingInfo(Map target, String timingLine) {
        def matcher = (timingLine =~ /^Start \/ End \/ Elapsed:\s*(.*?)\s*\/\s*(.*?)\s*\/\s*(.*)$/)
        if (!matcher.find()) {
            return
        }

        String rawStart = safeValue(matcher.group(1))
        String rawEnd = safeValue(matcher.group(2))
        String rawElapsed = safeValue(matcher.group(3))

        if (!isBlank(rawStart)) {
            target.startLabel = formatTimeFromAny(rawStart)
        }
        if (!isBlank(rawEnd)) {
            target.endLabel = formatTimeFromAny(rawEnd)
        }

        long durationMs = toMillisFromElapsed(rawElapsed)
        if (durationMs > 0L) {
            target.durationMs = durationMs
            target.durationLabel = formatDurationFull(durationMs)
        }
    }

    private Map parseEventLine(String line) {
        def matcher = (line =~ /^(\d{2}:\d{2}:\d{2}\.\d{3})\s+([A-Z]+)\s+(.*)$/)
        if (!matcher.find()) {
            return null
        }

        String rawStatus = safeValue(matcher.group(2)).toUpperCase(Locale.ENGLISH)
        String message = safeValue(matcher.group(3))

        return [
            timeLabel: formatTimeFromClock(matcher.group(1)),
            status   : normalizeEventStatus(rawStatus),
            message  : message
        ]
    }

    private String normalizeEventStatus(String rawStatus) {
        if (rawStatus == 'PASSED') {
            return 'passed'
        }
        if (rawStatus == 'FAILED' || rawStatus == 'ERROR') {
            return 'failed'
        }
        if (rawStatus == 'SKIPPED') {
            return 'skipped'
        }
        return 'info'
    }

    private boolean shouldIgnoreStep(String title) {
        String lower = safeValue(title).toLowerCase(Locale.ENGLISH)

        boolean ignored = false
        ignored = ignored || lower.startsWith('start listener action')
        ignored = ignored || lower.startsWith('glue')
        ignored = ignored || lower.startsWith('runfeaturefile')
        ignored = ignored || lower.startsWith('exportkatalonreports')
        ignored = ignored || lower.startsWith('sampleaftertestcase')
        ignored = ignored || lower.startsWith('video')
        ignored = ignored || lower.startsWith('beforetestcase')
        ignored = ignored || lower.startsWith('start test case : scenario')

        return ignored
    }

    // =========================================================================
    // STEP NORMALIZATION
    // =========================================================================

    private void normalizeScenarioSteps(List<Map> scenarios) {
        scenarios.each { Map scenario ->
            List<Map> narrativeSteps = extractNarrativeSteps(safeValue(scenario.errorFull))
            if (narrativeSteps.size() > scenario.steps.size()) {
                Map failedOriginal = scenario.steps.find { Map item -> safeValue(item.status) == 'failed' }

                narrativeSteps.eachWithIndex { Map item, int idx ->
                    item.id = scenario.id + '-step-' + (idx + 1)
                    item.emoji = resolveStepEmoji(item.title)
                    item.durationMs = 0L
                    item.durationLabel = formatDurationFull(0L)
                    item.timeLabel = ''
                    item.startLabel = ''
                    item.endLabel = ''
                    item.detailText = item.title
                    item.errorFull = ''
                    item.shortError = ''

                    if (safeValue(item.status) == 'failed') {
                        item.shortError = safeValue(scenario.errorShort)
                        item.errorFull = safeValue(scenario.errorFull)
                        if (isBlank(item.shortError) && failedOriginal != null) {
                            item.shortError = safeValue(failedOriginal.shortError)
                        }
                        if (isBlank(item.errorFull) && failedOriginal != null) {
                            item.errorFull = safeValue(failedOriginal.errorFull)
                        }
                    }
                }

                scenario.steps = narrativeSteps
            }

            scenario.steps.eachWithIndex { Map step, int index ->
                step.id = isBlank(step.id) ? (scenario.id + '-step-' + (index + 1)) : step.id
                step.title = cleanupStepTitle(step.title)
                step.emoji = resolveStepEmoji(step.title)
                step.durationMs = toLong(step.durationMs)
                step.durationLabel = formatDurationFull(toLong(step.durationMs))
                step.timeLabel = safeValue(step.timeLabel)
                step.shortError = safeValue(step.shortError)
                step.errorFull = safeValue(step.errorFull)
                step.detailText = safeValue(step.detailText)

                if (safeValue(step.status) == 'failed' && isBlank(step.shortError)) {
                    step.shortError = extractShortError(step.errorFull ?: step.detailText)
                }
            }

            scenario.status = resolveScenarioStatus(scenario.steps)
            scenario.errorShort = resolveScenarioErrorShort(scenario.steps)
            scenario.errorFull = resolveScenarioErrorFull(scenario.steps)
            scenario.sidebarSubtitle = isBlank(scenario.errorShort) ? safeValue(scenario.title) : scenario.errorShort
        }
    }

    private List<Map> extractNarrativeSteps(String source) {
        List<Map> steps = []
        if (isBlank(source)) {
            return steps
        }

        source.readLines().each { String raw ->
            String line = safeValue(raw)
            if (isBlank(line)) {
                return
            }

            String lower = line.toLowerCase(Locale.ENGLISH)
            if (!(lower.endsWith('passed') || lower.endsWith('failed') || lower.endsWith('skipped'))) {
                return
            }

            String status = ''
            if (lower.endsWith('passed')) {
                status = 'passed'
            } else if (lower.endsWith('failed')) {
                status = 'failed'
            } else if (lower.endsWith('skipped')) {
                status = 'skipped'
            }

            String base = line.substring(0, line.length() - status.length()).trim()
            base = base.replaceAll(/[.]+$/, '').trim()
            if (isBlank(base)) {
                return
            }

            boolean looksLikeGherkin = false
            String baseLower = base.toLowerCase(Locale.ENGLISH)
            looksLikeGherkin = looksLikeGherkin || baseLower.startsWith('given ')
            looksLikeGherkin = looksLikeGherkin || baseLower.startsWith('when ')
            looksLikeGherkin = looksLikeGherkin || baseLower.startsWith('then ')
            looksLikeGherkin = looksLikeGherkin || baseLower.startsWith('and ')

            if (!looksLikeGherkin) {
                return
            }

            steps << [
                title : cleanupStepTitle(base),
                status: status
            ]
        }

        return steps
    }

    private String cleanupScenarioTitle(String value) {
        String text = safeValue(value)
        text = text.replaceAll(/\s+\(\d+[.,]\d+s\)$/, '').trim()
        return text
    }

    private String cleanupStepTitle(String value) {
        String text = safeValue(value)
        text = text.replaceAll(/\s+\(\d+[.,]\d+s\)$/, '').trim()
        text = text.replaceAll(/[.]{2,}$/, '').trim()
        return text
    }

    private String resolveScenarioStatus(List<Map> steps) {
        boolean hasFailed = steps.any { Map item -> safeValue(item.status) == 'failed' }
        if (hasFailed) {
            return 'failed'
        }

        boolean hasPassed = steps.any { Map item -> safeValue(item.status) == 'passed' }
        if (hasPassed) {
            return 'passed'
        }

        boolean hasInfo = steps.any { Map item -> safeValue(item.status) == 'info' }
        if (hasInfo) {
            return 'info'
        }

        return 'skipped'
    }

    private String resolveScenarioErrorShort(List<Map> steps) {
        Map failedStep = steps.find { Map item -> safeValue(item.status) == 'failed' }
        if (failedStep == null) {
            return ''
        }

        return extractShortError(failedStep.shortError ?: failedStep.errorFull ?: failedStep.detailText)
    }

    private String resolveScenarioErrorFull(List<Map> steps) {
        Map failedStep = steps.find { Map item -> safeValue(item.status) == 'failed' }
        if (failedStep == null) {
            return ''
        }

        return safeValue(failedStep.errorFull ?: failedStep.detailText)
    }

    // =========================================================================
    // TIMING / DURATION
    // =========================================================================

    private void applySequentialTimingFallback(File reportDir, List<Map> scenarios) {
        if (scenarios.isEmpty()) {
            return
        }

        long totalDurationMs = 0L
        scenarios.each { Map item ->
            if (toLong(item.durationMs) <= 0L) {
                item.durationMs = sumStepDurations(item.steps)
            }
            totalDurationMs += toLong(item.durationMs)
        }

        Date suiteEnd = new Date(reportDir.lastModified())
        Date suiteStart = new Date(suiteEnd.time - totalDurationMs)

        long cursor = suiteStart.time
        scenarios.each { Map item ->
            long scenarioDuration = toLong(item.durationMs)

            if (isBlank(item.startLabel)) {
                item.startLabel = formatTimeOnly(new Date(cursor))
            }
            if (isBlank(item.endLabel)) {
                item.endLabel = formatTimeOnly(new Date(cursor + scenarioDuration))
            }

            item.durationLabel = formatDurationFull(scenarioDuration)
            cursor += scenarioDuration
        }
    }

    private long sumStepDurations(List<Map> steps) {
        long value = 0L
        steps.each { Map item ->
            value += toLong(item.durationMs)
        }
        return value
    }

    private long toMillisFromElapsed(String rawValue) {
        String raw = safeValue(rawValue)
        if (isBlank(raw)) {
            return 0L
        }

        def matcher = (raw =~ /^(\d{2}):(\d{2}):(\d{2})\.(\d{3})$/)
        if (matcher.find()) {
            long hours = matcher.group(1) as long
            long minutes = matcher.group(2) as long
            long seconds = matcher.group(3) as long
            long millis = matcher.group(4) as long
            return (((hours * 60L + minutes) * 60L) + seconds) * 1000L + millis
        }

        return toMillisFromCompactSeconds(raw)
    }

    private long toMillisFromCompactSeconds(String rawValue) {
        String raw = safeValue(rawValue).replace(',', '.').replace('s', '').trim()
        if (isBlank(raw)) {
            return 0L
        }

        try {
            double seconds = Double.parseDouble(raw)
            return Math.round(seconds * 1000d)
        } catch (Exception ignored) {
            return 0L
        }
    }

    private long toMillisFromSeconds(String rawValue) {
        return toMillisFromCompactSeconds(rawValue)
    }

    private String formatDurationFull(long durationMs) {
        long totalSeconds = durationMs > 0L ? Math.round(durationMs / 1000d) : 0L
        long hours = (long) Math.floor(totalSeconds / 3600L)
        long minutes = (long) Math.floor((totalSeconds % 3600L) / 60L)
        long seconds = totalSeconds % 60L

        return String.format(Locale.ENGLISH, '%02dh %02dm %02ds', hours, minutes, seconds)
    }

    private String formatDisplayDate(Date value) {
        return new SimpleDateFormat('MM.dd.yyyy hh:mm:ss a', Locale.ENGLISH).format(value)
    }

    private String formatTimeOnly(Date value) {
        return new SimpleDateFormat('HH:mm:ss', Locale.ENGLISH).format(value)
    }

    private String formatTimeFromAny(String raw) {
        String text = safeValue(raw)

        List<String> formats = [
            'yyyy-MM-dd HH:mm:ss.SSS',
            'yyyy-MM-dd HH:mm:ss',
            'dd-MM-yyyy HH:mm:ss',
            'MM.dd.yyyy hh:mm:ss a'
        ]

        for (String pattern : formats) {
            try {
                Date value = new SimpleDateFormat(pattern, Locale.ENGLISH).parse(text)
                return formatTimeOnly(value)
            } catch (Exception ignored) {
            }
        }

        return text
    }

    private String formatTimeFromClock(String raw) {
        try {
            Date value = new SimpleDateFormat('HH:mm:ss.SSS', Locale.ENGLISH).parse(safeValue(raw))
            return formatTimeOnly(value)
        } catch (Exception ignored) {
            return safeValue(raw)
        }
    }

    // =========================================================================
    // ERROR / EVIDENCE
    // =========================================================================

    private String extractShortError(def source) {
        String text = safeValue(source)
        if (isBlank(text)) {
            return ''
        }

        List<String> lines = text.readLines().collect { safeValue(it) }.findAll { !isBlank(it) }
        if (lines.isEmpty()) {
            return ''
        }

        String preferred = lines.find { String line ->
            String lower = line.toLowerCase(Locale.ENGLISH)
            boolean match = false
            match = match || lower.contains('unable to ')
            match = match || lower.contains('element click intercepted')
            match = match || lower.contains('object repository')
            match = match || lower.contains('no such element')
            match = match || lower.contains('timeout')
            return match
        }

        String value = safeValue(preferred ?: lines.first())
        value = value.replace('com.kms.katalon.core.exception.StepFailedException:', '').trim()
        value = value.replace('org.codehaus.groovy.runtime.InvokerInvocationException:', '').trim()

        int rootCauseIndex = value.indexOf('(Root cause:')
        if (rootCauseIndex > 0) {
            value = value.substring(0, rootCauseIndex).trim()
        }

        int stackIndex = value.indexOf(' at com.kms')
        if (stackIndex > 0) {
            value = value.substring(0, stackIndex).trim()
        }

        value = value.replaceAll(/\s+/, ' ').trim()

        if (value.length() > 130) {
            return value.substring(0, 127) + '...'
        }

        return value
    }

    private boolean looksLikeErrorLine(String line) {
        String lower = safeValue(line).toLowerCase(Locale.ENGLISH)

        boolean match = false
        match = match || lower.startsWith('at ')
        match = match || lower.startsWith('caused by:')
        match = match || lower.contains('exception')
        match = match || lower.contains('root cause')
        match = match || lower.contains('webdriver')
        match = match || lower.contains('session info')
        match = match || lower.contains('build info')
        match = match || lower.contains('driver info')
        match = match || lower.contains('capabilities')
        match = match || lower.contains('unable to ')
        match = match || lower.contains('stacktrace')

        return match
    }

    private void attachEvidenceToFailedScenarios(File reportDir, List<Map> scenarios) {
        List<File> images = collectEvidenceImages(reportDir)
        if (images.isEmpty()) {
            return
        }

        List<Map> failedScenarios = scenarios.findAll { Map item -> safeValue(item.status) == 'failed' }
        if (failedScenarios.isEmpty()) {
            return
        }

        int scenarioIndex = 0
        images.each { File image ->
            Map scenario = failedScenarios[scenarioIndex]

            scenario.evidences << [
                name      : image.name,
                filePath  : image.absolutePath,
                openUrl   : image.toURI().toString(),
                previewUrl: image.toURI().toString()
            ]

            if (scenarioIndex < failedScenarios.size() - 1) {
                scenarioIndex++
            }
        }
    }

    private List<File> collectEvidenceImages(File reportDir) {
        List<File> images = []

        reportDir.eachFileRecurse { File file ->
            if (!file.isFile()) {
                return
            }

            String lower = file.name.toLowerCase(Locale.ENGLISH)
            boolean isImage = false
            isImage = isImage || lower.endsWith('.png')
            isImage = isImage || lower.endsWith('.jpg')
            isImage = isImage || lower.endsWith('.jpeg')
            isImage = isImage || lower.endsWith('.webp')

            if (isImage) {
                images << file
            }
        }

        images.sort { File left, File right ->
            left.lastModified() <=> right.lastModified()
        }

        return images
    }

    // =========================================================================
    // FILE / TEXT HELPERS
    // =========================================================================

    private File findExecutionLog(File reportDir) {
        List<File> candidates = []

        reportDir.eachFileRecurse { File file ->
            if (!file.isFile()) {
                return
            }

            String lower = file.name.toLowerCase(Locale.ENGLISH)
            if (lower.startsWith('execution') && lower.endsWith('.log')) {
                candidates << file
            }
        }

        if (candidates.isEmpty()) {
            return null
        }

        candidates.sort { File left, File right ->
            right.lastModified() <=> left.lastModified()
        }

        return candidates.first()
    }

    private List<String> readFileLines(File file) {
        try {
            return file.readLines(StandardCharsets.UTF_8.name())
        } catch (Exception ignored) {
            try {
                return file.readLines()
            } catch (Exception ignoredAgain) {
                return []
            }
        }
    }

    private String normalizeText(List lines) {
        if (lines == null || lines.isEmpty()) {
            return ''
        }

        return lines.collect { safeValue(it) }.join('\n').trim()
    }

    private String resolveAssetUrl(File startDir, String relativePath) {
        File assetFile = resolveProjectFile(startDir, relativePath)
        if (assetFile == null || !assetFile.exists()) {
            return ''
        }
        return assetFile.toURI().toString()
    }

    private File resolveProjectFile(File startDir, String relativePath) {
        File current = startDir
        while (current != null) {
            File candidate = new File(current, relativePath)
            if (candidate.exists()) {
                return candidate
            }
            current = current.parentFile
        }
        return null
    }

    // =========================================================================
    // GENERIC HELPERS
    // =========================================================================

    private String resolveStepEmoji(String title) {
        String lower = safeValue(title).toLowerCase(Locale.ENGLISH)

        if (lower.contains('wait') || lower.contains('search') || lower.contains('find')) {
            return '🔎'
        }
        if (lower.contains('click') || lower.contains('select') || lower.contains('open')) {
            return '🖱️'
        }
        if (lower.contains('fill') || lower.contains('type') || lower.contains('input')) {
            return '⌨️'
        }
        if (lower.contains('import') || lower.contains('upload')) {
            return '📥'
        }
        if (lower.contains('save')) {
            return '💾'
        }
        if (lower.contains('reload') || lower.contains('refresh')) {
            return '🔄'
        }
        if (lower.contains('delete') || lower.contains('remove')) {
            return '🗑️'
        }
        if (lower.contains('validate') || lower.contains('assert') || lower.contains('match')) {
            return '✅'
        }
        if (lower.contains('portal') || lower.contains('page') || lower.contains('home')) {
            return '🌐'
        }
        return '📝'
    }

    private long toLong(def value) {
        try {
            return (value ?: 0L) as long
        } catch (Exception ignored) {
            return 0L
        }
    }

    private String safeValue(def value) {
        return value == null ? '' : String.valueOf(value).trim()
    }

    private boolean isBlank(def value) {
        return safeValue(value).isEmpty()
    }
}









