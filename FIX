import com.kms.katalon.core.util.KeywordUtil

String environment = ''
String scenarioName = ''

try {
	environment = targetEnvironment
} catch (Exception ignored) {
	environment = ''
}

try {
	scenarioName = exportScenarioName
} catch (Exception ignored) {
	scenarioName = ''
}

environment = environment?.trim()?.toUpperCase()

if (environment == null || environment == '') {
	environment = 'REC'
}

if (environment == 'PROD') {
	environment = 'PRD'
}

if (scenarioName == null || scenarioName.trim() == '') {
	scenarioName = 'ModuleDesResponsabilite_ValidateDimensions'
}

String exportLabel = environment + '_' + scenarioName

KeywordUtil.logInfo(
	'Resolved export environment: ' + environment
)

KeywordUtil.logInfo(
	'Resolved export scenario name: ' + scenarioName
)

KeywordUtil.logInfo(
	'Resolved export file label: ' + exportLabel
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Export expanded table\n' +
	'Environment: ' + environment + '\n' +
	'Export file: ' + exportLabel
)

CustomKeywords.'commands.ExportFile.exportFromOutilsToNo'(
	exportLabel
)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	exportLabel + '.png'
)
