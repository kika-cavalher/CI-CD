	private String buildAmountComparisonReport(
			String validationResult,
			File file,
			String amountHeader,
			String baseAmountHeader,
			String tolerancePercentText,
			Integer maxPerFile,
			Integer maxGeneral) {

		List<File> files = file == null ? [] : [file]
		BigDecimal tolerancePercent = parseDecimalOrDefault(
				tolerancePercentText,
				new BigDecimal('3')
				)

		List<Map> parsedRows = parseAmountComparisonRows(
				validationResult,
				files,
				tolerancePercent
				)

		List<Map> rejectedRows = parsedRows.findAll { Map row ->
			Boolean.FALSE.equals(row.accepted)
		}

		List<Map> acceptedRows = parsedRows.findAll { Map row ->
			Boolean.TRUE.equals(row.accepted)
		}

		Boolean shouldFail = shouldFailAmountComparison(
				validationResult,
				file,
				tolerancePercentText
				)

		List<String> lines = []

		lines.add('Headers compared: ' + amountHeader + ' | ' + baseAmountHeader)
		lines.add('Accepted difference: <= ' + formatDecimal(tolerancePercent) + '%')
		lines.add('Checked files: ' + files.size())
		lines.add('')

		if (file != null) {
			if (shouldFail) {
				if (!rejectedRows.isEmpty()) {
					lines.add(
							'File 1: FAILED - ' + file.getName() +
							' - ' + rejectedRows.size() +
							' wrong row(s) above tolerance.'
							)
				} else {
					lines.add(
							'File 1: FAILED - ' + file.getName() +
							' - Amount comparison returned an error.'
							)
				}
			} else if (!acceptedRows.isEmpty()) {
				lines.add(
						'File 1: PASSED WITH ACCEPTED DIFFERENCES - ' +
						file.getName() + ' - ' +
						acceptedRows.size() +
						' difference(s) within tolerance.'
						)
			} else {
				lines.add(
						'File 1: PASSED - ' + file.getName() +
						' - No amount errors returned.'
						)
			}
		}

		if (!hasValidationFailure(validationResult)) {
			lines.add('')
			lines.add('Result: all amount values are equal.')
			return lines.join('\n')
		}

		if (parsedRows.isEmpty()) {
			lines.add('')
			lines.add('Result: failed.')
			lines.add(
					'Reason: the keyword returned an error, ' +
					'but no row-level values were available.'
					)
			lines.add('')
			lines.add('Raw errors:')

			for (String error : limitLines(
					extractErrorLines(validationResult),
					maxGeneral)) {

				lines.add('- ' + cleanErrorLineForReport(error, files))
			}

			return lines.join('\n')
		}

		if (!rejectedRows.isEmpty()) {
			lines.add('')
			lines.add('Wrong values:')
			lines.add('')
			lines.add(file == null ? 'Unknown file' : file.getName())
			lines.add(
					'Row | Devise | Montant ccy | Montant base ccy | ' +
					'Difference | Difference % | Reason'
					)
			lines.add('--- | --- | --- | --- | --- | --- | ---')

			for (Map row : rejectedRows.take(maxPerFile)) {
				lines.add(
						tableValue(row.rowNumber) + ' | ' +
						tableValue(row.devise) + ' | ' +
						tableValue(row.amountCcy) + ' | ' +
						tableValue(row.amountBaseCcy) + ' | ' +
						tableValue(row.difference) + ' | ' +
						tableValue(row.differencePercent) + ' | ' +
						tableValue(row.reason)
						)
			}

			if (rejectedRows.size() > maxPerFile) {
				lines.add(
						'... and ' +
						(rejectedRows.size() - maxPerFile) +
						' more wrong row(s) in this file.'
						)
			}
		}

		if (!acceptedRows.isEmpty()) {
			lines.add('')
			lines.add('Accepted differences:')
			lines.add('')
			lines.add(file == null ? 'Unknown file' : file.getName())
			lines.add(
					'Row | Devise | Montant ccy | Montant base ccy | ' +
					'Difference | Difference % | Reason'
					)
			lines.add('--- | --- | --- | --- | --- | --- | ---')

			for (Map row : acceptedRows.take(maxPerFile)) {
				lines.add(
						tableValue(row.rowNumber) + ' | ' +
						tableValue(row.devise) + ' | ' +
						tableValue(row.amountCcy) + ' | ' +
						tableValue(row.amountBaseCcy) + ' | ' +
						tableValue(row.difference) + ' | ' +
						tableValue(row.differencePercent) + ' | ' +
						tableValue(row.reason)
						)
			}

			if (acceptedRows.size() > maxPerFile) {
				lines.add(
						'... and ' +
						(acceptedRows.size() - maxPerFile) +
						' more accepted row(s) in this file.'
						)
			}
		}

		return lines.join('\n')
	}

	private Boolean shouldFailAmountComparison(
			String validationResult,
			File file,
			String tolerancePercentText) {

		if (!hasValidationFailure(validationResult)) {
			return false
		}

		BigDecimal tolerancePercent = parseDecimalOrDefault(
				tolerancePercentText,
				new BigDecimal('3')
				)

		List<File> files = file == null ? [] : [file]
		List<Map> parsedRows = parseAmountComparisonRows(
				validationResult,
				files,
				tolerancePercent
				)

		if (parsedRows.any { Map row ->
					Boolean.FALSE.equals(row.accepted)
				}) {
			return true
		}

		return parsedRows.isEmpty()
	}

	private List<Map> parseAmountComparisonRows(
			String validationResult,
			List<File> files,
			BigDecimal tolerancePercent) {

		List<Map> rows = []
		String text = cleanErrorLineForReport(validationResult, files)
				.replace('\r\n', ' ')
				.replace('\n', ' ')
				.replace('\r', ' ')

		def matcher = text =~ /(?is)(?:^|[\s\-])File\s+'?([^'\s|]+\.xlsx)'?\s+row\s+(\d+)\s+has\s+different\s+amounts\.?\s*(.*?)(?=(?:[\s\-]File\s+'?[^'\s|]+\.xlsx'?\s+row\s+\d+\s+has\s+different\s+amounts)|$)/

		while (matcher.find()) {
			String fileName = matcher.group(1).trim()
			String rowNumber = matcher.group(2).trim()
			String details = matcher.group(3).trim()
			String devise = extractByRegex(details, "Devise\\s*=\\s*'([^']*)'")
			String amountCcy = extractByRegex(details, "Montant ccy\\s*=\\s*'([^']*)'")
			String amountBaseCcy = extractByRegex(details, "Montant base ccy\\s*=\\s*'([^']*)'")
			BigDecimal amountCcyNumber = parseDecimalOrNull(amountCcy)
			BigDecimal amountBaseCcyNumber = parseDecimalOrNull(amountBaseCcy)
			BigDecimal difference = null
			BigDecimal differencePercent = null
			Boolean accepted = false
			String reason = ''

			if (amountCcyNumber == null || amountBaseCcyNumber == null) {
				reason =
						'Cannot calculate difference because one amount is missing or not numeric.'
				accepted = false
			} else {
				difference = amountCcyNumber.subtract(amountBaseCcyNumber).abs()

				if (amountBaseCcyNumber.compareTo(BigDecimal.ZERO) == 0) {
					differencePercent = difference.compareTo(BigDecimal.ZERO) == 0
							? BigDecimal.ZERO
							: new BigDecimal('100')
				} else {
					differencePercent = difference
							.divide(
							amountBaseCcyNumber.abs(),
							10,
							RoundingMode.HALF_UP
							)
							.multiply(new BigDecimal('100'))
				}

				accepted = differencePercent.compareTo(tolerancePercent) <= 0
				reason = accepted
						? 'Accepted within tolerance.'
						: 'Difference is above the accepted tolerance.'
			}

			rows.add([
				fileName         : fileName,
				rowNumber        : rowNumber,
				devise           : devise,
				amountCcy        : amountCcy,
				amountBaseCcy    : amountBaseCcy,
				difference       : difference == null
				? '-'
				: formatDecimal(difference),
				differencePercent: differencePercent == null
				? '-'
				: formatDecimal(differencePercent) + '%',
				accepted         : accepted,
				reason           : reason
			])
		}

		return rows
	}


