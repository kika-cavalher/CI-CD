	private String buildScenarioListItem(Map scenario, boolean selected) {
		String borderClass = selected ? 'scenario-list-item selected' : 'scenario-list-item'
		String shortName = shorten(scenario.name, 42)
		String shortError = shorten(scenario.summary, 55)

		StringBuilder sb = new StringBuilder()
		sb.append('<button type="button" class="')
		sb.append(borderClass)
		sb.append('" data-sid="')
		sb.append(htmlEscape(scenario.id))
		sb.append('" onclick="showScenario(\'')
		sb.append(jsEscape(scenario.id))
		sb.append('\')">')

		sb.append('<div class="scenario-list-main">')
		sb.append('<div class="scenario-list-title">')
		sb.append(htmlEscape(shortName))
		sb.append('</div>')
		sb.append('<div class="scenario-list-summary">')
		sb.append(htmlEscape(shortError))
		sb.append('</div>')
		sb.append('<div class="scenario-list-meta">')
		sb.append(htmlEscape(scenario.startShort))
		sb.append('</div>')
		sb.append('</div>')

		sb.append('<div class="scenario-list-side">')
		sb.append('<span class="status-pill ')
		sb.append(htmlEscape(scenario.status))
		sb.append('">')
		sb.append(htmlEscape(statusLabel(scenario.status)))
		sb.append('</span>')
		sb.append('<div class="scenario-list-duration">')
		sb.append(htmlEscape(scenario.durationLabel))
		sb.append('</div>')
		sb.append('</div>')

		sb.append('</button>')
		return sb.toString()
	}

	private String buildScenarioPanel(Map scenario, Map view, boolean selected) {
		String panelClass = selected ? 'scenario-panel active' : 'scenario-panel'

		String suiteLabel = safeValue(view.suiteName)
		String scenarioName = safeValue(scenario.name)
		String scenarioStatus = safeValue(scenario.status)

		String visualError = firstNonBlank(
				scenario.visualError,
				scenario.errorSummary,
				scenario.errorShort,
				scenario.failureMessage,
				scenario.message,
				scenario.summary
				)

		String fullError = firstNonBlank(
				scenario.fullError,
				scenario.errorDetail,
				scenario.stackTrace,
				scenario.stacktrace,
				scenario.details,
				scenario.errorLog,
				visualError
				)

		String startLabel = firstNonBlank(
				scenario.startLong,
				scenario.startLabel,
				scenario.startClock,
				scenario.startShort,
				'--'
				)

		String endLabel = firstNonBlank(
				scenario.endLong,
				scenario.endLabel,
				scenario.endClock,
				scenario.endShort,
				'--'
				)

		String durationLabel = firstNonBlank(
				scenario.durationLabel,
				'00h 00m 00s'
				)

		Map failedEvidence = null
		List<Map> evidenceList = scenario.evidence instanceof List ? (scenario.evidence as List<Map>) : []

		if (!evidenceList.isEmpty()) {
			failedEvidence = evidenceList.find { Map ev ->
				String name = safeValue(ev.name).toLowerCase(Locale.ENGLISH)
				String href = safeValue(ev.href).toLowerCase(Locale.ENGLISH)
				return name.contains('error') ||
						name.contains('fail') ||
						href.contains('error') ||
						href.contains('fail')
			}

			if (failedEvidence == null) {
				failedEvidence = evidenceList[0]
			}
		}

		String evidenceName = failedEvidence != null ? safeValue(failedEvidence.name) : ''
		String evidenceHref = failedEvidence != null ? safeValue(failedEvidence.href) : ''
		String evidenceImgSrc = failedEvidence != null ? safeValue(failedEvidence.imgSrc) : ''
		boolean evidenceIsImage = failedEvidence != null && Boolean.TRUE.equals(failedEvidence.image)

		StringBuilder sb = new StringBuilder()

		sb.append('<section class="')
		sb.append(panelClass)
		sb.append('" id="panel-')
		sb.append(htmlEscape(safeValue(scenario.id)))
		sb.append('">')

		sb.append('<div class="scenario-header">')
		sb.append('<div class="scenario-title">')
		sb.append(htmlEscape(scenarioName))
		sb.append('</div>')

		sb.append('<div class="scenario-meta-row">')
		sb.append(buildMetaChip('Suite', suiteLabel, 'plain'))
		sb.append(buildMetaChip('Status', statusLabel(scenarioStatus), scenarioStatus))
		sb.append(buildMetaChip('Start', startLabel, 'accent'))
		sb.append(buildMetaChip('End', endLabel, 'accent'))
		sb.append(buildMetaChip('Duration', durationLabel, 'accent'))
		sb.append('</div>')
		sb.append('</div>')

		sb.append('<div class="section-title">Steps</div>')
		sb.append('<div class="steps-table">')
		sb.append('<div class="steps-head">')
		sb.append('<div class="col-status">STATUS</div>')
		sb.append('<div class="col-time">TIMESTAMP</div>')
		sb.append('<div class="col-detail">DETAILS</div>')
		sb.append('</div>')

		List<Map> steps = scenario.steps instanceof List ? (scenario.steps as List<Map>) : []

		if (steps.isEmpty()) {
			sb.append('<div class="step-row empty">')
			sb.append('<div class="col-status"></div>')
			sb.append('<div class="col-time"></div>')
			sb.append('<div class="col-detail">No step details available.</div>')
			sb.append('</div>')
		} else {
			steps.each { Map step ->
				sb.append(buildStepRow(step))
			}
		}

		sb.append('</div>')

		if ('failed'.equalsIgnoreCase(scenarioStatus)) {
			sb.append('<div class="error-block">')
			sb.append('<div class="error-title">Visual Error Log</div>')
			sb.append('<div class="error-summary">')
			sb.append(htmlEscape(visualError))
			sb.append('</div>')

			if (!safeValue(fullError).isEmpty()) {
				sb.append('<details class="details-box">')
				sb.append('<summary>🔎 View full error</summary>')
				sb.append('<pre>')
				sb.append(htmlEscape(fullError))
				sb.append('</pre>')
				sb.append('</details>')
			}

			sb.append('</div>')

			sb.append('<div class="evidence-block">')
			sb.append('<div class="evidence-title">Evidence</div>')

			if (failedEvidence != null) {
				sb.append('<details class="evidence-item">')
				sb.append('<summary>🖼 ')
				sb.append(htmlEscape(evidenceName.isEmpty() ? 'Open failed evidence' : evidenceName))
				sb.append('</summary>')

				if (!evidenceHref.isEmpty()) {
					sb.append('<div class="evidence-links">')
					sb.append('<a href="')
					sb.append(htmlEscape(evidenceHref))
					sb.append('" target="_blank" rel="noopener noreferrer">🔎 Open evidence</a>')
					sb.append('</div>')
				}

				if (evidenceIsImage && !evidenceImgSrc.isEmpty()) {
					sb.append('<img class="evidence-image" src="')
					sb.append(htmlEscape(evidenceImgSrc))
					sb.append('" alt="Evidence">')
				}

				sb.append('</details>')
			} else {
				sb.append('<div class="evidence-empty">No failed evidence was found for this scenario.</div>')
			}

			sb.append('</div>')
		}

		sb.append('</section>')
		return sb.toString()
	}

	private String buildStepRow(Map step) {
		StringBuilder sb = new StringBuilder()

		sb.append('<div class="step-row">')
		sb.append('<div class="col-status">')
		sb.append('<span class="status-pill ')
		sb.append(htmlEscape(step.status))
		sb.append('">')
		sb.append(htmlEscape(statusLabel(step.status)))
		sb.append('</span>')
		sb.append('</div>')

		sb.append('<div class="col-time">')
		sb.append(htmlEscape(pickFirst(step.timestamp, '--')))
		sb.append('</div>')

		sb.append('<div class="col-detail">')
		sb.append('<span class="step-icon">')
		sb.append(htmlEscape(step.icon))
		sb.append('</span> ')
		sb.append(htmlEscape(step.detail))
		sb.append('</div>')
		sb.append('</div>')

		return sb.toString()
	}

	private String buildMetaChip(String label, String value, String type) {
		StringBuilder sb = new StringBuilder()
		sb.append('<div class="meta-chip ')
		sb.append(htmlEscape(type))
		sb.append('">')
		sb.append('<span class="meta-label">')
		sb.append(htmlEscape(label))
		sb.append(':</span> ')
		sb.append('<span class="meta-value">')
		sb.append(htmlEscape(value))
		sb.append('</span>')
		sb.append('</div>')
		return sb.toString()
	}

	private String buildChartsSidebar(Map view) {
		StringBuilder sb = new StringBuilder()
		sb.append('<div class="chart-side-wrap">')
		sb.append('<div class="chart-side-title">Execution Status</div>')
		sb.append('<div class="legend-list">')
		sb.append(buildLegendLine('Passed', STATUS_PASS, view.passedCount))
		sb.append(buildLegendLine('Failed', STATUS_FAIL, view.failedCount))
		sb.append(buildLegendLine('Skipped', STATUS_SKIP, view.skippedCount))
		sb.append('</div>')
		sb.append('</div>')
		return sb.toString()
	}

	private String buildChartsPanel(Map view) {
		double failPercent = percent(view.failedCount as int, view.totalCount as int)
		double passPercent = percent(view.passedCount as int, view.totalCount as int)
		double skipPercent = percent(view.skippedCount as int, view.totalCount as int)

