package pageObject

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows


class RetournementDesInternesKeywords {


	// ======================================================
	// CONFIG
	// ======================================================

	private static final String IMAGE_GROUP =
		'RetournementDesInternes'

	private static final String OBJECT_GROUP =
		'retournementDesInternes'

	private static final String CLOSE_FILTER_OBJECT =
		'closeFilterButton'

	private static final String CLOSE_FILTER_IMAGE =
		'closeFilter'

	private static final Integer DEFAULT_TIMEOUT_SECONDS = 5


	// ======================================================
	// CLOSE FILTER
	// ======================================================

	@Keyword
	void closeFilter(
			Integer timeoutSeconds = DEFAULT_TIMEOUT_SECONDS
	) {

		Integer safeTimeout =
			timeoutSeconds == null ||
			timeoutSeconds <= 0
			? DEFAULT_TIMEOUT_SECONDS
			: timeoutSeconds


		KeywordUtil.logInfo(
			'Close Exclusion Trades default filter.\n' +
			'Strategy: Windows object > image fallback'
		)


		// ==================================================
		// OBJECT FIRST
		// ==================================================

		try {

			WindowsTestObject closeFilterButton =
				CustomKeywords.
				'commands.WindowsObjectLoader.getObject'(
					OBJECT_GROUP,
					CLOSE_FILTER_OBJECT
				)


			if (
				closeFilterButton != null &&
				Windows.verifyElementPresent(
					closeFilterButton,
					safeTimeout,
					FailureHandling.OPTIONAL
				)
			) {

				Windows.click(
					closeFilterButton,
					FailureHandling.OPTIONAL
				)

				KeywordUtil.logInfo(
					'Exclusion Trades filter closed using Windows object.'
				)

				Windows.delay(1)

				return
			}


			KeywordUtil.logInfo(
				'Close filter Windows object was not found. ' +
				'Trying image fallback.'
			)

		} catch (Throwable objectError) {

			KeywordUtil.logInfo(
				'Windows object strategy failed.\n' +
				'Reason: ' +
				objectError.getMessage() +
				'\nTrying image fallback.'
			)
		}


		// ==================================================
		// IMAGE FALLBACK
		// ==================================================

		try {

			String closeFilterImage =
				CustomKeywords.
				'commands.ImageLoader.getImage'(
					IMAGE_GROUP,
					CLOSE_FILTER_IMAGE
				)


			if (
				closeFilterImage != null &&
				!closeFilterImage.trim().isEmpty()
			) {

				Integer elapsedSeconds = 0

				while (
					elapsedSeconds < safeTimeout
				) {

					try {

						def found =
							WindowsImageKeywords.findImage(
								closeFilterImage
							)

						if (
							found != null &&
							found != false
						) {

							WindowsImageKeywords.clickImage(
								closeFilterImage
							)

							KeywordUtil.logInfo(
								'Exclusion Trades filter closed using image fallback.'
							)

							Windows.delay(1)

							return
						}

					} catch (Throwable ignored) {
					}


					Windows.delay(1)

					elapsedSeconds++
				}
			}

		} catch (Throwable imageError) {

			KeywordUtil.logInfo(
				'Image fallback failed.\n' +
				'Reason: ' +
				imageError.getMessage()
			)
		}


		// ==================================================
		// FAILURE WITHOUT STOPPING NEXT STEP
		// ==================================================

		KeywordUtil.markFailed(
			'Unable to close Exclusion Trades default filter.\n' +
			'Windows object not found/clickable and image fallback failed.'
		)
	}
}
