	@Keyword
	Map validateSyntheseRecPrdExports(
			String recFilePath,
			String prdFilePath) {

		File recFile =
				validateSyntheseExcelFile(
				recFilePath,
				'REC Synthèse export'
				)

		File prdFile =
				validateSyntheseExcelFile(
				prdFilePath,
				'PRD Synthèse export'
				)

		Map recData =
				readSyntheseWorkbookData(
				recFile,
				'REC'
				)

		Map prdData =
				readSyntheseWorkbookData(
				prdFile,
				'PRD'
				)

		List<String> errors = []
		List<String> passedDetails = []

		appendSyntheseIntegerComparison(
				'Number of table headers',
				recData.headerCount as Integer,
				prdData.headerCount as Integer,
				errors,
				passedDetails
				)

		appendSyntheseHeaderComparison(
				recData.headers as List<String>,
				prdData.headers as List<String>,
				errors,
				passedDetails
				)

		appendSyntheseIntegerComparison(
				'Number of data rows',
				recData.dataRows as Integer,
				prdData.dataRows as Integer,
				errors,
				passedDetails
				)

		appendSyntheseIntegerComparison(
				'Numeric data count',
				recData.numericValueCount as Integer,
				prdData.numericValueCount as Integer,
				errors,
				passedDetails
				)

		appendSyntheseDecimalComparison(
				'Numeric data checksum',
				recData.numericChecksum as BigDecimal,
				prdData.numericChecksum as BigDecimal,
				errors,
				passedDetails
				)

		Map result = [
			success                : errors.isEmpty(),
			recFileName            : recFile.name,
			prdFileName            : prdFile.name,
			recFilePath            : recFile.absolutePath,
			prdFilePath            : prdFile.absolutePath,
			recHeaders             : recData.headerCount,
			prdHeaders             : prdData.headerCount,
			recRows                : recData.dataRows,
			prdRows                : prdData.dataRows,
			recNumericValueCount   : recData.numericValueCount,
			prdNumericValueCount   : prdData.numericValueCount,
			recNumericChecksum     : recData.numericChecksum,
			prdNumericChecksum     : prdData.numericChecksum,
			passedDetails          : passedDetails.join('\n'),
			errors                 : errors.join('\n')
		]

		if (!errors.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Synthèse REC x PRD export validation failed.\n\n' +
					result.errors
					)

			return result
		}

		KeywordUtil.logInfo(
				'[PASS] Synthèse REC x PRD export validation completed.\n' +
				result.passedDetails
				)

		return result
	}

	private Map readSyntheseWorkbookData(
			File file,
			String environment) {

		FileInputStream input = null
		Workbook workbook = null

		try {
			input = new FileInputStream(file)
			workbook = WorkbookFactory.create(input)

			if (workbook.numberOfSheets <= 0) {
				throw new IllegalStateException(
				environment +
				' Synthèse export does not contain worksheets.'
				)
			}

			Sheet sheet = workbook.getSheetAt(0)
			DataFormatter formatter = new DataFormatter()

			FormulaEvaluator evaluator =
					workbook
					.creationHelper
					.createFormulaEvaluator()

			Integer headerRowIndex =
					findSyntheseHeaderRowIndex(
					sheet,
					formatter,
					evaluator
					)

			Row headerRow = sheet.getRow(headerRowIndex)

			List<String> headers =
					readSyntheseRowValues(
					headerRow,
					formatter,
					evaluator
					)

			Integer dataRows = 0
			Integer numericValueCount = 0
			BigDecimal numericChecksum = BigDecimal.ZERO

			for (Integer rowIndex = headerRowIndex + 1;
					rowIndex <= sheet.lastRowNum;
					rowIndex++) {

				Row row = sheet.getRow(rowIndex)

				if (row == null) {
					continue
				}

				List<String> rowValues =
						readSyntheseRowValues(
						row,
						formatter,
						evaluator
						)

				if (isSyntheseEmptyRow(rowValues)) {
					continue
				}

				dataRows++

				for (Integer columnIndex = 0;
						columnIndex < row.lastCellNum;
						columnIndex++) {

					BigDecimal value =
							readSyntheseNumericValue(
							row.getCell(columnIndex),
							formatter,
							evaluator
							)

					if (value == null) {
						continue
					}

					numericChecksum =
							numericChecksum.add(value)

					numericValueCount++
				}
			}

			return [
				headers           : headers,
				headerCount       : headers.findAll { String header ->

					!safeText(header).isEmpty()
				}.size(),
				dataRows          : dataRows,
				numericValueCount : numericValueCount,
				numericChecksum   : numericChecksum.setScale(
				2,
				RoundingMode.HALF_EVEN
				)
			]
		} finally {
			closeWorkbook(workbook)
			closeInput(input)
		}
	}

	private Integer findSyntheseHeaderRowIndex(
			Sheet sheet,
			DataFormatter formatter,
			FormulaEvaluator evaluator) {

		Integer bestRowIndex = 0
		Integer bestFilledCells = 0
		Integer maxRowIndex =
				Math.min(
				sheet.lastRowNum,
				30
				)

		for (Integer rowIndex = 0;
				rowIndex <= maxRowIndex;
				rowIndex++) {

			Row row = sheet.getRow(rowIndex)

			if (row == null) {
				continue
			}

			List<String> values =
					readSyntheseRowValues(
					row,
					formatter,
					evaluator
					)

			Integer filledCells =
					values.findAll { String value ->

						!safeText(value).isEmpty()
					}.size()

			if (filledCells > bestFilledCells) {
				bestFilledCells = filledCells
				bestRowIndex = rowIndex
			}
		}

		return bestRowIndex
	}

	private List<String> readSyntheseRowValues(
			Row row,
			DataFormatter formatter,
			FormulaEvaluator evaluator) {

		List<String> values = []

		if (row == null ||
				row.lastCellNum < 0) {

			return values
		}

		for (Integer columnIndex = 0;
				columnIndex < row.lastCellNum;
				columnIndex++) {

			Cell cell = row.getCell(columnIndex)

			try {
				values.add(
						cell == null
						? ''
						: formatter
						.formatCellValue(
						cell,
						evaluator
						)
						.trim()
						)
			} catch (Throwable ignored) {
				values.add('')
			}
		}

		return values
	}

	private BigDecimal readSyntheseNumericValue(
			Cell cell,
			DataFormatter formatter,
			FormulaEvaluator evaluator) {

		if (cell == null) {
			return null
		}

		try {
			if (cell.cellType == CellType.NUMERIC) {
				return BigDecimal.valueOf(
						cell.numericCellValue
						)
			}

			if (cell.cellType == CellType.FORMULA) {
				CellValue evaluated =
						evaluator.evaluate(cell)

				if (evaluated != null &&
						evaluated.cellType == CellType.NUMERIC) {

					return BigDecimal.valueOf(
							evaluated.numberValue
							)
				}
			}

			return parseNumber(
					formatter.formatCellValue(
					cell,
					evaluator
					)
					)
		} catch (Throwable ignored) {
			return null
		}
	}

	private void appendSyntheseIntegerComparison(
			String label,
			Integer recValue,
			Integer prdValue,
			List<String> errors,
			List<String> passedDetails) {

		if (recValue != prdValue) {
			errors.add(
					'[ERROR] ' +
					label +
					' is different.\nREC: ' +
					recValue +
					'\nPRD: ' +
					prdValue
					)

			return
		}

		passedDetails.add(
				'[PASS] ' +
				label +
				' is equal: ' +
				recValue
				)
	}

	private void appendSyntheseHeaderComparison(
			List<String> recHeaders,
			List<String> prdHeaders,
			List<String> errors,
			List<String> passedDetails) {

		Integer maximumHeaders =
				Math.max(
				recHeaders.size(),
				prdHeaders.size()
				)

		List<String> differences = []

		for (Integer index = 0;
				index < maximumHeaders;
				index++) {

			String recHeader =
					index < recHeaders.size()
					? recHeaders[index]
					: ''

			String prdHeader =
					index < prdHeaders.size()
					? prdHeaders[index]
					: ''

			if (!normalizeText(recHeader).equals(
					normalizeText(prdHeader))) {

				differences.add(
						'Column ' +
						(index + 1) +
						': REC "' +
						recHeader +
						'" | PRD "' +
						prdHeader +
						'"'
						)
			}
		}

		if (!differences.isEmpty()) {
			errors.add(
					'[ERROR] Table headers do not match.\n' +
					differences.join('\n')
					)

			return
		}

		passedDetails.add(
				'[PASS] Table headers match in the same order.'
				)
	}

	private void appendSyntheseDecimalComparison(
			String label,
			BigDecimal recValue,
			BigDecimal prdValue,
			List<String> errors,
			List<String> passedDetails) {

		if (recValue == null ||
				prdValue == null ||
				recValue.compareTo(prdValue) != 0) {

			errors.add(
					'[ERROR] ' +
					label +
					' is different.\nREC: ' +
					recValue +
					'\nPRD: ' +
					prdValue
					)

			return
		}

		passedDetails.add(
				'[PASS] ' +
				label +
				' is equal: ' +
				recValue
				)
	}

	private File validateSyntheseExcelFile(
			String filePath,
			String description) {

		String path = safeText(filePath)
		File file = new File(path)

		if (path.isEmpty() ||
				!file.exists() ||
				!file.isFile()) {

			KeywordUtil.markFailedAndStop(
					description +
					' was not found:\n' +
					file.absolutePath
					)

			return file
		}

		if (file.length() <= 0L) {
			KeywordUtil.markFailedAndStop(
					description +
					' is empty: ' +
					file.name
					)
		}

		return file
	}

	private Boolean isSyntheseEmptyRow(
			List<String> values) {

		return values == null ||
				values.isEmpty() ||
				values.every { String value ->

					safeText(value).isEmpty()
				}
	}

	// ======================================================
	// AJUSTEMENTS IPV REC X PRD EXPORT VALIDATION
	// Added without changing the existing validation flows
	// ======================================================

	@Keyword
	Map validateAjustementsIpvRecPrdExports(
			String recFilePath,
			String prdFilePath,
			String expectedAmountHeader) {

		File recFile =
				validateSyntheseExcelFile(
				recFilePath,
				'REC Ajustements IPV export'
				)

		File prdFile =
				validateSyntheseExcelFile(
				prdFilePath,
				'PRD Ajustements IPV export'
				)

		String amountHeader =
				safeText(expectedAmountHeader)

		if (amountHeader.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Ajustements IPV amount column name cannot be empty.'
					)

			return [:]
		}

		Map recData =
				readAjustementsIpvExportData(
				recFile,
				amountHeader,
				'REC'
				)

		System.gc()

		Map prdData =
				readAjustementsIpvExportData(
				prdFile,
				amountHeader,
				'PRD'
				)

		System.gc()

		List<String> errors = []
		List<String> passedDetails = []

		appendSyntheseIntegerComparison(
				'Number of table headers',
				recData.headerCount as Integer,
				prdData.headerCount as Integer,
				errors,
				passedDetails
				)

		appendSyntheseHeaderComparison(
				recData.headers as List<String>,
				prdData.headers as List<String>,
				errors,
				passedDetails
				)

		appendSyntheseIntegerComparison(
				'Number of data rows',
				recData.dataRows as Integer,
				prdData.dataRows as Integer,
				errors,
				passedDetails
				)

		appendAjustementsIpvDecimalComparison(
				'Column sum',
				amountHeader,
				recData.amountSum as BigDecimal,
				prdData.amountSum as BigDecimal,
				errors,
				passedDetails
				)

		Map result = [
			success              : errors.isEmpty(),
			recFileName          : recFile.name,
			prdFileName          : prdFile.name,
			recFilePath          : recFile.absolutePath,
			prdFilePath          : prdFile.absolutePath,
			expectedAmountHeader : amountHeader,
			recHeaders           : recData.headerCount,
			prdHeaders           : prdData.headerCount,
			recRows              : recData.dataRows,
			prdRows              : prdData.dataRows,
			recNumericValues     : recData.numericValues,
			prdNumericValues     : prdData.numericValues,
			recAmountSum         : recData.amountSum,
			prdAmountSum         : prdData.amountSum,
			recHeaderRow         : recData.headerRow,
			prdHeaderRow         : prdData.headerRow,
			recAmountColumnIndex : recData.amountColumnIndex,
			prdAmountColumnIndex : prdData.amountColumnIndex,
			recReadMode          : recData.readMode,
			prdReadMode          : prdData.readMode,
			passedDetails        : passedDetails.join('\n'),
			errors               : errors.join('\n')
		]

		if (!errors.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Ajustements IPV REC x PRD export validation failed.\n\n' +
					result.errors
					)

			return result
		}

		KeywordUtil.logInfo(
				'[PASS] Ajustements IPV REC x PRD export validation completed.\n' +
				result.passedDetails
				)

		return result
	}

	private Map readAjustementsIpvExportData(
			File file,
			String expectedAmountHeader,
			String environment) {

		String lowerName =
				file.getName().toLowerCase()

		if (lowerName.endsWith('.xlsx') ||
				lowerName.endsWith('.xlsm')) {

			try {
				Map streamingResult =
						readAjustementsIpvStreamingData(
						file,
						expectedAmountHeader,
						environment
						)

				Integer streamingNumericValues =
						streamingResult.numericValues == null
						? 0
						: streamingResult.numericValues as Integer

				if (streamingNumericValues > 0) {
					validateAjustementsIpvReadResult(
							streamingResult,
							expectedAmountHeader,
							environment,
							file
							)

					return streamingResult
				}

				KeywordUtil.logInfo(
						'[AJUSTEMENTS IPV VALUE FALLBACK] ' +
						environment +
						' streaming read returned no numeric values. ' +
						'The workbook reader will retry values stored as text.\n' +
						'Column: ' +
						expectedAmountHeader +
						'\nFile: ' +
						file.getName()
						)
			} catch (Exception exception) {
				KeywordUtil.logInfo(
						'[AJUSTEMENTS IPV VALUE FALLBACK] ' +
						environment +
						' streaming read could not complete. ' +
						'The workbook reader will retry the export.\n' +
						'Column: ' +
						expectedAmountHeader +
						'\nFile: ' +
						file.getName() +
						'\nReason: ' +
						safeText(exception.getMessage())
						)
			}

			Map workbookResult =
					readAjustementsIpvWorkbookData(
					file,
					expectedAmountHeader,
					environment
					)

			workbookResult.readMode =
					'WORKBOOK_TEXT_NUMERIC_FALLBACK'

			return workbookResult
		}

		return readAjustementsIpvWorkbookData(
				file,
				expectedAmountHeader,
				environment
				)
	}

	private Map readAjustementsIpvStreamingData(
			File file,
			String expectedAmountHeader,
			String environment) {

		OPCPackage opcPackage = null
		InputStream sheetInput = null

		try {
			opcPackage = OPCPackage.open(file)

			XSSFReader reader =
					new XSSFReader(opcPackage)

			StylesTable styles =
					reader.getStylesTable()

			ReadOnlySharedStringsTable sharedStrings =
					new ReadOnlySharedStringsTable(
					opcPackage
					)

			Iterator<InputStream> sheets =
					reader.getSheetsData()

			if (!sheets.hasNext()) {
				throw new IllegalStateException(
				environment +
				' Ajustements IPV export does not contain worksheets.'
				)
			}

			sheetInput = sheets.next()

			AjustementsIpvStreamingHandler handler =
					new AjustementsIpvStreamingHandler(
					expectedAmountHeader
					)

			XSSFSheetXMLHandler sheetHandler =
					new XSSFSheetXMLHandler(
					styles,
					null,
					sharedStrings,
					handler,
					new DataFormatter(),
					false
					)

			SAXParserFactory parserFactory =
					SAXParserFactory.newInstance()

			parserFactory.setNamespaceAware(true)

			XMLReader parser =
					parserFactory
					.newSAXParser()
					.getXMLReader()

			parser.setContentHandler(sheetHandler)

			parser.parse(
					new InputSource(sheetInput)
					)

			Map result = handler.buildResult()
			result.readMode = 'STREAMING_XLSX'

			return result
		} finally {
			try {
				if (sheetInput != null) {
					sheetInput.close()
				}
			} catch (Exception ignored) {
			}

			try {
				if (opcPackage != null) {
					opcPackage.close()
				}
			} catch (Exception ignored) {
			}
		}
	}

	private Map readAjustementsIpvWorkbookData(
			File file,
			String expectedAmountHeader,
			String environment) {

		FileInputStream input = null
		Workbook workbook = null

		try {
			input = new FileInputStream(file)
			workbook = WorkbookFactory.create(input)

			if (workbook.getNumberOfSheets() <= 0) {
				throw new IllegalStateException(
				environment +
				' Ajustements IPV export does not contain worksheets.'
				)
			}

			Sheet sheet = workbook.getSheetAt(0)
			DataFormatter formatter = new DataFormatter()

			FormulaEvaluator evaluator =
					workbook
					.getCreationHelper()
					.createFormulaEvaluator()

			Integer headerRowIndex =
					findAjustementsIpvHeaderRowIndex(
					sheet,
					expectedAmountHeader,
					formatter,
					evaluator
					)

			if (headerRowIndex < 0) {
				KeywordUtil.markFailedAndStop(
						environment +
						' Ajustements IPV table header was not found.\n' +
						'Expected amount column: ' +
						expectedAmountHeader +
						'\nFile: ' +
						file.getName()
						)

				return [:]
			}

			Row headerRow = sheet.getRow(headerRowIndex)

			List<String> headers =
					trimTrailingEmptyHeaders(
					readSyntheseRowValues(
					headerRow,
					formatter,
					evaluator
					)
					)

			Integer amountColumnIndex =
					findHeaderIndex(
					headers,
					expectedAmountHeader
					)

			Integer dataRows = 0
			Integer numericValues = 0
			BigDecimal amountSum = BigDecimal.ZERO

			for (Integer rowIndex = headerRowIndex + 1;
					rowIndex <= sheet.getLastRowNum();
					rowIndex++) {

				Row row = sheet.getRow(rowIndex)

				if (row == null) {
					continue
				}

				List<String> rowValues =
						readSyntheseRowValues(
						row,
						formatter,
						evaluator
						)

				if (isSyntheseEmptyRow(rowValues)) {
					continue
				}

				dataRows++

				BigDecimal value =
						readAjustementsIpvNumericValue(
						row.getCell(amountColumnIndex),
						formatter,
						evaluator
						)

				if (value == null) {
					continue
				}

				amountSum = amountSum.add(value)
				numericValues++
			}

			Map result = [
				headers           : headers,
				headerCount       : headers.findAll { String header ->

					!safeText(header).isEmpty()
				}.size(),
				headerRow         : headerRowIndex + 1,
				amountColumnIndex : amountColumnIndex,
				dataRows          : dataRows,
				numericValues     : numericValues,
				amountSum         : round2(amountSum),
				readMode          : 'WORKBOOK'
			]

			validateAjustementsIpvReadResult(
					result,
					expectedAmountHeader,
					environment,
					file
					)

			return result
		} finally {
			closeWorkbook(workbook)
			closeInput(input)
		}
	}

	private BigDecimal readAjustementsIpvNumericValue(
			Cell cell,
			DataFormatter formatter,
			FormulaEvaluator evaluator) {

		if (cell == null) {
			return null
		}

		BigDecimal numericValue =
				readSyntheseNumericValue(
				cell,
				formatter,
				evaluator
				)

		if (numericValue != null) {
			return numericValue
		}

		String rawText = ''

		try {
			if (cell.getCellType() == CellType.STRING) {
				rawText =
						safeText(
						cell.getStringCellValue()
						)
			}
		} catch (Exception ignored) {
		}

		if (rawText.isEmpty()) {
			try {
				rawText =
						safeText(
						formatter.formatCellValue(
						cell,
						evaluator
						)
						)
			} catch (Exception ignored) {
			}
		}

		return parseNumber(rawText)
	}


	private Integer findAjustementsIpvHeaderRowIndex(
			Sheet sheet,
			String expectedAmountHeader,
			DataFormatter formatter,
			FormulaEvaluator evaluator) {

		Integer maximumRow =
				Math.min(
				sheet.getLastRowNum(),
				50
				)

		for (Integer rowIndex = 0;
				rowIndex <= maximumRow;
				rowIndex++) {

			Row row = sheet.getRow(rowIndex)

			if (row == null) {
				continue
			}

			List<String> headers =
					readSyntheseRowValues(
					row,
					formatter,
					evaluator
					)

			if (findHeaderIndex(
					headers,
					expectedAmountHeader
					) >= 0) {

				return rowIndex
			}
		}

		return -1
	}

	private Integer findHeaderIndex(
			List<String> headers,
			String expectedHeader) {

		String normalizedExpected =
				normalizeText(expectedHeader)

		for (Integer index = 0;
				index < headers.size();
				index++) {

			if (normalizeText(
					headers.get(index)
					).equals(
					normalizedExpected
					)) {

				return index
			}
		}

		return -1
	}

	private Integer findHeaderIndex(
			Map<Integer, String> rowValues,
			String expectedHeader) {

		String normalizedExpected =
				normalizeText(expectedHeader)

		for (Map.Entry<Integer, String> entry :
		rowValues.entrySet()) {

			if (normalizeText(
					entry.getValue()
					).equals(
					normalizedExpected
					)) {

				return entry.getKey()
			}
		}

		return -1
	}

	private List<String> trimTrailingEmptyHeaders(
			List<String> headers) {

		List<String> result =
				new ArrayList<String>(headers)

		while (!result.isEmpty() &&
				safeText(
				result.get(
				result.size() - 1
				)
				).isEmpty()) {

			result.remove(
					result.size() - 1
					)
		}

		return result
	}

	private void validateAjustementsIpvReadResult(
			Map result,
			String expectedAmountHeader,
			String environment,
			File file) {

		if ((result.headerRow as Integer) <= 0) {
			KeywordUtil.markFailedAndStop(
					environment +
					' Ajustements IPV header row was not found.\n' +
					'Expected amount column: ' +
					expectedAmountHeader +
					'\nFile: ' +
					file.getName()
					)

			return
		}

		if ((result.amountColumnIndex as Integer) < 0) {
			KeywordUtil.markFailedAndStop(
					environment +
					' Ajustements IPV amount column was not found.\n' +
					'Expected header: ' +
					expectedAmountHeader +
					'\nFile: ' +
					file.getName()
					)

			return
		}

		if ((result.headerCount as Integer) <= 0) {
			KeywordUtil.markFailedAndStop(
					environment +
					' Ajustements IPV export does not contain readable table headers.\n' +
					'File: ' +
					file.getName()
					)

			return
		}

		if ((result.dataRows as Integer) <= 0) {
			KeywordUtil.markFailedAndStop(
					environment +
					' Ajustements IPV export does not contain data rows.\n' +
					'File: ' +
					file.getName()
					)

			return
		}

		if ((result.numericValues as Integer) <= 0) {
			KeywordUtil.markFailedAndStop(
					environment +
					' Ajustements IPV amount column does not contain readable numeric values.\n' +
					'Column: ' +
					expectedAmountHeader +
					'\nFile: ' +
					file.getName()
					)

			return
		}
	}

	private void appendAjustementsIpvDecimalComparison(
			String label,
			String columnName,
			BigDecimal recValue,
			BigDecimal prdValue,
			List<String> errors,
			List<String> passedDetails) {

		if (recValue == null ||
				prdValue == null ||
				recValue.compareTo(prdValue) != 0) {

			errors.add(
					'[ERROR] ' +
					label +
					' is different.\n' +
					'Column: ' +
					columnName +
					'\nREC: ' +
					recValue +
					'\nPRD: ' +
					prdValue
					)

			return
		}

		passedDetails.add(
				'[PASS] ' +
				label +
				' is equal.\n' +
				'Column: ' +
				columnName +
				'\nValue: ' +
				recValue
				)
	}

	private Integer getExcelColumnIndex(
			String cellReference) {

		String reference =
				safeText(cellReference)

		if (reference.isEmpty()) {
			return -1
		}

		String letters =
				reference.replaceAll(
				'[^A-Za-z]',
				''
				)

		if (letters.isEmpty()) {
			return -1
		}

		Integer index = 0
		int firstLetterValue =
				Character.getNumericValue(
				'A'.charAt(0)
				)

		for (Integer characterIndex = 0;
				characterIndex < letters.length();
				characterIndex++) {

			char currentCharacter =
					Character.toUpperCase(
					letters.charAt(characterIndex)
					)

			int currentCharacterValue =
					Character.getNumericValue(
					currentCharacter
					)

			index =
					(index * 26) +
					(currentCharacterValue -
					firstLetterValue +
					1)
		}

		return index - 1
	}

	private class AjustementsIpvStreamingHandler
	implements XSSFSheetXMLHandler.SheetContentsHandler {

		private final String expectedAmountHeader

		private Map<Integer, String> currentRowValues = [:]
		private List<String> headers = []

		private Integer headerRowNumber = -1
		private Integer amountColumnIndex = -1
		private Integer dataRows = 0
		private Integer numericValues = 0

		private BigDecimal amountSum =
		BigDecimal.ZERO

		AjustementsIpvStreamingHandler(
		String expectedAmountHeader) {

			this.expectedAmountHeader =
					safeText(expectedAmountHeader)
		}

		@Override
		void startRow(int rowNum) {
			currentRowValues = [:]
		}

		@Override
		void endRow(int rowNum) {

			if (headerRowNumber < 0) {
				Integer resolvedColumnIndex =
						findHeaderIndex(
						currentRowValues,
						expectedAmountHeader
						)

				if (resolvedColumnIndex >= 0) {
					headerRowNumber = rowNum
					amountColumnIndex =
							resolvedColumnIndex

					Integer maximumColumnIndex =
							currentRowValues
							.keySet()
							.max() as Integer

					List<String> resolvedHeaders = []

					for (Integer index = 0;
							index <= maximumColumnIndex;
							index++) {

						resolvedHeaders.add(
								safeText(
								currentRowValues.get(index)
								)
								)
					}

					headers =
							trimTrailingEmptyHeaders(
							resolvedHeaders
							)
				}

				return
			}

			if (rowNum <= headerRowNumber ||
					currentRowValues.isEmpty() ||
					currentRowValues.values().every { String value ->

						safeText(value).isEmpty()
					}) {

				return
			}

			dataRows++

			BigDecimal amountValue =
					parseNumber(
					currentRowValues.get(
					amountColumnIndex
					)
					)

			if (amountValue == null) {
				return
			}

			amountSum =
					amountSum.add(
					amountValue
					)

			numericValues++
		}

		@Override
		void cell(
				String cellReference,
				String formattedValue,
				XSSFComment comment) {

			Integer columnIndex =
					getExcelColumnIndex(
					cellReference
					)

			if (columnIndex < 0) {
				return
			}

			currentRowValues.put(
					columnIndex,
					safeText(formattedValue)
					)
		}

		@Override
		void headerFooter(
				String text,
				boolean isHeader,
				String tagName) {
		}

		Map buildResult() {

			return [
				headers           : headers,
				headerCount       : headers.findAll { String header ->

					!safeText(header).isEmpty()
				}.size(),
				headerRow         : headerRowNumber + 1,
				amountColumnIndex : amountColumnIndex,
				dataRows          : dataRows,
				numericValues     : numericValues,
				amountSum         : round2(amountSum)
			]
		}
	}
