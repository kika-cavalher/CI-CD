	@Keyword
	int resolveEnvironmentIndex(String env) {
		String normalized = normalizeEnvCode(env)

		switch (normalized) {
			case 'PROD':
				return 1
			case 'PREX':
			case 'PREPO':
				return 2
			case 'REC2':
				return 3
			case 'REC':
				return 4
			case 'DEV2':
				return 5
			case 'DEV':
				return 6
			default:
				return 4
		}
	}

	@Keyword
