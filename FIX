	private int parseIntOrZero(
			String value) {

		try {

			return Integer.parseInt(
				safeText(value)
			)

		} catch (Exception ignored) {

			return 0
		}
	}


	private int countOccurrences(
			String text,
			String token) {

		int count = 0
		int index = 0

		while (index >= 0) {

			index =
				text.indexOf(
					token,
					index
				)

			if (index >= 0) {

				count++

				index =
					index +
					token.length()
			}
		}

		return count
	}


	private boolean isTrue(
			String value) {

		String text =
			safeText(value)
				.toLowerCase()

		return text == 'true' ||
			text == 'yes' ||
			text == 'y' ||
			text == '1' ||
			text == 'sim'
	}


