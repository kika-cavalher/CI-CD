import java.io.File

import com.kms.katalon.core.util.KeywordUtil


// ======================================================
// COMPARISON CONFIG
// ======================================================

String recEnvironment = 'REC'
String prdEnvironment = 'PRD'

String exportLabel = 'DetailsSwapsVanilles'

String scenarioName =
	'REC x PRD - Detail Swaps Vanilles - Validate Row Count'


// ======================================================
// RESOLVE REC EXPORT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Resolve REC Detail Swaps Vanilles export\n' +
	'Environment: ' +
	recEnvironment +
	'\nExport label: ' +
	exportLabel
)

Map recExportValidation =
	CustomKeywords.
	'commands.ExportFileValidationKeywords.validateExportedFileExistsAndHasRows'(
		recEnvironment,
		exportLabel
	)

String recExportPath =
	new File(
		recExportValidation.folderPath.toString(),
		recExportValidation.fileName.toString()
	).absolutePath

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'REC Detail Swaps Vanilles export resolved successfully\n' +
	'File: ' +
	recExportValidation.fileName +
	'\nPath: ' +
	recExportPath +
	'\nData rows: ' +
	recExportValidation.dataRows +
	'\nFile size: ' +
	recExportValidation.fileSize +
	' bytes'
)


// ======================================================
// RESOLVE PRD EXPORT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Resolve PRD Detail Swaps Vanilles export\n' +
	'Environment: ' +
	prdEnvironment +
	'\nExport label: ' +
	exportLabel
)

Map prdExportValidation =
	CustomKeywords.
	'commands.ExportFileValidationKeywords.validateExportedFileExistsAndHasRows'(
		prdEnvironment,
		exportLabel
	)

String prdExportPath =
	new File(
		prdExportValidation.folderPath.toString(),
		prdExportValidation.fileName.toString()
	).absolutePath

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'PRD Detail Swaps Vanilles export resolved successfully\n' +
	'File: ' +
	prdExportValidation.fileName +
	'\nPath: ' +
	prdExportPath +
	'\nData rows: ' +
	prdExportValidation.dataRows +
	'\nFile size: ' +
	prdExportValidation.fileSize +
	' bytes'
)


// ======================================================
// COMPARE REC AND PRD ROW COUNT
// ======================================================

Integer recRows =
	recExportValidation.dataRows as Integer

Integer prdRows =
	prdExportValidation.dataRows as Integer

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Compare Detail Swaps Vanilles REC and PRD row count\n' +
	'REC file: ' +
	recExportValidation.fileName +
	'\nPRD file: ' +
	prdExportValidation.fileName +
	'\nValidation:\n' +
	'- Number of data rows\n' +
	'\nREC rows: ' +
	recRows +
	'\nPRD rows: ' +
	prdRows
)


// ======================================================
// FINAL RESULT
// ======================================================

if (recRows != prdRows) {

	String errorMessage =
		'[ERROR] Number of rows is different.\n' +
		'REC: ' +
		recRows +
		'\nPRD: ' +
		prdRows

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[FAIL] Detail Swaps Vanilles REC x PRD row validation\n' +
		errorMessage
	)

	KeywordUtil.markFailed(
		scenarioName +
		' failed.\n' +
		errorMessage
	)

} else {

	String passedMessage =
		'[PASS] Number of rows is equal.\n' +
		'REC: ' +
		recRows +
		'\nPRD: ' +
		prdRows

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[PASS] Detail Swaps Vanilles REC x PRD row validation\n' +
		passedMessage
	)

	KeywordUtil.markPassed(
		scenarioName +
		' completed successfully.\n' +
		passedMessage
	)
}
