package pageObject

import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import commands.DimensionsNavigator
import commands.ExportFile
import commands.ImageLoader
import commands.MenuNavigator

class ModuleDesResponsabiliteKeywords {

	private static final String MENU_NAME = 'cube balance des responsabilités'
	private static final String MENU_IMAGE_GROUP = 'ModuleDesResponsabilite'
	private static final String EXPORT_IMAGE_PREFIX = 'ModuleDesResponsabiliteExport'
	private static final String DIMENSIONS_IMAGE_PREFIX = 'ModuleDesResponsabiliteDimensions'
	private static final String EXPECTED_TAB = 'BDR/BalanceDesResponsabilitesTab'
	private static final String EXPORT_LABEL = 'Cube Balance des Responsabilités'

	private ImageLoader imageLoader = new ImageLoader()
	private MenuNavigator menuNavigator = new MenuNavigator()
	private ExportFile exportFile = new ExportFile()
	private DimensionsNavigator dimensionsNavigator = new DimensionsNavigator()

	@Keyword
	String getMenuName() {
		return MENU_NAME
	}

	@Keyword
	String getExportLabel() {
		return EXPORT_LABEL
	}

	@Keyword
	String getExportImageGroup() {
		return exportFile.getExportImageGroupByCurrentEnvironment(EXPORT_IMAGE_PREFIX)
	}

	@Keyword
	String getDimensionsImageGroup() {
		return dimensionsNavigator.getDimensionsImageGroupByCurrentEnvironment(DIMENSIONS_IMAGE_PREFIX)
	}

	@Keyword
	void openMenu(Integer timeoutSeconds) {
		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 60 : timeoutSeconds

		menuNavigator.searchAndOpenMenu(
			MENU_NAME,
			MENU_IMAGE_GROUP,
			EXPECTED_TAB,
			safeTimeout
		)
	}

	@Keyword
	void validateOpenedMenu(Integer timeoutSeconds) {
		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 60 : timeoutSeconds

		Windows.waitForElementPresent(
			findWindowsObject(EXPECTED_TAB),
			safeTimeout,
			FailureHandling.STOP_ON_FAILURE
		)
	}

	@Keyword
	void takeEvidence(String fileName) {
		imageLoader.takeEvidence(fileName)
	}

	@Keyword
	void validateDimensionsImagesExist(String dimensionsImageGroup) {
		dimensionsNavigator.validateDimensionsImagesExist(dimensionsImageGroup)
	}

	@Keyword
	void validateImagesExist(String dimensionsImageGroup) {
		dimensionsNavigator.validateDimensionsImagesExist(dimensionsImageGroup)
	}

	@Keyword
	void clickFirstDimension(String dimensionsImageGroup) {
		dimensionsNavigator.clickFirstDimension(dimensionsImageGroup)
	}

	@Keyword
	void openDimensionsUntilProvic(String dimensionsImageGroup, Integer maxDownMoves) {
		dimensionsNavigator.openDimensionsUntilProvic(dimensionsImageGroup, maxDownMoves)
	}

	@Keyword
	void scrollDimensionsToTop(String dimensionsImageGroup) {
		dimensionsNavigator.scrollDimensionsToTop(dimensionsImageGroup)
	}

	@Keyword
	void validateProvicOpen(String dimensionsImageGroup, Integer timeoutSeconds) {
		dimensionsNavigator.validateProvicOpen(dimensionsImageGroup, timeoutSeconds)
	}

	@Keyword
	void validateMeasuresOpen(String dimensionsImageGroup, Integer timeoutSeconds) {
		dimensionsNavigator.validateMeasuresOpen(dimensionsImageGroup, timeoutSeconds)
	}

	@Keyword
	void validateNormeOpen(String dimensionsImageGroup, Integer timeoutSeconds) {
		dimensionsNavigator.validateNormeOpen(dimensionsImageGroup, timeoutSeconds)
	}

	@Keyword
	void validateStartOfDimensions(String dimensionsImageGroup, Integer timeoutSeconds) {
		dimensionsNavigator.validateStartOfDimensions(dimensionsImageGroup, timeoutSeconds)
	}

	@Keyword
	void validateEndOfDimensions(String dimensionsImageGroup, Integer timeoutSeconds) {
		dimensionsNavigator.validateEndOfDimensions(dimensionsImageGroup, timeoutSeconds)
	}

	@Keyword
	void validateEndOfDimensionsSelected(String dimensionsImageGroup, Integer timeoutSeconds) {
		dimensionsNavigator.validateEndOfDimensionsSelected(dimensionsImageGroup, timeoutSeconds)
	}

	@Keyword
	void validateFirstPageReference(String dimensionsImageGroup, Integer timeoutSeconds) {
		dimensionsNavigator.validateFirstPageReference(dimensionsImageGroup, timeoutSeconds)
	}

	@Keyword
	void validateSecondPageReference(String dimensionsImageGroup, Integer timeoutSeconds) {
		dimensionsNavigator.validateSecondPageReference(dimensionsImageGroup, timeoutSeconds)
	}

	@Keyword
	void validateThirdPageReference(String dimensionsImageGroup, Integer timeoutSeconds) {
		dimensionsNavigator.validateThirdPageReference(dimensionsImageGroup, timeoutSeconds)
	}

	@Keyword
	boolean isDimensionImageVisible(String dimensionsImageGroup, String imageKey) {
		return dimensionsNavigator.isDimensionImageVisible(dimensionsImageGroup, imageKey)
	}

	@Keyword
	void clickDimensionImageOrStop(String dimensionsImageGroup, String imageKey) {
		dimensionsNavigator.clickDimensionImageOrStop(dimensionsImageGroup, imageKey)
	}

	@Keyword
	void waitForDimensionImageOrStop(String dimensionsImageGroup, String imageKey, Integer timeoutSeconds) {
		dimensionsNavigator.waitForDimensionImageOrStop(dimensionsImageGroup, imageKey, timeoutSeconds)
	}

	@Keyword
	void waitSeconds(Integer seconds) {
		Windows.delay(seconds == null ? 1 : seconds)
	}

	@Keyword
	String exportFromOutils(Integer intervalSeconds, Integer maxTimes) {
		return exportFile.downloadFromOutilsAndRegister(
			intervalSeconds == null ? 15 : intervalSeconds,
			maxTimes == null ? 15 : maxTimes,
			EXPORT_LABEL
		)
	}

	@Keyword
	void validateDownloadedFileExists(String fileName) {
		exportFile.validateDownloadedFileExists(fileName, EXPORT_LABEL)
	}

	@Keyword
	String validateExportedRecProdFiles(
		Integer threshold,
		String closingDate,
		List<Integer> historicalColumns,
		List<Integer> currentYearColumns,
		List<String> columnLabels
	) {
		return exportFile.validateRecProdExcelFiles(
			threshold,
			closingDate,
			historicalColumns,
			currentYearColumns,
			columnLabels
		)
	}
}













