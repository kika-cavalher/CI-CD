	@Keyword
	void validateSyntheseTabOpened(
			String openedTabName,
			Integer timeoutSeconds
	) {

		Integer timeout =
				safeTimeout(timeoutSeconds)

		String tabName =
				safeText(openedTabName)

		if (tabName.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Synthèse opened tab name cannot be empty.'
					)

			return
		}

		WindowsTestObject tabObject =
				WindowsObjectLoader.getTabByName(
				tabName
				)

		if (!Windows.waitForElementPresent(
				tabObject,
				timeout,
				FailureHandling.OPTIONAL
				)) {
			takeEvidence(
					'Synthese_Justification_Latent_TabNotOpened.png'
					)

			KeywordUtil.markFailedAndStop(
					'Synthèse tab was not opened.\n' +
					'Expected tab: ' +
					tabName
					)

			return
		}

		takeEvidence(
				'Synthese_Justification_Latent_Opened.png'
				)

		KeywordUtil.logInfo(
				'[PASS] Synthèse tab opened successfully.\n' +
				'Opened tab: ' +
				tabName
				)
	}
