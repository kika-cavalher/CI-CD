        String timeLabel = safeValue(step.timeLabel)
        String title = safeValue(step.title)
        String emoji = safeValue(step.emoji)
        String shortError = safeValue(step.shortError)
        String detailText = safeValue(step.detailText)
        String errorFull = safeValue(step.errorFull)

        html.append('<div class="step-row">')

        html.append('<div class="col-status">')
        html.append('<span class="status-badge ')
        html.append(htmlEscape(status))
        html.append('">')
        html.append(htmlEscape(capitalize(status)))
        html.append('</span>')
        html.append('</div>')

        html.append('<div class="col-time">')
        html.append(htmlEscape(timeLabel))
        html.append('</div>')

        html.append('<div class="col-detail">')
        html.append('<div class="step-main-line">')
        html.append('<span class="step-emoji">')
        html.append(htmlEscape(emoji))
        html.append('</span>')
        html.append('<span class="step-text">')
        html.append(htmlEscape(title))
        html.append('</span>')
        html.append('</div>')

        if (status == 'failed' && !isBlank(shortError)) {
            html.append('<div class="step-error-short">')
            html.append(htmlEscape(shortError))
            html.append('</div>')
        }

        if (status == 'failed' && !isBlank(errorFull)) {
            html.append('<details class="step-detail-box">')
            html.append('<summary>🔎 View full detail</summary>')
            html.append('<pre>')
            html.append(htmlEscape(errorFull))
            html.append('</pre>')
            html.append('</details>')
        }

        html.append('</div>')
        html.append('</div>')

        return html.toString()
    }

