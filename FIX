package common

import static com.kms.katalon.core.testobject.ObjectRepository.findTestObject

import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI

import cucumber.api.java.en.Given
import cucumber.api.java.en.Then
import cucumber.api.java.en.When
import internal.GlobalVariable

class Login {

	private static final int LOGIN_TIMEOUT = 10
	private static final int PAGE_TIMEOUT = 60

	@Given("user opens DEV login page")
	def userOpensDevLoginPageStep() {
		openDevLoginPage()
	}

	@When("the user logs in with the correct profile credentials.")
	def userLogsInWithDefaultProfileCredentialsStep() {
		loginIfRequired()
	}

	@Then("Hue home should be opened")
	def hueHomeShouldBeOpenedStep() {
		verifyHueHomeOpened()
	}

	@Given("DEV user is authenticated")
	def devUserIsAuthenticatedStep() {
		openDevLoginPage()
		loginIfRequired()
		verifyHueHomeOpened()
	}

	@Given("DEV user logguin")
	def devUserLogguinStep() {
		openDevLoginPage()
		loginIfRequired()
		verifyHueHomeOpened()
	}

	private void openDevLoginPage() {
		KeywordUtil.logInfo("Opening DEV login page")

		WebUI.openBrowser('')
		WebUI.maximizeWindow()
		WebUI.navigateToUrl(GlobalVariable.DEV_URL.toString())

		WebUI.waitForPageLoad(PAGE_TIMEOUT)
	}

	private void loginIfRequired() {
		KeywordUtil.logInfo("Checking login screen")

		boolean loginVisible = WebUI.verifyElementPresent(
			findTestObject('Login/input_Username'),
			LOGIN_TIMEOUT,
			FailureHandling.OPTIONAL
		)

		if (!loginVisible) {
			KeywordUtil.logInfo("Login screen was not displayed. User is already authenticated.")
			return
		}

		KeywordUtil.logInfo("Filling login credentials")

		WebUI.setText(
			findTestObject('Login/input_Username'),
			GlobalVariable.DEV_USERNAME.toString()
		)

		WebUI.setEncryptedText(
			findTestObject('Login/input_Password'),
			GlobalVariable.DEV_PASSWORD.toString()
		)

		WebUI.click(findTestObject('Login/button_SignIn'))

		WebUI.waitForPageLoad(PAGE_TIMEOUT)
	}

	private void verifyHueHomeOpened() {
		KeywordUtil.logInfo("Verifying Hue was opened")

		WebUI.waitForPageLoad(PAGE_TIMEOUT)

		String currentUrl = WebUI.getUrl()
		KeywordUtil.logInfo("Current URL: " + currentUrl)

		if (!currentUrl.contains('/hue/')) {
			KeywordUtil.markFailedAndStop("Hue was not opened. Current URL: " + currentUrl)
		}

		KeywordUtil.logInfo("Hue was opened successfully")
	}
}






Feature: DEV Authentication

  Scenario: Login in DEV successfully and open Hue home
    Given user opens DEV login page
    When the user logs in with the correct profile credentials.
    Then Hue home should be opened






Feature: Navigation

  Background:
    Given DEV user is authenticated

  Scenario: Verify navigation
    When user searches for the configured default database
    Then selected database title should be displayed


