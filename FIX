		String filterValue,
		String language,
		Integer resultLoadDelaySeconds
	) {
		String textFilterImage = isFrench(language)
			? 'textFilter'
			: 'textFilterEN'

		String closeFilterImage = isFrench(language)
			? 'closeFiltersBtn'
			: 'closeFiltersBtnEN'

		clickImageOrStop('sectionFilter')
		Windows.delay(5)

		clickImageOrStop(
			'filterBtn'
		)
		Windows.delay(3)

		typeOnImageOrStop(
			textFilterImage,
			filterValue
		)
		Windows.delay(3)

		clickImageOrStop(
			'checkbox'
		)
		Windows.delay(10)

