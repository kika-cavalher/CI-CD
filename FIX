def files = GlobalVariable.compareFiles as ArrayList

String errors = ''

String evPath = RunConfiguration.getReportFolder() + '\\Evidences\\'

Boolean validate=false
CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Validate expected downloaded files list')
if(files.size()==3) {
	validate=true
}else {
	if(files.size()!=2) {
		errors+='\n[ERROR] Files to test not found  \n'
		validate=false
	}else {
		errors+='\n[ERROR] files to validate not all present but was validated the existent \n '
		validate=false
	}
}

Double CCYValue=null

if(validate) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Resolve main and detail investigation files')
	String MainfileInvestigations=files.get(0)
	String BilanInvestigationsFile=files.get(1)
	String ResultatInvestigationsFile=files.get(2)
	
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Read Montant CCY reference value from general investigation file')
	input1 = new FileInputStream(evPath+MainfileInvestigations);
	wbEnv1 = WorkbookFactory.create(input1);
	sheetEnv1 = wbEnv1.getSheetAt(0);
	int linesEnv1 = sheetEnv1.getLastRowNum();
	Row row1= sheetEnv1.getRow(0)
	row1= sheetEnv1.getRow(1)
	Integer idxCCY=getMontantCCYColFromGeneralFile(row1)
	CCYValue=sheetEnv1.getRow(2).getCell(idxCCY).getNumericCellValue()
	input1.close()
	
	println(CCYValue)
	BigDecimal CCYValueParsed=new BigDecimal(CCYValue)
	CCYValueParsed=CCYValueParsed.setScale(0,BigDecimal.ROUND_HALF_UP)
	
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Compare Montant CCY reference against Bilan and Resultat detail files')
	if(CompareCCyfromreferenceWithDetails(BilanInvestigationsFile,CCYValueParsed,evPath)&&CompareCCyfromreferenceWithDetails(ResultatInvestigationsFile,CCYValueParsed,evPath)) {
		KeywordUtil.markPassed("Detail files contains montant CCY value from the main file")
	}else {
		errors+='\n[ERROR] Montant ccy column value from details files are not matching with the detail file first line of the investigations.xml file \n '
	}
}

println(CCYValue)

if(errors!='') {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Montant CCY validation finished with errors')
	KeywordUtil.markFailed(errors)
} else {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Montant CCY validation finished successfully')
	KeywordUtil.markPassed(" Montant ccy is  present in detail files for the first line of the general investigations.xml file")
}

Boolean CompareCCyfromreferenceWithDetails(String fileName,BigDecimal reference,String evPath) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Check Montant CCY value inside detail file: ' + fileName)
	
	FileInputStream input1 = new FileInputStream(evPath+fileName);
	Workbook wbEnv1 = WorkbookFactory.create(input1);
	Sheet sheetEnv1 = wbEnv1.getSheetAt(0);
	int linesEnv1 = sheetEnv1.getLastRowNum();
	Row row1= sheetEnv1.getRow(0)
	Integer idxCCY=getMontantCCYColFromDetails(row1)
	int i=0
	for (Row row in sheetEnv1) {
		if(i!=0) {
			String val= ''
			
			try {
				val=row.getCell(idxCCY).getNumericCellValue().toString()
			} catch (Exception e) {
				val=val=row.getCell(idxCCY).getStringCellValue()
			}
			
			println(val)
			BigDecimal valParsed=new BigDecimal(val)
			valParsed=valParsed.setScale(0,BigDecimal.ROUND_HALF_UP)
			
			if((Math.abs(reference)==Math.abs(valParsed))) {
				return true
			}
		}
		i++
	}
	return false
}

Integer getMontantCCYColFromDetails(Row headersRow) {
	Integer i=0
	for (Cell header in headersRow) {
		String headerText=header.getStringCellValue()
		if(headerText.equalsIgnoreCase("Montant ccy")) {
			return i
		}
		i++
	}
	return -1
}

Integer getMontantCCYColFromGeneralFile(Row headersRow) {
	Integer i=0
	for (Cell header in headersRow) {
		String headerText=header.getStringCellValue()
		if(headerText.equalsIgnoreCase("Total (ccy)")) {
			return i
		}
		i++
	}
	return -1
}
