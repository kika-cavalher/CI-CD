	private String resolveSuiteName(File reportDir, String providedSuiteName) {
		if (!isBlank(providedSuiteName)) {
			return safeValue(providedSuiteName)
		}

		File parent = reportDir.parentFile
		if (parent != null && !isBlank(parent.name)) {
			return safeValue(parent.name)
		}

		return 'Execution'
	}

	private String resolveAssetUrl(File reportDir, String relativePath) {
		if (isBlank(relativePath)) {
			return ''
		}

		File current = reportDir
		while (current != null) {
			if ('Reports'.equalsIgnoreCase(current.name)) {
				File projectRoot = current.parentFile != null ? current.parentFile : current
				File asset = new File(projectRoot, relativePath)
				if (asset.exists()) {
					return asset.toURI().toString()
				}
				break
			}
			current = current.parentFile
		}

		return ''
	}

	private String readFileText(File file) {
		try {
			return new String(Files.readAllBytes(file.toPath()), StandardCharsets.UTF_8)
		} catch (Exception ignored) {
			try {
				return file.getText('UTF-8')
			} catch (Exception ignoredAgain) {
				return ''
			}
		}
	}

	private int indexOfIgnoreCase(String source, String target) {
		if (isBlank(source) || isBlank(target)) {
			return -1
		}
		return source.toLowerCase(Locale.ENGLISH).indexOf(target.toLowerCase(Locale.ENGLISH))
	}

	private String lastPathToken(String value) {
		String text = safeValue(value).replace('\\', '/')
		List<String> parts = text.tokenize('/')
		return parts.isEmpty() ? text : safeValue(parts.last())
	}

	private String normalizeTitle(String value) {
		return safeValue(value)
				.replace('\u00A0', ' ')
				.replace('\\', '/')
				.replaceAll(/\s+/, ' ')
				.trim()
				.toLowerCase(Locale.ENGLISH)
	}

