1) Um file dentro do projeto Katalon

Crie este file no repositório:

jenkins\ArchiveMode.cmd

Cole exatamente isso:

@echo off
setlocal EnableExtensions EnableDelayedExpansion

rem ==============================
rem CONFIGURACAO DESTE TESTE
rem ==============================
set "JOB_LABEL=Archive Mode"
set "TEST_SUITE_COLLECTION=Test Suites/Archive Mode/Archive Mode Collection"
set "EXECUTION_PROFILE=default"
set "BROWSER_TYPE=Windows"

rem ==============================
rem CONFIGURACAO FIXA
rem ==============================
set "STARTER_DIR=D:\Projects\eMatchStarters"
set "GENERIC_TASK=\eMatch Automation\RunEMatchCommand"
set "WIN_DRIVER_TASK=startWinDriver"
set "WAIT_SECONDS=5"
set "MAX_WAIT_CYCLES=720"

echo ========================================
echo [INFO] Starting %JOB_LABEL%
echo [INFO] WORKSPACE=%WORKSPACE%
echo [INFO] TEST_SUITE_COLLECTION=%TEST_SUITE_COLLECTION%
echo ========================================

if "%WORKSPACE%"=="" (
    echo [ERROR] WORKSPACE is empty.
    exit /b 1
)

if not exist "%STARTER_DIR%" (
    echo [ERROR] STARTER_DIR not found: %STARTER_DIR%
    exit /b 1
)

if not exist "%STARTER_DIR%\logs" mkdir "%STARTER_DIR%\logs"

> "%STARTER_DIR%\run-context.properties" (
    echo JOB_LABEL=%JOB_LABEL%
    echo WORKSPACE=%WORKSPACE%
    echo TEST_SUITE_COLLECTION=%TEST_SUITE_COLLECTION%
    echo EXECUTION_PROFILE=%EXECUTION_PROFILE%
    echo BROWSER_TYPE=%BROWSER_TYPE%
    echo KATALON_HOME=C:\Users\adgi5appjenkins\Documents\Katalon_Studio_Engine_Windows_64-8.1.0
)

> "%STARTER_DIR%\run-result.properties" (
    echo STATUS=QUEUED
    echo EXIT_CODE=999
)

echo [INFO] Starting WinAppDriver task...
schtasks /run /tn "%WIN_DRIVER_TASK%"
if errorlevel 1 (
    echo [ERROR] Could not start %WIN_DRIVER_TASK%
    exit /b 1
)

echo [INFO] Starting visible Katalon task...
schtasks /run /tn "%GENERIC_TASK%"
if errorlevel 1 (
    echo [ERROR] Could not start %GENERIC_TASK%
    schtasks /end /tn "%WIN_DRIVER_TASK%" >nul 2>nul
    exit /b 1
)

set /a WAIT_COUNT=0

:waitLoop
set "TASK_STATUS="
for /f "tokens=2,* delims=: " %%A in ('schtasks /query /tn "%GENERIC_TASK%" /fo list ^| findstr /b /c:"Status:"') do set "TASK_STATUS=%%B"

if /i "!TASK_STATUS!"=="Running" (
    set /a WAIT_COUNT+=1

    if !WAIT_COUNT! GEQ %MAX_WAIT_CYCLES% (
        echo [ERROR] Timeout waiting %GENERIC_TASK%
        schtasks /end /tn "%GENERIC_TASK%" >nul 2>nul
        schtasks /end /tn "%WIN_DRIVER_TASK%" >nul 2>nul
        exit /b 1
    )

    if !WAIT_COUNT! LEQ 5 echo [INFO] %JOB_LABEL% is still running...
    timeout /t %WAIT_SECONDS% /nobreak >nul
    goto waitLoop
)

echo [INFO] Visible task finished.
schtasks /end /tn "%WIN_DRIVER_TASK%" >nul 2>nul

if not exist "%STARTER_DIR%\run-result.properties" (
    echo [ERROR] run-result.properties not found.
    exit /b 1
)

for /f "tokens=1,* delims==" %%A in (%STARTER_DIR%\run-result.properties) do (
    set "%%A=%%B"
)

echo [INFO] STATUS=!STATUS!
echo [INFO] EXIT_CODE=!EXIT_CODE!

if not "!EXIT_CODE!"=="0" exit /b !EXIT_CODE!

echo [INFO] %JOB_LABEL% finished successfully.
exit /b 0
2) Um BAT genérico no servidor

Crie este file:

D:\Projects\eMatchStarters\run-ematch-command.bat

Cole exatamente isso:

@echo off
setlocal EnableExtensions EnableDelayedExpansion

set "BASE_DIR=D:\Projects\eMatchStarters"
set "LOG_DIR=%BASE_DIR%\logs"
set "CTX_FILE=%BASE_DIR%\run-context.properties"
set "RESULT_FILE=%BASE_DIR%\run-result.properties"
set "LOG_FILE=%LOG_DIR%\run-ematch-command.log"

if not exist "%LOG_DIR%" mkdir "%LOG_DIR%"

call :log ========================================
call :log [INFO] Starting run-ematch-command.bat

if not exist "%CTX_FILE%" (
    call :log [ERROR] Context file not found: %CTX_FILE%
    call :writeResult FINISHED 1
    exit /b 1
)

for /f "usebackq tokens=1* delims==" %%A in ("%CTX_FILE%") do (
    set "%%A=%%B"
)

if not defined WORKSPACE (
    call :log [ERROR] WORKSPACE is empty.
    call :writeResult FINISHED 1
    exit /b 1
)

if not defined TEST_SUITE_COLLECTION (
    call :log [ERROR] TEST_SUITE_COLLECTION is empty.
    call :writeResult FINISHED 1
    exit /b 1
)

if not defined KATALON_HOME set "KATALON_HOME=C:\Users\adgi5appjenkins\Documents\Katalon_Studio_Engine_Windows_64-8.1.0"
if not defined EXECUTION_PROFILE set "EXECUTION_PROFILE=default"
if not defined BROWSER_TYPE set "BROWSER_TYPE=Windows"

set "PROJECT_FILE="
for %%I in ("%WORKSPACE%\*.prj") do (
    set "PROJECT_FILE=%%~fI"
    goto :projectFound
)

:projectFound
if not defined PROJECT_FILE (
    call :log [ERROR] No .prj file found in: %WORKSPACE%
    call :writeResult FINISHED 1
    exit /b 1
)

set "KATALON_EXE=%KATALON_HOME%\katalonc.exe"
if not exist "%KATALON_EXE%" (
    call :log [ERROR] Katalon executable not found: %KATALON_EXE%
    call :writeResult FINISHED 1
    exit /b 1
)

call :writeResult RUNNING 999

call :log [INFO] JOB_LABEL=%JOB_LABEL%
call :log [INFO] WORKSPACE=%WORKSPACE%
call :log [INFO] PROJECT_FILE=%PROJECT_FILE%
call :log [INFO] TEST_SUITE_COLLECTION=%TEST_SUITE_COLLECTION%
call :log [INFO] EXECUTION_PROFILE=%EXECUTION_PROFILE%
call :log [INFO] BROWSER_TYPE=%BROWSER_TYPE%

pushd "%WORKSPACE%"
"%KATALON_EXE%" -noSplash -runMode=console -projectPath="%PROJECT_FILE%" -retry=0 -testSuiteCollectionPath="%TEST_SUITE_COLLECTION%" -executionProfile="%EXECUTION_PROFILE%" -browserType="%BROWSER_TYPE%"
set "EXIT_CODE=%ERRORLEVEL%"
popd

call :log [INFO] Katalon finished with EXIT_CODE=%EXIT_CODE%
call :writeResult FINISHED %EXIT_CODE%
exit /b %EXIT_CODE%

:writeResult
> "%RESULT_FILE%" (
    echo STATUS=%~1
    echo EXIT_CODE=%~2
    echo UPDATED_AT=%date% %time%
)
goto :eof

:log
echo %*
>> "%LOG_FILE%" echo [%date% %time%] %*
goto :eof
3) Task schedule genérica

A task genérica deve ser:

\eMatch Automation\RunEMatchCommand

Com ação:

Program/script
C:\Windows\System32\cmd.exe
Add arguments
/c "D:\Projects\eMatchStarters\run-ematch-command.bat"
4) No Jenkins

No campo Execute Windows batch command você deve colocar somente isso:

call "%WORKSPACE%\jenkins\ArchiveMode.cmd"

⚠️ Nada de stage {} / load() / Groovy aqui.

✅ Porque agora vai abrir

Esse fluxo fica assim:

Jenkins chama ArchiveMode.cmd
ArchiveMode.cmd grava o contexto do teste
Jenkins dispara a task visível
A task visível executa run-ematch-command.bat
O run-ematch-command.bat chama o katalonc.exe
O teste roda na sessão remota visível
👀 Ponto obrigatório para o app aparecer

Na task \eMatch Automation\RunEMatchCommand:

Run only when user is logged on
Run with highest privileges
Hidden desmarcado
mesmo user da sessão remota visível

Se isso estiver errado, o teste pode executar mas o app não aparecer.

📌 O erro exato de agora

O que quebrou não foi o Katalon nem o app.
Foi a configuração do Jenkins porque você usou script Groovy num campo BAT.

✅ O que trocar agora
apagar o conteúdo atual do build step
criar jenkins\ArchiveMode.cmd no repo
criar D:\Projects\eMatchStarters\run-ematch-command.bat no servidor
deixar no Jenkins só:
call "%WORKSPACE%\jenkins\ArchiveMode.cmd"

Na próxima execução ele já vai pelo caminho certo.
