package jenkinsIntegration

def runAsset(script, config, asset) {

    script.echo "🚀 Running Katalon directly (NO Task Scheduler)"

    def command = """
"${config.katalonExe}" ^
-noSplash ^
-runMode=console ^
-projectPath="${config.projectPath}" ^
-testSuiteCollectionPath="${asset.path}" ^
-browserType="Windows" ^
-reportFolder="${config.reportsRoot}" ^
-reportFileName="report"
"""

    script.echo "📦 Command:"
    script.echo command

    def exitCode = script.bat(returnStatus: true, script: command)

    script.echo "🏁 Exit Code: ${exitCode}"

    return exitCode
}
