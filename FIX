import groovy.json.JsonSlurperClassic

def safeFileName(String value) {
    return (value ?: 'asset')
        .replaceAll(/[\\\\\\/:"*?<>|]+/, '_')
        .replaceAll(/\s+/, '_')
}

def loadResultFile(script, String resultFile, Map fallback) {
    if (!script.fileExists(resultFile)) {
        return fallback
    }

    try {
        String raw = script.readFile(file: resultFile, encoding: 'UTF-8')
        if (!raw?.trim()) {
            return fallback
        }

        def parsed = new JsonSlurperClassic().parseText(raw)
        return (parsed instanceof Map) ? parsed : fallback
    }
    catch (ignored) {
        return fallback
    }
}

