private void attachEvidenceToFailedScenarios(File reportDir, List<Map> scenarios) {
    List<File> images = findEvidenceImages(reportDir)
    List<Map> failedScenarios = scenarios.findAll { Map item -> safeValue(item.status) == 'failed' }

    scenarios.each { Map scenario ->
        scenario.evidences = []
    }

    if (images.isEmpty() || failedScenarios.isEmpty()) {
        return
    }

    images.sort { File a, File b -> a.lastModified() <=> b.lastModified() }

    int imageCursor = images.size() - 1

    failedScenarios.reverseEach { Map scenario ->
        if (imageCursor < 0) {
            return
        }

        File chosen = images[imageCursor]
        imageCursor--

        scenario.evidences = [[
            name     : chosen.name,
            fileName : chosen.name,
            href     : chosen.toURI().toString(),
            imageSrc : chosen.toURI().toString(),
            image    : true
        ]]
    }
}

private List<File> findEvidenceImages(File reportDir) {
    List<File> images = []
    collectEvidenceImages(reportDir, images)
    return images
}

private void collectEvidenceImages(File folder, List<File> images) {
    if (folder == null || !folder.exists()) {
        return
    }

    File[] files = folder.listFiles()
    if (files == null) {
        return
    }

    files.each { File file ->
        if (file.isDirectory()) {
            collectEvidenceImages(file, images)
            return
        }

        String lower = file.name.toLowerCase(Locale.ENGLISH)

        boolean isImage = false
        isImage = isImage || lower.endsWith('.png')
        isImage = isImage || lower.endsWith('.jpg')
        isImage = isImage || lower.endsWith('.jpeg')
        isImage = isImage || lower.endsWith('.webp')

        boolean isLogo = lower.contains('gaia-logo')

        if (isImage && !isLogo) {
            images << file
        }
    }
}
