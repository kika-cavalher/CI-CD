	private boolean isEnvironmentExcelFile(
			File file,
			String environment) {

		if (file == null ||
				!file.exists() ||
				!file.isFile()) {

			return false
		}

		String fileName =
				file.getName()

		if (fileName.startsWith('~$')) {
			return false
		}

		return fileName
				.toUpperCase()
				.startsWith(
				safeText(environment)
				.toUpperCase() +
				'_'
				) &&
				isExcelFileName(fileName)
	}


	private boolean isExcelFileName(
			String fileName) {

		String normalizedName =
				safeText(fileName)
				.toLowerCase()

		return normalizedName.endsWith('.xlsx') ||
				normalizedName.endsWith('.xls') ||
				normalizedName.endsWith('.xlsm')
	}


	private String readHeaderName(
			Sheet sheet,
			int columnIndex,
			DataFormatter formatter) {

		if (sheet == null ||
				columnIndex < 0) {

			return ''
		}

		Row headerRow =
				sheet.getRow(0)

		if (headerRow == null) {
			return ''
		}

		Cell headerCell =
				headerRow.getCell(columnIndex)

		if (headerCell == null) {
			return ''
		}

		return formatter
				.formatCellValue(headerCell)
				.trim()
	}


	private BigDecimal getCellNumber(
			Row row,
			int columnIndex,
			DataFormatter formatter,
			FormulaEvaluator evaluator) {

		if (row == null ||
				columnIndex < 0) {

			return null
		}

		Cell cell =
				row.getCell(columnIndex)

		if (cell == null) {
			return null
		}

		try {
			CellType cellType =
					cell.getCellType()

			if (cellType == CellType.NUMERIC) {
				return BigDecimal.valueOf(
						cell.getNumericCellValue()
						)
			}

			if (cellType == CellType.STRING) {
				return parseNumber(
						cell.getStringCellValue()
						)
			}

			if (cellType == CellType.FORMULA) {
				CellType cachedResultType =
						cell.getCachedFormulaResultType()

				if (cachedResultType ==
						CellType.NUMERIC) {

					return BigDecimal.valueOf(
							cell.getNumericCellValue()
							)
				}

				if (cachedResultType ==
						CellType.STRING) {

					BigDecimal cachedStringValue =
							parseNumber(
							cell.getStringCellValue()
							)

					if (cachedStringValue != null) {
						return cachedStringValue
					}
				}

				if (evaluator != null) {
					CellValue evaluatedValue =
							evaluator.evaluate(cell)

					if (evaluatedValue != null) {
						if (evaluatedValue.getCellType() ==
								CellType.NUMERIC) {

							return BigDecimal.valueOf(
									evaluatedValue
									.getNumberValue()
									)
						}

						if (evaluatedValue.getCellType() ==
								CellType.STRING) {

							BigDecimal evaluatedStringValue =
									parseNumber(
									evaluatedValue
									.getStringValue()
									)

							if (evaluatedStringValue != null) {
								return evaluatedStringValue
							}
						}
					}

					BigDecimal formattedFormulaValue =
							parseNumber(
							formatter.formatCellValue(
							cell,
							evaluator
							)
							)

					if (formattedFormulaValue != null) {
						return formattedFormulaValue
					}
				}
			}

			return parseNumber(
					formatter.formatCellValue(cell)
					)
		} catch (Exception exception) {
			KeywordUtil.logInfo(
					'[EXCEL VALUE WARNING] Value could not be read.\n' +
					'Row: ' +
					(row.getRowNum() + 1) +
					'\nColumn index: ' +
					columnIndex +
					'\nCell type: ' +
					safeText(cell.getCellType()) +
					'\nReason: ' +
					safeText(
					exception.getMessage()
					)
					)

			return null
		}
	}


	private boolean isRowEmpty(
			Row row,
			DataFormatter formatter) {

		if (row == null ||
				row.getLastCellNum() <= 0) {

			return true
		}

		for (int columnIndex = 0;
				columnIndex < row.getLastCellNum();
				columnIndex++) {

			Cell cell =
					row.getCell(columnIndex)

			if (cell == null) {
				continue
			}

			if (!formatter
					.formatCellValue(cell)
					.trim()
					.isEmpty()) {

				return false
			}
		}

		return true
	}


	private void appendComparison(
			StringBuilder errors,
			StringBuilder passedDetails,
			String validationLabel,
			String columnName,
			BigDecimal recValue,
			BigDecimal prdValue) {

		if (recValue == null ||
				prdValue == null) {

			errors.append('[ERROR] ')
					.append(validationLabel)
					.append(
					' could not be compared.\n'
					)

			return
		}

		if (recValue.compareTo(prdValue) != 0) {
			errors.append('[ERROR] ')
					.append(validationLabel)
					.append(' is different.\n')
					.append('Column: ')
					.append(columnName)
					.append('\nREC: ')
					.append(recValue)
					.append('\nPRD: ')
					.append(prdValue)
					.append('\n')
		} else {
			passedDetails.append('[PASS] ')
					.append(validationLabel)
					.append(' is equal.\n')
					.append('Column: ')
					.append(columnName)
					.append('\nValue: ')
					.append(recValue)
					.append('\n')
		}
	}


	private BigDecimal parseNumber(
			String value) {

		String text =
				safeText(value)

		if (text.isEmpty()) {
			return null
		}

		text = text
				.replace('\u00A0', ' ')
				.replace('\u202F', ' ')
				.replace('\u2212', '-')
				.replace('\u2012', '-')
				.replace('\u2013', '-')
				.replace('\u2014', '-')
				.replace('\u2015', '-')
				.trim()

		boolean negativeByParentheses =
				text.startsWith('(') &&
				text.endsWith(')')

		boolean negativeByTrailingMinus =
				text.endsWith('-')

		text = text
				.replaceAll(
				'[^0-9,\\.\\-\\(\\)]',
				''
				)
				.replace('(', '')
				.replace(')', '')

		if (negativeByTrailingMinus &&
				text.endsWith('-')) {

			text = text.substring(
					0,
					text.length() - 1
					)
		}

		boolean negative =
				text.startsWith('-') ||
				negativeByParentheses ||
				negativeByTrailingMinus

		text = text.replace('-', '')

		if (text.isEmpty()) {
			return null
		}

		String normalizedNumber =
				normalizeNumericSeparators(text)

		if (normalizedNumber.isEmpty()) {
			return null
		}

		try {
			BigDecimal result =
					new BigDecimal(
					normalizedNumber
					)

			if (negative &&
					result.compareTo(
					BigDecimal.ZERO
					) > 0) {

				result = result.negate()
			}

			return result
		} catch (Exception ignored) {
			return null
		}
	}


	private String normalizeNumericSeparators(
			String value) {

		int commaCount =
				countOccurrences(
				value,
				','
				)

		int dotCount =
				countOccurrences(
				value,
				'.'
				)

		if (commaCount > 0 &&
				dotCount > 0) {

			int lastComma =
					value.lastIndexOf(',')

			int lastDot =
					value.lastIndexOf('.')

			if (lastComma > lastDot) {
				return value
						.replace('.', '')
						.replace(',', '.')
			}

			return value.replace(',', '')
		}

		if (commaCount > 0) {
			return normalizeSingleSeparatorNumber(
					value,
					','
					)
		}

		if (dotCount > 0) {
			return normalizeSingleSeparatorNumber(
					value,
					'.'
					)
		}

		return value
	}


	private String normalizeSingleSeparatorNumber(
			String value,
			String separator) {

		int separatorCount =
				countOccurrences(
				value,
				separator
				)

		if (separatorCount == 0) {
			return value
		}

		if (separatorCount > 1) {
			int lastSeparator =
					value.lastIndexOf(
					separator
					)

			String decimals =
					value.substring(
					lastSeparator + 1
					)

			if (decimals.length() == 1 ||
					decimals.length() == 2) {

				String integerPart =
						value
						.substring(
						0,
						lastSeparator
						)
						.replace(
						separator,
						''
						)

				return integerPart +
						'.' +
						decimals
			}

			return value.replace(
					separator,
					''
					)
		}

		int separatorIndex =
				value.indexOf(separator)

		String before =
				value.substring(
				0,
				separatorIndex
				)

		String after =
				value.substring(
				separatorIndex + 1
				)

		if (after.length() == 3 &&
				before.length() >= 1 &&
				before.length() <= 3) {

			return before + after
		}

		if (separator == ',') {
			return before +
					'.' +
					after
		}

		return value
	}


	private BigDecimal round2(
			BigDecimal value) {

		if (value == null) {
			return null
		}

		return value.setScale(
				2,
				RoundingMode.HALF_EVEN
				)
	}


	private int countOccurrences(
			String text,
			String token) {

		int count = 0
		int index = 0

		while (index >= 0) {
			index = text.indexOf(
					token,
					index
					)

			if (index >= 0) {
				count++

				index +=
						token.length()
			}
		}

		return count
	}


	private String normalizeText(
			Object value) {

		String text =
				safeText(value)

		if (text.isEmpty()) {
			return ''
		}

		text = Normalizer.normalize(
				text,
				Normalizer.Form.NFD
				)

		text = text.replaceAll(
				'\\p{InCombiningDiacriticalMarks}+',
				''
				)

		return text
				.toLowerCase()
				.replace(' ', '_')
				.replace('-', '_')
				.replaceAll('_+', '_')
				.trim()
	}


	private String safeText(
			Object value) {

		if (value == null) {
			return ''
		}

		return value
				.toString()
				.trim()
	}


