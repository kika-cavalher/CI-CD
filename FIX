	private String readHeaderName(
			Sheet sheet,
			int columnIndex,
			DataFormatter formatter) {

		if (
		sheet == null ||
				columnIndex < 0
				) {
			return ''
		}

		Row headerRow =
				sheet.getRow(0)

		if (headerRow == null) {
			return ''
		}

		Cell cell =
				headerRow.getCell(
				columnIndex
				)

		if (cell == null) {
			return ''
		}

		return formatter
				.formatCellValue(cell)
				.trim()
	}


	private int countNonEmptyDataRows(
			Sheet sheet,
			DataFormatter formatter,
			FormulaEvaluator evaluator) {

		if (sheet == null) {
			return 0
		}

		int count = 0

		for (
		int i = 1;
				i <= sheet.getLastRowNum();
				i++
				) {

			Row row =
					sheet.getRow(i)

			if (
			row != null &&
					!isRowEmpty(
					row,
					formatter,
					evaluator
					)
					) {
				count++
			}
		}

		return count
	}


	private Map calculateColumnStatistics(
			Sheet sheet,
			int columnIndex,
			DataFormatter formatter,
			FormulaEvaluator evaluator) {

		BigDecimal sum =
				BigDecimal.ZERO

		BigDecimal minimum = null
		BigDecimal maximum = null

		int numericValues = 0

		for (
		int i = 1;
				i <= sheet.getLastRowNum();
				i++
				) {

			Row row =
					sheet.getRow(i)

			if (row == null) {
				continue
			}

			BigDecimal value =
					getCellNumber(
					row,
					columnIndex,
					formatter,
					evaluator
					)

			if (value == null) {
				continue
			}

			sum = sum.add(value)

			if (
			minimum == null ||
					value.compareTo(minimum) < 0
					) {
				minimum = value
			}

			if (
			maximum == null ||
					value.compareTo(maximum) > 0
					) {
				maximum = value
			}

			numericValues++
		}

		return [
			sum           : sum,
			minimum       : minimum,
			maximum       : maximum,
			numericValues : numericValues
		]
	}


	private void appendComparisonResult(
			StringBuilder errors,
			StringBuilder passedDetails,
			String validationLabel,
			String columnName,
			BigDecimal recValue,
			BigDecimal prdValue) {

		if (recValue.compareTo(prdValue) != 0) {

			errors.append('[ERROR] ')
					.append(validationLabel)
					.append(' is different.\n')
					.append('Column: ')
					.append(columnName)
					.append('\n')
					.append('REC: ')
					.append(recValue)
					.append('\n')
					.append('PRD: ')
					.append(prdValue)
					.append('\n')
		} else {

			passedDetails.append('[PASS] ')
					.append(validationLabel)
					.append(' is equal.\n')
					.append('Column: ')
					.append(columnName)
					.append('\n')
					.append('Value: ')
					.append(recValue)
					.append('\n')
		}
	}


