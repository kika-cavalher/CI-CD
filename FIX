	private void closeAllTabsAndConfirm(
			String expectedTabName,
			Integer timeoutSeconds,
			boolean requireExpectedTabClosed
	) {

		Integer timeout = actionTimeout(timeoutSeconds)

		pressKeyboardKey(
				KeyEvent.VK_ESCAPE
				)

		Windows.delay(1)

		WindowsTestObject closeAllTabsButton =
				object(
				'closeAllTabsTopBar'
				)

		boolean closeAllTabsFound =
				Windows.waitForElementPresent(
				closeAllTabsButton,
				timeout,
				FailureHandling.OPTIONAL
				)

		if (!closeAllTabsFound) {
			takeEvidence(
					'GUI_CloseAllTabsButtonNotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					'Close All Tabs button was not found within ' +
					timeout +
					' seconds.'
					)

			return
		}

		String enabledValue =
				safeText(
				Windows.getAttribute(
				closeAllTabsButton,
				'IsEnabled',
				FailureHandling.OPTIONAL
				)
				)

		boolean buttonDisabled =
				enabledValue.equalsIgnoreCase('False')

		if (buttonDisabled) {
			KeywordUtil.logInfo(
					'[CLOSE TABS] Close All Tabs is disabled. No opened tab requires closing.'
					)

			if (
			requireExpectedTabClosed &&
					!safeText(expectedTabName).isEmpty()
					) {
				verifyTabDisappeared(
						expectedTabName,
						timeout
						)
			}

			return
		}

		KeywordUtil.logInfo(
				'[CLOSE TABS] Clicking Close All Tabs.'
				)

		Windows.click(
				closeAllTabsButton,
				FailureHandling.STOP_ON_FAILURE
				)

		Windows.delay(1)

		WindowsTestObject expectedTab = null

		if (!safeText(expectedTabName).isEmpty()) {
			expectedTab =
					WindowsObjectLoader.getTabByName(
					expectedTabName
					)
		}

		long deadline =
				System.currentTimeMillis() +
				(timeout * 1000L)

		boolean confirmationHandled = false

		while (System.currentTimeMillis() < deadline) {

			confirmationHandled =
					clickFirstVisibleImage(
					GENERAL_IMAGE_GROUP,
					[
						'yes',
						'yesUnderline',
						'yesButton',
						'oui',
						'okModal',
						'okModal2Version'
					],
					1
					)

			if (confirmationHandled) {
				KeywordUtil.logInfo(
						'[CLOSE TABS] Confirmation modal button clicked.'
						)

				break
			}

			if (
			expectedTab != null &&
					!Windows.waitForElementPresent(
					expectedTab,
					1,
					FailureHandling.OPTIONAL
					)
					) {
				break
			}

			Windows.delay(1)
		}

		if (!confirmationHandled) {
			boolean tabsAlreadyClosed =
					expectedTab != null &&
					!Windows.waitForElementPresent(
					expectedTab,
					1,
					FailureHandling.OPTIONAL
					)

			if (!tabsAlreadyClosed) {
				KeywordUtil.logInfo(
						'[CLOSE TABS] Confirmation image was not found.\n' +
						'Pressing ENTER.'
						)

				pressKeyboardKey(
						KeyEvent.VK_ENTER
						)
			}
		}

		if (
		requireExpectedTabClosed &&
				!safeText(expectedTabName).isEmpty()
				) {
			verifyTabDisappeared(
					expectedTabName,
					timeout
					)
		} else {
			waitForCloseAllTabsDisabled(
					closeAllTabsButton,
					timeout
					)
		}

		Windows.delay(2)
	}


