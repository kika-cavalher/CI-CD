    private String normalizeStatus(def status) {
        String text = safeValue(status).toLowerCase(Locale.ENGLISH)

        if (text == 'passed' || text == 'pass' || text == 'success') {
            return 'passed'
        }
        if (text == 'failed' || text == 'fail' || text == 'error') {
            return 'failed'
        }
        if (text == 'blocked' || text == 'skipped' || text == 'skip' || text == 'not_run') {
            return 'blocked'
        }
        return 'passed'
    }

    private String statusLabel(String status) {
        switch (safeValue(status)) {
            case 'passed':
                return 'Passed'
            case 'failed':
                return 'Failed'
            case 'blocked':
                return 'Blocked'
            default:
                return 'Passed'
        }
    }

    private double percent(int value, int total) {
        if (total <= 0) {
            return 0d
        }
        return ((double) value / (double) total) * 100d
    }

    private String formatPercent(double value) {
        return String.format(Locale.ENGLISH, '%.2f', value)
    }

    private String pickFirst(Object... values) {
        if (values == null) {
            return ''
        }

        for (Object value : values) {
            String text = safeValue(value)
            if (!text.isEmpty()) {
                return text
            }
        }

        return ''
    }

    private String safeValue(def value) {
        return value == null ? '' : String.valueOf(value).trim()
    }

    private String htmlEscape(def value) {
        String text = safeValue(value)
        return text
            .replace('&', '&amp;')
            .replace('<', '&lt;')
            .replace('>', '&gt;')
            .replace('"', '&quot;')
            .replace("'", '&#39;')
    }

    private String jsEscape(def value) {
        String text = safeValue(value)
        return text
            .replace('\\', '\\\\')
            .replace("'", "\\'")
            .replace('\r', '')
            .replace('\n', '\\n')
    }
}












