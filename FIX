		}

		for (File file : files) {

			if (!file.exists()) {
				errors.append("[ERROR] File not found: ").append(file.getAbsolutePath()).append("\n")
			} else if (!file.isFile()) {
				errors.append("[ERROR] Path is not a file: ").append(file.getAbsolutePath()).append("\n")
			} else if (!isExcelFile(file.getName())) {
				errors.append("[ERROR] File is not Excel: ").append(file.getAbsolutePath()).append("\n")
