// ======================================================
// FILE RESOLUTION
// ======================================================

Map resolveLatestRecPrdFiles(
		File exportRoot,
		String expectedGroupFolder,
		String expectedFeatureFolder) {

	Map result = [
		recFile        : null,
		prdFile        : null,
		selectedFolder : null
	]

	if (exportRoot == null ||
		!exportRoot.exists() ||
		!exportRoot.isDirectory()) {

		KeywordUtil.logInfo(
			'[FILE SEARCH] Export root folder does not exist: ' +
			(exportRoot == null
				? 'null'
				: exportRoot.getAbsolutePath())
		)

		return result
	}

	List<File> featureFolders = []

	findMatchingFeatureFolders(
		exportRoot,
		normalizePathPart(expectedGroupFolder),
		normalizePathPart(expectedFeatureFolder),
		featureFolders
	)

	KeywordUtil.logInfo(
		'[FILE SEARCH] Matching feature folders found: ' +
		featureFolders.size()
	)

	List<Map> validPairs = []

	for (File featureFolder : featureFolders) {

		List<File> excelFiles =
			collectDirectExcelFiles(featureFolder)

		List<File> recFiles = excelFiles.findAll { File file ->
			isEnvironmentFile(file, 'REC')
		}

		List<File> prdFiles = excelFiles.findAll { File file ->
			isEnvironmentFile(file, 'PRD')
		}

		if (!recFiles.isEmpty() &&
			!prdFiles.isEmpty()) {

			recFiles.sort { File first, File second ->
				second.lastModified() <=>
					first.lastModified()
			}

			prdFiles.sort { File first, File second ->
				second.lastModified() <=>
					first.lastModified()
			}

			File latestRec = recFiles.get(0)
			File latestPrd = prdFiles.get(0)

			long pairTimestamp = Math.max(
				latestRec.lastModified(),
				latestPrd.lastModified()
			)

			validPairs.add([
				recFile        : latestRec,
				prdFile        : latestPrd,
				selectedFolder : featureFolder,
				timestamp      : pairTimestamp
			])
		}
	}

	if (validPairs.isEmpty()) {

		KeywordUtil.logInfo(
			'[FILE SEARCH] No folder containing both REC and PRD files was found.'
		)

		return result
	}

	validPairs.sort { Map first, Map second ->
		(second.timestamp as Long) <=>
			(first.timestamp as Long)
	}

	Map latestPair = validPairs.get(0)

	result.recFile = latestPair.recFile
	result.prdFile = latestPair.prdFile
	result.selectedFolder = latestPair.selectedFolder

	KeywordUtil.logInfo(
		'[FILE SEARCH] Selected folder: ' +
		(result.selectedFolder as File).getAbsolutePath()
	)

	KeywordUtil.logInfo(
		'[FILE SEARCH] Selected REC file: ' +
		(result.recFile as File).getName()
	)

	KeywordUtil.logInfo(
		'[FILE SEARCH] Selected PRD file: ' +
		(result.prdFile as File).getName()
	)

	return result
}

void findMatchingFeatureFolders(
		File currentFolder,
		String expectedGroupFolder,
		String expectedFeatureFolder,
		List<File> result) {

	if (currentFolder == null ||
		!currentFolder.exists() ||
		!currentFolder.isDirectory()) {

		return
	}

	String currentFolderName =
		normalizePathPart(currentFolder.getName())

	String parentFolderName =
		currentFolder.getParentFile() == null
			? ''
			: normalizePathPart(
				currentFolder.getParentFile().getName()
			)

	if (currentFolderName == expectedFeatureFolder &&
		parentFolderName == expectedGroupFolder) {

		result.add(currentFolder)

		return
	}

	File[] children = currentFolder.listFiles()

	if (children == null) {
		return
	}

	for (File child : children) {

		if (child != null &&
			child.isDirectory()) {

			findMatchingFeatureFolders(
				child,
				expectedGroupFolder,
				expectedFeatureFolder,
				result
			)
		}
	}
}

List<File> collectDirectExcelFiles(File folder) {

	List<File> result = []

	if (folder == null ||
		!folder.exists() ||
		!folder.isDirectory()) {

		return result
	}

	File[] files = folder.listFiles()

	if (files == null) {
		return result
	}

	for (File file : files) {

		if (file != null &&
			file.isFile() &&
			isExcelFile(file) &&
			!file.getName().startsWith('~$')) {

			result.add(file)
		}
	}

	return result
}

boolean isEnvironmentFile(
		File file,
		String environment) {

	if (file == null) {
		return false
	}

	String fileName = file.getName().toUpperCase()
	String environmentPrefix =
		safeText(environment).toUpperCase() + '_'

	return fileName.startsWith(environmentPrefix)
}

boolean isExcelFile(File file) {

	if (file == null) {
		return false
	}

	String fileName = file.getName().toLowerCase()

	return fileName.endsWith('.xlsx') ||
		fileName.endsWith('.xls') ||
		fileName.endsWith('.xlsm')
}

String normalizePathPart(Object value) {

	return safeText(value)
		.toLowerCase()
		.replace(' ', '_')
		.replace('-', '_')
		.replaceAll('_+', '_')
}

String displayValue(Object value) {

	if (value == null) {
		return 'NOT AVAILABLE'
	}

	String text = safeText(value)

	return text.isEmpty()
		? 'NOT AVAILABLE'
		: text
}

String safeText(Object value) {

	if (value == null) {
		return ''
	}

	return value.toString().trim()
}



