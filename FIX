REC x PRD - Ecarts De Cours - Validate Exports And Amount Sum



import java.io.File

import com.kms.katalon.core.util.KeywordUtil


// ======================================================
// COMPARISON CONFIG
// ======================================================

String recEnvironment = 'REC'
String prdEnvironment = 'PRD'

String exportLabel = 'EcartsDeCours'
String expectedAmountHeader = 'Ajustement ipv calculé'

String scenarioName =
	'REC x PRD - Ecarts De Cours - Validate Exports And Amount Sum'


// ======================================================
// RESOLVE REC EXPORT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Resolve REC Ecarts De Cours export\n' +
	'Environment: ' +
	recEnvironment +
	'\nExport label: ' +
	exportLabel
)

Map recExportValidation =
	CustomKeywords.
	'commands.ExportFileValidationKeywords.validateExportedFileExistsAndHasRows'(
		recEnvironment,
		exportLabel
	)

String recExportPath =
	new File(
		recExportValidation.folderPath.toString(),
		recExportValidation.fileName.toString()
	).absolutePath

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'REC Ecarts De Cours export resolved successfully\n' +
	'File: ' +
	recExportValidation.fileName +
	'\nPath: ' +
	recExportPath +
	'\nData rows: ' +
	recExportValidation.dataRows +
	'\nFile size: ' +
	recExportValidation.fileSize +
	' bytes'
)


// ======================================================
// RESOLVE PRD EXPORT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Resolve PRD Ecarts De Cours export\n' +
	'Environment: ' +
	prdEnvironment +
	'\nExport label: ' +
	exportLabel
)

Map prdExportValidation =
	CustomKeywords.
	'commands.ExportFileValidationKeywords.validateExportedFileExistsAndHasRows'(
		prdEnvironment,
		exportLabel
	)

String prdExportPath =
	new File(
		prdExportValidation.folderPath.toString(),
		prdExportValidation.fileName.toString()
	).absolutePath

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'PRD Ecarts De Cours export resolved successfully\n' +
	'File: ' +
	prdExportValidation.fileName +
	'\nPath: ' +
	prdExportPath +
	'\nData rows: ' +
	prdExportValidation.dataRows +
	'\nFile size: ' +
	prdExportValidation.fileSize +
	' bytes'
)


// ======================================================
// COMPARE REC AND PRD EXPORTS
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Compare Ecarts De Cours REC and PRD exports\n' +
	'REC file: ' +
	recExportValidation.fileName +
	'\nPRD file: ' +
	prdExportValidation.fileName +
	'\nAmount column: ' +
	expectedAmountHeader +
	'\nValidations:\n' +
	'- Number of table headers\n' +
	'- Header names and order\n' +
	'- Number of data rows\n' +
	'- Sum of Ajustement ipv calculé'
)

Map comparison =
	CustomKeywords.
	'commands.RecPrdExportValidationKeywords.validateAjustementsIpvRecPrdExports'(
		recExportPath,
		prdExportPath,
		expectedAmountHeader
	)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Ecarts De Cours REC x PRD comparison passed\n' +
	'REC file: ' +
	comparison.recFileName +
	'\nPRD file: ' +
	comparison.prdFileName +
	'\nTable headers: ' +
	comparison.recHeaders +
	'\nData rows: ' +
	comparison.recRows +
	'\nColumn: ' +
	comparison.expectedAmountHeader +
	'\nNumeric values read in REC: ' +
	comparison.recNumericValues +
	'\nNumeric values read in PRD: ' +
	comparison.prdNumericValues +
	'\nColumn sum: ' +
	comparison.recAmountSum +
	'\nREC read mode: ' +
	comparison.recReadMode +
	'\nPRD read mode: ' +
	comparison.prdReadMode
)

KeywordUtil.markPassed(
	scenarioName +
	' completed successfully.'
)
