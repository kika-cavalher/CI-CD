		if (!Windows.waitForElementPresent(
				targetObject,
				safeTimeout(timeoutSeconds),
				FailureHandling.OPTIONAL
				)) {
			takeEvidence(
					'Investigations_' +
					objectKey +
					'_NotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					description +
					' was not found by image or Windows object.\n' +
					'Image: ' +
					IMAGE_GROUP +
					'.' +
					imageKey +
					'\nObject: ' +
					OBJECT_GROUP +
					'.' +
					objectKey
					)

			return
		}

		Windows.click(
				targetObject,
				FailureHandling.STOP_ON_FAILURE
				)

		KeywordUtil.logInfo(
				'[OBJECT] ' +
				description +
				' clicked.\n' +
				'Group: ' +
				OBJECT_GROUP +
				'\nKey: ' +
				objectKey
				)
	}

	// ---------------------------------------------------------
	// verifyTabByName
	// Used by: validateDefaultDatesAndApply
	// ---------------------------------------------------------

	private void verifyTabByName(
			String tabName,
			Integer timeoutSeconds
	) {

		Integer timeout =
				safeTimeout(timeoutSeconds)

		WindowsTestObject tabObject =
				WindowsObjectLoader.getTabByName(
				tabName
				)

		if (!Windows.waitForElementPresent(
				tabObject,
				timeout,
				FailureHandling.OPTIONAL
				)) {
			takeEvidence(
					'Investigations_TabNotOpened.png'
					)

			KeywordUtil.markFailedAndStop(
					'Expected tab was not opened.\n' +
					'Tab: ' +
					tabName
					)

			return
		}

		KeywordUtil.logInfo(
				'[PASS] Tab opened successfully: ' +
				tabName
				)
	}

