import static com.kms.katalon.core.testcase.TestCaseFactory.findTestCase

import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import commands.WindowsObjectLoader

String targetEnvironment = 'REC'

String menuName = 'PL économique Brut'
String menuResultName = 'PL économique Brut'
String openedTabName = menuResultName

String loginTestCase = 'Component/Authentication/Login ' + targetEnvironment

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'🚀 Archive Mode validation\n' +
	'Menu search: ' + menuName + '\n' +
	'Validation: opened tab only'
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Authenticate and open application'
)

WebUI.callTestCase(
	findTestCase(loginTestCase),
	[:],
	FailureHandling.STOP_ON_FAILURE
)

CustomKeywords.'component.SettingsArchiveModeKeywords.enableArchiveModeFromSettings'(
	30
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Open Archive Mode menu\n' +
	'Result: ' + menuResultName
)

CustomKeywords.'component.MenuNavigator.searchAndOpenMenuByText'(
	menuName,
	menuResultName,
	45
)

WindowsTestObject openedTab = WindowsObjectLoader.getTabByName(openedTabName)
WindowsTestObject datesPopup = WindowsObjectLoader.getObject('menu', 'datesPopup')
WindowsTestObject columnsPopup = WindowsObjectLoader.getObject('menu', 'columnsPopup')

Boolean tabOpened = false
Boolean datesPopupOpened = false
Boolean columnsPopupOpened = false

Integer elapsedSeconds = 0
Integer timeoutSeconds = 25

while (elapsedSeconds < timeoutSeconds) {

	if (Windows.waitForElementPresent(openedTab, 1, FailureHandling.OPTIONAL)) {
		tabOpened = true
		break
	}

	if (Windows.waitForElementPresent(datesPopup, 1, FailureHandling.OPTIONAL)) {
		datesPopupOpened = true
		break
	}

	if (Windows.waitForElementPresent(columnsPopup, 1, FailureHandling.OPTIONAL)) {
		columnsPopupOpened = true
		break
	}

	Windows.delay(1)
	elapsedSeconds++
}

if (!tabOpened && !datesPopupOpened && !columnsPopupOpened) {
	CustomKeywords.'commands.ImageLoader.takeEvidence'(
		'PLEconomiqueBrutTabOrPopupNotOpened.png'
	)

	KeywordUtil.markFailedAndStop(
		'Archive Mode tab or expected startup popup was not opened.\n' +
		'Expected tab: ' + openedTabName + '\n' +
		'Expected popup 1: Dates à afficher\n' +
		'Expected popup 2: Choix des colonnes à afficher'
	)
}

if (datesPopupOpened || columnsPopupOpened) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'✅ Archive Mode menu opened successfully\n' +
		'Expected popup displayed before tab validation\n' +
		'Action: close startup popup and validate tab'
	)

	closePlEconomiqueBrutStartupPopups()

	Windows.delay(1)

	tabOpened = Windows.waitForElementPresent(
		openedTab,
		15,
		FailureHandling.OPTIONAL
	)
}

if (!tabOpened) {
	CustomKeywords.'commands.ImageLoader.takeEvidence'(
		'PLEconomiqueBrutTabNotVisibleAfterPopupClose.png'
	)

	KeywordUtil.markFailedAndStop(
		'Archive Mode tab was not visible after closing startup popups.\n' +
		'Expected tab: ' + openedTabName
	)
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'✅ Archive Mode tab opened successfully\n' +
	'Tab: ' + openedTabName
)

CustomKeywords.'component.CloseTabKeywords.closeTabByName'(
	openedTabName,
	20
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Close application'
)

WebUI.callTestCase(
	findTestCase('Component/Authentication/Close Application'),
	[:],
	FailureHandling.STOP_ON_FAILURE
)

KeywordUtil.markPassed(
	targetEnvironment + ' Archive Mode validation completed successfully. Menu: ' + menuResultName
)

void closePlEconomiqueBrutStartupPopups() {

	for (Integer attempt = 1; attempt <= 3; attempt++) {

		Boolean popupClosed = false

		if (closeSpecificPopupIfPresent(
				'datesPopup',
				'datesPopupCancelButton',
				'Dates à afficher')) {

			popupClosed = true
			Windows.delay(1)
		}

		if (closeSpecificPopupIfPresent(
				'columnsPopup',
				'columnsPopupCancelButton',
				'Choix des colonnes à afficher')) {

			popupClosed = true
			Windows.delay(1)
		}

		if (!popupClosed) {
			return
		}
	}
}

Boolean closeSpecificPopupIfPresent(String popupObjectName, String cancelButtonObjectName, String popupName) {

	try {
		WindowsTestObject popup = WindowsObjectLoader.getObject('menu', popupObjectName)

		if (!Windows.waitForElementPresent(popup, 2, FailureHandling.OPTIONAL)) {
			return false
		}

		WindowsTestObject cancelButton = WindowsObjectLoader.getObject('menu', cancelButtonObjectName)

		if (!Windows.waitForElementPresent(cancelButton, 5, FailureHandling.OPTIONAL)) {
			CustomKeywords.'commands.ImageLoader.takeEvidence'(
				popupObjectName + 'CancelButtonNotFound.png'
			)

			KeywordUtil.markFailedAndStop(
				popupName + ' popup was opened, but Annuler button was not found.'
			)

			return false
		}

		Windows.click(cancelButton, FailureHandling.OPTIONAL)

		CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
			'Startup popup closed\n' +
			'Popup: ' + popupName + '\n' +
			'Action: Annuler'
		)

		return true
	} catch (Throwable e) {
		CustomKeywords.'commands.ImageLoader.takeEvidence'(
			popupObjectName + 'CloseError.png'
		)

		KeywordUtil.markFailedAndStop(
			'Error while closing startup popup.\n' +
			'Popup: ' + popupName + '\n' +
			'Reason: ' + e.getMessage()
		)

		return false
	}
}
