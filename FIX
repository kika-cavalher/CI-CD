			String headerAmountBaseCcy,
			boolean needCurrencyRef) {

		StringBuilder errors = new StringBuilder()

		FileInputStream input = null
		Workbook workbook = null

		try {

			KeywordUtil.logInfo("🧾 [VALIDATE HEADERS] file=" + file.getName() + " | validationType=" + validationType)

			input = new FileInputStream(file)
			workbook = WorkbookFactory.create(input)

			if (workbook.getNumberOfSheets() <= sheetIndex) {

				errors.append("[ERROR] File '")
						.append(file.getName())
						.append("' does not contain sheet index ")
						.append(sheetIndex)
						.append(".\n")
			} else {

				Sheet sheet = workbook.getSheetAt(sheetIndex)
				DataFormatter formatter = new DataFormatter()

				int currencyCol = findHeaderColumn(sheet, headerCurrency, formatter)
				int currencyRefCol = findHeaderColumn(sheet, headerCurrencyRef, formatter)
				int amountCcyCol = findHeaderColumn(sheet, headerAmountCcy, formatter)
				int amountBaseCol = findHeaderColumn(sheet, headerAmountBaseCcy, formatter)

				KeywordUtil.logInfo("🧾 [HEADERS] file=" + file.getName() +
						" | " + headerCurrency + "=" + currencyCol +
						" | " + headerCurrencyRef + "=" + currencyRefCol +
						" | " + headerAmountCcy + "=" + amountCcyCol +
						" | " + headerAmountBaseCcy + "=" + amountBaseCol)

				if (currencyCol < 0) {
					errors.append("[ERROR] File '").append(file.getName()).append("' missing header: ").append(headerCurrency).append("\n")
				}

				if (needCurrencyRef && currencyRefCol < 0) {
					errors.append("[ERROR] File '").append(file.getName()).append("' missing header: ").append(headerCurrencyRef).append("\n")
				}

				if (amountCcyCol < 0) {
					errors.append("[ERROR] File '").append(file.getName()).append("' missing header: ").append(headerAmountCcy).append("\n")
				}

				if (amountBaseCol < 0) {
					errors.append("[ERROR] File '").append(file.getName()).append("' missing header: ").append(headerAmountBaseCcy).append("\n")
				}
			}
		} catch (Exception e) {

			errors.append("[ERROR] Header validation failed for file '")
					.append(file.getName())
					.append("': ")
					.append(e.getClass().getSimpleName())
					.append(" | ")
					.append(e.getMessage())
					.append("\n")
		} finally {

			try {
				if (workbook != null) {
					workbook.close()
				}
			} catch (Exception ignored) {}

			try {
				if (input != null) {
					input.close()
				}
			} catch (Exception ignored) {}
		}

		return errors.toString()
	}

