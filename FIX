pipeline {
    agent {
        node {
            label 'GI5_SWDCFRNXGI55817'
            customWorkspace 'D:\\jenkins\\work\\workspace\\GI5\\Gaia\\Gaia_Corrections'
        }
    }

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 95, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '15', daysToKeepStr: '20'))
    }

    parameters {
        string(name: 'STARTUP_WAIT_SECONDS',  defaultValue: '40', description: 'Seconds to wait after backend/frontend startup')
        string(name: 'SUITE_TIMEOUT_MINUTES', defaultValue: '10', description: 'Timeout in minutes for each suite')
        string(name: 'BROWSER',               defaultValue: 'Chrome', description: 'Katalon browser type')
    }

    environment {
        KATALON_EXE = 'C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0\\katalonc.exe'
        GIT_URL     = 'https://bitbucket-mut.mycloud.intrabpce.fr/scm/gi5/gaia-portal.git'
        GIT_BRANCH  = '*/master'
        GIT_CRED    = '965eceec-b3a3-4ec5-8820-a857c87dd80f'
        START_TASK  = 'GaiaBackFrontSetup'
        REPORT_MENU = 'Gaia Test Reports'
        BACK_PORT   = '8020'
        FRONT_PORT  = '4200'
    }

    stages {
        stage('✨ Validate Base Paths') {
            steps {
                script {
                    validateBasePaths(this)
                }
            }
        }

        stage('🚀 Start Gaia Backend and Frontend') {
            steps {
                script {
                    startGaiaProcesses(this)
                }
            }
        }

        stage('📥 Checkout Repository') {
            steps {
                script {
                    checkoutRepository(this)
                }
            }
        }

        stage('🧹 Prepare Reports Folder') {
            steps {
                script {
                    prepareReportsFolder(this)
                }
            }
        }

        stage('🧪 Execute Test Suites') {
            steps {
                script {
                    def suiteResults = []
                    def suites = getTestSuites()

                    suites.each { suite ->
                        stage("Suite • ${suite.name}") {
                            def result = null

                            catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                                result = runSuite(this, suite)
                                suiteResults << result

                                saveSuiteResults(this, suiteResults)
                                printSuiteResult(this, result)
                                printRunningSummary(this, suiteResults)

                                if (result.status != 'PASSED') {
                                    error("${result.name} finished with status ${result.status}")
                                }
                            }

                            if (result == null) {
                                result = [
                                    name        : suite.name,
                                    path        : suite.path,
                                    status      : 'FAILED',
                                    icon        : '❌',
                                    executed    : '0',
                                    passed      : '0',
                                    failed      : '0',
                                    skipped     : '0',
                                    line1       : 'Pipeline execution failed before report parsing',
                                    line2       : 'Suite ended unexpectedly inside Jenkins',
                                    line3       : 'Check console log for technical details',
                                    reason      : 'Unexpected pipeline interruption',
                                    reportRel   : '',
                                    logRel      : '',
                                    caseSummary : [],
                                    stepSummary : []
                                ]

                                suiteResults << result
                                saveSuiteResults(this, suiteResults)
                                printSuiteResult(this, result)
                                printRunningSummary(this, suiteResults)
                            }
                        }
                    }

                    if (suiteResults.any { it.status != 'PASSED' }) {
                        currentBuild.result = 'FAILURE'
                    }
                }
            }
        }

        stage('📊 Build Reports Dashboard') {
            steps {
                script {
                    def suiteResults = loadSuiteResults(this)
                    buildReportsDashboard(this, suiteResults)
                }
            }
        }
    }

    post {
        always {
            script {
                def suiteResults = loadSuiteResults(this)

                safeBuildReportsDashboard(this, suiteResults)
                stopGaiaProcesses(this, currentBuild.currentResult == 'ABORTED' ? 'Build aborted by user' : 'Build finished')
                printFinalSummary(this, suiteResults, currentBuild.currentResult)
            }

            catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                archiveArtifacts(
                    artifacts: 'Reports/**/*',
                    excludes: '**/broken-test-objects-v2.json,**/Self-healing/**',
                    allowEmptyArchive: true
                )
            }

            catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                junit allowEmptyResults: true, testResults: 'Reports/**/JUnit_Report.xml'
            }

            catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                publishHTML(target: [
                    allowMissing         : true,
                    alwaysLinkToLastBuild: true,
                    keepAll              : true,
                    reportDir            : 'Reports/dashboard',
                    reportFiles          : 'index.html',
                    reportName           : "${env.REPORT_MENU}",
                    reportTitles         : 'Gaia Corrections Dashboard'
                ])
            }
        }

        success {
            echo '✅ PIPELINE FINISHED SUCCESSFULLY'
        }

        failure {
            echo '❌ PIPELINE FINISHED WITH ERRORS'
        }

        aborted {
            echo '🛑 PIPELINE ABORTED'
        }
    }
}

def getTestSuites() {
    return [
        [name: 'PreLoad', path: 'Test Suites/PreLoad'],
        [name: 'Help',    path: 'Test Suites/Help']
    ]
}

def currentWorkspace(script) {
    return script.pwd()
}

def currentProjectPath(script) {
    return "${currentWorkspace(script)}\\gaia-portal.prj"
}

def currentReportsRoot(script) {
    return "${currentWorkspace(script)}\\Reports"
}

def validateBasePaths(script) {
    def workDir = currentWorkspace(script)
    def reportsRoot = currentReportsRoot(script)

    script.bat """
@echo off
echo ============================================================
echo ✨ VALIDATING BASE PATHS
echo ============================================================

if not exist "${workDir}" mkdir "${workDir}"
if not exist "${reportsRoot}" mkdir "${reportsRoot}"

if not exist "${script.env.KATALON_EXE}" (
    echo ❌ Katalon executable not found:
    echo ${script.env.KATALON_EXE}
    exit /b 1
)

echo ✅ Base paths are valid
echo ============================================================
"""
}

def startGaiaProcesses(script) {
    script.bat """
@echo off
echo ============================================================
echo 🚀 STARTING BACKEND AND FRONTEND
echo ============================================================
schtasks /run /tn "${script.env.START_TASK}"
"""
    script.sleep(time: script.params.STARTUP_WAIT_SECONDS.toInteger(), unit: 'SECONDS')
}

def checkoutRepository(script) {
    script.deleteDir()

    script.checkout([
        $class: 'GitSCM',
        branches: [[name: script.env.GIT_BRANCH]],
        userRemoteConfigs: [[url: script.env.GIT_URL, credentialsId: script.env.GIT_CRED]],
        extensions: [
            [$class: 'CloneOption', shallow: false, noTags: false, timeout: 30]
        ]
    ])

    script.echo '============================================================'
    script.echo '✅ CHECKOUT COMPLETED'
    script.echo "📁 Workspace: ${currentWorkspace(script)}"
    script.echo '============================================================'
}

def prepareReportsFolder(script) {
    def reportsRoot = currentReportsRoot(script)

    script.bat """
@echo off
if exist "${reportsRoot}" rmdir /s /q "${reportsRoot}"
mkdir "${reportsRoot}"
mkdir "${reportsRoot}\\logs"
mkdir "${reportsRoot}\\dashboard"
"""

    script.writeFile(
        file: "${reportsRoot}\\suite-results.json",
        text: '[]',
        encoding: 'UTF-8'
    )

    script.writeFile(
        file: "${reportsRoot}\\dashboard\\index.html",
        text: getInitialDashboardHtml(),
        encoding: 'UTF-8'
    )
}

def runSuite(script, Map suite) {
    printSuiteHeader(script, suite.name, suite.path, script.params.SUITE_TIMEOUT_MINUTES)

    def suiteKey = safeFileName(suite.name)
    def suiteStartedAt = new Date().format("yyyy-MM-dd'T'HH:mm:ss")
    def projectPath = currentProjectPath(script)
    def reportsRoot = currentReportsRoot(script)

    def exitCode = script.withEnv([
        "SUITE_NAME=${suite.name}",
        "SUITE_PATH=${suite.path}",
        "SUITE_KEY=${suiteKey}",
        "BROWSER=${script.params.BROWSER}",
        "SUITE_TIMEOUT_MINUTES=${script.params.SUITE_TIMEOUT_MINUTES}",
        "PROJECT_PATH=${projectPath}",
        "REPORTS_ROOT=${reportsRoot}"
    ]) {
        script.powershell(
            returnStatus: true,
            script: '''
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

function Stop-ProcessTree {
    param([int]$ProcessId)

    $children = Get-CimInstance Win32_Process -Filter "ParentProcessId=$ProcessId" -ErrorAction SilentlyContinue
    foreach ($child in $children) {
        Stop-ProcessTree -ProcessId $child.ProcessId
    }

    Stop-Process -Id $ProcessId -Force -ErrorAction SilentlyContinue
}

function Read-NewContent {
    param(
        [string]$Path,
        [ref]$Offset
    )

    if (-not (Test-Path $Path)) {
        return @()
    }

    $fs = $null
    $sr = $null

    try {
        $fs = [System.IO.File]::Open($Path, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, [System.IO.FileShare]::ReadWrite)
        [void]$fs.Seek($Offset.Value, [System.IO.SeekOrigin]::Begin)
        $sr = New-Object System.IO.StreamReader($fs)
        $content = $sr.ReadToEnd()
        $Offset.Value = $fs.Position

        if ([string]::IsNullOrWhiteSpace($content)) {
            return @()
        }

        return @($content -split "`r?`n")
    }
    catch {
        return @()
    }
    finally {
        if ($sr) { $sr.Close() }
        if ($fs) { $fs.Close() }
    }
}

function Emit-NewLines {
    param(
        [string]$Path,
        [ref]$Offset,
        [string]$Prefix
    )

    $lines = Read-NewContent -Path $Path -Offset $Offset
    foreach ($line in $lines) {
        if (-not [string]::IsNullOrWhiteSpace($line)) {
            Write-Host ($Prefix + $line)
        }
    }
}

function Find-ExecutionLog {
    param([string]$Root)

    $candidate = Get-ChildItem -Path $Root -Filter 'execution0.log' -File -Recurse -ErrorAction SilentlyContinue |
        Where-Object {
            $_.FullName -notmatch '\\\\logs\\\\' -and
            $_.FullName -notmatch '\\\\dashboard\\\\' -and
            $_.FullName -notmatch '\\\\Self-healing\\\\'
        } |
        Sort-Object LastWriteTime -Descending |
        Select-Object -First 1

    if ($candidate) {
        return $candidate.FullName
    }

    return ''
}

$stdoutLog = Join-Path $env:REPORTS_ROOT ("logs\\" + $env:SUITE_KEY + ".log")
$stderrLog = Join-Path $env:REPORTS_ROOT ("logs\\" + $env:SUITE_KEY + ".err.log")

if (Test-Path $stdoutLog) { Remove-Item $stdoutLog -Force -ErrorAction SilentlyContinue }
if (Test-Path $stderrLog) { Remove-Item $stderrLog -Force -ErrorAction SilentlyContinue }

$argString = @(
    '-noSplash',
    '-runMode=console',
    '-consoleLog',
    ('-projectPath="' + $env:PROJECT_PATH + '"'),
    '-retry=0',
    ('-testSuitePath="' + $env:SUITE_PATH + '"'),
    ('-browserType="' + $env:BROWSER + '"'),
    ('-reportFolder="' + $env:REPORTS_ROOT + '"')
) -join ' '

Write-Host '============================================================'
Write-Host ('🚀 KATALON START | ' + $env:SUITE_NAME)
Write-Host ('📁 Project      | ' + $env:PROJECT_PATH)
Write-Host ('🧪 Suite        | ' + $env:SUITE_PATH)
Write-Host ('🌐 Browser      | ' + $env:BROWSER)
Write-Host ('📂 Reports      | ' + $env:REPORTS_ROOT)
Write-Host '============================================================'

$process = Start-Process `
    -FilePath $env:KATALON_EXE `
    -ArgumentList $argString `
    -PassThru `
    -NoNewWindow `
    -RedirectStandardOutput $stdoutLog `
    -RedirectStandardError $stderrLog

$stdoutOffset = 0L
$stderrOffset = 0L
$executionOffset = 0L
$executionFile = ''
$timeoutAt = (Get-Date).AddMinutes([int]$env:SUITE_TIMEOUT_MINUTES)

while (-not $process.HasExited) {
    Emit-NewLines -Path $stdoutLog -Offset ([ref]$stdoutOffset) -Prefix '[KATALON] '
    Emit-NewLines -Path $stderrLog -Offset ([ref]$stderrOffset) -Prefix '[STDERR] '

    if (-not $executionFile) {
        $executionFile = Find-ExecutionLog -Root $env:REPORTS_ROOT
        if ($executionFile) {
            Write-Host ('[EXECUTION0] File detected: ' + $executionFile)
        }
    }

    if ($executionFile) {
        Emit-NewLines -Path $executionFile -Offset ([ref]$executionOffset) -Prefix '[EXECUTION0] '
    }

    if ((Get-Date) -ge $timeoutAt) {
        Write-Host '[TIMEOUT] Suite exceeded configured timeout'
        Stop-ProcessTree -ProcessId $process.Id

        Emit-NewLines -Path $stdoutLog -Offset ([ref]$stdoutOffset) -Prefix '[KATALON] '
        Emit-NewLines -Path $stderrLog -Offset ([ref]$stderrOffset) -Prefix '[STDERR] '
        if ($executionFile) {
            Emit-NewLines -Path $executionFile -Offset ([ref]$executionOffset) -Prefix '[EXECUTION0] '
        }

        if (Test-Path $stderrLog) {
            Add-Content -Path $stdoutLog -Value ''
            Add-Content -Path $stdoutLog -Value '==== STDERR ===='
            Get-Content $stderrLog | Add-Content -Path $stdoutLog
            Remove-Item $stderrLog -Force -ErrorAction SilentlyContinue
        }

        exit 124
    }

    Start-Sleep -Seconds 2
    try { $process.Refresh() } catch {}
}

Emit-NewLines -Path $stdoutLog -Offset ([ref]$stdoutOffset) -Prefix '[KATALON] '
Emit-NewLines -Path $stderrLog -Offset ([ref]$stderrOffset) -Prefix '[STDERR] '
if ($executionFile) {
    Emit-NewLines -Path $executionFile -Offset ([ref]$executionOffset) -Prefix '[EXECUTION0] '
}

if (Test-Path $stderrLog) {
    Add-Content -Path $stdoutLog -Value ''
    Add-Content -Path $stdoutLog -Value '==== STDERR ===='
    Get-Content $stderrLog | Add-Content -Path $stdoutLog
    Remove-Item $stderrLog -Force -ErrorAction SilentlyContinue
}

exit $process.ExitCode
'''
        )
    }

    def metaText = script.withEnv([
        "SUITE_NAME=${suite.name}",
        "SUITE_KEY=${suiteKey}",
        "RUN_EXIT=${exitCode}",
        "SUITE_STARTED_AT=${suiteStartedAt}",
        "REPORTS_ROOT=${reportsRoot}"
    ]) {
        script.powershell(
            returnStdout: true,
            script: '''
$ErrorActionPreference = 'SilentlyContinue'
$ProgressPreference = 'SilentlyContinue'

function Clean-Text {
    param([string]$Value)

    if ([string]::IsNullOrWhiteSpace($Value)) { return '' }

    $text = $Value -replace '[\\r\\n]+', ' '
    $text = $text -replace '\\s+', ' '
    $text = $text -replace '\\|', '/'
    return $text.Trim()
}

function Short-Text {
    param([string]$Value, [int]$Max = 150)

    $text = Clean-Text $Value
    if ($text.Length -gt $Max) {
        return $text.Substring(0, $Max - 3) + '...'
    }

    return $text
}

function To-RelPath {
    param(
        [string]$Root,
        [string]$FullPath
    )

    if ([string]::IsNullOrWhiteSpace($FullPath)) { return '' }
    if (-not $FullPath.StartsWith($Root)) { return '' }

    $rel = $FullPath.Substring($Root.Length)
    if ($rel.StartsWith('\\')) {
        $rel = $rel.Substring(1)
    }

    return $rel.Replace('\\', '/')
}

$root = $env:REPORTS_ROOT
$suiteName = $env:SUITE_NAME
$suiteKey = $env:SUITE_KEY
$runExit = [int]$env:RUN_EXIT
$suiteStartedAt = Get-Date $env:SUITE_STARTED_AT

$logFile = Join-Path $root ("logs\\" + $suiteKey + ".log")
$reportDir = ''
$junitFile = ''
$htmlFile = ''
$executionFile = ''
$executed = 0
$passed = 0
$failed = 0
$skipped = 0
$reason = ''
$caseLines = @()
$stepLines = @()

$candidates = Get-ChildItem -Path $root -Directory -Recurse -ErrorAction SilentlyContinue |
    Where-Object {
        $_.FullName -notmatch '\\\\dashboard($|\\\\)' -and
        $_.FullName -notmatch '\\\\logs($|\\\\)' -and
        $_.FullName -notmatch '\\\\Self-healing($|\\\\)' -and
        $_.LastWriteTime -ge $suiteStartedAt.AddMinutes(-1) -and
        (
            (Test-Path (Join-Path $_.FullName 'execution0.log')) -or
            (Get-ChildItem -Path $_.FullName -Filter 'JUnit_Report.xml' -File -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1) -or
            (Get-ChildItem -Path $_.FullName -Filter '*.html' -File -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1)
        )
    } |
    Sort-Object LastWriteTime -Descending

if ($candidates) {
    $reportDir = $candidates[0].FullName
}

if ($reportDir -and (Test-Path $reportDir)) {
    $executionCandidate = Get-ChildItem -Path $reportDir -Filter 'execution0.log' -File -Recurse -ErrorAction SilentlyContinue |
        Sort-Object LastWriteTime -Descending |
        Select-Object -First 1

    if ($executionCandidate) {
        $executionFile = $executionCandidate.FullName
    }

    $junitCandidate = Get-ChildItem -Path $reportDir -Filter 'JUnit_Report.xml' -File -Recurse -ErrorAction SilentlyContinue |
        Sort-Object LastWriteTime -Descending |
        Select-Object -First 1

    if ($junitCandidate) {
        $junitFile = $junitCandidate.FullName
    }

    $htmlCandidates = @(
        (Join-Path $reportDir 'report.html'),
        (Join-Path $reportDir 'index.html'),
        (Join-Path $reportDir 'cucumber_report\\cucumber-html-reports\\overview-features.html'),
        (Join-Path $reportDir 'cucumber_report\\cucumber-html-reports\\overview-tags.html')
    )

    foreach ($candidate in $htmlCandidates) {
        if ($candidate -and (Test-Path $candidate)) {
            $htmlFile = $candidate
            break
        }
    }

    if (-not $htmlFile) {
        $htmlCandidate = Get-ChildItem -Path $reportDir -Filter '*.html' -File -Recurse -ErrorAction SilentlyContinue |
            Sort-Object LastWriteTime -Descending |
            Select-Object -First 1

        if ($htmlCandidate) {
            $htmlFile = $htmlCandidate.FullName
        }
    }
}

if ($junitFile -and (Test-Path $junitFile)) {
    try {
        [xml]$xml = Get-Content $junitFile

        $testcases = @()

        if ($xml.testsuite) {
            $testcases = @($xml.testsuite.testcase)
        }
        elseif ($xml.testsuites) {
            foreach ($ts in @($xml.testsuites.testsuite)) {
                $testcases += @($ts.testcase)
            }
        }

        $testcases = @($testcases | Where-Object { $_ })
        $executed = $testcases.Count

        $failedNodes = @($testcases | Where-Object { $_.failure -or $_.error })
        $skippedNodes = @($testcases | Where-Object { $_.skipped })

        $failed = $failedNodes.Count
        $skipped = $skippedNodes.Count
        $passed = $executed - $failed - $skipped

        foreach ($tc in ($testcases | Select-Object -First 3)) {
            $caseName = Short-Text $tc.name 85

            if ($tc.failure -or $tc.error) {
                $msg = ''
                if ($tc.failure) {
                    $msg = Short-Text (($tc.failure.message + ' ' + $tc.failure.InnerText)) 70
                }
                elseif ($tc.error) {
                    $msg = Short-Text (($tc.error.message + ' ' + $tc.error.InnerText)) 70
                }

                $caseLines += ('❌ ' + $caseName + ' | ' + $msg)
            }
            elseif ($tc.skipped) {
                $caseLines += ('⏭️ ' + $caseName + ' | skipped')
            }
            else {
                $caseLines += ('✅ ' + $caseName + ' | passed')
            }
        }

        if ($failedNodes.Count -gt 0) {
            $firstBad = $failedNodes[0]

            if ($firstBad.failure) {
                $reason = Short-Text (($firstBad.failure.message + ' ' + $firstBad.failure.InnerText)) 150
            }
            elseif ($firstBad.error) {
                $reason = Short-Text (($firstBad.error.message + ' ' + $firstBad.error.InnerText)) 150
            }
        }
    }
    catch {
        $reason = Short-Text $_.Exception.Message 150
    }
}

if ($executionFile -and (Test-Path $executionFile)) {
    $lastLine = ''

    foreach ($line in (Get-Content $executionFile -ErrorAction SilentlyContinue)) {
        $text = Clean-Text $line
        if (-not $text) { continue }

        if ($text -match '(?i)Scenario(?: Outline)?\\s*[:\\-]?\\s*(.+)$') {
            $formatted = '🎬 ' + (Short-Text $Matches[1] 120)
            if ($formatted -ne $lastLine -and $stepLines.Count -lt 10) {
                $stepLines += $formatted
                $lastLine = $formatted
            }
            continue
        }

        if ($text -match '(?i)\\b(Given|When|Then|And|But)\\b\\s+(.+)$') {
            $step = ($Matches[1] + ' ' + $Matches[2]).Trim()
            $step = $step -replace '(?i)\\s*(PASSED|FAILED|SKIPPED|ERROR|SUCCESS).*$', ''
            $step = Short-Text $step 130

            $prefix = '➡️ '
            if ($text -match '(?i)\\bFAILED\\b|\\bERROR\\b|\\bEXCEPTION\\b|TIMED OUT|TIMEOUT|NOT FOUND') {
                $prefix = '❌ '
            }
            elseif ($text -match '(?i)\\bSKIPPED\\b') {
                $prefix = '⏭️ '
            }
            elseif ($text -match '(?i)\\bPASSED\\b|\\bSUCCESS\\b') {
                $prefix = '✅ '
            }

            $formatted = $prefix + $step
            if ($formatted -ne $lastLine -and $stepLines.Count -lt 10) {
                $stepLines += $formatted
                $lastLine = $formatted
            }
        }
    }
}

if (-not $reason -and (Test-Path $logFile)) {
    $logHints = Get-Content $logFile -ErrorAction SilentlyContinue |
        Where-Object {
            $_ -match 'StepFailedException|ERROR|Caused by|Unable to|not found|timed out|Timeout|failed|InvalidConsoleArgumentException'
        } |
        Select-Object -Last 3

    if ($logHints) {
        $reason = Short-Text (($logHints -join ' ')) 150
    }
}

$status = 'PASSED'
$icon = '✅'
$line1 = 'Suite finished successfully'
$line2 = 'All reported checks passed'
$line3 = 'Open the detailed report for execution evidence'

if ($runExit -eq 124) {
    $status = 'TIMEOUT'
    $icon = '⏰'
    $line1 = 'Execution timed out'
    $line2 = 'Suite exceeded the configured time limit'
    $line3 = 'Review slow steps or increase suite timeout'
}
elseif ($failed -gt 0 -or $runExit -ne 0) {
    $status = 'FAILED'
    $icon = '❌'
    $line1 = 'One or more checks failed'
    if ([string]::IsNullOrWhiteSpace($reason)) {
        $line2 = 'A failing step was detected during execution'
    }
    else {
        $line2 = $reason
    }
    $line3 = 'Open the detailed report for error evidence'
}
elseif ($executed -eq 0 -and $runExit -eq 0) {
    $status = 'PASSED'
    $icon = '✅'
    $line1 = 'Execution finished without technical errors'
    $line2 = 'No structured JUnit counters were found'
    $line3 = 'Open the detailed report for execution evidence'
}

$reportRel = To-RelPath -Root $root -FullPath $htmlFile
$logRel = To-RelPath -Root $root -FullPath $logFile

Write-Output ('SUITE_NAME=' + $suiteName)
Write-Output ('STATUS=' + $status)
Write-Output ('ICON=' + $icon)
Write-Output ('EXIT_CODE=' + $runExit)
Write-Output ('EXECUTED=' + $executed)
Write-Output ('PASSED=' + $passed)
Write-Output ('FAILED=' + $failed)
Write-Output ('SKIPPED=' + $skipped)
Write-Output ('LINE1=' + (Short-Text $line1 150))
Write-Output ('LINE2=' + (Short-Text $line2 150))
Write-Output ('LINE3=' + (Short-Text $line3 150))
Write-Output ('REASON=' + (Short-Text $reason 150))
Write-Output ('REPORT_REL=' + $reportRel)
Write-Output ('LOG_REL=' + $logRel)
Write-Output ('CASE_SUMMARY=' + (($caseLines -join ' || ')))
Write-Output ('STEP_SUMMARY=' + (($stepLines -join ' || ')))
'''
        ).trim()
    }

    def meta = parseKeyValue(metaText)

    return [
        name       : suite.name,
        path       : suite.path,
        status     : meta['STATUS'] ?: (exitCode == 0 ? 'PASSED' : (exitCode == 124 ? 'TIMEOUT' : 'FAILED')),
        icon       : meta['ICON'] ?: (exitCode == 0 ? '✅' : (exitCode == 124 ? '⏰' : '❌')),
        exitCode   : meta['EXIT_CODE'] ?: "${exitCode}",
        executed   : meta['EXECUTED'] ?: '0',
        passed     : meta['PASSED'] ?: '0',
        failed     : meta['FAILED'] ?: '0',
        skipped    : meta['SKIPPED'] ?: '0',
        line1      : meta['LINE1'] ?: '',
        line2      : meta['LINE2'] ?: '',
        line3      : meta['LINE3'] ?: '',
        reason     : meta['REASON'] ?: '',
        reportRel  : meta['REPORT_REL'] ?: '',
        logRel     : meta['LOG_REL'] ?: '',
        caseSummary: splitSummary(meta['CASE_SUMMARY'] ?: ''),
        stepSummary: splitSummary(meta['STEP_SUMMARY'] ?: '')
    ]
}

def saveSuiteResults(script, List results) {
    def reportsRoot = currentReportsRoot(script)
    def json = groovy.json.JsonOutput.prettyPrint(groovy.json.JsonOutput.toJson(results))
    script.writeFile(file: "${reportsRoot}\\suite-results.json", text: json, encoding: 'UTF-8')
}

def loadSuiteResults(script) {
    def filePath = "${currentReportsRoot(script)}\\suite-results.json"

    if (!script.fileExists(filePath)) {
        return []
    }

    def text = script.readFile(file: filePath, encoding: 'UTF-8')
    if (!text?.trim()) {
        return []
    }

    return new groovy.json.JsonSlurperClassic().parseText(text)
}

