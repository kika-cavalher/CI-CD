	// ======================================================
	// SWITCH TO OTHER USER
	// ======================================================

	@Keyword
	Map switchToOtherUser(
			String targetEnvironment,
			String alternateUsername,
			String alternatePassword,
			Integer timeoutSeconds
	) {

		stopImmediatelyIfFatalFailureWasAlreadyDetected()

		String environment = normalizeEnvironment(targetEnvironment)
		String username = safeAuthenticationText(alternateUsername)
		String password = alternatePassword == null ? '' : alternatePassword.toString()
		Integer timeout = timeoutSeconds != null && timeoutSeconds > 0 ? timeoutSeconds : DEFAULT_SWITCH_USER_TIMEOUT_SECONDS

		if (username.isEmpty()) {
			KeywordUtil.markFailedAndStop('Alternate username cannot be empty.')
			return [:]
		}

		if (password.isEmpty()) {
			KeywordUtil.markFailedAndStop('Alternate password cannot be empty.')
			return [:]
		}

		clickSwitchUserImageFirstThenObject('settingsButton', 'settingsButton', 'Settings button', timeout)
		Windows.delay(SWITCH_USER_DELAY_SECONDS)

		clickSwitchUserImageFirstThenObject('changeEnvironmentButton', 'changeEnvironmentButton', 'Change environment button', timeout)
		Windows.delay(SWITCH_USER_DELAY_SECONDS)

		clickSwitchUserImageFirstThenObject('yesWarningButton', 'switchEnvironmentWarningYesButton', 'Switch environment confirmation button', timeout)

		WindowsTestObject environmentCombo = WindowsObjectLoader.getObject(AUTHENTICATION_OBJECT_GROUP, 'environmentCombo')

		if (!Windows.waitForElementPresent(environmentCombo, timeout, FailureHandling.OPTIONAL)) {
			KeywordUtil.markFailedAndStop(
					'Environment combo was not displayed after confirming the environment change.\n' +
					'Environment: ' + environment
					)
			return [:]
		}

		clickElementCenterByCoordinates(environmentCombo)
		Thread.sleep(300L)
		selectFocusedEMatchComboByKeyboard(environment)
		Windows.delay(SWITCH_USER_DELAY_SECONDS)

		WindowsTestObject otherUserCheckbox = WindowsObjectLoader.getObject(AUTHENTICATION_OBJECT_GROUP, 'connectWithOtherUserCheckBox')

		if (!Windows.waitForElementPresent(otherUserCheckbox, timeout, FailureHandling.OPTIONAL)) {
			KeywordUtil.markFailedAndStop('Connect with another account checkbox was not displayed.')
			return [:]
		}

		Windows.click(otherUserCheckbox, FailureHandling.STOP_ON_FAILURE)
		Windows.delay(SWITCH_USER_DELAY_SECONDS)

		replaceAuthenticationText('userNameText', username, timeout)
		replaceAuthenticationText('passwordText', password, timeout)

		WindowsTestObject connectButton = WindowsObjectLoader.getObject(AUTHENTICATION_OBJECT_GROUP, 'connectButton')

		if (!Windows.waitForElementPresent(connectButton, timeout, FailureHandling.OPTIONAL)) {
			KeywordUtil.markFailedAndStop('Connect button was not displayed for the alternate user login.')
			return [:]
		}

		try {
			clickElementCenterByCoordinates(connectButton)
		} catch (Throwable coordinateError) {
			KeywordUtil.logInfo(
					'Coordinate click on alternate user connect button failed. Trying standard click. Reason: ' +
					safeAuthenticationText(coordinateError.message)
					)
			Windows.click(connectButton, FailureHandling.STOP_ON_FAILURE)
		}

		if (!waitUntilLoginScreenIsClosed(timeout)) {
			KeywordUtil.markFailedAndStop(
					'Alternate user credentials were submitted, but the main screen was not displayed.\n' +
					'Environment: ' + environment + '\nExpected user: ' + username
					)
			return [:]
		}

		WindowsTestObject loggedUserName = WindowsObjectLoader.getObject(AUTHENTICATION_OBJECT_GROUP, 'loggedUserName')

		if (!Windows.waitForElementPresent(loggedUserName, timeout, FailureHandling.OPTIONAL)) {
			KeywordUtil.markFailedAndStop(
					'Logged username element was not displayed after switching user.\n' +
					'Expected user: ' + username
					)
			return [:]
		}

		String actualLoggedUser = safeAuthenticationText(Windows.getText(loggedUserName))

		if (!actualLoggedUser.equalsIgnoreCase(username)) {
			KeywordUtil.markFailedAndStop(
					'Application was not logged with the expected alternate user.\n' +
					'Expected: ' + username + '\nActual: ' + actualLoggedUser
					)
			return [:]
		}

		saveCurrentEnvironment(environment)

		KeywordUtil.logInfo(
				'[PASS] Alternate user login completed successfully.\n' +
				'Environment: ' + environment + '\nUser: ' + actualLoggedUser
				)

		return [
			environment : environment,
			expectedUser: username,
			actualUser  : actualLoggedUser
		]
	}


	private void clickSwitchUserImageFirstThenObject(
			String imageKey,
			String objectKey,
			String description,
			Integer timeoutSeconds
	) {

		Integer timeout = timeoutSeconds != null && timeoutSeconds > 0 ? timeoutSeconds : DEFAULT_SWITCH_USER_TIMEOUT_SECONDS
		Integer imageTimeout = Math.min(timeout, SWITCH_USER_IMAGE_TIMEOUT_SECONDS)

		try {
			if (imageLoader.waitForImage(AUTHENTICATION_IMAGE_GROUP, imageKey, imageTimeout)) {
				WindowsImageKeywords.clickImage(
						imageLoader.getImage(AUTHENTICATION_IMAGE_GROUP, imageKey)
						)
				KeywordUtil.logInfo('[IMAGE] ' + description + ' clicked.')
				return
			}
		} catch (Throwable imageError) {
			KeywordUtil.logInfo(
					'[IMAGE] Could not click ' + description +
					'. Trying Windows object.\nReason: ' +
					safeAuthenticationText(imageError.message)
					)
		}

		WindowsTestObject targetObject = WindowsObjectLoader.getObject(AUTHENTICATION_OBJECT_GROUP, objectKey)

		if (!Windows.waitForElementPresent(targetObject, timeout, FailureHandling.OPTIONAL)) {
			KeywordUtil.markFailedAndStop(
					description + ' was not found by image or Windows object.\n' +
					'Image: ' + AUTHENTICATION_IMAGE_GROUP + '.' + imageKey + '\n' +
					'Object: ' + AUTHENTICATION_OBJECT_GROUP + '.' + objectKey
					)
			return
		}

		Windows.click(targetObject, FailureHandling.STOP_ON_FAILURE)
		KeywordUtil.logInfo('[OBJECT] ' + description + ' clicked.')
	}


	private void replaceAuthenticationText(
			String objectKey,
			String value,
			Integer timeoutSeconds
	) {

		WindowsTestObject inputObject = WindowsObjectLoader.getObject(AUTHENTICATION_OBJECT_GROUP, objectKey)

		if (!Windows.waitForElementPresent(inputObject, timeoutSeconds, FailureHandling.OPTIONAL)) {
			KeywordUtil.markFailedAndStop(
					'Authentication input was not displayed.\n' +
					'Object: ' + AUTHENTICATION_OBJECT_GROUP + '.' + objectKey
					)
			return
		}

		Windows.click(inputObject, FailureHandling.STOP_ON_FAILURE)

		Robot robot = new Robot()
		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_A)
