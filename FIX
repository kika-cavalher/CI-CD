package jiraIntegration

import groovy.util.XmlSlurper

import java.text.SimpleDateFormat
import java.util.Locale

class JiraReportBuilder {

	private static final int MAX_STEP_ROWS = 300
	private static final int MAX_EVIDENCES = 24

	File buildReport(File reportFolder, String suiteDisplayName, String executionTitle) {
		if (reportFolder == null || !reportFolder.exists()) {
			throw new RuntimeException('Report folder was not found.')
		}

		File junitXml = findJUnitXml(reportFolder)
		File csvFile = findFirstCsv(reportFolder)

		List<Map> testCases = parseJunit(junitXml)
		List<Map> stepRows = parseCsv(csvFile)
		List<Map> evidences = collectEvidenceImages(reportFolder)

		Map summary = buildSummary(testCases)

		String generatedAt = new SimpleDateFormat('yyyy-MM-dd HH:mm:ss').format(new Date())

		String html = new JiraGaiaHtmlTemplateBuilder().build([
			suiteName      : suiteDisplayName,
			executionTitle : executionTitle,
			generatedAt    : generatedAt,
			headerSubtitle : 'Non-Gherkin flow using native Katalon artifacts, failures, CSV and screenshots',
			summary        : summary,
			testCases      : testCases,
			stepRows       : stepRows.take(MAX_STEP_ROWS),
			evidences      : evidences.take(MAX_EVIDENCES)
		])

		File output = new File(reportFolder, 'JiraReport.html')
		output.write(html, 'UTF-8')

		return output
	}

	File findJUnitXml(File reportFolder) {
		List<File> xmls = findFilesByName(reportFolder, 'JUnit_Report.xml')

		if (!xmls.isEmpty()) {
			return xmls.sort { -it.lastModified() }[0]
		}

		List<File> anyXml = findFilesByExtension(reportFolder, '.xml')
		if (!anyXml.isEmpty()) {
			return anyXml.sort { -it.lastModified() }[0]
		}

		return null
	}

	private File findFirstCsv(File reportFolder) {
		List<File> csvs = findFilesByExtension(reportFolder, '.csv')
		if (csvs.isEmpty()) {
			return null
		}

		return csvs.sort { -it.lastModified() }[0]
	}

	private List<Map> parseJunit(File junitXml) {
		if (junitXml == null || !junitXml.exists()) {
			return []
		}

		def xml = new XmlSlurper(false, false).parse(junitXml)

		def testCaseNodes = xml.depthFirst().findAll { node ->
			node.name() == 'testcase'
		}

		return testCaseNodes.collect { tc ->
			String failureMessage = ''
			String failureDetail = ''
			String status = 'PASS'

			if (tc.failure?.size() > 0) {
				status = 'FAIL'
				failureMessage = safe(tc.failure[0].@message?.text())
				failureDetail = safe(tc.failure[0].text())
			} else if (tc.error?.size() > 0) {
				status = 'FAIL'
				failureMessage = safe(tc.error[0].@message?.text())
				failureDetail = safe(tc.error[0].text())
			} else if (tc.skipped?.size() > 0) {
				status = 'SKIP'
				failureMessage = safe(tc.skipped[0].@message?.text())
				failureDetail = safe(tc.skipped[0].text())
			}

			return [
				name          : safe(tc.@name?.text()),
				className     : safe(tc.@classname?.text()),
				time          : normalizeTime(tc.@time?.text()),
				status        : status,
				failureMessage: trimLargeText(failureMessage, 1200),
				failureDetail : trimLargeText(failureDetail, 4000)
			]
		}
	}

	private Map buildSummary(List<Map> testCases) {
		int total = testCases.size()
		int passed = testCases.count { safe(it.status).equalsIgnoreCase('PASS') }
		int failed = testCases.count { safe(it.status).equalsIgnoreCase('FAIL') }
		int skipped = testCases.count { safe(it.status).equalsIgnoreCase('SKIP') }

		BigDecimal duration = 0
		testCases.each { Map tc ->
			try {
				duration += new BigDecimal(safe(tc.time) ?: '0')
			} catch (Exception ignored) {
			}
		}

		return [
			total   : total,
			passed  : passed,
			failed  : failed,
			skipped : skipped,
			duration: duration.setScale(3, BigDecimal.ROUND_HALF_UP).toPlainString()
		]
	}

	private List<Map> parseCsv(File csvFile) {
		if (csvFile == null || !csvFile.exists()) {
			return []
		}

		List<String> lines = csvFile.readLines('UTF-8').findAll { String line ->
			line != null && line.trim().length() > 0
		}

		if (lines.size() < 2) {
			return []
		}

		List<String> headers = splitCsvLine(lines[0])

		List<Map> rows = []

		lines.drop(1).each { String line ->
			List<String> values = splitCsvLine(line)
			Map row = [:]

			for (int i = 0; i < headers.size(); i++) {
				String key = safe(headers[i])
				String value = i < values.size() ? safe(values[i]) : ''
				row[key] = value
			}

			rows << row
		}

		return rows
	}

	private List<Map> collectEvidenceImages(File reportFolder) {
		List<File> images = []

		reportFolder.eachFileRecurse { File file ->
			if (file.isFile()) {
				String name = file.name.toLowerCase(Locale.ENGLISH)
				if (name.endsWith('.png') || name.endsWith('.jpg') || name.endsWith('.jpeg') || name.endsWith('.gif')) {
					images << file
				}
			}
		}

		images = images.sort { -it.lastModified() }

		return images.collect { File file ->
			[
				name        : file.name,
				relativePath: toRelativePath(reportFolder, file)
			]
		}
	}

	private List<File> findFilesByName(File root, String expectedName) {
		List<File> files = []
		root.eachFileRecurse { File file ->
			if (file.isFile() && file.name.equalsIgnoreCase(expectedName)) {
				files << file
			}
		}
		return files
	}

	private List<File> findFilesByExtension(File root, String extension) {
		List<File> files = []
		root.eachFileRecurse { File file ->
			if (file.isFile() && file.name.toLowerCase(Locale.ENGLISH).endsWith(extension.toLowerCase(Locale.ENGLISH))) {
				files << file
			}
		}
		return files
	}

	private String toRelativePath(File root, File file) {
		try {
			return root.toPath().relativize(file.toPath()).toString().replace('\\', '/')
		} catch (Exception ignored) {
			return file.name
		}
	}

	private String normalizeTime(Object value) {
		String text = safe(value)
		if (text.isEmpty()) {
			return '0.000'
		}

		try {
			return new BigDecimal(text).setScale(3, BigDecimal.ROUND_HALF_UP).toPlainString()
		} catch (Exception ignored) {
			return '0.000'
		}
	}

	private String trimLargeText(String text, int maxLength) {
		String clean = safe(text)
		if (clean.length() <= maxLength) {
			return clean
		}
		return clean.substring(0, maxLength) + '\n\n...[truncated]'
	}

	private List<String> splitCsvLine(String line) {
		List<String> values = []
		StringBuilder current = new StringBuilder()
		boolean inQuotes = false

		for (int i = 0; i < line.length(); i++) {
			char ch = line.charAt(i)

			if (ch == '"') {
				if (inQuotes && i + 1 < line.length() && line.charAt(i + 1) == '"') {
					current.append('"')
					i++
				} else {
					inQuotes = !inQuotes
				}
			} else if (ch == ',' && !inQuotes) {
				values << current.toString()
				current.setLength(0)
			} else {
				current.append(ch)
			}
		}

		values << current.toString()

		return values.collect { String item ->
			safe(item)
		}
	}

	private String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}
}
