import groovy.json.JsonSlurperClassic

def safeFileName(String value) {
    return (value ?: 'asset')
        .replaceAll(/[\\\\\\/:"*?<>|]+/, '_')
        .replaceAll(/\s+/, '_')
}

def toLong(def value) {
    try {
        return (value ?: '0').toString().trim().toLong()
    }
    catch (ignored) {
        return 0L
    }
}

def relativeLogPath(String currentLogFile, String reportsRoot) {
    String log = (currentLogFile ?: '').replace('\\', '/')
    String root = (reportsRoot ?: '').replace('\\', '/')

    if (root && log.startsWith(root + '/')) {
        return log.substring(root.length() + 1)
    }

    return '_desktop_logs/katalon_current.log'
}

def loadResultFile(script, String resultFile, Map fallback) {
    if (!script.fileExists(resultFile)) {
        return fallback
    }

    try {
        String raw = script.readFile(file: resultFile, encoding: 'UTF-8')
        if (!raw?.trim()) {
            return fallback
        }

        def parsed = new JsonSlurperClassic().parseText(raw)
        return (parsed instanceof Map) ? parsed : fallback
    }
    catch (ignored) {
        return fallback
    }
}

