	@Keyword
	String validateEvidenceFolderExists(String folderPath) {

		StringBuilder errors = new StringBuilder()

		File folder = new File(safeText(folderPath))

		KeywordUtil.logInfo("📁 [VALIDATE FOLDER] " + folder.getAbsolutePath())

		if (!folder.exists()) {
			errors.append("[ERROR] Evidence folder does not exist: ").append(folder.getAbsolutePath()).append("\n")
		} else if (!folder.isDirectory()) {
			errors.append("[ERROR] Evidence path is not a folder: ").append(folder.getAbsolutePath()).append("\n")
		}

		return errors.toString()
	}

	@Keyword
	String resolveExcelFilesAsString(String folderPath, String requestedFileNames, String includeSubFoldersText) {

		File folder = new File(safeText(folderPath))
		boolean includeSubFolders = isTrue(includeSubFoldersText)

		List<File> files = []

		List<String> requestedFiles = splitText(requestedFileNames)

		if (requestedFiles.size() > 0) {

			for (String fileName : requestedFiles) {

				File file = new File(fileName)

				if (!file.isAbsolute()) {
					file = new File(folder, fileName)
				}

				files.add(file)
			}
		} else if (folder.exists() && folder.isDirectory()) {

			files = collectExcelFiles(folder, includeSubFolders)
		}

		files = files.findAll { File file ->
			file != null && isExcelFile(file.getName()) && !file.getName().startsWith('~$')
		}

		files = files.unique { File file ->
			file.getAbsolutePath().toLowerCase()
		}

		files.sort { File file ->
			file.getAbsolutePath().toLowerCase()
		}

		String result = files.collect { File file ->
			file.getAbsolutePath()
		}.join(LIST_SEPARATOR)

		KeywordUtil.logInfo("📄 [RESOLVED FILES] " + result)

		return result
	}

