	private Map buildModel(File reportFolder, String suiteName, String executionTitle) {
		File root = reportFolder ?: new File('.')

		Map<String, Map> traceByCase = readTrace(root)
		Map<String, List<String>> evidenceByCase = readEvidenceIndex(root)
		List<File> junitFiles = collectJUnitFiles(root)
		List<Map> scenarios = []

		junitFiles.each { File junitFile ->
			scenarios.addAll(buildScenariosFromJUnit(junitFile, root, traceByCase, evidenceByCase))
		}

		if (scenarios.isEmpty()) {
			scenarios = buildFallbackFromTrace(root, traceByCase, evidenceByCase)
		}

		String resolvedSuiteName = !safe(suiteName).isEmpty() ? safe(suiteName) : detectSuiteName(root, scenarios)
		String resolvedExecutionTitle = !safe(executionTitle).isEmpty() ? safe(executionTitle) : resolvedSuiteName

		int passedCount = scenarios.count { Map row -> safe(row.status) == 'passed' }
		int failedCount = scenarios.count { Map row -> safe(row.status) == 'failed' }
		int blockedCount = scenarios.count { Map row -> safe(row.status) == 'blocked' }

		return [
