        } catch (Exception ignored) {
        }
    }

    @Keyword
    void ensureWinAppDriverRunning() {
        if (isPortOpen('127.0.0.1', 4723)) {
            KeywordUtil.logInfo('WinAppDriver port 4723 is already available.')
            return
        }

        String matchedTask = null

        for (String taskName : WINAPPDRIVER_TASK_CANDIDATES) {
            try {
                Map queryResult = runCommand("schtasks /query /tn \"${taskName}\"", 10)
                KeywordUtil.logInfo("WinAppDriver task query for '${taskName}':\n${queryResult.output ?: ''}")

                if (queryResult.exitCode == 0) {
                    matchedTask = taskName
                    break
                }
            } catch (Exception e) {
                KeywordUtil.logInfo("Could not query task '${taskName}': ${e.getMessage()}")
            }
        }

        if (matchedTask) {
            try {
                Map taskResult = runCommand("schtasks /run /tn \"${matchedTask}\"", 15)
                KeywordUtil.logInfo("WinAppDriver task run output:\n${taskResult.output ?: ''}")
            } catch (Exception e) {
                KeywordUtil.logInfo("Could not run task '${matchedTask}': ${e.getMessage()}")
            }

            long taskDeadline = System.currentTimeMillis() + (WINAPPDRIVER_TASK_WAIT_SEC * 1000L)

            while (System.currentTimeMillis() < taskDeadline) {
                if (isPortOpen('127.0.0.1', 4723)) {
                    KeywordUtil.logInfo("WinAppDriver started successfully through task '${matchedTask}'.")
                    return
                }
                Thread.sleep(1000)
            }
        } else {
            KeywordUtil.logInfo('No WinAppDriver scheduled task was found. Falling back to direct executable start.')
        }

        File exe = new File(WINAPPDRIVER_EXE)
        if (!exe.exists()) {
            KeywordUtil.markFailedAndStop("WinAppDriver not found: ${WINAPPDRIVER_EXE}")
        }

        try {
            new ProcessBuilder(WINAPPDRIVER_EXE).start()
            KeywordUtil.logInfo('WinAppDriver direct start command executed.')
        } catch (Exception e) {
            KeywordUtil.logInfo("WinAppDriver direct start failed: ${e.getMessage()}")
        }

        long deadline = System.currentTimeMillis() + (WINAPPDRIVER_START_TIMEOUT_SEC * 1000L)

        while (System.currentTimeMillis() < deadline) {
            if (isPortOpen('127.0.0.1', 4723)) {
                KeywordUtil.logInfo('WinAppDriver started successfully.')
                return
            }
            Thread.sleep(1000)
        }

        KeywordUtil.markFailedAndStop(
            "WinAppDriver did not start within ${WINAPPDRIVER_START_TIMEOUT_SEC} seconds. Path='${WINAPPDRIVER_EXE}'"
        )
    }

    private String normalizeEnvironment(String environment) {
        String env = (environment ?: '').trim().toUpperCase()

        if (!env) {
            env = REC
        }

        if (env == 'PROD') {
            env = PRD
        }

        if (!(env in [REC, PRD])) {
            KeywordUtil.markFailedAndStop("Invalid environment '${env}'. Use REC or PRD.")
        }

        return env
    }

    private void runResolutionScriptIfExists() {
        File script = new File(RESOLUTION_SCRIPT_PATH)

        if (!script.exists()) {
            return
        }

        Process process = new ProcessBuilder(
            'powershell',
            '-ExecutionPolicy',
            'Bypass',
            '-File',
            RESOLUTION_SCRIPT_PATH
        ).redirectErrorStream(true).start()

        boolean finished = process.waitFor(60, TimeUnit.SECONDS)

        if (!finished) {
            process.destroyForcibly()
            KeywordUtil.markFailedAndStop("Resolution script timed out: ${RESOLUTION_SCRIPT_PATH}")
        }

        if (process.exitValue() != 0) {
            String output = process.inputStream.getText('Cp1252')
            KeywordUtil.logInfo("Resolution script output:\n${output}")
            KeywordUtil.markFailedAndStop("Resolution script failed: ${RESOLUTION_SCRIPT_PATH}")
        }
    }

    private void clickWithRetry(String objectId, int retries, int delaySec) {
        Exception lastError = null

        for (int i = 1; i <= retries; i++) {
            try {
                Windows.click(findWindowsObject(objectId))
                return
            } catch (Exception e) {
                lastError = e
                Windows.delay(delaySec)
            }
        }

        KeywordUtil.markFailedAndStop("Could not click '${objectId}' after ${retries} attempts. Last error: ${lastError?.message}")
    }

    private String resolveExistingFileByBaseName(String configuredPath) {
        File configuredFile = new File(configuredPath)

        if (configuredFile.exists()) {
            return configuredFile.absolutePath
        }

        File parentFolder = configuredFile.parentFile
        if (parentFolder == null || !parentFolder.exists()) {
            return null
        }

        String configuredName = configuredFile.name
        String configuredBaseName = stripKnownSuffix(configuredName)

        File[] files = parentFolder.listFiles()
        if (files == null) {
            return null
        }

        File match = files.find { File f ->
            String fileName = f.name
            String fileBaseName = stripKnownSuffix(fileName)

            fileName.equalsIgnoreCase(configuredName) || fileBaseName.equalsIgnoreCase(configuredBaseName)
        }

        return match?.absolutePath
    }

    private String resolveInstalledExePath() {
        File baseFolder = new File(System.getProperty('user.home'), CLICKONCE_LOCAL_ROOT)

        if (!baseFolder.exists()) {
            return null
        }

        List<File> matches = []

        baseFolder.eachFileRecurse(FileType.FILES) { File file ->
            if (file.name.equalsIgnoreCase(EMATCH_EXE_NAME)) {
                matches << file
            }
        }

        if (!matches) {
            return null
        }

        matches.sort { a, b -> b.lastModified() <=> a.lastModified() }
        return matches.first().absolutePath
    }

    private String resolveLaunchTarget(String remoteShortcut, String localInstalledExe, String localAppRef, String applicationPath) {
        if (remoteShortcut) {
            return remoteShortcut
        }

        if (localInstalledExe) {
            return localInstalledExe
        }

        if (localAppRef) {
            return localAppRef
        }

        return applicationPath
    }

    private String stripKnownSuffix(String fileName) {
        String value = fileName ?: ''

        if (value.toLowerCase().endsWith('.lnk')) {
            return value.substring(0, value.length() - 4)
        }

        if (value.toLowerCase().endsWith('.appref-ms')) {
            return value.substring(0, value.length() - 10)
        }

        return value
    }

    private Map runCommand(String commandLine, int timeoutSec) {
        Process process = new ProcessBuilder('cmd', '/c', commandLine)
            .redirectErrorStream(true)
            .start()

        boolean finished = process.waitFor(timeoutSec, TimeUnit.SECONDS)

        if (!finished) {
            process.destroyForcibly()
            return [
                exitCode: -1,
                output  : "Command timed out after ${timeoutSec} seconds.\nCommand: ${commandLine}"
            ]
        }

        String output = process.inputStream.getText('Cp1252')

        return [
            exitCode: process.exitValue(),
            output  : output
        ]
    }

    private boolean isPortOpen(String host, int port) {
        Socket socket = null
        try {
            socket = new Socket(host, port)
            return true
        } catch (Throwable ignored) {
            return false
        } finally {
            try {
                socket?.close()
            } catch (Throwable ignored) {
            }
        }
    }
