import com.kms.katalon.core.annotation.*
import com.kms.katalon.core.context.*
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows
import org.openqa.selenium.OutputType

import javax.imageio.ImageIO
import javax.imageio.ImageWriter
import javax.imageio.plugins.jpeg.JPEGImageWriteParam
import javax.imageio.stream.MemoryCacheImageOutputStream
import java.awt.Robot
import java.awt.Rectangle
import java.awt.Toolkit
import java.awt.image.BufferedImage
import java.util.Base64

class WindowsFailureReportListener {

	static List<Map> results = []
	static Map<String, List<String>> stepsPerTest = [:]

	// === minimal additions for durations ===
	static Map<String, Long> _caseStartTimes = [:]
	static long _suiteStartMs = 0L
	static long _suiteEndMs   = 0L

	@BeforeTestSuite
	def beforeSuite(TestSuiteContext suiteCtx) {
		results.clear()
		stepsPerTest.clear()
		_caseStartTimes.clear()
		_suiteStartMs = System.currentTimeMillis() // added
	}

	// added: capture per-test start time
	@BeforeTestCase
	def beforeCase(TestCaseContext testCaseCtx) {
		_caseStartTimes[testCaseCtx.getTestCaseId()] = System.currentTimeMillis()
	}

	@AfterTestCase
	def afterCase(TestCaseContext testCaseCtx) {

		String name   = testCaseCtx.getTestCaseId()
		String status = testCaseCtx.getTestCaseStatus()

		if (!stepsPerTest.containsKey(name)) stepsPerTest[name] = []

		String raw = testCaseCtx.getMessage() ?: ""
		String summary = formatFailureMessage(raw, status)
		if (!summary?.trim()) summary = "❗ Mandatory failure\n➡️ Unknown error"

		// --- Extract file + line ---
		String stack = raw ?: ""
		String location = extractLocation(stack)

		String fullLog = raw.trim()

		// ---------- SCREENSHOT (Desktop-first, then try driver) ----------
		String screenshotBase64 = null
		if (status in ["FAILED", "ERROR"]) {
			screenshotBase64 = captureDesktopScreenshot()   // always works
			screenshotBase64 = tryDriverScreenshot(screenshotBase64) // override if driver is valid
		}

		// added: per-test duration
		long started  = _caseStartTimes[name] ?: System.currentTimeMillis()
		long ended    = System.currentTimeMillis()
		long duration = Math.max(0L, ended - started)

		results.add([
			name            : name,
			status          : status,
			summaryMessage  : summary + "\n📍 <b>${location}</b>",
			fullLog         : fullLog,
			screenshotBase64: screenshotBase64,
			durationMs      : duration // added
		])
	}

	@AfterTestSuite
	def afterSuite(TestSuiteContext suiteCtx) {

		_suiteEndMs = System.currentTimeMillis() // added
		long suiteDurationMs = Math.max(0L, _suiteEndMs - _suiteStartMs)

		String reportFolder = RunConfiguration.getReportFolder()
		File logFile = new File(reportFolder, "execution.log")
		if (logFile.exists()) parseExecutionLog(logFile)

		String reportPath = reportFolder + "/eMatchReport.html"
		File report = new File(reportPath)

		def failed  = results.findAll { it.status in ["FAILED","ERROR"] }
		def passed  = results.findAll { it.status == "PASSED" }
		def skipped = results.findAll { !(it.status in ["PASSED","FAILED","ERROR"]) }

		// added: totals and average
		int executed = results.size()
		long avgMs = executed ? (results.collect { (it.durationMs ?: 0L) }.sum() / executed) : 0L

		report.text = """
		<html>
		<head>
		<title>Windows Test Execution Report — eMatch</title>
		<meta charset="utf-8"/>
		<style>
		body { font-family: Segoe UI, Arial, sans-serif; padding:20px; }
		.group { margin-top:30px; }
		.test { margin-bottom:20px; padding:12px; background:#fafafa; border-radius:6px; white-space:pre-line; }
		.pass  { border-left:5px solid #5cb85c; }
		.fail  { border-left:5px solid #d9534f; background:#fff3f3; }
		.skip  { border-left:5px solid #ffcc00; background:#fffaf0; }
		img.thumb { max-width:350px; border:1px solid #333; cursor:zoom-in; margin-top:6px; border-radius:4px; }
		#zoomModal { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.85); justify-content:center; align-items:center; z-index:9999; }
		#zoomModal img { max-width:90%; max-height:90%; border-radius:8px; }
		details summary { cursor:pointer; font-weight:bold; }

		/* added: compact summary strip */
		.summary { background:#f6fbff; padding:12px; border-radius:6px; margin-bottom:18px; border-left:5px solid #3388ff; }
		.kv { display:inline-block; margin-right:18px; margin-bottom:6px; }
		.kv b { display:block; }
		</style>
		</head>
		<body>
		
		<div id="zoomModal" onclick="this.style.display='none'">
		  <img id="zoomImg">
		</div>
		
		<h2>Windows Test Execution Report — eMatch</h2>

		<!-- added: summary section with counts and durations -->
		<div class="summary">
		  <span class="kv"><b>Suite</b> ${suiteCtx?.getTestSuiteId() ?: "Unknown"}</span>
		  <span class="kv"><b>Start</b> ${new Date(_suiteStartMs)}</span>
		  <span class="kv"><b>End</b> ${new Date(_suiteEndMs)}</span>
		  <span class="kv"><b>Suite Duration</b> ${_fmtMs(suiteDurationMs)}</span>
		  <span class="kv"><b>Executed</b> ${executed}</span>
		  <span class="kv"><b>Passed</b> ${passed.size()}</span>
		  <span class="kv"><b>Failed</b> ${failed.size()}</span>
		  <span class="kv"><b>Skipped</b> ${skipped.size()}</span>
		  <span class="kv"><b>Avg/Test</b> ${_fmtMs(avgMs)}</span>
		</div>
		"""

		// FAILED
		report << "<div class='group'><h3>❌ Failed (${failed.size()})</h3>"
		failed.each { r ->
			report << "<div class='test fail'>"
			report << "<b>${r.name}</b><br>${r.summaryMessage}"
			// added: per-test duration line
			report << "<br>⏱ Duration: ${_fmtMs(r.durationMs ?: 0L)}"
			appendSteps(report, r.name)

			// ✅ Only ONE collapsed log block
			if (r.fullLog?.trim()) {
				report << """
				<br><details><summary>🔍 See full error log</summary>
				<pre style="white-space:pre-wrap; font-size:12px;">${escapeHtml(r.fullLog)}</pre>
				</details>
				"""
			}

			if (r.screenshotBase64) {
				report << "<br><img src='data:image/jpeg;base64,${r.screenshotBase64}' class='thumb' " +
						 "onclick=\"document.getElementById('zoomImg').src=this.src;" +
						 "document.getElementById('zoomModal').style.display='flex';\">"
			}
			report << "</div>"
		}
		report << "</div>"

		// PASSED
		report << "<div class='group'><details><summary>✅ Passed (${passed.size()})</summary>"
		passed.each { r ->
			report << "<div class='test pass'><b>${r.name}</b><br>✔ Test Passed"
			// added: per-test duration line
			report << "<br>⏱ Duration: ${_fmtMs(r.durationMs ?: 0L)}"
			appendSteps(report, r.name)
			report << "</div>"
		}
		report << "</details></div>"

		// SKIPPED
		if (!skipped.isEmpty()) {
			report << "<div class='group'><h3>⏭ Skipped (${skipped.size()})</h3>"
			skipped.each { r ->
				report << "<div class='test skip'><b>${r.name}</b><br>⏭ Test Skipped</div>"
			}
			report << "</div>"
		}

		report << "</body></html>"
		println "✅ eMatch HTML report generated at: ${reportPath}"
	}

	// ================== SCREENSHOT HELPERS ==================

	private static String captureDesktopScreenshot() {
		try {
			Robot robot = new Robot()
			Rectangle rect = new Rectangle(Toolkit.getDefaultToolkit().getScreenSize())
			BufferedImage img = robot.createScreenCapture(rect)

			int maxW = 1600
			if (img.width > maxW) {
				float scale = maxW / (float) img.width
				int newW = (int)(img.width * scale)
				int newH = (int)(img.height * scale)
				BufferedImage resized = new BufferedImage(newW, newH, BufferedImage.TYPE_INT_RGB)
				resized.graphics.drawImage(img, 0, 0, newW, newH, null)
				img = resized
			}

			ByteArrayOutputStream baos = new ByteArrayOutputStream()
			ImageWriter writer = ImageIO.getImageWritersByFormatName("jpeg").next()
			JPEGImageWriteParam jpegParams = new JPEGImageWriteParam(null)
			jpegParams.setCompressionMode(JPEGImageWriteParam.MODE_EXPLICIT)
			jpegParams.setCompressionQuality(0.80f)
			writer.setOutput(new MemoryCacheImageOutputStream(baos))
			writer.write(null, new javax.imageio.IIOImage(img, null, null), jpegParams)
			writer.dispose()

			return Base64.encoder.encodeToString(baos.toByteArray())
		} catch (Exception e) {
			println("⚠ Desktop screenshot failed: ${e.message}")
			return null
		}
	}

	private static String tryDriverScreenshot(String current) {
		try {
			def driver = Windows.getDriver()
			if (driver != null) {
				byte[] rawBytes = driver.getScreenshotAs(OutputType.BYTES)
				if (rawBytes?.length > 0) {
					return Base64.encoder.encodeToString(rawBytes)
				}
			}
		} catch (ignored) {}
		return current
	}

	// ================== LOG + STEPS ==================
	private static void parseExecutionLog(File f) {
		String current = null
		
		f.eachLine { line ->
			if (line.contains("Start Test Case")) {
				current = line.replaceAll(/.*Start Test Case\s*:\s*/, "").trim()
				stepsPerTest[current] = []
				return
			}
			if (line.contains("End Test Case")) { current = null; return }
			if (!current) return
			
			// --- 1) Capture timestamp-formatted user-level steps (original behavior) ---
	        if (line ==~ /\[\d{2}:\d{2}:\d{2}\].*/) {
	            String clean = line.replaceFirst(/\[.*?\]\s*/, "").trim()
	            if (!clean) return
	            if (clean.startsWith("FAILED") || clean.startsWith("ERROR") || clean.contains("Exception")) return
	            if (clean ==~ /(Start|End) Test (Suite|Case).*/) return
	            stepsPerTest[current] << clean
	            return
	        }
	
	        // --- 2) Capture your test's logInfo / markWarning messages ---
	        if (line.contains("INFO") || line.contains("WARN")) {
	            String clean = line.replaceFirst(/^\[.*?\]\s*/, "").trim()
	
	            // Exclude engine noise (WinAppDriver + Selenium + Java stack)
	            if (clean.contains("Exception") || clean.contains("Caused by") || clean.matches(/at .+:\d+/)) return
	            if (clean.contains("org.openqa") || clean.contains("io.appium") || clean.contains("sun.reflect")) return
	
	            stepsPerTest[current] << clean
	        }
		}
	}

	private static void appendSteps(File report, String testName) {
		def steps = stepsPerTest[testName]
		if (steps?.size() > 0) {
			report << "<br><details><summary>▶ Steps Executed</summary><div style='margin-top:6px;'>"
			steps.eachWithIndex { s, i -> report << "${i+1}. ${s}<br>" }
			report << "</div></details>"
		}
	}

	// ================== MESSAGE + LOCATION ==================
	private static String extractLocation(String stack) {
		def tc = stack =~ /at\s+(.+?)\.run\((.+?):(\d+)\)/
		if (tc.find()) return "${tc.group(2).replaceAll(/^.*[\\\/]/, '')} : line ${tc.group(3)}"
		def pg = stack =~ /(.*\.groovy):(\d+)/
		if (pg.find()) return pg.group(1).replaceAll(/^.*[\\\/]/, "") + " : line " + pg.group(2)
		return "Line unavailable"
	}

	private static String formatFailureMessage(String raw, String status) {
		if (!(status in ["FAILED","ERROR"])) return "✔ Test Passed"
		String cleaned = raw ?: ""
		def m = cleaned =~ /Reason:\s*(?:\r?\n)?([^\r\n]+)/
		if (m.find()) return "❗ Mandatory failure\n➡️ ${m.group(1).trim()}"
		return "❗ Mandatory failure\n➡️ Unknown error"
	}

	private static String escapeHtml(String s) {
		s.replace("&","&amp;").replace("<","&lt;").replace(">","&gt;")
	}

	private String _fmtMs(Object ms) {
	    if (ms == null) return "0ms"
	
	    // Convert to double for mod and division operations
	    double totalMs = ((Number) ms).doubleValue()
	
	    long minutes = (long) (totalMs / 60000)
	    long seconds = (long) ((totalMs % 60000) / 1000)
	    long millis = (long) (totalMs % 1000)
	
	    return String.format("%dm %02ds %03dms", minutes, seconds, millis)
	}
}
