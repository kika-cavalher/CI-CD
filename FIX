package commands

import java.io.File

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.driver.WindowsDriverFactory
import com.kms.katalon.core.windows.keyword.helper.WindowsActionHelper

class ImageLoader {

	private static final Map<String, Map<String, String>> IMAGE_GROUPS = [

		'General': [
			'envImage'        : 'Images/General/envImage.png',
			'envImag'         : 'Images/General/envImag.png',
			'homeGrey'        : 'Images/General/HomeGrey.png',
			'homeWhite'       : 'Images/General/HomeWhite.png',
			'home'            : 'Images/General/Home.PNG',
			'exports'         : 'Images/General/Exports.PNG',
			'exports2'        : 'Images/General/Exports2.PNG',
			'outils'          : 'Images/General/Outils.PNG',
			'yes'             : 'Images/General/Yes.PNG',
			'yesEn'           : 'Images/General/yesEn.png',
			'yesUnderline'    : 'Images/General/yesUnderline.png',
			'no'              : 'Images/General/No.PNG',
			'noEn'            : 'Images/General/NoEn.PNG',
			'saveDialog'      : 'Images/General/saveDialog.png',
			'fileName'        : 'Images/General/FileName.png'
		],

		'authentication': [
			'homeGrey'        : 'Images/General/HomeGrey.png',
			'homeWhite'       : 'Images/General/HomeWhite.png',
			'home'            : 'Images/General/Home.PNG'
		],

		'ModuleDesResponsabilite': [
			'menuImage'        : 'Images/BDR/CubeBalanceDesResponsabilites.png',
			'openedTab'        : 'Images/BDR/CubeBalanceDesResponsabilitesTab.png',
			'firstDimension'   : 'Images/BDR/measures.PNG',
			'lastDimension'    : 'Images/BDR/provic.png',
			'lastDimensionOpen': 'Images/BDR/provicOpen.png',
			'firstPageRef'     : 'Images/BDR/FirstPageOfDimensions.PNG',
			'lastPageRef'      : 'Images/BDR/LastPageOfDimensions.PNG'
		],

		'ModuleDesResponsabiliteExport': [
			'allRow'           : 'Images/BDR/AllRow.PNG',
			'expandArrow'      : 'Images/BDR/ExpandArrow.PNG',
			'lastRowArrow'     : 'Images/BDR/lastRowArrow.PNG',
			'isAllOpen'        : 'Images/BDR/isAllOpen.PNG',
			'totalCurrentYear' : 'Images/BDR/totalCurrentYear.PNG'
		]
	]

	@Keyword
	Map<String, String> getImages(String groupName) {
		Map<String, String> group = IMAGE_GROUPS[groupName]

		if (group == null) {
			KeywordUtil.markFailedAndStop(
				'Image group not found: ' + groupName + '\n' +
				'Available groups: ' + IMAGE_GROUPS.keySet()
			)
		}

		Map<String, String> resolved = [:]

		group.each { String key, String relativePath ->
			resolved[key] = resolveImagePath(relativePath)
		}

		return resolved
	}

	@Keyword
	String getImagePath(String groupName, String imageKey) {
		Map<String, String> images = getImages(groupName)
		String imagePath = images[imageKey]

		if (imagePath == null) {
			KeywordUtil.markFailedAndStop(
				'Image key not found.\n' +
				'Group: ' + groupName + '\n' +
				'Key: ' + imageKey + '\n' +
				'Available keys: ' + images.keySet()
			)
		}

		return imagePath
	}

	@Keyword
	void validateGroupImagesExist(String groupName) {
		Map<String, String> images = getImages(groupName)
		List<String> missingImages = []

		images.each { String key, String imagePath ->
			File file = new File(imagePath)

			if (!file.exists()) {
				missingImages.add(key + ' -> ' + imagePath)
			}
		}

		if (!missingImages.isEmpty()) {
			KeywordUtil.markFailedAndStop(
				'Some images were not found for group: ' + groupName + '\n' +
				missingImages.join('\n')
			)
		}

		KeywordUtil.logInfo('All image files exist for group: ' + groupName)
	}

	@Keyword
	boolean isVisible(String groupName, String imageKey) {
		String imagePath = getImagePath(groupName, imageKey)

		try {
			def result = WindowsImageKeywords.findImage(imagePath)
			return result != null && result != false
		} catch (Exception ignored) {
			return false
		}
	}

	@Keyword
	void waitForImageOrStop(String groupName, String imageKey, Integer timeoutSeconds) {
		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 15 : timeoutSeconds
		String imagePath = getImagePath(groupName, imageKey)

		int elapsed = 0

		while (elapsed < safeTimeout) {
			if (isVisible(groupName, imageKey)) {
				KeywordUtil.logInfo(
					'Image became visible.\n' +
					'Group: ' + groupName + '\n' +
					'Key: ' + imageKey + '\n' +
					'Path: ' + imagePath
				)
				return
			}

			Thread.sleep(1000)
			elapsed++
		}

		takeEvidence('ImageNotFound_' + imageKey + '.png')

		KeywordUtil.markFailedAndStop(
			'Image was not found before timeout.\n' +
			'Group: ' + groupName + '\n' +
			'Key: ' + imageKey + '\n' +
			'Path: ' + imagePath + '\n' +
			'Timeout: ' + safeTimeout
		)
	}

	@Keyword
	void clickImageOrStop(String groupName, String imageKey) {
		String imagePath = getImagePath(groupName, imageKey)

		waitForImageOrStop(groupName, imageKey, 15)

		try {
			WindowsImageKeywords.clickImage(imagePath)
			KeywordUtil.logInfo('Image clicked successfully: ' + imageKey)
		} catch (Exception e) {
			takeEvidence('ClickImageFailed_' + imageKey + '.png')

			KeywordUtil.markFailedAndStop(
				'Could not click image.\n' +
				'Group: ' + groupName + '\n' +
				'Key: ' + imageKey + '\n' +
				'Path: ' + imagePath + '\n' +
				'Reason: ' + e.getMessage()
			)
		}
	}

	@Keyword
	boolean clickFirstVisibleInGroup(String groupName) {
		Map<String, String> images = getImages(groupName)

		for (String imageKey : images.keySet()) {
			if (isVisible(groupName, imageKey)) {
				clickImageOrStop(groupName, imageKey)
				return true
			}
		}

		return false
	}

	@Keyword
	void clickImageInsideImageOrStop(String groupName, String parentImageKey, String childImageKey) {
		String childImagePath = getImagePath(groupName, childImageKey)

		waitForImageOrStop(groupName, parentImageKey, 15)
		waitForImageOrStop(groupName, childImageKey, 15)

		try {
			WindowsImageKeywords.clickImage(childImagePath)
			KeywordUtil.logInfo(
				'Child image clicked successfully.\n' +
				'Group: ' + groupName + '\n' +
				'Parent key: ' + parentImageKey + '\n' +
				'Child key: ' + childImageKey
			)
		} catch (Exception e) {
			takeEvidence('ClickInsideImageFailed_' + childImageKey + '.png')

			KeywordUtil.markFailedAndStop(
				'Could not click child image inside parent context.\n' +
				'Group: ' + groupName + '\n' +
				'Parent key: ' + parentImageKey + '\n' +
				'Child key: ' + childImageKey + '\n' +
				'Reason: ' + e.getMessage()
			)
		}
	}

	@Keyword
	void takeEvidence(String fileName) {
		try {
			String evidenceDir = RunConfiguration.getReportFolder() + File.separator + 'Evidences' + File.separator
			new File(evidenceDir).mkdirs()

			String fullPath = evidenceDir + fileName

			WindowsActionHelper
				.create(WindowsDriverFactory.getWindowsSession())
				.takeScreenshot(fullPath)

			KeywordUtil.logInfo('Evidence captured: ' + fullPath)
		} catch (Exception e) {
			KeywordUtil.logInfo('Could not capture evidence: ' + e.getMessage())
		}
	}

	private String resolveImagePath(String relativePath) {
		return new File(RunConfiguration.getProjectDir(), relativePath).getAbsolutePath()
	}
}
