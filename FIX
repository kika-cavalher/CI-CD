	private boolean isLocalExecutionUser() {
		String configuredUser = gv('username')
		String currentUser = getCurrentWindowsUser()
		return configuredUser && currentUser && configuredUser.equalsIgnoreCase(currentUser)
	}

	private boolean isPortOpen(String host, int port, int timeoutMs = 1000) {
		Socket socket = null
		try {
			socket = new Socket()
			socket.connect(new InetSocketAddress(host, port), timeoutMs)
			return true
		} catch (Throwable ignored) {
			return false
		} finally {
			try {
				socket?.close()
			} catch (Throwable ignored) {
			}
		}
	}

	private boolean isWinAppDriverHealthy(int timeoutMs = 1500) {
		HttpURLConnection connection = null
		try {
			connection = (HttpURLConnection) new URL('http://127.0.0.1:4723/status').openConnection()
			connection.setRequestMethod('GET')
			connection.setConnectTimeout(timeoutMs)
			connection.setReadTimeout(timeoutMs)

			int responseCode = connection.responseCode
			String body = ''
			try {
				body = connection.inputStream?.getText('UTF-8') ?: ''
			} catch (Throwable ignored) {
				body = ''
			}

			if (responseCode != 200) {
				return false
			}

			String normalizedBody = body.toLowerCase()
			return normalizedBody.contains('"build"') || normalizedBody.contains('"os"') || normalizedBody.contains('"value"')
		} catch (Throwable ignored) {
			return false
		} finally {
			try {
				connection?.disconnect()
			} catch (Throwable ignored) {
			}
		}
	}

	private boolean waitForPort(String host, int port, int maxSeconds) {
		for (int i = 1; i <= maxSeconds; i++) {
			if (isPortOpen(host, port, 1000)) {
				KeywordUtil.logInfo("Port ${port} is open on ${host} at attempt ${i}")
				return true
			}
			Windows.delay(1)
		}
		return false
	}

	private boolean waitForWinAppDriverStatus(int maxSeconds) {
		for (int i = 1; i <= maxSeconds; i++) {
			if (isWinAppDriverHealthy()) {
				KeywordUtil.logInfo("WinAppDriver /status is healthy at attempt ${i}")
				return true
			}
			Windows.delay(1)
		}
		return false
	}

	private boolean processExists(String imageName) {
		try {
			Process process = new ProcessBuilder(
				'cmd',
				'/c',
				"tasklist /FI \"IMAGENAME eq ${imageName}\""
			).redirectErrorStream(true).start()

			String output = process.inputStream.getText('CP1252')
			process.waitFor()

			return output != null && output.toLowerCase().contains(imageName.toLowerCase())
		} catch (Throwable ignored) {
			return false
		}
	}

	private void killProcessIfExists(String imageName) {
		try {
			if (!processExists(imageName)) {
				return
			}

			KeywordUtil.logInfo("Killing existing process: ${imageName}")
			new ProcessBuilder(
				'cmd',
				'/c',
				"taskkill /F /T /IM \"${imageName}\""
			).redirectErrorStream(true).start().waitFor()

			Windows.delay(2)
		} catch (Throwable e) {
			KeywordUtil.logInfo("Unable to kill process ${imageName}: ${e.message}")
		}
	}

