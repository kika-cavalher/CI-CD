CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Start comparison between exported files for Ecart bilan vs. Complte de résultat ccy')

def files = GlobalVariable.compareFiles as ArrayList
int index = 9 //Ecart bilan vs. Complte de résultat ccy
String errors = ''

String evPath = RunConfiguration.getReportFolder() + '\\Evidences\\'

String file3
String file4

try {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Resolve exported files from compareFiles list')
	file3 = (evPath + files.get(0))
	file4 = (evPath + files.get(1))

	KeywordUtil.logInfo("Attempting to access files: " + file3 + " and " + file4)

	File f1 = new File(file3)
	File f2 = new File(file4)

	if (!f1.exists() || !f2.exists()) {
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'('One or both exported files were not found')
		errors += "One or both files not found: ${f1.getAbsolutePath()}, ${f2.getAbsolutePath()}\n"
	}
	
} catch (Exception e) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Error while retrieving exported files')
	errors += 'Error encountered while retrieving files: ' + e.getMessage() + "\n"
}

if (errors != '') {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Stop validation because files could not be resolved')
	KeywordUtil.markFailedAndStop('Files for the test not found. Errors: \n' + errors)
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Open Excel files for comparison')
input1 = new FileInputStream(file3);
input2 = new FileInputStream(file4);
wbEnv1 = WorkbookFactory.create(input1);
wbEnv2 = WorkbookFactory.create(input2);
sheetEnv1 = wbEnv1.getSheetAt(0);
sheetEnv2 = wbEnv2.getSheetAt(0);

int linesEnv1 = sheetEnv1.getLastRowNum();
int linesEnv2 = sheetEnv2.getLastRowNum();

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Compare table dimensions and headers')
Row row1 = sheetEnv1.getRow(0)
Row row2 = sheetEnv2.getRow(0)
row1.getPhysicalNumberOfCells()!=row2.getPhysicalNumberOfCells() ? errors += "\n[ERROR] Files have diffent number of Table headers " : errors

Integer i = 0;
Boolean headersFlag = true
for (Cell cell in row1) {
	if(!cell.toString().equals(row2.getCell(i).toString())) {
		headersFlag = false
	}
	i++
}

!headersFlag ? errors += "\n[ERROR] Files table Headers not match " : errors

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Validate row count difference threshold')
if(row1.getLastCellNum() - row2.getLastCellNum() <= 10 && row1.getLastCellNum() - row2.getLastCellNum() >= -10) {
	KeywordUtil.markPassed('Row number discrepancy between threshold of 10 difference, Actual value :' + (row1.getLastCellNum() - row2.getLastCellNum()))
} else {
	errors += "\n[ERROR] Files have diffent number of rows more than 10, Actual value: " + (row1.getLastCellNum() - row2.getLastCellNum())
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Calculate and compare total sums for target column')
BigDecimal sum1 = CustomKeywords.'com.katalon.keywords.excelHandling.ExcelValidations.totalSum'(sheetEnv1, index)
BigDecimal sum2 = CustomKeywords.'com.katalon.keywords.excelHandling.ExcelValidations.totalSum'(sheetEnv2, index)
sum1 = sum1.setScale(2, BigDecimal.ROUND_HALF_DOWN)
sum2 = sum2.setScale(2, BigDecimal.ROUND_HALF_DOWN)
println(sum1)
println(sum2)

if(sum1 != sum2) {
	int rowDifference = Math.abs(row1.getLastCellNum() - row2.getLastCellNum())
	errors += '⚠️ [ERROR] Sum of Ecart bilan vs. Complte de résultat ccy (' + sum1 + ') is different than (' + sum2 + '). Files have different numbers of rows: ' + rowDifference + ' rows.'
}

if (errors != '') {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('File comparison finished with errors')
	errors += (((('Files used : ' + file3.substring(file3.lastIndexOf('\\'))) + ' and ') + file4.substring(file4.lastIndexOf('\\'))) + '\n')
	KeywordUtil.markFailed('\n' + errors)
} else {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('File comparison finished successfully')
}




