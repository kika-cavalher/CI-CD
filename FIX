✅ 4) D:\Projects\eMatchStarters\run-ematch-command.bat (MULTILINHAS + ROBUSTO)

Esse é o BAT do Task Scheduler.
Ele:

Lê run-context.properties
Cria Reports\logs
Roda Katalon
Escreve o marker Reports\__jenkins_task_exitcode.txt com o exit code
@echo off
setlocal EnableExtensions EnableDelayedExpansion

REM ============================================================
REM  eMatch Desktop Runner (Scheduled Task entrypoint)
REM  Reads:  D:\Projects\eMatchStarters\run-context.properties
REM  Writes: %WORKSPACE%\Reports\__jenkins_task_exitcode.txt
REM ============================================================

set "CTX_FILE=D:\Projects\eMatchStarters\run-context.properties"

if not exist "%CTX_FILE%" (
  echo [ERROR] Context file not found: %CTX_FILE%
  exit /b 2
)

REM ---- Load context vars ----
for /f "usebackq tokens=1,* delims==" %%A in ("%CTX_FILE%") do (
  set "%%A=%%B"
)

if "%WORKSPACE%"=="" (
  echo [ERROR] WORKSPACE is empty. Check run-context.properties
  exit /b 3
)

set "REPORTS_DIR=%WORKSPACE%\Reports"
set "LOG_DIR=%REPORTS_DIR%\logs"
set "MARKER=%REPORTS_DIR%\__jenkins_task_exitcode.txt"
set "LOG_FILE=%LOG_DIR%\run-ematch-command.log"

if not exist "%REPORTS_DIR%" mkdir "%REPORTS_DIR%" >nul 2>&1
if not exist "%LOG_DIR%" mkdir "%LOG_DIR%" >nul 2>&1

del /f /q "%MARKER%" >nul 2>&1

echo =========================================================== > "%LOG_FILE%"
echo [INFO] START %DATE% %TIME%                                  >> "%LOG_FILE%"
echo [INFO] WORKSPACE=%WORKSPACE%                                 >> "%LOG_FILE%"
echo [INFO] PROJECT_FILE=%PROJECT_FILE%                           >> "%LOG_FILE%"
echo [INFO] KATALON_EXE=%KATALON_EXE%                              >> "%LOG_FILE%"
echo [INFO] COLLECTION_PATH=%COLLECTION_PATH%                      >> "%LOG_FILE%"
echo [INFO] BROWSER_TYPE=%BROWSER_TYPE%                            >> "%LOG_FILE%"
echo [INFO] RETRY=%RETRY%                                          >> "%LOG_FILE%"
echo ===========================================================   >> "%LOG_FILE%"

REM ---- Go to workspace so relative project paths behave ----
pushd "%WORKSPACE%" 1>> "%LOG_FILE%" 2>&1

REM ---- Run Katalon ----
"%KATALON_EXE%" ^
  -noSplash ^
  -runMode=console ^
  -consoleLog ^
  -projectPath="%WORKSPACE%\%PROJECT_FILE%" ^
  -retry=%RETRY% ^
  -testSuiteCollectionPath="%COLLECTION_PATH%" ^
  -browserType="%BROWSER_TYPE%" ^
  -reportFolder="Reports" ^
  1>> "%LOG_FILE%" 2>&1

set "EC=%ERRORLEVEL%"

popd

echo [INFO] END %DATE% %TIME%  ExitCode=%EC%                      >> "%LOG_FILE%"

REM ---- Marker for Jenkins ----
echo %EC%> "%MARKER%"

exit /b %EC%
