private WebElement openEditableFileBrowserBreadcrumb() {
	KeywordUtil.logInfo("Opening editable File Browser breadcrumb")

	TestObject editableBreadcrumb = getRequiredObject(OBJ_FILE_BROWSER_EDITABLE_BREADCRUMB)
	TestObject breadcrumbPathInput = getRequiredObject(OBJ_FILE_BROWSER_PATH_INPUT)

	for (int attempt = 1; attempt <= MAX_ATTEMPTS; attempt++) {
		KeywordUtil.logInfo("Opening editable breadcrumb attempt: " + attempt + "/" + MAX_ATTEMPTS)

		WebUI.waitForElementVisible(
				editableBreadcrumb,
				DEFAULT_TIMEOUT,
				FailureHandling.STOP_ON_FAILURE
				)

		WebElement editableBreadcrumbElement = WebUI.findWebElement(editableBreadcrumb, DEFAULT_TIMEOUT)

		try {
			Actions actions = new Actions(DriverFactory.getWebDriver())

			actions
					.moveToElement(editableBreadcrumbElement)
					.doubleClick(editableBreadcrumbElement)
					.perform()
		} catch (Exception e) {
			KeywordUtil.logInfo("Normal double click failed. Trying JavaScript double click.")

			WebUI.executeJavaScript(
					"""
					const element = arguments[0];

					element.scrollIntoView({block: 'center', inline: 'center'});
					element.dispatchEvent(new MouseEvent('mouseover', {bubbles: true}));
					element.dispatchEvent(new MouseEvent('mousedown', {bubbles: true}));
					element.dispatchEvent(new MouseEvent('mouseup', {bubbles: true}));
					element.dispatchEvent(new MouseEvent('click', {bubbles: true}));
					element.dispatchEvent(new MouseEvent('dblclick', {bubbles: true}));
					""",
					Arrays.asList(editableBreadcrumbElement)
					)
		}

		WebUI.delay(1)

		boolean inputVisible = WebUI.verifyElementVisible(
				breadcrumbPathInput,
				FailureHandling.OPTIONAL
				)

		if (inputVisible) {
			KeywordUtil.logInfo("Editable File Browser path input is visible")
			return WebUI.findWebElement(breadcrumbPathInput, DEFAULT_TIMEOUT)
		}

		KeywordUtil.logInfo("Editable File Browser path input is not visible yet. Retrying.")
		WebUI.delay(1)
	}

	KeywordUtil.markFailedAndStop("Editable File Browser path input was not displayed after double clicking breadcrumb.")
	return null
}
