		String description,
		Integer timeout,
		List<String> errors
	) {

		logObjectSearch(
			objectKey,
			description
		)

		boolean present =
			Windows.waitForElementPresent(
				object(objectKey),
				timeout,
				FailureHandling.OPTIONAL
			)

		reportBooleanResult(
			present,
			description + ' was found.',
			description + ' was not found.',
			errors
		)
	}


	private void validateEnabledState(
		String objectKey,
		String description,
		boolean expectedEnabled,
		Integer timeout,
		List<String> errors
	) {

		logObjectSearch(
			objectKey,
			description +
			' | Expected enabled: ' +
			expectedEnabled
		)

		WindowsTestObject targetObject =
			object(objectKey)

		boolean present =
			Windows.waitForElementPresent(
				targetObject,
				timeout,
				FailureHandling.OPTIONAL
			)

		if (!present) {
			String message =
				description +
				' was not found.'

			errors.add(message)

			KeywordUtil.logInfo(
				'[FAIL] ' + message
			)

			return
		}

		String enabledAttribute =
			safeText(
				Windows.getAttribute(
					targetObject,
					'IsEnabled',
					FailureHandling.OPTIONAL
				)
			)

		boolean actualEnabled =
			enabledAttribute.equalsIgnoreCase('True')

		if (actualEnabled == expectedEnabled) {
			KeywordUtil.logInfo(
				'[PASS] ' +
				description +
				' enabled state is correct.\n' +
				'Expected: ' +
				expectedEnabled +
				'\nActual: ' +
				actualEnabled
			)
		} else {
			String message =
				description +
				' enabled state is incorrect.\n' +
				'Expected: ' +
				expectedEnabled +
				'\nActual: ' +
				actualEnabled

			errors.add(message)

			KeywordUtil.logInfo(
				'[FAIL] ' + message
			)
		}
	}


	private void clickImage(
		String groupName,
		String imageKey,
		Integer timeout
	) {

		KeywordUtil.logInfo(
			'[IMAGE] Searching and clicking\n' +
			'Group: ' + groupName + '\n' +
			'Key: ' + imageKey + '\n' +
			'Timeout: ' + timeout + ' seconds'
		)

		boolean found =
			imageLoader.waitForImage(
				groupName,
				imageKey,
				timeout
			)

		if (!found) {
			takeEvidence(
				'GUI_ImageNotFound_' +
					imageKey +
					'.png'
			)

			KeywordUtil.markFailedAndStop(
				'Image was not found.\n' +
				'Group: ' + groupName + '\n' +
				'Key: ' + imageKey + '\n' +
				'Path: ' +
				image(groupName, imageKey)
			)

			return
		}

		try {
			WindowsImageKeywords.clickImage(
				image(groupName, imageKey)
			)

			KeywordUtil.logInfo(
				'[PASS] Image clicked: ' +
				imageKey
			)
		} catch (Exception e) {
			takeEvidence(
				'GUI_ImageClickFailed_' +
					imageKey +
					'.png'
			)

			KeywordUtil.markFailedAndStop(
				'Image click failed.\n' +
				'Group: ' + groupName + '\n' +
				'Key: ' + imageKey + '\n' +
				'Reason: ' + safeMessage(e)
			)
		}
	}


	private void typeOnImage(
		String groupName,
		String imageKey,
		String value,
		Integer timeout
	) {

		KeywordUtil.logInfo(
			'[IMAGE] Searching input image\n' +
			'Group: ' + groupName + '\n' +
			'Key: ' + imageKey + '\n' +
			'Value: ' + value + '\n' +
			'Timeout: ' + timeout + ' seconds'
		)

		boolean found =
			imageLoader.waitForImage(
				groupName,
				imageKey,
				timeout
			)

		if (!found) {
			takeEvidence(
				'GUI_InputImageNotFound_' +
					imageKey +
					'.png'
			)

			KeywordUtil.markFailedAndStop(
				'Input image was not found.\n' +
				'Group: ' + groupName + '\n' +
				'Key: ' + imageKey
			)

			return
		}

		try {
			WindowsImageKeywords.typeOnImage(
