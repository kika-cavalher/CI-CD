import java.awt.Robot
import java.awt.Toolkit
import java.awt.datatransfer.StringSelection
import java.awt.event.InputEvent
import java.awt.event.KeyEvent
import java.io.File

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import commands.ImageLoader
import commands.WindowsObjectLoader

String sectionValue = '228'
String imageGroup = 'General'
String rechercheImageKey = 'rechercheTab'

Integer tabCountToSection = 18
Integer resultLoadDelaySeconds = 10

Robot robot = new Robot()
robot.setAutoDelay(120)

ImageLoader imageLoader = new ImageLoader()

Closure<String> resolveImagePathFromLoader = { String groupName, String imageKey ->
	Map<String, String> images = imageLoader.getImages(groupName)

	if (images == null || images.isEmpty()) {
		KeywordUtil.markFailedAndStop(
			'Image group not found in ImageLoader.\n' +
			'Image group: ' + groupName
		)
	}

	if (!images.containsKey(imageKey)) {
		KeywordUtil.markFailedAndStop(
			'Image key not found in ImageLoader.\n' +
			'Image group: ' + groupName + '\n' +
			'Image key: ' + imageKey + '\n' +
			'Available keys: ' + images.keySet().join(', ')
		)
	}

	String pathFromLoader = images[imageKey]

	if (pathFromLoader == null || pathFromLoader.trim().isEmpty()) {
		KeywordUtil.markFailedAndStop(
			'Image path is empty in ImageLoader.\n' +
			'Image group: ' + groupName + '\n' +
			'Image key: ' + imageKey
		)
	}

	File imageFile = new File(pathFromLoader)

	if (!imageFile.isAbsolute()) {
		imageFile = new File(RunConfiguration.getProjectDir(), pathFromLoader)
	}

	if (!imageFile.exists()) {
		KeywordUtil.markFailedAndStop(
			'Image file not found.\n' +
			'Image group: ' + groupName + '\n' +
			'Image key: ' + imageKey + '\n' +
			'Path from ImageLoader: ' + pathFromLoader + '\n' +
			'Resolved path: ' + imageFile.getAbsolutePath() + '\n' +
			'Project dir: ' + RunConfiguration.getProjectDir()
		)
	}

	return imageFile.getAbsolutePath()
}

Closure clickImageFromLoader = { String groupName, String imageKey ->
	String imagePath = resolveImagePathFromLoader(groupName, imageKey)

	try {
		KeywordUtil.logInfo(
			'Click image from ImageLoader.\n' +
			'Image group: ' + groupName + '\n' +
			'Image key: ' + imageKey + '\n' +
			'Path: ' + imagePath
		)

		WindowsImageKeywords.clickImage(imagePath)
		Windows.delay(1)
	} catch (Exception e) {
		KeywordUtil.markFailedAndStop(
			'Could not click image.\n' +
			'Image group: ' + groupName + '\n' +
			'Image key: ' + imageKey + '\n' +
			'Path: ' + imagePath + '\n' +
			'Reason: ' + e.getMessage()
		)
	}
}

Closure pressTabTimes = { Integer times ->
	for (int index = 1; index <= times; index++) {
		robot.keyPress(KeyEvent.VK_TAB)
		robot.keyRelease(KeyEvent.VK_TAB)
		Thread.sleep(80)
	}
}

Closure clearFocusedField = {
	robot.keyPress(KeyEvent.VK_CONTROL)
	robot.keyPress(KeyEvent.VK_A)
	robot.keyRelease(KeyEvent.VK_A)
	robot.keyRelease(KeyEvent.VK_CONTROL)

	Thread.sleep(150)

	robot.keyPress(KeyEvent.VK_BACK_SPACE)
	robot.keyRelease(KeyEvent.VK_BACK_SPACE)

	Thread.sleep(150)
}

Closure pasteText = { String text ->
	StringSelection selection = new StringSelection(text)
	Toolkit.getDefaultToolkit().getSystemClipboard().setContents(selection, null)

	Thread.sleep(300)

	robot.keyPress(KeyEvent.VK_CONTROL)
	robot.keyPress(KeyEvent.VK_V)
	robot.keyRelease(KeyEvent.VK_V)
	robot.keyRelease(KeyEvent.VK_CONTROL)

	Thread.sleep(300)
}

Closure clickObjectCenter = { WindowsTestObject object ->
	def rect = Windows.getElementRect(object)

	int x = rect.getX() + Math.floor(rect.getWidth() / 2).intValue()
	int y = rect.getY() + Math.floor(rect.getHeight() / 2).intValue()

	robot.mouseMove(x, y)
	Thread.sleep(100)

	robot.mousePress(InputEvent.BUTTON1_DOWN_MASK)
	Thread.sleep(100)
	robot.mouseRelease(InputEvent.BUTTON1_DOWN_MASK)

	Thread.sleep(500)
}

Closure<WindowsTestObject> resolveRechercherButton = {
	List<String> objectKeys = [
		'rechercherButton',
		'rechercherButtonByName'
	]

	for (String objectKey : objectKeys) {
		try {
			WindowsTestObject object = WindowsObjectLoader.getObject('filter', objectKey)

			boolean isPresent = Windows.verifyElementPresent(
				object,
				3,
				FailureHandling.OPTIONAL
			)

			if (isPresent) {
				KeywordUtil.logInfo('Rechercher button found by object: filter.' + objectKey)
				return object
			}
		} catch (Exception e) {
			KeywordUtil.logInfo(
				'Rechercher button object not available.\n' +
				'Object: filter.' + objectKey + '\n' +
				'Reason: ' + e.getMessage()
			)
		}
	}

	KeywordUtil.markFailedAndStop(
		'Rechercher button was not found.\n' +
		'Expected object keys: filter.rechercherButton or filter.rechercherButtonByName'
	)

	return null
}

if (sectionValue == null || sectionValue.trim().isEmpty()) {
	KeywordUtil.markFailedAndStop('Section value is empty.')
}

KeywordUtil.logInfo('Step 1. Open Recherche tab.')
clickImageFromLoader(imageGroup, rechercheImageKey)
Windows.delay(2)

KeywordUtil.logInfo('Step 2. Move focus to Section field using TAB ' + tabCountToSection + ' times.')
pressTabTimes(tabCountToSection)
Windows.delay(1)

KeywordUtil.logInfo('Step 3. Fill Section field with value: ' + sectionValue)
clearFocusedField()
pasteText(sectionValue)
Windows.delay(1)

KeywordUtil.logInfo('Step 4. Click Rechercher button.')
WindowsTestObject rechercherButton = resolveRechercherButton()
clickObjectCenter(rechercherButton)

KeywordUtil.logInfo('Step 5. Wait result grid after filter.')
Windows.delay(resultLoadDelaySeconds)

KeywordUtil.markPassed('Comparatif Inter filter applied successfully. Section: ' + sectionValue)
