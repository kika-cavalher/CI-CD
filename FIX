package pageObject

import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import java.awt.Dimension
import java.awt.Robot
import java.awt.Toolkit
import java.awt.event.InputEvent

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import commands.DimensionsNavigator
import commands.ExportFile
import commands.ImageLoader
import commands.MenuNavigator

class ModuleDesResponsabiliteKeywords {

	private static final String MENU_NAME = 'cube balance des responsabilités'
	private static final String MENU_IMAGE_GROUP = 'ModuleDesResponsabilite'
	private static final String EXPECTED_TAB = 'BDR/BalanceDesResponsabilitesTab'
	private static final String EXPORT_LABEL = 'ExportExpandedTable'

	private ImageLoader imageLoader = new ImageLoader()
	private MenuNavigator menuNavigator = new MenuNavigator()
	private DimensionsNavigator dimensionsNavigator = new DimensionsNavigator()
	private ExportFile exportFile = new ExportFile()

	@Keyword
	String getMenuName() {
		return MENU_NAME
	}

	@Keyword
	String getExportLabel() {
		return EXPORT_LABEL
	}

	@Keyword
	String getDimensionsImageGroup() {
		return MENU_IMAGE_GROUP
	}

	@Keyword
	void openMenu(Integer timeoutSeconds) {
		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 60 : timeoutSeconds

		menuNavigator.searchAndOpenMenu(
				MENU_NAME,
				MENU_IMAGE_GROUP,
				EXPECTED_TAB,
				safeTimeout
				)
	}

	@Keyword
	void validateOpenedMenu(Integer timeoutSeconds) {
		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 60 : timeoutSeconds

		boolean tabPresent = false

		try {
			tabPresent = Windows.verifyElementPresent(
					findWindowsObject(EXPECTED_TAB),
					safeTimeout,
					FailureHandling.OPTIONAL
					)
		} catch (Exception ignored) {
		}

		if (!tabPresent && !imageLoader.waitForImage(MENU_IMAGE_GROUP, 'openedTab', 5)) {
			imageLoader.takeEvidence('OpenedMenuNotValidated.png')

			KeywordUtil.markFailedAndStop(
					'Opened menu was not validated.\n' +
					'Menu: ' + MENU_NAME + '\n' +
					'Expected tab object: ' + EXPECTED_TAB
					)
		}

		KeywordUtil.logInfo('Opened menu validated successfully: ' + MENU_NAME)
	}

	@Keyword
	void takeEvidence(String fileName) {
		imageLoader.takeEvidence(fileName)
	}

	@Keyword
	void validateDimensionsImagesExist(String imageGroup) {
		dimensionsNavigator.validateDimensionsImagesExist(imageGroup)
	}

	@Keyword
	void validateMeasuresOpen(String imageGroup, Integer timeoutSeconds) {
		dimensionsNavigator.validateMeasuresOpen(imageGroup, timeoutSeconds)
	}

	@Keyword
	void clickFirstDimension(String imageGroup) {
		dimensionsNavigator.clickFirstDimension(imageGroup)
	}

	@Keyword
	void openDimensionsUntilProvic(String imageGroup, Integer maxCycles) {
		dimensionsNavigator.openDimensionsUntilProvic(imageGroup, maxCycles)
	}

	@Keyword
	void validateProvicOpen(String imageGroup, Integer timeoutSeconds) {
		dimensionsNavigator.validateProvicOpen(imageGroup, timeoutSeconds)
	}

	@Keyword
	void validateLastDimension(String imageGroup, Integer timeoutSeconds) {
		dimensionsNavigator.validateLastDimension(imageGroup, timeoutSeconds)
	}

	@Keyword
	void scrollDimensionsToTop(String imageGroup) {
		dimensionsNavigator.scrollDimensionsToTop(imageGroup)
	}

	@Keyword
	void validateFirstPageReference(String imageGroup, Integer timeoutSeconds) {
		dimensionsNavigator.validateFirstPageReference(imageGroup, timeoutSeconds)
	}

	@Keyword
	void prepareExpandedTableForExport(String imageGroup) {
		imageLoader.validateGroupImagesExist(imageGroup)

		KeywordUtil.logInfo('Step 1. Scroll current page until ZoneLignes becomes visible.')
		boolean zoneLignesVisible = scrollCurrentPageUntilImageVisible(imageGroup, 'zoneLignes', false, 40)

		if (!zoneLignesVisible) {
			imageLoader.takeEvidence('ZoneLignesNotFound.png')

			KeywordUtil.markFailedAndStop(
					'ZoneLignes image was not found before timeout.\n' +
					'Group: ' + imageGroup + '\n' +
					'Key: zoneLignes'
					)
		}

		KeywordUtil.logInfo('Step 2. Click beside ZoneLignes arrow until the end.')
		scrollInsideZoneLignesToEnd(imageGroup, 18)

		KeywordUtil.logInfo('Step 3. Drag last visible item from ZoneLignes to Measures.')
		dragLastVisibleZoneLignesItemToMeasures(imageGroup)

		KeywordUtil.logInfo('Step 4. Scroll current page to the end.')
		scrollCurrentPageToBottom(35)

		KeywordUtil.logInfo('Step 5. Validate updated last page image at page end.')
		imageLoader.waitForImageOrStop(imageGroup, 'updatedLastPageRef', 15)
	}

	@Keyword
	void exportExpandedTableWithoutOpeningFile(String exportLabel) {
		exportFile.exportFromOutilsToNo(exportLabel)
	}

	private boolean scrollCurrentPageUntilImageVisible(String imageGroup, String imageKey, boolean scrollUp, int maxMoves) {
		for (int i = 0; i < maxMoves; i++) {
			if (imageLoader.isVisible(imageGroup, imageKey)) {
				KeywordUtil.logInfo(
						'Image found during current page scroll.\n' +
						'Group: ' + imageGroup + '\n' +
						'Key: ' + imageKey + '\n' +
						'Move: ' + i
						)
				return true
			}

			moveMouseToMainPageScrollArea()
			scrollWheel(scrollUp ? -3 : 3)
			Windows.delay(1)
		}

		return imageLoader.isVisible(imageGroup, imageKey)
	}

	private void scrollInsideZoneLignesToEnd(String imageGroup, int maxMoves) {
		imageLoader.waitForImageOrStop(imageGroup, 'zoneLignes', 15)

		for (int i = 0; i < maxMoves; i++) {
			clickBesideZoneLignesArrow(imageGroup)
			Windows.delay(1)
		}
	}

	private void clickBesideZoneLignesArrow(String imageGroup) {
		Map<String, Integer> zoneAnchor = getImageAnchor(imageGroup, 'zoneLignes')

		int clickX = zoneAnchor.x + 175
		int clickY = zoneAnchor.y + 95

		KeywordUtil.logInfo(
				'Click beside ZoneLignes arrow using fixed offset.\n' +
				'Anchor X: ' + zoneAnchor.x + '\n' +
				'Anchor Y: ' + zoneAnchor.y + '\n' +
				'Click X: ' + clickX + '\n' +
				'Click Y: ' + clickY
				)

		mouseClick(clickX, clickY)
	}

	private void dragLastVisibleZoneLignesItemToMeasures(String imageGroup) {
		Map<String, Integer> zoneAnchor = getImageAnchor(imageGroup, 'zoneLignes')
		Map<String, Integer> measuresAnchor = getImageAnchor(imageGroup, 'firstDimension')

		int sourceX = zoneAnchor.x + 80
		int sourceY = zoneAnchor.y + 82

		int targetX = measuresAnchor.x + 18
		int targetY = measuresAnchor.y + 18

		KeywordUtil.logInfo(
				'Dragging last visible ZoneLignes item to Measures using anchor offsets.\n' +
				'Source: (' + sourceX + ', ' + sourceY + ')\n' +
				'Target: (' + targetX + ', ' + targetY + ')'
				)

		dragAndDrop(sourceX, sourceY, targetX, targetY)
		Windows.delay(3)
	}

	private void scrollCurrentPageToBottom(int maxMoves) {
		moveMouseToMainPageScrollArea()
		Windows.delay(1)

		for (int i = 0; i < maxMoves; i++) {
			scrollWheel(4)
			Windows.delay(1)
		}
	}

	private Map<String, Integer> getImageAnchor(String groupName, String imageKey) {
		String imagePath = imageLoader.getImage(groupName, imageKey)
		def match = WindowsImageKeywords.findImage(imagePath)

		if (match == null || match == false) {
			imageLoader.takeEvidence('ImageAnchorNotFound_' + imageKey + '.png')

			KeywordUtil.markFailedAndStop(
					'Could not find image anchor.\n' +
					'Group: ' + groupName + '\n' +
					'Key: ' + imageKey + '\n' +
					'Path: ' + imagePath
					)
		}

		int x = readMatchValue(match, ['x', 'getX'])
		int y = readMatchValue(match, ['y', 'getY'])

		if (x <= 0 && y <= 0) {
			imageLoader.takeEvidence('ImageAnchorInvalid_' + imageKey + '.png')

			KeywordUtil.markFailedAndStop(
					'Image anchor was found but coordinates are invalid.\n' +
					'Group: ' + groupName + '\n' +
					'Key: ' + imageKey + '\n' +
					'X: ' + x + '\n' +
					'Y: ' + y
					)
		}

		return [x: x, y: y]
	}

	private int readMatchValue(def match, List<String> accessors) {
		for (String accessor : accessors) {
			try {
				def value

				if (accessor.startsWith('get')) {
					value = match."$accessor"()
				} else {
					value = match."$accessor"
				}

				if (value instanceof Number) {
					return value.intValue()
				}
			} catch (Exception ignored) {
			}
		}

		return 0
	}

	private void dragAndDrop(int startX, int startY, int endX, int endY) {
		Robot robot = new Robot()
		robot.setAutoDelay(120)

		robot.mouseMove(startX, startY)
		Windows.delay(1)

		robot.mousePress(InputEvent.BUTTON1_DOWN_MASK)
		Windows.delay(1)

		int steps = 20

		for (int i = 1; i <= steps; i++) {
			int currentX = startX + Math.floor((endX - startX) * i / steps).intValue()
			int currentY = startY + Math.floor((endY - startY) * i / steps).intValue()

			robot.mouseMove(currentX, currentY)
			Thread.sleep(60)
		}

		robot.mouseRelease(InputEvent.BUTTON1_DOWN_MASK)
		Windows.delay(2)
	}

	private void moveMouseToMainPageScrollArea() {
		Dimension screenSize = Toolkit.getDefaultToolkit().getScreenSize()

		int x = Math.floor(screenSize.width * 0.78).intValue()
		int y = Math.floor(screenSize.height * 0.72).intValue()

		moveMouse(x, y)
	}

	private void moveMouse(int x, int y) {
		Robot robot = new Robot()
		robot.setAutoDelay(100)
		robot.mouseMove(x, y)
	}

	private void mouseClick(int x, int y) {
		Robot robot = new Robot()
		robot.setAutoDelay(120)

		robot.mouseMove(x, y)
		Thread.sleep(150)

		robot.mousePress(InputEvent.BUTTON1_DOWN_MASK)
		Thread.sleep(120)
		robot.mouseRelease(InputEvent.BUTTON1_DOWN_MASK)

		Thread.sleep(250)
	}

	private void scrollWheel(int amount) {
		Robot robot = new Robot()
		robot.setAutoDelay(100)
		robot.mouseWheel(amount)
	}
}
