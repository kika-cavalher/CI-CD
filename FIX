
import java.awt.Desktop




// =========================================================================
// SECTION 3 - START MATCH
// =========================================================================

@Keyword
void startMatch(String currentUser, String targetWindowTitle) {
	String expectedTitle = normalizeTitle(safe(targetWindowTitle) ?: resolveWindowTitle())

	KeywordUtil.logInfo("Starting eMatch for environment ${(safe(GlobalVariable.env) ?: 'REC')}")
	KeywordUtil.logInfo("Current Windows user ${safe(currentUser)}")
	KeywordUtil.logInfo("Target window title ${expectedTitle}")

	ensureWinAppDriverRunning()

	Map<String, String> alreadyOpen = waitForWindow(expectedTitle, 5)
	if (safe(alreadyOpen.title)) {
		detectedWindowTitle = normalizeTitle(alreadyOpen.title)
		KeywordUtil.logInfo("eMatch already open with title ${detectedWindowTitle}")
		return
	}

	Throwable lastError = null

	String installedExe = safe(getInstalledExePath())
	if (fileExists(installedExe)) {
		try {
			KeywordUtil.logInfo("Starting installed eMatch exe with Katalon: ${installedExe}")
			Windows.startApplicationWithTitle(installedExe, expectedTitle)
			Map<String, String> found = waitForWindow(expectedTitle, 25)
			if (safe(found.title)) {
				detectedWindowTitle = normalizeTitle(found.title)
				KeywordUtil.logInfo("eMatch window detected after installed exe start with title ${detectedWindowTitle}")
				return
			}
		} catch (Throwable t) {
			lastError = t
			KeywordUtil.logInfo("Installed exe start failed: ${safe(t.message)}")
		}
	}

	List<Map<String, String>> candidates = buildLaunchCandidates()
	if (candidates.isEmpty()) {
		KeywordUtil.markFailedAndStop("No valid launch candidate was found for eMatch")
	}

	for (Map<String, String> candidate : candidates) {
		try {
			launchCandidate(candidate)
		} catch (Throwable t) {
			lastError = t
			KeywordUtil.logInfo("Launch candidate failed: ${safe(candidate?.type)} ${safe(candidate?.path)} :: ${safe(t.message)}")
		}

		Map<String, String> found = waitForWindow(expectedTitle, 35)
		if (safe(found.title)) {
			detectedWindowTitle = normalizeTitle(found.title)
			KeywordUtil.logInfo("eMatch window detected during startup with title ${detectedWindowTitle}")
			return
		}
	}

	KeywordUtil.markFailedAndStop(
		"Could not open eMatch window ${expectedTitle}. Last launch error: ${safe(lastError?.message)}"
	)
}



// =========================================================================
// SECTION 6 - LAUNCH CANDIDATES
// =========================================================================

private List<Map<String, String>> buildLaunchCandidates() {
	List<Map<String, String>> candidates = []
	Set<String> seen = [] as Set<String>

	addLaunchCandidate(candidates, seen, 'shortcut', getShortcutPath())
	addLaunchCandidate(candidates, seen, 'installedExe', getInstalledExePath())
	addLaunchCandidate(candidates, seen, 'application', getApplicationPath())

	return candidates
}

private void addLaunchCandidate(List<Map<String, String>> candidates, Set<String> seen, String type, String path) {
	String resolved = safe(path)
	if (!resolved) {
		return
	}

	if (!fileExists(resolved)) {
		return
	}

	if (seen.contains(resolved.toLowerCase())) {
		return
	}

	seen << resolved.toLowerCase()
	candidates << [type: type, path: resolved]
}

private void launchCandidate(Map<String, String> candidate) {
	String type = safe(candidate?.type)
	String path = safe(candidate?.path)

	KeywordUtil.logInfo("Launching ${type}: ${path}")

	if (type == 'installedExe') {
		openExecutableNoConsole(path)
	} else {
		openFileNoConsole(path)
	}

	sleepMs(2500)
}



// =========================================================================
// SECTION 7 - WINAPPDRIVER / WINDOW DISCOVERY
// =========================================================================

private void ensureWinAppDriverRunning() {
	if (isPortOpen('127.0.0.1', 4723, 500)) {
		KeywordUtil.logInfo("WinAppDriver already running on 127.0.0.1:4723")
		return
	}

	KeywordUtil.markFailedAndStop(
		"WinAppDriver is not running on 127.0.0.1:4723. Open WinAppDriver.exe manually before running the suite."
	)
}

private Map<String, String> waitForWindow(String expectedTitle, int timeoutSeconds) {
	String normalizedExpected = normalizeTitle(expectedTitle)
	long end = System.currentTimeMillis() + (timeoutSeconds * 1000L)

	while (System.currentTimeMillis() < end) {
		Map<String, String> found = queryMainWindow(normalizedExpected)

		String foundTitle = normalizeTitle(safe(found.title))
		String foundHandle = safe(found.handle)

		if (foundTitle && foundTitle == normalizedExpected && foundHandle && foundHandle != '0') {
			return [title: foundTitle, handle: foundHandle]
		}

		sleepMs(1000)
	}

	return [title: '', handle: '']
}

private Map<String, String> queryMainWindow(String expectedTitle) {
	String exact = escapePowerShell(expectedTitle)

	String script = """
\$ErrorActionPreference = 'SilentlyContinue'

\$p = Get-Process |
    Where-Object { \$_.MainWindowTitle -and \$_.MainWindowTitle.Trim() -eq '${exact}' } |
    Select-Object -First 1 MainWindowTitle, MainWindowHandle

if (-not \$p) {
    \$p = Get-Process |
        Where-Object { \$_.MainWindowTitle -and \$_.MainWindowTitle.Trim() -like '*${exact}*' } |
        Select-Object -First 1 MainWindowTitle, MainWindowHandle
}

if (\$p) {
    [PSCustomObject]@{
        title  = [string]\$p.MainWindowTitle
        handle = [string]\$p.MainWindowHandle
    } | ConvertTo-Json -Compress
}
"""

	String output = safe(runPowerShell(script))
	if (!output) {
		return [title: '', handle: '']
	}

	String jsonLine = output.readLines().find { it?.trim()?.startsWith('{') && it?.trim()?.endsWith('}') }
	if (!jsonLine) {
		return [title: '', handle: '']
	}

	try {
		def parsed = new JsonSlurper().parseText(jsonLine)
		return [
			title : safe(parsed?.title),
			handle: safe(parsed?.handle)
		]
	} catch (Throwable ignored) {
		return [title: '', handle: '']
	}
}

private String findWindowHandleByTitle(String exactTitle) {
	Map<String, String> found = queryMainWindow(normalizeTitle(exactTitle))
	return safe(found.handle)
}

private void waitForStableMainWindow(String expectedTitle, String expectedHandle, int stableRoundsNeeded) {
	int stableRounds = 0

	for (int i = 1; i <= 30; i++) {
		String currentHandle = findWindowHandleByTitle(expectedTitle)

		if (safe(currentHandle) && currentHandle == expectedHandle) {
			stableRounds++
			KeywordUtil.logInfo("Stable handle round ${stableRounds}/${stableRoundsNeeded} for ${expectedTitle}")

			if (stableRounds >= stableRoundsNeeded) {
				sleepMs(2500)
				return
			}
		} else {
			stableRounds = 0
		}

		sleepMs(1000)
	}

	KeywordUtil.logInfo("Window did not fully stabilize in time. Continuing with handle ${expectedHandle}")
}






// =========================================================================
// SECTION 8 - DRIVER ATTACH
// =========================================================================

private WindowsDriver attachExistingWindowByHandle(Object handleValue) {
	String handleDec = safe(handleValue)

	if (!handleDec) {
		KeywordUtil.markFailedAndStop("Window handle is empty")
	}

	long handleLong
	try {
		handleLong = Long.parseLong(handleDec)
	} catch (Throwable ignored) {
		KeywordUtil.markFailedAndStop("Window handle is invalid: ${handleDec}")
		return null
	}

	String handleHex = Long.toHexString(handleLong).toUpperCase()
	URL serverUrl = new URL(DEFAULT_WINAPPDRIVER_URL)

	DesiredCapabilities caps = new DesiredCapabilities()
	caps.setCapability('platformName', 'Windows')
	caps.setCapability('deviceName', 'WindowsPC')
	caps.setCapability('appTopLevelWindow', handleHex)
	caps.setCapability('ms:waitForAppLaunch', '60')

	KeywordUtil.logInfo("Attaching by native handle ${handleHex} using ${serverUrl}")

	WindowsDriver driver = new WindowsDriver(serverUrl, caps)
	registerWindowsDriver(driver)
	return driver
}

private void registerWindowsDriver(WindowsDriver driver) {
	boolean registered = false

	try {
		Class<?> factoryClass = Class.forName('com.kms.katalon.core.windows.driver.WindowsDriverFactory')

		def method = factoryClass.declaredMethods.find {
			it.name == 'changeDriver' && it.parameterCount == 1
		}

		if (method != null) {
			method.accessible = true
			method.invoke(null, driver)
			registered = true
			KeywordUtil.logInfo("Windows driver registered through WindowsDriverFactory.changeDriver")
		}

		if (!registered) {
			trySetStaticField(factoryClass, 'windowsSession', driver)
			trySetStaticField(factoryClass, 'session', driver)
			trySetStaticField(factoryClass, 'driver', driver)
			registered = true
			KeywordUtil.logInfo("Windows driver registered through reflective session field update")
		}
	} catch (Throwable ignored) {
	}

	try {
		DriverFactory.changeWebDriver(driver)
	} catch (Throwable ignored) {
	}

	if (!registered) {
		KeywordUtil.logInfo("Windows driver fallback registration completed through DriverFactory.changeWebDriver")
	}
}

private void trySetStaticField(Class<?> clazz, String fieldName, Object value) {
	try {
		def field = clazz.getDeclaredField(fieldName)
		field.accessible = true
		field.set(null, value)
	} catch (Throwable ignored) {
	}
}

private boolean waitForAnyLoginIndicator(int timeoutSeconds) {
	long end = System.currentTimeMillis() + (timeoutSeconds * 1000L)

	while (System.currentTimeMillis() < end) {
		if (waitPresent(envComboObj(), 2)) {
			return true
		}

		if (waitPresent(connectBtnObj(), 2)) {
			return true
		}

		try {
			WebDriver driver = DriverFactory.getWebDriver()
			String title = safe(driver?.getTitle())
			if (title) {
				return true
			}
		} catch (Throwable ignored) {
		}

		sleepMs(500)
	}

	return false
}


// =========================================================================
// SECTION 11 - POWERSHELL / SYSTEM
// =========================================================================

private boolean fileExists(String path) {
	String value = safe(path)
	return value && new File(value).exists()
}

private boolean isPortOpen(String host, int port, int timeoutMs) {
	try {
		Socket socket = new Socket()
		socket.connect(new InetSocketAddress(host, port), timeoutMs)
		socket.close()
		return true
	} catch (Throwable ignored) {
		return false
	}
}

private String runPowerShell(String script) {
	Process process = new ProcessBuilder(
		'powershell.exe',
		'-NoProfile',
		'-ExecutionPolicy', 'Bypass',
		'-Command', script
	)
	.redirectErrorStream(true)
	.start()

	String output = process.inputStream.getText('UTF-8')
	process.waitFor()
	return safe(output)
}

private void runDetachedPowerShell(String script) {
	new ProcessBuilder(
		'powershell.exe',
		'-NoProfile',
		'-ExecutionPolicy', 'Bypass',
		'-Command', script
	).start()
}

private void openExecutableNoConsole(String path) {
	new ProcessBuilder(path).start()
}

private void openFileNoConsole(String path) {
	try {
		File file = new File(path)
		if (file.exists() && Desktop.isDesktopSupported()) {
			Desktop.getDesktop().open(file)
			return
		}
	} catch (Throwable ignored) {
	}

	new ProcessBuilder('explorer.exe', path).start()
}




// =========================================================================
// SECTION 13 - GENERIC UTILS
// =========================================================================

private void sleepMs(long ms) {
	try {
		Thread.sleep(ms)
	} catch (InterruptedException ignored) {
		Thread.currentThread().interrupt()
	}
}

private String normalizeTitle(String value) {
	return safe(value).replaceAll('\\s+', ' ').trim()
}

private String safe(Object value) {
	return value == null ? '' : value.toString().trim()
}

private String escapePowerShell(String value) {
	return safe(value).replace("'", "''")
}

private String xpathLiteral(String value) {
	String v = safe(value)

	if (!v.contains("'")) {
		return "'${v}'"
	}

	if (!v.contains('"')) {
		return "\"${v}\""
	}

	List<String> parts = v.split("'").collect { "'${it}'" }
	return "concat(${parts.join(", \"'\", ")})"
}


