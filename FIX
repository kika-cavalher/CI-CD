    color: #5a6776;
}
.step-row {
    position: relative;
    font-size: 13px;
    color: #15212b;
}
.step-row::after {
    content: "";
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 0;
    height: 1px;
    background: #edf2f7;
}
.step-row:last-child::after {
    display: none;
}
.col-status {
    min-width: 0;
