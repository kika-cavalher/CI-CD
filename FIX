package keywords

import static com.kms.katalon.core.testobject.ObjectRepository.findTestObject

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.model.FailureHandling

import internal.GlobalVariable

class Login {

	@Keyword
	@Given("user opens Hue login page")
	def userOpensHueLoginPage() {
		KeywordUtil.logInfo("Opening Hue login page")

		WebUI.openBrowser('')
		WebUI.maximizeWindow()
		WebUI.navigateToUrl(GlobalVariable.HUE_URL)

		WebUI.waitForPageLoad(30)
		WebUI.waitForElementVisible(findTestObject('Hue/Login/input_Username'), 30)
	}

	@Keyword
	@When("user logs in with default profile credentials")
	def userLogsInWithDefaultProfileCredentials() {
		KeywordUtil.logInfo("Filling Hue login credentials")

		WebUI.setText(findTestObject('Hue/Login/input_Username'), GlobalVariable.HUE_USERNAME)
		WebUI.setEncryptedText(findTestObject('Hue/Login/input_Password'), GlobalVariable.HUE_PASSWORD)

		WebUI.click(findTestObject('Hue/Login/button_SignIn'))

		WebUI.waitForPageLoad(60)
	}

	@Keyword
	@Then("Hue editor should be opened")
	def hueEditorShouldBeOpened() {
		KeywordUtil.logInfo("Verifying Hue editor was opened")

		WebUI.waitForUrlContains('/hue/editor/', 60)

		String currentUrl = WebUI.getUrl()
		KeywordUtil.logInfo("Current URL: " + currentUrl)

		WebUI.verifyMatch(
			currentUrl,
			".*/hue/editor/.*",
			true,
			FailureHandling.STOP_ON_FAILURE
		)
	}

	@Keyword
	@And("Hive editor should be selected by default")
	def hiveEditorShouldBeSelectedByDefault() {
		KeywordUtil.logInfo("Verifying Hive editor is selected by default")

		String currentUrl = WebUI.getUrl()
		KeywordUtil.logInfo("Current URL: " + currentUrl)

		WebUI.verifyMatch(
			currentUrl,
			".*" + GlobalVariable.HUE_EXPECTED_DEFAULT_TYPE + ".*",
			true,
			FailureHandling.STOP_ON_FAILURE
		)
	}

	@Keyword
	@And("default database should be selected")
	def defaultDatabaseShouldBeSelected() {
		KeywordUtil.logInfo("Verifying default database is selected")

		WebUI.waitForElementVisible(
			findTestObject('Hue/Editor/dropdown_DefaultDatabase'),
			60,
			FailureHandling.STOP_ON_FAILURE
		)

		WebUI.verifyElementText(
			findTestObject('Hue/Editor/dropdown_DefaultDatabase'),
			GlobalVariable.HUE_EXPECTED_DATABASE,
			FailureHandling.STOP_ON_FAILURE
		)

		WebUI.closeBrowser()
	}
}

