@echo off
setlocal EnableExtensions EnableDelayedExpansion

REM ============================================================================
REM  eMatch Automation Runner
REM  Reads context from:  D:\Projects\eMatchStarters\run-context.properties
REM  Writes marker to:    D:\Projects\eMatchStarters\logs\__jenkins_task_exitcode.txt
REM ============================================================================

set "CTX_FILE=D:\Projects\eMatchStarters\run-context.properties"

if not exist "%CTX_FILE%" (
    echo [ERROR] CTX_FILE not found: "%CTX_FILE%"
    exit /b 98
)

REM ---------------------------------------------------------------------------
REM Load key=value pairs from ctx into env vars
REM ---------------------------------------------------------------------------
for /f "usebackq tokens=1* delims==" %%A in ("%CTX_FILE%") do (
    set "K=%%A"
    set "V=%%B"
    if not "!K!"=="" set "!K!=!V!"
)

REM ---------------------------------------------------------------------------
REM Defaults
REM ---------------------------------------------------------------------------
if "%BROWSER_TYPE%"==""    set "BROWSER_TYPE=Windows"
if "%RETRY%"==""           set "RETRY=0"

if "%LOG_FILE%"=="" (
    set "LOG_FILE=D:\Projects\eMatchStarters\logs\katalon_%DATE:~-4%%DATE:~3,2%%DATE:~0,2%_%TIME:~0,2%%TIME:~3,2%%TIME:~6,2%.log"
    set "LOG_FILE=%LOG_FILE: =0%"
)

if "%MARKER_FILE%"=="" (
    set "MARKER_FILE=D:\Projects\eMatchStarters\logs\__jenkins_task_exitcode.txt"
)

REM Ensure logs folder exists
for %%D in ("%LOG_FILE%") do if not exist "%%~dpD" mkdir "%%~dpD" 1>nul 2>nul
for %%D in ("%MARKER_FILE%") do if not exist "%%~dpD" mkdir "%%~dpD" 1>nul 2>nul

REM ---------------------------------------------------------------------------
REM Print context
REM ---------------------------------------------------------------------------
echo.
echo [INFO] WORKSPACE      "%WORKSPACE%"
echo [INFO] PROJECT_PATH   "%PROJECT_PATH%"
echo [INFO] KATALON_EXE    "%KATALON_EXE%"
echo [INFO] COLLECTION     "%COLLECTION_PATH%"
echo [INFO] BROWSER_TYPE   "%BROWSER_TYPE%"
echo [INFO] RETRY          "%RETRY%"
echo [INFO] LOG_FILE       "%LOG_FILE%"
echo [INFO] MARKER_FILE    "%MARKER_FILE%"
echo.

REM ---------------------------------------------------------------------------
REM Validate required vars
REM ---------------------------------------------------------------------------
if "%PROJECT_PATH%"=="" (
    echo [ERROR] PROJECT_PATH is empty in run-context.properties
    call :WriteMarker 97
    exit /b 97
)

if "%KATALON_EXE%"=="" (
    echo [ERROR] KATALON_EXE is empty in run-context.properties
    call :WriteMarker 96
    exit /b 96
)

if "%COLLECTION_PATH%"=="" (
    echo [ERROR] COLLECTION_PATH is empty in run-context.properties
    call :WriteMarker 95
    exit /b 95
)

if not exist "%PROJECT_PATH%" (
    echo [ERROR] PROJECT_PATH not found: "%PROJECT_PATH%"
    call :WriteMarker 94
    exit /b 94
)

if not exist "%KATALON_EXE%" (
    echo [ERROR] KATALON_EXE not found: "%KATALON_EXE%"
    call :WriteMarker 93
    exit /b 93
)

REM ---------------------------------------------------------------------------
REM Clean old marker to avoid Jenkins reading stale values
REM ---------------------------------------------------------------------------
if exist "%MARKER_FILE%" del /f /q "%MARKER_FILE%" 1>nul 2>nul
if exist "%MARKER_FILE%.tmp" del /f /q "%MARKER_FILE%.tmp" 1>nul 2>nul

REM ---------------------------------------------------------------------------
REM Run Katalon in the SAME visible console
REM Keep it visible so you can see execution
REM ---------------------------------------------------------------------------
echo [INFO] Starting Katalon execution...
echo.

pushd "%WORKSPACE%" 1>nul 2>nul

"%KATALON_EXE%" ^
  -noSplash ^
  -runMode=console ^
  -projectPath="%PROJECT_PATH%" ^
  -testSuiteCollectionPath="%COLLECTION_PATH%" ^
  -browserType="%BROWSER_TYPE%" ^
  -retry="%RETRY%"

set "EXITCODE=%ERRORLEVEL%"

popd 1>nul 2>nul

echo.
echo [INFO] Katalon finished with exit code: %EXITCODE%
echo.

call :WriteMarker %EXITCODE%
exit /b %EXITCODE%

REM ---------------------------------------------------------------------------
REM Write marker atomically to avoid AccessDenied or partial reads
REM ---------------------------------------------------------------------------
:WriteMarker
set "CODE=%~1"

REM Write to tmp then move
> "%MARKER_FILE%.tmp" echo %CODE%
move /y "%MARKER_FILE%.tmp" "%MARKER_FILE%" 1>nul 2>nul

REM Extra safety: ensure marker exists
if not exist "%MARKER_FILE%" (
    echo [WARN] Marker could not be written, retrying once...
    > "%MARKER_FILE%.tmp" echo %CODE%
    move /y "%MARKER_FILE%.tmp" "%MARKER_FILE%" 1>nul 2>nul
)

exit /b 0
