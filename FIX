    private String htmlEscape(def value) {
        String text = safeValue(value)
        return text
            .replace('&', '&amp;')
            .replace('<', '&lt;')
            .replace('>', '&gt;')
            .replace('"', '&quot;')
            .replace("'", '&#39;')
    }

    private String statusClass(def statusValue) {
        String s = safeValue(statusValue).toLowerCase()
        if (s == 'failed' || s == 'fail') {
            return 'fail'
        }
        if (s == 'skipped' || s == 'skip') {
            return 'skip'
        }
        return 'pass'
    }

    private String statusLabel(def statusValue) {
        String s = safeValue(statusValue).toLowerCase()
        if (s == 'failed' || s == 'fail') {
            return 'Fail'
        }
        if (s == 'skipped' || s == 'skip') {
            return 'Skipped'
        }
        return 'Pass'
    }

    private String buildStatCard(String label, String value, String extraClass) {
        StringBuilder html = new StringBuilder()
        html.append('<div class="stat-card ')
        html.append(htmlEscape(extraClass))
        html.append('">')
        html.append('<div class="stat-label">')
        html.append(htmlEscape(label))
        html.append('</div>')
        html.append('<div class="stat-value">')
        html.append(htmlEscape(value))
        html.append('</div>')
        html.append('</div>')
        return html.toString()
    }

