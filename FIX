	}

	String formatDurationSeconds(BigDecimal totalSeconds) {
		if (totalSeconds == null) {
			return '0ms'
		}

		long millis = (long) (totalSeconds * 1000)
		long hours = millis / 3600000
		long minutes = (millis % 3600000) / 60000
		long seconds = (millis % 60000) / 1000
		long ms = millis % 1000

		if (hours > 0) {
			return "${hours}h ${minutes}m ${seconds}s ${ms}ms"
		}
		if (minutes > 0) {
			return "${minutes}m ${seconds}s ${ms}ms"
		}
		if (seconds > 0) {
			return "${seconds}s ${ms}ms"
		}
		return "${ms}ms"
	}

	String normalizeSuiteName(String suiteName) {
		if (isBlank(suiteName)) {
			return ''
		}
		return suiteName.trim()
	}

	boolean isTimestampFolderName(String name) {
		if (isBlank(name)) {
			return false
		}
		return name ==~ /\d{8}_\d{6}/
	}

	boolean isIgnorableFolderName(String folderName) {
		if (isBlank(folderName)) return true

		String name = folderName.trim()

		if (name.equalsIgnoreCase('Reports')) return true
		if (name.equalsIgnoreCase('logs')) return true
		if (name.equalsIgnoreCase('videos')) return true
		if (name.equalsIgnoreCase('cucumber_report')) return true
		if (name.equalsIgnoreCase('PreLoad')) return true
		if (name.equalsIgnoreCase(EVIDENCE_FOLDER_NAME)) return true
		if (isTimestampFolderName(name)) return true

		return false
	}

