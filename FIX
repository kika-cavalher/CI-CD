/*
 * ============================================================
 * eMatch startup and login flow
 * Refactored with:
 * 1. clear constants
 * 2. self contained retry logic
 * 3. fallback for window titles
 * 4. safer environment selection
 * 5. safer startup flow
 * ============================================================
 */

// ============================================================
// Hardcoded paths
// ============================================================
final String EMATCH_LNK_PATH = 'D:\\RunAseMatchReq\\eMatch.lnk'
final String EMATCH_APPLICATION_PATH = '\\\\cib.net\\shareparis\\Soft\\ematch\\IHM\\Livraisons\\REC\\IXIS.Ematch.IHM.application'
final String WINAPPDRIVER_EXE = 'C:\\Program Files (x86)\\Windows Application Driver\\WinAppDriver.exe'
final String RESOLUTION_SCRIPT_PATH = 'D:\\setResolution.ps1'

// ============================================================
// Timeouts and retry setup
// ============================================================
final int APP_LAUNCH_DELAY_SEC = 5
final int WINDOW_ATTACH_TIMEOUT_SEC = 60
final int WINDOW_ATTACH_RETRY_SEC = 2
final int CLICK_RETRY_ATTEMPTS = 3
final int CLICK_RETRY_DELAY_SEC = 2
final int SEARCH_BOX_TIMEOUT_SEC = 60

// ============================================================
// Environment mapping
// IMPORTANT:
// We move to the first option with HOME,
// then ARROW_DOWN envIndex - 1 times
// ============================================================
final Map<String, Integer> ENV_INDEX_MAP = [
	'PROD': 1,
	'PREX': 2,
	'REC2': 3,
	'REC' : 4,
	'DEV2': 5,
	'DEV' : 6
]

// ============================================================
// Runtime values
// ============================================================
String currentUser = System.getProperty('user.name')?.trim() ?: ''
String configuredUser = (GlobalVariable.username ?: '').trim()
String configuredEnv = (GlobalVariable.env ?: 'REC').trim().toUpperCase()

List<String> candidateWindowTitles = [
	GlobalVariable.versionProd?.toString()?.trim(),
	GlobalVariable.version?.toString()?.trim()
].findAll { it }

// ============================================================
// Helpers
// ============================================================
def note = { String message ->
	KeywordUtil.logInfo(message)
	try {
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'(message)
	} catch (Exception ignored) {
		KeywordUtil.logInfo("JiraReportSteps.note unavailable: ${ignored.message}")
	}
}

def failAndStop = { String message ->
	note(message)
	KeywordUtil.markFailedAndStop(message)
}

def buildWindowObjectByName = { String windowTitle ->
	WindowsTestObject targetWindow = new WindowsTestObject()
	targetWindow.setLocatorStrategy(LocatorStrategy.NAME)
	targetWindow.setLocator(windowTitle)
	return targetWindow
}

def isProcessRunning = { String processName ->
	try {
		Process p = ['cmd', '/c', "tasklist /FI \"IMAGENAME eq ${processName}\""].execute()
		p.waitFor()
		String output = p.in.text ?: ''
		return output.toLowerCase().contains(processName.toLowerCase())
	} catch (Exception e) {
		note("Could not verify process '${processName}': ${e.message}")
		return false
	}
}

def runResolutionScript = {
	try {
		if (new File(RESOLUTION_SCRIPT_PATH).exists()) {
			note("Running resolution script: ${RESOLUTION_SCRIPT_PATH}")
			new ProcessBuilder([
				'Powershell.exe',
				'-ExecutionPolicy',
				'Bypass',
				'-File',
				RESOLUTION_SCRIPT_PATH
			]).start()
			Windows.delay(2)
		} else {
			note("Resolution script not found. Skipping: ${RESOLUTION_SCRIPT_PATH}")
		}
	} catch (Exception e) {
		note("Resolution script failed, continuing anyway: ${e.message}")
	}
}

def ensureWinAppDriverStarted = {
	if (isProcessRunning('WinAppDriver.exe')) {
		note('WinAppDriver is already running.')
		return
	}

	if (!new File(WINAPPDRIVER_EXE).exists()) {
		failAndStop("WinAppDriver.exe not found at: ${WINAPPDRIVER_EXE}")
	}

	try {
		note("Starting WinAppDriver: ${WINAPPDRIVER_EXE}")
		new ProcessBuilder([WINAPPDRIVER_EXE]).start()
		Windows.delay(2)
	} catch (Exception e) {
		failAndStop("Failed to start WinAppDriver: ${e.message}")
	}
}

def startEmatchApplication = {
	if (candidateWindowTitles.isEmpty()) {
		failAndStop("No valid window title found. Check GlobalVariable.versionProd / GlobalVariable.version.")
	}

	String preferredWindowTitle = candidateWindowTitles[0]

	if (currentUser.equalsIgnoreCase(configuredUser)) {
		note("Runtime user matches configured user '${configuredUser}'. Starting eMatch with shortcut.")
		runResolutionScript()

		try {
			note("Starting eMatch using shortcut: ${EMATCH_LNK_PATH}")
			note("Expected title: ${preferredWindowTitle}")
			Windows.startApplicationWithTitle(EMATCH_LNK_PATH, preferredWindowTitle)
		} catch (Exception shortcutException) {
			note("Shortcut startup failed. Falling back to .application path. Reason: ${shortcutException.message}")
			Windows.startApplication(EMATCH_APPLICATION_PATH)
		}
	} else {
		note("Runtime user does not match configured user. Starting eMatch through WinAppDriver flow.")
		ensureWinAppDriverStarted()
		note("Starting eMatch using .application path: ${EMATCH_APPLICATION_PATH}")
		Windows.startApplication(EMATCH_APPLICATION_PATH)
	}

	Windows.delay(APP_LAUNCH_DELAY_SEC)
}

def switchToAnyMatchingWindow = { List<String> titles, int timeoutSec = WINDOW_ATTACH_TIMEOUT_SEC, int retrySec = WINDOW_ATTACH_RETRY_SEC ->
	long endTime = System.currentTimeMillis() + (timeoutSec * 1000L)
	Exception lastException = null

	while (System.currentTimeMillis() < endTime) {
		try {
			Windows.switchToDesktop()
		} catch (Exception ignored) {
		}

		for (String title : titles) {
			try {
				Windows.switchToWindow(buildWindowObjectByName(title))
				note("Switched successfully to window: ${title}")
				return title
			} catch (Exception e) {
				lastException = e
			}
		}

		Windows.delay(retrySec)
	}

	String triedTitles = titles.join(', ')
	String lastError = lastException ? lastException.message : 'No detailed exception captured'
	failAndStop("Could not attach to eMatch window within ${timeoutSec} seconds. Titles tried: [${triedTitles}]. Last error: ${lastError}")
	return null
}

def clickObjectWithRetry = { String objectRepoId, int attempts = CLICK_RETRY_ATTEMPTS, int delaySec = CLICK_RETRY_DELAY_SEC ->
	Exception lastException = null

	for (int attempt = 1; attempt <= attempts; attempt++) {
		try {
			Windows.click(findWindowsObject(objectRepoId))
			return
		} catch (Exception e) {
			lastException = e
			note("Click attempt ${attempt}/${attempts} failed for '${objectRepoId}': ${e.message}")
			Windows.delay(delaySec)
		}
	}

	throw lastException
}

def selectEnvironment = { String envName ->
	Integer envIndex = ENV_INDEX_MAP[envName]

	if (envIndex == null) {
		failAndStop("Unsupported environment '${envName}'. Supported values: ${ENV_INDEX_MAP.keySet().join(', ')}")
	}

	note("Selecting environment: ${envName} (index ${envIndex})")

	clickObjectWithRetry('Login Page/optEnv')
	Windows.delay(1)

	/*
	 * Reset selection to the first item before moving down.
	 * This avoids wrong selections when the previous environment remains selected.
	 */
	Windows.sendKeys(findWindowsObject('Login Page/optEnv'), Keys.chord(Keys.HOME))
	Windows.delay(1)

	for (int i = 1; i < envIndex; i++) {
		Windows.sendKeys(findWindowsObject('Login Page/optEnv'), Keys.chord(Keys.ARROW_DOWN))
		Windows.delay(1)
	}

	Windows.sendKeys(findWindowsObject('Login Page/optEnv'), Keys.chord(Keys.ENTER))
	Windows.delay(3)
}

def clickConnectIfPresent = {
	boolean connectButtonPresent = false

	try {
		connectButtonPresent = Windows.verifyElementPresent(
			findWindowsObject('Login Page/btnConnecter'),
			2,
			FailureHandling.OPTIONAL
		)
	} catch (Exception ignored) {
		connectButtonPresent = false
	}

	if (connectButtonPresent) {
		note("Connect button found. Clicking it.")
		clickObjectWithRetry('Login Page/btnConnecter')
	} else {
		note("Connect button not present. Continuing flow.")
	}
}

def waitForSearchField = {
	boolean loaded = false

	try {
		loaded = Windows.waitForElementPresent(findWindowsObject('General/txtSearch'), SEARCH_BOX_TIMEOUT_SEC)
	} catch (Exception e) {
		note("Search field wait raised exception: ${e.message}")
		loaded = false
	}

	if (!loaded) {
		failAndStop("eMatch main screen did not load. 'General/txtSearch' was not found within ${SEARCH_BOX_TIMEOUT_SEC} seconds.")
	}

	note("eMatch main screen detected.")
}

def ensureHomeTabActive = {
	String homeGrey = new File(RunConfiguration.getProjectDir(), 'Images/General/HomeGrey.PNG').getAbsolutePath()
	String homeWhite = new File(RunConfiguration.getProjectDir(), 'Images/General/HomeWhite.PNG').getAbsolutePath()

	if (!new File(homeGrey).exists()) {
		note("HomeGrey image not found: ${homeGrey}")
		return
	}

	if (!new File(homeWhite).exists()) {
		note("HomeWhite image not found: ${homeWhite}")
		return
	}

	try {
		def activeTab = WindowsImageKeywords.findImage(homeGrey)
		if (activeTab != null) {
			note('Home tab is already active.')
			return
		}
	} catch (Exception ignored) {
	}

	try {
		def inactiveTab = WindowsImageKeywords.findImage(homeWhite)
		if (inactiveTab != null) {
			note('Home tab found inactive. Clicking to activate it.')
			Windows.click(inactiveTab)
			Windows.delay(5)
		} else {
			note('Home tab image was not found on screen.')
		}
	} catch (Exception e) {
		note("Failed while trying to activate Home tab: ${e.message}")
	}
}

// ============================================================
// Main flow
// ============================================================
note('Verify set Username and version')
note("Runtime user.name: ${currentUser}")
note("GlobalVariable.username: ${GlobalVariable.username}")
note("GlobalVariable.version: ${GlobalVariable.version}")
note("GlobalVariable.versionProd: ${GlobalVariable.versionProd}")
note("GlobalVariable.env: ${GlobalVariable.env}")
note("EMATCH_LNK_PATH: ${EMATCH_LNK_PATH}")
note("EMATCH_APPLICATION_PATH: ${EMATCH_APPLICATION_PATH}")

try {
	startEmatchApplication()

	String attachedWindowTitle = switchToAnyMatchingWindow(candidateWindowTitles)
	note("Attached window title: ${attachedWindowTitle}")

	selectEnvironment(configuredEnv)
	clickConnectIfPresent()
	waitForSearchField()
	ensureHomeTabActive()

	note('eMatch startup flow completed successfully.')
} catch (Throwable t) {
	String rootMessage = "Failed to start and initialize eMatch. ${t.getClass().getName()}: ${t.getMessage()}"
	note(rootMessage)
	KeywordUtil.markFailedAndStop(rootMessage)
}
