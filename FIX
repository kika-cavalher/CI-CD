/*
 * Responsibility:
 * Shared desktop pipeline runner for separated desktop Jenkins jobs.
 * Jenkins only prepares the environment and runs Katalon.
 * REC / PRD opening logic remains inside the Katalon login tests.
 */

def run(script, Map cfg) {
    def consoleView = script.load('jenkinsIntegration/JenkinsConsoleView.groovy')
    def resultStore = script.load('jenkinsIntegration/JenkinsResultStore.groovy')
    def taskLogger  = script.load('jenkinsIntegration/JenkinsDesktopTaskLogger.groovy')

    String reportsRoot = "${script.pwd()}\\Reports"
    List suiteResults = []

    script.stage('Validate Environment') {
        script.bat """
@echo off
echo ------------------------------------------------------------
echo VALIDATING TOOLS AND SUPPORT FILES
echo ------------------------------------------------------------

if not exist "${script.pwd()}\\${cfg.projectFileName}" (
    echo [ERROR] Project file not found
    echo ${script.pwd()}\\${cfg.projectFileName}
    exit /b 1
)

if not exist "${cfg.katalonExe}" (
    echo [ERROR] Katalon executable not found
    echo ${cfg.katalonExe}
    exit /b 1
)

schtasks /query /tn "${cfg.winDriverTask}" >nul 2>nul
if errorlevel 1 (
    echo [ERROR] WinDriver task not found
    echo ${cfg.winDriverTask}
    exit /b 1
)

schtasks /query /tn "${cfg.desktopRunnerTask}" >nul 2>nul
if errorlevel 1 (
    echo [ERROR] Desktop runner task not found
    echo ${cfg.desktopRunnerTask}
    exit /b 1
)

if not exist "${script.pwd()}\\jenkinsIntegration\\JenkinsConsoleView.groovy" (
    echo [ERROR] JenkinsConsoleView.groovy not found
    exit /b 1
)

if not exist "${script.pwd()}\\jenkinsIntegration\\JenkinsResultStore.groovy" (
    echo [ERROR] JenkinsResultStore.groovy not found
    exit /b 1
)

if not exist "${script.pwd()}\\jenkinsIntegration\\JenkinsDesktopTaskLogger.groovy" (
    echo [ERROR] JenkinsDesktopTaskLogger.groovy not found
    exit /b 1
)

echo [OK] Support files and scheduled tasks found
echo ------------------------------------------------------------
"""
    }

    script.stage('Prepare Artifacts') {
        script.bat """
@echo off
if exist "${reportsRoot}" rmdir /s /q "${reportsRoot}"
mkdir "${reportsRoot}"
mkdir "${reportsRoot}\\logs"
"""
        resultStore.saveSuiteResults(script, reportsRoot, [])
    }

    try {
        script.stage(cfg.executionStageName ?: 'Run Test Assets') {
            cfg.assets.each { asset ->
                script.stage("Run - ${asset.name}") {
                    consoleView.printSuiteHeader(
                        script,
                        asset.name,
                        asset.path,
                        (asset.timeoutMinutes ?: cfg.defaultTimeoutMinutes ?: 30).toString()
                    )

                    int exitCode = taskLogger.runAsset(script, [
                        katalonExe        : cfg.katalonExe,
                        projectPath       : "${script.pwd()}\\${cfg.projectFileName}",
                        reportsRoot       : reportsRoot,
                        defaultTimeoutMin : (cfg.defaultTimeoutMinutes ?: 30),
                        desktopRunnerTask : cfg.desktopRunnerTask,
                        winDriverTask     : cfg.winDriverTask
                    ], asset)

                    Map meta = resultStore.readSuiteMeta(script, reportsRoot, asset.name)

                    Map result = [
                        name            : asset.name,
                        path            : asset.path,
                        type            : asset.type ?: 'COLLECTION',
                        status          : meta['STATUS'] ?: (exitCode == 0 ? 'PASSED' : 'FAILED'),
                        icon            : meta['ICON'] ?: (exitCode == 0 ? '✅' : '❌'),
                        exitCode        : meta['EXIT_CODE'] ?: "${exitCode}",
                        executed        : meta['EXECUTED'] ?: '0',
                        passed          : meta['PASSED'] ?: '0',
                        failed          : meta['FAILED'] ?: '0',
                        skipped         : meta['SKIPPED'] ?: '0',
                        durationSeconds : meta['DURATION_SECONDS'] ?: '0',
                        reason          : meta['REASON'] ?: '',
                        screenshotRel   : meta['SCREENSHOT_REL'] ?: '',
                        logRel          : meta['LOG_REL'] ?: '',
                        caseSummary     : resultStore.splitSummary(meta['CASE_SUMMARY'] ?: ''),
                        stepSummary     : resultStore.splitSummary(meta['STEP_SUMMARY'] ?: '')
                    ]

                    suiteResults << result

                    resultStore.saveSuiteResults(script, reportsRoot, suiteResults)

                    consoleView.printSuiteResult(script, result)
                    consoleView.printRunningSummary(script, suiteResults)

                    if (result.status != 'PASSED') {
                        script.currentBuild.result = 'FAILURE'
                        script.error("${result.name} finished with status ${result.status}")
                    }
                }
            }
        }
    } finally {
        try {
            suiteResults = resultStore.loadSuiteResults(script, reportsRoot)
        } catch (ignored) {
            suiteResults = []
        }

        try {
            consoleView.printFinalSummary(script, suiteResults, script.currentBuild.currentResult)
        } catch (ignored) {
            script.echo '============================================================'
            script.echo 'PIPELINE FINISHED'
            script.echo '============================================================'
        }

        script.catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
            script.junit allowEmptyResults: true, testResults: 'Reports/**/*.xml,Reports/logs/*.junit.xml'
        }

        script.catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
            script.archiveArtifacts artifacts: 'Reports/**/*', allowEmptyArchive: true
        }

        if ((script.currentBuild.currentResult == null || script.currentBuild.currentResult == 'SUCCESS') &&
            (cfg.nextJobName ?: '').trim()) {
            script.echo "Triggering next Jenkins job: ${cfg.nextJobName}"
            script.build job: cfg.nextJobName, wait: false, propagate: false
        }
    }
}

return this









import groovy.json.JsonOutput
import groovy.json.JsonSlurperClassic

def saveSuiteResults(script, String reportsRoot, List suiteResults) {
    String targetFile = "${reportsRoot}\\suite-results.json"
    script.writeFile(
        file: targetFile,
        text: JsonOutput.prettyPrint(JsonOutput.toJson(suiteResults ?: [])),
        encoding: 'UTF-8'
    )
}

def loadSuiteResults(script, String reportsRoot) {
    String targetFile = "${reportsRoot}\\suite-results.json"
    if (!script.fileExists(targetFile)) {
        return []
    }

    String raw = script.readFile(file: targetFile, encoding: 'UTF-8')
    if (!raw?.trim()) {
        return []
    }

    def parsed = new JsonSlurperClassic().parseText(raw)
    return (parsed instanceof List) ? parsed : []
}

def readSuiteMeta(script, String reportsRoot, String assetName) {
    String safeName = sanitizeFileName(assetName)
    String metaFile = "${reportsRoot}\\logs\\${safeName}.meta"

    if (!script.fileExists(metaFile)) {
        return [:]
    }

    String raw = script.readFile(file: metaFile, encoding: 'UTF-8')
    Map result = [:]

    raw.readLines().each { line ->
        int idx = line.indexOf('=')
        if (idx > 0) {
            String key = line.substring(0, idx).trim()
            String value = line.substring(idx + 1).trim()
            result[key] = value
        }
    }

    return result
}

def splitSummary(String value) {
    if (!value?.trim()) {
        return []
    }

    return value
        .split(/\s*\|\|\|\s*/)
        .collect { it?.trim() }
        .findAll { it }
}

def sanitizeFileName(String value) {
    return (value ?: 'suite')
        .replaceAll(/[\\\\\\/:"*?<>|]+/, '_')
        .replaceAll(/\s+/, '_')
}

return this
