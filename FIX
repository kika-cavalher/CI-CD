	// ======================================================
	// DELETE FAVORITE
	// ======================================================
	
	@Keyword
	void deleteCreatedFavorite(
		String favoriteTitle,
		String favoriteImageKey
	) {
	
		Integer maximumDeleteChecks = 5
		Integer waitPerDeleteCheckSeconds = 20
	
		logStep(
			'DELETE FAVORITE',
			'Favorite title: ' + favoriteTitle + '\n' +
			'Favorite image key: ' + favoriteImageKey
		)
	
		String favoritesTabImagePath =
			optionalImage(
				GUI_IMAGE_GROUP,
				'favoritesTab'
			)
	
		String favoriteImagePath =
			optionalImage(
				GUI_IMAGE_GROUP,
				favoriteImageKey
			)
	
		String deleteFavoriteImagePath =
			optionalImage(
				GUI_IMAGE_GROUP,
				'deleteFavoriteBtn'
			)
	
		if (favoritesTabImagePath.isEmpty()) {
			KeywordUtil.markFailedAndStop(
				'Favorites tab image was not found.\n' +
				'Image key: favoritesTab'
			)
	
			return
		}
	
		if (favoriteImagePath.isEmpty()) {
			KeywordUtil.markFailedAndStop(
				'Favorite image was not found in ImageLoader.\n' +
				'Favorite: ' + favoriteTitle + '\n' +
				'Image key: ' + favoriteImageKey
			)
	
			return
		}
	
		if (deleteFavoriteImagePath.isEmpty()) {
			KeywordUtil.markFailedAndStop(
				'Delete Favorite image was not found in ImageLoader.\n' +
				'Image key: deleteFavoriteBtn'
			)
	
			return
		}
	
	
		// ======================================================
		// CLOSE OPENED TABS
		// ======================================================
	
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Closing opened tabs before accessing Favorites.'
		)
	
		pressKeyboardKey(
			KeyEvent.VK_ESCAPE
		)
	
		Windows.delay(1)
	
		WindowsTestObject closeAllTabsButton =
			object(
				'closeAllTabsTopBar'
			)
	
		boolean closeAllTabsFound =
			Windows.waitForElementPresent(
				closeAllTabsButton,
				5,
				FailureHandling.OPTIONAL
			)
	
		if (closeAllTabsFound) {
			String enabledValue =
				safeText(
					Windows.getAttribute(
						closeAllTabsButton,
						'IsEnabled',
						FailureHandling.OPTIONAL
					)
				)
	
			if (!enabledValue.equalsIgnoreCase('False')) {
				Windows.click(
					closeAllTabsButton,
					FailureHandling.STOP_ON_FAILURE
				)
	
				Windows.delay(2)
	
				boolean confirmationClicked =
					clickFirstVisibleImage(
						GENERAL_IMAGE_GROUP,
						[
							'yes',
							'yesUnderline',
							'yesButton',
							'oui'
						],
						3
					)
	
				if (!confirmationClicked) {
					pressKeyboardKey(
						KeyEvent.VK_ENTER
					)
				}
	
				Windows.delay(5)
			}
		}
	
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Opened tabs closing flow completed.'
		)
	
	
		// ======================================================
		// OPEN FAVORITES TAB
		// ======================================================
	
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Clicking Favorites tab image.'
		)
	
		try {
			WindowsImageKeywords.clickImage(
				favoritesTabImagePath
			)
		} catch (Throwable favoritesTabError) {
			takeEvidence(
				'GUI_FavoritesTabNotFoundForDelete.png'
			)
	
			KeywordUtil.markFailedAndStop(
				'Favorites tab image was not found on screen.\n' +
				'Image key: favoritesTab\n' +
				'Reason: ' +
					safeText(
						favoritesTabError.getMessage()
					)
			)
	
			return
		}
	
		Windows.delay(2)
	
	
		// ======================================================
		// RIGHT CLICK FAVORITE IMAGE
		// ======================================================
	
		boolean favoriteRightClicked = false
		Throwable lastFavoriteImageError = null
	
		for (
			Integer favoriteAttempt = 1;
			favoriteAttempt <= favoriteActionAttempts;
			favoriteAttempt++
		) {
			try {
				KeywordUtil.logInfo(
					'[DELETE FAVORITE] Searching favorite image for right click.\n' +
					'Favorite: ' + favoriteTitle + '\n' +
					'Image key: ' + favoriteImageKey + '\n' +
					'Attempt: ' +
						favoriteAttempt +
						'/' +
						favoriteActionAttempts
				)
	
				WindowsImageKeywords.rightClickImage(
					favoriteImagePath
				)
	
				favoriteRightClicked = true
	
				KeywordUtil.logInfo(
					'[DELETE FAVORITE] Favorite image found.\n' +
					'Right click executed successfully.'
				)
	
				break
			} catch (Throwable favoriteImageError) {
				lastFavoriteImageError =
					favoriteImageError
	
				if (favoriteAttempt < favoriteActionAttempts) {
					Windows.delay(
						waitBetweenActionAttempts
					)
				}
			}
		}
	
		if (!favoriteRightClicked) {
			takeEvidence(
				'GUI_FavoriteNotFoundForDelete.png'
			)
	
			KeywordUtil.markFailedAndStop(
				'Favorite image was not found for right click.\n' +
				'Favorite: ' + favoriteTitle + '\n' +
				'Image key: ' + favoriteImageKey + '\n' +
				'Attempts: ' + favoriteActionAttempts + '\n' +
				'Reason: ' +
					safeText(
						lastFavoriteImageError?.getMessage()
					)
			)
	
			return
		}
	
		Windows.delay(2)
	
	
		// ======================================================
		// CLICK SUPPRIMER LE FAVORI IMAGE
		// ======================================================
	
		boolean deleteFavoriteClicked = false
		Throwable lastDeleteImageError = null
	
		for (
			Integer deleteAttempt = 1;
			deleteAttempt <= deleteActionAttempts;
			deleteAttempt++
		) {
			try {
				KeywordUtil.logInfo(
					'[DELETE FAVORITE] Searching delete image.\n' +
					'Image key: deleteFavoriteBtn\n' +
					'Expected text: Supprimer le favori\n' +
					'Attempt: ' +
						deleteAttempt +
						'/' +
						deleteActionAttempts
				)
	
				WindowsImageKeywords.clickImage(
					deleteFavoriteImagePath
				)
	
				deleteFavoriteClicked = true
	
				KeywordUtil.logInfo(
					'[DELETE FAVORITE] Supprimer le favori image was clicked.'
				)
	
				break
			} catch (Throwable deleteImageError) {
				lastDeleteImageError =
					deleteImageError
	
				if (deleteAttempt < deleteActionAttempts) {
					Windows.delay(
						waitBetweenActionAttempts
					)
				}
			}
		}
	
		if (!deleteFavoriteClicked) {
			takeEvidence(
				'GUI_DeleteFavoriteButtonNotFound.png'
			)
	
			KeywordUtil.markFailedAndStop(
				'Delete Favorite image was not found on screen.\n' +
				'Image key: deleteFavoriteBtn\n' +
				'Expected text: Supprimer le favori\n' +
				'Attempts: ' + deleteActionAttempts + '\n' +
				'Reason: ' +
					safeText(
						lastDeleteImageError?.getMessage()
					)
			)
	
			return
		}
	
	
		// ======================================================
		// VERIFY FAVORITE IMAGE DISAPPEARED
		// ======================================================
	
		boolean favoriteDeleted = false
	
		for (
			Integer deleteCheckAttempt = 1;
			deleteCheckAttempt <= maximumDeleteChecks;
			deleteCheckAttempt++
		) {
	
			KeywordUtil.logInfo(
				'[DELETE FAVORITE] Waiting before checking favorite removal.\n' +
				'Favorite: ' + favoriteTitle + '\n' +
				'Image key: ' + favoriteImageKey + '\n' +
				'Attempt: ' +
					deleteCheckAttempt +
					'/' +
					maximumDeleteChecks + '\n' +
				'Wait time: ' +
					waitPerDeleteCheckSeconds +
					' seconds'
			)
	
			Windows.delay(
				waitPerDeleteCheckSeconds
			)
	
			if (Windows.waitForElementPresent(
				favoritesTab,
				2,
				FailureHandling.OPTIONAL
			)) {
				Windows.click(
					favoritesTab,
					FailureHandling.OPTIONAL
				)
	
				Windows.delay(2)
			}
	
			try {
				WindowsImageKeywords.rightClickImage(
					favoriteImagePath
				)
	
				KeywordUtil.logInfo(
					'[DELETE FAVORITE] Favorite image is still displayed.\n' +
					'Favorite: ' + favoriteTitle + '\n' +
					'Attempt: ' +
						deleteCheckAttempt +
						'/' +
						maximumDeleteChecks
				)
	
				pressKeyboardKey(
					KeyEvent.VK_ESCAPE
				)
			} catch (Throwable ignored) {
				favoriteDeleted = true
	
				KeywordUtil.logInfo(
					'[PASS] Favorite image is no longer displayed.\n' +
					'Favorite: ' + favoriteTitle + '\n' +
					'Attempt: ' +
						deleteCheckAttempt +
						'/' +
						maximumDeleteChecks
				)
	
				break
			}
		}
	
		takeEvidence(
			'GUI_FavoriteAfterDelete.png'
		)
	
		if (!favoriteDeleted) {
			KeywordUtil.markFailedAndStop(
				'Favorite is still displayed after deletion.\n' +
				'Favorite: ' + favoriteTitle + '\n' +
				'Image key: ' + favoriteImageKey + '\n' +
				'Attempts: ' + maximumDeleteChecks + '\n' +
				'Wait per attempt: ' +
					waitPerDeleteCheckSeconds +
					' seconds'
			)
	
			return
		}
	
		KeywordUtil.markPassed(
			'Favorite deleted successfully.\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'Favorite image is no longer displayed.'
		)
	}
