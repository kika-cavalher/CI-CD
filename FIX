properties([
    disableConcurrentBuilds(),
    buildDiscarder(logRotator(numToKeepStr: '15'))
])

def NODE_LABEL = 'GI5_SWDCFRNXGI55817'
def SHORT_WORKSPACE = 'D:/jenkins/ws/ARCH'

def RUN_NEXT_JOB = true
def NEXT_JOB = 'GI5/eMatch_Regression/BDR_Module des Responsabilite'

def manualAbort = false

def asErrorText = { Throwable err ->
    def parts = []
    Throwable current = err
    while (current != null) {
        parts << "${current.getClass().getName()}: ${current.getMessage()}"
        current = current.getCause()
    }
    return parts.join(' | ')
}

def isTimeoutError = { Throwable err ->
    def text = asErrorText(err).toLowerCase()
    return text.contains('timeout') || text.contains('time limit') || text.contains('exceededtimeout')
}

def isManualAbortError = { Throwable err ->
    def text = asErrorText(err).toLowerCase()
    return text.contains('flowinterruptedexception') && !isTimeoutError(err)
}

def stopCurrentExecution = {
    bat '''
@echo off
schtasks /end /tn "\\eMatch Automation\\RunEMatchCommand" >nul 2>nul
schtasks /end /tn "startWinDriver" >nul 2>nul
taskkill /f /im WinAppDriver.exe /t >nul 2>nul
taskkill /f /im katalon.exe /t >nul 2>nul
taskkill /f /im KatalonStudio.exe /t >nul 2>nul
ping -n 3 127.0.0.1 >nul
exit /b 0
'''
}

def runCollection = { String stageName, String cmdFile ->
    if (manualAbort) {
        echo "${stageName} skipped because the pipeline was manually aborted."
        return
    }

    stage(stageName) {
        try {
            timeout(time: 5, unit: 'HOURS') {
                bat "call \"${env.WORKSPACE}\\jenkins\\${cmdFile}\""
            }
            echo "${stageName} completed successfully."
        } catch (Throwable err) {
            if (isManualAbortError(err)) {
                manualAbort = true
                currentBuild.result = 'ABORTED'
                echo "${stageName} was manually aborted."
            } else if (isTimeoutError(err)) {
                echo "${stageName} exceeded the 5 hour limit and will be treated as failed, but the pipeline will continue."
            } else {
                echo "${stageName} failed: ${err}"
            }
        } finally {
            stage("Stop ${stageName}") {
                stopCurrentExecution()
            }
        }
    }
}

node(NODE_LABEL) {
