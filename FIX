1. REC - Ajustements IPV - Filter Export And Validate
import static com.kms.katalon.core.testcase.TestCaseFactory.findTestCase

import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import internal.GlobalVariable


// ======================================================
// EXPORT CONFIG
// ======================================================

String targetEnvironment = 'REC'
String exportLabel = 'AjustementsIPV'

String menuName = 'ajustements IPV'
String menuResultName = 'ajustements IPV'
String openedTabName = menuResultName

String scenarioName =
	targetEnvironment +
	' Ajustements IPV Filter Export And Validate'

String loginTestCase =
	'Component/Authentication/Login ' + targetEnvironment

String closeApplicationTestCase =
	'Component/Authentication/Close Application'


// ======================================================
// TIMEOUT CONFIG
// ======================================================

Integer menuTimeout = 60
Integer openedTabTimeout = 60
Integer filterTimeout = 5
Integer exportLoadDelay = 3


// ======================================================
// AUTHENTICATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Authenticate and open application\n' +
	'Environment: ' + targetEnvironment
)

WebUI.callTestCase(
	findTestCase(loginTestCase),
	[:],
	FailureHandling.STOP_ON_FAILURE
)


// ======================================================
// MENU NAVIGATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Open Ajustements IPV menu\n' +
	'Search: ' + menuName + '\n' +
	'Result: ' + menuResultName
)

CustomKeywords.'component.MenuNavigator.searchAndOpenMenuByText'(
	menuName,
	menuResultName,
	menuTimeout
)


// ======================================================
// OPENED SCREEN VALIDATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Validate opened tab\n' +
	'Expected tab: ' + openedTabName
)

if (!Windows.waitForElementPresent(
	CustomKeywords.'commands.WindowsObjectLoader.getTabByName'(
		openedTabName
	),
	openedTabTimeout,
	FailureHandling.OPTIONAL
)) {
	CustomKeywords.'commands.ImageLoader.takeEvidence'(
		targetEnvironment +
		'_AjustementsIPV_TabNotOpened.png'
	)

	KeywordUtil.markFailedAndStop(
		'Ajustements IPV tab was not opened.\n' +
		'Expected tab: ' + openedTabName
	)
}

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	targetEnvironment +
	'_AjustementsIPV_Opened.png'
)


// ======================================================
// AS OF DATE CONFIG
// ======================================================

String asOfDateValue =
	GlobalVariable.arreteDate == null ?
	'' :
	GlobalVariable.arreteDate.toString().trim()

if (asOfDateValue.isEmpty()) {
	asOfDateValue =
		CustomKeywords.'general.MenuHandling.getArreteDateWithSlash'()

	GlobalVariable.arreteDate = asOfDateValue
}

if (asOfDateValue == null || asOfDateValue.trim().isEmpty()) {
	CustomKeywords.'commands.ImageLoader.takeEvidence'(
		targetEnvironment +
		'_AjustementsIPV_AsOfDateNotResolved.png'
	)

	KeywordUtil.markFailedAndStop(
		'As Of Date could not be resolved for the Recherche filter.'
	)
}


// ======================================================
// RECHERCHE FILTER
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Apply Recherche filter\n' +
	'Filter: As Of Date\n' +
	'Value: ' + asOfDateValue
)

CustomKeywords.'component.RechercheFilterKeywords.applyElementValoriseAsOfDateFilter'(
	asOfDateValue,
	filterTimeout
)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	targetEnvironment +
	'_AjustementsIPV_FilterApplied.png'
)


// ======================================================
// EXPORT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Wait for filtered content before export\n' +
	'Delay: ' + exportLoadDelay + ' seconds'
)

Windows.delay(exportLoadDelay)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Export filtered Ajustements IPV table\n' +
	'Flow: Exports tab > Export button > Save > Non\n' +
	'Environment: ' + targetEnvironment + '\n' +
	'Export label: ' + exportLabel
)

CustomKeywords.'commands.ExportFile.exportFromTwoExportImagesToNo'(
	exportLabel,
	targetEnvironment
)


// ======================================================
// CLOSE APPLICATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Close application\n' +
	'Environment: ' + targetEnvironment
)

WebUI.callTestCase(
	findTestCase(closeApplicationTestCase),
	[:],
	FailureHandling.STOP_ON_FAILURE
)


// ======================================================
// FILE VALIDATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Validate downloaded export\n' +
	'Environment: ' + targetEnvironment + '\n' +
	'Export label: ' + exportLabel + '\n' +
	'Validations:\n' +
	'- File exists\n' +
	'- File is not empty\n' +
	'- Data row quantity is greater than zero'
)

Map exportValidation =
	CustomKeywords.'commands.ExportFileValidationKeywords.validateExportedFileExistsAndHasRows'(
		targetEnvironment,
		exportLabel
	)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Downloaded export validation passed\n' +
	'File: ' + exportValidation.fileName + '\n' +
	'Data rows: ' + exportValidation.dataRows + '\n' +
	'File size: ' + exportValidation.fileSize + ' bytes\n' +
	'Folder: ' + exportValidation.folderPath
)

KeywordUtil.markPassed(
	scenarioName + ' completed successfully.'
)
