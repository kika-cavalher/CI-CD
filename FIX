2) ✅ Consertar o writeRunContextFile (sem PowerShell) para não quebrar linhas

📌 No JenkinsDesktopPipelineRunner.groovy, troque só a função writeRunContextFile por esta:

def writeRunContextFile(String targetFile, Map ctx) {
  def content = (ctx ?: [:])
    .collect { k, v -> "${k}=${v}" }
    .join("\r\n") + "\r\n"

  echo "Writing run-context.properties to: ${targetFile}"

  def dir = targetFile.replace('/', '\\')
  dir = dir.substring(0, dir.lastIndexOf('\\'))

  bat """@echo off
if not exist "${dir}" mkdir "${dir}"
exit /b 0
"""

  writeFile file: targetFile, text: content, encoding: 'UTF-8'
}

✅ Isso elimina o seu erro antigo de “aqui-string header / sem newline” e garante CRLF.

3) ✅ BAT genérico que funciona e fica bem formatado

📌 Substitua o conteúdo do arquivo:

D:\Projects\eMatchStarters\run-ematch-command.bat

por este:

@echo off
setlocal EnableExtensions EnableDelayedExpansion

REM ============================================================
REM  eMatch Desktop Runner (Generic)
REM  Reads:  D:\Projects\eMatchStarters\run-context.properties
REM  Writes: %MARKER_FILE%  and  %LOG_FILE%
REM ============================================================

set "CTX_FILE=D:\Projects\eMatchStarters\run-context.properties"

if not exist "%CTX_FILE%" (
  echo [ERROR] CTX_FILE not found: "%CTX_FILE%"
  exit /b 2
)

REM --- Load properties (KEY=VALUE) ---
for /f "usebackq tokens=1* delims==" %%A in ("%CTX_FILE%") do (
  set "K=%%A"
  set "V=%%B"
  if not "!K!"=="" (
    set "!K!=!V!"
  )
)

REM --- Required values ---
if "%WORKSPACE%"==""   exit /b 3
if "%PROJECT_FILE%"=="" exit /b 3
if "%KATALON_EXE%"=="" exit /b 3
if "%MARKER_FILE%"=="" exit /b 3
if "%LOG_FILE%"==""    exit /b 3

if "%COLLECTION_PATH%"=="" (
  echo [ERROR] COLLECTION_PATH is empty in run-context.properties
  exit /b 3
)

REM --- Ensure folders exist ---
for %%D in ("%LOG_FILE%") do if not exist "%%~dpD" mkdir "%%~dpD"
for %%D in ("%MARKER_FILE%") do if not exist "%%~dpD" mkdir "%%~dpD"

REM --- Print context to log ---
> "%LOG_FILE%" (
  echo [INFO] WORKSPACE       = %WORKSPACE%
  echo [INFO] PROJECT_FILE    = %PROJECT_FILE%
  echo [INFO] KATALON_EXE      = %KATALON_EXE%
  echo [INFO] COLLECTION_PATH  = %COLLECTION_PATH%
  echo [INFO] BROWSER_TYPE     = %BROWSER_TYPE%
  echo [INFO] RETRY           = %RETRY%
  echo [INFO] MARKER_FILE     = %MARKER_FILE%
  echo [INFO] LOG_FILE        = %LOG_FILE%
  echo.
)

REM --- Go to workspace (project root) ---
cd /d "%WORKSPACE%"
if errorlevel 1 (
  echo [ERROR] Failed to cd to WORKSPACE: "%WORKSPACE%" >> "%LOG_FILE%"
  echo EXIT_CODE=10 > "%MARKER_FILE%"
  exit /b 10
)

REM --- Build Katalon command ---
set "PROJECT_PATH=%WORKSPACE%\%PROJECT_FILE%"

set "CMD="%KATALON_EXE%" -noSplash -runMode=console -consoleLog -projectPath="%PROJECT_PATH%" -retry=%RETRY% -testSuiteCollectionPath="%COLLECTION_PATH%" -browserType="%BROWSER_TYPE%" -reportFolder="%WORKSPACE%\Reports""

echo [INFO] Running Katalon... >> "%LOG_FILE%"
echo [INFO] %CMD% >> "%LOG_FILE%"
echo. >> "%LOG_FILE%"

call %CMD% >> "%LOG_FILE%" 2>&1
set "EC=%ERRORLEVEL%"

echo. >> "%LOG_FILE%"
echo [INFO] Katalon finished. EXIT_CODE=%EC% >> "%LOG_FILE%"

echo EXIT_CODE=%EC% > "%MARKER_FILE%"
exit /b %EC%

✅ Esse BAT:

lê properties certo
cria pastas de log e marker
executa o Katalon de verdade
sempre escreve EXIT_CODE=... no marker (mesmo se falhar cedo)
