class OpenReport {

	def reportSearch (TestData refInput) {
		for (int i = 1; i <= refInput.getRowNumbers(); i++) {

			String reportName = refInput.getValue(2, i)

			String reportFormat = refInput.getValue(3, i)

			String closingDate = GlobalVariable.date_arrete

			Windows.setText(findWindowsObject('Object Repository/Reports/txt_NomRapport'), reportName)

			Windows.setText(findWindowsObject('Object Repository/Reports/cbb_Format'), reportFormat)

			if (reportName != "Rapprochement D1") {
				Windows.setText(findWindowsObject('Object Repository/Reports/cbb_DateArrete'), closingDate)
			}

			Windows.click(findWindowsObject('Reports/btn_ReportGeneration'))

			Windows.delay(20)

			clickReport(reportName, reportFormat)

			Windows.delay(20)

			WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession()).takeScreenshot(RunConfiguration.getReportFolder()+ '\\Evidences\\' + reportName + "_" + reportFormat + '.PNG')
		}
	}

	def boolean reportTimeout () {
		String screenshotLocation = RunConfiguration.getReportFolder() + '\\Evidences\\'
		def code_report=Windows.getText(findWindowsObject('Reports/dat_CodeReport'))
		def status_report=	Windows.getText(findWindowsObject('Reports/dat_ReportStatus'))
		boolean result = false

		for (int count = 1; count <= GlobalVariable.timeout; count++) {
			if(status_report=="En attente" || status_report=="En cours") {
				Windows.delay(60)
				status_report=	Windows.getText(findWindowsObject('Reports/dat_ReportStatus'))
			}
			else {
				count = GlobalVariable.timeout+1
				result = true
				code_report=Windows.getText(findWindowsObject('Reports/dat_CodeReport'))
				status_report=	Windows.getText(findWindowsObject('Reports/dat_ReportStatus'))
			}
		}
		return result;
	}

	@Keyword
	def clickReport(String nom_du_rapport, String format_du_rapport) {
		Windows.delay(20)
		String screenshotLocation = RunConfiguration.getReportFolder() + '\\Evidences\\'
		boolean timeout = false;
		def code_report=Windows.getText(findWindowsObject('Reports/dat_CodeReport'))
		def status_report=	Windows.getText(findWindowsObject('Reports/dat_ReportStatus'))

		if(code_report== nom_du_rapport && (status_report=="En attente" || status_report=="En cours")) {
			timeout = reportTimeout();
			status_report=	Windows.getText(findWindowsObject('Reports/dat_ReportStatus'))
		}
		status_report=	Windows.getText(findWindowsObject('Reports/dat_ReportStatus'))
		if (code_report== nom_du_rapport && status_report=="Généré") {
			KeywordUtil.markPassed('[SUCCESS] Execution was finished successfully!!!')
		} else if (code_report== nom_du_rapport && status_report=="En erreur") {
			WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession()).takeScreenshot(screenshotLocation + '[ERROR] ' + code_report + format_du_rapport + '_' + '.PNG')
			KeywordUtil.markFailed('[ERRORS:] \n' + code_report + '\n[FORMAT]: \n' + format_du_rapport)
		} else if (!timeout){
			KeywordUtil.markFailed('[TIMEOUT ERROR:] \n' + code_report + '\n[FORMAT]: \n' + format_du_rapport);
			WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession()).takeScreenshot(screenshotLocation + '[TIMEOUT] ' + code_report + '_' + format_du_rapport + '.PNG')
		}
	}
}
