        "PROJECT_PATH=${projectPath}",
        "BROWSER_TYPE=${browserType}",
        "RETRY=${retry}",
        "ASSET_NAME=${assetName}",
        "ASSET_TYPE=${assetType}",
        "ASSET_PATH=${assetPath}",
        "ASSET_TIMEOUT_MINUTES=${timeoutMinutes}",
        "RUN_LABEL=${runLabel}"
    ]) {
        script.powershell(
            returnStatus: true,
            script: '''
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

$scriptStart = (Get-Date).ToUniversalTime()

function Clean-Text {
    param([string]$Value)

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return ''
    }

    return (($Value -replace '[\\r\\n]+', ' ') -replace '\\s+', ' ').Trim()
}

function Short-Text {
    param(
        [string]$Value,
        [int]$Max = 220
    )

    $text = Clean-Text $Value

    if ($text.Length -gt $Max) {
        return $text.Substring(0, $Max - 3) + '...'
    }

    return $text
}

function As-WindowsPath {
    param([string]$Value)

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return ''
    }

    return ($Value -replace '/', '\\')
}

function Ensure-ParentDirectory {
    param([string]$Path)

    $parent = Split-Path -Path $Path -Parent

    if (-not [string]::IsNullOrWhiteSpace($parent) -and -not (Test-Path -LiteralPath $parent)) {
        New-Item -ItemType Directory -Path $parent -Force | Out-Null
    }
}

function Ensure-Directory {
    param([string]$Path)

    if (-not [string]::IsNullOrWhiteSpace($Path) -and -not (Test-Path -LiteralPath $Path)) {
        New-Item -ItemType Directory -Path $Path -Force | Out-Null
    }
}

function Read-NewContent {
    param(
        [string]$Path,
        [ref]$Offset
    )

    if (-not (Test-Path -LiteralPath $Path)) {
        return @()
    }

    $fs = $null
    $sr = $null

    try {
        $fs = [System.IO.File]::Open($Path, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, [System.IO.FileShare]::ReadWrite)
        [void]$fs.Seek($Offset.Value, [System.IO.SeekOrigin]::Begin)
        $sr = New-Object System.IO.StreamReader($fs)
        $content = $sr.ReadToEnd()
        $Offset.Value = $fs.Position

        if ([string]::IsNullOrWhiteSpace($content)) {
            return @()
        }

        return @($content -split "`r?`n")
    }
    catch {
        return @()
    }
    finally {
        if ($sr) { $sr.Close() }
        if ($fs) { $fs.Close() }
    }
}

function Should-IncludeJunitForSummary {
    param([string]$JunitPath)

    if ([string]::IsNullOrWhiteSpace($JunitPath)) {
        return $false
    }

    $lower = $JunitPath.ToLowerInvariant()

    if ($lower.Contains('jira import report')) {
        return $false
    }

    return $true
}

function Find-LatestJunit {
    param([string]$Root)

    if (-not (Test-Path -LiteralPath $Root)) {
        return ''
    }

    $files = Get-ChildItem -Path $Root -Filter 'JUnit_Report.xml' -File -Recurse -ErrorAction SilentlyContinue |
        Sort-Object LastWriteTime -Descending

    foreach ($file in @($files)) {
        if (Should-IncludeJunitForSummary -JunitPath $file.FullName) {
            return $file.FullName
        }
    }

    if ($files -and $files.Count -gt 0) {
        return $files[0].FullName
    }

    return ''
}

function Get-JUnitSummary {
    param([string]$JunitFile)

    $result = [ordered]@{
        Executed    = 0
        Passed      = 0
        Failed      = 0
        Skipped     = 0
        Reason      = ''
        CaseSummary = @()
    }

    if ([string]::IsNullOrWhiteSpace($JunitFile) -or -not (Test-Path -LiteralPath $JunitFile)) {
        return $result
    }

    try {
        [xml]$xml = Get-Content -LiteralPath $JunitFile -Raw

        $testcases = @()

        if ($xml.testsuite) {
            $testcases = @($xml.testsuite.testcase)
        }
        elseif ($xml.testsuites) {
            foreach ($ts in @($xml.testsuites.testsuite)) {
                $testcases += @($ts.testcase)
            }
        }

        $testcases = @($testcases | Where-Object { $_ })
        $result.Executed = $testcases.Count

        $failedNodes = @($testcases | Where-Object { $_.failure -or $_.error })
        $skippedNodes = @($testcases | Where-Object { $_.skipped })

        $result.Failed = $failedNodes.Count
        $result.Skipped = $skippedNodes.Count
        $result.Passed = $result.Executed - $result.Failed - $result.Skipped

        if ($failedNodes.Count -gt 0) {
            $firstBad = $failedNodes[0]
            $message = ''

            if ($firstBad.failure) {
                $message = (($firstBad.failure.message | Out-String) + ' ' + ($firstBad.failure.InnerText | Out-String))
            }
            elseif ($firstBad.error) {
                $message = (($firstBad.error.message | Out-String) + ' ' + ($firstBad.error.InnerText | Out-String))
            }

            $result.Reason = Short-Text $message 220
        }

        foreach ($node in @($failedNodes | Select-Object -First 3)) {
            $name = ''
            try {
                $name = ($node.name | Out-String).Trim()
            } catch {
                $name = ''
            }

            if (-not [string]::IsNullOrWhiteSpace($name)) {
                $result.CaseSummary += (Short-Text $name 160)
            }
        }
    }
    catch {
        $result.Reason = Short-Text $_.Exception.Message 220
    }

    return $result
}

$status = 'FAILED'
$icon = '❌'
$reason = 'Desktop execution did not produce a result file'
$exitCode = 1
$executed = 0
$passed = 0
$failed = 0
$skipped = 0
$caseSummary = @()
$junitFile = ''
$logRel = '_desktop_logs/katalon_current.log'

try {
    $workspacePath = As-WindowsPath $env:WORKSPACE
    $reportsRoot = As-WindowsPath $env:REPORTS_ROOT
    $logsDir = As-WindowsPath $env:LOGS_DIR
    $ctxFile = As-WindowsPath $env:CTX_FILE
    $markerFile = As-WindowsPath $env:MARKER_FILE
    $currentLogFile = As-WindowsPath $env:CURRENT_LOG_FILE
    $resultFile = As-WindowsPath $env:RESULT_FILE
    $projectPath = As-WindowsPath $env:PROJECT_PATH
    $katalonExe = As-WindowsPath $env:KATALON_EXE
    $winAppDriverExe = As-WindowsPath $env:WINAPPDRIVER_EXE

    Ensure-Directory -Path $reportsRoot
    Ensure-Directory -Path $logsDir
    Ensure-ParentDirectory -Path $ctxFile
    Ensure-ParentDirectory -Path $markerFile
    Ensure-ParentDirectory -Path $currentLogFile
    Ensure-ParentDirectory -Path $resultFile

    Remove-Item -LiteralPath $markerFile -Force -ErrorAction SilentlyContinue
    Remove-Item -LiteralPath $currentLogFile -Force -ErrorAction SilentlyContinue
    Remove-Item -LiteralPath $resultFile -Force -ErrorAction SilentlyContinue

    Set-Content -LiteralPath $currentLogFile -Value '' -Encoding UTF8

    $effectiveAutoStartWinAppDriver = $env:AUTO_START_WINAPPDRIVER
    if ([string]::IsNullOrWhiteSpace($winAppDriverExe) -or -not (Test-Path -LiteralPath $winAppDriverExe)) {
        $effectiveAutoStartWinAppDriver = 'false'
        Write-Host '[WARN] WinAppDriver executable not found. Auto start will be skipped.'
    }

    $ctxLines = @()
    $ctxLines += ('WORKSPACE=' + $workspacePath)
    $ctxLines += ('PROJECT_PATH=' + $projectPath)
    $ctxLines += ('KATALON_EXE=' + $katalonExe)
    $ctxLines += ('ASSET_TYPE=' + $env:ASSET_TYPE)
    $ctxLines += ('ASSET_PATH=' + $env:ASSET_PATH)
    $ctxLines += ('BROWSER_TYPE=' + $env:BROWSER_TYPE)
    $ctxLines += ('RETRY=' + $env:RETRY)
    $ctxLines += ('REPORTS_DIR=' + $reportsRoot)
    $ctxLines += ('LOG_DIR=' + $logsDir)
    $ctxLines += ('CURRENT_LOG_FILE=' + $currentLogFile)
    $ctxLines += ('MARKER_FILE=' + $markerFile)
    $ctxLines += ('RUN_LABEL=' + $env:RUN_LABEL)
    $ctxLines += ('WINAPPDRIVER_EXE=' + $winAppDriverExe)
    $ctxLines += ('AUTO_START_WINAPPDRIVER=' + $effectiveAutoStartWinAppDriver)
    $ctxLines += 'OPEN_VISIBLE_APP=false'
    $ctxLines += 'APP_LNK_PATH='
    $ctxLines += 'APP_EXE_PATH='

    Set-Content -LiteralPath $ctxFile -Value $ctxLines -Encoding ASCII

    Write-Host '------------------------------------------------------------'
    Write-Host ('[INFO] DESKTOP START | ' + $env:ASSET_NAME)
    Write-Host ('[INFO] WORKSPACE     | ' + $workspacePath)
    Write-Host ('[INFO] PROJECT       | ' + $projectPath)
    Write-Host ('[INFO] TYPE          | ' + $env:ASSET_TYPE)
    Write-Host ('[INFO] PATH          | ' + $env:ASSET_PATH)
    Write-Host ('[INFO] LOG           | ' + $currentLogFile)
    Write-Host ('[INFO] TIMEOUT       | ' + $env:ASSET_TIMEOUT_MINUTES + ' min')
    Write-Host ('[INFO] TASK          | ' + $env:DESKTOP_RUNNER_TASK)
    Write-Host '------------------------------------------------------------'

    $taskOutput = & schtasks /run /tn $env:DESKTOP_RUNNER_TASK 2>&1
    $taskExitCode = $LASTEXITCODE

    foreach ($line in @($taskOutput)) {
        if (-not [string]::IsNullOrWhiteSpace($line)) {
            Write-Host ('[TASK] ' + (Clean-Text $line))
        }
    }

    if ($taskExitCode -ne 0) {
        throw ('Failed to start scheduled task. ExitCode=' + $taskExitCode)
    }

    $stdoutOffset = 0L
    $deadline = (Get-Date).AddMinutes([int]$env:ASSET_TIMEOUT_MINUTES)
    $lastHeartbeat = Get-Date
    $exitCode = 124

    while ((Get-Date) -lt $deadline) {
        $stdoutLines = Read-NewContent -Path $currentLogFile -Offset ([ref]$stdoutOffset)

        if ($stdoutLines.Count -gt 0) {
            foreach ($line in $stdoutLines) {
                $text = Clean-Text $line
                if (-not [string]::IsNullOrWhiteSpace($text)) {
                    Write-Host ('[KATALON] ' + $text)
                }
            }

            $lastHeartbeat = Get-Date
        }
        else {
            if ((New-TimeSpan -Start $lastHeartbeat -End (Get-Date)).TotalSeconds -ge 15) {
                Write-Host '[WAIT] Desktop run still in progress...'
                $lastHeartbeat = Get-Date
            }
        }

        if (Test-Path -LiteralPath $markerFile) {
            try {
                $exitLine = Get-Content -LiteralPath $markerFile -ErrorAction Stop | Select-Object -First 1
                $exitCode = [int]$exitLine.ToString().Trim()
            }
            catch {
                $exitCode = 1
            }

            break
        }

        Start-Sleep -Seconds 2
    }

    $stdoutLines = Read-NewContent -Path $currentLogFile -Offset ([ref]$stdoutOffset)
    foreach ($line in $stdoutLines) {
        $text = Clean-Text $line
        if (-not [string]::IsNullOrWhiteSpace($text)) {
            Write-Host ('[KATALON] ' + $text)
        }
    }

    $junitFile = Find-LatestJunit -Root $reportsRoot
    $junitSummary = Get-JUnitSummary -JunitFile $junitFile

    $executed = [int]$junitSummary.Executed
    $passed = [int]$junitSummary.Passed
    $failed = [int]$junitSummary.Failed
    $skipped = [int]$junitSummary.Skipped
    $caseSummary = @($junitSummary.CaseSummary)
    $reason = $junitSummary.Reason

    $status = 'PASSED'
    $icon = '✅'

    if ($exitCode -eq 124) {
        $status = 'TIMEOUT'
        $icon = '⏰'
    }
    elseif ($exitCode -ne 0 -or $failed -gt 0) {
        $status = 'FAILED'
        $icon = '❌'
    }

    if ([string]::IsNullOrWhiteSpace($reason) -and $status -eq 'TIMEOUT') {
        $reason = 'Desktop execution exceeded timeout'
    }

    if ([string]::IsNullOrWhiteSpace($reason) -and $status -eq 'FAILED') {
        $reason = 'Desktop execution failed without explicit JUnit reason'
    }

    Write-Host '------------------------------------------------------------'
    Write-Host ($icon + ' DESKTOP END   | ' + $env:ASSET_NAME)
    Write-Host ('[INFO] STATUS   | ' + $status)
    Write-Host ('[INFO] EXECUTED | ' + $executed)
    Write-Host ('[INFO] PASSED   | ' + $passed)
    Write-Host ('[INFO] FAILED   | ' + $failed)
    Write-Host ('[INFO] SKIPPED  | ' + $skipped)
    if (-not [string]::IsNullOrWhiteSpace($reason)) {
        Write-Host ('[INFO] REASON   | ' + $reason)
    }
    Write-Host ('[INFO] LOG      | ' + $currentLogFile)
    Write-Host '------------------------------------------------------------'
}
catch {
    $status = 'FAILED'
    $icon = '❌'
    $reason = Short-Text $_.Exception.Message 220

    if (-not $reason) {
        $reason = 'Desktop execution failed before result generation'
    }
}
finally {
    $durationSeconds = [int][Math]::Round(((Get-Date).ToUniversalTime() - $scriptStart).TotalSeconds)

    $result = [ordered]@{
        name            = $env:ASSET_NAME
        type            = $env:ASSET_TYPE
        status          = $status
        icon            = $icon
        exitCode        = $exitCode
        executed        = $executed
        passed          = $passed
        failed          = $failed
        skipped         = $skipped
        reason          = $reason
        currentLog      = (As-WindowsPath $env:CURRENT_LOG_FILE)
        logRel          = $logRel
        junitFile       = $junitFile
        resultFile      = (As-WindowsPath $env:RESULT_FILE)
        durationSeconds = $durationSeconds
        caseSummary     = @($caseSummary)
    }

    $result | ConvertTo-Json -Depth 6 | Set-Content -LiteralPath (As-WindowsPath $env:RESULT_FILE) -Encoding UTF8

    if ($status -eq 'PASSED') {
        exit 0
    }
    elseif ($status -eq 'TIMEOUT') {
        exit 124
    }
    else {
        exit 1
    }
}
'''
        )
    }

    Map result = loadResultFile(script, resultFile, resultFallback)
    result.psExitCode = psExit
    result.name = result.name ?: assetName
    result.type = result.type ?: assetType
    result.currentLog = result.currentLog ?: currentLogFile
    result.logRel = result.logRel ?: relativeLogPath(currentLogFile, reportsRoot)
    result.durationSeconds = toLong(result.durationSeconds)

    if (!result.status) {
        result.status = (psExit == 0 ? 'PASSED' : (psExit == 124 ? 'TIMEOUT' : 'FAILED'))
    }

    if (!result.icon) {
        result.icon = (result.status == 'PASSED' ? '✅' : (result.status == 'TIMEOUT' ? '⏰' : '❌'))
    }

    return result
}

return this
