package jiraIntegration

import groovy.json.JsonOutput

class JiraGaiaHtmlTemplateBuilder {

    private static final String APP_NAME = 'GAIA'
    private static final String REPORT_TITLE_PREFIX = 'Test report - '
    private static final String LOGO_SRC = 'Image/gaia-logo.png'   // use a transparent PNG here
    private static final String BANNER_GRADIENT = 'linear-gradient(90deg, #0d2d57 0%, #155c78 55%, #4cc07a 100%)'

    private String safeValue(def value) {
        return value == null ? '' : String.valueOf(value).trim()
    }

    private String htmlEscape(def value) {
        String text = safeValue(value)
        return text
            .replace('&', '&amp;')
            .replace('<', '&lt;')
            .replace('>', '&gt;')
            .replace('"', '&quot;')
            .replace("'", '&#39;')
    }

    private String buildPreparedJson(Map model) {
        List<Map> preparedCases = []

        (model.cases ?: []).eachWithIndex { Map item, int index ->
            List<Map> preparedRows = []
            (item.rows ?: []).each { Map row ->
                preparedRows.add([
                    status     : safeValue(row.status),
                    statusLabel: safeValue(row.statusLabel),
                    timestamp  : safeValue(row.timestamp),
                    text       : safeValue(row.text),
                    shortText  : safeValue(row.shortText),
                    fullText   : safeValue(row.fullText),
                    icon       : safeValue(row.icon),
                    expandable : row.expandable == true
                ])
            }

            List<Map> preparedEvidence = []
            (item.evidences ?: []).each { Map evidence ->
                preparedEvidence.add([
                    name: safeValue(evidence.name),
                    src : safeValue(evidence.src),
                    type: safeValue(evidence.type)
                ])
            }

            preparedCases.add([
                id           : 'case-' + index,
                name         : safeValue(item.name),
                scenarioName : safeValue(item.scenarioName),
                shortName    : safeValue(item.shortName),
                shortSummary : safeValue(item.shortSummary),
                status       : safeValue(item.status),
                statusLabel  : safeValue(item.statusLabel),
                durationText : safeValue(item.durationText),
                startText    : safeValue(item.startText),
                endText      : safeValue(item.endText),
                startTag     : safeValue(item.startTag),
                endTag       : safeValue(item.endTag),
                suiteName    : safeValue(item.className),
                visualSummary: safeValue(item.visualSummary),
                visualDetails: safeValue(item.visualDetails),
                rows         : preparedRows,
                evidences    : preparedEvidence
            ])
        }

        Map payload = [
            projectName : safeValue(model.projectName),
            suiteName   : safeValue(model.suiteName),
            title       : safeValue(model.title),
            subtitle    : safeValue(model.subtitle),
            generatedAt : safeValue(model.generatedAt),
            startText   : safeValue(model.startText),
            endText     : safeValue(model.endText),
            durationText: safeValue(model.durationText),
            totalCount  : model.totalCount ?: 0,
            passedCount : model.passedCount ?: 0,
            failedCount : model.failedCount ?: 0,
            skippedCount: model.skippedCount ?: 0,
            cases       : preparedCases,
            logoSrc     : LOGO_SRC
        ]

        return JsonOutput.toJson(payload)
    }

    String buildHtml(Map model) {
        String modelJson = buildPreparedJson(model)

