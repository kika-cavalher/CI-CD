1. Export File Validation
import java.io.File

import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil

String testCaseName = 'Export File Validation'

String baseExportFolderPath = resolveExecutionExportFolder().getAbsolutePath()

String requestedFileNames = ''
String includeSubFolders = 'true'
String minimumExpectedFiles = '3'

String defaultValidationType = 'Mixte'
String sheetIndex = '0'

String headerCurrency = 'Devise'
String headerCurrencyRef = 'Devise de ref.'
String headerAmountCcy = 'Montant ccy'
String headerAmountBaseCcy = 'Montant base ccy'

String amountDifferenceTolerancePercent = '3'

String maxErrorsPerFile = '999'
String maxGeneralErrors = '999'

String allErrors = ''
String filesToValidate = ''
Boolean validationFailed = false

String requiredColumnsText = headerCurrency + ' | ' +
		headerCurrencyRef + ' | ' +
		headerAmountCcy + ' | ' +
		headerAmountBaseCcy

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[START] ' + testCaseName
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[CONFIG] Export validation setup\n' +
		'Folder: ' + new File(baseExportFolderPath).getName() + '\n' +
		'File search: ' + (requestedFileNames?.trim() ? requestedFileNames : 'Automatic from export folder') + '\n' +
		'Minimum files required: ' + minimumExpectedFiles + '\n' +
		'Validation type: ' + defaultValidationType + '\n' +
		'Sheet index: ' + sheetIndex + '\n' +
		'Accepted amount difference: ' + amountDifferenceTolerancePercent + '%'
)

def reportValidation = { String validationName, String validationResult, String filesText ->
	String result = validationResult == null ? '' : validationResult.trim()
	List<File> files = parseFileList(filesText)

	String visualReport = buildVisualValidationReport(
			validationName,
			result,
			files,
			maxErrorsPerFile,
			maxGeneralErrors,
			requiredColumnsText,
			amountDifferenceTolerancePercent
	)

	if (isSkippedResult(result)) {
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
				'[SKIPPED] ' + validationName + '\n' +
				visualReport
		)

		return
	}

	Boolean shouldFail = shouldFailValidation(
			validationName,
			result,
			files,
			amountDifferenceTolerancePercent
	)

	if (shouldFail) {
		validationFailed = true

		allErrors = allErrors +
				'\n\n========== ' + validationName + ' ==========\n' +
				visualReport

		CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
				'[FAIL] ' + validationName + '\n' +
				visualReport
		)

		return
	}

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
			'[PASS] ' + validationName + '\n' +
			visualReport
	)
}

String validationResult = ''

validationResult = CustomKeywords.'commands.ExportFileValidationKeywords.validateEvidenceFolderExists'(
		baseExportFolderPath
)

String folderReport = buildFolderReport(baseExportFolderPath, validationResult)

if (hasValidationFailure(validationResult)) {
	validationFailed = true

	allErrors = allErrors +
			'\n\n========== Export folder ==========\n' +
			folderReport

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
			'[FAIL] Export folder\n' +
			folderReport
	)
} else {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
			'[PASS] Export folder\n' +
			folderReport
	)
}

if (!hasValidationFailure(validationResult)) {
	filesToValidate = CustomKeywords.'commands.ExportFileValidationKeywords.resolveExcelFilesAsString'(
			baseExportFolderPath,
			requestedFileNames,
			includeSubFolders
	)

	String foundFilesResult = CustomKeywords.'commands.ExportFileValidationKeywords.validateExcelFilesFound'(
			filesToValidate
	)

	String minimumFilesResult = CustomKeywords.'commands.ExportFileValidationKeywords.validateMinimumExpectedFileQuantity'(
			filesToValidate,
			minimumExpectedFiles
	)

	String fileDiscoveryResult = combineValidationResults(foundFilesResult, minimumFilesResult)
	String fileDiscoveryReport = buildFileDiscoveryReport(
			filesToValidate,
			minimumExpectedFiles,
			fileDiscoveryResult,
			maxGeneralErrors
	)

	if (hasValidationFailure(fileDiscoveryResult)) {
		validationFailed = true

		allErrors = allErrors +
				'\n\n========== Export files ==========\n' +
				fileDiscoveryReport

		CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
				'[FAIL] Export files\n' +
				fileDiscoveryReport
		)
	} else {
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
				'[PASS] Export files\n' +
				fileDiscoveryReport
		)
	}

	if (!filesToValidate.trim().isEmpty()) {
		validationResult = CustomKeywords.'commands.ExportFileValidationKeywords.validateRequiredHeaders'(
				filesToValidate,
				defaultValidationType,
				sheetIndex,
				headerCurrency,
				headerCurrencyRef,
				headerAmountCcy,
				headerAmountBaseCcy
		)
		reportValidation('Required columns', validationResult, filesToValidate)

		validationResult = CustomKeywords.'commands.ExportFileValidationKeywords.validateRowsForValidationType'(
				filesToValidate,
				defaultValidationType,
				sheetIndex,
				headerCurrency,
				headerCurrencyRef
		)
		reportValidation('Currency columns', validationResult, filesToValidate)

		validationResult = CustomKeywords.'commands.ExportFileValidationKeywords.validateMontantCcyEqualsMontantBaseCcy'(
				filesToValidate,
				defaultValidationType,
				sheetIndex,
				headerCurrency,
				headerCurrencyRef,
				headerAmountCcy,
				headerAmountBaseCcy
		)
		reportValidation('Amount columns comparison', validationResult, filesToValidate)
	}
}

if (validationFailed) {
	KeywordUtil.markFailedAndStop(
			testCaseName + ' failed.\n' +
			'Check the failed validation step in the report.\n' +
			allErrors
	)
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[PASS] ' + testCaseName + ' completed\n' +
		'All export file validations completed successfully.'
)

KeywordUtil.markPassed(
		testCaseName + ' completed successfully.'
)

File resolveExecutionExportFolder() {
	File executionRootFolder = resolveExecutionRootFolder()

	return new File(
			executionRootFolder,
			'Shared_REC_PRD_Exports'
	)
}

File resolveExecutionRootFolder() {
	String reportFolderPath = RunConfiguration.getReportFolder()

	if (reportFolderPath == null || reportFolderPath.trim().isEmpty()) {
		return new File(RunConfiguration.getProjectDir(), 'Reports\\Unknown_Execution')
	}

	File current = new File(reportFolderPath)

	while (current != null) {
		File parent = current.getParentFile()

		if (parent != null && parent.getName().equalsIgnoreCase('Reports')) {
			return current
		}

		current = parent
	}

	return new File(reportFolderPath)
}

String buildFolderReport(String folderPath, String validationResult) {
	File folder = new File(folderPath)

	String result = validationResult == null ? '' : validationResult.trim()

	if (hasValidationFailure(result)) {
		return 'Folder: ' + folder.getName() + '\n' +
				'Result: Not available\n' +
				'Details: ' + cleanErrorLineForReport(result, [])
	}

	return 'Folder: ' + folder.getName() + '\n' +
			'Result: Available'
}

String buildFileDiscoveryReport(
		String filesText,
		String minimumExpectedFilesText,
		String validationResult,
		String maxGeneralErrorsText) {

	List<File> files = parseFileList(filesText)

	Integer minimum = parseIntOrDefault(minimumExpectedFilesText, 0)
	Integer rowsToShow = Math.max(minimum, files.size())

	List<String> lines = []

	lines.add('Required files: ' + minimum)
	lines.add('Found files: ' + files.size())
	lines.add('')

	if (rowsToShow <= 0) {
		lines.add('No files were configured for validation.')
		return lines.join('\n')
	}

	for (int i = 0; i < rowsToShow; i++) {
		if (i < files.size()) {
			lines.add('File ' + (i + 1) + ': ' + files[i].getName())
		} else {
			lines.add('File ' + (i + 1) + ': Missing file')
		}
	}

	if (hasValidationFailure(validationResult)) {
		List<String> errors = extractErrorLines(validationResult)

		if (!errors.isEmpty()) {
			lines.add('')
			lines.add('Errors:')

			for (String error : limitLines(errors, parseIntOrDefault(maxGeneralErrorsText, 999))) {
				lines.add('- ' + cleanErrorLineForReport(error, files))
			}
		}
	}

	return lines.join('\n')
}

String buildVisualValidationReport(
		String validationName,
		String validationResult,
		List<File> files,
		String maxErrorsPerFileText,
		String maxGeneralErrorsText,
		String requiredColumnsText,
		String amountTolerancePercentText) {

	String result = validationResult == null ? '' : validationResult.trim()
	Integer maxPerFile = parseIntOrDefault(maxErrorsPerFileText, 999)
	Integer maxGeneral = parseIntOrDefault(maxGeneralErrorsText, 999)

	if (isSkippedResult(result)) {
		return buildSkippedReport(result)
	}

	if (validationName.toLowerCase().contains('required columns')) {
		return buildRequiredColumnsReport(result, files, requiredColumnsText, maxGeneral)
	}

	if (validationName.toLowerCase().contains('amount columns comparison')) {
		return buildAmountComparisonReport(result, files, maxPerFile, maxGeneral, amountTolerancePercentText)
	}

	if (!hasValidationFailure(result)) {
		return buildPassedFileReport(files)
	}

	return buildGenericFailureReport(validationName, result, files, maxPerFile, maxGeneral)
}

String buildRequiredColumnsReport(
		String validationResult,
		List<File> files,
		String requiredColumnsText,
		Integer maxGeneral) {

	List<String> lines = []

	lines.add('Columns checked: ' + requiredColumnsText)
	lines.add('Checked files: ' + (files == null ? 0 : files.size()))
	lines.add('')

	if (files != null) {
		for (int i = 0; i < files.size(); i++) {
			lines.add('File ' + (i + 1) + ': ' + files[i].getName())
		}
	}

	if (hasValidationFailure(validationResult)) {
		List<String> errors = extractErrorLines(validationResult)

		lines.add('')
		lines.add('Errors:')

		for (String error : limitLines(errors, maxGeneral)) {
			lines.add('- ' + cleanErrorLineForReport(error, files))
		}
	}

	return lines.join('\n')
}

String buildPassedFileReport(List<File> files) {
	if (files == null || files.isEmpty()) {
		return 'No file list was available for this validation.'
	}

	List<String> lines = []

	lines.add('Checked files: ' + files.size())
	lines.add('')

	for (int i = 0; i < files.size(); i++) {
		lines.add('File ' + (i + 1) + ': ' + files[i].getName())
	}

	return lines.join('\n')
}

String buildAmountComparisonReport(
		String validationResult,
		List<File> files,
		Integer maxPerFile,
		Integer maxGeneral,
		String amountTolerancePercentText) {

	BigDecimal tolerancePercent = parseDecimalOrDefault(amountTolerancePercentText, new BigDecimal('3'))
	List<Map> parsedRows = parseAmountComparisonRows(validationResult, files, tolerancePercent)

	List<String> lines = []

	lines.add('Accepted difference: <= ' + formatDecimal(tolerancePercent) + '%')
	lines.add('Checked files: ' + (files == null ? 0 : files.size()))
	lines.add('')

	if (files != null && !files.isEmpty()) {
		Map<String, List<Map>> rowsByFile = parsedRows.groupBy { Map row -> safeText(row.fileName) }

		for (int i = 0; i < files.size(); i++) {
			File file = files[i]
			List<Map> rowsForFile = rowsByFile[file.getName()] ?: []

			Boolean hasRejected = rowsForFile.any { Map row -> Boolean.FALSE.equals(row.accepted) }
			Boolean hasAccepted = rowsForFile.any { Map row -> Boolean.TRUE.equals(row.accepted) }

			if (hasRejected) {
				lines.add('File ' + (i + 1) + ': FAILED - ' + file.getName())
			} else if (hasAccepted) {
				lines.add('File ' + (i + 1) + ': PASSED WITH ACCEPTED DIFFERENCES - ' + file.getName())
			} else {
				lines.add('File ' + (i + 1) + ': PASSED - ' + file.getName())
			}
		}

		lines.add('')
	}

	if (!hasValidationFailure(validationResult)) {
		lines.add('Result: all amount values are equal.')
		return lines.join('\n')
	}

	if (parsedRows.isEmpty()) {
		lines.add('Result: failed.')
		lines.add('Reason: the amount comparison returned errors, but the row values could not be parsed.')
		lines.add('')
		lines.add('Raw errors:')

		for (String error : limitLines(extractErrorLines(validationResult), maxGeneral)) {
			lines.add('- ' + cleanErrorLineForReport(error, files))
		}

		return lines.join('\n')
	}

	List<Map> rejectedRows = parsedRows.findAll { Map row -> Boolean.FALSE.equals(row.accepted) }
	List<Map> acceptedRows = parsedRows.findAll { Map row -> Boolean.TRUE.equals(row.accepted) }

	if (!rejectedRows.isEmpty()) {
		lines.add('Wrong values:')

		Map<String, List<Map>> rejectedByFile = rejectedRows.groupBy { Map row -> safeText(row.fileName) }

		rejectedByFile.each { String fileName, List<Map> rows ->
			lines.add('')
			lines.add(fileName)
			lines.add('Row | Devise | Montant ccy | Montant base ccy | Difference | Difference % | Reason')
			lines.add('--- | --- | --- | --- | --- | --- | ---')

			for (Map row : rows.take(maxPerFile)) {
				lines.add(
						safeText(row.rowNumber) + ' | ' +
						safeText(row.devise) + ' | ' +
						safeText(row.amountCcy) + ' | ' +
						safeText(row.amountBaseCcy) + ' | ' +
						safeText(row.difference) + ' | ' +
						safeText(row.differencePercent) + ' | ' +
						safeText(row.reason)
				)
			}

			if (rows.size() > maxPerFile) {
				lines.add('... and ' + (rows.size() - maxPerFile) + ' more wrong row(s) in this file.')
			}
		}
	}

	if (!acceptedRows.isEmpty()) {
		lines.add('')
		lines.add('Accepted differences:')

		Map<String, List<Map>> acceptedByFile = acceptedRows.groupBy { Map row -> safeText(row.fileName) }

		acceptedByFile.each { String fileName, List<Map> rows ->
			lines.add('')
			lines.add(fileName)
			lines.add('Row | Devise | Montant ccy | Montant base ccy | Difference | Difference % | Reason')
			lines.add('--- | --- | --- | --- | --- | --- | ---')

			for (Map row : rows.take(maxPerFile)) {
				lines.add(
						safeText(row.rowNumber) + ' | ' +
						safeText(row.devise) + ' | ' +
						safeText(row.amountCcy) + ' | ' +
						safeText(row.amountBaseCcy) + ' | ' +
						safeText(row.difference) + ' | ' +
						safeText(row.differencePercent) + ' | ' +
						safeText(row.reason)
				)
			}

			if (rows.size() > maxPerFile) {
				lines.add('... and ' + (rows.size() - maxPerFile) + ' more accepted row(s) in this file.')
			}
		}
	}

	return lines.join('\n')
}

String buildGenericFailureReport(String validationName, String validationResult, List<File> files, Integer maxPerFile, Integer maxGeneral) {
	List<String> errorLines = extractErrorLines(validationResult)
	List<String> reportLines = []

	if (files == null || files.isEmpty()) {
		reportLines.add('Affected files: not available')
		reportLines.add('')
		reportLines.add('Errors:')

		for (String error : limitLines(errorLines, maxGeneral)) {
			reportLines.add('- ' + cleanErrorLineForReport(error, files))
		}

		return reportLines.join('\n')
	}

	reportLines.add('Checked files: ' + files.size())
	reportLines.add('')

	for (int i = 0; i < files.size(); i++) {
		File file = files[i]
		List<String> fileErrors = findErrorsForFile(errorLines, file)

		if (!fileErrors.isEmpty()) {
			reportLines.add('File ' + (i + 1) + ': FAILED - ' + file.getName())
		} else {
			reportLines.add('File ' + (i + 1) + ': PASSED - ' + file.getName())
		}
	}

	reportLines.add('')
	reportLines.add('Errors:')

	Boolean hasFileSpecificErrors = false

	for (int i = 0; i < files.size(); i++) {
		File file = files[i]
		List<String> fileErrors = findErrorsForFile(errorLines, file)

		if (fileErrors.isEmpty()) {
			continue
		}

		hasFileSpecificErrors = true

		reportLines.add('')
		reportLines.add(file.getName() + ':')

		for (String error : limitLines(fileErrors, maxPerFile)) {
			reportLines.add('- ' + cleanErrorLineForReport(error, files))
		}

		if (fileErrors.size() > maxPerFile) {
			reportLines.add('- ... and ' + (fileErrors.size() - maxPerFile) + ' more error(s) in this file.')
		}
	}

	List<String> generalErrors = findGeneralErrors(errorLines, files)

	if (!generalErrors.isEmpty() || !hasFileSpecificErrors) {
		if (hasFileSpecificErrors) {
			reportLines.add('')
		}

		for (String error : limitLines(generalErrors.isEmpty() ? errorLines : generalErrors, maxGeneral)) {
			reportLines.add('- ' + cleanErrorLineForReport(error, files))
		}
	}

	return reportLines.join('\n')
}

String buildSkippedReport(String validationResult) {
	String reason = validationResult == null ? '' : validationResult.trim()

	reason = reason.replace('[SKIPPED]', '').trim()
	reason = reason.replace('Validation skipped.', '').trim()
	reason = reason.replace('Reason:', '').trim()

	if (reason.isEmpty()) {
		reason = 'This validation was skipped.'
	}

	return 'Not executed.\n' +
			'Reason: ' + cleanErrorLineForReport(reason, [])
}

String combineValidationResults(String firstResult, String secondResult) {
	List<String> results = []

	String first = firstResult == null ? '' : firstResult.trim()
	String second = secondResult == null ? '' : secondResult.trim()

	if (!first.isEmpty()) {
		results.add(first)
	}

	if (!second.isEmpty()) {
		results.add(second)
	}

	return results.join('\n')
}

Boolean shouldFailValidation(
		String validationName,
		String validationResult,
		List<File> files,
		String amountTolerancePercentText) {

	if (!hasValidationFailure(validationResult)) {
		return false
	}

	String lowerName = validationName == null ? '' : validationName.toLowerCase(Locale.ENGLISH)

	if (!lowerName.contains('amount columns comparison')) {
		return true
	}

	BigDecimal tolerancePercent = parseDecimalOrDefault(amountTolerancePercentText, new BigDecimal('3'))
	List<Map> parsedRows = parseAmountComparisonRows(validationResult, files, tolerancePercent)

	if (parsedRows.isEmpty()) {
		return true
	}

	return parsedRows.any { Map row ->
		Boolean.FALSE.equals(row.accepted)
	}
}

Boolean hasValidationFailure(String validationResult) {
	String result = validationResult == null ? '' : validationResult.trim()

	if (result.isEmpty()) {
		return false
	}

	if (isSkippedResult(result)) {
		return false
	}

	String upper = result.toUpperCase(Locale.ENGLISH)

	if (upper == 'PASS' || upper == 'PASSED' || upper == 'SUCCESS') {
		return false
	}

	if (upper.startsWith('[PASS]') || upper.startsWith('[PASSED]') || upper.startsWith('[SUCCESS]')) {
		return false
	}

	if (upper.contains('RESULT: PASSED')) {
		return false
	}

	return true
}

Boolean isSkippedResult(String validationResult) {
	String result = validationResult == null ? '' : validationResult.trim()

	result = result.replaceFirst('^\\s*[^A-Za-z0-9\\[]+\\s*', '')

	return result.startsWith('[SKIPPED]')
}

List<File> parseFileList(String filesText) {
	List<File> files = []

	String text = filesText == null ? '' : filesText.trim()

	if (text.isEmpty()) {
		return files
	}

	String normalized = text
			.replace('\r\n', '|')
			.replace('\n', '|')
			.replace(';', '|')

	String[] parts = normalized.split('\\|')

	for (String part : parts) {
		String clean = part == null ? '' : part.trim()

		if (!clean.isEmpty()) {
			files.add(new File(clean))
		}
	}

	return files.unique { File file ->
		file.getAbsolutePath().toLowerCase(Locale.ENGLISH)
	}
}

List<String> extractErrorLines(String validationResult) {
	List<String> lines = []

	String result = validationResult == null ? '' : validationResult.trim()

	if (result.isEmpty()) {
		return lines
	}

	String normalized = result
			.replace('\r\n', '\n')
			.replace('\r', '\n')

	String[] parts = normalized.split('\n')

	for (String part : parts) {
		String clean = part == null ? '' : part.trim()

		if (!clean.isEmpty()) {
			lines.add(clean)
		}
	}

	if (lines.isEmpty()) {
		lines.add(result)
	}

	return lines
}

List<String> findErrorsForFile(List<String> errorLines, File file) {
	List<String> result = []

	if (file == null) {
		return result
	}

	String fileName = file.getName()
	String absolutePath = file.getAbsolutePath()

	for (String errorLine : errorLines) {
		String line = errorLine == null ? '' : errorLine

		if (line.contains(fileName) || line.contains(absolutePath)) {
			result.add(line)
		}
	}

	return result
}

List<String> findGeneralErrors(List<String> errorLines, List<File> files) {
	List<String> result = []

	for (String errorLine : errorLines) {
		Boolean belongsToFile = false

		for (File file : files) {
			if (errorLine.contains(file.getName()) || errorLine.contains(file.getAbsolutePath())) {
				belongsToFile = true
				break
			}
		}

		if (!belongsToFile) {
			result.add(errorLine)
		}
	}

	return result
}

List<Map> parseAmountComparisonRows(String validationResult, List<File> files, BigDecimal tolerancePercent) {
	List<Map> rows = []

	String text = cleanErrorLineForReport(validationResult, files)
			.replace('\r\n', ' ')
			.replace('\n', ' ')
			.replace('\r', ' ')

	def matcher = text =~ /(?is)(?:^|[\s\-])File\s+'?([^'\s|]+\.xlsx)'?\s+row\s+(\d+)\s+has\s+different\s+amounts\.?\s*(.*?)(?=(?:[\s\-]File\s+'?[^'\s|]+\.xlsx'?\s+row\s+\d+\s+has\s+different\s+amounts)|$)/

	while (matcher.find()) {
		String fileName = matcher.group(1).trim()
		String rowNumber = matcher.group(2).trim()
		String details = matcher.group(3).trim()

		String devise = extractByRegex(details, "Devise\\s*=\\s*'([^']*)'")
		String amountCcy = extractByRegex(details, "Montant ccy\\s*=\\s*'([^']*)'")
		String amountBaseCcy = extractByRegex(details, "Montant base ccy\\s*=\\s*'([^']*)'")
		String comparison = extractByRegex(details, "comparison\\s*=\\s*numeric:\\s*([^|]+)")

		BigDecimal amountCcyNumber = parseDecimalOrNull(amountCcy)
		BigDecimal amountBaseCcyNumber = parseDecimalOrNull(amountBaseCcy)

		BigDecimal difference = null
		BigDecimal differencePercent = null
		Boolean accepted = false
		String reason = ''

		if (amountCcyNumber == null || amountBaseCcyNumber == null) {
			reason = 'Cannot calculate difference because one amount is missing or not numeric.'
			accepted = false
		} else {
			difference = amountCcyNumber.subtract(amountBaseCcyNumber).abs()

			if (amountBaseCcyNumber.compareTo(BigDecimal.ZERO) == 0) {
				differencePercent = difference.compareTo(BigDecimal.ZERO) == 0 ? BigDecimal.ZERO : new BigDecimal('100')
			} else {
				differencePercent = difference
						.divide(amountBaseCcyNumber.abs(), 10, BigDecimal.ROUND_HALF_UP)
						.multiply(new BigDecimal('100'))
			}

			accepted = differencePercent.compareTo(tolerancePercent) <= 0

			if (accepted) {
				reason = 'Accepted within tolerance.'
			} else {
				reason = 'Difference is above the accepted tolerance.'
			}
		}

		rows.add([
			fileName         : fileName,
			rowNumber        : rowNumber,
			devise           : devise,
			amountCcy        : amountCcy,
			amountBaseCcy    : amountBaseCcy,
			comparison       : comparison,
			difference       : difference == null ? '-' : formatDecimal(difference),
			differencePercent: differencePercent == null ? '-' : formatDecimal(differencePercent) + '%',
			accepted         : accepted,
			reason           : reason
		])
	}

	return rows
}

String extractByRegex(String text, String pattern) {
	try {
		def matcher = text =~ pattern

		if (matcher.find()) {
