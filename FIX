		Windows.delay(safeTimeout(waitAfterDropSeconds, 2))

		KeywordUtil.markPassed(
			'Image drag and drop completed successfully.\n' +
			'Source: ' + sourceImageRelativePath + '\n' +
			'Target: ' + targetImageRelativePath
