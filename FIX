@echo off
setlocal EnableExtensions EnableDelayedExpansion

set "CTX_FILE=D:\Projects\eMatchStarters\run-context.properties"
set "LOG_DIR=D:\Projects\eMatchStarters\logs"

if not exist "%LOG_DIR%" mkdir "%LOG_DIR%"

if not exist "%CTX_FILE%" (
  echo [ERROR] Context file not found: "%CTX_FILE%"
  exit /b 2
)

for /f "usebackq tokens=1,* delims==" %%A in ("%CTX_FILE%") do (
  set "K=%%A"
  set "V=%%B"
  if not "!K!"=="" set "!K!=!V!"
)

if "%WORKSPACE%"=="" (
  echo [ERROR] WORKSPACE is empty. Check run-context.properties
  exit /b 3
)

if "%PROJECT_FILE%"=="" (
  echo [ERROR] PROJECT_FILE is empty. Check run-context.properties
  exit /b 3
)

if "%KATALON_EXE%"=="" (
  echo [ERROR] KATALON_EXE is empty. Check run-context.properties
  exit /b 3
)

if "%COLLECTION_PATH%"=="" (
  echo [ERROR] COLLECTION_PATH is empty. Check run-context.properties
  exit /b 3
)

set "PROJECT_PATH=%WORKSPACE%\%PROJECT_FILE%"
set "REPORTS_DIR=%WORKSPACE%\Reports"
set "MARKER_FILE=%REPORTS_DIR%\__jenkins_task_exitcode.txt"

if not exist "%REPORTS_DIR%" mkdir "%REPORTS_DIR%"

del /f /q "%MARKER_FILE%" 2>nul

for /f "tokens=1-6 delims=/:. " %%a in ("%date% %time%") do (
  set "TS=%%c%%a%%b_%%d%%e%%f"
)

set "LOG_FILE=%LOG_DIR%\katalon_%TS%.log"

echo [INFO] WORKSPACE        "%WORKSPACE%"
echo [INFO] PROJECT_PATH     "%PROJECT_PATH%"
echo [INFO] KATALON_EXE      "%KATALON_EXE%"
echo [INFO] COLLECTION_PATH  "%COLLECTION_PATH%"
echo [INFO] REPORTS_DIR      "%REPORTS_DIR%"
echo [INFO] LOG_FILE         "%LOG_FILE%"
echo [INFO] MARKER_FILE      "%MARKER_FILE%"

"%KATALON_EXE%" ^
  -noSplash ^
  -runMode=console ^
  -consoleLog ^
  -projectPath="%PROJECT_PATH%" ^
  -retry=%RETRY% ^
  -testSuiteCollectionPath="%COLLECTION_PATH%" ^
  -browserType="%BROWSER_TYPE%" ^
  -reportFolder="%REPORTS_DIR%" ^
  > "%LOG_FILE%" 2>&1

set "EC=%ERRORLEVEL%"

echo %EC% > "%MARKER_FILE%"

echo [INFO] ExitCode=%EC%
exit /b %EC%
