	html.append(safeHtml((item.className ?: '') + '/' + (item.testName ?: '')))
	html.append('</div>')

	html.append('<div class="test-line">')
	html.append('<span class="bullet">✔</span> Test Passed')
	html.append('</div>')

	html.append('<div class="test-line duration">')
	html.append('Duration: ')
	html.append(safeHtml(formatDurationSeconds(item.timeSeconds as BigDecimal)))
	html.append('</div>')

	html.append('</div>')

	return html.toString()
}

