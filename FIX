	private List<Map> parseExecutionScenarios(File reportDir) {
		File logFile = findExecutionLog(reportDir)
		if (logFile == null || !logFile.exists() || !logFile.isFile()) {
			return []
		}

		List<String> rawLines = readFileLines(logFile)
		if (rawLines.isEmpty()) {
			return []
		}

		List<Map> scenarios = []
		Map currentScenario = null
		Map currentStep = null

		Closure finishStep = {
			if (currentScenario == null || currentStep == null) {
				return
			}

			if (isBlank(currentStep.status)) {
				currentStep.status = 'passed'
			}

			List<String> detailLines = currentStep.detailLines instanceof List ? (currentStep.detailLines as List<String>) : []
			List<String> errorLines = currentStep.errorLines instanceof List ? (currentStep.errorLines as List<String>) : []

			if (!detailLines.isEmpty()) {
				currentStep.detailText = normalizeText(detailLines)
			} else if (isBlank(currentStep.detailText)) {
				currentStep.detailText = safeValue(currentStep.title)
			}

			if (!errorLines.isEmpty()) {
				currentStep.errorFull = normalizeText(errorLines)
			}

			if (isBlank(currentStep.shortError)) {
				currentStep.shortError = extractShortError(currentStep.errorFull ?: currentStep.detailText)
			}

			if (toLong(currentStep.durationMs) <= 0L) {
				currentStep.durationMs = 1000L
			}

			currentStep.durationLabel = formatDurationFull(toLong(currentStep.durationMs))
			currentStep = null
		}

		Closure finishScenario = {
			if (currentScenario == null) {
				return
			}

			List<Map> steps = currentScenario.steps instanceof List ? (currentScenario.steps as List<Map>) : []
			if (steps.isEmpty()) {
				currentScenario = null
				return
			}

			applyStepDurationsFromTimestamps(steps)

			long totalDuration = sumStepDurations(steps)
			if (totalDuration <= 0L) {
				totalDuration = 1000L
			}

			currentScenario.durationMs = totalDuration
			currentScenario.durationLabel = formatDurationFull(totalDuration)
			currentScenario.status = resolveScenarioStatus(steps)
			currentScenario.errorShort = resolveScenarioErrorShort(steps)
			currentScenario.errorFull = resolveScenarioErrorFull(steps)
			currentScenario.sidebarSubtitle = isBlank(currentScenario.errorShort) ? safeValue(currentScenario.title) : currentScenario.errorShort

			Map firstTimedStep = steps.find { Map item -> !isBlank(item.timeLabel) }
			Map lastTimedStep = null
			for (int i = steps.size() - 1; i >= 0; i--) {
				if (!isBlank(steps[i].timeLabel)) {
					lastTimedStep = steps[i]
					break
				}
			}

			if (isBlank(currentScenario.startLabel) && firstTimedStep != null) {
				currentScenario.startLabel = safeValue(firstTimedStep.timeLabel)
			}
			if (isBlank(currentScenario.endLabel) && lastTimedStep != null) {
				currentScenario.endLabel = safeValue(lastTimedStep.timeLabel)
			}

			scenarios.add(currentScenario)
			currentScenario = null
		}

		rawLines.each { String rawLine ->
			String timeLabel = extractTimeLabel(rawLine)
			long timestampMs = extractTimeMillis(rawLine)
			String line = sanitizeLogLine(rawLine)

			if (isBlank(line)) {
				return
			}

			String testCaseTitle = extractTestCaseTitle(line)
			if (!isBlank(testCaseTitle)) {
				finishStep.call()
				finishScenario.call()

				if (shouldIgnoreTestCase(testCaseTitle)) {
					currentScenario = null
					return
				}

				currentScenario = newScenarioMap('scenario-' + (scenarios.size() + 1), normalizeTestCaseTitle(testCaseTitle))
				if (!isBlank(timeLabel)) {
					currentScenario.startLabel = timeLabel
				}
				return
			}

			Map stepData = parseStepLine(line)
			if (stepData != null) {
				if (currentScenario == null) {
					currentScenario = newScenarioMap('scenario-' + (scenarios.size() + 1), defaultScenarioTitle(reportDir))
				}

				finishStep.call()

				currentStep = [
					id           : currentScenario.id + '-step-' + (((currentScenario.steps ?: []).size()) + 1),
					title        : safeValue(stepData.title),
					status       : safeValue(stepData.status),
					timeLabel    : isBlank(timeLabel) ? safeValue(stepData.timeLabel) : timeLabel,
					timestampMs  : timestampMs > 0L ? timestampMs : toLong(stepData.timestampMs),
					durationMs   : toLong(stepData.durationMs),
					durationLabel: formatDurationFull(toLong(stepData.durationMs)),
					detailText   : safeValue(stepData.title),
					detailLines  : [safeValue(stepData.title)],
					errorLines   : [],
					errorFull    : '',
					shortError   : '',
					emoji        : resolveStepEmoji(stepData.title)
				]

				if (toLong(currentStep.durationMs) <= 0L) {
					currentStep.durationMs = 1000L
					currentStep.durationLabel = formatDurationFull(1000L)
				}

				currentScenario.steps << currentStep
				return
			}

			Map event = parseEventLine(line, timeLabel, timestampMs)
			if (event != null && currentStep != null) {
				if (isBlank(currentStep.timeLabel)) {
					currentStep.timeLabel = safeValue(event.timeLabel)
				}
				if (toLong(currentStep.timestampMs) <= 0L && toLong(event.timestampMs) > 0L) {
					currentStep.timestampMs = toLong(event.timestampMs)
				}

				String eventStatus = safeValue(event.status)
				String eventMessage = safeValue(event.message)

				if (!isBlank(eventMessage)) {
					currentStep.detailLines << eventMessage
				}

				if (eventStatus == 'failed') {
					currentStep.status = 'failed'
					if (!isBlank(eventMessage)) {
						currentStep.errorLines << eventMessage
					}
					if (isBlank(currentStep.shortError)) {
						currentStep.shortError = extractShortError(eventMessage)
					}
				} else if (eventStatus == 'skipped') {
					if (safeValue(currentStep.status) != 'failed') {
						currentStep.status = 'skipped'
					}
				} else if (eventStatus == 'passed') {
					if (safeValue(currentStep.status) != 'failed') {
						currentStep.status = 'passed'
					}
				} else if (isBlank(currentStep.status)) {
					currentStep.status = 'info'
				}

				return
			}

			if (currentStep == null) {
				return
			}

			if (looksLikeErrorLine(line)) {
				currentStep.status = 'failed'
				currentStep.errorLines << line
				currentStep.detailLines << line
				if (isBlank(currentStep.shortError)) {
					currentStep.shortError = extractShortError(line)
				}
				return
			}

			if (!looksLikeNoiseLine(line)) {
				currentStep.detailLines << line
			}
		}

		finishStep.call()
		finishScenario.call()

		return scenarios
	}

	private Map newScenarioMap(String id, String title) {
		return [
			id             : id,
			title          : title,
			status         : 'passed',
			startLabel     : '',
			endLabel       : '',
			durationMs     : 0L,
			durationLabel  : formatDurationFull(0L),
			steps          : [],
			errorShort     : '',
			errorFull      : '',
			sidebarSubtitle: '',
			evidences      : []
		]
	}

	private String extractTestCaseTitle(String line) {
		String text = safeValue(line)

		def matcherA = (text =~ /^TEST CASE[:\s]+(.+?)(?:\s+\(([\d.,]+s)\))?$/)
		if (matcherA.find()) {
			return safeValue(matcherA.group(1))
		}

		def matcherB = (text =~ /^(Test Cases\/.+?)(?:\s+\(([\d.,]+s)\))?$/)
		if (matcherB.find()) {
			return safeValue(matcherB.group(1))
		}

		return ''
	}

	private Map parseStepLine(String line) {
		String text = safeValue(line)

		if (isIgnorableStandaloneLine(text)) {
			return null
		}

		def matcherA = (text =~ /^TEST STEP[:\s]+(.+)$/)
		if (matcherA.find()) {
			String title = cleanupStepTitle(safeValue(matcherA.group(1)))
			if (shouldIgnoreStep(title)) {
				return null
			}
			return [
				title      : title,
				status     : 'passed',
				timeLabel  : '',
				timestampMs: 0L,
				durationMs : 1000L
			]
		}

		def matcherB = (text =~ /^(\d+)\s*-\s*(.+?)(?:\s+\(([\d.,]+s)\))?$/)
		if (matcherB.find()) {
			String title = cleanupStepTitle(safeValue(matcherB.group(2)))
			if (shouldIgnoreStep(title)) {
				return null
			}
			long durationMs = toMillisFromCompactSeconds(safeValue(matcherB.group(3)))
			if (durationMs <= 0L) {
				durationMs = 1000L
			}
			return [
				title      : title,
				status     : 'passed',
				timeLabel  : '',
				timestampMs: 0L,
				durationMs : durationMs
			]
		}

		return null
	}

	private Map parseEventLine(String line, String defaultTimeLabel, long defaultTimestampMs) {
		String text = safeValue(line)

		def matcherA = (text =~ /^(\d{2}:\d{2}:\d{2}(?:\.\d{3})?)\s+(PASSED|FAILED|ERROR|INFO|WARNING|SKIPPED)\s+(.*)$/)
		if (matcherA.find()) {
			return [
				timeLabel  : cleanClock(safeValue(matcherA.group(1))),
				timestampMs: defaultTimestampMs,
				status     : normalizeEventStatus(safeValue(matcherA.group(2))),
				message    : safeValue(matcherA.group(3))
			]
		}

		def matcherB = (text =~ /^(PASSED|FAILED|ERROR|INFO|WARNING|SKIPPED)\s+(.*)$/)
		if (matcherB.find()) {
			return [
				timeLabel  : defaultTimeLabel,
				timestampMs: defaultTimestampMs,
				status     : normalizeEventStatus(safeValue(matcherB.group(1))),
				message    : safeValue(matcherB.group(2))
			]
		}

		return null
	}

	private String normalizeEventStatus(String rawStatus) {
		String value = safeValue(rawStatus).toUpperCase(Locale.ENGLISH)

		if (value == 'FAILED' || value == 'ERROR') {
			return 'failed'
		}
		if (value == 'SKIPPED') {
			return 'skipped'
		}
		if (value == 'PASSED') {
			return 'passed'
		}
		return 'info'
	}

	private boolean shouldIgnoreTestCase(String title) {
		String lower = safeValue(title).toLowerCase(Locale.ENGLISH)
		return lower.contains('/jira_import_') ||
				lower.contains('/jira import') ||
				lower.contains('jiraimport') ||
				lower.contains('jira import')
	}

	private boolean shouldIgnoreStep(String title) {
		String lower = safeValue(title).toLowerCase(Locale.ENGLISH)

		boolean ignored = false
		ignored = ignored || lower.startsWith('start listener action')
		ignored = ignored || lower.startsWith('beforecase')
		ignored = ignored || lower.startsWith('aftercase')
		ignored = ignored || lower.startsWith('beforesuite')
		ignored = ignored || lower.startsWith('aftersuite')
		ignored = ignored || lower == 'video'
		ignored = ignored || lower.startsWith('exportkatalonreports')

		return ignored
	}

	private boolean isIgnorableStandaloneLine(String line) {
		String lower = safeValue(line).toLowerCase(Locale.ENGLISH)
		return lower.startsWith('beforecase') ||
				lower.startsWith('aftercase') ||
				lower.startsWith('beforesuite') ||
				lower.startsWith('aftersuite') ||
				lower == 'video'
	}

	private boolean looksLikeNoiseLine(String line) {
		String lower = safeValue(line).toLowerCase(Locale.ENGLISH)

		boolean noise = false
		noise = noise || lower.startsWith('build info:')
		noise = noise || lower.startsWith('system info:')
		noise = noise || lower.startsWith('driver info:')
		noise = noise || lower.startsWith('capabilities')
		noise = noise || lower.startsWith('session id:')
		return noise
	}

	private boolean looksLikeErrorLine(String line) {
		String lower = safeValue(line).toLowerCase(Locale.ENGLISH)

		boolean error = false
		error = error || lower.contains('stepfailedexception')
		error = error || lower.contains('steperrorexception')
		error = error || lower.contains('root cause')
		error = error || lower.contains('caused by:')
		error = error || lower.contains('exception')
		error = error || lower.contains('unable to ')
		error = error || lower.contains('classnotfoundexception')
		error = error || lower.contains('no such element')
		error = error || lower.contains('timeout')
		error = error || lower.startsWith('at ')
		return error
	}

	private void applyStepDurationsFromTimestamps(List<Map> steps) {
		if (steps == null || steps.isEmpty()) {
			return
		}

		for (int i = 0; i < steps.size(); i++) {
			Map current = steps[i]
			Map next = i + 1 < steps.size() ? steps[i + 1] : null

			long currentMs = toLong(current.timestampMs)
			long nextMs = next != null ? toLong(next.timestampMs) : 0L

			if (currentMs > 0L && nextMs > currentMs) {
				current.durationMs = nextMs - currentMs
				current.durationLabel = formatDurationFull(toLong(current.durationMs))
			}
		}
	}

	private String normalizeTestCaseTitle(String rawTitle) {
		String value = safeValue(rawTitle).replace('\\', '/')
		if (value.contains('/')) {
			return value.tokenize('/').last()
		}
		return value
	}

	private String defaultScenarioTitle(File reportDir) {
		File parent = reportDir?.parentFile
		if (parent != null && !isBlank(parent.name)) {
			return safeValue(parent.name)
		}
		return 'Execution'
	}

