    @Keyword
    String getInstalledExePath() {
        String expected = safe(detectedWindowTitle)
        if (!expected) {
            expected = resolveWindowTitle()
        }

        String runningPath = getInstalledExePathFromRunningWindow(expected)
        if (fileExists(runningPath)) {
            return runningPath
        }

        String user = getCurrentWindowsUser()
        String baseDir = "C:\\Users\\${user}\\AppData\\Local\\Apps\\2.0"

        String script = """
\$ErrorActionPreference = 'SilentlyContinue'
\$base = '${ps(baseDir)}'
if (-not (Test-Path \$base)) { return }

\$exe = Get-ChildItem -Path \$base -Filter 'IXIS.eMatch.HIM.exe' -File -Recurse -ErrorAction SilentlyContinue |
    Sort-Object LastWriteTime -Descending |
    Select-Object -First 1 -ExpandProperty FullName

if (\$exe) { \$exe }
"""

        return safe(runPowerShell(script, 60))
    }

    @Keyword
    void ensureWinAppDriverRunning() {
        if (isPortOpen('127.0.0.1', WINAPPDRIVER_PORT)) {
            KeywordUtil.logInfo("WinAppDriver already running on 127.0.0.1:${WINAPPDRIVER_PORT}")
            return
        }

        String winAppDriverPath = getWinAppDriverPath()
        if (!fileExists(winAppDriverPath)) {
            KeywordUtil.markFailedAndStop("WinAppDriver was not found at ${winAppDriverPath}")
        }

        KeywordUtil.logInfo("Starting WinAppDriver minimized from ${winAppDriverPath}")
        runDetached("start \"\" /min \"${winAppDriverPath}\" 127.0.0.1 ${WINAPPDRIVER_PORT}")

        long end = System.currentTimeMillis() + 30000L
        while (System.currentTimeMillis() < end) {
            if (isPortOpen('127.0.0.1', WINAPPDRIVER_PORT)) {
                KeywordUtil.logInfo("WinAppDriver is ready on 127.0.0.1:${WINAPPDRIVER_PORT}")
                return
            }
            sleepMs(500)
        }

        KeywordUtil.markFailedAndStop("WinAppDriver did not start on 127.0.0.1:${WINAPPDRIVER_PORT}")
    }

    @Keyword
    void startMatch(String currentUser, String targetWindowTitle) {
        String expectedTitle = normalizeTitle(targetWindowTitle ?: resolveWindowTitle())

        KeywordUtil.logInfo("Starting eMatch for environment ${readEnv()}")
        KeywordUtil.logInfo("Current Windows user ${safe(currentUser)}")
        KeywordUtil.logInfo("Target window title ${expectedTitle}")

        ensureWinAppDriverRunning()

        Map<String, String> alreadyOpen = findMatchingWindow(expectedTitle)
        if (safe(alreadyOpen.title)) {
            detectedWindowTitle  = normalizeTitle(alreadyOpen.title)
            detectedWindowHandle = safe(alreadyOpen.handle)
            KeywordUtil.logInfo("eMatch already open with title ${detectedWindowTitle}")
            return
        }

        String launcherBat     = getLauncherBat()
        String shortcutPath    = getShortcutPath()
        String applicationPath = getApplicationPath()
        String installedExe    = getInstalledExePath()

        if (fileExists(launcherBat)) {
            KeywordUtil.logInfo("Launching launcher bat ${launcherBat}")
            runDetached("start \"\" \"${launcherBat}\"")
        } else if (fileExists(shortcutPath)) {
            KeywordUtil.logInfo("Launching shortcut ${shortcutPath}")
            runDetached("start \"\" \"${shortcutPath}\"")
        } else if (fileExists(applicationPath)) {
            KeywordUtil.logInfo("Launching application path ${applicationPath}")
            runDetached("start \"\" \"${applicationPath}\"")
        } else if (fileExists(installedExe)) {
            KeywordUtil.logInfo("Launching installed exe ${installedExe}")
            runDetached("start \"\" \"${installedExe}\"")
        } else {
            KeywordUtil.markFailedAndStop(
                "Could not launch eMatch. No launcher bat, shortcut, application path or installed exe was found."
            )
        }

        Map<String, String> found = waitForWindow(expectedTitle, 120)
        if (!safe(found.title)) {
            KeywordUtil.markFailedAndStop("eMatch window was not detected after launch. Expected title ${expectedTitle}")
        }

        detectedWindowTitle  = normalizeTitle(found.title)
        detectedWindowHandle = safe(found.handle)

        KeywordUtil.logInfo("eMatch window detected during startup with title ${detectedWindowTitle}")
    }

    @Keyword
    void attachToLoginWindow(String targetWindowTitle) {
        String expectedTitle = normalizeTitle(
            safe(detectedWindowTitle) ? detectedWindowTitle : targetWindowTitle
        )

        KeywordUtil.logInfo("Attaching to login window. Expected title ${expectedTitle}")

        ensureWinAppDriverRunning()

        Map<String, String> found = waitForWindow(expectedTitle, 30)
        if (safe(found.title)) {
            detectedWindowTitle  = normalizeTitle(found.title)
            detectedWindowHandle = safe(found.handle)
        }

        String installedExePath = getInstalledExePath()
        if (!fileExists(installedExePath)) {
            KeywordUtil.logInfo("Installed exe not found yet. Waiting a little longer.")
            long end = System.currentTimeMillis() + 30000L
            while (System.currentTimeMillis() < end) {
                installedExePath = getInstalledExePath()
                if (fileExists(installedExePath)) {
                    break
                }
                sleepMs(1000)
            }
        }

        if (!fileExists(installedExePath)) {
            KeywordUtil.markFailedAndStop("Installed exe was not found. Path ${installedExePath}")
        }

        Throwable lastError = null

        for (int attempt = 1; attempt <= 5; attempt++) {
            try {
                KeywordUtil.logInfo("Attach attempt ${attempt} with title ${expectedTitle}")
                Windows.startApplicationWithTitle(installedExePath, expectedTitle)
                sleepMs(2500)

                if (waitForLoginDialog(10)) {
                    KeywordUtil.logInfo("Login dialog attached successfully")
                    return
                }
            } catch (Throwable t) {
                lastError = t
                KeywordUtil.logInfo("Attach attempt ${attempt} failed: ${safe(t.message)}")
            }

            Map<String, String> refresh = waitForWindow(expectedTitle, 10)
            if (safe(refresh.title)) {
                detectedWindowTitle  = normalizeTitle(refresh.title)
                detectedWindowHandle = safe(refresh.handle)
                expectedTitle        = detectedWindowTitle
            }

            sleepMs(2000)
        }

        KeywordUtil.markFailedAndStop(
            "Could not attach to login window. Expected title ${expectedTitle}. ${safe(lastError?.message)}"
        )
    }

    @Keyword
    void openEnvironmentDropdown() {
        if (!waitForLoginDialog(20)) {
            KeywordUtil.markFailedAndStop("Login dialog was not found before opening environment dropdown.")
        }

        try {
            Windows.click(envComboObj())
            sleepMs(1000)
            Windows.sendKeys(envComboObj(), Keys.chord(Keys.ALT, Keys.ARROW_DOWN))
            sleepMs(1000)
            return
        } catch (Throwable ignored) {
        }

        try {
            Windows.sendKeys(envComboObj(), Keys.chord(Keys.ALT, Keys.ARROW_DOWN))
            sleepMs(1000)
            return
        } catch (Throwable t) {
            KeywordUtil.markFailedAndStop("Could not open environment dropdown. ${safe(t.message)}")
        }
    }

    @Keyword
    int resolveEnvironmentIndex(String env) {
        String value = safe(env).toUpperCase()

        Map<String, Integer> indexes = [
            'PROD': 0,
            'PREX': 1,
            'REC2': 2,
            'REC' : 3,
            'DEV2': 4,
            'DEV' : 5
        ]

        return indexes.containsKey(value) ? indexes[value] : 3
    }

    private String resolveEnvironmentDisplayValue(String env) {
        String value = safe(env).toUpperCase()

        Map<String, String> values = [
            'PROD': 'Production (PROD)',
            'PREX': 'Bench (PREX)',
            'REC2': 'Qualification (REC2)',
            'REC' : 'Recette (REC)',
            'DEV2': 'Simulation (DEV2)',
            'DEV' : 'Development (DEV)'
        ]

        return values.containsKey(value) ? values[value] : 'Recette (REC)'
    }

    @Keyword
    void selectEnvironment(String env) {
        String displayValue = resolveEnvironmentDisplayValue(env)
        int targetIndex = resolveEnvironmentIndex(env)

        openEnvironmentDropdown()

        try {
            WindowsTestObject optionObj = winObj(
                'envOption',
                "//*[@Name='${displayValue.replace(\"'\", \"&apos;\")}']"
            )

            if (Windows.waitForElementPresent(optionObj, 5)) {
                Windows.click(optionObj)
                sleepMs(1000)
                return
            }
        } catch (Throwable ignored) {
        }

        try {
            for (int i = 0; i < targetIndex; i++) {
                Windows.sendKeys(envComboObj(), Keys.ARROW_DOWN)
                sleepMs(300)
            }
            Windows.sendKeys(envComboObj(), Keys.ENTER)
            sleepMs(1000)
            return
        } catch (Throwable t) {
            KeywordUtil.markFailedAndStop("Could not select environment ${safe(env)}. ${safe(t.message)}")
        }
    }

