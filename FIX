        if (isBlank(reportFolder)) {
            return ''
        }

        File root = new File(reportFolder)
        if (!root.exists() || !root.isDirectory()) {
            return ''
        }

        List<File> preferred = new ArrayList<File>()
        List<File> secondary = new ArrayList<File>()

        collectXmlFiles(root, preferred, secondary)

        if (!preferred.isEmpty()) {
            preferred.sort { a, b -> b.lastModified() <=> a.lastModified() }
            return preferred[0].absolutePath
        }

        if (!secondary.isEmpty()) {
            secondary.sort { a, b -> b.lastModified() <=> a.lastModified() }
            return secondary[0].absolutePath
        }

        return ''
    }

    void collectXmlFiles(File currentDir, List<File> preferred, List<File> secondary) {
        if (currentDir == null || !currentDir.exists() || !currentDir.isDirectory()) {
            return
        }

        File[] children = currentDir.listFiles()
        if (children == null) {
            return
        }

        for (File child : children) {
            if (child == null) {
                continue
            }

            if (child.isDirectory()) {
                collectXmlFiles(child, preferred, secondary)
                continue
            }

            String lowerName = safe(child.name).toLowerCase(Locale.ENGLISH)
            if (lowerName == safe(PRIMARY_XML_FILE_NAME).toLowerCase(Locale.ENGLISH)) {
                preferred.add(child)
            } else if (lowerName == safe(SECONDARY_XML_FILE_NAME).toLowerCase(Locale.ENGLISH)) {
                secondary.add(child)
            }
        }
    }

    File findExecutionLog(String reportFolder) {
        if (isBlank(reportFolder)) {
            return null
        }

        List<File> matches = new ArrayList<File>()
        collectNamedLogs(new File(reportFolder), matches)

        if (matches.isEmpty()) {
            return null
        }

        matches.sort { a, b -> b.lastModified() <=> a.lastModified() }
        return matches[0]
    }

    void collectNamedLogs(File currentDir, List<File> matches) {
        if (currentDir == null || !currentDir.exists() || !currentDir.isDirectory()) {
            return
        }

        File[] children = currentDir.listFiles()
        if (children == null) {
            return
        }

        for (File child : children) {
            if (child == null) {
                continue
            }

            if (child.isDirectory()) {
                collectNamedLogs(child, matches)
                continue
            }

            String lowerName = safe(child.name).toLowerCase(Locale.ENGLISH)
            if (lowerName.startsWith('execution') && lowerName.endsWith('.log')) {
                matches.add(child)
            }
        }
    }

