package commands

import java.awt.Robot
import java.awt.event.KeyEvent

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

class DimensionsNavigator {

	private ImageLoader imageLoader = new ImageLoader()
	private ExportFile exportFile = new ExportFile()

	@Keyword
	String getDimensionsImageGroupByCurrentEnvironment(String imageGroupPrefix) {
		return imageGroupPrefix + '_' + exportFile.getCurrentEnvironment()
	}

	@Keyword
	void validateDimensionsImagesExist(String dimensionsImageGroup) {
		imageLoader.validateGroupImagesExist(dimensionsImageGroup)
	}

	@Keyword
	void clickFirstDimension(String dimensionsImageGroup) {
		imageLoader.clickImageOrStop(dimensionsImageGroup, 'firstDimension')
		Windows.delay(2)
	}

	@Keyword
	void openDimensionsUntilProvic(String dimensionsImageGroup, Integer maxDownMoves) {
		int safeMoves = maxDownMoves == null || maxDownMoves <= 0 ? 30 : maxDownMoves

		validateDimensionsImagesExist(dimensionsImageGroup)
		clickFirstDimension(dimensionsImageGroup)

		if (!imageLoader.isVisible(dimensionsImageGroup, 'measures')) {
			KeywordUtil.markFailedAndStop(
				'Measures dimension is not visible after click.\n' +
				'Group: ' + dimensionsImageGroup
			)
		}

		pressKey(KeyEvent.VK_RIGHT)
		Windows.delay(1)

		for (int i = 0; i < safeMoves; i++) {
			if (imageLoader.isVisible(dimensionsImageGroup, 'provicOpen')) {
				KeywordUtil.logInfo('Provic open image found after navigating dimensions.')
				return
			}

			pressKey(KeyEvent.VK_DOWN)
			Windows.delay(1)
		}

		imageLoader.takeEvidence('ProvicOpenNotFound.png')

		KeywordUtil.markFailedAndStop(
			'Provic open image was not found while navigating dimensions.\n' +
			'Group: ' + dimensionsImageGroup + '\n' +
			'Max down moves: ' + safeMoves
		)
	}

	@Keyword
	void scrollDimensionsToTop(String dimensionsImageGroup) {
		Robot robot = new Robot()
		robot.setAutoDelay(120)

		try {
			if (imageLoader.isVisible(dimensionsImageGroup, 'provicOpen')) {
				imageLoader.clickImageOrStop(dimensionsImageGroup, 'provicOpen')
			} else if (imageLoader.isVisible(dimensionsImageGroup, 'measures')) {
				imageLoader.clickImageOrStop(dimensionsImageGroup, 'measures')
			}
		} catch (Exception ignored) {
		}

		Windows.delay(1)

		for (int i = 0; i < 5; i++) {
			pressKey(KeyEvent.VK_HOME)
			Windows.delay(1)
		}

		for (int i = 0; i < 15; i++) {
			robot.mouseWheel(-1)
			Windows.delay(1)
		}
	}

	@Keyword
	void validateProvicOpen(String dimensionsImageGroup, Integer timeoutSeconds) {
		imageLoader.waitForImageOrStop(
			dimensionsImageGroup,
			'provicOpen',
			timeoutSeconds == null ? 10 : timeoutSeconds
		)
	}

	@Keyword
	void validateMeasuresOpen(String dimensionsImageGroup, Integer timeoutSeconds) {
		imageLoader.waitForImageOrStop(
			dimensionsImageGroup,
			'measures',
			timeoutSeconds == null ? 10 : timeoutSeconds
		)
	}

	@Keyword
	void validateNormeOpen(String dimensionsImageGroup, Integer timeoutSeconds) {
		imageLoader.waitForImageOrStop(
			dimensionsImageGroup,
			'normeOpen',
			timeoutSeconds == null ? 10 : timeoutSeconds
		)
	}

	@Keyword
	void validateStartOfDimensions(String dimensionsImageGroup, Integer timeoutSeconds) {
		imageLoader.waitForImageOrStop(
			dimensionsImageGroup,
			'startOfDimensions',
			timeoutSeconds == null ? 10 : timeoutSeconds
		)
	}

	@Keyword
	void validateEndOfDimensions(String dimensionsImageGroup, Integer timeoutSeconds) {
		imageLoader.waitForImageOrStop(
			dimensionsImageGroup,
			'endOfDimensions',
			timeoutSeconds == null ? 10 : timeoutSeconds
		)
	}

	@Keyword
	void validateEndOfDimensionsSelected(String dimensionsImageGroup, Integer timeoutSeconds) {
		imageLoader.waitForImageOrStop(
			dimensionsImageGroup,
			'endOfDimensionsSelected',
			timeoutSeconds == null ? 10 : timeoutSeconds
		)
	}

	@Keyword
	void validateFirstPageReference(String dimensionsImageGroup, Integer timeoutSeconds) {
		imageLoader.waitForImageOrStop(
			dimensionsImageGroup,
			'firstPageRef',
			timeoutSeconds == null ? 10 : timeoutSeconds
		)
	}

	@Keyword
	void validateSecondPageReference(String dimensionsImageGroup, Integer timeoutSeconds) {
		imageLoader.waitForImageOrStop(
			dimensionsImageGroup,
			'secondPageRef',
			timeoutSeconds == null ? 10 : timeoutSeconds
		)
	}

	@Keyword
	void validateThirdPageReference(String dimensionsImageGroup, Integer timeoutSeconds) {
		imageLoader.waitForImageOrStop(
			dimensionsImageGroup,
			'thirdPageRef',
			timeoutSeconds == null ? 10 : timeoutSeconds
		)
	}

	@Keyword
	boolean isDimensionImageVisible(String dimensionsImageGroup, String imageKey) {
		return imageLoader.isVisible(dimensionsImageGroup, imageKey)
	}

	@Keyword
	void clickDimensionImageOrStop(String dimensionsImageGroup, String imageKey) {
		imageLoader.clickImageOrStop(dimensionsImageGroup, imageKey)
	}

	@Keyword
	void waitForDimensionImageOrStop(String dimensionsImageGroup, String imageKey, Integer timeoutSeconds) {
		imageLoader.waitForImageOrStop(
			dimensionsImageGroup,
			imageKey,
			timeoutSeconds == null ? 10 : timeoutSeconds
		)
	}

	@Keyword
	void waitSeconds(Integer seconds) {
		Windows.delay(seconds == null ? 1 : seconds)
	}

	private void pressKey(int keyCode) {
		Robot robot = new Robot()
		robot.setAutoDelay(120)
		robot.keyPress(keyCode)
		robot.keyRelease(keyCode)
	}
}
