        border-radius: 6px;
        padding: 12px;
        min-height: 70px;
    }
    .stat-label {
        font-size: 10px;
        text-transform: uppercase;
        color: #6b7280;
        margin-bottom: 8px;
        font-weight: 700;
    }
    .stat-value {
        font-size: 14px;
        font-weight: 600;
        line-height: 1.4;
    }
    .section-title {
        font-size: 14px;
        font-weight: 700;
        margin: 22px 0 10px 0;
    }
    .section-title.failed {
        color: #b91c1c;
    }
    .section-title.passed {
        color: #15803d;
    }
    .section-title.skipped {
        color: #92400e;
    }
    .case-card {
        border-left: 3px solid #d1d5db;
        background: #ffffff;
        padding: 10px 12px 14px 12px;
        margin-bottom: 18px;
    }
    .case-card.failed {
        border-left-color: #dc2626;
        background: #fff7f7;
    }
    .case-card.passed {
        border-left-color: #16a34a;
        background: #f8fff9;
    }
    .case-card.skipped {
        border-left-color: #d97706;
        background: #fffaf0;
    }
    .case-title {
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 4px;
    }
    .case-meta {
        font-size: 12px;
        color: #4b5563;
        margin-bottom: 6px;
    }
    .failure-line {
        font-size: 12px;
        color: #374151;
        margin: 2px 0;
    }
    .details-wrap {
        margin-top: 8px;
    }
    details summary {
        cursor: pointer;
        font-size: 12px;
        color: #111827;
        font-weight: 600;
    }
    pre {
        margin-top: 8px;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        padding: 10px;
        font-size: 11px;
        line-height: 1.45;
        white-space: pre-wrap;
        word-break: break-word;
        overflow-x: auto;
    }
    .failure-image {
        margin-top: 12px;
        max-width: 320px;
        max-height: 180px;
        border: 1px solid #d1d5db;
        border-radius: 4px;
        display: block;
        background: #ffffff;
    }
    .empty-text {
        font-size: 13px;
        color: #6b7280;
        margin-top: 10px;
    }
