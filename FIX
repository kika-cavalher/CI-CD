	// ---------------------------------------------------------
	// applySourceFilter
	// ---------------------------------------------------------
	// Uses:
	// Component: FilterKeywords.selectOnlyFilterValue
	// Images: sourceParent, filterButton, sourceAscending,
	// sourceDescending, titleValues, FilterToutchecked,
	// textFilterFR, bilan, resultat, closeFiltersButtonFR
	// Objects: sourceHeader, sourceFilterButton,
	// filterValuesTab, filterSelectAllOption,
	// filterSearchInput, sourceBilanCheckbox,
	// sourceResultatCheckbox, closeFiltersButtonFR
	// Helpers: safeTimeout, normalizeSource, takeEvidence

	@Keyword
	void applySourceFilter(
			String sourceValue,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)
		String normalizedSource =
			normalizeSource(sourceValue)

		if (!normalizedSource.equals('bilan') &&
			!normalizedSource.equals('resultat')) {

			KeywordUtil.markFailedAndStop(
				'Unsupported source filter value: ' +
					sourceValue +
					'. Allowed values: bilan or resultat.'
			)

			return
		}

		String resultImageKey =
			normalizedSource.equals('bilan')
				? 'bilan'
				: 'resultat'

		String resultObjectKey =
			normalizedSource.equals('bilan')
				? 'sourceBilanCheckbox'
				: 'sourceResultatCheckbox'

		filterKeywords.selectOnlyFilterValue(
			IMAGE_GROUP,
			OBJECT_GROUP,
			'sourceParent',
			'sourceHeader',
			[
				'filterButton',
				'sourceDescending',
				'sourceAscending'
			],
			'sourceFilterButton',
			'titleValues',
			'filterValuesTab',
			'filterAllChecked',
			'filterSelectAllOption',
			'textFilterFR',
			'filterSearchInput',
			resultImageKey,
			resultObjectKey,
			'closeFiltersButtonFR',
			'closeFiltersButtonFR',
			normalizedSource.toUpperCase(),
			timeout
		)

		takeEvidence(
			'Investigations_SourceFilter_' +
				normalizedSource.toUpperCase() +
				'.png'
		)
	}

