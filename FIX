@Field Map SUITE = [
    NODE_LABEL                    : 'GI5_SWDCFRNXGI55817',
    CUSTOM_WORKSPACE_PATH         : 'D:\\jenkins\\work\\workspace\\GI5\\eMatch_Regression\\Archive Mode',

    STARTERS_DIR                  : 'D:\\Projects\\eMatchStarters',
    DESKTOP_RUNNER_TASK           : '\\eMatch Automation\\RunEMatchDesktop',
    WINAPPDRIVER_EXE              : 'C:\\Program Files (x86)\\Windows Application Driver\\WinAppDriver.exe',
    AUTO_START_WINAPPDRIVER       : 'true',

    KATALON_EXE                   : 'C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0\\katalonc.exe',
    PROJECT_FILE                  : 'eMatch POC.prj',

    SUITE_NAME                    : 'Archive Mode Collection',
    SUITE_TYPE                    : 'COLLECTION',
    SUITE_PATH                    : 'Test Suites\\Archive Mode\\Archive Mode Collection',

    BROWSER_TYPE                  : 'Windows',
    RETRY                         : '0',
    TIMEOUT_MINUTES               : 180,
    ALLOW_EXIT_3_WHEN_JUNIT_GREEN : true,

    APP_EXE_PATH                  : '',
    APP_LNK_PATH                  : 'D:/RunAsEMatchReg/eMatch.lnk',

    NEXT_JOB_NAME                 : '',
    WAIT_FOR_NEXT_JOB             : false,
    PROPAGATE_NEXT_JOB_FAILURE    : false
]

def loadHelpers(script) {
    return [
        consoleView : script.load('jenkinsIntegration/JenkinsConsoleView.groovy'),
        taskLogger  : script.load('jenkinsIntegration/JenkinsDesktopTaskLogger.groovy'),
        paths       : script.load('jenkinsIntegration/JenkinsPaths.groovy'),
        resultStore : script.load('jenkinsIntegration/JenkinsResultStore.groovy')
    ]
}

def buildCfg(script, Map helpers) {
    String reportsRoot = helpers.paths.reportsRoot(script)
    String logsDir = "${reportsRoot}\\_desktop_logs"

    return [
        workspace                : helpers.paths.workspace(script),
        reportsRoot              : reportsRoot,
        logsDir                  : logsDir,
        startersDir              : SUITE.STARTERS_DIR,
        ctxFile                  : "${SUITE.STARTERS_DIR}\\run-context.properties",
        markerFile               : "${SUITE.STARTERS_DIR}\\logs\\__jenkins_task_exitcode.txt",
        currentLogFile           : "${logsDir}\\katalon_current.log",
        resultFile               : "${logsDir}\\desktop-run-result.json",
        desktopRunnerTask        : SUITE.DESKTOP_RUNNER_TASK,
        winAppDriverExe          : SUITE.WINAPPDRIVER_EXE,
        autoStartWinAppDriver    : SUITE.AUTO_START_WINAPPDRIVER,
        katalonExe               : SUITE.KATALON_EXE,
        projectPath              : helpers.paths.projectPath(script, SUITE.PROJECT_FILE),
        browserType              : SUITE.BROWSER_TYPE,
        retry                    : SUITE.RETRY,
        defaultTimeoutMinutes    : SUITE.TIMEOUT_MINUTES,
        runLabel                 : "${SUITE.SUITE_NAME} Build ${script.env.BUILD_NUMBER}",
        runnerWindowTitle        : "eMatch Runner ${SUITE.SUITE_NAME} ${script.env.BUILD_NUMBER}",
        appExePath               : SUITE.APP_EXE_PATH,
        appLnkPath               : SUITE.APP_LNK_PATH,
        allowExit3WhenJunitGreen : SUITE.ALLOW_EXIT_3_WHEN_JUNIT_GREEN
    ]
}

def buildAsset() {
    return [
        name           : SUITE.SUITE_NAME,
        type           : SUITE.SUITE_TYPE,
        path           : SUITE.SUITE_PATH,
        timeoutMinutes : SUITE.TIMEOUT_MINUTES
    ]
}

def normalizeResult(Map result) {
    Map normalized = [:] + (result ?: [:])

    if (!normalized.durationSeconds) {
        normalized.durationSeconds = '0'
    }

    if (!normalized.logRel) {
        normalized.logRel = '_desktop_logs/katalon_current.log'
    }

    if (!normalized.caseSummary) {
        normalized.caseSummary = []
    }

    if (!normalized.status) {
        normalized.status = 'FAILED'
    }

    if (!normalized.icon) {
        normalized.icon = (
            normalized.status == 'PASSED'
                ? '✅'
                : (normalized.status == 'TIMEOUT' ? '⏰' : '❌')
        )
    }

    return normalized
}

pipeline {
    agent {
        node {
            label SUITE.NODE_LABEL
            customWorkspace SUITE.CUSTOM_WORKSPACE_PATH
        }
    }

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        timeout(time: 4, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '20', daysToKeepStr: '30'))
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "Workspace: ${pwd()}"
            }
        }

        stage('Run Desktop Suite') {
            steps {
                script {
                    def helpers = loadHelpers(this)
                    def cfg = buildCfg(this, helpers)
                    def asset = buildAsset()

                    helpers.resultStore.saveSuiteResults(this, cfg.reportsRoot, [])

                    helpers.consoleView.printAssetHeader(this, asset, asset.timeoutMinutes.toString())

                    Map result = normalizeResult(helpers.taskLogger.runAsset(this, cfg, asset))

                    helpers.resultStore.saveSuiteResults(this, cfg.reportsRoot, [result])
                    helpers.consoleView.printAssetResult(this, result)
                    helpers.consoleView.printRunningSummary(this, [result])

                    if (result.status != 'PASSED') {
                        error("Desktop execution failed. Check Reports/${result.logRel}")
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    archiveArtifacts allowEmptyArchive: true, artifacts: [
                        'Reports/**/*',
                        'D:\\Projects\\eMatchStarters\\logs\\*.log',
                        'D:\\Projects\\eMatchStarters\\logs\\__jenkins_task_exitcode.txt'
                    ].join(',')
                }

                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    junit allowEmptyResults: true, testResults: 'Reports/**/JUnit_Report.xml,Reports/**/JUnit*.xml,Reports/**/junit*.xml'
                }
            }
        }

        success {
            script {
                if ((SUITE.NEXT_JOB_NAME ?: '').toString().trim()) {
                    echo "Triggering next Jenkins job at final stage: ${SUITE.NEXT_JOB_NAME}"
                    build job: SUITE.NEXT_JOB_NAME,
                        wait: (SUITE.WAIT_FOR_NEXT_JOB as boolean),
                        propagate: (SUITE.PROPAGATE_NEXT_JOB_FAILURE as boolean)
                }
            }
        }
    }
}








