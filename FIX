    }

    script.currentBuild.description = "${cfg.suiteName} | Exit=${exitCode}"

    if (exitCode != 0 || (junit.failed ?: 0) > 0) {
        script.error("Desktop execution failed. Check Reports\\_desktop_logs\\katalon_current.log")
    }
}

pipeline {
    agent {
        node {
            label SUITE.NODE_LABEL
            customWorkspace SUITE.CUSTOM_WORKSPACE_PATH
        }
    }

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        timeout(time: 4, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '20', daysToKeepStr: '30'))
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "Workspace: ${pwd()}"
            }
        }

        stage('Prepare Context + Reports') {
            steps {
                script {
                    def cfg = buildSuiteConfig(this)
                    prepareContext(this, cfg)
                }
            }
        }

        stage('Run Desktop') {
            steps {
                script {
                    def cfg = buildSuiteConfig(this)
                    runDesktopSuite(this, cfg)
                }
            }
        }
    }

    post {
        always {
            script {
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    archiveArtifacts artifacts: 'Reports/**', allowEmptyArchive: true
                }

                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    junit allowEmptyResults: true, testResults: 'Reports/**/JUnit_Report.xml,Reports/**/JUnit*.xml,Reports/**/junit*.xml'
                }
            }
        }
    }
}

