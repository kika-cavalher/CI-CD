	// ======================================================
	// OPEN ADMINISTRATION
	// ======================================================

	@Keyword
	boolean openAdministration(
		int timeoutSeconds
	) {
		int effectiveTimeout =
			timeoutSeconds <= 0
				? 5
				: timeoutSeconds

		WindowsTestObject administrationItem =
			WindowsObjectLoader.getObject(
				'common',
				'administrationItem'
			)

		if (!Windows.verifyElementPresent(
			administrationItem,
			effectiveTimeout,
			FailureHandling.OPTIONAL
		)) {
			takeEvidence(
				'AdministrationNotFound.png'
			)

			KeywordUtil.markFailedAndStop(
				'Administration item was not found.\n' +
				'Object: common.administrationItem\n' +
				'Expected Name: Administration'
			)

			return false
		}

		clickElementCenterByCoordinates(
			administrationItem
		)

		Thread.sleep(700)

		KeywordUtil.logInfo(
			'Administration item clicked successfully.\n' +
				'Object: common.administrationItem'
		)

		return true
	}


