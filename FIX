	}


	private List<String> getValidReportFolderParts() {

		List<String> validParts = []

		String reportFolderPath =
				RunConfiguration.getReportFolder()

		if (reportFolderPath == null ||
				reportFolderPath.trim().isEmpty()) {

			return validParts
		}

		File executionRootFolder =
				resolveExecutionRootFolder()

		String fullPath =
				new File(
				reportFolderPath
				)
				.getAbsolutePath()

		String rootPath =
				executionRootFolder
				.getAbsolutePath()

		if (!fullPath
			.toLowerCase()
			.startsWith(
			rootPath.toLowerCase()
			)) {

			return validParts
		}

		String relativePath =
				fullPath
				.substring(
				rootPath.length()
				)
				.replaceAll(
				'^\\\\+',
				''
				)

		if (relativePath.trim().isEmpty()) {
			return validParts
		}

		List<String> parts =
				relativePath
				.replace(
				'/',
				'\\'
				)
				.split(
				'\\\\'
				) as List<String>

		for (String part : parts) {

			if (isValidFeatureNamePart(
					part
					)) {

				validParts.add(
						part.trim()
						)
			}
		}

		return validParts
	}


	private boolean isValidFeatureNamePart(
			String part) {

		if (part == null ||
				part.trim().isEmpty()) {

			return false
		}

		String value =
				part.trim()

		String lower =
				value.toLowerCase()

		if (value ==~ /\d{8}_\d{6}/ ||
				value ==~ /\d{14}/ ||
				value ==~ /^\d+\.\s*.*/) {

			return false
		}

		List<String> ignoredExactValues = [
			'reports',
			'evidences',
			'exports',
			'test cases',
			'test suites',
			'connection',
			'authentication',
			'login rec',
			'login prd',
			'katalon',
			'temp'
		]

		if (ignoredExactValues.contains(
				lower
				)) {

			return false
		}

		List<String> ignoredContainsValues = [
			'filter export and validate',
			'validation compare rec x prd',
			'test tool validation',
			'close application',
			'open module',
			'login'
		]

		for (String ignored : ignoredContainsValues) {

			if (lower.contains(
					ignored
					)) {

				return false
			}
		}

		return true
	}


