	@Keyword
	void validateMissingRefComptaAlert(
			Integer timeoutSeconds
		) {

		// Configuration
		Integer timeout = safeTimeout(timeoutSeconds)

		// Double click first Total CCY result
		Boolean alertOpened =
			openMissingRefComptaAlert(
				timeout
			)

		if (!alertOpened) {
			takeEvidence(
				'Investigations_MissingRefComptaAlertNotOpened.png'
			)

			KeywordUtil.markFailedAndStop(
				'The missing REF COMPTA alert was not displayed after all double-click attempts.\n' +
				'Image: ' +
				IMAGE_GROUP +
				'.headerTotalCcy\n' +
				'Object: ' +
				OBJECT_GROUP +
				'.firstTotalCcyResultCell'
			)

			return
		}

		// Evidence
		takeEvidence(
			'Investigations_AlertNoRefCompta.png'
		)

		// Close alert
		closeMissingRefComptaAlert(
			timeout
		)

		Windows.delay(POLLING_DELAY_SECONDS)

		KeywordUtil.logInfo(
			'[PASS] Critical error was displayed when REF COMPTA was not selected.'
		)
	}


	// ---------------------------------------------------------
	// openMissingRefComptaAlert
	// Used by: validateMissingRefComptaAlert
	// ---------------------------------------------------------

	private Boolean openMissingRefComptaAlert(
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)
		Integer imageTimeout =
			Math.min(
				timeout,
				IMAGE_FALLBACK_TIMEOUT
			)

		// Attempt 1: image anchor and mouse double click
		try {
			if (imageLoader.waitForImage(
				IMAGE_GROUP,
				'headerTotalCcy',
				imageTimeout
			)) {
				Integer firstRowOffsetX = 50
				Integer firstRowOffsetY = 35

				WindowsImageKeywords.doubleclickImageWithCoorinates(
					image('headerTotalCcy'),
					firstRowOffsetX,
					firstRowOffsetY
				)

				if (waitForMissingRefComptaAlert(5)) {
					KeywordUtil.logInfo(
						'[PASS] First Total CCY result opened by image coordinates.'
					)

					return true
				}

				KeywordUtil.logInfo(
					'[IMAGE] Double click did not open the expected alert. Trying Windows object.'
				)
			}
		} catch (Throwable imageError) {
			KeywordUtil.logInfo(
				'[IMAGE] Could not double click the first Total CCY result.\n' +
				'Reason: ' +
				safeText(imageError.message)
			)
		}

		// Attempt 2: Windows object coordinates and physical mouse
		WindowsTestObject firstResultObject =
			object('firstTotalCcyResultCell')

		if (Windows.waitForElementPresent(
			firstResultObject,
			timeout,
			FailureHandling.OPTIONAL
		)) {
			try {
				List<RemoteWebElement> firstResultElements =
					Windows.findElements(
						firstResultObject
					)

				if (firstResultElements != null &&
					!firstResultElements.isEmpty()) {

					doubleClickElementCenterWithMouse(
						firstResultElements.get(0)
					)

					if (waitForMissingRefComptaAlert(5)) {
						KeywordUtil.logInfo(
							'[PASS] First Total CCY result opened by Windows object coordinates.'
						)

						return true
					}
				}
			} catch (Throwable mouseError) {
				KeywordUtil.logInfo(
					'[OBJECT] Physical mouse double click failed.\n' +
						'Reason: ' +
						safeText(mouseError.message)
				)
			}

			// Attempt 3: standard Windows double click
			try {
				Windows.doubleClick(
					firstResultObject,
					FailureHandling.OPTIONAL
				)

				if (waitForMissingRefComptaAlert(timeout)) {
					KeywordUtil.logInfo(
						'[PASS] First Total CCY result opened by standard Windows double click.'
					)

					return true
				}
			} catch (Throwable objectError) {
				KeywordUtil.logInfo(
					'[OBJECT] Standard Windows double click failed.\n' +
						'Reason: ' +
						safeText(objectError.message)
				)
			}
		}

		return false
	}


	// ---------------------------------------------------------
	// waitForMissingRefComptaAlert
	// Used by: openMissingRefComptaAlert
	// ---------------------------------------------------------

	private Boolean waitForMissingRefComptaAlert(
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)
		long endTime =
			System.currentTimeMillis() +
				(timeout * 1000L)

		WindowsTestObject alertObject =
			object('missingRefComptaAlert')

		while (System.currentTimeMillis() <= endTime) {
			try {
				if (imageLoader.waitForImage(
					IMAGE_GROUP,
					'alertModalIcon',
					1
				)) {
					return true
				}
			} catch (Throwable ignored) {
			}

			try {
				if (Windows.waitForElementPresent(
					alertObject,
					1,
					FailureHandling.OPTIONAL
				)) {
					return true
				}
			} catch (Throwable ignored) {
			}

			Windows.delay(POLLING_DELAY_SECONDS)
		}

		return false
	}


	// ---------------------------------------------------------
	// doubleClickElementCenterWithMouse
	// Used by: openMissingRefComptaAlert
	// ---------------------------------------------------------

	private void doubleClickElementCenterWithMouse(
			RemoteWebElement element
		) {

		def elementRectangle =
			element.getRect()

		Integer clickX =
			elementRectangle.getX() +
				elementRectangle.getWidth().intdiv(2)

		Integer clickY =
			elementRectangle.getY() +
				elementRectangle.getHeight().intdiv(2)

		Robot robot = new Robot()

		robot.mouseMove(
			clickX,
			clickY
		)

		robot.mousePress(
			InputEvent.BUTTON1_DOWN_MASK
		)
		robot.mouseRelease(
			InputEvent.BUTTON1_DOWN_MASK
		)

		Thread.sleep(150L)

		robot.mousePress(
			InputEvent.BUTTON1_DOWN_MASK
		)
		robot.mouseRelease(
			InputEvent.BUTTON1_DOWN_MASK
		)
	}


	// ---------------------------------------------------------
	// closeMissingRefComptaAlert
	// Used by: validateMissingRefComptaAlert
	// ---------------------------------------------------------

	private void closeMissingRefComptaAlert(
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)
		Integer shortTimeout = Math.min(timeout, 5)

		// Attempt 1: OK button by image
		try {
			if (imageLoader.waitForImage(
				IMAGE_GROUP,
				'okErrorButton',
				shortTimeout
			)) {
				WindowsImageKeywords.clickImage(
					image('okErrorButton')
				)

				if (waitForMissingRefComptaAlertClosed(
					shortTimeout
				)) {
					KeywordUtil.logInfo(
						'[PASS] Missing REF COMPTA alert closed using the OK image.'
					)

					return
				}
			}
		} catch (Throwable okImageError) {
			KeywordUtil.logInfo(
				'[IMAGE] Could not close alert using the OK image.\n' +
					'Reason: ' +
					safeText(okImageError.message)
			)
		}

		// Attempt 2: OK button by Windows object
		WindowsTestObject okButtonObject =
			object('missingRefComptaAlertOkButton')

		if (Windows.waitForElementPresent(
			okButtonObject,
			shortTimeout,
			FailureHandling.OPTIONAL
		)) {
			try {
				Windows.click(
					okButtonObject,
					FailureHandling.OPTIONAL
				)

				if (waitForMissingRefComptaAlertClosed(
					shortTimeout
				)) {
					KeywordUtil.logInfo(
						'[PASS] Missing REF COMPTA alert closed using the OK Windows object.'
					)

					return
				}
			} catch (Throwable okObjectError) {
				KeywordUtil.logInfo(
					'[OBJECT] Could not close alert using the OK Windows object.\n' +
						'Reason: ' +
						safeText(okObjectError.message)
				)
			}
		}

		// Attempt 3: focus modal icon and press ENTER
		try {
			if (imageLoader.waitForImage(
				IMAGE_GROUP,
				'alertModalIcon',
				shortTimeout
			)) {
				WindowsImageKeywords.clickImage(
					image('alertModalIcon')
				)

				Robot robot = new Robot()

				robot.keyPress(KeyEvent.VK_ENTER)
				robot.keyRelease(KeyEvent.VK_ENTER)

				if (waitForMissingRefComptaAlertClosed(
					shortTimeout
				)) {
					KeywordUtil.logInfo(
						'[PASS] Missing REF COMPTA alert closed using modal focus and ENTER.'
					)

					return
				}
			}
		} catch (Throwable modalError) {
			KeywordUtil.logInfo(
				'[IMAGE] Could not close alert using modal icon and ENTER.\n' +
					'Reason: ' +
					safeText(modalError.message)
			)
		}

		takeEvidence(
			'Investigations_MissingRefComptaAlertNotClosed.png'
		)

		KeywordUtil.markFailedAndStop(
			'The missing REF COMPTA alert was displayed but could not be closed.'
		)
	}


	// ---------------------------------------------------------
	// waitForMissingRefComptaAlertClosed
	// Used by: closeMissingRefComptaAlert
	// ---------------------------------------------------------

	private Boolean waitForMissingRefComptaAlertClosed(
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)
		long endTime =
			System.currentTimeMillis() +
				(timeout * 1000L)

		WindowsTestObject alertObject =
			object('missingRefComptaAlert')

		while (System.currentTimeMillis() <= endTime) {
			Boolean alertImageVisible = false
			Boolean alertObjectVisible = false

			try {
				alertImageVisible =
					imageLoader.waitForImage(
						IMAGE_GROUP,
						'alertModalIcon',
						1
					)
			} catch (Throwable ignored) {
				alertImageVisible = false
			}

			try {
				alertObjectVisible =
					Windows.waitForElementPresent(
						alertObject,
						1,
						FailureHandling.OPTIONAL
					)
			} catch (Throwable ignored) {
				alertObjectVisible = false
			}

			if (!alertImageVisible &&
				!alertObjectVisible) {

				return true
			}

			Windows.delay(POLLING_DELAY_SECONDS)
		}

		return false
	}

