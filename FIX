class authentication {

    private static final String WINAPPDRIVER_URL = 'http://127.0.0.1:4723'
    private static final int WINAPPDRIVER_PORT = 4723
    private static final int APP_START_TIMEOUT_SECONDS = 120
    private static final int TITLE_WAIT_SECONDS = 60
    private static final int LOGIN_WAIT_SECONDS = 30

    private static WindowsDriver<WebElement> rootDriver
    private static WindowsDriver<WebElement> appDriver

    @Keyword
    String getCurrentWindowsUser() {
        try {
            return System.getProperty('user.name') ?: ''
        } catch (Throwable ignored) {
            return ''
        }
    }

    @Keyword
    String resolveWindowTitle() {
        String version = ''
        try {
            version = (GlobalVariable.version ?: '').toString().trim()
        } catch (Throwable ignored) {
            version = ''
        }

        if (version) {
            return "eMatch ${version}"
        }

        return 'eMatch 26.1.1.3'
    }

    @Keyword
    String getShortcutPath() {
        String user = getCurrentWindowsUser()
        String env = safeEnv()

        List<String> candidates = [
            "C:\\Users\\${user}\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\NATIXIS\\eMatch ${env}.appref-ms",
            "C:\\Users\\${user}\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\NATIXIS\\eMatch REC.appref-ms",
            "C:\\Users\\${user}\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\NATIXIS\\eMatch.appref-ms"
        ]

        return firstExisting(candidates)
    }

    @Keyword
    String getApplicationPath() {
        String env = safeEnv()

        List<String> candidates = [
            "\\\\cib.net\\shareparis\\Soft\\ematch\\HMI\\Livraisons\\${env}\\IXIS.eMatch.IHM.application",
            "\\\\cib.net\\shareparis\\Soft\\ematch\\HMI\\Livraisons\\REC\\IXIS.eMatch.IHM.application"
        ]

        return firstExisting(candidates)
    }

    @Keyword
    String getLauncherBat() {
        String env = safeEnv()

        List<String> candidates = [
            "D:\\Projects\\eMatchStarters\\runAsEmatch${env}\\eMatch.bat",
            "D:\\Projects\\eMatchStarters\\runAsEmatchREC\\eMatch.bat",
