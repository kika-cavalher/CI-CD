📌 Nome sugerido: JenkinsPipelines/Jenkinsfile_ArchiveMode.groovy

/*
 * Dedicated Jenkins pipeline for Archive Mode build.
 * Runs eMatch via Windows Scheduled Tasks (interactive desktop).
 * The test itself decides REC/PRD (login test), not Jenkins.
 */

def PIPELINE_CFG = [
  agentLabel: 'GI5_SWDCFRNXGI55817',

  projectFileName: 'eMatch POC.prj',

  winDriverTask: 'startWinDriver',

  desktopTask: '\\eMatch Automation\\RunEMatchDesktop',

  contextFile: 'D:\\Projects\\eMatchStarters\\run-context.properties',

  collectionPath: 'Test Suites/Archive Mode/Archive Mode Collection',

  pipelineTimeoutMinutes: 180,
  defaultSuiteTimeoutMinutes: 30,

  nextJobName: 'Passerelle Bilan'
]

node(PIPELINE_CFG.agentLabel) {
  timestamps {
    ansiColor('xterm') {
      timeout(time: PIPELINE_CFG.pipelineTimeoutMinutes, unit: 'MINUTES') {

        stage('Checkout') {
          checkout scm
        }

        stage('Prepare Run Context') {
          def content = [
            "WORKSPACE=${env.WORKSPACE}",
            "PROJECT_FILE=${PIPELINE_CFG.projectFileName}",
            "COLLECTION_PATH=${PIPELINE_CFG.collectionPath}"
          ].join('\r\n') + '\r\n'

          writeFile file: 'run-context.properties', text: content
          bat """
            @echo off
            copy /Y "run-context.properties" "${PIPELINE_CFG.contextFile}" >nul
          """
        }

        stage('Run - Archive Mode Collection') {
          echo "============================================================"
          echo "START ASSET: Archive Mode Collection"
          echo "TASK: ${PIPELINE_CFG.desktopTask}"
          echo "============================================================"

          bat """
            @echo off
            schtasks /run /tn "${PIPELINE_CFG.winDriverTask}"
            if errorlevel 1 exit /b 1

            schtasks /run /tn "${PIPELINE_CFG.desktopTask}"
            if errorlevel 1 exit /b 2

            :loop
            for /f "tokens=2 delims=: " %%f in ('schtasks /query /tn "${PIPELINE_CFG.desktopTask}" /fo list ^| find "Status:"') do (
                if "%%f"=="Running" (
                    ping -n 6 localhost >nul 2>nul
                    goto loop
                )
            )

            schtasks /end /tn "${PIPELINE_CFG.winDriverTask}" >nul 2>nul
            exit /b 0
          """
        }

        stage('Collect Reports') {
          catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
            junit testResults: 'Reports/**/JUnit_Report.xml', allowEmptyResults: true
          }

          catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
            archiveArtifacts artifacts: 'Reports/**/*', allowEmptyArchive: true
          }

          def exitFile = "${env.WORKSPACE}\\Reports\\_jenkins_task_exitcode.txt"
          if (fileExists(exitFile)) {
            def rc = readFile(exitFile).trim()
            echo "Desktop task exit code: ${rc}"
          } else {
            echo "Desktop task exit code file not found: ${exitFile}"
          }
        }

        stage('Trigger Next Job') {
          if (PIPELINE_CFG.nextJobName?.trim()) {
            echo "Triggering next Jenkins job: ${PIPELINE_CFG.nextJobName}"
            build job: PIPELINE_CFG.nextJobName, wait: false
          } else {
            echo "Next job is empty. Skipping."
          }
        }
      }
    }
  }
}
