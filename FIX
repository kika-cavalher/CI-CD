pipeline {
  agent { label 'GI5_SWDCFRNXGI55817' }

  parameters {
    booleanParam(name: 'SHOW_BROWSER', defaultValue: true, description: 'Show Chrome UI during execution')
  }

  stages {

    stage('Start Gaia Backend and Frontend') {
      steps {
        // Start backend/frontend via Windows Scheduled Task
        bat 'schtasks /run /tn "GaiaBackFrontSetup"'
        // Give services time to boot
        sleep(time: 300, unit: 'SECONDS')
      }
    }

    stage('Get bitbucket source code') {
      steps {
        // Clean workspace (best effort; do not fail build if something is locked)
        cleanWs(deleteDirs: true, disableDeferredWipeout: true, notFailBuild: true)
        // Checkout source code
        git credentialsId: '965eceec-b3a3-4ec5-8820-a857c87dd80f',
            url: 'https://bitbucket-mut.mycloud.intrabpce.fr/scm/gi5/gaia-portal.git'
      }
    }

    stage('GAIA TSC') {
      steps {
        script {
          // Fixed config (NOT parameters): suite collection is hardcoded here
          def KATALON_HOME = 'C:/Users/adgi5appjenkins/Documents/Katalon_Studio_Engine_Windows_64-8.1.0'

          if (params.SHOW_BROWSER) {
            // Visible mode: run via Scheduled Task so Chrome UI is visible
            bat 'schtasks /query /tn "GaiaKatalon_Visible"'
            bat 'schtasks /run /tn "GaiaKatalon_Visible"'
          } else {
            // Headless mode: run inside Jenkins and capture exit code
            catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
              executeKatalon(
                executeArgs: '-projectPath="D:/jenkins/work/workspace/GI5/Gaia/Gaia" -browserType="Chrome (headless)" -testSuiteCollectionPath="Test Suites/GAIA TSC" -consoleLog -logLevel=DEBUG',
                location: KATALON_HOME,
                version: '',
                x11Display: '',
                xvfbConfiguration: ''
              )
            }
          }
        }
      }
    }
  }
}
