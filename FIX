Este BAT lê run-context.properties gerado pelo Jenkins, executa Katalon, e sempre escreve o marker de exitcode.

@echo off
setlocal EnableExtensions EnableDelayedExpansion

REM =============================
REM  CONFIG
REM =============================
set "CTX_FILE=D:\Projects\eMatchStarters\run-context.properties"

REM =============================
REM  VALIDATE CONTEXT
REM =============================
if not exist "%CTX_FILE%" (
  echo [ERROR] Context file not found: "%CTX_FILE%"
  exit /b 90
)

call :ReadCtx "WORKSPACE" WORKSPACE
call :ReadCtx "PROJECT_PATH" PROJECT_PATH
call :ReadCtx "KATALON_EXE" KATALON_EXE
call :ReadCtx "COLLECTION_PATH" COLLECTION_PATH
call :ReadCtx "BROWSER_TYPE" BROWSER_TYPE
call :ReadCtx "MARKER_FILE" MARKER_FILE

if "%WORKSPACE%"=="" (
  echo [ERROR] WORKSPACE is empty in run-context.properties
  exit /b 91
)

if "%PROJECT_PATH%"=="" (
  echo [ERROR] PROJECT_PATH is empty in run-context.properties
  exit /b 92
)

if "%KATALON_EXE%"=="" (
  echo [ERROR] KATALON_EXE is empty in run-context.properties
  exit /b 93
)

if "%COLLECTION_PATH%"=="" (
  echo [ERROR] COLLECTION_PATH is empty in run-context.properties
  exit /b 94
)

if "%MARKER_FILE%"=="" (
  echo [ERROR] MARKER_FILE is empty in run-context.properties
  exit /b 95
)

REM Guarantee marker folder exists
for %%F in ("%MARKER_FILE%") do (
  if not exist "%%~dpF" mkdir "%%~dpF" >nul 2>&1
)

echo [INFO] WORKSPACE      = "%WORKSPACE%"
echo [INFO] PROJECT_PATH   = "%PROJECT_PATH%"
echo [INFO] KATALON_EXE    = "%KATALON_EXE%"
echo [INFO] COLLECTION     = "%COLLECTION_PATH%"
echo [INFO] BROWSER_TYPE   = "%BROWSER_TYPE%"
echo [INFO] MARKER_FILE    = "%MARKER_FILE%"

REM =============================
REM  RUN KATALON
REM =============================
set "LOG_DIR=%WORKSPACE%\Reports\_desktop_logs"
if not exist "%LOG_DIR%" mkdir "%LOG_DIR%" >nul 2>&1

set "TS=%DATE:~6,4%%DATE:~3,2%%DATE:~0,2%_%TIME:~0,2%%TIME:~3,2%%TIME:~6,2%"
set "TS=%TS: =0%"
set "KLOG=%LOG_DIR%\katalon_%TS%.log"

echo [INFO] Logging to: "%KLOG%"

REM Keep window open if launched manually
title eMatch - Katalon Runner

"%KATALON_EXE%" ^
  -runMode=console ^
  -projectPath="%PROJECT_PATH%" ^
  -testSuiteCollectionPath="%COLLECTION_PATH%" ^
  -executionProfile="default" ^
  -browserType="%BROWSER_TYPE%" ^
  -retry=0 ^
  -retryFailedTestCases=false ^
  -consoleLog ^
  > "%KLOG%" 2>&1

set "EXITCODE=%ERRORLEVEL%"

echo [INFO] Katalon finished with exit code: %EXITCODE%

REM =============================
REM  WRITE MARKER
REM  Format:
REM    line1 = exitCode
REM    line2 = logFile
REM =============================
(
  echo %EXITCODE%
  echo %KLOG%
) > "%MARKER_FILE%"

echo [INFO] Marker written: "%MARKER_FILE%"

exit /b %EXITCODE%


REM =============================
REM  FUNCTIONS
REM =============================
:ReadCtx
set "KEY=%~1"
set "OUTVAR=%~2"
set "VAL="

for /f "usebackq tokens=1,* delims==" %%A in ("%CTX_FILE%") do (
  if /i "%%A"=="%KEY%" (
    set "VAL=%%B"
  )
)

REM trim
for /f "tokens=* delims= " %%Z in ("%VAL%") do set "VAL=%%Z"

set "%OUTVAR%=%VAL%"
exit /b 0
