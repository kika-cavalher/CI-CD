<script>
function showTab(tabName) {
    var tabTests = document.getElementById('tab-tests');
    var tabCharts = document.getElementById('tab-charts');
    var testsSidebar = document.getElementById('tests-sidebar-block');
    var chartsSidebar = document.getElementById('charts-sidebar-block');
    var chartsPanel = document.getElementById('charts-panel');
    var scenarioPanels = document.querySelectorAll('.scenario-panel');

    if (tabName === 'charts') {
        tabTests.classList.remove('active');
        tabCharts.classList.add('active');
        testsSidebar.classList.add('hidden');
        chartsSidebar.classList.remove('hidden');
        chartsPanel.classList.remove('hidden');
        scenarioPanels.forEach(function(panel) {
            panel.classList.add('hidden');
        });
    } else {
        tabCharts.classList.remove('active');
        tabTests.classList.add('active');
        chartsSidebar.classList.add('hidden');
        testsSidebar.classList.remove('hidden');
        chartsPanel.classList.add('hidden');
        scenarioPanels.forEach(function(panel) {
            panel.classList.remove('hidden');
        });
    }
}

function showScenario(id) {
    var buttons = document.querySelectorAll('.scenario-list-item');
    var panels = document.querySelectorAll('.scenario-panel');

    buttons.forEach(function(btn) {
        if (btn.getAttribute('data-sid') === id) {
            btn.classList.add('selected');
        } else {
            btn.classList.remove('selected');
        }
    });

    panels.forEach(function(panel) {
        if (panel.id === 'panel-' + id) {
            panel.classList.add('active');
        } else {
            panel.classList.remove('active');
        }
    });

    showTab('tests');
}

function filterScenarios() {
    var input = document.getElementById('scenarioSearch');
    var filter = input.value.toLowerCase();
    var items = document.querySelectorAll('.scenario-list-item');

    items.forEach(function(item) {
        var text = item.textContent.toLowerCase();
        if (text.indexOf(filter) > -1) {
            item.style.display = '';
        } else {
            item.style.display = 'none';
        }
    });
}
</script>
