    private String buildStepsTable(Map caseRow) {
        List<Map> steps = caseRow.steps instanceof List ? caseRow.steps : []
        StringBuilder html = new StringBuilder()

        html.append('<table class="steps-table">')
        html.append('<thead>')
        html.append('<tr>')
        html.append('<th>Status</th>')
        html.append('<th>Timestamp</th>')
        html.append('<th>Details</th>')
        html.append('</tr>')
        html.append('</thead>')
        html.append('<tbody>')

        if (steps.isEmpty()) {
            html.append('<tr><td colspan="3" class="empty-row">No step details were found for this test.</td></tr>')
        } else {
            steps.eachWithIndex { Map step, int index ->
                String status = safeValue(step.status)
                String detail = safeValue(step.details)
                String fullText = safeValue(step.fullText)

                html.append('<tr>')
                html.append('<td>')
                html.append('<span class="status-pill ')
                html.append(statusClass(status))
                html.append('">')
                html.append(htmlEscape(statusLabel(status)))
                html.append('</span>')
                html.append('</td>')

                html.append('<td class="timestamp-cell">')
                html.append(htmlEscape(safeValue(step.timestamp)))
                html.append('</td>')

                html.append('<td>')
                html.append('<div class="step-line" title="')
                html.append(htmlEscape(detail))
                html.append('">')
                html.append(htmlEscape(oneLine(detail, 180)))
                html.append('</div>')
                html.append('</td>')
                html.append('</tr>')

                if (!isBlank(fullText) && oneLine(fullText, 180) != oneLine(detail, 180)) {
                    html.append('<tr class="expand-row">')
                    html.append('<td colspan="3">')
                    html.append('<details class="details-block step-expand">')
                    html.append('<summary>🔎 View full log</summary>')
                    html.append('<pre>')
                    html.append(htmlEscape(fullText))
                    html.append('</pre>')
                    html.append('</details>')
                    html.append('</td>')
                    html.append('</tr>')
                }
            }
        }

        html.append('</tbody>')
        html.append('</table>')
        return html.toString()
    }

    private String buildEvidenceBlock(Map caseRow) {
        List evidences = caseRow.evidences instanceof List ? caseRow.evidences : []
        StringBuilder html = new StringBuilder()

        if (evidences.isEmpty()) {
            html.append('<div class="empty-row">No evidence image found for this test.</div>')
            return html.toString()
        }

        html.append('<div class="evidence-list">')
        evidences.eachWithIndex { Map item, int index ->
            html.append('<details class="evidence-item">')
            html.append('<summary>📎 Evidence ')
            html.append(index + 1)
            html.append(' • ')
            html.append(htmlEscape(safeValue(item.name)))
            html.append('</summary>')
            html.append('<div class="evidence-body">')
            html.append('<img src="')
            html.append(htmlEscape(safeValue(item.dataUri)))
            html.append('" alt="Evidence image">')
            html.append('</div>')
            html.append('</details>')
        }
        html.append('</div>')
        return html.toString()
    }

    private String buildChartsPanel(Map model) {
        List<Map> cases = model.cases instanceof List ? model.cases : []
        StringBuilder html = new StringBuilder()

        html.append('<div class="charts-grid">')

        html.append('<div class="panel-card">')
        html.append('<div class="panel-title">Execution Summary</div>')
        html.append(buildDonutBlock(model))
        html.append(buildSideCounters(model))
        html.append('</div>')

        html.append('<div class="panel-card">')
        html.append('<div class="panel-title">Scenario Duration & Status</div>')
        html.append('<div class="bar-list">')

        long maxDuration = 1L
        cases.each { Map item ->
            long current = toLong(item.durationMs)
            if (current > maxDuration) {
                maxDuration = current
            }
        }

        cases.each { Map item ->
            int width = (int) Math.max(8, Math.round((toLong(item.durationMs) * 100D) / maxDuration))

            html.append('<div class="bar-row">')
            html.append('<div class="bar-title" title="')
            html.append(htmlEscape(safeValue(item.name)))
            html.append('">')
            html.append(htmlEscape(oneLine(item.name, 72)))
            html.append('</div>')

            html.append('<div class="bar-track">')
            html.append('<div class="bar-fill ')
            html.append(statusClass(item.status))
            html.append('" style="width:')
            html.append(width)
            html.append('%;"></div>')
            html.append('</div>')

            html.append('<div class="bar-value">')
            html.append(htmlEscape(safeValue(item.durationText)))
            html.append('</div>')
            html.append('</div>')
        }

        html.append('</div>')
        html.append('</div>')

        html.append('</div>')
        return html.toString()
    }

    private String buildDonutBlock(Map model) {
        int total = toInt(model.total)
        int passed = toInt(model.passed)
        int failed = toInt(model.failed)
        int skipped = toInt(model.skipped)

        double passedPct = total > 0 ? (passed * 100D / total) : 0D
        double failedPct = total > 0 ? (failed * 100D / total) : 0D
        double skippedPct = total > 0 ? (skipped * 100D / total) : 0D

        double passedEnd = passedPct
        double failedEnd = passedPct + failedPct
        double skippedEnd = passedPct + failedPct + skippedPct

        StringBuilder html = new StringBuilder()
        html.append('<div class="donut-wrap">')
        html.append('<div class="donut-chart" style="background: conic-gradient(')
        html.append(STATUS_PASS).append(' 0% ').append(formatPct(passedEnd)).append('%, ')
        html.append(STATUS_FAIL).append(' ').append(formatPct(passedEnd)).append('% ').append(formatPct(failedEnd)).append('%, ')
        html.append(STATUS_SKIP).append(' ').append(formatPct(failedEnd)).append('% ').append(formatPct(skippedEnd)).append('%, ')
        html.append('#e5e7eb ').append(formatPct(skippedEnd)).append('% 100%);">')
        html.append('<div class="donut-center">')
        html.append('<div class="donut-total">').append(total).append('</div>')
        html.append('<div class="donut-label">tests</div>')
        html.append('</div>')
        html.append('</div>')
        html.append('</div>')
        return html.toString()
    }

    private String buildSideCounters(Map model) {
        StringBuilder html = new StringBuilder()
        html.append('<div class="side-counts">')
        html.append(counterRow('Passed', toInt(model.passed), 'pass'))
        html.append(counterRow('Failed', toInt(model.failed), 'fail'))
        html.append(counterRow('Skipped', toInt(model.skipped), 'skip'))
        html.append('</div>')
        return html.toString()
    }

    private String counterRow(String label, int value, String status) {
