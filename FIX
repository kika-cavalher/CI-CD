properties([
    disableConcurrentBuilds(),
    buildDiscarder(logRotator(numToKeepStr: '15'))
])

// ============================================================================
// CONFIG - CHANGE ONLY THIS BLOCK
// ============================================================================

def NODE_LABEL = 'GI5_SWDCFRNXGI55817'
def SHORT_WORKSPACE = 'D:\\jenkins\\ws\\ARCH_MD'

def RUN_NEXT_JOB = true
def NEXT_JOB = 'GI5/eMatch_Regression/BDR Module des Responsabilite'

def COLLECTION_TIMEOUT_HOURS = 5

def COLLECTIONS = [
    [stage: 'Archive Mode Collection', cmd: 'ArchiveMode.cmd']
]

// ============================================================================
// FIXED LOGIC - DO NOT CHANGE BELOW
// ============================================================================

def executionFailed = false
def manuallyAborted = false

def asErrorText = { Throwable err ->
    def parts = []
    def current = err
    while (current != null) {
        parts << "${current.getClass().getName()}: ${current.getMessage() ?: ''}"
        current = current.getCause()
    }
    return parts.join(' | ').toLowerCase()
}

def isTimeoutError = { Throwable err ->
    def text = asErrorText(err)
    return text.contains('timeout') ||
           text.contains('exceededtimeout') ||
           text.contains('org.jenkinsci.plugins.workflow.steps.timeout')
}

def isManualAbortError = { Throwable err ->
    def text = asErrorText(err)
    return text.contains('flowinterruptedexception') ||
           text.contains('aborted by') ||
           text.contains('interrupted')
}

def stopCurrentExecution = {
    bat '''
@echo off
schtasks /end /tn "\\eMatch Automation\\RunEMatchCommand" >nul 2>&1
schtasks /end /tn "startWinDriver" >nul 2>&1
taskkill /f /im WinAppDriver.exe /t >nul 2>&1
taskkill /f /im katalonc.exe /t >nul 2>&1
taskkill /f /im KatalonStudio.exe /t >nul 2>&1
ping -n 4 127.0.0.1 >nul
exit /b 0
'''
}

def runCollection = { Map item ->
    stage(item.stage) {
        try {
            timeout(time: COLLECTION_TIMEOUT_HOURS, unit: 'HOURS') {
                bat "call \"${env.WORKSPACE}\\jenkins\\${item.cmd}\""
            }
            echo "${item.stage} completed successfully."
        } catch (Throwable err) {
            executionFailed = true

            if (isManualAbortError(err)) {
                manuallyAborted = true
                currentBuild.result = 'ABORTED'
                echo "${item.stage} was manually aborted."
            } else if (isTimeoutError(err)) {
                currentBuild.result = 'FAILURE'
                echo "${item.stage} exceeded the ${COLLECTION_TIMEOUT_HOURS} hour limit and was stopped."
            } else {
                currentBuild.result = 'FAILURE'
                echo "${item.stage} failed: ${err}"
            }
        } finally {
            stage("Stop ${item.stage}") {
                stopCurrentExecution()
            }
        }
    }
}

node(NODE_LABEL) {
    ws(SHORT_WORKSPACE) {
        try {
            stage('Checkout') {
                deleteDir()
                checkout scm
            }

            COLLECTIONS.each { item ->
                runCollection(item)
            }

        } catch (Throwable err) {
            executionFailed = true

            if (isManualAbortError(err)) {
                manuallyAborted = true
                currentBuild.result = 'ABORTED'
                echo "Pipeline interrupted manually: ${err}"
            } else {
                currentBuild.result = 'FAILURE'
                echo "Unexpected pipeline error: ${err}"
            }

        } finally {
            stage('Trigger next pipeline') {
                if (RUN_NEXT_JOB && NEXT_JOB?.trim()) {
                    echo "Scheduling next pipeline regardless of current result: ${NEXT_JOB}"
                    build job: NEXT_JOB, wait: false, propagate: false
                } else {
                    echo 'Next pipeline disabled.'
                }
            }
        }
    }
}

if (!currentBuild.result) {
    currentBuild.result = executionFailed ? 'FAILURE' : 'SUCCESS'
}

return
