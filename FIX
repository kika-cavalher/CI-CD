package jiraIntegration

import java.nio.file.Files
import java.text.SimpleDateFormat
import java.util.Base64

import groovy.json.JsonOutput

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil

class JiraHtmlReportBuilder {

    @Keyword
    String buildReport() {
        try {
            File reportFolder = resolveReportFolder()
            List<Map> cases = JiraReportSteps.snapshotCases()

            if (!cases || cases.isEmpty()) {
                KeywordUtil.logInfo('[JIRA_REPORT] No cases found to build report.')
                return ''
            }

            List<Map> normalizedCases = sortCases(cases).collect { Map tc ->
                return buildCasePayload(tc, reportFolder)
            }

            Map payload = [
                suiteName  : resolveSuiteName(reportFolder),
                generatedAt: new SimpleDateFormat('dd/MM/yyyy HH:mm:ss').format(new Date()),
                logoDataUri: resolveLogoDataUri(),
                cases      : normalizedCases
            ]

            String json = JsonOutput.toJson(payload).replace('</', '<\\/')

            String html = buildHtml(json)

            File htmlFile = new File(reportFolder, 'ematchReport.html')
            htmlFile.setText(html, 'UTF-8')

            File indexFile = new File(reportFolder, 'index.html')
            indexFile.setText(html, 'UTF-8')

            KeywordUtil.logInfo('[JIRA_REPORT] HTML generated at: ' + htmlFile.getAbsolutePath())
            return htmlFile.getAbsolutePath()
        } catch (Throwable t) {
            KeywordUtil.logInfo('[JIRA_REPORT] buildReport failed: ' + safe(t.getMessage()))
            return ''
        }
    }

    private static List<Map> sortCases(List<Map> cases) {
        List<Map> copy = cases.collect { it }

        copy.sort { Map a, Map b ->
            int priorityA = statusPriority(safe(a.status))
            int priorityB = statusPriority(safe(b.status))

            if (priorityA != priorityB) {
                return priorityA <=> priorityB
            }

            return safe(a.displayName).compareToIgnoreCase(safe(b.displayName))
        }

        return copy
    }

    private static int statusPriority(String status) {
        String value = safe(status).toUpperCase(Locale.ENGLISH)
        if ('FAILED'.equals(value)) {
            return 0
        }
        if ('BLOCKED'.equals(value)) {
            return 1
        }
        return 2
    }

    private static Map buildCasePayload(Map caseData, File reportFolder) {
        List<Map> evidence = (caseData.evidence ?: []).collect { Map ev ->
            return buildEvidencePayload(ev, reportFolder)
        }.findAll { it != null }

        List<Map> steps = (caseData.steps ?: []).collect { Map step ->
            String finalStatus = normalizeStepStatus(step.status)
            return [
                status   : finalStatus,
                timestamp: safe(step.timestamp),
                details  : safe(step.details)
            ]
        }

        return [
            caseId      : safe(caseData.caseId),
            displayName : safe(caseData.displayName),
            status      : normalizeCaseStatus(caseData.status),
            startText   : safe(caseData.startText),
            endText     : safe(caseData.endText),
            durationText: safe(caseData.durationText),
            steps       : steps,
            shortError  : safe(caseData.shortError),
            fullError   : safe(caseData.fullError),
            evidence    : evidence
        ]
    }

    private static Map buildEvidencePayload(Map evidenceData, File reportFolder) {
        String name = safe(evidenceData.name)
        String absolutePath = safe(evidenceData.absolutePath)
        String relativePath = safe(evidenceData.relativePath)

        File sourceFile = null

        if (!absolutePath.isEmpty()) {
            File absoluteFile = new File(absolutePath)
            if (absoluteFile.exists()) {
                sourceFile = absoluteFile
            }
        }

        if (sourceFile == null && !relativePath.isEmpty()) {
            File relativeFile = new File(reportFolder, relativePath)
            if (relativeFile.exists()) {
                sourceFile = relativeFile
            }
        }

        String dataUri = ''
        if (sourceFile != null && sourceFile.exists() && sourceFile.isFile()) {
            dataUri = fileToDataUri(sourceFile)
        }

        return [
            name    : name,
            openPath: dataUri,
            preview : dataUri
        ]
    }

    private static String normalizeStepStatus(Object rawStatus) {
        String value = safe(rawStatus).toUpperCase(Locale.ENGLISH)
        if (value in ['FAILED', 'FAIL']) {
            return 'FAILED'
        }
        if (value in ['BLOCKED', 'SKIPPED']) {
            return 'BLOCKED'
        }
        return 'PASSED'
    }

    private static String normalizeCaseStatus(Object rawStatus) {
        String value = safe(rawStatus).toUpperCase(Locale.ENGLISH)
        if (value in ['FAILED', 'FAIL', 'ERROR']) {
            return 'FAILED'
        }
        if (value in ['BLOCKED', 'SKIPPED']) {
            return 'BLOCKED'
        }
        return 'PASSED'
    }

    private static String resolveSuiteName(File reportFolder) {
        String suiteName = JiraReportSteps.suiteNameStatic()
        if (!suiteName.isEmpty()) {
            return suiteName
        }

        File parent = reportFolder != null ? reportFolder.getParentFile() : null
        return parent != null ? parent.getName() : 'Execution Report'
    }

    private static String resolveLogoDataUri() {
        try {
            File projectDir = new File(RunConfiguration.getProjectDir())

            List<File> candidates = [
                new File(projectDir, 'Images/logo.png'),
                new File(projectDir, 'Images/logo.jpg'),
                new File(projectDir, 'Images/logo.jpeg'),
                new File(projectDir, 'Images/gaia-logo.png'),
                new File(projectDir, 'Images/eMatch-logo.png'),
                new File(projectDir, 'Include/resources/logo.png')
            ]

            File logoFile = candidates.find { File it -> it.exists() && it.isFile() }
            if (logoFile == null) {
                return ''
            }

            return fileToDataUri(logoFile)
        } catch (Throwable ignored) {
            return ''
        }
    }

    private static String fileToDataUri(File file) {
        try {
            byte[] bytes = Files.readAllBytes(file.toPath())
            String base64 = Base64.encoder.encodeToString(bytes)
            String extension = extensionOf(file.getName()).toLowerCase(Locale.ENGLISH)

            String mimeType = 'image/png'
            if (extension == 'jpg' || extension == 'jpeg') {
                mimeType = 'image/jpeg'
            } else if (extension == 'gif') {
                mimeType = 'image/gif'
            } else if (extension == 'bmp') {
                mimeType = 'image/bmp'
            }

            return 'data:' + mimeType + ';base64,' + base64
        } catch (Throwable ignored) {
            return ''
        }
    }

    private static String extensionOf(String fileName) {
        String name = safe(fileName)
        int idx = name.lastIndexOf('.')
        return idx >= 0 ? name.substring(idx + 1) : ''
    }

    private static File resolveReportFolder() {
        String fromRunConfiguration = safe(RunConfiguration.getReportFolder())
        if (!fromRunConfiguration.isEmpty()) {
            File direct = new File(fromRunConfiguration)
            ensureFolder(direct)
            return direct
        }

        File reportsRoot = new File(RunConfiguration.getProjectDir(), 'Reports')
        ensureFolder(reportsRoot)

        File latestLeaf = findLatestLeafFolder(reportsRoot)
        if (latestLeaf != null) {
            return latestLeaf
        }

        File fallback = new File(reportsRoot, new SimpleDateFormat('yyyyMMdd_HHmmss').format(new Date()))
        ensureFolder(fallback)
        return fallback
    }

    private static File findLatestLeafFolder(File root) {
        List<File> folders = []
        root.eachFileRecurse { File file ->
            if (file.isDirectory()) {
                folders << file
            }
        }

        folders = folders.findAll { File folder ->
            File[] children = folder.listFiles()
            return children != null && children.any { File child -> child.isFile() }
        }

        if (folders.isEmpty()) {
            return null
        }

        folders.sort { File a, File b -> Long.valueOf(b.lastModified()).compareTo(Long.valueOf(a.lastModified())) }
        return folders[0]
    }

    private static void ensureFolder(File folder) {
        if (folder != null && !folder.exists()) {
            folder.mkdirs()
        }
    }

    private static String buildHtml(String json) {
        return """<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Test report</title>
<style>
    * { box-sizing: border-box; }
    body {
        margin: 0;
        font-family: Arial, Helvetica, sans-serif;
        background: #f5f6fb;
        color: #222;
    }
    .topbar {
        background: linear-gradient(90deg, #4026b6, #5a2fd6);
        color: #fff;
        padding: 18px 22px;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .topbar img {
        width: 34px;
        height: 34px;
        object-fit: contain;
        background: #fff;
        border-radius: 8px;
        padding: 4px;
    }
    .topbar-title {
        display: flex;
