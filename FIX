class RecPrdExportValidationKeywords {

	// ======================================================
	// PUBLIC VALIDATION
	// ======================================================

	@Keyword
	Map validateLatestRecPrdExport(
			String exportRootFolder,
			String exportGroupFolder,
			String exportFeatureFolder,
			Integer columnIndex,
			String expectedColumnName) {

		Map result = createEmptyResult(
				exportRootFolder,
				exportGroupFolder,
				exportFeatureFolder,
				columnIndex,
				expectedColumnName
		)

		StringBuilder errors = new StringBuilder()
		StringBuilder passedDetails = new StringBuilder()

		try {
			File exportRoot = new File(safeText(exportRootFolder))
			int validatedColumnIndex = columnIndex == null ? -1 : columnIndex.intValue()

			if (!exportRoot.exists() || !exportRoot.isDirectory()) {
				errors.append('[ERROR] Export root folder does not exist or is not a folder.\n')
						.append('Folder: ')
						.append(exportRoot.getAbsolutePath())

				return finalizeResult(result, errors, passedDetails)
			}

			if (validatedColumnIndex < 0) {
				errors.append('[ERROR] Invalid column index.\n')
						.append('Column index: ')
						.append(validatedColumnIndex)

				return finalizeResult(result, errors, passedDetails)
			}

			Map selectedFiles = resolveLatestRecPrdFiles(
					exportRoot,
					exportGroupFolder,
					exportFeatureFolder
			)

			File recFile = selectedFiles.recFile as File
			File prdFile = selectedFiles.prdFile as File
			File selectedFolder = selectedFiles.selectedFolder as File

			result.recFileName = recFile == null ? 'NOT FOUND' : recFile.getName()
			result.prdFileName = prdFile == null ? 'NOT FOUND' : prdFile.getName()
			result.selectedFolderPath = selectedFolder == null ? '' : selectedFolder.getAbsolutePath()

			if (recFile == null || prdFile == null) {
				errors.append('[ERROR] REC and PRD exported files were not found.\n')
						.append('Search root: ')
						.append(exportRoot.getAbsolutePath())
						.append('\nExpected folder: ')
						.append(safeText(exportGroupFolder))
						.append('\\')
						.append(safeText(exportFeatureFolder))
						.append('\nREC file: ')
						.append(result.recFileName)
						.append('\nPRD file: ')
						.append(result.prdFileName)

				return finalizeResult(result, errors, passedDetails)
			}

			KeywordUtil.logInfo(
					'[REC X PRD] Folder=' + selectedFolder.getAbsolutePath() +
					' | REC=' + recFile.getName() +
					' | PRD=' + prdFile.getName()
			)

			Map recData = readFileStatistics(
					recFile,
					validatedColumnIndex,
					expectedColumnName,
					'REC'
			)

			Map prdData = readFileStatistics(
					prdFile,
					validatedColumnIndex,
					expectedColumnName,
					'PRD'
			)

			copyStatisticsToResult(
					result,
					recData,
					prdData,
					expectedColumnName
			)

			appendFileErrors(errors, recData)
			appendFileErrors(errors, prdData)

			if (errors.length() > 0) {
				return finalizeResult(result, errors, passedDetails)
			}

			if (!normalizeText(result.recColumnName).equals(
					normalizeText(result.prdColumnName))) {

				errors.append('[ERROR] REC and PRD column headers are different.\n')
						.append('REC: ')
						.append(result.recColumnName)
						.append('\nPRD: ')
						.append(result.prdColumnName)
						.append('\n')
			}

			if ((result.recRows as int) != (result.prdRows as int)) {
				errors.append('[ERROR] Number of rows is different.\n')
						.append('REC: ')
						.append(result.recRows)
						.append('\nPRD: ')
						.append(result.prdRows)
						.append('\n')
			} else {
				passedDetails.append('[PASS] Number of rows is equal.\n')
						.append('REC: ')
						.append(result.recRows)
						.append('\nPRD: ')
						.append(result.prdRows)
						.append('\n')
			}

			appendComparison(
					errors,
					passedDetails,
					'Column sum',
					result.columnName,
					result.recSum as BigDecimal,
					result.prdSum as BigDecimal
			)

			appendComparison(
					errors,
					passedDetails,
					'Minimum value',
					result.columnName,
					result.recMinimum as BigDecimal,
					result.prdMinimum as BigDecimal
			)

			appendComparison(
					errors,
					passedDetails,
					'Maximum value',
					result.columnName,
					result.recMaximum as BigDecimal,
					result.prdMaximum as BigDecimal
			)

		} catch (OutOfMemoryError error) {
			errors.append('[ERROR] Not enough memory to validate the exported files.\n')
					.append('Message: ')
					.append(safeText(error.getMessage()))
		} catch (Exception exception) {
			errors.append('[ERROR] REC x PRD export validation failed.\n')
					.append('Exception: ')
					.append(exception.getClass().getSimpleName())
					.append('\nMessage: ')
					.append(safeText(exception.getMessage()))
		}

		return finalizeResult(result, errors, passedDetails)
	}


	// ======================================================
	// FILE READING
	// ======================================================

	private Map readFileStatistics(
			File file,
			int columnIndex,
			String expectedColumnName,
			String environment) {

		String lowerName = file.getName().toLowerCase()

		if (lowerName.endsWith('.xlsx') || lowerName.endsWith('.xlsm')) {
			return readXlsxStreaming(
					file,
					columnIndex,
					expectedColumnName,
					environment
			)
		}

		return readLegacyWorkbook(
				file,
				columnIndex,
				expectedColumnName,
				environment
		)
	}


	private Map readXlsxStreaming(
			File file,
			int columnIndex,
			String expectedColumnName,
			String environment) {

		Map result = createEmptyStatistics()
		OPCPackage opcPackage = null
		InputStream sheetInput = null

		try {
			opcPackage = OPCPackage.open(file)

			XSSFReader reader = new XSSFReader(opcPackage)
			StylesTable styles = reader.getStylesTable()
			ReadOnlySharedStringsTable sharedStrings =
					new ReadOnlySharedStringsTable(opcPackage)

			Iterator<InputStream> sheets = reader.getSheetsData()

			if (!sheets.hasNext()) {
				result.errors =
						'[ERROR] ' + environment +
						' workbook does not contain worksheets.\n' +
						'File: ' + file.getName()

				return result
			}

			sheetInput = sheets.next()

			StreamingStatisticsHandler statisticsHandler =
					new StreamingStatisticsHandler(columnIndex)

			XSSFSheetXMLHandler sheetHandler =
					new XSSFSheetXMLHandler(
							styles,
							null,
							sharedStrings,
							statisticsHandler,
							new DataFormatter(),
							false
					)

			SAXParserFactory parserFactory = SAXParserFactory.newInstance()
			parserFactory.setNamespaceAware(true)

			XMLReader parser =
					parserFactory
					.newSAXParser()
					.getXMLReader()

			parser.setContentHandler(sheetHandler)
			parser.parse(new InputSource(sheetInput))

			result.columnName = statisticsHandler.columnName
			result.rows = statisticsHandler.rows
			result.numericValues = statisticsHandler.numericValues
			result.sum = statisticsHandler.numericValues > 0
					? round2(statisticsHandler.sum)
					: null
			result.minimum = statisticsHandler.numericValues > 0
					? round2(statisticsHandler.minimum)
					: null
			result.maximum = statisticsHandler.numericValues > 0
					? round2(statisticsHandler.maximum)
					: null

			validateStatistics(
					result,
					expectedColumnName,
					columnIndex,
					environment
			)

			KeywordUtil.logInfo(
					'[STREAMING EXCEL] Environment=' + environment +
					' | File=' + file.getName() +
					' | Rows=' + result.rows +
					' | Numeric values=' + result.numericValues
			)

			return result

		} finally {
			try {
				if (sheetInput != null) {
					sheetInput.close()
				}
			} catch (Exception ignored) {
			}

			try {
				if (opcPackage != null) {
					opcPackage.close()
				}
			} catch (Exception ignored) {
			}
		}
	}


	private Map readLegacyWorkbook(
			File file,
			int columnIndex,
			String expectedColumnName,
			String environment) {

		Map result = createEmptyStatistics()

		FileInputStream input = null
		Workbook workbook = null

		try {
			input = new FileInputStream(file)
			workbook = WorkbookFactory.create(input)

			if (workbook.getNumberOfSheets() == 0) {
				result.errors =
						'[ERROR] ' + environment +
						' workbook does not contain worksheets.\n' +
						'File: ' + file.getName()

				return result
			}

			Sheet sheet = workbook.getSheetAt(0)
			DataFormatter formatter = new DataFormatter()

			result.columnName = readHeaderName(
					sheet,
					columnIndex,
					formatter
			)

			BigDecimal sum = BigDecimal.ZERO
			BigDecimal minimum = null
			BigDecimal maximum = null
			int rows = 0
			int numericValues = 0

			for (int rowIndex = 1;
					rowIndex <= sheet.getLastRowNum();
					rowIndex++) {

				Row row = sheet.getRow(rowIndex)

				if (row == null || isRowEmpty(row, formatter)) {
					continue
				}

				rows++

				BigDecimal value = getCellNumber(
						row,
						columnIndex,
						formatter
				)

				if (value == null) {
					continue
				}

				sum = sum.add(value)

				if (minimum == null || value.compareTo(minimum) < 0) {
					minimum = value
				}

				if (maximum == null || value.compareTo(maximum) > 0) {
					maximum = value
				}

				numericValues++
			}

			result.rows = rows
			result.numericValues = numericValues
			result.sum = numericValues > 0 ? round2(sum) : null
			result.minimum = numericValues > 0 ? round2(minimum) : null
			result.maximum = numericValues > 0 ? round2(maximum) : null

			validateStatistics(
					result,
					expectedColumnName,
					columnIndex,
					environment
			)

			return result

		} finally {
			try {
				if (workbook != null) {
					workbook.close()
				}
			} catch (Exception ignored) {
			}

			try {
				if (input != null) {
					input.close()
				}
			} catch (Exception ignored) {
			}
		}
	}


	private void validateStatistics(
			Map result,
			String expectedColumnName,
			int columnIndex,
			String environment) {

		StringBuilder errors = new StringBuilder()
		String columnName = safeText(result.columnName)

		if (columnName.isEmpty()) {
			errors.append('[ERROR] ')
					.append(environment)
					.append(' column header was not found.\n')
					.append('Column index: ')
					.append(columnIndex)
					.append('\n')
		} else if (!normalizeText(columnName).equals(
				normalizeText(expectedColumnName))) {

			errors.append('[ERROR] Unexpected ')
					.append(environment)
					.append(' column header.\n')
					.append('Expected: ')
					.append(safeText(expectedColumnName))
					.append('\nFound: ')
					.append(columnName)
					.append('\n')
		}

		if ((result.numericValues as int) == 0) {
			errors.append('[ERROR] ')
					.append(environment)
					.append(' column does not contain numeric values.\n')
					.append('Column: ')
					.append(columnName)
					.append('\n')
		}

		result.errors = errors.toString().trim()
	}


	// ======================================================
	// STREAMING HANDLER
	// ======================================================

	private class StreamingStatisticsHandler
			implements XSSFSheetXMLHandler.SheetContentsHandler {

		private final int targetColumnIndex

		String columnName = ''
		int rows = 0
		int numericValues = 0

		BigDecimal sum = BigDecimal.ZERO
		BigDecimal minimum = null
		BigDecimal maximum = null

		private boolean rowHasValue = false
		private String targetCellValue = ''

		StreamingStatisticsHandler(int targetColumnIndex) {
			this.targetColumnIndex = targetColumnIndex
		}

		@Override
		void startRow(int rowNum) {
			rowHasValue = false
			targetCellValue = ''
		}

		@Override
		void endRow(int rowNum) {
			if (rowNum == 0) {
				columnName = safeText(targetCellValue)
				return
			}

			if (!rowHasValue) {
				return
			}

			rows++

			BigDecimal number = parseNumber(targetCellValue)

			if (number == null) {
				return
			}

			sum = sum.add(number)

			if (minimum == null || number.compareTo(minimum) < 0) {
				minimum = number
			}

			if (maximum == null || number.compareTo(maximum) > 0) {
				maximum = number
			}

			numericValues++
		}

		@Override
		void cell(
				String cellReference,
				String formattedValue,
				XSSFComment comment) {

			String value = safeText(formattedValue)

			if (!value.isEmpty()) {
				rowHasValue = true
			}

			if (cellReference == null) {
				return
			}

			int currentColumnIndex =
					new CellReference(cellReference).getCol()

			if (currentColumnIndex == targetColumnIndex) {
				targetCellValue = value
			}
		}

		@Override
		void headerFooter(
				String text,
				boolean isHeader,
				String tagName) {
		}
	}


	// ======================================================
	// FILE SEARCH
	// ======================================================

	private Map resolveLatestRecPrdFiles(
			File exportRoot,
			String expectedGroupFolder,
			String expectedFeatureFolder) {

		Map result = [
			recFile        : null,
			prdFile        : null,
			selectedFolder : null
		]

		List<File> matchingFeatureFolders = []

		collectMatchingFeatureFolders(
				exportRoot,
				expectedGroupFolder,
				expectedFeatureFolder,
				matchingFeatureFolders
		)

		if (matchingFeatureFolders.isEmpty()) {
			collectFallbackFeatureFolders(
					exportRoot,
					expectedFeatureFolder,
					matchingFeatureFolders
			)
		}

		List<Map> validPairs = []

		for (File featureFolder : matchingFeatureFolders) {
			File[] folderFiles = featureFolder.listFiles()

			if (folderFiles == null) {
				continue
			}

			List<File> recFiles = folderFiles.findAll { File file ->
				isEnvironmentExcelFile(file, 'REC')
			}

			List<File> prdFiles = folderFiles.findAll { File file ->
				isEnvironmentExcelFile(file, 'PRD')
			}

			if (recFiles.isEmpty() || prdFiles.isEmpty()) {
				continue
			}

			recFiles.sort { File first, File second ->
				second.lastModified() <=> first.lastModified()
			}

			prdFiles.sort { File first, File second ->
				second.lastModified() <=> first.lastModified()
			}

			File recFile = recFiles.get(0)
			File prdFile = prdFiles.get(0)

			validPairs.add([
				recFile        : recFile,
				prdFile        : prdFile,
				selectedFolder : featureFolder,
				pairTimestamp  : Math.max(
						recFile.lastModified(),
						prdFile.lastModified()
				)
			])
		}

		if (validPairs.isEmpty()) {
			return result
		}

		validPairs.sort { Map first, Map second ->
			(second.pairTimestamp as Long) <=>
			(first.pairTimestamp as Long)
		}

		Map latestPair = validPairs.get(0)

		result.recFile = latestPair.recFile
		result.prdFile = latestPair.prdFile
		result.selectedFolder = latestPair.selectedFolder

		return result
	}


	private void collectMatchingFeatureFolders(
			File currentFolder,
			String expectedGroupFolder,
			String expectedFeatureFolder,
			List<File> result) {

		if (currentFolder == null ||
				!currentFolder.exists() ||
				!currentFolder.isDirectory()) {

			return
		}

		File parentFolder = currentFolder.getParentFile()

		boolean featureMatches =
				normalizeText(currentFolder.getName()).equals(
						normalizeText(expectedFeatureFolder)
				)

		boolean groupMatches =
				parentFolder != null &&
				normalizeText(parentFolder.getName()).equals(
						normalizeText(expectedGroupFolder)
				)

		if (featureMatches && groupMatches) {
			result.add(currentFolder)
			return
		}

		File[] children = currentFolder.listFiles()

		if (children == null) {
			return
		}

		for (File child : children) {
			if (child != null && child.isDirectory()) {
				collectMatchingFeatureFolders(
						child,
						expectedGroupFolder,
						expectedFeatureFolder,
						result
				)
			}
		}
	}


	private void collectFallbackFeatureFolders(
			File currentFolder,
			String expectedFeatureFolder,
			List<File> result) {

		if (currentFolder == null ||
				!currentFolder.exists() ||
				!currentFolder.isDirectory()) {

			return
		}

		if (normalizeText(currentFolder.getName()).equals(
				normalizeText(expectedFeatureFolder))) {

			result.add(currentFolder)
			return
		}

		File[] children = currentFolder.listFiles()

		if (children == null) {
			return
		}

		for (File child : children) {
			if (child != null && child.isDirectory()) {
				collectFallbackFeatureFolders(
						child,
						expectedFeatureFolder,
						result
				)
			}
		}
	}


	private boolean isEnvironmentExcelFile(
			File file,
			String environment) {

		if (file == null ||
				!file.exists() ||
				!file.isFile()) {

			return false
		}

		String fileName = file.getName()

		if (fileName.startsWith('~$')) {
			return false
		}

		String lowerName = fileName.toLowerCase()

		return fileName.toUpperCase().startsWith(
				safeText(environment).toUpperCase() + '_'
		) && (
			lowerName.endsWith('.xlsx') ||
			lowerName.endsWith('.xlsm') ||
			lowerName.endsWith('.xls')
		)
	}


	// ======================================================
	// RESULT
	// ======================================================

	private void copyStatisticsToResult(
			Map result,
			Map recData,
			Map prdData,
			String expectedColumnName) {

		result.recColumnName = safeText(recData.columnName)
		result.prdColumnName = safeText(prdData.columnName)

		result.columnName = !safeText(recData.columnName).isEmpty()
				? safeText(recData.columnName)
				: safeText(expectedColumnName)

		result.recRows = recData.rows
		result.prdRows = prdData.rows
		result.recNumericValues = recData.numericValues
		result.prdNumericValues = prdData.numericValues
		result.recSum = recData.sum
		result.prdSum = prdData.sum
		result.recMinimum = recData.minimum
		result.prdMinimum = prdData.minimum
		result.recMaximum = recData.maximum
		result.prdMaximum = prdData.maximum
	}


	private void appendFileErrors(
			StringBuilder errors,
			Map data) {

		String value = safeText(data.errors)

		if (!value.isEmpty()) {
			errors.append(value).append('\n')
		}
	}


	private void appendComparison(
			StringBuilder errors,
			StringBuilder passedDetails,
			String validationLabel,
			Object columnName,
			BigDecimal recValue,
			BigDecimal prdValue) {

		if (recValue == null || prdValue == null) {
			errors.append('[ERROR] ')
					.append(validationLabel)
					.append(' could not be compared.\n')
			return
		}

		if (recValue.compareTo(prdValue) != 0) {
			errors.append('[ERROR] ')
					.append(validationLabel)
					.append(' is different.\n')
					.append('Column: ')
					.append(safeText(columnName))
					.append('\nREC: ')
					.append(recValue)
					.append('\nPRD: ')
					.append(prdValue)
					.append('\n')
		} else {
			passedDetails.append('[PASS] ')
					.append(validationLabel)
					.append(' is equal.\n')
					.append('Column: ')
					.append(safeText(columnName))
					.append('\nValue: ')
					.append(recValue)
					.append('\n')
		}
	}


	private Map createEmptyResult(
			String exportRootFolder,
			String exportGroupFolder,
			String exportFeatureFolder,
			Integer columnIndex,
			String expectedColumnName) {

		return [
			success             : false,
			errors              : '',
			passedDetails       : '',
			exportRootFolder    : safeText(exportRootFolder),
			exportGroupFolder   : safeText(exportGroupFolder),
			exportFeatureFolder : safeText(exportFeatureFolder),
			columnIndex         : columnIndex,
			columnName          : safeText(expectedColumnName),
			recColumnName       : '',
			prdColumnName       : '',
			selectedFolderPath  : '',
			recFileName         : 'NOT FOUND',
			prdFileName         : 'NOT FOUND',
			recRows             : null,
			prdRows             : null,
			recNumericValues    : null,
			prdNumericValues    : null,
			recSum              : null,
			prdSum              : null,
			recMinimum          : null,
			prdMinimum          : null,
			recMaximum          : null,
			prdMaximum          : null
		]
	}


	private Map createEmptyStatistics() {
		return [
			columnName   : '',
			rows         : 0,
			numericValues: 0,
			sum          : null,
			minimum      : null,
			maximum      : null,
			errors       : ''
		]
	}


	private Map finalizeResult(
			Map result,
			StringBuilder errors,
			StringBuilder passedDetails) {

		result.errors = errors.toString().trim()
		result.passedDetails = passedDetails.toString().trim()
		result.success = result.errors.isEmpty()

		return result
	}


	// ======================================================
	// LEGACY EXCEL HELPERS
	// ======================================================

	private String readHeaderName(
			Sheet sheet,
			int columnIndex,
			DataFormatter formatter) {

		Row row = sheet.getRow(0)
		Cell cell = row == null ? null : row.getCell(columnIndex)

		return cell == null
				? ''
				: formatter.formatCellValue(cell).trim()
	}


	private BigDecimal getCellNumber(
			Row row,
			int columnIndex,
			DataFormatter formatter) {

		Cell cell = row == null ? null : row.getCell(columnIndex)

		if (cell == null) {
			return null
		}

		try {
			if (cell.getCellType() == CellType.NUMERIC) {
				return BigDecimal.valueOf(cell.getNumericCellValue())
			}

			if (cell.getCellType() == CellType.FORMULA &&
					cell.getCachedFormulaResultType() == CellType.NUMERIC) {

				return BigDecimal.valueOf(cell.getNumericCellValue())
			}

			return parseNumber(
					formatter.formatCellValue(cell)
			)
		} catch (Exception ignored) {
			return null
		}
	}


	private boolean isRowEmpty(
			Row row,
			DataFormatter formatter) {

		if (row == null || row.getLastCellNum() <= 0) {
			return true
		}

		for (int index = 0;
				index < row.getLastCellNum();
				index++) {

			Cell cell = row.getCell(index)

			if (cell != null &&
					!formatter.formatCellValue(cell).trim().isEmpty()) {

				return false
			}
		}

		return true
	}


	// ======================================================
	// NUMBER HELPERS
	// ======================================================

	private BigDecimal parseNumber(Object rawValue) {

		String value = safeText(rawValue)

		if (value.isEmpty()) {
			return null
		}

		value = value
				.replace('\u00A0', ' ')
				.replace('\u202F', ' ')
				.replace('\u2212', '-')
				.replace('\u2012', '-')
				.replace('\u2013', '-')
				.replace('\u2014', '-')
				.replace('\u2015', '-')
				.trim()

		boolean parentheses =
				value.startsWith('(') &&
				value.endsWith(')')

		boolean trailingMinus =
				value.endsWith('-')

		value = value
				.replaceAll('[^0-9,\\.\\-\\(\\)]', '')
				.replace('(', '')
				.replace(')', '')

		if (trailingMinus && value.endsWith('-')) {
			value = value.substring(0, value.length() - 1)
		}

		boolean negative =
				value.startsWith('-') ||
				parentheses ||
				trailingMinus

		value = value.replace('-', '')

		if (value.isEmpty()) {
			return null
		}

		String normalizedNumber =
				normalizeNumericSeparators(value)

		try {
			BigDecimal number = new BigDecimal(normalizedNumber)

			if (negative && number.compareTo(BigDecimal.ZERO) > 0) {
				number = number.negate()
			}

			return number
		} catch (Exception ignored) {
			return null
		}
	}


	private String normalizeNumericSeparators(String value) {

		int commaCount = countOccurrences(value, ',')
		int dotCount = countOccurrences(value, '.')

		if (commaCount > 0 && dotCount > 0) {
			return value.lastIndexOf(',') > value.lastIndexOf('.')
					? value.replace('.', '').replace(',', '.')
					: value.replace(',', '')
		}

		if (commaCount > 0) {
			return normalizeSingleSeparator(value, ',')
		}

		if (dotCount > 0) {
			return normalizeSingleSeparator(value, '.')
		}

		return value
	}


	private String normalizeSingleSeparator(
			String value,
			String separator) {

		int count = countOccurrences(value, separator)

		if (count > 1) {
			int lastSeparator = value.lastIndexOf(separator)
			String decimals = value.substring(lastSeparator + 1)

			if (decimals.length() == 1 || decimals.length() == 2) {
				return value
						.substring(0, lastSeparator)
						.replace(separator, '') +
						'.' +
						decimals
			}

			return value.replace(separator, '')
		}

		int separatorIndex = value.indexOf(separator)
		String before = value.substring(0, separatorIndex)
		String after = value.substring(separatorIndex + 1)

		if (after.length() == 3 &&
				before.length() >= 1 &&
				before.length() <= 3) {

			return before + after
		}

		return separator == ','
				? before + '.' + after
				: value
	}


	private int countOccurrences(
			String value,
			String token) {

		int count = 0
		int index = 0

		while ((index = value.indexOf(token, index)) >= 0) {
			count++
			index += token.length()
		}

		return count
	}


	private BigDecimal round2(BigDecimal value) {

		return value == null
				? null
				: value.setScale(
						2,
						RoundingMode.HALF_EVEN
				)
	}


	// ======================================================
	// GENERAL HELPERS
	// ======================================================

	private String normalizeText(Object value) {

		String text = safeText(value)

		if (text.isEmpty()) {
			return ''
		}

		return Normalizer
				.normalize(text, Normalizer.Form.NFD)
				.replaceAll(
						'\\p{InCombiningDiacriticalMarks}+',
						''
				)
				.toLowerCase()
				.replace(' ', '_')
				.replace('-', '_')
				.replaceAll('_+', '_')
				.trim()
	}


	private String safeText(Object value) {

		return value == null
				? ''
				: value.toString().trim()
	}
}
