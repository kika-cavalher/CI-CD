@Keyword
void openEnvironmentDropdown() {
	KeywordUtil.logInfo("Opening environment dropdown")

	focusLoginWindow()

	WindowsTestObject combo = envComboObj()

	if (waitPresent(combo, 5)) {
		try {
			Windows.click(combo)
			sleepMs(800)
			return
		} catch (Throwable t) {
			KeywordUtil.logInfo("Combo click failed. Using legacy keyboard fallback. ${safe(t.message)}")
		}
	}

	legacyOpenEnvironmentDropdown()
}

@Keyword
int resolveEnvironmentLegacyIndex(String env) {
	String value = safe(env).toUpperCase()

	switch (value) {
		case 'PROD':
			return 1
		case 'PREPO':
		case 'PREX':
			return 2
		case 'REC2':
			return 3
		case 'REC':
			return 4
		case 'DEV2':
			return 5
		case 'DEV':
			return 6
		default:
			return 4
	}
}

@Keyword
void selectEnvironment(String env) {
	String resolvedEnv = safe(env) ?: safe(GlobalVariable.env) ?: 'REC'
	int legacyIndex = resolveEnvironmentLegacyIndex(resolvedEnv)

	KeywordUtil.logInfo("Selecting environment ${resolvedEnv} with legacy logic and index ${legacyIndex}")

	focusLoginWindow()

	WindowsTestObject combo = envComboObj()

	if (waitPresent(combo, 5)) {
		try {
			Windows.click(combo)
			sleepMs(800)

			for (int i = 0; i < legacyIndex; i++) {
				Windows.sendKeys(combo, Keys.chord(Keys.ARROW_DOWN))
				sleepMs(300)
			}

			Windows.sendKeys(combo, Keys.chord(Keys.ENTER))
			sleepMs(7000)
			return
		} catch (Throwable t) {
			KeywordUtil.logInfo("Combo selection failed. Using legacy keyboard fallback. ${safe(t.message)}")
		}
	}

	legacySelectEnvironmentByKeyboard(legacyIndex)
}

@Keyword
boolean isConnectButtonPresent() {
	return waitPresent(connectBtnObj(), 3)
}

@Keyword
void clickConnectButton() {
	KeywordUtil.logInfo("Clicking connect button")

	focusLoginWindow()

	WindowsTestObject btn = connectBtnObj()

	if (waitPresent(btn, 3)) {
		try {
			Windows.click(btn)
			sleepMs(1200)
			return
		} catch (Throwable t) {
			KeywordUtil.logInfo("Connect button click failed. Using ENTER fallback. ${safe(t.message)}")
		}
	}

	legacyConfirmLogin()
}

@Keyword
boolean waitForMainScreen() {
	KeywordUtil.logInfo("Waiting for main eMatch screen")

	try {
		Windows.waitForElementPresent(mainSearchObj(), 60, FailureHandling.OPTIONAL)
	} catch (Throwable ignored) {
	}

	sleepMs(10000)
	return true
}

@Keyword
void activateHomeTab() {
	try {
		WindowsTestObject homeTab = homeTabObj()
		if (waitPresent(homeTab, 5)) {
			Windows.click(homeTab)
			sleepMs(800)
			return
		}
	} catch (Throwable ignored) {
	}

	try {
		String homeImg = new File(RunConfiguration.getProjectDir(), 'Images/General/Home.PNG').getAbsolutePath()
		if (new File(homeImg).exists()) {
			WindowsImageKeywords.clickImage(homeImg)
			sleepMs(1000)
		}
	} catch (Throwable ignored) {
	}
}

@Keyword
void loginThroughNativeControls() {
	loginThroughNativeControls(safe(GlobalVariable.env) ?: 'REC')
}

@Keyword
void loginThroughNativeControls(String env) {
	String resolvedEnv = safe(env) ?: safe(GlobalVariable.env) ?: 'REC'

	KeywordUtil.logInfo("Logging through native controls for env ${resolvedEnv}")

	focusLoginWindow()
	selectEnvironment(resolvedEnv)

	focusLoginWindow()
	clickConnectButton()

	waitForMainScreen()
	activateHomeTab()

	KeywordUtil.logInfo("eMatch startup flow completed successfully for environment ${resolvedEnv}")
}

private void legacyOpenEnvironmentDropdown() {
	KeywordUtil.logInfo("Opening environment dropdown with legacy keyboard logic")

	focusLoginWindow()
	sleepMs(1000)

	Robot r = new Robot()
	r.setAutoDelay(100)

	r.keyPress(KeyEvent.VK_ALT)
	sleepMs(150)
	r.keyPress(KeyEvent.VK_DOWN)
	sleepMs(150)
	r.keyRelease(KeyEvent.VK_DOWN)
	sleepMs(150)
	r.keyRelease(KeyEvent.VK_ALT)

	sleepMs(1000)
}

private void legacySelectEnvironmentByKeyboard(int legacyIndex) {
	KeywordUtil.logInfo("Selecting environment with legacy keyboard fallback")
	KeywordUtil.logInfo("Pressing ARROW_DOWN ${legacyIndex} times")

	focusLoginWindow()
	sleepMs(1000)

	Robot r = new Robot()
	r.setAutoDelay(100)

	r.keyPress(KeyEvent.VK_ALT)
	sleepMs(150)
	r.keyPress(KeyEvent.VK_DOWN)
	sleepMs(150)
	r.keyRelease(KeyEvent.VK_DOWN)
	sleepMs(150)
	r.keyRelease(KeyEvent.VK_ALT)
	sleepMs(500)

	r.keyPress(KeyEvent.VK_HOME)
	sleepMs(150)
	r.keyRelease(KeyEvent.VK_HOME)
	sleepMs(300)

	for (int i = 0; i < legacyIndex; i++) {
		r.keyPress(KeyEvent.VK_DOWN)
		sleepMs(150)
		r.keyRelease(KeyEvent.VK_DOWN)
		sleepMs(300)
	}

	r.keyPress(KeyEvent.VK_ENTER)
	sleepMs(150)
	r.keyRelease(KeyEvent.VK_ENTER)

	sleepMs(7000)
}

private void legacyConfirmLogin() {
	KeywordUtil.logInfo("Confirming login with ENTER fallback")

	focusLoginWindow()
	sleepMs(800)

	Robot r = new Robot()
	r.setAutoDelay(100)

	r.keyPress(KeyEvent.VK_ENTER)
	sleepMs(150)
	r.keyRelease(KeyEvent.VK_ENTER)

	sleepMs(1500)
}





