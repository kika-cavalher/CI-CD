// ======================================================
// DELETE FAVORITE
// ======================================================

@Keyword
void deleteCreatedFavorite(
	String favoriteTitle,
	String favoriteImageKey
) {

	Integer favoriteSearchTimeout = 20
	Integer deleteCommandTimeout = 5

	Integer maximumDeleteChecks = 5
	Integer waitPerDeleteCheckSeconds = 20

	logStep(
		'DELETE FAVORITE',
		'Favorite title: ' + favoriteTitle + '\n' +
		'Favorite image key: ' + favoriteImageKey + '\n' +
		'Delete validation attempts: ' +
			maximumDeleteChecks + '\n' +
		'Wait per attempt: ' +
			waitPerDeleteCheckSeconds +
			' seconds'
	)


	// ======================================================
	// OPEN FAVORITES TAB
	// Same flow used when opening the favorite.
	// ======================================================

	WindowsTestObject favoritesTab =
		object(
			'favoritesTab'
		)

	if (!Windows.waitForElementPresent(
		favoritesTab,
		favoriteSearchTimeout,
		FailureHandling.OPTIONAL
	)) {
		takeEvidence(
			'GUI_FavoritesTabNotFoundForDelete.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorites tab was not found before deletion.'
		)

		return
	}

	KeywordUtil.logInfo(
		'[DELETE FAVORITE] Clicking Favorites tab.'
	)

	Windows.click(
		favoritesTab,
		FailureHandling.STOP_ON_FAILURE
	)

	Windows.delay(3)


	// ======================================================
	// FIND FAVORITE AND RIGHT CLICK
	// Element first, same image fallback used when opening.
	// ======================================================

	WindowsTestObject favoriteItem =
		WindowsObjectLoader.getTreeItemByName(
			favoriteTitle
		)

	KeywordUtil.logInfo(
		'[DELETE FAVORITE] Searching for created favorite.\n' +
		'Favorite: ' + favoriteTitle + '\n' +
		'Timeout: ' +
			favoriteSearchTimeout +
			' seconds'
	)

	boolean favoriteFoundByElement =
		Windows.waitForElementPresent(
			favoriteItem,
			favoriteSearchTimeout,
			FailureHandling.OPTIONAL
		)

	boolean favoriteContextMenuOpened = false

	if (favoriteFoundByElement) {
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Favorite found by element.\n' +
			'Opening context menu with right click.'
		)

		Windows.rightClick(
			favoriteItem,
			FailureHandling.STOP_ON_FAILURE
		)

		favoriteContextMenuOpened = true
	} else {
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Favorite element was not found.\n' +
			'Trying the same image fallback used when opening the favorite.\n' +
			'Image key: ' + favoriteImageKey
		)

		if (!safeText(favoriteImageKey).isEmpty()) {
			favoriteContextMenuOpened =
				rightClickFirstVisibleImage(
					GUI_IMAGE_GROUP,
					[
						favoriteImageKey
					],
					5
				)
		}
	}

	if (!favoriteContextMenuOpened) {
		takeEvidence(
			'GUI_FavoriteNotFoundForDelete.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorite was not found for deletion by element or image.\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'Image key: ' + favoriteImageKey
		)

		return
	}

	Windows.delay(2)


	// ======================================================
	// CLICK DELETE COMMAND
	// Element first, image fallback.
	// ======================================================

	boolean deleteCommandClicked = false

	WindowsTestObject deleteFavoriteButton =
		object(
			'deleteFavoriteButton'
		)

	boolean deleteButtonFound =
		Windows.waitForElementPresent(
			deleteFavoriteButton,
			deleteCommandTimeout,
			FailureHandling.OPTIONAL
		)

	if (deleteButtonFound) {
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Clicking Supprimer le favori by element.'
		)

		Windows.click(
			deleteFavoriteButton,
			FailureHandling.STOP_ON_FAILURE
		)

		deleteCommandClicked = true
	} else {
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Supprimer le favori element was not found.\n' +
			'Trying image fallback: deleteFavoriteBtn'
		)

		deleteCommandClicked =
			clickFirstVisibleImage(
				GUI_IMAGE_GROUP,
				[
					'deleteFavoriteBtn'
				],
				deleteCommandTimeout
			)
	}

	if (!deleteCommandClicked) {
		takeEvidence(
			'GUI_DeleteFavoriteButtonNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Delete Favorite command was not found by element or image.\n' +
			'Expected command: Supprimer le favori\n' +
			'Image key: deleteFavoriteBtn'
		)

		return
	}


	// ======================================================
	// WAIT UNTIL FAVORITE DISAPPEARS
	// Checks both element and image.
	// 5 attempts of 20 seconds.
	// ======================================================

	boolean favoriteDeleted = false

	for (
		Integer deleteCheckAttempt = 1;
		deleteCheckAttempt <= maximumDeleteChecks;
		deleteCheckAttempt++
	) {
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Waiting for favorite deletion.\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'Attempt: ' +
				deleteCheckAttempt +
				'/' +
				maximumDeleteChecks + '\n' +
			'Wait time: ' +
				waitPerDeleteCheckSeconds +
				' seconds'
		)

		Windows.delay(
			waitPerDeleteCheckSeconds
		)

		// Open Favorites again before checking the list.
		if (Windows.waitForElementPresent(
			favoritesTab,
			2,
			FailureHandling.OPTIONAL
		)) {
			Windows.click(
				favoritesTab,
				FailureHandling.OPTIONAL
			)

			Windows.delay(2)
		}

		// Recreate the dynamic object for each validation.
		WindowsTestObject currentFavoriteItem =
			WindowsObjectLoader.getTreeItemByName(
				favoriteTitle
			)

		boolean favoriteStillPresentByElement =
			Windows.waitForElementPresent(
				currentFavoriteItem,
				2,
				FailureHandling.OPTIONAL
			)

		boolean favoriteStillPresentByImage = false

		if (!safeText(favoriteImageKey).isEmpty()) {
			favoriteStillPresentByImage =
				isOptionalImageVisible(
					GUI_IMAGE_GROUP,
					favoriteImageKey
				)
		}

		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Favorite presence validation.\n' +
			'Found by element: ' +
				favoriteStillPresentByElement + '\n' +
			'Found by image: ' +
				favoriteStillPresentByImage
		)

		if (
			!favoriteStillPresentByElement &&
			!favoriteStillPresentByImage
		) {
			favoriteDeleted = true

			KeywordUtil.logInfo(
				'[PASS] Favorite is no longer displayed.\n' +
				'Attempt: ' +
				deleteCheckAttempt +
				'/' +
				maximumDeleteChecks
			)

			break
		}

		if (deleteCheckAttempt < maximumDeleteChecks) {
			KeywordUtil.logInfo(
				'[DELETE FAVORITE] Favorite is still displayed.\n' +
				'Another 20-second validation will be executed.'
			)
		}
	}

	takeEvidence(
		'GUI_FavoriteAfterDelete.png'
	)

	if (!favoriteDeleted) {
		KeywordUtil.markFailedAndStop(
			'Favorite is still visible after deletion.\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'Image key: ' + favoriteImageKey + '\n' +
			'Attempts: ' + maximumDeleteChecks + '\n' +
			'Wait per attempt: ' +
				waitPerDeleteCheckSeconds +
				' seconds\n' +
			'Maximum total wait: 100 seconds'
		)

		return
	}


	// ======================================================
	// CLOSE ALL TABS
	// ======================================================

	WindowsTestObject closeAllTabsButton =
		object(
			'closeAllTabsTopBar'
		)

	if (!Windows.waitForElementPresent(
		closeAllTabsButton,
		5,
		FailureHandling.OPTIONAL
	)) {
		takeEvidence(
			'GUI_CloseAllTabsButtonNotFoundAfterDelete.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorite was deleted, but the Close All Tabs button was not found.'
		)

		return
	}

	KeywordUtil.logInfo(
		'[DELETE FAVORITE] Closing all opened tabs.'
	)

	Windows.click(
		closeAllTabsButton,
		FailureHandling.STOP_ON_FAILURE
	)

	Windows.delay(2)

	boolean closeTabsConfirmed =
		clickFirstVisibleImage(
			GENERAL_IMAGE_GROUP,
			[
				'yes',
				'yesUnderline',
				'yesButton',
				'oui'
			],
			3
		)

	if (!closeTabsConfirmed) {
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Close confirmation image was not found.\n' +
			'Pressing ENTER.'
		)

		pressKeyboardKey(
			KeyEvent.VK_ENTER
		)
	}

	Windows.delay(5)

	takeEvidence(
		'GUI_AllTabsClosedAfterFavoriteDelete.png'
	)

	KeywordUtil.markPassed(
		'Favorite deleted successfully.\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'Favorite is no longer displayed.\n' +
			'All opened tabs were closed.'
	)
}


/**
 * Finds the configured image and performs a right click
 * at the center of the detected image.
 */
private boolean rightClickFirstVisibleImage(
	String groupName,
	List<String> imageKeys,
	Integer timeoutSeconds
) {

	Integer timeout =
		safeTimeout(
			timeoutSeconds,
			3
		)

	for (String imageKey : imageKeys) {
		String imagePath =
			optionalImage(
				groupName,
				imageKey
			)

		if (imagePath.isEmpty()) {
			continue
		}

		Integer elapsedSeconds = 0

		while (elapsedSeconds < timeout) {
			try {
				def foundImage =
					WindowsImageKeywords.findImage(
						imagePath
					)

				if (
					foundImage != null &&
					foundImage != false
				) {
					Integer centerX = null
					Integer centerY = null

					try {
						def center =
							foundImage.getCenter()

						centerX =
							(center.x as Number)
								.intValue()

						centerY =
							(center.y as Number)
								.intValue()
					} catch (Throwable ignored) {
					}

					if (
						centerX == null ||
						centerY == null
					) {
						try {
							Integer imageX =
								(foundImage.x as Number)
									.intValue()

							Integer imageY =
								(foundImage.y as Number)
									.intValue()

							Integer imageWidth =
								(foundImage.w as Number)
									.intValue()

							Integer imageHeight =
								(foundImage.h as Number)
									.intValue()

							centerX =
								imageX +
								imageWidth.intdiv(2)

							centerY =
								imageY +
								imageHeight.intdiv(2)
						} catch (Throwable ignored) {
						}
					}

					if (
						centerX != null &&
						centerY != null
					) {
						Robot robot =
							new Robot()

						robot.setAutoDelay(100)

						robot.mouseMove(
							centerX,
							centerY
						)

						robot.mousePress(
							java.awt.event.InputEvent
								.BUTTON3_DOWN_MASK
						)

						robot.mouseRelease(
							java.awt.event.InputEvent
								.BUTTON3_DOWN_MASK
						)

						KeywordUtil.logInfo(
							'[IMAGE] Right clicked: ' +
							groupName +
							'.' +
							imageKey
						)

						return true
					}
				}
			} catch (Throwable ignored) {
			}

			Windows.delay(1)
			elapsedSeconds++
		}
	}

	return false
}
