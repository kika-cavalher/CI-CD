	@Keyword
	def launchApplication(String targetEnvironment) {
		stopImmediatelyIfFatalFailureWasAlreadyDetected()

		String environment =
				normalizeEnvironment(targetEnvironment)

		if (System.getProperty('user.name') == GlobalVariable.username) {
			if (environment == 'REC') {
				String cmd =
						'Powershell.exe -executionpolicy remotesigned -File D:\\setResolution.ps1'

				Runtime
						.getRuntime()
						.exec(cmd)
			}

			Windows.startApplicationWithTitle(
					getShortcutPath(environment),
					getVersion(environment)
					)
		} else {
			if (environment == 'REC') {
				startWinAppDriver()
			}

			Windows.startApplication(
					getApplicationPath(environment)
					)
		}
	}


	@Keyword
	def validateProductionVersionOnly(String targetEnvironment) {
		stopImmediatelyIfFatalFailureWasAlreadyDetected()

		String environment =
				normalizeEnvironment(targetEnvironment)

		if (!isProductionEnvironment(environment)) {
			KeywordUtil.markFailedAndStop(
					'validateProductionVersionOnly can only be used for PRD/PROD.\n' +
					'Received environment: ' + environment
					)
		}

		validateCorrectVersionWindowOrStop(environment)
		saveCurrentEnvironment(environment)

		KeywordUtil.logInfo(
				'PRD version validated successfully. ' +
				'Credential modal, environment selector and connect button are not required for PRD.'
				)
	}


	@Keyword
	def switchToVersionWindow(String targetEnvironment) {
		stopImmediatelyIfFatalFailureWasAlreadyDetected()

