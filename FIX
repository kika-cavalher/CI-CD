goto waitLoop

:resultDone
echo [INFO] Result file updated.
echo [INFO] RUN_ID=!FILE_RUN_ID!
echo [INFO] STATUS=!STATUS!
echo [INFO] EXIT_CODE=!EXIT_CODE!
echo [INFO] UPDATED_AT=!UPDATED_AT!
echo.

schtasks /end /tn "%WIN_DRIVER_TASK%" >nul 2>&1

call :printTaskInfo
call :printResultFile
call :printLog "%LOG_FILE%" "run-ematch-command.log" 30
call :printLog "%KATALON_CONSOLE_LOG%" "katalon-console.log" 120
call :printReportsSummary
call :validateExecution
if errorlevel 1 exit /b 1

echo [INFO] %JOB_LABEL% execution finished successfully.

if not "!EXIT_CODE!"=="0" (
    echo [WARN] Katalon returned EXIT_CODE=!EXIT_CODE!, but Jenkins will keep SUCCESS because tests were executed.
)

exit /b 0

:readResult
set "FILE_RUN_ID="
set "STATUS="
set "EXIT_CODE="
set "UPDATED_AT="

if exist "%RESULT_FILE%" (
    for /f "usebackq tokens=1* delims==" %%A in ("%RESULT_FILE%") do (
        if /i "%%A"=="RUN_ID" set "FILE_RUN_ID=%%B"
        if /i "%%A"=="STATUS" set "STATUS=%%B"
        if /i "%%A"=="EXIT_CODE" set "EXIT_CODE=%%B"
        if /i "%%A"=="UPDATED_AT" set "UPDATED_AT=%%B"
    )
)

exit /b 0

:isTaskRunning
set "TASK_RUNNING=0"

schtasks /query /tn "%GENERIC_TASK%" /fo list /v | find /i "Status:" | find /i "Running" >nul 2>&1
if not errorlevel 1 set "TASK_RUNNING=1"

exit /b 0

:tryCompleteWhenTaskStopped
set "FORCED_DONE=0"

call :hasValidJUnitExecution
if "!HAS_VALID_JUNIT_EXECUTION!"=="1" (
    if not defined FILE_RUN_ID set "FILE_RUN_ID=%EXPECTED_RUN_ID%"
    if not defined STATUS set "STATUS=FINISHED"
    if not defined EXIT_CODE set "EXIT_CODE=0"
    set "FORCED_DONE=1"
    exit /b 0
)

set "FOUND_FINISH_MARKER=0"

if exist "%KATALON_CONSOLE_LOG%" (
    powershell -NoProfile -Command ^
        "$p='%KATALON_CONSOLE_LOG%';" ^
        "$txt=Get-Content -Path $p -Raw -ErrorAction SilentlyContinue;" ^
        "if($txt -match 'Execution completed\. Exit code: \d+\.' -or $txt -match 'All launchers terminated'){ exit 0 } else { exit 1 }"
    if not errorlevel 1 set "FOUND_FINISH_MARKER=1"
)

if "!FOUND_FINISH_MARKER!"=="1" (
    for /f %%I in ('powershell -NoProfile -Command "$p='%KATALON_CONSOLE_LOG%'; $m=[regex]::Matches((Get-Content -Path $p -Raw -ErrorAction SilentlyContinue),'Execution completed\. Exit code: (\d+)\.'); if($m.Count -gt 0){$m[$m.Count-1].Groups[1].Value}"') do set "EXIT_CODE=%%I"

    if not defined EXIT_CODE set "EXIT_CODE=0"

    call :hasValidJUnitExecution
    if "!HAS_VALID_JUNIT_EXECUTION!"=="1" (
        set "FILE_RUN_ID=%EXPECTED_RUN_ID%"
        set "STATUS=FINISHED"
        set "FORCED_DONE=1"
        exit /b 0
    )
)

exit /b 0

:hasArtifacts
set "HAS_ARTIFACTS=0"

if exist "%WORKSPACE%\Reports" (
    dir /s /b "%WORKSPACE%\Reports\JUnit_Report.xml" >nul 2>&1 && set "HAS_ARTIFACTS=1"
    if "!HAS_ARTIFACTS!"=="0" dir /s /b "%WORKSPACE%\Reports\execution0.log" >nul 2>&1 && set "HAS_ARTIFACTS=1"
    if "!HAS_ARTIFACTS!"=="0" dir /s /b "%WORKSPACE%\Reports\*.html" >nul 2>&1 && set "HAS_ARTIFACTS=1"
)

exit /b 0

:hasValidJUnitExecution
set "HAS_VALID_JUNIT_EXECUTION=0"
set "VALID_JUNIT_FILE="
set "VALID_TEST_COUNT=0"

if not exist "%WORKSPACE%\Reports" (
    exit /b 0
)

for /f "usebackq delims=" %%F in (`dir /s /b "%WORKSPACE%\Reports\JUnit_Report.xml" 2^>nul`) do (
    set "CURRENT_JUNIT=%%F"

    for /f "usebackq delims=" %%T in (`powershell -NoProfile -Command ^
        "$p='%%F';" ^
        "try {" ^
        "  [xml]$xml = Get-Content -Path $p -ErrorAction Stop;" ^
        "  $tests = 0;" ^
        "  if($xml.testsuite -and $xml.testsuite.tests -ne $null){ $tests = [int]$xml.testsuite.tests }" ^
        "  elseif($xml.testsuites -and $xml.testsuites.tests -ne $null){ $tests = [int]$xml.testsuites.tests }" ^
        "  else {" ^
        "    $nodes = $xml.SelectNodes('//*[@tests]');" ^
        "    foreach($n in $nodes){ $tests += [int]$n.tests }" ^
        "  }" ^
        "  Write-Output $tests;" ^
        "} catch { Write-Output 0 }"`) do (
        set "CURRENT_TEST_COUNT=%%T"
    )

    if not defined CURRENT_TEST_COUNT set "CURRENT_TEST_COUNT=0"

    if !CURRENT_TEST_COUNT! GTR 0 (
        set "HAS_VALID_JUNIT_EXECUTION=1"
        set "VALID_JUNIT_FILE=%%F"
        set "VALID_TEST_COUNT=!CURRENT_TEST_COUNT!"
        exit /b 0
    )
)

exit /b 0

:validateExecution
echo [INFO] Validating current execution...

set "VALIDATION_FAILED=0"

call :hasValidJUnitExecution

if "!HAS_VALID_JUNIT_EXECUTION!"=="1" (
    echo [INFO] Valid JUnit execution found.
    echo [INFO] JUnit file: !VALID_JUNIT_FILE!
    echo [INFO] Tests executed: !VALID_TEST_COUNT!
    echo [INFO] Execution is valid even if some test cases failed.
    exit /b 0
)

echo [ERROR] No valid JUnit execution found for %JOB_LABEL%.
echo [ERROR] This means the expected test suite collection did not execute correctly.
echo [ERROR] Jenkins must FAIL this job.

set "HARD_ERROR=0"

powershell -NoProfile -Command ^
    "$files=@('%KATALON_CONSOLE_LOG%','%LOG_FILE%') | Where-Object { Test-Path $_ };" ^
    "$txt=($files | ForEach-Object { Get-Content -Path $_ -Raw -ErrorAction SilentlyContinue }) -join [Environment]::NewLine;" ^
    "if($txt -match 'FilePathTooLongException' -or $txt -match 'Cannot save entity' -or $txt -match 'Test Suite Collection .+ not found' -or $txt -match 'Test Suite .+ not found' -or $txt -match 'Unable to open project' -or $txt -match 'com\.kms\.katalon\.execution\.exception\.ExecutionException'){ exit 0 } else { exit 1 }"

if not errorlevel 1 set "HARD_ERROR=1"

if "!HARD_ERROR!"=="1" (
    echo [ERROR] Hard execution error detected for %JOB_LABEL%.
    exit /b 1
)

call :hasArtifacts

if "!HAS_ARTIFACTS!"=="1" (
    echo [ERROR] Some artifacts were generated, but no valid JUnit with tests greater than zero was found.
    echo [ERROR] This job is considered FAILED because execution cannot be confirmed.
    exit /b 1
)

echo [ERROR] No report artifacts were generated for %JOB_LABEL%.
exit /b 1

:printTaskInfo
echo [INFO] Scheduled task status snapshot:
echo [INFO] ---- %WIN_DRIVER_TASK% ----
schtasks /query /tn "%WIN_DRIVER_TASK%" /fo list /v | findstr /I /C:"Status:" /C:"Last Run Time" /C:"Last Result"
echo [INFO] ---- %GENERIC_TASK% ----
schtasks /query /tn "%GENERIC_TASK%" /fo list /v | findstr /I /C:"Status:" /C:"Last Run Time" /C:"Last Result"
echo.

exit /b 0

:printResultFile
if exist "%RESULT_FILE%" (
    echo [INFO] Current run-result.properties:
    type "%RESULT_FILE%"
    echo.
) else (
    echo [WARN] Result file not found: %RESULT_FILE%
    echo.
)

exit /b 0

:printLog
set "TARGET_FILE=%~1"
set "TARGET_TITLE=%~2"
set "TARGET_TAIL=%~3"

if exist "%TARGET_FILE%" (
    echo [INFO] Last lines from %TARGET_TITLE%:
    powershell -NoProfile -Command "Get-Content -Path '%TARGET_FILE%' -Tail %TARGET_TAIL% -ErrorAction SilentlyContinue"
    echo.
) else (
    echo [WARN] File not found: %TARGET_FILE%
    echo.
)

exit /b 0

:printReportsSummary
if exist "%WORKSPACE%\Reports" (
    echo [INFO] Reports folder found: %WORKSPACE%\Reports
    echo [INFO] Relevant report artifacts:

    powershell -NoProfile -Command ^
        "$root='%WORKSPACE%\Reports';" ^
        "Get-ChildItem -Path $root -Recurse -File -ErrorAction SilentlyContinue | Where-Object { $_.Name -like 'JUnit_Report.xml' -or $_.Name -like 'execution0.log' -or $_.Extension -eq '.html' } | Sort-Object LastWriteTime -Descending | Select-Object -First 20 | ForEach-Object { Write-Host ('[REPORT] ' + $_.LastWriteTime.ToString('yyyy-MM-dd HH:mm:ss') + '  ' + $_.FullName) }"

    echo.
) else (
    echo [WARN] Reports folder not found: %WORKSPACE%\Reports
    echo.
)

exit /b 0

