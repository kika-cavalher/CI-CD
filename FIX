        long end = System.currentTimeMillis() + 120000L

        while (System.currentTimeMillis() < end) {
            boolean loginStillPresent = false
            try {
                loginStillPresent = Windows.waitForElementPresent(loginDialogObj(), 2)
            } catch (Throwable ignored) {
            }

            if (!loginStillPresent) {
                return true
            }

            sleepMs(1000)
        }

        return false
    }

