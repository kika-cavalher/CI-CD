	@Keyword
	String getResolutionScriptPath() {
		return firstNonBlank(
			readGlobal('RESOLUTION_SCRIPT_PATH'),
			readGlobal('resolutionScriptPath'),
			System.getenv('RESOLUTION_SCRIPT_PATH'),
			DEFAULT_RESOLUTION_SCRIPT_PATH
		)
	}

	@Keyword
	String resolveWindowTitle() {
		String version = safe(readGlobal('version'))
		String versionProd = safe(readGlobal('versionProd'))
		String raw = firstNonBlank(version, versionProd)

		if (blank(raw)) {
			KeywordUtil.markFailedAndStop('GlobalVariable.version and GlobalVariable.versionProd are both empty.')
			return ''
		}

		if (raw.toLowerCase().startsWith('ematch')) {
			return raw
		}

		return "eMatch ${raw}"
	}

	@Keyword
	void runResolutionScriptIfAvailable() {
		String scriptPath = getResolutionScriptPath()

		try {
			if (blank(scriptPath)) {
				return
			}

			File resolutionScript = new File(scriptPath)

			if (!resolutionScript.exists()) {
				KeywordUtil.logInfo("Resolution script not found. Skipping: ${scriptPath}")
				return
			}

			new ProcessBuilder(
				'powershell.exe',
				'-ExecutionPolicy', 'Bypass',
				'-File', resolutionScript.absolutePath
			).start()

			KeywordUtil.logInfo("Resolution script started: ${resolutionScript.absolutePath}")
		}
		catch (Exception e) {
			KeywordUtil.logInfo("Resolution script failed but flow will continue: ${e.getMessage()}")
		}
	}

	@Keyword
	void startEmatch(String currentUser, String targetWindowTitle) {
		String shortcutPath = getShortcutPath()
		String applicationPath = getApplicationPath()

		KeywordUtil.logInfo('============================================================')
		KeywordUtil.logInfo('eMatch startup context')
		KeywordUtil.logInfo("Windows user      : ${safe(currentUser)}")
		KeywordUtil.logInfo("Global username   : ${safe(readGlobal('username'))}")
		KeywordUtil.logInfo("Window title      : ${safe(targetWindowTitle)}")
		KeywordUtil.logInfo("Shortcut path     : ${safe(shortcutPath)}")
		KeywordUtil.logInfo("Application path  : ${safe(applicationPath)}")
		KeywordUtil.logInfo("WinAppDriver path : ${safe(getWinAppDriverPath())}")
		KeywordUtil.logInfo('============================================================')

		try {
			ensureWinAppDriverRunning()
			runResolutionScriptIfAvailable()

			boolean started = false

			if (!blank(shortcutPath) && new File(shortcutPath).exists()) {
				try {
					KeywordUtil.logInfo("Trying shortcut startup with title: ${shortcutPath}")
					Windows.startApplicationWithTitle(shortcutPath, targetWindowTitle)
					started = true
				}
				catch (Exception shortcutError) {
					KeywordUtil.logInfo("Shortcut startup with title failed: ${shortcutError.getMessage()}")
				}
			}

			if (!started && !blank(applicationPath)) {
				try {
					KeywordUtil.logInfo("Trying application startup: ${applicationPath}")
					Windows.startApplication(applicationPath)
					started = true
				}
				catch (Exception appError) {
					KeywordUtil.logInfo("Application startup failed: ${appError.getMessage()}")
				}
			}

			if (!started) {
				if (!blank(shortcutPath) && new File(shortcutPath).exists()) {
					KeywordUtil.logInfo("Trying detached shortcut startup: ${shortcutPath}")
					launchDetached(shortcutPath)
					started = true
				}
				else if (!blank(applicationPath)) {
					KeywordUtil.logInfo("Trying detached application startup: ${applicationPath}")
					launchDetached(applicationPath)
					started = true
				}
			}

			if (!started) {
				KeywordUtil.markFailedAndStop('Failed to start eMatch from shortcut and application path.')
			}

			Windows.delay(AFTER_APP_START_DELAY_SEC)
		}
		catch (Exception e) {
			KeywordUtil.markFailed("Failed to start eMatch.")
			KeywordUtil.markFailed("Exception: ${e.getClass().getName()} - ${e.getMessage()}")
			KeywordUtil.markFailedAndStop("Stopping test case due to startup failure.")
		}
	}

	@Keyword
	void attachToLoginWindow(String targetWindowTitle) {
		int elapsedTime = 0
		Exception lastError = null

		while (elapsedTime < WINDOW_ATTACH_TIMEOUT_SEC) {
			try {
				Windows.switchToDesktop()

				if (trySwitchByExactName(targetWindowTitle)) {
					KeywordUtil.logInfo("Attached by exact name: ${targetWindowTitle}")
					return
				}

				if (trySwitchByContainsName(targetWindowTitle)) {
					KeywordUtil.logInfo("Attached by contains title: ${targetWindowTitle}")
					return
				}

				if (trySwitchByContainsName('eMatch')) {
					KeywordUtil.logInfo("Attached by generic eMatch title.")
					return
				}
			}
			catch (Exception e) {
				lastError = e
			}

			Windows.delay(WINDOW_ATTACH_RETRY_SEC)
			elapsedTime += WINDOW_ATTACH_RETRY_SEC
		}

		String extra = lastError != null ? " Last error: ${lastError.getMessage()}" : ''
		KeywordUtil.markFailedAndStop("Target window '${targetWindowTitle}' could not be found within ${WINDOW_ATTACH_TIMEOUT_SEC} seconds.${extra}")
	}

	private boolean trySwitchByExactName(String title) {
		try {
			WindowsTestObject targetWindow = new WindowsTestObject('exactWindow')
			targetWindow.setLocatorStrategy(LocatorStrategy.NAME)
			targetWindow.setLocator(title)

			Windows.switchToWindow(targetWindow)
			return true
		}
		catch (Exception ignored) {
			return false
		}
	}

	private boolean trySwitchByContainsName(String title) {
		try {
			WindowsTestObject targetWindow = new WindowsTestObject('containsWindow')
			targetWindow.setLocatorStrategy(LocatorStrategy.XPATH)
			targetWindow.setLocator("//*[contains(@Name,'${escapeXpathText(title)}')]")

			Windows.switchToWindow(targetWindow)
			return true
		}
		catch (Exception ignored) {
			return false
		}
	}

	@Keyword
	void openEnvironmentDropdown() {
		WinRetry.clickWithRetry('Login Page/optEnv', 3, 10)
		Windows.delay(AFTER_ENV_DROPDOWN_DELAY_SEC)
	}

	@Keyword
	int resolveEnvironmentIndex(String environment) {
		switch (safe(environment).toUpperCase()) {
			case 'PROD':
				return 1
			case 'PREX':
				return 2
			case 'REC2':
				return 3
			case 'REC':
				return 4
			case 'DEV2':
				return 5
			case 'DEV':
				return 6
			default:
				return 3
		}
	}

	@Keyword
	void selectEnvironment(String environment) {
		int env = resolveEnvironmentIndex(environment)

		for (int i = 0; i < env; i++) {
			Windows.sendKeys(findWindowsObject('Login Page/optEnv'), Keys.chord(Keys.ARROW_DOWN))
		}

		Windows.sendKeys(findWindowsObject('Login Page/optEnv'), Keys.chord(Keys.ENTER))
		Windows.delay(AFTER_ENV_SELECTION_DELAY_SEC)
	}

