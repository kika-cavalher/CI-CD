	def updateTestCaseStatusInUse(String execIDTestCase) {
		println 'Changing status of Test ' + execIDTestCase + ' to In Use.'

		def response = WS.sendRequest(findTestObject(REQUEST_TRANSITION_STATUS, [
			('issueID')     : execIDTestCase,
			('transitionID'): '21',
			('token')       : JIRA_TOKEN
		]))

		return WS.getResponseStatusCode(response)
	}

	def updateTestCaseStatusApproved(String execIDTestCase) {
		println 'Changing status of Test ' + execIDTestCase + ' to Approved.'

		def response = WS.sendRequest(findTestObject(REQUEST_TRANSITION_STATUS, [
			('issueID')     : execIDTestCase,
			('transitionID'): '11',
			('token')       : JIRA_TOKEN
		]))

		return WS.getResponseStatusCode(response)
	}

	List<String> importTestCaseKey(String execID) {
		println 'Getting Tests of Test Execution ' + execID + '.'

		def response = WS.sendRequest(findTestObject(REQUEST_GET_ISSUE, [
			('issueID'): execID,
			('token')  : JIRA_TOKEN
		]))

		def slurper = new JsonSlurper()
		def parsedJson = slurper.parseText(response.getResponseBodyContent())
		def keys = parsedJson?.fields?.customfield_12513?.testKey

		if (keys == null) {
			return []
		}

		if (keys instanceof List) {
			return keys
		}

		return [keys.toString()]
	}

	def updateTestCasePath(String execIDTestCase, String summaryName) {
		if (summaryName != null && summaryName.startsWith('Test Cases')) {
			println 'Updating X-Ray folder for ' + execIDTestCase + '.'

			String pathValue = ""
			List<String> splitted = summaryName.split("/")
			List<String> projectFolder = System.getProperty("user.dir").toString().split("\\\\")

			splitted[splitted.indexOf('Test Cases')] = projectFolder[projectFolder.size() - 1]

			for (int i = 0; i < splitted.size() - 1; i++) {
				pathValue += splitted[i] + "/"
			}

			println("Moving to Path: " + pathValue)

			def response = WS.sendRequest(findTestObject(REQUEST_UPDATE_REPOSITORY_PATH, [
				('issueID'): execIDTestCase,
				('repPath'): pathValue,
				('token')  : JIRA_TOKEN
			]))

			return WS.getResponseStatusCode(response)
		}

		return 200
	}

	def updateSummaryTestCase(String execIDTestCase, String summaryName) {
		println 'Updating Test Summary...'

		List<String> summaryTxt = summaryName.split("/")
		String changedSummaryName = summaryTxt[summaryTxt.size() - 1]

		def response = WS.sendRequest(findTestObject(REQUEST_UPDATE_SUMMARY, [
			('issueID'): execIDTestCase,
			('summary'): changedSummaryName,
			('token')  : JIRA_TOKEN
		]))

		return WS.getResponseStatusCode(response)
	}

