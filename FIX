	private String validateTableLiaisonTableAndFormPair(
			String label,
			String tableObjectKey,
			String formObjectKey,
			Map<String, String> values
	) {

		String tableValue = safeText(
				Windows.getText(
				object(tableObjectKey)
				)
				)

		String formValue = safeText(
				Windows.getText(
				object(formObjectKey)
				)
				)

		values[label + ' table'] = tableValue
		values[label + ' form'] = formValue

		if (!tableValue.equals(formValue)) {
			return label +
					' table value does not match the form value. Table: "' +
					tableValue +
					'", form: "' +
					formValue +
					'".\n'
		}

		KeywordUtil.logInfo(
				'[PASS] ' +
				label +
				' table value matches the form value.'
				)

		return ''
	}


	private String validateTableLiaisonEnabledState(
			String objectKey,
			Boolean expectedEnabled
	) {

		String expectedValue = expectedEnabled ? 'True' : 'False'

		Boolean valid = Windows.verifyElementAttributeValue(
				object(objectKey),
				'IsEnabled',
				expectedValue,
				4,
				FailureHandling.OPTIONAL
				)

		if (valid) {
			return ''
		}

		return 'Unexpected IsEnabled state for ' +
				objectKey +
				'. Expected: ' +
				expectedValue +
				'.\n'
	}


	private void replaceTableLiaisonText(
			String objectKey,
			String value,
			Integer timeoutSeconds
	) {

		String text = safeText(value)

		if (text.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Table de Liaison value cannot be empty.\n' +
					'Object key: ' +
					objectKey
					)
			return
		}

		WindowsTestObject inputObject = object(objectKey)

		if (!Windows.waitForElementPresent(inputObject, timeoutSeconds, FailureHandling.OPTIONAL)) {
			KeywordUtil.markFailedAndStop(
					'Table de Liaison input was not displayed.\n' +
					'Object key: ' +
					objectKey
					)
			return
		}

		Windows.click(inputObject, FailureHandling.STOP_ON_FAILURE)

		Robot robot = new Robot()
		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_BACK_SPACE)
		robot.keyRelease(KeyEvent.VK_BACK_SPACE)

		Windows.setText(inputObject, text)
	}


