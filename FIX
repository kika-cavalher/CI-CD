function Write-VisualLine {
    param([string]$Text)

    if (-not [string]::IsNullOrWhiteSpace($Text)) {
        Write-Host $Text
    }
}

function Emit-Scenario {
    param([string]$Scenario)

    $scenario = Short-Text $Scenario 170
    if (-not $scenario) { return }

    if ($script:CurrentScenario -ne $scenario) {
        $script:CurrentScenario = $scenario
        $script:CurrentStep = ''
        $script:LastStepSignature = ''
        Write-VisualLine ("🎬 SCENARIO      | " + $scenario)
    }
}

function Emit-StepStarted {
    param([string]$Step)

    $step = Short-Text $Step 170
    if (-not $step) { return }

    $signature = 'START|' + $step
    if ($script:LastStepSignature -ne $signature) {
        $script:CurrentStep = $step
        $script:LastStepSignature = $signature
        Write-VisualLine ("➡️ STEP STARTED | " + $step)
    }
}

function Emit-StepPassed {
    param([string]$Step)

    $step = Short-Text $Step 170
    if (-not $step) { return }

    $script:CurrentStep = $step
    $signature = 'PASS|' + $step
    if ($script:LastStepSignature -ne $signature) {
        $script:LastStepSignature = $signature
        Write-VisualLine ("✅ STEP PASSED  | " + $step)
    }
}

function Emit-StepFailed {
    param(
        [string]$Step,
        [string]$Reason
    )

    $step = Short-Text $Step 170
    $reason = Short-Text $Reason 220

    if (-not $step) { return }

    $script:CurrentStep = $step
    $signature = 'FAIL|' + $step + '|' + $reason
    if ($script:LastStepSignature -ne $signature) {
        $script:LastStepSignature = $signature
        if ($reason) {
            Write-VisualLine ("❌ STEP FAILED  | " + $step + " | " + $reason)
        } else {
            Write-VisualLine ("❌ STEP FAILED  | " + $step)
        }
    }
}

function Emit-TestCase {
    param([string]$TestCase)

    $name = Short-Text $TestCase 170
    if ($name) {
        Write-VisualLine ("🧩 TEST CASE    | " + $name)
    }
}

function Emit-RawImportant {
    param(
        [string]$Source,
        [string]$Line
    )

    $text = Short-Text $Line 220
    if (-not $text) { return }

    if ($text -eq $script:LastRawSignature) { return }

    if (
        $text -match '(?i)error|failed|exception|timeout|timed out|warning|cannot|unable to|not found|start suite|end suite|start test case|browser|chrome|report folder|execution0\\.log'
        -or $text -match '(?i)Scenario'
        -or $text -match '(?i)\\b(Given|When|Then|And|But)\\b'
    ) {
        $script:LastRawSignature = $text
        Write-VisualLine ("📝 " + $Source.PadRight(12) + " | " + $text)
    }
}

function Parse-ExecutionLine {
    param(
        [string]$Line,
        [string]$Source
    )

    $text = Clean-Text $Line
    if (-not $text) { return }

    if ($text -match '(?i)Scenario(?: Outline)?\\s*[:\\-]?\\s*(.+)$') {
        Emit-Scenario $Matches[1]
        return
    }

    if ($text -match '(?i)(Test Cases[\\\\/][^\\s]+)') {
        Emit-TestCase $Matches[1]
    }

    if ($text -match '(?i)\\b(Given|When|Then|And|But)\\b\\s+(.+)$') {
        $step = ($Matches[1] + ' ' + $Matches[2]).Trim()
        $step = $step -replace '(?i)\\s*(PASSED|FAILED|ERROR|SUCCESS).*$', ''
        $step = Short-Text $step 170

        if ($text -match '(?i)\\b(PASSED|PASS|SUCCESS)\\b') {
            Emit-StepPassed $step
            return
        }

        if ($text -match '(?i)\\b(FAILED|FAIL|ERROR|EXCEPTION|NOT FOUND|TIMED OUT|TIMEOUT)\\b') {
            Emit-StepFailed $step $text
            return
        }

        Emit-StepStarted $step
        return
    }

    if ($script:CurrentStep -and $text -match '(?i)\\b(PASSED|PASS|SUCCESS)\\b') {
        if ($text -match '(?i)keyword|step|gherkin|cucumber|Scenario|Given|When|Then|And|But') {
            Emit-StepPassed $script:CurrentStep
            return
        }
    }

    if ($script:CurrentStep -and $text -match '(?i)\\b(FAILED|FAIL|ERROR|EXCEPTION|NOT FOUND|TIMED OUT|TIMEOUT|STEPFAILEDEXCEPTION|ASSERTIONFAILEDERROR)\\b') {
        Emit-StepFailed $script:CurrentStep $text
        return
    }

    Emit-RawImportant $Source $text
}

function Flush-File {
    param(
        [string]$Path,
        [ref]$Offset,
        [string]$Source
    )

    $lines = Read-NewLines -Path $Path -Offset $Offset
    foreach ($line in $lines) {
        Parse-ExecutionLine -Line $line -Source $Source
    }
}

function Discover-ExecutionLog {
    param([string]$Root)

    if ($script:DiscoveredExecutionLog -and (Test-Path $script:DiscoveredExecutionLog)) {
        return $script:DiscoveredExecutionLog
    }

    $candidate = Get-ChildItem -Path $Root -Filter 'execution0.log' -File -Recurse -ErrorAction SilentlyContinue |
        Where-Object { $_.FullName -like ("*" + $env:SUITE_NAME + "*") } |
        Sort-Object LastWriteTime -Descending |
        Select-Object -First 1

    if ($candidate) {
        $script:DiscoveredExecutionLog = $candidate.FullName
        Write-VisualLine ("📄 EXECUTION LOG | " + $script:DiscoveredExecutionLog)
        return $script:DiscoveredExecutionLog
    }

    return ''
}

