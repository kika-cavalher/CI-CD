	private String resolveCurrentCollectionName() {
		List<String> validParts =
				getValidReportFolderParts()

		if (!validParts.isEmpty()) {
			return validParts[0]
		}

		return 'Collection'
	}

	private String resolveCurrentFeatureName() {
		List<String> validParts =
				getValidReportFolderParts()

		if (!validParts.isEmpty()) {
			return validParts.last()
		}

		return 'Export'
	}

	private List<String> getValidReportFolderParts() {
		List<String> validParts = []

		String reportFolderPath =
				RunConfiguration.getReportFolder()

		if (reportFolderPath == null ||
				reportFolderPath.trim().isEmpty()) {
			return validParts
		}

		List<String> parts =
				reportFolderPath
				.replace('/', '\\')
				.split('\\\\') as List<String>

		for (String part : parts) {
			if (isValidFeatureNamePart(
					part
					)) {
				validParts.add(
						part.trim()
						)
			}
		}

		return validParts
	}

	private boolean isValidFeatureNamePart(
			String part
	) {
		if (part == null ||
				part.trim().isEmpty()) {
			return false
		}

		String value = part.trim()
		String lower = value.toLowerCase()

		if (value ==~ /\d{8}_\d{6}/ ||
				value ==~ /\d{14}/) {
			return false
		}

		if (value ==~ /^\d+\.\s*.*/) {
			return false
		}

		List<String> ignoredExactValues = [
			'reports',
			'evidences',
			'exports',
			'test cases',
			'test suites',
			'connection',
			'authentication',
			'login rec',
			'login prd',
			'katalon',
			'temp'
		]

		if (ignoredExactValues.contains(
				lower
				)) {
			return false
		}

		List<String> ignoredContainsValues = [
			'validation',
			'validations',
			'validate',
			'compare',
			'close application',
			'open module',
			'login'
		]

		for (String ignored : ignoredContainsValues) {
			if (lower.contains(
					ignored
					)) {
				return false
			}
		}

		return true
	}

	private String sanitizeFileName(
			String text
	) {
		if (text == null ||
				text.trim().isEmpty()) {
			return 'Export'
		}

		String normalized =
				Normalizer
				.normalize(
				text,
				Normalizer.Form.NFD
				)
				.replaceAll(
				'\\p{InCombiningDiacriticalMarks}+',
				''
				)

		String cleaned =
				normalized
				.replaceAll(
				'[\\\\/:*?"<>|]',
				'_'
				)
				.replaceAll(
				'\\s+',
				'_'
				)
				.replaceAll(
				'_+',
				'_'
				)
				.replaceAll(
				'^_|_$',
				''
				)
				.trim()

		if (cleaned.isEmpty()) {
			return 'Export'
		}

		return cleaned
	}

	private String shortenFilePart(
			String value,
			Integer maximumLength
	) {
		if (value == null ||
				value.trim().isEmpty()) {
			return ''
		}

		int safeMaximum =
				maximumLength == null ||
				maximumLength <= 0 ?
				20 :
				maximumLength

		String cleanValue =
				sanitizeFileName(
				value
				)

		if (cleanValue.length() <= safeMaximum) {
			return cleanValue
		}

		return cleanValue.substring(
				0,
				safeMaximum
				)
	}

	private void setFileName(
			String fileName
	) {
		boolean fileNameFieldFocused =
				focusFileNameField()

		if (!fileNameFieldFocused) {
			imageLoader.takeEvidence(
					'FileNameFieldNotFocused.png'
					)

			KeywordUtil.markFailedAndStop(
					'Could not focus export file name field before saving.\n' +
					'Expected file name: ' + fileName
					)
		}

		clearFocusedField()
		pasteText(fileName)
		Windows.delay(1)
	}

	private boolean focusFileNameField() {
		List<WindowsTestObject> candidateObjects = [
			buildFileNameFieldByAutomationId(),
			buildFileNameFieldByName(
			'File name'
			),
			buildFileNameFieldByName(
			'Nom du fichier'
			),
			buildFileNameFieldByName(
			'Nome do ficheiro'
			),
			buildFileNameFieldByName(
			'Nome do arquivo'
			)
		]

		for (WindowsTestObject object : candidateObjects) {
			try {
				if (Windows.verifyElementPresent(
						object,
						1,
						FailureHandling.OPTIONAL
						)) {
					Windows.click(
							object
							)

					Windows.delay(1)

					KeywordUtil.logInfo(
							'File name field focused using dynamic Windows object: ' +
							object.getObjectId()
							)

					return true
				}
			} catch (Exception ignored) {
			}
		}

		try {
			Windows.click(
					findWindowsObject(
					'General/txtFileName'
					)
					)

			Windows.delay(1)

			KeywordUtil.logInfo(
					'File name field focused using General/txtFileName.'
					)

			return true
		} catch (Exception ignored) {
			KeywordUtil.logInfo(
					'General/txtFileName was not available.'
					)
		}

		try {
			focusFileNameFieldWithShortcut()

			Windows.delay(1)

			KeywordUtil.logInfo(
					'File name field focused using ALT + N.'
					)

			return true
		} catch (Exception ignored) {
		}

		return false
	}

	private WindowsTestObject buildFileNameFieldByAutomationId() {
		WindowsTestObject object =
				new WindowsTestObject(
				'fileNameFieldAutomationId'
				)

		object.setLocatorStrategy(
				LocatorStrategy.XPATH
				)

		object.setLocator(
				"//*[@AutomationId='FileNameControlHost']"
				)

		return object
	}

	private WindowsTestObject buildFileNameFieldByName(
			String name
	) {
		WindowsTestObject object =
				new WindowsTestObject(
				'fileNameField_' +
				sanitizeObjectName(
				name
				)
				)

		object.setLocatorStrategy(
				LocatorStrategy.XPATH
				)

		object.setLocator(
				"//*[contains(" +
				"translate(@Name, " +
				"'abcdefghijklmnopqrstuvwxyz', " +
				"'ABCDEFGHIJKLMNOPQRSTUVWXYZ'), " +
				"'" + name.toUpperCase() + "')]"
				)

		return object
	}

	private WindowsTestObject buildXpathObject(
			String xpath
	) {
		WindowsTestObject object =
				new WindowsTestObject()

		object.setLocatorStrategy(
				LocatorStrategy.XPATH
				)

		object.setLocator(
				xpath
				)

		return object
	}

	private String sanitizeObjectName(
			String text
	) {
		if (text == null) {
			return 'empty'
		}

		return text.replaceAll(
				'[^a-zA-Z0-9]',
				'_'
				)
	}

	private void focusFileNameFieldWithShortcut() {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(
				KeyEvent.VK_ALT
				)

		robot.keyPress(
				KeyEvent.VK_N
				)

		robot.keyRelease(
				KeyEvent.VK_N
				)

		robot.keyRelease(
				KeyEvent.VK_ALT
				)
	}

	private void clearFocusedField() {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(
				KeyEvent.VK_CONTROL
				)

		robot.keyPress(
				KeyEvent.VK_A
				)

		robot.keyRelease(
				KeyEvent.VK_A
				)

		robot.keyRelease(
				KeyEvent.VK_CONTROL
				)

		Windows.delay(1)

		robot.keyPress(
				KeyEvent.VK_BACK_SPACE
				)

		robot.keyRelease(
				KeyEvent.VK_BACK_SPACE
				)
	}

	private void pasteAndEnter(
			String text
	) {
		pasteText(
				text
				)

		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(
				KeyEvent.VK_ENTER
				)

		robot.keyRelease(
				KeyEvent.VK_ENTER
				)
	}

	private void pasteText(
			String text
	) {
		StringSelection selection =
				new StringSelection(
				text
				)

		Toolkit
				.getDefaultToolkit()
				.getSystemClipboard()
				.setContents(
				selection,
				null
				)

		Windows.delay(1)

		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(
				KeyEvent.VK_CONTROL
				)

		robot.keyPress(
				KeyEvent.VK_V
				)

		robot.keyRelease(
				KeyEvent.VK_V
				)

		robot.keyRelease(
				KeyEvent.VK_CONTROL
				)
	}
