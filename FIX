		}

		if (detectedModalImage == null) {

			logInfo(
					'REC modal not found. Searching for PRD open-file modal. Timeout: ' +
					OPEN_FILE_MODAL_TIMEOUT_SECONDS +
					' seconds.'
					)

			if (imageLoader.waitForImage(
					GENERAL_IMAGE_GROUP,
					'iconeModalPRD',
					OPEN_FILE_MODAL_TIMEOUT_SECONDS
					)) {

				detectedModalImage = 'iconeModalPRD'
			}
		}

		if (detectedModalImage == null) {

			imageLoader.takeEvidence(
					'OpenFileModalNotFound.png'
					)

