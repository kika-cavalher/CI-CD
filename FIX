package component

import java.awt.Robot
import java.awt.event.KeyEvent
import java.io.File

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows


class FilterKeywords {

	private static final Integer DEFAULT_TIMEOUT = 10
	private static final Integer POLLING_DELAY_SECONDS = 1


	// ======================================================
	// OPEN FILTER
	// ======================================================

	@Keyword
	void openFilter(
			String filterFieldImagePath,
			String filterButtonImagePath,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)

		validateImageFile(filterFieldImagePath, 'Filter field')
		validateImageFile(filterButtonImagePath, 'Filter button')

		waitForImagePresent(
			filterFieldImagePath,
			timeout,
			'Filter field was not displayed.'
		)

		WindowsImageKeywords.clickImage(filterFieldImagePath)

		waitForImagePresent(
			filterButtonImagePath,
			timeout,
			'Filter button was not displayed after opening the filter field.'
		)

		WindowsImageKeywords.clickImage(filterButtonImagePath)
	}


	// ======================================================
	// CLEAR CURRENT SELECTION
	// ======================================================

	@Keyword
	void clearCurrentSelection(
			String selectAllImagePath,
			String emptySelectionImagePath,
			String closeFilterImagePath,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)

		validateImageFile(selectAllImagePath, 'Select all option')
		validateImageFile(emptySelectionImagePath, 'Empty selection option')
		validateImageFile(closeFilterImagePath, 'Close filter button')

		waitForImagePresent(
			selectAllImagePath,
			timeout,
			'Select all option was not displayed.'
		)

		WindowsImageKeywords.doubleClickImage(selectAllImagePath)
		Windows.delay(POLLING_DELAY_SECONDS)

		waitForImagePresent(
			emptySelectionImagePath,
			timeout,
			'Empty selection option was not displayed.'
		)

		WindowsImageKeywords.doubleClickImage(emptySelectionImagePath)
		Windows.delay(POLLING_DELAY_SECONDS)

		waitForImagePresent(
			closeFilterImagePath,
			timeout,
			'Close filter button was not displayed.'
		)

		WindowsImageKeywords.clickImage(closeFilterImagePath)
		Windows.delay(POLLING_DELAY_SECONDS)
	}


	// ======================================================
	// APPLY TEXT FILTER WITH CHECKBOX
	// ======================================================

	@Keyword
	void applyTextCheckboxFilter(
			String filterFieldImagePath,
			String filterButtonImagePath,
			String textInputImagePath,
			String checkboxImagePath,
			String closeFilterImagePath,
			String appliedFilterImagePath,
			String filterValue,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)
		String value = safeText(filterValue)

		if (value.isEmpty()) {
			KeywordUtil.markFailedAndStop('Filter value cannot be empty.')
		}

		validateImageFile(textInputImagePath, 'Filter text input')
		validateImageFile(checkboxImagePath, 'Filter checkbox')
		validateImageFile(closeFilterImagePath, 'Close filter button')
		validateImageFile(appliedFilterImagePath, 'Applied filter validation')

		openFilter(
			filterFieldImagePath,
			filterButtonImagePath,
			timeout
		)

		waitForImagePresent(
			textInputImagePath,
			timeout,
			'Filter text input was not displayed.'
		)

		replaceTextOnImage(
			textInputImagePath,
			value
		)
		Windows.delay(2)

		waitForImagePresent(
			checkboxImagePath,
			timeout,
			'Filter checkbox was not displayed for value: ' + value
		)

		WindowsImageKeywords.clickImage(checkboxImagePath)
		Windows.delay(POLLING_DELAY_SECONDS)

		waitForImagePresent(
			closeFilterImagePath,
			timeout,
			'Close filter button was not displayed.'
		)

		WindowsImageKeywords.clickImage(closeFilterImagePath)

		waitForImagePresent(
			appliedFilterImagePath,
			timeout,
			'Filter was not applied correctly for value: ' + value
		)

		KeywordUtil.logInfo(
			'[PASS] Text filter applied successfully. Value: ' + value
		)
	}


	// ======================================================
	// DRAG FILTER TO TARGET AREA
	// ======================================================

	@Keyword
	void dragFilterToTargetAndValidate(
			String sourceFilterImagePath,
			String targetAreaImagePath,
			String appliedFilterImagePath,
			String availableFiltersValidationImagePath,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)

		validateImageFile(sourceFilterImagePath, 'Source filter')
		validateImageFile(targetAreaImagePath, 'Filter target area')
		validateImageFile(appliedFilterImagePath, 'Applied filter validation')
		validateImageFile(
			availableFiltersValidationImagePath,
			'Available filters validation'
		)

		waitForImagePresent(
			sourceFilterImagePath,
			timeout,
			'Source filter was not displayed before drag and drop.'
		)

		waitForImagePresent(
			targetAreaImagePath,
			timeout,
			'Filter target area was not displayed.'
		)

		WindowsImageKeywords.dragAndDrop(
			sourceFilterImagePath,
			targetAreaImagePath
		)

		waitForImagePresent(
			appliedFilterImagePath,
			timeout,
			'Filter was not applied to the target area.'
		)

		waitForImagePresent(
			availableFiltersValidationImagePath,
			timeout,
			'Available filter list was not updated after drag and drop.'
		)

		KeywordUtil.logInfo(
			'[PASS] Filter drag and drop completed and validated.'
		)
	}


	// ======================================================
	// IMAGE VALIDATION
	// ======================================================

	@Keyword
	Boolean isImageDisplayed(
			String imagePath,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)
		validateImageFile(imagePath, 'Validation image')

		return waitForImage(
			imagePath,
			timeout
		)
	}


	// ======================================================
	// INTERNAL HELPERS
	// ======================================================

	private void replaceTextOnImage(
			String imagePath,
			String value
		) {

		WindowsImageKeywords.clickImage(imagePath)

		Robot robot = new Robot()

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_CONTROL)

		robot.keyPress(KeyEvent.VK_BACK_SPACE)
		robot.keyRelease(KeyEvent.VK_BACK_SPACE)

		WindowsImageKeywords.typeOnImage(
			imagePath,
			value
		)
	}

	private Boolean waitForImage(
			String imagePath,
			Integer timeoutSeconds
		) {

		long endTime = System.currentTimeMillis() +
			(timeoutSeconds * 1000L)

		while (System.currentTimeMillis() <= endTime) {
			try {
				if (WindowsImageKeywords.findImage(imagePath)) {
					return true
				}
			} catch (Throwable ignored) {
			}

			Windows.delay(POLLING_DELAY_SECONDS)
		}

		return false
	}

	private void waitForImagePresent(
			String imagePath,
			Integer timeoutSeconds,
			String failureMessage
		) {

		if (!waitForImage(imagePath, timeoutSeconds)) {
			KeywordUtil.markFailedAndStop(
				failureMessage + '\nImage: ' +
				new File(imagePath).name
			)
		}
	}

	private void validateImageFile(
			String imagePath,
			String imageDescription
		) {

		String path = safeText(imagePath)

		if (path.isEmpty()) {
			KeywordUtil.markFailedAndStop(
				imageDescription + ' image path is empty.'
			)
		}

		File imageFile = new File(path)

		if (!imageFile.exists() || !imageFile.isFile()) {
			KeywordUtil.markFailedAndStop(
				imageDescription + ' image was not found:\n' +
				imageFile.absolutePath
			)
		}
	}

	private Integer safeTimeout(Integer timeoutSeconds) {
		return timeoutSeconds != null && timeoutSeconds > 0 ?
			timeoutSeconds : DEFAULT_TIMEOUT
	}

	private String safeText(Object value) {
		return value == null ? '' : value.toString().trim()
	}
}







