    @Keyword
    int resolveEnvironmentIndex(String environment) {
        String envName = (environment ?: '').trim().toUpperCase()
        int env = 3

        switch (envName) {
            case 'PRD':
            case 'PROD':
                env = 1
                break
            case 'PREX':
                env = 2
                break
            case 'REC2':
                env = 3
                break
            case 'REC':
                env = 4
                break
            case 'DEV2':
                env = 5
                break
            case 'DEV':
                env = 6
                break
            default:
                env = 4
                break
        }

        return env
    }

