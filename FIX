package pageObject

import java.util.concurrent.TimeUnit

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.exception.StepFailedException

class authentication {

    private static final String REC = 'REC'
    private static final String PRD = 'PRD'

    private static final String RUNAS_USER = 'cib\\cavalherer'

    private static final String REC_LNK_PATH = 'D:\\RunAseMatchReq\\eMatch.lnk'
    private static final String PRD_LNK_PATH = 'D:\\RunAseMatchPRD\\eMatch.lnk'

    private static final String REC_APPLICATION_PATH = '\\\\cib.net\\shareparis\\Soft\\ematch\\IHM\\Livraisons\\REC\\IXIS.eMatch.IHM.application'
    private static final String PRD_APPLICATION_PATH = '\\\\cib.net\\shareparis\\Soft\\ematch\\IHM\\PROD\\IXIS.eMatch.IHM.application'

    private static final String REC_WINDOW_TITLE = 'eMatch - Login REC'
    private static final String PRD_WINDOW_TITLE = 'eMatch - Login PRD'

    private static final String REC_LAUNCHER_BAT = 'D:\\RecEmatchAsUser.bat'
    private static final String PRD_LAUNCHER_BAT = 'D:\\ProdEmatchAsUser.bat'

    private static final String WINAPPDRIVER_EXE = 'C:\\Program Files (x86)\\Windows Application Driver\\WinAppDriver.exe'
    private static final String RESOLUTION_SCRIPT_PATH = 'D:\\setResolution.ps1'

    private static final int WINAPPDRIVER_TIMEOUT_SEC = 20
    private static final int PROCESS_TIMEOUT_SEC = 180

    @Keyword
    String resolveEnvironment(String environment) {
        String env = (environment ?: '').trim().toUpperCase()

        if (!env) {
            env = REC
        }

        if (!(env in [REC, PRD])) {
            throw new StepFailedException("Invalid environment '${env}'. Use REC or PRD.")
        }

        return env
    }

    @Keyword
    String getCurrentWindowsUser() {
        return System.getProperty('user.name') ?: ''
    }

    @Keyword
    String getRunAsUser() {
        return RUNAS_USER
    }

    @Keyword
    String getShortcutPath(String environment) {
        String env = resolveEnvironment(environment)
        return env == PRD ? PRD_LNK_PATH : REC_LNK_PATH
    }

    @Keyword
    String getApplicationPath(String environment) {
        String env = resolveEnvironment(environment)
        return env == PRD ? PRD_APPLICATION_PATH : REC_APPLICATION_PATH
    }

    @Keyword
    String getWindowTitle(String environment) {
        String env = resolveEnvironment(environment)
        return env == PRD ? PRD_WINDOW_TITLE : REC_WINDOW_TITLE
    }

    @Keyword
    String getLauncherBat(String environment) {
        String env = resolveEnvironment(environment)
        return env == PRD ? PRD_LAUNCHER_BAT : REC_LAUNCHER_BAT
    }

    @Keyword
    String getResolutionScriptPath() {
        return RESOLUTION_SCRIPT_PATH
    }

    @Keyword
    String getWinAppDriverPath() {
        return WINAPPDRIVER_EXE
    }

    @Keyword
    void ensureWinAppDriverRunning() {
        if (isWinAppDriverRunning()) {
            return
        }

        File exe = new File(WINAPPDRIVER_EXE)
        if (!exe.exists()) {
            throw new StepFailedException("WinAppDriver not found: ${WINAPPDRIVER_EXE}")
        }

        new ProcessBuilder(WINAPPDRIVER_EXE).start()

        long deadline = System.currentTimeMillis() + (WINAPPDRIVER_TIMEOUT_SEC * 1000L)
        while (System.currentTimeMillis() < deadline) {
            if (isWinAppDriverRunning()) {
                return
            }
            sleep(1000)
        }

        throw new StepFailedException("WinAppDriver did not start within ${WINAPPDRIVER_TIMEOUT_SEC} seconds.")
    }

    @Keyword
    void runResolutionScriptIfExists() {
        File script = new File(RESOLUTION_SCRIPT_PATH)
        if (!script.exists()) {
            return
        }

        Process process = new ProcessBuilder(
            'powershell',
            '-ExecutionPolicy',
            'Bypass',
            '-File',
            RESOLUTION_SCRIPT_PATH
        ).redirectErrorStream(true).start()

        boolean finished = process.waitFor(60, TimeUnit.SECONDS)

        if (!finished) {
            process.destroyForcibly()
            throw new StepFailedException("Resolution script timed out: ${RESOLUTION_SCRIPT_PATH}")
        }

        if (process.exitValue() != 0) {
            String output = process.inputStream.getText('Cp1252')
            throw new StepFailedException("Resolution script failed.\n${output}")
        }
    }

    @Keyword
    void launchEmatch(String environment) {
        String launcherBat = getLauncherBat(environment)

        File launcher = new File(launcherBat)
        if (!launcher.exists()) {
            throw new StepFailedException("Launcher BAT not found: ${launcherBat}")
        }

        Process process = new ProcessBuilder(
            'cmd',
            '/c',
            launcherBat
        ).redirectErrorStream(true).start()

        boolean finished = process.waitFor(PROCESS_TIMEOUT_SEC, TimeUnit.SECONDS)

        if (!finished) {
            process.destroyForcibly()
            throw new StepFailedException("Launcher timed out: ${launcherBat}")
        }

        if (process.exitValue() != 0) {
            String output = process.inputStream.getText('Cp1252')
            throw new StepFailedException("Launcher failed.\n${output}")
        }
    }

    @Keyword
    Map getEnvironmentConfig(String environment) {
        String env = resolveEnvironment(environment)

        return [
            environment       : env,
            runAsUser         : getRunAsUser(),
            shortcutPath      : getShortcutPath(env),
            applicationPath   : getApplicationPath(env),
            windowTitle       : getWindowTitle(env),
            launcherBat       : getLauncherBat(env),
            winAppDriverPath  : getWinAppDriverPath(),
            resolutionScript  : getResolutionScriptPath()
        ]
    }

    private boolean isWinAppDriverRunning() {
        try {
            Socket socket = new Socket('127.0.0.1', 4723)
            socket.close()
            return true
        } catch (Throwable ignored) {
            return false
        }
    }
}







