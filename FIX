	String now() {
		return new SimpleDateFormat('yyyy-MM-dd HH.mm.ss').format(new Date())
	}

	String formatUiDate(Date date) {
		if (date == null) {
			return ''
		}
		return new SimpleDateFormat('EEE MMM dd HH:mm:ss z yyyy', Locale.ENGLISH).format(date)
	}

	boolean isBlank(String value) {
		return value == null || value.trim().isEmpty()
	}

	String maskToken(String token) {
		if (isBlank(token)) {
			return 'EMPTY'
		}

		if (token.length() <= 10) {
			return '***'
		}

		return token.take(6) + '...' + token.takeRight(4)
	}

	void logSection(String message) {
		KeywordUtil.logInfo('==================================================')
		KeywordUtil.logInfo(message)
		KeywordUtil.logInfo('==================================================')
	}

	String safeHtml(String value) {
		if (value == null) {
			return ''
		}

		return value
			.replace('&', '&amp;')
			.replace('<', '&lt;')
			.replace('>', '&gt;')
			.replace('"', '&quot;')
			.replace("'", '&#39;')
	}

	boolean isTimestampFolderName(String name) {
		if (name == null) {
			return false
		}

		return name ==~ /\\d{8,}_\\d{4,}/ || name ==~ /\\d{8,}/
	}

	String formatDurationSeconds(BigDecimal secondsValue) {
		if (secondsValue == null) {
			return '0ms'
		}

		long totalMs = (secondsValue * 1000).longValue()
		long hours = totalMs / 3600000
		long minutes = (totalMs % 3600000) / 60000
		long seconds = (totalMs % 60000) / 1000
		long millis = totalMs % 1000

		String result = ''

		if (hours > 0) {
			result += hours + 'h '
		}

		if (minutes > 0 || hours > 0) {
			result += minutes + 'm '
		}

		if (seconds > 0 || minutes > 0 || hours > 0) {
			result += seconds + 's '
		}

		result += millis + 'ms'
		return result.trim()
	}

	String guessMimeType(File file) {
		String lower = file.name.toLowerCase()

		if (lower.endsWith('.png')) return 'image/png'
		if (lower.endsWith('.jpg') || lower.endsWith('.jpeg')) return 'image/jpeg'
		if (lower.endsWith('.gif')) return 'image/gif'
		if (lower.endsWith('.webp')) return 'image/webp'

		return 'application/octet-stream'
	}

	String toDataUri(File file) {
		try {
			byte[] bytes = Files.readAllBytes(file.toPath())
			String base64 = Base64.encoder.encodeToString(bytes)
			String mime = guessMimeType(file)
			return "data:${mime};base64,${base64}"
		} catch (Exception e) {
			KeywordUtil.markWarning("Could not convert image to base64: ${file.name} - ${e.message}")
			return ''
		}
	}

	String normalizeSuiteName(String value) {
		if (isBlank(value)) {
			return 'UnknownTestSuite'
		}

		String cleaned = value.trim()

		cleaned = cleaned.replaceAll('(?i)^test suites[/\\\\]', '')
		cleaned = cleaned.replaceAll('(?i)^test suite[/\\\\]', '')
		cleaned = cleaned.replaceAll('(?i)jira integration$', '')
		cleaned = cleaned.trim()

		if (cleaned.contains('\\')) {
			cleaned = cleaned.tokenize('\\')[-1]
		}

		if (cleaned.contains('/')) {
			cleaned = cleaned.tokenize('/')[-1]
		}

		return cleaned.trim()
	}

