	String importExecutionResults(String xmlPath) {
		def response = WS.sendRequest(findTestObject('Jira Integration/Import Results', [
			('filePath'): xmlPath,
			('project') : PROJECT_KEY,
			('baseUrl') : JIRA_BASE_URL,
			('token')   : JIRA_TOKEN
		]))

		int status = WS.getResponseStatusCode(response)
		String body = safe(response.getResponseBodyContent())

		KeywordUtil.logInfo("Import results status: ${status}")
		KeywordUtil.logInfo("Import results response: ${body}")

		if (!(status in [200, 201, 204])) {
			return 'ERROR' + status
		}

		def parsed = new JsonSlurper().parseText(body)
		String executionKey = safe(parsed?.testExecIssue?.key)

		if (isBlank(executionKey)) {
			return 'ERROR_NO_EXEC_KEY'
		}

		return executionKey
	}

	String findExistingTestPlanKey(String summary) {
		if (FORCE_CREATE_NEW_TEST_PLAN) {
			KeywordUtil.logInfo("FORCE_CREATE_NEW_TEST_PLAN enabled. A new Test Plan will be created.")
			return ''
		}

		if (!isBlank(MANUAL_TEST_PLAN_KEY)) {
			KeywordUtil.logInfo("Using manual Test Plan key: ${MANUAL_TEST_PLAN_KEY}")
			return MANUAL_TEST_PLAN_KEY
		}

		String savedKey = readSavedSuiteTestPlanKey()
		if (!isBlank(savedKey)) {
			KeywordUtil.logInfo("Using saved Test Plan key for suite ${getCurrentSuiteName()}: ${savedKey}")
			return savedKey
		}

		String escapedSummary = summary.replace('[', '\\\\[').replace(']', '\\\\]')

		def response = WS.sendRequest(findTestObject('Jira Integration/Get Test Plan', [
			('project'): PROJECT_KEY,
			('token')  : JIRA_TOKEN,
			('summary'): escapedSummary,
			('parent') : EPIC_KEY
		]))

		int status = WS.getResponseStatusCode(response)
		String body = safe(response.getResponseBodyContent())

		KeywordUtil.logInfo("Get Test Plan status: ${status}")
		KeywordUtil.logInfo("Get Test Plan response: ${body}")

		if (status != 200) {
			return ''
		}

		def parsed = new JsonSlurper().parseText(body)
		def issues = parsed?.issues

		if (!(issues instanceof List) || issues.isEmpty()) {
			KeywordUtil.logInfo("No existing Test Plan found for summary: ${summary}")
			return ''
		}

		String expected = normalizeTitle(summary)

		def exactMatch = issues.find { issue ->
			normalizeTitle(issue?.fields?.summary) == expected
		}

		if (exactMatch != null) {
			String foundKey = safe(exactMatch.key)
			if (!isBlank(foundKey)) {
				saveSuiteTestPlanKey(foundKey)
				KeywordUtil.logInfo("Existing Test Plan found by exact summary: ${foundKey}")
				return foundKey
			}
		}

		String firstKey = safe(issues[0]?.key)
		if (!isBlank(firstKey)) {
			saveSuiteTestPlanKey(firstKey)
			KeywordUtil.logInfo("Existing Test Plan found by first result fallback: ${firstKey}")
			return firstKey
		}

		return ''
	}

	String createTestPlan(String summary) {
		def response = WS.sendRequest(findTestObject('Jira Integration/Create Test Plan', [
			('token')  : JIRA_TOKEN,
			('project'): PROJECT_KEY,
			('summary'): summary,
			('epic')   : EPIC_KEY
		]))

		int status = WS.getResponseStatusCode(response)
		String body = safe(response.getResponseBodyContent())

		KeywordUtil.logInfo("Create Test Plan status: ${status}")
		KeywordUtil.logInfo("Create Test Plan response: ${body}")

		if (!(status in [200, 201])) {
			return 'ERROR' + status
		}

		def parsed = new JsonSlurper().parseText(body)
		String createdKey = safe(parsed?.key)

		if (!isBlank(createdKey)) {
			saveSuiteTestPlanKey(createdKey)
		}

		return createdKey
	}

	String getOrCreateTestPlanKey() {
		String summary = getTestPlanName()

		String existingKey = findExistingTestPlanKey(summary)
		if (!isBlank(existingKey)) {
			KeywordUtil.logInfo("Resolved existing Test Plan for suite ${getCurrentSuiteName()}: ${existingKey}")
			return existingKey
		}

		String createdKey = createTestPlan(summary)
		KeywordUtil.logInfo("Created new Test Plan for suite ${getCurrentSuiteName()}: ${createdKey}")
		return createdKey
	}

	int addExecutionToTestPlan(String testPlanKey, String executionKey) {
		String jsonBody = JsonOutput.toJson([
			addTestsToPlan: true,
			add           : [executionKey]
		])

		def response = WS.sendRequest(findTestObject('Jira Integration/Update Test Plan', [
			('token')      : JIRA_TOKEN,
			('testPlanKey'): testPlanKey,
			('jsonBody')   : jsonBody
		]))

		int status = WS.getResponseStatusCode(response)
		KeywordUtil.logInfo("Add execution to Test Plan status: ${status}")
		return status
	}

	int updateTestExecution(String executionKey, String executionSummary) {
		def response = WS.sendRequest(findTestObject('Jira Integration/Update Test Execution Name', [
			('issueID'): executionKey,
			('token')  : JIRA_TOKEN,
			('summary'): executionSummary,
			('labels') : LABELS,
			('env')    : ENVIRONMENT
		]))

		int status = WS.getResponseStatusCode(response)
		KeywordUtil.logInfo("Update Test Execution status: ${status}")
		return status
	}

	int uploadAttachment(String issueKey, String filePath) {
		if (isBlank(filePath)) {
			return 0
		}

		File file = new File(filePath)
		if (!file.exists() || !file.isFile() || file.length() <= 0) {
			KeywordUtil.logInfo("Skipping attachment upload because file path is empty or invalid: ${filePath}")
			return 0
		}

		def response = WS.sendRequest(findTestObject('Jira Integration/Evidence attachment', [
			('token')    : JIRA_TOKEN,
			('evidences'): file,
			('execID')   : issueKey
		]))

		int status = WS.getResponseStatusCode(response)
		String body = safe(response.getResponseBodyContent())

		KeywordUtil.logInfo("Upload attachment status: ${status}")
		KeywordUtil.logInfo("Upload attachment response: ${body}")

		return status
	}

	// ============================================================
	// MAIN FLOW
	// ============================================================

	@Keyword
	def jiraImport() {
		KeywordUtil.logInfo("============================================================")
		KeywordUtil.logInfo("Starting Jira import flow")
		KeywordUtil.logInfo("============================================================")

		String reportFolder = getResolvedReportFolder()
		if (isBlank(reportFolder)) {
			KeywordUtil.markFailed("Report folder could not be resolved.")
			return
		}

		KeywordUtil.logInfo("Using report folder: ${reportFolder}")

		String suiteName = getCurrentSuiteName()
		if (isBlank(suiteName)) {
			KeywordUtil.markFailed("Suite name could not be resolved from report path.")
			return
		}

		KeywordUtil.logInfo("Suite name detected from report path: ${suiteName}")

		String executionSummary = getExecutionSummary()
		String testPlanSummary = getTestPlanName()

		KeywordUtil.logInfo("Execution title used: ${executionSummary}")
		KeywordUtil.logInfo("Test Plan title used: ${testPlanSummary}")

		String xmlPath = findXmlFile(reportFolder)
		if (isBlank(xmlPath)) {
			KeywordUtil.markFailed("JUnit or Cucumber XML file was not found in report folder.")
			return
		}

		KeywordUtil.logInfo("XML file found: ${xmlPath}")

		String gaiaReportPath = createGaiaHtmlReport()
		if (isBlank(gaiaReportPath)) {
			KeywordUtil.markWarning("Gaia report could not be created.")
		} else {
			KeywordUtil.logInfo("Gaia report created: ${gaiaReportPath}")
		}

		String executionKey = importExecutionResults(xmlPath)
		if (executionKey.startsWith('ERROR')) {
			KeywordUtil.markFailed("Execution import failed: ${executionKey}")
			return
		}

		String testPlanKey = getOrCreateTestPlanKey()
		if (isBlank(testPlanKey) || testPlanKey.startsWith('ERROR')) {
			KeywordUtil.markFailed("Test Plan could not be created or resolved: ${testPlanKey}")
			return
		}

		int addExecutionStatus = addExecutionToTestPlan(testPlanKey, executionKey)
		int updateExecutionStatus = updateTestExecution(executionKey, executionSummary)

		KeywordUtil.logInfo("Uploading execution attachments...")

		Map attachmentStatuses = uploadExecutionAttachments(executionKey)

		KeywordUtil.logInfo("Gaia report attachment status: ${attachmentStatuses.gaiaReport}")
		KeywordUtil.logInfo("Evidences.zip attachment status: ${attachmentStatuses.evidences}")
		KeywordUtil.logInfo("Results.zip attachment status: ${attachmentStatuses.results}")

		KeywordUtil.logInfo("============================================================")
		KeywordUtil.logInfo("Jira import finished")
		KeywordUtil.logInfo("============================================================")
		KeywordUtil.logInfo("Execution key: ${executionKey}")
		KeywordUtil.logInfo("Execution title used: ${executionSummary}")
		KeywordUtil.logInfo("Test Plan key: ${testPlanKey}")
		KeywordUtil.logInfo("Test Plan title used: ${testPlanSummary}")
		KeywordUtil.logInfo("Add execution to Test Plan status: ${addExecutionStatus}")
		KeywordUtil.logInfo("Update Test Execution status: ${updateExecutionStatus}")
	}
