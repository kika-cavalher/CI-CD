	private String resolveExportLabelSuffixForFileName(
			String exportLabel) {

		if (exportLabel == null ||
				exportLabel.trim().isEmpty()) {

			return ''
		}

		String value =
				sanitizeFileName(
				exportLabel
				)

		value = value.replaceFirst(
				'(?i)^REC_',
				''
				)

		value = value.replaceFirst(
				'(?i)^PRD_',
				''
				)

		value = value.replaceFirst(
				'(?i)^REC-',
				''
				)

		value = value.replaceFirst(
				'(?i)^PRD-',
				''
				)

		value = value.replaceFirst(
				'(?i)^REC ',
				''
				)

		value = value.replaceFirst(
				'(?i)^PRD ',
				''
				)

		return value == null ||
				value.trim().isEmpty()
				? ''
				: value
	}


	private String resolveEnvironmentName(
			String targetEnvironment,
			String exportLabel) {

		String environment =
				normalizeEnvironmentNameStrict(
				targetEnvironment
				)

		if (environment != null) {
			return environment
		}

		List<String> globalVariableNames = [
			'targetEnvironment',
			'currentEnvironment',
			'environment',
			'env',
			'ENV',
			'currentEnv',
			'environmentName'
		]

		for (String variableName : globalVariableNames) {

			environment = normalizeEnvironmentNameStrict(
					getGlobalVariableValue(
					variableName
					)
					)

			if (environment != null) {
				return environment
			}
		}

		environment = normalizeEnvironmentNameStrict(
				RunConfiguration.getExecutionProfile()
				)

		if (environment != null) {
			return environment
		}

		environment = normalizeEnvironmentNameStrict(
				exportLabel
				)

		return environment == null
				? 'REC'
				: environment
	}


	private String normalizeEnvironmentNameStrict(
			String rawEnvironment) {

		if (rawEnvironment == null ||
				rawEnvironment.trim().isEmpty()) {

			return null
		}

		String value =
				rawEnvironment
				.trim()
				.toUpperCase()

		if (value == 'PRD' ||
				value == 'PROD' ||
				value == 'PRODUCTION' ||
				value.startsWith('PRD_') ||
				value.startsWith('PRD-') ||
				value.startsWith('PRD ')) {

			return 'PRD'
		}

		if (value == 'REC' ||
				value == 'RECETTE' ||
				value.startsWith('REC_') ||
				value.startsWith('REC-') ||
				value.startsWith('REC ')) {

			return 'REC'
		}

		return null
	}


	private String getGlobalVariableValue(
			String variableName) {

		try {
			def value =
					GlobalVariable."${variableName}"

			if (value != null &&
					!value
					.toString()
					.trim()
					.isEmpty()) {

				return value.toString()
			}
		} catch (Exception ignored) {
		}

		return null
	}


