	@Keyword
	void createFavoriteFromCurrentModule(
			String favoriteTitle,
			Integer controlTimeoutSeconds,
			Integer popupTimeoutSeconds
	) {

		Integer controlTimeout = actionTimeout(controlTimeoutSeconds)
		Integer popupTimeout = actionTimeout(popupTimeoutSeconds)

		String cleanFavoriteTitle = safeText(favoriteTitle)

		if (cleanFavoriteTitle.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Favorite title is empty.'
					)

			return
		}

		logStep(
				'CREATE FAVORITE',
				'Favorite title: ' + cleanFavoriteTitle + '\n' +
				'Required action timeout: ' + controlTimeout + ' seconds\n' +
				'Confirmation timeout: ' + popupTimeout + ' seconds'
				)

		Windows.delay(2)

		KeywordUtil.logInfo(
				'[FAVORITE][01] Searching Create Favorite image.'
				)

		boolean createFavoriteClicked =
				clickFirstVisibleImage(
				GENERAL_IMAGE_GROUP,
				[
					'createFavoriteIcon'
				],
				controlTimeout
				)

		if (!createFavoriteClicked) {
			takeEvidence(
					'GUI_CreateFavoriteImageNotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					'Create Favorite image was not found within ' +
					controlTimeout +
					' seconds.\n' +
					'Image group: ' + GENERAL_IMAGE_GROUP + '\n' +
					'Image key: createFavoriteIcon\n' +
					'Expected file: Images/General/icomFavorite.png'
					)

			return
		}

		KeywordUtil.logInfo(
				'[FAVORITE][02] Create Favorite image clicked.'
				)

		Windows.delay(1)

		KeywordUtil.logInfo(
				'[FAVORITE][03] Filling favorite title by image.\n' +
				'Image key: favoriteFilterField\n' +
				'Title: ' + cleanFavoriteTitle
				)

		typeOnImage(
				GUI_IMAGE_GROUP,
				'favoriteFilterField',
				cleanFavoriteTitle,
				controlTimeout
				)

		Windows.delay(1)

		KeywordUtil.logInfo(
				'[FAVORITE][04] Searching Save Favorite image.'
				)

		boolean saveFavoriteClicked =
				clickFirstVisibleImage(
				GENERAL_IMAGE_GROUP,
				[
					'saveFavoriteIcon'
				],
				controlTimeout
				)

		if (saveFavoriteClicked) {
			KeywordUtil.logInfo(
					'[FAVORITE][05] Save Favorite clicked by image.'
					)
		} else {
			KeywordUtil.logInfo(
					'[FAVORITE][05] Save Favorite image was not found.\n' +
					'Using keyboard fallback: TAB + ENTER.'
					)

			takeEvidence(
					'GUI_SaveFavoriteImageNotFound_UsingKeyboard.png'
					)

			pressKeyboardKey(
					KeyEvent.VK_TAB
					)

			Windows.delay(1)

			pressKeyboardKey(
					KeyEvent.VK_ENTER
					)

			KeywordUtil.logInfo(
					'[FAVORITE][06] TAB + ENTER fallback completed.'
					)
		}

		KeywordUtil.logInfo(
				'[FAVORITE][07] Waiting for favorite confirmation modal.'
				)

		String confirmationDetection =
				waitForFavoriteConfirmation(
				cleanFavoriteTitle,
				popupTimeout
				)

		if (confirmationDetection.isEmpty()) {
			takeEvidence(
					'GUI_FavoriteConfirmationModalNotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					'Favorite confirmation modal was not found within ' +
					popupTimeout +
					' seconds.\n' +
					'Favorite: ' + cleanFavoriteTitle + '\n' +
					'Save method: ' +
					(saveFavoriteClicked ? 'image' : 'TAB + ENTER')
					)

			return
		}

		takeEvidence(
				'GUI_FavoriteConfirmationModal.png'
				)

		KeywordUtil.logInfo(
				'[FAVORITE][08] Confirmation modal detected by: ' +
				confirmationDetection
				)

		boolean confirmationClosed =
				clickFirstVisibleImage(
				GENERAL_IMAGE_GROUP,
				[
					'okModal',
					'okModal2Version'
				],
				controlTimeout
				)

		if (!confirmationClosed) {
			KeywordUtil.logInfo(
					'[FAVORITE][09] OK image was not found.\n' +
					'Pressing ENTER.'
					)

			pressKeyboardKey(
					KeyEvent.VK_ENTER
					)
		} else {
			KeywordUtil.logInfo(
					'[FAVORITE][09] Confirmation closed by OK image.'
					)
		}

		boolean modalClosed =
				waitForFavoriteConfirmationToDisappear(
				cleanFavoriteTitle,
				controlTimeout
				)

		if (!modalClosed) {
			takeEvidence(
					'GUI_FavoriteConfirmationModalStillOpen.png'
					)

			KeywordUtil.markFailedAndStop(
					'Favorite confirmation modal is still open after ' +
					controlTimeout +
					' seconds.\n' +
					'Favorite: ' + cleanFavoriteTitle
					)

			return
		}

		Windows.delay(2)

		KeywordUtil.markPassed(
				'Favorite created successfully.\n' +
				'Title: ' + cleanFavoriteTitle + '\n' +
				'Save method: ' +
					(saveFavoriteClicked ? 'image' : 'TAB + ENTER') + '\n' +
				'Confirmation detected by: ' + confirmationDetection
				)
	}


	// ======================================================
	// OPEN FAVORITE
	// ======================================================

	@Keyword
	void closeAllTabsAndOpenFavorite(
			String favoriteTitle,
			String openedTabName,
			String favoriteImageKey,
			Integer timeoutSeconds
	) {

		Integer timeout = actionTimeout(timeoutSeconds)

		String cleanFavoriteTitle = safeText(favoriteTitle)
		String cleanOpenedTabName = safeText(openedTabName)
		String cleanFavoriteImageKey = safeText(favoriteImageKey)

		if (cleanFavoriteTitle.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Favorite title is empty.'
					)

			return
		}

		if (cleanOpenedTabName.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Expected opened tab name is empty.'
					)

			return
		}

		logStep(
				'OPEN FAVORITE',
				'Favorite: ' + cleanFavoriteTitle + '\n' +
				'Expected tab: ' + cleanOpenedTabName + '\n' +
				'Action timeout: ' + timeout + ' seconds'
				)

		closeAllTabsAndConfirm(
				cleanOpenedTabName,
				timeout,
				true
				)

		clickRequiredObject(
				'favoritesTab',
				'Favorites tab',
				timeout,
				'GUI_FavoritesTabNotFound.png'
				)

		Windows.delay(2)

		WindowsTestObject favoriteItem =
				WindowsObjectLoader.getTreeItemByName(
				cleanFavoriteTitle
				)

		KeywordUtil.logInfo(
				'[OPEN FAVORITE] Searching favorite by element.\n' +
				'Favorite: ' + cleanFavoriteTitle
				)

		long searchDeadline =
				System.currentTimeMillis() +
				(timeout * 1000L)

		Integer elementTimeout =
				Math.max(
				1,
				Math.min(
				5,
				timeout
				)
				)

		boolean favoriteFoundByElement =
				Windows.waitForElementPresent(
				favoriteItem,
				elementTimeout,
				FailureHandling.OPTIONAL
				)

		boolean favoriteOpenedByImage = false

		if (favoriteFoundByElement) {
			KeywordUtil.logInfo(
					'[OPEN FAVORITE] Favorite found by element. Clicking.'
					)

			Windows.click(
					favoriteItem,
					FailureHandling.STOP_ON_FAILURE
					)
		} else {
			Integer remainingSeconds =
					remainingSeconds(
					searchDeadline
					)

			if (
			remainingSeconds > 0 &&
					!cleanFavoriteImageKey.isEmpty()
					) {
				KeywordUtil.logInfo(
						'[OPEN FAVORITE] Favorite element was not found.\n' +
						'Trying image fallback.\n' +
						'Image key: ' + cleanFavoriteImageKey
						)

				favoriteOpenedByImage =
						clickFirstVisibleImage(
						GUI_IMAGE_GROUP,
						[
							cleanFavoriteImageKey
						],
						remainingSeconds
						)
			}
		}

		if (!favoriteFoundByElement && !favoriteOpenedByImage) {
			takeEvidence(
					'GUI_CreatedFavoriteNotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					'Created favorite was not found within ' +
					timeout +
					' seconds.\n' +
					'Favorite: ' + cleanFavoriteTitle + '\n' +
					'Image key: ' + cleanFavoriteImageKey
					)

			return
		}

		WindowsTestObject openedTab =
				WindowsObjectLoader.getTabByName(
				cleanOpenedTabName
				)

		KeywordUtil.logInfo(
				'[OPEN FAVORITE] Waiting for expected tab.\n' +
				'Tab: ' + cleanOpenedTabName + '\n' +
				'Timeout: ' + timeout + ' seconds'
				)

		boolean favoriteOpened =
				Windows.waitForElementPresent(
				openedTab,
				timeout,
				FailureHandling.OPTIONAL
				)

		if (!favoriteOpened) {
			takeEvidence(
					'GUI_CreatedFavoriteTabNotOpened.png'
					)

			KeywordUtil.markFailedAndStop(
					'Favorite was selected, but the expected tab did not open within ' +
					timeout +
					' seconds.\n' +
					'Favorite: ' + cleanFavoriteTitle + '\n' +
					'Expected tab: ' + cleanOpenedTabName
					)

			return
		}

		Windows.delay(2)

		takeEvidence(
				'GUI_CreatedFavoriteOpened.png'
				)

		KeywordUtil.markPassed(
				'Created favorite opened successfully.\n' +
				'Favorite: ' + cleanFavoriteTitle + '\n' +
				'Tab: ' + cleanOpenedTabName
				)
	}


	// ======================================================
	// DELETE FAVORITE
	// ======================================================

	@Keyword
	void deleteCreatedFavorite(
			String favoriteTitle,
			String favoriteImageKey
	) {

		Integer timeout = REQUIRED_ACTION_TIMEOUT

		String cleanFavoriteTitle = safeText(favoriteTitle)
		String cleanFavoriteImageKey = safeText(favoriteImageKey)

		if (cleanFavoriteTitle.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Favorite title is empty.'
					)

			return
		}

		if (cleanFavoriteImageKey.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Favorite image key is empty.\n' +
					'Favorite: ' + cleanFavoriteTitle
					)

			return
		}

		logStep(
				'DELETE FAVORITE',
				'Favorite: ' + cleanFavoriteTitle + '\n' +
				'Favorite image key: ' + cleanFavoriteImageKey + '\n' +
				'Action timeout: ' + timeout + ' seconds'
				)

		String favoriteImagePath =
				optionalImage(
				GUI_IMAGE_GROUP,
				cleanFavoriteImageKey
				)

		String deleteFavoriteImagePath =
				optionalImage(
				GUI_IMAGE_GROUP,
				'deleteFavoriteBtn'
				)

		if (favoriteImagePath.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Favorite image file was not found in ImageLoader.\n' +
					'Favorite: ' + cleanFavoriteTitle + '\n' +
					'Image key: ' + cleanFavoriteImageKey
					)

			return
		}

		if (deleteFavoriteImagePath.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Delete Favorite image file was not found in ImageLoader.\n' +
					'Image key: deleteFavoriteBtn'
					)

			return
		}

		closeAllTabsAndConfirm(
				'',
				timeout,
				false
				)

		clickRequiredObject(
				'favoritesTab',
				'Favorites tab',
				timeout,
				'GUI_FavoritesTabNotFoundForDelete.png'
				)

		Windows.delay(2)

		KeywordUtil.logInfo(
				'[DELETE FAVORITE] Searching favorite image for right click.\n' +
				'Favorite: ' + cleanFavoriteTitle + '\n' +
				'Timeout: ' + timeout + ' seconds'
				)

		boolean favoriteRightClicked =
				rightClickImageWithinTimeout(
				favoriteImagePath,
				timeout
				)

		if (!favoriteRightClicked) {
			takeEvidence(
					'GUI_FavoriteNotFoundForDelete.png'
					)

			KeywordUtil.markFailedAndStop(
					'Favorite image was not found for right click within ' +
					timeout +
					' seconds.\n' +
					'Favorite: ' + cleanFavoriteTitle + '\n' +
					'Image key: ' + cleanFavoriteImageKey
					)

			return
		}

		Windows.delay(1)

		KeywordUtil.logInfo(
				'[DELETE FAVORITE] Searching Supprimer le favori image.'
				)

		boolean deleteFavoriteClicked =
				clickFirstVisibleImage(
				GUI_IMAGE_GROUP,
				[
					'deleteFavoriteBtn'
				],
				timeout
				)

		if (!deleteFavoriteClicked) {
			takeEvidence(
					'GUI_DeleteFavoriteButtonNotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					'Supprimer le favori image was not found within ' +
