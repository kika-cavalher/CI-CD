	private void clickImageOrStop(String relativePath) {
		String imagePath = resolveProjectPath(relativePath)

		try {
			WindowsImageKeywords.clickImage(imagePath)
		} catch (Throwable error) {
			KeywordUtil.markFailedAndStop(
				'Image could not be clicked.\n' +
				'Image: ' + relativePath + '\n' +
				'Reason: ' + safeText(error.message)
			)
		}
	}

	private void rightClickImageOrStop(String relativePath) {
		String imagePath = resolveProjectPath(relativePath)

		try {
			WindowsImageKeywords.rightClickImage(imagePath)
		} catch (Throwable error) {
			KeywordUtil.markFailedAndStop(
				'Image could not be right clicked.\n' +
				'Image: ' + relativePath + '\n' +
				'Reason: ' + safeText(error.message)
			)
		}
	}

	private void typeOnImageOrStop(
		String relativePath,
		String text
	) {
		String imagePath = resolveProjectPath(relativePath)

		try {
			WindowsImageKeywords.typeOnImage(
				imagePath,
				text
			)
		} catch (Throwable error) {
			KeywordUtil.markFailedAndStop(
				'Text could not be entered using the image.\n' +
				'Image: ' + relativePath + '\n' +
				'Text: ' + text + '\n' +
				'Reason: ' + safeText(error.message)
			)
		}
	}

	private boolean isImageVisible(String relativePath) {
		String imagePath = resolveProjectPath(relativePath)

		try {
			def found = WindowsImageKeywords.findImage(imagePath)
			return found != null && found != false
		} catch (Throwable ignored) {
			return false
		}
	}

	private String resolveProjectPath(String relativePath) {
		String cleanPath = safeText(relativePath)

		if (cleanPath.isEmpty()) {
			KeywordUtil.markFailedAndStop('Image relative path is empty.')
		}

		File imageFile = new File(
			RunConfiguration.getProjectDir(),
			cleanPath
		)

		if (!imageFile.exists() || !imageFile.isFile()) {
			KeywordUtil.markFailedAndStop(
				'Image file was not found.\n' +
				'Relative path: ' + cleanPath + '\n' +
				'Resolved path: ' + imageFile.getAbsolutePath()
			)
		}

		return imageFile.getAbsolutePath()
	}


