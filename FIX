1) File do projeto Katalon

Crie no projeto um file assim:

jenkins/ArchiveMode.groovy

Cole este conteúdo:

def CONFIG = [
    JOB_LABEL             : 'Archive Mode',
    TEST_SUITE_COLLECTION : 'Test Suites/Archive Mode/Archive Mode Collection',
    EXECUTION_PROFILE     : 'default',
    BROWSER_TYPE          : 'Windows',
    STARTER_DIR           : 'D:\\Projects\\eMatchStarters',
    GENERIC_TASK          : '\\eMatch Automation\\RunEMatchCommand',
    WIN_DRIVER_TASK       : 'startWinDriver',
    LOG_TAIL_LINES        : '30',
    WAIT_SECONDS          : '5',
    MAX_WAIT_CYCLES       : '720'
]

def run() {
    stage("Prepare ${CONFIG.JOB_LABEL}") {
        bat """
@echo off
setlocal EnableExtensions

if not exist "${CONFIG.STARTER_DIR}\\logs" mkdir "${CONFIG.STARTER_DIR}\\logs"

> "${CONFIG.STARTER_DIR}\\run-context.properties" (
    echo JOB_LABEL=${CONFIG.JOB_LABEL}
    echo TEST_SUITE_COLLECTION=${CONFIG.TEST_SUITE_COLLECTION}
    echo EXECUTION_PROFILE=${CONFIG.EXECUTION_PROFILE}
    echo BROWSER_TYPE=${CONFIG.BROWSER_TYPE}
    echo WORKSPACE=%WORKSPACE%
    echo STARTER_DIR=${CONFIG.STARTER_DIR}
    echo KATALON_HOME=C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0
)

> "${CONFIG.STARTER_DIR}\\run-result.properties" (
    echo STATUS=QUEUED
    echo EXIT_CODE=999
)

echo ========================================
echo [INFO] JOB_LABEL=${CONFIG.JOB_LABEL}
echo [INFO] TEST_SUITE_COLLECTION=${CONFIG.TEST_SUITE_COLLECTION}
echo [INFO] WORKSPACE=%WORKSPACE%
echo ========================================
type "${CONFIG.STARTER_DIR}\\run-context.properties"
"""
    }

    stage("Execute ${CONFIG.JOB_LABEL}") {
        bat """
@echo off
setlocal EnableExtensions EnableDelayedExpansion

echo [INFO] Starting WinAppDriver task...
schtasks /run /tn "${CONFIG.WIN_DRIVER_TASK}"
if errorlevel 1 exit /b 1

echo [INFO] Starting visible Katalon task...
schtasks /run /tn "${CONFIG.GENERIC_TASK}"
if errorlevel 1 (
    schtasks /end /tn "${CONFIG.WIN_DRIVER_TASK}" >nul 2>nul
    exit /b 1
)

echo [INFO] Waiting for task to finish...
set /a WAIT_COUNT=0

:waitLoop
set "TASK_STATUS="
for /f "tokens=2 delims=: " %%A in ('schtasks /query /tn "${CONFIG.GENERIC_TASK}" /fo list ^| findstr /b /c:"Status:"') do set "TASK_STATUS=%%A"

if /i "!TASK_STATUS!"=="Running" (
    set /a WAIT_COUNT+=1
    echo [INFO] ${CONFIG.JOB_LABEL} running... cycle !WAIT_COUNT!

    if !WAIT_COUNT! GEQ ${CONFIG.MAX_WAIT_CYCLES} (
        echo [ERROR] Timeout waiting task ${CONFIG.GENERIC_TASK}
        schtasks /end /tn "${CONFIG.GENERIC_TASK}" >nul 2>nul
        schtasks /end /tn "${CONFIG.WIN_DRIVER_TASK}" >nul 2>nul
        exit /b 1
    )

    timeout /t ${CONFIG.WAIT_SECONDS} /nobreak >nul
    goto waitLoop
)

echo [INFO] Task finished. Closing WinAppDriver task...
schtasks /end /tn "${CONFIG.WIN_DRIVER_TASK}" >nul 2>nul

echo [INFO] Task Scheduler result:
schtasks /query /tn "${CONFIG.GENERIC_TASK}" /fo list | findstr /b /c:"Last Run Time:" /c:"Last Result:"
"""
    }

    stage("Validate ${CONFIG.JOB_LABEL}") {
        def resultText = bat(
            returnStdout: true,
            script: """
@echo off
if exist "${CONFIG.STARTER_DIR}\\run-result.properties" (
    type "${CONFIG.STARTER_DIR}\\run-result.properties"
) else (
    echo STATUS=MISSING
    echo EXIT_CODE=1
)
"""
        ).trim()

        echo resultText

        def exitCodeLine = resultText.readLines().find { it.trim().startsWith('EXIT_CODE=') } ?: 'EXIT_CODE=1'
        def exitCode = exitCodeLine.split('=', 2)[1].trim()

        if (exitCode != '0') {
            error("${CONFIG.JOB_LABEL} failed with exit code ${exitCode}")
        }
    }

    stage("Tail log ${CONFIG.JOB_LABEL}") {
        bat """
@echo off
if exist "${CONFIG.STARTER_DIR}\\logs\\run-ematch-command.log" (
    echo ========================================
    echo [INFO] Last ${CONFIG.LOG_TAIL_LINES} lines
    echo ========================================
    powershell -NoProfile -Command "Get-Content -Path '${CONFIG.STARTER_DIR}\\logs\\run-ematch-command.log' -Tail ${CONFIG.LOG_TAIL_LINES}"
)
"""
    }
}

return this
2) Como chamar no Jenkins

No Jenkins, você deixa só isso:

stage('Archive Mode') {
    steps {
        script {
            load("${env.WORKSPACE}\\jenkins\\ArchiveMode.groovy").run()
        }
    }
}

Se quiser copiar para outra suite depois, é só duplicar o file e trocar isso no topo:

JOB_LABEL             : 'Archive Mode',
TEST_SUITE_COLLECTION : 'Test Suites/Archive Mode/Archive Mode Collection',
3) Bat genérico

Agora crie este arquivo no servidor:

D:\Projects\eMatchStarters\run-ematch-command.bat

Conteúdo:

@echo off
setlocal EnableExtensions EnableDelayedExpansion

set "BASE_DIR=D:\Projects\eMatchStarters"
set "LOG_DIR=%BASE_DIR%\logs"
set "CTX_FILE=%BASE_DIR%\run-context.properties"
set "RESULT_FILE=%BASE_DIR%\run-result.properties"
set "LOG_FILE=%LOG_DIR%\run-ematch-command.log"

if not exist "%LOG_DIR%" mkdir "%LOG_DIR%"

call :writeResult RUNNING 999
call :log [INFO] ==========================================
call :log [INFO] Starting run-ematch-command.bat

if not exist "%CTX_FILE%" (
    call :log [ERROR] Context file not found: %CTX_FILE%
    call :finish 1
)

for /f "usebackq tokens=1* delims==" %%A in ("%CTX_FILE%") do (
    if not "%%~A"=="" set "%%~A=%%~B"
)

if not defined WORKSPACE (
    call :log [ERROR] WORKSPACE not informed in context file.
    call :finish 1
)

if not defined TEST_SUITE_COLLECTION (
    call :log [ERROR] TEST_SUITE_COLLECTION not informed in context file.
    call :finish 1
)

if not defined KATALON_HOME set "KATALON_HOME=C:\Users\adgi5appjenkins\Documents\Katalon_Studio_Engine_Windows_64-8.1.0"
if not defined BROWSER_TYPE set "BROWSER_TYPE=Windows"
if not defined EXECUTION_PROFILE set "EXECUTION_PROFILE=default"

set "PROJECT_FILE="
for %%I in ("%WORKSPACE%\*.prj") do (
    set "PROJECT_FILE=%%~fI"
    goto :projectFound
)

:projectFound
if not defined PROJECT_FILE (
    call :log [ERROR] No .prj file found in: %WORKSPACE%
    call :finish 1
)

set "KATALON_EXE=%KATALON_HOME%\katalonc.exe"
if not exist "%KATALON_EXE%" (
    call :log [ERROR] Katalon executable not found: %KATALON_EXE%
    call :finish 1
)

call :log [INFO] JOB_LABEL=%JOB_LABEL%
call :log [INFO] WORKSPACE=%WORKSPACE%
call :log [INFO] PROJECT_FILE=%PROJECT_FILE%
call :log [INFO] TEST_SUITE_COLLECTION=%TEST_SUITE_COLLECTION%
call :log [INFO] EXECUTION_PROFILE=%EXECUTION_PROFILE%
call :log [INFO] BROWSER_TYPE=%BROWSER_TYPE%
call :log [INFO] Launching Katalon visible execution...

"%KATALON_EXE%" -noSplash -runMode=console -projectPath="%PROJECT_FILE%" -retry=0 -testSuiteCollectionPath="%TEST_SUITE_COLLECTION%" -executionProfile="%EXECUTION_PROFILE%" -browserType="%BROWSER_TYPE%"
set "EXIT_CODE=%ERRORLEVEL%"

call :log [INFO] Katalon finished with EXIT_CODE=%EXIT_CODE%
call :finish %EXIT_CODE%

:finish
set "FINAL_EXIT=%~1"
call :writeResult FINISHED %FINAL_EXIT%
call :log [INFO] Finished run-ematch-command.bat with EXIT_CODE=%FINAL_EXIT%
exit /b %FINAL_EXIT%

:writeResult
> "%RESULT_FILE%" (
    echo STATUS=%~1
    echo EXIT_CODE=%~2
    echo UPDATED_AT=%date% %time%
)
goto :eof

:log
echo %~1 %~2 %~3 %~4 %~5 %~6 %~7 %~8 %~9
>> "%LOG_FILE%" echo [%date% %time%] %~1 %~2 %~3 %~4 %~5 %~6 %~7 %~8 %~9
goto :eof
4) Task Schedule genérica

Crie ou ajuste a task:

\eMatch Automation\RunEMatchCommand

Na ação dela coloque:

Program/script

C:\Windows\System32\cmd.exe

Add arguments

/c "D:\Projects\eMatchStarters\run-ematch-command.bat"
5) Muito importante para abrir o app visível 👀

Isso aqui é obrigatório:

Na task RunEMatchCommand
Run only when user is logged on
usar o mesmo user da sessão remota visível
deixar desmarcado Hidden
manter Run with highest privileges

Se isso não estiver assim, o Jenkins pode rodar, mas o app continuar sem aparecer visualmente.
