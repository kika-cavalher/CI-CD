private File resolveFile(String path, String baseFolder) {
    String raw = safeValue(path)
    if (raw.isEmpty()) {
        return null
    }

    try {
        if (raw.toLowerCase(Locale.ENGLISH).startsWith('file:/')) {
            File uriFile = new File(new URI(raw))
            if (uriFile.exists()) {
                return uriFile
            }
        }
    } catch (Exception ignored) {
    }

    File direct = new File(raw)
    if (direct.exists()) {
        return direct
    }

    if (!safeValue(baseFolder).isEmpty()) {
        File byBase = new File(baseFolder, raw)
        if (byBase.exists()) {
            return byBase
        }
    }

    return direct
}
