    private static String safe(def value) {
        return value == null ? '' : value.toString().trim()
    }

    private static void sleepMs(long ms) {
        try {
            Thread.sleep(ms)
        } catch (Throwable ignored) {
        }
    }

    private static boolean fileExists(String path) {
        return safe(path) && new File(path).exists()
    }

    private static String normalizeTitle(String value) {
        String title = safe(value).replaceAll('\\s+', ' ').trim()
        title = title.replaceFirst('(?i)^ematch\\s+ematch\\s+', 'eMatch ')
        title = title.replaceFirst('(?i)^ematch\\s+', 'eMatch ')
        return title
    }

    private static boolean isRealEMatchTitle(String title, String expectedTitle) {
        String normalizedTitle = normalizeTitle(title)
        String normalizedExpected = normalizeTitle(expectedTitle)

        if (!normalizedTitle) {
            return false
        }

        String lower = normalizedTitle.toLowerCase()

        if (lower.contains('katalon')) return false
        if (lower.contains('chrome')) return false
        if (lower.contains('confluence')) return false
        if (lower.contains('workspace')) return false
        if (lower.contains('file:///')) return false

        if (normalizedTitle == normalizedExpected) {
            return true
        }

        return normalizedTitle ==~ /(?i)^eMatch\s+\d+\.\d+\.\d+\.\d+$/
    }

    private static String readEnv() {
        String env = ''
        try {
            env = safe(GlobalVariable.env)
        } catch (Throwable ignored) {
        }
        return env ? env.toUpperCase() : 'REC'
    }

    private static String runPowerShell(String script, int timeoutSeconds = 30) {
        try {
            Process process = new ProcessBuilder(
                'powershell',
                '-NoProfile',
                '-ExecutionPolicy', 'Bypass',
                '-Command',
                script
            ).redirectErrorStream(true).start()

            StringBuilder output = new StringBuilder()
            long end = System.currentTimeMillis() + (timeoutSeconds * 1000L)

            while (System.currentTimeMillis() < end) {
                while (process.inputStream.available() > 0) {
                    output.append((char) process.inputStream.read())
                }

                try {
                    process.exitValue()
                    while (process.inputStream.available() > 0) {
                        output.append((char) process.inputStream.read())
                    }
                    return output.toString().trim()
                } catch (IllegalThreadStateException ignored) {
                }

                sleepMs(200)
            }

            process.destroyForcibly()
            return output.toString().trim()
        } catch (Throwable t) {
            KeywordUtil.logInfo("PowerShell failed: ${safe(t.message)}")
            return ''
        }
    }

    private static void runDetached(String command) {
        try {
            new ProcessBuilder('cmd', '/c', command).start()
        } catch (Throwable t) {
            KeywordUtil.logInfo("Detached command failed: ${safe(t.message)}")
        }
    }

    private static boolean isPortOpen(String host, int port) {
        try {
            Socket socket = new Socket(host, port)
            socket.close()
            return true
        } catch (Throwable ignored) {
            return false
        }
    }

