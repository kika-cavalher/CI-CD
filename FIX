    private String buildChartsPanel(Map summary) {
        int total = toInt(summary.total)
        int passed = toInt(summary.passed)
        int failed = toInt(summary.failed)
        int skipped = toInt(summary.skipped)

        StringBuilder html = new StringBuilder()

        html.append('<section class="charts-main">')
        html.append('<div class="charts-header">Global Overview</div>')

        html.append('<div class="charts-grid">')

        html.append('<div class="charts-donut-card">')
        html.append('<div class="charts-donut" style="background:')
        html.append(buildDonutGradient(passed, failed, skipped, total))
        html.append(';">')
        html.append('<div class="charts-donut-center">')
        html.append('<div class="charts-donut-total">')
        html.append(total)
        html.append('</div>')
        html.append('<div class="charts-donut-label">Tests</div>')
        html.append('</div>')
        html.append('</div>')
        html.append('</div>')

        html.append('<div class="charts-stats">')
        html.append(buildMainBar('Passed', passed, total, 'passed'))
        html.append(buildMainBar('Failed', failed, total, 'failed'))
        html.append(buildMainBar('Skipped', skipped, total, 'skipped'))
        html.append('</div>')

        html.append('</div>')
        html.append('</section>')

        return html.toString()
    }

    private String buildMainBar(String label, int value, int total, String statusClass) {
        int percent = total > 0 ? Math.round((value * 100f) / total) : 0

        StringBuilder html = new StringBuilder()
        html.append('<div class="main-bar-card">')
        html.append('<div class="main-bar-top">')
        html.append('<span class="main-bar-label">')
        html.append(htmlEscape(label))
        html.append('</span>')
        html.append('<span class="main-bar-value">')
        html.append(value)
        html.append('</span>')
        html.append('</div>')
        html.append('<div class="main-bar-track">')
        html.append('<div class="main-bar-fill ')
        html.append(statusClass)
        html.append('" style="width:')
        html.append(percent)
        html.append('%;"></div>')
        html.append('</div>')
        html.append('<div class="main-bar-percent">')
        html.append(percent)
        html.append('% of execution</div>')
        html.append('</div>')
        return html.toString()
    }

    private String buildDonutGradient(int passed, int failed, int skipped, int total) {
        if (total <= 0) {
            return 'conic-gradient(#e8edf2 0deg 360deg)'
        }

        double passedDeg = (passed * 360d) / total
        double failedDeg = (failed * 360d) / total
        double skippedDeg = (skipped * 360d) / total

        double a = passedDeg
        double b = a + failedDeg
        double c = b + skippedDeg

        return "conic-gradient(${STATUS_PASS} 0deg ${a}deg, ${STATUS_FAIL} ${a}deg ${b}deg, ${STATUS_SKIP} ${b}deg ${c}deg, #e8edf2 ${c}deg 360deg)"
    }

