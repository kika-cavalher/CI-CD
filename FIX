    // ============================================================
    // XML RESOLUTION
    // ============================================================
    String findXmlFile(String reportFolder) {
        if (isBlank(reportFolder)) {
            return ''
        }

        File root = new File(reportFolder)
        if (!root.exists() || !root.isDirectory()) {
            return ''
        }

        List<File> preferred = []
        List<File> secondary = []
        List<File> fallback = []

        collectXmlFiles(root, preferred, secondary, fallback)

        if (!preferred.isEmpty()) {
            preferred.sort { a, b -> b.lastModified() <=> a.lastModified() }
            return preferred[0].absolutePath
        }

        if (!secondary.isEmpty()) {
            secondary.sort { a, b -> b.lastModified() <=> a.lastModified() }
            return secondary[0].absolutePath
        }

        if (!fallback.isEmpty()) {
            fallback.sort { a, b -> b.lastModified() <=> a.lastModified() }
            return fallback[0].absolutePath
        }

        return ''
    }

    void collectXmlFiles(File currentDir, List<File> preferred, List<File> secondary, List<File> fallback) {
        if (currentDir == null || !currentDir.exists() || !currentDir.isDirectory()) {
            return
        }

        File[] children = currentDir.listFiles()
        if (children == null) {
            return
        }

        for (File child : children) {
            if (child == null) {
                continue
            }

            if (child.isDirectory()) {
                collectXmlFiles(child, preferred, secondary, fallback)
                continue
            }

            String lowerName = safe(child.name).toLowerCase(Locale.ENGLISH)

            if (lowerName == safe(PRIMARY_XML_FILE_NAME).toLowerCase(Locale.ENGLISH)) {
                preferred << child
            } else if (lowerName == safe(SECONDARY_XML_FILE_NAME).toLowerCase(Locale.ENGLISH)) {
                secondary << child
            } else if (lowerName.endsWith('.xml')) {
                fallback << child
            }
        }
    }

    String resolveXmlPathForImport(String reportFolder, String suiteName, JiraReportBuilder reportBuilder) {
        String foundXml = findXmlFile(reportFolder)
        if (!isBlank(foundXml)) {
            KeywordUtil.logInfo("XML file found for Jira import: ${foundXml}")
            return foundXml
        }

        KeywordUtil.logInfo("No XML found immediately. Creating runtime XML from execution log.")
        String runtimeXml = reportBuilder.createRuntimeJUnitXmlFromKatalonLog(reportFolder, suiteName)

        if (!isBlank(runtimeXml) && new File(runtimeXml).exists()) {
            KeywordUtil.logInfo("Runtime XML created successfully: ${runtimeXml}")
            return runtimeXml
        }

        String fallbackXml = findXmlFile(reportFolder)
        if (!isBlank(fallbackXml)) {
            KeywordUtil.logInfo("Fallback XML found after runtime generation: ${fallbackXml}")
            return fallbackXml
        }

        return ''
    }

