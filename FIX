import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import org.openqa.selenium.Keys

import com.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import internal.GlobalVariable as GlobalVariable
import general.WinRetry



CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Verify set Username and version')



String currentUser = System.getProperty('user.name')



String ematchAppPath = System.getProperty('ematchAppPath')
if (ematchAppPath == null || ematchAppPath.trim() == '') {
	ematchAppPath = System.getenv('EMATCH_APP_PATH')
}
ematchAppPath = (ematchAppPath != null) ? ematchAppPath.trim() : ''



CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Runtime user.name = '${currentUser}'")
CustomKeywords.'jiraIntegration.JiraReportSteps.note'("GlobalVariable.username = '${GlobalVariable.username}'")
CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Resolved ematchAppPath = '${ematchAppPath}'")



if (ematchAppPath == '') {
	KeywordUtil.markFailedAndStop("ematchAppPath is EMPTY. Pass it from Jenkins using -DematchAppPath=\"...\" or set env var EMATCH_APP_PATH.")
}



try {

	if (currentUser == GlobalVariable.username) {

		String cmd = 'Powershell.exe -executionpolicy remotesigned -File D:\\setResolution.ps1'
		Runtime.getRuntime().exec(cmd)

		CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Starting eMatch with title using path: ${ematchAppPath}")

		Windows.startApplicationWithTitle(ematchAppPath, GlobalVariable.version)

	} else {

		String command = 'C:\\Program Files (x86)\\Windows Application Driver\\WinAppDriver.exe'
		ProcessBuilder builder = new ProcessBuilder(command).inheritIO()
		startWinAppDriver = builder.start()

		CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Starting eMatch using path: ${ematchAppPath}")

		Windows.startApplication(ematchAppPath)

	}

} catch (Exception e) {

	KeywordUtil.markFailed("Failed to start eMatch using ematchAppPath: ${ematchAppPath}")
	KeywordUtil.markFailed("Exception: ${e.getClass().getName()} - ${e.getMessage()}")

	throw e
}
