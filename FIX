	Map parseSuiteData(String xmlPath) {
		def xml = new XmlSlurper().parse(new File(xmlPath))

		String suiteName = getCurrentSuiteName()
		String startText = ''
		String endText = ''
		BigDecimal suiteTime = 0
		int executed = 0
		int passed = 0
		int failed = 0
		int skipped = 0

		List<Map> failedTests = []
		List<Map> passedTests = []

		List<File> images = getFailureImages(getResolvedReportPath())
		int imageIndex = 0

		def testcases = xml.depthFirst().findAll { it.name() == 'testcase' }

		executed = testcases.size()

		BigDecimal totalTime = 0
		for (def tc : testcases) {
			BigDecimal timeSeconds = 0
			try {
				timeSeconds = new BigDecimal((tc.@time?.text() ?: '0').trim())
			} catch (Exception ignored) {
				timeSeconds = 0
			}
			totalTime += timeSeconds
		}
		suiteTime = totalTime

		Date fileDate = new Date(new File(xmlPath).lastModified())
		endText = new SimpleDateFormat('EEE MMM dd HH:mm:ss z yyyy', Locale.ENGLISH).format(fileDate)
		startText = endText

		testcases.each { tc ->
			String className = tc.@classname?.text() ?: suiteName
			String testName = tc.@name?.text() ?: 'Unnamed test'

			BigDecimal timeSeconds = 0
			try {
				timeSeconds = new BigDecimal((tc.@time?.text() ?: '0').trim())
			} catch (Exception ignored) {
				timeSeconds = 0
			}

			def failureNode = tc.failure?.size() > 0 ? tc.failure[0] : null
			def errorNode = tc.error?.size() > 0 ? tc.error[0] : null
			def skippedNode = tc.skipped?.size() > 0 ? tc.skipped[0] : null

			if (failureNode != null || errorNode != null) {
				failed++

				def node = failureNode != null ? failureNode : errorNode
				String failureMessage = node.@message?.text() ?: 'Test failed'
				String stackTrace = node.text() ?: failureMessage

				String imageData = ''
				if (imageIndex < images.size()) {
					File img = images[imageIndex]
					String ext = img.name.toLowerCase().endsWith('.png') ? 'png' : 'jpeg'
					String base64 = img.bytes.encodeBase64().toString()
					imageData = "data:image/${ext};base64,${base64}"
					imageIndex++
				}

				failedTests.add([
					className     : className,
					testName      : testName,
					timeSeconds   : timeSeconds,
					failureMessage: failureMessage,
					stackTrace    : stackTrace,
					imageData     : imageData
				])
			} else if (skippedNode != null) {
				skipped++
			} else {
				passed++
				passedTests.add([
					className   : className,
					testName    : testName,
					timeSeconds : timeSeconds
				])
			}
		}

		return [
			suiteName  : suiteName,
			startText  : startText,
			endText    : endText,
			suiteTime  : suiteTime,
			executed   : executed,
			passed     : passed,
			failed     : failed,
			skipped    : skipped,
			failedTests: failedTests,
			passedTests: passedTests
		]
	}

