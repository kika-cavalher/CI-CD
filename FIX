/c D:\Projects\eMatchStarters\run-ematch-command.bat


@echo off
setlocal EnableExtensions EnableDelayedExpansion

title Run eMatch Desktop

set "PROJECT_PATH=D:\jenkins\work\workspace\GI5\eMatch_Regression\Archive Mode\eMatch POC.prj"
set "KATALON_EXE=C:\Users\adgi5appjenkins\Documents\Katalon_Studio_Engine_Windows_64-8.1.0\katalonc.exe"
set "TEST_SUITE_COLLECTION=Test Suites\Archive Mode\Archive Mode Collection"
set "BROWSER_TYPE=Windows"
set "RETRY=0"

echo ============================================================
echo [INFO] USERNAME      = %USERNAME%
echo [INFO] SESSIONNAME   = %SESSIONNAME%
echo [INFO] PROJECT_PATH  = %PROJECT_PATH%
echo [INFO] KATALON_EXE   = %KATALON_EXE%
echo [INFO] COLLECTION    = %TEST_SUITE_COLLECTION%
echo ============================================================
query user
echo ============================================================

if not exist "%KATALON_EXE%" (
    echo [ERROR] KATALON_EXE not found
    exit /b 1
)

if not exist "%PROJECT_PATH%" (
    echo [ERROR] PROJECT_PATH not found
    exit /b 1
)

cd /d "D:\Projects\eMatchStarters"

"%KATALON_EXE%" ^
-noSplash ^
-runMode=console ^
-projectPath="%PROJECT_PATH%" ^
-retry=%RETRY% ^
-testSuiteCollectionPath="%TEST_SUITE_COLLECTION%" ^
-browserType="%BROWSER_TYPE%"

set "EXITCODE=%ERRORLEVEL%"
echo [INFO] KATALON EXIT CODE = %EXITCODE%
exit /b %EXITCODE%
