@echo off
setlocal EnableExtensions EnableDelayedExpansion

set "CTX_FILE=D:\Projects\eMatchStarters\run-context.properties"

if not exist "%CTX_FILE%" (
    echo [ERROR] Context file not found: "%CTX_FILE%"
    exit /b 90
)

for /f "usebackq tokens=1,* delims==" %%A in ("%CTX_FILE%") do (
    set "K=%%A"
    set "V=%%B"

    if /I "!K!"=="WORKSPACE"                set "WORKSPACE=!V!"
    if /I "!K!"=="PROJECT_PATH"             set "PROJECT_PATH=!V!"
    if /I "!K!"=="KATALON_EXE"              set "KATALON_EXE=!V!"
    if /I "!K!"=="ASSET_TYPE"               set "ASSET_TYPE=!V!"
    if /I "!K!"=="ASSET_PATH"               set "ASSET_PATH=!V!"
    if /I "!K!"=="BROWSER_TYPE"             set "BROWSER_TYPE=!V!"
    if /I "!K!"=="RETRY"                    set "RETRY=!V!"
    if /I "!K!"=="REPORTS_DIR"              set "REPORTS_DIR=!V!"
    if /I "!K!"=="LOG_DIR"                  set "LOG_DIR=!V!"
    if /I "!K!"=="CURRENT_LOG_FILE"         set "CURRENT_LOG_FILE=!V!"
    if /I "!K!"=="MARKER_FILE"              set "MARKER_FILE=!V!"
    if /I "!K!"=="RUN_LABEL"                set "RUN_LABEL=!V!"
    if /I "!K!"=="RUNNER_WINDOW_TITLE"      set "RUNNER_WINDOW_TITLE=!V!"
    if /I "!K!"=="WINAPPDRIVER_EXE"         set "WINAPPDRIVER_EXE=!V!"
    if /I "!K!"=="AUTO_START_WINAPPDRIVER"  set "AUTO_START_WINAPPDRIVER=!V!"
    if /I "!K!"=="APP_EXE_PATH"             set "APP_EXE_PATH=!V!"
    if /I "!K!"=="APP_LNK_PATH"             set "APP_LNK_PATH=!V!"
)

if "%WORKSPACE%"=="" (
    echo [ERROR] WORKSPACE is empty
    exit /b 91
)

if "%PROJECT_PATH%"=="" (
    echo [ERROR] PROJECT_PATH is empty
    exit /b 92
)

if "%KATALON_EXE%"=="" (
    echo [ERROR] KATALON_EXE is empty
    exit /b 93
)

if "%ASSET_TYPE%"=="" (
    echo [ERROR] ASSET_TYPE is empty
    exit /b 94
)

if "%ASSET_PATH%"=="" (
    echo [ERROR] ASSET_PATH is empty
    exit /b 95
)

if "%MARKER_FILE%"=="" (
    echo [ERROR] MARKER_FILE is empty
    exit /b 96
)

if "%REPORTS_DIR%"=="" (
    set "REPORTS_DIR=%WORKSPACE%\Reports"
)

if "%LOG_DIR%"=="" (
    set "LOG_DIR=%REPORTS_DIR%\_desktop_logs"
)

if "%CURRENT_LOG_FILE%"=="" (
    set "CURRENT_LOG_FILE=%LOG_DIR%\katalon_current.log"
)

if "%BROWSER_TYPE%"=="" (
    set "BROWSER_TYPE=Windows"
)

if "%RETRY%"=="" (
    set "RETRY=0"
)

if "%RUN_LABEL%"=="" (
    set "RUN_LABEL=eMatch Desktop Run"
)

if "%RUNNER_WINDOW_TITLE%"=="" (
    set "RUNNER_WINDOW_TITLE=eMatch Runner"
)

if "%AUTO_START_WINAPPDRIVER%"=="" (
    set "AUTO_START_WINAPPDRIVER=true"
)

if "%WINAPPDRIVER_EXE%"=="" (
    set "WINAPPDRIVER_EXE=C:\Program Files (x86)\Windows Application Driver\WinAppDriver.exe"
)

for %%F in ("%REPORTS_DIR%") do (
    if not exist "%%~fF" mkdir "%%~fF" >nul 2>&1
)

for %%F in ("%LOG_DIR%") do (
    if not exist "%%~fF" mkdir "%%~fF" >nul 2>&1
)

for %%F in ("%MARKER_FILE%") do (
    if not exist "%%~dpF" mkdir "%%~dpF" >nul 2>&1
)

for %%F in ("%CURRENT_LOG_FILE%") do (
    if not exist "%%~dpF" mkdir "%%~dpF" >nul 2>&1
)

if exist "%MARKER_FILE%" del /f /q "%MARKER_FILE%" >nul 2>&1
if exist "%MARKER_FILE%.tmp" del /f /q "%MARKER_FILE%.tmp" >nul 2>&1
if exist "%CURRENT_LOG_FILE%" del /f /q "%CURRENT_LOG_FILE%" >nul 2>&1

type nul > "%CURRENT_LOG_FILE%"

for /f %%I in ('powershell -NoProfile -Command "Get-Date -Format yyyyMMdd_HHmmss"') do set "TS=%%I"
set "FINAL_LOG_FILE=%LOG_DIR%\katalon_%TS%.log"

title %RUNNER_WINDOW_TITLE%

call :appendlog ============================================================
call :appendlog eMatch Desktop Run
call :appendlog ============================================================
call :appendlog [INFO] RUN_LABEL       = "%RUN_LABEL%"
call :appendlog [INFO] WORKSPACE       = "%WORKSPACE%"
call :appendlog [INFO] PROJECT_PATH    = "%PROJECT_PATH%"
call :appendlog [INFO] KATALON_EXE     = "%KATALON_EXE%"
call :appendlog [INFO] ASSET_TYPE      = "%ASSET_TYPE%"
call :appendlog [INFO] ASSET_PATH      = "%ASSET_PATH%"
call :appendlog [INFO] BROWSER_TYPE    = "%BROWSER_TYPE%"
call :appendlog [INFO] RETRY           = "%RETRY%"
call :appendlog [INFO] REPORTS_DIR     = "%REPORTS_DIR%"
call :appendlog [INFO] CURRENT_LOG     = "%CURRENT_LOG_FILE%"
call :appendlog [INFO] FINAL_LOG       = "%FINAL_LOG_FILE%"
call :appendlog [INFO] MARKER_FILE     = "%MARKER_FILE%"
call :appendlog ============================================================
call :appendlog.

REM Minimize this runner window so it does not hide the app
powershell -NoProfile -ExecutionPolicy Bypass -Command ^
"$sig='[DllImport(\"user32.dll\")] public static extern bool ShowWindowAsync(IntPtr hWnd, int nCmdShow);'; Add-Type -MemberDefinition $sig -Name Win32Show -Namespace Native; $title='%RUNNER_WINDOW_TITLE%'; 1..15 | ForEach-Object { $p = Get-Process | Where-Object { $_.MainWindowTitle -eq $title } | Select-Object -First 1; if ($p) { [Native.Win32Show]::ShowWindowAsync($p.MainWindowHandle, 2) | Out-Null; break }; Start-Sleep -Milliseconds 200 }" >nul 2>&1

if /I "%AUTO_START_WINAPPDRIVER%"=="true" (
    powershell -NoProfile -ExecutionPolicy Bypass -Command ^
    "if (-not (Get-Process WinAppDriver -ErrorAction SilentlyContinue)) { if (Test-Path '%WINAPPDRIVER_EXE%') { Start-Process -FilePath '%WINAPPDRIVER_EXE%' -WindowStyle Minimized | Out-Null } }" >nul 2>&1

    call :appendlog [INFO] WinAppDriver check executed
) else (
    call :appendlog [INFO] AUTO_START_WINAPPDRIVER=false
)

REM Optional forced app opening before Katalon
if defined APP_EXE_PATH (
    if exist "%APP_EXE_PATH%" (
        call :appendlog [INFO] Opening app from APP_EXE_PATH...
        powershell -NoProfile -ExecutionPolicy Bypass -Command "Start-Process -FilePath '%APP_EXE_PATH%' -WindowStyle Normal | Out-Null" >nul 2>&1
        timeout /t 3 >nul
    ) else (
        call :appendlog [WARN] APP_EXE_PATH not found: "%APP_EXE_PATH%"
    )
)

if not defined APP_EXE_PATH if defined APP_LNK_PATH (
    if exist "%APP_LNK_PATH%" (
        call :appendlog [INFO] Opening app from APP_LNK_PATH...
        powershell -NoProfile -ExecutionPolicy Bypass -Command "Start-Process -FilePath '%APP_LNK_PATH%' -WindowStyle Normal | Out-Null" >nul 2>&1
        timeout /t 3 >nul
    ) else (
        call :appendlog [WARN] APP_LNK_PATH not found: "%APP_LNK_PATH%"
    )
)

cd /d "%WORKSPACE%"

if /I "%ASSET_TYPE%"=="COLLECTION" (
    call :appendlog [INFO] Running Katalon test suite collection...

    "%KATALON_EXE%" ^
      -noSplash ^
      -runMode=console ^
      -consoleLog ^
      -projectPath="%PROJECT_PATH%" ^
      -retry=%RETRY% ^
      -testSuiteCollectionPath="%ASSET_PATH%" ^
      -browserType="%BROWSER_TYPE%" ^
      -reportFolder="%REPORTS_DIR%" ^
      >> "%CURRENT_LOG_FILE%" 2>&1
) else (
    call :appendlog [INFO] Running Katalon test suite...

    "%KATALON_EXE%" ^
      -noSplash ^
      -runMode=console ^
      -consoleLog ^
      -projectPath="%PROJECT_PATH%" ^
      -retry=%RETRY% ^
      -testSuitePath="%ASSET_PATH%" ^
      -browserType="%BROWSER_TYPE%" ^
      -reportFolder="%REPORTS_DIR%" ^
      >> "%CURRENT_LOG_FILE%" 2>&1
)

set "EXITCODE=%ERRORLEVEL%"

copy /Y "%CURRENT_LOG_FILE%" "%FINAL_LOG_FILE%" >nul 2>&1

call :appendlog.
call :appendlog [INFO] Katalon ExitCode = %EXITCODE%
call :appendlog [INFO] Writing marker file...

(
    echo %EXITCODE%
) > "%MARKER_FILE%.tmp"

move /Y "%MARKER_FILE%.tmp" "%MARKER_FILE%" >nul 2>&1

call :appendlog [INFO] Marker file written: "%MARKER_FILE%"
call :appendlog [INFO] Final log saved   : "%FINAL_LOG_FILE%"
call :appendlog [INFO] Runner finished
call :appendlog.

endlocal & exit /b %EXITCODE%

:appendlog
echo %*
>> "%CURRENT_LOG_FILE%" echo %*
exit /b 0
