package keywords

import static com.kms.katalon.core.testobject.ObjectRepository.findTestObject

import java.nio.file.Files
import java.text.SimpleDateFormat
import java.util.zip.ZipEntry
import java.util.zip.ZipOutputStream

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webservice.keyword.WSBuiltInKeywords as WS

import groovy.io.FileType
import groovy.json.JsonOutput
import groovy.json.JsonSlurper

public class JiraIntegration {

    // =========================================================
    // CONFIGURATION
    // Update all values here
    // =========================================================

    String BASE_URL                     = 'https://your-jira-url-here'
    String ACCESS_TOKEN                 = 'your-token-here'
    String PROJECT_KEY                  = 'QA'
    String REPORT_BASE_PATH             = 'C:\\KatalonReports'
    String TEST_SUITE_NAME              = 'Regression'
    String TEST_PLAN_NAME               = 'Regression Test Plan'
    String ENVIRONMENT                  = 'QA'
    String LABELS                       = 'automation,regression'
    String EPIC_KEY                     = 'QA-100'
    String TRANSITION_ID                = '11'
    String XML_FILE_NAME_CONTAINS       = 'cucumber.xml'
    String EVIDENCE_FOLDER_NAME_CONTAINS = 'evidence'
    String ZIP_FILE_NAME                = 'Evidences.zip'

    // =========================================================
    // OBJECT REPOSITORY PATHS
    // Update these paths if your objects have different names
    // =========================================================

    String REQUEST_IMPORT_RESULTS        = 'Jira Integration/import Results'
    String REQUEST_GET_TEST_PLAN         = 'Jira Integration/Get Test Plan'
    String REQUEST_CREATE_TEST_PLAN      = 'Jira Integration/Create Test Plan'
    String REQUEST_UPDATE_TEST_PLAN      = 'Jira Integration/Update Test Plan'
    String REQUEST_UPDATE_TEST_EXECUTION = 'Jira Integration/Update Test Execution Name'
    String REQUEST_ADD_ATTACHMENT        = 'Jira Integration/Evidence attachment'
    String REQUEST_TRANSITION_STATUS     = 'Jira Integration/Transition Issue Status'

    // =========================================================
    // HELPER METHODS
    // =========================================================

    private File getLatestReportDirectory() {
        File reportDir = new File(REPORT_BASE_PATH)

        if (!reportDir.exists() || !reportDir.isDirectory()) {
            KeywordUtil.markFailed("Report base folder does not exist or is invalid: ${REPORT_BASE_PATH}")
            return null
        }

        File latestDir = reportDir.listFiles()
                ?.findAll { it.isDirectory() }
                ?.max { it.lastModified() }

        if (latestDir == null) {
            KeywordUtil.markFailed("No report subfolder was found in: ${REPORT_BASE_PATH}")
            return null
        }

        KeywordUtil.logInfo("Latest report folder found: ${latestDir.absolutePath}")
        return latestDir
    }

    private File getTestSuiteReportDirectory() {
        File latestReportDir = getLatestReportDirectory()
        if (latestReportDir == null) {
            return null
        }

        File testSuiteDir = new File(latestReportDir, TEST_SUITE_NAME)

        if (!testSuiteDir.exists() || !testSuiteDir.isDirectory()) {
            KeywordUtil.markFailed("Test suite folder was not found: ${testSuiteDir.absolutePath}")
            return null
        }

        KeywordUtil.logInfo("Test suite folder found: ${testSuiteDir.absolutePath}")
        return testSuiteDir
    }

    private String getXmlFilePath(File testSuiteDir) {
        if (testSuiteDir == null || !testSuiteDir.exists()) {
            KeywordUtil.markFailed("Test suite directory is null or does not exist.")
            return null
        }

        String xmlPath = null

        testSuiteDir.eachFileRecurse(FileType.FILES) { file ->
            KeywordUtil.logInfo("Found file: ${file.absolutePath}")

            if (file.name.toLowerCase().contains(XML_FILE_NAME_CONTAINS.toLowerCase())) {
                xmlPath = file.absolutePath
            }
        }

        if (xmlPath == null) {
            KeywordUtil.markFailed("No XML file containing '${XML_FILE_NAME_CONTAINS}' was found in: ${testSuiteDir.absolutePath}")
            return null
        }

        KeywordUtil.logInfo("XML file found: ${xmlPath}")
        return xmlPath
    }

    private List<String> importResults(String xmlPath) {
        if (xmlPath == null || xmlPath.trim().isEmpty()) {
            KeywordUtil.markFailed("XML path is empty.")
            return null
        }

        def response = WS.sendRequest(findTestObject(REQUEST_IMPORT_RESULTS, [
            ('filePath') : xmlPath,
            ('project')  : PROJECT_KEY,
            ('baseUrl')  : BASE_URL,
            ('token')    : ACCESS_TOKEN
        ]))

        int status = WS.getResponseStatusCode(response)
        String body = response.getResponseBodyContent()

        KeywordUtil.logInfo("Import Results status: ${status}")
        KeywordUtil.logInfo("Import Results response: ${body}")

        if (!(status in [200, 204])) {
            KeywordUtil.markFailed("Failed to import results into Jira. Status: ${status}")
            return null
        }

        def parsedJson = new JsonSlurper().parseText(body)

        if (parsedJson?.testExecIssue?.key == null) {
            KeywordUtil.markFailed("Response did not return testExecIssue.key")
            return null
        }

        List<String> testExecKeys = [parsedJson.testExecIssue.key.toString()]
        KeywordUtil.logInfo("Created Test Execution key: ${testExecKeys}")
        return testExecKeys
    }

    private String getOrCreateTestPlan() {
        if (TEST_PLAN_NAME == null || TEST_PLAN_NAME.trim().isEmpty()) {
            KeywordUtil.markFailed("TEST_PLAN_NAME is empty.")
            return null
        }

        String escapedSummary = TEST_PLAN_NAME.replace("[", "\\\\[").replace("]", "\\\\]")

        def response = WS.sendRequest(findTestObject(REQUEST_GET_TEST_PLAN, [
            ('project') : PROJECT_KEY,
            ('token')   : ACCESS_TOKEN,
            ('summary') : escapedSummary,
            ('parent')  : EPIC_KEY
        ]))

        int status = WS.getResponseStatusCode(response)
        String body = response.getResponseBodyContent()

        KeywordUtil.logInfo("Get Test Plan status: ${status}")
        KeywordUtil.logInfo("Get Test Plan response: ${body}")

        if (status != 200) {
            KeywordUtil.markFailed("Failed to search for Test Plan. Status: ${status}")
            return null
        }

        def parsedJson = new JsonSlurper().parseText(body)
        int total = parsedJson?.total ?: 0

        KeywordUtil.logInfo("Number of Test Plans found: ${total}")

        if (total == 0) {
            return createTestPlan()
        }

        if (total == 1) {
            String key = parsedJson.issues[0].key
            KeywordUtil.logInfo("Existing Test Plan found: ${key}")
            return key
        }

        KeywordUtil.markFailed("Multiple Test Plans were found with the same name: ${TEST_PLAN_NAME}")
        return null
    }

    private String createTestPlan() {
        def response = WS.sendRequest(findTestObject(REQUEST_CREATE_TEST_PLAN, [
            ('token')   : ACCESS_TOKEN,
            ('env')     : ENVIRONMENT,
            ('project') : PROJECT_KEY,
            ('summary') : TEST_PLAN_NAME,
            ('labels')  : LABELS,
            ('epic')    : EPIC_KEY
        ]))

        int status = WS.getResponseStatusCode(response)
        String body = response.getResponseBodyContent()

        KeywordUtil.logInfo("Create Test Plan status: ${status}")
        KeywordUtil.logInfo("Create Test Plan response: ${body}")

        if (status != 201) {
            KeywordUtil.markFailed("Failed to create Test Plan. Status: ${status}")
            return null
        }

        def parsedJson = new JsonSlurper().parseText(body)
        String key = parsedJson?.key

        if (key == null) {
            KeywordUtil.markFailed("Test Plan creation response did not return key.")
            return null
        }

        KeywordUtil.logInfo("Created Test Plan key: ${key}")
        return key
    }

    private boolean updateTestPlan(String testPlanKey, List<String> testExecKeys) {
        if (testPlanKey == null || testExecKeys == null || testExecKeys.isEmpty()) {
            KeywordUtil.markFailed("Cannot update Test Plan because required data is missing.")
            return false
        }

        def jsonBody = [
            addTestsToPlan: true,
            add           : testExecKeys
        ]

        String jsonBodyString = JsonOutput.toJson(jsonBody)

        def response = WS.sendRequest(findTestObject(REQUEST_UPDATE_TEST_PLAN, [
            ('token')       : ACCESS_TOKEN,
            ('testPlanKey') : testPlanKey,
            ('jsonBody')    : jsonBodyString
        ]))

        int status = WS.getResponseStatusCode(response)
        KeywordUtil.logInfo("Update Test Plan status: ${status}")

        if (status != 200) {
            KeywordUtil.markFailed("Failed to update Test Plan. Status: ${status}")
            return false
        }

        KeywordUtil.logInfo("Test Execution was added to Test Plan successfully.")
        return true
    }

    private boolean updateTestExecution(List<String> testExecKeys) {
        if (testExecKeys == null || testExecKeys.isEmpty()) {
            KeywordUtil.markFailed("Test Execution list is empty.")
            return false
        }

        String timestamp = new SimpleDateFormat("yyyy-MM-dd HH.mm.ss").format(new Date())
        String summary = "${TEST_PLAN_NAME} ${timestamp}"

        def response = WS.sendRequest(findTestObject(REQUEST_UPDATE_TEST_EXECUTION, [
            ('issueID') : testExecKeys[0],
            ('token')   : ACCESS_TOKEN,
            ('summary') : summary,
            ('labels')  : LABELS,
            ('env')     : ENVIRONMENT
        ]))

        int status = WS.getResponseStatusCode(response)
        String body = response.getResponseBodyContent()

        KeywordUtil.logInfo("Update Test Execution status: ${status}")
        KeywordUtil.logInfo("Update Test Execution response: ${body}")

        if (status != 204) {
            KeywordUtil.markFailed("Failed to update Test Execution. Status: ${status}")
            return false
        }

        KeywordUtil.logInfo("Test Execution updated successfully.")
        return true
    }

    private File zipEvidences(File testSuiteDir) {
        if (testSuiteDir == null || !testSuiteDir.exists()) {
            KeywordUtil.markFailed("Test suite folder does not exist for zip creation.")
            return null
        }

        File evidencesFolder = testSuiteDir.listFiles()?.find { file ->
            file.isDirectory() && file.name.toLowerCase().contains(EVIDENCE_FOLDER_NAME_CONTAINS.toLowerCase())
        }

        if (evidencesFolder == null) {
            KeywordUtil.markFailed("No evidence folder was found inside: ${testSuiteDir.absolutePath}")
            return null
        }

        File zipFile = new File(testSuiteDir, ZIP_FILE_NAME)
        ZipOutputStream output = new ZipOutputStream(new FileOutputStream(zipFile))

        evidencesFolder.eachFileRecurse(FileType.FILES) { file ->
            String relativePath = evidencesFolder.toPath().relativize(file.toPath()).toString().replace("\\", "/")
            KeywordUtil.logInfo("Adding file to zip: ${relativePath}")
            output.putNextEntry(new ZipEntry(relativePath))
            Files.copy(file.toPath(), output)
            output.closeEntry()
        }

        output.close()

        KeywordUtil.logInfo("Zip file created successfully: ${zipFile.absolutePath}")
        return zipFile
    }

    private boolean addAttachment(File zipFile, List<String> execIds) {
        if (zipFile == null || !zipFile.exists()) {
            KeywordUtil.markFailed("Zip file was not found for attachment.")
            return false
        }

        if (execIds == null || execIds.isEmpty()) {
            KeywordUtil.markFailed("Execution ID list is empty for attachment.")
            return false
        }

        def response = WS.sendRequest(findTestObject(REQUEST_ADD_ATTACHMENT, [
            ('token')     : ACCESS_TOKEN,
            ('evidences') : zipFile,
            ('execID')    : execIds[0]
        ]))

        int status = WS.getResponseStatusCode(response)
        String body = response.getResponseBodyContent()

        KeywordUtil.logInfo("Add Attachment status: ${status}")
        KeywordUtil.logInfo("Add Attachment response: ${body}")

        if (status != 200) {
            KeywordUtil.markFailed("Failed to attach evidence zip. Status: ${status}")
            return false
        }

        KeywordUtil.logInfo("Evidence zip attached successfully.")
        return true
    }

    private boolean updateIssueStatus(String issueKey) {
        if (issueKey == null || issueKey.trim().isEmpty()) {
            KeywordUtil.markFailed("Issue key is empty for status transition.")
            return false
        }

        def response = WS.sendRequest(findTestObject(REQUEST_TRANSITION_STATUS, [
            ('token')        : ACCESS_TOKEN,
            ('issueID')      : issueKey,
            ('transitionID') : TRANSITION_ID
        ]))

        int status = WS.getResponseStatusCode(response)
        String body = response.getResponseBodyContent()

        KeywordUtil.logInfo("Transition status for ${issueKey}: ${status}")
        KeywordUtil.logInfo("Transition response for ${issueKey}: ${body}")

        if (!(status in [200, 204])) {
            KeywordUtil.markFailed("Failed to transition issue ${issueKey}. Status: ${status}")
            return false
        }

        KeywordUtil.logInfo("Issue ${issueKey} status updated successfully.")
        return true
    }

    // =========================================================
    // MAIN FLOW
    // =========================================================

    @Keyword
    def jiraImport() {
        KeywordUtil.logInfo("Starting Jira integration...")

        File testSuiteDir = getTestSuiteReportDirectory()
        if (testSuiteDir == null) {
            return
        }

        String xmlPath = getXmlFilePath(testSuiteDir)
        if (xmlPath == null) {
            return
        }

        List<String> testExecKeys = importResults(xmlPath)
        if (testExecKeys == null || testExecKeys.isEmpty()) {
            return
        }

        String testPlanKey = getOrCreateTestPlan()
        if (testPlanKey == null) {
            return
        }

        if (!updateTestPlan(testPlanKey, testExecKeys)) {
            return
        }

        if (!updateTestExecution(testExecKeys)) {
            return
        }

        File zipFile = zipEvidences(testSuiteDir)
        if (zipFile == null) {
            return
        }

        if (!addAttachment(zipFile, testExecKeys)) {
            return
        }

        updateIssueStatus(testExecKeys[0])
        updateIssueStatus(testPlanKey)

        KeywordUtil.logInfo("Jira integration finished successfully.")
    }
}
