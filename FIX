    private String buildJavascript(String activeId) {
        String firstId = safeValue(activeId)

        return '''
            (function () {
                var tabs = document.querySelectorAll('.tab-button');
                var sidebarViews = document.querySelectorAll('.sidebar-view');
                var mainViews = document.querySelectorAll('.main-view');
                var scenarioItems = document.querySelectorAll('.scenario-item');
                var scenarioPanels = document.querySelectorAll('.scenario-panel');
                var search = document.getElementById('scenarioSearch');

                function activateScenario(id) {
                    scenarioItems.forEach(function (item) {
                        item.classList.toggle('active', item.getAttribute('data-scenario-id') === id);
                    });

                    scenarioPanels.forEach(function (panel) {
                        panel.classList.toggle('active', panel.getAttribute('data-panel-id') === id);
                    });
                }

                function activateTab(tabName) {
                    tabs.forEach(function (button) {
                        button.classList.toggle('active', button.getAttribute('data-tab') === tabName);
                    });

                    sidebarViews.forEach(function (view) {
                        view.classList.toggle('active', view.getAttribute('data-view') === tabName);
                    });

                    mainViews.forEach(function (view) {
                        view.classList.toggle('active', view.getAttribute('data-view') === tabName);
                    });
                }

                scenarioItems.forEach(function (item) {
                    item.addEventListener('click', function () {
                        activateScenario(item.getAttribute('data-scenario-id'));
                    });
                });

                tabs.forEach(function (button) {
                    button.addEventListener('click', function () {
                        activateTab(button.getAttribute('data-tab'));
                    });
                });

                if (search) {
                    search.addEventListener('input', function () {
                        var value = (search.value || '').toLowerCase();

                        scenarioItems.forEach(function (item) {
                            var text = (item.getAttribute('data-search') || '').toLowerCase();
                            var visible = value === '' || text.indexOf(value) >= 0;
                            item.style.display = visible ? '' : 'none';
                        });
                    });
                }

                activateTab('tests');
        ''' + (isBlank(firstId) ? '' : "activateScenario('${escapeForJs(firstId)}');") + '''
            })();
        '''
    }

    // =========================================================================
    // HELPERS
    // =========================================================================

    private String normalizeStatus(def value) {
        String status = safeValue(value).toLowerCase(Locale.ENGLISH)
        if (status == 'passed') {
            return 'passed'
        }
        if (status == 'failed') {
            return 'failed'
        }
        if (status == 'skipped') {
            return 'skipped'
        }
        return 'info'
    }

    private String capitalize(String value) {
        String text = safeValue(value)
        if (isBlank(text)) {
            return ''
        }
        return text.substring(0, 1).toUpperCase(Locale.ENGLISH) + text.substring(1)
    }

    private int toInt(def value) {
        try {
            return Integer.parseInt(safeValue(value))
        } catch (Exception ignored) {
            return 0
        }
    }

    private String oneLineText(def value, int size) {
        String text = safeValue(value)
        if (text.length() <= size) {
            return text
        }
        return text.substring(0, Math.max(0, size - 3)) + '...'
    }

    private String safeValue(def value) {
        return value == null ? '' : String.valueOf(value).trim()
    }

    private boolean isBlank(def value) {
        return safeValue(value).isEmpty()
    }

    private String htmlEscape(def value) {
        String text = safeValue(value)
        return text
            .replace('&', '&amp;')
            .replace('<', '&lt;')
            .replace('>', '&gt;')
            .replace('"', '&quot;')
            .replace("'", '&#39;')
    }

    private String escapeForJs(String value) {
        return safeValue(value)
            .replace('\\', '\\\\')
            .replace("'", "\\'")
    }
