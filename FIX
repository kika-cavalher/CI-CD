	@Keyword
	String getCurrentExportFolderPath(
			String targetEnvironment,
			String exportLabel) {

		String environment = resolveEnvironmentName(
				targetEnvironment,
				exportLabel
				)

		String collectionName = shortenFilePart(
				sanitizeFileName(
				resolveCurrentCollectionName()
				),
				MAX_COLLECTION_LENGTH
				)

		String featureName = shortenFilePart(
				sanitizeFileName(
				resolveCurrentFeatureName()
				),
				MAX_FEATURE_LENGTH
				)

		File exportDirectory = resolveShortExportDirectory(
				environment,
				collectionName,
				featureName
				)

		logInfo(
				'Current export folder resolved.\n' +
				'Environment: ' + environment + '\n' +
				'Collection: ' + collectionName + '\n' +
				'Feature: ' + featureName + '\n' +
				'Folder: ' + exportDirectory.getAbsolutePath()
				)

		return exportDirectory.getAbsolutePath()
	}


	@Keyword
	String findLatestExportedFilePath(
			String targetEnvironment,
			String exportLabel) {

		String environment = resolveEnvironmentName(
				targetEnvironment,
				exportLabel
				)

		String exportFolderPath = getCurrentExportFolderPath(
				targetEnvironment,
				exportLabel
				)

		File exportFolder = new File(
				exportFolderPath
				)

		if (!exportFolder.exists() ||
				!exportFolder.isDirectory()) {

			logInfo(
					'Export folder was not found. Folder: ' +
					exportFolderPath
					)

			return ''
		}

		String expectedSuffix = shortenFilePart(
				resolveExportLabelSuffixForFileName(
				exportLabel
				),
				MAX_LABEL_LENGTH
				)

		File[] folderFiles = exportFolder.listFiles()
		List<File> matchingFiles = []

		if (folderFiles != null) {
			for (File file : folderFiles) {

				if (file == null ||
						!file.exists() ||
						!file.isFile() ||
						file.length() <= 0 ||
						file.getName().startsWith('~$')) {

					continue
				}

				String lowerName =
						file.getName().toLowerCase()

				boolean excelFile =
						lowerName.endsWith('.xlsx') ||
						lowerName.endsWith('.xlsm') ||
						lowerName.endsWith('.xls')

				boolean environmentMatches =
						file.getName()
						.toUpperCase()
						.startsWith(
						environment +
							'_'
						)

				boolean suffixMatches =
						expectedSuffix == null ||
						expectedSuffix.trim().isEmpty() ||
						removeExcelExtension(
						file.getName()
						)
						.toLowerCase()
						.endsWith(
						'_' +
							expectedSuffix.toLowerCase()
						)

				if (excelFile &&
						environmentMatches &&
						suffixMatches) {

					matchingFiles.add(
							file
							)
				}
			}
		}

		if (matchingFiles.isEmpty()) {

			logInfo(
					'No exported file matched the expected values.\n' +
					'Environment: ' + environment + '\n' +
					'Export label: ' + safeLogText(exportLabel) + '\n' +
					'Expected suffix: ' + safeLogText(expectedSuffix) + '\n' +
					'Folder: ' + exportFolderPath
					)

			return ''
		}

		matchingFiles.sort {
			File first,
			File second ->

			second.lastModified() <=>
					first.lastModified()
		}

		File latestExportedFile =
				matchingFiles.first()

		logInfo(
				'Latest exported file resolved.\n' +
				'File: ' + latestExportedFile.getName() + '\n' +
				'Path: ' + latestExportedFile.getAbsolutePath() + '\n' +
				'Size bytes: ' + latestExportedFile.length()
				)

		return latestExportedFile.getAbsolutePath()
	}


	private void clickImageFirstThenObject(
			String buttonDescription,
			String imageKey,
			String objectKey) {

		long startedAt =
				System.currentTimeMillis()

		logInfo(
				'Searching for ' +
				buttonDescription +
				' button using image. Image key: ' +
				imageKey +
				'. Timeout: ' +
				IMAGE_BUTTON_TIMEOUT_SECONDS +
				' seconds.'
				)

		boolean imageFound = false

		try {
			imageFound = imageLoader.waitForImage(
					GENERAL_IMAGE_GROUP,
					imageKey,
					IMAGE_BUTTON_TIMEOUT_SECONDS
					)
		} catch (Exception exception) {

			logInfo(
					buttonDescription +
						' image search returned an exception. Trying Windows element. Message: ' +
						safeExceptionMessage(
						exception
						)
					)
		}

		if (imageFound) {

			imageLoader.clickImageOrStop(
					GENERAL_IMAGE_GROUP,
					imageKey
					)

			logInfo(
					buttonDescription +
						' button clicked using image. Elapsed milliseconds: ' +
						elapsedMilliseconds(
						startedAt
						)
					)

			return
		}

		logInfo(
				buttonDescription +
					' image was not found. Trying Windows object ' +
					objectKey +
					'. Timeout: ' +
					ELEMENT_BUTTON_TIMEOUT_SECONDS +
					' seconds.'
				)

		WindowsTestObject buttonObject =
				getRequiredWindowsObject(
				objectKey
				)

		boolean elementFound = false

		try {
			elementFound = Windows.verifyElementPresent(
					buttonObject,
					ELEMENT_BUTTON_TIMEOUT_SECONDS,
					FailureHandling.OPTIONAL
					)
		} catch (Exception exception) {

			imageLoader.takeEvidence(
					buttonDescription +
						'ElementVerificationError.png'
					)

			KeywordUtil.markFailedAndStop(
					buttonDescription +
						' element verification failed. Object key: ' +
						objectKey +
						'. Message: ' +
						safeExceptionMessage(
						exception
						)
					)

			return
		}

		if (!elementFound) {

			imageLoader.takeEvidence(
					buttonDescription +
						'ButtonNotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					buttonDescription +
						' button was not found using image or Windows object.\n' +
						'Image key: ' + imageKey + '\n' +
						'Object key: ' + objectKey
					)

			return
		}

		try {
			Windows.click(
					buttonObject
					)
		} catch (Exception exception) {

			imageLoader.takeEvidence(
					buttonDescription +
						'ButtonClickError.png'
					)

			KeywordUtil.markFailedAndStop(
					buttonDescription +
						' button was found but could not be clicked. Message: ' +
						safeExceptionMessage(
						exception
						)
					)

			return
		}

		logInfo(
				buttonDescription +
					' button clicked using Windows object. Elapsed milliseconds: ' +
					elapsedMilliseconds(
					startedAt
					)
				)
	}


	private File saveToShortExportFolder(
			String exportLabel,
			String targetEnvironment) {

		long startedAt =
				System.currentTimeMillis()

		String environment = resolveEnvironmentName(
				targetEnvironment,
				exportLabel
				)

		String collectionName = shortenFilePart(
				sanitizeFileName(
				resolveCurrentCollectionName()
				),
				MAX_COLLECTION_LENGTH
				)

		String featureName = shortenFilePart(
				sanitizeFileName(
				resolveCurrentFeatureName()
				),
				MAX_FEATURE_LENGTH
				)

		String exportLabelSuffix = shortenFilePart(
				resolveExportLabelSuffixForFileName(
				exportLabel
				),
				MAX_LABEL_LENGTH
				)

		File directory = resolveShortExportDirectory(
				environment,
				collectionName,
				featureName
				)

		if (!directory.exists()) {

			logInfo(
					'Export directory does not exist. Creating directory: ' +
					directory.getAbsolutePath()
					)

			boolean created =
					directory.mkdirs()

			if (!created &&
					!directory.exists()) {

				KeywordUtil.markFailedAndStop(
						'Could not create export directory. Directory: ' +
						directory.getAbsolutePath()
						)

				return null
			}
		}

		String fileName = buildAutomaticExportFileName(
				environment,
				featureName,
				exportLabelSuffix
				)

		File exportedFile = new File(
				directory,
				fileName
				)

		exportedFile = ensurePathIsShortEnough(
				exportedFile,
				environment,
				exportLabelSuffix
				)

		String exportDirectory =
				exportedFile
				.getParentFile()
				.getAbsolutePath()

		logInfo(
				'Save dialog configuration prepared.\n' +
				'Environment: ' + environment + '\n' +
				'Collection: ' + collectionName + '\n' +
				'Feature: ' + featureName + '\n' +
				'Export label: ' + exportLabelSuffix + '\n' +
				'Directory: ' + exportDirectory + '\n' +
				'File name: ' + exportedFile.getName() + '\n' +
				'Full path length: ' + exportedFile.getAbsolutePath().length()
				)

		waitForSaveDialog()

		setSaveDialogDirectory(
				exportDirectory
				)

		setSaveDialogFileName(
				exportedFile.getName()
				)

		clickRequiredWindowsObject(
				'saveButton',
				'Save button',
				SAVE_DIALOG_TIMEOUT_SECONDS
				)

		Windows.delay(
				SAVE_DIALOG_OPEN_DELAY_SECONDS
				)

		logInfo(
				'Save button clicked. Waiting for exported file. Timeout: ' +
				EXPORT_FILE_TIMEOUT_SECONDS +
				' seconds. Expected path: ' +
				exportedFile.getAbsolutePath()
				)

		waitForExportedFileOrStop(
				exportedFile,
				EXPORT_FILE_TIMEOUT_SECONDS
				)

		logInfo(
				'Save flow completed. Elapsed milliseconds: ' +
				elapsedMilliseconds(
				startedAt
				)
				)

		return exportedFile
	}


	private void waitForSaveDialog() {

		logInfo(
				'Waiting for Save dialog using fileNameField. Timeout: ' +
				SAVE_DIALOG_TIMEOUT_SECONDS +
				' seconds.'
				)

		WindowsTestObject fileNameField =
				getRequiredWindowsObject(
				'fileNameField'
				)

		boolean found = false

		try {
			found = Windows.verifyElementPresent(
					fileNameField,
					SAVE_DIALOG_TIMEOUT_SECONDS,
					FailureHandling.OPTIONAL
					)
		} catch (Exception exception) {

			imageLoader.takeEvidence(
					'SaveDialogVerificationError.png'
					)

			KeywordUtil.markFailedAndStop(
					'Save dialog verification failed. Message: ' +
					safeExceptionMessage(
					exception
					)
					)

			return
		}

		if (!found) {

			imageLoader.takeEvidence(
					'SaveDialogNotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					'Save dialog was not found within ' +
					SAVE_DIALOG_TIMEOUT_SECONDS +
					' seconds. Expected object: export/fileNameField'
					)

			return
		}

		logInfo(
				'Save dialog found successfully.'
				)
	}


	private void setSaveDialogDirectory(
			String exportDirectory) {

		logInfo(
				'Searching for Save dialog folder field using images folderNew and folderOld. Timeout per image: ' +
				SAVE_DIALOG_IMAGE_TIMEOUT_SECONDS +
				' seconds.'
				)

		String detectedImage = clickFirstVisibleImage(
				[
					'folderNew',
					'folderOld'
				],
				SAVE_DIALOG_IMAGE_TIMEOUT_SECONDS
				)

		if (detectedImage != null) {

			logInfo(
					'Save dialog folder field focused using image: ' +
					detectedImage
					)
		} else {

			logInfo(
					'Save dialog folder images were not found. Using CTRL + L fallback.'
					)

			try {
				focusSaveDialogAddressBar()
			} catch (Exception exception) {

				imageLoader.takeEvidence(
						'SaveDialogAddressBarError.png'
						)

				KeywordUtil.markFailedAndStop(
						'Could not focus Save dialog folder field using images or CTRL + L. Message: ' +
						safeExceptionMessage(
						exception
						)
						)

				return
			}
		}

		Windows.delay(
				SHORT_UI_DELAY_SECONDS
				)

		clearFocusedField()

		logInfo(
				'Entering export directory: ' +
				exportDirectory
				)

		pasteAndEnter(
				exportDirectory
				)

		Windows.delay(
				PANEL_OPEN_DELAY_SECONDS
				)

		logInfo(
				'Export directory entered successfully.'
				)
	}


	private String clickFirstVisibleImage(
			List<String> imageKeys,
			Integer timeoutSeconds) {

		int safeTimeout =
				timeoutSeconds == null ||
				timeoutSeconds <= 0
				? SAVE_DIALOG_IMAGE_TIMEOUT_SECONDS
				: timeoutSeconds

		for (String imageKey : imageKeys) {

			try {
				logInfo(
						'Searching Save dialog folder image: ' +
						imageKey +
						'. Timeout: ' +
						safeTimeout +
						' seconds.'
						)

				boolean found = imageLoader.waitForImage(
						GENERAL_IMAGE_GROUP,
						imageKey,
						safeTimeout
						)

				if (!found) {
					continue
				}

				imageLoader.clickImageOrStop(
						GENERAL_IMAGE_GROUP,
						imageKey
						)

				return imageKey
			} catch (Exception exception) {

				logInfo(
						'Save dialog folder image could not be used. Image key: ' +
						imageKey +
						'. Message: ' +
						safeExceptionMessage(
						exception
						)
						)
			}
		}

		return null
	}


	private void setSaveDialogFileName(
			String fileName) {

		logInfo(
				'Focusing file name field using object export/fileNameField. Timeout: ' +
				SAVE_DIALOG_TIMEOUT_SECONDS +
				' seconds.'
				)

		boolean focusedByObject =
				tryClickWindowsObject(
				'fileNameField',
				SAVE_DIALOG_TIMEOUT_SECONDS
				)

		if (!focusedByObject) {

			logInfo(
					'fileNameField was not focused using Windows object. Trying ' +
					FILE_NAME_FALLBACK_TAB_COUNT +
					' TAB presses.'
					)

			try {
				pressTabTimes(
						FILE_NAME_FALLBACK_TAB_COUNT
						)
			} catch (Exception exception) {

				imageLoader.takeEvidence(
						'FileNameFieldNotFocused.png'
						)

				KeywordUtil.markFailedAndStop(
						'Could not focus file name field using object or ' +
						FILE_NAME_FALLBACK_TAB_COUNT +
						' TAB presses. Message: ' +
						safeExceptionMessage(
						exception
						)
						)

				return
			}
		}

		Windows.delay(
				SHORT_UI_DELAY_SECONDS
				)

		clearFocusedField()

		pasteText(
				fileName
				)

		Windows.delay(
				SHORT_UI_DELAY_SECONDS
				)

		logInfo(
				'File name entered successfully: ' +
				fileName
				)
	}


	private boolean tryClickWindowsObject(
			String objectKey,
			Integer timeoutSeconds) {

		WindowsTestObject object =
				getOptionalWindowsObject(
				objectKey
				)

		if (object == null) {
			return false
		}

		try {
			boolean found = Windows.verifyElementPresent(
					object,
					timeoutSeconds,
					FailureHandling.OPTIONAL
					)

			if (!found) {
				return false
			}

			Windows.click(
					object
					)

			return true
		} catch (Exception exception) {

			logInfo(
					'Windows object could not be clicked. Object key: ' +
					objectKey +
					'. Message: ' +
					safeExceptionMessage(
					exception
					)
					)

			return false
		}
	}


	private void clickRequiredWindowsObject(
			String objectKey,
			String description,
			Integer timeoutSeconds) {

		int safeTimeout =
				timeoutSeconds == null ||
				timeoutSeconds <= 0
				? SAVE_DIALOG_TIMEOUT_SECONDS
				: timeoutSeconds

		logInfo(
				'Searching for Windows element. Description: ' +
				description +
				'. Object key: ' +
				objectKey +
				'. Timeout: ' +
				safeTimeout +
				' seconds.'
				)

		WindowsTestObject object =
				getRequiredWindowsObject(
				objectKey
				)

		boolean found = false

		try {
			found = Windows.verifyElementPresent(
					object,
					safeTimeout,
					FailureHandling.OPTIONAL
					)
		} catch (Exception exception) {

			imageLoader.takeEvidence(
					objectKey +
						'VerificationError.png'
					)

			KeywordUtil.markFailedAndStop(
					'Windows element verification failed. Description: ' +
					description +
						'. Object key: ' +
						objectKey +
						'. Message: ' +
						safeExceptionMessage(
						exception
						)
					)

			return
		}

		if (!found) {

			imageLoader.takeEvidence(
					objectKey +
						'NotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					'Required Windows element was not found. Description: ' +
					description +
						'. Object key: ' +
						objectKey +
						'. Timeout: ' +
						safeTimeout +
						' seconds.'
					)

			return
		}

		try {
			Windows.click(
					object
					)
		} catch (Exception exception) {

			imageLoader.takeEvidence(
					objectKey +
						'ClickError.png'
					)

			KeywordUtil.markFailedAndStop(
					'Windows element was found but could not be clicked. Description: ' +
					description +
						'. Object key: ' +
						objectKey +
						'. Message: ' +
						safeExceptionMessage(
						exception
						)
					)

			return
		}

		logInfo(
				description +
					' clicked successfully.'
				)
	}


	private WindowsTestObject getRequiredWindowsObject(
			String objectKey) {

		WindowsTestObject object =
				getOptionalWindowsObject(
				objectKey
				)

		if (object == null) {

			KeywordUtil.markFailedAndStop(
					'Windows object is not configured in WindowsObjectLoader.\n' +
					'Object group: ' + EXPORT_OBJECT_GROUP + '\n' +
					'Object key: ' + objectKey
					)
		}

		return object
	}


	private WindowsTestObject getOptionalWindowsObject(
			String objectKey) {

		try {
			return WindowsObjectLoader.getObject(
					EXPORT_OBJECT_GROUP,
					objectKey
					)
		} catch (Exception exception) {

			logInfo(
					'Windows object could not be loaded. Object group: ' +
					EXPORT_OBJECT_GROUP +
						'. Object key: ' +
						objectKey +
						'. Message: ' +
						safeExceptionMessage(
						exception
						)
					)

			return null
		}
	}


	private void waitForExportedFileOrStop(
			File exportedFile,
			Integer timeoutSeconds) {

		int safeTimeout =
				timeoutSeconds == null ||
				timeoutSeconds <= 0
				? EXPORT_FILE_TIMEOUT_SECONDS
				: timeoutSeconds

		int elapsedSeconds = 0
		long previousSize = -1
		int stableSizeChecks = 0

		while (elapsedSeconds < safeTimeout) {

			boolean fileExists =
					exportedFile.exists() &&
					exportedFile.isFile()

			long currentSize =
					fileExists
					? exportedFile.length()
					: 0

			if (fileExists &&
					currentSize > 0) {

				if (currentSize == previousSize) {
					stableSizeChecks++
				} else {
					previousSize = currentSize
					stableSizeChecks = 0
				}

				if (stableSizeChecks >=
						REQUIRED_STABLE_SIZE_CHECKS) {

					logInfo(
							'Exported file found and writing completed.\n' +
							'Path: ' + exportedFile.getAbsolutePath() + '\n' +
							'Size bytes: ' + currentSize + '\n' +
							'Elapsed seconds: ' + elapsedSeconds
							)

					return
				}
			}

			if (elapsedSeconds == 0 ||
					elapsedSeconds % FILE_LOG_INTERVAL_SECONDS == 0) {

				logInfo(
						'Export file is still being generated.\n' +
						'Elapsed seconds: ' + elapsedSeconds + ' of ' + safeTimeout + '\n' +
						'File exists: ' + fileExists + '\n' +
						'Current size bytes: ' + currentSize + '\n' +
						'Stable size checks: ' + stableSizeChecks + ' of ' + REQUIRED_STABLE_SIZE_CHECKS + '\n' +
						'Expected path: ' + exportedFile.getAbsolutePath()
						)
			}

			Windows.delay(
					1
					)

			elapsedSeconds++
		}

		imageLoader.takeEvidence(
				'ExportedFileNotFound.png'
				)

		KeywordUtil.markFailedAndStop(
				'Exported file was not found, remained empty or did not finish writing.\n' +
				'Expected path: ' + exportedFile.getAbsolutePath() + '\n' +
				'Timeout seconds: ' + safeTimeout + '\n' +
				'File exists: ' + exportedFile.exists() + '\n' +
				'Final size bytes: ' + (exportedFile.exists() ? exportedFile.length() : 0)
				)
	}


	private void closeOpenFileModal() {

		logInfo(
				'Searching for REC open-file modal. Timeout: ' +
				OPEN_FILE_MODAL_TIMEOUT_SECONDS +
				' seconds.'
				)

		String detectedModalImage = null

		if (imageLoader.waitForImage(
				GENERAL_IMAGE_GROUP,
