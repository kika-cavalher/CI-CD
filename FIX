    private String buildChartsPanel(Map model, Map summary) {
        int total = toInt(summary.total)
        int passed = toInt(summary.passed)
        int failed = toInt(summary.failed)
        int skipped = toInt(summary.skipped)

        String donutStyle = buildDonutStyle(passed, failed, skipped, total)

        StringBuilder html = new StringBuilder()

        html.append('<div class="charts-layout">')

        html.append('<div class="chart-card chart-donut-card">')
        html.append('<div class="section-title">Global Overview</div>')
        html.append('<div class="donut-wrap">')
        html.append('<div class="donut-chart" style="background:')
        html.append(donutStyle)
        html.append(';">')
        html.append('<div class="donut-center">')
        html.append('<div class="donut-total">')
        html.append(String.valueOf(total))
        html.append('</div>')
        html.append('<div class="donut-label">Tests</div>')
        html.append('</div>')
        html.append('</div>')
        html.append('</div>')

        html.append('<div class="chart-legend">')
        html.append(buildLegendItem('Passed', passed, STATUS_PASS))
        html.append(buildLegendItem('Failed', failed, STATUS_FAIL))
        html.append(buildLegendItem('Skipped', skipped, STATUS_SKIP))
        html.append('</div>')
        html.append('</div>')

        html.append('<div class="chart-card chart-bars-card">')
        html.append('<div class="section-title">Execution status</div>')
        html.append(buildChartBar('Passed', passed, total, STATUS_PASS))
        html.append(buildChartBar('Failed', failed, total, STATUS_FAIL))
        html.append(buildChartBar('Skipped', skipped, total, STATUS_SKIP))
        html.append('</div>')

        html.append('</div>')
        return html.toString()
    }

    private String buildDonutStyle(int passed, int failed, int skipped, int total) {
        double passDeg = total > 0 ? (passed * 360d / total) : 0d
        double failDeg = total > 0 ? (failed * 360d / total) : 0d
        double skipDeg = total > 0 ? (skipped * 360d / total) : 0d

        double endPass = passDeg
        double endFail = passDeg + failDeg
        double endSkip = passDeg + failDeg + skipDeg

        return "conic-gradient(${STATUS_PASS} 0deg ${endPass}deg, ${STATUS_FAIL} ${endPass}deg ${endFail}deg, ${STATUS_SKIP} ${endFail}deg ${endSkip}deg, #edf2f7 ${endSkip}deg 360deg)"
    }

    private String buildLegendItem(String label, int value, String color) {
        StringBuilder html = new StringBuilder()

        html.append('<div class="legend-item">')
        html.append('<span class="legend-dot" style="background:')
        html.append(color)
        html.append(';"></span>')
        html.append('<span class="legend-label">')
        html.append(htmlEscape(label))
        html.append('</span>')
        html.append('<span class="legend-value">')
        html.append(String.valueOf(value))
        html.append('</span>')
        html.append('</div>')

        return html.toString()
    }

    private String buildChartBar(String label, int value, int total, String color) {
        int percent = total > 0 ? Math.round((value * 100f) / total) : 0

        StringBuilder html = new StringBuilder()
        html.append('<div class="chart-bar-block">')
        html.append('<div class="chart-bar-header">')
        html.append('<span>')
        html.append(htmlEscape(label))
        html.append('</span>')
        html.append('<span>')
        html.append(String.valueOf(value))
        html.append('</span>')
        html.append('</div>')
        html.append('<div class="chart-bar-track">')
        html.append('<div class="chart-bar-fill" style="width:')
        html.append(String.valueOf(percent))
        html.append('%; background:')
        html.append(color)
        html.append(';"></div>')
        html.append('</div>')
        html.append('<div class="chart-bar-percent">')
        html.append(String.valueOf(percent))
        html.append('% of execution</div>')
        html.append('</div>')

        return html.toString()
    }

