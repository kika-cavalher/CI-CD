✅ 1) jenkinsIntegration/JenkinsDesktopPipelineRunner.groovy (CORRIGIDO)

Problema que estava te matando: seu writeRunContextFile() usava PowerShell com here-string + escapeForCmd() que remove quebras de linha, aí o PowerShell explode com “here-string header…”.
Solução: escreve o arquivo direto com writeFile (zero PowerShell).

/*
 * Responsibility:
 * Helpers for desktop execution via Scheduled Task + marker file.
 */

def deleteIfExists(String path) {
  bat """@echo off
if exist "${path}" del /f /q "${path}"
exit /b 0
"""
}

/**
 * Writes run-context.properties in a stable way (no PowerShell here-string issues).
 * Uses CRLF so legacy readers behave correctly.
 */
def writeRunContextFile(String targetFile, Map ctx) {
  def lines = []
  ctx.each { k, v ->
    lines << "${k}=${v}"
  }

  def content = lines.join("\r\n") + "\r\n"
  echo "Writing run-context.properties to: ${targetFile}"

  // Ensure folder exists (Windows)
  def dir = targetFile.substring(0, targetFile.lastIndexOf("\\"))
  bat """@echo off
if not exist "${dir}" mkdir "${dir}"
exit /b 0
"""

  writeFile file: targetFile, text: content, encoding: 'US-ASCII'
}

def runScheduledTaskAndWaitMarker(String taskName, String markerPath, int timeoutMinutes) {
  echo "Running Task Scheduler: ${taskName}"

  bat """@echo off
schtasks /run /tn "${taskName}"
if errorlevel 1 exit /b 1
exit /b 0
"""

  timeout(time: timeoutMinutes, unit: 'MINUTES') {
    echo "Waiting marker file: ${markerPath}"
    while (true) {
      if (fileExists(markerPath)) break
      sleep time: 3, unit: 'SECONDS'
    }
  }

  def ecText = readFile(markerPath).trim()
  int ec = 1
  try { ec = Integer.parseInt(ecText) } catch (ignored) { ec = 1 }

  echo "Desktop task finished. ExitCode=${ec}"
  return ec
}

