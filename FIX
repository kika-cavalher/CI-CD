	private static final String DEFAULT_REPORT_FILE_NAME = 'customReport.html'
	private static final long DEFAULT_NATIVE_HTML_WAIT_MS = 15000L

	JiraFlowCoordinator flow

	JiraGaiaReportBuilder(JiraFlowCoordinator flow) {
		this.flow = flow
	}

	String createGaiaHtmlReport(String reportFolder, String suiteName, String xmlPath) {
		if (isBlank(reportFolder)) {
			return ''
		}

		File reportDir = new File(reportFolder)
		if (!reportDir.exists() || !reportDir.isDirectory()) {
			return ''
		}

		File nativeHtml = waitForNativeKatalonHtmlReport(reportDir, resolveNativeHtmlWaitMs())

		List<Map> xmlCases = parseXmlCases(xmlPath)
		List<Map> logCases = parseExecutionLogCases(reportDir)
		List<Map> scenarios = mergeScenarios(xmlCases, logCases)

		if (scenarios.isEmpty()) {
			return ''
		}

		applySequentialTimingFallback(reportDir, scenarios)
		attachEvidenceFromNativeHtml(reportDir, nativeHtml, scenarios)

		Map model = [
			appName          : flow.getAppDisplayName(),
			suiteName        : resolveSuiteName(reportDir, suiteName),
			reportTitle      : 'Test report - ' + resolveSuiteName(reportDir, suiteName),
			subtitle         : flow.getReportSubtitle(),
			generatedAt      : formatDisplayDate(new Date()),
			logoSrc          : resolveAssetUrl(reportDir, flow.getReportLogoRelativePath()),
			reportFolder     : reportDir.absolutePath,
			headerBackground : flow.getReportHeaderBackground(),
			accentColor      : flow.getReportAccentColor(),
			accentSoftColor  : flow.getReportAccentSoftColor(),
			infoColor        : flow.getReportInfoColor(),
			scenarios        : scenarios
		]

		String html = new JiraGaiaHtmlTemplateBuilder().build(model)

		File htmlFile = new File(reportDir, resolveReportFileName())
		htmlFile.setText(html, 'UTF-8')
		return htmlFile.absolutePath
	}

	// =========================================================================
	// MAIN MERGE
	// =========================================================================

	private List<Map> mergeScenarios(List<Map> xmlCases, List<Map> logCases) {
		List<Map> scenarios = []
		List<Map> remainingLogCases = new ArrayList<Map>(logCases ?: [])

		if (xmlCases == null || xmlCases.isEmpty()) {
			remainingLogCases.eachWithIndex { Map logCase, int index ->
				List<Map> steps = cloneSteps(logCase.steps)
				normalizeStepStatuses(steps, safeValue(logCase.status))
				scenarios << buildScenarioFromSources(
						index + 1,
						logCase.title,
						safeValue(logCase.status).isEmpty() ? 'info' : safeValue(logCase.status),
						toLong(logCase.durationMs),
						safeValue(logCase.errorShort),
						safeValue(logCase.errorFull),
						safeValue(logCase.startLabel),
						safeValue(logCase.endLabel),
						steps
				)
			}
			return scenarios
		}

		xmlCases.eachWithIndex { Map xmlCase, int index ->
			Map matchedLogCase = findMatchingLogCase(xmlCase, remainingLogCases)
			if (matchedLogCase != null) {
				remainingLogCases.remove(matchedLogCase)
			}

			String scenarioTitle = firstNonBlank(
					matchedLogCase?.title,
					xmlCase?.name,
					xmlCase?.shortName,
					"Scenario ${index + 1}"
			)

			List<Map> steps = matchedLogCase != null ? cloneSteps(matchedLogCase.steps) : []
			if (steps.isEmpty()) {
				steps = buildFallbackStepsFromXmlCase(xmlCase)
			}

			String scenarioStatus = safeValue(xmlCase.status)
			String errorShort = extractShortError(xmlCase.message ?: xmlCase.details)
			String errorFull = safeValue(xmlCase.details)

			normalizeStepStatuses(steps, scenarioStatus)
			markFailedStepIfNeeded(steps, scenarioStatus, errorShort, errorFull)

			scenarios << buildScenarioFromSources(
					index + 1,
					scenarioTitle,
					scenarioStatus,
					toLong(xmlCase.durationMs),
					errorShort,
					errorFull,
					safeValue(matchedLogCase?.startLabel),
					safeValue(matchedLogCase?.endLabel),
					steps
			)
		}

		remainingLogCases.eachWithIndex { Map logCase, int extraIndex ->
			List<Map> steps = cloneSteps(logCase.steps)
			normalizeStepStatuses(steps, safeValue(logCase.status))
			scenarios << buildScenarioFromSources(
					xmlCases.size() + extraIndex + 1,
					logCase.title,
					safeValue(logCase.status).isEmpty() ? 'info' : safeValue(logCase.status),
					toLong(logCase.durationMs),
					safeValue(logCase.errorShort),
					safeValue(logCase.errorFull),
					safeValue(logCase.startLabel),
					safeValue(logCase.endLabel),
					steps
			)
		}

		return scenarios
	}

	private Map findMatchingLogCase(Map xmlCase, List<Map> logCases) {
		if (logCases == null || logCases.isEmpty()) {
			return null
		}

		String xmlName = safeValue(xmlCase?.name)
		String xmlShortName = safeValue(xmlCase?.shortName)

		Map matched = logCases.find { Map logCase ->
			String logTitle = safeValue(logCase?.title)
			return sameCase(xmlName, logTitle) || sameCase(xmlShortName, logTitle)
		}

		if (matched != null) {
			return matched
		}

		return null
	}

	private boolean sameCase(String left, String right) {
		String a = normalizeCaseKey(left)
		String b = normalizeCaseKey(right)

		if (isBlank(a) || isBlank(b)) {
			return false
		}

		return a == b || a.contains(b) || b.contains(a)
	}

	private String normalizeCaseKey(String value) {
		String text = safeValue(value).toLowerCase(Locale.ENGLISH)

		text = text.replace('\\', '/')
		text = text.replace('test suites/', '')
		text = text.replace('test suite/', '')
		text = text.replace('test cases/', '')
		text = text.replace('test case/', '')
		text = text.replaceAll(/[^a-z0-9]+/, '')

		return text
	}

	private Map buildScenarioFromSources(
			int index,
			String title,
			String status,
			long durationMs,
			String errorShort,
			String errorFull,
			String startLabel,
			String endLabel,
			List<Map> steps
	) {
		return [
			id             : 'scenario-' + index,
			title          : safeValue(title),
			name           : safeValue(title),
			status         : isBlank(status) ? 'info' : safeValue(status),
			startLabel     : safeValue(startLabel),
			endLabel       : safeValue(endLabel),
			durationMs     : durationMs,
			durationLabel  : formatDurationFull(durationMs),
			steps          : steps ?: [],
			errorShort     : safeValue(errorShort),
			errorFull      : safeValue(errorFull),
			visualError    : safeValue(errorShort),
			sidebarSubtitle: isBlank(errorShort) ? safeValue(title) : safeValue(errorShort),
			evidences      : []
		]
	}

	private List<Map> cloneSteps(List<Map> source) {
		List<Map> result = []

		(source ?: []).eachWithIndex { Map step, int index ->
			result << [
				id           : safeValue(step.id).isEmpty() ? ('step-' + (index + 1)) : safeValue(step.id),
				title        : safeValue(step.title),
				detail       : safeValue(step.detail).isEmpty() ? safeValue(step.title) : safeValue(step.detail),
				status       : safeValue(step.status),
				timeLabel    : safeValue(step.timeLabel),
				startLabel   : safeValue(step.startLabel),
				endLabel     : safeValue(step.endLabel),
				durationMs   : toLong(step.durationMs),
				durationLabel: formatDurationFull(toLong(step.durationMs)),
				detailText   : safeValue(step.detailText),
				shortError   : safeValue(step.shortError),
				errorFull    : safeValue(step.errorFull),
				icon         : safeValue(step.icon).isEmpty() ? resolveStepIcon(safeValue(step.title), safeValue(step.status)) : safeValue(step.icon),
				emoji        : safeValue(step.emoji)
			]
		}

		return result
	}

	private List<Map> buildFallbackStepsFromXmlCase(Map xmlCase) {
		String title = firstNonBlank(xmlCase?.shortName, xmlCase?.name, 'Test step')
		String status = safeValue(xmlCase?.status)
		String errorShort = extractShortError(xmlCase?.message ?: xmlCase?.details)
		String errorFull = safeValue(xmlCase?.details)

		return [[
			id           : 'step-1',
			title        : title,
			detail       : title,
			status       : status,
			timeLabel    : '',
			startLabel   : '',
			endLabel     : '',
			durationMs   : toLong(xmlCase?.durationMs),
			durationLabel: formatDurationFull(toLong(xmlCase?.durationMs)),
			detailText   : safeValue(xmlCase?.details),
			shortError   : errorShort,
			errorFull    : errorFull,
			icon         : resolveStepIcon(title, status),
			emoji        : resolveStepEmoji(title)
		]]
	}

	private void normalizeStepStatuses(List<Map> steps, String scenarioStatus) {
		if (steps == null || steps.isEmpty()) {
			return
		}

		steps.each { Map step ->
			String current = safeValue(step.status)

			if (isBlank(current) || current == 'pending') {
				if (scenarioStatus == 'skipped') {
					step.status = 'skipped'
				} else if (scenarioStatus == 'failed') {
					step.status = 'passed'
				} else {
					step.status = 'passed'
				}
			}

			step.icon = resolveStepIcon(firstNonBlank(step.detail, step.title), safeValue(step.status))
			step.durationMs = toLong(step.durationMs)
			step.durationLabel = formatDurationFull(toLong(step.durationMs))
		}
	}

	private void markFailedStepIfNeeded(List<Map> steps, String scenarioStatus, String errorShort, String errorFull) {
		if (steps == null || steps.isEmpty()) {
			return
		}

		if (scenarioStatus != 'failed') {
			return
		}

		Map alreadyFailed = steps.find { Map step -> safeValue(step.status) == 'failed' }
		if (alreadyFailed != null) {
			if (isBlank(alreadyFailed.shortError)) {
				alreadyFailed.shortError = errorShort
			}
			if (isBlank(alreadyFailed.errorFull)) {
				alreadyFailed.errorFull = errorFull
			}
			alreadyFailed.icon = resolveStepIcon(firstNonBlank(alreadyFailed.detail, alreadyFailed.title), 'failed')
			return
		}

		Map target = steps.reverse().find { Map step ->
			!shouldIgnoreRenderedStep(firstNonBlank(step.detail, step.title))
		}

		if (target == null) {
			target = steps.last()
		}

		target.status = 'failed'
		target.shortError = errorShort
		target.errorFull = errorFull
		target.icon = resolveStepIcon(firstNonBlank(target.detail, target.title), 'failed')
	}

	private boolean shouldIgnoreRenderedStep(String title) {
		String lower = safeValue(title).toLowerCase(Locale.ENGLISH)
		return lower.startsWith('start listener action') ||
				lower == 'video' ||
				lower.startsWith('beforecase') ||
				lower.startsWith('aftercase')
	}

	// =========================================================================
	// EXECUTION LOG
	// =========================================================================

	private List<Map> parseExecutionLogCases(File reportDir) {
		File logFile = findExecutionLog(reportDir)
		if (logFile == null || !logFile.exists()) {
			return []
		}

		List<String> lines = readFileLines(logFile)
		if (lines.isEmpty()) {
			return []
		}

		List<Map> scenarios = []
		Map currentScenario = null
		Map currentStep = null

		lines.each { String rawLine ->
			String line = sanitizeLogLine(rawLine)
			if (isBlank(line)) {
				return
			}

			String testCaseTitle = extractTestCaseTitle(line)
			if (!isBlank(testCaseTitle)) {
				finalizeCurrentStep(currentScenario, currentStep)
				currentStep = null

				if (currentScenario != null) {
					finalizeScenario(currentScenario)
					scenarios << currentScenario
				}

				currentScenario = [
					title        : testCaseTitle,
					status       : 'info',
					durationMs   : 0L,
					startLabel   : '',
					endLabel     : '',
					errorShort   : '',
					errorFull    : '',
					steps        : []
				]
				return
			}

			if (currentScenario == null) {
				return
			}

			if (line.startsWith('Start / End / Elapsed:')) {
				applyTimingInfo(currentStep != null ? currentStep : currentScenario, line)
				return
			}

			String testStepTitle = extractTestStepTitle(line)
			if (!isBlank(testStepTitle)) {
				finalizeCurrentStep(currentScenario, currentStep)

				if (!shouldIgnoreLogStep(testStepTitle)) {
					currentStep = [
						id           : 'step-' + (((currentScenario.steps ?: []).size()) + 1),
						title        : cleanupStepTitle(testStepTitle),
						detail       : cleanupStepTitle(testStepTitle),
						status       : 'passed',
						timeLabel    : '',
						startLabel   : '',
						endLabel     : '',
						durationMs   : 0L,
						durationLabel: formatDurationFull(0L),
						detailLines  : [],
						shortError   : '',
						errorFull    : '',
						icon         : resolveStepIcon(cleanupStepTitle(testStepTitle), 'passed'),
						emoji        : resolveStepEmoji(testStepTitle)
					]
					currentScenario.steps << currentStep
				} else {
					currentStep = null
				}
				return
			}

			if (currentStep == null) {
				return
			}

			Map event = parseEventLine(line)
			if (event != null) {
				if (isBlank(currentStep.timeLabel)) {
					currentStep.timeLabel = safeValue(event.timeLabel)
				}

				currentStep.detailLines << safeValue(event.message)

				if (safeValue(event.status) == 'failed') {
					currentStep.status = 'failed'
					currentStep.shortError = extractShortError(event.message)
					appendError(currentStep, event.message)
				}
				return
			}

			if (looksLikeErrorLine(line)) {
				currentStep.status = 'failed'
				appendError(currentStep, line)
				if (isBlank(currentStep.shortError)) {
					currentStep.shortError = extractShortError(line)
				}
				return
			}

			if (isUsefulSupplementaryLine(line)) {
				currentStep.detailLines << line
			}
		}

		finalizeCurrentStep(currentScenario, currentStep)
		if (currentScenario != null) {
			finalizeScenario(currentScenario)
			scenarios << currentScenario
		}

		return scenarios
	}

	private void finalizeCurrentStep(Map currentScenario, Map currentStep) {
		if (currentScenario == null || currentStep == null) {
			return
		}

		currentStep.detailText = joinLines(currentStep.detailLines as List<String>)
		if (!isBlank(currentStep.detailText) && safeValue(currentStep.detail) == safeValue(currentStep.title)) {
			currentStep.detail = safeValue(currentStep.title)
		}
		currentStep.durationMs = toLong(currentStep.durationMs)
		currentStep.durationLabel = formatDurationFull(toLong(currentStep.durationMs))
		currentStep.icon = resolveStepIcon(firstNonBlank(currentStep.detail, currentStep.title), safeValue(currentStep.status))
	}

	private void finalizeScenario(Map scenario) {
		if (scenario == null) {
			return
		}

		List<Map> steps = scenario.steps ?: []
		boolean hasFailed = steps.any { Map step -> safeValue(step.status) == 'failed' }
		boolean hasSkipped = steps.any { Map step -> safeValue(step.status) == 'skipped' }
		boolean hasPassed = steps.any { Map step -> safeValue(step.status) == 'passed' }

		if (hasFailed) {
			scenario.status = 'failed'
		} else if (hasPassed) {
			scenario.status = 'passed'
		} else if (hasSkipped) {
			scenario.status = 'skipped'
		} else {
			scenario.status = 'info'
		}

		Map failedStep = steps.find { Map step -> safeValue(step.status) == 'failed' }
		if (failedStep != null) {
			scenario.errorShort = firstNonBlank(failedStep.shortError, extractShortError(failedStep.errorFull), extractShortError(failedStep.detailText))
			scenario.errorFull = firstNonBlank(failedStep.errorFull, failedStep.detailText)
		}

		long stepDuration = 0L
		steps.each { Map step ->
			stepDuration += toLong(step.durationMs)
		}

		if (stepDuration > toLong(scenario.durationMs)) {
			scenario.durationMs = stepDuration
		}
	}

	private String extractTestCaseTitle(String line) {
		if (line.contains('TEST CASE:')) {
			return cleanupCaseTitle(line.substring(line.indexOf('TEST CASE:') + 'TEST CASE:'.length()).trim())
		}

		def startMatcher = (line =~ /^START\s+(Test Cases\/.+)$/)
		if (startMatcher.find()) {
			return cleanupCaseTitle(safeValue(startMatcher.group(1)))
		}

		return ''
	}

	private String extractTestStepTitle(String line) {
		if (!line.contains('TEST STEP:')) {
			return ''
		}

		String step = line.substring(line.indexOf('TEST STEP:') + 'TEST STEP:'.length()).trim()
		return cleanupStepTitle(step)
	}

	private String cleanupCaseTitle(String value) {
		String text = safeValue(value)
		text = text.replaceAll(/\s+\([\d.,]+s\)$/, '').trim()
		return text
	}

	private String cleanupStepTitle(String value) {
		String text = safeValue(value)
		text = text.replaceAll(/\s+\([\d.,]+s\)$/, '').trim()
		text = text.replaceAll(/[.]{2,}$/, '').trim()
		return text
	}

	private boolean shouldIgnoreLogStep(String title) {
		String lower = safeValue(title).toLowerCase(Locale.ENGLISH)

		return lower.startsWith('start listener action') ||
				lower == 'video' ||
				lower.startsWith('beforecase') ||
				lower.startsWith('aftercase') ||
				lower.startsWith('sampleaftertestcase') ||
				lower.startsWith('exportkatalonreports')
	}

	private boolean isUsefulSupplementaryLine(String line) {
		String lower = safeValue(line).toLowerCase(Locale.ENGLISH)

		if (isBlank(lower)) {
			return false
		}

		if (lower.startsWith('start test cases/')) return false
		if (lower.startsWith('end test cases/')) return false
		if (lower.startsWith('start / end / elapsed:')) return false

		return true
	}

	private void appendError(Map step, String message) {
		String current = safeValue(step.errorFull)
		String extra = safeValue(message)

		if (isBlank(extra)) {
			return
		}

		if (isBlank(current)) {
			step.errorFull = extra
		} else {
			step.errorFull = current + '\n' + extra
		}
	}

	private File findExecutionLog(File reportDir) {
		if (reportDir == null || !reportDir.exists()) {
			return null
		}

		List<File> candidates = []

		File[] files = reportDir.listFiles()
		if (files != null) {
			files.each { File file ->
				if (file.isFile()) {
					String lower = file.name.toLowerCase(Locale.ENGLISH)

					if (lower.startsWith('execution') && lower.endsWith('.log')) {
						candidates << file
					} else if (lower == 'execution.log') {
						candidates << file
					}
				}
			}
		}

		if (candidates.isEmpty()) {
			return null
		}

		candidates.sort { File a, File b -> b.lastModified() <=> a.lastModified() }
		return candidates.first()
	}

	private List<String> readFileLines(File file) {
		try {
			return Files.readAllLines(file.toPath(), StandardCharsets.UTF_8)
		} catch (Exception ignored) {
			try {
				return file.readLines()
			} catch (Exception ignoredAgain) {
				return []
			}
		}
	}

	private String sanitizeLogLine(String rawLine) {
		String line = safeValue(rawLine)
		if (isBlank(line)) {
			return ''
		}

		line = line.replaceAll(/\u001B\[[;\d]*m/, '')
		line = line.replace('\t', ' ')
		line = line.replaceAll(/\s+/, ' ').trim()

		def prefixed = (line =~ /^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3}\s+[A-Z]+\s+.+?\s+-\s+(.*)$/)
		if (prefixed.find()) {
			line = safeValue(prefixed.group(1))
		}

		return line
	}

	private Map parseEventLine(String line) {
		def matcher = (line =~ /^(\d{2}:\d{2}:\d{2}\.\d{3})\s+([A-Z]+)\s+(.*)$/)
		if (!matcher.find()) {
			return null
		}

		String rawStatus = safeValue(matcher.group(2)).toUpperCase(Locale.ENGLISH)
		String message = safeValue(matcher.group(3))

		return [
			timeLabel: formatTimeFromClock(safeValue(matcher.group(1))),
			status   : normalizeEventStatus(rawStatus),
			message  : message
		]
	}

	private String normalizeEventStatus(String rawStatus) {
		if (rawStatus == 'PASSED') return 'passed'
		if (rawStatus == 'FAILED' || rawStatus == 'ERROR') return 'failed'
		if (rawStatus == 'SKIPPED') return 'skipped'
		return 'info'
	}

	// =========================================================================
	// XML
	// =========================================================================

	private List<Map> parseXmlCases(String xmlPath) {
		List<Map> result = []

		if (isBlank(xmlPath)) {
			return result
		}

		File xmlFile = new File(xmlPath)
		if (!xmlFile.exists() || !xmlFile.isFile()) {
			return result
		}

		Document document = parseXmlDocument(xmlFile)
		if (document == null) {
			return result
		}

		NodeList testcases = document.getElementsByTagName('testcase')
		for (int index = 0; index < testcases.length; index++) {
			Node node = testcases.item(index)
			if (!(node instanceof Element)) {
				continue
			}

			Element testcase = (Element) node

			String className = safeValue(testcase.getAttribute('classname'))
			String testName = safeValue(testcase.getAttribute('name'))
			long durationMs = toMillisFromSeconds(testcase.getAttribute('time'))

			Element failureNode = firstChildElement(testcase, 'failure')
			Element errorNode = firstChildElement(testcase, 'error')
			Element skippedNode = firstChildElement(testcase, 'skipped')

			boolean failed = failureNode != null || errorNode != null
			boolean skipped = skippedNode != null

			String message = ''
			String details = ''

			if (failureNode != null) {
				message = safeValue(failureNode.getAttribute('message'))
				details = safeValue(failureNode.getTextContent())
			} else if (errorNode != null) {
				message = safeValue(errorNode.getAttribute('message'))
				details = safeValue(errorNode.getTextContent())
			} else if (skippedNode != null) {
				message = safeValue(skippedNode.getAttribute('message'))
				details = safeValue(skippedNode.getTextContent())
			}

			String displayName = buildDisplayName(className, testName)

			result << [
				index      : index + 1,
				name       : displayName,
				shortName  : isBlank(testName) ? displayName : testName,
				durationMs : durationMs,
				status     : skipped ? 'skipped' : (failed ? 'failed' : 'passed'),
				message    : message,
				details    : details
			]
		}

		return result
	}

	private Document parseXmlDocument(File xmlFile) {
		try {
			DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance()
			factory.setNamespaceAware(false)
			factory.setFeature('http://apache.org/xml/features/disallow-doctype-decl', true)
			factory.setFeature('http://xml.org/sax/features/external-general-entities', false)
			factory.setFeature('http://xml.org/sax/features/external-parameter-entities', false)
			factory.setFeature('http://apache.org/xml/features/nonvalidating/load-external-dtd', false)
			factory.setExpandEntityReferences(false)

			return factory.newDocumentBuilder().parse(xmlFile)
		} catch (Exception ignored) {
			return null
		}
	}

	private Element firstChildElement(Element parent, String tagName) {
		if (parent == null || isBlank(tagName)) {
			return null
		}

		NodeList nodes = parent.getElementsByTagName(tagName)
		if (nodes == null || nodes.length == 0) {
			return null
		}

		Node node = nodes.item(0)
		return node instanceof Element ? (Element) node : null
	}

	private String buildDisplayName(String className, String testName) {
		if (!isBlank(testName) && testName.startsWith('Test Cases/')) {
			return testName
		}

		if (!isBlank(className) && className.startsWith('Test Cases/')) {
			return className
		}

		if (!isBlank(className) && !isBlank(testName)) {
			return className + '/' + testName
		}

		if (!isBlank(testName)) {
			return testName
		}

		return className
	}

	// =========================================================================
	// NATIVE HTML EVIDENCE
	// =========================================================================

	private void attachEvidenceFromNativeHtml(File reportDir, File nativeHtml, List<Map> scenarios) {
		scenarios.each { Map scenario ->
			scenario.evidences = []
		}

		if (nativeHtml == null || !nativeHtml.exists()) {
			return
		}

		String html = readFileText(nativeHtml)
		if (isBlank(html)) {
			return
		}

		scenarios.findAll { Map scenario ->
			safeValue(scenario.status) == 'failed'
		}.each { Map scenario ->
			Map evidence = findEvidenceForScenarioInNativeHtml(html, nativeHtml, reportDir, scenario)
			if (evidence != null) {
				scenario.evidences = [evidence]
			}
		}
	}

	private Map findEvidenceForScenarioInNativeHtml(String html, File nativeHtml, File reportDir, Map scenario) {
		List<String> namesToTry = [
			safeValue(scenario.title),
			safeValue(scenario.name)
		].findAll { String value -> !isBlank(value) }.unique()

		for (String caseName : namesToTry) {
			int index = indexOfIgnoreCase(html, caseName)
			if (index < 0) {
				continue
			}

			int start = Math.max(0, index - 1000)
			int end = Math.min(html.length(), index + 120000)
			String block = html.substring(start, end)

			Map evidence = extractEvidenceFromHtmlBlock(block, nativeHtml, reportDir)
			if (evidence != null) {
				return evidence
			}
		}

		return null
	}

	private Map extractEvidenceFromHtmlBlock(String block, File nativeHtml, File reportDir) {
		def matcher = (block =~ /(?is)<img\b[^>]*\bsrc\s*=\s*["']([^"']+)["'][^>]*>/)
		while (matcher.find()) {
			String rawSrc = htmlUnescape(safeValue(matcher.group(1)))
			if (isBlank(rawSrc)) {
				continue
			}

			String lower = rawSrc.toLowerCase(Locale.ENGLISH)
			boolean looksLikeEvidence = lower.startsWith('data:image') ||
					lower.contains('screenshot') ||
					lower.endsWith('.png') ||
					lower.endsWith('.jpg') ||
					lower.endsWith('.jpeg') ||
					lower.endsWith('.gif') ||
					lower.endsWith('.webp') ||
					lower.endsWith('.bmp')

			if (!looksLikeEvidence) {
				continue
			}

			if (lower.startsWith('data:image')) {
				return [
					name  : 'Failure screenshot',
					href  : rawSrc,
					image : true,
					imgSrc: rawSrc
				]
			}

			File resolved = resolveReferencedImage(rawSrc, nativeHtml, reportDir)
			if (resolved != null && resolved.exists()) {
				String previewSrc = buildEvidencePreviewSrc(resolved)
				return [
					name  : resolved.name,
					href  : resolved.toURI().toString(),
					image : true,
					imgSrc: previewSrc
				]
			}
		}

		return null
	}

	private File resolveReferencedImage(String src, File nativeHtml, File reportDir) {
		String value = safeValue(src)
		if (isBlank(value)) {
			return null
		}

		try {
			if (value.toLowerCase(Locale.ENGLISH).startsWith('file:/')) {
				File direct = new File(new java.net.URI(value))
				if (direct.exists()) {
					return direct
				}
			}
		} catch (Exception ignored) {
		}

		File direct = new File(value)
		if (direct.exists()) {
			return direct
		}

		File relativeToHtml = new File(nativeHtml.parentFile, value)
		if (relativeToHtml.exists()) {
			return relativeToHtml
		}

		File relativeToReport = new File(reportDir, value)
		if (relativeToReport.exists()) {
			return relativeToReport
		}

		String onlyName = new File(value).name
		if (!isBlank(onlyName)) {
			File found = findFileByName(reportDir, onlyName)
			if (found != null && found.exists()) {
				return found
			}
		}

		return null
	}

	private File findFileByName(File root, String fileName) {
		if (root == null || !root.exists() || !root.isDirectory() || isBlank(fileName)) {
			return null
		}

		File[] children = root.listFiles()
		if (children == null) {
			return null
		}

		for (File child : children) {
			if (child.isFile() && child.name.equalsIgnoreCase(fileName)) {
				return child
			}
		}

		for (File child : children) {
			if (child.isDirectory()) {
				File found = findFileByName(child, fileName)
				if (found != null) {
					return found
				}
			}
		}

		return null
	}

	private File waitForNativeKatalonHtmlReport(File reportDir, long waitMs) {
		long startedAt = System.currentTimeMillis()
		File found = null

		while ((System.currentTimeMillis() - startedAt) <= waitMs) {
			found = findNativeKatalonHtmlReport(reportDir)
			if (found != null && found.exists()) {
				return found
			}

			try {
				Thread.sleep(500L)
			} catch (Exception ignored) {
				break
			}
		}

		return findNativeKatalonHtmlReport(reportDir)
	}

	private File findNativeKatalonHtmlReport(File reportDir) {
		if (reportDir == null || !reportDir.exists() || !reportDir.isDirectory()) {
			return null
		}

		String customReportName = resolveReportFileName().toLowerCase(Locale.ENGLISH)
		List<File> htmlFiles = []

		File[] files = reportDir.listFiles()
		if (files != null) {
			files.each { File file ->
				if (file.isFile()) {
					String lower = file.name.toLowerCase(Locale.ENGLISH)
					if (lower.endsWith('.html') && lower != customReportName) {
						htmlFiles << file
					}
				}
			}
		}

		if (htmlFiles.isEmpty()) {
			return null
		}

		htmlFiles.sort { File a, File b -> b.lastModified() <=> a.lastModified() }
		return htmlFiles.first()
	}

	// =========================================================================
	// TIMING
	// =========================================================================

	private void applySequentialTimingFallback(File reportDir, List<Map> scenarios) {
		if (scenarios == null || scenarios.isEmpty()) {
			return
		}

		long totalDurationMs = 0L
		scenarios.each { Map scenario ->
			long scenarioDuration = toLong(scenario.durationMs)
			if (scenarioDuration <= 0L) {
				scenarioDuration = sumStepDurations((scenario.steps ?: []) as List<Map>)
			}
			if (scenarioDuration <= 0L) {
				scenarioDuration = 1000L
			}

			scenario.durationMs = scenarioDuration
			scenario.durationLabel = formatDurationFull(scenarioDuration)
			totalDurationMs += scenarioDuration
		}

		Date suiteEnd = new Date(reportDir.lastModified())
		long startMillis = suiteEnd.time - totalDurationMs
		long cursor = startMillis

		scenarios.each { Map scenario ->
			long scenarioDuration = toLong(scenario.durationMs)

			if (isBlank(scenario.startLabel)) {
				scenario.startLabel = formatTimeOnly(new Date(cursor))
			}
			if (isBlank(scenario.endLabel)) {
				scenario.endLabel = formatTimeOnly(new Date(cursor + scenarioDuration))
			}

			fillStepTimes((scenario.steps ?: []) as List<Map>, cursor, scenarioDuration)
			cursor += scenarioDuration
		}
	}

	private void fillStepTimes(List<Map> steps, long scenarioStartMillis, long scenarioDuration) {
		if (steps == null || steps.isEmpty()) {
			return
		}

		long cursor = scenarioStartMillis
		long perStep = steps.size() > 0 ? Math.max(1000L, (long) Math.floor((double) scenarioDuration / (double) steps.size())) : 1000L

		steps.each { Map step ->
			if (isBlank(step.timeLabel)) {
				step.timeLabel = formatTimeOnly(new Date(cursor))
			}

			if (toLong(step.durationMs) <= 0L) {
				step.durationMs = perStep
				step.durationLabel = formatDurationFull(perStep)
			}

			cursor += toLong(step.durationMs)
		}
	}

	private void applyTimingInfo(Map target, String timingLine) {
		def matcher = (timingLine =~ /^Start \/ End \/ Elapsed:\s*(.*?)\s*\/\s*(.*?)\s*\/\s*(.*)$/)
		if (!matcher.find()) {
			return
		}

		String rawStart = safeValue(matcher.group(1))
		String rawEnd = safeValue(matcher.group(2))
		String rawElapsed = safeValue(matcher.group(3))

		if (!isBlank(rawStart)) {
			target.startLabel = formatTimeFromAny(rawStart)
		}
		if (!isBlank(rawEnd)) {
			target.endLabel = formatTimeFromAny(rawEnd)
		}

		long durationMs = toMillisFromElapsed(rawElapsed)
		if (durationMs > 0L) {
			target.durationMs = durationMs
			target.durationLabel = formatDurationFull(durationMs)
		}
	}

	private long sumStepDurations(List<Map> steps) {
		long total = 0L
		(steps ?: []).each { Map step ->
			total += toLong(step.durationMs)
		}
		return total
	}

