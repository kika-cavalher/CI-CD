private void attachEvidenceToFailedScenarios(File reportDir, List<Map> scenarios) {
    List<File> images = findEvidenceImages(reportDir)
    List<Map> failedScenarios = scenarios.findAll { Map item -> safeValue(item.status) == 'failed' }

    scenarios.each { Map scenario ->
        scenario.evidences = []
    }

    if (images.isEmpty() || failedScenarios.isEmpty()) {
        return
    }

    images.sort { File a, File b -> a.lastModified() <=> b.lastModified() }

    int imageCursor = images.size() - 1
    failedScenarios.reverseEach { Map scenario ->
        if (imageCursor >= 0) {
            File chosen = images[imageCursor]
            imageCursor--

            scenario.evidences << [
                name         : chosen.name,
                fileName     : chosen.name,
                path         : chosen.absolutePath,
                absolutePath : chosen.absolutePath,
                href         : chosen.toURI().toString(),
                imageSrc     : chosen.toURI().toString(),
                image        : true
            ]
        }
    }
}
