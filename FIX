	private static final String LIST_SEPARATOR = '|'

	@Keyword
	String validateEvidenceFolderExists(String folderPath) {

		StringBuilder errors = new StringBuilder()

		File folder = new File(safeText(folderPath))

		KeywordUtil.logInfo("📁 [VALIDATE FOLDER] " + folder.getAbsolutePath())

		if (!folder.exists()) {
			errors.append("[ERROR] Evidence folder does not exist: ").append(folder.getAbsolutePath()).append("\n")
		} else if (!folder.isDirectory()) {
			errors.append("[ERROR] Evidence path is not a folder: ").append(folder.getAbsolutePath()).append("\n")
		}

		return errors.toString()
	}

	@Keyword
	String resolveExcelFilesAsString(String folderPath, String requestedFileNames, String includeSubFoldersText) {

		File folder = new File(safeText(folderPath))
		boolean includeSubFolders = isTrue(includeSubFoldersText)

		List<File> files = []

		List<String> requestedFiles = splitText(requestedFileNames)

		if (requestedFiles.size() > 0) {

			for (String fileName : requestedFiles) {

				File file = new File(fileName)

				if (!file.isAbsolute()) {
					file = new File(folder, fileName)
				}

				files.add(file)
			}
		} else if (folder.exists() && folder.isDirectory()) {

			files = collectExcelFiles(folder, includeSubFolders)
		}

		files = files.findAll { File file ->
			file != null && isExcelFile(file.getName()) && !file.getName().startsWith('~$')
		}

		files = files.unique { File file ->
			file.getAbsolutePath().toLowerCase()
		}

		files.sort { File file ->
			file.getAbsolutePath().toLowerCase()
		}

		String result = files.collect { File file ->
			file.getAbsolutePath()
		}.join(LIST_SEPARATOR)

		KeywordUtil.logInfo("📄 [RESOLVED FILES] " + result)

		return result
	}

	@Keyword
	String validateExcelFilesFound(String filesToValidate) {

		StringBuilder errors = new StringBuilder()

		List<File> files = parseFiles(filesToValidate)

		if (files.size() == 0) {
			errors.append("[ERROR] No Excel files found to validate.\n")
		}

		for (File file : files) {

			if (!file.exists()) {
				errors.append("[ERROR] File not found: ").append(file.getAbsolutePath()).append("\n")
			} else if (!file.isFile()) {
				errors.append("[ERROR] Path is not a file: ").append(file.getAbsolutePath()).append("\n")
			} else if (!isExcelFile(file.getName())) {
				errors.append("[ERROR] File is not Excel: ").append(file.getAbsolutePath()).append("\n")
			}
		}

		return errors.toString()
	}

	@Keyword
	String validateMinimumExpectedFileQuantity(String filesToValidate, String minimumExpectedFilesText) {

		int minimumExpectedFiles = parseIntOrZero(minimumExpectedFilesText)

		if (minimumExpectedFiles <= 0) {
			return "[SKIPPED] Minimum expected file quantity was not configured."
		}

		StringBuilder errors = new StringBuilder()

		List<File> files = parseFiles(filesToValidate)

		KeywordUtil.logInfo("📄 [FILE COUNT] found=" + files.size() + " | minimumExpected=" + minimumExpectedFiles)

		if (files.size() < minimumExpectedFiles) {
			errors.append("[ERROR] Expected at least ")
					.append(minimumExpectedFiles)
					.append(" Excel files, but found ")
					.append(files.size())
					.append(".\n")
		}

		return errors.toString()
	}

