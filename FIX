	private long resolveNativeHtmlWaitMs() {
		try {
			def raw = flow?.WAIT_NATIVE_HTML_MS
			long value = toLong(raw)
			return value > 0L ? value : DEFAULT_NATIVE_HTML_WAIT_MS
		} catch (Exception ignored) {
			return DEFAULT_NATIVE_HTML_WAIT_MS
		}
	}

	private String resolveReportFileName() {
		try {
			String value = safeValue(flow?.GAIA_REPORT_FILE_NAME)
			if (!isBlank(value)) {
				return value
			}
		} catch (Exception ignored) {
		}
		return DEFAULT_REPORT_FILE_NAME
	}

	private String resolveSuiteName(File reportDir, String providedSuiteName) {
		if (!isBlank(providedSuiteName)) {
			return safeValue(providedSuiteName)
		}

		File parent = reportDir.parentFile
		if (parent != null && !isBlank(parent.name)) {
			return safeValue(parent.name)
		}

		return 'Execution'
	}

	private String resolveAssetUrl(File reportDir, String relativePath) {
		if (isBlank(relativePath)) {
			return ''
		}

		File projectRoot = findProjectRoot(reportDir)
		File asset = new File(projectRoot, relativePath)
		if (asset.exists()) {
			return asset.toURI().toString()
		}

		return ''
	}

	private File findProjectRoot(File reportDir) {
		File current = reportDir
		while (current != null) {
			if ('Reports'.equalsIgnoreCase(current.name)) {
				return current.parentFile != null ? current.parentFile : current
			}
			current = current.parentFile
		}
		return reportDir
	}

	private String readFileText(File file) {
		try {
			return new String(Files.readAllBytes(file.toPath()), StandardCharsets.UTF_8)
		} catch (Exception ignored) {
			try {
				return file.getText('UTF-8')
			} catch (Exception ignoredAgain) {
				return ''
			}
		}
	}

	private int indexOfIgnoreCase(String source, String search) {
		if (isBlank(source) || isBlank(search)) {
			return -1
		}
		return source.toLowerCase(Locale.ENGLISH).indexOf(search.toLowerCase(Locale.ENGLISH))
	}

	private String htmlUnescape(String value) {
		return safeValue(value)
				.replace('&amp;', '&')
				.replace('&lt;', '<')
				.replace('&gt;', '>')
				.replace('&quot;', '"')
				.replace('&#39;', "'")
	}

	private String joinLines(List<String> lines) {
		if (lines == null || lines.isEmpty()) {
			return ''
		}
		return lines.findAll { String item -> !isBlank(item) }.join('\n').trim()
	}

	private String safeValue(def value) {
		return value == null ? '' : String.valueOf(value).trim()
	}

	private boolean isBlank(def value) {
		return safeValue(value).isEmpty()
	}

	private String firstNonBlank(Object... values) {
		if (values == null) {
			return ''
		}

		for (Object value : values) {
			String text = safeValue(value)
			if (!text.isEmpty()) {
				return text
			}
		}

		return ''
	}

	private long toLong(def value) {
		String raw = safeValue(value)
		if (raw.isEmpty()) {
			return 0L
		}

		try {
			return Long.parseLong(raw)
		} catch (Exception ignored) {
		}

		try {
			String clean = raw.replace(',', '.')
			if (clean.endsWith('s')) {
				clean = clean.substring(0, clean.length() - 1)
				return Math.round(Double.parseDouble(clean) * 1000d)
			}
		} catch (Exception ignored) {
		}

		return 0L
	}

	private long toMillisFromSeconds(String rawValue) {
		return toMillisFromCompactSeconds(rawValue)
	}

	private long toMillisFromElapsed(String rawValue) {
		String raw = safeValue(rawValue)
		if (isBlank(raw)) {
			return 0L
		}

		def matcher = (raw =~ /^(\d{2}):(\d{2}):(\d{2})\.(\d{3})$/)
		if (matcher.find()) {
			long hours = matcher.group(1) as long
			long minutes = matcher.group(2) as long
			long seconds = matcher.group(3) as long
			long millis = matcher.group(4) as long
			return (((hours * 60L + minutes) * 60L) + seconds) * 1000L + millis
		}

		return toMillisFromCompactSeconds(raw)
	}

	private long toMillisFromCompactSeconds(String rawValue) {
		String raw = safeValue(rawValue).replace(',', '.').replace('s', '').trim()
		if (isBlank(raw)) {
			return 0L
		}

		try {
			double seconds = Double.parseDouble(raw)
			return Math.round(seconds * 1000d)
		} catch (Exception ignored) {
			return 0L
		}
	}

	private String formatDurationFull(long durationMs) {
		long totalSeconds = durationMs > 0L ? Math.round(durationMs / 1000d) : 0L
		long hours = (long) Math.floor(totalSeconds / 3600L)
		long minutes = (long) Math.floor((totalSeconds % 3600L) / 60L)
		long seconds = totalSeconds % 60L
		return String.format(Locale.ENGLISH, '%02dh %02dm %02ds', hours, minutes, seconds)
	}

	private String formatDisplayDate(Date value) {
		return new SimpleDateFormat('MM.dd.yyyy hh:mm:ss a', Locale.ENGLISH).format(value)
	}

	private String formatTimeOnly(Date value) {
		return new SimpleDateFormat('HH:mm:ss', Locale.ENGLISH).format(value)
	}

	private String formatTimeFromAny(String raw) {
		String text = safeValue(raw)

		List<String> formats = [
			'yyyy-MM-dd HH:mm:ss.SSS',
			'yyyy-MM-dd HH:mm:ss',
			'dd-MM-yyyy HH:mm:ss',
			'MM.dd.yyyy hh:mm:ss a',
			'HH:mm:ss'
		]

		for (String pattern : formats) {
			try {
				Date value = new SimpleDateFormat(pattern, Locale.ENGLISH).parse(text)
				return formatTimeOnly(value)
			} catch (Exception ignored) {
			}
		}

		return text
	}

	private String formatTimeFromClock(String raw) {
		try {
			Date value = new SimpleDateFormat('HH:mm:ss.SSS', Locale.ENGLISH).parse(safeValue(raw))
			return formatTimeOnly(value)
		} catch (Exception ignored) {
			return safeValue(raw)
		}
	}

	private boolean looksLikeErrorLine(String line) {
		String lower = safeValue(line).toLowerCase(Locale.ENGLISH)

		return lower.contains('exception') ||
				lower.contains('root cause') ||
				lower.contains('caused by:') ||
				lower.contains('unable to ') ||
				lower.contains('stacktrace') ||
				lower.startsWith('at ')
	}

	private String extractShortError(def source) {
		String text = safeValue(source)
		if (isBlank(text)) {
			return ''
		}

		List<String> lines = text.readLines().collect { safeValue(it) }.findAll { !isBlank(it) }
		if (lines.isEmpty()) {
			return ''
		}

		String preferred = lines.find { String line ->
			String lower = line.toLowerCase(Locale.ENGLISH)
			return lower.contains('unable to ') ||
					lower.contains('element click intercepted') ||
					lower.contains('object repository') ||
					lower.contains('no such element') ||
					lower.contains('timeout') ||
					lower.contains('mandatory failure')
		}

		String value = safeValue(preferred ?: lines.first())
		value = value.replace('com.kms.katalon.core.exception.StepFailedException:', '').trim()
		value = value.replace('(Root cause:', '').trim()

		int atIndex = value.indexOf(' at ')
		if (atIndex > 0) {
			value = value.substring(0, atIndex).trim()
		}

		if (value.length() > 180) {
			value = value.substring(0, 177) + '...'
		}

		return value
	}

	private String buildEvidencePreviewSrc(File file) {
		if (file == null || !file.exists() || !file.isFile()) {
			return ''
		}

		if (!isImageFile(file.name)) {
			return ''
		}

		try {
			byte[] content = Files.readAllBytes(file.toPath())
			String mime = resolveImageMime(file.name)
			return 'data:' + mime + ';base64,' + Base64.encoder.encodeToString(content)
		} catch (Exception ignored) {
			return file.toURI().toString()
		}
	}

	private String resolveImageMime(String fileName) {
		String lower = safeValue(fileName).toLowerCase(Locale.ENGLISH)

		if (lower.endsWith('.png')) return 'image/png'
		if (lower.endsWith('.jpg') || lower.endsWith('.jpeg')) return 'image/jpeg'
		if (lower.endsWith('.webp')) return 'image/webp'
		if (lower.endsWith('.gif')) return 'image/gif'
		if (lower.endsWith('.bmp')) return 'image/bmp'

		return 'image/png'
	}

	private boolean isImageFile(String fileName) {
		String lower = safeValue(fileName).toLowerCase(Locale.ENGLISH)
		return lower.endsWith('.png') ||
				lower.endsWith('.jpg') ||
				lower.endsWith('.jpeg') ||
				lower.endsWith('.gif') ||
				lower.endsWith('.webp') ||
				lower.endsWith('.bmp')
	}

	private String resolveStepEmoji(String title) {
		String lower = safeValue(title).toLowerCase(Locale.ENGLISH)

		if (lower.contains('search') || lower.contains('find') || lower.contains('wait')) return '🔎'
		if (lower.contains('click') || lower.contains('select') || lower.contains('open') || lower.contains('navigate')) return '🖱️'
		if (lower.contains('fill') || lower.contains('input') || lower.contains('type') || lower.contains('write')) return '⌨️'
		if (lower.contains('import') || lower.contains('upload') || lower.contains('file')) return '📄'
		if (lower.contains('verify') || lower.contains('assert') || lower.contains('match') || lower.contains('contain')) return '✅'

		return '🔹'
	}

	private String resolveStepIcon(String detail, String status) {
		String lower = safeValue(detail).toLowerCase(Locale.ENGLISH)

		if (status == 'failed') return '❌'
		if (status == 'skipped') return '⏭️'
		if (lower.contains('wait')) return '🔎'
		if (lower.contains('click') || lower.contains('select') || lower.contains('fill') || lower.contains('import')) return '🖱️'
		if (lower.contains('open') || lower.contains('navigate')) return '🌐'

		return 'ℹ️'
	}
