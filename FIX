private boolean clickFirstVisibleImage(
	String groupName,
	List<String> imageKeys,
	Integer timeoutSeconds
) {

	Integer timeout =
		timeoutSeconds == null || timeoutSeconds <= 0
			? 5
			: timeoutSeconds

	for (int elapsed = 0; elapsed < timeout; elapsed++) {

		for (String imageKey : imageKeys) {

			try {
				String imagePath =
					imageLoader.getImage(
						groupName,
						imageKey
					)

				def found =
					WindowsImageKeywords.findImage(
						imagePath
					)

				if (found != null && found != false) {

					WindowsImageKeywords.clickImage(
						imagePath
					)

					KeywordUtil.logInfo(
						'[PASS] Image clicked.\n' +
						'Group: ' + groupName + '\n' +
						'Key: ' + imageKey
					)

					return true
				}
			} catch (Exception e) {
				KeywordUtil.logInfo(
					'[INFO] Image not visible.\n' +
						'Group: ' + groupName + '\n' +
						'Key: ' + imageKey + '\n' +
						'Reason: ' + safeMessage(e)
				)
			}
		}

		Windows.delay(1)
	}

	return false
}
