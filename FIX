package jiraIntegration

import java.io.File
import java.nio.file.Files
import java.text.SimpleDateFormat
import java.util.Base64
import java.util.Date
import java.util.Locale

import javax.xml.parsers.DocumentBuilderFactory

import org.w3c.dom.Document
import org.w3c.dom.Element
import org.w3c.dom.Node
import org.w3c.dom.NodeList

class JiraGaiaReportBuilder {

    JiraFlowCoordinator flow
    JiraGaiaHtmlTemplateBuilder htmlBuilder

    JiraGaiaReportBuilder(JiraFlowCoordinator flow) {
        this.flow = flow
        this.htmlBuilder = new JiraGaiaHtmlTemplateBuilder()
    }

    private String safeValue(def value) {
        if (value == null) {
            return ''
        }
        return String.valueOf(value).trim()
    }

    private boolean isBlank(def value) {
        return safeValue(value).isEmpty()
    }

    private String stripAnsi(def value) {
        return safeValue(value).replaceAll(/\u001B\[[;\d]*m/, '')
    }

    private long toMillis(def secondsValue) {
        String raw = safeValue(secondsValue)
        if (raw.isEmpty()) {
            return 0L
        }

        try {
            BigDecimal seconds = new BigDecimal(raw.replace(',', '.'))
            return seconds.multiply(new BigDecimal('1000')).longValue()
        } catch (Exception ignored) {
            return 0L
        }
    }

    private String formatHeaderDate(Date date) {
        if (date == null) {
            return ''
        }
        return new SimpleDateFormat("MMM d, yyyy hh:mm:ss a", Locale.ENGLISH).format(date)
    }

    private String formatTime(Date date) {
        if (date == null) {
            return ''
        }
        return new SimpleDateFormat("hh:mm:ss a", Locale.ENGLISH).format(date)
    }

    private String formatDurationMillis(long millis) {
        long safeMillis = Math.max(0L, millis)
        long hours = safeMillis / 3600000L
        long minutes = (safeMillis % 3600000L) / 60000L
        long seconds = (safeMillis % 60000L) / 1000L
        long ms = safeMillis % 1000L

        if (hours > 0L) {
            return "${hours}h ${minutes}m ${seconds}s ${ms}ms"
        }
        if (minutes > 0L) {
            return "${minutes}m ${seconds}s ${ms}ms"
        }
        if (seconds > 0L) {
            return "${seconds}s ${ms}ms"
        }
        return "${ms}ms"
    }

    private String getOutputFileName() {
        try {
            String configured = safeValue(flow?.GAIA_REPORT_FILE_NAME)
            return configured ?: 'gaiaReport.html'
        } catch (Exception ignored) {
            return 'gaiaReport.html'
        }
    }

    private Document parseXml(String xmlPath) {
        if (isBlank(xmlPath)) {
            return null
        }

        File xmlFile = new File(xmlPath)
        if (!xmlFile.exists()) {
            return null
        }

        try {
            DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance()
            factory.setNamespaceAware(false)
            factory.setExpandEntityReferences(false)
            factory.setFeature("http://apache.org/xml/features/disallow-doctype-decl", true)
            factory.setFeature("http://xml.org/sax/features/external-general-entities", false)
            factory.setFeature("http://xml.org/sax/features/external-parameter-entities", false)

            def builder = factory.newDocumentBuilder()
            Document document = builder.parse(xmlFile)
            document.documentElement.normalize()
            return document
        } catch (Exception ignored) {
            return null
        }
    }

    private String getAttr(Element element, String attrName) {
        if (element == null || attrName == null) {
            return ''
        }
        if (!element.hasAttribute(attrName)) {
            return ''
        }
        return safeValue(element.getAttribute(attrName))
    }

    private Element firstChildElementByTag(Element parent, String tagName) {
        if (parent == null) {
            return null
        }

        NodeList children = parent.getChildNodes()
        for (int i = 0; i < children.getLength(); i++) {
            Node node = children.item(i)
            if (node.getNodeType() == Node.ELEMENT_NODE && safeValue(node.getNodeName()) == tagName) {
                return (Element) node
            }
        }
        return null
    }

    private List<Element> getDirectChildElementsByTag(Element parent, String tagName) {
        List<Element> result = []
        if (parent == null) {
            return result
        }

        NodeList children = parent.getChildNodes()
        for (int i = 0; i < children.getLength(); i++) {
            Node node = children.item(i)
            if (node.getNodeType() == Node.ELEMENT_NODE && safeValue(node.getNodeName()) == tagName) {
                result.add((Element) node)
            }
        }
        return result
    }

    private Date parseTimestampValue(String rawValue) {
        String raw = safeValue(rawValue)
        if (raw.isEmpty()) {
            return null
        }

        List<String> patterns = [
            "yyyy-MM-dd'T'HH:mm:ss",
            "yyyy-MM-dd'T'HH:mm:ss.SSS",
            "yyyy-MM-dd HH:mm:ss",
            "yyyy-MM-dd'T'HH:mm:ssX",
            "yyyy-MM-dd'T'HH:mm:ss.SSSX"
        ]

        for (String pattern : patterns) {
            try {
                return new SimpleDateFormat(pattern, Locale.ENGLISH).parse(raw)
            } catch (Exception ignored) {
            }
        }

        return null
    }

    private Date resolveSuiteStartDate(String xmlPath, long fallbackStartMillis) {
        Document document = parseXml(xmlPath)
        if (document == null || document.getDocumentElement() == null) {
            return new Date(fallbackStartMillis)
        }

        Element root = document.getDocumentElement()
        String rootName = safeValue(root.getNodeName())
        String timestampValue = ''

        if (rootName == 'testsuite') {
            timestampValue = getAttr(root, 'timestamp')
        } else if (rootName == 'testsuites') {
            List<Element> suites = getDirectChildElementsByTag(root, 'testsuite')
            if (!suites.isEmpty()) {
                timestampValue = getAttr(suites[0], 'timestamp')
            }
        }

        Date parsed = parseTimestampValue(timestampValue)
        if (parsed != null) {
            return parsed
        }

        return new Date(fallbackStartMillis)
    }

    List<Map> parseXmlCases(String xmlPath) {
        List<Map> result = []

        Document document = parseXml(xmlPath)
        if (document == null || document.getDocumentElement() == null) {
            return result
        }

        Element root = document.getDocumentElement()
        String rootName = safeValue(root.getNodeName())

        List<Element> testcaseNodes = []

        if (rootName == 'testsuite') {
            testcaseNodes.addAll(getDirectChildElementsByTag(root, 'testcase'))
        } else if (rootName == 'testsuites') {
            List<Element> suites = getDirectChildElementsByTag(root, 'testsuite')
            suites.each { Element suite ->
                testcaseNodes.addAll(getDirectChildElementsByTag(suite, 'testcase'))
            }
        }

        testcaseNodes.eachWithIndex { Element tc, int index ->
            String className = getAttr(tc, 'classname')
            String testName = getAttr(tc, 'name')
            long durationMs = toMillis(getAttr(tc, 'time'))

            Element failureNode = firstChildElementByTag(tc, 'failure')
            Element errorNode = firstChildElementByTag(tc, 'error')
            Element skippedNode = firstChildElementByTag(tc, 'skipped')

            boolean failed = failureNode != null || errorNode != null
            boolean skipped = skippedNode != null

            String message = ''
            String details = ''

            if (failureNode != null) {
                message = getAttr(failureNode, 'message')
                details = stripAnsi(failureNode.getTextContent())
            } else if (errorNode != null) {
                message = getAttr(errorNode, 'message')
                details = stripAnsi(errorNode.getTextContent())
            } else if (skippedNode != null) {
                message = getAttr(skippedNode, 'message')
                details = stripAnsi(skippedNode.getTextContent())
            }

            String displayName = ''
            if (!isBlank(className) && !isBlank(testName)) {
                displayName = className + '/' + testName
            } else if (!isBlank(testName)) {
                displayName = testName
            } else {
                displayName = className
            }

            String status = skipped ? 'skipped' : (failed ? 'failed' : 'passed')

            Map row = [:]
            row.id = "case_${index + 1}"
            row.name = displayName
            row.shortName = isBlank(testName) ? displayName : testName
            row.durationMs = durationMs
            row.status = status
            row.statusClass = status == 'failed' ? 'fail' : (status == 'skipped' ? 'skip' : 'pass')
            row.statusLabel = status == 'failed' ? 'Fail' : (status == 'skipped' ? 'Skipped' : 'Pass')
            row.message = message
            row.details = details

            result.add(row)
        }

        return result
    }

    private List<File> collectFailureImages(String reportFolder) {
        List<File> images = []

        if (isBlank(reportFolder)) {
            return images
        }

        File base = new File(reportFolder)
        if (!base.exists()) {
            return images
        }

        base.eachFileRecurse { File file ->
            if (!file.isFile()) {
                return
            }

            String name = file.name.toLowerCase(Locale.ENGLISH)

            if (name.endsWith('.png') || name.endsWith('.jpg') || name.endsWith('.jpeg')) {
                String lowerPath = file.absolutePath.toLowerCase(Locale.ENGLISH)

                if (!lowerPath.contains(File.separator + 'requests' + File.separator)) {
                    images.add(file)
                }
            }
        }

        images.sort { File a, File b -> a.lastModified() <=> b.lastModified() }
        return images
    }

    private String toDataUri(File file) {
        if (file == null || !file.exists() || !file.isFile()) {
            return ''
        }

        try {
            byte[] bytes = Files.readAllBytes(file.toPath())
            String base64 = Base64.encoder.encodeToString(bytes)

            String name = file.name.toLowerCase(Locale.ENGLISH)
            String mimeType = 'image/png'
            if (name.endsWith('.jpg') || name.endsWith('.jpeg')) {
                mimeType = 'image/jpeg'
            }

            return "data:${mimeType};base64,${base64}"
        } catch (Exception ignored) {
            return ''
        }
    }

    private List<String> getFailureSummaryLines(String message, String details) {
        List<String> lines = []

        String safeMessage = stripAnsi(message)
        String safeDetails = stripAnsi(details)

        if (!isBlank(safeMessage)) {
            lines.add(safeMessage)
        }

        safeDetails.readLines().each { String raw ->
            String line = safeValue(raw)

            if (isBlank(line)) {
                return
            }
            if (line.startsWith('at ')) {
                return
            }
            if (line.startsWith('Caused by: at ')) {
                return
            }
            if (line.contains('com.kms.katalon') && line.length() > 120) {
                return
            }
            if (line.contains('org.openqa.selenium') && line.length() > 120) {
                return
            }

            lines.add(line)
        }

        List<String> cleaned = []
        lines.each { String item ->
            String normalized = safeValue(item).replaceAll(/\s+/, ' ').trim()
            if (!isBlank(normalized) && !cleaned.contains(normalized)) {
                cleaned.add(normalized)
            }
        }

        if (cleaned.isEmpty() && !isBlank(safeDetails)) {
            safeDetails.readLines().each { String raw ->
                String line = safeValue(raw)
                if (!isBlank(line) && cleaned.size() < 4) {
                    cleaned.add(line)
                }
            }
        }

        if (cleaned.size() > 4) {
            return cleaned.subList(0, 4)
        }

        return cleaned
    }

    String createGaiaHtmlReport(String reportFolder, String suiteName, String xmlPath) {
        if (isBlank(reportFolder) || isBlank(xmlPath)) {
            return ''
        }

        List<Map> cases = parseXmlCases(xmlPath)

        long totalDurationMs = 0L
        cases.each { Map item ->
            totalDurationMs += ((item.durationMs ?: 0L) as long)
        }

        File reportDir = new File(reportFolder)
        Date endDate = new Date(reportDir.lastModified())
        long fallbackStartMillis = endDate.time - totalDurationMs
        Date suiteStartDate = resolveSuiteStartDate(xmlPath, fallbackStartMillis)

        long runningMillis = suiteStartDate.time
        cases.each { Map item ->
            long durationMs = (item.durationMs ?: 0L) as long
            Date itemStart = new Date(runningMillis)

            item.startDateText = formatHeaderDate(itemStart)
            item.timeText = formatTime(itemStart)
            item.durationText = formatDurationMillis(durationMs)
            item.summaryLines = getFailureSummaryLines(item.message, item.details)

            runningMillis += durationMs
        }

        List<File> failureImages = collectFailureImages(reportFolder)
        List<Map> failedCases = cases.findAll { Map item -> safeValue(item.status) == 'failed' }

        int imageIndex = 0
        failedCases.each { Map item ->
            if (imageIndex < failureImages.size()) {
                File image = failureImages[imageIndex]
                item.imageData = toDataUri(image)
                item.imageName = image.name
                imageIndex++
            } else {
                item.imageData = ''
                item.imageName = ''
            }
        }

        cases.each { Map item ->
            if (!item.containsKey('imageData')) {
                item.imageData = ''
                item.imageName = ''
            }
        }

        int executed = cases.size()
        int passedCount = cases.count { Map item -> safeValue(item.status) == 'passed' }
        int failedCount = cases.count { Map item -> safeValue(item.status) == 'failed' }
        int skippedCount = cases.count { Map item -> safeValue(item.status) == 'skipped' }

        String avgTest = executed > 0
            ? formatDurationMillis((long) (totalDurationMs / executed))
            : '0ms'

        Map model = [:]
        model.reportTitle = 'GAIA Execution'
        model.suiteName = safeValue(suiteName)
        model.generatedAt = formatHeaderDate(new Date())
        model.startDate = formatHeaderDate(suiteStartDate)
        model.endDate = formatHeaderDate(endDate)
        model.duration = formatDurationMillis(totalDurationMs)
        model.executed = executed
        model.passed = passedCount
        model.failed = failedCount
        model.skipped = skippedCount
        model.avgTest = avgTest
        model.cases = cases

        String html = htmlBuilder.buildReportHtml(model)

        File htmlFile = new File(reportFolder + File.separator + getOutputFileName())
        htmlFile.setText(html, 'UTF-8')
        return htmlFile.absolutePath
    }
