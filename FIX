		}

		List<Map> scenarios = []
		Map currentScenario = null
		Map currentStep = null

		Closure finishStep = {
			if (currentScenario == null || currentStep == null) {
				return
			}

			if (isBlank(currentStep.status)) {
				currentStep.status = 'passed'
			}

			currentStep.detailText = isBlank(currentStep.detailText)
					? safeValue(currentStep.title)
					: currentStep.detailText

			if (currentStep.detailLines instanceof List && !(currentStep.detailLines as List).isEmpty()) {
				currentStep.detailText = normalizeText(currentStep.detailLines as List<String>)
			}

			if (currentStep.errorLines instanceof List && !(currentStep.errorLines as List).isEmpty()) {
				currentStep.errorFull = normalizeText(currentStep.errorLines as List<String>)
			}

			if (isBlank(currentStep.shortError)) {
				currentStep.shortError = extractShortError(currentStep.errorFull ?: currentStep.detailText)
			}

			if (toLong(currentStep.durationMs) <= 0L) {
				currentStep.durationMs = 1000L
			}

			currentStep.durationLabel = formatDurationFull(toLong(currentStep.durationMs))
			currentStep = null
