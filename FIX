	@Keyword
	void createFavoriteFromCurrentModule(
			String favoriteTitle,
			Integer controlTimeoutSeconds,
			Integer popupTimeoutSeconds
	) {

		Integer controlTimeout =
				safeTimeout(
				controlTimeoutSeconds,
				5
				)

		Integer popupTimeout =
				safeTimeout(
				popupTimeoutSeconds,
				5
				)

		String cleanFavoriteTitle =
				safeText(
				favoriteTitle
				)

		if (cleanFavoriteTitle.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Favorite title is empty.'
					)

			return
		}

		logStep(
				'CREATE FAVORITE',
				'Favorite title: ' + cleanFavoriteTitle + '\n' +
				'Create and save timeout: ' + controlTimeout + ' seconds\n' +
				'Confirmation image timeout: 3 attempts of 5 seconds'
				)

		KeywordUtil.logInfo(
				'Waiting 2 seconds before clicking Create Favorite.'
				)

		Windows.delay(2)

		KeywordUtil.logInfo(
				'Searching for the Create Favorite image.\n' +
				'Image key: createFavoriteIcon\n' +
				'Timeout: ' + controlTimeout + ' seconds'
				)

		boolean createFavoriteClicked =
				clickFirstVisibleImage(
				GENERAL_IMAGE_GROUP,
				[
					'createFavoriteIcon'
				],
				controlTimeout
				)

		if (!createFavoriteClicked) {
			takeEvidence(
					'GUI_CreateFavoriteImageNotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					'Create Favorite image was not found within ' +
					controlTimeout +
					' seconds.\n' +
					'Image group: ' + GENERAL_IMAGE_GROUP + '\n' +
					'Image key: createFavoriteIcon'
					)

			return
		}

		KeywordUtil.logInfo(
				'Create Favorite image clicked. Filling the favorite title.'
				)

		Windows.delay(1)

		typeOnImage(
				GUI_IMAGE_GROUP,
				'favoriteFilterField',
				cleanFavoriteTitle,
				controlTimeout
				)

		KeywordUtil.logInfo(
				'Favorite title entered. Searching for the Save Favorite image.\n' +
				'Image key: saveFavoriteIcon\n' +
				'Timeout: ' + controlTimeout + ' seconds'
				)

		Windows.delay(1)

		boolean saveFavoriteClicked =
				clickFirstVisibleImage(
				GENERAL_IMAGE_GROUP,
				[
					'saveFavoriteIcon'
				],
				controlTimeout
				)

		if (saveFavoriteClicked) {
			KeywordUtil.logInfo(
					'Save Favorite image clicked.'
					)
		} else {
			KeywordUtil.logInfo(
					'Save Favorite image was not found. Using TAB and ENTER.'
					)

			takeEvidence(
					'GUI_SaveFavoriteImageNotFound_UsingKeyboard.png'
					)

			pressKeyboardKey(
					KeyEvent.VK_TAB
					)

			Windows.delay(1)

			pressKeyboardKey(
					KeyEvent.VK_ENTER
					)

			KeywordUtil.logInfo(
					'TAB and ENTER were pressed to save the favorite.'
					)
		}

		KeywordUtil.logInfo(
				'Waiting for the favorite confirmation OK image.\n' +
				'Maximum wait: 3 attempts of 5 seconds'
				)

		boolean confirmationClosed =
				clickImageWithAttempts(
				GENERAL_IMAGE_GROUP,
				[
					'okModal',
					'okModal2Version'
				],
				3,
				5
				)

		if (!confirmationClosed) {
			takeEvidence(
					'GUI_FavoriteConfirmationOkNotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					'Favorite confirmation OK image was not found after 3 attempts of 5 seconds.\n' +
					'Favorite: ' + cleanFavoriteTitle
					)

			return
		}

		KeywordUtil.logInfo(
				'Favorite confirmation OK image clicked. Continuing immediately.'
				)

		KeywordUtil.markPassed(
				'Favorite created successfully.\n' +
				'Title: ' + cleanFavoriteTitle + '\n' +
				'Save method: ' +
				(saveFavoriteClicked ? 'image' : 'TAB and ENTER')
				)
	}



	// ======================================================
	// OPEN FAVORITE
	// ======================================================

	@Keyword
	void closeAllTabsAndOpenFavorite(
			String favoriteTitle,
			String openedTabName,
			String favoriteImageKey,
			Integer timeoutSeconds
	) {

		Integer timeout =
				safeTimeout(
				timeoutSeconds,
				5
				)

		String cleanFavoriteTitle =
				safeText(
				favoriteTitle
				)

		String cleanFavoriteImageKey =
				safeText(
				favoriteImageKey
				)

		if (cleanFavoriteTitle.isEmpty()) {
			KeywordUtil.logInfo(
					'[FAIL] Favorite title is empty.'
					)

			KeywordUtil.markFailedAndStop(
					'Favorite title is empty.'
					)

			return
		}

		logStep(
				'OPEN FAVORITE',
				'Favorite: ' + cleanFavoriteTitle + '\n' +
				'Timeout for each image or object search: ' +
				timeout +
				' seconds'
				)

		KeywordUtil.logInfo(
				'[IMAGE] Starting Close All Tabs.'
				)

		closeAllTabs(
				timeout
				)

		KeywordUtil.logInfo(
				'[OBJECT] Opening Favorites tab.'
				)

		clickRequiredObject(
				'favoritesTab',
				'Favorites tab',
				timeout,
				'GUI_FavoritesTabNotFound.png'
				)

		Windows.delay(1)

		boolean favoriteClickedByImage = false

		if (!cleanFavoriteImageKey.isEmpty()) {
			KeywordUtil.logInfo(
					'[IMAGE] Searching for the created favorite.\n' +
					'Image key: ' + cleanFavoriteImageKey + '\n' +
					'Timeout: ' + timeout + ' seconds'
					)

			favoriteClickedByImage =
					clickFirstVisibleImage(
					GUI_IMAGE_GROUP,
					[
						cleanFavoriteImageKey
					],
					timeout
					)
		}

		boolean favoriteClickedByObject = false

		if (!favoriteClickedByImage) {
			KeywordUtil.logInfo(
					'[OBJECT] Favorite image was not found. Searching by object.\n' +
					'Favorite: ' + cleanFavoriteTitle + '\n' +
					'Timeout: ' + timeout + ' seconds'
					)

			WindowsTestObject favoriteItem =
					WindowsObjectLoader.getTreeItemByName(
					cleanFavoriteTitle
					)

			boolean favoriteObjectFound =
					Windows.waitForElementPresent(
					favoriteItem,
					timeout,
					FailureHandling.OPTIONAL
					)

			if (favoriteObjectFound) {
				Windows.click(
						favoriteItem,
						FailureHandling.STOP_ON_FAILURE
						)

				favoriteClickedByObject = true

				KeywordUtil.logInfo(
						'[OBJECT] Created favorite found and clicked.'
						)
			}
		}

		if (!favoriteClickedByImage && !favoriteClickedByObject) {
			takeEvidence(
					'GUI_CreatedFavoriteNotFound.png'
					)

			KeywordUtil.logInfo(
					'[FAIL] Created favorite was not found by image or object.'
					)

			KeywordUtil.markFailedAndStop(
					'Created favorite was not found.\n' +
					'Favorite: ' + cleanFavoriteTitle + '\n' +
					'Image key: ' + cleanFavoriteImageKey + '\n' +
					'Image timeout: ' + timeout + ' seconds\n' +
					'Object timeout: ' + timeout + ' seconds'
					)

			return
		}

		KeywordUtil.logInfo(
				'[PASS] Created favorite clicked successfully.\n' +
				'Continuing directly to export without validating the opened tab.'
				)

		takeEvidence(
				'GUI_CreatedFavoriteClicked.png'
				)
	}


