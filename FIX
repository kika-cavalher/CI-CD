package jiraIntegration

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import org.openqa.selenium.OutputType

import javax.imageio.ImageIO

import java.awt.Graphics2D
import java.awt.GraphicsEnvironment
import java.awt.Rectangle
import java.awt.Robot
import java.awt.Toolkit
import java.awt.image.BufferedImage
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale

class ImagesEvidence {

    private static final SimpleDateFormat FILE_STAMP =
        new SimpleDateFormat('yyyyMMdd_HHmmss_SSS', Locale.ENGLISH)

    private static final ThreadLocal<String> CURRENT_CASE_ID = new ThreadLocal<String>()

    @Keyword
    static void startCase(String caseId) {
        CURRENT_CASE_ID.set(safe(caseId))
    }

    @Keyword
    static void finishCase() {
        CURRENT_CASE_ID.remove()
    }

    @Keyword
    static void note(String message) {
        KeywordUtil.logInfo('[REPORT_NOTE] ' + safe(message))
    }

    @Keyword
    static void checkpoint(String message) {
        KeywordUtil.logInfo('[REPORT_CHECKPOINT] ' + safe(message))
    }

    @Keyword
    static File captureNow(String label = 'manual') {
        String caseId = safe(CURRENT_CASE_ID.get())
        if (caseId.isEmpty()) {
            caseId = 'Unknown_Test_Case'
        }

        return captureForCase(caseId, label)
    }

    @Keyword
    static File noteAndCapture(String message, String label = 'manual') {
        note(message)
        return captureNow(label)
    }

    static File autoFailure(String caseId) {
        return captureForCase(caseId, 'auto-failure')
    }

    private static File captureForCase(String caseId, String label) {
        try {
            File evidencesRoot = new File(RunConfiguration.getReportFolder(), 'Evidences')
            File caseFolder = new File(evidencesRoot, sanitizeFolderName(caseId))

            if (!caseFolder.exists()) {
                caseFolder.mkdirs()
            }

            String fileName = FILE_STAMP.format(new Date()) + '_' + sanitizeFileName(label) + '.png'
            File target = new File(caseFolder, fileName)

            BufferedImage image = tryDriverScreenshot()
            if (image == null) {
                image = captureDesktop()
            }

            if (image == null) {
                KeywordUtil.logInfo('Evidence screenshot could not be captured.')
                return null
            }

            ImageIO.write(image, 'png', target)
            KeywordUtil.logInfo('Evidence screenshot saved: ' + target.absolutePath)

            return target
        } catch (Throwable t) {
            KeywordUtil.logInfo('Evidence capture failed: ' + safe(t.message))
            return null
        }
    }

    private static BufferedImage tryDriverScreenshot() {
        try {
            def driver = Windows.getDriver()
            if (driver == null) {
                return null
            }

            byte[] bytes = driver.getScreenshotAs(OutputType.BYTES)
            if (bytes == null || bytes.length == 0) {
                return null
            }

            return ImageIO.read(new ByteArrayInputStream(bytes))
        } catch (Throwable ignored) {
            return null
        }
    }

    private static BufferedImage captureDesktop() {
        try {
            if (GraphicsEnvironment.isHeadless()) {
                return null
            }

            Robot robot = new Robot()
            Rectangle rect = new Rectangle(Toolkit.getDefaultToolkit().getScreenSize())
            BufferedImage raw = robot.createScreenCapture(rect)

            int maxWidth = 1800
            if (raw.width <= maxWidth) {
                return raw
            }

            double scale = (double) maxWidth / (double) raw.width
            int newWidth = (int) Math.round(raw.width * scale)
            int newHeight = (int) Math.round(raw.height * scale)

            BufferedImage resized = new BufferedImage(newWidth, newHeight, BufferedImage.TYPE_INT_RGB)
            Graphics2D graphics = resized.createGraphics()
            try {
                graphics.drawImage(raw, 0, 0, newWidth, newHeight, null)
            } finally {
                graphics.dispose()
            }

            return resized
        } catch (Throwable ignored) {
            return null
        }
    }

    private static String sanitizeFolderName(String value) {
        return safe(value)
            .replace('\\', '_')
            .replace('/', '_')
            .replaceAll(/[^A-Za-z0-9._ -]+/, '_')
            .replaceAll(/[ ]+/, '_')
            .replaceAll(/_+/, '_')
            .trim()
    }

    private static String sanitizeFileName(String value) {
        String clean = safe(value)
        if (clean.isEmpty()) {
            clean = 'evidence'
        }

        return clean
            .replace('\\', '_')
            .replace('/', '_')
            .replaceAll(/[^A-Za-z0-9._ -]+/, '_')
            .replaceAll(/[ ]+/, '-')
            .replaceAll(/-+/, '-')
            .trim()
    }

    private static String safe(Object value) {
        return value == null ? '' : String.valueOf(value).trim()
    }
}
