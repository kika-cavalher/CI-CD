import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import java.awt.Robot
import java.awt.event.KeyEvent

import org.openqa.selenium.WebElement
import org.openqa.selenium.interactions.Actions

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.driver.WindowsDriverFactory
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows
import com.kms.katalon.core.windows.keyword.helper.WindowsActionHelper

import io.appium.java_client.AppiumDriver as AppiumDriver

String currEnv = Windows.getText(findWindowsObject('Object Repository/General/curEnv')).equalsIgnoreCase('Recette') ? 'Rec' : 'PROD'
CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Current environment detected: ' + currEnv)

String imgDir = RunConfiguration.getProjectDir() + File.separator + 'Images' + File.separator + 'BDR' + File.separator
String firstDimension = new File(imgDir, 'measures.PNG').getAbsolutePath()
String lastDimension = new File(imgDir, 'provic.png').getAbsolutePath()
String provicOpen = new File(imgDir, 'provicOpen.png').getAbsolutePath()
String normeOpen = new File(imgDir, 'normeOpen.png').getAbsolutePath()
String endOfDimensions = new File(imgDir, 'endOfDimensions.PNG').getAbsolutePath()
String startOfDimensions = new File(imgDir, "startOfDimension_${currEnv}.PNG").getAbsolutePath()

String firstPageRef = new File(imgDir, "FirstPageOfDimensions${currEnv}.PNG").getAbsolutePath()
String secondPageRef = new File(imgDir, "SecondPageOfDimensions${currEnv}.PNG").getAbsolutePath()
String thirdPageRef = new File(imgDir, "ThirdPageOfDimensions${currEnv}.PNG").getAbsolutePath()

String zoneLignes = new File(imgDir, 'ZoneLignes.png').getAbsolutePath()
String zoneLignesArrowDown = new File(imgDir, 'ZoneLignes_arrowDown.png').getAbsolutePath()
String tableColWithArrows = new File(imgDir, 'tableWithArrows.png').getAbsolutePath()

String evidenceDir = RunConfiguration.getReportFolder() + "\\Evidences\\"
new File(evidenceDir).mkdirs()

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Image references resolved for complete BDR validation flow')

[firstDimension, lastDimension, provicOpen, normeOpen, endOfDimensions, startOfDimensions, firstPageRef, secondPageRef, thirdPageRef, zoneLignes, zoneLignesArrowDown, tableColWithArrows].each { path ->
	if (!new File(path).exists()) {
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Missing required image file: ' + path)
		KeywordUtil.markFailedAndStop("❌ Missing image file: ${path}")
	}
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('All required image files were verified successfully')

String errors = ''
Robot robot = new Robot()

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Clicking first dimension to focus the dimensions list')
WindowsImageKeywords.clickImage(firstDimension)

int maxOpen = 95
int maxScrolls = 30
int scrollCount = 0

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Expanding dimensions list until open state is reached')
while (!WindowsImageKeywords.findImage(normeOpen) && scrollCount < maxOpen) {
	scrollCount++
	robot.keyPress(KeyEvent.VK_RIGHT)
	robot.keyRelease(KeyEvent.VK_RIGHT)

	robot.keyPress(KeyEvent.VK_DOWN)
	robot.keyRelease(KeyEvent.VK_DOWN)
}

if (scrollCount >= maxScrolls) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Warning: end of dimensions not found after maximum scroll attempts')
	KeywordUtil.markWarning("endOfDimensions image not found after ${maxScrolls} scrolls.")
}

scrollCount = 0
CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Returning to the top of the dimensions list')
while (!WindowsImageKeywords.findImage(firstDimension) && scrollCount < maxScrolls) {
	scrollCount++
	Windows.click(findWindowsObject('Object Repository/BDR/scrollUpDimensions'))
	println("Searching for start image... Found: " + WindowsImageKeywords.findImage(firstDimension))
}

if (scrollCount >= maxScrolls) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Warning: could not return to the top of the dimensions list')
	KeywordUtil.markWarning("Could not scroll to top — startOfDimensions not found after ${maxScrolls} attempts.")
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Capturing and validating the first page of dimensions')
WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession()).takeScreenshot(evidenceDir + "First_Page_Dimensions_${currEnv}.PNG")

if (!WindowsImageKeywords.findImage(firstPageRef)) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('First page validation failed for environment: ' + currEnv)
	errors += "\n The dimensions list (Begin Scroll) does not match in env: ${currEnv}\n"
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Scrolling to the middle section of the dimensions list')
for (int i = 0; i < 22; i++) {
	Windows.click(findWindowsObject('Object Repository/BDR/scrollDownDimensions'))
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Capturing and validating the second page of dimensions')
WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession()).takeScreenshot(evidenceDir + "Second_Page_Dimensions_${currEnv}.PNG")

if (!WindowsImageKeywords.findImage(secondPageRef)) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Second page validation failed for environment: ' + currEnv)
	errors += "\n The dimensions list (Mid Scroll) does not match in env: ${currEnv}\n"
}

scrollCount = 0
CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Scrolling to the end of the dimensions list')
while (!WindowsImageKeywords.findImage(lastDimension) && scrollCount < maxScrolls) {
	scrollCount++
	Windows.click(findWindowsObject('Object Repository/BDR/scrollDownDimensions'))
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Capturing and validating the third page of dimensions')
WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession()).takeScreenshot(evidenceDir + "Third_Page_Dimensions_${currEnv}.PNG")

if (!WindowsImageKeywords.findImage(thirdPageRef)) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Third page validation failed for environment: ' + currEnv)
	errors += "\n The dimensions list (End Scroll) does not match in env: ${currEnv}\n"
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Checking if ZoneLignes base image is visible on screen')
Windows.delay(2)
boolean zoneFound = WindowsImageKeywords.findImage(zoneLignes)

if (!zoneFound) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('ZoneLignes base image was not visible on screen')
	KeywordUtil.markFailedAndStop("❌ Base image ZoneLignes not visible on screen.")
}

try {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Clicking arrow down inside ZoneLignes')
	WindowsImageKeywords.clickImageInImage(zoneLignes, zoneLignesArrowDown)
	KeywordUtil.logInfo("🖱️ Clicked arrow-down inside ZoneLignes.")
} catch (Exception e) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Failed while clicking arrow in ZoneLignes')
	KeywordUtil.markFailedAndStop("❌ Failed clicking arrow in ZoneLignes: ${e.message}")
}

try {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Searching drag and drop source and target elements')
	WebElement fromElement = Windows.findElement(findWindowsObject('Object Repository/BDR/moisDarreteDimension'))
	WebElement toElement = Windows.findElement(findWindowsObject('Object Repository/BDR/measuresListDimensions'))

	if (fromElement == null || toElement == null) {
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Could not find one or both UI elements for drag and drop')
		KeywordUtil.markFailedAndStop("❌ Could not find one or both UI elements for drag-and-drop.")
	}

	AppiumDriver<?> driver = Windows.getDriver()
	Actions action = new Actions(driver)
	action.moveToElement(fromElement)
		  .clickAndHold()
		  .moveToElement(toElement)
		  .release()
		  .perform()

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Drag and drop completed from moisDarreteDimension to measuresListDimensions')
	KeywordUtil.logInfo("🔀 Drag-and-drop completed from moisDarreteDimension → measuresListDimensions.")
} catch (Exception e) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Drag and drop failed')
	KeywordUtil.markFailedAndStop("❌ Drag-and-drop failed: ${e.message}")
}

boolean tableVisible = false

try {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Waiting for expandable table with arrows to appear')
	tableVisible = WindowsImageKeywords.waitForImage(tableColWithArrows, 20)
	if (tableVisible) {
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Table with arrows detected on screen')
		KeywordUtil.logInfo("✅ Table with arrows detected on screen.")
	} else {
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Table with arrows not detected after timeout')
		KeywordUtil.markWarning("⚠️ Table with arrows not detected after timeout.")
	}
} catch (Exception e) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Error while waiting for table image')
	KeywordUtil.markWarning("⚠️ Error while waiting for table image: ${e.message}")
}

String screenshotPath = evidenceDir + "DimensionDeselected_${currEnv}.png"
CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Capturing evidence for dimension deselection result')
WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession()).takeScreenshot(screenshotPath)
KeywordUtil.logInfo("📸 Screenshot saved: ${screenshotPath}")

if (!WindowsImageKeywords.findImage(tableColWithArrows)) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Final table validation failed in environment: ' + currEnv)
	errors += "\n The dimension table is not expandable or not visible in env: ${currEnv}\n"
}

if (errors != '') {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Complete BDR validation flow finished with mismatches')
	KeywordUtil.markFailed('\n' + errors)
} else {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Complete BDR validation flow finished successfully for environment: ' + currEnv)
	KeywordUtil.markPassed("✅ All BDR validations finished successfully for env: ${currEnv}")
}
