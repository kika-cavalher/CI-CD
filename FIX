	private String limitVisualError(String text) {
		List<String> lines = safeValue(text)
				.readLines()
				.collect { safeValue(it) }
				.findAll { !it.isEmpty() }

		if (lines.isEmpty()) {
			return ''
		}

		List<String> result = []

		for (String line : lines) {
			String lower = line.toLowerCase(Locale.ENGLISH)

			if (line.startsWith('at ')) {
				break
			}

			if (lower.startsWith('original error:')) {
				break
			}

			result << line

			if (lower.startsWith('expected window title:')) {
				break
			}
		}

		if (result.isEmpty()) {
			int max = Math.min(lines.size(), 4)
			result = lines.take(max)
		}

		return result.join('\n')
	}

