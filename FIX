import java.io.File

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.exception.StepFailedException
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

String sourceValue = 'bilan'
String imageRelativePath = 'Images/Justification des Comptes de Latent/isSourceFilterApplied.PNG'

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Start bilan source filter validation')
CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Apply source filter with value bilan')
CustomKeywords.'com.katalon.ematch.helper.EmatchHelper.FilterBySourceInvestigations'(sourceValue)
Windows.delay(2)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Validate source filter application')

File validationImage = new File(RunConfiguration.getProjectDir(), imageRelativePath)

if (!validationImage.exists() || !validationImage.isFile()) {
    KeywordUtil.markFailed("Validation image not found: ${validationImage.absolutePath}")
}

boolean filterApplied = false
int maxAttempts = 6
int waitSeconds = 2

for (int attempt = 1; attempt <= maxAttempts; attempt++) {
    try {
        if (WindowsImageKeywords.findImage(validationImage.absolutePath)) {
            filterApplied = true
            break
        }
    } catch (Throwable ignored) {
    }

    Windows.delay(waitSeconds)
}

if (!filterApplied) {
    KeywordUtil.markFailed("Bilan filter not applied or image not found on screen: ${validationImage.name}")
} else {
    KeywordUtil.markPassed('Bilan filter applied correctly')
}
