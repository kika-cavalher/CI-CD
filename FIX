	private String readLegacyValue(
		String objectKey,
		Integer timeout,
		List<String> errors
	) {

		logObjectSearch(
			objectKey,
			'Read LegacyValue'
		)

		WindowsTestObject targetObject =
			object(objectKey)

		if (!Windows.waitForElementPresent(
			targetObject,
			timeout,
			FailureHandling.OPTIONAL
		)) {
			errors.add(
				'Object was not found: ' +
				objectKey
			)

			return ''
		}

		String value = safeText(
			Windows.getAttribute(
				targetObject,
				'LegacyValue',
				FailureHandling.OPTIONAL
			)
		)

		KeywordUtil.logInfo(
			'[INFO] LegacyValue for ' +
			objectKey +
			': ' +
			value
		)

		if (value.isEmpty()) {
			errors.add(
				'LegacyValue is empty for: ' +
				objectKey
			)
		}

		return value
	}


	private void validateGroupLabel(
		String rawValue,
		String expectedLabel,
		boolean requirePositiveInteger,
		List<String> errors
	) {

		String normalizedValue =
			safeText(rawValue)
				.replaceAll(/\s+/, ' ')

		Integer separatorIndex =
			normalizedValue.lastIndexOf(':')

		if (separatorIndex <= 0) {
			errors.add(
				'Invalid Group By format.\n' +
				'Expected: ' +
				expectedLabel +
				': NUMBER\n' +
				'Actual: ' +
				normalizedValue
			)

			return
		}

		String actualLabel =
			normalizedValue
				.substring(0, separatorIndex)
				.trim()

		String numericText =
			normalizedValue
				.substring(separatorIndex + 1)
				.trim()
				.replace(',', '.')

		if (!actualLabel.equalsIgnoreCase(
			expectedLabel
		)) {
			errors.add(
				'Unexpected Group By label.\n' +
				'Expected: ' +
				expectedLabel +
				'\nActual: ' +
				actualLabel
			)
		}

		try {
			BigDecimal numericValue =
				new BigDecimal(numericText)

			if (
				requirePositiveInteger &&
				numericValue <= BigDecimal.ZERO
			) {
				errors.add(
					expectedLabel +
					' value must be greater than zero.\n' +
					'Actual: ' +
					numericValue
				)
			}
		} catch (Exception ignored) {
			errors.add(
				expectedLabel +
				' numeric value is invalid.\n' +
				'Actual: ' +
				numericText
			)
		}
	}


