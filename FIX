package pageObject

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.TestObject
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows
import com.katalon.keywords.windows.WindowsImageKeywords


class RetournementDesInternesKeywords {


	// ======================================================
	// CONFIG
	// ======================================================

	private static final String IMAGE_GROUP ='RetournementDesInternes'

	private static final String OBJECT_GROUP ='retournementDesInternes'

	private static final Integer DEFAULT_TIMEOUT_SECONDS = 5


	// ======================================================
	// CLOSE FILTER
	// ======================================================

	@Keyword
	def closeFilter(
			Integer timeoutSeconds = DEFAULT_TIMEOUT_SECONDS
	) {

		KeywordUtil.logInfo(
				'Close Exclusion Trades filter'
				)

		Map<String, String> images =
				CustomKeywords.
				'commands.ImageLoader.getImages'(
				IMAGE_GROUP
				)

		Map<String, TestObject> objects =
				CustomKeywords.
				'commands.WindowsObjectLoader.getObjects'(
				OBJECT_GROUP
				)


		// ==================================================
		// OBJECT FIRST
		// ==================================================

		try {

			TestObject closeFilterButton =
					objects[
						'closeFilterButton'
					]

			if (
			closeFilterButton != null &&
					Windows.verifyElementPresent(
					closeFilterButton,
					timeoutSeconds,
					FailureHandling.OPTIONAL
					)
					) {

				Windows.click(
						closeFilterButton,
						FailureHandling.OPTIONAL
						)

				KeywordUtil.logInfo(
						'Filter closed using Windows object'
						)

				return
			}
		} catch (Throwable objectError) {

			KeywordUtil.logInfo(
					'Close filter object not available. ' +
					'Trying image fallback.'
					)
		}


		// ==================================================
		// IMAGE FALLBACK
		// ==================================================

		try {

			String closeFilterImage =
					images[
						'closeFilter'
					]

			if (
			closeFilterImage != null &&
					!closeFilterImage.trim().isEmpty()
					) {

				WindowsImageKeywords.clickOnDesktop(
						closeFilterImage
						)

				KeywordUtil.logInfo(
						'Filter closed using image fallback'
						)

				return
			}
		} catch (Throwable imageError) {

			KeywordUtil.logInfo(
					'Close filter image fallback failed'
					)
		}


		// ==================================================
		// FAILURE WITHOUT BLOCKING NEXT STEP
		// ==================================================

		KeywordUtil.markFailed(
				'Unable to close Exclusion Trades filter. ' +
				'Windows object and image fallback were not found.'
				)
	}
}
