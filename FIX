def nowStamp() {
    return new SimpleDateFormat("yyyyMMdd_HHmmss").format(new Date())
}

def sharedMarkerFile() {
    return "D:\\Projects\\eMatchStarters\\logs\\__jenkins_task_exitcode.txt"
}

def sharedCtxFile() {
    return "D:\\Projects\\eMatchStarters\\run-context.properties"
}

def writeContextFile(Map ctx) {
    def lines = []
    ctx.each { k, v ->
        lines << "${k}=${v}"
    }
    writeFile file: sharedCtxFile(), text: lines.join("\n")
    echo "[INFO] Context written to: ${sharedCtxFile()}"
}

def safeDelete(String path) {
    try {
        bat(label: "Delete if exists: ${path}", script: """
            @echo off
            if exist "${path}" del /f /q "${path}" 1>nul 2>nul
            if exist "${path}.tmp" del /f /q "${path}.tmp" 1>nul 2>nul
            exit /b 0
        """.trim())
    } catch (ignored) {
        echo "[WARN] Could not delete: ${path}"
    }
}

def waitForFile(String path, int timeoutSeconds) {
    int waited = 0
    int step = 2
    while (waited < timeoutSeconds) {
        def exists = fileExists(path)
        if (exists) return true
        sleep time: step, unit: 'SECONDS'
        waited += step
    }
    return false
}

def readMarkerWithRetry(String path, int maxAttempts, int sleepSeconds) {
    for (int i = 1; i <= maxAttempts; i++) {
        try {
            def txt = readFile(path).trim()
            if (txt?.isInteger()) return txt.toInteger()
            echo "[WARN] Marker content not numeric on attempt ${i}: '${txt}'"
        } catch (Exception ex) {
            echo "[WARN] Failed to read marker on attempt ${i}: ${ex.getClass().getName()} ${ex.message}"
        }
        sleep time: sleepSeconds, unit: 'SECONDS'
    }
    return null
}

