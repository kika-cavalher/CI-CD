import com.kms.katalon.core.util.KeywordUtil

import internal.GlobalVariable

// ======================================================
// VALIDATION CONFIG
// ======================================================

// Apache POI uses zero-based indexes.
// Excel column X = index 23.
Integer expectedColumnIndex = 23
String expectedColumnName = 'Valo finale ccy'

String validationName = 'Emission Dérivée'

// ======================================================
// TEST FLOW
// ======================================================

List<String> compareFiles = []

if (GlobalVariable.compareFiles instanceof Collection) {
	compareFiles.addAll(
		(GlobalVariable.compareFiles as Collection).collect { Object value ->
			value == null ? '' : value.toString().trim()
		}
	)
}

compareFiles = compareFiles.findAll { String filePath ->
	!filePath.isEmpty()
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Start REC x PRD validation\n' +
	'Feature: ' + validationName + '\n' +
	'Expected column index: ' + expectedColumnIndex + '\n' +
	'Expected column: ' + expectedColumnName
)

if (compareFiles.size() < 2) {
	String errorMessage =
		'REC x PRD validation cannot be executed.\n' +
		'Expected files: 2\n' +
		'Files received: ' + compareFiles.size() + '\n' +
		'REC file: ' +
		(compareFiles.size() > 0
			? compareFiles.get(0)
			: 'NOT FOUND') + '\n' +
		'PRD file: ' +
		(compareFiles.size() > 1
			? compareFiles.get(1)
			: 'NOT FOUND')

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[FAIL] Files available for validation\n' +
		errorMessage
	)

	KeywordUtil.markFailedAndStop(errorMessage)
}

String recFilePath = compareFiles.get(0)
String prdFilePath = compareFiles.get(1)

File recFile = new File(recFilePath)
File prdFile = new File(prdFilePath)

if (!recFile.exists() || !prdFile.exists()) {
	String errorMessage =
		'REC x PRD validation cannot be executed.\n' +
		'REC file: ' + recFile.getAbsolutePath() + '\n' +
		'REC exists: ' + recFile.exists() + '\n' +
		'PRD file: ' + prdFile.getAbsolutePath() + '\n' +
		'PRD exists: ' + prdFile.exists()

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[FAIL] Exported file validation\n' +
		errorMessage
	)

	KeywordUtil.markFailedAndStop(errorMessage)
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'[PASS] Files selected for validation\n' +
	'REC file: ' + recFile.getName() + '\n' +
	'PRD file: ' + prdFile.getName()
)

Map result =
	CustomKeywords.'commands.ExportFileValidationKeywords.validateRecPrdColumnStatistics'(
		compareFiles,
		expectedColumnIndex,
		expectedColumnName
	)

boolean success = result.success == true

String errors = safeText(result.errors)
String passedDetails = safeText(result.passedDetails)
String resolvedColumnName = safeText(result.columnName)

if (resolvedColumnName.isEmpty()) {
	resolvedColumnName = expectedColumnName
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	(success ? '[PASS] ' : '[FAIL] ') +
	'Excel validation result\n' +
	'Feature: ' + validationName + '\n' +
	'Expected column index: ' + expectedColumnIndex + '\n' +
	'Expected column: ' + expectedColumnName + '\n' +
	'Resolved column: ' + resolvedColumnName + '\n' +
	'REC file: ' + recFile.getName() + '\n' +
	'PRD file: ' + prdFile.getName() + '\n\n' +
	'Validation statistics\n' +
	'REC rows: ' + displayValue(result.recRows) + '\n' +
	'PRD rows: ' + displayValue(result.prdRows) + '\n' +
	'REC sum: ' + displayValue(result.recSum) + '\n' +
	'PRD sum: ' + displayValue(result.prdSum) + '\n' +
	'REC minimum: ' + displayValue(result.recMinimum) + '\n' +
	'PRD minimum: ' + displayValue(result.prdMinimum) + '\n' +
	'REC maximum: ' + displayValue(result.recMaximum) + '\n' +
	'PRD maximum: ' + displayValue(result.prdMaximum)
)

if (!success) {
	String failureMessage =
		'REC x PRD validation failed for ' +
		validationName + '.\n' +
		(errors.isEmpty()
			? 'Validation returned an unsuccessful result.'
			: errors)

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[FAIL] Final validation result\n' +
		failureMessage +
		(passedDetails.isEmpty()
			? ''
			: '\n\nSuccessful validations\n' + passedDetails)
	)

	KeywordUtil.markFailed(failureMessage)
} else {
	String successMessage =
		'REC x PRD validation completed successfully for ' +
		validationName + '.'

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[PASS] Final validation result\n' +
		successMessage +
		(passedDetails.isEmpty()
			? ''
			: '\n' + passedDetails)
	)

	KeywordUtil.markPassed(successMessage)
}

// ======================================================
// SUPPORT
// ======================================================

String displayValue(Object value) {
	String text = safeText(value)

	return text.isEmpty()
		? 'NOT AVAILABLE'
		: text
}

String safeText(Object value) {
	if (value == null) {
		return ''
	}

	return value.toString().trim()
}



import org.apache.poi.ss.usermodel.WorkbookFactory

import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil

import internal.GlobalVariable

int index = 15; //15 = Notionnel 
BigDecimal sum1, min1, max1, sum2, min2, max2;
String errors = '';
String msg = '';
def rows = GlobalVariable.compareRows as ArrayList;
def files = GlobalVariable.compareFiles as ArrayList;
String evPath = RunConfiguration.getReportFolder() + '\\Evidences\\';

if (rows.size() > 0) {
	if (rows.get(0) != rows.get(1)) errors+= '\n[ERROR] Number of rows (' + rows.get(0) + ') and (' + rows.get(1) + ') are different between the envs in Emission Filtrée.';
	else msg += '\nNumber of rows (' + rows.get(0) + ') and (' + rows.get(1) + ') are equal between the envs in Emission Filtrée.';
} else {
	//Getting files path
	String file1 = evPath + files.get(0);
	String file2 = evPath + files.get(1);
	
	//Reading excel files for comparison
	input1 = new FileInputStream(file1);
	input2 = new FileInputStream(file2);
	wbEnv1 = WorkbookFactory.create(input1);
	wbEnv2 = WorkbookFactory.create(input2);
	sheetEnv1 = wbEnv1.getSheetAt(0);
	sheetEnv2 = wbEnv2.getSheetAt(0);
	int linesEnv1 = sheetEnv1.getLastRowNum();
	int linesEnv2 = sheetEnv2.getLastRowNum();
	String col = sheetEnv1.getRow(0).getCell(index);
	
	//Number of Lines
	if (linesEnv1 != linesEnv2) errors += '\n[ERROR] Number of rows (' + linesEnv1 + ') of file ' + files.get(0) + ' is different than (' + linesEnv2 + ') of file ' + files.get(1) + '.';
	else msg += '\nNumber of rows (' + linesEnv1 + ') of file ' + files.get(0) + ' is equal to (' + linesEnv2 + ') of file ' + files.get(1) + '.';
	
	//Sum Validation
	sum1 = CustomKeywords.'com.katalon.keywords.excelHandling.ExcelValidations.totalSum'(sheetEnv1, index);
	sum2 = CustomKeywords.'com.katalon.keywords.excelHandling.ExcelValidations.totalSum'(sheetEnv2, index);
	sum1 = sum1.setScale(2, BigDecimal.ROUND_HALF_EVEN);
	sum2 = sum2.setScale(2, BigDecimal.ROUND_HALF_EVEN);
	
	if (sum1 != sum2) errors += '\n[ERROR] The sum of the amounts of REC (' + sum1 + ') and PROD (' + sum2 + ') are different.';
	else msg += '\nThe sum of the amounts of column ' + col + ' in ' + GlobalVariable.env + ' (' + sum1 + ') and PROD (' + sum2 + ') are equal.';
	
	//Min Validation
	min1 = CustomKeywords.'com.katalon.keywords.excelHandling.ExcelValidations.minAmount'(sheetEnv1, index);
	min2 = CustomKeywords.'com.katalon.keywords.excelHandling.ExcelValidations.minAmount'(sheetEnv2, index);
	min1 = min1.setScale(2,BigDecimal.ROUND_HALF_EVEN);
	min2= min2.setScale(2,BigDecimal.ROUND_HALF_EVEN);
	
	if (min1 != min2) errors += '\n[ERROR] The minimun amount of column ' + col + ' in ' + GlobalVariable.env + ' (' + min1 + ') and PROD (' + min2 + ') are different.';
	else msg += '\nThe minimun amount of column ' + col + ' in ' + GlobalVariable.env + ' (' + min1 + ') and PROD (' + min2 + ') are equal.';
	
	//Max Validation
	max1 = CustomKeywords.'com.katalon.keywords.excelHandling.ExcelValidations.maxAmount'(sheetEnv1, index);
	max2 = CustomKeywords.'com.katalon.keywords.excelHandling.ExcelValidations.maxAmount'(sheetEnv2, index);
	max1 = max1.setScale(2,BigDecimal.ROUND_HALF_EVEN);
	max2 = max2.setScale(2,BigDecimal.ROUND_HALF_EVEN);
	
	if (max1 != max2) errors += '\n[ERROR] The maximum amount of column ' + col + ' in ' + GlobalVariable.env + ' (' + max1 + ') and PROD (' + max2 + ') are different.';
	else msg += '\nThe maximum amount of the amount of column ' + col + ' in ' + GlobalVariable.env + ' (' + max1 + ') and PROD (' + max2 + ') are equal.';
}

//Fails if any validation didn't pass
if (errors.length() > 1)
	KeywordUtil.markFailed(errors + msg);
else
	KeywordUtil.markPassed('\n[SUCCESS] The between ' + GlobalVariable.env + ' and PROD of Emission Filtrée finished successfully!\n' + msg);
