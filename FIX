pipeline {
    agent { label 'GI5_SWDCFRNXGI55817' }

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        timeout(time: 180, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '15', daysToKeepStr: '20'))
    }

    environment {
        GIT_URL          = 'https://bitbucket-mut.mycloud.intrabpce.fr/scm/gi5/ematch-r-tests.git'
        GIT_BRANCH       = '*/master'
        GIT_CREDENTIAL   = 'adgi5appjenkins/******'

        KATALON_EXE      = 'C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0\\katalonc.exe'
        PROJECT_FILE     = 'eMatch POC.prj'
        REPORTS_ROOT     = "${WORKSPACE}\\Reports"
        WIN_DRIVER_TASK  = 'startWinDriver'
        CLOSE_BAT_PATH   = 'D:\\Projects\\eMatchStarters\\closeEmatch.bat'
        NEXT_JOB_NAME    = 'Passerelle Bilan'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: env.GIT_BRANCH]],
                    userRemoteConfigs: [[url: env.GIT_URL, credentialsId: env.GIT_CREDENTIAL]],
                    extensions: [
                        [$class: 'CloneOption', shallow: false, noTags: false, timeout: 30]
                    ]
                ])
            }
        }

        stage('Validate Environment') {
            steps {
                bat """
@echo off
echo ------------------------------------------------------------
echo VALIDATING ENVIRONMENT
echo ------------------------------------------------------------

if not exist "%KATALON_EXE%" (
    echo [ERROR] Katalon executable not found
    echo %KATALON_EXE%
    exit /b 1
)

if not exist "%WORKSPACE%\\%PROJECT_FILE%" (
    echo [ERROR] Project file not found
    echo %WORKSPACE%\\%PROJECT_FILE%
    exit /b 1
)

if exist "%REPORTS_ROOT%" rmdir /s /q "%REPORTS_ROOT%"
mkdir "%REPORTS_ROOT%"
mkdir "%REPORTS_ROOT%\\logs"

echo [OK] Environment validated
echo ------------------------------------------------------------
"""
            }
        }

        stage('Run Archive Mode Suite') {
            steps {
                powershell '''
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

function Start-WinDriverTask {
    param([string]$TaskName)

    if ([string]::IsNullOrWhiteSpace($TaskName)) { return }

    Write-Host "[INFO] Starting WinDriver task: $TaskName"
    schtasks /run /tn $TaskName | Out-Host
    Start-Sleep -Seconds 3
}

function Stop-WinDriverTask {
    param([string]$TaskName)

    if ([string]::IsNullOrWhiteSpace($TaskName)) { return }

    try {
        Write-Host "[INFO] Stopping WinDriver task: $TaskName"
        schtasks /end /tn $TaskName 1>$null 2>$null
    }
    catch {
    }
}

function Run-CloseBatIfNeeded {
    param([string]$BatPath)

    if ([string]::IsNullOrWhiteSpace($BatPath)) { return }
    if (-not (Test-Path -LiteralPath $BatPath)) {
        Write-Host "[WARN] close bat not found: $BatPath"
        return
    }

    Write-Host "[INFO] Running close bat: $BatPath"
    Start-Process -FilePath 'cmd.exe' -ArgumentList '/c', ('"' + $BatPath + '"') -Wait -NoNewWindow
    Start-Sleep -Seconds 2
}

Start-WinDriverTask -TaskName $env:WIN_DRIVER_TASK

try {
    & "$env:KATALON_EXE" `
        -noSplash `
        -runMode=console `
        -consoleLog `
        -projectPath="$env:WORKSPACE\\$env:PROJECT_FILE" `
        -retry=0 `
        -testSuitePath="Test Suites/ArchiveMode/Archive Mode" `
        -browserType="Windows" `
        -reportFolder="$env:REPORTS_ROOT"

    if ($LASTEXITCODE -ne 0) {
        throw "Archive Mode suite failed with exit code $LASTEXITCODE"
    }
}
finally {
    Run-CloseBatIfNeeded -BatPath $env:CLOSE_BAT_PATH
    Stop-WinDriverTask -TaskName $env:WIN_DRIVER_TASK
}
'''
            }
        }

        stage('Run Archive Mode Collection') {
            steps {
                powershell '''
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

function Start-WinDriverTask {
    param([string]$TaskName)

    if ([string]::IsNullOrWhiteSpace($TaskName)) { return }

    Write-Host "[INFO] Starting WinDriver task: $TaskName"
    schtasks /run /tn $TaskName | Out-Host
    Start-Sleep -Seconds 3
}

function Stop-WinDriverTask {
    param([string]$TaskName)

    if ([string]::IsNullOrWhiteSpace($TaskName)) { return }

    try {
        Write-Host "[INFO] Stopping WinDriver task: $TaskName"
        schtasks /end /tn $TaskName 1>$null 2>$null
    }
    catch {
    }
}

function Run-CloseBatIfNeeded {
    param([string]$BatPath)

    if ([string]::IsNullOrWhiteSpace($BatPath)) { return }
    if (-not (Test-Path -LiteralPath $BatPath)) {
        Write-Host "[WARN] close bat not found: $BatPath"
        return
    }

    Write-Host "[INFO] Running close bat: $BatPath"
    Start-Process -FilePath 'cmd.exe' -ArgumentList '/c', ('"' + $BatPath + '"') -Wait -NoNewWindow
    Start-Sleep -Seconds 2
}

Start-WinDriverTask -TaskName $env:WIN_DRIVER_TASK

try {
    & "$env:KATALON_EXE" `
        -noSplash `
        -runMode=console `
        -consoleLog `
        -projectPath="$env:WORKSPACE\\$env:PROJECT_FILE" `
        -retry=0 `
        -testSuiteCollectionPath="Test Suites/ArchiveMode/Archive Mode Collection" `
        -browserType="Windows" `
        -reportFolder="$env:REPORTS_ROOT"

    if ($LASTEXITCODE -ne 0) {
        throw "Archive Mode Collection failed with exit code $LASTEXITCODE"
    }
}
finally {
    Run-CloseBatIfNeeded -BatPath $env:CLOSE_BAT_PATH
    Stop-WinDriverTask -TaskName $env:WIN_DRIVER_TASK
}
'''
            }
        }
    }

    post {
        always {
            junit allowEmptyResults: true, testResults: 'Reports/**/JUnit_Report.xml'
            archiveArtifacts artifacts: 'Reports/**/*', allowEmptyArchive: true
        }

        success {
            script {
                if (env.NEXT_JOB_NAME?.trim()) {
                    build job: env.NEXT_JOB_NAME, wait: false, propagate: false
                }
            }
        }
    }
}
