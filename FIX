import com.kms.katalon.core.util.KeywordUtil

import internal.GlobalVariable

// ======================================================
// VALIDATION CONFIG
// ======================================================

Integer expectedColumnIndex = 15
String expectedColumnName = 'Notdone1'
String validationName = 'Emission Filtrée'

String exportRootFolder = 'C:\\KatalonExports'
String exportGroupFolder = 'JV_Emissions'
String exportFeatureFolder = 'Emission_Filtre'

// ======================================================
// TEST FLOW
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Start REC x PRD validation\n' +
	'Feature: ' + validationName + '\n' +
	'Expected column index: ' + expectedColumnIndex + '\n' +
	'Expected column: ' + expectedColumnName + '\n' +
	'Export root: ' + exportRootFolder + '\n' +
	'Export folder: ' +
	exportGroupFolder + '\\' + exportFeatureFolder
)

Map result =
	CustomKeywords.'commands.RecPrdExportValidationKeywords.validateLatestRecPrdExport'(
		exportRootFolder,
		exportGroupFolder,
		exportFeatureFolder,
		expectedColumnIndex,
		expectedColumnName
	)

boolean success =
	result != null &&
	result.success == true

String errors =
	result == null
		? '[ERROR] Validation keyword returned no result.'
		: safeText(result.errors)

String passedDetails =
	result == null
		? ''
		: safeText(result.passedDetails)

String resolvedColumnName =
	result == null
		? expectedColumnName
		: safeText(result.columnName)

if (resolvedColumnName.isEmpty()) {
	resolvedColumnName = expectedColumnName
}

String recFileName =
	result == null
		? 'NOT FOUND'
		: displayValue(result.recFileName)

String prdFileName =
	result == null
		? 'NOT FOUND'
		: displayValue(result.prdFileName)

String selectedFolderPath =
	result == null
		? 'NOT FOUND'
		: displayValue(result.selectedFolderPath)


// ======================================================
// REPORT SELECTED FILES
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	(success ? '[PASS] ' : '[FAIL] ') +
	'Files selected for validation\n' +
	'Folder: ' + selectedFolderPath + '\n' +
	'REC file: ' + recFileName + '\n' +
	'PRD file: ' + prdFileName
)


// ======================================================
// REPORT EXCEL RESULT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	(success ? '[PASS] ' : '[FAIL] ') +
	'Excel validation result\n' +
	'Feature: ' + validationName + '\n' +
	'Column: ' + resolvedColumnName + '\n' +
	'Column index: ' + expectedColumnIndex + '\n' +
	'REC rows: ' + displayValue(result?.recRows) + '\n' +
	'PRD rows: ' + displayValue(result?.prdRows) + '\n' +
	'REC numeric values: ' +
	displayValue(result?.recNumericValues) + '\n' +
	'PRD numeric values: ' +
	displayValue(result?.prdNumericValues) + '\n' +
	'REC sum: ' + displayValue(result?.recSum) + '\n' +
	'PRD sum: ' + displayValue(result?.prdSum) + '\n' +
	'REC minimum: ' +
	displayValue(result?.recMinimum) + '\n' +
	'PRD minimum: ' +
	displayValue(result?.prdMinimum) + '\n' +
	'REC maximum: ' +
	displayValue(result?.recMaximum) + '\n' +
	'PRD maximum: ' +
	displayValue(result?.prdMaximum)
)


// ======================================================
// FINAL RESULT
// ======================================================

if (!success) {

	String finalErrorMessage =
		errors.isEmpty()
			? 'REC x PRD validation returned an unsuccessful result.'
			: errors

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[FAIL] Final validation result\n' +
		finalErrorMessage +
		(
			passedDetails.isEmpty()
				? ''
				: '\n\nSuccessful validations\n' +
					passedDetails
		)
	)

	KeywordUtil.markFailed(
		'REC x PRD validation failed for ' +
		validationName +
		'.\n' +
		finalErrorMessage
	)

} else {

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[PASS] Final validation result\n' +
		'REC x PRD validation completed successfully.\n' +
		passedDetails
	)

	KeywordUtil.markPassed(
		'REC x PRD validation completed successfully for ' +
		validationName +
		'.'
	)
}


// ======================================================
// HELPERS
// ======================================================

String displayValue(Object value) {

	String text = safeText(value)

	return text.isEmpty()
		? 'NOT AVAILABLE'
		: text
}


String safeText(Object value) {

	if (value == null) {
		return ''
	}

	return value.toString().trim()
}
