                    <div class="detail-line">
                        <span class="detail-icon">${escapeHtml(row.icon || 'ℹ️')}</span>
                        <div class="detail-text">
                            <span class="detail-short" title="${escapeHtml(row.text || row.shortText || '')}">${shortDetail}</span>
                            ${hasExpand ? `
                                <a class="detail-toggle" href="javascript:void(0)" onclick="toggleBlock('${expandId}')">🔎 View full detail</a>
