
pipeline {
    agent { label 'GI5_SWDCFRNXGI55817' }

    stages {
        
    stage('Start Gaia Backend and Frontend'){
        steps{
            script{
                echo "Start Gaia Backend and Frontend"
                def setupTask = "GaiaBackFrontSetup"
                bat "schtasks /run /tn \"${setupTask}\""
                echo "Wait 180 seconds for the backend and frontend to start..."
                sleep(time: 300, unit: 'SECONDS')
        
            }
            
            
        }
    }
      
    stage('Get bitbucket source code') {
         steps {
            cleanWs()
            git credentialsId: '965eceec-b3a3-4ec5-8820-a857c87dd80f', url: 'https://bitbucket-mut.mycloud.intrabpce.fr/scm/gi5/gaia-portal.git'
         }
    }
    
    
    
    stage('GAIA TSC') {
        steps {
            catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                executeKatalon executeArgs: '-projectPath="D:/jenkins/work/workspace/GI5/Gaia/Gaia" -browserType="Chrome" -testSuiteCollectionPath="Test Suites/GAIA TSC"', location: 'C:/Users/adgi5appjenkins/Documents/Katalon_Studio_Engine_Windows_64-8.1.0', version: '', x11Display: '', xvfbConfiguration: ''
            }
        }
    }


stage('🧹 PreClean (minimal)') {
  steps {
    powershell '''
      # English comments only
      $ErrorActionPreference = "SilentlyContinue"

      $names = @("katalonc.exe","java.exe","chrome.exe","chromedriver.exe")
      foreach ($n in $names) { try { taskkill /IM $n /F /T | Out-Null } catch {} }

      # Remove lock files (best effort)
      if (Test-Path "$env:WORKSPACE\\Reports") {
        Get-ChildItem "$env:WORKSPACE\\Reports" -Recurse -Filter "*.lck" -ErrorAction SilentlyContinue |
          ForEach-Object { try { Remove-Item $_.FullName -Force } catch {} }
      }
    '''
  }
}
