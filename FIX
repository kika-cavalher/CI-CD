@echo off
setlocal EnableExtensions EnableDelayedExpansion

set "BASE_DIR=D:\Projects\eMatchStarters"
set "CONTEXT_FILE=%BASE_DIR%\run-context.properties"
set "STATUS_FILE=%BASE_DIR%\visible_katalon_status.txt"
set "LOG_FILE=%BASE_DIR%\visible_katalon_runner.log"

if not exist "%BASE_DIR%" mkdir "%BASE_DIR%"

> "%STATUS_FILE%" echo STARTING [%DATE% %TIME%]
>> "%LOG_FILE%" echo ==================================================
>> "%LOG_FILE%" echo [%DATE% %TIME%] RunEMatchDesktop started

if not exist "%CONTEXT_FILE%" (
    >> "%LOG_FILE%" echo [ERROR] Context file not found: %CONTEXT_FILE%
    > "%STATUS_FILE%" echo ERROR context file not found
    exit /b 1
)

for %%V in (
    WORKSPACE
    PROJECT_FILE
    KATALON_EXE
    SUITE_TYPE
    SUITE_PATH
    EXECUTION_PROFILE
    BROWSER_TYPE
    RETRY
    WINAPPDRIVER_EXE
    AUTO_START_WINAPPDRIVER
) do set "%%V="

for /f "usebackq tokens=1* delims==" %%A in ("%CONTEXT_FILE%") do (
    if not "%%A"=="" set "%%A=%%B"
)

if not defined WORKSPACE call :fail WORKSPACE is empty
if not defined PROJECT_FILE call :fail PROJECT_FILE is empty
if not defined KATALON_EXE call :fail KATALON_EXE is empty
if not defined SUITE_TYPE call :fail SUITE_TYPE is empty
if not defined SUITE_PATH call :fail SUITE_PATH is empty
if not defined EXECUTION_PROFILE set "EXECUTION_PROFILE=default"
if not defined BROWSER_TYPE set "BROWSER_TYPE=Windows"
if not defined RETRY set "RETRY=0"
if not defined AUTO_START_WINAPPDRIVER set "AUTO_START_WINAPPDRIVER=true"
if not defined WINAPPDRIVER_EXE set "WINAPPDRIVER_EXE=C:\Program Files (x86)\Windows Application Driver\WinAppDriver.exe"

>> "%LOG_FILE%" echo [INFO] WORKSPACE=%WORKSPACE%
>> "%LOG_FILE%" echo [INFO] PROJECT_FILE=%PROJECT_FILE%
>> "%LOG_FILE%" echo [INFO] KATALON_EXE=%KATALON_EXE%
>> "%LOG_FILE%" echo [INFO] SUITE_TYPE=%SUITE_TYPE%
>> "%LOG_FILE%" echo [INFO] SUITE_PATH=%SUITE_PATH%

if /I "%AUTO_START_WINAPPDRIVER%"=="true" (
    tasklist /FI "IMAGENAME eq WinAppDriver.exe" | find /I "WinAppDriver.exe" >nul
    if errorlevel 1 (
        >> "%LOG_FILE%" echo [INFO] Starting WinAppDriver: %WINAPPDRIVER_EXE%
        start "" /min "%WINAPPDRIVER_EXE%"
        call :waitForDriver 30
        if errorlevel 1 call :fail WinAppDriver did not start within 30 seconds
    ) else (
        >> "%LOG_FILE%" echo [INFO] WinAppDriver already running
    )
)

cd /d "%WORKSPACE%" || call :fail Cannot enter workspace %WORKSPACE%

if /I "%SUITE_TYPE%"=="COLLECTION" (
    >> "%LOG_FILE%" echo [INFO] Launching Katalon with collection
    call "%KATALON_EXE%" ^
    -noSplash ^
    -runMode=console ^
    -projectPath="%PROJECT_FILE%" ^
    -testSuiteCollectionPath="%SUITE_PATH%" ^
    -executionProfile="%EXECUTION_PROFILE%" ^
    -browserType="%BROWSER_TYPE%" ^
    -consoleLog ^
    -statusDelay=15 ^
    -retry=%RETRY%
) else if /I "%SUITE_TYPE%"=="SUITE" (
    >> "%LOG_FILE%" echo [INFO] Launching Katalon with suite
    call "%KATALON_EXE%" ^
    -noSplash ^
    -runMode=console ^
    -projectPath="%PROJECT_FILE%" ^
    -testSuitePath="%SUITE_PATH%" ^
    -executionProfile="%EXECUTION_PROFILE%" ^
    -browserType="%BROWSER_TYPE%" ^
    -consoleLog ^
    -statusDelay=15 ^
    -retry=%RETRY%
) else (
    call :fail Unsupported SUITE_TYPE %SUITE_TYPE%
)

set "RC=%ERRORLEVEL%"
if "%RC%"=="0" (
    >> "%LOG_FILE%" echo [SUCCESS] Katalon finished with exit code 0
    > "%STATUS_FILE%" echo SUCCESS [%DATE% %TIME%]
    exit /b 0
) else (
    >> "%LOG_FILE%" echo [ERROR] Katalon finished with exit code %RC%
    > "%STATUS_FILE%" echo ERROR %RC% [%DATE% %TIME%]
    exit /b %RC%
)

:waitForDriver
set "MAXWAIT=%~1"
set /a COUNT=0
:waitForDriverLoop
tasklist /FI "IMAGENAME eq WinAppDriver.exe" | find /I "WinAppDriver.exe" >nul
if not errorlevel 1 exit /b 0
timeout /t 1 /nobreak >nul
set /a COUNT+=1
if %COUNT% GEQ %MAXWAIT% exit /b 1
goto waitForDriverLoop

:fail
>> "%LOG_FILE%" echo [ERROR] %*
> "%STATUS_FILE%" echo ERROR %*
exit /b 1
