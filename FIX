class RecPrdExportValidationKeywords {

	@Keyword
	Map validateLatestRecPrdExport(
			String exportRootFolder,
			String exportGroupFolder,
			String exportFeatureFolder,
			Integer columnIndex,
			String expectedColumnName) {

		Map result = emptyResult(
				exportRootFolder,
				exportGroupFolder,
				exportFeatureFolder,
				columnIndex,
				expectedColumnName
		)

		StringBuilder errors = new StringBuilder()
		StringBuilder passed = new StringBuilder()

		try {
			File root = new File(text(exportRootFolder))
			int targetColumn = columnIndex == null ? -1 : columnIndex.intValue()

			if (!root.exists() || !root.isDirectory()) {
				errors.append('[ERROR] Export root folder does not exist or is not a folder.\n')
						.append('Folder: ')
						.append(root.getAbsolutePath())
				return finish(result, errors, passed)
			}

			if (targetColumn < 0) {
				errors.append('[ERROR] Invalid column index: ')
						.append(targetColumn)
				return finish(result, errors, passed)
			}

			Map pair = latestPair(root, exportGroupFolder, exportFeatureFolder)
			File recFile = pair.recFile as File
			File prdFile = pair.prdFile as File
			File folder = pair.folder as File

			result.recFileName = recFile == null ? 'NOT FOUND' : recFile.getName()
			result.prdFileName = prdFile == null ? 'NOT FOUND' : prdFile.getName()
			result.selectedFolderPath = folder == null ? '' : folder.getAbsolutePath()

			if (recFile == null || prdFile == null) {
				errors.append('[ERROR] REC and PRD exported files were not found.\n')
						.append('Search root: ')
						.append(root.getAbsolutePath())
						.append('\nExpected folder: ')
						.append(text(exportGroupFolder))
						.append('\\')
						.append(text(exportFeatureFolder))
						.append('\nREC file: ')
						.append(result.recFileName)
						.append('\nPRD file: ')
						.append(result.prdFileName)
				return finish(result, errors, passed)
			}

			KeywordUtil.logInfo(
					'[REC X PRD] Folder=' + folder.getAbsolutePath() +
					' | REC=' + recFile.getName() +
					' | PRD=' + prdFile.getName()
			)

			Map rec = readStatistics(recFile, targetColumn, expectedColumnName, 'REC')
			Map prd = readStatistics(prdFile, targetColumn, expectedColumnName, 'PRD')

			copyStatistics(result, rec, prd, expectedColumnName)

			appendFileErrors(errors, rec)
			appendFileErrors(errors, prd)

			if (errors.length() > 0) {
				return finish(result, errors, passed)
			}

			if (normalize(result.recColumnName) != normalize(result.prdColumnName)) {
				errors.append('[ERROR] REC and PRD column headers are different.\n')
						.append('REC: ').append(result.recColumnName)
						.append('\nPRD: ').append(result.prdColumnName)
						.append('\n')
			}

			if ((result.recRows as int) != (result.prdRows as int)) {
				errors.append('[ERROR] Number of rows is different.\n')
						.append('REC: ').append(result.recRows)
						.append('\nPRD: ').append(result.prdRows)
						.append('\n')
			} else {
				passed.append('[PASS] Number of rows is equal.\n')
						.append('REC: ').append(result.recRows)
						.append('\nPRD: ').append(result.prdRows)
						.append('\n')
			}

			compare(errors, passed, 'Column sum', result.columnName,
					result.recSum as BigDecimal, result.prdSum as BigDecimal)

			compare(errors, passed, 'Minimum value', result.columnName,
					result.recMinimum as BigDecimal, result.prdMinimum as BigDecimal)

			compare(errors, passed, 'Maximum value', result.columnName,
					result.recMaximum as BigDecimal, result.prdMaximum as BigDecimal)

		} catch (OutOfMemoryError error) {
			errors.append('[ERROR] Not enough memory to validate the exported files.\n')
					.append('Message: ')
					.append(text(error.getMessage()))
		} catch (Exception exception) {
			errors.append('[ERROR] REC x PRD export validation failed.\n')
					.append('Exception: ')
					.append(exception.getClass().getSimpleName())
					.append('\nMessage: ')
					.append(text(exception.getMessage()))
		}

		return finish(result, errors, passed)
	}


	private Map readStatistics(
			File file,
			int columnIndex,
			String expectedColumnName,
			String environment) {

		String name = file.getName().toLowerCase()

		if (name.endsWith('.xlsx') || name.endsWith('.xlsm')) {
			return readXlsxStreaming(file, columnIndex, expectedColumnName, environment)
		}

		return readLegacyWorkbook(file, columnIndex, expectedColumnName, environment)
	}


	private Map readXlsxStreaming(
			File file,
			int columnIndex,
			String expectedColumnName,
			String environment) {

		Map result = emptyStatistics()
		OPCPackage pkg = null
		InputStream sheetStream = null

		try {
			pkg = OPCPackage.open(file)

			XSSFReader reader = new XSSFReader(pkg)
			StylesTable styles = reader.getStylesTable()
			ReadOnlySharedStringsTable strings = new ReadOnlySharedStringsTable(pkg)
			Iterator<InputStream> sheets = reader.getSheetsData()

			if (!sheets.hasNext()) {
				result.errors = '[ERROR] ' + environment +
						' workbook does not contain worksheets.\nFile: ' +
						file.getName()
				return result
			}

			sheetStream = sheets.next()

			StreamingHandler data = new StreamingHandler(columnIndex)
			XSSFSheetXMLHandler handler = new XSSFSheetXMLHandler(
					styles,
					null,
					strings,
					data,
					new DataFormatter(),
					false
			)

			XMLReader parser = XMLHelper.newXMLReader()
			parser.setContentHandler(handler)
			parser.parse(new InputSource(sheetStream))

			result.columnName = data.columnName
			result.rows = data.rows
			result.numericValues = data.numericValues
			result.sum = data.numericValues > 0 ? round2(data.sum) : null
			result.minimum = data.numericValues > 0 ? round2(data.minimum) : null
			result.maximum = data.numericValues > 0 ? round2(data.maximum) : null

			validateStatistics(result, expectedColumnName, columnIndex, environment)

			KeywordUtil.logInfo(
					'[STREAMING EXCEL] Environment=' + environment +
					' | File=' + file.getName() +
					' | Rows=' + result.rows +
					' | Numeric values=' + result.numericValues
			)

			return result
		} finally {
			try {
				if (sheetStream != null) {
					sheetStream.close()
				}
			} catch (Exception ignored) {
			}

			try {
				if (pkg != null) {
					pkg.close()
				}
			} catch (Exception ignored) {
			}
		}
	}


	private Map readLegacyWorkbook(
			File file,
			int columnIndex,
			String expectedColumnName,
			String environment) {

		Map result = emptyStatistics()
		FileInputStream input = null
		Workbook workbook = null

		try {
			input = new FileInputStream(file)
			workbook = WorkbookFactory.create(input)

			if (workbook.getNumberOfSheets() == 0) {
				result.errors = '[ERROR] ' + environment +
						' workbook does not contain worksheets.\nFile: ' +
						file.getName()
				return result
			}

			Sheet sheet = workbook.getSheetAt(0)
			DataFormatter formatter = new DataFormatter()

			result.columnName = header(sheet, columnIndex, formatter)

			BigDecimal sum = BigDecimal.ZERO
			BigDecimal minimum = null
			BigDecimal maximum = null
			int rows = 0
			int numericValues = 0

			for (int rowIndex = 1; rowIndex <= sheet.getLastRowNum(); rowIndex++) {
				Row row = sheet.getRow(rowIndex)

				if (row == null || rowEmpty(row, formatter)) {
					continue
				}

				rows++
				BigDecimal value = cellNumber(row, columnIndex, formatter)

				if (value == null) {
					continue
				}

				sum = sum.add(value)
				minimum = minimum == null || value < minimum ? value : minimum
				maximum = maximum == null || value > maximum ? value : maximum
				numericValues++
			}

			result.rows = rows
			result.numericValues = numericValues
			result.sum = numericValues > 0 ? round2(sum) : null
			result.minimum = numericValues > 0 ? round2(minimum) : null
			result.maximum = numericValues > 0 ? round2(maximum) : null

			validateStatistics(result, expectedColumnName, columnIndex, environment)
			return result
		} finally {
			try {
				if (workbook != null) {
					workbook.close()
				}
			} catch (Exception ignored) {
			}

			try {
				if (input != null) {
					input.close()
				}
			} catch (Exception ignored) {
			}
		}
	}


	private void validateStatistics(
			Map result,
			String expectedColumnName,
			int columnIndex,
			String environment) {

		StringBuilder errors = new StringBuilder()
		String columnName = text(result.columnName)

		if (columnName.isEmpty()) {
			errors.append('[ERROR] ')
					.append(environment)
					.append(' column header was not found.\nColumn index: ')
					.append(columnIndex)
					.append('\n')
		} else if (normalize(columnName) != normalize(expectedColumnName)) {
			errors.append('[ERROR] Unexpected ')
					.append(environment)
					.append(' column header.\nExpected: ')
					.append(text(expectedColumnName))
					.append('\nFound: ')
					.append(columnName)
					.append('\n')
		}

		if ((result.numericValues as int) == 0) {
			errors.append('[ERROR] ')
					.append(environment)
					.append(' column does not contain numeric values.\nColumn: ')
					.append(columnName)
					.append('\n')
		}

		result.errors = errors.toString().trim()
	}


	private class StreamingHandler implements XSSFSheetXMLHandler.SheetContentsHandler {

		private final int targetColumn

		String columnName = ''
		int rows = 0
		int numericValues = 0
		BigDecimal sum = BigDecimal.ZERO
		BigDecimal minimum = null
		BigDecimal maximum = null

		private boolean rowHasValue = false
		private String targetValue = ''

		StreamingHandler(int targetColumn) {
			this.targetColumn = targetColumn
		}

		@Override
		void startRow(int rowNum) {
			rowHasValue = false
			targetValue = ''
		}

		@Override
		void endRow(int rowNum) {
			if (rowNum == 0) {
				columnName = text(targetValue)
				return
			}

			if (!rowHasValue) {
				return
			}

			rows++

			BigDecimal value = parseNumber(targetValue)

			if (value == null) {
				return
			}

			sum = sum.add(value)
			minimum = minimum == null || value < minimum ? value : minimum
			maximum = maximum == null || value > maximum ? value : maximum
			numericValues++
		}

		@Override
		void cell(
				String cellReference,
				String formattedValue,
				XSSFComment comment) {

			String value = text(formattedValue)

			if (!value.isEmpty()) {
				rowHasValue = true
			}

			if (cellReference != null &&
					new CellReference(cellReference).getCol() == targetColumn) {

				targetValue = value
			}
		}

		@Override
		void headerFooter(String value, boolean isHeader, String tagName) {
		}
	}


	private Map latestPair(
			File root,
			String groupName,
			String featureName) {

		List<File> folders = []
		findFeatureFolders(root, groupName, featureName, folders)

		List<Map> pairs = []

		for (File folder : folders) {
			File[] children = folder.listFiles()

			if (children == null) {
				continue
			}

			List<File> recFiles = children.findAll { File file ->
				environmentExcel(file, 'REC')
			}

			List<File> prdFiles = children.findAll { File file ->
				environmentExcel(file, 'PRD')
			}

			if (recFiles.isEmpty() || prdFiles.isEmpty()) {
				continue
			}

			recFiles.sort { File a, File b -> b.lastModified() <=> a.lastModified() }
			prdFiles.sort { File a, File b -> b.lastModified() <=> a.lastModified() }

			File rec = recFiles.first()
			File prd = prdFiles.first()

			pairs.add([
				recFile: rec,
				prdFile: prd,
				folder : folder,
				date   : Math.max(rec.lastModified(), prd.lastModified())
			])
		}

		if (pairs.isEmpty()) {
			return [recFile: null, prdFile: null, folder: null]
		}

		pairs.sort { Map a, Map b -> (b.date as Long) <=> (a.date as Long) }
		return pairs.first()
	}


	private void findFeatureFolders(
			File folder,
			String groupName,
			String featureName,
			List<File> result) {

		if (folder == null || !folder.exists() || !folder.isDirectory()) {
			return
		}

		File parent = folder.getParentFile()

		if (normalize(folder.getName()) == normalize(featureName) &&
				parent != null &&
				normalize(parent.getName()) == normalize(groupName)) {

			result.add(folder)
			return
		}

		File[] children = folder.listFiles()

		if (children == null) {
			return
		}

		for (File child : children) {
			if (child.isDirectory()) {
				findFeatureFolders(child, groupName, featureName, result)
			}
		}
	}


	private boolean environmentExcel(File file, String environment) {
		if (file == null || !file.isFile() || file.getName().startsWith('~$')) {
			return false
		}

		String name = file.getName().toLowerCase()

		return file.getName().toUpperCase().startsWith(environment + '_') &&
				(name.endsWith('.xlsx') || name.endsWith('.xlsm') || name.endsWith('.xls'))
	}


	private void copyStatistics(
			Map result,
			Map rec,
			Map prd,
			String expectedColumnName) {

		result.recColumnName = text(rec.columnName)
		result.prdColumnName = text(prd.columnName)
		result.columnName = !text(rec.columnName).isEmpty()
				? text(rec.columnName)
				: text(expectedColumnName)

		result.recRows = rec.rows
		result.prdRows = prd.rows
		result.recNumericValues = rec.numericValues
		result.prdNumericValues = prd.numericValues
		result.recSum = rec.sum
		result.prdSum = prd.sum
		result.recMinimum = rec.minimum
		result.prdMinimum = prd.minimum
		result.recMaximum = rec.maximum
		result.prdMaximum = prd.maximum
	}


	private void appendFileErrors(StringBuilder errors, Map data) {
		String value = text(data.errors)

		if (!value.isEmpty()) {
			errors.append(value).append('\n')
		}
	}


	private void compare(
			StringBuilder errors,
			StringBuilder passed,
			String label,
			Object columnName,
			BigDecimal rec,
			BigDecimal prd) {

		if (rec == null || prd == null) {
			errors.append('[ERROR] ')
					.append(label)
					.append(' could not be compared.\n')
			return
		}

		if (rec.compareTo(prd) != 0) {
			errors.append('[ERROR] ')
					.append(label)
					.append(' is different.\nColumn: ')
					.append(text(columnName))
					.append('\nREC: ')
					.append(rec)
					.append('\nPRD: ')
					.append(prd)
					.append('\n')
		} else {
			passed.append('[PASS] ')
					.append(label)
					.append(' is equal.\nColumn: ')
					.append(text(columnName))
					.append('\nValue: ')
					.append(rec)
					.append('\n')
		}
	}


	private String header(Sheet sheet, int column, DataFormatter formatter) {
		Row row = sheet.getRow(0)
		Cell cell = row == null ? null : row.getCell(column)
		return cell == null ? '' : formatter.formatCellValue(cell).trim()
	}


	private BigDecimal cellNumber(Row row, int column, DataFormatter formatter) {
		Cell cell = row == null ? null : row.getCell(column)

		if (cell == null) {
			return null
		}

		try {
			if (cell.getCellType() == CellType.NUMERIC) {
				return BigDecimal.valueOf(cell.getNumericCellValue())
			}

			if (cell.getCellType() == CellType.FORMULA &&
					cell.getCachedFormulaResultType() == CellType.NUMERIC) {

				return BigDecimal.valueOf(cell.getNumericCellValue())
			}

			return parseNumber(formatter.formatCellValue(cell))
		} catch (Exception ignored) {
			return null
		}
	}


	private boolean rowEmpty(Row row, DataFormatter formatter) {
		if (row == null || row.getLastCellNum() <= 0) {
			return true
		}

		for (int index = 0; index < row.getLastCellNum(); index++) {
			Cell cell = row.getCell(index)

			if (cell != null && !formatter.formatCellValue(cell).trim().isEmpty()) {
				return false
			}
		}

		return true
	}


	private BigDecimal parseNumber(Object rawValue) {
		String value = text(rawValue)

		if (value.isEmpty()) {
			return null
		}

		value = value
				.replace('\u00A0', ' ')
				.replace('\u202F', ' ')
				.replace('\u2212', '-')
				.replace('\u2012', '-')
				.replace('\u2013', '-')
				.replace('\u2014', '-')
				.replace('\u2015', '-')
				.trim()

		boolean parentheses = value.startsWith('(') && value.endsWith(')')
		boolean trailingMinus = value.endsWith('-')

		value = value
				.replaceAll('[^0-9,\\.\\-\\(\\)]', '')
				.replace('(', '')
				.replace(')', '')

		if (trailingMinus && value.endsWith('-')) {
			value = value.substring(0, value.length() - 1)
		}

		boolean negative = value.startsWith('-') || parentheses || trailingMinus
		value = value.replace('-', '')

		if (value.isEmpty()) {
			return null
		}

		String normalized = numericSeparators(value)

		try {
			BigDecimal number = new BigDecimal(normalized)
			return negative && number > BigDecimal.ZERO ? number.negate() : number
		} catch (Exception ignored) {
			return null
		}
	}


	private String numericSeparators(String value) {
		int commas = occurrences(value, ',')
		int dots = occurrences(value, '.')

		if (commas > 0 && dots > 0) {
			return value.lastIndexOf(',') > value.lastIndexOf('.')
					? value.replace('.', '').replace(',', '.')
					: value.replace(',', '')
		}

		if (commas > 0) {
			return singleSeparator(value, ',')
		}

		if (dots > 0) {
			return singleSeparator(value, '.')
		}

		return value
	}


	private String singleSeparator(String value, String separator) {
		int count = occurrences(value, separator)

		if (count > 1) {
			int last = value.lastIndexOf(separator)
			String decimals = value.substring(last + 1)

			if (decimals.length() == 1 || decimals.length() == 2) {
				return value.substring(0, last).replace(separator, '') + '.' + decimals
			}

			return value.replace(separator, '')
		}

		int index = value.indexOf(separator)
		String before = value.substring(0, index)
		String after = value.substring(index + 1)

		if (after.length() == 3 && before.length() >= 1 && before.length() <= 3) {
			return before + after
		}

		return separator == ',' ? before + '.' + after : value
	}


	private int occurrences(String value, String token) {
		int count = 0
		int index = 0

		while ((index = value.indexOf(token, index)) >= 0) {
			count++
			index += token.length()
		}

		return count
	}


	private BigDecimal round2(BigDecimal value) {
		return value == null ? null : value.setScale(2, RoundingMode.HALF_EVEN)
	}


	private String normalize(Object rawValue) {
		String value = text(rawValue)

		if (value.isEmpty()) {
			return ''
		}

		return Normalizer.normalize(value, Normalizer.Form.NFD)
				.replaceAll('\\p{InCombiningDiacriticalMarks}+', '')
				.toLowerCase()
				.replace(' ', '_')
				.replace('-', '_')
				.replaceAll('_+', '_')
				.trim()
	}


	private String text(Object value) {
		return value == null ? '' : value.toString().trim()
	}


	private Map emptyStatistics() {
		return [
			columnName   : '',
			rows         : 0,
			numericValues: 0,
			sum          : null,
			minimum      : null,
			maximum      : null,
			errors       : ''
		]
	}


	private Map emptyResult(
			String root,
			String group,
			String feature,
			Integer column,
			String expectedColumn) {

		return [
			success             : false,
			errors              : '',
			passedDetails       : '',
			exportRootFolder    : text(root),
			exportGroupFolder   : text(group),
			exportFeatureFolder : text(feature),
			columnIndex         : column,
			columnName          : text(expectedColumn),
			recColumnName       : '',
			prdColumnName       : '',
			selectedFolderPath  : '',
			recFileName         : 'NOT FOUND',
			prdFileName         : 'NOT FOUND',
			recRows             : null,
			prdRows             : null,
			recNumericValues    : null,
			prdNumericValues    : null,
			recSum              : null,
			prdSum              : null,
			recMinimum          : null,
			prdMinimum          : null,
			recMaximum          : null,
			prdMaximum          : null
		]
	}


	private Map finish(
			Map result,
			StringBuilder errors,
			StringBuilder passed) {

		result.errors = errors.toString().trim()
		result.passedDetails = passed.toString().trim()
		result.success = result.errors.isEmpty()
		return result
	}
}
