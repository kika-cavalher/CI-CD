def currentExitCode = 0
def nextBuild = null

node('GI5_SWDCFRNXGI55817') {
    stage('Checkout') {
        checkout scm
    }

    stage('Run current execution') {
        currentExitCode = bat(
            script: "call \"%WORKSPACE%\\jenkins\\ArchiveMode.cmd\"",
            returnStatus: true
        )

        echo "[INFO] Current execution exit code: ${currentExitCode}"
    }

    stage('Cleanup current execution') {
        bat '''
@echo off
echo [INFO] Finishing current execution resources...

schtasks /end /tn "\\eMatch Automation\\RunEMatchCommand" >nul 2>nul
schtasks /end /tn "startWinDriver" >nul 2>nul

ping -n 6 127.0.0.1 >nul

taskkill /f /im WinAppDriver.exe /t >nul 2>nul
taskkill /f /im katalonc.exe /t >nul 2>nul
taskkill /f /im KatalonStudio.exe /t >nul 2>nul

echo [INFO] Cleanup snapshot:
echo [INFO] ---- startWinDriver ----
schtasks /query /tn "startWinDriver" /fo list | findstr /i /b /c:"Status:" /c:"Last Result:"
echo [INFO] ---- \\eMatch Automation\\RunEMatchCommand ----
schtasks /query /tn "\\eMatch Automation\\RunEMatchCommand" /fo list | findstr /i /b /c:"Status:" /c:"Last Result:"
'''
    }
}

stage('Run next pipeline') {
    nextBuild = build(
        job: 'GI5/eMatch_Regression/Archive Mode ttttt',
        wait: true,
        propagate: false
    )

    echo "[INFO] Next pipeline build number: ${nextBuild.number}"
    echo "[INFO] Next pipeline result: ${nextBuild.result}"
}

stage('Finalize') {
    if (currentExitCode == 0) {
        currentBuild.result = 'SUCCESS'
        echo '[INFO] Current execution finished successfully.'
    } else {
        currentBuild.result = 'UNSTABLE'
        echo "[WARN] Current execution returned exit code ${currentExitCode}, but next pipeline was executed."
    }
}
