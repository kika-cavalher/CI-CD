pipeline {
    agent {
        label 'GI5_SWDCFRNXGI55817'
    }

    stages {
        stage('Start Gaia Backend and Frontend') {
            steps {
                script {
                    echo 'Start Gaia Backend and Frontend'

                    def setupTask = 'GaiaBackFrontSetup'

                    bat "schtasks /run /tn \"${setupTask}\""

                    echo 'Wait 300 seconds for backend and frontend to start...'
                    sleep(time: 300, unit: 'SECONDS')
                }
            }
        }

        stage('Get Bitbucket Source Code') {
            steps {
                cleanWs()

                git(
                    credentialsId: '965eceec-b3a3-4ec5-8820-a857c87dd80f',
                    url: 'https://bitbucket-mut.mycloud.intrabpce.fr/scm/gi5/gaia-portal.git',
                    branch: 'master'
                )
            }
        }

        stage('GAIA TSC') {
            steps {
                script {
                    echo "Workspace: ${env.WORKSPACE}"
                }

                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    executeKatalon(
                        executeArgs: "-projectPath=\"${env.WORKSPACE}\\gaia-portal.prj\" -browserType=\"Chrome\" -testSuiteCollectionPath=\"Test Suites/GAIA TSC\"",
                        location: 'C:/Users/adgi5appjenkins/Documents/Katalon_Studio_Engine_Windows_64-8.1.0',
                        version: '',
                        x11Display: '',
                        xvfbConfiguration: ''
                    )
                }
            }
        }
    }
}
