	@Keyword
	boolean waitForMainScreen() {
		KeywordUtil.logInfo("Waiting for main screen using HomeGrey image with object fallback")

		String homeGreyImage = new File(RunConfiguration.getProjectDir(), 'Images/General/HomeGrey.png').getAbsolutePath()
		long end = System.currentTimeMillis() + 60000L

		while (System.currentTimeMillis() < end) {
			focusLoginWindow(detectedWindowTitle)

			if (imageFileExists(homeGreyImage) && waitImagePresent(homeGreyImage, 2)) {
				KeywordUtil.logInfo("Main screen confirmed by HomeGrey image")
				return true
			}

			if (waitPresent(mainSearchObj(), 2)) {
				KeywordUtil.logInfo("Main screen confirmed by General/txtSearch")
				return true
			}

			if (waitPresent(homeTabObj(), 2)) {
				KeywordUtil.logInfo("Main screen confirmed by home tab object")
				return true
			}

			sleepMs(1000)
		}

		return false
	}

