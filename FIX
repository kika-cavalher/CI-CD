import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import commands.ImageLoader

ImageLoader imageLoader = new ImageLoader()

Windows.delay(5)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Close the application with windows")
Windows.closeApplication()
Windows.delay(1)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Confirm close application clicking Yes until modal closes")

int maxAttempts = 10
boolean modalClosed = false

for (int attempt = 1; attempt <= maxAttempts; attempt++) {
	if (imageLoader.waitForImage('General', 'yes', 2)) {
		KeywordUtil.logInfo("Close confirmation modal found. Clicking Yes. Attempt: " + attempt + "/" + maxAttempts)
		imageLoader.clickImageOrStop('General', 'yes')
		Windows.delay(1)
	} else {
		KeywordUtil.logInfo("Close confirmation modal is no longer visible.")
		modalClosed = true
		break
	}
}

if (!modalClosed && imageLoader.waitForImage('General', 'yes', 2)) {
	imageLoader.takeEvidence('CloseApplicationYesModalStillOpen.png')

	KeywordUtil.markFailedAndStop(
		'Close confirmation modal remained open after clicking Yes.\n' +
		'Image group: General\n' +
		'Image key: yes\n' +
		'Max attempts: ' + maxAttempts
	)
}
