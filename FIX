	/*
	 * Responsibility:
	 * This file handles storing and reading suite execution metadata.
	 */

	def safeFileName(String value) {
		/*
		 * Responsibility:
		 * Convert a suite name into a filesystem safe file name.
		 */

		return (value ?: '').replaceAll(/[^A-Za-z0-9._ -]/, '').replace(' ', '_')
	}

	def parsePropertiesText(String text) {
		/*
		 * Responsibility:
		 * Parse a simple key=value text block into a map.
		 */

		def map = [:]

		if (!text?.trim()) {
			return map
		}

		text.readLines().each { line ->
			int idx = line.indexOf('=')
			if (idx > 0) {
				def key = line.substring(0, idx).trim()
				def value = line.substring(idx + 1).trim()
				map[key] = value
			}
		}

		return map
	}

	def splitSummary(String value) {
		/*
		 * Responsibility:
		 * Split a summary string stored with || separator.
		 */

		if (!value?.trim()) {
			return []
		}

		return value.split('\\|\\|').collect { it.trim() }.findAll { it }
	}

	def readSuiteMeta(script, String reportsRoot, String suiteName) {
		/*
		 * Responsibility:
		 * Read the meta file generated by the live runner for one suite.
		 */

		def metaPath = "${reportsRoot}\\logs\\${safeFileName(suiteName)}.meta.properties"

		if (!script.fileExists(metaPath)) {
			return [:]
		}

		return parsePropertiesText(script.readFile(file: metaPath, encoding: 'UTF-8'))
	}

	def saveSuiteResults(script, String reportsRoot, List results) {
		/*
		 * Responsibility:
		 * Save the full suite results list as JSON.
		 */

		def json = groovy.json.JsonOutput.prettyPrint(groovy.json.JsonOutput.toJson(results))

		script.writeFile(
				file: "${reportsRoot}\\suite-results.json",
				text: json,
				encoding: 'UTF-8'
				)
	}

	def loadSuiteResults(script, String reportsRoot) {
		/*
		 * Responsibility:
		 * Load the persisted suite results JSON.
		 */

		def filePath = "${reportsRoot}\\suite-results.json"

		if (!script.fileExists(filePath)) {
			return []
		}

		def text = script.readFile(file: filePath, encoding: 'UTF-8')
		if (!text?.trim()) {
			return []
		}

		return new groovy.json.JsonSlurperClassic().parseText(text)
	}

	return this















