package commands

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.testobject.WindowsTestObject.LocatorStrategy
import com.kms.katalon.core.util.KeywordUtil

class WindowsObjectLoader {

	private static final Map<String, Map<String, String>> OBJECTS = [
		'authentication': [
			'environmentCombo': 'Environnement eMatch',
			'connectButton'   : 'Se connecter'
		],

		'common': [
			'homeTab': 'Modules'
		]
	]

	private static final Map<String, Map<String, String>> XPATH_OBJECTS = [
		'menu': [
			'searchBox'                           : "//*[@Name='Type keywords here']",
			'moduleDesResponsabiliteGroup'       : "//*[@Name='Balance des Responsabilités']",
			'moduleDesResponsabiliteResult'      : "//*[@Name='Cube Balance des Responsabilités']",

			'moduleDesResponsabiliteOpenedTitle' : "//*[@Name='Cube Balance des Responsabilités']",
			'moduleDesResponsabiliteOpenedCRS'   : "//*[@Name='CRS']",
			'moduleDesResponsabiliteOpenedData'  : "//*[@Name='Données']",
			'moduleDesResponsabiliteOpenedTotal' : "//*[@Name='Total général']"
		]
	]

	@Keyword
	static WindowsTestObject getObject(String groupName, String objectName) {
		Map<String, String> nameGroup = OBJECTS[groupName]

		if (nameGroup != null && nameGroup[objectName] != null) {
			return createNameObject(nameGroup[objectName])
		}

		Map<String, String> xpathGroup = XPATH_OBJECTS[groupName]

		if (xpathGroup != null && xpathGroup[objectName] != null) {
			return createXpathObject(xpathGroup[objectName])
		}

		KeywordUtil.markFailedAndStop(
				"Windows object not found: " + groupName + "." + objectName + "\n" +
				"Available NAME groups: " + OBJECTS.keySet() + "\n" +
				"Available XPATH groups: " + XPATH_OBJECTS.keySet()
				)

		return null
	}

	@Keyword
	static WindowsTestObject getWindowByName(String windowName) {
		return createNameObject(windowName)
	}

	private static WindowsTestObject createNameObject(String name) {
		WindowsTestObject object = new WindowsTestObject()
		object.setLocatorStrategy(LocatorStrategy.NAME)
		object.setLocator(name)

		return object
	}

	private static WindowsTestObject createXpathObject(String xpath) {
		WindowsTestObject object = new WindowsTestObject()
		object.setLocatorStrategy(LocatorStrategy.XPATH)
		object.setLocator(xpath)

		return object
	}
}
