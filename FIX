	Map importExecutionResults(File junitXmlFile, String projectKey, String testPlanKey, String testExecKey) {
		validateRequiredConfiguration()

		if (junitXmlFile == null || !junitXmlFile.exists() || !junitXmlFile.isFile()) {
			throw new IllegalArgumentException('JUnit XML file was not found: ' + safePath(junitXmlFile))
		}

		Map query = [:]

		if (notBlank(projectKey)) {
			query.projectKey = projectKey
		}
		if (notBlank(testPlanKey)) {
			query.testPlanKey = testPlanKey
		}
		if (notBlank(testExecKey)) {
			query.testExecKey = testExecKey
		}

		String path = '/rest/raven/1.0/import/execution/junit' + buildQueryString(query)

		return doMultipartFileRequest(
			'POST',
			path,
			junitXmlFile,
			'file',
			'application/xml',
			[
				'X-Atlassian-Token': 'no-check'
			]
		)
	}
