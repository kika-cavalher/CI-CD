Integer menuOpenTimeout = 90
Integer delayAfterMenuOpen = 10
Integer tabOpenTimeout = 120
Integer closeTabTimeout = 30

String loginTestCase = 'Component/Authentication/Login ' + targetEnvironment

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'🚀 Archive Mode validation\n' +
	'Menu search: ' + menuName + '\n' +
	'Menu result: ' + menuResultName + '\n' +
	'Validation: opened tab only'
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Authenticate and open application'
)

WebUI.callTestCase(
	findTestCase(loginTestCase),
	[:],
	FailureHandling.STOP_ON_FAILURE
)

CustomKeywords.'component.SettingsArchiveModeKeywords.enableArchiveModeFromSettings'(
	30
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Open Archive Mode menu\n' +
	'Search: ' + menuName + '\n' +
	'Result: ' + menuResultName + '\n' +
	'Menu open timeout: ' + menuOpenTimeout + ' seconds'
)

CustomKeywords.'component.MenuNavigator.searchAndOpenMenuByText'(
	menuName,
	menuResultName,
	menuOpenTimeout
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Wait after menu open\n' +
	'Delay: ' + delayAfterMenuOpen + ' seconds'
)

Windows.delay(delayAfterMenuOpen)

WindowsTestObject openedTab = WindowsObjectLoader.getTabByName(openedTabName)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Validate opened tab\n' +
	'Expected tab: ' + openedTabName + '\n' +
	'Tab timeout: ' + tabOpenTimeout + ' seconds'
)

if (!Windows.waitForElementPresent(openedTab, tabOpenTimeout, FailureHandling.OPTIONAL)) {
	CustomKeywords.'commands.ImageLoader.takeEvidence'(
		'ArchiveModeTabNotOpened.png'
	)

	KeywordUtil.markFailedAndStop(
		'Archive Mode tab was not opened.\n' +
		'Expected tab: ' + openedTabName + '\n' +
		'Menu search: ' + menuName + '\n' +
		'Menu result: ' + menuResultName + '\n' +
		'Timeout: ' + tabOpenTimeout + ' seconds'
	)
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'✅ Archive Mode tab opened successfully\n' +
	'Tab: ' + openedTabName
)

CustomKeywords.'component.CloseTabKeywords.closeTabByName'(
	openedTabName,
	closeTabTimeout
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Close application'
)

WebUI.callTestCase(
	findTestCase('Component/Authentication/Close Application'),
	[:],
	FailureHandling.STOP_ON_FAILURE
)

KeywordUtil.markPassed(
	targetEnvironment + ' Archive Mode validation completed successfully. Menu: ' + menuResultName
)
