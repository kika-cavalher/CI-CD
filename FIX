	String findFileRecursively(File baseDir, String fileName) {
		if (baseDir == null || !baseDir.exists()) {
			return ''
		}

		String found = ''
		baseDir.eachFileRecurse(FileType.FILES) { File file ->
			if (file.name.equalsIgnoreCase(fileName) && isBlank(found)) {
				found = file.absolutePath
			}
		}
		return found
	}

	String findExecutionXmlPath() {
		File reportFolder = new File(getReportPath())
		if (!reportFolder.exists()) {
			return ''
		}

		String junitPath = findFileRecursively(reportFolder, PRIMARY_XML_FILE_NAME)
		if (!isBlank(junitPath)) {
			return junitPath
		}

		String cucumberPath = findFileRecursively(reportFolder, SECONDARY_XML_FILE_NAME)
		if (!isBlank(cucumberPath)) {
			return cucumberPath
		}

		return ''
	}

	List<File> findFailureImages(File reportFolder) {
		if (reportFolder == null || !reportFolder.exists()) {
			return []
		}

		List<File> images = []
		reportFolder.eachFileRecurse(FileType.FILES) { File file ->
			String name = file.name.toLowerCase()
			if ((name.endsWith('.png') || name.endsWith('.jpg') || name.endsWith('.jpeg')) &&
				!name.equalsIgnoreCase('gaiareport.html')) {
				images << file
			}
		}

		return images.sort { a, b -> a.lastModified() <=> b.lastModified() }
	}

	List<String> extractShortFailureLines(String rawText, String testName) {
		List<String> result = []

		if (!isBlank(testName)) {
			result << testName
		}

		if (isBlank(rawText)) {
			return result.take(3)
		}

		List<String> lines = rawText.readLines()
			.collect { safe(it) }
			.findAll { !isBlank(it) }

		List<String> preferred = lines.findAll {
			it.toLowerCase().contains('exception') ||
			it.toLowerCase().contains('error') ||
			it.toLowerCase().contains('caused by') ||
			it.toLowerCase().contains('line ')
		}

		if (preferred.isEmpty()) {
			preferred = lines
		}

		preferred.each { String line ->
			if (result.size() < 3) {
				result << line
			}
		}

		return result.take(3)
	}

	String buildFailedCard(Map testCase, File reportFolder) {
		String imageHtml = ''
		if (!isBlank(testCase.imagePath)) {
			File imageFile = new File(testCase.imagePath.toString())
			if (imageFile.exists()) {
				String relative = relativeUri(reportFolder, imageFile)
				imageHtml = """
					<div class="thumb-wrap">
						<img class="thumb" src="${htmlEscape(relative)}" alt="Failure evidence">
					</div>
				"""
			}
		}

		String shortList = testCase.shortLines.collect {
			"<li>${htmlEscape(it)}</li>"
		}.join('\n')

		return """
			<div class="case failed-card">
				<div class="case-title">${htmlEscape(testCase.displayName)}</div>
				<ul class="case-meta">
					${shortList}
					<li>Duration: ${htmlEscape(testCase.durationText)}</li>
				</ul>
				<details class="details">
					<summary>See full error log</summary>
					<pre>${htmlEscape(testCase.fullError)}</pre>
				</details>
				${imageHtml}
			</div>
		"""
	}

	String buildPassedCard(Map testCase) {
		return """
			<div class="case passed-card">
				<div class="case-title">${htmlEscape(testCase.displayName)}</div>
				<ul class="case-meta">
					<li>Test Passed</li>
					<li>Duration: ${htmlEscape(testCase.durationText)}</li>
				</ul>
			</div>
		"""
	}

