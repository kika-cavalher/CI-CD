@Keyword
def selectEnvironment(String targetEnvironment) {
	String environment = normalizeEnvironment(targetEnvironment)

	if (!requiresEnvironmentSelection(environment)) {
		KeywordUtil.logInfo("Environment selection is not required for " + environment + ".")
		return
	}

	int env = getEnvironmentIndex(environment)

	try {
		focusLoginWindow(targetEnvironment)

		TestObject envObject = findWindowsObject('Login Page/optEnv')

		// Force focus on combo
		Windows.click(envObject)
		Windows.delay(1)

		// Open combo correctly
		Windows.sendKeys(envObject, Keys.chord(Keys.SPACE))
		Windows.delay(1)

		// Reset position
		Windows.sendKeys(envObject, Keys.chord(Keys.HOME))
		Windows.delay(1)

		// Move down
		for (int i = 1; i < env; i++) {
			Windows.click(envObject, FailureHandling.OPTIONAL)
			Windows.delay(1)

			Windows.sendKeys(envObject, Keys.chord(Keys.ARROW_DOWN))
			Windows.delay(1)
		}

		// Confirm
		Windows.sendKeys(envObject, Keys.chord(Keys.ENTER))
		Windows.delay(5)

		KeywordUtil.logInfo("Environment selected successfully: " + environment)

	} catch (Exception e) {
		KeywordUtil.markFailedAndStop(
				"Failed to select environment.\n" +
				"Reason: " + e.getMessage()
				)
	}
}
