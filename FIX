package component

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import commands.WindowsObjectLoader

class CloseTabKeywords {

	@Keyword
	void closeTabByName(String tabName, Integer timeoutSeconds) {
		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 30 : timeoutSeconds

		addNote(
			'🧹 Close opened tab\n' +
			'Tab: ' + tabName
		)

		WindowsTestObject tabObject = WindowsObjectLoader.getTabByName(tabName)

		if (!Windows.waitForElementPresent(
				tabObject,
				safeTimeout,
				FailureHandling.OPTIONAL
		)) {
			KeywordUtil.markFailedAndStop(
				'Tab was not found and could not be closed.\n' +
				'Tab: ' + tabName
			)
		}

		Windows.click(tabObject)

		Windows.delay(1)

		WindowsTestObject closeButtonByTab = WindowsObjectLoader.getCloseButtonByTabName(tabName)

		if (Windows.waitForElementPresent(
				closeButtonByTab,
				5,
				FailureHandling.OPTIONAL
		)) {
			Windows.click(closeButtonByTab)

			Windows.delay(2)

			addNote(
				'✅ Tab closed successfully\n' +
				'Tab: ' + tabName
			)

			return
		}

		WindowsTestObject genericCloseButton = WindowsObjectLoader.getObject(
			'archiveMode',
			'closeButton'
		)

		if (Windows.waitForElementPresent(
				genericCloseButton,
				5,
				FailureHandling.OPTIONAL
		)) {
			Windows.click(genericCloseButton)

			Windows.delay(2)

			addNote(
				'✅ Tab closed successfully using generic close button\n' +
				'Tab: ' + tabName
			)

			return
		}

		KeywordUtil.markFailedAndStop(
			'Close button was not found for tab.\n' +
			'Tab: ' + tabName
		)
	}

	private void addNote(String message) {
		try {
			new jiraIntegration.JiraReportSteps().note(message)
		} catch (Throwable ignored) {
			KeywordUtil.logInfo(message)
		}
	}
}
