	private void pasteText(
			String text) {

		StringSelection selection =
				new StringSelection(
				text == null
				? ''
				: text
				)

		Toolkit
				.getDefaultToolkit()
				.getSystemClipboard()
				.setContents(
				selection,
				null
				)

		Thread.sleep(
				300
				)

		Robot robot =
				new Robot()

		robot.setAutoDelay(
				150
				)

		robot.keyPress(
				KeyEvent.VK_CONTROL
				)

		robot.keyPress(
				KeyEvent.VK_V
				)

		robot.keyRelease(
				KeyEvent.VK_V
				)

		robot.keyRelease(
				KeyEvent.VK_CONTROL
				)
	}

	private boolean isRemoteExecution() {

		List<String> remoteEnvironmentVariables = [
			'JENKINS_URL',
			'BUILD_NUMBER',
			'BUILD_ID',
			'JOB_NAME',
			'WORKSPACE'
		]

		for (String variableName : remoteEnvironmentVariables) {

			String variableValue =
					System.getenv(
					variableName
						)

			if (variableValue != null &&
					!variableValue.trim().isEmpty()) {

				return true
			}
		}

		return false
	}


	private boolean clickFirstAvailableImage(
			List<String> imageKeys,
			Integer timeoutSeconds) {

		for (String imageKey : imageKeys) {

			try {
				boolean imageFound =
						imageLoader.waitForImage(
						GENERAL_IMAGE_GROUP,
						imageKey,
						timeoutSeconds
						)

				if (!imageFound) {
					continue
				}

				imageLoader.clickImageOrStop(
						GENERAL_IMAGE_GROUP,
						imageKey
						)

				return true
			} catch (Throwable throwable) {

				logInfo(
						'Image was not available or could not be clicked.\n' +
						'Image key: ' +
						imageKey +
						'\nMessage: ' +
						safeExceptionMessage(
						throwable
							)
						)
			}
		}

		return false
	}


	private String findFirstVisibleImage(
			List<String> imageKeys,
			Integer timeoutSeconds) {

		for (String imageKey : imageKeys) {

			try {
				boolean imageFound =
						imageLoader.waitForImage(
						GENERAL_IMAGE_GROUP,
						imageKey,
						timeoutSeconds
						)

				if (imageFound) {
					return imageKey
				}
			} catch (Throwable throwable) {

				logInfo(
						'Image visibility search returned an exception.\n' +
						'Image key: ' +
						imageKey +
						'\nMessage: ' +
						safeExceptionMessage(
						throwable
							)
						)
			}
		}

		return null
	}


	private boolean isAnyImageVisible(
			List<String> imageKeys) {

		for (String imageKey : imageKeys) {

			try {
				boolean imageVisible =
						imageLoader.isVisible(
						GENERAL_IMAGE_GROUP,
						imageKey
						)

				if (imageVisible) {
					return true
				}
			} catch (Throwable throwable) {

				logInfo(
						'Could not verify image visibility.\n' +
						'Image key: ' +
						imageKey +
						'\nMessage: ' +
						safeExceptionMessage(
						throwable
							)
						)
			}
		}

		return false
	}



	private String sanitizeFileName(
			String text) {

		if (text == null ||
				text.trim().isEmpty()) {

			return 'Export'
		}

		String normalized =
				Normalizer
				.normalize(
				text,
				Normalizer.Form.NFD
				)
				.replaceAll(
				'\\p{InCombiningDiacriticalMarks}+',
				''
				)

		String cleaned =
				normalized
				.replaceAll(
				'[\\\\/:*?"<>|]',
				'_'
				)
				.replaceAll(
				'\\s+',
				'_'
				)
				.replaceAll(
				'_+',
				'_'
				)
				.replaceAll(
				'^_|_$',
				''
				)
				.trim()

		return cleaned.isEmpty()
				? 'Export'
				: cleaned
	}


	private String shortenFilePart(
			String value,
			Integer maximumLength) {

		if (value == null ||
				value.trim().isEmpty()) {

			return ''
		}

		int safeMaximum =
				maximumLength == null ||
				maximumLength <= 0
				? 20
				: maximumLength

		String cleanValue =
				sanitizeFileName(
				value
				)

		return cleanValue.length() <= safeMaximum
				? cleanValue
				: cleanValue.substring(
				0,
				safeMaximum
				)
	}


	private String removeExcelExtension(
			String fileName) {

		String value =
				fileName == null
				? ''
				: fileName.trim()

		return value.replaceFirst(
				'(?i)\\.(xlsx|xlsm|xls)$',
				''
				)
	}


	private String safeLogText(
			Object value) {

		if (value == null ||
				value.toString().trim().isEmpty()) {

			return 'Not provided'
		}

		return value.toString()
	}


	private String safeExceptionMessage(
			Throwable exception) {

		if (exception == null ||
				exception.getMessage() == null ||
				exception.getMessage().trim().isEmpty()) {

			return 'No exception message available'
		}

		return exception.getMessage()
	}


	private long elapsedMilliseconds(
