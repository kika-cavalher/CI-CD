)

Map result =
	CustomKeywords.'commands.RecPrdExportValidationKeywords.validateLatestRecPrdExport'(
		exportRootFolder,
		exportGroupFolder,
		exportFeatureFolder,
		expectedColumnIndex,
		expectedColumnName
	)

boolean success =
	result != null &&
	result.success == true

String errors =
	result == null
		? '[ERROR] Validation keyword returned no result.'
		: safeText(result.errors)

String passedDetails =
	result == null
		? ''
		: safeText(result.passedDetails)

String resolvedColumnName =
	result == null
		? expectedColumnName
		: safeText(result.columnName)

if (resolvedColumnName.isEmpty()) {
	resolvedColumnName = expectedColumnName
}

String recFileName =
	result == null
		? 'NOT FOUND'
		: displayValue(result.recFileName)

String prdFileName =
	result == null
		? 'NOT FOUND'
		: displayValue(result.prdFileName)

String selectedFolderPath =
	result == null
		? 'NOT FOUND'
		: displayValue(result.selectedFolderPath)


// ======================================================
