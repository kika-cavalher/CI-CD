import com.kms.katalon.core.annotation.AfterTestCase
import com.kms.katalon.core.annotation.AfterTestSuite
import com.kms.katalon.core.annotation.BeforeTestCase
import com.kms.katalon.core.annotation.BeforeTestSuite
import com.kms.katalon.core.context.TestCaseContext
import com.kms.katalon.core.context.TestSuiteContext
import com.kms.katalon.core.util.KeywordUtil

import java.text.SimpleDateFormat
import java.util.Collections
import java.util.Date
import java.util.Locale
import java.util.Map

class ematchReport {

    private static final SimpleDateFormat TIME_FORMAT =
        new SimpleDateFormat('yyyy-MM-dd HH:mm:ss.SSS', Locale.ENGLISH)

    private static final Map<String, Long> CASE_START_TIMES =
        Collections.synchronizedMap([:])

    private static long suiteStartTime = 0L

    @BeforeTestSuite
    def beforeTestSuite(TestSuiteContext testSuiteContext) {
        suiteStartTime = System.currentTimeMillis()
        CASE_START_TIMES.clear()

        String suiteId = safe(testSuiteContext?.getTestSuiteId())

        KeywordUtil.logInfo('============================================================')
        KeywordUtil.logInfo('START TEST SUITE: ' + suiteId)
        KeywordUtil.logInfo('SUITE START TIME: ' + now())
        KeywordUtil.logInfo('[REPORT_SUITE_START] ' + suiteId + ' | ' + now())
        KeywordUtil.logInfo('============================================================')
    }

    @BeforeTestCase
    def beforeTestCase(TestCaseContext testCaseContext) {
        String caseId = safe(testCaseContext?.getTestCaseId())

        CASE_START_TIMES[caseId] = System.currentTimeMillis()

        KeywordUtil.logInfo('------------------------------------------------------------')
        KeywordUtil.logInfo('START TEST CASE: ' + caseId)
        KeywordUtil.logInfo('START TIME: ' + now())
        KeywordUtil.logInfo('[REPORT_CASE_START] ' + caseId + ' | ' + now())
        KeywordUtil.logInfo('------------------------------------------------------------')

        try {
            CustomKeywords.'jiraIntegration.JiraImagesEvidence.startCase'(caseId)
        } catch (Throwable ignored) {
            KeywordUtil.logInfo('Warning: JiraImagesEvidence.startCase could not be executed.')
        }
    }

    @AfterTestCase
    def afterTestCase(TestCaseContext testCaseContext) {
        String caseId = safe(testCaseContext?.getTestCaseId())
        String rawStatus = safe(testCaseContext?.getTestCaseStatus()).toUpperCase(Locale.ENGLISH)
        String finalStatus = normalizeStatus(rawStatus)
        String message = safe(testCaseContext?.getMessage())

        long started = CASE_START_TIMES.containsKey(caseId)
            ? (CASE_START_TIMES[caseId] ?: System.currentTimeMillis())
            : System.currentTimeMillis()

        long ended = System.currentTimeMillis()
        long durationMs = Math.max(0L, ended - started)

        String startText = TIME_FORMAT.format(new Date(started))
        String endText = TIME_FORMAT.format(new Date(ended))

        KeywordUtil.logInfo('[REPORT_STATUS] ' + caseId + ' | ' + finalStatus)
        KeywordUtil.logInfo('[REPORT_CASE_END] ' + caseId + ' | ' + endText)
        KeywordUtil.logInfo('[REPORT_DURATION] ' + caseId + ' | ' + durationMs)

        String shortFailure = buildShortFailure(message)
        if (!shortFailure.isEmpty() && finalStatus != 'PASSED') {
            KeywordUtil.logInfo('[REPORT_FAILURE] ' + caseId + ' | ' + shortFailure)
        }

        try {
            CustomKeywords.'jiraIntegration.JiraImagesEvidence.finishCase'(caseId, finalStatus, message)
        } catch (Throwable ignored) {
            KeywordUtil.logInfo('Warning: JiraImagesEvidence.finishCase could not be executed.')
        }

        KeywordUtil.logInfo('STATUS: ' + finalStatus)
        KeywordUtil.logInfo('START TIME: ' + startText)
        KeywordUtil.logInfo('END TIME: ' + endText)
        KeywordUtil.logInfo('DURATION: ' + formatDuration(durationMs))

        if (!shortFailure.isEmpty() && finalStatus != 'PASSED') {
            KeywordUtil.logInfo('FAILURE MESSAGE: ' + shortFailure)
        }

        KeywordUtil.logInfo('END TEST CASE: ' + caseId)
        KeywordUtil.logInfo('------------------------------------------------------------')
    }

    @AfterTestSuite
    def afterTestSuite(TestSuiteContext testSuiteContext) {
        long suiteEndTime = System.currentTimeMillis()
        long suiteDurationMs = Math.max(0L, suiteEndTime - suiteStartTime)

        String suiteId = safe(testSuiteContext?.getTestSuiteId())

        KeywordUtil.logInfo('============================================================')
        KeywordUtil.logInfo('END TEST SUITE: ' + suiteId)
        KeywordUtil.logInfo('SUITE END TIME: ' + TIME_FORMAT.format(new Date(suiteEndTime)))
        KeywordUtil.logInfo('SUITE DURATION: ' + formatDuration(suiteDurationMs))
        KeywordUtil.logInfo('[REPORT_SUITE_END] ' + suiteId + ' | ' + TIME_FORMAT.format(new Date(suiteEndTime)))
        KeywordUtil.logInfo('============================================================')
    }

    private String normalizeStatus(String rawStatus) {
        switch (safe(rawStatus)) {
            case 'PASSED':
                return 'PASSED'
            case 'FAILED':
            case 'ERROR':
                return 'FAILED'
            case 'NOT_RUN':
            case 'INCOMPLETE':
            case 'SKIPPED':
            default:
                return 'BLOCKED'
        }
    }

    private String buildShortFailure(String rawMessage) {
        if (safe(rawMessage).isEmpty()) {
            return ''
        }

        List<String> meaningful = []

        rawMessage.readLines().each { String line ->
            String clean = safe(line)

            if (clean.isEmpty()) {
                return
            }

            if (clean.equalsIgnoreCase('Reason:')) {
                return
            }

            if (clean.startsWith('at ')) {
                return
            }

            if (clean.startsWith('Build info:')) {
                return
            }

            if (clean.startsWith('System info:')) {
                return
            }

            if (clean.startsWith('Driver info:')) {
                return
            }

            meaningful << clean
        }

        if (meaningful.isEmpty()) {
            return ''
        }

        return meaningful.take(2).join(' | ')
    }

    private String now() {
        return TIME_FORMAT.format(new Date())
    }

    private String formatDuration(long durationMs) {
        if (durationMs < 0L) {
            durationMs = 0L
        }

        long totalSeconds = Math.round(durationMs / 1000.0d)
        long hours = (long) (totalSeconds / 3600L)
        long minutes = (long) ((totalSeconds % 3600L) / 60L)
        long seconds = (long) (totalSeconds % 60L)

        return String.format(Locale.ENGLISH, '%02dh %02dm %02ds', hours, minutes, seconds)
    }

    private String safe(Object value) {
        return value == null ? '' : String.valueOf(value).trim()
    }
}
