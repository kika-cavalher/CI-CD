                color: var(--text-muted);
                box-shadow: var(--shadow);
            }

            @media (max-width: 1260px) {
                .page {
                    grid-template-columns: 380px 1fr;
                }

                .chart-grid {
                    grid-template-columns: 1fr;
                }

