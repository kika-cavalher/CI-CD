	private void validatePresent(
		String objectKey,
		String description,
		Integer timeout,
		List<String> errors
	) {

		logObjectSearch(
			objectKey,
			description
		)

		boolean present =
			Windows.waitForElementPresent(
				object(objectKey),
				timeout,
				FailureHandling.OPTIONAL
			)

		reportBooleanResult(
