pipeline {
  agent { label 'GI5_SWDCFRNXGI55817' }

  parameters {
    booleanParam(name: 'SHOW_BROWSER', defaultValue: true, description: 'If true, try to run Katalon via Scheduled Task (visible UI). If task not found, fallback to normal Jenkins run.')
  }

  options {
    timestamps()
    timeout(time: 75, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  environment {
    KATALON_HOME   = 'C:/Users/adgi5appjenkins/Documents/Katalon_Studio_Engine_Windows_64-8.1.0'
    PROJECT_PATH   = 'D:/jenkins/work/workspace/GI5/Gaia/Gaia'
    TSC_PATH       = 'Test Suites/GAIA TSC'

    // Scheduled task name that YOU must create in Windows Task Scheduler
    VISIBLE_TASK   = 'GaiaKatalon_Visible'
  }

  stages {

    stage('Start Gaia Backend and Frontend') {
      steps {
        script {
          echo "[gaia-start] Start Gaia Backend + Frontend"
          bat 'schtasks /run /tn "GaiaBackFrontSetup"'
          echo "[gaia-start] Waiting 300 seconds..."
          sleep(time: 300, unit: 'SECONDS')
        }
      }
    }

    stage('Get bitbucket source code') {
      steps {
        // Keep your original (less intrusive) approach
        cleanWs(deleteDirs: true, disableDeferredWipeout: true, notFailBuild: true)

        git credentialsId: '965eceec-b3a3-4ec5-8820-a857c87dd80f',
            url: 'https://bitbucket-mut.mycloud.intrabpce.fr/scm/gi5/gaia-portal.git'
      }
    }

    stage('GAIA TSC (try visible, fallback safe)') {
      steps {
        script {
          def katalonArgs = "-projectPath=\"${env.PROJECT_PATH}\" -browserType=\"Chrome\" -testSuiteCollectionPath=\"${env.TSC_PATH}\" -noHeadless -consoleLog -logLevel=DEBUG"

          // 1) Try scheduled task (ONLY if user wants UI)
          if (params.SHOW_BROWSER) {
            echo "[katalon] SHOW_BROWSER=true -> trying scheduled task: ${env.VISIBLE_TASK}"

            def taskExists = bat(returnStatus: true, script: "schtasks /query /tn \"${env.VISIBLE_TASK}\" >NUL 2>&1")

            if (taskExists == 0) {
              echo "[katalon] Task exists. Running it (Chrome should be visible in your RDP session)."
              // Run task
              bat "schtasks /run /tn \"${env.VISIBLE_TASK}\""
              echo "[katalon] Scheduled task triggered."
              // IMPORTANT: do not fail build here; task handles execution
              return
            } else {
              echo "[katalon] Task NOT found -> fallback to Jenkins execution (may be invisible if Session 0)."
            }
          } else {
            echo "[katalon] SHOW_BROWSER=false -> running via Jenkins (headless not forced here)."
          }

          // 2) Fallback: original working Jenkins execution
          catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
            executeKatalon(
              executeArgs: katalonArgs,
              location: "${env.KATALON_HOME}",
              version: '',
              x11Display: '',
              xvfbConfiguration: ''
            )
          }
        }
      }
    }
  }
}
