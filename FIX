        }

        List<File> candidates = []
        candidates.add(new File(root, 'Evidences'))
        candidates.add(new File(root, 'evidence'))
        candidates.add(new File(root, 'Evidence'))

        for (File candidate : candidates) {
            if (candidate.exists() && candidate.isDirectory()) {
                return candidate
            }
        }

        return null
    }

    List<File> collectFailureImages(String reportFolder) {
        List<File> images = []
        if (isBlank(reportFolder)) {
            return images
        }

        File root = new File(reportFolder)
        if (!root.exists() || !root.isDirectory()) {
            return images
        }

        Set<String> seen = new LinkedHashSet<String>()

        root.eachFileRecurse { File file ->
            if (file == null || !file.isFile()) {
                return
            }

            String lowerPath = safe(file.absolutePath).toLowerCase(Locale.ENGLISH)
            String lowerName = safe(file.name).toLowerCase(Locale.ENGLISH)

            if (lowerPath.contains(File.separator + 'requests' + File.separator)) {
                return
            }
            if (lowerPath.contains(File.separator + 'videos' + File.separator)) {
                return
            }
            if (lowerName == safe(RESULT_ZIP_NAME).toLowerCase(Locale.ENGLISH)) {
                return
            }
            if (lowerName == safe(EVIDENCE_ZIP_NAME).toLowerCase(Locale.ENGLISH)) {
                return
            }
            if (lowerName == safe(REPORT_FILE_NAME).toLowerCase(Locale.ENGLISH)) {
                return
            }
            if (!(lowerName.endsWith('.png') ||
                  lowerName.endsWith('.jpg') ||
                  lowerName.endsWith('.jpeg') ||
                  lowerName.endsWith('.webp') ||
                  lowerName.endsWith('.bmp') ||
                  lowerName.endsWith('.gif'))) {
                return
            }

            String key = file.absolutePath
            if (!seen.contains(key)) {
                seen.add(key)
                images.add(file)
            }
        }

        images.sort { a, b -> a.lastModified() <=> b.lastModified() }
        return images
    }

