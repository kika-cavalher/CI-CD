node('GI5_SWDCFRNXGI55817') {
    def currentExitCode = 0
    def nextBuild = null

    stage('Checkout') {
        checkout scm
    }

    stage('Run current execution') {
        currentExitCode = bat(
            script: "call \"%WORKSPACE%\\jenkins\\ArchiveMode.cmd\"",
            returnStatus: true
        )

        echo "Current execution exit code: ${currentExitCode}"
    }

    stage('Run next pipeline') {
        nextBuild = build job: 'GI5/eMatch_Regression/Archive Mode ttttt',
            wait: true,
            propagate: false

        echo "Next pipeline build number: ${nextBuild.number}"
        echo "Next pipeline result: ${nextBuild.result}"
    }

    stage('Finalize') {
        if (currentExitCode != 0) {
            currentBuild.result = 'UNSTABLE'
            echo "Current execution finished with non-zero exit code: ${currentExitCode}"
        } else {
            echo 'Current execution finished successfully.'
        }

        echo "Pipeline finished. Current execution code=${currentExitCode}, next pipeline=${nextBuild?.result}"
    }
}
