// ======================================================
// CREATE FAVORITE
// ======================================================

@Keyword
void createFavoriteFromCurrentModule(
	String favoriteTitle,
	Integer controlTimeoutSeconds,
	Integer popupTimeoutSeconds
) {

	Integer controlTimeout = safeTimeout(
		controlTimeoutSeconds,
		5
	)

	Integer popupTimeout = safeTimeout(
		popupTimeoutSeconds,
		5
	)

	logStep(
		'CREATE FAVORITE',
		'Favorite title: ' + favoriteTitle
	)

	KeywordUtil.logInfo(
		'[FAVORITE][01] Method started.'
	)

	Windows.delay(2)

	// ==================================================
	// CLICK CREATE FAVORITE BY IMAGE
	// ==================================================

	KeywordUtil.logInfo(
		'[FAVORITE][02] Searching Create Favorite image.\n' +
		'Image group: ' + GENERAL_IMAGE_GROUP + '\n' +
		'Image key: createFavoriteIcon\n' +
		'Expected file: Images/general/icomFavorite.png\n' +
		'Timeout: ' + controlTimeout + ' seconds'
	)

	long createFavoriteSearchStart =
		System.currentTimeMillis()

	boolean createFavoriteClicked =
		clickFirstVisibleImage(
			GENERAL_IMAGE_GROUP,
			[
				'createFavoriteIcon'
			],
			controlTimeout
		)

	long createFavoriteSearchDuration =
		System.currentTimeMillis() -
		createFavoriteSearchStart

	KeywordUtil.logInfo(
		'[FAVORITE][03] Create Favorite image search finished.\n' +
		'Found and clicked: ' + createFavoriteClicked + '\n' +
		'Duration: ' + createFavoriteSearchDuration + ' ms'
	)

	if (!createFavoriteClicked) {
		KeywordUtil.logInfo(
			'[FAVORITE][04] Create Favorite image was not found. ' +
			'Stopping test immediately.'
		)

		takeEvidence(
			'GUI_CreateFavoriteImageNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Create Favorite image was not found.\n' +
			'Image group: ' + GENERAL_IMAGE_GROUP + '\n' +
			'Image key: createFavoriteIcon\n' +
			'Expected file: Images/general/icomFavorite.png\n' +
			'Timeout: ' + controlTimeout + ' seconds\n' +
			'Search duration: ' +
			createFavoriteSearchDuration +
			' ms'
		)

		return
	}

	KeywordUtil.logInfo(
		'[FAVORITE][05] Create Favorite clicked successfully by image.'
	)

	Windows.delay(1)

	// ==================================================
	// FAVORITE TITLE
	// ==================================================

	KeywordUtil.logInfo(
		'[FAVORITE][06] Filling favorite title.\n' +
		'Image group: ' + GUI_IMAGE_GROUP + '\n' +
		'Image key: favoriteFilterField\n' +
		'Title: ' + favoriteTitle
	)

	long favoriteTitleStart =
		System.currentTimeMillis()

	try {
		typeOnImage(
			GUI_IMAGE_GROUP,
			'favoriteFilterField',
			favoriteTitle,
			controlTimeout
		)
	} catch (Throwable error) {
		takeEvidence(
			'GUI_FavoriteTitleNotFilled.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorite title could not be filled.\n' +
			'Image key: favoriteFilterField\n' +
			'Favorite title: ' + favoriteTitle + '\n' +
			'Error: ' + safeText(error.getMessage())
		)

		return
	}

	KeywordUtil.logInfo(
		'[FAVORITE][07] Favorite title filled successfully.\n' +
		'Duration: ' +
		(System.currentTimeMillis() - favoriteTitleStart) +
		' ms'
	)

	Windows.delay(1)

	// ==================================================
	// SAVE FAVORITE
	// ==================================================

	KeywordUtil.logInfo(
		'[FAVORITE][08] Loading WindowsObject: favoriteSaveTopBar'
	)

	WindowsTestObject saveFavoriteButton

	try {
		saveFavoriteButton =
			object('favoriteSaveTopBar')
	} catch (Throwable error) {
		takeEvidence(
			'GUI_SaveFavoriteObjectLoadError.png'
		)

		KeywordUtil.markFailedAndStop(
			'Save Favorite WindowsObject could not be loaded.\n' +
			'WindowsObject: favoriteSaveTopBar\n' +
			'Error: ' + safeText(error.getMessage())
		)

		return
	}

	KeywordUtil.logInfo(
		'[FAVORITE][09] Save Favorite WindowsObject loaded successfully.'
	)

	KeywordUtil.logInfo(
		'[FAVORITE][10] Waiting for Save Favorite button.\n' +
		'Timeout: ' + controlTimeout + ' seconds'
	)

	long saveButtonSearchStart =
		System.currentTimeMillis()

	boolean saveFavoritePresent =
		Windows.waitForElementPresent(
			saveFavoriteButton,
			controlTimeout,
			FailureHandling.OPTIONAL
		)

	KeywordUtil.logInfo(
		'[FAVORITE][11] Save Favorite search finished.\n' +
		'Present: ' + saveFavoritePresent + '\n' +
		'Duration: ' +
		(System.currentTimeMillis() - saveButtonSearchStart) +
		' ms'
	)

	if (!saveFavoritePresent) {
		takeEvidence(
			'GUI_SaveFavoriteButtonNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Save Favorite button was not found.\n' +
			'WindowsObject: favoriteSaveTopBar\n' +
			'Timeout: ' + controlTimeout + ' seconds'
		)

		return
	}

	KeywordUtil.logInfo(
		'[FAVORITE][12] Reading Save Favorite IsEnabled attribute.'
	)

	String saveEnabled = safeText(
		Windows.getAttribute(
			saveFavoriteButton,
			'IsEnabled',
			FailureHandling.OPTIONAL
		)
	)

	KeywordUtil.logInfo(
		'[FAVORITE][13] Save Favorite IsEnabled: ' +
		saveEnabled
	)

	if (!saveEnabled.equalsIgnoreCase('True')) {
		takeEvidence(
			'GUI_SaveFavoriteButtonDisabled.png'
		)

		KeywordUtil.markFailedAndStop(
			'Save Favorite button is disabled after filling the title.\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'IsEnabled: ' + saveEnabled
		)

		return
	}

	KeywordUtil.logInfo(
		'[FAVORITE][14] Clicking Save Favorite button.'
	)

	long saveClickStart =
		System.currentTimeMillis()

	try {
		Windows.click(
			saveFavoriteButton,
			FailureHandling.STOP_ON_FAILURE
		)
	} catch (Throwable error) {
		takeEvidence(
			'GUI_SaveFavoriteClickError.png'
		)

		KeywordUtil.markFailedAndStop(
			'Save Favorite button was found but could not be clicked.\n' +
			'Error: ' + safeText(error.getMessage())
		)

		return
	}

	KeywordUtil.logInfo(
		'[FAVORITE][15] Save Favorite button clicked.\n' +
		'Duration: ' +
		(System.currentTimeMillis() - saveClickStart) +
		' ms'
	)

	// ==================================================
	// CONFIRMATION
	// ==================================================

	KeywordUtil.logInfo(
		'[FAVORITE][16] Waiting for favorite confirmation.\n' +
		'Timeout: ' + popupTimeout + ' seconds'
	)

	long confirmationStart =
		System.currentTimeMillis()

	String modalDetection =
		waitForFavoriteConfirmation(
			favoriteTitle,
			popupTimeout
		)

	KeywordUtil.logInfo(
		'[FAVORITE][17] Confirmation search finished.\n' +
		'Detected by: ' + modalDetection + '\n' +
		'Duration: ' +
		(System.currentTimeMillis() - confirmationStart) +
		' ms'
	)

	if (modalDetection.isEmpty()) {
		takeEvidence(
			'GUI_FavoriteConfirmationModalNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorite confirmation modal was not found.\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'Timeout: ' + popupTimeout + ' seconds'
		)

		return
	}

	takeEvidence(
		'GUI_FavoriteConfirmationModal.png'
	)

	Windows.delay(5)

	KeywordUtil.logInfo(
		'[FAVORITE][18] Closing favorite confirmation.'
	)

	boolean confirmationClosed =
		clickFirstVisibleImage(
			GENERAL_IMAGE_GROUP,
			[
				'okModal',
				'okModal2Version'
			],
			3
		)

	KeywordUtil.logInfo(
		'[FAVORITE][19] Confirmation closed by image: ' +
		confirmationClosed
	)

	if (!confirmationClosed) {
		KeywordUtil.logInfo(
			'[FAVORITE][20] OK image was not found. Pressing ENTER.'
		)

		pressKeyboardKey(
			KeyEvent.VK_ENTER
		)
	}

	Windows.delay(2)

	KeywordUtil.markPassed(
		'Favorite created successfully.\n' +
		'Title: ' + favoriteTitle + '\n' +
		'Confirmation detected by: ' + modalDetection
	)
}
