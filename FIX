package jiraIntegration

import groovy.json.JsonOutput
import groovy.json.JsonSlurper

import java.net.HttpURLConnection
import java.net.URL
import java.net.URLEncoder
import java.nio.charset.StandardCharsets
import java.util.UUID

import javax.net.ssl.HostnameVerifier
import javax.net.ssl.HttpsURLConnection
import javax.net.ssl.SSLContext
import javax.net.ssl.SSLSession
import javax.net.ssl.TrustManager
import javax.net.ssl.X509TrustManager

class JiraGateway {

    private String jiraBaseUrl = ''
    private String authHeader = ''
    private boolean ignoreSslCertificates = false
    private def owner

    JiraGateway() {
    }

    JiraGateway(def ownerOrConfig) {
        this.owner = ownerOrConfig
        applyOwnerOrConfig(ownerOrConfig)
        buildAuthHeader()
    }

    JiraGateway(String baseUrl, String token) {
        this.jiraBaseUrl = normalizeBaseUrl(baseUrl)
        if (!blank(token)) {
            this.authHeader = 'Bearer ' + token.trim()
        }
    }

    JiraGateway(String baseUrl, String username, String password) {
        this.jiraBaseUrl = normalizeBaseUrl(baseUrl)
        if (!blank(username) || !blank(password)) {
            String raw = safe(username) + ':' + safe(password)
            this.authHeader = 'Basic ' + raw.bytes.encodeBase64().toString()
        }
    }

    // =========================================================================
    // PUBLIC API
    // =========================================================================

    void validateRequiredConfiguration() {
        if (blank(jiraBaseUrl)) {
            throw new IllegalStateException('JIRA_BASE_URL is required.')
        }

        if (blank(authHeader)) {
            throw new IllegalStateException('Jira authentication is required. Configure token or username/password.')
        }
    }

    Map getIssueByKey(String issueKey) {
        validateRequiredConfiguration()
        return doGet('/rest/api/2/issue/' + encoded(issueKey))
    }

    Map searchIssues(String jql) {
        validateRequiredConfiguration()
        String path = '/rest/api/2/search?jql=' + encoded(jql) + '&maxResults=200'
        return doGet(path)
    }

    Map searchTestPlans(String projectKey, String summary) {
        validateRequiredConfiguration()

        String escapedSummary = escapeJqlText(summary)
        String jql = "project = '${safe(projectKey)}' AND issuetype = 'Test Plan' AND summary ~ \\\"${escapedSummary}\\\" ORDER BY created DESC"

        return searchIssues(jql)
    }

    Map createIssue(Map fields) {
        validateRequiredConfiguration()
        return doPostJson('/rest/api/2/issue', [fields: fields])
    }

    Map createTestPlan(String projectKey,
                       String summary,
                       String epicFieldId,
                       String epicKey,
                       List labels,
                       String description) {
        validateRequiredConfiguration()

        Map fields = [
            project  : [key: safe(projectKey)],
            summary  : safe(summary),
            issuetype: [name: 'Test Plan']
        ]

        List safeLabels = (labels ?: []).findAll { !blank(it) }.collect { safe(it) }
        if (!safeLabels.isEmpty()) {
            fields.labels = safeLabels
        }

        if (!blank(description)) {
            fields.description = safe(description)
        }

        if (!blank(epicFieldId) && !blank(epicKey)) {
            fields[epicFieldId] = safe(epicKey)
        }

        return createIssue(fields)
    }

    Map importExecutionResults(File junitXmlFile, String projectKey, String testPlanKey) {
        validateRequiredConfiguration()

        if (junitXmlFile == null || !junitXmlFile.exists()) {
            throw new IllegalArgumentException('JUnit XML file was not found.')
        }

        String path = buildJUnitImportPath(projectKey, testPlanKey)
        byte[] payload = junitXmlFile.bytes

        return doPostBinary(path, payload, 'text/xml; charset=UTF-8', 'application/json')
    }

    Map importExecutionResults(File junitXmlFile, String projectKey, String testPlanKey, String ignoredExecutionSummary) {
        return importExecutionResults(junitXmlFile, projectKey, testPlanKey)
    }

    Map importJunitExecution(File junitXmlFile, String projectKey, String testPlanKey) {
        return importExecutionResults(junitXmlFile, projectKey, testPlanKey)
    }

    Map importJunitExecution(File junitXmlFile, String projectKey, String testPlanKey, String ignoredExecutionSummary) {
        return importExecutionResults(junitXmlFile, projectKey, testPlanKey)
    }

    Map addExecutionToTestPlan(String testPlanKey, String testExecutionKey) {
        validateRequiredConfiguration()

        String path = '/rest/raven/1.0/api/testplan/' + encoded(testPlanKey) + '/testexecution'
        List body = [safe(testExecutionKey)]

        return doPostJson(path, body)
    }

    Map uploadAttachment(String issueKey, File attachmentFile) {
        validateRequiredConfiguration()

        if (attachmentFile == null || !attachmentFile.exists()) {
            throw new IllegalArgumentException('Attachment file was not found.')
        }

        String path = '/rest/api/2/issue/' + encoded(issueKey) + '/attachments'
        return doMultipartAttachment(path, attachmentFile)
    }

    Map addAttachment(String issueKey, File attachmentFile) {
        return uploadAttachment(issueKey, attachmentFile)
    }

    // =========================================================================
    // HTTP
    // =========================================================================

    private Map doGet(String path) {
        return executeRequest('GET', path, null, null, 'application/json', [:])
    }

    private Map doPostJson(String path, Object payload) {
        byte[] bytes = JsonOutput.toJson(payload).getBytes(StandardCharsets.UTF_8)
        return executeRequest('POST', path, bytes, 'application/json; charset=UTF-8', 'application/json', [:])
    }

    private Map doPostBinary(String path, byte[] payload, String contentType, String accept) {
        return executeRequest('POST', path, payload, contentType, accept, [:])
    }

    private Map doMultipartAttachment(String path, File attachmentFile) {
        String boundary = '----OpenAIBoundary' + UUID.randomUUID().toString().replace('-', '')
        ByteArrayOutputStream buffer = new ByteArrayOutputStream()

        String fileName = attachmentFile.name
        byte[] lineBreak = '\r\n'.getBytes(StandardCharsets.UTF_8)

        buffer.write(('--' + boundary + '\r\n').getBytes(StandardCharsets.UTF_8))
        buffer.write(('Content-Disposition: form-data; name="file"; filename="' + fileName + '"\r\n').getBytes(StandardCharsets.UTF_8))
        buffer.write(('Content-Type: application/octet-stream\r\n\r\n').getBytes(StandardCharsets.UTF_8))
        buffer.write(attachmentFile.bytes)
        buffer.write(lineBreak)
        buffer.write(('--' + boundary + '--\r\n').getBytes(StandardCharsets.UTF_8))

        Map extraHeaders = ['X-Atlassian-Token': 'no-check']

        return executeRequest(
            'POST',
            path,
            buffer.toByteArray(),
            'multipart/form-data; boundary=' + boundary,
            'application/json',
            extraHeaders
        )
    }

    private Map executeRequest(String method,
                               String path,
                               byte[] body,
                               String contentType,
                               String accept,
                               Map extraHeaders) {
        configureSslIfNeeded()

        HttpURLConnection connection = null
        int status = -1
        String responseBody = ''

        try {
            URL url = new URL(jiraBaseUrl + path)
            connection = (HttpURLConnection) url.openConnection()
            connection.setRequestMethod(method)
            connection.setConnectTimeout(60000)
            connection.setReadTimeout(60000)
            connection.setUseCaches(false)
            connection.setDoInput(true)

            connection.setRequestProperty('Authorization', authHeader)
            connection.setRequestProperty('Accept', blank(accept) ? '*/*' : accept)
            connection.setRequestProperty('User-Agent', 'Katalon-Jira-Integration')

            extraHeaders?.each { String key, Object value ->
                if (!blank(key) && value != null) {
                    connection.setRequestProperty(key, String.valueOf(value))
                }
            }

            if (body != null) {
                connection.setDoOutput(true)
                if (!blank(contentType)) {
                    connection.setRequestProperty('Content-Type', contentType)
                }
                connection.outputStream.withCloseable { stream ->
                    stream.write(body)
                    stream.flush()
                }
            }

            status = connection.responseCode

            InputStream stream = status >= 400 ? connection.getErrorStream() : connection.getInputStream()
            if (stream != null) {
                responseBody = stream.getText('UTF-8')
            }

            return buildResponseMap(status, responseBody, connection)
        } finally {
            try {
                connection?.disconnect()
            } catch (Exception ignored) {
            }
        }
    }

    private Map buildResponseMap(int status, String responseBody, HttpURLConnection connection) {
        String contentType = safe(connection?.getHeaderField('Content-Type'))
        Object json = parseJsonSilently(responseBody)

        return [
            status     : status,
            body       : safeRaw(responseBody),
            json       : json,
            contentType: contentType,
            isHtml     : looksLikeHtml(responseBody, contentType),
            isJson     : json != null
        ]
    }

    // =========================================================================
    // INTERNAL CONFIG
    // =========================================================================

    private void applyOwnerOrConfig(def source) {
        if (source == null) {
            return
        }

        if (source instanceof Map) {
            jiraBaseUrl = normalizeBaseUrl(firstNonBlank(
                source.jiraBaseUrl,
                source.baseUrl,
                source.JIRA_BASE_URL
            ))

            ignoreSslCertificates = toBoolean(firstNonBlank(
                source.ignoreSslCertificates,
                source.IGNORE_SSL_CERTIFICATES,
                source.disableSslValidation,
                source.DISABLE_SSL_VALIDATION
            ))

            String directAuthHeader = firstNonBlank(
                source.authHeader,
                source.AUTH_HEADER
            )

            String token = firstNonBlank(
                source.jiraToken,
                source.token,
                source.JIRA_TOKEN,
                source.JIRA_PAT
            )

            String username = firstNonBlank(
                source.username,
                source.user,
                source.JIRA_USERNAME,
                source.JIRA_USER
            )

            String password = firstNonBlank(
                source.password,
                source.pass,
                source.JIRA_PASSWORD
            )

            if (!blank(directAuthHeader)) {
                authHeader = directAuthHeader
                return
            }

            if (!blank(token)) {
                authHeader = 'Bearer ' + token.trim()
                return
            }

            if (!blank(username) || !blank(password)) {
                String raw = safe(username) + ':' + safe(password)
                authHeader = 'Basic ' + raw.bytes.encodeBase64().toString()
            }

            return
        }

        jiraBaseUrl = normalizeBaseUrl(firstNonBlank(
            readOwnerText('jiraBaseUrl'),
            readOwnerText('baseUrl'),
            readOwnerText('JIRA_BASE_URL')
        ))

        ignoreSslCertificates = toBoolean(firstNonBlank(
            readOwnerText('ignoreSslCertificates'),
            readOwnerText('IGNORE_SSL_CERTIFICATES'),
            readOwnerText('disableSslValidation'),
            readOwnerText('DISABLE_SSL_VALIDATION')
        ))

        String directAuthHeader = firstNonBlank(
            readOwnerText('authHeader'),
            readOwnerText('AUTH_HEADER')
        )

        String token = firstNonBlank(
            readOwnerText('jiraToken'),
            readOwnerText('token'),
            readOwnerText('JIRA_TOKEN'),
            readOwnerText('JIRA_PAT')
        )

        String username = firstNonBlank(
            readOwnerText('username'),
            readOwnerText('user'),
            readOwnerText('JIRA_USERNAME'),
            readOwnerText('JIRA_USER')
        )

        String password = firstNonBlank(
            readOwnerText('password'),
            readOwnerText('pass'),
            readOwnerText('JIRA_PASSWORD')
        )

        if (!blank(directAuthHeader)) {
            authHeader = directAuthHeader
            return
        }

        if (!blank(token)) {
            authHeader = 'Bearer ' + token.trim()
            return
        }

        if (!blank(username) || !blank(password)) {
            String raw = safe(username) + ':' + safe(password)
            authHeader = 'Basic ' + raw.bytes.encodeBase64().toString()
        }
    }

    private void buildAuthHeader() {
        if (!blank(authHeader)) {
            return
        }
    }

    private void configureSslIfNeeded() {
        if (!ignoreSslCertificates) {
            return
        }

        TrustManager[] trustAllCerts = [
            [
                getAcceptedIssuers: { -> null },
                checkClientTrusted: { chain, authType -> },
                checkServerTrusted: { chain, authType -> }
            ] as X509TrustManager
        ] as TrustManager[]

        SSLContext sc = SSLContext.getInstance('SSL')
        sc.init(null, trustAllCerts, new java.security.SecureRandom())
        HttpsURLConnection.setDefaultSSLSocketFactory(sc.getSocketFactory())

        HttpsURLConnection.setDefaultHostnameVerifier([
            verify: { String hostname, SSLSession session -> true }
        ] as HostnameVerifier)
    }

    private String buildJUnitImportPath(String projectKey, String testPlanKey) {
        List<String> params = []

        if (!blank(projectKey)) {
            params << 'projectKey=' + encoded(projectKey)
        }

        if (!blank(testPlanKey)) {
            params << 'testPlanKey=' + encoded(testPlanKey)
        }

        String query = params.isEmpty() ? '' : ('?' + params.join('&'))
        return '/rest/raven/1.0/import/execution/junit' + query
    }

    // =========================================================================
    // HELPERS
    // =========================================================================

    private Object parseJsonSilently(String body) {
        String text = safeRaw(body)
        if (blank(text)) {
            return null
        }

        String trimmed = text.trim()
        if (!(trimmed.startsWith('{') || trimmed.startsWith('['))) {
            return null
        }

        try {
            return new JsonSlurper().parseText(trimmed)
        } catch (Exception ignored) {
            return null
        }
    }

    private boolean looksLikeHtml(String body, String contentType) {
        String text = safeRaw(body).toLowerCase()
        String type = safe(contentType).toLowerCase()

        return type.contains('text/html') ||
               text.startsWith('<html') ||
               text.startsWith('<!doctype html') ||
               text.contains('<body')
    }

    private String readOwnerText(String propertyName) {
        if (owner == null || blank(propertyName)) {
            return ''
        }

        try {
            def metaProperty = owner.metaClass?.hasProperty(owner, propertyName)
            if (metaProperty == null) {
                return ''
            }
            def value = owner."${propertyName}"
            return safe(value)
        } catch (Exception ignored) {
            return ''
        }
    }

    private String normalizeBaseUrl(String raw) {
        String value = safe(raw)
        if (blank(value)) {
            return ''
        }
        while (value.endsWith('/')) {
            value = value.substring(0, value.length() - 1)
        }
        return value
    }

    private String escapeJqlText(String raw) {
        return safe(raw)
            .replace('\\', '\\\\')
            .replace('"', '\\"')
    }

    private String encoded(String raw) {
        return URLEncoder.encode(safe(raw), 'UTF-8').replace('+', '%20')
    }

    private boolean toBoolean(def value) {
        String text = safe(value).toLowerCase()
        return text == 'true' || text == '1' || text == 'yes'
    }

    private boolean blank(def value) {
        return safe(value).isEmpty()
    }

    private String safe(def value) {
        return value == null ? '' : String.valueOf(value).trim()
    }

    private String safeRaw(def value) {
        return value == null ? '' : String.valueOf(value)
    }

    private String firstNonBlank(Object... values) {
        if (values == null) {
            return ''
        }

        for (Object value : values) {
            String text = safe(value)
            if (!text.isEmpty()) {
                return text
            }
        }

        return ''
    }
}
