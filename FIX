import org.jenkinsci.plugins.workflow.steps.FlowInterruptedException

properties([
    disableConcurrentBuilds()
])

def NODE_LABEL = 'GI5_SWDCFRNXGI55817'

// true = schedule the next pipeline
// false = stop after this pipeline
def RUN_NEXT_JOB = false

// Example: GI5/eMatch_Regression/PNLEco
def NEXT_JOB = ''

def hadHardFailure = false
def manuallyAborted = false

def stopCurrentExecution = {
    bat '''
@echo off
schtasks /end /tn "\\eMatch Automation\\RunEMatchCommand" >nul 2>nul
schtasks /end /tn "startWinDriver" >nul 2>nul
taskkill /f /im WinAppDriver.exe /t >nul 2>nul
taskkill /f /im katalonc.exe /t >nul 2>nul
taskkill /f /im KatalonStudio.exe /t >nul 2>nul
ping -n 6 127.0.0.1 >nul
exit /b 0
'''
}

def isTimeoutError = { Throwable err ->
    def text = "${err}".toLowerCase()
    return text.contains('timeout') || text.contains('exceededtimeout')
}

def runCollection = { String stageName, String cmdFile ->
    stage(stageName) {
        try {
            timeout(time: 5, unit: 'HOURS') {
                bat """call "%WORKSPACE%\\jenkins\\${cmdFile}" """
            }
            echo "${stageName} completed successfully."
        } catch (FlowInterruptedException err) {
            if (isTimeoutError(err)) {
                hadHardFailure = true
                echo "${stageName} timed out after 5 hours."
            } else {
                manuallyAborted = true
                echo "${stageName} was manually aborted."
                throw err
            }
        } catch (Throwable err) {
            hadHardFailure = true
            echo "${stageName} failed: ${err}"
        } finally {
            stage("Stop ${stageName}") {
                stopCurrentExecution()
            }
        }
    }
}

try {
    node(NODE_LABEL) {
        stage('Checkout') {
            checkout scm
        }

        runCollection('Emission Element Valorise Collection', 'EmissionElementValorise.cmd')
        runCollection('Emission Derive Collection', 'EmissionDerive.cmd')
        runCollection('Emission Filtre Collection', 'EmissionFiltre.cmd')
        runCollection('Emission Validations Collection', 'EmissionValidations.cmd')
        runCollection('Emission Valorisation Brute Collection', 'EmissionValorisationBrute.cmd')
    }
} catch (FlowInterruptedException err) {
    manuallyAborted = true
    currentBuild.result = 'ABORTED'
    echo 'Build manually aborted. Next pipeline will not be scheduled.'
    return
}

if (manuallyAborted) {
    currentBuild.result = 'ABORTED'
    echo 'Build manually aborted. Next pipeline will not be scheduled.'
    return
}

stage('Trigger next pipeline') {
    if (RUN_NEXT_JOB && NEXT_JOB?.trim()) {
        echo "Scheduling next pipeline: ${NEXT_JOB}"
        build job: NEXT_JOB,
              wait: false,
              propagate: false
    } else {
        echo 'Next pipeline disabled.'
    }
}

currentBuild.result = hadHardFailure ? 'UNSTABLE' : 'SUCCESS'
return
