package excel

import org.apache.poi.ss.usermodel.Cell
import org.apache.poi.ss.usermodel.Row
import org.apache.poi.ss.usermodel.Sheet
import org.apache.poi.ss.usermodel.Workbook
import org.apache.poi.ss.usermodel.WorkbookFactory

import com.katalon.keywords.excelHandling.ExcelValidations
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil

import internal.GlobalVariable


public class ExcelFile {

	def files = GlobalVariable.fileNameList as ArrayList
	String errors = ''
	String evPath = "${RunConfiguration.getReportFolder()}\\Evidences\\"
	ExcelValidations excelValidations = new ExcelValidations()
	String file1Rec = ''
	String file2Prod = ''

	void getFileUrl() {
		try {
			if (files.size() < 2) {
				throw new IllegalArgumentException('Not enough files provided in GlobalVariable.compareFiles')
			}

			file1Rec = "${evPath}${files[0]}"
			file2Prod = "${evPath}${files[1]}"

			if (!new File(file1Rec).exists()) {
				throw new FileNotFoundException("File not found: ${file1Rec}")
			}

			if (!new File(file2Prod).exists()) {
				throw new FileNotFoundException("File not found: ${file2Prod}")
			}
		} catch (FileNotFoundException fnfe) {
			KeywordUtil.markFailedAndStop(fnfe.message)
		} catch (IllegalArgumentException iae) {
			KeywordUtil.markFailedAndStop(iae.message)
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop('An unexpected error occurred: ' + e.message)
		}
	}

	List<Object> readFile(filePath){
		Workbook wbEnv
		FileInputStream fileInputStream
		try {
			fileInputStream = new FileInputStream(filePath)
			wbEnv = WorkbookFactory.create(fileInputStream)
			Sheet sheetEnv = wbEnv.getSheetAt(0)
			Row row = sheetEnv.getRow(0)

			return [
				sheetEnv,
				row,
				fileInputStream,
				wbEnv
			]
		} catch (FileNotFoundException fnfe) {
			KeywordUtil.markFailed("[ERROR] File not found: ${fnfe.message}")
			return [null, null, null]
		}finally {
			closeFile(wbEnv, fileInputStream)
		}
	}


	void closeFile(Workbook wbEnv,FileInputStream fileInputStream){
		try {
			if (wbEnv != null) {
				wbEnv.close()
			}
			if (fileInputStream != null) {
				fileInputStream.close()
			}
		} catch (IOException ioe) {
			KeywordUtil.markFailed("[ERROR] Failed to close files: ${ioe.message}")
		}
	}


	void compareFiles(int ccycolumn){
		getFileUrl()

		try {
			// Reading first Excel file
			List<Object> result1 = readFile(file1Rec)

			List<Object> result2 = readFile(file2Prod)

			Row row1 = result1.get(1)
			Row row2 = result2.get(1)

			Sheet sheetEnv1 = result1.get(0)
			Sheet sheetEnv2 = result2.get(0)

			compareTableDimensions(row1,row2,sheetEnv1,sheetEnv2)

			compareHeaders(row1,row2)

			checkSumMontantCCY(sheetEnv1,sheetEnv2,ccycolumn)

			closeFiles(result1, result2)
		} catch (FileNotFoundException fnfe) {
			KeywordUtil.markFailed("[ERROR] File not found: ${fnfe.message}")
		}
	}



	void compareTableDimensions(Row row1, Row row2,Sheet sheetEnv1,Sheet sheetEnv2){
		int numberOfRowsSheet1 = sheetEnv1.getPhysicalNumberOfRows()
		int numberOfRowsSheet2 = sheetEnv2.getPhysicalNumberOfRows()

		if (numberOfRowsSheet1 == numberOfRowsSheet2 && numberOfRowsSheet1 > 0) {
			KeywordUtil.logInfo("Files have the same number of rows: " + numberOfRowsSheet2)
		} else {
			KeywordUtil.markFailedAndStop("[ERROR] Files have different number of rows or the number of rows is zero. file 1: ${numberOfRowsSheet1} and file 2: ${numberOfRowsSheet2}")
		}

		row1.getPhysicalNumberOfCells() == row2.getPhysicalNumberOfCells() ? KeywordUtil.logInfo("Files have the same number of table headers: " +row2.getPhysicalNumberOfCells()) : KeywordUtil.markFailed("[ERROR] Files have different number of table headers")
	}


	void compareHeaders(Row row1, Row row2) {
		Integer numCellsRow1 = row1.getPhysicalNumberOfCells()
		Integer numCellsRow2 = row2.getPhysicalNumberOfCells()
		boolean headersFlag

		if (numCellsRow1 != numCellsRow2) {
			headersFlag = false
		} else {
			headersFlag = true

			for (Integer i = 0; i < numCellsRow1; i++) {
				Cell cell1 = row1.getCell(i)
				Cell cell2 = row2.getCell(i)

				KeywordUtil.logInfo("${cell1.toString()} ----> ${cell2.toString()}")

				if (cell1 == null || cell2 == null || !cell1.toString().equals(cell2.toString())) {
					headersFlag = false
					break
				}
			}
		}

		if (headersFlag) {
			KeywordUtil.logInfo("The headers in the two spreadsheets match as expected.")
		}
		else {
			KeywordUtil.markFailed("[ERROR] The headers in the two spreadsheets do not match.")
		}
	}

	//perguntar se é a pos 20 mesmo (mudar essa logica para procurar pelo nome da coluna, não pela posição)
	void checkSumMontantCCY(Sheet sheetEnv1,Sheet sheetEnv2,int ccycolumn){
		BigDecimal sum1 = excelValidations.totalSum(sheetEnv1, ccycolumn)

		BigDecimal sum2 = excelValidations.totalSum(sheetEnv2, ccycolumn)

		sum1.setScale(2, BigDecimal.ROUND_HALF_DOWN) != sum2.setScale(2, BigDecimal.ROUND_HALF_DOWN) ? KeywordUtil.markFailed("[ERROR] Files have different sum for column montant CCY") : KeywordUtil.logInfo("Rec and Prod file match sum for column montant CCY ${sum1}")
	}

	void closeFiles(List<Object> result1, List<Object> result2) {
		FileInputStream fileInputStream1 = result1.get(2)
		Workbook wbEnv1 = result1.get(3)
		closeFile(wbEnv1, fileInputStream1)

		FileInputStream fileInputStream2 = result2.get(2)
		Workbook wbEnv2 = result2.get(3)
		closeFile(wbEnv2, fileInputStream2)
	}
}






