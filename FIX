private void legacyOpenEnvironmentDropdown() {
	KeywordUtil.logInfo("Opening environment dropdown with legacy keyboard logic")

	focusLoginWindow()
	sleepMs(1000)

	Robot r = new Robot()
	r.setAutoDelay(100)

	r.keyPress(KeyEvent.VK_ALT)
	sleepMs(150)
	r.keyPress(KeyEvent.VK_DOWN)
	sleepMs(150)
	r.keyRelease(KeyEvent.VK_DOWN)
	sleepMs(150)
	r.keyRelease(KeyEvent.VK_ALT)

	sleepMs(1000)
}

private void legacySelectEnvironmentByKeyboard(int legacyIndex) {
	KeywordUtil.logInfo("Selecting environment with legacy keyboard fallback")

	focusLoginWindow()
	sleepMs(1000)

	Robot r = new Robot()
	r.setAutoDelay(100)

	r.keyPress(KeyEvent.VK_ALT)
	sleepMs(150)
	r.keyPress(KeyEvent.VK_DOWN)
	sleepMs(150)
	r.keyRelease(KeyEvent.VK_DOWN)
	sleepMs(150)
	r.keyRelease(KeyEvent.VK_ALT)
	sleepMs(500)

	r.keyPress(KeyEvent.VK_HOME)
	sleepMs(150)
	r.keyRelease(KeyEvent.VK_HOME)
	sleepMs(300)

	for (int i = 0; i < legacyIndex; i++) {
		r.keyPress(KeyEvent.VK_DOWN)
		sleepMs(150)
		r.keyRelease(KeyEvent.VK_DOWN)
		sleepMs(300)
	}

	r.keyPress(KeyEvent.VK_ENTER)
	sleepMs(150)
	r.keyRelease(KeyEvent.VK_ENTER)

	sleepMs(7000)
}
