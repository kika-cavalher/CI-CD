import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import java.awt.Robot
import java.awt.event.KeyEvent

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.driver.WindowsDriverFactory
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows
import com.kms.katalon.core.windows.keyword.helper.WindowsActionHelper

String menu = 'Comparatif inter';
Robot robot = new Robot();

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Start validation for Archive Mode menu: ' + menu)

Windows.waitForElementPresent(findWindowsObject('General/txtSearch'), 10);
CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Search field found, typing menu: ' + menu)
Windows.setText(findWindowsObject('General/txtSearch'), menu);
		
//Check file image based on input name
temp = new File(RunConfiguration.getProjectDir(), ('Images/Archive Mode/Comparatif inter-arrêtés.PNG')).getAbsolutePath();

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Image path resolved for menu: ' + menu)

//Clicking images
Windows.delay(1);
CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Clicking target menu: ' + menu)
WindowsImageKeywords.clickImage(temp);
CustomKeywords.'com.katalon.keywords.windows.WindowsImprovedKeywords.errorWindow'(menu);

try {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Waiting for tab to open: ' + menu)
	Windows.waitForElementPresent(findWindowsObject('Object Repository/Archive Mode/tabName'), 120);
	//if tab is found, take a screen shot then close it
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Tab opened successfully, capturing evidence')
	WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession()).takeScreenshot(RunConfiguration.getReportFolder()+ '\\Evidences\\' + menu + '.PNG')
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Closing tab: ' + menu)
	Windows.click(findWindowsObject('Archive Mode/btnFermer'))
	KeywordUtil.markPassed('[SUCCESS] Tab of menu ' + menu + ' was opened sucessfully.');
} catch (Exception e) {
	//otherwise, tabe was not found and there is an error
	Windows.delay(2)
	
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Tab was not opened, capturing error evidence')
	WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession()).takeScreenshot(RunConfiguration.getReportFolder()+ '\\Evidences\\' + '[ERROR] ' + menu + '.PNG')
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Handling error popup for menu: ' + menu)
	Windows.click(findWindowsObject('Object Repository/Justification des Comptes de Latent/confirmBtn'))
	KeywordUtil.markFailed('\n[ERROR] Tab of menu ' + menu + ' was not opened.');
}
