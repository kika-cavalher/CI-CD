@Keyword
void dragAndDropImage(
		String sourceImageKey,
		String targetImageKey,
		Integer timeoutSeconds
	) {

	Integer timeout = safeTimeout(timeoutSeconds, 5)
	Integer maxAttempts = 3

	String sourceImagePath =
			image(
			GUI_IMAGE_GROUP,
			sourceImageKey
			)

	String targetImagePath =
			image(
			GUI_IMAGE_GROUP,
			targetImageKey
			)

	Exception lastError = null

	logStep(
			'DRAG AND DROP',
			'Source: ' + sourceImageKey + '\n' +
			'Target: ' + targetImageKey + '\n' +
			'Recognition timeout: ' + timeout + ' seconds\n' +
			'Maximum attempts: ' + maxAttempts
			)

	for (Integer attempt = 1; attempt <= maxAttempts; attempt++) {

		KeywordUtil.logInfo(
				'[INFO] Drag and drop attempt ' +
				attempt +
				' of ' +
				maxAttempts +
				'.'
				)

		boolean sourceVisible = false
		boolean targetVisible = false

		try {
			sourceVisible =
					imageLoader.waitForImage(
					GUI_IMAGE_GROUP,
					sourceImageKey,
					timeout
					)
		} catch (Exception e) {
			KeywordUtil.logInfo(
					'[INFO] Source image validation failed.\n' +
					'Image: ' + sourceImageKey + '\n' +
					'Reason: ' + safeMessage(e)
					)
		}

		try {
			targetVisible =
					imageLoader.waitForImage(
					GUI_IMAGE_GROUP,
					targetImageKey,
					timeout
					)
		} catch (Exception e) {
			KeywordUtil.logInfo(
					'[INFO] Target image validation failed.\n' +
					'Image: ' + targetImageKey + '\n' +
					'Reason: ' + safeMessage(e)
					)
		}

		KeywordUtil.logInfo(
				'[INFO] Image recognition result.\n' +
				'Source: ' + sourceImageKey +
				' | Visible: ' + sourceVisible + '\n' +
				'Target: ' + targetImageKey +
				' | Visible: ' + targetVisible
				)

		if (!sourceVisible || !targetVisible) {
			if (attempt < maxAttempts) {
				Windows.delay(1)
				continue
			}

			takeEvidence(
					'GUI_DragAndDropImagesNotFound_' +
					sourceImageKey +
					'.png'
					)

			KeywordUtil.markFailedAndStop(
					'Drag and drop images were not found.\n' +
					'Source: ' + sourceImageKey + '\n' +
					'Source visible: ' + sourceVisible + '\n' +
					'Target: ' + targetImageKey + '\n' +
					'Target visible: ' + targetVisible + '\n' +
					'Attempts: ' + maxAttempts
					)

			return
		}

		try {
			WindowsImageKeywords.dragAndDrop(
					sourceImagePath,
					targetImagePath
					)

			Windows.delay(2)

			KeywordUtil.logInfo(
					'[PASS] Drag and drop completed.\n' +
					'Source: ' + sourceImageKey + '\n' +
					'Target: ' + targetImageKey + '\n' +
					'Attempt: ' + attempt
					)

			return
		} catch (Exception e) {
			lastError = e

			KeywordUtil.logInfo(
					'[INFO] Drag and drop attempt failed.\n' +
					'Attempt: ' + attempt + '/' + maxAttempts + '\n' +
					'Source: ' + sourceImageKey + '\n' +
					'Target: ' + targetImageKey + '\n' +
					'Reason: ' + safeMessage(e)
					)

			if (attempt < maxAttempts) {
				Windows.delay(1)
			}
		}
	}

	takeEvidence(
			'GUI_DragAndDropFailed_' +
			sourceImageKey +
			'.png'
			)

	KeywordUtil.markFailedAndStop(
			'Drag and drop failed after maximum attempts.\n' +
			'Source: ' + sourceImageKey + '\n' +
			'Target: ' + targetImageKey + '\n' +
			'Attempts: ' + maxAttempts + '\n' +
			'Reason: ' + safeMessage(lastError)
			)
}
