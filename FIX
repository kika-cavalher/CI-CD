	// ======================================================
	// OPEN FAVORITE
	// ======================================================

	@Keyword
	void closeAllTabsAndOpenFavorite(
			String favoriteTitle,
			String openedTabName,
			String favoriteImageKey,
			Integer timeoutSeconds
	) {

		Integer favoriteSearchTimeout = safeTimeout(timeoutSeconds, 10)

		Integer maxOpenAttempts = 30
		Integer waitPerOpenAttemptSeconds = 100000

		WindowsTestObject openedTab =
				WindowsObjectLoader.getTabByName(
				openedTabName
				)

		logStep(
				'OPEN FAVORITE',
				'Favorite: ' + favoriteTitle + '\n' +
				'Expected tab: ' + openedTabName + '\n' +
				'Favorite search timeout: ' +
				favoriteSearchTimeout + ' seconds\n' +
				'Tab opening attempts: ' +
				maxOpenAttempts + '\n' +
				'Wait per attempt: ' +
				waitPerOpenAttemptSeconds + ' seconds'
				)


		// ======================================================
		// CLOSE FAVORITE CREATION MODAL
		// ======================================================

		KeywordUtil.logInfo(
				'[MODAL] Waiting before closing the favorite creation modal.'
				)

		Windows.delay(5)

		boolean favoriteModalClosed =
				clickFirstVisibleImage(
				GENERAL_IMAGE_GROUP,
				[
					'okModal',
					'okModal2Version'
				],
				2
				)

		if (!favoriteModalClosed) {
			KeywordUtil.logInfo(
					'[MODAL] OK image was not found. Pressing ENTER.'
					)

			pressKeyboardKey(
					KeyEvent.VK_ENTER
					)
		}

		Windows.delay(2)


		// ======================================================
		// CLOSE ALL OPENED TABS
		// ======================================================

		for (
		Integer closeAttempt = 1;
				closeAttempt <= 3;
				closeAttempt++
				) {

			boolean tabStillPresent =
					Windows.waitForElementPresent(
					openedTab,
					1,
					FailureHandling.OPTIONAL
					)

			if (!tabStillPresent) {
				KeywordUtil.logInfo(
						'[CLOSE TABS] Target tab is no longer visible.'
						)

				break
			}

			KeywordUtil.logInfo(
					'[CLOSE TABS] Attempt ' +
					closeAttempt +
					' of 3.'
					)

			WindowsTestObject closeAllTabsButton =
					object(
					'closeAllTabsTopBar'
					)

			if (!Windows.waitForElementPresent(
					closeAllTabsButton,
					5,
					FailureHandling.OPTIONAL
					)) {
				takeEvidence(
						'GUI_CloseAllTabsButtonNotFound.png'
						)

				KeywordUtil.markFailedAndStop(
						'Close All Tabs button was not found.'
						)

				return
			}

			Windows.click(
					closeAllTabsButton,
					FailureHandling.STOP_ON_FAILURE
					)

			Windows.delay(2)

			boolean closeConfirmed =
					clickFirstVisibleImage(
					GENERAL_IMAGE_GROUP,
					[
						'yes',
						'yesUnderline',
						'yesButton',
						'oui'
					],
					3
					)

			if (!closeConfirmed) {
				KeywordUtil.logInfo(
						'[CLOSE TABS] Oui image was not found. Pressing ENTER.'
						)

				pressKeyboardKey(
						KeyEvent.VK_ENTER
						)
			}

			Windows.delay(5)
		}

		boolean targetTabStillPresent =
				Windows.waitForElementPresent(
				openedTab,
				2,
				FailureHandling.OPTIONAL
				)

		if (targetTabStillPresent) {
			takeEvidence(
					'GUI_TabsNotClosed.png'
					)

			KeywordUtil.markFailedAndStop(
					'Opened tab is still visible after 3 close attempts.\n' +
					'Tab: ' + openedTabName
					)

			return
		}


		// ======================================================
		// OPEN FAVORITES TAB
		// ======================================================

		WindowsTestObject favoritesTab =
				object(
				'favoritesTab'
				)

		if (!Windows.waitForElementPresent(
				favoritesTab,
				5,
				FailureHandling.OPTIONAL
				)) {
			takeEvidence(
					'GUI_FavoritesTabNotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					'Favorites tab was not found.'
					)

			return
		}

		KeywordUtil.logInfo(
				'[OBJECT] Clicking Favorites tab.'
				)

		Windows.click(
				favoritesTab,
				FailureHandling.STOP_ON_FAILURE
				)

		Windows.delay(3)


		// ======================================================
		// FIND AND CLICK CREATED FAVORITE
		// ======================================================

		WindowsTestObject favoriteItem =
				WindowsObjectLoader.getTreeItemByName(
				favoriteTitle
				)

		KeywordUtil.logInfo(
				'[OBJECT] Waiting for created favorite.\n' +
				'Favorite: ' + favoriteTitle + '\n' +
				'Timeout: ' +
				favoriteSearchTimeout +
				' seconds'
				)

		boolean favoriteFound = Windows.waitForElementPresent(
				favoriteItem,
				favoriteSearchTimeout,
				FailureHandling.OPTIONAL
				)

		if (favoriteFound) {
			KeywordUtil.logInfo(
					'[OBJECT] Created favorite found. Clicking by element.'
					)

			Windows.click(
					favoriteItem,
					FailureHandling.STOP_ON_FAILURE
					)
		} else {
			boolean clickedByImage = false

			if (!safeText(favoriteImageKey).isEmpty()) {
				KeywordUtil.logInfo(
						'[IMAGE] Favorite element was not found. Trying image fallback.\n' +
						'Image key: ' + favoriteImageKey
						)

				clickedByImage =
						clickFirstVisibleImage(
						GUI_IMAGE_GROUP,
						[
							favoriteImageKey
						],
						5
						)
			}

			if (!clickedByImage) {
				takeEvidence(
						'GUI_CreatedFavoriteNotFound.png'
						)

				KeywordUtil.markFailedAndStop(
						'Created favorite was not found by element or image.\n' +
						'Favorite: ' + favoriteTitle + '\n' +
						'Image key: ' + favoriteImageKey
						)

				return
			}
		}


		// ======================================================
		// WAIT FOR FAVORITE TAB
		// 5 ATTEMPTS OF 60 SECONDS
		// ======================================================

		boolean favoriteOpened = false

		for (
		Integer openAttempt = 1;
				openAttempt <= maxOpenAttempts;
				openAttempt++
				) {

			KeywordUtil.logInfo(
					'[OPEN FAVORITE] Waiting for expected tab.\n' +
					'Favorite: ' + favoriteTitle + '\n' +
					'Expected tab: ' + openedTabName + '\n' +
					'Attempt: ' +
					openAttempt +
					'/' +
					maxOpenAttempts + '\n' +
					'Wait time: ' +
					waitPerOpenAttemptSeconds +
					' seconds'
					)

			try {
				favoriteOpened =
						Windows.waitForElementPresent(
						openedTab,
						waitPerOpenAttemptSeconds,
						FailureHandling.OPTIONAL
						)
			} catch (Exception e) {
				favoriteOpened = false

				KeywordUtil.logInfo(
						'[OPEN FAVORITE] Tab validation failed during attempt ' +
						openAttempt +
						'.\n' +
						'Reason: ' +
						safeMessage(e)
						)
			}

			if (favoriteOpened) {
				KeywordUtil.logInfo(
						'[PASS] Favorite tab opened successfully.\n' +
						'Attempt: ' +
						openAttempt +
						'/' +
						maxOpenAttempts + '\n' +
						'Tab: ' +
						openedTabName
						)

				break
			}

			if (openAttempt < maxOpenAttempts) {
				KeywordUtil.logInfo(
						'[OPEN FAVORITE] Expected tab has not opened yet.\n' +
						'Starting another 60-second wait.'
						)
			}
		}

		if (!favoriteOpened) {
			takeEvidence(
					'GUI_CreatedFavoriteTabNotOpened.png'
					)

			KeywordUtil.markFailedAndStop(
					'Favorite was selected, but the expected tab was not opened.\n' +
					'Favorite: ' + favoriteTitle + '\n' +
					'Expected tab: ' + openedTabName + '\n' +
					'Attempts: ' + maxOpenAttempts + '\n' +
					'Wait per attempt: ' +
					waitPerOpenAttemptSeconds +
					' seconds\n' +
					'Maximum total wait: 300 seconds'
					)

			return
		}

		Windows.delay(3)

		takeEvidence(
				'GUI_CreatedFavoriteOpened.png'
				)

		KeywordUtil.markPassed(
				'Created favorite was opened successfully.\n' +
				'Favorite: ' + favoriteTitle + '\n' +
				'Tab: ' + openedTabName
				)
	}

	// ======================================================
