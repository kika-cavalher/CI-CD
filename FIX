package com.katalon.keywords.CSVHandling

import com.kms.katalon.core.annotation.Keyword


public class CSVValidations {

	@Keyword
	def String firstValue(String file,Integer index,Integer lineToRead) {
		//Read first index from CSV
		def idx = 0 //lines to read
		def first
		def results = new File(file).splitEachLine(';', { def fields ->
			//iteration in all lines (with the index of fields you pick the collumn)
			if (idx == lineToRead) {
				first= fields[index].toString()
			}
			idx++
		}
		)
		return first
	}

	@Keyword
	def String compareCurrency(ArrayList<String> file, Integer index, String evPath) {
		// Validations
		if (file == null || file.size() < 2) {
			return "Insufficient files provided for currency comparison."
		}

		String base1 = file.get(file.size() - 2)
		String base2 = file.get(file.size() - 1)

		String path1 = evPath + (base1.endsWith(".csv") ? base1 : base1 + ".csv")
		String path2 = evPath + (base2.endsWith(".csv") ? base2 : base2 + ".csv")

		File f1 = new File(path1)
		File f2 = new File(path2)
		if (!f1.exists()) {
			return "CSV not found: ${path1}"
		}
		if (!f2.exists()) {
			return "CSV not found: ${path2}"
		}

		List<String> vals1 = []
		List<String> vals2 = []

		int row = 0
		f1.eachLine { line ->
			def fields = line.split(';') as List<String>
			if (row > 0 && fields.size() > index) {
				vals1 << fields[index]
			}
			row++
		}

		row = 0
		f2.eachLine { line ->
			def fields = line.split(';') as List<String>
			if (row > 0 && fields.size() > index) {
				vals2 << fields[index]
			}
			row++
		}

		StringBuilder errors = new StringBuilder()
		vals2.each { v ->
			if (!vals1.contains(v)) {
				errors << "\nMissing currency in details: ${v}"
			}
		}

		return errors.toString()
	}
}




