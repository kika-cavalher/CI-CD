	String getSuiteTestPlanFilePath() {
		File folder = new File(TEST_PLAN_KEYS_FOLDER)

		if (!folder.exists()) {
			folder.mkdirs()
		}

		return folder.absolutePath + '\\' + getSanitizedSuiteName() + '.txt'
	}

	String getSavedTestPlanKey() {
		File file = new File(getSuiteTestPlanFilePath())

		if (!file.exists()) {
			return ''
		}

		String key = file.text?.trim()

		if (isBlank(key)) {
			return ''
		}

		KeywordUtil.logInfo("Saved Test Plan key found: ${key}")
		return key
	}

	void saveTestPlanKey(String testPlanKey) {
		if (isBlank(testPlanKey)) {
			return
		}

		File file = new File(getSuiteTestPlanFilePath())
		file.write(testPlanKey.trim(), 'UTF-8')

		KeywordUtil.logInfo("Saved Test Plan key for suite '${getCurrentSuiteName()}': ${testPlanKey}")
	}

	@Keyword
	def resetTestPlanKey() {
		File file = new File(getSuiteTestPlanFilePath())

		if (!file.exists()) {
			KeywordUtil.logInfo("No saved Test Plan key file found for this suite.")
			return
		}

		file.write('', 'UTF-8')
		KeywordUtil.logInfo("Saved Test Plan key cleared for suite '${getCurrentSuiteName()}'.")
	}

