package jenkinsIntegration

class eMatchTaskSchedulerRunner {

  static Map DEFAULT = [
    STARTER_DIR    : 'D:\\Projects\\eMatchStarters',
    CTX_FILE       : 'D:\\Projects\\eMatchStarters\\run-context.properties',
    LOG_DIR        : 'D:\\Projects\\eMatchStarters\\logs',
    KATALON_EXE    : 'C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0\\katalonc.exe',
    PROJECT_FILE   : 'eMatch POC.prj',
    EXEC_PROFILE   : 'default',
    BROWSER_TYPE   : 'Windows',
    START_WINAPPDRIVER : 'true',

    TASKS: [
      ArchiveMode     : '\\eMatch Automation\\RunArchiveMode',
      PasserelleBilan : '\\eMatch Automation\\RunPasserelleBilan'
    ]
  ]

  static Map COLLECTIONS = [
    ArchiveMode     : 'Test Suites/Archive Mode/Archive Mode Collection',
    PasserelleBilan : 'Test Suites/PasserelleBilan/Passerelle Bilan Collection'
  ]

  static void run(def steps, String suiteKey, Map overrides = [:]) {

    Map cfg = [:]
    cfg.putAll(DEFAULT)
    cfg.putAll(overrides)

    if (!cfg.TASKS.containsKey(suiteKey)) {
      steps.error("[eMatch] Unknown suiteKey: ${suiteKey}. Known: ${cfg.TASKS.keySet()}")
    }

    String taskName = cfg.TASKS[suiteKey]
    String collectionPath = COLLECTIONS[suiteKey]

    String projectPath = "${steps.env.WORKSPACE}\\${cfg.PROJECT_FILE}"
    String markerFile  = "${cfg.LOG_DIR}\\__jenkins_task_exitcode_${steps.env.JOB_NAME}_${steps.env.BUILD_NUMBER}_${suiteKey}.txt"

    steps.bat """
      if not exist "${cfg.LOG_DIR}" mkdir "${cfg.LOG_DIR}"
      if exist "${markerFile}" del /f /q "${markerFile}" 1>nul 2>nul
    """

    String ctx = [
      "WORKSPACE=${steps.env.WORKSPACE}",
      "PROJECT_PATH=${projectPath}",
      "KATALON_EXE=${cfg.KATALON_EXE}",
      "EXECUTION_PROFILE=${cfg.EXEC_PROFILE}",
      "BROWSER_TYPE=${cfg.BROWSER_TYPE}",
      "LOG_DIR=${cfg.LOG_DIR}",
      "START_WINAPPDRIVER=${cfg.START_WINAPPDRIVER}",
      "MARKER_FILE=${markerFile}"
    ].join("\r\n") + "\r\n"

    steps.writeFile file: cfg.CTX_FILE, text: ctx

    steps.echo "[eMatch] Triggering Task Scheduler: ${taskName}"
    steps.bat """schtasks /run /tn "${taskName}" """

    steps.timeout(time: 3, unit: 'HOURS') {
      steps.waitUntil {
        steps.sleep(time: 3, unit: 'SECONDS')
        return steps.fileExists(markerFile)
      }
    }

    String markerText = steps.readFile(markerFile).trim()
    steps.echo "[eMatch] Marker content:\n${markerText}"

    Map marker = [:]
    markerText.split("\\r?\\n").each { line ->
      def p = line.indexOf('=')
      if (p > 0) {
        marker[line.substring(0, p).trim()] = line.substring(p + 1).trim()
      }
    }

    int exitCode = (marker.exitcode ?: '2') as Integer
    String logFile = marker.logfile ?: ''

    if (logFile) {
      steps.echo "[eMatch] Katalon log: ${logFile}"
      steps.archiveArtifacts artifacts: logFile.replace('\\','/'), allowEmptyArchive: true
    }

    if (exitCode != 0) {
      steps.error("[eMatch] Suite ${suiteKey} failed. exitcode=${exitCode}")
    }

    steps.echo "[eMatch] Suite ${suiteKey} OK ✅"
  }
}
