	@Keyword
	void activateHomeTab() {
		String home = new File(RunConfiguration.getProjectDir(), 'Images/General/Home.PNG').getAbsolutePath()
		String homeGrey = new File(RunConfiguration.getProjectDir(), 'Images/General/HomeGrey.PNG').getAbsolutePath()
		String homeWhite = new File(RunConfiguration.getProjectDir(), 'Images/General/HomeWhite.PNG').getAbsolutePath()

		try {
			if (new File(home).exists()) {
				WindowsImageKeywords.clickImage(home)
				Windows.delay(AFTER_HOME_CLICK_DELAY_SEC)
				return
			}
		}
		catch (Exception ignored) {
		}

		try {
			if (new File(homeGrey).exists()) {
				def activeTab = WindowsImageKeywords.findImage(homeGrey)
				if (activeTab != null) {
					return
				}
			}
		}
		catch (Exception ignored) {
		}

		try {
			if (new File(homeWhite).exists()) {
				def inactiveTab = WindowsImageKeywords.findImage(homeWhite)
				if (inactiveTab != null) {
					Windows.click(inactiveTab)
					Windows.delay(AFTER_HOME_CLICK_DELAY_SEC)
					return
				}
			}
		}
		catch (Exception ignored) {
		}
	}

	private boolean sameUserAsExecution(String currentUser) {
		String expectedUser = safe(resolveGlobalValue([
			'username',
			'USERNAME'
		]))

		if (blank(expectedUser)) {
			return true
		}

		return safe(currentUser).equalsIgnoreCase(expectedUser)
	}

	private boolean isWinAppDriverRunning() {
		try {
			Process process = new ProcessBuilder(
					'cmd',
					'/c',
					'tasklist /FI "IMAGENAME eq WinAppDriver.exe"'
					).start()

			String output = process.inputStream.getText('Cp1252')
			String error = process.errorStream.getText('Cp1252')

			String combined = safe(output + ' ' + error)
			return combined.toLowerCase(Locale.ENGLISH).contains('winappdriver.exe')
		}
		catch (Exception e) {
			return false
		}
	}

	private String resolveShortcutPath() {
		String explicit = firstNonBlank(
				resolveGlobalValue(['eMatchShortcutPath', 'EMATCH_SHORTCUT_PATH']),
				System.getenv('EMATCH_SHORTCUT_PATH')
				)

		if (!blank(explicit)) {
			return explicit
		}

		return DEFAULT_EMATCH_LNK_PATH
	}

	private String resolveApplicationPath() {
		String explicit = firstNonBlank(
				resolveGlobalValue(['eMatchApplicationPath', 'EMATCH_APPLICATION_PATH']),
				System.getenv('EMATCH_APPLICATION_PATH')
				)

		if (!blank(explicit)) {
			return explicit
		}

		return DEFAULT_EMATCH_APPLICATION_PATH
	}

	private String resolveResolutionScriptPath() {
		String explicit = firstNonBlank(
				resolveGlobalValue(['resolutionScriptPath', 'RESOLUTION_SCRIPT_PATH']),
				System.getenv('RESOLUTION_SCRIPT_PATH')
				)

		if (!blank(explicit)) {
			return explicit
		}

		return DEFAULT_RESOLUTION_SCRIPT_PATH
	}

	private String resolveWinAppDriverExePath() {
		String explicit = firstNonBlank(
				resolveGlobalValue([
					'winAppDriverExePath',
					'WinAppDriverExePath',
					'WINAPPDRIVER_EXE',
					'winAppDriverPath'
				]),
				System.getenv('WINAPPDRIVER_EXE'),
				System.getenv('WINAPPDRIVER_PATH')
				)

		if (!blank(explicit) && new File(explicit).exists()) {
			return explicit
		}

		for (String path : WINAPPDRIVER_EXE_CANDIDATES) {
			if (new File(path).exists()) {
				return path
			}
		}

		return explicit
	}

	private String resolveBundledWinAppDriverMsiPath() {
		List<String> katalonExeCandidates = [
			firstNonBlank(
					resolveGlobalValue(['katalonExe', 'KATALON_EXE']),
					System.getenv('KATALON_EXE')
					),
			firstNonBlank(
					resolveGlobalValue(['katalonExePath', 'KATALON_EXE_PATH']),
					System.getenv('KATALON_EXE_PATH')
					)
		].findAll { !blank(it) }

		for (String katalonExe : katalonExeCandidates) {
			try {
				File exe = new File(katalonExe)
				if (exe.exists()) {
					File msi = new File(exe.parentFile, 'configuration\\resources\\extensions\\WinAppDriver\\WindowsApplicationDriver.msi')
					if (msi.exists()) {
						return msi.absolutePath
					}
				}
			}
			catch (Exception ignored) {
			}
		}

		List<String> commonMsiCandidates = [
			'C:\\Katalon_Studio_Engine_Windows_64-8.1.0\\configuration\\resources\\extensions\\WinAppDriver\\WindowsApplicationDriver.msi',
			'C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0\\configuration\\resources\\extensions\\WinAppDriver\\WindowsApplicationDriver.msi'
		]

		for (String path : commonMsiCandidates) {
			if (new File(path).exists()) {
				return path
			}
		}

		return ''
	}

	private Object resolveGlobalValue(List<String> names) {
		for (String name : names) {
			try {
				def value = GlobalVariable."${name}"
				if (!blank(safe(value))) {
					return value
				}
			}
			catch (Exception ignored) {
			}
		}

		return null
	}

	private String firstNonBlank(Object... values) {
		if (values == null) {
			return ''
		}

		for (Object value : values) {
			String text = safe(value)
			if (!text.isEmpty()) {
				return text
			}
		}

		return ''
	}

	private boolean blank(String value) {
		return safe(value).isEmpty()
	}

	private String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}
