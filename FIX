import java.io.File

import com.kms.katalon.core.util.KeywordUtil


// ======================================================
// COMPARISON CONFIG
// ======================================================

String recEnvironment = 'REC'
String prdEnvironment = 'PRD'

String exportLabel = 'ExclusionBooks'

Integer expectedColumnIndex = 14

String scenarioName =
	'REC x PRD - Caps Floors Grecques - Validate Row Sum Min Max'


// ======================================================
// RESOLVE REC EXPORT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Resolve REC Caps Floors Grecques export\n' +
	'Environment: ' +
	recEnvironment +
	'\nExport label: ' +
	exportLabel
)

Map recExportValidation =
	CustomKeywords.
	'commands.ExportFileValidationKeywords.validateExportedFileExistsAndHasRows'(
		recEnvironment,
		exportLabel
	)

String recExportPath =
	new File(
		recExportValidation.folderPath.toString(),
		recExportValidation.fileName.toString()
	).absolutePath

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'REC Caps Floors Grecques export resolved successfully\n' +
	'File: ' +
	recExportValidation.fileName +
	'\nPath: ' +
	recExportPath +
	'\nData rows: ' +
	recExportValidation.dataRows +
	'\nFile size: ' +
	recExportValidation.fileSize +
	' bytes'
)


// ======================================================
// RESOLVE PRD EXPORT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Resolve PRD Caps Floors Grecques export\n' +
	'Environment: ' +
	prdEnvironment +
	'\nExport label: ' +
	exportLabel
)

Map prdExportValidation =
	CustomKeywords.
	'commands.ExportFileValidationKeywords.validateExportedFileExistsAndHasRows'(
		prdEnvironment,
		exportLabel
	)

String prdExportPath =
	new File(
		prdExportValidation.folderPath.toString(),
		prdExportValidation.fileName.toString()
	).absolutePath

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'PRD Caps Floors Grecques export resolved successfully\n' +
	'File: ' +
	prdExportValidation.fileName +
	'\nPath: ' +
	prdExportPath +
	'\nData rows: ' +
	prdExportValidation.dataRows +
	'\nFile size: ' +
	prdExportValidation.fileSize +
	' bytes'
)


// ======================================================
// COMPARE REC AND PRD EXPORTS
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Compare Caps Floors Grecques REC and PRD exports\n' +
	'REC file: ' +
	recExportValidation.fileName +
	'\nPRD file: ' +
	prdExportValidation.fileName +
	'\nZero-based column index: ' +
	expectedColumnIndex +
	'\nValidations:\n' +
	'- Number of data rows\n' +
	'- Column sum\n' +
	'- Minimum value\n' +
	'- Maximum value'
)

Map comparison =
	CustomKeywords.
	'commands.RecPrdExportValidationKeywords.validateRecPrdExportRowSumMinMax'(
		recExportPath,
		prdExportPath,
		expectedColumnIndex
	)

boolean success =
	comparison != null &&
	comparison.success == true

String errors =
	comparison == null
		? '[ERROR] Validation keyword returned no result.'
		: safeText(
			comparison.errors
			)

String passedDetails =
	comparison == null
		? ''
		: safeText(
			comparison.passedDetails
			)


// ======================================================
// REPORT COMPARISON RESULT
// ======================================================

if (comparison != null) {

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		(success ? '[PASS] ' : '[FAIL] ') +
		'Caps Floors Grecques REC x PRD comparison result\n' +
		'REC file: ' +
		comparison.recFileName +
		'\nPRD file: ' +
		comparison.prdFileName +
		'\nColumn index: ' +
		comparison.columnIndex +
		'\nREC column: ' +
		comparison.recColumnName +
		'\nPRD column: ' +
		comparison.prdColumnName +
		'\nREC rows: ' +
		comparison.recRows +
		'\nPRD rows: ' +
		comparison.prdRows +
		'\nREC numeric values: ' +
		comparison.recNumericValues +
		'\nPRD numeric values: ' +
		comparison.prdNumericValues +
		'\nREC sum: ' +
		comparison.recSum +
		'\nPRD sum: ' +
		comparison.prdSum +
		'\nREC minimum: ' +
		comparison.recMinimum +
		'\nPRD minimum: ' +
		comparison.prdMinimum +
		'\nREC maximum: ' +
		comparison.recMaximum +
		'\nPRD maximum: ' +
		comparison.prdMaximum +
		'\nREC read mode: ' +
		comparison.recReadMode +
		'\nPRD read mode: ' +
		comparison.prdReadMode
	)
}


// ======================================================
// FINAL RESULT
// ======================================================

if (!success) {

	String finalErrorMessage =
		errors.isEmpty()
			? 'REC x PRD validation returned an unsuccessful result.'
			: errors

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[FAIL] Final Caps Floors Grecques validation result\n' +
		finalErrorMessage +
		(
			passedDetails.isEmpty()
				? ''
				: '\n\nSuccessful validations\n' +
					passedDetails
		)
	)

	KeywordUtil.markFailed(
		scenarioName +
		' failed.\n' +
		finalErrorMessage
	)

} else {

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[PASS] Final Caps Floors Grecques validation result\n' +
		'REC x PRD validation completed successfully.\n' +
		passedDetails
	)

	KeywordUtil.markPassed(
		scenarioName +
		' completed successfully.'
	)
}


// ======================================================
// HELPERS
// ======================================================

String safeText(Object value) {

	if (value == null) {
		return ''
	}

	return value
		.toString()
		.trim()
}

































