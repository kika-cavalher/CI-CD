@echo off
setlocal EnableExtensions EnableDelayedExpansion

REM ==========================================================
REM eMatch Desktop Runner
REM Reads run-context.properties and runs Katalon collection
REM Writes marker: %WORKSPACE%\Reports\__jenkins_task_exitcode.txt
REM ==========================================================

set "BASE_DIR=D:\Projects\eMatchStarters"
set "CTX_FILE=%BASE_DIR%\run-context.properties"

if not exist "%CTX_FILE%" (
  echo ERROR: Context file not found: %CTX_FILE%
  exit /b 2
)

REM Load KEY=VALUE from run-context.properties
for /f "usebackq tokens=1,* delims==" %%A in ("%CTX_FILE%") do (
  set "K=%%A"
  set "V=%%B"
  if not "!K!"=="" (
    set "!K!=!V!"
  )
)

REM Required vars
if "%WORKSPACE%"=="" (
  echo ERROR: WORKSPACE is empty in run-context.properties
  exit /b 2
)
if "%KATALON_EXE%"=="" (
  echo ERROR: KATALON_EXE is empty in run-context.properties
  exit /b 2
)
if "%PROJECT_FILE%"=="" (
  echo ERROR: PROJECT_FILE is empty in run-context.properties
  exit /b 2
)
if "%COLLECTION_PATH%"=="" (
  echo ERROR: COLLECTION_PATH is empty in run-context.properties
  exit /b 2
)

REM Defaults
if "%BROWSER_TYPE%"=="" set "BROWSER_TYPE=Windows"
if "%RETRY%"=="" set "RETRY=0"

set "REPORT_ROOT=%WORKSPACE%\Reports"
set "MARKER=%REPORT_ROOT%\__jenkins_task_exitcode.txt"

if not exist "%REPORT_ROOT%" mkdir "%REPORT_ROOT%" >nul 2>&1
if exist "%MARKER%" del /f /q "%MARKER%" >nul 2>&1

echo ==========================================================
echo WORKSPACE        = %WORKSPACE%
echo PROJECT_FILE     = %PROJECT_FILE%
echo KATALON_EXE      = %KATALON_EXE%
echo COLLECTION_PATH  = %COLLECTION_PATH%
echo REPORT_ROOT      = %REPORT_ROOT%
echo ==========================================================

pushd "%WORKSPACE%"

"%KATALON_EXE%" ^
  -noSplash ^
  -runMode=console ^
  -projectPath="%WORKSPACE%\%PROJECT_FILE%" ^
  -retry=%RETRY% ^
  -testSuiteCollectionPath="%COLLECTION_PATH%" ^
  -browserType="%BROWSER_TYPE%" ^
  -reportFolder="Reports" ^
  -reportFileName="report"

set "EC=%ERRORLEVEL%"

popd

echo %EC% > "%MARKER%"

echo.
echo KATALON FINISHED. EXITCODE=%EC%
echo Marker file: %MARKER%
echo.

exit /b %EC%
