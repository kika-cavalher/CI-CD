	private Boolean openRechercheTabWithRetry(
			Integer timeoutSeconds,
			Integer maximumAttempts
	) {

		for (Integer attempt = 1;
			attempt <= maximumAttempts;
			attempt++) {

			KeywordUtil.logInfo(
					'[RECHERCHE TAB] Attempt ' +
					attempt +
					' of ' +
					maximumAttempts
					)

			focusEmatchApplication()

			WindowsTestObject rechercheTabObject = null

			try {
				rechercheTabObject =
						WindowsObjectLoader.getObject(
						'filter',
						'rechercheTab'
						)
			} catch (Throwable exception) {
				KeywordUtil.logInfo(
						'[RECHERCHE TAB] Dictionary object could not be loaded.\n' +
						'Reason: ' +
						safeMessage(
						exception
						)
						)
			}

			if (rechercheTabObject != null) {
				try {
					if (Windows.waitForElementPresent(
							rechercheTabObject,
							timeoutSeconds,
							FailureHandling.OPTIONAL
							)) {

						Windows.click(
								rechercheTabObject,
								FailureHandling.OPTIONAL
								)

						Windows.delay(1)

						KeywordUtil.logInfo(
								'[PASS] Recherche tab opened by Windows object.'
								)

						return true
					}
				} catch (Throwable exception) {
					KeywordUtil.logInfo(
							'[RECHERCHE TAB] Object lookup or click failed.\n' +
							'Reason: ' +
							safeMessage(
							exception
							)
							)
				}
			}

			try {
				if (imageLoader.waitForImage(
						IMAGE_GROUP,
						RECHERCHE_IMAGE_KEY,
						timeoutSeconds
						)) {

					WindowsImageKeywords.clickImage(
							imageLoader.getImage(
							IMAGE_GROUP,
							RECHERCHE_IMAGE_KEY
							)
							)

					Windows.delay(1)

					KeywordUtil.logInfo(
							'[PASS] Recherche tab opened by image.'
							)

					return true
				}
			} catch (Throwable exception) {
				KeywordUtil.logInfo(
						'[RECHERCHE TAB] Image lookup or click failed.\n' +
						'Reason: ' +
						safeMessage(
						exception
						)
						)
			}

			delayBeforeNextAttempt(
					attempt,
					maximumAttempts
					)
		}

		return false
	}


	private Boolean fillAsOfDateWithRetry(
			String asOfDateValue,
			Integer timeoutSeconds,
			Integer maximumAttempts
	) {

		for (Integer attempt = 1;
			attempt <= maximumAttempts;
			attempt++) {

			KeywordUtil.logInfo(
					'[AS OF DATE] Attempt ' +
					attempt +
					' of ' +
					maximumAttempts
					)

			WindowsTestObject asOfDateField = null

			try {
				asOfDateField =
						findWindowsObject(
						'Object Repository/PNL Comptable/asOfDateFilterPNLEco'
						)
			} catch (Throwable exception) {
				KeywordUtil.logInfo(
						'[AS OF DATE] Repository object could not be loaded.\n' +
						'Reason: ' +
						safeMessage(
						exception
						)
						)
			}

			if (asOfDateField != null) {
				try {
					if (Windows.waitForElementPresent(
							asOfDateField,
							timeoutSeconds,
							FailureHandling.OPTIONAL
							)) {

						Windows.click(
								asOfDateField,
								FailureHandling.OPTIONAL
								)

						Windows.setText(
								asOfDateField,
								asOfDateValue,
								FailureHandling.OPTIONAL
								)

						KeywordUtil.logInfo(
								'[PASS] As Of Date filled by Windows object.'
								)

						return true
					}
				} catch (Throwable exception) {
					KeywordUtil.logInfo(
							'[AS OF DATE] Object lookup or input failed.\n' +
							'Reason: ' +
							safeMessage(
							exception
							)
							)
				}
			}

			try {
				if (imageLoader.waitForImage(
						IMAGE_GROUP,
						AS_OF_DATE_IMAGE_KEY,
						timeoutSeconds
						)) {

					WindowsImageKeywords.clickImage(
							imageLoader.getImage(
							IMAGE_GROUP,
							AS_OF_DATE_IMAGE_KEY
							)
							)

					clearFocusedField()

					pasteText(
							asOfDateValue
							)

					KeywordUtil.logInfo(
							'[PASS] As Of Date filled by image fallback.'
							)

					return true
				}
			} catch (Throwable exception) {
				KeywordUtil.logInfo(
						'[AS OF DATE] Image lookup or input failed.\n' +
						'Reason: ' +
						safeMessage(
						exception
						)
						)
			}

			delayBeforeNextAttempt(
					attempt,
					maximumAttempts
					)
		}

		return false
	}


