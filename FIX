private void selectFocusedEMatchComboByKeyboard(String environment) {
	int downCount = getEMatchDownCount(environment)

	KeywordUtil.logInfo("Selecting Environment eMatch with keyboard from PROD. Environment: " + environment + ", down count: " + downCount)

	pressAltDown()
	Windows.delay(1)

	// HOME não está confiável nesse combo.
	// Sobe várias vezes para garantir que sempre começa em Production (PROD).
	for (int i = 0; i < 10; i++) {
		pressKey(KeyEvent.VK_UP)
		Windows.delay(1)
	}

	for (int i = 0; i < downCount; i++) {
		pressKey(KeyEvent.VK_DOWN)
		Windows.delay(1)
	}

	pressKey(KeyEvent.VK_ENTER)
	Windows.delay(2)

	KeywordUtil.logInfo("Environment eMatch selected with keyboard: " + environment)
}
