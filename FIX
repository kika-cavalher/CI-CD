	boolean isBlank(def value) {
		return value == null || value.toString().trim().isEmpty()
	}

	String safe(def value) {
		return value == null ? '' : value.toString()
	}

	String safeHtml(def value) {
		String text = safe(value)
		text = text.replace('&', '&amp;')
		text = text.replace('<', '&lt;')
		text = text.replace('>', '&gt;')
		text = text.replace('"', '&quot;')
		return text
	}

	void logSeparator(String title) {
		KeywordUtil.logInfo('============================================================')
		KeywordUtil.logInfo(title)
		KeywordUtil.logInfo('============================================================')
	}

	String nowExecution() {
		return new SimpleDateFormat('yyyy-MM-dd HH.mm.ss').format(new Date())
	}

	String nowCompact() {
		return new SimpleDateFormat('yyyyMMdd_HHmmss').format(new Date())
	}

	String sanitizeFileName(String value) {
		return safe(value).replaceAll('[\\\\/:*?"<>|]', '_').trim()
	}

	String formatDurationSeconds(BigDecimal totalSeconds) {
		if (totalSeconds == null) {
			return '0m 0s'
		}

		long millis = (totalSeconds * 1000).longValue()
		long hours = (long) (millis / 3600000)
		long minutes = (long) ((millis % 3600000) / 60000)
		long seconds = (long) ((millis % 60000) / 1000)
		long ms = (long) (millis % 1000)

		if (hours > 0) {
			return "${hours}h ${minutes}m ${seconds}s ${ms}ms"
		}
		if (minutes > 0) {
			return "${minutes}m ${seconds}s ${ms}ms"
		}
		return "${seconds}s ${ms}ms"
	}

