    const passedPct = percent(passed, total);
    const failedPct = percent(failed, total);
    const skippedPct = percent(skipped, total);

    const donutBackground = `conic-gradient(
        var(--pass) 0% ${passedPct}%,
        var(--fail) ${passedPct}% ${passedPct + failedPct}%,
        var(--skip) ${passedPct + failedPct}% 100%
