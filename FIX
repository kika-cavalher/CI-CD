	String getCurrentSuiteName() {
		String reportPath = getResolvedReportPath()

		if (isBlank(reportPath)) {
			return 'UnknownTestSuite'
		}

		File pointer = new File(reportPath)

		while (pointer != null) {
			String folderName = pointer.getName()

			if (folderName != null
				&& !folderName.equalsIgnoreCase('Reports')
				&& !folderName.equalsIgnoreCase('logs')
				&& !folderName.equalsIgnoreCase('videos')
				&& !folderName.equalsIgnoreCase('cucumber_report')
				&& !folderName.equalsIgnoreCase('PreLoad')
				&& !folderName.equalsIgnoreCase(GAIA_REPORT_FOLDER_NAME)
				&& !isTimestampFolderName(folderName)) {
				return folderName
			}

			pointer = pointer.getParentFile()
		}

		return 'UnknownTestSuite'
	}

