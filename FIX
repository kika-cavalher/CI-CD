	@Keyword
	void loginThroughNativeControls(String env) {
		String resolvedEnv = safe(env) ?: safe(GlobalVariable.env) ?: 'REC'
		String displayValue = resolveEnvironmentDisplayValue(resolvedEnv)
		int legacyIndex = resolveEnvironmentIndex(resolvedEnv)

		KeywordUtil.logInfo("Logging through native controls for env ${resolvedEnv}")

		focusLoginWindow(detectedWindowTitle)

		WindowsTestObject envCombo = envComboObj()
		if (!waitPresent(envCombo, 10)) {
			KeywordUtil.markFailedAndStop("Environment combo was not found")
		}

		KeywordUtil.logInfo("Selecting environment ${displayValue} with index ${legacyIndex}")

		boolean selected = false

		// 1) click combo and use Katalon built-in selection first
		try {
			focusLoginWindow(detectedWindowTitle)
			Windows.click(envCombo)
			sleepMs(800)

			Windows.selectOptionByLabel(envCombo, displayValue, 3)
			sleepMs(1200)
			selected = true
			KeywordUtil.logInfo("Environment selected with selectOptionByLabel")
		} catch (Throwable ignored) {
			KeywordUtil.logInfo("selectOptionByLabel failed, trying list item click")
		}

		// 2) direct click on visible list item
		if (!selected) {
			try {
				focusLoginWindow(detectedWindowTitle)
				Windows.click(envCombo)
				sleepMs(800)

				WindowsTestObject itemObj = comboListItemObj(displayValue)
				if (waitPresent(itemObj, 3)) {
					Windows.click(itemObj)
					sleepMs(1200)
					selected = true
					KeywordUtil.logInfo("Environment selected by direct list item click")
				}
			} catch (Throwable ignored) {
				KeywordUtil.logInfo("Direct list item click failed, trying legacy keyboard flow")
			}
		}

		// 3) old working logic
		if (!selected) {
			try {
				focusLoginWindow(detectedWindowTitle)
				Windows.click(envCombo)
				sleepMs(800)

				for (int i = 0; i < legacyIndex; i++) {
					Windows.sendKeys(envCombo, Keys.chord(Keys.ARROW_DOWN))
					sleepMs(300)
				}
				Windows.sendKeys(envCombo, Keys.chord(Keys.ENTER))
				sleepMs(1200)
				selected = true
				KeywordUtil.logInfo("Environment selected with legacy sendKeys flow")
			} catch (Throwable ignored) {
				KeywordUtil.logInfo("Legacy sendKeys flow failed, trying Robot fallback")
			}
		}

		// 4) last fallback with Robot
		if (!selected) {
			try {
				focusLoginWindow(detectedWindowTitle)
				Windows.click(envCombo)
				sleepMs(800)

				for (int i = 0; i < legacyIndex; i++) {
					robotKey(KeyEvent.VK_DOWN)
					sleepMs(300)
				}
				robotKey(KeyEvent.VK_ENTER)
				sleepMs(1200)
				selected = true
				KeywordUtil.logInfo("Environment selected with Robot fallback")
			} catch (Throwable ignored) {
			}
		}

		if (!selected) {
			KeywordUtil.markFailedAndStop("Could not select environment ${displayValue}")
		}

		WindowsTestObject connectBtn = connectBtnObj()

		if (waitPresent(connectBtn, 5)) {
			try {
				focusLoginWindow(detectedWindowTitle)
				Windows.click(connectBtn)
				sleepMs(1000)
				KeywordUtil.logInfo("Connect button clicked")
			} catch (Throwable ignored) {
				focusLoginWindow(detectedWindowTitle)
				robotKey(KeyEvent.VK_ENTER)
				sleepMs(1000)
				KeywordUtil.logInfo("Connect confirmed with ENTER fallback")
			}
		} else {
			focusLoginWindow(detectedWindowTitle)
			robotKey(KeyEvent.VK_ENTER)
			sleepMs(1000)
			KeywordUtil.logInfo("Connect button not present, ENTER fallback used")
		}

		boolean mainScreenLoaded = waitForMainScreen()

		if (!mainScreenLoaded) {
			KeywordUtil.markFailedAndStop("eMatch main screen was not loaded. Object 'General/txtSearch' not found.")
		}

		activateHomeTab()
		KeywordUtil.logInfo("eMatch startup flow completed successfully for environment ${resolvedEnv}")
	}

	@Keyword
	boolean waitForMainScreen() {
		KeywordUtil.logInfo("Waiting for main eMatch screen")

		long end = System.currentTimeMillis() + 60000L

		while (System.currentTimeMillis() < end) {
			// old expected success path
			if (waitPresent(mainSearchObj(), 2)) {
				return true
			}

			// if login controls are still there, we are still on login
			boolean loginStillVisible = waitPresent(envComboObj(), 1) || waitPresent(connectBtnObj(), 1)
			if (loginStillVisible) {
				sleepMs(1000)
				continue
			}

			// old fallback behavior after login
			sleepMs(1000)
		}

		return false
	}

	@Keyword
