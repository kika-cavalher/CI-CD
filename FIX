package jiraIntegration

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.driver.DriverFactory
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import org.openqa.selenium.OutputType
import org.openqa.selenium.TakesScreenshot

import javax.imageio.ImageIO

import java.awt.GraphicsDevice
import java.awt.GraphicsEnvironment
import java.awt.Rectangle
import java.awt.Robot
import java.awt.image.BufferedImage
import java.text.SimpleDateFormat
import java.util.Date
import java.util.HashSet
import java.util.Locale
import java.util.Set

class JiraImagesEvidence {

	private static final String ROOT_FOLDER_NAME = 'evidence'
	private static final SimpleDateFormat FILE_STAMP =
		new SimpleDateFormat('yyyyMMdd_HHmmss_SSS', Locale.ENGLISH)

	private static final ThreadLocal<File> CURRENT_CASE_FOLDER = new ThreadLocal<File>()
	private static final ThreadLocal<String> CURRENT_CASE_ID = new ThreadLocal<String>()

	@Keyword
	def startCase(String caseId) {
		String resolvedCaseId = safe(caseId)
		if (resolvedCaseId.isEmpty()) {
			resolvedCaseId = safe(RunConfiguration.getExecutionSourceName())
		}
		if (resolvedCaseId.isEmpty()) {
			resolvedCaseId = 'unknown-case'
		}

		File caseFolder = new File(
			new File(RunConfiguration.getReportFolder(), ROOT_FOLDER_NAME),
			sanitizeCaseId(resolvedCaseId)
		)

		if (!caseFolder.exists()) {
			caseFolder.mkdirs()
		}

		CURRENT_CASE_ID.set(resolvedCaseId)
		CURRENT_CASE_FOLDER.set(caseFolder)

		return caseFolder.absolutePath
	}

	@Keyword
	def finishCase() {
		CURRENT_CASE_ID.remove()
		CURRENT_CASE_FOLDER.remove()
	}

	@Keyword
	def note(String message) {
		KeywordUtil.logInfo('[REPORT_STEP] ' + safe(message))
	}

	@Keyword
	def checkpoint(String message) {
		KeywordUtil.logInfo('[REPORT_STEP] ' + safe(message))
	}

	@Keyword
	def captureNow(String label) {
		return captureInternal(label, false, '')
	}

	@Keyword
	def noteAndCapture(String message, String label) {
		note(message)
		return captureInternal(label, false, '')
	}

	@Keyword
	def autoFailure(String caseId) {
		return captureInternal('auto-failure', true, caseId)
	}

	private String captureInternal(String label, boolean failureMode, String explicitCaseId) {
		File caseFolder = ensureCaseFolder(explicitCaseId)

		String cleanLabel = sanitizeFilePart(label)
		if (cleanLabel.isEmpty()) {
			cleanLabel = failureMode ? 'auto-failure' : 'capture'
		}

		File targetFile = new File(
			caseFolder,
			FILE_STAMP.format(new Date()) + '_' + cleanLabel + '.png'
		)

		String source = saveBestScreenshot(targetFile)

		if (!source.isEmpty()) {
			KeywordUtil.logInfo('Evidence screenshot saved from ' + source + ': ' + targetFile.absolutePath)
			return targetFile.absolutePath
		}

		KeywordUtil.logInfo('Evidence screenshot could not be captured for: ' + safe(explicitCaseId ?: CURRENT_CASE_ID.get()))
		return ''
	}

	private File ensureCaseFolder(String explicitCaseId) {
		File existing = CURRENT_CASE_FOLDER.get()
		if (existing != null && existing.exists()) {
			return existing
		}

		String caseId = safe(explicitCaseId)
		if (caseId.isEmpty()) {
			caseId = safe(CURRENT_CASE_ID.get())
		}
		if (caseId.isEmpty()) {
			caseId = safe(RunConfiguration.getExecutionSourceName())
		}
		if (caseId.isEmpty()) {
			caseId = 'unknown-case'
		}

		String path = String.valueOf(startCase(caseId))
		return new File(path)
	}

	private String saveBestScreenshot(File targetFile) {
		if (captureFromWebDriver(targetFile) && isUsefulImage(targetFile)) {
			return 'web-driver'
		}
		deleteQuietly(targetFile)

		if (captureFromWindowsDriver(targetFile) && isUsefulImage(targetFile)) {
			return 'windows-driver'
		}
		deleteQuietly(targetFile)

		if (captureFromDesktopRobot(targetFile) && isUsefulImage(targetFile)) {
			return 'desktop-robot'
		}
		deleteQuietly(targetFile)

		return ''
	}

	private boolean captureFromWebDriver(File targetFile) {
		try {
			def driver = DriverFactory.getWebDriver()
			if (driver instanceof TakesScreenshot) {
				byte[] bytes = ((TakesScreenshot) driver).getScreenshotAs(OutputType.BYTES)
				if (bytes != null && bytes.length > 0) {
					targetFile.parentFile?.mkdirs()
					targetFile.bytes = bytes
					return true
				}
			}
		} catch (Throwable ignored) {
		}
		return false
	}

	private boolean captureFromWindowsDriver(File targetFile) {
		try {
			def driver = Windows.getDriver()
			if (driver != null) {
				byte[] bytes = driver.getScreenshotAs(OutputType.BYTES)
				if (bytes != null && bytes.length > 0) {
					targetFile.parentFile?.mkdirs()
					targetFile.bytes = bytes
					return true
				}
			}
		} catch (Throwable ignored) {
		}
		return false
	}

	private boolean captureFromDesktopRobot(File targetFile) {
		try {
			if (GraphicsEnvironment.isHeadless()) {
				return false
			}

			Rectangle allScreensBounds = getAllScreensBounds()
			if (allScreensBounds == null || allScreensBounds.width <= 0 || allScreensBounds.height <= 0) {
				return false
			}

			BufferedImage image = new Robot().createScreenCapture(allScreensBounds)
			targetFile.parentFile?.mkdirs()
			ImageIO.write(image, 'png', targetFile)
			return targetFile.exists() && targetFile.length() > 0L
		} catch (Throwable ignored) {
		}
		return false
	}

	private Rectangle getAllScreensBounds() {
		try {
			GraphicsEnvironment environment = GraphicsEnvironment.getLocalGraphicsEnvironment()
			GraphicsDevice[] devices = environment.getScreenDevices()

			Rectangle bounds = null

			for (GraphicsDevice device : devices) {
				Rectangle current = device.defaultConfiguration.bounds
				if (current == null) {
					continue
				}

				if (bounds == null) {
					bounds = new Rectangle(current)
				} else {
					bounds = bounds.union(current)
				}
			}

			return bounds
		} catch (Throwable ignored) {
			return null
		}
	}

	private boolean isUsefulImage(File file) {
		try {
			if (file == null || !file.exists() || file.length() <= 0L) {
				return false
			}

			BufferedImage image = ImageIO.read(file)
			if (image == null) {
				return false
			}

			int width = image.getWidth()
			int height = image.getHeight()

			if (width <= 1 || height <= 1) {
				return false
			}

			int stepX = Math.max(1, width / 60)
			int stepY = Math.max(1, height / 60)

			Set<Integer> uniqueColors = new HashSet<Integer>()
			int minBrightness = 255
			int maxBrightness = 0
			int samples = 0

			for (int y = 0; y < height; y += stepY) {
				for (int x = 0; x < width; x += stepX) {
					int rgb = image.getRGB(x, y) & 0x00FFFFFF
					uniqueColors.add(rgb)

					int r = (rgb >> 16) & 0xFF
					int g = (rgb >> 8) & 0xFF
					int b = rgb & 0xFF
					int brightness = (r + g + b) / 3

					if (brightness < minBrightness) {
						minBrightness = brightness
					}
					if (brightness > maxBrightness) {
						maxBrightness = brightness
					}

					samples++
					if (uniqueColors.size() > 8) {
						return true
					}
				}
			}

			if (samples == 0) {
				return false
			}

			int spread = maxBrightness - minBrightness

			if (uniqueColors.size() <= 2 && spread <= 4) {
				return false
			}

			return true
		} catch (Throwable ignored) {
			return false
		}
	}

	private void deleteQuietly(File file) {
		try {
			if (file != null && file.exists()) {
				file.delete()
			}
		} catch (Throwable ignored) {
		}
	}

	private String sanitizeCaseId(String value) {
		String text = safe(value)
			.replace('\\', '_')
			.replace('/', '_')
			.replace(':', '_')
			.replace('*', '_')
			.replace('?', '_')
			.replace('"', '_')
			.replace('<', '_')
			.replace('>', '_')
			.replace('|', '_')
			.replaceAll('[^A-Za-z0-9._ -]', '_')
			.trim()
			.replaceAll('\\s+', '_')

		return text.isEmpty() ? 'unknown-case' : text
	}

	private String sanitizeFilePart(String value) {
		String text = safe(value)
			.replace('\\', '_')
			.replace('/', '_')
			.replace(':', '_')
			.replace('*', '_')
			.replace('?', '_')
			.replace('"', '_')
			.replace('<', '_')
			.replace('>', '_')
			.replace('|', '_')
			.replaceAll('[^A-Za-z0-9._ -]', '_')
			.trim()
			.replaceAll('\\s+', '-')

		return text
	}

	private String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}
}
