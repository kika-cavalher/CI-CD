import static com.kms.katalon.core.testcase.TestCaseFactory.findTestCase

import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows


// ======================================================
// MODULE CONFIG
// ======================================================

String targetEnvironment = 'REC'

String menuName = 'synthèse Justification Latent'
String menuResultName = 'Synthèse Justification Latent'
String openedTabName = menuResultName

String firstGroupSourceImage ='grappeHeader'
String emptyGroupTargetImage ='emptyGroupSection'
String secondGroupSourceImage ='ecartBilanVSCompteResultatCCY'
String filledGroupTargetImage ='filledGroupSection'
String loginTestCase ='Component/Authentication/Login ' + targetEnvironment
String closeApplicationTestCase ='Component/Authentication/Close Application'


// ======================================================
// TIMEOUT CONFIG
// ======================================================

Integer menuTimeout = 60
Integer openedTabTimeout = 60
Integer groupByTimeout = 10
Integer detailsTimeout = 10
Integer dragAndDropTimeout = 10


// ======================================================
// AUTHENTICATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Authenticate and open application\n' +
	'Environment: ' + targetEnvironment
)

WebUI.callTestCase(
	findTestCase(loginTestCase),
	[:],
	FailureHandling.STOP_ON_FAILURE
)


// ======================================================
// MENU NAVIGATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Open target module\n' +
	'Search: ' + menuName + '\n' +
	'Result: ' + menuResultName
)

CustomKeywords.'component.MenuNavigator.searchAndOpenMenuByText'(
	menuName,
	menuResultName,
	menuTimeout
)

Windows.delay(30)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	targetEnvironment + '_GUI_GroupBy_OpenModule.png'
)


// ======================================================
// FIRST GROUP BY LEVEL
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Create first Group By level\n' +
	'Field: Grappe\n' +
	'Expected format: Grappe:INTEGER greater than zero'
)

CustomKeywords.'pageObject.guiValidation.dragAndDropImage'(
	firstGroupSourceImage,
	emptyGroupTargetImage,
	dragAndDropTimeout
)
CustomKeywords.'pageObject.guiValidation.dragAndDropImage'(
	secondGroupSourceImage,
	filledGroupTargetImage,
	dragAndDropTimeout
)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	targetEnvironment + '_GUI_GroupBy_Grappe.png'
)

// ======================================================
// SECOND GROUP BY LEVEL
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Create second Group By level\n' +
	'Field: Ecart bilan vs. compte de résultat ccy\n' +
	'Expected format: label:NUMBER'
)

CustomKeywords.'pageObject.guiValidation.dragAndDropImage'(
	secondGroupSourceImage,
	filledGroupTargetImage,
	dragAndDropTimeout
)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	targetEnvironment + '_GUI_GroupBy_GrappeAndEcart.png'
)


// ======================================================
// GROUP BY RESULT VALIDATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Validate Group By result\n' +
	'Action: Double-click the first result row\n' +
	'Expected: line 2 starts with Ecart bilan vs. compte de résultat ccy\n' +
	'Validation strategy: image first and Windows element fallback'
)

CustomKeywords.'pageObject.guiValidation.validateGroupByResult'(
	groupByTimeout
)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	targetEnvironment + '_GUI_GroupBy_ResultValidated.png'
)


// ======================================================
// CLOSE APPLICATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Close application\n' +
	'Environment: ' + targetEnvironment
)

WebUI.callTestCase(
	findTestCase(closeApplicationTestCase),
	[:],
	FailureHandling.STOP_ON_FAILURE
)

KeywordUtil.markPassed(
	targetEnvironment +
	' Group By hierarchy validation completed successfully.'
)
