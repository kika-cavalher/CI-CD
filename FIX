String parent = 'Rapprochement PNL'
String parent2 = 'Rapprochement'
String menu = 'Rapprochement'
Robot robot = new Robot()

CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Wait for search field to be available for menu: ${menu}")
Windows.waitForElementPresent(findWindowsObject('General/txtSearch'), 10)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Type menu name in search field: ${menu}")
Windows.setText(findWindowsObject('General/txtSearch'), menu)

// Check file image based on input name
CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Load image references for parent and child menu path: ${parent} > ${parent2} > ${menu}")
temp = new File(RunConfiguration.getProjectDir(), ('Images/Archive Mode/' + menu + '.PNG')).getAbsolutePath()
tempParent = new File(RunConfiguration.getProjectDir(), ('Images/Archive Mode/' + parent + 'Menu.PNG')).getAbsolutePath()
tempParent2 = new File(RunConfiguration.getProjectDir(), ('Images/Archive Mode/' + parent2 + 'Menu.PNG')).getAbsolutePath()

CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Wait briefly before navigating through menu path: ${parent} > ${parent2} > ${menu}")
Windows.delay(1)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Click first parent menu image: ${parent}")
WindowsImageKeywords.clickImage(tempParent)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Wait briefly after clicking first parent menu: ${parent}")
Windows.delay(1)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Click second parent menu image: ${parent2}")
WindowsImageKeywords.clickImage(tempParent2)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Wait briefly after clicking second parent menu: ${parent2}")
Windows.delay(1)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Click target menu image: ${menu}")
WindowsImageKeywords.clickImage(temp)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Validate whether an application error window is displayed after opening menu: ${menu}")
CustomKeywords.'com.katalon.keywords.windows.WindowsImprovedKeywords.errorWindow'(menu)

try {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Wait for tab to open successfully for menu: ${menu}")
	Windows.waitForElementPresent(findWindowsObject('Object Repository/Archive Mode/tabName'), 120)

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Capture success evidence for opened menu tab: ${menu}")
	WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession()).takeScreenshot(
		RunConfiguration.getReportFolder() + '\\Evidences\\' + menu + '.PNG'
	)

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Close opened tab for menu: ${menu}")
	Windows.click(findWindowsObject('Archive Mode/btnFermer'))

	KeywordUtil.markPassed('[SUCCESS] Tab of menu ' + menu + ' was opened sucessfully.')
} catch (Exception e) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Tab did not open as expected. Capture failure evidence for menu: ${menu}")
	Windows.delay(2)

	WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession()).takeScreenshot(
		RunConfiguration.getReportFolder() + '\\Evidences\\' + '[ERROR] ' + menu + '.PNG'
	)

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Click confirmation button on failure dialog for menu: ${menu}")
	Windows.click(findWindowsObject('Object Repository/Justification des Comptes de Latent/confirmBtn'))

	KeywordUtil.markFailed('\n[ERROR] Tab of menu ' + menu + ' was not opened.')
}
