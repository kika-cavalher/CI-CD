	private void clickRequiredWindowsObject(
			String objectKey,
			String description,
			Integer timeoutSeconds) {

		int safeTimeout =
				timeoutSeconds == null ||
				timeoutSeconds <= 0
				? SAVE_DIALOG_TIMEOUT_SECONDS
				: timeoutSeconds

		logInfo(
				'Searching for required control using Windows object first.\n' +
				'Description: ' + description + '\n' +
				'Object key: ' + objectKey + '\n' +
				'Functional timeout: ' + safeTimeout + ' seconds\n' +
				'Hard timeout: ' + ELEMENT_HARD_TIMEOUT_SECONDS + ' seconds'
				)

		boolean clickedByObject =
				tryClickWindowsObjectProtected(
				objectKey,
				description,
				safeTimeout
				)

		if (clickedByObject) {

			logInfo(
					description +
					' clicked successfully using Windows object.'
					)

			return
		}

		logInfo(
				description +
				' Windows object was not available or did not answer.\n' +
				'Trying image fallback.\n' +
				'Image key: ' + objectKey
				)

		boolean imageFound = false

		try {
			imageFound = imageLoader.waitForImage(
					GENERAL_IMAGE_GROUP,
					objectKey,
					IMAGE_BUTTON_TIMEOUT_SECONDS
					)
		} catch (Throwable throwable) {

			logInfo(
					description +
					' image fallback returned an exception.\n' +
					'Image key: ' + objectKey + '\n' +
					'Message: ' +
					safeExceptionMessage(
					throwable
					)
					)
		}

		if (imageFound) {

			try {
				imageLoader.clickImageOrStop(
						GENERAL_IMAGE_GROUP,
						objectKey
						)

				logInfo(
						description +
						' clicked successfully using image fallback.'
						)

				return
			} catch (Throwable throwable) {

				logInfo(
						description +
						' image fallback was found but could not be clicked.\n' +
						'Image key: ' + objectKey + '\n' +
						'Message: ' +
						safeExceptionMessage(
						throwable
						)
						)
			}
		}

		imageLoader.takeEvidence(
				objectKey +
				'NotFound.png'
				)

		KeywordUtil.markFailedAndStop(
				'Required control was not found or could not be clicked.\n' +
				'Description: ' + description + '\n' +
				'Windows object: ' + EXPORT_OBJECT_GROUP + '/' + objectKey + '\n' +
				'Windows hard timeout: ' + ELEMENT_HARD_TIMEOUT_SECONDS + ' seconds\n' +
				'Image fallback: ' + GENERAL_IMAGE_GROUP + '/' + objectKey + '\n' +
				'Image timeout: ' + IMAGE_BUTTON_TIMEOUT_SECONDS + ' seconds'
				)
	}


	private boolean isWindowsObjectPresentProtected(
			String objectKey,
			String description,
			Integer timeoutSeconds) {

		int safeTimeout =
				timeoutSeconds == null ||
				timeoutSeconds <= 0
				? ELEMENT_BUTTON_TIMEOUT_SECONDS
				: timeoutSeconds

		WindowsTestObject object =
				getOptionalWindowsObject(
				objectKey
				)

		if (object == null) {

			logInfo(
					description +
					' Windows object is not configured.\n' +
					'Object key: ' + objectKey
					)

			return false
		}

		Map result =
				executeWindowsActionWithHardTimeout(
				'Verify ' + description,
				ELEMENT_HARD_TIMEOUT_SECONDS,
				{
					Windows.verifyElementPresent(
							object,
							safeTimeout,
							FailureHandling.OPTIONAL
							)
				}
				)

		if (!result.completed) {

			logInfo(
					description +
					' Windows verification did not complete.\n' +
					'Object key: ' + objectKey + '\n' +
					'Timed out: ' + result.timedOut + '\n' +
					'Message: ' + safeLogText(result.message)
					)

			return false
		}

		return Boolean.TRUE.equals(
				result.value
				)
	}


	private boolean tryClickWindowsObjectProtected(
			String objectKey,
			String description,
			Integer timeoutSeconds) {

		int safeTimeout =
				timeoutSeconds == null ||
				timeoutSeconds <= 0
				? ELEMENT_BUTTON_TIMEOUT_SECONDS
				: timeoutSeconds

		WindowsTestObject object =
				getOptionalWindowsObject(
				objectKey
				)

		if (object == null) {

			logInfo(
					description +
					' Windows object is not configured.\n' +
					'Object key: ' + objectKey
					)

			return false
		}

		Map verificationResult =
				executeWindowsActionWithHardTimeout(
				'Verify ' + description,
				ELEMENT_HARD_TIMEOUT_SECONDS,
				{
					Windows.verifyElementPresent(
							object,
							safeTimeout,
							FailureHandling.OPTIONAL
							)
				}
				)

		if (!verificationResult.completed ||
				!Boolean.TRUE.equals(
				verificationResult.value
				)) {

			logInfo(
					description +
					' Windows object was not available.\n' +
					'Object key: ' + objectKey + '\n' +
					'Timed out: ' + verificationResult.timedOut + '\n' +
					'Message: ' + safeLogText(verificationResult.message)
					)

			return false
		}

		Map clickResult =
				executeWindowsActionWithHardTimeout(
				'Click ' + description,
				ELEMENT_HARD_TIMEOUT_SECONDS,
				{
					Windows.click(
							object,
							FailureHandling.STOP_ON_FAILURE
							)

					return true
				}
				)

		if (!clickResult.completed ||
				!Boolean.TRUE.equals(
				clickResult.value
				)) {

			logInfo(
					description +
					' Windows click did not complete.\n' +
					'Object key: ' + objectKey + '\n' +
					'Timed out: ' + clickResult.timedOut + '\n' +
					'Message: ' + safeLogText(clickResult.message)
					)

			return false
		}

		return true
	}


	private Map executeWindowsActionWithHardTimeout(
			String actionDescription,
			Integer hardTimeoutSeconds,
			Closure action) {

		int safeHardTimeout =
				hardTimeoutSeconds == null ||
				hardTimeoutSeconds <= 0
				? ELEMENT_HARD_TIMEOUT_SECONDS
				: hardTimeoutSeconds

		if (windowsElementChannelTimedOut) {

			return [
				completed: false,
				timedOut: true,
				value: null,
				message: 'Windows element channel was already abandoned after a previous hard timeout'
			]
		}

		FutureTask<Object> future =
				new FutureTask<Object>(
				{
					return action.call()
				} as Callable<Object>
				)

		String threadName =
				'ExportFile-' +
				safeLogText(
				actionDescription
				)
				.replaceAll(
				'[^A-Za-z0-9]+',
				'_'
				)

		Thread worker =
				new Thread(
				future,
				threadName
				)

		worker.setDaemon(
				true
				)

		worker.start()

		try {
			Object value =
					future.get(
					safeHardTimeout,
					TimeUnit.SECONDS
					)

			return [
				completed: true,
				timedOut: false,
				value: value,
				message: ''
			]
		} catch (TimeoutException timeoutException) {

			windowsElementChannelTimedOut = true

			future.cancel(
					true
					)

			logInfo(
					'Windows action reached the hard timeout and was abandoned.\n' +
					'Action: ' + actionDescription + '\n' +
					'Hard timeout: ' + safeHardTimeout + ' seconds\n' +
					'The test thread will continue to the image fallback.'
					)

			return [
				completed: false,
				timedOut: true,
				value: null,
				message: 'Hard timeout reached'
			]
		} catch (Throwable throwable) {

			future.cancel(
					true
					)

			Throwable rootCause =
					throwable.getCause() == null
					? throwable
					: throwable.getCause()

			logInfo(
					'Windows action failed and the test will continue to the image fallback.\n' +
					'Action: ' + actionDescription + '\n' +
					'Message: ' +
					safeExceptionMessage(
					rootCause
					)
					)

			return [
				completed: false,
				timedOut: false,
				value: null,
				message: safeExceptionMessage(
					rootCause
					)
			]
		}
	}


