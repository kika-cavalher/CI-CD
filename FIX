        block.append('</div>\n')

        block.append('</div>\n')
        return block.toString()
    }

    String createGaiaHtmlReport(String reportFolder, String suiteName, String xmlPath) {
        if (owner.isBlank(reportFolder) || owner.isBlank(xmlPath)) {
            return ''
        }

        List<Map> cases = parseXmlCases(xmlPath)
        List<Map> failedCases = cases.findAll { Map item -> owner.safe(item.status) == 'failed' }
        List<Map> passedCases = cases.findAll { Map item -> owner.safe(item.status) == 'passed' }
        List<Map> skippedCases = cases.findAll { Map item -> owner.safe(item.status) == 'skipped' }

        List<File> failureImages = owner.collectFailureImages(reportFolder)

        int imageIndex = 0
        failedCases.each { Map item ->
            if (imageIndex < failureImages.size()) {
                item.image = failureImages[imageIndex]
                imageIndex++
            } else {
                item.image = null
            }
        }

        long totalDurationMs = 0L
        cases.each { Map item ->
            totalDurationMs += ((item.durationMs ?: 0L) as long)
        }

        File baseDir = new File(reportFolder)
        Date endDate = new Date(baseDir.lastModified())
        Date startDate = new Date(endDate.time - totalDurationMs)

        int executed = cases.size()
        String avgTest = executed > 0
            ? owner.formatDurationMillis((long) (totalDurationMs / executed))
            : '0m 0s 0ms'

