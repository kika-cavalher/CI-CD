import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import org.openqa.selenium.Keys

import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import general.WinRetry


CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Verify set Username and version')



String currentUser = System.getProperty('user.name') ?: ''



String ematchAppPath =
		System.getProperty('ematchAppPath') ?:
		System.getenv('EMATCH_APP_PATH') ?:
		''



String ematchVersion =
		System.getProperty('ematchVersion') ?:
		System.getenv('EMATCH_VERSION') ?:
		''



if (!ematchAppPath?.trim()) {
	KeywordUtil.markFailedAndStop("[ERROR] ematchAppPath is empty. Provide -DematchAppPath or env EMATCH_APP_PATH")
}



if (!ematchVersion?.trim()) {
	KeywordUtil.logInfo("[WARN] ematchVersion is empty. Proceeding without title matching.")
}



try {

	if (currentUser == 'adgi5appjenkins') {

		String cmd = 'Powershell.exe -executionpolicy remotesigned -File D:\\setResolution.ps1'
		Runtime.getRuntime().exec(cmd)

		if (ematchVersion?.trim()) {
			Windows.startApplicationWithTitle(ematchAppPath, ematchVersion)
		} else {
			Windows.startApplication(ematchAppPath)
		}

	} else {

		String command = 'C:\\Program Files (x86)\\Windows Application Driver\\WinAppDriver.exe'
		ProcessBuilder builder = new ProcessBuilder(command).inheritIO()
		builder.start()

		Windows.delay(2)

		Windows.startApplication(ematchAppPath)
	}

} catch (Throwable t) {

	KeywordUtil.markFailedAndStop("[ERROR] Failed to start eMatch. Details: " + t.getMessage())
}
