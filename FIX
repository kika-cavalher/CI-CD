package jiraIntegration

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.context.TestCaseContext
import com.kms.katalon.core.util.KeywordUtil

import javax.imageio.ImageIO
import java.awt.GraphicsEnvironment
import java.awt.Rectangle
import java.awt.Robot
import java.awt.Toolkit
import java.awt.image.BufferedImage
import java.text.SimpleDateFormat
import java.util.Locale

class ImagesEvidence {

    private static final SimpleDateFormat FILE_STAMP =
        new SimpleDateFormat('yyyyMMdd_HHmmss_SSS', Locale.ENGLISH)

    private static final SimpleDateFormat LOG_STAMP =
        new SimpleDateFormat('yyyy-MM-dd HH:mm:ss.SSS', Locale.ENGLISH)

    private static final ThreadLocal<File> CURRENT_CASE_FOLDER = new ThreadLocal<File>()
    private static final ThreadLocal<String> CURRENT_CASE_ID = new ThreadLocal<String>()

    /*
     * Manual note that will be saved in the evidence log.
     * Use this when you want the report to show only controlled steps.
     */
    @Keyword
    def note(String message) {
        appendNoteLine('NOTE', message)
    }

    /*
     * Manual controlled checkpoint.
     * This is useful for validations you want to expose in the custom report.
     */
    @Keyword
    def checkpoint(String message) {
        appendNoteLine('CHECKPOINT', message)
    }

    /*
     * Manual screenshot when you explicitly want one.
     */
    @Keyword
    File captureNow(String label = 'manual') {
        return captureScreenshot(label)
    }

    /*
     * Manual note plus screenshot in one command.
     */
    @Keyword
    File noteAndCapture(String message, String label = 'manual') {
        appendNoteLine('NOTE', message)
        return captureScreenshot(label)
    }

    /*
     * Global start hook.
     * This is called automatically from the listener.
     */
    static void startCase(TestCaseContext context) {
        File caseFolder = resolveCaseFolder(context)
        CURRENT_CASE_FOLDER.set(caseFolder)
        CURRENT_CASE_ID.set(safe(context?.getTestCaseId()))
        appendLine(caseFolder, buildLogLine('CASE_START', safe(context?.getTestCaseId())))
    }

    /*
     * Global end hook.
     * If the test failed or errored, it captures a screenshot automatically.
     */
    static void finishCase(TestCaseContext context) {
        try {
            File caseFolder = resolveActiveCaseFolder(context)
            String status = normalizeStatus(context?.getTestCaseStatus())

            appendLine(caseFolder, buildLogLine('CASE_END', status))

            if (status == 'FAILED' || status == 'ERROR') {
                captureScreenshot('auto-failure')
            }
        } finally {
            CURRENT_CASE_FOLDER.remove()
            CURRENT_CASE_ID.remove()
        }
    }

    /*
     * Captures the current desktop screen and stores it in the current test evidence folder.
     */
    private static File captureScreenshot(String label) {
        File caseFolder = resolveActiveCaseFolder(null)
        String safeLabel = sanitizeFileName(label)

        if (safeLabel.isEmpty()) {
            safeLabel = 'manual'
        }

        File target = new File(caseFolder, FILE_STAMP.format(new Date()) + '_' + safeLabel + '.png')

        try {
            if (GraphicsEnvironment.isHeadless()) {
                appendLine(caseFolder, buildLogLine('SCREENSHOT_ERROR', 'Headless environment. Screenshot was not captured.'))
                KeywordUtil.logInfo('Evidence screenshot was not captured because the environment is headless.')
                return null
            }

            BufferedImage image = new Robot().createScreenCapture(
                new Rectangle(Toolkit.getDefaultToolkit().getScreenSize())
            )

            ImageIO.write(image, 'png', target)

            appendLine(caseFolder, buildLogLine('SCREENSHOT', target.absolutePath))
            KeywordUtil.logInfo('Evidence screenshot saved: ' + target.absolutePath)

            return target
        } catch (Throwable t) {
            appendLine(caseFolder, buildLogLine('SCREENSHOT_ERROR', safe(t?.getMessage())))
            KeywordUtil.logInfo('Evidence screenshot could not be captured: ' + safe(t?.getMessage()))
            return null
        }
    }

    /*
     * Saves controlled notes in a simple log file.
     * The report builder can later read only this file and ignore noisy execution logs.
     */
    private static void appendNoteLine(String type, String message) {
        File caseFolder = resolveActiveCaseFolder(null)
        appendLine(caseFolder, buildLogLine(type, message))
    }

    /*
     * Returns the active case folder if it already exists in the thread.
     * Otherwise it resolves it again safely.
     */
    private static File resolveActiveCaseFolder(TestCaseContext context) {
        File active = CURRENT_CASE_FOLDER.get()

        if (active != null && active.exists()) {
            return active
        }

        File caseFolder = resolveCaseFolder(context)
        CURRENT_CASE_FOLDER.set(caseFolder)

        return caseFolder
    }

    /*
     * Builds a stable folder inside the current Katalon report folder.
     * Structure:
     * <current report folder>/Evidences/<sanitized test case id>/
     */
    private static File resolveCaseFolder(TestCaseContext context) {
        String reportFolderPath = ''

        try {
            reportFolderPath = safe(RunConfiguration.getReportFolder())
        } catch (Throwable ignored) {
        }

        File reportFolder
        if (!reportFolderPath.isEmpty()) {
            reportFolder = new File(reportFolderPath)
        } else {
            reportFolder = new File(new File(RunConfiguration.getProjectDir(), 'Reports'), '_genericEvidence')
        }

        File evidencesRoot = new File(reportFolder, 'Evidences')
        if (!evidencesRoot.exists()) {
            evidencesRoot.mkdirs()
        }

        String caseId = safe(context?.getTestCaseId())
        if (caseId.isEmpty()) {
            caseId = safe(CURRENT_CASE_ID.get())
        }
        if (caseId.isEmpty()) {
            caseId = 'general'
        }

        File caseFolder = new File(evidencesRoot, sanitizeFileName(caseId))
        if (!caseFolder.exists()) {
            caseFolder.mkdirs()
        }

        return caseFolder
    }

    /*
     * Appends one line into evidence-notes.log.
     */
    private static void appendLine(File caseFolder, String line) {
        if (caseFolder == null) {
            return
        }

        if (!caseFolder.exists()) {
            caseFolder.mkdirs()
        }

        File logFile = new File(caseFolder, 'evidence-notes.log')
        logFile << line + System.lineSeparator()
    }

    /*
     * Standard evidence log format:
     * 2026-03-24 14:10:52.221|NOTE|Opened menu
     */
    private static String buildLogLine(String type, String value) {
        return LOG_STAMP.format(new Date()) + '|' + safe(type) + '|' + safe(value)
    }

    private static String normalizeStatus(String status) {
        return safe(status).toUpperCase(Locale.ENGLISH)
    }

    private static String sanitizeFileName(String value) {
        return safe(value)
            .replace('\\', '_')
            .replace('/', '_')
            .replace(':', '_')
            .replace('*', '_')
            .replace('?', '_')
            .replace('"', '_')
            .replace('<', '_')
            .replace('>', '_')
            .replace('|', '_')
            .replaceAll(/\s+/, '_')
    }

    private static String safe(Object value) {
        return value == null ? '' : String.valueOf(value).trim()
    }
}








import com.kms.katalon.core.annotation.AfterTestCase
import com.kms.katalon.core.annotation.BeforeTestCase
import com.kms.katalon.core.context.TestCaseContext

import jiraIntegration.ImagesEvidence

class GlobalEvidenceListener {

    @BeforeTestCase
    def beforeTestCase(TestCaseContext testCaseContext) {
        ImagesEvidence.startCase(testCaseContext)
    }

    @AfterTestCase
    def afterTestCase(TestCaseContext testCaseContext) {
        ImagesEvidence.finishCase(testCaseContext)
    }
}







