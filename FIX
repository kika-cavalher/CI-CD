	private String buildScenarioPanel(Map scenario, boolean selected) {
		StringBuilder sb = new StringBuilder()

		sb.append('<section class="scenario-panel')
		if (selected) {
			sb.append(' active')
		}
		sb.append('" id="panel-').append(escape(safe(scenario.id))).append('">')

		sb.append('<div class="scenario-header">')
		sb.append('<div class="scenario-main-title">').append(escape(safe(scenario.title))).append('</div>')
		sb.append('<div class="meta-row">')
		sb.append(buildMetaChip('Status', statusLabel(safe(scenario.status)), safe(scenario.status)))
		sb.append(buildMetaChip('Start', first(scenario.startLabel, '--'), 'accent'))
		sb.append(buildMetaChip('End', first(scenario.endLabel, '--'), 'accent'))
		sb.append(buildMetaChip('Duration', first(scenario.durationLabel, '00h 00m 00s'), 'accent'))
		sb.append('</div>')
		sb.append('</div>')

		if (safe(scenario.status) == 'failed') {
			sb.append('<div class="error-box">')
			sb.append('<div class="section-title">Error</div>')
			sb.append('<div class="error-short">').append(escape(first(scenario.errorShort, 'Failure'))).append('</div>')

			String fullError = first(scenario.errorFull, '')
			if (!fullError.isEmpty()) {
				sb.append('<details class="details-box">')
				sb.append('<summary>View full error</summary>')
				sb.append('<pre>').append(escape(fullError)).append('</pre>')
				sb.append('</details>')
			}
			sb.append('</div>')
		}

		sb.append('<div class="steps-box">')
		sb.append('<div class="section-title">Steps</div>')
		sb.append('<div class="steps-table">')
		sb.append('<div class="steps-head"><div>Status</div><div>Time</div><div>Detail</div></div>')

		List<Map> steps = scenario.steps instanceof List ? (scenario.steps as List<Map>) : []
		if (steps.isEmpty()) {
			sb.append('<div class="step-row empty"><div></div><div></div><div>No step details found.</div></div>')
		} else {
			steps.each { Map step ->
				sb.append(buildStepRow(step))
			}
		}
		sb.append('</div>')
		sb.append('</div>')

		List<Map> evidences = scenario.evidence instanceof List ? (scenario.evidence as List<Map>) : []
		if (!evidences.isEmpty()) {
			Map evidence = evidences[0]
			sb.append('<div class="evidence-box">')
			sb.append('<div class="section-title">Evidence</div>')

			String href = first(evidence.href, '')
			String imgSrc = first(evidence.imgSrc, href)

			if (!href.isEmpty()) {
				sb.append('<div class="evidence-link"><a href="').append(escape(href)).append('" target="_blank" rel="noopener noreferrer">Open image</a></div>')
			}

			if (!imgSrc.isEmpty()) {
				sb.append('<img class="evidence-image" src="').append(escape(imgSrc)).append('" alt="evidence">')
			}

			sb.append('</div>')
		}

		sb.append('</section>')
		return sb.toString()
	}

	private String buildStepRow(Map step) {
		StringBuilder sb = new StringBuilder()
		String status = safe(step.status)
		if (status.isEmpty()) {
			status = 'info'
		}

		sb.append('<div class="step-row">')
		sb.append('<div><span class="pill ').append(escape(status)).append('">').append(escape(statusLabel(status))).append('</span></div>')
		sb.append('<div class="step-time">').append(escape(first(step.timeLabel, '--'))).append('</div>')
		sb.append('<div class="step-detail">').append(escape(first(step.detailText, step.title, ''))).append('</div>')
		sb.append('</div>')
		return sb.toString()
	}

	private String buildMetaChip(String label, String value, String type) {
		StringBuilder sb = new StringBuilder()
		sb.append('<div class="meta-chip ').append(escape(type)).append('">')
		sb.append('<span class="meta-chip-label">').append(escape(label)).append(':</span> ')
		sb.append('<span>').append(escape(value)).append('</span>')
		sb.append('</div>')
		return sb.toString()
	}

	private String statusLabel(String status) {
		switch (safe(status)) {
			case 'passed':
				return 'Passed'
			case 'failed':
				return 'Failed'
			case 'skipped':
				return 'Skipped'
			default:
				return 'Info'
		}
	}

	private String resolveFileHref(String rawPath, String baseFolder) {
		String value = safe(rawPath)
		if (value.isEmpty()) {
			return ''
		}

		try {
			if (value.toLowerCase(Locale.ENGLISH).startsWith('file:/')) {
				File uriFile = new File(new URI(value))
				if (uriFile.exists()) {
					return uriFile.toURI().toString()
				}
			}
		} catch (Exception ignored) {
		}

		File direct = new File(value)
		if (direct.exists()) {
			return direct.toURI().toString()
		}

		if (!safe(baseFolder).isEmpty()) {
			File byBase = new File(baseFolder, value)
			if (byBase.exists()) {
				return byBase.toURI().toString()
			}
		}

		return value
	}

	private String first(def... values) {
		if (values == null) {
			return ''
		}

		for (def value : values) {
			String text = safe(value)
			if (!text.isEmpty()) {
				return text
			}
		}

		return ''
	}

	private String shorten(String text, int max) {
		String value = safe(text)
		if (value.length() <= max) {
			return value
		}
		return value.substring(0, Math.max(0, max - 3)) + '...'
	}

	private String safe(def value) {
		return value == null ? '' : String.valueOf(value).trim()
	}

	private String escape(def value) {
		String text = safe(value)
		return text
				.replace('&', '&amp;')
				.replace('<', '&lt;')
				.replace('>', '&gt;')
				.replace('"', '&quot;')
				.replace("'", '&#39;')
	}

	private String js(def value) {
		String text = safe(value)
		return text
				.replace('\\', '\\\\')
				.replace("'", "\\'")
				.replace('\r', '')
				.replace('\n', '\\n')
	}

