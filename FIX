/*
  Archive Mode - Jenkins Pipeline
  Strategy:
  - Checkout repo
  - Write run-context.properties to D:\Projects\eMatchStarters\run-context.properties
  - Trigger scheduled tasks:
      1) startWinDriver
      2) \eMatch Automation\RunEMatchDesktop
  - Wait until desktop task finishes (query schtasks status)
  - Collect reports from workspace Reports/
*/

def CFG = [
  agentLabel: 'GI5_SWDCFRNXGI55817',

  // Katalon engine exe (GUI-capable; task runs in interactive session)
  katalonExe: 'C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0\\katalonc.exe',

  // Katalon project file inside workspace
  projectFile: 'eMatch POC.prj',

  // Suite collection path for Archive Mode
  suiteCollectionPath: 'Test Suites/Archive Mode/Archive Mode Collection',

  // Scheduled tasks
  winDriverTask: 'startWinDriver',
  desktopTask: '\\eMatch Automation\\RunEMatchDesktop',

  // Where the task runner reads the context
  runContextFile: 'D:\\Projects\\eMatchStarters\\run-context.properties',

  // Timeouts
  pipelineTimeoutMinutes: 180,
  desktopTaskTimeoutMinutes: 120
]

node(CFG.agentLabel) {
  timestamps {
    ansiColor('xterm') {
      timeout(time: CFG.pipelineTimeoutMinutes, unit: 'MINUTES') {
        stage('Checkout') {
          checkout scm
        }

        stage('Validate Tools and Scheduled Tasks') {
          echo "============================================================"
          echo "VALIDATING TOOLS AND SUPPORT FILES"
          echo "============================================================"

          bat(label: 'Check schtasks', script: """
            @echo off
            schtasks /query /tn "${CFG.winDriverTask}" >nul 2>nul
            if %errorlevel% neq 0 (
              echo [ERROR] Task not found: ${CFG.winDriverTask}
              exit /b 2
            )
            schtasks /query /tn "${CFG.desktopTask}" >nul 2>nul
            if %errorlevel% neq 0 (
              echo [ERROR] Task not found: ${CFG.desktopTask}
              exit /b 3
            )
            echo [OK] Support files and scheduled tasks found
          """)
        }

        stage('Prepare Run Context') {
          def ws = pwd()
          def reportsDir = "${ws}\\Reports"
          def logsDir = "D:\\Projects\\eMatchStarters\\logs"

          def props = []
          props << "WORKSPACE=${ws}"
          props << "PROJECT_FILE=${CFG.projectFile}"
          props << "KATALON_EXE=${CFG.katalonExe}"
          props << "COLLECTION_PATH=${CFG.suiteCollectionPath}"
          props << "REPORTS_DIR=${reportsDir}"
          props << "LOG_DIR=${logsDir}"
          props << "BROWSER_TYPE=Windows"
          props << "RETRY=0"

          writeFile(file: CFG.runContextFile, text: props.join("\r\n") + "\r\n")

          echo "✅ run-context.properties written: ${CFG.runContextFile}"
          echo "📌 WORKSPACE: ${ws}"
          echo "📌 COLLECTION: ${CFG.suiteCollectionPath}"
        }

        stage('Run Archive Mode') {
          echo "============================================================"
          echo "START ASSET: Archive Mode Collection"
          echo "TASK: ${CFG.desktopTask}"
          echo "============================================================"

          // Ensure previous exit code file is cleared
          bat(label: 'Cleanup previous exitcode', script: """
            @echo off
            set WS=${pwd()}
            if exist "%WS%\\Reports\\_jenkins_task_exitcode.txt" del /f /q "%WS%\\Reports\\_jenkins_task_exitcode.txt"
          """)

          // Start WinAppDriver
          bat(label: 'Start WinDriver', script: """
            @echo off
            schtasks /run /tn "${CFG.winDriverTask}"
            if %errorlevel% neq 0 exit /b %errorlevel%
          """)

          // Start desktop task
          bat(label: 'Start Desktop Task', script: """
            @echo off
            schtasks /run /tn "${CFG.desktopTask}"
            if %errorlevel% neq 0 exit /b %errorlevel%
          """)

          // Wait until task finishes OR timeout
          timeout(time: CFG.desktopTaskTimeoutMinutes, unit: 'MINUTES') {
            bat(label: 'Wait Desktop Task', script: """
              @echo off
              :loop
              for /f "tokens=2 delims=: " %%f in ('schtasks /query /tn "${CFG.desktopTask}" /fo list ^| find "Status:"') do (
                if /I "%%f"=="Running" (
                  ping -n 6 localhost >nul 2>nul
                  goto loop
                )
              )
              echo Desktop task finished
            """)
          }

          // Stop WinAppDriver task (best effort)
          bat(label: 'Stop WinDriver', script: """
            @echo off
            schtasks /end /tn "${CFG.winDriverTask}" >nul 2>nul
            exit /b 0
          """)
        }

        stage('Collect Reports') {
          def ws = pwd()
          def reportsRoot = "${ws}\\Reports"

          // Read exit code if created by the runner .bat
          def exitFile = "${reportsRoot}\\_jenkins_task_exitcode.txt"
          if (fileExists(exitFile)) {
            def txt = readFile(exitFile).trim()
            echo "📌 Desktop task exit code: ${txt}"
            if (txt.isInteger() && txt.toInteger() != 0) {
              currentBuild.result = 'UNSTABLE'
              echo "⚠️ Katalon returned non-zero exit code: ${txt}"
            }
          } else {
            currentBuild.result = 'UNSTABLE'
            echo "⚠️ Exit code file not found: ${exitFile}"
          }

          catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
            junit(testResults: 'Reports/**/JUnit_Report.xml', allowEmptyResults: true)
          }

          catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
            archiveArtifacts(artifacts: 'Reports/**/*', allowEmptyArchive: true, fingerprint: false)
          }
        }

        stage('Trigger Next Job') {
          echo "▶️ Triggering next Jenkins job: Passerelle Bilan"
          build job: 'GI5/eMatch_Regression/Passerelle Bilan', wait: false
        }
      }
    }
  }
}
