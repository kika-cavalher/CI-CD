def publishPrimaryArtifact(script, String reportsRoot, Map result) {
    if (!(result?.screenshotRel ?: '').trim()) {
        return
    }

    def parts = result.screenshotRel.tokenize('/')
    if (!parts) {
        return
    }

    def suiteKey = safeFileName(result.name)
    def timestampPart = (parts.size() >= 2) ? parts[parts.size() - 2] : new Date().format('yyyyMMdd_HHmmss')
    def fileName = parts[parts.size() - 1]
    def srcFile = "${reportsRoot}\\${result.screenshotRel.replace('/', '\\')}"
    def destRel = "suite-artifacts/${suiteKey}/${timestampPart}/${fileName}"
    def destDir = "${reportsRoot}\\suite-artifacts\\${suiteKey}\\${timestampPart}"
    def destFile = "${reportsRoot}\\${destRel.replace('/', '\\')}"

    script.withEnv([
        "SRC_FILE=${srcFile}",
        "DEST_DIR=${destDir}",
        "DEST_FILE=${destFile}"
    ]) {
        script.powershell(
            returnStatus: true,
            script: '''
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

if (-not [string]::IsNullOrWhiteSpace($env:SRC_FILE) -and (Test-Path -LiteralPath $env:SRC_FILE)) {
    New-Item -ItemType Directory -Path $env:DEST_DIR -Force | Out-Null
    Copy-Item -LiteralPath $env:SRC_FILE -Destination $env:DEST_FILE -Force
}
'''
        )
    }

    result.primaryArtifactRel = destRel
}

def normalizeKatalonRuntimeSettings(script) {
    script.withEnv([
        "WORKSPACE_DIR=${script.pwd()}"
    ]) {
        script.powershell(
            returnStatus: true,
            script: '''
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

$workspace = $env:WORKSPACE_DIR

Write-Host '------------------------------------------------------------'
Write-Host '[INFO ] NORMALIZING KATALON RUNTIME SETTINGS FOR JENKINS'
Write-Host '------------------------------------------------------------'

function Update-PropertyFileFlags {
    param([string]$Path)

    if (-not (Test-Path -LiteralPath $Path)) {
        return
    }

    $lines = Get-Content -LiteralPath $Path -ErrorAction SilentlyContinue
    if ($null -eq $lines) {
        return
    }

    $changed = $false
    $newLines = @()

    foreach ($line in $lines) {
        $trimmed = $line.Trim()
        $lower = $trimmed.ToLowerInvariant()
        $newLine = $line

        if ($lower.Contains('self') -and $lower.Contains('heal') -and $lower.EndsWith('=true')) {
            $newLine = $line -replace '=true', '=false'
            $changed = $true
        }
        elseif ($lower.Contains('smart') -and $lower.Contains('locator') -and $lower.EndsWith('=true')) {
            $newLine = $line -replace '=true', '=false'
            $changed = $true
        }
        elseif ($lower.Contains('time') -and $lower.Contains('capsule') -and $lower.EndsWith('=true')) {
            $newLine = $line -replace '=true', '=false'
            $changed = $true
        }

        $newLines += $newLine
    }

    if ($changed) {
        Set-Content -LiteralPath $Path -Value $newLines -Encoding UTF8
        Write-Host ('[OK   ] Patched property file: ' + $Path)
    }
}

function Update-TestSuiteXml {
    param([string]$Path)

    if (-not (Test-Path -LiteralPath $Path)) {
        return
    }

    try {
        [xml]$xml = Get-Content -LiteralPath $Path -ErrorAction Stop
        $changed = $false

        $node = $xml.SelectSingleNode('//numberOfRerun')
        if ($node -and $node.InnerText -ne '0') {
            $node.InnerText = '0'
            $changed = $true
        }

        $node = $xml.SelectSingleNode('//rerunImmediately')
        if ($node -and $node.InnerText -ne 'false') {
            $node.InnerText = 'false'
            $changed = $true
        }

        $node = $xml.SelectSingleNode('//rerunFailedTestCasesOnly')
        if ($node -and $node.InnerText -ne 'false') {
            $node.InnerText = 'false'
            $changed = $true
        }

        $node = $xml.SelectSingleNode('//retryCount')
        if ($node -and $node.InnerText -ne '0') {
            $node.InnerText = '0'
            $changed = $true
        }

        if ($changed) {
            $xml.Save($Path)
            Write-Host ('[OK   ] Patched test suite xml: ' + $Path)
        }
    }
    catch {
        Write-Host ('[WARN ] Could not patch test suite xml: ' + $Path)
    }
}

$settingsDir = Join-Path $workspace 'settings'
if (Test-Path -LiteralPath $settingsDir) {
    Get-ChildItem -Path $settingsDir -Recurse -File -ErrorAction SilentlyContinue | ForEach-Object {
        Update-PropertyFileFlags -Path $_.FullName
    }
}

$consoleFile = Join-Path $workspace 'console.properties'
if (Test-Path -LiteralPath $consoleFile) {
    Update-PropertyFileFlags -Path $consoleFile
}

$testSuitesDir = Join-Path $workspace 'Test Suites'
if (Test-Path -LiteralPath $testSuitesDir) {
    Get-ChildItem -Path $testSuitesDir -Recurse -File -ErrorAction SilentlyContinue | ForEach-Object {
        Update-TestSuiteXml -Path $_.FullName
    }
}

Write-Host '[OK   ] Runtime normalization finished'
Write-Host '------------------------------------------------------------'
'''
        )
    }
}

