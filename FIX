package jiraIntegration

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil

import java.text.SimpleDateFormat
import java.util.Base64
import java.util.Locale

class JiraReportSteps {

	private static final Object LOCK = new Object()

	private static final ThreadLocal<String> CURRENT_CASE_ID = new ThreadLocal<String>()
	private static final ThreadLocal<File> CURRENT_TRACE_FILE = new ThreadLocal<File>()

	private static final SimpleDateFormat TS =
		new SimpleDateFormat('yyyy-MM-dd HH:mm:ss.SSS', Locale.ENGLISH)

	@Keyword
	def startCase(String caseId) {
		String safeCaseId = safe(caseId)
		if (safeCaseId.isEmpty()) {
			return
		}

		File traceFile = resolveTraceFile()
		CURRENT_CASE_ID.set(safeCaseId)
		CURRENT_TRACE_FILE.set(traceFile)

		append('CASE_START', safeCaseId, '')
	}

	@Keyword
	def finishCase(String status = '') {
		String caseId = safe(CURRENT_CASE_ID.get())
		if (!caseId.isEmpty()) {
			append('CASE_END', caseId, safe(status))
		}

		CURRENT_CASE_ID.remove()
		CURRENT_TRACE_FILE.remove()
	}

	@Keyword
	def note(String message) {
		String detail = safe(message)
		if (detail.isEmpty()) {
			return
		}

		KeywordUtil.logInfo('[REPORT_STEP] ' + detail)
		append('STEP', resolveCaseId(), detail)
	}

	@Keyword
	def checkpoint(String message) {
		note(message)
	}

	@Keyword
	def fail(String message) {
		String detail = safe(message)
		if (detail.isEmpty()) {
			return
		}

		KeywordUtil.logInfo('[REPORT_STEP_FAIL] ' + detail)
		append('STEP_FAIL', resolveCaseId(), detail)
	}

	@Keyword
	def captureNow(String label = 'capture') {
		try {
			new JiraImagesEvidence().captureNow(sanitizeLabel(label))
		} catch (Throwable ignored) {
		}
	}

	@Keyword
	def noteAndCapture(String message, String label = 'capture') {
		note(message)
		captureNow(label)
	}

	private void append(String type, String caseId, String payload) {
		String safeType = safe(type)
		String safeCaseId = safe(caseId)

		if (safeType.isEmpty() || safeCaseId.isEmpty()) {
			return
		}

		File traceFile = CURRENT_TRACE_FILE.get()
		if (traceFile == null) {
			traceFile = resolveTraceFile()
			CURRENT_TRACE_FILE.set(traceFile)
		}

		if (traceFile == null) {
			return
		}

		if (traceFile.parentFile != null && !traceFile.parentFile.exists()) {
			traceFile.parentFile.mkdirs()
		}

		String encoded = Base64.encoder.encodeToString(safe(payload).getBytes('UTF-8'))
		String line = safeType + '\t' + System.currentTimeMillis() + '\t' + safeCaseId + '\t' + encoded + System.lineSeparator()

		synchronized (LOCK) {
			traceFile << line
		}
	}

	private File resolveTraceFile() {
		try {
			String reportFolder = RunConfiguration.getReportFolder()
			if (safe(reportFolder).isEmpty()) {
				return null
			}
			return new File(reportFolder, '_custom_report_trace.log')
		} catch (Throwable ignored) {
			return null
		}
	}

	private String resolveCaseId() {
		String current = safe(CURRENT_CASE_ID.get())
		return current
	}

	private String sanitizeLabel(String value) {
		String text = safe(value)
			.replace('\\', '_')
			.replace('/', '_')
			.replaceAll('[^A-Za-z0-9._-]+', '_')
			.replaceAll('_+', '_')
			.replaceAll('^_+', '')
			.replaceAll('_+$', '')

		return text.isEmpty() ? 'capture' : text
	}

	private String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}
}









import com.kms.katalon.core.annotation.AfterTestCase
import com.kms.katalon.core.annotation.BeforeTestCase
import com.kms.katalon.core.context.TestCaseContext
import com.kms.katalon.core.util.KeywordUtil

class ematchReport {

	@BeforeTestCase
	def beforeCase(TestCaseContext testCaseContext) {
		String caseId = safe(testCaseContext != null ? testCaseContext.getTestCaseId() : '')

		if (caseId.isEmpty()) {
			return
		}

		try {
			CustomKeywords.'jiraIntegration.JiraReportSteps.startCase'(caseId)
		} catch (Throwable t) {
			KeywordUtil.logInfo('Report listener startCase failed: ' + safe(t.message))
		}

		try {
			CustomKeywords.'jiraIntegration.JiraImagesEvidence.startCase'(caseId)
		} catch (Throwable ignored) {
		}
	}

	@AfterTestCase
	def afterCase(TestCaseContext testCaseContext) {
		String caseId = safe(testCaseContext != null ? testCaseContext.getTestCaseId() : '')
		String status = normalizeStatus(testCaseContext != null ? testCaseContext.getTestCaseStatus() : '')
		String failureSummary = buildFailureSummary(testCaseContext != null ? testCaseContext.getMessage() : '')

		if ('FAILED'.equals(status) && !failureSummary.isEmpty()) {
			try {
				CustomKeywords.'jiraIntegration.JiraReportSteps.fail'(failureSummary)
			} catch (Throwable ignored) {
			}
		}

		if ('FAILED'.equals(status) && !caseId.isEmpty()) {
			try {
				CustomKeywords.'jiraIntegration.JiraImagesEvidence.autoFailure'(caseId)
			} catch (Throwable ignored) {
			}
		}

		try {
			CustomKeywords.'jiraIntegration.JiraReportSteps.finishCase'(status)
		} catch (Throwable t) {
			KeywordUtil.logInfo('Report listener finishCase failed: ' + safe(t.message))
		}

		try {
			CustomKeywords.'jiraIntegration.JiraImagesEvidence.finishCase'()
		} catch (Throwable ignored) {
		}
	}

	private String normalizeStatus(String rawStatus) {
		String upper = safe(rawStatus).toUpperCase(Locale.ENGLISH)

		if (upper == 'PASSED' || upper == 'PASS' || upper == 'SUCCESS') {
			return 'PASSED'
		}
		if (upper == 'FAILED' || upper == 'FAIL' || upper == 'ERROR') {
			return 'FAILED'
		}
		if (upper == 'SKIPPED' || upper == 'SKIP') {
			return 'BLOCKED'
		}
		return upper.isEmpty() ? 'UNKNOWN' : upper
	}

	private String buildFailureSummary(String rawMessage) {
		String text = safe(rawMessage)

		if (text.isEmpty()) {
			return ''
		}

		List<String> lines = text.readLines().findAll { String line ->
			!safe(line).isEmpty()
		}

		if (lines.isEmpty()) {
			return text
		}

		if (lines.size() >= 2 && safe(lines[0]).equalsIgnoreCase('Reason:')) {
			return safe(lines[1])
		}

		return safe(lines[0])
	}

	private String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}
}









