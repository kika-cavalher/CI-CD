.scenario-list-item {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 120px;
    gap: 12px;
    padding: 16px 14px;
    border: 0;
    background: #ffffff;
    text-align: left;
    cursor: pointer;
    position: relative;
    appearance: none;
    -webkit-appearance: none;
    border-radius: 0;
}

.scenario-list-item::after {
    content: "";
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 0;
    height: 1px;
    background: #dfe6ef;
}

.scenario-list-item:last-child::after {
    display: none;
}

.scenario-list-item.selected {
    border-left: 4px solid #2f86eb;
    padding-left: 10px;
    background: #f8fbff;
}


.step-row {
    position: relative;
    font-size: 13px;
    color: #15212b;
}

.step-row::after {
    content: "";
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 0;
    height: 1px;
    background: #edf2f7;
}

.step-row:last-child::after {
    display: none;
}


