package jiraIntegration

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil

import internal.GlobalVariable

import java.io.File
import java.io.FileOutputStream
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale
import java.util.zip.ZipEntry
import java.util.zip.ZipOutputStream

class JiraFlowCoordinator {

	private static final String JIRA_BASE_URL = 'https://jira-mut.d.bbg'
	private static final String PROJECT_KEY = 'GI5PRD'
	private static final String TEST_PLAN_ISSUE_TYPE_ID = '10604'
	private static final String EPIC_LINK_FIELD_ID = 'customfield_10006'

	private static final String DEFAULT_EPIC_KEY = 'GI5PRD-9877'
	private static final String TEST_PLAN_ASSIGNEE = 'cavalherer'

	private static final boolean FORCE_CREATE_NEW_TEST_PLAN = false

	/*
	 * Leave empty if your token already comes from:
	 * 1) GlobalVariable.JIRA_TOKEN
	 * 2) GlobalVariable.jiraToken
	 * 3) System env JIRA_TOKEN
	 */
	private static final String JIRA_TOKEN = ''

	@Keyword
	String jiraImport(String epicKey = '') {
		try {
			KeywordUtil.logInfo('============================================================')
			KeywordUtil.logInfo('Starting Jira import flow')
			KeywordUtil.logInfo('============================================================')

			String token = resolveToken()

			if (blank(token)) {
				throw new RuntimeException('JIRA token is empty. Fill JIRA_TOKEN or GlobalVariable.JIRA_TOKEN or env JIRA_TOKEN.')
			}

			String effectiveEpicKey = !blank(epicKey) ? safe(epicKey) : DEFAULT_EPIC_KEY

			File reportFolder = locateTargetReportFolder()
			File latestRunFolder = findLatestRunFolder(new File(RunConfiguration.getProjectDir(), 'Reports'))
			File junitXml = findJUnitXml(reportFolder)

			if (reportFolder == null || !reportFolder.exists()) {
				throw new RuntimeException('Could not locate the target report folder.')
			}

			if (junitXml == null || !junitXml.exists()) {
				throw new RuntimeException('JUnit XML was not found inside the selected report folder.')
			}

			String suiteName = safe(reportFolder.parentFile?.name)
			String executionTitle = buildExecutionTitle(suiteName, latestRunFolder)

			KeywordUtil.logInfo('Using report folder: ' + reportFolder.absolutePath)
			KeywordUtil.logInfo('Suite name detected from report path: ' + suiteName)
			KeywordUtil.logInfo('Execution title used: ' + executionTitle)
			KeywordUtil.logInfo('Test Plan title used: ' + suiteName + ' Test Plan')
			KeywordUtil.logInfo('Epic key used: ' + effectiveEpicKey)
			KeywordUtil.logInfo('Assignee used on Test Plan: ' + TEST_PLAN_ASSIGNEE)
			KeywordUtil.logInfo('JUnit XML found: ' + junitXml.absolutePath)

			File customReport = buildCustomHtmlReport(reportFolder, suiteName, executionTitle)
			KeywordUtil.logInfo('Custom Jira report created: ' + customReport.absolutePath)

			File resultsZip = new File(reportFolder, 'Results.zip')
			createZipFromFolder(reportFolder, resultsZip, [
				'Results.zip',
				'Evidences.zip'
			])
			KeywordUtil.logInfo('Results ZIP created: ' + resultsZip.absolutePath)

			File evidencesZip = createEvidencesZip(reportFolder)
			if (evidencesZip != null && evidencesZip.exists()) {
				KeywordUtil.logInfo('Evidences ZIP created: ' + evidencesZip.absolutePath)
			}

			JiraGateway gateway = new JiraGateway(JIRA_BASE_URL, token)

			JiraTestPlanManager testPlanManager = new JiraTestPlanManager(
					gateway,
					PROJECT_KEY,
					TEST_PLAN_ISSUE_TYPE_ID,
					EPIC_LINK_FIELD_ID,
					effectiveEpicKey,
					TEST_PLAN_ASSIGNEE
					)

			String testPlanKey = testPlanManager.getOrCreateTestPlanKey(
					suiteName,
					'',
					FORCE_CREATE_NEW_TEST_PLAN
					)

			List<File> attachments = []
			attachments << customReport
			attachments << resultsZip

			if (evidencesZip != null && evidencesZip.exists()) {
				attachments << evidencesZip
			}

			JiraExecutionPublisher publisher = new JiraExecutionPublisher(gateway)

			Map publishResponse = publisher.publishExecution([
				junitXml      : junitXml,
				customReport  : customReport,
				reportFolder  : reportFolder,
				projectKey    : PROJECT_KEY,
				testPlanKey   : testPlanKey,
				executionTitle: executionTitle,
				attachments   : attachments
			])

			String executionKey = safe(publishResponse.executionKey)

			KeywordUtil.logInfo('Jira import completed successfully.')
			KeywordUtil.logInfo('Test Plan key: ' + testPlanKey)
			KeywordUtil.logInfo('Execution key: ' + executionKey)
			KeywordUtil.logInfo('============================================================')

			return executionKey
		} catch (Exception e) {
			KeywordUtil.markFailed('Jira import failed: ' + safe(e.message))
			throw e
		}
	}

	private File buildCustomHtmlReport(File reportFolder, String suiteName, String executionTitle) {
		JiraReportBuilder reportBuilder = new JiraReportBuilder()
		File customReport = reportBuilder.buildReport(reportFolder, suiteName, executionTitle)

		if (customReport == null || !customReport.exists()) {
			throw new RuntimeException('Custom HTML report was not generated.')
		}

		return customReport
	}

	private String resolveToken() {
		if (!blank(JIRA_TOKEN)) {
			return JIRA_TOKEN
		}

		String envToken = System.getenv('JIRA_TOKEN')
		if (!blank(envToken)) {
			return envToken
		}

		List<String> candidates = [
			'JIRA_TOKEN',
			'jiraToken',
			'jira_token',
			'JiraToken',
			'TOKEN'
		]

		for (String fieldName : candidates) {
			try {
				def value = GlobalVariable."${fieldName}"
				if (!blank(safe(value))) {
					return safe(value)
				}
			} catch (Exception ignored) {
			}
		}

		return ''
	}

	private File locateTargetReportFolder() {
		File reportsRoot = new File(RunConfiguration.getProjectDir(), 'Reports')
		File latestRunFolder = findLatestRunFolder(reportsRoot)

		if (latestRunFolder == null || !latestRunFolder.exists()) {
			throw new RuntimeException('No timestamp report folder was found under Reports.')
		}

		List<File> candidates = []

		latestRunFolder.eachFileRecurse { File dir ->
			if (!dir.isDirectory()) {
				return
			}

			boolean hasJUnit = new File(dir, 'JUnit_Report.xml').exists()
			String lowerName = safe(dir.name).toLowerCase(Locale.ENGLISH)

			if (hasJUnit && !lowerName.contains('jira import') && !lowerName.contains('collection')) {
				candidates << dir
			}
		}

		if (candidates.isEmpty()) {
			throw new RuntimeException('No main suite report folder with JUnit_Report.xml was found.')
		}

		candidates = candidates.sort { File a, File b ->
			b.lastModified() <=> a.lastModified()
		}

		return candidates[0]
	}

	private File findLatestRunFolder(File reportsRoot) {
		if (reportsRoot == null || !reportsRoot.exists()) {
			return null
		}

		List<File> folders = reportsRoot.listFiles()?.findAll { File file ->
			file.isDirectory()
		} ?: []

		if (folders.isEmpty()) {
			return null
		}

		folders = folders.sort { File a, File b ->
			b.lastModified() <=> a.lastModified()
		}

		return folders[0]
	}

	private File findJUnitXml(File reportFolder) {
		if (reportFolder == null || !reportFolder.exists()) {
			return null
		}

		List<File> xmls = []

		reportFolder.eachFileRecurse { File file ->
			if (file.isFile() && file.name.equalsIgnoreCase('JUnit_Report.xml')) {
				xmls << file
			}
		}

		if (xmls.isEmpty()) {
			return null
		}

		xmls = xmls.sort { File a, File b ->
			b.lastModified() <=> a.lastModified()
		}

		return xmls[0]
	}

	private String buildExecutionTitle(String suiteName, File latestRunFolder) {
		String formattedDate = new SimpleDateFormat('yyyy-MM-dd HH.mm.ss').format(new Date())

		if (latestRunFolder != null) {
			try {
				Date parsed = new SimpleDateFormat('yyyyMMdd_HHmmss').parse(latestRunFolder.name)
				formattedDate = new SimpleDateFormat('yyyy-MM-dd HH.mm.ss').format(parsed)
			} catch (Exception ignored) {
			}
		}

		return safe(suiteName) + ' ' + formattedDate
	}

	private void createZipFromFolder(File sourceFolder, File targetZip, List<String> excludedNames) {
		if (sourceFolder == null || !sourceFolder.exists()) {
			return
		}

		if (targetZip.exists()) {
			targetZip.delete()
		}

		ZipOutputStream zos = null

		try {
			zos = new ZipOutputStream(new FileOutputStream(targetZip))

			sourceFolder.eachFileRecurse { File file ->
				if (!file.isFile()) {
					return
				}

				if (excludedNames?.contains(file.name)) {
					return
				}

				String relativePath = sourceFolder.toPath().relativize(file.toPath()).toString().replace('\\', '/')
				ZipEntry entry = new ZipEntry(relativePath)
				zos.putNextEntry(entry)
				zos << file.bytes
				zos.closeEntry()
			}
		} finally {
			try {
				zos?.close()
			} catch (Exception ignored) {
			}
		}
	}

	private File createEvidencesZip(File sourceFolder) {
		if (sourceFolder == null || !sourceFolder.exists()) {
			return null
		}

		List<File> images = []

		sourceFolder.eachFileRecurse { File file ->
			if (!file.isFile()) {
				return
			}

			String name = safe(file.name).toLowerCase(Locale.ENGLISH)
			if (name.endsWith('.png') || name.endsWith('.jpg') || name.endsWith('.jpeg') || name.endsWith('.gif') || name.endsWith('.bmp') || name.endsWith('.webp')) {
				images << file
			}
		}

		if (images.isEmpty()) {
			return null
		}

		File zipFile = new File(sourceFolder, 'Evidences.zip')

		if (zipFile.exists()) {
			zipFile.delete()
		}

		ZipOutputStream zos = null

		try {
			zos = new ZipOutputStream(new FileOutputStream(zipFile))

			images.each { File file ->
				String relativePath = sourceFolder.toPath().relativize(file.toPath()).toString().replace('\\', '/')
				ZipEntry entry = new ZipEntry(relativePath)
				zos.putNextEntry(entry)
				zos << file.bytes
				zos.closeEntry()
			}
		} finally {
			try {
				zos?.close()
			} catch (Exception ignored) {
			}
		}

		return zipFile
	}

	private boolean blank(String value) {
		return safe(value).isEmpty()
	}

	private String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}
}






package jiraIntegration

import com.kms.katalon.core.util.KeywordUtil

class JiraExecutionPublisher {

	private final JiraGateway gateway

	JiraExecutionPublisher(JiraGateway gateway) {
		this.gateway = gateway
	}

	Map publishExecution(Map request) {
		File junitXml = request.junitXml as File
		File customReport = request.customReport as File
		File reportFolder = request.reportFolder as File
		String projectKey = safe(request.projectKey)
		String testPlanKey = safe(request.testPlanKey)
		String executionTitle = safe(request.executionTitle)

		List<File> attachments = []
		if (request.attachments instanceof Collection) {
			attachments.addAll((request.attachments as Collection).findAll { it instanceof File } as Collection<File>)
		}

		KeywordUtil.logInfo('Importing XML file: ' + safe(junitXml?.absolutePath))

		Map importResponse = gateway.importExecutionResults(junitXml, projectKey, testPlanKey)

		KeywordUtil.logInfo('Import Results status: ' + importResponse.status)
		KeywordUtil.logInfo('Import Results response: ' + safe(importResponse.body))

		if ((importResponse.status as int) != 200) {
			throw new RuntimeException('Import execution failed with status ' + importResponse.status + '. Body: ' + safe(importResponse.body))
		}

		String executionKey = extractExecutionKey(importResponse.json)

		if (blank(executionKey)) {
			throw new RuntimeException('Import execution succeeded, but no Test Execution key was returned. Body: ' + safe(importResponse.body))
		}

		KeywordUtil.logInfo('Imported Test Execution key: ' + executionKey)

		if (!blank(executionTitle)) {
			Map renameResponse = gateway.updateIssueSummary(executionKey, executionTitle)
			KeywordUtil.logInfo('Update execution title status: ' + renameResponse.status)
			KeywordUtil.logInfo('Update execution title response: ' + safe(renameResponse.body))
		}

		KeywordUtil.logInfo('Skipping explicit addExecutionToTestPlan call because import/execution/junit already received testPlanKey.')

		List<File> finalAttachments = []
		finalAttachments.addAll(buildDefaultAttachments(reportFolder, junitXml, customReport))
		finalAttachments.addAll(attachments.findAll { File f -> f != null && f.exists() })

		finalAttachments = finalAttachments.findAll { File f ->
			f != null && f.exists()
		}.unique { File f ->
			f.absolutePath
		}

		finalAttachments.each { File file ->
			KeywordUtil.logInfo('Attaching file to Test Execution: ' + file.absolutePath)

			Map attachResponse = gateway.attachFile(executionKey, file)

			KeywordUtil.logInfo('Attachment status: ' + attachResponse.status)
			KeywordUtil.logInfo('Attachment response: ' + safe(attachResponse.body))

			if ((attachResponse.status as int) != 200) {
				KeywordUtil.logInfo('Attachment failed but Jira import will continue for file: ' + file.name)
			}
		}

		return [
			executionKey  : executionKey,
			importResponse: importResponse
		]
	}

	private List<File> buildDefaultAttachments(File reportFolder, File junitXml, File customReport) {
		List<File> files = []

		if (customReport != null && customReport.exists()) {
			files << customReport
		}

		if (junitXml != null && junitXml.exists()) {
			files << junitXml
		}

		if (reportFolder != null && reportFolder.exists()) {
			File resultsZip = new File(reportFolder, 'Results.zip')
			File evidencesZip = new File(reportFolder, 'Evidences.zip')

			if (resultsZip.exists()) {
				files << resultsZip
			}

			if (evidencesZip.exists()) {
				files << evidencesZip
			}
		}

		return files
	}

	private String extractExecutionKey(Object json) {
		if (!(json instanceof Map)) {
			return ''
		}

		Map map = json as Map

		String direct = safe(map?.testExecIssue?.key)
		if (!blank(direct)) {
			return direct
		}

		String flatKey = safe(map?.key)
		if (!blank(flatKey)) {
			return flatKey
		}

		if (map.testExecIssues instanceof List && !(map.testExecIssues as List).isEmpty()) {
			Object first = (map.testExecIssues as List)[0]
			if (first instanceof Map) {
				return safe((first as Map).key)
			}
		}

		return ''
	}

	private boolean blank(String value) {
		return safe(value).isEmpty()
	}

	private String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}
}

