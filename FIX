
import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import org.openqa.selenium.WebElement
import org.openqa.selenium.interactions.Actions

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.driver.WindowsDriverFactory
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows
import com.kms.katalon.core.windows.keyword.helper.WindowsActionHelper

import io.appium.java_client.AppiumDriver as AppiumDriver

// ======================
// CONFIGURATION
// ======================
String currEnv = Windows.getText(findWindowsObject('Object Repository/General/curEnv')).equalsIgnoreCase('Recette') ? 'Rec' : 'PROD'
String imgDir = RunConfiguration.getProjectDir() + File.separator + 'Images' + File.separator + 'BDR' + File.separator

String zoneLignes = new File(imgDir, 'ZoneLignes.png').getAbsolutePath()
String zoneLignesArrowDown = new File(imgDir, 'ZoneLignes_arrowDown.png').getAbsolutePath()
String tableColWithArrows = new File(imgDir, 'tableWithArrows.png').getAbsolutePath()

String evidenceDir = RunConfiguration.getReportFolder() + "\\Evidences\\"
new File(evidenceDir).mkdirs()

// ======================
// VALIDATE IMAGE FILES EXIST
// ======================
[zoneLignes, zoneLignesArrowDown, tableColWithArrows].each { path ->
	if (!new File(path).exists()) {
		KeywordUtil.markFailedAndStop("❌ Missing image file: ${path}")
	}
}
KeywordUtil.logInfo("✅ All image files verified for ${currEnv}")

// ======================
// STEP 1 – Click on dropdown arrow inside ZoneLignes
// ======================
try {
	Windows.delay(2)
	boolean zoneFound = WindowsImageKeywords.findImage(zoneLignes)
	if (!zoneFound) {
		KeywordUtil.markFailedAndStop("❌ Base image ZoneLignes not visible on screen.")
	}
	
	WindowsImageKeywords.clickImageInImage(zoneLignes, zoneLignesArrowDown)
	KeywordUtil.logInfo("🖱️ Clicked arrow-down inside ZoneLignes.")
} catch (Exception e) {
	KeywordUtil.markFailedAndStop("❌ Failed clicking arrow in ZoneLignes: ${e.message}")
}

// ======================
// STEP 2 – Drag from 'mois d'arrêté' to 'mesures' zone
// ======================
try {
	WebElement fromElement = Windows.findElement(findWindowsObject('Object Repository/BDR/moisDarreteDimension'))
	WebElement toElement = Windows.findElement(findWindowsObject('Object Repository/BDR/measuresListDimensions'))

	if (fromElement == null || toElement == null) {
		KeywordUtil.markFailedAndStop("❌ Could not find one or both UI elements for drag-and-drop.")
	}

	AppiumDriver<?> driver = Windows.getDriver()
	Actions action = new Actions(driver)
	action.moveToElement(fromElement)
		  .clickAndHold()
		  .moveToElement(toElement)
		  .release()
		  .perform()

	KeywordUtil.logInfo("🔀 Drag-and-drop completed from moisDarreteDimension → measuresListDimensions.")
} catch (Exception e) {
	KeywordUtil.markFailedAndStop("❌ Drag-and-drop failed: ${e.message}")
}

// ======================
// STEP 3 – Wait for table with arrows to appear
// ======================
boolean tableVisible = false
try {
	tableVisible = WindowsImageKeywords.waitForImage(tableColWithArrows, 20)
	if (tableVisible) {
		KeywordUtil.logInfo("✅ Table with arrows detected on screen.")
	} else {
		KeywordUtil.markWarning("⚠️ Table with arrows not detected after timeout.")
	}
} catch (Exception e) {
	KeywordUtil.markWarning("⚠️ Error while waiting for table image: ${e.message}")
}

// ======================
// STEP 4 – Capture Evidence
// ======================
String screenshotPath = evidenceDir + "DimensionDeselected_${currEnv}.png"
WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession()).takeScreenshot(screenshotPath)
KeywordUtil.logInfo("📸 Screenshot saved: ${screenshotPath}")

// ======================
// STEP 5 – Final Verification
// ======================
if (!WindowsImageKeywords.findImage(tableColWithArrows)) {
	KeywordUtil.markFailed("❌ The table is not expandable or not visible in ${currEnv}.")
} else {
	KeywordUtil.markPassed("✅ The table is expandable and visible in ${currEnv}.")
}
