        if (firstEvidence != null) {
            sb.append('<details class="evidence-item" open>')
            sb.append('<summary>🖼 ')
            sb.append(htmlEscape(pickFirst(firstEvidence.name, 'Open evidence')))
            sb.append('</summary>')

            if (!pickFirst(firstEvidence.href, '').isEmpty()) {
                sb.append('<div class="evidence-links">')
                sb.append('<a href="')
                sb.append(htmlEscape(firstEvidence.href))
                sb.append('" target="_blank" rel="noopener noreferrer">🔎 Open evidence</a>')
                sb.append('</div>')
            }

            if (Boolean.TRUE.equals(firstEvidence.image) && !pickFirst(firstEvidence.imgSrc, '').isEmpty()) {
                sb.append('<img class="evidence-image" src="')
                sb.append(htmlEscape(firstEvidence.imgSrc))
                sb.append('" alt="Evidence">')
            }

            sb.append('</details>')
        } else {
            sb.append('<div class="evidence-empty">No evidence was found for this scenario.</div>')
        }

        sb.append('</div>')
        sb.append('</section>')

        return sb.toString()
    }

    private String buildStepRow(Map step) {
        StringBuilder sb = new StringBuilder()

        sb.append('<div class="step-row">')
        sb.append('<div class="col-status">')
        sb.append('<span class="status-pill ')
        sb.append(htmlEscape(step.status))
        sb.append('">')
        sb.append(htmlEscape(statusLabel(step.status)))
        sb.append('</span>')
        sb.append('</div>')

