	}

	private void waitUntilFileBrowserIsOpened() {
		KeywordUtil.logInfo("Waiting until File Browser is opened")

		for (int attempt = 1; attempt <= MAX_ATTEMPTS; attempt++) {
			KeywordUtil.logInfo("File Browser validation attempt: " + attempt + "/" + MAX_ATTEMPTS)

			boolean fileBrowserTitleVisible = isObjectPresent('FILE_BROWSER_TITLE', SHORT_TIMEOUT)

			if (fileBrowserTitleVisible) {
				KeywordUtil.logInfo("File Browser title is visible")
				return
			}

			WebUI.delay(1)
		}

		KeywordUtil.markFailedAndStop("File Browser was not opened after clicking Files menu.")
	}

	private void openFileBrowserPath(String fileBrowserPath) {
		fileBrowserPath = normalizePath(fileBrowserPath)
		currentFileBrowserPath = fileBrowserPath

		KeywordUtil.logInfo("Opening File Browser path using breadcrumb input: " + currentFileBrowserPath)

		for (int attempt = 1; attempt <= MAX_ATTEMPTS; attempt++) {
			KeywordUtil.logInfo("Open File Browser path attempt: " + attempt + "/" + MAX_ATTEMPTS)

			boolean breadcrumbInputOpened = openEditableFileBrowserBreadcrumb()

			if (!breadcrumbInputOpened) {
				KeywordUtil.logInfo("Breadcrumb input was not opened on attempt: " + attempt)
				WebUI.delay(1)
				continue
			}

			boolean pathFilled = pasteFileBrowserPathIntoInput(currentFileBrowserPath)

			if (!pathFilled) {
				KeywordUtil.logInfo("File Browser path input was not filled on attempt: " + attempt)
				WebUI.delay(1)
				continue
			}

			pressEnterOnFileBrowserPathInput()

			WebUI.delay(10)
			WebUI.waitForPageLoad(DEFAULT_TIMEOUT)

			KeywordUtil.logInfo("File Browser path was submitted using ENTER: " + currentFileBrowserPath)
			return
		}

		KeywordUtil.markFailedAndStop("File Browser path was not opened after " + MAX_ATTEMPTS + " attempts. Path: " + currentFileBrowserPath)
	}

	private boolean openEditableFileBrowserBreadcrumb() {
		KeywordUtil.logInfo("Opening editable File Browser breadcrumb by clicking empty area after breadcrumb text")

		TestObject breadcrumbContainer = getFileBrowserBreadcrumbContainerObject()
		TestObject breadcrumbPathInput = getNavigationObject('FILE_BROWSER_PATH_INPUT')

		for (int attempt = 1; attempt <= MAX_ATTEMPTS; attempt++) {
			KeywordUtil.logInfo("Opening editable breadcrumb attempt: " + attempt + "/" + MAX_ATTEMPTS)

			WebUI.waitForElementPresent(
					breadcrumbContainer,
					DEFAULT_TIMEOUT,
					FailureHandling.STOP_ON_FAILURE
			)

			try {
				WebElement breadcrumbContainerElement = WebUI.findWebElement(breadcrumbContainer, DEFAULT_TIMEOUT)

				WebUI.executeJavaScript(
						"""
						const container = arguments[0];

						container.scrollIntoView({ block: 'center', inline: 'center' });

						const containerRect = container.getBoundingClientRect();
						const lastLink = container.querySelector('a:last-of-type');
						const linkRect = lastLink ? lastLink.getBoundingClientRect() : containerRect;

						const emptyAreaX = Math.min(containerRect.right - 10, linkRect.right + 35);
						const emptyAreaY = containerRect.top + (containerRect.height / 2);

						const target = document.elementFromPoint(emptyAreaX, emptyAreaY) || container;

						const eventOptions = {
							bubbles: true,
							cancelable: true,
							view: window,
							clientX: emptyAreaX,
							clientY: emptyAreaY,
							button: 0
						};

						target.dispatchEvent(new MouseEvent('mouseover', eventOptions));
						target.dispatchEvent(new MouseEvent('mousemove', eventOptions));
						target.dispatchEvent(new MouseEvent('mousedown', eventOptions));
						target.dispatchEvent(new MouseEvent('mouseup', eventOptions));
						target.dispatchEvent(new MouseEvent('click', eventOptions));
						target.dispatchEvent(new MouseEvent('mousedown', eventOptions));
						target.dispatchEvent(new MouseEvent('mouseup', eventOptions));
						target.dispatchEvent(new MouseEvent('click', eventOptions));
						target.dispatchEvent(new MouseEvent('dblclick', {
							bubbles: true,
							cancelable: true,
							view: window,
							clientX: emptyAreaX,
							clientY: emptyAreaY,
							button: 0,
							detail: 2
						}));
						""",
						Arrays.asList(breadcrumbContainerElement)
				)
			} catch (Exception e) {
				KeywordUtil.logInfo("JavaScript empty area click failed. Trying Actions click by offset.")

				WebElement breadcrumbContainerElement = WebUI.findWebElement(breadcrumbContainer, DEFAULT_TIMEOUT)

				Actions actions = new Actions(DriverFactory.getWebDriver())

				actions
						.moveToElement(breadcrumbContainerElement, 180, 12)
						.click()
						.pause(500)
						.doubleClick()
						.perform()
			}

			WebUI.delay(2)

			if (isFileBrowserPathInputReady(breadcrumbPathInput)) {
				KeywordUtil.logInfo("Editable File Browser path input is visible")
				return true
			}

			KeywordUtil.logInfo("Editable File Browser path input is not visible yet. Retrying.")
			WebUI.delay(1)
		}

		KeywordUtil.logInfo("Editable File Browser path input was not visible after clicking empty breadcrumb area")
		return false
	}

	private boolean isFileBrowserPathInputReady(TestObject breadcrumbPathInput) {
		try {
			WebElement inputElement = WebUI.findWebElement(breadcrumbPathInput, SHORT_TIMEOUT)

			String displayValue = inputElement.getCssValue('display')
			String visibilityValue = inputElement.getCssValue('visibility')

			KeywordUtil.logInfo("Breadcrumb input display value: " + displayValue)
			KeywordUtil.logInfo("Breadcrumb input visibility value: " + visibilityValue)

			return !displayValue.equalsIgnoreCase('none') && !visibilityValue.equalsIgnoreCase('hidden')
		} catch (Exception ignored) {
			return false
		}
	}

	private boolean pasteFileBrowserPathIntoInput(String fileBrowserPath) {
		KeywordUtil.logInfo("Pasting File Browser path into breadcrumb input: " + fileBrowserPath)

		TestObject breadcrumbPathInput = getNavigationObject('FILE_BROWSER_PATH_INPUT')

		WebUI.waitForElementPresent(
				breadcrumbPathInput,
				DEFAULT_TIMEOUT,
				FailureHandling.STOP_ON_FAILURE
		)

		WebElement breadcrumbInputElement = WebUI.findWebElement(breadcrumbPathInput, DEFAULT_TIMEOUT)

		try {
			breadcrumbInputElement.click()
			WebUI.delay(1)

			copyTextToClipboard(fileBrowserPath)

			Actions actions = new Actions(DriverFactory.getWebDriver())

			actions
					.keyDown(Keys.CONTROL)
					.sendKeys("a")
					.keyUp(Keys.CONTROL)
					.sendKeys(Keys.DELETE)
					.perform()

			WebUI.delay(1)

			actions
					.keyDown(Keys.CONTROL)
					.sendKeys("v")
					.keyUp(Keys.CONTROL)
					.perform()

			WebUI.delay(2)
		} catch (Exception e) {
			KeywordUtil.logInfo("Clipboard paste failed. Trying JavaScript input value.")
		}

		String actualValue = getInputValue(breadcrumbInputElement)

		if (actualValue.contains(fileBrowserPath)) {
			KeywordUtil.logInfo("File Browser path input value after paste: " + actualValue)
			return true
		}

		KeywordUtil.logInfo("Trying JavaScript value setter for File Browser path input.")

		WebUI.executeJavaScript(
				"""
				const input = arguments[0];
				const value = arguments[1];

				input.focus();

				const nativeInputValueSetter = Object.getOwnPropertyDescriptor(window.HTMLInputElement.prototype, 'value').set;

				nativeInputValueSetter.call(input, '');
				input.dispatchEvent(new Event('input', { bubbles: true }));
				input.dispatchEvent(new Event('change', { bubbles: true }));

				nativeInputValueSetter.call(input, value);
				input.dispatchEvent(new Event('input', { bubbles: true }));
				input.dispatchEvent(new Event('change', { bubbles: true }));
				""",
				Arrays.asList(breadcrumbInputElement, fileBrowserPath)
		)

		WebUI.delay(1)

		actualValue = getInputValue(breadcrumbInputElement)

		if (actualValue.contains(fileBrowserPath)) {
			KeywordUtil.logInfo("File Browser path input value after JavaScript setter: " + actualValue)
			return true
		}

		KeywordUtil.logInfo("File Browser path input was not filled. Actual value: " + actualValue)
		return false
	}

	private void pressEnterOnFileBrowserPathInput() {
		KeywordUtil.logInfo("Pressing ENTER on File Browser breadcrumb input")

		TestObject breadcrumbPathInput = getNavigationObject('FILE_BROWSER_PATH_INPUT')

		WebUI.waitForElementPresent(
				breadcrumbPathInput,
				DEFAULT_TIMEOUT,
				FailureHandling.STOP_ON_FAILURE
		)

		WebElement breadcrumbInputElement = WebUI.findWebElement(breadcrumbPathInput, DEFAULT_TIMEOUT)

		try {
			breadcrumbInputElement.click()
			WebUI.delay(1)

			Actions actions = new Actions(DriverFactory.getWebDriver())

			actions
					.sendKeys(Keys.ENTER)
					.perform()
		} catch (Exception e) {
			KeywordUtil.logInfo("Normal ENTER failed. Trying JavaScript ENTER events.")

			WebUI.executeJavaScript(
					"""
					const input = arguments[0];

					input.focus();

					input.dispatchEvent(new KeyboardEvent('keydown', {
						bubbles: true,
						cancelable: true,
						key: 'Enter',
						code: 'Enter',
						keyCode: 13,
						which: 13
					}));

					input.dispatchEvent(new KeyboardEvent('keypress', {
						bubbles: true,
						cancelable: true,
						key: 'Enter',
						code: 'Enter',
						keyCode: 13,
						which: 13
					}));

					input.dispatchEvent(new KeyboardEvent('keyup', {
						bubbles: true,
						cancelable: true,
						key: 'Enter',
						code: 'Enter',
						keyCode: 13,
						which: 13
					}));
					""",
					Arrays.asList(breadcrumbInputElement)
			)
		}

		WebUI.delay(3)
	}

	private void waitUntilFileBrowserFilesAreLoaded() {
		KeywordUtil.logInfo("Waiting until File Browser files are loaded")

		for (int attempt = 1; attempt <= DEFAULT_TIMEOUT; attempt++) {
			boolean fileRowVisible = isObjectPresent('FILE_BROWSER_THIRD_FILE_ROW', 1)

			if (fileRowVisible) {
				KeywordUtil.logInfo("File Browser files were loaded")
				return
			}

			WebUI.delay(1)
		}

		KeywordUtil.markFailedAndStop("File Browser files were not loaded after " + DEFAULT_TIMEOUT + " seconds.")
	}

	private WebElement getDatabaseSearchInputElement() {
		TestObject searchInput = getNavigationObject('DATABASE_SEARCH')

		try {
			return WebUI.findWebElement(searchInput, SHORT_TIMEOUT)
		} catch (Exception e) {
			KeywordUtil.logInfo("Object Repository input was not found. Trying fallback XPath.")

			return WebUI.findWebElement(getFallbackDatabaseSearchInputObject(), DEFAULT_TIMEOUT)
		}
	}

	private TestObject getFallbackDatabaseSearchInputObject() {
		TestObject fallbackInput = new TestObject('Dynamic_Navigation_InputDatabaseSearch')

		fallbackInput.addProperty(
				'xpath',
				ConditionType.EQUALS,
				"//input[contains(@placeholder,'Filter')]"
		)

		return fallbackInput
	}

	private TestObject getFileBrowserBreadcrumbContainerObject() {
		TestObject breadcrumbContainer = new TestObject('Dynamic_Navigation_FileBrowserBreadcrumbContainer')

		breadcrumbContainer.addProperty(
				'xpath',
				ConditionType.EQUALS,
				"//ul[@id='editBreadcrumb']"
		)

		return breadcrumbContainer
	}

	private boolean isDatabaseResultVisible(String databaseName, int timeoutInSeconds) {
		try {
			TestObject databaseResult = getDatabaseResultObject(databaseName)

			return WebUI.verifyElementPresent(
					databaseResult,
					timeoutInSeconds,
					FailureHandling.OPTIONAL
			)
		} catch (Exception ignored) {
			return false
		}
	}

	private boolean isSelectedDatabaseTitleVisible(String databaseName, int timeoutInSeconds) {
		try {
			TestObject selectedDatabaseTitle = getSelectedDatabaseTitleObject(databaseName)

			return WebUI.verifyElementPresent(
					selectedDatabaseTitle,
					timeoutInSeconds,
					FailureHandling.OPTIONAL
			)
		} catch (Exception ignored) {
			return false
		}
	}

	private TestObject getDatabaseResultObject(String databaseName) {
		try {
			return HueObjectRepository.navigation('DATABASE_RESULT', [('databaseName') : databaseName])
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop("Object Repository item was not found: DATABASE_RESULT")
			return null
		}
	}

	private TestObject getSelectedDatabaseTitleObject(String databaseName) {
		try {
			return HueObjectRepository.navigation('SELECTED_DATABASE_TITLE', [('databaseName') : databaseName])
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop("Object Repository item was not found: SELECTED_DATABASE_TITLE")
			return null
		}
	}

	private TestObject getNavigationObject(String objectKey) {
		try {
			return HueObjectRepository.navigation(objectKey)
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop("Object Repository item was not found for key: " + objectKey)
			return null
		}
	}

	private boolean isObjectPresent(String objectKey, int timeoutInSeconds) {
		try {
			TestObject testObject = getNavigationObject(objectKey)

			if (testObject == null) {
				return false
			}

			return WebUI.verifyElementPresent(
					testObject,
					timeoutInSeconds,
					FailureHandling.OPTIONAL
			)
		} catch (Exception ignored) {
			return false
		}
	}

	private String getInputValue(WebElement inputElement) {
		try {
			String value = inputElement.getAttribute('value')
			return value == null ? '' : value.trim()
		} catch (Exception ignored) {
			return ''
		}
	}

	private void copyTextToClipboard(String text) {
		StringSelection stringSelection = new StringSelection(text)
		Toolkit.getDefaultToolkit().getSystemClipboard().setContents(stringSelection, null)
	}

	private String normalizeDatabaseName(String databaseName) {
		String normalizedDatabaseName = databaseName == null ? '' : databaseName.trim()

		if (normalizedDatabaseName.length() == 0) {
			KeywordUtil.markFailedAndStop("Database name is empty")
		}

		return normalizedDatabaseName
	}

	private String normalizePath(String path) {
		String normalizedPath = path == null ? '' : path.trim()

		if (normalizedPath.length() == 0) {
			KeywordUtil.markFailedAndStop("File Browser path is empty")
		}

		return normalizedPath
	}
}
