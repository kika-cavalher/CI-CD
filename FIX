	private String sanitizeFileName(
			String text) {

		if (text == null ||
				text.trim().isEmpty()) {

			return 'Export'
		}

		String normalized =
				Normalizer
				.normalize(
				text,
				Normalizer.Form.NFD
				)
				.replaceAll(
				'\\p{InCombiningDiacriticalMarks}+',
				''
				)

		String cleaned =
				normalized
				.replaceAll(
				'[\\\\/:*?"<>|]',
				'_'
				)
				.replaceAll(
				'\\s+',
				'_'
				)
				.replaceAll(
				'_+',
				'_'
				)
				.replaceAll(
				'^_|_$',
				''
				)
				.trim()

		return cleaned.isEmpty()
				? 'Export'
				: cleaned
	}


	private String shortenFilePart(
			String value,
			Integer maximumLength) {

		if (value == null ||
				value.trim().isEmpty()) {

			return ''
		}

		int safeMaximum =
				maximumLength == null ||
				maximumLength <= 0
				? 20
				: maximumLength

		String cleanValue =
				sanitizeFileName(
				value
				)

		return cleanValue.length() <= safeMaximum
				? cleanValue
				: cleanValue.substring(
				0,
				safeMaximum
				)
	}


	private String removeExcelExtension(
			String fileName) {

		String value =
				fileName == null
				? ''
				: fileName.trim()

		return value.replaceFirst(
				'(?i)\\.(xlsx|xlsm|xls)$',
				''
				)
	}


	private String safeLogText(
			Object value) {

		if (value == null ||
