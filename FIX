// ======================================================
	// OPEN FAVORITE
	// ======================================================

	@Keyword
	void closeAllTabsAndOpenFavorite(
		String favoriteTitle,
		String openedTabName,
		String favoriteImageKey,
		Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds, 40)
		WindowsTestObject openedTab =
			WindowsObjectLoader.getTabByName(openedTabName)

		logStep(
			'OPEN FAVORITE',
			'Favorite: ' + favoriteTitle + '\n' +
			'Expected tab: ' + openedTabName
		)

		// Extra protection in case the favorite confirmation modal is still visible.
		Windows.delay(5)

		if (!clickFirstVisibleImage(
			GENERAL_IMAGE_GROUP,
			['okModal', 'okModal2Version'],
			2
		)) {
			pressKeyboardKey(KeyEvent.VK_ENTER)
		}

		Windows.delay(2)

		for (int attempt = 1; attempt <= 3; attempt++) {

			boolean tabStillPresent = Windows.waitForElementPresent(
				openedTab,
				1,
				FailureHandling.OPTIONAL
			)

			if (!tabStillPresent) {
				break
			}

			KeywordUtil.logInfo(
				'[CLOSE TABS] Attempt ' + attempt + ' of 3.'
			)

			WindowsTestObject closeAllTabsButton =
				object('closeAllTabsTopBar')

			if (!Windows.waitForElementPresent(
				closeAllTabsButton,
				5,
				FailureHandling.OPTIONAL
			)) {
				takeEvidence('GUI_CloseAllTabsButtonNotFound.png')

				KeywordUtil.markFailedAndStop(
					'Close All Tabs button was not found.'
				)

				return
			}

			Windows.click(
				closeAllTabsButton,
				FailureHandling.STOP_ON_FAILURE
			)

			Windows.delay(2)

			boolean closeConfirmed = clickFirstVisibleImage(
				GENERAL_IMAGE_GROUP,
				['yes', 'yesUnderline', 'yesButton', 'oui'],
				3
			)

			if (!closeConfirmed) {
				pressKeyboardKey(KeyEvent.VK_ENTER)
			}

			Windows.delay(5)
		}

		if (Windows.waitForElementPresent(
			openedTab,
			2,
			FailureHandling.OPTIONAL
		)) {
			takeEvidence('GUI_TabsNotClosed.png')

			KeywordUtil.markFailedAndStop(
				'Opened tab is still visible after 3 close attempts.\n' +
				'Tab: ' + openedTabName
			)

			return
		}

		WindowsTestObject favoritesTab =
			object('favoritesTab')

		if (!Windows.waitForElementPresent(
			favoritesTab,
			5,
			FailureHandling.OPTIONAL
		)) {
			takeEvidence('GUI_FavoritesTabNotFound.png')

			KeywordUtil.markFailedAndStop(
				'Favorites tab was not found.'
			)

			return
		}

		Windows.click(
			favoritesTab,
			FailureHandling.STOP_ON_FAILURE
		)

		Windows.delay(3)

		WindowsTestObject favoriteItem =
			WindowsObjectLoader.getTreeItemByName(
				favoriteTitle
			)

		boolean favoriteFound = Windows.waitForElementPresent(
			favoriteItem,
			timeout,
			FailureHandling.OPTIONAL
		)

		if (favoriteFound) {
			Windows.click(
				favoriteItem,
				FailureHandling.STOP_ON_FAILURE
			)
		} else {
			boolean clickedByImage = false

			if (!safeText(favoriteImageKey).isEmpty()) {
				clickedByImage = clickFirstVisibleImage(
					GUI_IMAGE_GROUP,
					[favoriteImageKey],
					5
				)
			}

			if (!clickedByImage) {
				takeEvidence('GUI_CreatedFavoriteNotFound.png')

				KeywordUtil.markFailedAndStop(
					'Created favorite was not found by element or image.\n' +
					'Favorite: ' + favoriteTitle + '\n' +
					'Image key: ' + favoriteImageKey
				)

				return
			}
		}

		boolean favoriteOpened = Windows.waitForElementPresent(
			openedTab,
			timeout,
			FailureHandling.OPTIONAL
		)

		if (!favoriteOpened) {
			takeEvidence('GUI_CreatedFavoriteTabNotOpened.png')

			KeywordUtil.markFailedAndStop(
				'Favorite was selected, but the expected tab was not opened.\n' +
				'Expected tab: ' + openedTabName
			)

			return
		}

		takeEvidence('GUI_CreatedFavoriteOpened.png')

		KeywordUtil.markPassed(
			'Created favorite was opened successfully.\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'Tab: ' + openedTabName
		)
	}
