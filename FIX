// ======================================================
// FINAL RESULT
// ======================================================

if (!success) {

	String finalErrorMessage =
		errors.isEmpty()
			? 'REC x PRD PNL Eco validation returned an unsuccessful result without an error description.'
			: errors

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[FAIL] Final PNL Eco validation result\n' +
		finalErrorMessage +
		(
			passedDetails.isEmpty()
				? ''
				: '\n\nSuccessful validations\n' +
					passedDetails
		)
	)

	KeywordUtil.markFailed(
		'REC x PRD validation failed for ' +
		validationName +
		'.\n' +
		finalErrorMessage
	)

} else {

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[PASS] Final PNL Eco validation result\n' +
		'REC x PRD validation completed successfully.\n' +
		passedDetails
	)

	KeywordUtil.markPassed(
		'REC x PRD validation completed successfully for ' +
		validationName +
		'.'
	)
}


// ======================================================
// HELPERS
// ======================================================

String displayValue(
		Object value,
		String emptyMessage
) {

	String text =
		safeText(
			value
			)

	return text.isEmpty()
		? emptyMessage
		: text
}


String safeText(
		Object value
) {

	if (value == null) {
		return ''
	}

	return value
		.toString()
		.trim()
}








