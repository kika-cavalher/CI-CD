package jiraIntegration

import static com.kms.katalon.core.testobject.ObjectRepository.findTestObject

import java.io.File
import java.net.URLEncoder
import java.nio.charset.StandardCharsets

import com.kms.katalon.core.testobject.ConditionType
import com.kms.katalon.core.testobject.RequestObject
import com.kms.katalon.core.testobject.TestObjectProperty
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webservice.keyword.WSBuiltInKeywords as WS

import groovy.json.JsonOutput
import groovy.json.JsonSlurper

class JiraGateway {

	JiraFlowCoordinator owner

	JiraGateway(JiraFlowCoordinator owner) {
		this.owner = owner
	}

	void validateRequiredConfiguration() {
		if (owner.isBlank(owner.JIRA_TOKEN)) {
			KeywordUtil.markFailed("JIRA_TOKEN is empty.")
		}

		if (owner.isBlank(owner.PROJECT_KEY)) {
			KeywordUtil.markFailed("PROJECT_KEY is empty.")
		}

		if (owner.isBlank(owner.EPIC_KEY)) {
			KeywordUtil.markFailed("EPIC_KEY is empty.")
		}

		if (owner.isBlank(owner.JIRA_BASE_URL)) {
			KeywordUtil.markFailed("JIRA_BASE_URL is empty.")
		}
	}

	String importExecutionResults(String xmlPath) {
		def response = WS.sendRequest(findTestObject('Jira Integration/Import Results', [
			('filePath'): xmlPath,
			('project') : owner.PROJECT_KEY,
			('baseUrl') : owner.JIRA_BASE_URL,
			('token')   : owner.JIRA_TOKEN
		]))

		int status = WS.getResponseStatusCode(response)
		String body = owner.safe(response.getResponseBodyContent())

		KeywordUtil.logInfo("Import results status: ${status}")
		KeywordUtil.logInfo("Import results response: ${body}")

		if (!(status in [200, 201, 204])) {
			return 'ERROR' + status
		}

		def parsed = body ? new JsonSlurper().parseText(body) : [:]
		String executionKey = owner.safe(parsed?.testExecIssue?.key)

		if (owner.isBlank(executionKey)) {
			return 'ERROR_NO_EXEC_KEY'
		}

		return executionKey
	}

	Map searchTestPlans(String summary, String epicKey) {
		String jql =
			'project = "' + owner.PROJECT_KEY + '" ' +
			'AND issuetype = "Test Plan" ' +
			'ORDER BY created DESC'

		KeywordUtil.logInfo("Searching Test Plan using JQL: ${jql}")

		try {
			String encodedJql = URLEncoder.encode(jql, StandardCharsets.UTF_8.toString())
			String encodedFields = URLEncoder.encode('summary,created,issuetype', StandardCharsets.UTF_8.toString())

			String url =
				owner.JIRA_BASE_URL +
				'/rest/api/2/search' +
				'?jql=' + encodedJql +
				'&maxResults=200' +
				'&fields=' + encodedFields

			RequestObject request = new RequestObject('Runtime Search Test Plan')
			request.setRestUrl(url)
			request.setRestRequestMethod('GET')
			request.setHttpHeaderProperties([
				new TestObjectProperty('Authorization', ConditionType.EQUALS, 'Bearer ' + owner.JIRA_TOKEN),
				new TestObjectProperty('Accept', ConditionType.EQUALS, 'application/json')
			])

			def response = WS.sendRequest(request)

			int status = WS.getResponseStatusCode(response)
			String body = owner.safe(response.getResponseBodyContent())

			KeywordUtil.logInfo("Get Test Plan status: ${status}")
			KeywordUtil.logInfo("Get Test Plan response: ${body}")

			if (status != 200) {
				return [
					ok    : false,
					status: status,
					error : body,
					issues: []
				]
			}

			def parsed = body ? new JsonSlurper().parseText(body) : [:]
			List issues = parsed?.issues instanceof List ? parsed.issues : []

			return [
				ok    : true,
				status: status,
				error : '',
				issues: issues
			]
		} catch (Exception e) {
			KeywordUtil.logInfo("Get Test Plan request failed: ${e.message}")
			return [
				ok    : false,
				status: 0,
				error : e.message,
				issues: []
			]
		}
	}

	Map getIssueByKey(String issueKey) {
		if (owner.isBlank(issueKey)) {
			return [
				ok    : false,
				status: 0,
				error : 'Issue key is empty.',
				issue : null
			]
		}

		try {
			String encodedFields = URLEncoder.encode('summary,created,issuetype', StandardCharsets.UTF_8.toString())

			String url =
				owner.JIRA_BASE_URL +
				'/rest/api/2/issue/' + issueKey +
				'?fields=' + encodedFields

			RequestObject request = new RequestObject('Runtime Get Issue By Key')
			request.setRestUrl(url)
			request.setRestRequestMethod('GET')
			request.setHttpHeaderProperties([
				new TestObjectProperty('Authorization', ConditionType.EQUALS, 'Bearer ' + owner.JIRA_TOKEN),
				new TestObjectProperty('Accept', ConditionType.EQUALS, 'application/json')
			])

			def response = WS.sendRequest(request)

			int status = WS.getResponseStatusCode(response)
			String body = owner.safe(response.getResponseBodyContent())

			KeywordUtil.logInfo("Get issue by key status: ${status}")
			KeywordUtil.logInfo("Get issue by key response: ${body}")

			if (status != 200) {
				return [
					ok    : false,
					status: status,
					error : body,
					issue : null
				]
			}

			def parsed = body ? new JsonSlurper().parseText(body) : [:]

			return [
				ok    : true,
				status: status,
				error : '',
				issue : parsed
			]
		} catch (Exception e) {
			KeywordUtil.logInfo("Get issue by key request failed: ${e.message}")
			return [
				ok    : false,
				status: 0,
				error : e.message,
				issue : null
			]
		}
	}

	String createTestPlan(String summary, String epicKey) {
		def response = WS.sendRequest(findTestObject('Jira Integration/Create Test Plan', [
			('token')  : owner.JIRA_TOKEN,
			('project'): owner.PROJECT_KEY,
			('summary'): summary,
			('epic')   : epicKey
		]))

		int status = WS.getResponseStatusCode(response)
		String body = owner.safe(response.getResponseBodyContent())

		KeywordUtil.logInfo("Create Test Plan status: ${status}")
		KeywordUtil.logInfo("Create Test Plan response: ${body}")

		if (!(status in [200, 201])) {
			return 'ERROR' + status
		}

		def parsed = body ? new JsonSlurper().parseText(body) : [:]
		return owner.safe(parsed?.key)
	}

	int addExecutionToTestPlan(String testPlanKey, String executionKey) {
		String jsonBody = JsonOutput.toJson([
			addTestsToPlan: true,
			add           : [executionKey]
		])

		def response = WS.sendRequest(findTestObject('Jira Integration/Update Test Plan', [
			('token')      : owner.JIRA_TOKEN,
			('testPlanKey'): testPlanKey,
			('jsonBody')   : jsonBody
		]))

		int status = WS.getResponseStatusCode(response)
		KeywordUtil.logInfo("Add execution to Test Plan status: ${status}")
		return status
	}

	int updateTestExecution(String executionKey, String executionSummary, String labels, String environment) {
		def response = WS.sendRequest(findTestObject('Jira Integration/Update Test Execution Name', [
			('issueID'): executionKey,
			('token')  : owner.JIRA_TOKEN,
			('summary'): executionSummary,
			('labels') : labels,
			('env')    : environment
		]))

		int status = WS.getResponseStatusCode(response)
		KeywordUtil.logInfo("Update Test Execution status: ${status}")
		return status
	}

	int uploadAttachment(String issueKey, String filePath) {
		if (owner.isBlank(filePath)) {
			return 0
		}

		File file = new File(filePath)
		if (!file.exists() || !file.isFile() || file.length() <= 0) {
			KeywordUtil.logInfo("Skipping attachment upload because file path is empty or invalid: ${filePath}")
			return 0
		}

		def response = WS.sendRequest(findTestObject('Jira Integration/Evidence attachment', [
			('token')    : owner.JIRA_TOKEN,
			('evidences'): file,
			('execID')   : issueKey
		]))

		int status = WS.getResponseStatusCode(response)
		String body = owner.safe(response.getResponseBodyContent())

		KeywordUtil.logInfo("Upload attachment status: ${status}")
		KeywordUtil.logInfo("Upload attachment response: ${body}")

		return status
	}
}









package jiraIntegration

import com.kms.katalon.core.util.KeywordUtil

class JiraTestPlanManager {

	JiraFlowCoordinator owner
	JiraGateway gateway

	JiraTestPlanManager(JiraFlowCoordinator owner, JiraGateway gateway) {
		this.owner = owner
		this.gateway = gateway
	}

	String findExistingTestPlanKey(String summary) {
		if (owner.FORCE_CREATE_NEW_TEST_PLAN) {
			KeywordUtil.logInfo("FORCE_CREATE_NEW_TEST_PLAN enabled. A new Test Plan will be created.")
			return ''
		}

		if (!owner.isBlank(owner.MANUAL_TEST_PLAN_KEY)) {
			KeywordUtil.logInfo("Using manual Test Plan key: ${owner.MANUAL_TEST_PLAN_KEY}")
			return owner.MANUAL_TEST_PLAN_KEY
		}

		String expectedSummary = owner.normalizeTitle(summary)

		String savedKey = owner.readSavedSuiteTestPlanKey()
		if (!owner.isBlank(savedKey)) {
			Map savedIssueResult = gateway.getIssueByKey(savedKey)

			if (savedIssueResult.ok) {
				String savedSummary = owner.safe(savedIssueResult.issue?.fields?.summary)
				String savedType = owner.safe(savedIssueResult.issue?.fields?.issuetype?.name)

				if (owner.normalizeTitle(savedSummary) == expectedSummary &&
					owner.normalizeTitle(savedType) == 'test plan') {
					KeywordUtil.logInfo("Using saved Test Plan key for suite ${owner.getCurrentSuiteName()}: ${savedKey}")
					return savedKey
				}

				KeywordUtil.logInfo("Saved Test Plan key ignored because summary/type do not match current suite.")
			} else {
				KeywordUtil.logInfo("Saved Test Plan key could not be validated. Search will continue. Error: ${savedIssueResult.error}")
			}
		}

		Map searchResult = gateway.searchTestPlans(summary, owner.EPIC_KEY)

		if (!searchResult.ok) {
			KeywordUtil.logInfo("Search Test Plan failed. Status: ${searchResult.status}. Error: ${searchResult.error}")
			return searchResult.status > 0 ? "ERROR_SEARCH_${searchResult.status}" : "ERROR_SEARCH_REQUEST"
		}

		List issues = searchResult.issues instanceof List ? searchResult.issues : []

		List exactMatches = issues.findAll { issue ->
			owner.normalizeTitle(issue?.fields?.summary) == expectedSummary
		}

		if (exactMatches.isEmpty()) {
			KeywordUtil.logInfo("No existing Test Plan found for summary: ${summary}")
			return ''
		}

		if (exactMatches.size() > 1) {
			KeywordUtil.logInfo("Multiple Test Plans found with same summary. The newest one will be used. Count: ${exactMatches.size()}")
		}

		def chosen = exactMatches[0]
		String foundKey = owner.safe(chosen?.key)

		if (!owner.isBlank(foundKey)) {
			owner.saveSuiteTestPlanKey(foundKey)
			KeywordUtil.logInfo("Existing Test Plan found by exact summary: ${foundKey}")
			return foundKey
		}

		return ''
	}

	String getOrCreateTestPlanKey() {
		String summary = owner.getTestPlanName()

		String existingKey = findExistingTestPlanKey(summary)

		if (existingKey.startsWith('ERROR')) {
			return existingKey
		}

		if (!owner.isBlank(existingKey)) {
			KeywordUtil.logInfo("Resolved existing Test Plan for suite ${owner.getCurrentSuiteName()}: ${existingKey}")
			return existingKey
		}

		String createdKey = gateway.createTestPlan(summary, owner.EPIC_KEY)
		if (!owner.isBlank(createdKey) && !createdKey.startsWith('ERROR')) {
			owner.saveSuiteTestPlanKey(createdKey)
			KeywordUtil.logInfo("Created new Test Plan for suite ${owner.getCurrentSuiteName()}: ${createdKey}")
		}

		return createdKey
	}
}
