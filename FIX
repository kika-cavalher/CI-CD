	@Keyword
	void applyElementValoriseAsOfDateFilter(
			String asOfDateValue,
			Integer timeoutSeconds
	) {

		if (asOfDateValue == null ||
			asOfDateValue.trim().isEmpty()) {

			KeywordUtil.markFailedAndStop(
					'As Of Date value is empty.'
					)
		}

		String safeAsOfDateValue =
				asOfDateValue.trim()

		Integer safeTimeout =
				timeoutSeconds == null ||
				timeoutSeconds <= 0
					? 5
					: timeoutSeconds

		robot.setAutoDelay(120)

		addNote(
				'Apply Element Valorise As Of Date filter\n' +
				'Value: ' +
				safeAsOfDateValue
				)

		addNote(
				'Step 1. Open Recherche tab'
				)

		openElementValoriseRechercheTab()

		Windows.delay(1)

		addNote(
				'Step 2. Move focus to As Of Date field\n' +
				'TAB count: 2'
				)

		pressTabTimes(2)

		Windows.delay(1)

		addNote(
				'Step 3. Fill As Of Date field\n' +
				'Value: ' +
				safeAsOfDateValue
				)

		clearFocusedField()

		typeDateWithRobot(
				safeAsOfDateValue
				)

		Windows.delay(1)

		addNote(
				'Step 4. Click Rechercher button'
				)

		clickElementValoriseRechercherButton(
				safeTimeout
				)

		Windows.delay(
				safeTimeout
				)

		imageLoader.takeEvidence(
				'Recherche_ElementValorise_AsOfDate_Applied.png'
				)

		addNote(
				'Element Valorise filter applied successfully\n' +
				'As Of Date: ' +
				safeAsOfDateValue
				)
	}


	private void openElementValoriseRechercheTab() {

		WindowsTestObject rechercheTabButton =
