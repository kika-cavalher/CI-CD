Windows.delay(160)

if (errors != '') {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Investigations popup validation finished with errors')
	KeywordUtil.markFailed('\n' + errors)
} else {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Investigations popup validation finished successfully')
}



