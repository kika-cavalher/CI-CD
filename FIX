    exit /b 1
)

if not exist "${script.pwd()}\\jenkinsIntegration\\JenkinsDesktopPipelineRunner.groovy" (
    echo [ERROR] JenkinsDesktopPipelineRunner.groovy not found
    exit /b 1
)

echo [OK] Katalon executable found
echo [OK] Jenkins support files found
echo ------------------------------------------------------------
"""
}

def prepareArtifacts(script, def paths, def resultStore) {
    script.bat """
@echo off
if exist "${paths.reportsRoot(script)}" rmdir /s /q "${paths.reportsRoot(script)}"
mkdir "${paths.reportsRoot(script)}"
mkdir "${paths.logsRoot(script)}"
mkdir "${paths.artifactsRoot(script)}"
"""

    resultStore.saveSuiteResults(script, paths.reportsRoot(script), [])
}

def buildResultFromMeta(def resultStore, script, String reportsRoot, Map suite, int exitCode) {
    def meta = resultStore.readSuiteMeta(script, reportsRoot, suite.name)

    return [
        name              : suite.name,
        type              : meta['SUITE_TYPE'] ?: (suite.type ?: 'SUITE'),
        path              : meta['SUITE_PATH'] ?: (suite.path ?: ''),
        status            : meta['STATUS'] ?: (exitCode == 0 ? 'PASSED' : (exitCode == 124 ? 'TIMEOUT' : 'FAILED')),
        icon              : meta['ICON'] ?: (exitCode == 0 ? '✅' : (exitCode == 124 ? '⏰' : '❌')),
        exitCode          : meta['EXIT_CODE'] ?: "${exitCode}",
        executed          : meta['EXECUTED'] ?: '0',
        passed            : meta['PASSED'] ?: '0',
        failed            : meta['FAILED'] ?: '0',
        skipped           : meta['SKIPPED'] ?: '0',
        durationSeconds   : meta['DURATION_SECONDS'] ?: '0',
        reason            : meta['REASON'] ?: '',
        screenshotRel     : meta['SCREENSHOT_REL'] ?: '',
        primaryArtifactRel: '',
        logRel            : meta['LOG_REL'] ?: '',
        caseSummary       : resultStore.splitSummary(meta['CASE_SUMMARY'] ?: ''),
        stepSummary       : resultStore.splitSummary(meta['STEP_SUMMARY'] ?: '')
    ]
}

def run(script, Map cfg) {
    script.node(cfg.agent.label) {
        script.timestamps {
            script.ansiColor('xterm') {
                script.properties([
                    script.disableConcurrentBuilds(),
                    script.buildDiscarder(script.logRotator(numToKeepStr: cfg.buildDiscarder.numToKeepStr, daysToKeepStr: cfg.buildDiscarder.daysToKeepStr))
                ])

                script.timeout(time: cfg.pipelineTimeoutMinutes as int, unit: 'MINUTES') {
                    def suiteResults = []
                    def consoleView
                    def paths
                    def resultStore

                    try {
                        script.stage('Bootstrap Support Files') {
                            bootstrapSupportFiles(script, cfg)

                            script.echo '------------------------------------------------------------'
                            script.echo '[OK] BOOTSTRAP CHECKOUT COMPLETED'
                            script.echo "Workspace: ${script.pwd()}"
                            script.echo '------------------------------------------------------------'
                        }

                        script.stage('Validate Support Files') {
                            validateSupportFiles(script, cfg)
                        }

                        script.stage('Full Checkout Repository') {
                            fullCheckout(script, cfg)

                            script.echo '------------------------------------------------------------'
                            script.echo '[OK] FULL CHECKOUT COMPLETED'
                            script.echo "Workspace: ${script.pwd()}"
                            script.echo '------------------------------------------------------------'
                        }

                        script.stage('Validate Project File') {
                            def pathsTmp = loadPaths(script)
                            def projectFilePath = pathsTmp.projectPath(script, cfg.execution.projectFileName)

                            script.bat """
@echo off
echo ------------------------------------------------------------
echo VALIDATING PROJECT FILE
echo ------------------------------------------------------------

if not exist "${projectFilePath}" (
    echo [ERROR] Project file not found
    echo ${projectFilePath}
    exit /b 1
)

echo [OK] Project file found
echo ------------------------------------------------------------
"""
                        }

                        script.stage('Prepare Artifacts') {
                            paths = loadPaths(script)
                            resultStore = loadResultStore(script)

                            prepareArtifacts(script, paths, resultStore)
                        }

                        script.stage(cfg.executionStageName ?: 'Execute Desktop Suites') {
                            consoleView = loadConsoleView(script)
                            paths = paths ?: loadPaths(script)
                            resultStore = resultStore ?: loadResultStore(script)
                            def desktopTaskLogger = loadDesktopTaskLogger(script)

                            cfg.suites.each { suite ->
                                script.stage("Suite - ${suite.name}") {
                                    def suiteTimeout = (suite.timeoutMinutes ?: cfg.defaultSuiteTimeoutMinutes).toString()
                                    consoleView.printSuiteHeader(script, suite, suiteTimeout)

                                    int exitCode = desktopTaskLogger.runSuite(script, [
                                        katalonExe         : cfg.execution.katalonExe,
                                        projectPath        : paths.projectPath(script, cfg.execution.projectFileName),
                                        reportsRoot        : paths.reportsRoot(script),
                                        browser            : cfg.execution.browser,
                                        winDriverTask      : cfg.desktop.winDriverTask,
                                        suiteTimeoutMinutes: cfg.defaultSuiteTimeoutMinutes,
                                        pollSeconds        : cfg.desktop.pollSeconds
                                    ], suite)

                                    def result = buildResultFromMeta(resultStore, script, paths.reportsRoot(script), suite, exitCode)

                                    publishPrimaryArtifact(script, paths.reportsRoot(script), result)

                                    suiteResults << result
                                    resultStore.saveSuiteResults(script, paths.reportsRoot(script), suiteResults)

                                    consoleView.printSuiteResult(script, result)
                                    consoleView.printRunningSummary(script, suiteResults)

                                    if (result.status != 'PASSED') {
                                        script.catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                                            script.error("${result.name} finished with status ${result.status}")
                                        }

                                        if (suite.stopPipelineOnFailure == true) {
                                            script.currentBuild.result = 'FAILURE'
                                            script.error("Stopping pipeline because suite ${result.name} failed and stopPipelineOnFailure=true")
                                        }
                                    }
                                }
                            }

                            if (suiteResults.any { it.status != 'PASSED' }) {
                                script.currentBuild.result = 'FAILURE'
                            }
                        }
                    }
                    finally {
                        try {
                            if (!paths) {
                                paths = loadPaths(script)
                            }
                            if (!resultStore) {
                                resultStore = loadResultStore(script)
                            }

                            suiteResults = resultStore.loadSuiteResults(script, paths.reportsRoot(script))
                        }
                        catch (Throwable ignored) {
                        }

                        try {
                            if (!consoleView) {
                                consoleView = loadConsoleView(script)
                            }

                            consoleView.printFinalSummary(script, suiteResults, script.currentBuild.currentResult)
                        }
                        catch (Throwable ignored) {
                            script.echo '============================================================'
                            script.echo 'PIPELINE FINISHED'
                            script.echo '============================================================'
                        }

                        try {
                            emergencyStopWinDriver(script, cfg.desktop.winDriverTask)
                        }
                        catch (Throwable ignored) {
                        }

                        script.catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                            script.archiveArtifacts(
                                artifacts: 'Reports/suite-artifacts/**/*.png,Reports/**/*.log,Reports/**/*.txt',
                                allowEmptyArchive: true
                            )
                        }

                        script.catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                            script.junit allowEmptyResults: true, testResults: 'Reports/**/JUnit_Report.xml,Reports/logs/*.junit.xml'
                        }

                        if (script.currentBuild.currentResult == 'SUCCESS') {
                            if (cfg.triggerNextJob && (cfg.nextJobName ?: '').trim()) {
                                script.echo "Triggering next Jenkins job as a separate build: ${cfg.nextJobName}"

                                script.build job: cfg.nextJobName,
                                             wait: false,
                                             propagate: false

                                script.echo "Next Jenkins job triggered successfully: ${cfg.nextJobName}"
                            }
                            else {
                                script.echo 'No next Jenkins job configured.'
                            }
                        }
                    }
                }
            }
        }
    }
}

