@echo off
setlocal EnableExtensions EnableDelayedExpansion

REM =========================
REM  CONFIG (EDIT IF NEEDED)
REM =========================
set "WORKSPACE=D:\jenkins\work\workspace\GI5\eMatch_Regression\Archive Mode"
set "PROJECT_FILE=eMatch POC.prj"
set "KATALON_EXE=C:\Users\adgi5appjenkins\Documents\Katalon_Studio_Engine_Windows_64-8.1.0\katalonc.exe"

REM Example:
REM set "COLLECTION_PATH=Test Suites\Archive Mode\Archive Mode Collection"
set "COLLECTION_PATH=Test Suites\Archive Mode\Archive Mode Collection"

REM Where reports will be written
set "REPORT_FOLDER=%WORKSPACE%\Reports"
set "MARKER_FILE=%REPORT_FOLDER%\__jenkins_task_exitcode.txt"

REM Log file on the VM (keeps Jenkins clean)
set "LOCAL_LOG_DIR=D:\Projects\eMatchStarters\logs"
if not exist "%LOCAL_LOG_DIR%" mkdir "%LOCAL_LOG_DIR%"
set "TS=%DATE:~6,4%%DATE:~3,2%%DATE:~0,2%_%TIME:~0,2%%TIME:~3,2%%TIME:~6,2%"
set "TS=%TS: =0%"
set "LOG_FILE=%LOCAL_LOG_DIR%\katalon_%TS%.log"

REM =========================
REM  PREP
REM =========================
if not exist "%REPORT_FOLDER%" mkdir "%REPORT_FOLDER%"

REM Clean marker from previous run
if exist "%MARKER_FILE%" del /f /q "%MARKER_FILE%"

echo ================================================== >> "%LOG_FILE%"
echo STARTING KATALON DESKTOP RUN - %DATE% %TIME%      >> "%LOG_FILE%"
echo WORKSPACE: %WORKSPACE%                            >> "%LOG_FILE%"
echo PROJECT:   %PROJECT_FILE%                         >> "%LOG_FILE%"
echo SUITE/COL: %COLLECTION_PATH%                      >> "%LOG_FILE%"
echo ================================================== >> "%LOG_FILE%"

pushd "%WORKSPACE%"

REM =========================
REM  RUN KATALON (VISIBLE SESSION)
REM =========================
"%KATALON_EXE%" ^
  -noSplash ^
  -runMode=console ^
  -retry=0 ^
  -projectPath="%WORKSPACE%\%PROJECT_FILE%" ^
  -testSuiteCollectionPath="%COLLECTION_PATH%" ^
  -executionProfile="default" ^
  -browserType="Windows" ^
  -reportFolder="%REPORT_FOLDER%" ^
  -reportFileName="report" ^
  >> "%LOG_FILE%" 2>&1

set "EC=%ERRORLEVEL%"

popd

REM =========================
REM  WRITE MARKER FOR JENKINS
REM =========================
echo %EC%> "%MARKER_FILE%"

echo ================================================== >> "%LOG_FILE%"
echo FINISHED - EXITCODE=%EC%                           >> "%LOG_FILE%"
echo MARKER: %MARKER_FILE%                              >> "%LOG_FILE%"
echo ================================================== >> "%LOG_FILE%"

exit /b %EC%





