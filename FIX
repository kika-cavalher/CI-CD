1) ✅ JenkinsDesktopPipelineRunner.groovy (REESCRITO)

Coloque exatamente em jenkinsIntegration/JenkinsDesktopPipelineRunner.groovy

/*
 * Responsibility:
 * - Write run-context.properties deterministically (CRLF)
 * - Trigger a Windows Scheduled Task
 * - Wait for a marker file containing the exit code
 */

def deleteIfExists(script, String path) {
  script.bat(returnStatus: true, script: """@echo off
if exist "${path}" del /f /q "${path}"
exit /b 0
""")
}

def writeRunContextFile(script, String targetFile, Map ctx) {
  // Force Windows CRLF so Notepad shows proper lines
  def lines = ctx.collect { k, v -> "${k}=${v}" }
  def content = lines.join("\r\n") + "\r\n"

  script.echo "Writing run-context.properties to: ${targetFile}"

  script.writeFile(
    file: targetFile,
    text: content,
    encoding: 'ASCII'
  )
}

def runScheduledTaskAndWaitMarker(script, String taskName, String markerPath, int timeoutMinutes) {
  script.echo "Running Task Scheduler: ${taskName}"

  int rc = script.bat(returnStatus: true, script: """@echo off
schtasks /run /tn "${taskName}"
exit /b %ERRORLEVEL%
""")

  if (rc != 0) {
    script.error("Failed to start scheduled task. rc=${rc} task=${taskName}")
  }

  script.echo "Waiting marker file: ${markerPath}"

  script.timeout(time: timeoutMinutes, unit: 'MINUTES') {
    script.waitUntil(initialRecurrencePeriod: 3000) {
      return script.fileExists(markerPath)
    }
  }

  def ecText = script.readFile(markerPath).trim()
  int ec = 1
  try { ec = Integer.parseInt(ecText) } catch (ignored) { ec = 1 }

  script.echo "Desktop task finished. ExitCode=${ec}"
  return ec
}

