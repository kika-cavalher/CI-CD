// ======================================================
// CREATE FAVORITE
// Only favoriteFilterField uses image recognition.
// ======================================================

@Keyword
void createFavoriteFromCurrentModule(
	String favoriteTitle,
	Integer controlTimeoutSeconds,
	Integer popupTimeoutSeconds
) {

	Integer controlTimeout = safeTimeout(
		controlTimeoutSeconds,
		5
	)

	Integer popupTimeout = safeTimeout(
		popupTimeoutSeconds,
		5
	)

	logStep(
		'CREATE FAVORITE',
		'Favorite title: ' + favoriteTitle
	)

	KeywordUtil.logInfo(
		'[FAVORITE][01] Method started.'
	)

	/*
	 * Small stabilization time after applying the formulaire filter.
	 */
	KeywordUtil.logInfo(
		'[FAVORITE][02] Waiting 2 seconds after formulaire filter.'
	)

	Windows.delay(2)

	// ==================================================
	// CREATE FAVORITE BUTTON
	// ==================================================

	KeywordUtil.logInfo(
		'[FAVORITE][03] Loading WindowsObject: createFavoriteTopBar'
	)

	long objectLoadStart = System.currentTimeMillis()

	WindowsTestObject createFavoriteButton

	try {
		createFavoriteButton =
			object('createFavoriteTopBar')
	} catch (Throwable error) {
		takeEvidence(
			'GUI_CreateFavoriteObjectLoadError.png'
		)

		KeywordUtil.markFailedAndStop(
			'Unable to load WindowsObject createFavoriteTopBar.\n' +
			'Error: ' + error.getMessage()
		)

		return
	}

	KeywordUtil.logInfo(
		'[FAVORITE][04] WindowsObject loaded successfully.\n' +
		'Duration: ' +
		(System.currentTimeMillis() - objectLoadStart) +
		' ms'
	)

	KeywordUtil.logInfo(
		'[FAVORITE][05] Waiting for Create Favorite button.\n' +
		'Timeout: ' + controlTimeout + ' seconds'
	)

	long presenceStart = System.currentTimeMillis()

	boolean createFavoritePresent =
		Windows.waitForElementPresent(
			createFavoriteButton,
			controlTimeout,
			FailureHandling.OPTIONAL
		)

	KeywordUtil.logInfo(
		'[FAVORITE][06] Presence verification finished.\n' +
		'Present: ' + createFavoritePresent + '\n' +
		'Duration: ' +
		(System.currentTimeMillis() - presenceStart) +
		' ms'
	)

	if (!createFavoritePresent) {
		takeEvidence(
			'GUI_CreateFavoriteButtonNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Create Favorite button was not found.\n' +
			'WindowsObject: createFavoriteTopBar\n' +
			'Timeout: ' + controlTimeout + ' seconds'
		)

		return
	}

	// ==================================================
	// CLICK CREATE FAVORITE
	// ==================================================

	KeywordUtil.logInfo(
		'[FAVORITE][07] Create Favorite button was found.'
	)

	KeywordUtil.logInfo(
		'[FAVORITE][08] Calling Windows.click now.'
	)

	long clickStart = System.currentTimeMillis()

	try {
		Windows.click(
			createFavoriteButton,
			FailureHandling.STOP_ON_FAILURE
		)
	} catch (Throwable error) {
		takeEvidence(
			'GUI_CreateFavoriteClickError.png'
		)

		KeywordUtil.markFailedAndStop(
			'Create Favorite button was found, but the click failed.\n' +
			'Error: ' + error.getMessage()
		)

		return
	}

	KeywordUtil.logInfo(
		'[FAVORITE][09] Windows.click finished.\n' +
		'Duration: ' +
		(System.currentTimeMillis() - clickStart) +
		' ms'
	)

	Windows.delay(1)

	// ==================================================
	// FAVORITE TITLE
	// ==================================================

	KeywordUtil.logInfo(
		'[FAVORITE][10] Starting typeOnImage.\n' +
		'Image key: favoriteFilterField\n' +
		'Text: ' + favoriteTitle
	)

	long typeStart = System.currentTimeMillis()

	try {
		typeOnImage(
			GUI_IMAGE_GROUP,
			'favoriteFilterField',
			favoriteTitle,
			controlTimeout
		)
	} catch (Throwable error) {
		takeEvidence(
			'GUI_FavoriteTitleTypeError.png'
		)

		KeywordUtil.markFailedAndStop(
			'Unable to fill favorite title.\n' +
			'Image key: favoriteFilterField\n' +
			'Error: ' + error.getMessage()
		)

		return
	}

	KeywordUtil.logInfo(
		'[FAVORITE][11] Favorite title filled.\n' +
		'Duration: ' +
		(System.currentTimeMillis() - typeStart) +
		' ms'
	)

	Windows.delay(1)

	// ==================================================
	// SAVE FAVORITE BUTTON
	// ==================================================

	KeywordUtil.logInfo(
		'[FAVORITE][12] Loading WindowsObject: favoriteSaveTopBar'
	)

	WindowsTestObject saveFavoriteButton

	try {
		saveFavoriteButton =
			object('favoriteSaveTopBar')
	} catch (Throwable error) {
		takeEvidence(
			'GUI_SaveFavoriteObjectLoadError.png'
		)

		KeywordUtil.markFailedAndStop(
			'Unable to load WindowsObject favoriteSaveTopBar.\n' +
			'Error: ' + error.getMessage()
		)

		return
	}

	KeywordUtil.logInfo(
		'[FAVORITE][13] Save Favorite WindowsObject loaded.'
	)

	KeywordUtil.logInfo(
		'[FAVORITE][14] Waiting for Save Favorite button.\n' +
		'Timeout: ' + controlTimeout + ' seconds'
	)

	boolean saveFavoritePresent =
		Windows.waitForElementPresent(
			saveFavoriteButton,
			controlTimeout,
			FailureHandling.OPTIONAL
		)

	KeywordUtil.logInfo(
		'[FAVORITE][15] Save Favorite presence result: ' +
		saveFavoritePresent
	)

	if (!saveFavoritePresent) {
		takeEvidence(
			'GUI_SaveFavoriteButtonNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Save Favorite button was not found.'
		)

		return
	}

	String saveEnabled = safeText(
		Windows.getAttribute(
			saveFavoriteButton,
			'IsEnabled',
			FailureHandling.OPTIONAL
		)
	)

	KeywordUtil.logInfo(
		'[FAVORITE][16] Save Favorite IsEnabled: ' +
		saveEnabled
	)

	if (!saveEnabled.equalsIgnoreCase('True')) {
		takeEvidence(
			'GUI_SaveFavoriteButtonDisabled.png'
		)

		KeywordUtil.markFailedAndStop(
			'Save Favorite button is disabled after filling the title.\n' +
			'IsEnabled: ' + saveEnabled
		)

		return
	}

	KeywordUtil.logInfo(
		'[FAVORITE][17] Clicking Save Favorite button.'
	)

	Windows.click(
		saveFavoriteButton,
		FailureHandling.STOP_ON_FAILURE
	)

	KeywordUtil.logInfo(
		'[FAVORITE][18] Save Favorite button clicked.'
	)

	// ==================================================
	// CONFIRMATION
	// ==================================================

	KeywordUtil.logInfo(
		'[FAVORITE][19] Waiting for favorite confirmation.'
	)

	String modalDetection =
		waitForFavoriteConfirmation(
			favoriteTitle,
			popupTimeout
		)

	KeywordUtil.logInfo(
		'[FAVORITE][20] Confirmation detection result: ' +
		modalDetection
	)

	if (modalDetection.isEmpty()) {
		takeEvidence(
			'GUI_FavoriteConfirmationModalNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorite confirmation modal was not found.\n' +
			'Favorite: ' + favoriteTitle
		)

		return
	}

	takeEvidence(
		'GUI_FavoriteConfirmationModal.png'
	)

	Windows.delay(5)

	KeywordUtil.logInfo(
		'[FAVORITE][21] Trying to close confirmation.'
	)

	boolean confirmationClosed =
		clickFirstVisibleImage(
			GENERAL_IMAGE_GROUP,
			[
				'okModal',
				'okModal2Version'
			],
			3
		)

	KeywordUtil.logInfo(
		'[FAVORITE][22] Confirmation closed by image: ' +
		confirmationClosed
	)

	if (!confirmationClosed) {
		KeywordUtil.logInfo(
			'[FAVORITE][23] OK image not found. Pressing ENTER.'
		)

		pressKeyboardKey(
			KeyEvent.VK_ENTER
		)
	}

	Windows.delay(2)

	KeywordUtil.markPassed(
		'Favorite created successfully.\n' +
		'Title: ' + favoriteTitle + '\n' +
		'Confirmation detected by: ' + modalDetection
	)
}
