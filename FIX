                font-size: 12px;
            }

            .chart-grid {
                display: grid;
                grid-template-columns: 340px 1fr;
                gap: 24px;
                align-items: start;
            }

            .chart-card,
            .stats-card {
                background: #ffffff;
                border: 1px solid var(--border);
                border-radius: 16px;
                padding: 20px;
                box-shadow: var(--shadow);
            }

            .chart-card h2,
            .stats-card h2 {
                margin: 0 0 18px 0;
                font-size: 24px;
                font-weight: 700;
            }

            .donut {
                width: 180px;
                height: 180px;
                border-radius: 50%;
                position: relative;
                margin: 8px auto 18px auto;
            }

            .donut-center {
                position: absolute;
                inset: 22px;
