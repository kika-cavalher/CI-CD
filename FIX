// ======================================================
// CLOSE ALL TABS
// Image first, WindowsObject as fallback.
// ======================================================

private void closeAllTabs(
	Integer timeoutSeconds
) {

	Integer timeout =
		safeTimeout(
			timeoutSeconds,
			5
		)

	logStep(
		'CLOSE ALL TABS',
		'Image key: closeTabs\n' +
		'WindowsObject fallback: closeAllTabsTopBar\n' +
		'Timeout for each search: ' + timeout + ' seconds'
	)

	// ==================================================
	// TRY IMAGE FIRST
	// ==================================================

	KeywordUtil.logInfo(
		'Searching for the Close All Tabs image.\n' +
		'Image group: ' + GENERAL_IMAGE_GROUP + '\n' +
		'Image key: closeTabs\n' +
		'Timeout: ' + timeout + ' seconds'
	)

	boolean closeAllTabsClicked =
		clickFirstVisibleImage(
			GENERAL_IMAGE_GROUP,
			[
				'closeTabs'
			],
			timeout
		)

	if (closeAllTabsClicked) {
		KeywordUtil.logInfo(
			'Close All Tabs clicked successfully by image.'
		)
	}

	// ==================================================
	// FALLBACK TO WINDOWS OBJECT
	// ==================================================

	if (!closeAllTabsClicked) {

		KeywordUtil.logInfo(
			'Close All Tabs image was not found.\n' +
			'Trying WindowsObject fallback.\n' +
			'Object key: closeAllTabsTopBar\n' +
			'Timeout: ' + timeout + ' seconds'
		)

		WindowsTestObject closeAllTabsButton =
			object(
				'closeAllTabsTopBar'
			)

		boolean closeAllTabsFound =
			Windows.waitForElementPresent(
				closeAllTabsButton,
				timeout,
				FailureHandling.OPTIONAL
			)

		if (!closeAllTabsFound) {
			takeEvidence(
				'GUI_CloseAllTabsNotFound.png'
			)

			KeywordUtil.markFailedAndStop(
				'Close All Tabs was not found by image or WindowsObject.\n' +
				'Image key: closeTabs\n' +
				'Object key: closeAllTabsTopBar\n' +
				'Timeout for each search: ' + timeout + ' seconds'
			)

			return
		}

		String enabledValue =
			safeText(
				Windows.getAttribute(
					closeAllTabsButton,
					'IsEnabled',
					FailureHandling.OPTIONAL
				)
			)

		KeywordUtil.logInfo(
			'Close All Tabs WindowsObject found.\n' +
			'Enabled value: ' + enabledValue
		)

		if (enabledValue.equalsIgnoreCase('False')) {
			KeywordUtil.logInfo(
				'Close All Tabs is disabled. There are no opened tabs to close.'
			)

			return
		}

		KeywordUtil.logInfo(
			'Clicking Close All Tabs by WindowsObject.'
		)

		Windows.click(
			closeAllTabsButton,
			FailureHandling.STOP_ON_FAILURE
		)

		closeAllTabsClicked = true

		KeywordUtil.logInfo(
			'Close All Tabs clicked successfully by WindowsObject.'
		)
	}

	// ==================================================
	// CONFIRM CLOSE ALL TABS
	// ==================================================

	KeywordUtil.logInfo(
		'Waiting for the Close All Tabs confirmation.\n' +
		'Timeout: ' + timeout + ' seconds'
	)

	boolean confirmationClicked =
		clickFirstVisibleImage(
			GENERAL_IMAGE_GROUP,
			[
				'yes',
				'yesUnderline',
				'yesButton',
				'oui',
				'okModal',
				'okModal2Version'
			],
			timeout
		)

	if (!confirmationClicked) {
		takeEvidence(
			'GUI_CloseAllTabsConfirmationNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Close All Tabs was clicked, but the confirmation button ' +
			'was not found within ' +
			timeout +
			' seconds.'
		)

		return
	}

	KeywordUtil.logInfo(
		'Close All Tabs confirmation clicked. Continuing immediately.'
	)
}
