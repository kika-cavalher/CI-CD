// ======================================================
// DELETE FAVORITE
// ======================================================

@Keyword
void deleteCreatedFavorite(
	String favoriteTitle,
	String favoriteImageKey
) {

	Integer favoriteSearchTimeout = 10
	Integer deleteCommandTimeout = 5

	Integer maximumDeleteChecks = 5
	Integer waitPerDeleteCheckSeconds = 20

	logStep(
		'DELETE FAVORITE',
		'Favorite title: ' + favoriteTitle + '\n' +
		'Favorite image key: ' + favoriteImageKey
	)


	// ======================================================
	// CLOSE OPENED TABS
	// ======================================================

	closeTabsBeforeFavoriteDeletion()

	Windows.delay(2)


	// ======================================================
	// OPEN FAVORITES TAB
	// ======================================================

	WindowsTestObject favoritesTab =
		object(
			'favoritesTab'
		)

	if (!Windows.waitForElementPresent(
		favoritesTab,
		10,
		FailureHandling.OPTIONAL
	)) {
		takeEvidence(
			'GUI_FavoritesTabNotFoundForDelete.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorites tab was not found before deletion.'
		)

		return
	}

	KeywordUtil.logInfo(
		'[DELETE FAVORITE] Clicking Favorites tab.'
	)

	Windows.click(
		favoritesTab,
		FailureHandling.STOP_ON_FAILURE
	)

	Windows.delay(3)


	// ======================================================
	// FIND FAVORITE AND OPEN CONTEXT MENU
	// IMAGE FIRST, ELEMENT FALLBACK
	// ======================================================

	boolean contextMenuOpened = false

	if (!safeText(favoriteImageKey).isEmpty()) {
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Searching favorite by image.\n' +
			'Image key: ' + favoriteImageKey
		)

		contextMenuOpened =
			rightClickFavoriteImage(
				GUI_IMAGE_GROUP,
				favoriteImageKey,
				favoriteSearchTimeout
			)
	}

	if (!contextMenuOpened) {
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Favorite image was not found.\n' +
			'Trying Windows element fallback.\n' +
			'Favorite: ' + favoriteTitle
		)

		WindowsTestObject favoriteItem =
			findFavoriteListItem(
				favoriteTitle,
				favoriteSearchTimeout
			)

		if (favoriteItem != null) {
			Windows.rightClick(
				favoriteItem,
				FailureHandling.STOP_ON_FAILURE
			)

			contextMenuOpened = true

			KeywordUtil.logInfo(
				'[DELETE FAVORITE] Favorite found by element.\n' +
				'Right click executed.'
			)
		}
	}

	if (!contextMenuOpened) {
		takeEvidence(
			'GUI_FavoriteNotFoundForDelete.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorite was not found for deletion by image or element.\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'Image key: ' + favoriteImageKey
		)

		return
	}

	Windows.delay(2)


	// ======================================================
	// CLICK SUPPRIMER LE FAVORI
	// ELEMENT FIRST, IMAGE FALLBACK
	// ======================================================

	boolean deleteCommandClicked = false

	List<WindowsTestObject> deleteCommandCandidates = []

	try {
		deleteCommandCandidates.add(
			object(
				'deleteFavoriteButton'
			)
		)
	} catch (Throwable ignored) {
	}

	deleteCommandCandidates.add(
		buildXpathObject(
			"//*[@Name='Supprimer le favori']"
		)
	)

	deleteCommandCandidates.add(
		buildXpathObject(
			"//*[contains(@Name,'Supprimer le favori')]"
		)
	)

	for (
		WindowsTestObject deleteCommand :
		deleteCommandCandidates
	) {
		try {
			boolean deleteCommandFound =
				Windows.waitForElementPresent(
					deleteCommand,
					deleteCommandTimeout,
					FailureHandling.OPTIONAL
				)

			if (deleteCommandFound) {
				KeywordUtil.logInfo(
					'[DELETE FAVORITE] Clicking Supprimer le favori by element.'
				)

				Windows.click(
					deleteCommand,
					FailureHandling.STOP_ON_FAILURE
				)

				deleteCommandClicked = true

				break
			}
		} catch (Throwable ignored) {
		}
	}

	if (!deleteCommandClicked) {
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Delete command was not found by element.\n' +
			'Trying image fallback: deleteFavoriteBtn'
		)

		deleteCommandClicked =
			clickFirstVisibleImage(
				GUI_IMAGE_GROUP,
				[
					'deleteFavoriteBtn'
				],
				deleteCommandTimeout
			)
	}

	if (!deleteCommandClicked) {
		takeEvidence(
			'GUI_DeleteFavoriteButtonNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Delete Favorite command was not found by element or image.\n' +
			'Expected command: Supprimer le favori\n' +
			'Image key: deleteFavoriteBtn'
		)

		return
	}


	// ======================================================
	// VERIFY FAVORITE WAS REMOVED
	// ======================================================

	boolean favoriteDeleted = false

	for (
		Integer deleteCheckAttempt = 1;
		deleteCheckAttempt <= maximumDeleteChecks;
		deleteCheckAttempt++
	) {

		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Waiting for favorite removal.\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'Attempt: ' +
				deleteCheckAttempt +
				'/' +
				maximumDeleteChecks + '\n' +
			'Wait time: ' +
				waitPerDeleteCheckSeconds +
				' seconds'
		)

		Windows.delay(
			waitPerDeleteCheckSeconds
		)

		pressKeyboardKey(
			KeyEvent.VK_ESCAPE
		)

		if (Windows.waitForElementPresent(
			favoritesTab,
			2,
			FailureHandling.OPTIONAL
		)) {
			Windows.click(
				favoritesTab,
				FailureHandling.OPTIONAL
			)

			Windows.delay(2)
		}

		boolean favoriteStillPresentByImage = false

		if (!safeText(favoriteImageKey).isEmpty()) {
			favoriteStillPresentByImage =
				isOptionalImageVisible(
					GUI_IMAGE_GROUP,
					favoriteImageKey
				)
		}

		WindowsTestObject remainingFavorite =
			findFavoriteListItem(
				favoriteTitle,
				2
			)

		boolean favoriteStillPresentByElement =
			remainingFavorite != null

		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Favorite presence validation.\n' +
			'Found by image: ' +
				favoriteStillPresentByImage + '\n' +
			'Found by element: ' +
				favoriteStillPresentByElement
		)

		if (
			!favoriteStillPresentByImage &&
			!favoriteStillPresentByElement
		) {
			favoriteDeleted = true

			KeywordUtil.logInfo(
				'[PASS] Favorite is no longer displayed.\n' +
				'Attempt: ' +
					deleteCheckAttempt +
					'/' +
					maximumDeleteChecks
			)

			break
		}

		if (deleteCheckAttempt < maximumDeleteChecks) {
			KeywordUtil.logInfo(
				'[DELETE FAVORITE] Favorite is still displayed.\n' +
				'Another validation will be executed.'
			)
		}
	}

	takeEvidence(
		'GUI_FavoriteAfterDelete.png'
	)

	if (!favoriteDeleted) {
		KeywordUtil.markFailedAndStop(
			'Favorite is still visible after deletion.\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'Image key: ' + favoriteImageKey + '\n' +
			'Attempts: ' + maximumDeleteChecks + '\n' +
			'Wait per attempt: ' +
				waitPerDeleteCheckSeconds +
				' seconds'
		)

		return
	}

	KeywordUtil.markPassed(
		'Favorite deleted successfully.\n' +
		'Favorite: ' + favoriteTitle + '\n' +
		'Favorite is no longer displayed.'
	)
}


// ======================================================
// CLOSE TABS BEFORE FAVORITE DELETION
// ======================================================

private void closeTabsBeforeFavoriteDeletion() {

	KeywordUtil.logInfo(
		'[DELETE FAVORITE] Closing opened tabs before accessing Favorites.'
	)

	pressKeyboardKey(
		KeyEvent.VK_ESCAPE
	)

	Windows.delay(1)

	WindowsTestObject closeAllTabsButton =
		object(
			'closeAllTabsTopBar'
		)

	if (!Windows.waitForElementPresent(
		closeAllTabsButton,
		5,
		FailureHandling.OPTIONAL
	)) {
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Close All Tabs button was not found.\n' +
			'Continuing because no opened tab may be available.'
		)

		return
	}

	String enabledValue =
		safeText(
			Windows.getAttribute(
				closeAllTabsButton,
				'IsEnabled',
				FailureHandling.OPTIONAL
			)
		)

	if (enabledValue.equalsIgnoreCase('False')) {
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Close All Tabs button is disabled.\n' +
			'There are no tabs to close.'
		)

		return
	}

	Windows.click(
		closeAllTabsButton,
		FailureHandling.STOP_ON_FAILURE
	)

	Windows.delay(2)

	boolean closeConfirmed =
		clickFirstVisibleImage(
			GENERAL_IMAGE_GROUP,
			[
				'yes',
				'yesUnderline',
				'yesButton',
				'oui'
			],
			3
		)

	if (!closeConfirmed) {
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Close confirmation image was not found.\n' +
			'Pressing ENTER.'
		)

		pressKeyboardKey(
			KeyEvent.VK_ENTER
		)
	}

	Windows.delay(5)

	KeywordUtil.logInfo(
		'[DELETE FAVORITE] Opened tabs were closed.'
	)
}


// ======================================================
// FIND FAVORITE LIST ITEM
// ======================================================

private WindowsTestObject findFavoriteListItem(
	String favoriteTitle,
	Integer timeoutSeconds
) {

	Integer timeout =
		safeTimeout(
			timeoutSeconds,
			2
		)

	List<WindowsTestObject> favoriteCandidates = [
		WindowsObjectLoader.getTreeItemByName(
			favoriteTitle
		),

		buildXpathObject(
			"//*[@Name=" +
				xpathLiteral(favoriteTitle) +
				"]"
		),

		buildXpathObject(
			"//*[contains(@Name," +
				xpathLiteral(favoriteTitle) +
				")]"
		),

		buildXpathObject(
			"//*[@LegacyValue=" +
				xpathLiteral(favoriteTitle) +
				"]"
		)
	]

	for (
		WindowsTestObject favoriteCandidate :
		favoriteCandidates
	) {
		try {
			boolean favoriteFound =
				Windows.waitForElementPresent(
					favoriteCandidate,
					timeout,
					FailureHandling.OPTIONAL
				)

			if (favoriteFound) {
				return favoriteCandidate
			}
		} catch (Throwable ignored) {
		}
	}

	return null
}


// ======================================================
// RIGHT CLICK FAVORITE IMAGE
// ======================================================

private boolean rightClickFavoriteImage(
	String groupName,
	String imageKey,
	Integer timeoutSeconds
) {

	Integer timeout =
		safeTimeout(
			timeoutSeconds,
			5
		)

	String imagePath =
		optionalImage(
			groupName,
			imageKey
		)

	if (imagePath.isEmpty()) {
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Favorite image path was not resolved.\n' +
			'Group: ' + groupName + '\n' +
			'Image key: ' + imageKey
		)

		return false
	}

	Integer elapsedSeconds = 0

	while (elapsedSeconds < timeout) {
		try {
			def foundImage =
				WindowsImageKeywords.findImage(
					imagePath
				)

			if (
				foundImage != null &&
				foundImage != false
			) {
				def center =
					foundImage.getCenter()

				Integer targetX =
					(center.getX() as Number)
						.intValue()

				Integer targetY =
					(center.getY() as Number)
						.intValue()

				Robot robot =
					new Robot()

				robot.setAutoDelay(
					100
				)

				robot.mouseMove(
					targetX,
					targetY
				)

				robot.mousePress(
					java.awt.event.InputEvent
						.BUTTON3_DOWN_MASK
				)

				robot.mouseRelease(
					java.awt.event.InputEvent
						.BUTTON3_DOWN_MASK
				)

				KeywordUtil.logInfo(
					'[DELETE FAVORITE] Favorite found by image.\n' +
					'Right click executed.\n' +
					'Image key: ' + imageKey + '\n' +
					'Position X: ' + targetX + '\n' +
					'Position Y: ' + targetY
				)

				return true
			}
		} catch (Throwable imageError) {
			KeywordUtil.logInfo(
				'[DELETE FAVORITE] Favorite image search failed.\n' +
				'Image key: ' + imageKey + '\n' +
				'Reason: ' +
					safeText(
						imageError.getMessage()
					)
			)
		}

		Windows.delay(1)
		elapsedSeconds++
	}

	return false
}
