				FailureHandling.OPTIONAL
				)

		if (!isComboPresent) {
			KeywordUtil.markFailedAndStop(
					'Environment combo was not found by NAME.\n' +
					'Expected Name: Environnement eMatch\n' +
					'Environment: ' + environment
					)
		}

		KeywordUtil.logInfo(
				'Environment eMatch combo found. ' +
				'Selection will be done in selectEnvironment.'
				)
	}


	@Keyword
	def selectEnvironment(String targetEnvironment) {
		stopImmediatelyIfFatalFailureWasAlreadyDetected()

		String environment =
				normalizeEnvironment(targetEnvironment)

		if (isProductionEnvironment(environment)) {
			KeywordUtil.logInfo(
					'PRD does not use credential modal or environment selection. ' +
					'Skipping environment selection.'
					)

			saveCurrentEnvironment(environment)
			return
		}

		validateCorrectVersionWindowOrStop(environment)

		if (!isLoginScreenVisibleSafely()) {
			KeywordUtil.markFailedAndStop(
					'Login screen is not visible, but it was expected for environment selection.\n' +
					'Environment: ' + environment
					)
		}

		WindowsTestObject environmentCombo =
				WindowsObjectLoader.getObject(
				'authentication',
				'environmentCombo'
				)

		boolean isComboPresent =
				Windows.verifyElementPresent(
				environmentCombo,
				5,
				FailureHandling.OPTIONAL
				)

		if (!isComboPresent) {
			KeywordUtil.markFailedAndStop(
					'Environment combo was not found by NAME.\n' +
					'Expected Name: Environnement eMatch\n' +
					'Environment: ' + environment
					)
		}

		KeywordUtil.logInfo(
				'Selecting Environment eMatch: ' +
				environment
				)

		clickElementCenterByCoordinates(environmentCombo)
		Thread.sleep(300)

		selectFocusedEMatchComboByKeyboard(environment)

		saveCurrentEnvironment(environment)

