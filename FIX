import groovy.transform.Field
import groovy.json.JsonSlurperClassic

@Field final Map SUITE = [
    NODE_LABEL                 : 'GI5_SWDCFRNXGI55817',
    CUSTOM_WORKSPACE_PATH      : 'D:\\jenkins\\work\\workspace\\GI5\\eMatch_Regression\\Archive Mode',

    STARTERS_DIR               : 'D:\\Projects\\eMatchStarters',
    DESKTOP_RUNNER_TASK        : '\\eMatch Automation\\RunEMatchDesktop',
    WINAPPDRIVER_EXE           : '',
    AUTO_START_WINAPPDRIVER    : 'true',

    KATALON_EXE                : 'C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0\\katalonc.exe',
    PROJECT_FILE               : 'eMatch POC.prj',

    SUITE_NAME                 : 'Archive Mode Collection',
    SUITE_TYPE                 : 'COLLECTION',
    SUITE_PATH                 : 'Test Suites\\Archive Mode\\Archive Mode Collection',
    BROWSER_TYPE               : 'Windows',
    RETRY                      : '0',
    TIMEOUT_MINUTES            : 180,
    ALLOW_EXITCODE_3_IF_GREEN  : 'true',

    OPEN_VISIBLE_APP           : 'true',
    APP_LNK_PATH               : 'D:\\RunAseMatchReq\\eMatch.lnk',
    APP_EXE_PATH               : '',
    APP_WINDOW_TITLE           : 'eMatch',
    KATALON_EXTRA_ARGS         : '',

    NEXT_JOB_NAME              : '',
    WAIT_FOR_NEXT_JOB          : false,
    PROPAGATE_NEXT_JOB_FAILURE : false
]

pipeline {
    agent {
        node {
            label SUITE.NODE_LABEL
            customWorkspace SUITE.CUSTOM_WORKSPACE_PATH
        }
    }

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        timeout(time: 4, unit: 'HOURS')
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "Workspace: ${pwd()}"
            }
        }

        stage('Run Desktop Suite') {
            steps {
                script {
                    def consoleView   = load 'jenkinsIntegration/JenkinsConsoleView.groovy'
                    def desktopLogger = load 'jenkinsIntegration/JenkinsDesktopTaskLogger.groovy'
                    def paths         = load 'jenkinsIntegration/JenkinsPaths.groovy'
                    def resultStore   = load 'jenkinsIntegration/JenkinsResultStore.groovy'

                    String workspace   = pwd()
                    String projectPath = paths.projectPath(this, SUITE.PROJECT_FILE)
                    String reportsRoot = paths.reportsRoot(this)
                    String logsDir     = "${reportsRoot}\\_desktop_logs"
                    String resultFile  = "${logsDir}\\desktop-run-result.json"

                    env.REPORTS_ROOT = reportsRoot
                    env.DESKTOP_RESULT_FILE = resultFile

                    Map asset = [
                        name          : SUITE.SUITE_NAME,
                        type          : SUITE.SUITE_TYPE,
                        path          : SUITE.SUITE_PATH,
                        timeoutMinutes: SUITE.TIMEOUT_MINUTES
                    ]

                    Map cfg = [
                        workspace              : workspace,
                        reportsRoot            : reportsRoot,
                        logsDir                : logsDir,
                        resultFile             : resultFile,
                        startersDir            : SUITE.STARTERS_DIR,
                        desktopRunnerTask      : SUITE.DESKTOP_RUNNER_TASK,
                        winAppDriverExe        : SUITE.WINAPPDRIVER_EXE,
                        autoStartWinAppDriver  : SUITE.AUTO_START_WINAPPDRIVER,
                        katalonExe             : SUITE.KATALON_EXE,
                        projectPath            : projectPath,
                        browserType            : SUITE.BROWSER_TYPE,
                        retry                  : SUITE.RETRY,
                        runLabel               : "${SUITE.SUITE_NAME} Build ${env.BUILD_NUMBER}",
                        allowExitCode3IfGreen  : SUITE.ALLOW_EXITCODE_3_IF_GREEN,
                        openVisibleApp         : SUITE.OPEN_VISIBLE_APP,
                        appLnkPath             : SUITE.APP_LNK_PATH,
                        appExePath             : SUITE.APP_EXE_PATH,
                        appWindowTitle         : SUITE.APP_WINDOW_TITLE,
                        katalonExtraArgs       : SUITE.KATALON_EXTRA_ARGS,
                        defaultTimeoutMinutes  : SUITE.TIMEOUT_MINUTES
                    ]

                    List results = []

                    consoleView.printAssetHeader(this, asset, String.valueOf(SUITE.TIMEOUT_MINUTES))

                    Map result = desktopLogger.runAsset(this, cfg, asset)

                    if (!result.durationSeconds) {
                        result.durationSeconds = '0'
                    }

                    results << result
                    resultStore.saveSuiteResults(this, reportsRoot, results)

                    consoleView.printAssetResult(this, result)
                    consoleView.printRunningSummary(this, results)

                    if ((result.status ?: 'FAILED') != 'PASSED') {
                        error(result.reason ?: 'Desktop suite failed')
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                def consoleView = load 'jenkinsIntegration/JenkinsConsoleView.groovy'
                def resultStore = load 'jenkinsIntegration/JenkinsResultStore.groovy'
                def paths       = load 'jenkinsIntegration/JenkinsPaths.groovy'

                String reportsRoot = env.REPORTS_ROOT ?: paths.reportsRoot(this)
                List results = resultStore.loadSuiteResults(this, reportsRoot)

                if ((!results || results.isEmpty()) && env.DESKTOP_RESULT_FILE?.trim() && fileExists(env.DESKTOP_RESULT_FILE)) {
                    try {
                        def parsed = new JsonSlurperClassic().parseText(readFile(file: env.DESKTOP_RESULT_FILE, encoding: 'UTF-8'))
                        if (parsed instanceof Map) {
                            results = [parsed]
                        }
                    }
                    catch (ignored) {
                    }
                }

                consoleView.printFinalSummary(this, results ?: [], currentBuild.currentResult ?: 'UNKNOWN')
            }

            archiveArtifacts allowEmptyArchive: true, artifacts: 'Reports/**/*'
        }

        success {
            script {
                if ((SUITE.NEXT_JOB_NAME ?: '').trim()) {
                    echo "Triggering next job at final step: ${SUITE.NEXT_JOB_NAME}"

                    build job: SUITE.NEXT_JOB_NAME,
                          wait: SUITE.WAIT_FOR_NEXT_JOB,
                          propagate: SUITE.PROPAGATE_NEXT_JOB_FAILURE
                }
            }
        }
    }
}
