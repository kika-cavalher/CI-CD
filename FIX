	@Keyword
	boolean startEMatch(String currentUser, String targetWindowTitle) {
		String env = currentEnv()
		String shortcutPath = getShortcutPath()
		String installedExePath = getInstalledExePath()

		KeywordUtil.logInfo("Starting eMatch for environment: ${env}")
		KeywordUtil.logInfo("Current Windows user: ${currentUser}")
		KeywordUtil.logInfo("Target window title: ${targetWindowTitle}")
		KeywordUtil.logInfo("Shortcut path: ${shortcutPath}")
		KeywordUtil.logInfo("Application path: ${getApplicationPath()}")
		KeywordUtil.logInfo("Installed exe path: ${installedExePath}")

		ensureWinAppDriverStarted()

		if (isLoginWindowReady()) {
			KeywordUtil.logInfo("Login window already available before launch.")
			return true
		}

		killProcessIfExists('IXIS.eMatch.IHM.exe')

		if (installedExePath) {
			File installedExe = new File(installedExePath)

			if (installedExe.exists()) {
				KeywordUtil.logInfo("Launching eMatch directly from installed exe.")
				Windows.startApplication(installedExePath)
				Windows.delay(3)

				boolean loginReadyFromExe = waitForLoginWindowReady(45)
				if (loginReadyFromExe) {
					KeywordUtil.logInfo("Login window detected after launching installed exe.")
					return true
				}

				KeywordUtil.logInfo("Installed exe launched, but login objects were not found in time. Falling back to shortcut flow.")
				killProcessIfExists('IXIS.eMatch.IHM.exe')
			}
		}

		if (!shortcutPath) {
			throw new Exception("Shortcut path is empty and installed exe path was not available.")
		}

		File shortcut = new File(shortcutPath)
		if (!shortcut.exists()) {
			throw new Exception("Shortcut does not exist: ${shortcutPath}")
		}

		boolean launched = launchShortcutWithShell(shortcutPath)
		if (!launched) {
			throw new Exception("Unable to launch shortcut: ${shortcutPath}")
		}

		boolean processReady = waitForProcess('IXIS.eMatch.IHM.exe', 20)
		if (!processReady) {
			throw new Exception("eMatch process did not appear after shortcut launch.")
		}

		Windows.delay(4)

		boolean attached = attachToLoginByWindowIndex(30, 5)
		if (!attached) {
			throw new Exception("eMatch opened but the login window could not be attached by window index.")
		}

		boolean loginReady = waitForLoginWindowReady(10)
		if (!loginReady) {
			throw new Exception("eMatch window was attached, but login objects were not detected.")
		}

		KeywordUtil.logInfo("eMatch login window detected successfully.")
		return true
	}

	@Keyword
	boolean attachToLoginWindow(String targetWindowTitle) {
		if (isLoginWindowReady()) {
			KeywordUtil.logInfo("Login window already available for '${targetWindowTitle}'.")
			return true
		}

		boolean attached = attachToLoginByWindowIndex(20, 5)
		if (!attached) {
			throw new Exception("Unable to attach to login window for '${targetWindowTitle}' using window index.")
		}

		boolean loginReady = waitForLoginWindowReady(10)
		if (!loginReady) {
			throw new Exception("Login window attached but objects were not detected.")
		}

		return true
	}

	@Keyword
	boolean openEnvironmentDropdown() {
		Exception lastError = null
		List<String> candidateObjects = [
			'Object Repository/Login Page/optEnv',
			'Login Page/optEnv'
		]

		for (String objectId : candidateObjects) {
			try {
				KeywordUtil.logInfo("Trying to click environment dropdown using object: ${objectId}")
				Windows.click(findWindowsObject(objectId))
				Windows.delay(1)
				return true
			} catch (Exception e) {
				lastError = e
				KeywordUtil.logInfo("Dropdown click failed with '${objectId}': ${e.message}")
			}
		}

		throw new Exception("Unable to open environment dropdown. Last error: ${lastError?.message}")
	}

	@Keyword
	int resolveEnvironmentIndex(String envName) {
		String env = (envName ?: '').trim().toUpperCase()

		switch (env) {
			case 'PROD':
			case 'PRD':
				return 1
			case 'PREQ':
			case 'BENCH':
				return 2
			case 'QUAL':
			case 'QUALIFICATION':
				return 3
			case 'REC':
			case 'RECETTE':
				return 4
			case 'SIM':
			case 'SIMULATION':
				return 5
			case 'DEV':
			case 'DEVELOPMENT':
				return 6
			default:
				return 4
		}
	}

	@Keyword
	boolean selectEnvironment(String envName) {
		int envIndex = resolveEnvironmentIndex(envName)

		KeywordUtil.logInfo("Selecting environment '${envName}' using index ${envIndex}")

		keyPress(KeyEvent.VK_HOME)
		Windows.delay(1)

		if (envIndex > 1) {
			keyPressMultiple(KeyEvent.VK_DOWN, envIndex - 1)
			Windows.delay(1)
		}

		keyPress(KeyEvent.VK_ENTER)
		Windows.delay(1)

		return true
	}

	@Keyword
	boolean isConnectButtonPresent() {
		List<String> candidateObjects = [
			'Object Repository/Login Page/btnConnect',
			'Login Page/btnConnect'
		]

		for (String objectId : candidateObjects) {
			if (safeVerifyPresent(objectId, 2)) {
				return true
			}
		}

		return false
	}

	@Keyword
	boolean clickConnectButton() {
		Exception lastError = null
		List<String> candidateObjects = [
			'Object Repository/Login Page/btnConnect',
			'Login Page/btnConnect'
		]

		for (String objectId : candidateObjects) {
			try {
				Windows.click(findWindowsObject(objectId))
				Windows.delay(1)
				return true
			} catch (Exception e) {
				lastError = e
			}
		}

		throw new Exception("Unable to click connect button. Last error: ${lastError?.message}")
	}

	@Keyword
	boolean waitForMainScreen() {
		List<String> candidateObjects = [
			'Object Repository/General/txtSearch',
			'General/txtSearch'
		]

		for (int i = 1; i <= 30; i++) {
			for (String objectId : candidateObjects) {
				if (safeVerifyPresent(objectId, 1)) {
					KeywordUtil.logInfo("Main screen detected with object '${objectId}' at attempt ${i}")
					return true
				}
			}
			Windows.delay(1)
		}

		return false
	}

	@Keyword
	boolean activateHomeTab() {
		List<String> candidateObjects = [
			'Object Repository/General/tabHome',
			'General/tabHome'
		]

		for (String objectId : candidateObjects) {
			if (safeClick(objectId, 2)) {
				KeywordUtil.logInfo("Home tab activated with object '${objectId}'")
				return true
			}
		}

		KeywordUtil.logInfo('Home tab object not found. Continuing without explicit click.')
		return true
	}
}



