import com.kms.katalon.core.annotation.BeforeTestSuite
import com.kms.katalon.core.configuration.RunConfiguration

class DriverSetup {

  @BeforeTestSuite
  def setChromeDriverPath() {

    def projectDir = RunConfiguration.getProjectDir()
    def driverPath = projectDir + '/Drivers/chromedriver.exe'

    println('================ CHROMEDRIVER DEBUG ================')
    println('ProjectDir: ' + projectDir)
    println('DriverPath (expected): ' + driverPath)

    def f = new File(driverPath)
    println('Driver exists? ' + f.exists())
    if (f.exists()) {
      println('Driver size (bytes): ' + f.length())
      println('Driver lastModified: ' + new Date(f.lastModified()))
      println('Driver canonicalPath: ' + f.getCanonicalPath())
      println('Driver absolutePath: ' + f.getAbsolutePath())
    } else {
      println('ERROR: chromedriver.exe NOT FOUND in Drivers folder!')
    }

    // ✅ CORRETO: Selenium lê essa property
    System.setProperty('webdriver.chrome.driver', driverPath)
    println('System property set:')
    println('  webdriver.chrome.driver = ' + System.getProperty('webdriver.chrome.driver'))

    println('Env checks:')
    println('  JAVA_HOME = ' + System.getenv('JAVA_HOME'))
    println('  PATH (first 600 chars) = ' + (System.getenv('PATH') ?: '').take(600))

    // 🔍 Tenta descobrir se tem chromedriver no PATH
    try {
      def p = ['cmd', '/c', 'where chromedriver'].execute()
      def out = p.text
      println('where chromedriver =>')
      println(out?.trim() ? out.trim() : '(no result)')
    } catch (Throwable t) {
      println('where chromedriver failed: ' + t.getMessage())
    }

    // 🔍 Executa o chromedriver da pasta Drivers pra imprimir versão
    try {
      def p2 = ['cmd', '/c', "\"${driverPath}\" --version"].execute()
      def out2 = p2.text
      println('Drivers\\chromedriver.exe --version =>')
      println(out2?.trim() ? out2.trim() : '(no output)')
    } catch (Throwable t) {
      println('chromedriver --version failed: ' + t.getMessage())
    }

    println('====================================================')
  }
}
