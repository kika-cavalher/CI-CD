			OBJECT_GROUP,
			'filterEqualSection',
			'sectionFilterEqualOperator',
			'differentSection',
			'sectionFilterNotEqualOperator',
			timeout
		)

		takeEvidence(
			'Synthese_SectionDifferentFilterApplied.png'
		)

		KeywordUtil.logInfo(
			'[PASS] Synthèse Section filter applied.\n' +
				'Condition: Section is different from ' +
				value
		)
	}

