package jiraIntegration

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil

import java.nio.charset.StandardCharsets
import java.text.SimpleDateFormat
import java.util.Base64
import java.util.Date
import java.util.Locale

class JiraReportSteps {

	private static final ThreadLocal<String> CURRENT_CASE_ID = new ThreadLocal<String>()
	private static final String TRACE_FILE_NAME = '_custom_report_trace.log'
	private static final SimpleDateFormat TRACE_DATE =
			new SimpleDateFormat('yyyy-MM-dd HH:mm:ss.SSS', Locale.ENGLISH)

	@Keyword
	void startCase(String caseId) {
		String effectiveCaseId = safe(caseId)

		if (effectiveCaseId.isEmpty()) {
			KeywordUtil.logInfo('JiraReportSteps.startCase skipped because caseId is empty.')
			return
		}

		CURRENT_CASE_ID.set(effectiveCaseId)
		appendTrace('CASE_START', effectiveCaseId, '')
	}

	@Keyword
	void note(String message) {
		String caseId = safe(CURRENT_CASE_ID.get())
		String text = safe(message)

		if (caseId.isEmpty() || text.isEmpty()) {
			return
		}

		appendTrace('REPORT_STEP', caseId, text)
	}

	@Keyword
	void fail(String fullMessage) {
		String caseId = safe(CURRENT_CASE_ID.get())

		if (caseId.isEmpty()) {
			return
		}

		appendTrace('STEP_FAIL', caseId, safe(fullMessage))
	}

	@Keyword
	void evidence(String absolutePath) {
		String caseId = safe(CURRENT_CASE_ID.get())
		String path = safe(absolutePath)

		if (caseId.isEmpty() || path.isEmpty()) {
			return
		}

		appendTrace('EVIDENCE', caseId, path)
	}

	@Keyword
	void finishCase(String status) {
		String caseId = safe(CURRENT_CASE_ID.get())

		if (caseId.isEmpty()) {
			return
		}

		appendTrace('STATUS', caseId, normalizeStatus(status))
		appendTrace('CASE_END', caseId, '')
		CURRENT_CASE_ID.remove()
	}

	private void appendTrace(String type, String caseId, String payload) {
		File traceFile = resolveTraceFile()

		if (traceFile == null) {
			return
		}

		if (traceFile.parentFile != null && !traceFile.parentFile.exists()) {
			traceFile.parentFile.mkdirs()
		}

		String line =
				TRACE_DATE.format(new Date()) + '\t' +
				safe(type) + '\t' +
				encode64(caseId) + '\t' +
				encode64(payload) +
				System.lineSeparator()

		traceFile.append(line, 'UTF-8')
	}

	private File resolveTraceFile() {
		String reportFolderPath = safe(RunConfiguration.getReportFolder())

		if (!reportFolderPath.isEmpty()) {
			File reportFolder = new File(reportFolderPath)
			if (!reportFolder.exists()) {
				reportFolder.mkdirs()
			}
			return new File(reportFolder, TRACE_FILE_NAME)
		}

		File fallback = new File(RunConfiguration.getProjectDir(), 'Reports')
		if (!fallback.exists()) {
			fallback.mkdirs()
		}

		return new File(fallback, TRACE_FILE_NAME)
	}

	private String encode64(String value) {
		return Base64.encoder.encodeToString(safe(value).getBytes(StandardCharsets.UTF_8))
	}

	private String normalizeStatus(String rawStatus) {
		String upper = safe(rawStatus).toUpperCase(Locale.ENGLISH)

		if (upper == 'PASSED' || upper == 'PASS' || upper == 'SUCCESS') {
			return 'PASSED'
		}

		if (upper == 'FAILED' || upper == 'FAIL' || upper == 'ERROR') {
			return 'FAILED'
		}

		if (upper == 'SKIPPED' || upper == 'SKIP' || upper == 'BLOCKED') {
			return 'BLOCKED'
		}

		return upper.isEmpty() ? 'UNKNOWN' : upper
	}

	private String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}
}
