// SECTION 7 - WINAPPDRIVER / WINDOW DISCOVERY
// =========================================================================

private void ensureWinAppDriverRunning() {
	if (isPortOpen('127.0.0.1', 4723, 500)) {
		KeywordUtil.logInfo("WinAppDriver already running on 127.0.0.1:4723")
		return
	}

	String path = safe(getWinAppDriverPath())
	if (!fileExists(path)) {
		KeywordUtil.markFailedAndStop("WinAppDriver executable was not found at ${path}")
	}

	KeywordUtil.logInfo("Starting WinAppDriver from ${path}")

	Throwable lastError = null

	// tentativa 1 - start normal pelo cmd
	try {
		new ProcessBuilder('cmd.exe', '/c', 'start', '', "\"${path}\"").start()
	} catch (Throwable t) {
		lastError = t
		KeywordUtil.logInfo("WinAppDriver start attempt 1 failed: ${safe(t.message)}")
	}

	if (waitForWinAppDriverPort(10)) {
		KeywordUtil.logInfo("WinAppDriver is ready on 127.0.0.1:4723")
		return
	}

	// tentativa 2 - powershell start-process
	try {
		String script = "Start-Process -FilePath '${escapePowerShell(path)}'"
		new ProcessBuilder(
			'powershell.exe',
			'-NoProfile',
			'-ExecutionPolicy', 'Bypass',
			'-Command', script
		).start()
	} catch (Throwable t) {
		lastError = t
		KeywordUtil.logInfo("WinAppDriver start attempt 2 failed: ${safe(t.message)}")
	}

	if (waitForWinAppDriverPort(15)) {
		KeywordUtil.logInfo("WinAppDriver is ready on 127.0.0.1:4723")
		return
	}

	// tentativa 3 - verificar se o processo abriu mas a porta ainda não respondeu
	try {
		String script = """
\$p = Get-Process WinAppDriver -ErrorAction SilentlyContinue | Select-Object -First 1
if (\$p) { Write-Output 'RUNNING' }
"""
		String output = safe(runPowerShell(script))
		if (output.contains('RUNNING')) {
			KeywordUtil.logInfo("WinAppDriver process exists, waiting extra time for port 4723")
			if (waitForWinAppDriverPort(10)) {
				KeywordUtil.logInfo("WinAppDriver is ready on 127.0.0.1:4723")
				return
			}
		}
	} catch (Throwable t) {
		lastError = t
		KeywordUtil.logInfo("WinAppDriver verification failed: ${safe(t.message)}")
	}

	KeywordUtil.markFailedAndStop(
		"WinAppDriver did not start on port 4723. " +
		"Check admin permission / first manual launch / UAC. " +
		"Last error: ${safe(lastError?.message)}"
	)
}

private boolean waitForWinAppDriverPort(int timeoutSeconds) {
	long end = System.currentTimeMillis() + (timeoutSeconds * 1000L)

	while (System.currentTimeMillis() < end) {
		if (isPortOpen('127.0.0.1', 4723, 500)) {
			return true
		}
		sleepMs(500)
	}

	return false
}

private Map<String, String> queryMainWindow(String expectedTitle) {
	String exact = escapePowerShell(expectedTitle)

	String script = """
\$ErrorActionPreference = 'SilentlyContinue'

\$p = Get-Process |
    Where-Object { \$_.MainWindowTitle -and \$_.MainWindowTitle.Trim() -eq '${exact}' } |
    Select-Object -First 1 MainWindowTitle, MainWindowHandle

if (-not \$p) {
    \$p = Get-Process |
        Where-Object { \$_.MainWindowTitle -and \$_.MainWindowTitle.Trim() -like '*${exact}*' } |
        Select-Object -First 1 MainWindowTitle, MainWindowHandle
}

if (\$p) {
    [PSCustomObject]@{
        title  = [string]\$p.MainWindowTitle
        handle = [string]\$p.MainWindowHandle
    } | ConvertTo-Json -Compress
}
"""

	String output = safe(runPowerShell(script))
	if (!output) {
		return [title: '', handle: '']
	}

	String jsonLine = output.readLines().find { it?.trim()?.startsWith('{') && it?.trim()?.endsWith('}') }
	if (!jsonLine) {
		return [title: '', handle: '']
	}

	try {
		def parsed = new JsonSlurper().parseText(jsonLine)
		return [
			title : safe(parsed?.title),
			handle: safe(parsed?.handle)
		]
	} catch (Throwable ignored) {
		return [title: '', handle: '']
	}
}
