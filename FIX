import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil

import internal.GlobalVariable


// ======================================================
// VALIDATION CONFIG
// ======================================================

Integer columnIndex = 28

String validationName = 'Élément Valorisé'
String expectedColumnName = 'Valo Finale CCY'

String exportRootFolder = 'C:\\KatalonExport'
String exportFeatureFolder = 'Emission_Element_Valorise'

Integer sheetIndex = 0

// ======================================================
// TEST FLOW
// ======================================================

String errors = ''
String passedDetails = ''

FileInputStream inputRec = null
FileInputStream inputPrd = null

Workbook workbookRec = null
Workbook workbookPrd = null

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Start REC x PRD validation\n' +
	'Feature: ' + validationName + '\n' +
	'Column index: ' + columnIndex + '\n' +
	'Expected column: ' + expectedColumnName
)

try {

	// ======================================================
	// RESOLVE REC AND PRD FILES
	// ======================================================

	List compareFiles = []

	try {
		if (GlobalVariable.compareFiles != null) {
			compareFiles.addAll(
				GlobalVariable.compareFiles as List
			)
		}
	} catch (Exception ignored) {
		compareFiles = []
	}

	File recFile = null
	File prdFile = null

	if (compareFiles.size() >= 2) {

		CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
			'Resolve files received from export execution\n' +
			'Available files: ' + compareFiles.size()
		)

		recFile = resolveFileByEnvironment(
			compareFiles,
			'REC'
		)

		prdFile = resolveFileByEnvironment(
			compareFiles,
			'PRD'
		)
	}

	if (recFile == null || prdFile == null) {

		CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
			'Search exported files in export folder\n' +
			'Root folder: ' + folderNameOnly(exportRootFolder) + '\n' +
			'Feature folder: ' + exportFeatureFolder
		)

		Map discoveredFiles = findLatestRecPrdFiles(
			new File(exportRootFolder),
			exportFeatureFolder
		)

		if (recFile == null) {
			recFile = discoveredFiles.recFile as File
		}

		if (prdFile == null) {
			prdFile = discoveredFiles.prdFile as File
		}
	}

	if (recFile == null || !recFile.exists()) {

		errors +=
			'[ERROR] REC exported file was not found.\n' +
			'Search root: ' + folderNameOnly(exportRootFolder) + '\n' +
			'Feature folder: ' + exportFeatureFolder + '\n'
	}

	if (prdFile == null || !prdFile.exists()) {

		errors +=
			'[ERROR] PRD exported file was not found.\n' +
			'Search root: ' + folderNameOnly(exportRootFolder) + '\n' +
			'Feature folder: ' + exportFeatureFolder + '\n'
	}

	if (!errors.isEmpty()) {

		CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
			'[FAIL] Files selected for validation\n' +
			'REC file: ' +
			(recFile == null ? 'NOT FOUND' : recFile.getName()) + '\n' +
			'PRD file: ' +
			(prdFile == null ? 'NOT FOUND' : prdFile.getName())
		)

		KeywordUtil.markFailedAndStop(
			'Exported files validation cannot be executed.\n' +
			errors.trim()
		)
	}

	GlobalVariable.compareFiles = [
		recFile.getAbsolutePath(),
		prdFile.getAbsolutePath()
	]

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[PASS] Files selected for validation\n' +
		'REC file: ' + recFile.getName() + '\n' +
		'PRD file: ' + prdFile.getName()
	)

	// ======================================================
	// OPEN WORKBOOKS
	// ======================================================

	inputRec = new FileInputStream(recFile)
	inputPrd = new FileInputStream(prdFile)

	workbookRec = WorkbookFactory.create(inputRec)
	workbookPrd = WorkbookFactory.create(inputPrd)

	if (workbookRec.getNumberOfSheets() <= sheetIndex) {

		KeywordUtil.markFailedAndStop(
			'REC workbook does not contain sheet index ' +
			sheetIndex + '.\n' +
			'File: ' + recFile.getName()
		)
	}

	if (workbookPrd.getNumberOfSheets() <= sheetIndex) {

		KeywordUtil.markFailedAndStop(
			'PRD workbook does not contain sheet index ' +
			sheetIndex + '.\n' +
			'File: ' + prdFile.getName()
		)
	}

	Sheet sheetRec = workbookRec.getSheetAt(sheetIndex)
	Sheet sheetPrd = workbookPrd.getSheetAt(sheetIndex)

	DataFormatter formatter = new DataFormatter()

	// ======================================================
	// VALIDATE COLUMN
	// ======================================================

	String recColumnName = readColumnName(
		sheetRec,
		columnIndex,
		formatter
	)

	String prdColumnName = readColumnName(
		sheetPrd,
		columnIndex,
		formatter
	)

	String columnName = recColumnName

	if (columnName.isEmpty()) {
		columnName = expectedColumnName
	}

	if (recColumnName.isEmpty()) {

		errors +=
			'[ERROR] REC column was not found.\n' +
			'Column index: ' + columnIndex + '\n'
	}

	if (prdColumnName.isEmpty()) {

		errors +=
			'[ERROR] PRD column was not found.\n' +
			'Column index: ' + columnIndex + '\n'
	}

	if (!recColumnName.isEmpty() &&
		!recColumnName.equalsIgnoreCase(expectedColumnName)) {

		errors +=
			'[ERROR] Unexpected REC column found.\n' +
			'Expected: ' + expectedColumnName + '\n' +
			'Found: ' + recColumnName + '\n'
	}

	if (!prdColumnName.isEmpty() &&
		!prdColumnName.equalsIgnoreCase(expectedColumnName)) {

		errors +=
			'[ERROR] Unexpected PRD column found.\n' +
			'Expected: ' + expectedColumnName + '\n' +
			'Found: ' + prdColumnName + '\n'
	}

	if (!recColumnName.isEmpty() &&
		!prdColumnName.isEmpty() &&
		!recColumnName.equalsIgnoreCase(prdColumnName)) {

		errors +=
			'[ERROR] REC and PRD column names are different.\n' +
			'REC: ' + recColumnName + '\n' +
			'PRD: ' + prdColumnName + '\n'
	}

	// ======================================================
	// VALIDATE ROWS
	// ======================================================

	Integer recRows = countDataRows(
		sheetRec,
		formatter
	)

	Integer prdRows = countDataRows(
		sheetPrd,
		formatter
	)

	if (recRows != prdRows) {

		errors +=
			'[ERROR] Number of rows is different.\n' +
			'REC: ' + recRows + '\n' +
			'PRD: ' + prdRows + '\n'
	} else {

		passedDetails +=
			'[PASS] Number of rows is equal.\n' +
			'REC: ' + recRows + '\n' +
			'PRD: ' + prdRows + '\n'
	}

	// ======================================================
	// CALCULATE COLUMN STATISTICS
	// ======================================================

	Map recStatistics = calculateColumnStatistics(
		sheetRec,
		columnIndex
	)

	Map prdStatistics = calculateColumnStatistics(
		sheetPrd,
		columnIndex
	)

	if (!(recStatistics.hasNumericValues as boolean)) {

		errors +=
			'[ERROR] REC column does not contain numeric values.\n' +
			'Column: ' + columnName + '\n'
	}

	if (!(prdStatistics.hasNumericValues as boolean)) {

		errors +=
			'[ERROR] PRD column does not contain numeric values.\n' +
			'Column: ' + columnName + '\n'
	}

	if (!(recStatistics.hasNumericValues as boolean) ||
		!(prdStatistics.hasNumericValues as boolean)) {

		KeywordUtil.markFailedAndStop(
			'Column statistics validation cannot be executed.\n' +
			errors.trim()
		)
	}

	BigDecimal recSum =
		(recStatistics.sum as BigDecimal).setScale(
			2,
			RoundingMode.HALF_EVEN
		)

	BigDecimal prdSum =
		(prdStatistics.sum as BigDecimal).setScale(
			2,
			RoundingMode.HALF_EVEN
		)

	BigDecimal recMinimum =
		(recStatistics.minimum as BigDecimal).setScale(
			2,
			RoundingMode.HALF_EVEN
		)

	BigDecimal prdMinimum =
		(prdStatistics.minimum as BigDecimal).setScale(
			2,
			RoundingMode.HALF_EVEN
		)

	BigDecimal recMaximum =
		(recStatistics.maximum as BigDecimal).setScale(
			2,
			RoundingMode.HALF_EVEN
		)

	BigDecimal prdMaximum =
		(prdStatistics.maximum as BigDecimal).setScale(
			2,
			RoundingMode.HALF_EVEN
		)

	// ======================================================
	// VALIDATE SUM
	// ======================================================

	if (recSum.compareTo(prdSum) != 0) {

		errors +=
			'[ERROR] Column sum is different.\n' +
			'Column: ' + columnName + '\n' +
			'REC: ' + recSum + '\n' +
			'PRD: ' + prdSum + '\n'
	} else {

		passedDetails +=
			'[PASS] Column sum is equal.\n' +
			'Column: ' + columnName + '\n' +
			'Value: ' + recSum + '\n'
	}

	// ======================================================
	// VALIDATE MINIMUM
	// ======================================================

	if (recMinimum.compareTo(prdMinimum) != 0) {

		errors +=
			'[ERROR] Minimum value is different.\n' +
			'Column: ' + columnName + '\n' +
			'REC: ' + recMinimum + '\n' +
			'PRD: ' + prdMinimum + '\n'
	} else {

		passedDetails +=
			'[PASS] Minimum value is equal.\n' +
			'Column: ' + columnName + '\n' +
			'Value: ' + recMinimum + '\n'
	}

	// ======================================================
	// VALIDATE MAXIMUM
	// ======================================================

	if (recMaximum.compareTo(prdMaximum) != 0) {

		errors +=
			'[ERROR] Maximum value is different.\n' +
			'Column: ' + columnName + '\n' +
			'REC: ' + recMaximum + '\n' +
			'PRD: ' + prdMaximum + '\n'
	} else {

		passedDetails +=
			'[PASS] Maximum value is equal.\n' +
			'Column: ' + columnName + '\n' +
			'Value: ' + recMaximum + '\n'
	}

	// ======================================================
	// REPORT STATISTICS
	// ======================================================

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		(errors.isEmpty() ? '[PASS] ' : '[FAIL] ') +
		'Excel validation result\n' +
		'Column: ' + columnName + '\n' +
		'REC file: ' + recFile.getName() + '\n' +
		'PRD file: ' + prdFile.getName() + '\n' +
		'REC rows: ' + recRows + '\n' +
		'PRD rows: ' + prdRows + '\n' +
		'REC sum: ' + recSum + '\n' +
		'PRD sum: ' + prdSum + '\n' +
		'REC minimum: ' + recMinimum + '\n' +
		'PRD minimum: ' + prdMinimum + '\n' +
		'REC maximum: ' + recMaximum + '\n' +
		'PRD maximum: ' + prdMaximum
	)

} catch (Exception exception) {

	if (exception.getClass().getSimpleName() == 'StepFailedException') {
		throw exception
	}

	String exceptionMessage =
		exception.getMessage() == null ?
		'No exception message available.' :
		exception.getMessage()

	errors +=
		'[ERROR] Unexpected validation error.\n' +
		'Exception: ' +
		exception.getClass().getSimpleName() + '\n' +
		'Message: ' + exceptionMessage + '\n'

} finally {

	try {
		if (workbookRec != null) {
			workbookRec.close()
		}
	} catch (Exception ignored) {
	}

	try {
		if (workbookPrd != null) {
			workbookPrd.close()
		}
	} catch (Exception ignored) {
	}

	try {
		if (inputRec != null) {
			inputRec.close()
		}
	} catch (Exception ignored) {
	}

	try {
		if (inputPrd != null) {
			inputPrd.close()
		}
	} catch (Exception ignored) {
	}
}

// ======================================================
// FINAL RESULT
// ======================================================

if (!errors.isEmpty()) {

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[FAIL] Final validation result\n' +
		errors.trim() +
		(
			passedDetails.trim().isEmpty() ?
			'' :
			'\n\nSuccessful validations\n' +
			passedDetails.trim()
		)
	)

	KeywordUtil.markFailed(
		'REC x PRD validation failed for ' +
		validationName + '.\n' +
		errors.trim()
	)

} else {

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[PASS] Final validation result\n' +
		'REC x PRD validation completed successfully.\n\n' +
		passedDetails.trim()
	)

	KeywordUtil.markPassed(
		'REC x PRD validation completed successfully for ' +
		validationName + '.'
	)
}


// ======================================================
// FILE RESOLUTION
// ======================================================

File resolveFileByEnvironment(
		List fileValues,
		String environment) {

	if (fileValues == null || fileValues.isEmpty()) {
		return null
	}

	String prefix = environment.toUpperCase() + '_'

	List<File> candidates = []

	for (Object value : fileValues) {

		if (value == null) {
			continue
		}

		File file = new File(
			String.valueOf(value).trim()
		)

		if (file.exists() &&
			file.isFile() &&
			file.getName().toUpperCase().startsWith(prefix) &&
			isExcelFile(file)) {

			candidates.add(file)
		}
	}

	if (candidates.isEmpty()) {
		return null
	}

	candidates.sort { File first, File second ->
		second.lastModified() <=> first.lastModified()
	}

	return candidates.get(0)
}

Map findLatestRecPrdFiles(
		File exportRoot,
		String expectedFeatureFolder) {

	Map result = [
		recFile : null,
		prdFile : null
	]

	if (exportRoot == null ||
		!exportRoot.exists() ||
		!exportRoot.isDirectory()) {

		return result
	}

	List<File> allExcelFiles = []

	collectExcelFilesRecursively(
		exportRoot,
		allExcelFiles
	)

	String normalizedFeatureFolder =
		normalizeSearchText(expectedFeatureFolder)

	List<File> featureFiles = allExcelFiles.findAll { File file ->

		String normalizedPath =
			normalizeSearchText(
				file.getParentFile() == null ?
				'' :
				file.getParentFile().getAbsolutePath()
			)

		return normalizedFeatureFolder.isEmpty() ||
			normalizedPath.contains(normalizedFeatureFolder)
	}

	if (featureFiles.isEmpty()) {
		featureFiles = allExcelFiles
	}

	Map<String, List<File>> filesByFolder =
		featureFiles.groupBy { File file ->

			return file.getParentFile() == null ?
				'' :
				file.getParentFile().getAbsolutePath()
		}

	List<Map> validFolders = []

	filesByFolder.each { String folderPath, List<File> folderFiles ->

		List<File> recFiles = folderFiles.findAll { File file ->
			file.getName()
				.toUpperCase()
				.startsWith('REC_')
		}

		List<File> prdFiles = folderFiles.findAll { File file ->
			file.getName()
				.toUpperCase()
				.startsWith('PRD_')
		}

		if (!recFiles.isEmpty() && !prdFiles.isEmpty()) {

			recFiles.sort { File first, File second ->
				second.lastModified() <=> first.lastModified()
			}

			prdFiles.sort { File first, File second ->
				second.lastModified() <=> first.lastModified()
			}

			File recFile = recFiles.get(0)
			File prdFile = prdFiles.get(0)

			Long folderTimestamp = Math.max(
				recFile.lastModified(),
				prdFile.lastModified()
			)

			validFolders.add([
				recFile   : recFile,
				prdFile   : prdFile,
				timestamp : folderTimestamp
			])
		}
	}

	if (!validFolders.isEmpty()) {

		validFolders.sort { Map first, Map second ->
			(second.timestamp as Long) <=>
			(first.timestamp as Long)
		}

		Map latestFolder = validFolders.get(0)

		result.recFile = latestFolder.recFile
		result.prdFile = latestFolder.prdFile

		return result
	}

	List<File> recFiles = featureFiles.findAll { File file ->
		file.getName()
			.toUpperCase()
			.startsWith('REC_')
	}

	List<File> prdFiles = featureFiles.findAll { File file ->
		file.getName()
			.toUpperCase()
			.startsWith('PRD_')
	}

	recFiles.sort { File first, File second ->
		second.lastModified() <=> first.lastModified()
	}

	prdFiles.sort { File first, File second ->
		second.lastModified() <=> first.lastModified()
	}

	if (!recFiles.isEmpty()) {
		result.recFile = recFiles.get(0)
	}

	if (!prdFiles.isEmpty()) {
		result.prdFile = prdFiles.get(0)
	}

	return result
}

void collectExcelFilesRecursively(
		File directory,
		List<File> result) {

	if (directory == null ||
		!directory.exists() ||
		!directory.isDirectory()) {

		return
	}

	File[] children = directory.listFiles()

	if (children == null) {
		return
	}

	for (File child : children) {

		if (child.isDirectory()) {

			collectExcelFilesRecursively(
				child,
				result
			)

		} else if (
			child.isFile() &&
			isExcelFile(child) &&
			!child.getName().startsWith('~$')
		) {

			result.add(child)
		}
	}
}

boolean isExcelFile(File file) {

	if (file == null) {
		return false
	}

	String fileName = file.getName().toLowerCase()

	return fileName.endsWith('.xlsx') ||
		fileName.endsWith('.xls') ||
		fileName.endsWith('.xlsm')
}

// ======================================================
// EXCEL VALIDATION
// ======================================================

String readColumnName(
		Sheet sheet,
		Integer columnIndex,
		DataFormatter formatter) {

	if (sheet == null ||
		columnIndex == null ||
		columnIndex < 0) {

		return ''
	}

	Row headerRow = sheet.getRow(0)

	if (headerRow == null ||
		headerRow.getCell(columnIndex) == null) {

		return ''
	}

	return formatter
		.formatCellValue(
			headerRow.getCell(columnIndex)
		)
		.trim()
}

Integer countDataRows(
		Sheet sheet,
		DataFormatter formatter) {

	if (sheet == null) {
		return 0
	}

	Integer count = 0

	for (Integer rowIndex = 1;
		rowIndex <= sheet.getLastRowNum();
		rowIndex++) {

		Row row = sheet.getRow(rowIndex)

		if (!isRowEmpty(row, formatter)) {
			count++
		}
	}

	return count
}

Map calculateColumnStatistics(
		Sheet sheet,
		Integer columnIndex) {

	BigDecimal sum = BigDecimal.ZERO
	BigDecimal minimum = null
	BigDecimal maximum = null

	Integer numericValues = 0

	DataFormatter formatter = new DataFormatter()

	for (Integer rowIndex = 1;
		rowIndex <= sheet.getLastRowNum();
		rowIndex++) {

		Row row = sheet.getRow(rowIndex)

		if (row == null ||
			row.getCell(columnIndex) == null) {

			continue
		}

		String cellText = formatter
			.formatCellValue(
				row.getCell(columnIndex)
			)
			.trim()

		BigDecimal value = parseNumber(cellText)

		if (value == null) {
			continue
		}

		sum = sum.add(value)

		if (minimum == null ||
			value.compareTo(minimum) < 0) {

			minimum = value
		}

		if (maximum == null ||
			value.compareTo(maximum) > 0) {

			maximum = value
		}

		numericValues++
	}

	return [
		hasNumericValues : numericValues > 0,
		numericValues    : numericValues,
		sum              : sum,
		minimum          : minimum,
		maximum          : maximum
	]
}

BigDecimal parseNumber(String value) {

	if (value == null ||
		value.trim().isEmpty()) {

		return null
	}

	String text = value
		.replace('\u00A0', ' ')
		.replace('\u202F', ' ')
		.replace('\u2212', '-')
		.replace('\u2012', '-')
		.replace('\u2013', '-')
		.replace('\u2014', '-')
		.replace('\u2015', '-')
		.trim()

	boolean negativeByParentheses =
		text.startsWith('(') &&
		text.endsWith(')')

	boolean negativeByTrailingMinus =
		text.endsWith('-')

	text = text
		.replaceAll('[^0-9,\\.\\-\\(\\)]', '')
		.replace('(', '')
		.replace(')', '')

	if (negativeByTrailingMinus &&
		text.endsWith('-')) {

		text = text.substring(
			0,
			text.length() - 1
		)
	}

	boolean negative =
		text.startsWith('-') ||
		negativeByParentheses ||
		negativeByTrailingMinus

	text = text.replace('-', '')

	if (text.isEmpty()) {
		return null
	}

	String normalized =
		normalizeNumericSeparators(text)

	if (normalized.isEmpty()) {
		return null
	}

	try {

		BigDecimal result =
			new BigDecimal(normalized)

		if (negative &&
			result.compareTo(BigDecimal.ZERO) > 0) {

			result = result.negate()
		}

		return result

	} catch (Exception ignored) {

		return null
	}
}

String normalizeNumericSeparators(String value) {

	Integer commaCount =
		countOccurrences(value, ',')

	Integer dotCount =
		countOccurrences(value, '.')

	if (commaCount > 0 &&
		dotCount > 0) {

		Integer lastComma =
			value.lastIndexOf(',')

		Integer lastDot =
			value.lastIndexOf('.')

		if (lastComma > lastDot) {

			return value
				.replace('.', '')
				.replace(',', '.')
		}

		return value.replace(',', '')
	}

	if (commaCount > 0) {

		return normalizeSingleSeparator(
			value,
			','
		)
	}

	if (dotCount > 0) {

		return normalizeSingleSeparator(
			value,
			'.'
		)
	}

	return value
}

String normalizeSingleSeparator(
		String value,
		String separator) {

	Integer separatorCount =
		countOccurrences(
			value,
			separator
		)

	if (separatorCount > 1) {

		Integer lastSeparator =
			value.lastIndexOf(separator)

		String decimals =
			value.substring(lastSeparator + 1)

		if (decimals.length() == 1 ||
			decimals.length() == 2) {

			String integerPart =
				value
					.substring(0, lastSeparator)
					.replace(separator, '')

			return integerPart +
				'.' +
				decimals
		}

		return value.replace(separator, '')
	}

	Integer separatorIndex =
		value.indexOf(separator)

	String before =
		value.substring(0, separatorIndex)

	String after =
		value.substring(separatorIndex + 1)

	if (after.length() == 3 &&
		before.length() >= 1 &&
		before.length() <= 3) {

		return before + after
	}

	if (separator == ',') {
		return before + '.' + after
	}

	return value
}

Integer countOccurrences(
		String value,
		String token) {

	Integer count = 0
	Integer index = 0

	while (index >= 0) {

		index = value.indexOf(
			token,
			index
		)

		if (index >= 0) {

			count++

			index += token.length()
		}
	}

	return count
}

boolean isRowEmpty(
		Row row,
		DataFormatter formatter) {

	if (row == null ||
		row.getLastCellNum() <= 0) {

		return true
	}

	for (Integer columnIndex = 0;
		columnIndex < row.getLastCellNum();
		columnIndex++) {

		if (row.getCell(columnIndex) != null) {

			String value = formatter
				.formatCellValue(
					row.getCell(columnIndex)
				)
				.trim()

			if (!value.isEmpty()) {
				return false
			}
		}
	}

	return true
}

// ======================================================
// TEXT HELPERS
// ======================================================

String normalizeSearchText(String value) {

	if (value == null) {
		return ''
	}

	return value
		.toLowerCase()
		.replace('\\', '/')
		.replace(' ', '_')
		.replace('-', '_')
		.replaceAll('_+', '_')
		.trim()
}

String folderNameOnly(String value) {

	if (value == null ||
		value.trim().isEmpty()) {

		return 'NOT CONFIGURED'
	}

	File folder = new File(value)

	return folder.getName().isEmpty() ?
		value :
		folder.getName()
}
