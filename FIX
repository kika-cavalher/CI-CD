package jiraIntegration

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import org.openqa.selenium.OutputType

import javax.imageio.ImageIO

import java.awt.GraphicsEnvironment
import java.awt.Rectangle
import java.awt.Robot
import java.awt.Toolkit
import java.awt.image.BufferedImage
import java.text.SimpleDateFormat
import java.util.Locale

class JiraImagesEvidence {

    private static final SimpleDateFormat TRACE_STAMP =
        new SimpleDateFormat('yyyy-MM-dd HH:mm:ss.SSS', Locale.ENGLISH)

    private static final SimpleDateFormat FILE_STAMP =
        new SimpleDateFormat('yyyyMMdd_HHmmss_SSS', Locale.ENGLISH)

    private static final ThreadLocal<String> CURRENT_CASE_ID = new ThreadLocal<String>()
    private static final ThreadLocal<File> CURRENT_CASE_FOLDER = new ThreadLocal<File>()

    @Keyword
    def startCase(String caseId) {
        String resolvedCaseId = safe(caseId)
        if (resolvedCaseId.isEmpty()) {
            return
        }

        File caseFolder = ensureCaseFolder(resolvedCaseId)

        CURRENT_CASE_ID.set(resolvedCaseId)
        CURRENT_CASE_FOLDER.set(caseFolder)

        writeTrace(caseFolder, 'CASE_START', nowStamp(), resolvedCaseId)
    }

    @Keyword
    def finishCase(String status = '', String rawFailureMessage = '') {
        String caseId = safe(CURRENT_CASE_ID.get())
        File caseFolder = resolveCurrentCaseFolder()

        if (caseFolder == null) {
            return
        }

        String normalizedStatus = normalizeStatus(status)

        if (!normalizedStatus.isEmpty()) {
            writeTrace(caseFolder, 'STATUS', nowStamp(), normalizedStatus)
        }

        String failureText = safe(rawFailureMessage)
        if (!failureText.isEmpty()) {
            File failureFile = new File(caseFolder, 'failure.txt')
            failureFile.write(failureText, 'UTF-8')
            writeTrace(caseFolder, 'FAILURE_FILE', nowStamp(), failureFile.absolutePath)
        }

        writeTrace(caseFolder, 'CASE_END', nowStamp(), caseId)

        CURRENT_CASE_ID.remove()
        CURRENT_CASE_FOLDER.remove()
    }

    @Keyword
    def note(String message) {
        writeStep(message)
    }

    @Keyword
    def checkpoint(String message) {
        writeStep(message)
    }

    @Keyword
    String captureNow(String label = 'manual') {
        File file = captureEvidence(firstNonBlank(label, 'manual'))
        return file != null ? file.absolutePath : ''
    }

    @Keyword
    def noteAndCapture(String message, String label = 'manual') {
        writeStep(message)
        captureNow(label)
    }

    @Keyword
    String autoFailure(String caseId = '') {
        if (resolveCurrentCaseFolder() == null && !safe(caseId).isEmpty()) {
            startCase(caseId)
        }

        File file = captureEvidence('auto-failure')
        return file != null ? file.absolutePath : ''
    }

    private void writeStep(String message) {
        File caseFolder = resolveCurrentCaseFolder()
        if (caseFolder == null) {
            return
        }

        String detail = safe(message)
        if (detail.isEmpty()) {
            return
        }

        writeTrace(caseFolder, 'STEP', nowStamp(), detail)
    }

    private File captureEvidence(String label) {
        File caseFolder = resolveCurrentCaseFolder()
        if (caseFolder == null) {
            return null
        }

        String fileName = FILE_STAMP.format(new Date()) + '_' + sanitizeFragment(label) + '.png'
        File output = new File(caseFolder, fileName)

        boolean saved = tryDriverScreenshot(output)
        if (!saved) {
            saved = captureDesktopScreenshot(output)
        }

        if (!saved || !output.exists()) {
            return null
        }

        writeTrace(caseFolder, 'SCREENSHOT', nowStamp(), output.absolutePath)
        KeywordUtil.logInfo('Evidence screenshot saved: ' + output.absolutePath)

        return output
    }

    private boolean tryDriverScreenshot(File output) {
        try {
            def driver = Windows.getDriver()
            if (driver == null) {
                return false
            }

            byte[] bytes = driver.getScreenshotAs(OutputType.BYTES)
            if (bytes == null || bytes.length == 0) {
                return false
            }

            output.bytes = bytes
            return true
        } catch (Throwable ignored) {
            return false
        }
    }

    private boolean captureDesktopScreenshot(File output) {
        try {
            if (GraphicsEnvironment.isHeadless()) {
                return false
            }

            Rectangle screenRect = new Rectangle(Toolkit.getDefaultToolkit().getScreenSize())
            BufferedImage image = new Robot().createScreenCapture(screenRect)
            ImageIO.write(image, 'png', output)

            return output.exists()
        } catch (Throwable ignored) {
            return false
        }
    }

    private File resolveCurrentCaseFolder() {
        File existing = CURRENT_CASE_FOLDER.get()
        if (existing != null) {
            return existing
        }

        String caseId = safe(CURRENT_CASE_ID.get())
        if (caseId.isEmpty()) {
            return null
        }

        File folder = ensureCaseFolder(caseId)
        CURRENT_CASE_FOLDER.set(folder)
        return folder
    }

    private File ensureCaseFolder(String caseId) {
        File reportFolder = new File(RunConfiguration.getReportFolder())
        File evidencesRoot = new File(reportFolder, 'Evidences')

        if (!evidencesRoot.exists()) {
            evidencesRoot.mkdirs()
        }

        File caseFolder = new File(evidencesRoot, sanitizeCaseId(caseId))
        if (!caseFolder.exists()) {
            caseFolder.mkdirs()
        }

        return caseFolder
    }

    private void writeTrace(File caseFolder, String type, String timestamp, String payload) {
        File traceFile = new File(caseFolder, 'trace.log')
        String cleanPayload = safe(payload)
            .replace('\r', ' ')
            .replace('\n', ' ')
            .trim()

        traceFile << safe(type) + '|' + safe(timestamp) + '|' + cleanPayload + System.lineSeparator()
    }

    private String normalizeStatus(String status) {
        String upper = safe(status).toUpperCase(Locale.ENGLISH)

        if (upper == 'PASSED' || upper == 'PASS' || upper == 'SUCCESS') {
            return 'passed'
        }
        if (upper == 'FAILED' || upper == 'FAIL' || upper == 'ERROR') {
            return 'failed'
        }
        if (upper == 'SKIPPED' || upper == 'SKIP' || upper == 'BLOCKED') {
            return 'blocked'
        }

        return upper.isEmpty() ? '' : upper.toLowerCase(Locale.ENGLISH)
    }

    private String sanitizeCaseId(String value) {
        return safe(value)
            .replace('\\', '_')
            .replace('/', '_')
            .replace(':', '_')
            .replace('*', '_')
            .replace('?', '_')
            .replace('"', '_')
            .replace('<', '_')
            .replace('>', '_')
            .replace('|', '_')
            .replaceAll('[^A-Za-z0-9._-]+', '_')
            .replaceAll('_+', '_')
            .replaceAll('^_+|_+$', '')
    }

    private String sanitizeFragment(String value) {
        String sanitized = safe(value)
            .replaceAll('[^A-Za-z0-9._-]+', '-')
            .replaceAll('-+', '-')
            .replaceAll('^-+|-+$', '')

        return sanitized.isEmpty() ? 'capture' : sanitized
    }

    private String nowStamp() {
        return TRACE_STAMP.format(new Date())
    }

    private String firstNonBlank(Object... values) {
        if (values == null) {
            return ''
        }

        for (Object value : values) {
            String text = safe(value)
            if (!text.isEmpty()) {
                return text
            }
        }

        return ''
    }

    private String safe(Object value) {
        return value == null ? '' : String.valueOf(value).trim()
    }
}











import com.kms.katalon.core.annotation.AfterTestCase
import com.kms.katalon.core.annotation.BeforeTestCase
import com.kms.katalon.core.context.TestCaseContext
import com.kms.katalon.core.util.KeywordUtil

class ematchReport {

    @BeforeTestCase
    def beforeCase(TestCaseContext testCaseContext) {
        try {
            String caseId = safe(testCaseContext != null ? testCaseContext.getTestCaseId() : '')
            if (caseId.isEmpty()) {
                return
            }

            CustomKeywords.'jiraIntegration.JiraImagesEvidence.startCase'(caseId)
        } catch (Throwable t) {
            KeywordUtil.logInfo('Report listener beforeCase failed: ' + safe(t.message))
        }
    }

    @AfterTestCase
    def afterCase(TestCaseContext testCaseContext) {
        try {
            String caseId = safe(testCaseContext != null ? testCaseContext.getTestCaseId() : '')
            String status = normalizeStatus(testCaseContext != null ? testCaseContext.getTestCaseStatus() : '')
            String rawMessage = safe(testCaseContext != null ? testCaseContext.getMessage() : '')

            if ('failed'.equalsIgnoreCase(status) || 'blocked'.equalsIgnoreCase(status)) {
                try {
                    CustomKeywords.'jiraIntegration.JiraImagesEvidence.autoFailure'(caseId)
                } catch (Throwable ignored) {
                }
            }

            CustomKeywords.'jiraIntegration.JiraImagesEvidence.finishCase'(status, rawMessage)
        } catch (Throwable t) {
            KeywordUtil.logInfo('Report listener afterCase failed: ' + safe(t.message))
        }
    }

    private String normalizeStatus(String rawStatus) {
        String upper = safe(rawStatus).toUpperCase(Locale.ENGLISH)

        if (upper == 'PASSED' || upper == 'PASS' || upper == 'SUCCESS') {
            return 'passed'
        }
        if (upper == 'FAILED' || upper == 'FAIL' || upper == 'ERROR') {
            return 'failed'
        }
        if (upper == 'SKIPPED' || upper == 'SKIP' || upper == 'BLOCKED') {
            return 'blocked'
        }

        return upper.isEmpty() ? 'blocked' : upper.toLowerCase(Locale.ENGLISH)
    }

    private String safe(Object value) {
        return value == null ? '' : String.valueOf(value).trim()
    }
}















