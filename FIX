                font-size: 12px;
                text-decoration: none;
            }

            .evidence-link:hover {
                text-decoration: underline;
            }

            .evidence-preview {
                margin-top: 10px;
                max-width: 100%;
                max-height: 360px;
                border: 1px solid var(--border);
                border-radius: 10px;
