	private WindowsDriver attachExistingWindowByHandle(Object handleValue) {
		String handleDec = safe(handleValue)

		if (!handleDec) {
			KeywordUtil.markFailedAndStop("Window handle is empty")
		}

		long handleLong
		try {
			handleLong = Long.parseLong(handleDec)
		} catch (Throwable ignored) {
			KeywordUtil.markFailedAndStop("Window handle is invalid: ${handleDec}")
			return null
		}

		String handleHex = Long.toHexString(handleLong).toUpperCase()
		URL serverUrl = new URL(DEFAULT_WINAPPDRIVER_URL)

		DesiredCapabilities caps = new DesiredCapabilities()
		caps.setCapability('platformName', 'Windows')
		caps.setCapability('deviceName', 'WindowsPC')
		caps.setCapability('appTopLevelWindow', handleHex)
		caps.setCapability('ms:waitForAppLaunch', '60')

		KeywordUtil.logInfo("Attaching by native handle ${handleHex} using ${serverUrl}")

		WindowsDriver driver = new WindowsDriver(serverUrl, caps)
		registerWindowsDriver(driver)
		return driver
	}

	private void registerWindowsDriver(WindowsDriver driver) {
		DriverFactory.changeWebDriver(driver)

		boolean registered = false

		try {
			Class<?> factoryClass = Class.forName('com.kms.katalon.core.windows.driver.WindowsDriverFactory')

			registered = tryInvokeFactoryRegistration(factoryClass, driver)

			if (!registered) {
				Object sessionObj = buildWindowsSession(driver)
				if (sessionObj != null) {
					setStaticFieldIfExists(factoryClass, 'windowsSession', sessionObj)
					registered = true
				}
			}

			setStaticFieldIfExists(factoryClass, 'driver', driver)
			setStaticFieldIfExists(factoryClass, 'webDriver', driver)
			setStaticFieldIfExists(factoryClass, 'windowsDriver', driver)

			if (!registered) {
				KeywordUtil.markFailedAndStop("Could not register Windows session into WindowsDriverFactory")
			}

			KeywordUtil.logInfo("Windows session registered into WindowsDriverFactory")
			return
		} catch (Throwable t) {
			KeywordUtil.markFailedAndStop("Could not register Windows driver: ${safe(t.message)}")
		}
	}

	private boolean tryInvokeFactoryRegistration(Class<?> factoryClass, WindowsDriver driver) {
		List<String> methodNames = [
			'changeWindowsDriver',
			'changeDriver',
			'setDriver',
			'setWindowsSession',
			'changeSession'
		]

		for (String methodName : methodNames) {
			try {
				def method = factoryClass.declaredMethods.find {
					it.name == methodName && it.parameterCount == 1
				}

				if (method == null) {
					continue
				}

				method.setAccessible(true)

				Class<?> paramType = method.parameterTypes[0]

				if (paramType.isAssignableFrom(driver.getClass())) {
					method.invoke(null, driver)
					KeywordUtil.logInfo("WindowsDriverFactory.${methodName} registered driver directly")
					return true
				}

				Object sessionObj = buildWindowsSession(driver)
				if (sessionObj != null && paramType.isAssignableFrom(sessionObj.getClass())) {
					method.invoke(null, sessionObj)
					KeywordUtil.logInfo("WindowsDriverFactory.${methodName} registered WindowsSession")
					return true
				}
			} catch (Throwable ignored) {
			}
		}

		return false
	}

	private Object buildWindowsSession(WindowsDriver driver) {
		try {
			Class<?> sessionClass = Class.forName('com.kms.katalon.core.windows.driver.WindowsSession')

			for (def ctor : sessionClass.declaredConstructors) {
				try {
					ctor.setAccessible(true)

					if (ctor.parameterCount == 1) {
						Class<?> paramType = ctor.parameterTypes[0]

						if (paramType.isAssignableFrom(driver.getClass())
							|| paramType.name.toLowerCase().contains('webdriver')
							|| paramType.name.toLowerCase().contains('windowsdriver')) {
							return ctor.newInstance(driver)
						}
					}
				} catch (Throwable ignored) {
				}
			}

			try {
				def ctor = sessionClass.getDeclaredConstructor()
				ctor.setAccessible(true)
				Object sessionObj = ctor.newInstance()

				setInstanceFieldIfExists(sessionObj, 'runningDriver', driver)
				setInstanceFieldIfExists(sessionObj, 'driver', driver)
				setInstanceFieldIfExists(sessionObj, 'webDriver', driver)

				return sessionObj
			} catch (Throwable ignored) {
			}
		} catch (Throwable ignored) {
		}

		return null
	}




