}
.col-detail {
    min-width: 0;
    white-space: normal;
    word-break: break-word;
    line-height: 1.45;
}
.step-icon {
    margin-right: 3px;
}
.error-block,
.evidence-block {
    margin-top: 20px;
    padding: 14px 16px;
    border-left: 3px solid #e05b4d;
    background: #fff8f7;
    border-radius: 10px;
    max-width: 1180px;
