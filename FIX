    @Keyword
    void startMatch(String currentUser, String targetWindowTitle) {
        expectedWindowTitle = normalizeExpectedTitle(targetWindowTitle)

        KeywordUtil.logInfo("Starting eMatch for environment ${readEnv()}")
        KeywordUtil.logInfo("Current Windows user ${safe(currentUser)}")
        KeywordUtil.logInfo("Expected window title ${expectedWindowTitle}")

        ensureWinAppDriverRunning()

        Map existingWindow = findMatchingEMatchWindow(expectedWindowTitle)
        if (isValidWindow(existingWindow)) {
            detectedWindowTitle = safe(existingWindow.title)
            detectedWindowHandle = safe(existingWindow.handle)
            KeywordUtil.logInfo("eMatch already open with title ${detectedWindowTitle}")
            return
        }

        String launcherBat = getLauncherBat()
        String shortcutPath = getShortcutPath()
        String installedExePath = getInstalledExePath()

        if (fileExists(launcherBat)) {
            KeywordUtil.logInfo("Launching launcher bat ${launcherBat}")
            runDetached("start \"\" \"${launcherBat}\"")
        } else if (fileExists(shortcutPath)) {
            KeywordUtil.logInfo("Launching shortcut ${shortcutPath}")
            runDetached("start \"\" \"${shortcutPath}\"")
        } else if (fileExists(installedExePath)) {
            KeywordUtil.logInfo("Launching installed exe ${installedExePath}")
            runDetached("start \"\" \"${installedExePath}\"")
        } else {
            KeywordUtil.markFailedAndStop("Could not launch eMatch. No launcher bat, shortcut or installed exe was found.")
        }

        Map foundWindow = waitForEMatchWindow(expectedWindowTitle, 90)
        if (!isValidWindow(foundWindow)) {
            KeywordUtil.markFailedAndStop("eMatch window was not detected after launch. Expected title ${expectedWindowTitle}")
        }

        detectedWindowTitle = safe(foundWindow.title)
        detectedWindowHandle = safe(foundWindow.handle)

        KeywordUtil.logInfo("Detected main window title ${detectedWindowTitle}")
        KeywordUtil.logInfo("Detected main window handle ${detectedWindowHandle}")
    }

    @Keyword
    void attachToLoginWindow(String targetWindowTitle) {
        String expected = normalizeExpectedTitle(targetWindowTitle)

        if (!safe(detectedWindowTitle)) {
            Map foundWindow = waitForEMatchWindow(expected, 45)
            if (isValidWindow(foundWindow)) {
                detectedWindowTitle = safe(foundWindow.title)
                detectedWindowHandle = safe(foundWindow.handle)
            }
        }

        if (!safe(detectedWindowTitle)) {
            KeywordUtil.markFailedAndStop("Could not find eMatch login window. Expected title ${expected}")
        }

        String installedExePath = getInstalledExePath()
        if (!fileExists(installedExePath)) {
            KeywordUtil.markFailedAndStop("Installed exe was not found. Path ${installedExePath}")
        }

        Throwable lastError = null

        for (int attempt = 1; attempt <= 5; attempt++) {
            try {
                KeywordUtil.logInfo("Attach attempt ${attempt} using title ${detectedWindowTitle}")

                activateWindow(detectedWindowTitle, detectedWindowHandle)
                sleep(1200)

                Windows.startApplicationWithTitle(installedExePath, detectedWindowTitle)
                sleep(1500)

                if (isLoginWindowReady()) {
                    KeywordUtil.logInfo("Login window attached successfully")
                    return
                }
            } catch (Throwable t) {
                lastError = t
                KeywordUtil.logInfo("Attach attempt ${attempt} failed: ${safe(t.message)}")
            }

            Map refreshed = waitForEMatchWindow(expected, 20)
            if (isValidWindow(refreshed)) {
                detectedWindowTitle = safe(refreshed.title)
                detectedWindowHandle = safe(refreshed.handle)
            }

            sleep(1500)
        }

        KeywordUtil.markFailedAndStop("Could not attach to login window ${detectedWindowTitle}. ${safe(lastError?.message)}")
    }

