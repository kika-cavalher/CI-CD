import com.kms.katalon.core.annotation.AfterTestCase
import com.kms.katalon.core.annotation.BeforeTestCase
import com.kms.katalon.core.context.TestCaseContext
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.configuration.RunConfiguration

import java.nio.charset.StandardCharsets
import java.text.SimpleDateFormat
import java.util.concurrent.ConcurrentHashMap
import java.util.regex.Pattern

class ematchReport {

    private static final Map<String, Long> CASE_START = new ConcurrentHashMap<>()

    private static final Pattern START_PATTERN = Pattern.compile('\\[START\\].*Test Cases/(.+)')
    private static final Pattern END_PATTERN   = Pattern.compile('\\[END\\].*Test Cases/(.+)')

    private static final SimpleDateFormat FORMAT = new SimpleDateFormat("HH:mm:ss.SSS")

    @BeforeTestCase
    def beforeCase(TestCaseContext ctx) {
        String caseId = safe(ctx.getTestCaseId())
        long now = System.currentTimeMillis()

        CASE_START.put(caseId, now)

        append("CASE_START", caseId, now, "")
    }

    @AfterTestCase
    def afterCase(TestCaseContext ctx) {
        String caseId = safe(ctx.getTestCaseId())
        String status = normalize(ctx.getTestCaseStatus())

        long end = System.currentTimeMillis()
        long start = CASE_START.containsKey(caseId) ? CASE_START.get(caseId) : end
        long duration = end - start

        List<Map> steps = extractSteps(caseId)

        steps.each { s ->
            append("STEP", caseId, s.time, s.detail)
        }

        append("CASE_END", caseId, end, "")
        append("STATUS", caseId, end, status)
        append("DURATION", caseId, end, String.valueOf(duration))

        if (status == "FAILED") {
            try {
                CustomKeywords.'jiraIntegration.JiraImagesEvidence.autoFailure'(caseId)
            } catch (Throwable ignored) {}
        }

        try {
            CustomKeywords.'jiraIntegration.JiraImagesEvidence.finishCase'()
        } catch (Throwable ignored) {}

        CASE_START.remove(caseId)
    }

    // =========================
    // STEP EXTRACTION
    // =========================

    private List<Map> extractSteps(String caseId) {

        List<Map> result = []
        File root = new File(RunConfiguration.getReportFolder())

        if (!root.exists()) return result

        List<File> logs = []

        root.eachFileRecurse { f ->
            if (f.isFile() && f.name.toLowerCase().contains("execution")) {
                logs << f
            }
        }

        logs.sort { a, b -> b.lastModified() <=> a.lastModified() }

        logs.take(3).each { file ->

            boolean inside = false

            file.eachLine(StandardCharsets.UTF_8.name()) { line ->

                String l = safe(line)
                if (l.isEmpty()) return

                // START
                def sm = START_PATTERN.matcher(l)
                if (sm.find()) {
                    inside = safe(sm.group(1)) == caseId
                    return
                }

                // END
                def em = END_PATTERN.matcher(l)
                if (em.find()) {
                    inside = false
                    return
                }

                if (!inside) return

                // 🔥 SOMENTE LOGINFO COM STEP
                if (l.contains("[REPORT_STEP]")) {
                    result << [
                        time: extractTime(l),
                        detail: l.substring(l.indexOf("[REPORT_STEP]") + 13).trim()
                    ]
                }
            }
        }

        result.sort { a, b -> a.time <=> b.time }

        return result
    }

    // =========================
    // TIME PARSER
    // =========================

    private long extractTime(String line) {
        try {
            // exemplo log: 2026-03-25 09:58:20.123
            String ts = line.substring(0, 23)
            return new SimpleDateFormat("yyyy-MM-dd HH:mm:ss.SSS").parse(ts).time
        } catch (Throwable e) {
            return System.currentTimeMillis()
        }
    }

    // =========================
    // HELPERS
    // =========================

    private void append(String type, String caseId, long time, String value) {
        KeywordUtil.logInfo(
            "[" + type + "] " +
            caseId + " | " +
            FORMAT.format(new Date(time)) + " | " +
            safe(value)
        )
    }

    private String normalize(String s) {
        String v = safe(s).toUpperCase()

        if (v.contains("PASS")) return "PASSED"
        if (v.contains("FAIL") || v.contains("ERROR")) return "FAILED"
        if (v.contains("SKIP")) return "SKIPPED"

        return "UNKNOWN"
    }

    private String safe(def v) {
        return v == null ? "" : String.valueOf(v).trim()
    }
}
