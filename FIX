@Keyword
boolean waitForMainScreen() {
	KeywordUtil.logInfo("Waiting for main eMatch screen")

	reattachMainWindowAfterLogin()

	long end = System.currentTimeMillis() + 70000L

	while (System.currentTimeMillis() < end) {
		if (waitPresent(mainSearchObj(), 3)) {
			return true
		}

		if (waitPresent(homeTabObj(), 3)) {
			return true
		}

		sleepMs(1000)
	}

	return false
}

