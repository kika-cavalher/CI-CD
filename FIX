		return imageLoader.getImage(
			IMAGE_GROUP,
			imageKey
		)
	}

	private void takeEvidence(
			String fileName
		) {

		imageLoader.takeEvidence(fileName)
	}

	private String normalizeSource(
			String sourceValue
		) {

		String value =
			safeText(sourceValue)
				.toLowerCase(Locale.ROOT)

		value =
			java.text.Normalizer.normalize(
				value,
				java.text.Normalizer.Form.NFD
			).replaceAll('\\p{M}', '')

		return value
	}

	private Integer safeTimeout(
			Integer timeoutSeconds
		) {

		return timeoutSeconds != null &&
			timeoutSeconds > 0
				? timeoutSeconds
				: DEFAULT_TIMEOUT
	}

	private String safeText(
			Object value
		) {

		return value == null
			? ''
			: value.toString().trim()
	}


	private static class HeaderLocation {

		final Integer rowIndex
		final Integer columnIndex

		HeaderLocation(
				Integer rowIndex,
				Integer columnIndex
			) {

			this.rowIndex = rowIndex
			this.columnIndex = columnIndex
		}
	}
