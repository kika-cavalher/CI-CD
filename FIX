		) {

		String expectedValue =
			safeText(
				expectedSourceValue
			).toUpperCase()

		Integer expectedRows =
			expectedSourceRows != null &&
			expectedSourceRows > 0
				? expectedSourceRows
				: 1

		if (expectedValue.isEmpty()) {
			KeywordUtil.markFailedAndStop(
				'Expected Source value cannot be empty.'
			)

			return [:]
		}

		File filteredFile =
			validateExcelFile(
				filteredFilePath,
				'Filtered investigations export'
			)

		Workbook workbook = null
		FileInputStream inputStream = null

		try {
			inputStream =
				new FileInputStream(
					filteredFile
				)

			workbook =
				WorkbookFactory.create(
					inputStream
				)

			if (workbook.numberOfSheets <= 0) {
				KeywordUtil.markFailedAndStop(
					'Filtered investigations export has no worksheet: ' +
						filteredFile.name
				)

				return [:]
			}

			Sheet sheet =
				workbook.getSheetAt(0)

			HeaderLocation sourceHeader =
				findHeader(
					sheet,
					'Source'
				)

			if (sourceHeader == null) {
				KeywordUtil.markFailedAndStop(
					'Column Source was not found in filtered export: ' +
						filteredFile.name
				)

				return [:]
			}

			DataFormatter formatter =
				new DataFormatter()

			List<String> sourceValues = []

			for (Integer rowIndex =
					sourceHeader.rowIndex + 1;
				rowIndex <= sheet.lastRowNum;
				rowIndex++) {

				Row row =
					sheet.getRow(
						rowIndex
					)

				if (row == null) {
					continue
				}

				String sourceValue =
					safeText(
						formatter.formatCellValue(
							row.getCell(
								sourceHeader.columnIndex
							)
						)
					).toUpperCase()

				if (sourceValue.isEmpty()) {
					continue
				}

				sourceValues.add(
					sourceValue
				)
			}

			List<String> unexpectedValues =
				sourceValues.findAll {
					String actualValue ->
						!actualValue.equals(
							expectedValue
						)
				}

			if (sourceValues.size() != expectedRows ||
				!unexpectedValues.isEmpty()) {

				KeywordUtil.markFailedAndStop(
					'Filtered export Source validation failed.\n' +
						'File: ' + filteredFile.name + '\n' +
						'Expected Source value: ' +
						expectedValue + '\n' +
						'Expected non-empty Source rows: ' +
						expectedRows + '\n' +
						'Actual Source values: ' +
						sourceValues + '\n' +
						'Actual non-empty Source rows: ' +
						sourceValues.size()
				)

				return [:]
			}

			return [
				fileName           : filteredFile.name,
				expectedSourceValue: expectedValue,
				sourceValues       : sourceValues,
				nonEmptySourceRows : sourceValues.size(),
				ignoredBlankRows   :
					Math.max(
						0,
						sheet.lastRowNum -
							sourceHeader.rowIndex -
							sourceValues.size()
					)
			]
		} finally {
			try {
				workbook?.close()
			} catch (Throwable ignored) {
			}

			try {
				inputStream?.close()
			} catch (Throwable ignored) {
			}
		}
	}


	// ---------------------------------------------------------
	// validateMontantCcyBetweenExports
	// ---------------------------------------------------------
	// Uses:
	// Excel columns: Total (ccy), Montant ccy
	// Helpers: validateExcelFile, readMainTotalCcy,
	// detailContainsMontantCcy

	@Keyword
	Map validateMontantCcyBetweenExports(
			String mainFilePath,
			String bilanDetailFilePath,
			String resultatDetailFilePath
		) {

		// Validate input files
		File mainFile = validateExcelFile(
			mainFilePath,
			'Main investigations export'
		)

		File bilanFile = validateExcelFile(
			bilanDetailFilePath,
			'Bilan detail export'
		)

		File resultatFile = validateExcelFile(
			resultatDetailFilePath,
			'Resultat detail export'
		)

		// Read Total (ccy) reference
		BigDecimal mainReference = readMainTotalCcy(mainFile)

		// Compare Bilan detail
		Boolean bilanMatch = detailContainsMontantCcy(
			bilanFile,
			mainReference
		)

		// Compare Resultat detail
		Boolean resultatMatch = detailContainsMontantCcy(
			resultatFile,
			mainReference
		)

		// Validate comparison result
		if (!bilanMatch || !resultatMatch) {
			String errors = ''

			if (!bilanMatch) {
				errors +=
					'\nBilan detail export does not contain Montant ccy matching the main Total (ccy).'
			}

			if (!resultatMatch) {
				errors +=
					'\nResultat detail export does not contain Montant ccy matching the main Total (ccy).'
			}

			KeywordUtil.markFailedAndStop(
				errors +
				'\nExpected absolute rounded value: ' +
				mainReference.abs().setScale(0, RoundingMode.HALF_UP)
			)
		}

		// Result
		return [
			mainFileName     : mainFile.name,
			bilanFileName    : bilanFile.name,
			resultatFileName : resultatFile.name,
			mainTotalCcy     : mainReference,
			bilanMatch       : bilanMatch,
			resultatMatch    : resultatMatch
		]
	}


