    // INTERNAL PARSING
    // ============================================================
    private List<Map> parseCaseModels(String reportFolder, String suiteName) {
        File executionLog = owner.findExecutionLog(reportFolder)
        if (executionLog == null || !executionLog.exists()) {
            return [[
                path        : suiteName,
                displayName : suiteName,
                className   : suiteName,
                testName    : suiteName,
                status      : 'PASSED',
                durationMs  : 0L,
                errorSummary: '',
                fullError   : '',
                steps       : []
            ]]
        }

        List<String> rawLines = readLines(executionLog)
        Map<String, Map> byPath = new LinkedHashMap<String, Map>()
        String currentPath = ''

        rawLines.each { String rawLine ->
            String line = cleanLogLine(rawLine)
            if (blank(line)) {
                return
            }

            Matcher statusMatcher = Pattern.compile('(Test Cases/.+?)\\s+(PASSED|FAILED|ERROR|SKIPPED)\\.?$', Pattern.CASE_INSENSITIVE).matcher(line)
            if (statusMatcher.find()) {
                currentPath = safe(statusMatcher.group(1))
                Map item = getOrCreateCase(byPath, currentPath, suiteName)
                String rawStatus = safe(statusMatcher.group(2)).toUpperCase(Locale.ENGLISH)
                item.status = rawStatus == 'ERROR' ? 'FAILED' : rawStatus
                return
            }

            Matcher durationMatcher = Pattern.compile('(Test Cases/.+?)\\s*\\(([\\d.,]+)s\\)', Pattern.CASE_INSENSITIVE).matcher(line)
            if (durationMatcher.find()) {
                currentPath = safe(durationMatcher.group(1))
                Map item = getOrCreateCase(byPath, currentPath, suiteName)
                item.durationMs = parseDurationTokenToMillis(safe(durationMatcher.group(2)))
                return
            }

            if (!blank(currentPath)) {
                Map current = getOrCreateCase(byPath, currentPath, suiteName)

                if (line.contains('TEST STEP:')) {
                    String stepText = safe(line.substring(line.indexOf('TEST STEP:') + 'TEST STEP:'.length()))
                    if (!blank(stepText)) {
                        current.steps << stepText
                    }
                    return
                }

                Matcher compactStepMatcher = Pattern.compile('^\\d+\\s*-\\s*(.+?)\\s*\\(([\\d.,]+)s\\)$').matcher(line)
                if (compactStepMatcher.find()) {
                    String stepText = safe(compactStepMatcher.group(1))
                    if (!blank(stepText)) {
                        current.steps << stepText
                    }
                    return
                }

                Matcher elapsedMatcher = Pattern.compile('Elapsed time:\\s*([\\d.,]+)s', Pattern.CASE_INSENSITIVE).matcher(line)
                if (elapsedMatcher.find()) {
                    long elapsedMs = parseDurationTokenToMillis(safe(elapsedMatcher.group(1)))
                    if (elapsedMs > 0L) {
                        current.durationMs = elapsedMs
                    }
                    return
                }

                if (looksLikeError(line)) {
                    current.errorLines << line
                    if (safe(current.status) != 'SKIPPED') {
                        current.status = 'FAILED'
                    }
                    return
                }
            }
        }

        List<Map> result = new ArrayList<Map>()
        byPath.values().each { Map item ->
            if (blank(item.status)) {
                item.status = item.errorLines.isEmpty() ? 'PASSED' : 'FAILED'
            }

            item.errorSummary = summarizeError(item.errorLines)
            item.fullError = item.errorLines.join('\n')
            result << item
        }

        if (result.isEmpty()) {
            result << [
                path        : suiteName,
                displayName : suiteName,
                className   : suiteName,
                testName    : suiteName,
                status      : 'PASSED',
                durationMs  : 0L,
                errorSummary: '',
                fullError   : '',
                steps       : []
            ]
        }

        return result
    }

    private Map getOrCreateCase(Map<String, Map> byPath, String path, String suiteName) {
        if (!byPath.containsKey(path)) {
            String displayName = path
            if (path.contains('/')) {
                displayName = path.substring(path.lastIndexOf('/') + 1)
            }

            String className = suiteName
            String testName = displayName

            byPath[path] = [
                path        : path,
                displayName : displayName,
                className   : className,
                testName    : testName,
                status      : '',
                durationMs  : 0L,
                errorSummary: '',
                fullError   : '',
                errorLines  : [],
                steps       : []
            ]
        }

        return byPath[path]
    }

    private List<String> readLines(File file) {
        try {
            return Files.readAllLines(file.toPath(), StandardCharsets.UTF_8)
        } catch (Exception ignored) {
            try {
                return file.readLines()
            } catch (Exception ignoredAgain) {
                return []
            }
        }
    }

    private String cleanLogLine(String rawLine) {
        String line = safe(rawLine)
        if (blank(line)) {
            return ''
        }

        line = line.replaceAll(/\u001B\[[;\d]*m/, '')
        line = line.replace('\t', ' ').trim()

        Matcher prefixed = Pattern.compile('^\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2}\\.\\d{3}\\s+[A-Z]+\\s+.+?\\s+-\\s+(.*)$').matcher(line)
        if (prefixed.find()) {
            line = safe(prefixed.group(1))
        }

        return line
    }

    private boolean looksLikeError(String line) {
        String lower = safe(line).toLowerCase(Locale.ENGLISH)
        return lower.startsWith('reason:') ||
               lower.startsWith('caused by:') ||
               lower.contains('stepfailederror') ||
               lower.contains('stepfailedexception') ||
               lower.contains('missingmethodexception') ||
               lower.contains('exception:') ||
               lower.contains('unable to ') ||
               lower.contains('object repository') ||
               lower.contains('timed out')
    }

    private String summarizeError(List<String> errorLines) {
        if (errorLines == null || errorLines.isEmpty()) {
            return ''
        }

        String first = safe(errorLines.find { String item -> !blank(item) })
        if (first.length() > 220) {
            return first.substring(0, 217) + '...'
        }
        return first
    }

    private long parseDurationTokenToMillis(String raw) {
        String value = safe(raw).replace(',', '.')
        if (blank(value)) {
            return 0L
        }

        try {
            return Math.round(Double.parseDouble(value) * 1000d)
        } catch (Exception ignored) {
            return 0L
        }
    }

    private String formatSeconds(long durationMs) {
        double seconds = ((double) durationMs) / 1000d
        return String.format(Locale.ENGLISH, '%.3f', seconds)
    }

    private String formatDuration(long durationMs) {
        if (durationMs < 0L) {
            durationMs = 0L
        }

        long totalSeconds = Math.round(durationMs / 1000d)
        long hours = (long) (totalSeconds / 3600L)
        long minutes = (long) ((totalSeconds % 3600L) / 60L)
        long seconds = (long) (totalSeconds % 60L)

        return String.format(Locale.ENGLISH, '%02dh %02dm %02ds', hours, minutes, seconds)
    }

    private String xmlEscape(String value) {
        return safe(value)
            .replace('&', '&amp;')
            .replace('<', '&lt;')
            .replace('>', '&gt;')
            .replace('"', '&quot;')
            .replace("'", '&apos;')
    }

