			imageLoader.takeEvidence(
					'OpenFileModalKeyboardError.png'
					)

			KeywordUtil.markFailedAndStop(
					'Could not close open-file modal using TAB and ENTER.\n' +
						'Detected image: ' +
						detectedModalImage + '\n' +
						'Message: ' +
						safeExceptionMessage(
						exception
						)
					)

			return
		}

		Windows.delay(
				SHORT_UI_DELAY_SECONDS
				)

		boolean recModalStillVisible =
				imageLoader.isVisible(
				GENERAL_IMAGE_GROUP,
					'iconeModal'
				)

		boolean prdModalStillVisible =
				imageLoader.isVisible(
				GENERAL_IMAGE_GROUP,
					'iconeModalPRD'
				)

		if (recModalStillVisible ||
				prdModalStillVisible) {

			imageLoader.takeEvidence(
					'OpenFileModalStillVisible.png'
					)

			KeywordUtil.markFailedAndStop(
					'Open-file modal is still visible after TAB and ENTER.\n' +
						'REC modal visible: ' +
						recModalStillVisible + '\n' +
						'PRD modal visible: ' +
						prdModalStillVisible
					)

			return
		}

		logInfo(
				'Open-file modal closed successfully.\n' +
					'Detected image: ' +
					detectedModalImage + '\n' +
					'Elapsed milliseconds: ' +
					elapsedMilliseconds(
					modalStartedAt
					)
				)
	}


	// ======================================================
	// WINDOWS OBJECT HELPERS
	// ======================================================

	private void clickRequiredWindowsObject(
			String objectKey,
			String description,
			Integer timeoutSeconds) {

		int safeTimeout =
				timeoutSeconds == null ||
				timeoutSeconds <= 0
					? SAVE_DIALOG_TIMEOUT_SECONDS
					: timeoutSeconds

		long actionStartedAt =
				System.currentTimeMillis()

		logInfo(
				'Searching for Windows element.\n' +
					'Description: ' +
					description + '\n' +
					'Object group: ' +
					EXPORT_OBJECT_GROUP + '\n' +
					'Object key: ' +
					objectKey + '\n' +
					'Timeout: ' +
					safeTimeout +
					' seconds.'
				)

		WindowsTestObject object =
				getRequiredWindowsObject(
				objectKey
				)

		boolean found = false

		try {
			found = Windows.verifyElementPresent(
					object,
						safeTimeout,
						FailureHandling.OPTIONAL
					)
		} catch (Exception exception) {

			imageLoader.takeEvidence(
					sanitizeFileName(
					objectKey
					) +
						'VerificationError.png'
					)

			KeywordUtil.markFailedAndStop(
					'Windows element verification failed.\n' +
						'Description: ' +
						description + '\n' +
						'Object group: ' +
						EXPORT_OBJECT_GROUP + '\n' +
						'Object key: ' +
						objectKey + '\n' +
						'Timeout: ' +
						safeTimeout +
						' seconds.\n' +
						'Message: ' +
						safeExceptionMessage(
						exception
						)
					)

			return
		}

		if (!found) {

			imageLoader.takeEvidence(
					sanitizeFileName(
					objectKey
					) +
						'NotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					'Required Windows element was not found.\n' +
						'Description: ' +
						description + '\n' +
						'Object group: ' +
						EXPORT_OBJECT_GROUP + '\n' +
						'Object key: ' +
						objectKey + '\n' +
						'Timeout: ' +
						safeTimeout +
						' seconds.'
					)

			return
		}

		try {
			Windows.click(
					object,
						FailureHandling.STOP_ON_FAILURE
					)
		} catch (Exception exception) {

			imageLoader.takeEvidence(
					sanitizeFileName(
					objectKey
					) +
						'ClickError.png'
					)

			KeywordUtil.markFailedAndStop(
					'Required Windows element was found but could not be clicked.\n' +
						'Description: ' +
						description + '\n' +
						'Object group: ' +
						EXPORT_OBJECT_GROUP + '\n' +
						'Object key: ' +
						objectKey + '\n' +
						'Message: ' +
						safeExceptionMessage(
						exception
						)
					)

			return
		}

		logInfo(
				'Windows element clicked successfully.\n' +
					'Description: ' +
					description + '\n' +
					'Object key: ' +
					objectKey + '\n' +
					'Elapsed milliseconds: ' +
					elapsedMilliseconds(
					actionStartedAt
					)
				)
	}


