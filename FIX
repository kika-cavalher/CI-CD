    // =========================================================================
    // NORMALIZATION
    // =========================================================================

    private Map normalizeModel(Map model) {
        Map safeModel = model ?: [:]

        String suiteName = pickFirst(
            safeModel.suiteName,
            safeModel.testSuiteName,
            safeModel.suite,
            safeModel.executionName,
            safeModel.title,
            'Execution'
        )

        List<Map> scenarios = []
        asList(safeModel.scenarios).eachWithIndex { rawItem, index ->
            Map item = rawItem instanceof Map ? (rawItem as Map) : [name: safeValue(rawItem)]

            scenarios << [
                id            : pickFirst(item.id, "scenario-${index + 1}"),
                name          : pickFirst(item.name, item.scenarioName, item.title, "Scenario ${index + 1}"),
                summary       : pickFirst(item.summary, item.visualError, item.errorSummary, ''),
                status        : normalizeStatus(pickFirst(item.status, 'info')),
                startShort    : pickFirst(item.startShort, ''),
                endShort      : pickFirst(item.endShort, ''),
                startLong     : pickFirst(item.startLong, ''),
                endLong       : pickFirst(item.endLong, ''),
                durationLabel : pickFirst(item.durationLabel, '00h 00m 00s'),
                visualError   : pickFirst(item.visualError, item.summary, ''),
                fullError     : pickFirst(item.fullError, ''),
                steps         : normalizeSteps(item.steps),
                evidence      : normalizeEvidence(item.evidence, safeModel)
            ]
        }

        int passedCount = scenarios.count { Map it -> it.status == 'passed' }
        int failedCount = scenarios.count { Map it -> it.status == 'failed' }
        int skippedCount = scenarios.count { Map it -> it.status == 'skipped' }
        int totalCount = scenarios.size()

        return [
            reportTitle   : REPORT_TITLE_PREFIX + suiteName,
            suiteName     : suiteName,
            generatedLabel: buildGeneratedLabel(safeModel),
            reportFolder  : pickFirst(safeModel.reportFolder, safeModel.baseFolder, safeModel.executionFolder),
            logoSrc       : pickFirst(safeModel.logoSrc, LOGO_SRC),
            scenarios     : scenarios,
            passedCount   : passedCount,
            failedCount   : failedCount,
            skippedCount  : skippedCount,
            totalCount    : totalCount
        ]
    }

    private List<Map> normalizeSteps(def rawSteps) {
        List<Map> result = []

        asList(rawSteps).each { raw ->
            Map row = raw instanceof Map ? (raw as Map) : [detail: safeValue(raw)]

            String detail = pickFirst(row.detail, row.message, row.text, row.title, row.name)
            if (detail.isEmpty()) {
                return
            }

            String status = normalizeStatus(pickFirst(row.status, row.result, row.outcome, 'info'))
            String timestamp = pickFirst(row.timestamp, row.time, row.label, '')

            result << [
                status   : status,
                timestamp: timestamp,
                detail   : detail,
                icon     : pickFirst(row.icon, resolveStepIcon(detail, status))
            ]
        }

        return result
    }

    private List<Map> normalizeEvidence(def rawEvidence, Map model) {
        List<Map> result = []

        asList(rawEvidence).each { raw ->
            if (raw instanceof Map) {
                Map item = raw as Map
                result << [
                    name  : pickFirst(item.name, item.fileName, 'Evidence'),
                    href  : pickFirst(item.href, item.url, item.path, ''),
                    image : Boolean.valueOf(String.valueOf(item.image)),
                    imgSrc: pickFirst(item.imgSrc, item.imageSrc, item.href, item.url, '')
                ]
            } else if (!safeValue(raw).isEmpty()) {
                String href = safeValue(raw)
                result << [
                    name  : new File(href).name,
                    href  : href,
                    image : isImageFile(href),
                    imgSrc: isImageFile(href) ? href : ''
                ]
            }
        }

        return result
    }

