	private Map validateHeadersInFile(
			File file,
			Integer sheetIndex,
			List<String> headers) {

		List<String> foundHeaders = []
		List<String> missingHeaders = []
		List<String> errors = []
		Workbook workbook = null

		try {
			if (file == null || !file.exists() || !file.isFile()) {
				return [
					failed        : true,
					headerRow     : '',
					foundHeaders  : foundHeaders,
					missingHeaders: headers,
					errors        : ['File was not found.']
				]
			}

			workbook = WorkbookFactory.create(file)

			if (sheetIndex < 0 || sheetIndex >= workbook.getNumberOfSheets()) {
				return [
					failed        : true,
					headerRow     : '',
					foundHeaders  : foundHeaders,
					missingHeaders: headers,
					errors        : [
						'Sheet index ' + sheetIndex +
						' was not found. Available sheets: ' +
						workbook.getNumberOfSheets()
					]
				]
			}

			Sheet sheet = workbook.getSheetAt(sheetIndex)
			DataFormatter formatter = new DataFormatter(Locale.ENGLISH)
			def evaluator = workbook.getCreationHelper().createFormulaEvaluator()
			Map headerInfo = findBestHeaderRow(
					sheet,
					formatter,
					evaluator,
					headers
					)

			foundHeaders.addAll(headerInfo.foundHeaders as List<String>)
			missingHeaders.addAll(headerInfo.missingHeaders as List<String>)

			return [
				failed        : !missingHeaders.isEmpty(),
				headerRow     : headerInfo.headerRow,
				foundHeaders  : foundHeaders,
				missingHeaders: missingHeaders,
				errors        : errors
			]
		} catch (Throwable throwable) {
			errors.add(
					throwable.getClass().getSimpleName() + ': ' +
					safeText(throwable.getMessage())
					)

			return [
				failed        : true,
				headerRow     : '',
				foundHeaders  : foundHeaders,
				missingHeaders: headers,
				errors        : errors
			]
		} finally {
			try {
				workbook?.close()
			} catch (Throwable ignored) {
			}
		}
	}

	private Map findBestHeaderRow(
			Sheet sheet,
			DataFormatter formatter,
			def evaluator,
			List<String> headers) {

		Integer maxHeaderScanRows = Math.min(sheet.getLastRowNum(), 50)
		List<String> bestFound = []
		List<String> bestMissing = headers == null
				? []
				: new ArrayList<String>(headers)
		Integer bestHeaderRow = -1

		for (int rowIndex = 0; rowIndex <= maxHeaderScanRows; rowIndex++) {
			Row row = sheet.getRow(rowIndex)

			if (row == null ||
					row.getFirstCellNum() < 0 ||
					row.getLastCellNum() < 0) {

				continue
			}

			Set<String> rowValues = [] as Set<String>

			for (int cellIndex = row.getFirstCellNum();
					cellIndex < row.getLastCellNum();
					cellIndex++) {

				Cell cell = row.getCell(
						cellIndex,
						Row.MissingCellPolicy.RETURN_BLANK_AS_NULL
						)

				String value = cellText(cell, formatter, evaluator)

				if (!value.isEmpty()) {
					rowValues.add(normalizeDynamicHeader(value))
				}
			}

			List<String> currentFound = []
			List<String> currentMissing = []

			for (String header : headers) {
				if (rowValues.contains(normalizeDynamicHeader(header))) {
					currentFound.add(header)
				} else {
					currentMissing.add(header)
				}
			}

			if (currentFound.size() > bestFound.size()) {
				bestFound = currentFound
				bestMissing = currentMissing
				bestHeaderRow = rowIndex + 1
			}

			if (currentMissing.isEmpty()) {
				break
			}
		}

		return [
			headerRow     : bestHeaderRow < 0 ? '' : String.valueOf(bestHeaderRow),
			foundHeaders  : bestFound,
			missingHeaders: bestMissing
		]
	}

	private String cellText(
			Cell cell,
			DataFormatter formatter,
			def evaluator) {

		if (cell == null) {
			return ''
		}

		try {
			return formatter.formatCellValue(cell, evaluator).trim()
		} catch (Throwable ignored) {
			try {
				return formatter.formatCellValue(cell).trim()
			} catch (Throwable ignoredAgain) {
				return ''
			}
		}
	}

	private String normalizeDynamicHeader(String value) {
		return safeText(value)
				.toLowerCase(Locale.ENGLISH)
				.replaceAll('[^a-z0-9]+', '')
	}

