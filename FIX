import com.kms.katalon.core.annotation.*
import com.kms.katalon.core.context.*
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil

import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale

class ematchReport {

	private static final SimpleDateFormat TIME_FORMAT =
		new SimpleDateFormat('yyyy-MM-dd HH:mm:ss.SSS', Locale.ENGLISH)

	private static long suiteStartTime = 0

	@BeforeTestSuite
	def beforeSuite(TestSuiteContext testSuiteContext) {

		suiteStartTime = System.currentTimeMillis()

		KeywordUtil.logInfo('============================================================')
		KeywordUtil.logInfo('🚀 STARTING TEST SUITE: ' + safe(testSuiteContext?.getTestSuiteId()))
		KeywordUtil.logInfo('🕒 START TIME: ' + now())
		KeywordUtil.logInfo('============================================================')
	}

	@BeforeTestCase
	def beforeCase(TestCaseContext testCaseContext) {

		String caseName = safe(testCaseContext?.getTestCaseId())

		KeywordUtil.logInfo('------------------------------------------------------------')
		KeywordUtil.logInfo('🎬 START TEST CASE: ' + caseName)
		KeywordUtil.logInfo('🕒 START TIME: ' + now())
		KeywordUtil.logInfo('------------------------------------------------------------')

		try {
			CustomKeywords.'jiraIntegration.ImagesEvidence.startCase'(caseName)
		} catch (Exception e) {
			KeywordUtil.logInfo('⚠ startCase not available: ' + e.message)
		}
	}

	@AfterTestCase
	def afterCase(TestCaseContext testCaseContext) {

		String caseName = safe(testCaseContext?.getTestCaseId())
		String status = safe(testCaseContext?.getTestCaseStatus())

		KeywordUtil.logInfo('------------------------------------------------------------')
		KeywordUtil.logInfo('🏁 END TEST CASE: ' + caseName)
		KeywordUtil.logInfo('📊 STATUS: ' + status)

		if (status in ['FAILED', 'ERROR']) {
			KeywordUtil.logInfo('❌ TEST FAILED - capturing automatic evidence')

			try {
				CustomKeywords.'jiraIntegration.ImagesEvidence.captureNow'('auto-failure')
			} catch (Exception e) {
				KeywordUtil.logInfo('⚠ captureNow failed: ' + e.message)
			}
		}

		KeywordUtil.logInfo('🕒 END TIME: ' + now())
		KeywordUtil.logInfo('------------------------------------------------------------')
	}

	@AfterTestSuite
	def afterSuite(TestSuiteContext testSuiteContext) {

		long end = System.currentTimeMillis()
		long duration = end - suiteStartTime

		KeywordUtil.logInfo('============================================================')
		KeywordUtil.logInfo('🏁 FINISHED TEST SUITE: ' + safe(testSuiteContext?.getTestSuiteId()))
		KeywordUtil.logInfo('⏱ TOTAL DURATION: ' + formatDuration(duration))
		KeywordUtil.logInfo('🕒 END TIME: ' + now())
		KeywordUtil.logInfo('============================================================')
	}

	// ================= HELPERS =================

	private String now() {
		return TIME_FORMAT.format(new Date())
	}

	private String safe(Object value) {
		return value == null ? '' : String.valueOf(value)
	}

	private String formatDuration(long ms) {

		long seconds = (long)(ms / 1000)
		long minutes = (long)(seconds / 60)
		long remainingSeconds = seconds % 60

		return minutes + 'm ' + remainingSeconds + 's'
	}
}
