package jiraIntegration

import java.io.File
import java.io.FileInputStream
import java.io.FileOutputStream
import java.io.RandomAccessFile
import java.util.zip.ZipEntry
import java.util.zip.ZipOutputStream

import com.kms.katalon.core.util.KeywordUtil

class JiraExecutionPublisher {

	JiraFlowCoordinator owner
	JiraGateway gateway

	JiraExecutionPublisher(JiraFlowCoordinator owner, JiraGateway gateway) {
		this.owner = owner
		this.gateway = gateway
	}

	String getHtmlReportFilePath() {
		return owner.getResolvedReportFolder() + File.separator + owner.HTML_REPORT_FILE_NAME
	}

	boolean isLockedOrUnreadable(File file) {
		if (file == null || !file.exists() || !file.isFile()) {
			return true
		}

		RandomAccessFile raf = null
		try {
			raf = new RandomAccessFile(file, 'r')
			return false
		} catch (Exception ignored) {
			return true
		} finally {
			try {
				raf?.close()
			} catch (Exception ignored) {}
		}
	}

	boolean shouldSkipReportEntry(File file) {
		String name = owner.safe(file?.name).toLowerCase()

		if (owner.isBlank(name)) return true
		if (name == owner.safe(owner.RESULT_ZIP_NAME).toLowerCase()) return true
		if (name == owner.safe(owner.EVIDENCE_ZIP_NAME).toLowerCase()) return true
		if (name == owner.safe(owner.HTML_REPORT_FILE_NAME).toLowerCase()) return true
		if (name == owner.safe(owner.EVIDENCE_FOLDER_NAME).toLowerCase()) return true
		if (name == 'videos') return true
		if (name == 'requests') return true
		if (name.endsWith('.lck')) return true
		if (name.endsWith('.lock')) return true

		return false
	}

	boolean shouldSkipEvidenceEntry(File file) {
		String name = owner.safe(file?.name).toLowerCase()

		if (owner.isBlank(name)) return true
		if (name == owner.safe(owner.EVIDENCE_ZIP_NAME).toLowerCase()) return true
		if (name.endsWith('.lck')) return true
		if (name.endsWith('.lock')) return true

		return false
	}

	void addFileToZip(ZipOutputStream output, File rootFolder, File currentFile) {
		if (currentFile == null || !currentFile.exists()) {
			return
		}

		if (currentFile.isDirectory()) {
			File[] children = currentFile.listFiles()
			if (children != null) {
				children.each { child ->
					addFileToZip(output, rootFolder, child)
				}
			}
			return
		}

		if (isLockedOrUnreadable(currentFile)) {
			KeywordUtil.logInfo("Skipping locked file from ZIP: ${currentFile.absolutePath}")
			return
		}

		String relativePath = rootFolder.toURI().relativize(currentFile.toURI()).getPath()
		if (owner.isBlank(relativePath)) {
			return
		}

		FileInputStream input = null
		try {
			output.putNextEntry(new ZipEntry(relativePath))
			input = new FileInputStream(currentFile)

			byte[] buffer = new byte[8192]
			int readBytes = 0

			while ((readBytes = input.read(buffer)) != -1) {
				output.write(buffer, 0, readBytes)
			}

			output.closeEntry()
			KeywordUtil.logInfo("Adding file to ZIP: ${relativePath}")
		} catch (Exception e) {
			try {
				output.closeEntry()
			} catch (Exception ignored) {}
			KeywordUtil.logInfo("Skipping file from ZIP due to error: ${currentFile.absolutePath} | ${e.message}")
		} finally {
			try {
				input?.close()
			} catch (Exception ignored) {}
		}
	}

	String zipReports() {
		String reportFolder = owner.getResolvedReportFolder()
		File sourceFolder = new File(reportFolder)

		if (!sourceFolder.exists() || !sourceFolder.isDirectory()) {
			KeywordUtil.logInfo("Report ZIP skipped. Folder not found: ${reportFolder}")
			return ''
		}

		String zipPath = reportFolder + File.separator + owner.RESULT_ZIP_NAME
		File zipFile = new File(zipPath)
		if (zipFile.exists()) {
			zipFile.delete()
		}

		ZipOutputStream output = null
		try {
			output = new ZipOutputStream(new FileOutputStream(zipFile))

			File[] children = sourceFolder.listFiles()
			if (children != null) {
				children.each { file ->
					if (!shouldSkipReportEntry(file)) {
						addFileToZip(output, sourceFolder, file)
					}
				}
			}

			KeywordUtil.logInfo("Report ZIP created successfully: ${zipPath}")
			return zipPath
		} finally {
			try {
				output?.close()
			} catch (Exception ignored) {}
		}
	}

	String zipEvidences() {
		String evidenceFolderPath = owner.getResolvedReportFolder() + File.separator + owner.EVIDENCE_FOLDER_NAME
		File sourceFolder = new File(evidenceFolderPath)

		if (!sourceFolder.exists() || !sourceFolder.isDirectory()) {
			KeywordUtil.logInfo("Evidence ZIP skipped. Folder not found: ${evidenceFolderPath}")
			return ''
		}

		File[] evidenceChildren = sourceFolder.listFiles()
		if (evidenceChildren == null || evidenceChildren.length == 0) {
			KeywordUtil.logInfo("Evidence ZIP skipped. Evidence folder is empty.")
			return ''
		}

		String zipPath = evidenceFolderPath + File.separator + owner.EVIDENCE_ZIP_NAME
		File zipFile = new File(zipPath)
		if (zipFile.exists()) {
			zipFile.delete()
		}

		ZipOutputStream output = null
		try {
			output = new ZipOutputStream(new FileOutputStream(zipFile))

			evidenceChildren.each { file ->
				if (!shouldSkipEvidenceEntry(file)) {
					addFileToZip(output, sourceFolder, file)
				}
			}

			KeywordUtil.logInfo("Evidence ZIP created successfully: ${zipPath}")
			return zipPath
		} finally {
			try {
				output?.close()
			} catch (Exception ignored) {}
		}
	}

	Map uploadExecutionAttachments(String executionKey) {
		Map result = [
			htmlReportStatus: 0,
			evidencesStatus : 0,
			resultsStatus   : 0
		]

		String htmlReportPath = getHtmlReportFilePath()
		String evidencesZipPath = zipEvidences()
		String resultsZipPath = zipReports()

		if (!owner.isBlank(htmlReportPath) && new File(htmlReportPath).exists()) {
			KeywordUtil.logInfo("Uploading HTML report attachment: ${htmlReportPath}")
			result.htmlReportStatus = gateway.uploadAttachment(executionKey, htmlReportPath)
		} else {
			KeywordUtil.logInfo("HTML report attachment skipped. File not found.")
		}

		if (!owner.isBlank(evidencesZipPath) && new File(evidencesZipPath).exists()) {
			KeywordUtil.logInfo("Uploading Evidences ZIP attachment: ${evidencesZipPath}")
			result.evidencesStatus = gateway.uploadAttachment(executionKey, evidencesZipPath)
		} else {
			KeywordUtil.logInfo("Evidences ZIP attachment skipped.")
		}

		if (!owner.isBlank(resultsZipPath) && new File(resultsZipPath).exists()) {
			KeywordUtil.logInfo("Uploading Results ZIP attachment: ${resultsZipPath}")
			result.resultsStatus = gateway.uploadAttachment(executionKey, resultsZipPath)
		} else {
			KeywordUtil.logInfo("Results ZIP attachment skipped.")
		}

		return result
	}

	Map publishExecution(String xmlPath, String executionSummary, String testPlanKey) {
		Map result = [
			executionKey         : '',
			addExecutionStatus   : 0,
			updateExecutionStatus: 0,
			htmlReportStatus     : 0,
			evidencesStatus      : 0,
			resultsStatus        : 0
		]

		String executionKey = gateway.importExecutionResults(xmlPath)
		result.executionKey = executionKey

		if (owner.isBlank(executionKey) || executionKey.startsWith('ERROR')) {
			return result
		}

		result.addExecutionStatus = gateway.addExecutionToTestPlan(testPlanKey, executionKey)
		result.updateExecutionStatus = gateway.updateTestExecution(
				executionKey,
				executionSummary,
				owner.LABELS,
				owner.ENVIRONMENT
				)

		Map attachmentResult = uploadExecutionAttachments(executionKey)
		result.putAll(attachmentResult)

		return result
	}
}
