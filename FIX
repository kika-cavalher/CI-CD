CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Start validation of downloaded Cube Balance des Responsabilites files')

def files = ((GlobalVariable.compareFiles) as ArrayList)

String arreteDate = GlobalVariable.arreteDate
SimpleDateFormat dateFormat = new SimpleDateFormat("dd-MM-yyyy")
Calendar calendar = Calendar.getInstance()
int year, month, trimester
Double trimesterCalcul = 0

try {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Parsing closing date and calculating expected trimester')
	Date date = dateFormat.parse(arreteDate)
	calendar.setTime(date)
	month = calendar.get(Calendar.MONTH) + 1
	year = calendar.get(Calendar.YEAR)
	
	trimesterCalcul = month / 3
	if (trimesterCalcul <= 1) {
		trimester = 1
	} else if (trimesterCalcul <= 2) {
		trimester = 2
	} else if (trimesterCalcul <= 3) {
		trimester = 3
	} else {
		trimester = 4
	}

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Closing date parsed successfully. Year: ${year}, Month: ${month}, Trimester: ${trimester}")
} catch (Exception e) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Closing date was not parsed correctly')
	KeywordUtil.markFailed("Closing date not parsed correctly")
}

String errors = ''
String evPath = RunConfiguration.getReportFolder() + '\\Evidences\\'

String file1Rec
String file2Prod

try {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Resolving REC and PROD downloaded files from evidence folder')
	file1Rec = (evPath + files.get(0))
	file2Prod = (evPath + files.get(1))
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Files resolved successfully: REC=${file1Rec}, PROD=${file2Prod}")
}
catch (Exception e) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Files required for validation were not found')
	KeywordUtil.markFailedAndStop('Files for the test not found')
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Opening REC workbook and reading first rows')
wbEnv1 = WorkbookFactory.create(new FileInputStream(file1Rec));
Sheet sheetEnv1 = wbEnv1.getSheetAt(0);
Row row1 = sheetEnv1.getRow(0)
Row rowNd = sheetEnv1.getRow(1)
wbEnv1.close()

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Opening PROD workbook and reading first rows')
wbEnv2 = WorkbookFactory.create(new FileInputStream(file2Prod));
Sheet sheetEnv2 = wbEnv2.getSheetAt(0);
Row row2 = sheetEnv2.getRow(0)
Row rowNd2 = sheetEnv2.getRow(1)
wbEnv2.close()

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Comparing table dimensions between REC and PROD files')
row1.getPhysicalNumberOfCells() != row2.getPhysicalNumberOfCells() ? errors += "\n[ERROR] Files have diffent number of Table headers " : errors
row1.getLastCellNum() != row2.getLastCellNum() ? errors += "\n[ERROR] Files have diffent number of rows " : errors

rowNd.getPhysicalNumberOfCells() != rowNd2.getPhysicalNumberOfCells() ? errors += "\n[ERROR] Files have diffent number of Table headers " : errors
rowNd.getLastCellNum() != rowNd2.getLastCellNum() ? errors += "\n[ERROR] Files have diffent number of rows " : errors

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Comparing header values in first and second rows')
Boolean headersFlag = true
for (Cell cell in row1) {
	if (!cell.toString().equals(row2.getCell(cell.getAddress()._col).toString())) {
		headersFlag = false
	}
}
!headersFlag ? errors += "\n[ERROR] Files table Headers not match " : errors

headersFlag = true
for (Cell cell in rowNd) {
	String cellFile1 = cell.toString()
	String cellFile2 = rowNd2.getCell(cell.getAddress()._col).toString()
	
	if (!cellFile1.equals(cellFile2)) {
		headersFlag = false
	}
}
!headersFlag ? errors += "\n[ERROR] Files table Headers not match in the second row " : errors

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Removing first three rows before data comparison')
sheetEnv1.removeRow(sheetEnv1.getRow(0))
sheetEnv1.removeRow(sheetEnv1.getRow(1))
sheetEnv1.removeRow(sheetEnv1.getRow(2))

sheetEnv2.removeRow(sheetEnv2.getRow(0))
sheetEnv2.removeRow(sheetEnv2.getRow(1))
sheetEnv2.removeRow(sheetEnv2.getRow(2))

int threshold = 3
int actualtrimesterValidated = 1
Boolean inQuarter = false

CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Starting row by row comparison with threshold: ${threshold}")
for (Row rowTest in sheetEnv1) {
	println(rowTest.getCell(1).cellTypeEnum == CellType.NUMERIC ? "numeric" : rowTest.getCell(1).getStringCellValue())
	println(sheetEnv2.getRow(rowTest.rowNum).getCell(1).cellTypeEnum == CellType.NUMERIC ? "numeric" : sheetEnv2.getRow(rowTest.rowNum).getCell(1).getStringCellValue())
	if (rowTest.getCell(1).cellTypeEnum == CellType.NUMERIC) {
		if (rowTest.getCell(1).getNumericCellValue() < year) {
			println(rowTest.getCell(1).getNumericCellValue())
			println(sheetEnv2.getRow(rowTest.rowNum).getCell(1).getNumericCellValue())
			rowTest.getCell(1).getNumericCellValue() != sheetEnv2.getRow(rowTest.rowNum).getCell(1).getNumericCellValue() ? errors += "\n[ERROR] Year column has a difference between rec and prod" : errors
			Math.abs(rowTest.getCell(2).getNumericCellValue() - sheetEnv2.getRow(rowTest.rowNum).getCell(2).getNumericCellValue()) >= threshold ? errors += "\n[ERROR] Nombre column has a difference greater than ${threshold} between rec and prod at row ${rowTest.rowNum + 1}" : errors
			Math.abs(rowTest.getCell(3).getNumericCellValue() - sheetEnv2.getRow(rowTest.rowNum).getCell(3).getNumericCellValue()) >= threshold ? errors += "\n[ERROR] Solde Transac CCY column has a difference greater than ${threshold} between rec and prod at row ${rowTest.rowNum + 1}" : errors
			Math.abs(rowTest.getCell(4).getNumericCellValue() - sheetEnv2.getRow(rowTest.rowNum).getCell(4).getNumericCellValue()) >= threshold ? errors += "\n[ERROR] Solde Base CCY column has a difference greater than ${threshold} between rec and prod at row ${rowTest.rowNum + 1}" : errors
			Math.abs(rowTest.getCell(5).getNumericCellValue() - sheetEnv2.getRow(rowTest.rowNum).getCell(5).getNumericCellValue()) >= threshold ? errors += "\n[ERROR] Solde Solde Fixing Base CCY -historique column has a difference greater than ${threshold} between rec and prod at row ${rowTest.rowNum + 1}" : errors
		}
	} else {
		if (actualtrimesterValidated < trimester && inQuarter) {
			Math.abs(rowTest.getCell(5).getNumericCellValue() - sheetEnv2.getRow(rowTest.rowNum).getCell(5).getNumericCellValue()) >= threshold ? errors += "\n[ERROR] Nombre column has a difference greater than ${threshold} between rec and prod at row ${rowTest.rowNum + 1}" : errors
			Math.abs(rowTest.getCell(6).getNumericCellValue() - sheetEnv2.getRow(rowTest.rowNum).getCell(6).getNumericCellValue()) >= threshold ? errors += "\n[ERROR] Solde Transac CCY column has a difference greater than ${threshold} between rec and prod at row ${rowTest.rowNum + 1}" : errors
			Math.abs(rowTest.getCell(7).getNumericCellValue() - sheetEnv2.getRow(rowTest.rowNum).getCell(7).getNumericCellValue()) >= threshold ? errors += "\n[ERROR] Solde Base CCY column has a difference greater than ${threshold} between rec and prod at row ${rowTest.rowNum + 1}" : errors
			Math.abs(rowTest.getCell(8).getNumericCellValue() - sheetEnv2.getRow(rowTest.rowNum).getCell(8).getNumericCellValue()) >= threshold ? errors += "\n[ERROR] Solde Solde Fixing Base CCY -historique column has a difference greater than ${threshold} between rec and prod at row ${rowTest.rowNum + 1}" : errors
			actualtrimesterValidated++
		} else {
			inQuarter = false
		}
		if ((rowTest.getCell(1).getStringCellValue().toString().equals("Total " + year.toInteger()) && sheetEnv2.getRow(rowTest.rowNum).getCell(1).getStringCellValue().toString().equals("Total " + year.toInteger()))) {
			inQuarter = true
		}
	}
}

if (errors != '') {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('File comparison finished with mismatches between REC and PROD')
	KeywordUtil.markFailed('\n' + errors)
} else {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('File comparison finished successfully with no mismatches')
}
