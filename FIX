	private void clickExportButtonByObject(String objectKey, String buttonName) {
		List<WindowsTestObject> candidates = buildExportButtonCandidates(objectKey, buttonName)

		for (WindowsTestObject candidate : candidates) {
			try {
				if (Windows.verifyElementPresent(candidate, 2, FailureHandling.OPTIONAL)) {
					Windows.click(candidate)

					KeywordUtil.logInfo(
							'Export button clicked successfully by element.\n' +
							'Button: ' + buttonName + '\n' +
							'Object key: ' + objectKey
					)

					return
				}
			} catch (Exception e) {
				KeywordUtil.logInfo(
						'Export button candidate failed.\n' +
						'Button: ' + buttonName + '\n' +
						'Reason: ' + e.getMessage()
				)
			}
		}

		imageLoader.takeEvidence(buttonName + 'ButtonNotFound.png')

		KeywordUtil.markFailedAndStop(
				'Export button was not found before timeout.\n' +
				'Button: ' + buttonName + '\n' +
				'Object key: ' + objectKey
		)
	}

	private List<WindowsTestObject> buildExportButtonCandidates(String objectKey, String buttonName) {
		List<WindowsTestObject> candidates = []

		try {
			candidates.add(WindowsObjectLoader.getObject('export', objectKey))
		} catch (Exception ignored) {
		}

		candidates.add(buildNameObject(buttonName))
		candidates.add(buildXpathObject("//*[@Name='" + buttonName + "' and @LocalizedControlType='button']"))
		candidates.add(buildXpathObject("//*[@Name='" + buttonName + "' and contains(@ControlType,'Button')]"))
		candidates.add(buildXpathObject("//*[@Name='" + buttonName + "']"))

		return candidates
	}

	private File saveToExecutionRecPrdExportFolder(String exportLabel, String targetEnvironment) {
		File directory = resolveExecutionRecPrdExportFolder()
		directory.mkdirs()

		String featureNameFromTargetFolder = directory.getName()
		String environment = resolveEnvironmentName(targetEnvironment, exportLabel)
		String exportLabelSuffix = resolveExportLabelSuffixForFileName(exportLabel)
		String fileName = buildAutomaticExportFileName(environment, featureNameFromTargetFolder, exportLabelSuffix)
		File exportedFile = new File(directory, fileName)

		KeywordUtil.logInfo('Execution REC/PRD export directory: ' + directory.getAbsolutePath())
		KeywordUtil.logInfo('Target environment received: ' + targetEnvironment)
		KeywordUtil.logInfo('Resolved export environment: ' + environment)
		KeywordUtil.logInfo('Export feature name from target folder: ' + featureNameFromTargetFolder)
		KeywordUtil.logInfo('Export label received: ' + exportLabel)
		KeywordUtil.logInfo('Export label suffix used in file name: ' + exportLabelSuffix)
		KeywordUtil.logInfo('Export file name: ' + fileName)
		KeywordUtil.logInfo('Expected exported file path: ' + exportedFile.getAbsolutePath())

		Windows.click(findWindowsObject('Object Repository/Acapulco/filePath'))
		Windows.delay(2)

		pasteAndEnter(directory.getAbsolutePath())

		Windows.delay(2)

		setFileName(fileName)

		Windows.click(findWindowsObject('General/btnSave'))
		Windows.delay(3)

		waitForExportedFileOrStop(exportedFile, 30)

		return exportedFile
	}

	private void waitForExportedFileOrStop(File exportedFile, Integer timeoutSeconds) {
		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 30 : timeoutSeconds
		int elapsedSeconds = 0

		while (elapsedSeconds < safeTimeout) {
			if (exportedFile.exists() && exportedFile.isFile() && exportedFile.length() > 0) {
				KeywordUtil.logInfo(
						'Exported file found.\n' +
						'Path: ' + exportedFile.getAbsolutePath() + '\n' +
						'Size bytes: ' + exportedFile.length()
				)

				return
			}

			Windows.delay(1)
			elapsedSeconds = elapsedSeconds + 1
		}

		imageLoader.takeEvidence('ExportedFileNotFound.png')

		KeywordUtil.markFailedAndStop(
				'Exported file was not found or is empty after save.\n' +
				'Expected path: ' + exportedFile.getAbsolutePath() + '\n' +
				'Timeout seconds: ' + safeTimeout
		)
	}

	private void validateExportedExcelFileHasRowsAndValues(File exportedFile) {
		if (exportedFile == null || !exportedFile.exists() || !exportedFile.isFile()) {
			KeywordUtil.markFailedAndStop(
					'Exported file does not exist for validation.\n' +
					'Path: ' + (exportedFile == null ? 'null' : exportedFile.getAbsolutePath())
			)
		}

		if (exportedFile.length() <= 0) {
			KeywordUtil.markFailedAndStop(
					'Exported file is empty.\n' +
					'Path: ' + exportedFile.getAbsolutePath()
			)
		}

		Workbook workbook = null

		try {
			workbook = WorkbookFactory.create(exportedFile)

			if (workbook.getNumberOfSheets() <= 0) {
				KeywordUtil.markFailedAndStop(
						'Exported Excel file has no sheets.\n' +
						'Path: ' + exportedFile.getAbsolutePath()
				)
			}

			Sheet sheet = workbook.getSheetAt(0)
			FormulaEvaluator evaluator = workbook.getCreationHelper().createFormulaEvaluator()
			DataFormatter formatter = new DataFormatter()

			int nonEmptyRows = 0
			int nonEmptyCells = 0

			for (int rowIndex = 0; rowIndex <= sheet.getLastRowNum(); rowIndex++) {
				Row row = sheet.getRow(rowIndex)

				if (row == null) {
					continue
				}

				boolean rowHasValue = false
				int lastCellNumber = row.getLastCellNum()

				if (lastCellNumber < 0) {
					continue
				}

				for (int cellIndex = 0; cellIndex < lastCellNumber; cellIndex++) {
					Cell cell = row.getCell(cellIndex)

					if (cell == null) {
						continue
					}

					String value = formatter.formatCellValue(cell, evaluator)

					if (value != null && !value.trim().isEmpty()) {
						nonEmptyCells = nonEmptyCells + 1
						rowHasValue = true
					}
				}

				if (rowHasValue) {
					nonEmptyRows = nonEmptyRows + 1
				}
			}

			KeywordUtil.logInfo(
					'Exported Excel validation result.\n' +
					'Path: ' + exportedFile.getAbsolutePath() + '\n' +
					'Non-empty rows: ' + nonEmptyRows + '\n' +
					'Non-empty cells: ' + nonEmptyCells
			)

			if (nonEmptyRows <= 1) {
				KeywordUtil.markFailedAndStop(
						'Exported Excel file does not have enough rows with values.\n' +
						'Path: ' + exportedFile.getAbsolutePath() + '\n' +
						'Non-empty rows: ' + nonEmptyRows
				)
			}

			if (nonEmptyCells <= 0) {
				KeywordUtil.markFailedAndStop(
						'Exported Excel file does not have values.\n' +
						'Path: ' + exportedFile.getAbsolutePath()
				)
			}
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop(
					'Could not validate exported Excel file.\n' +
					'Path: ' + exportedFile.getAbsolutePath() + '\n' +
					'Reason: ' + e.getMessage()
			)
		} finally {
			try {
				if (workbook != null) {
					workbook.close()
				}
			} catch (Exception ignored) {
			}
		}
	}

	private File resolveExecutionRecPrdExportFolder() {
		File executionRootFolder = resolveExecutionRootFolder()
		String collectionName = sanitizeFileName(resolveCurrentCollectionName())
		String featureName = sanitizeFileName(resolveCurrentFeatureName())

		return new File(
				executionRootFolder,
				'Shared_REC_PRD_Exports\\' + collectionName + '\\' + featureName
		)
	}

	private File resolveExecutionRootFolder() {
		String reportFolderPath = RunConfiguration.getReportFolder()

		if (reportFolderPath == null || reportFolderPath.trim().isEmpty()) {
			return new File(RunConfiguration.getProjectDir(), 'Reports\\Unknown_Execution')
		}

		File current = new File(reportFolderPath)

		while (current != null) {
			File parent = current.getParentFile()

			if (parent != null && parent.getName().equalsIgnoreCase('Reports')) {
				return current
			}

			current = parent
		}

		return new File(reportFolderPath)
	}

	private String buildAutomaticExportFileName(String environment, String featureName, String exportLabelSuffix) {
		String timestamp = new SimpleDateFormat('yyyyMMdd_HHmmss').format(new Date())
		String safeEnvironment = environment == null || environment.trim().isEmpty() ? 'REC' : environment
		String safeFeatureName = featureName == null || featureName.trim().isEmpty() ? resolveCurrentFeatureName() : featureName
		String safeExportLabelSuffix = exportLabelSuffix == null || exportLabelSuffix.trim().isEmpty() ? '' : exportLabelSuffix

		String baseFileName = safeEnvironment + '_' + timestamp + '_' + safeFeatureName

		if (!safeExportLabelSuffix.trim().isEmpty()) {
			baseFileName = baseFileName + '_' + safeExportLabelSuffix
		}

		return sanitizeFileName(baseFileName) + '.xlsx'
	}

	private String resolveExportLabelSuffixForFileName(String exportLabel) {
		if (exportLabel == null || exportLabel.trim().isEmpty()) {
			return ''
		}

		String value = sanitizeFileName(exportLabel)

		value = value.replaceFirst('(?i)^REC_', '')
		value = value.replaceFirst('(?i)^PRD_', '')
		value = value.replaceFirst('(?i)^REC-', '')
		value = value.replaceFirst('(?i)^PRD-', '')
		value = value.replaceFirst('(?i)^REC ', '')
		value = value.replaceFirst('(?i)^PRD ', '')

		if (value == null || value.trim().isEmpty()) {
			return ''
		}

		return value
	}

	private String resolveEnvironmentName(String targetEnvironment, String exportLabel) {
		String environmentFromParameter = normalizeEnvironmentNameStrict(targetEnvironment)

		if (environmentFromParameter != null) {
			KeywordUtil.logInfo('Environment resolved from targetEnvironment parameter: ' + environmentFromParameter)
			return environmentFromParameter
		}

		String environmentFromGlobal = normalizeEnvironmentNameStrict(getGlobalVariableValue('targetEnvironment'))

		if (environmentFromGlobal != null) {
			KeywordUtil.logInfo('Environment resolved from GlobalVariable.targetEnvironment: ' + environmentFromGlobal)
			return environmentFromGlobal
		}

		environmentFromGlobal = normalizeEnvironmentNameStrict(getGlobalVariableValue('currentEnvironment'))

		if (environmentFromGlobal != null) {
			KeywordUtil.logInfo('Environment resolved from GlobalVariable.currentEnvironment: ' + environmentFromGlobal)
			return environmentFromGlobal
		}

		environmentFromGlobal = normalizeEnvironmentNameStrict(getGlobalVariableValue('environment'))

		if (environmentFromGlobal != null) {
			KeywordUtil.logInfo('Environment resolved from GlobalVariable.environment: ' + environmentFromGlobal)
			return environmentFromGlobal
		}

		environmentFromGlobal = normalizeEnvironmentNameStrict(getGlobalVariableValue('env'))

		if (environmentFromGlobal != null) {
			KeywordUtil.logInfo('Environment resolved from GlobalVariable.env: ' + environmentFromGlobal)
			return environmentFromGlobal
		}

		environmentFromGlobal = normalizeEnvironmentNameStrict(getGlobalVariableValue('ENV'))

		if (environmentFromGlobal != null) {
			KeywordUtil.logInfo('Environment resolved from GlobalVariable.ENV: ' + environmentFromGlobal)
			return environmentFromGlobal
		}

		environmentFromGlobal = normalizeEnvironmentNameStrict(getGlobalVariableValue('currentEnv'))

		if (environmentFromGlobal != null) {
			KeywordUtil.logInfo('Environment resolved from GlobalVariable.currentEnv: ' + environmentFromGlobal)
			return environmentFromGlobal
		}

		environmentFromGlobal = normalizeEnvironmentNameStrict(getGlobalVariableValue('environmentName'))

		if (environmentFromGlobal != null) {
			KeywordUtil.logInfo('Environment resolved from GlobalVariable.environmentName: ' + environmentFromGlobal)
			return environmentFromGlobal
		}

		String environmentFromProfile = normalizeEnvironmentNameStrict(RunConfiguration.getExecutionProfile())

		if (environmentFromProfile != null) {
			KeywordUtil.logInfo('Environment resolved from execution profile: ' + environmentFromProfile)
			return environmentFromProfile
		}

		String environmentFromVisibleScreen = getEnvironmentFromVisibleScreen()

		if (environmentFromVisibleScreen != null) {
			KeywordUtil.logInfo('Environment resolved from visible screen: ' + environmentFromVisibleScreen)
			return environmentFromVisibleScreen
		}

		String environmentFromLabel = normalizeEnvironmentNamePrefixOnly(exportLabel)

		if (environmentFromLabel != null) {
			KeywordUtil.logInfo('Environment resolved from export label prefix: ' + environmentFromLabel)
			return environmentFromLabel
		}

		KeywordUtil.logInfo('Environment not resolved. Defaulting to REC.')
		return 'REC'
	}

	private String normalizeEnvironmentNameStrict(String rawEnvironment) {
		if (rawEnvironment == null || rawEnvironment.trim().isEmpty()) {
			return null
		}

		String value = rawEnvironment.trim().toUpperCase()

		if (value == 'PRD' || value == 'PROD' || value == 'PRODUCTION') {
			return 'PRD'
		}

		if (value == 'REC' || value == 'RECETTE') {
			return 'REC'
		}

		if (value.startsWith('PRD_') || value.startsWith('PRD-') || value.startsWith('PRD ')) {
			return 'PRD'
		}

		if (value.startsWith('REC_') || value.startsWith('REC-') || value.startsWith('REC ')) {
			return 'REC'
		}

		return null
	}

	private String normalizeEnvironmentNamePrefixOnly(String rawEnvironment) {
		if (rawEnvironment == null || rawEnvironment.trim().isEmpty()) {
			return null
		}

		String value = rawEnvironment.trim().toUpperCase()

		if (value == 'PRD' || value.startsWith('PRD_') || value.startsWith('PRD-') || value.startsWith('PRD ')) {
			return 'PRD'
		}

		if (value == 'REC' || value.startsWith('REC_') || value.startsWith('REC-') || value.startsWith('REC ')) {
			return 'REC'
		}

		return null
	}

	private String getEnvironmentFromVisibleScreen() {
		if (isAnyTextVisibleOnCurrentWindow(['PROD', 'PRODUCTION', 'PRD'])) {
			return 'PRD'
		}

		if (isAnyTextVisibleOnCurrentWindow(['RECETTE', 'REC'])) {
			return 'REC'
		}

		return null
	}

	private boolean isAnyTextVisibleOnCurrentWindow(List<String> texts) {
		for (String text : texts) {
			if (isTextVisibleOnCurrentWindow(text)) {
				return true
			}
		}

		return false
	}

	private boolean isTextVisibleOnCurrentWindow(String text) {
		if (text == null || text.trim().isEmpty()) {
			return false
		}

		String upperText = text.trim().toUpperCase()

		try {
			WindowsTestObject object = new WindowsTestObject('visibleText_' + sanitizeObjectName(upperText))
			object.setLocatorStrategy(LocatorStrategy.XPATH)
			object.setLocator(
					"//*[contains(translate(@Name, 'abcdefghijklmnopqrstuvwxyz', 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'), '" + upperText + "')]"
			)

			return Windows.verifyElementPresent(object, 1, FailureHandling.OPTIONAL)
		} catch (Exception ignored) {
		}

		return false
	}

	private String getGlobalVariableValue(String variableName) {
		try {
			def value = GlobalVariable."${variableName}"

			if (value != null && !value.toString().trim().isEmpty()) {
				return value.toString()
			}
		} catch (Exception ignored) {
		}

		return null
	}

	private String resolveCurrentCollectionName() {
		List<String> validParts = getValidReportFolderParts()

		if (!validParts.isEmpty()) {
			return validParts[0]
		}

		return 'Collection'
	}

	private String resolveCurrentFeatureName() {
		List<String> validParts = getValidReportFolderParts()

		if (!validParts.isEmpty()) {
			return validParts.last()
		}

		return 'Export'
	}

	private List<String> getValidReportFolderParts() {
		List<String> validParts = []
		String reportFolderPath = RunConfiguration.getReportFolder()

		if (reportFolderPath == null || reportFolderPath.trim().isEmpty()) {
			return validParts
		}

		File executionRootFolder = resolveExecutionRootFolder()
		String fullPath = new File(reportFolderPath).getAbsolutePath()
		String rootPath = executionRootFolder.getAbsolutePath()

		if (!fullPath.toLowerCase().startsWith(rootPath.toLowerCase())) {
			return validParts
		}

		String relativePath = fullPath.substring(rootPath.length())
		relativePath = relativePath.replaceAll('^\\\\+', '')

		if (relativePath.trim().isEmpty()) {
			return validParts
		}

		List<String> parts = relativePath.replace('/', '\\').split('\\\\') as List<String>

		for (String part : parts) {
			if (isValidFeatureNamePart(part)) {
				validParts.add(part.trim())
			}
		}

		return validParts
	}

	private boolean isValidFeatureNamePart(String part) {
		if (part == null || part.trim().isEmpty()) {
			return false
		}

		String value = part.trim()
		String lower = value.toLowerCase()

		if (value ==~ /\d{8}_\d{6}/ || value ==~ /\d{14}/) {
			return false
		}

		if (value ==~ /^\d+\.\s*.*/) {
			return false
		}

		List<String> ignoredExactValues = [
			'reports',
			'evidences',
			'exports',
			'test cases',
			'test suites',
			'connection',
			'authentication',
			'login rec',
			'login prd'
		]

		if (ignoredExactValues.contains(lower)) {
			return false
		}

		List<String> ignoredContainsValues = [
			'validation',
			'validations',
			'validate',
			'compare',
			'close application',
			'open module',
			'login'
		]

		for (String ignored : ignoredContainsValues) {
			if (lower.contains(ignored)) {
				return false
			}
		}

		return true
	}

	private String sanitizeFileName(String text) {
		if (text == null || text.trim().isEmpty()) {
			return 'Export'
		}

		String normalized = Normalizer.normalize(text, Normalizer.Form.NFD)
				.replaceAll('\\p{InCombiningDiacriticalMarks}+', '')

		return normalized
				.replaceAll('[\\\\/:*?"<>|]', '_')
				.replaceAll('\\s+', '_')
				.replaceAll('_+', '_')
				.replaceAll('^_|_$', '')
				.trim()
	}

	private void setFileName(String fileName) {
		boolean fileNameFieldFocused = focusFileNameField()

		if (!fileNameFieldFocused) {
			imageLoader.takeEvidence('FileNameFieldNotFocused.png')

			KeywordUtil.markFailedAndStop(
					'Could not focus export file name field before saving.\n' +
					'Expected file name: ' + fileName
			)
		}

		clearFocusedField()
		pasteText(fileName)
		Windows.delay(1)
	}

	private boolean focusFileNameField() {
		List<WindowsTestObject> candidateObjects = [
			buildFileNameFieldByAutomationId(),
			buildFileNameFieldByName('File name'),
			buildFileNameFieldByName('Nom du fichier'),
			buildFileNameFieldByName('Nome do ficheiro'),
			buildFileNameFieldByName('Nome do arquivo')
		]

		for (WindowsTestObject object : candidateObjects) {
			try {
				if (Windows.verifyElementPresent(object, 1, FailureHandling.OPTIONAL)) {
					Windows.click(object)
					Windows.delay(1)
					KeywordUtil.logInfo('File name field focused using dynamic Windows object: ' + object.getObjectId())
					return true
				}
			} catch (Exception ignored) {
			}
		}

		try {
			Windows.click(findWindowsObject('General/txtFileName'))
			Windows.delay(1)
			KeywordUtil.logInfo('File name field focused using General/txtFileName.')
			return true
		} catch (Exception ignored) {
			KeywordUtil.logInfo('General/txtFileName was not available.')
		}

		try {
			focusFileNameFieldWithShortcut()
			Windows.delay(1)
			KeywordUtil.logInfo('File name field focused using ALT + N.')
			return true
		} catch (Exception ignored) {
		}

		return false
	}

	private WindowsTestObject buildFileNameFieldByAutomationId() {
		WindowsTestObject object = new WindowsTestObject('fileNameFieldAutomationId')
		object.setLocatorStrategy(LocatorStrategy.XPATH)
		object.setLocator("//*[@AutomationId='FileNameControlHost']")

		return object
	}

	private WindowsTestObject buildFileNameFieldByName(String name) {
		WindowsTestObject object = new WindowsTestObject('fileNameField_' + sanitizeObjectName(name))
		object.setLocatorStrategy(LocatorStrategy.XPATH)
		object.setLocator(
				"//*[contains(translate(@Name, 'abcdefghijklmnopqrstuvwxyz', 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'), '" + name.toUpperCase() + "')]"
		)

		return object
	}

	private void closeOpenFileModalByVerifiedModal(Integer timeoutSeconds) {
		Integer safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 5 : Math.min(timeoutSeconds, 5)

		KeywordUtil.logInfo(
				'Verifying open-file modal before closing.\n' +
				'Expected modal: Export de données\n' +
				'Timeout: ' + safeTimeout + ' seconds'
		)

		if (!waitOpenFileModalVisible(safeTimeout)) {
			imageLoader.takeEvidence('OpenFileModalNotVerified.png')

			KeywordUtil.markFailedAndStop(
					'Open-file modal was not verified before close action.\n' +
					'Expected title bar: Export de données\n' +
					'Expected question: Voulez-vous ouvrir le fichier ?\n' +
					'Timeout seconds: ' + safeTimeout
			)
		}

		KeywordUtil.logInfo('Open-file modal verified. Trying to click Non by element.')

		if (clickNoButtonUsingKatalonElement()) {
			return
		}

		KeywordUtil.logInfo('Katalon click did not close the modal. Trying direct driver element click.')

		if (clickNoButtonUsingDriverElement()) {
			return
		}

		KeywordUtil.logInfo('Element click did not close the modal. Using TAB + ENTER only because modal was verified.')

		if (closeOpenFileModalByTabEnterAfterVerifiedModal()) {
			return
		}

		imageLoader.takeEvidence('OpenFileModalNonButtonNotClicked.png')

		KeywordUtil.markFailedAndStop(
				'Open-file modal was verified but could not be closed.\n' +
				'Expected button: Non'
		)
	}

	private boolean waitOpenFileModalVisible(Integer timeoutSeconds) {
		Integer safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 5 : Math.min(timeoutSeconds, 5)
		Integer elapsedSeconds = 0

		while (elapsedSeconds <= safeTimeout) {
			if (isOpenFileModalVisible()) {
				return true
			}

			KeywordUtil.logInfo(
					'Open-file modal not visible yet.\n' +
					'Elapsed seconds: ' + elapsedSeconds + '/' + safeTimeout
			)

			Windows.delay(1)
			elapsedSeconds = elapsedSeconds + 1
		}

		return false
	}

	private boolean isOpenFileModalVisible() {
		List<WindowsTestObject> modalCandidates = []

		try {
			modalCandidates.add(WindowsObjectLoader.getObject('export', 'openFileModalTitleBar'))
		} catch (Exception ignored) {
		}

		try {
			modalCandidates.add(WindowsObjectLoader.getObject('export', 'openFileModalAny'))
		} catch (Exception ignored) {
		}

		try {
			modalCandidates.add(WindowsObjectLoader.getObject('export', 'openFileModalQuestion'))
		} catch (Exception ignored) {
		}

		modalCandidates.add(buildXpathObject('''//*[@Name='Export de données' and @LocalizedControlType='title bar']'''))
		modalCandidates.add(buildXpathObject('''//*[@Name='Export de données' and contains(@ControlType,'TitleBar')]'''))
		modalCandidates.add(buildXpathObject('''//*[@Name='Export de données']'''))
		modalCandidates.add(buildXpathObject('''//*[contains(@Name,'Voulez-vous ouvrir le fichier')]'''))
		modalCandidates.add(buildXpathObject('''//*[contains(@Name,'ouvrir le fichier')]'''))

		for (WindowsTestObject modalCandidate : modalCandidates) {
			try {
				if (Windows.verifyElementPresent(modalCandidate, 1, FailureHandling.OPTIONAL)) {
					KeywordUtil.logInfo('Open-file modal verified by Katalon Windows object.')
					return true
				}
			} catch (Exception ignored) {
			}
		}

		List<String> driverModalXpaths = [
			'''//*[@Name='Export de données' and @LocalizedControlType='title bar']''',
			'''//*[@Name='Export de données' and contains(@ControlType,'TitleBar')]''',
			'''//*[@Name='Export de données']''',
			'''//*[contains(@Name,'Voulez-vous ouvrir le fichier')]''',
			'''//*[contains(@Name,'ouvrir le fichier')]'''
		]

		for (String xpath : driverModalXpaths) {
			if (driverElementExistsByXpath(xpath)) {
				KeywordUtil.logInfo(
						'Open-file modal verified by direct driver XPath.\n' +
						'XPath: ' + xpath
				)

				return true
			}
		}

		return false
	}

	private boolean clickNoButtonUsingKatalonElement() {
		List<WindowsTestObject> noButtonCandidates = []

		try {
			noButtonCandidates.add(WindowsObjectLoader.getObject('export', 'openFileNoButton'))
		} catch (Exception ignored) {
		}

		try {
			noButtonCandidates.add(WindowsObjectLoader.getObject('export', 'openFileNoButtonByName'))
		} catch (Exception ignored) {
		}

		noButtonCandidates.add(buildNameObject('Non'))
		noButtonCandidates.add(buildXpathObject('''//*[@Name='Non' and @LocalizedControlType='button']'''))
		noButtonCandidates.add(buildXpathObject('''//*[@Name='Non' and contains(@ControlType,'Button')]'''))
		noButtonCandidates.add(buildXpathObject('''//*[@Name='Non']'''))

		for (WindowsTestObject noButton : noButtonCandidates) {
			try {
				if (Windows.verifyElementPresent(noButton, 1, FailureHandling.OPTIONAL)) {
					KeywordUtil.logInfo('Non button found by Katalon object. Clicking Non.')

					Windows.click(noButton)
					Windows.delay(1)

					if (!isOpenFileModalVisible()) {
						KeywordUtil.logInfo('Open-file modal closed successfully by Katalon element click.')
						return true
					}

					KeywordUtil.logInfo('Katalon click was executed but modal is still visible.')
				}
			} catch (Exception e) {
				KeywordUtil.logInfo(
						'Katalon Non button click failed.\n' +
						'Reason: ' + e.getMessage()
				)
			}
		}

		return false
	}

	private boolean clickNoButtonUsingDriverElement() {
		List<String> xpathCandidates = [
			'''//*[@Name='Non' and @LocalizedControlType='button']''',
			'''//*[@Name='Non' and contains(@ControlType,'Button')]''',
			'''//*[@Name='Non']'''
		]

		for (String xpath : xpathCandidates) {
			try {
				def driver = WindowsDriverFactory.getWindowsSession()
				WebElement element = driver.findElement(By.xpath(xpath))

				if (element != null) {
					KeywordUtil.logInfo(
							'Non button found by direct driver XPath. Clicking element.\n' +
							'XPath: ' + xpath
					)

					try {
						element.click()
					} catch (Exception clickError) {
						KeywordUtil.logInfo(
								'Direct click failed. Trying ENTER on Non element.\n' +
								'Reason: ' + clickError.getMessage()
						)

						element.sendKeys(Keys.ENTER)
					}

					Windows.delay(1)

					if (!isOpenFileModalVisible()) {
						KeywordUtil.logInfo('Open-file modal closed successfully by direct driver element.')
						return true
					}

					KeywordUtil.logInfo('Direct driver action was executed but modal is still visible.')
				}
			} catch (Exception e) {
				KeywordUtil.logInfo(
						'Direct driver Non candidate failed.\n' +
						'XPath: ' + xpath + '\n' +
						'Reason: ' + e.getMessage()
				)
			}
		}

		try {
			def driver = WindowsDriverFactory.getWindowsSession()
			WebElement element = driver.findElement(By.name('Non'))

			if (element != null) {
				KeywordUtil.logInfo('Non button found by direct driver Name. Clicking element.')

				try {
					element.click()
				} catch (Exception clickError) {
					KeywordUtil.logInfo(
							'Direct Name click failed. Trying ENTER on Non element.\n' +
							'Reason: ' + clickError.getMessage()
					)

					element.sendKeys(Keys.ENTER)
				}

				Windows.delay(1)

				if (!isOpenFileModalVisible()) {
					KeywordUtil.logInfo('Open-file modal closed successfully by direct driver Name.')
					return true
				}
			}
		} catch (Exception e) {
			KeywordUtil.logInfo(
					'Direct driver Name failed for Non.\n' +
					'Reason: ' + e.getMessage()
			)
		}

		return false
	}

	private boolean closeOpenFileModalByTabEnterAfterVerifiedModal() {
		if (!isOpenFileModalVisible()) {
			KeywordUtil.logInfo('TAB + ENTER skipped because modal is not visible anymore.')
			return false
		}

		try {
			focusOpenFileModal()

			KeywordUtil.logInfo('Executing TAB + ENTER because open-file modal is verified.')

			Robot robot = new Robot()
			robot.setAutoDelay(120)

			robot.keyPress(KeyEvent.VK_TAB)
			robot.keyRelease(KeyEvent.VK_TAB)

			Windows.delay(1)

			robot.keyPress(KeyEvent.VK_ENTER)
			robot.keyRelease(KeyEvent.VK_ENTER)

			Windows.delay(1)

			if (!isOpenFileModalVisible()) {
				KeywordUtil.logInfo('Open-file modal closed successfully by TAB + ENTER.')
				return true
			}

			KeywordUtil.logInfo('TAB + ENTER executed but modal is still visible.')
		} catch (Exception e) {
			KeywordUtil.logInfo(
					'TAB + ENTER fallback failed.\n' +
					'Reason: ' + e.getMessage()
			)
		}

		return false
	}

	private void focusOpenFileModal() {
		List<WindowsTestObject> modalFocusCandidates = []

		try {
			modalFocusCandidates.add(WindowsObjectLoader.getObject('export', 'openFileModalTitleBar'))
		} catch (Exception ignored) {
		}

		modalFocusCandidates.add(buildXpathObject('''//*[@Name='Export de données' and @LocalizedControlType='title bar']'''))
		modalFocusCandidates.add(buildXpathObject('''//*[@Name='Export de données' and contains(@ControlType,'TitleBar')]'''))
		modalFocusCandidates.add(buildXpathObject('''//*[@Name='Export de données']'''))

		for (WindowsTestObject modal : modalFocusCandidates) {
			try {
				if (Windows.verifyElementPresent(modal, 1, FailureHandling.OPTIONAL)) {
					Windows.click(modal)
					Windows.delay(1)
					KeywordUtil.logInfo('Open-file modal focused before keyboard fallback.')
					return
				}
			} catch (Exception ignored) {
			}
		}

		KeywordUtil.logInfo('Could not focus modal by element. Continuing because modal was already verified.')
	}

	private boolean driverElementExistsByXpath(String xpath) {
		try {
			def driver = WindowsDriverFactory.getWindowsSession()
			WebElement element = driver.findElement(By.xpath(xpath))

			return element != null
		} catch (Exception ignored) {
		}

		return false
	}

	private WindowsTestObject buildNameObject(String name) {
		WindowsTestObject object = new WindowsTestObject('dynamicName_' + sanitizeObjectName(name))
		object.setLocatorStrategy(LocatorStrategy.NAME)
		object.setLocator(name)

		return object
	}

	private WindowsTestObject buildXpathObject(String xpath) {
		WindowsTestObject object = new WindowsTestObject('dynamic_' + sanitizeObjectName(xpath))
		object.setLocatorStrategy(LocatorStrategy.XPATH)
		object.setLocator(xpath)

		return object
	}

	private String sanitizeObjectName(String text) {
		if (text == null) {
			return 'empty'
		}

		return text.replaceAll('[^a-zA-Z0-9]', '_')
	}

	private void focusFileNameFieldWithShortcut() {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_ALT)
		robot.keyPress(KeyEvent.VK_N)
		robot.keyRelease(KeyEvent.VK_N)
		robot.keyRelease(KeyEvent.VK_ALT)
	}

	private void clearFocusedField() {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_CONTROL)

		Windows.delay(1)

		robot.keyPress(KeyEvent.VK_BACK_SPACE)
		robot.keyRelease(KeyEvent.VK_BACK_SPACE)
	}

	private void pasteAndEnter(String text) {
		pasteText(text)

		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_ENTER)
		robot.keyRelease(KeyEvent.VK_ENTER)
	}

	private void pasteText(String text) {
		StringSelection selection = new StringSelection(text)
		Toolkit.getDefaultToolkit().getSystemClipboard().setContents(selection, null)

		Windows.delay(1)

		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_V)
		robot.keyRelease(KeyEvent.VK_V)
		robot.keyRelease(KeyEvent.VK_CONTROL)
	}
