    def jiraImport(String epicKeyOverride) {
        JiraGateway gateway = new JiraGateway(this)
        JiraTestPlanManager testPlanManager = new JiraTestPlanManager(this, gateway)
        JiraReportBuilder reportBuilder = new JiraReportBuilder(this)
        JiraExecutionPublisher executionPublisher = new JiraExecutionPublisher(this, gateway)

        gateway.validateRequiredConfiguration()

        KeywordUtil.logInfo('============================================================')
        KeywordUtil.logInfo('Starting Jira import flow')
        KeywordUtil.logInfo('============================================================')

        String reportFolder = getResolvedReportFolder()
        if (isBlank(reportFolder)) {
            KeywordUtil.markFailedAndStop('Report folder could not be resolved.')
            return ''
        }

        KeywordUtil.logInfo("Using report folder: ${reportFolder}")

        String suiteName = getCurrentSuiteName()
        if (isBlank(suiteName)) {
            KeywordUtil.markFailedAndStop('Suite name could not be resolved from report path.')
            return ''
        }

        KeywordUtil.logInfo("Suite name detected from report path: ${suiteName}")

        if (!isBlank(epicKeyOverride)) {
            EPIC_KEY = safe(epicKeyOverride)
        } else if (AUTO_RESOLVE_EPIC_BY_NAME) {
            String epicSummary = AUTO_EPIC_PREFIX + getSuiteGroupName()
            String resolvedEpic = gateway.findEpicKeyBySummary(epicSummary)
            if (!isBlank(resolvedEpic)) {
                EPIC_KEY = resolvedEpic
                KeywordUtil.logInfo("Epic resolved automatically: ${EPIC_KEY}")
            } else {
                EPIC_KEY = safe(DEFAULT_EPIC_KEY)
                KeywordUtil.logInfo("Automatic epic not found. Using default epic key: ${EPIC_KEY}")
            }
        } else {
            EPIC_KEY = safe(DEFAULT_EPIC_KEY)
        }

        String executionSummary = getExecutionSummary()
        String testPlanSummary = getTestPlanName()

        KeywordUtil.logInfo("Execution title used: ${executionSummary}")
        KeywordUtil.logInfo("Test Plan title used: ${testPlanSummary}")

        String xmlPath = findXmlFile(reportFolder)
        if (isBlank(xmlPath)) {
            KeywordUtil.markFailedAndStop('JUnit_Report.xml was not found in the report folder.')
            return ''
        }

        KeywordUtil.logInfo("XML file found: ${xmlPath}")

        String customReportPath = reportBuilder.createHtmlReport(reportFolder, suiteName, xmlPath, executionSummary)
        if (isBlank(customReportPath)) {
            KeywordUtil.markWarning('Custom Jira HTML report could not be created.')
        } else {
            KeywordUtil.logInfo("Custom Jira report created: ${customReportPath}")
        }

        String testPlanKey = testPlanManager.getOrCreateTestPlanKey()
        if (isBlank(testPlanKey) || testPlanKey.startsWith('ERROR')) {
            KeywordUtil.markFailedAndStop("Test Plan could not be created or resolved: ${testPlanKey}")
            return ''
        }

        Map executionResult = executionPublisher.publishExecution(
            xmlPath,
            executionSummary,
            testPlanKey,
            reportFolder,
            customReportPath
        )

        String executionKey = safe(executionResult.executionKey)
        if (isBlank(executionKey) || executionKey.startsWith('ERROR')) {
            KeywordUtil.markFailedAndStop("Execution import failed: ${executionKey}")
            return ''
        }

        KeywordUtil.logInfo('============================================================')
        KeywordUtil.logInfo('Jira import finished')
        KeywordUtil.logInfo('============================================================')
        KeywordUtil.logInfo("Execution key: ${executionKey}")
        KeywordUtil.logInfo("Execution title used: ${executionSummary}")
        KeywordUtil.logInfo("Test Plan key: ${testPlanKey}")
        KeywordUtil.logInfo("Test Plan title used: ${testPlanSummary}")
        KeywordUtil.logInfo("Custom report attachment status: ${executionResult.customReportStatus}")
        KeywordUtil.logInfo("Evidence ZIP attachment status: ${executionResult.evidencesStatus}")
        KeywordUtil.logInfo("Results ZIP attachment status: ${executionResult.resultsStatus}")
        KeywordUtil.logInfo("Add execution to Test Plan status: ${executionResult.addExecutionStatus}")
        KeywordUtil.logInfo("Update Test Execution status: ${executionResult.updateExecutionStatus}")
        KeywordUtil.logInfo("Assign execution status: ${executionResult.assignExecutionStatus}")

        return executionKey
    }
