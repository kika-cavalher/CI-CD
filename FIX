package pageObject

import java.awt.Robot
import java.awt.event.KeyEvent

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.exception.StepFailedException
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.testobject.WindowsTestObject.LocatorStrategy
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import jiraIntegration.JiraReportSteps

class CotreParametersKeywords {

	private static final String SETTINGS_FOOTER_NAME = 'MNU_FILE'
	private static final String COTRE_PARAMETERS_NAME = 'Contre-valorisation'
	private static final String MODULES_FOOTER_NAME = 'Modules'

	private static final int ELEMENT_TIMEOUT = 10
	private static final int DELAY_AFTER_CLICK = 2
	private static final int DELAY_AFTER_POPUP_OPEN = 2
	private static final int DELAY_AFTER_CONFIRMATION = 5

	@Keyword
	def configureCurrency(String currency) {
		String normalizedCurrency = normalizeCurrency(currency)

		Robot robot = new Robot()
		robot.setAutoDelay(120)

		try {
			addNote(
				'Configure Cotre Parameters\n' +
				'Currency: ' + normalizedCurrency
			)

			clickByName(
				SETTINGS_FOOTER_NAME,
				'Open Settings footer'
			)

			clickByName(
				COTRE_PARAMETERS_NAME,
				'Open Cotre Parameters setting'
			)

			Windows.delay(DELAY_AFTER_POPUP_OPEN)

			addNote(
				'Move focus to currency field\n' +
				'Action: TAB x2'
			)

			pressKey(robot, KeyEvent.VK_TAB)
			pressKey(robot, KeyEvent.VK_TAB)

			addNote(
				'Select currency\n' +
				'Currency: ' + normalizedCurrency + '\n' +
				'Input method: keyboard'
			)

			typeCurrency(robot, normalizedCurrency)

			addNote(
				'Confirm selected currency\n' +
				'Action: TAB and ENTER'
			)

			pressKey(robot, KeyEvent.VK_TAB)
			pressKey(robot, KeyEvent.VK_ENTER)

			Windows.delay(DELAY_AFTER_CONFIRMATION)

			clickByName(
				MODULES_FOOTER_NAME,
				'Return to Modules footer'
			)

			KeywordUtil.logInfo(
				'Cotre Parameters ' +
				normalizedCurrency +
				' configured successfully.'
			)

			return true
		} catch (Exception error) {
			String message =
				'Failed to configure Cotre Parameters.\n' +
				'Currency: ' + normalizedCurrency + '\n' +
				'Reason: ' + error.getMessage()

			KeywordUtil.markFailed(message)

			throw new StepFailedException(
				message,
				error
			)
		}
	}

	private void clickByName(
		String elementName,
		String description
	) {
		WindowsTestObject object = buildNameObject(elementName)

		boolean elementFound = Windows.waitForElementPresent(
			object,
			ELEMENT_TIMEOUT,
			FailureHandling.OPTIONAL
		)

		if (!elementFound) {
			throw new StepFailedException(
				description + ' failed.\n' +
				'Element not found by NAME: ' + elementName
			)
		}

		addNote(
			description + '\n' +
			'Element: ' + elementName
		)

		Windows.click(
			object,
			FailureHandling.STOP_ON_FAILURE
		)

		Windows.delay(DELAY_AFTER_CLICK)
	}

	private WindowsTestObject buildNameObject(
		String elementName
	) {
		WindowsTestObject object = new WindowsTestObject()

		object.setLocatorStrategy(
			LocatorStrategy.NAME
		)

		object.setLocator(elementName)

		return object
	}

	private void typeCurrency(
		Robot robot,
		String currency
	) {
		currency.each { String character ->
			String upperCharacter = character.toUpperCase()

			if (upperCharacter == ' ') {
				pressKey(
					robot,
					KeyEvent.VK_SPACE
				)
			} else {
				Integer keyCode = resolveKeyCode(
					upperCharacter
				)

				pressKey(
					robot,
					keyCode
				)
			}
		}
	}

	private Integer resolveKeyCode(
		String character
	) {
		try {
			return KeyEvent."VK_${character}" as Integer
		} catch (Exception error) {
			throw new StepFailedException(
				'Unsupported currency character: ' +
					character,
				error
			)
		}
	}

	private void pressKey(
		Robot robot,
		Integer keyCode
	) {
		robot.keyPress(keyCode)
		robot.keyRelease(keyCode)

		Thread.sleep(300)
	}

	private String normalizeCurrency(
		String currency
	) {
		if (
			currency == null ||
			currency.trim().isEmpty()
		) {
			throw new StepFailedException(
				'Currency cannot be null or empty.'
			)
		}

		String normalizedCurrency =
			currency.trim().toUpperCase()

		if (
			normalizedCurrency != 'EUR' &&
			normalizedCurrency != 'USD' &&
			normalizedCurrency != 'MIXTE'
		) {
			throw new StepFailedException(
				'Unsupported Cotre Parameters currency: ' +
					normalizedCurrency +
					'. Expected: EUR, USD or Mixte.'
			)
		}

		if (normalizedCurrency == 'MIXTE') {
			return 'Mixte'
		}

		return normalizedCurrency
	}

	private void addNote(
		String message
	) {
		JiraReportSteps reportSteps =
			new JiraReportSteps()

		reportSteps.note(message)
	}
}
