@echo off
setlocal EnableExtensions EnableDelayedExpansion

REM English comments only
REM Task Scheduler calls THIS bat.
REM Jenkins writes the Katalon arguments (WITHOUT browser flags) to:
REM   C:\Gaia\katalon_args.txt
REM This bat:
REM   - reads that file
REM   - runs Katalon with visible Chrome (adds -browserType="Chrome" -noHeadless)
REM   - captures stdout/stderr to C:\Gaia\katalon_task.log (NO cmd redirection)
REM   - writes exit code to C:\Gaia\katalon_exit.txt (Jenkins will read it)

set "KATALON_HOME=C:\Users\adgi5appjenkins\Documents\Katalon_Studio_Engine_Windows_64-8.1.0"
set "ARGS_FILE=C:\Gaia\katalon_args.txt"
set "LOG_FILE=C:\Gaia\katalon_task.log"
set "EXIT_FILE=C:\Gaia\katalon_exit.txt"

if not exist "%KATALON_HOME%\katalonc.exe" (
  powershell -NoProfile -Command "Set-Content -Path '%LOG_FILE%' -Value '[bat] ERROR: katalonc.exe not found' -Encoding ASCII"
  powershell -NoProfile -Command "Set-Content -Path '%EXIT_FILE%' -Value '3' -Encoding ASCII"
  exit /b 3
)

if not exist "%ARGS_FILE%" (
  powershell -NoProfile -Command "Set-Content -Path '%LOG_FILE%' -Value '[bat] ERROR: katalon_args.txt not found' -Encoding ASCII"
  powershell -NoProfile -Command "Set-Content -Path '%EXIT_FILE%' -Value '2' -Encoding ASCII"
  exit /b 2
)

set "KATALON_ARGS="
for /f "usebackq delims=" %%A in ("%ARGS_FILE%") do (
  set "KATALON_ARGS=%%A"
  goto :gotArgs
)
:gotArgs

if "%KATALON_ARGS%"=="" (
  powershell -NoProfile -Command "Set-Content -Path '%LOG_FILE%' -Value '[bat] ERROR: katalon_args.txt is empty' -Encoding ASCII"
  powershell -NoProfile -Command "Set-Content -Path '%EXIT_FILE%' -Value '4' -Encoding ASCII"
  exit /b 4
)

REM Add ONLY visibility flags here (TC stays in Jenkins)
set "FULL_ARGS=-noSplash -runMode=console %KATALON_ARGS% -browserType=""Chrome"" -noHeadless"

REM Write header to the log
powershell -NoProfile -Command ^
  "$h=@(); $h+='[bat] Starting Katalon'; $h+='[bat] EXE=%KATALON_HOME%\\katalonc.exe'; $h+='[bat] ARGS=%FULL_ARGS%'; Set-Content -Path '%LOG_FILE%' -Value $h -Encoding ASCII"

REM Run katalonc via PowerShell and safely capture output to the log file
powershell -NoProfile -ExecutionPolicy Bypass -Command ^
  "$exe='%KATALON_HOME%\\katalonc.exe';" ^
  "$args='%FULL_ARGS%';" ^
  "$p=Start-Process -FilePath $exe -ArgumentList $args -Wait -PassThru -NoNewWindow -RedirectStandardOutput '%LOG_FILE%' -RedirectStandardError '%LOG_FILE%';" ^
  "Set-Content -Path '%EXIT_FILE%' -Value $p.ExitCode -Encoding ASCII; exit $p.ExitCode"

exit /b %ERRORLEVEL%





pipeline {
  agent { label 'GI5_SWDCFRNXGI55817' }

  options {
    timestamps()
    timeout(time: 75, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  stages {

    stage('Start Gaia Backend and Frontend') {
      steps {
        // Start backend/frontend via Windows Scheduled Task
        bat 'schtasks /run /tn "GaiaBackFrontSetup"'
        // Give services time to boot
        sleep(time: 300, unit: 'SECONDS')
      }
    }

    stage('Get bitbucket source code') {
      steps {
        // Clean workspace (best effort; do not fail build if something is locked)
        cleanWs(deleteDirs: true, disableDeferredWipeout: true, notFailBuild: true)

        // Checkout source code
        git credentialsId: '965eceec-b3a3-4ec5-8820-a857c87dd80f',
            url: 'https://bitbucket-mut.mycloud.intrabpce.fr/scm/gi5/gaia-portal.git'
      }
    }

    stage('GAIA TSC (Visible Chrome via Task)') {
      steps {
        script {
          // Fixed config (NOT parameters): TC stays hardcoded in Jenkins
          def PROJECT_PATH = 'D:/jenkins/work/workspace/GI5/Gaia/Gaia'
          def TSC_PATH     = 'Test Suites/GAIA TSC'

          // Write args file that the bat reads (WITHOUT browser flags)
          bat """
            if not exist C:\\Gaia mkdir C:\\Gaia
            echo -projectPath="${PROJECT_PATH}" -testSuiteCollectionPath="${TSC_PATH}" -consoleLog -logLevel=DEBUG > C:\\Gaia\\katalon_args.txt
            del /q C:\\Gaia\\katalon_exit.txt >NUL 2>&1
            del /q C:\\Gaia\\katalon_task.log >NUL 2>&1
            type C:\\Gaia\\katalon_args.txt
          """

          // Trigger scheduled task (Chrome visible)
          bat 'schtasks /run /tn "GaiaKatalon_Visible"'

          // Wait until exit code file exists (means bat finished)
          bat '''
            @echo off
            set EXIT=C:\\Gaia\\katalon_exit.txt
            set LOG=C:\\Gaia\\katalon_task.log

            set /a tries=0
            :wait
            if exist "%EXIT%" goto done
            timeout /t 5 /nobreak >nul
            set /a tries+=1
            if %tries% GEQ 600 (
              echo [jenkins] ERROR: Timeout waiting for %EXIT%
              if exist "%LOG%" (
                echo [jenkins] Showing last 80 lines of log:
                powershell -NoProfile -Command "Get-Content -Path '%LOG%' -Tail 80 -ErrorAction SilentlyContinue"
              )
              exit /b 1
            )
            goto wait

            :done
            for /f %%C in (%EXIT%) do set CODE=%%C
            echo [jenkins] Katalon exit code=%CODE%

            if not "%CODE%"=="0" (
              echo [jenkins] Showing last 120 lines of log:
              powershell -NoProfile -Command "Get-Content -Path '%LOG%' -Tail 120 -ErrorAction SilentlyContinue"
              exit /b 1
            )
          '''
        }
      }
    }
  }
}
