def NEXT_JOB = 'GI5/eMatch_Regression/Cube Rapp Detail V2'
def COLLECTION_TIMEOUT_HOURS = 5

def COLLECTIONS = [
    [stage: 'Investigations Collection',     cmd: 'JustificationLatentInvestigations.cmd'],
    [stage: 'Synthese Collection',           cmd: 'JustificationLatentSynthese.cmd'],
    [stage: 'Table de Liaison Collection',   cmd: 'JustificationLatentTableDeLiaison.cmd']
]

/*
|--------------------------------------------------------------------------
| FIXED LOGIC
|--------------------------------------------------------------------------
*/
def executionWarnings = []
def manuallyAborted = false

def asErrorText = { Throwable err ->
    def parts = []
    def current = err

    while (current != null) {
        parts << "${current.getClass().getName()} :: ${current.getMessage() ?: ''}"
        current = current.getCause()
    }

    return parts.join(' | ')
}

def isTimeoutError = { Throwable err ->
    def text = asErrorText(err).toLowerCase()
    return text.contains('timeout') || text.contains('exceededtimeout')
}

def isManualAbortError = { Throwable err ->
    def text = asErrorText(err).toLowerCase()
    return text.contains('flowinterruptedexception') || text.contains('aborted by')
}

def stopCurrentExecution = {
    bat '''
@echo off
schtasks /end /tn "\\eMatch Automation\\RunEMatchCommand" >nul 2>nul
schtasks /end /tn "startWinDriver" >nul 2>nul
taskkill /f /im WinAppDriver.exe /t >nul 2>nul
taskkill /f /im katalon.exe /t >nul 2>nul
taskkill /f /im KatalonStudio.exe /t >nul 2>nul
ping -n 3 127.0.0.1 >nul
exit /b 0
'''
}

def runCollection = { Map cfg ->
    stage(cfg.stage) {
        try {
            timeout(time: COLLECTION_TIMEOUT_HOURS, unit: 'HOURS') {
                bat "call \"${env.WORKSPACE}\\jenkins\\${cfg.cmd}\""
            }

            echo "${cfg.stage} completed successfully."
        } catch (Throwable err) {
            if (isManualAbortError(err) && !isTimeoutError(err)) {
                manuallyAborted = true
                currentBuild.result = 'ABORTED'
                echo "${cfg.stage} was manually aborted."
                throw err
            }

            if (isTimeoutError(err)) {
                echo "${cfg.stage} reached timeout, but Jenkins will continue to the next collection."
                executionWarnings << "${cfg.stage} reached timeout."
            } else {
                echo "${cfg.stage} failed, but Jenkins will continue to the next collection. Error: ${err}"
                executionWarnings << "${cfg.stage} failed."
            }
        } finally {
            stage("Stop ${cfg.stage}") {
                stopCurrentExecution()
            }
        }
    }
}

node(NODE_LABEL) {
    ws("D:\\jenkins\\ws\\${SHORT_WORKSPACE}") {
        timestamps {
            ansiColor('xterm') {
                stage('Checkout') {
                    deleteDir()
                    checkout scm
                }

                COLLECTIONS.each { cfg ->
                    if (!manuallyAborted) {
                        runCollection(cfg)
                    }
                }
            }
        }
    }
}

if (manuallyAborted) {
    return
}

stage('Trigger next pipeline') {
    if (RUN_NEXT_JOB && NEXT_JOB?.trim()) {
        echo "Scheduling next pipeline: ${NEXT_JOB}"
        build job: NEXT_JOB, wait: false, propagate: false
    } else {
        echo 'Next pipeline disabled.'
    }
}

if (!executionWarnings.isEmpty()) {
    echo 'Pipeline finished with warnings:'
    executionWarnings.each { warning ->
        echo " - ${warning}"
    }
}

currentBuild.result = 'SUCCESS'
return









