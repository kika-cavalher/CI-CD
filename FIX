/*
 * Responsibility:
 * Shared runner for eMatch desktop Jenkins pipelines.
 * Each Jenkinsfile provides its own PIPELINE_CONFIG and delegates execution here.
 */

def safeFileName(String value) {
    return (value ?: '').replaceAll(/[^A-Za-z0-9._ -]/, '').replace(' ', '_')
}

def bootstrapSupportFiles(script, Map cfg) {
    script.deleteDir()

    script.checkout([
        $class: 'GitSCM',
        branches: [[name: cfg.git.branch]],
        userRemoteConfigs: [[url: cfg.git.url, credentialsId: cfg.git.credentialsId]],
        extensions: [
            [$class: 'CloneOption', shallow: false, noTags: false, timeout: 30],
            [$class: 'SparseCheckoutPaths', sparseCheckoutPaths: [
                [path: 'jenkinsPipelines'],
                [path: 'jenkinsIntegration']
            ]]
        ]
    ])
}

def fullCheckout(script, Map cfg) {
    script.deleteDir()

    script.checkout([
        $class: 'GitSCM',
        branches: [[name: cfg.git.branch]],
        userRemoteConfigs: [[url: cfg.git.url, credentialsId: cfg.git.credentialsId]],
        extensions: [
            [$class: 'CloneOption', shallow: false, noTags: false, timeout: 30]
        ]
    ])
}

def loadPaths(script) {
    return script.load('jenkinsIntegration/JenkinsPaths.groovy')
}

def loadConsoleView(script) {
    return script.load('jenkinsIntegration/JenkinsConsoleView.groovy')
}

def loadResultStore(script) {
    return script.load('jenkinsIntegration/JenkinsResultStore.groovy')
}

def loadDesktopTaskLogger(script) {
    return script.load('jenkinsIntegration/JenkinsDesktopTaskLogger.groovy')
}

def publishPrimaryArtifact(script, String reportsRoot, Map result) {
    if (!(result?.screenshotRel ?: '').trim()) {
        return
    }

    def parts = result.screenshotRel.tokenize('/')
    if (!parts) {
        return
    }

    def suiteKey = safeFileName(result.name)
    def timestampPart = (parts.size() >= 2) ? parts[parts.size() - 2] : new Date().format('yyyyMMdd_HHmmss')
    def fileName = parts[parts.size() - 1]
    def srcFile = "${reportsRoot}\\${result.screenshotRel.replace('/', '\\')}"
    def destRel = "suite-artifacts/${suiteKey}/${timestampPart}/${fileName}"
    def destDir = "${reportsRoot}\\suite-artifacts\\${suiteKey}\\${timestampPart}"
    def destFile = "${reportsRoot}\\${destRel.replace('/', '\\')}"

    script.withEnv([
        "SRC_FILE=${srcFile}",
        "DEST_DIR=${destDir}",
        "DEST_FILE=${destFile}"
    ]) {
        script.powershell(
            returnStatus: true,
            script: '''
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

if (-not [string]::IsNullOrWhiteSpace($env:SRC_FILE) -and (Test-Path -LiteralPath $env:SRC_FILE)) {
    New-Item -ItemType Directory -Path $env:DEST_DIR -Force | Out-Null
    Copy-Item -LiteralPath $env:SRC_FILE -Destination $env:DEST_FILE -Force
}
'''
        )
    }

    result.primaryArtifactRel = destRel
}

def emergencyStopWinDriver(script, String winDriverTask) {
    if (!(winDriverTask ?: '').trim()) {
        return
    }

    script.withEnv([
        "WIN_DRIVER_TASK=${winDriverTask}"
    ]) {
        script.powershell(
            returnStatus: true,
            script: '''
$ErrorActionPreference = 'SilentlyContinue'
$ProgressPreference = 'SilentlyContinue'

try {
    schtasks /end /tn $env:WIN_DRIVER_TASK 1>$null 2>$null
}
catch {
}

exit 0
'''
        )
    }
}

def validateSupportFiles(script, Map cfg) {
    script.bat """
@echo off
echo ------------------------------------------------------------
echo VALIDATING TOOLS AND SUPPORT FILES
echo ------------------------------------------------------------

if not exist "${cfg.execution.katalonExe}" (
    echo [ERROR] Katalon executable not found
    echo ${cfg.execution.katalonExe}
