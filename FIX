    }

    @Keyword
    String resolveWindowTitle() {
        String version = firstNonBlank(
            gv('versionRec'),
            gv('versionREC'),
            gv('version'),
            '26.1.1.3'
        )

        if (version.toLowerCase().startsWith('ematch')) {
            return version
        }

        return "eMatch ${version}".trim()
    }

