				: targetEnvironment.trim().toUpperCase()

		String scenarioName =
				exportScenarioName == null
				? ''
				: exportScenarioName.trim()

		if (environment.isEmpty()) {
			environment = 'REC'
		}

		if (environment == 'PROD') {
			environment = 'PRD'
		}

		if (scenarioName.isEmpty()) {
			scenarioName =
					'ModuleDesResponsabilite_ValidateDimensions'
		}

		String exportLabel =
				environment +
				'_' +
				scenarioName

		logInfo(
				'Export configuration resolved.\n' +
				'Environment: ' +
				environment + '\n' +
				'Scenario: ' +
				scenarioName + '\n' +
				'Export label: ' +
				exportLabel
				)

		exportFromOutilsToNo(
				exportLabel,
				environment
				)

		imageLoader.takeEvidence(
				exportLabel +
				'.png'
				)

		logInfo(
				'Current table exported successfully.\n' +
