function Clean-Text {
    param([string]$Value)

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return ''
    }

    return (($Value -replace '[\\r\\n]+', ' ') -replace '\\s+', ' ').Trim()
}

function Short-Text {
    param(
        [string]$Value,
        [int]$Max = 180
    )

    $text = Clean-Text $Value

    if ($text.Length -gt $Max) {
        return $text.Substring(0, $Max - 3) + '...'
    }

    return $text
}

function Ensure-ParentDirectory {
    param([string]$Path)

    $parent = Split-Path -Path $Path -Parent
    if (-not [string]::IsNullOrWhiteSpace($parent) -and -not (Test-Path -LiteralPath $parent)) {
        New-Item -ItemType Directory -Path $parent -Force | Out-Null
    }
}

function Read-NewContent {
    param(
        [string]$Path,
        [ref]$Offset
    )

    if (-not (Test-Path -LiteralPath $Path)) {
        return @()
    }

    $fs = $null
    $sr = $null

    try {
        $fs = [System.IO.File]::Open($Path, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, [System.IO.FileShare]::ReadWrite)
        [void]$fs.Seek($Offset.Value, [System.IO.SeekOrigin]::Begin)
        $sr = New-Object System.IO.StreamReader($fs)
        $content = $sr.ReadToEnd()
        $Offset.Value = $fs.Position

        if ([string]::IsNullOrWhiteSpace($content)) {
            return @()
        }

        return @($content -split "`r?`n")
    }
    catch {
        return @()
    }
    finally {
        if ($sr) { $sr.Close() }
        if ($fs) { $fs.Close() }
    }
}

function Find-LatestRunRoot {
    param([string]$Root)

    if (-not (Test-Path -LiteralPath $Root)) {
        return ''
    }

    $candidate = Get-ChildItem -Path $Root -Directory -ErrorAction SilentlyContinue |
        Where-Object { $_.Name -match '^\\d{8}_\\d{6}$' } |
        Sort-Object LastWriteTime -Descending |
        Select-Object -First 1

    if ($candidate) {
        return $candidate.FullName
    }

    return ''
}

function Should-IncludeJunitForSummary {
    param([string]$JunitPath)

    $lower = ($JunitPath ?? '').ToLowerInvariant()

    if ($lower.Contains('jira import report')) {
        return $false
    }

    return $true
}

function Get-DisplayCaseName {
    param($TestCase)

    $className = ''
    $caseName = ''

    try { $className = [string]$TestCase.classname } catch {}
    try { $caseName = [string]$TestCase.name } catch {}

    $className = Clean-Text $className
    $caseName = Clean-Text $caseName

    if (-not [string]::IsNullOrWhiteSpace($className) -and -not [string]::IsNullOrWhiteSpace($caseName)) {
        if ($className.EndsWith($caseName)) {
            return $className
        }

        return ($className + '/' + $caseName)
    }

    if (-not [string]::IsNullOrWhiteSpace($className)) {
        return $className
    }

    return $caseName
}

function Get-JUnitSummary {
    param([string]$ReportsRoot)

    $result = [ordered]@{
        Executed    = 0
        Passed      = 0
        Failed      = 0
        Skipped     = 0
        Reason      = ''
        CaseSummary = @()
        RunRoot     = ''
    }

    $runRoot = Find-LatestRunRoot -Root $ReportsRoot
    $result.RunRoot = $runRoot

    if ([string]::IsNullOrWhiteSpace($runRoot)) {
        return $result
    }

    $junitFiles = Get-ChildItem -Path $runRoot -Filter 'JUnit_Report.xml' -File -Recurse -ErrorAction SilentlyContinue |
        Sort-Object FullName

    foreach ($junitFile in @($junitFiles)) {
        if (-not (Should-IncludeJunitForSummary -JunitPath $junitFile.FullName)) {
            continue
        }

        try {
            [xml]$xml = Get-Content -LiteralPath $junitFile.FullName -Raw
            $testcases = @()

            if ($xml.testsuite) {
                $testcases = @($xml.testsuite.testcase)
            }
            elseif ($xml.testsuites) {
                foreach ($suite in @($xml.testsuites.testsuite)) {
                    $testcases += @($suite.testcase)
                }
            }

            foreach ($tc in @($testcases | Where-Object { $_ })) {
                $result.Executed++

                $displayName = Get-DisplayCaseName -TestCase $tc
                $displayName = Short-Text $displayName 140

                $hasFailure = $false
                $hasSkipped = $false

                try {
                    if ($tc.failure -or $tc.error) {
                        $hasFailure = $true
                    }
                }
                catch {}

                try {
                    if ($tc.skipped) {
                        $hasSkipped = $true
                    }
                }
                catch {}

                if ($hasFailure) {
                    $result.Failed++

                    if ([string]::IsNullOrWhiteSpace($result.Reason)) {
                        try {
                            if ($tc.failure) {
                                $result.Reason = Short-Text (([string]$tc.failure.message + ' ' + [string]$tc.failure.InnerText)) 180
                            }
                            elseif ($tc.error) {
                                $result.Reason = Short-Text (([string]$tc.error.message + ' ' + [string]$tc.error.InnerText)) 180
                            }
                        }
                        catch {}
                    }

                    if ($result.CaseSummary.Count -lt 3 -and -not [string]::IsNullOrWhiteSpace($displayName)) {
                        $result.CaseSummary += ('FAILED | ' + $displayName)
                    }
                }
                elseif ($hasSkipped) {
                    $result.Skipped++

                    if ($result.CaseSummary.Count -lt 3 -and -not [string]::IsNullOrWhiteSpace($displayName)) {
                        $result.CaseSummary += ('SKIPPED | ' + $displayName)
                    }
                }
                else {
                    $result.Passed++

                    if ($result.CaseSummary.Count -lt 3 -and -not [string]::IsNullOrWhiteSpace($displayName)) {
                        $result.CaseSummary += ('PASSED | ' + $displayName)
                    }
                }
            }
        }
        catch {
            if ([string]::IsNullOrWhiteSpace($result.Reason)) {
                $result.Reason = Short-Text $_.Exception.Message 180
            }
        }
    }

    return $result
}

