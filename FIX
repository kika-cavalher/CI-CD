    private String buildJavascript(def firstCaseId) {
        String initialId = jsEscape(safeValue(firstCaseId))

        return """
            let currentView = 'tests';
            let selectedCaseId = '${initialId}';

            function switchView(viewName) {
                currentView = viewName;

                document.querySelectorAll('.tab-btn').forEach(function(btn) {
                    btn.classList.remove('active');
                });

                const buttons = document.querySelectorAll('.tab-btn');
                if (viewName === 'tests') {
                    buttons[0].classList.add('active');
                } else {
                    buttons[1].classList.add('active');
                }

                document.getElementById('view-tests').classList.toggle('active', viewName === 'tests');
                document.getElementById('view-charts').classList.toggle('active', viewName === 'charts');
            }

            function selectCase(caseId) {
                selectedCaseId = caseId;

                document.querySelectorAll('.sidebar-case-item').forEach(function(item) {
                    item.classList.toggle('active', item.getAttribute('data-case-id') === caseId);
                });

                document.querySelectorAll('.case-panel').forEach(function(panel) {
                    panel.classList.toggle('active', panel.getAttribute('data-case-id') === caseId);
                });

                switchView('tests');
            }

            function filterCases() {
                const value = document.getElementById('caseSearch').value.toLowerCase();

                document.querySelectorAll('.sidebar-case-item').forEach(function(item) {
                    const target = item.getAttribute('data-filter') || '';
                    const visible = target.indexOf(value) >= 0;
                    item.style.display = visible ? 'block' : 'none';
                });
            }
        """
    }

