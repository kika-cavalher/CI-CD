import java.util.Locale

import com.kms.katalon.core.annotation.AfterTestCase
import com.kms.katalon.core.annotation.AfterTestSuite
import com.kms.katalon.core.annotation.BeforeTestCase
import com.kms.katalon.core.annotation.BeforeTestSuite
import com.kms.katalon.core.context.TestCaseContext
import com.kms.katalon.core.context.TestSuiteContext
import com.kms.katalon.core.util.KeywordUtil

class ematchReport {

	private static final ThreadLocal<Boolean> TRACKING_ENABLED = new ThreadLocal<Boolean>()

	@BeforeTestSuite
	def beforeTestSuite(TestSuiteContext testSuiteContext) {
		String suiteId = safe(testSuiteContext?.getTestSuiteId())
		boolean skipSuite = shouldSkipSuite(suiteId)

		TRACKING_ENABLED.set(!skipSuite)

		if (skipSuite) {
			KeywordUtil.logInfo('[REPORT_LISTENER] Skipping report tracking for suite: ' + suiteId)
			return
		}

		try {
			CustomKeywords.'jiraIntegration.JiraReportSteps.reset'()
			CustomKeywords.'jiraIntegration.JiraReportSteps.setSuiteName'(cleanSuiteName(suiteId))
		} catch (Throwable t) {
			KeywordUtil.logInfo('[REPORT_LISTENER] beforeTestSuite failed: ' + safe(t.message))
		}
	}

	@BeforeTestCase
	def beforeTestCase(TestCaseContext testCaseContext) {
		if (!isTrackingEnabled()) {
			return
		}

		try {
			String caseId = safe(testCaseContext?.getTestCaseId())
			CustomKeywords.'jiraIntegration.JiraReportSteps.startCase'(caseId)
		} catch (Throwable t) {
			KeywordUtil.logInfo('[REPORT_LISTENER] beforeTestCase failed: ' + safe(t.message))
		}
	}

	@AfterTestCase
	def afterTestCase(TestCaseContext testCaseContext) {
		if (!isTrackingEnabled()) {
			return
		}

		String caseId = safe(testCaseContext?.getTestCaseId())
		String rawStatus = safe(testCaseContext?.getTestCaseStatus())
		String rawMessage = safe(testCaseContext?.getMessage())
		String finalStatus = resolveFinalStatus(caseId, rawStatus, rawMessage)

		try {
			if ('FAILED'.equals(finalStatus)) {
				CustomKeywords.'jiraIntegration.JiraReportSteps.fail'(rawMessage)
				CustomKeywords.'jiraIntegration.JiraImagesEvidence.autoFailure'(caseId)
			}

			CustomKeywords.'jiraIntegration.JiraReportSteps.finishCase'(finalStatus)
			new jiraIntegration.JiraReportBuilder().buildReport()
		} catch (Throwable t) {
			KeywordUtil.logInfo('[REPORT_LISTENER] afterTestCase failed: ' + safe(t.message))
		}
	}

	@AfterTestSuite
	def afterTestSuite(TestSuiteContext testSuiteContext) {
		if (!isTrackingEnabled()) {
			return
		}

		try {
			new jiraIntegration.JiraReportBuilder().buildReport()
		} catch (Throwable t) {
			KeywordUtil.logInfo('[REPORT_LISTENER] afterTestSuite failed: ' + safe(t.message))
		} finally {
			TRACKING_ENABLED.remove()
		}
	}

	private boolean isTrackingEnabled() {
		Boolean enabled = TRACKING_ENABLED.get()
		return enabled != null && enabled.booleanValue()
	}

	private boolean shouldSkipSuite(String suiteId) {
		String lower = safe(suiteId).toLowerCase(Locale.ENGLISH)
		return lower.contains('jira integration report')
	}

	private String resolveFinalStatus(String caseId, String rawStatus, String rawMessage) {
		String upper = safe(rawStatus).toUpperCase(Locale.ENGLISH)

		if (upper in ['FAILED', 'FAIL', 'ERROR']) {
			return 'FAILED'
		}

		if (upper in ['BLOCKED', 'SKIPPED']) {
			return 'BLOCKED'
		}

		boolean storedFailure = false

		try {
			storedFailure = CustomKeywords.'jiraIntegration.JiraReportSteps.caseHasFailure'(caseId)
		} catch (Throwable ignored) {
			storedFailure = false
		}

		if (storedFailure) {
			return 'FAILED'
		}

		if (!safe(rawMessage).isEmpty() && !'PASSED'.equals(upper)) {
			return 'FAILED'
		}

		return 'PASSED'
	}

	private String cleanSuiteName(String suiteId) {
		String value = safe(suiteId)
		if (value.startsWith('Test Suites/')) {
			return value.substring('Test Suites/'.length())
		}
		return value
	}

	private String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}
}
