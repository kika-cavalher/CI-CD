pipeline {
    agent { label 'GI5_SWDCFRNXGI55817' }

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        timeout(time: 90, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10', daysToKeepStr: '14'))
        skipDefaultCheckout(true)
    }

    parameters {
        choice(
            name: 'RUN_MODE',
            choices: ['VISIBLE', 'HEADLESS'],
            description: 'Choose how Chrome should run'
        )
        string(
            name: 'STARTUP_WAIT_SECONDS',
            defaultValue: '45',
            description: 'Seconds to wait after Gaia startup'
        )
    }

    environment {
        KATALON_HOME        = 'C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0'
        GIT_URL             = 'https://bitbucket-mut.mycloud.intrabpce.fr/scm/gi5/gaia-portal.git'
        GIT_CRED            = '965eceec-b3a3-4ec5-8820-a857c87dd80f'
        REPORTS_DIR         = 'Reports'
        DISPLAY_WIDTH       = '1920'
        DISPLAY_HEIGHT      = '1080'
        VISIBLE_TASK_NAME   = 'GaiaKatalon_Visible'
        VISIBLE_COMMAND_BAT = 'C:\\Gaia\\visible_katalon_command.bat'
        VISIBLE_STATUS_FILE = 'C:\\Gaia\\gaia_visible_status.txt'
        VISIBLE_LOG_FILE    = 'C:\\Gaia\\gaia_visible_console.log'
    }

    stages {

        stage('Start Gaia Backend + Frontend') {
            steps {
                echo 'Starting Gaia backend and frontend'
                bat 'schtasks /run /tn "GaiaBackFrontSetup"'
                sleep(time: params.STARTUP_WAIT_SECONDS.toInteger(), unit: 'SECONDS')
            }
        }

        stage('Checkout gaia-portal') {
            steps {
                deleteDir()

                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/master']],
                    userRemoteConfigs: [[url: env.GIT_URL, credentialsId: env.GIT_CRED]],
                    extensions: [
                        [$class: 'WipeWorkspace'],
                        [$class: 'CloneOption', shallow: false, noTags: false, timeout: 30]
                    ]
                ])
            }
        }

        stage('Prepare Execution') {
            steps {
                script {
                    bat """
                        @echo off
                        if exist "${env.WORKSPACE}\\${env.REPORTS_DIR}" rmdir /s /q "${env.WORKSPACE}\\${env.REPORTS_DIR}"
                        mkdir "${env.WORKSPACE}\\${env.REPORTS_DIR}"
                    """

                    env.PROJECT_PATH = powershell(
                        returnStdout: true,
                        script: """
                            \$prj = Get-ChildItem -Path "${env.WORKSPACE}" -Filter *.prj -Recurse -ErrorAction SilentlyContinue |
                                   Select-Object -First 1 -ExpandProperty FullName
                            if (-not \$prj) {
                                Write-Error "No .prj file found under workspace: ${env.WORKSPACE}"
                                exit 1
                            }
                            Write-Output \$prj
                        """
                    ).trim()

                    echo "Project file found: ${env.PROJECT_PATH}"

                    env.PROJECT_DIR = powershell(
                        returnStdout: true,
                        script: """
                            Split-Path -Path "${env.PROJECT_PATH}" -Parent
                        """
                    ).trim()

                    echo "Project directory: ${env.PROJECT_DIR}"
                }
            }
        }

        stage('Execute Gaia Suites') {
            steps {
                script {
                    def suites = [
                        [name: 'PreLoad',                path: 'Test Suites/PreLoad'],
                        [name: 'Help',                   path: 'Test Suites/Help'],
                        [name: 'AddCorrection',          path: 'Test Suites/AddCorrection'],
                        [name: 'ComputationSelection',   path: 'Test Suites/Computation Selection'],
                        [name: 'CorrectedDuplication',   path: 'Test Suites/CorrectedDuplication'],
                        [name: 'CorrectionDetails',      path: 'Test Suites/CorrectionDetails'],
                        [name: 'DownloadInvalidRecords', path: 'Test Suites/DownloadInvalidRecords']
                    ]

                    for (suite in suites) {
                        runGaiaSuite(suite)
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'Reports/**/*', allowEmptyArchive: true, excludes: '**/*.lck'

            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
                junit allowEmptyResults: true, testResults: 'Reports/**/JUnit_Report.xml, Reports/**/junit*.xml, Reports/**/TEST-*.xml'
            }

            powershell """
                \$ErrorActionPreference = 'SilentlyContinue'

                Get-CimInstance Win32_Process | Where-Object {
                    \$_.Name -match 'katalon|katalonc|chrome|chromedriver' -or
                    (\$_.Name -eq 'java.exe' -and \$_.CommandLine -like '*katalon*')
                } | ForEach-Object {
                    try {
                        Stop-Process -Id \$_.ProcessId -Force
                    } catch {}
                }
            """
        }

        success {
            echo 'SUCCESS: Pipeline completed successfully'
        }

        unstable {
            echo 'UNSTABLE: Pipeline completed with test failures'
        }

        failure {
            echo 'FAILURE: Pipeline failed'
        }

        aborted {
            echo 'ABORTED: Pipeline canceled by user'
        }
    }
}

def runGaiaSuite(suite) {
    def reportDir = "${env.WORKSPACE}\\${env.REPORTS_DIR}\\${suite.name}"
    def chromeArgs = buildChromeArgs(params.RUN_MODE)

    echo "========================================"
    echo "Suite Name : ${suite.name}"
    echo "Suite Path : ${suite.path}"
    echo "Run Mode   : ${params.RUN_MODE}"
    echo "Project    : ${env.PROJECT_PATH}"
    echo "Report Dir : ${reportDir}"
    echo "========================================"

    bat """
        @echo off
        if exist "${reportDir}" rmdir /s /q "${reportDir}"
        mkdir "${reportDir}"
    """

    if (params.RUN_MODE == 'HEADLESS') {
        catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
            executeKatalon(
                location: env.KATALON_HOME,
                executeArgs:
                    "-projectPath=\"${env.PROJECT_PATH}\" " +
                    "-testSuitePath=\"${suite.path}\" " +
                    "-browserType=\"Chrome\" " +
                    "-consoleLog -logLevel=DEBUG " +
                    "-reportFolder=\"${reportDir}\" " +
                    chromeArgs,
                version: '',
                x11Display: '',
                xvfbConfiguration: ''
            )
        }
    } else {
        def visibleCommand = """@echo off
cd /d "${env.PROJECT_DIR}"
call "${env.KATALON_HOME}\\katalonc.exe" ^
-projectPath="${env.PROJECT_PATH}" ^
-testSuitePath="${suite.path}" ^
-browserType="Chrome" ^
-consoleLog -logLevel=DEBUG ^
-reportFolder="${reportDir}" ^
${chromeArgs}
exit /b %ERRORLEVEL%
"""

        writeFile file: 'visible_katalon_command.bat', text: visibleCommand

        bat """
            @echo off
            copy /Y "${env.WORKSPACE}\\visible_katalon_command.bat" "${env.VISIBLE_COMMAND_BAT}" >nul
            if exist "${env.VISIBLE_STATUS_FILE}" del /f /q "${env.VISIBLE_STATUS_FILE}"
            if exist "${env.VISIBLE_LOG_FILE}" del /f /q "${env.VISIBLE_LOG_FILE}"
        """

        bat "schtasks /run /tn \"${env.VISIBLE_TASK_NAME}\""

        powershell """
            \$statusFile = "${env.VISIBLE_STATUS_FILE}"
            \$timeoutMinutes = 30
            \$start = Get-Date

            Write-Host "Waiting visible execution for suite: ${suite.name}"

            while (\$true) {
                if (Test-Path \$statusFile) {
                    Write-Host "Status file found"
                    Get-Content \$statusFile
                    break
                }

                if (((Get-Date) - \$start).TotalMinutes -ge \$timeoutMinutes) {
                    Write-Error "Timeout waiting for suite ${suite.name}"
                    exit 1
                }

                Start-Sleep -Seconds 5
            }
        """

        powershell """
            \$statusFile = "${env.VISIBLE_STATUS_FILE}"

            if (!(Test-Path \$statusFile)) {
                Write-Error "Status file not found for suite ${suite.name}"
                exit 1
            }

            \$content = Get-Content \$statusFile | Select-Object -First 1

            if (\$content -match 'EXIT_CODE=(\\d+)') {
                \$exitCode = [int]\$matches[1]
                Write-Host "Suite ${suite.name} exit code: \$exitCode"

                if (\$exitCode -ne 0) {
                    Write-Error "Suite ${suite.name} failed with exit code \$exitCode"
                    exit \$exitCode
                }
            } else {
                Write-Error "Could not parse exit code for suite ${suite.name}"
                exit 1
            }
        """
    }
}

def buildChromeArgs(runMode) {
    if (runMode == 'HEADLESS') {
        def args = [
            '--headless=new',
            "--window-size=${env.DISPLAY_WIDTH},${env.DISPLAY_HEIGHT}",
            '--disable-gpu',
            '--disable-dev-shm-usage',
            '--no-sandbox'
        ]
        return "--config -webui.chrome.args='${args.join(' ')}'"
    }

    def args = [
        "--window-size=${env.DISPLAY_WIDTH},${env.DISPLAY_HEIGHT}",
        '--start-maximized'
    ]
    return "--config -webui.chrome.args='${args.join(' ')}'"
}
