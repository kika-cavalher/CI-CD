import java.util.Locale

import com.kms.katalon.core.util.KeywordUtil

Integer threshold = 3
Integer maxDifferencesToShow = 999
Integer maxErrorsToShow = 999

String acceptedDifferenceText = '<= ' + threshold + '%'

def addNote = { String message ->
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(message)
}

Map result = CustomKeywords.'commands.ExportFileComparator.compareRecProdExportFiles'(
		threshold
)

String featureName = safeText(result.featureName, 'Not available')
String sharedFolderName = folderNameOnly(result.sharedFolder)

String recFileName = fileNameOnly(result.recFileName)
String prdFileName = fileNameOnly(result.prdFileName)

String recFileStatus = isNotFound(recFileName) ? 'FAILED' : 'PASSED'
String prdFileStatus = isNotFound(prdFileName) ? 'FAILED' : 'PASSED'

Integer totalValidations = toInteger(result.totalValidations, 0)
Integer passedValidations = toInteger(result.passedValidations, 0)
Integer failedValidations = toInteger(result.failedValidations, 0)

List<Map> validations = result.validations == null ? [] : result.validations as List<Map>
List<String> differences = result.differences == null ? [] : result.differences as List<String>

String errorsText = safeText(result.errorsText, '')
Boolean hasFailure = failedValidations > 0 || !differences.isEmpty() || !errorsText.isEmpty()

addNote(
		'[PASS] REC x PRD Export Validation setup\n' +
		'Feature: ' + featureName + '\n' +
		'Accepted numeric difference: ' + acceptedDifferenceText + '\n' +
		'Shared folder: ' + sharedFolderName + '\n' +
		'Goal: compare the REC exported file against the PRD exported file.'
)

addNote(
		((recFileStatus == 'PASSED' && prdFileStatus == 'PASSED') ? '[PASS] ' : '[FAIL] ') +
		'Files selected for comparison\n' +
		'Expected files: 2\n' +
		'Files ready: ' + countReadyFiles(recFileName, prdFileName) + '\n\n' +
		'REC file: ' + recFileStatus + ' - ' + recFileName + '\n' +
		'PRD file: ' + prdFileStatus + ' - ' + prdFileName
)

addNote(
		(hasFailure ? '[FAIL] ' : '[PASS] ') +
		'Validation summary\n' +
		'Total validations: ' + totalValidations + '\n' +
		'Passed: ' + passedValidations + '\n' +
		'Failed: ' + failedValidations + '\n' +
		'Accepted numeric difference: ' + acceptedDifferenceText + '\n' +
		'Differences listed: ' + differences.size()
)

if (validations.isEmpty()) {
	addNote(
			'[SKIPPED] Validation details\n' +
			'No validation detail was returned by the comparator keyword.'
	)
} else {
	validations.eachWithIndex { Map validation, int index ->
		String validationName = safeText(validation.name, 'Validation ' + (index + 1))
		String validationStatus = normalizeStatus(validation.status)
		String validationDetails = cleanReportText(validation.details)

		String statusPrefix = validationStatus == 'PASS' ? '[PASS] ' : '[FAIL] '

		addNote(
				statusPrefix +
				'Validation ' + (index + 1) + ' - ' + validationName + '\n' +
				'Status: ' + validationStatus + '\n' +
				formatValidationDetails(validationDetails, acceptedDifferenceText)
		)
	}
}

if (!differences.isEmpty()) {
	addNote(
			'[FAIL] Differences found\n' +
			'Total differences returned: ' + differences.size() + '\n' +
			'Differences displayed: ' + Math.min(differences.size(), maxDifferencesToShow) + '\n' +
			'Accepted numeric difference: ' + acceptedDifferenceText + '\n\n' +
			buildDifferencesReport(differences, maxDifferencesToShow, acceptedDifferenceText)
	)
} else {
	addNote(
			'[PASS] Differences check\n' +
			'Accepted numeric difference: ' + acceptedDifferenceText + '\n' +
			'No differences were returned by the comparator keyword.'
	)
}

if (!errorsText.isEmpty()) {
	addNote(
			'[FAIL] Comparator errors\n' +
			'Accepted numeric difference: ' + acceptedDifferenceText + '\n\n' +
			buildErrorsReport(errorsText, maxErrorsToShow, acceptedDifferenceText)
	)
}

if (hasFailure) {
	addNote(
			'[FAIL] Final result\n' +
			'REC x PRD export validation finished with mismatches.\n' +
			'Feature: ' + featureName + '\n' +
			'Accepted numeric difference: ' + acceptedDifferenceText + '\n' +
