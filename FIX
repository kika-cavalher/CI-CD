	String readLastRunPath() {
		File lastRunFile = new File(RunConfiguration.projectDir + '\\LastRun.xlsx')
		if (!lastRunFile.exists()) {
			return ''
		}

		FileInputStream fis = null
		XSSFWorkbook wb = null

		try {
			fis = new FileInputStream(lastRunFile)
			wb = new XSSFWorkbook(fis)
			XSSFSheet sheet = wb.getSheetAt(0)
			XSSFRow row = sheet.getRow(0)

			if (row == null || row.getCell(0) == null) {
				return ''
			}

			String result = safe(row.getCell(0).stringCellValue)
			return result
		} catch (Exception e) {
			KeywordUtil.logInfo("Could not read LastRun.xlsx: ${e.message}")
			return ''
		} finally {
			try { wb?.close() } catch (Exception ignored) {}
			try { fis?.close() } catch (Exception ignored) {}
		}
	}

	File findLatestReportFolderFromRoot() {
		File reportsRoot = new File(RunConfiguration.projectDir + '\\Reports')
		if (!reportsRoot.exists() || !reportsRoot.isDirectory()) {
			return null
		}

		List<File> rootTimestampFolders = reportsRoot.listFiles()?.findAll {
			it.isDirectory() && isTimestampFolderName(it.name)
		} ?: []

		if (rootTimestampFolders.isEmpty()) {
			return null
		}

		File latestRoot = rootTimestampFolders.max { it.lastModified() }
		if (latestRoot == null) {
			return null
		}

		List<File> suiteFolders = latestRoot.listFiles()?.findAll {
			it.isDirectory() && !isTimestampFolderName(it.name)
		} ?: []

		if (suiteFolders.isEmpty()) {
			return null
		}

		File latestSuiteFolder = suiteFolders.max { it.lastModified() }
		if (latestSuiteFolder == null) {
			return null
		}

		List<File> executionFolders = latestSuiteFolder.listFiles()?.findAll {
			it.isDirectory() && isTimestampFolderName(it.name)
		} ?: []

		if (executionFolders.isEmpty()) {
			return latestSuiteFolder
		}

		return executionFolders.max { it.lastModified() }
	}

	String getReportPath() {
		String fromLastRun = readLastRunPath()
		if (!isBlank(fromLastRun) && new File(fromLastRun).exists()) {
			return fromLastRun
		}

		File fallback = findLatestReportFolderFromRoot()
		return fallback == null ? '' : fallback.absolutePath
	}

	String extractSuiteNameFromReportPath(String reportPath) {
		if (isBlank(reportPath)) {
			return ''
		}

		File folder = new File(reportPath)
		if (!folder.exists()) {
			return ''
		}

		String currentName = safe(folder.name)
		String parentName = folder.parentFile == null ? '' : safe(folder.parentFile.name)

		if (isTimestampFolderName(currentName) && !isBlank(parentName)) {
			return parentName
		}

		return currentName
	}

	String getCurrentSuiteName() {
