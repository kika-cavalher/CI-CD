} catch (Throwable failure) {

	executionFailure = failure

	KeywordUtil.logInfo(
		'[GUI FAVORITE FAILURE]\n' +
		'The current test will be stopped and the suite can continue with the next test.\n' +
		'Reason: ' +
		(
			failure.getMessage() == null ||
			failure.getMessage().trim().isEmpty()
				? failure.getClass().getSimpleName()
				: failure.getMessage()
		)
	)

} finally {

	// ======================================================
	// CLOSE APPLICATION
	// ======================================================

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'Close application\n' +
		'Environment: ' + targetEnvironment
	)

