

package jiraIntegration

import groovy.json.JsonOutput
import groovy.json.JsonSlurper

import java.io.ByteArrayOutputStream
import java.io.File
import java.io.InputStream
import java.net.HttpURLConnection
import java.net.URL
import java.net.URLEncoder
import java.nio.charset.StandardCharsets
import java.security.SecureRandom
import java.security.cert.X509Certificate
import java.util.UUID

import javax.net.ssl.HostnameVerifier
import javax.net.ssl.HttpsURLConnection
import javax.net.ssl.SSLContext
import javax.net.ssl.SSLSession
import javax.net.ssl.TrustManager
import javax.net.ssl.X509TrustManager

class JiraGateway {

	private final def owner

	private String jiraBaseUrl = ''
	private String authHeader = ''
	private boolean ignoreSslCertificates = true

	JiraGateway(def owner) {
		this.owner = owner
		loadConfiguration()
	}

	// =========================================================================
	// PUBLIC API
	// =========================================================================

	void validateRequiredConfiguration() {
		if (blank(jiraBaseUrl)) {
			throw new IllegalStateException('JIRA_BASE_URL is required.')
		}

		if (blank(authHeader)) {
			throw new IllegalStateException('Jira authentication is required.')
		}
	}

	Map getIssueByKey(String issueKey) {
		validateRequiredConfiguration()
		return doGet('/rest/api/2/issue/' + encoded(issueKey))
	}

	Map searchIssues(String jql) {
		validateRequiredConfiguration()
		String path = '/rest/api/2/search?jql=' + encoded(jql) + '&maxResults=200'
		return doGet(path)
	}

	Map searchTestPlans(String projectKey, String summary) {
		validateRequiredConfiguration()

		String escapedSummary = escapeJql(summary)
		String jql = "project = '${safe(projectKey)}' AND issuetype = 'Test Plan' AND summary ~ \\\"${escapedSummary}\\\" ORDER BY created DESC"

		return searchIssues(jql)
	}

	/*
	 * This method was intentionally made flexible because different project files
	 * may call createTestPlan with different signatures.
	 *
	 * Supported signatures:
	 * 1) createTestPlan(summary, epicKey)
	 * 2) createTestPlan(projectKey, summary, epicKey)
	 * 3) createTestPlan(projectKey, summary, epicFieldId, epicKey)
	 * 4) createTestPlan(projectKey, summary, epicFieldId, epicKey, labels)
	 * 5) createTestPlan(projectKey, summary, epicFieldId, epicKey, labels, description)
	 */
	Map createTestPlan(Object... args) {
		validateRequiredConfiguration()

		List values = args == null ? [] : args.toList()

		String projectKey = defaultProjectKey()
		String summary = ''
		String epicFieldId = defaultEpicFieldId()
		String epicKey = ''
		List labels = defaultLabels()
		String description = ''

		if (values.size() == 2) {
			summary = safe(values[0])
			epicKey = safe(values[1])
		} else if (values.size() == 3) {
			projectKey = safe(values[0])
			summary = safe(values[1])
			epicKey = safe(values[2])
		} else if (values.size() == 4) {
			projectKey = safe(values[0])
			summary = safe(values[1])
			epicFieldId = safe(values[2])
			epicKey = safe(values[3])
		} else if (values.size() == 5) {
			projectKey = safe(values[0])
			summary = safe(values[1])
			epicFieldId = safe(values[2])
			epicKey = safe(values[3])
			labels = normalizeLabels(values[4])
		} else if (values.size() >= 6) {
			projectKey = safe(values[0])
			summary = safe(values[1])
			epicFieldId = safe(values[2])
			epicKey = safe(values[3])
			labels = normalizeLabels(values[4])
			description = safe(values[5])
		} else {
			throw new IllegalArgumentException('Unsupported createTestPlan signature. Received args size = ' + values.size())
		}

		return createTestPlanInternal(projectKey, summary, epicFieldId, epicKey, labels, description)
	}

	Map importExecutionResults(File junitXmlFile, String projectKey, String testPlanKey) {
		validateRequiredConfiguration()

		if (junitXmlFile == null || !junitXmlFile.exists()) {
			throw new IllegalArgumentException('JUnit XML file was not found.')
		}

		String path = buildJUnitImportPath(projectKey, testPlanKey)
		return doMultipartFile(path, 'file', junitXmlFile, 'application/json')
	}

	Map addExecutionToTestPlan(String testPlanKey, String testExecutionKey) {
		validateRequiredConfiguration()

		String path = '/rest/raven/1.0/api/testplan/' + encoded(testPlanKey) + '/testexecution'
		return doPostJson(path, [safe(testExecutionKey)])
	}

	Map uploadAttachment(String issueKey, File attachmentFile) {
		validateRequiredConfiguration()

		if (attachmentFile == null || !attachmentFile.exists()) {
			throw new IllegalArgumentException('Attachment file was not found.')
		}

		String path = '/rest/api/2/issue/' + encoded(issueKey) + '/attachments'
		return doMultipartFile(
			path,
			'file',
			attachmentFile,
			'application/json',
			['X-Atlassian-Token': 'no-check']
		)
	}

	// =========================================================================
	// TEST PLAN CREATION
	// =========================================================================

	private Map createTestPlanInternal(String projectKey,
									   String summary,
									   String epicFieldId,
									   String epicKey,
									   List labels,
									   String description) {
		Map fields = [
			project  : [key: safe(projectKey)],
			summary  : safe(summary),
			issuetype: [name: 'Test Plan']
		]

		List safeLabels = normalizeLabels(labels)
		if (!safeLabels.isEmpty()) {
			fields.labels = safeLabels
		}

		if (!blank(description)) {
			fields.description = safe(description)
		}

		if (!blank(epicFieldId) && !blank(epicKey)) {
			fields[epicFieldId] = safe(epicKey)
		}

		return doPostJson('/rest/api/2/issue', [fields: fields])
	}

	// =========================================================================
	// HTTP HELPERS
	// =========================================================================

	private Map doGet(String path) {
		return executeRequest('GET', path, null, null, 'application/json', [:])
	}

	private Map doPostJson(String path, Object payload) {
		byte[] body = JsonOutput.toJson(payload).getBytes(StandardCharsets.UTF_8)
		return executeRequest('POST', path, body, 'application/json; charset=UTF-8', 'application/json', [:])
	}

	private Map doMultipartFile(String path, String fieldName, File file, String accept) {
		return doMultipartFile(path, fieldName, file, accept, [:])
	}

	private Map doMultipartFile(String path, String fieldName, File file, String accept, Map extraHeaders) {
		String boundary = '----OpenAIBoundary' + UUID.randomUUID().toString().replace('-', '')
		ByteArrayOutputStream output = new ByteArrayOutputStream()

		output.write(("--${boundary}\r\n").getBytes(StandardCharsets.UTF_8))
		output.write(("Content-Disposition: form-data; name=\"${safe(fieldName)}\"; filename=\"${file.name}\"\r\n").getBytes(StandardCharsets.UTF_8))
		output.write(("Content-Type: application/octet-stream\r\n\r\n").getBytes(StandardCharsets.UTF_8))
		output.write(file.bytes)
		output.write("\r\n".getBytes(StandardCharsets.UTF_8))
		output.write(("--${boundary}--\r\n").getBytes(StandardCharsets.UTF_8))

		return executeRequest(
			'POST',
			path,
			output.toByteArray(),
			"multipart/form-data; boundary=${boundary}",
			accept,
			extraHeaders ?: [:]
		)
	}

	private Map executeRequest(String method,
							   String path,
							   byte[] body,
							   String contentType,
							   String accept,
							   Map extraHeaders) {
		configureSslIfNeeded()

		HttpURLConnection connection = null
		int status = -1
		String responseBody = ''

		try {
			URL url = new URL(jiraBaseUrl + path)
			connection = (HttpURLConnection) url.openConnection()

			connection.setRequestMethod(method)
			connection.setConnectTimeout(60000)
			connection.setReadTimeout(60000)
			connection.setUseCaches(false)
			connection.setDoInput(true)
			connection.setRequestProperty('Authorization', authHeader)
			connection.setRequestProperty('Accept', blank(accept) ? '*/*' : accept)
			connection.setRequestProperty('User-Agent', 'Katalon-Jira-Integration')

			extraHeaders?.each { String key, Object value ->
				if (!blank(key) && value != null) {
					connection.setRequestProperty(key, String.valueOf(value))
				}
			}

			if (body != null) {
				connection.setDoOutput(true)

				if (!blank(contentType)) {
					connection.setRequestProperty('Content-Type', contentType)
				}

				connection.outputStream.withCloseable { stream ->
					stream.write(body)
					stream.flush()
				}
			}

			status = connection.responseCode

			InputStream responseStream = status >= 400 ? connection.getErrorStream() : connection.getInputStream()
			if (responseStream != null) {
				responseBody = responseStream.getText('UTF-8')
			}

			return [
				status     : status,
				body       : safeRaw(responseBody),
				json       : parseJsonSilently(responseBody),
				contentType: safe(connection?.getHeaderField('Content-Type'))
			]
		} finally {
			try {
				connection?.disconnect()
			} catch (Exception ignored) {
			}
		}
	}

	// =========================================================================
	// CONFIGURATION
	// =========================================================================

	private void loadConfiguration() {
		jiraBaseUrl = normalizeBaseUrl(firstNonBlank(
			readOwnerText('JIRA_BASE_URL'),
			readOwnerText('jiraBaseUrl'),
			readOwnerText('baseUrl')
		))

		String explicitAuthHeader = firstNonBlank(
			readOwnerText('AUTH_HEADER'),
			readOwnerText('authHeader')
		)

		String token = firstNonBlank(
			readOwnerText('JIRA_TOKEN'),
			readOwnerText('jiraToken'),
			readOwnerText('token')
		)

		String username = firstNonBlank(
			readOwnerText('JIRA_USERNAME'),
			readOwnerText('jiraUsername'),
			readOwnerText('username')
		)

		String password = firstNonBlank(
			readOwnerText('JIRA_PASSWORD'),
			readOwnerText('jiraPassword'),
			readOwnerText('password')
		)

		if (!blank(explicitAuthHeader)) {
			authHeader = explicitAuthHeader
		} else if (!blank(token)) {
			authHeader = 'Bearer ' + token.trim()
		} else if (!blank(username) || !blank(password)) {
			String raw = safe(username) + ':' + safe(password)
			authHeader = 'Basic ' + raw.bytes.encodeBase64().toString()
		}

		ignoreSslCertificates = readOwnerBoolean([
			'IGNORE_SSL_CERTIFICATES',
			'ignoreSslCertificates',
			'DISABLE_SSL_VALIDATION',
			'disableSslValidation',
			'ACCEPT_INSECURE_CERTIFICATES'
		], true)
	}

	private void configureSslIfNeeded() {
		if (!ignoreSslCertificates) {
			return
		}

		TrustManager[] trustAllCerts = [
			[
				getAcceptedIssuers: { -> [] as X509Certificate[] },
				checkClientTrusted: { X509Certificate[] chain, String authType -> },
				checkServerTrusted: { X509Certificate[] chain, String authType -> }
			] as X509TrustManager
		] as TrustManager[]

		SSLContext sslContext = SSLContext.getInstance('TLS')
		sslContext.init(null, trustAllCerts, new SecureRandom())

		HttpsURLConnection.setDefaultSSLSocketFactory(sslContext.socketFactory)
		HttpsURLConnection.setDefaultHostnameVerifier({ String hostname, SSLSession session -> true } as HostnameVerifier)
	}

	// =========================================================================
	// VALUE HELPERS
	// =========================================================================

	private String buildJUnitImportPath(String projectKey, String testPlanKey) {
		List<String> params = []

		if (!blank(projectKey)) {
			params << 'projectKey=' + encoded(projectKey)
		}

		if (!blank(testPlanKey)) {
			params << 'testPlanKey=' + encoded(testPlanKey)
		}

		return '/rest/raven/1.0/import/execution/junit' + (params.isEmpty() ? '' : '?' + params.join('&'))
	}

	private Object parseJsonSilently(String body) {
		String text = safeRaw(body)
		if (blank(text)) {
			return null
		}

		String trimmed = text.trim()
		if (!(trimmed.startsWith('{') || trimmed.startsWith('['))) {
			return null
		}

		try {
			return new JsonSlurper().parseText(trimmed)
		} catch (Exception ignored) {
			return null
		}
	}

	private String defaultProjectKey() {
		return firstNonBlank(
			readOwnerText('PROJECT_KEY'),
			readOwnerText('DEFAULT_PROJECT_KEY'),
			readOwnerText('JIRA_PROJECT_KEY')
		)
	}

	private String defaultEpicFieldId() {
		return firstNonBlank(
			readOwnerText('EPIC_FIELD_ID'),
			'customfield_10008'
		)
	}

	private List defaultLabels() {
		return normalizeLabels(readOwnerText('LABELS'))
	}

	private List normalizeLabels(def raw) {
		if (raw == null) {
			return []
		}

		if (raw instanceof Collection) {
			return raw.findAll { !blank(it) }.collect { safe(it) }
		}

		String value = safe(raw)
		if (value.isEmpty()) {
			return []
		}

		return value
			.split(',')
			collect { safe(it) }
			.findAll { !it.isEmpty() }
	}

	private String readOwnerText(String propertyName) {
		if (owner == null || blank(propertyName)) {
			return ''
		}

		try {
			def property = owner.metaClass?.hasProperty(owner, propertyName)
			if (property == null) {
				return ''
			}
			return safe(owner."${propertyName}")
		} catch (Exception ignored) {
			return ''
		}
	}

	private boolean readOwnerBoolean(List<String> propertyNames, boolean defaultValue) {
		for (String propertyName : propertyNames) {
			String value = readOwnerText(propertyName)
			if (!blank(value)) {
				return toBoolean(value)
			}
		}
		return defaultValue
	}

	private String normalizeBaseUrl(String raw) {
		String value = safe(raw)
		while (value.endsWith('/')) {
			value = value.substring(0, value.length() - 1)
		}
		return value
	}

	private String escapeJql(String raw) {
		return safe(raw)
			.replace('\\', '\\\\')
			.replace('"', '\\"')
	}

	private String encoded(String raw) {
		return URLEncoder.encode(safe(raw), 'UTF-8').replace('+', '%20')
	}

	private boolean toBoolean(def value) {
		String text = safe(value).toLowerCase()
		return text == 'true' || text == '1' || text == 'yes'
	}

	private boolean blank(def value) {
		return safe(value).isEmpty()
	}

	private String safe(def value) {
		return value == null ? '' : String.valueOf(value).trim()
	}

	private String safeRaw(def value) {
		return value == null ? '' : String.valueOf(value)
	}

	private String firstNonBlank(Object... values) {
		if (values == null) {
			return ''
		}

		for (Object value : values) {
			String text = safe(value)
			if (!text.isEmpty()) {
				return text
			}
		}

		return ''
	}
}
