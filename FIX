// ======================================================
// CREATE FAVORITE FROM CURRENT MODULE
// ======================================================

@Keyword
void createFavoriteFromCurrentModule(
	String favoriteTitle,
	Integer controlTimeoutSeconds,
	Integer popupTimeoutSeconds
) {

	Integer controlTimeout =
		safeTimeout(controlTimeoutSeconds, 5)

	Integer popupTimeout =
		safeTimeout(popupTimeoutSeconds, 5)

	logStep(
		'CREATE FAVORITE',
		'Favorite title: ' + favoriteTitle
	)

	WindowsTestObject createFavoriteButton =
		object('createFavoriteTopBar')

	if (!Windows.waitForElementPresent(
		createFavoriteButton,
		controlTimeout,
		FailureHandling.OPTIONAL
	)) {
		takeEvidence(
			'GUI_CreateFavoriteButtonNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Create Favorite button was not found.'
		)

		return
	}

	KeywordUtil.logInfo(
		'[OBJECT] Clicking Create Favorite button.'
	)

	Windows.click(
		createFavoriteButton,
		FailureHandling.STOP_ON_FAILURE
	)

	Windows.delay(1)

	WindowsTestObject favoriteTitleInput =
		object('favoriteTitleInput')

	if (!Windows.waitForElementPresent(
		favoriteTitleInput,
		controlTimeout,
		FailureHandling.OPTIONAL
	)) {
		takeEvidence(
			'GUI_FavoriteTitleInputNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorite title input was not found.'
		)

		return
	}

	KeywordUtil.logInfo(
		'[OBJECT] Favorite title input found.\n' +
		'Value: ' + favoriteTitle
	)

	Windows.click(
		favoriteTitleInput,
		FailureHandling.STOP_ON_FAILURE
	)

	Windows.delay(1)

	pasteTextIntoFocusedField(
		favoriteTitle
	)

	Windows.delay(1)

	WindowsTestObject saveFavoriteButton =
		object('favoriteSaveTopBar')

	if (!Windows.waitForElementPresent(
		saveFavoriteButton,
		controlTimeout,
		FailureHandling.OPTIONAL
	)) {
		takeEvidence(
			'GUI_SaveFavoriteButtonNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Save Favorite button was not found.'
		)

		return
	}

	String saveEnabled = safeText(
		Windows.getAttribute(
			saveFavoriteButton,
			'IsEnabled',
			FailureHandling.OPTIONAL
		)
	)

	if (!saveEnabled.equalsIgnoreCase('True')) {
		takeEvidence(
			'GUI_SaveFavoriteButtonDisabled.png'
		)

		KeywordUtil.markFailedAndStop(
			'Save Favorite button is disabled after filling the title.'
		)

		return
	}

	KeywordUtil.logInfo(
		'[OBJECT] Clicking Save Favorite button.'
	)

	Windows.click(
		saveFavoriteButton,
		FailureHandling.STOP_ON_FAILURE
	)

	KeywordUtil.logInfo(
		'[IMAGE] Waiting for favorite confirmation modal.\n' +
		'First attempt: General.iconeModal\n' +
		'Fallback: General.iconeModalPRD'
	)

	boolean modalFound =
		imageLoader.waitForImage(
			GENERAL_IMAGE_GROUP,
			'iconeModal',
			popupTimeout
		)

	String modalKey = 'iconeModal'

	if (!modalFound) {
		modalFound =
			imageLoader.waitForImage(
				GENERAL_IMAGE_GROUP,
				'iconeModalPRD',
				popupTimeout
			)

		modalKey = 'iconeModalPRD'
	}

	if (!modalFound) {
		takeEvidence(
			'GUI_FavoriteConfirmationModalNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorite confirmation modal was not found.\n' +
			'Images tried:\n' +
			'- General.iconeModal\n' +
			'- General.iconeModalPRD'
		)

		return
	}

	KeywordUtil.logInfo(
		'[PASS] Favorite confirmation modal found.\n' +
		'Image: General.' + modalKey
	)

	takeEvidence(
		'GUI_FavoriteConfirmationModal.png'
	)

	pressKeyboardKey(
		KeyEvent.VK_ENTER
	)

	Windows.delay(2)

	KeywordUtil.markPassed(
		'Favorite created successfully.\n' +
		'Title: ' + favoriteTitle
	)
}


// ======================================================
// CLOSE ALL TABS AND OPEN FAVORITE
// ======================================================

@Keyword
void closeAllTabsAndOpenFavorite(
	String favoriteTitle,
	Integer timeoutSeconds
) {

	Integer timeout =
		safeTimeout(timeoutSeconds, 5)

	logStep(
		'OPEN FAVORITE',
		'Favorite title: ' + favoriteTitle
	)

	WindowsTestObject closeAllTabsButton =
		object('closeAllTabsTopBar')

	if (!Windows.waitForElementPresent(
		closeAllTabsButton,
		timeout,
		FailureHandling.OPTIONAL
	)) {
		takeEvidence(
			'GUI_CloseAllTabsButtonNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Close All Tabs button was not found.'
		)

		return
	}

	KeywordUtil.logInfo(
		'[OBJECT] Clicking Close All Tabs.'
	)

	Windows.click(
		closeAllTabsButton,
		FailureHandling.STOP_ON_FAILURE
	)

	Windows.delay(1)

	pressKeyboardKey(
		KeyEvent.VK_ENTER
	)

	Windows.delay(2)

	KeywordUtil.logInfo(
		'[IMAGE] Opening Favorites tab.'
	)

	clickImage(
		GUI_IMAGE_GROUP,
		'favoritesTab',
		3
	)

	WindowsTestObject favoriteItem =
		WindowsObjectLoader.getWindowByName(
			favoriteTitle
		)

	KeywordUtil.logInfo(
		'[OBJECT] Waiting for created favorite.\n' +
		'Name: ' + favoriteTitle + '\n' +
		'Timeout: ' + timeout + ' seconds'
	)

	if (!Windows.waitForElementPresent(
		favoriteItem,
		timeout,
		FailureHandling.OPTIONAL
	)) {
		takeEvidence(
			'GUI_CreatedFavoriteNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Created favorite was not found.\n' +
			'Favorite: ' + favoriteTitle
		)

		return
	}

	Windows.click(
		favoriteItem,
		FailureHandling.STOP_ON_FAILURE
	)

	Windows.delay(3)

	takeEvidence(
		'GUI_CreatedFavoriteOpened.png'
	)

	KeywordUtil.markPassed(
		'Created favorite was selected successfully.\n' +
		'Favorite: ' + favoriteTitle
	)
}

