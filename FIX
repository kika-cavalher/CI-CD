	@Keyword
	void openEnvironmentDropdown() {
		KeywordUtil.logInfo("Opening environment dropdown")

		focusLoginWindow(detectedWindowTitle)
		sleepMs(700)

		// 1) Try exact dropdown image first
		if (clickFirstAvailableImage(dropdownEnvironmentImageCandidates(), 4, 1200L, "Opening environment dropdown by image")) {
			sleepMs(1200)
			return
		}

		// 2) Try dropdown arrow object
		WindowsTestObject arrowObj = comboArrowObj()
		if (waitPresent(arrowObj, 5)) {
			KeywordUtil.logInfo("Opening environment dropdown by arrow object")
			Windows.click(arrowObj)
			sleepMs(1200)
			return
		}

		// 3) Try combo object itself
		WindowsTestObject comboObj = envComboObj()
		if (waitPresent(comboObj, 5)) {
			KeywordUtil.logInfo("Opening environment dropdown by combo object")
			Windows.click(comboObj)
			sleepMs(500)
			Windows.sendKeys(comboObj, Keys.chord(Keys.ALT, Keys.ARROW_DOWN))
			sleepMs(1200)
			return
		}

		// 4) Last fallback
		KeywordUtil.logInfo("Opening environment dropdown by keyboard fallback")
		robotCombo(KeyEvent.VK_ALT, KeyEvent.VK_DOWN)
		sleepMs(1200)
	}

	@Keyword
	int resolveEnvironmentIndex(String env) {
		String normalized = normalizeEnvCode(env)

		Map<String, Integer> indexes = [
			'PROD' : 1,
			'PREPO': 2,
			'REC2' : 3,
			'REC'  : 4,
			'DEV2' : 5,
			'DEV'  : 6
		]

		return indexes.containsKey(normalized) ? indexes[normalized] : 4
	}

	@Keyword
	void selectEnvironment(String env) {
		String displayValue = resolveEnvironmentDisplayValue(env)
		int legacyIndex = resolveEnvironmentIndex(env)

		KeywordUtil.logInfo("Selecting environment ${displayValue}")

		focusLoginWindow(detectedWindowTitle)
		sleepMs(700)

		// IMPORTANT: open dropdown first
		openEnvironmentDropdown()
		sleepMs(1200)

		// 1) Best path: click the environment image after dropdown is open
		if (clickFirstAvailableImage(environmentImageCandidates(env), 4, 1000L, "Selecting environment ${displayValue} by image")) {
			sleepMs(1200)
			return
		}

		// 2) Object path
		WindowsTestObject itemObj = comboListItemObj(displayValue)
		if (waitPresent(itemObj, 4)) {
			KeywordUtil.logInfo("Selecting environment by list item object ${displayValue}")
			Windows.click(itemObj)
			sleepMs(1200)
			return
		}

		// 3) Legacy combo fallback
		WindowsTestObject comboObj = envComboObj()
		if (waitPresent(comboObj, 4)) {
			KeywordUtil.logInfo("Selecting environment with combo keyboard fallback, index ${legacyIndex}")
			Windows.click(comboObj)
			sleepMs(500)

			for (int i = 0; i < legacyIndex; i++) {
				Windows.sendKeys(comboObj, Keys.chord(Keys.ARROW_DOWN))
				sleepMs(300)
			}

			Windows.sendKeys(comboObj, Keys.chord(Keys.ENTER))
			sleepMs(1200)
			return
		}

		// 4) Final fallback with Robot
		KeywordUtil.logInfo("Selecting environment with Robot fallback, index ${legacyIndex}")
		for (int i = 0; i < legacyIndex; i++) {
			robotKey(KeyEvent.VK_DOWN)
			sleepMs(300)
		}
		robotKey(KeyEvent.VK_ENTER)
		sleepMs(1200)
	}

	@Keyword
	boolean isConnectButtonPresent() {
		if (waitPresent(connectBtnObj(), 3)) {
			return true
		}

		String connectImage = firstExistingImage(connectImageCandidates())
		return connectImage != ''
	}

	@Keyword
	void clickConnectButton() {
		KeywordUtil.logInfo("Clicking connect button")

		focusLoginWindow(detectedWindowTitle)
		sleepMs(500)

		// 1) Try object first
		WindowsTestObject btn = connectBtnObj()
		if (waitPresent(btn, 5)) {
			try {
				Windows.click(btn)
				sleepMs(1500)
				return
			} catch (Throwable ignored) {
			}
		}

		// 2) Try image
		if (clickFirstAvailableImage(connectImageCandidates(), 4, 1000L, "Clicking connect button by image")) {
			sleepMs(1500)
			return
		}

		// 3) Last fallback
		KeywordUtil.logInfo("Connect button not clicked by object/image. Trying ENTER fallback.")
		robotKey(KeyEvent.VK_ENTER)
		sleepMs(1500)
	}

	@Keyword
	boolean waitForMainScreen() {
		KeywordUtil.logInfo("Waiting for main eMatch screen")

		if (waitForHomeGrey(60)) {
			return true
		}

		long end = System.currentTimeMillis() + 30000L

		while (System.currentTimeMillis() < end) {
			if (waitPresent(mainSearchObj(), 2)) {
				return true
			}

			if (waitPresent(homeTabObj(), 2)) {
				return true
			}

			sleepMs(1000)
		}

		return false
	}

	@Keyword
	void activateHomeTab() {
		try {
			if (clickFirstAvailableImage(homeGreyImageCandidates(), 2, 800L, "Activating Home tab by image")) {
				sleepMs(800)
				return
			}
		} catch (Throwable ignored) {
		}

		try {
			WindowsTestObject homeTab = homeTabObj()
			if (waitPresent(homeTab, 5)) {
				Windows.click(homeTab)
				sleepMs(800)
				return
			}
		} catch (Throwable ignored) {
		}

		try {
			String home = new File(RunConfiguration.getProjectDir(), 'Images/General/Home.PNG').getAbsolutePath()
			if (new File(home).exists()) {
				WindowsImageKeywords.clickImage(home)
				sleepMs(1000)
			}
		} catch (Throwable ignored) {
		}
	}

	@Keyword
	void loginThroughNativeControls() {
		loginThroughNativeControls(safe(GlobalVariable.env) ?: 'REC')
	}

	@Keyword
	void loginThroughNativeControls(String env) {
		String resolvedEnv = safe(env) ?: safe(GlobalVariable.env) ?: 'REC'

		KeywordUtil.logInfo("Logging through native controls for env ${resolvedEnv}")

		focusLoginWindow(detectedWindowTitle)
		sleepMs(700)

		selectEnvironment(resolvedEnv)
		sleepMs(1200)

		clickConnectButton()
		sleepMs(1500)

		boolean mainScreenLoaded = waitForMainScreen()

		if (!mainScreenLoaded) {
			KeywordUtil.markFailedAndStop("eMatch main screen was not loaded. HomeGrey / txtSearch not found.")
		}

		activateHomeTab()
		KeywordUtil.logInfo("eMatch startup flow completed successfully for environment ${resolvedEnv}")
	}







