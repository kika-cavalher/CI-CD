		if (!Windows.waitForElementPresent(
			tabObject,
			timeout,
			FailureHandling.OPTIONAL
		)) {
			takeEvidence(
				'Synthese_Justification_Latent_TabNotOpened.png'
			)

			KeywordUtil.markFailedAndStop(
				'Synthèse tab was not opened.\n' +
					'Expected tab: ' +
					tabName
			)

			return
		}

		takeEvidence(
			'Synthese_Justification_Latent_Opened.png'
		)

		KeywordUtil.logInfo(
			'[PASS] Synthèse tab opened successfully.\n' +
				'Opened tab: ' +
				tabName
		)
	}


	@Keyword
	void applySyntheseSectionDifferentFilter(
			String filterValue,
			Integer timeoutSeconds
		) {

		Integer timeout =
			safeTimeout(timeoutSeconds)

		String value =
			safeText(filterValue)

		if (value.isEmpty()) {
			KeywordUtil.markFailedAndStop(
				'Synthèse Section filter value cannot be empty.'
			)

			return
		}

		// Reuse the existing Section filter flow that already works
		// for Investigations and applies Section = requested value.
		applySectionFilter(
