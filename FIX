import org.apache.poi.ss.usermodel.WorkbookFactory
import org.apache.poi.xssf.usermodel.XSSFSheet
import org.apache.poi.xssf.usermodel.XSSFWorkbook

import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil

import internal.GlobalVariable

int index = 21; //21 = JV calculé
BigDecimal sum1, min1, max1, sum2, min2, max2;
String errors = '';
String msg = '';
def rows = GlobalVariable.compareRows as ArrayList;
def files = GlobalVariable.compareFiles as ArrayList;
String evPath = RunConfiguration.getReportFolder() + '\\Evidences\\';

if (rows.size() > 0) {
	if (rows.get(0) != rows.get(1)) errors+= '\n[ERROR] Number of rows (' + rows.get(0) + ') and (' + rows.get(1) + ') are different between the envs in Validations.';
	else msg += '\nNumber of rows (' + rows.get(0) + ') and (' + rows.get(1) + ') are equal between the envs in Validations.';
} else {
	//Getting files path
	String file1 = evPath + files.get(0);
	String file2 = evPath + files.get(1);
	
	//Reading excel files for comparison
	input1 = new FileInputStream(file1);
	input2 = new FileInputStream(file2);
	wbEnv1 = WorkbookFactory.create(input1);
	wbEnv2 = WorkbookFactory.create(input2);
	sheetEnv1 = wbEnv1.getSheetAt(0);
	sheetEnv2 = wbEnv2.getSheetAt(0);
	int linesEnv1 = sheetEnv1.getLastRowNum();
	int linesEnv2 = sheetEnv2.getLastRowNum();
	String col = sheetEnv1.getRow(0).getCell(index);
	
	//Number of Lines
	if (linesEnv1 != linesEnv2) errors += '\n[ERROR] Number of rows (' + linesEnv1 + ') of file ' + files.get(0) + ' is different than (' + linesEnv2 + ') of file ' + files.get(1) + '.';
	else msg += '\nNumber of rows (' + linesEnv1 + ') of file ' + files.get(0) + ' is equal to (' + linesEnv2 + ') of file ' + files.get(1) + '.';
	
	//Sum Validation
	sum1 = CustomKeywords.'com.katalon.keywords.excelHandling.ExcelValidations.totalSum'(sheetEnv1, index);
	sum2 = CustomKeywords.'com.katalon.keywords.excelHandling.ExcelValidations.totalSum'(sheetEnv2, index);
	sum1 = sum1.setScale(2, BigDecimal.ROUND_HALF_EVEN);
	sum2 = sum2.setScale(2, BigDecimal.ROUND_HALF_EVEN);
	
	if (sum1 != sum2) errors += '\n[ERROR] The sum of the amounts of REC (' + sum1 + ') and PROD (' + sum2 + ') are different.';
	else msg += '\nThe sum of the amounts of column ' + col + ' in ' + GlobalVariable.env + ' (' + sum1 + ') and PROD (' + sum2 + ') are equal.';
	
	//Min Validation
	min1 = CustomKeywords.'com.katalon.keywords.excelHandling.ExcelValidations.minAmount'(sheetEnv1, index);
	min2 = CustomKeywords.'com.katalon.keywords.excelHandling.ExcelValidations.minAmount'(sheetEnv2, index);
	min1 = min1.setScale(2,BigDecimal.ROUND_HALF_EVEN);
	min2= min2.setScale(2,BigDecimal.ROUND_HALF_EVEN);
	
	if (min1 != min2) errors += '\n[ERROR] The minimun amount of column ' + col + ' in ' + GlobalVariable.env + ' (' + min1 + ') and PROD (' + min2 + ') are different.';
	else msg += '\nThe minimun amount of column ' + col + ' in ' + GlobalVariable.env + ' (' + min1 + ') and PROD (' + min2 + ') are equal.';
	
	//Max Validation
	max1 = CustomKeywords.'com.katalon.keywords.excelHandling.ExcelValidations.maxAmount'(sheetEnv1, index);
	max2 = CustomKeywords.'com.katalon.keywords.excelHandling.ExcelValidations.maxAmount'(sheetEnv2, index);
	max1 = max1.setScale(2,BigDecimal.ROUND_HALF_EVEN);
	max2 = max2.setScale(2,BigDecimal.ROUND_HALF_EVEN);
	
	if (max1 != max2) errors += '\n[ERROR] The maximum amount of column ' + col + ' in ' + GlobalVariable.env + ' (' + max1 + ') and PROD (' + max2 + ') are different.';
	else msg += '\nThe maximum amount of the amount of column ' + col + ' in ' + GlobalVariable.env + ' (' + max1 + ') and PROD (' + max2 + ') are equal.';
}

//Fails if any validation didn't pass
if (errors.length() > 1)
	KeywordUtil.markFailed(errors + msg);
else
	KeywordUtil.markPassed('\n[SUCCESS] The between ' + GlobalVariable.env + ' and PROD of Validations finished successfully!\n' + msg);









