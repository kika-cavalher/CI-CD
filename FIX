/*
 * Responsibility:
 * This file is responsible for:
 * 1) Running one Katalon suite
 * 2) Streaming useful live output to the Jenkins console
 * 3) Writing a clean metadata file for the suite
 * 4) Creating a synthetic JUnit when Katalon fails without generating one
 */

def safeFileName(String value) {
	return (value ?: '').replaceAll(/[^A-Za-z0-9._ -]/, '').replace(' ', '_')
}

def runSuite(script, Map cfg, Map suite) {
	/*
	 * Responsibility:
	 * Execute one suite and return the process exit code.
	 */

	def suiteKey = safeFileName(suite.name)

	return script.withEnv([
		"KATALON_EXE=${cfg.katalonExe}",
		"PROJECT_PATH=${cfg.projectPath}",
		"REPORTS_ROOT=${cfg.reportsRoot}",
		"SUITE_NAME=${suite.name}",
		"SUITE_PATH=${suite.path}",
		"SUITE_KEY=${suiteKey}",
		"BROWSER=${cfg.browser}",
		"SUITE_TIMEOUT_MINUTES=${cfg.suiteTimeoutMinutes.toString()}"
	]) {
		script.powershell(
			returnStatus: true,
			script: '''
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

$script:LastProgressLine = ''
$script:CurrentScenario = ''
$script:LastStepLine = ''
$script:RecentStepLines = New-Object System.Collections.ArrayList
$script:ExecutionRecordBuffer = New-Object System.Collections.ArrayList
$script:IsInsideRecord = $false

function Clean-Text {
    param([string]$Value)

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return ''
    }

    $text = $Value -replace '[\\r\\n]+', ' '
    $text = $text -replace '\\s+', ' '
    return $text.Trim()
}

function Short-Text {
    param(
        [string]$Value,
        [int]$Max = 180
    )

    $text = Clean-Text $Value

    if ($text.Length -gt $Max) {
        return $text.Substring(0, $Max - 3) + '...'
    }

    return $text
}

function Normalize-Path {
    param([string]$Path)

    if ([string]::IsNullOrWhiteSpace($Path)) {
        return ''
    }

    return $Path.Replace('\\', '/').ToLowerInvariant()
}

function Is-IgnoredReportPath {
    param([string]$Path)

    $normalized = Normalize-Path $Path

    return (
        $normalized -like '*/logs' -or
        $normalized -like '*/logs/*' -or
        $normalized -like '*/self-healing' -or
        $normalized -like '*/self-healing/*'
    )
}

function To-RelativePath {
    param(
        [string]$Root,
        [string]$FullPath
    )

    if ([string]::IsNullOrWhiteSpace($FullPath)) {
        return ''
    }

    $normalizedRoot = Normalize-Path $Root
    $normalizedFull = Normalize-Path $FullPath

    if (-not $normalizedFull.StartsWith($normalizedRoot)) {
        return ''
    }

    $rel = $FullPath.Substring($Root.Length)

    if ($rel.StartsWith('\\')) {
        $rel = $rel.Substring(1)
    }

    return $rel.Replace('\\', '/')
}

function Add-RecentStepLine {
    param([string]$Text)

    if ([string]::IsNullOrWhiteSpace($Text)) {
        return
    }

    [void]$script:RecentStepLines.Add($Text)

    while ($script:RecentStepLines.Count -gt 10) {
        $script:RecentStepLines.RemoveAt(0)
    }
}

function Stop-ProcessTree {
    param([int]$ProcessId)

    $children = Get-CimInstance Win32_Process -Filter "ParentProcessId=$ProcessId" -ErrorAction SilentlyContinue
    foreach ($child in $children) {
        Stop-ProcessTree -ProcessId $child.ProcessId
    }

    Stop-Process -Id $ProcessId -Force -ErrorAction SilentlyContinue
}

function Read-NewContent {
    param(
        [string]$Path,
        [ref]$Offset
    )

    if (-not (Test-Path -LiteralPath $Path)) {
        return @()
    }

    $fs = $null
    $sr = $null

    try {
        $fs = [System.IO.File]::Open($Path, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, [System.IO.FileShare]::ReadWrite)
        [void]$fs.Seek($Offset.Value, [System.IO.SeekOrigin]::Begin)
        $sr = New-Object System.IO.StreamReader($fs)
        $content = $sr.ReadToEnd()
        $Offset.Value = $fs.Position

        if ([string]::IsNullOrWhiteSpace($content)) {
            return @()
        }

        return @($content -split "`r?`n")
    }
    catch {
        return @()
    }
    finally {
        if ($sr) { $sr.Close() }
        if ($fs) { $fs.Close() }
    }
}

function Should-SkipKatalonLine {
    param([string]$Text)

    $noise = @(
        'CPU load',
        'Total memory',
        'Free memory',
        'Start getting machine ID',
        'Start appending additional signatures',
        'Search for valid offline licenses',
        'Start checking license',
        'Invalid package binding for default import',
        'ENTRY org.eclipse.jdt.core',
        'MESSAGE Invalid package binding',
        'The number of Runtime Engine running sessions',
        'Cleaning up workspace'
    )

    foreach ($item in $noise) {
        if ($Text -like "*$item*") {
            return $true
        }
    }

    return $false
}

function Emit-KatalonConsoleLine {
    param(
        [string]$Line,
        [string]$Prefix
    )

    $text = Clean-Text $Line

    if ([string]::IsNullOrWhiteSpace($text)) {
        return
    }

    if (Should-SkipKatalonLine -Text $text) {
        return
    }

    if ($text -match 'Test Suites/.+\\.\\.\\.[0-9]+/[0-9]+\\([0-9]+%\\)') {
        if ($script:LastProgressLine -ne $text) {
            Write-Host ($Prefix + $text)
            $script:LastProgressLine = $text
        }
        return
    }

    if (
        $text -match 'START Test Suites' -or
        $text -match 'START Test Cases' -or
        $text -match 'START SCENARIO' -or
        $text -match 'ChromeDriver' -or
        $text -match 'chromedriver' -or
        $text -match 'sessionId' -or
        $text -match 'Navigate' -or
        $text -match 'Click' -or
        $text -match 'Import' -or
        $text -match 'Save' -or
        $text -match 'not found' -or
        $text -match 'selector is null' -or
        $text -match 'FAILED' -or
        $text -match 'ERROR' -or
        $text -match 'Exception' -or
        $text -match 'Warning'
    ) {
        Write-Host ($Prefix + $text)
    }
}

function Get-XmlTagValue {
    param(
        [string]$Text,
        [string]$Tag
    )

    $options = [System.Text.RegularExpressions.RegexOptions]::Singleline -bor [System.Text.RegularExpressions.RegexOptions]::IgnoreCase
    $pattern = '<' + [regex]::Escape($Tag) + '>(.*?)</' + [regex]::Escape($Tag) + '>'
    $match = [regex]::Match($Text, $pattern, $options)

    if ($match.Success) {
        return $match.Groups[1].Value
    }

    return ''
}

function Get-XmlPropertyValue {
    param(
        [string]$Text,
        [string]$Name
    )

    $options = [System.Text.RegularExpressions.RegexOptions]::Singleline -bor [System.Text.RegularExpressions.RegexOptions]::IgnoreCase
    $pattern = '<property name="' + [regex]::Escape($Name) + '">(.*?)</property>'
    $match = [regex]::Match($Text, $pattern, $options)

    if ($match.Success) {
        return $match.Groups[1].Value
    }

    return ''
}

function Emit-HumanExecutionRecord {
    param([string]$RecordText)

    $level = (Get-XmlTagValue -Text $RecordText -Tag 'level').ToUpperInvariant()
    $message = Get-XmlTagValue -Text $RecordText -Tag 'message'
    $stepIndex = Get-XmlPropertyValue -Text $RecordText -Name 'stepIndex'

    if ([string]::IsNullOrWhiteSpace($message)) {
        return
    }

    $message = [System.Net.WebUtility]::HtmlDecode($message)
    $message = $message -replace '<[^>]+>', ''
    $message = Short-Text $message 180

    if ([string]::IsNullOrWhiteSpace($message)) {
        return
    }

    if ($message -match '^Start scenario\\s*:\\s*(.+)$') {
        $script:CurrentScenario = Short-Text $Matches[1] 150
        Write-Host ("[STEP] 🎬 SCENARIO | " + $script:CurrentScenario)
        Add-RecentStepLine ("🎬 " + $script:CurrentScenario)
        return
    }

    if ($message -match '^End action\\s*:') {
        return
    }

    if ($message -match '^extract report to folder') {
        return
    }

    $interesting = $false

    if (-not [string]::IsNullOrWhiteSpace($stepIndex)) {
        $interesting = $true
    }

    if (
        $message -match 'Navigate to' -or
        $message -match 'Click' -or
        $message -match 'Import' -or
        $message -match 'Save' -or
        $message -match 'selector is null' -or
        $message -match 'not found' -or
        $message -match 'Unable to' -or
        $message -match 'successfully'
    ) {
        $interesting = $true
    }

    if (-not $interesting) {
        return
    }

    $icon = '➡️'

    if ($level -eq 'PASSED') {
        $icon = '✅'
    }
    elseif ($level -eq 'FAILED' -or $level -eq 'ERROR') {
        $icon = '❌'
    }
    elseif ($level -eq 'WARNING') {
        $icon = '⚠️'
    }

    $line = ''

    if ([string]::IsNullOrWhiteSpace($stepIndex)) {
        $line = $icon + ' ' + $message
    }
    else {
        $line = $icon + ' STEP ' + $stepIndex + ' | ' + $message
    }

    if ($line -ne $script:LastStepLine) {
        Write-Host ('[STEP] ' + $line)
        Add-RecentStepLine $line
        $script:LastStepLine = $line
    }
}

function Emit-ExecutionLines {
    param([string[]]$Lines)

    foreach ($line in $Lines) {
        if ($line -match '<record>') {
            $script:IsInsideRecord = $true
            $script:ExecutionRecordBuffer.Clear()
        }

        if ($script:IsInsideRecord) {
            [void]$script:ExecutionRecordBuffer.Add($line)
        }

        if ($line -match '</record>' -and $script:IsInsideRecord) {
            try {
                $recordText = ($script:ExecutionRecordBuffer -join "`n")
                Emit-HumanExecutionRecord -RecordText $recordText
            }
            catch {
            }
            finally {
                $script:IsInsideRecord = $false
                $script:ExecutionRecordBuffer.Clear()
            }
        }
    }
}

function Find-ExecutionLog {
    param([string]$Root)

    $candidate = Get-ChildItem -Path $Root -Filter 'execution0.log' -File -Recurse -ErrorAction SilentlyContinue |
        Where-Object {
            -not (Is-IgnoredReportPath -Path $_.FullName)
        } |
        Sort-Object LastWriteTime -Descending |
        Select-Object -First 1

    if ($candidate) {
        return $candidate.FullName
    }

    return ''
}

function Find-SuiteOutputDir {
    param(
        [string]$Root,
        [datetime]$StartedAt
    )

    $candidate = Get-ChildItem -Path $Root -Directory -Recurse -ErrorAction SilentlyContinue |
        Where-Object {
            (-not (Is-IgnoredReportPath -Path $_.FullName)) -and
            $_.LastWriteTime -ge $StartedAt.AddMinutes(-1)
        } |
        Where-Object {
            (Test-Path (Join-Path $_.FullName 'JUnit_Report.xml')) -or
            (Test-Path (Join-Path $_.FullName 'execution0.log')) -or
            (Get-ChildItem -Path $_.FullName -Filter '*.png' -File -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1)
        } |
        Sort-Object LastWriteTime -Descending |
        Select-Object -First 1

    if ($candidate) {
        return $candidate.FullName
    }

    return ''
}

function Get-JUnitSummary {
    param([string]$JunitFile)

    $result = [ordered]@{
        Executed = 0
        Passed   = 0
        Failed   = 0
        Skipped  = 0
        Reason   = ''
        Cases    = @()
    }

    if (-not (Test-Path $JunitFile)) {
        return $result
    }

    try {
        [xml]$xml = Get-Content $JunitFile

        $testcases = @()

        if ($xml.testsuite) {
            $testcases = @($xml.testsuite.testcase)
        }
        elseif ($xml.testsuites) {
            foreach ($ts in @($xml.testsuites.testsuite)) {
                $testcases += @($ts.testcase)
            }
        }

        $testcases = @($testcases | Where-Object { $_ })
        $result.Executed = $testcases.Count

        $failedNodes = @($testcases | Where-Object { $_.failure -or $_.error })
        $skippedNodes = @($testcases | Where-Object { $_.skipped })

        $result.Failed = $failedNodes.Count
        $result.Skipped = $skippedNodes.Count
        $result.Passed = $result.Executed - $result.Failed - $result.Skipped

        foreach ($tc in ($testcases | Select-Object -First 5)) {
            $caseName = Short-Text $tc.name 90

            if ($tc.failure -or $tc.error) {
                $msg = ''
                if ($tc.failure) {
                    $msg = Short-Text (($tc.failure.message + ' ' + $tc.failure.InnerText)) 90
                }
                elseif ($tc.error) {
                    $msg = Short-Text (($tc.error.message + ' ' + $tc.error.InnerText)) 90
                }

                $result.Cases += ('❌ ' + $caseName + ' | ' + $msg)
            }
            elseif ($tc.skipped) {
                $result.Cases += ('⏭️ ' + $caseName + ' | skipped')
            }
            else {
                $result.Cases += ('✅ ' + $caseName + ' | passed')
            }
        }

        if ($failedNodes.Count -gt 0) {
            $firstBad = $failedNodes[0]

            if ($firstBad.failure) {
                $result.Reason = Short-Text (($firstBad.failure.message + ' ' + $firstBad.failure.InnerText)) 150
            }
            elseif ($firstBad.error) {
                $result.Reason = Short-Text (($firstBad.error.message + ' ' + $firstBad.error.InnerText)) 150
            }
        }
    }
    catch {
        $result.Reason = Short-Text $_.Exception.Message 150
    }

    return $result
}

function Write-SyntheticJunit {
    param(
        [string]$FilePath,
        [string]$SuiteName,
        [string]$Reason
    )

    $escapedReason = [System.Security.SecurityElement]::Escape($Reason)
    if ([string]::IsNullOrWhiteSpace($escapedReason)) {
        $escapedReason = 'Suite failed without JUnit report'
    }

    $xml = @"
<?xml version="1.0" encoding="UTF-8"?>
<testsuite name="$SuiteName" tests="1" failures="1" errors="0" skipped="0">
  <testcase classname="$SuiteName" name="$SuiteName">
    <failure message="$escapedReason">$escapedReason</failure>
  </testcase>
</testsuite>
"@

    Set-Content -Path $FilePath -Value $xml -Encoding UTF8
}

$SuiteStartedAt = Get-Date
$LogsDir = Join-Path $env:REPORTS_ROOT 'logs'
$StdoutLog = Join-Path $LogsDir ($env:SUITE_KEY + '.log')
$StderrLog = Join-Path $LogsDir ($env:SUITE_KEY + '.err.log')
$MetaFile = Join-Path $LogsDir ($env:SUITE_KEY + '.meta.properties')
$SyntheticJunit = Join-Path $LogsDir ($env:SUITE_KEY + '.junit.xml')

if (-not (Test-Path $LogsDir)) {
    New-Item -ItemType Directory -Path $LogsDir -Force | Out-Null
}

Remove-Item $StdoutLog -Force -ErrorAction SilentlyContinue
Remove-Item $StderrLog -Force -ErrorAction SilentlyContinue
Remove-Item $MetaFile -Force -ErrorAction SilentlyContinue
Remove-Item $SyntheticJunit -Force -ErrorAction SilentlyContinue

$args = @(
    '-noSplash',
    '-runMode=console',
    '-consoleLog',
    ('-projectPath="' + $env:PROJECT_PATH + '"'),
    '-retry=0',
    ('-testSuitePath="' + $env:SUITE_PATH + '"'),
