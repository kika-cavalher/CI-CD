		Closure finishScenario = {
			if (currentScenario == null) {
				return
			}

			List<Map> steps = (currentScenario.steps ?: []) as List<Map>
			if (steps.isEmpty()) {
				currentScenario = null
				return
			}

			applyStepDurationsFromTimestamps(steps)

			long duration = sumStepDurations(steps)
			currentScenario.durationMs = duration > 0L ? duration : 1000L
			currentScenario.durationLabel = formatDurationFull(toLong(currentScenario.durationMs))
			currentScenario.status = resolveScenarioStatus(steps)
			currentScenario.errorShort = resolveScenarioErrorShort(steps)
			currentScenario.errorFull = resolveScenarioErrorFull(steps)
			currentScenario.sidebarSubtitle = isBlank(currentScenario.errorShort) ? safeValue(currentScenario.title) : currentScenario.errorShort

			if (isBlank(currentScenario.startLabel)) {
				Map first = steps.find { !isBlank(it.timeLabel) }
				currentScenario.startLabel = first != null ? safeValue(first.timeLabel) : ''
			}
			if (isBlank(currentScenario.endLabel)) {
				Map last = steps.reverse().find { !isBlank(it.timeLabel) }
				currentScenario.endLabel = last != null ? safeValue(last.timeLabel) : ''
