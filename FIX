private transient SSLContext UNSAFE_SSL_CONTEXT

SSLContext getUnsafeSslContext() {
	if (UNSAFE_SSL_CONTEXT != null) {
		return UNSAFE_SSL_CONTEXT
	}

	TrustManager[] trustAllManagers = [
		[
			getAcceptedIssuers: { -> new X509Certificate[0] },
			checkClientTrusted: { X509Certificate[] chain, String authType -> },
			checkServerTrusted: { X509Certificate[] chain, String authType -> }
		] as X509TrustManager
	] as TrustManager[]

	SSLContext context = SSLContext.getInstance('TLS')
	context.init(null, trustAllManagers, new SecureRandom())
	UNSAFE_SSL_CONTEXT = context
	return UNSAFE_SSL_CONTEXT
}

HostnameVerifier getUnsafeHostnameVerifier() {
	return [
		verify: { String hostname, SSLSession session -> true }
	] as HostnameVerifier
}

String readConnectionBody(HttpURLConnection connection) {
	InputStream stream = null
	BufferedReader reader = null

	try {
		int status = connection.getResponseCode()
		stream = status >= 400 ? connection.getErrorStream() : connection.getInputStream()

		if (stream == null) {
			return ''
		}

		reader = new BufferedReader(new InputStreamReader(stream, 'UTF-8'))
		StringBuilder body = new StringBuilder()
		String line = null

		while ((line = reader.readLine()) != null) {
			body.append(line).append('\n')
		}

		return body.toString().trim()
	} finally {
		try { reader?.close() } catch (Exception ignored) {}
		try { stream?.close() } catch (Exception ignored) {}
	}
}

def parseJsonBody(String body) {
	if (isBlank(body)) {
		return [:]
	}

	try {
		return new JsonSlurper().parseText(body)
	} catch (Exception ignored) {
		return [:]
	}
}

HttpURLConnection openConnection(String url, String method, String contentType = '', Map<String, String> extraHeaders = [:]) {
	URL targetUrl = new URL(url)
	HttpURLConnection connection = (HttpURLConnection) targetUrl.openConnection()

	if (connection instanceof HttpsURLConnection) {
		HttpsURLConnection httpsConnection = (HttpsURLConnection) connection
		httpsConnection.setSSLSocketFactory(getUnsafeSslContext().getSocketFactory())
		httpsConnection.setHostnameVerifier(getUnsafeHostnameVerifier())
		connection = httpsConnection
	}

	connection.setRequestMethod(method)
	connection.setConnectTimeout(30000)
	connection.setReadTimeout(120000)
	connection.setUseCaches(false)
	connection.setDoInput(true)
	connection.setInstanceFollowRedirects(false)

	if (method in ['POST', 'PUT', 'PATCH', 'DELETE']) {
		connection.setDoOutput(true)
	}

	connection.setRequestProperty('Accept', 'application/json')

	if (!isBlank(JIRA_TOKEN)) {
		connection.setRequestProperty('Authorization', 'Bearer ' + JIRA_TOKEN)
	}

	if (!isBlank(contentType)) {
		connection.setRequestProperty('Content-Type', contentType)
	}

	extraHeaders.each { String key, String value ->
		if (!isBlank(key) && value != null) {
			connection.setRequestProperty(key, value)
		}
	}

	return connection
}

Map httpJson(String method, String url, String body = '', Map<String, String> extraHeaders = [:]) {
	HttpURLConnection connection = openConnection(
		url,
		method,
		'application/json; charset=UTF-8',
		extraHeaders
	)

	OutputStream output = null

	try {
		if (method in ['POST', 'PUT', 'PATCH'] && body != null) {
			output = connection.getOutputStream()
			output.write(body.getBytes('UTF-8'))
			output.flush()
		}

		int status = connection.getResponseCode()
		String responseBody = readConnectionBody(connection)
		def json = parseJsonBody(responseBody)

		return [
			status: status,
			body  : responseBody,
			json  : json
		]
	} finally {
		try { output?.close() } catch (Exception ignored) {}
		try { connection?.disconnect() } catch (Exception ignored) {}
	}
}

Map httpGet(String url, Map<String, String> extraHeaders = [:]) {
	HttpURLConnection connection = openConnection(url, 'GET', '', extraHeaders)

	try {
		int status = connection.getResponseCode()
		String responseBody = readConnectionBody(connection)
		def json = parseJsonBody(responseBody)

		return [
			status: status,
			body  : responseBody,
			json  : json
		]
	} finally {
		try { connection?.disconnect() } catch (Exception ignored) {}
	}
}

Map httpMultipart(String url, String fileFieldName, String filePath, String mimeType = 'application/octet-stream', Map<String, String> extraHeaders = [:]) {
	File file = new File(filePath)

	if (!file.exists() || !file.isFile()) {
		throw new IOException("Multipart file not found: ${filePath}")
	}

	String boundary = '----KATALON_BOUNDARY_' + System.currentTimeMillis()
	HttpURLConnection connection = openConnection(
		url,
		'POST',
		"multipart/form-data; boundary=${boundary}",
		(['X-Atlassian-Token': 'no-check'] + extraHeaders)
	)

	DataOutputStream output = null

	try {
		output = new DataOutputStream(connection.getOutputStream())

		output.writeBytes("--${boundary}\r\n")
		output.writeBytes("Content-Disposition: form-data; name=\"${fileFieldName}\"; filename=\"${file.name}\"\r\n")
		output.writeBytes("Content-Type: ${mimeType}\r\n\r\n")

		file.withInputStream { InputStream input ->
			byte[] buffer = new byte[8192]
			int read = 0

			while ((read = input.read(buffer)) != -1) {
				output.write(buffer, 0, read)
			}
		}

		output.writeBytes("\r\n")
		output.writeBytes("--${boundary}--\r\n")
		output.flush()

		int status = connection.getResponseCode()
		String responseBody = readConnectionBody(connection)
		def json = parseJsonBody(responseBody)

		return [
			status: status,
			body  : responseBody,
			json  : json
		]
	} finally {
		try { output?.close() } catch (Exception ignored) {}
		try { connection?.disconnect() } catch (Exception ignored) {}
	}
}

// ============================================================
// JIRA REQUESTS
// ============================================================

String getImportExecutionUrl() {
	return JIRA_BASE_URL + '/rest/raven/1.0/import/execution/cucumber?projectKey=' + PROJECT_KEY
}

String getIssueUrl(String issueKey) {
	return JIRA_BASE_URL + '/rest/api/2/issue/' + issueKey
}

String getAttachmentUrl(String issueKey) {
	return getIssueUrl(issueKey) + '/attachments'
}

String getFindTestPlanUrl(String escapedSummary) {
	return JIRA_BASE_URL + '/rest/api/2/search?jql=' +
		URLEncoder.encode(
			'project = "' + PROJECT_KEY + '" AND issuetype = "Test Plan" AND summary ~ "' + escapedSummary + '"',
			'UTF-8'
		)
}

String getAddExecutionToTestPlanUrl(String testPlanKey) {
	return JIRA_BASE_URL + '/rest/raven/1.0/api/testplan/' + testPlanKey + '/testexecution'
}

String getTransitionUrl(String issueKey) {
	return JIRA_BASE_URL + '/rest/api/2/issue/' + issueKey + '/transitions'
}

String getEpicLinkFieldName() {
	return 'customfield_10006'
}

String buildCreateTestPlanBody(String summary) {
	Map fields = [
		project  : [key: PROJECT_KEY],
		summary  : summary,
		issuetype: [name: 'Test Plan']
	]

	if (!isBlank(EPIC_KEY)) {
		fields[getEpicLinkFieldName()] = EPIC_KEY
	}

	return JsonOutput.toJson([fields: fields])
}

String buildUpdateExecutionBody(String summary, String testPlanKey) {
	Map fields = [
		summary: summary
	]

	if (!isBlank(ENVIRONMENT)) {
		fields['environment'] = ENVIRONMENT
	}

	if (!isBlank(LABELS)) {
		fields['labels'] = LABELS.split(',').collect { it.trim() }.findAll { !isBlank(it) }
	}

	if (!isBlank(testPlanKey)) {
		fields['customfield_10005'] = testPlanKey
	}

	return JsonOutput.toJson([fields: fields])
}

String buildAddExecutionToPlanBody(String executionKey) {
	return JsonOutput.toJson([
		add: [executionKey]
	])
}

String escapeJqlText(String text) {
	if (text == null) return ''
	return text.replace('\\', '\\\\').replace('"', '\\"')
}

String findExistingTestPlanKeyBySummary(String summary) {
	if (isBlank(summary)) {
		return ''
	}

	String escapedSummary = escapeJqlText(summary)
	Map response = httpGet(getFindTestPlanUrl(escapedSummary))

	KeywordUtil.logInfo('Find Test Plan status: ' + response.status)
	KeywordUtil.logInfo('Find Test Plan response: ' + safe(response.body))

	if (response.status != 200) {
		return ''
	}

	def issues = response.json?.issues
	if (issues instanceof List && !issues.isEmpty()) {
		return safe(issues[0]?.key)
	}

	return ''
}

String createTestPlan(String summary) {
	Map response = httpJson('POST', JIRA_BASE_URL + '/rest/api/2/issue', buildCreateTestPlanBody(summary))

	KeywordUtil.logInfo('Create Test Plan status: ' + response.status)
	KeywordUtil.logInfo('Create Test Plan response: ' + safe(response.body))

	if (!(response.status in [200, 201])) {
		return 'ERROR' + response.status
	}

	return safe(response.json?.key)
}

String getOrCreateTestPlanKey() {
	if (!isBlank(MANUAL_TEST_PLAN_KEY)) {
		KeywordUtil.logInfo('Using manual Test Plan key: ' + MANUAL_TEST_PLAN_KEY)
		return MANUAL_TEST_PLAN_KEY
	}

	if (!FORCE_CREATE_NEW_TEST_PLAN) {
		String existingKey = findExistingTestPlanKeyBySummary(getTestPlanName())
		if (!isBlank(existingKey)) {
			KeywordUtil.logInfo('Existing Test Plan found: ' + existingKey)
			return existingKey
		}
	}

	String createdKey = createTestPlan(getTestPlanName())
	if (createdKey.startsWith('ERROR')) {
		return createdKey
	}

	return createdKey
}

String importExecutionResults(String xmlFilePath) {
	Map response = httpMultipart(
		getImportExecutionUrl(),
		'file',
		xmlFilePath,
		'text/xml'
	)

	KeywordUtil.logInfo('Import results status: ' + response.status)
	KeywordUtil.logInfo('Import results response: ' + safe(response.body))

	if (!(response.status in [200, 201])) {
		return 'ERROR' + response.status
	}

	String executionKey = safe(response.json?.testExecIssue?.key)
	if (isBlank(executionKey)) {
		return 'ERROR_NO_EXEC_KEY'
	}

	return executionKey
}

int updateIssue(String issueKey, String jsonBody) {
	Map response = httpJson('PUT', getIssueUrl(issueKey), jsonBody)
	KeywordUtil.logInfo('Update issue status for ' + issueKey + ': ' + response.status)
	KeywordUtil.logInfo('Update issue response for ' + issueKey + ': ' + safe(response.body))
	return response.status as int
}

int addExecutionToTestPlan(String testPlanKey, String executionKey) {
	Map response = httpJson('POST', getAddExecutionToTestPlanUrl(testPlanKey), buildAddExecutionToPlanBody(executionKey))
	KeywordUtil.logInfo('Add execution to Test Plan status: ' + response.status)
	KeywordUtil.logInfo('Add execution to Test Plan response: ' + safe(response.body))
	return response.status as int
}

int uploadAttachment(String issueKey, String filePath) {
	if (isBlank(filePath)) {
		return 0
	}

	File file = new File(filePath)
	if (!file.exists() || !file.isFile() || file.length() <= 0) {
		KeywordUtil.logInfo('Skipping attachment upload because file path is empty or file does not exist: ' + filePath)
		return 0
	}

	Map response = httpMultipart(
		getAttachmentUrl(issueKey),
		'file',
		filePath,
		Files.probeContentType(file.toPath()) ?: 'application/octet-stream'
	)

	KeywordUtil.logInfo('Upload attachment status: ' + response.status)
	KeywordUtil.logInfo('Upload attachment response: ' + safe(response.body))

	return response.status as int
}

int transitionIssue(String issueKey, String transitionId) {
	if (isBlank(transitionId)) {
		return 0
	}

	String body = JsonOutput.toJson([
		transition: [id: transitionId]
	])

	Map response = httpJson('POST', getTransitionUrl(issueKey), body)

	KeywordUtil.logInfo('Transition status response code: ' + response.status)
	KeywordUtil.logInfo('Transition response body: ' + safe(response.body))

	return response.status as int
}
