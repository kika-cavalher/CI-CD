    color: #253341;
    margin-bottom: 8px;
    white-space: pre-wrap;
    word-break: break-word;
}
.details-box,
.evidence-item {
    margin-top: 10px;
    border: 1px solid #e3e8ef;
    border-radius: 10px;
    overflow: hidden;
    background: #ffffff;
}
.details-box summary,
.evidence-item summary {
    cursor: pointer;
    padding: 12px 14px;
    font-size: 13px;
    font-weight: 700;
    color: #5a1ea6;
    list-style: none;
}
.details-box summary::-webkit-details-marker,
.evidence-item summary::-webkit-details-marker {
    display: none;
}
.details-box pre {
    margin: 0;
    padding: 14px;
    background: #0f1c2b;
    color: #ffffff;
