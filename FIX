import org.apache.poi.ss.usermodel.*
import org.apache.poi.ss.usermodel.WorkbookFactory as WorkbookFactory
import com.kms.katalon.core.configuration.RunConfiguration as RunConfiguration
import com.kms.katalon.core.util.KeywordUtil as KeywordUtil
import internal.GlobalVariable as GlobalVariable

String errors = ''

def rows = GlobalVariable.compareRows as ArrayList

def files = GlobalVariable.compareFiles as ArrayList

String evPath = ((RunConfiguration.getReportFolder() + '\\Evidences\\Evidence_') + GlobalVariable.currencyType) + '\\'

String validationType = GlobalVariable.currencyType //configuration of the currency on ematch

//Getting files path
String file1 = evPath + files.get(0);

//Reading excel files for comparison
input1 = new FileInputStream(file1)

wbEnv1 = WorkbookFactory.create(input1)

sheetEnv1 = wbEnv1.getSheetAt(0)

int linesEnv1 = sheetEnv1.getLastRowNum()

int Devise = findHeaderColumn(sheetEnv1,"Devise")
int DeviseRef = findHeaderColumn(sheetEnv1,"Devise de ref.")
int MontantCcy = findHeaderColumn(sheetEnv1,"Montant ccy")
int MontantBase = findHeaderColumn(sheetEnv1,"Montant base ccy")

KeywordUtil.logInfo("Devise: "+Devise+"DeviseRef: "+DeviseRef+"MontantCcy"+MontantCcy+"MontantBase"+MontantBase)

//Verify what configuration was done in ematch (EUR, USD or Mixte)
if (validationType.contains('EUR')) {
    for (Row row : sheetEnv1) {
        if (row.rowNum != 0) {
            //if currency is the same, amounts must be the same
            if (row.getCell(Devise).toString().equalsIgnoreCase('EUR')) {
                if (row.getCell(MontantCcy).getNumericCellValue().round(2) != row.getCell(MontantBase).getNumericCellValue().round(
                    2)) {
                    errors += (('[ERROR] In row number ' + row.rowNum) + ' the amounts of EUR are different.')
                }
            }
        }
    }
    //if currency is the same, amounts must be the same
    //if currency is the same, amounts must be the same
} else if (validationType.contains('USD')) {
    for (Row row : sheetEnv1) {
        if (row.rowNum != 0) {
            if (row.getCell(Devise).toString().equalsIgnoreCase('USD')) {
                if (row.getCell(MontantCcy).getNumericCellValue().round(2) != row.getCell(MontantBase).getNumericCellValue().round(
                    2)) {
                    errors += (('[ERROR] In row number ' + row.rowNum) + ' the amounts of USD are different.')
                }
            }
        }
    }
} else {
    for (Row row : sheetEnv1) {
        if (row.rowNum != 0) {
            if (row.getCell(Devise).toString().equalsIgnoreCase(row.getCell(DeviseRef).toString())) {

                if (row.getCell(MontantCcy).getNumericCellValue().round(2) != row.getCell(MontantBase).getNumericCellValue().round(
                    2)) {
                    errors += (('[ERROR] In row number ' + row.rowNum) + ' the amounts should be same, but they are different.')
                }
                
            }
        }
    }
}

//Fails if any validation didn't pass
if (errors.length() > 1) {
    KeywordUtil.markFailed(errors)
} // Assume que o cabeçalho está na primeira linha
// Verifica se a linha do cabeçalho existe
// Retorna o índice da coluna se o cabeçalho for encontrado
// Retorna -1 se o cabeçalho não for encontrado
else {
    KeywordUtil.markPassed('\n[SUCCESS] Validation of PL Economique finished successfully!\n')
}

int findHeaderColumn(Sheet sheet, String headerName) {
	Row headerRow = sheet.getRow(0)
   
    if (headerRow == null) {
        KeywordUtil.markFailed("The Header "+headerName+" not found.");
		return -1
    }
    
    for (int i = 0; i < headerRow.getPhysicalNumberOfCells(); i++) {
        Cell cell = headerRow.getCell(i)

        if ((cell != null) && cell.getStringCellValue().equalsIgnoreCase(headerName)) {
            return i
        }
    }
	KeywordUtil.markFailed("The Header "+headerName+" not found.");
    return -1
}
