	private String buildGeneratedLabel(Map model) {
		String raw = pickFirst(
				model.generatedAt,
				model.generatedLabel,
				model.createdAt,
				model.executionDate
				)

		if (!raw.isEmpty()) {
			return 'Generated ' + raw
		}

		return 'Generated ' + new SimpleDateFormat('dd.MM.yyyy HH:mm:ss').format(new Date())
	}

	private long normalizeDurationMs(Map item, String rawStart, String rawEnd) {
		Object durationValue = pickFirstObject(
				item.durationMs,
				item.elapsedMs,
				item.timeMs,
				item.duration
				)

		long parsed = toLong(durationValue)
		if (parsed > 0L) {
			return parsed
		}

		long startMillis = parseDateMillis(rawStart)
		long endMillis = parseDateMillis(rawEnd)

		if (startMillis > 0L && endMillis >= startMillis) {
			return endMillis - startMillis
		}

		return 0L
	}

	private long parseDateMillis(String raw) {
		String text = safeValue(raw)
		if (text.isEmpty()) {
			return 0L
		}

		List<String> patterns = [
			'dd.MM.yyyy HH:mm:ss',
			'dd.MM.yyyy hh:mm:ss a',
			'yyyy-MM-dd HH:mm:ss',
			'yyyy-MM-dd HH:mm:ss.SSS',
			'yyyy-MM-dd\'T\'HH:mm:ss',
			'yyyy-MM-dd\'T\'HH:mm:ss.SSS',
			'HH:mm:ss'
		]

		for (String pattern : patterns) {
			try {
				return new SimpleDateFormat(pattern).parse(text).time
			} catch (Exception ignored) {
			}
		}

		return 0L
	}

	private String formatDateTimeLabel(String raw) {
		String text = safeValue(raw)
		if (text.isEmpty()) {
			return '--'
		}
		return text
	}

	private String extractClockLabel(String raw) {
		String text = safeValue(raw)
		if (text.isEmpty()) {
			return ''
		}

		def matcher = (text =~ /(\\d{2}:\\d{2}:\\d{2}|\\d{1,2}:\\d{2}:\\d{2}\\s?[APMapm]{2})/)
		if (matcher.find()) {
			return cleanClock(matcher.group(1))
		}

		return text
	}

	private String cleanClock(String raw) {
		String text = safeValue(raw)
		if (text.contains('.')) {
			return text.substring(0, text.indexOf('.'))
		}
		return text
	}

	private String formatDuration(long durationMs) {
		if (durationMs < 0L) {
			durationMs = 0L
		}

		long totalSeconds = Math.round(durationMs / 1000d)
		long hours = (long) (totalSeconds / 3600L)
		long minutes = (long) ((totalSeconds % 3600L) / 60L)
		long seconds = (long) (totalSeconds % 60L)

		return String.format(Locale.ENGLISH, '%02dh %02dm %02ds', hours, minutes, seconds)
	}

	private String resolveStepIcon(String detail, String status) {
		String lower = safeValue(detail).toLowerCase(Locale.ENGLISH)

		if (status == 'failed') return '❌'
		if (status == 'skipped') return '⏭️'
		if (lower.contains('wait')) return '🔎'
		if (lower.contains('click') || lower.contains('select') || lower.contains('fill') || lower.contains('import')) return '🖱️'
		if (lower.contains('open') || lower.contains('navigate')) return '🌐'
		return 'ℹ️'
	}

	private String normalizeStatus(String raw) {
		String text = safeValue(raw).toLowerCase(Locale.ENGLISH)

		switch (text) {
			case 'pass':
			case 'passed':
			case 'success':
				return 'passed'
			case 'fail':
			case 'failed':
			case 'error':
				return 'failed'
			case 'skip':
			case 'skipped':
				return 'skipped'
			default:
				return 'info'
		}
	}

	private String statusLabel(String status) {
		switch (safeValue(status)) {
			case 'passed':
				return 'Passed'
			case 'failed':
				return 'Failed'
			case 'skipped':
				return 'Skipped'
			default:
				return 'Info'
		}
	}

	private File resolveFile(String path, String baseFolder) {
		String raw = safeValue(path)
		if (raw.isEmpty()) {
			return null
		}

		try {
			if (raw.toLowerCase(Locale.ENGLISH).startsWith('file:/')) {
				File uriFile = new File(new URI(raw))
				if (uriFile.exists()) {
					return uriFile
				}
			}
		} catch (Exception ignored) {
		}

		File direct = new File(raw)
		if (direct.exists()) {
			return direct
		}

		if (!safeValue(baseFolder).isEmpty()) {
			File byBase = new File(baseFolder, raw)
			if (byBase.exists()) {
				return byBase
			}
		}

		return direct
	}

	private String resolveLogoHref(Map view) {
		File logoFile = resolveFile(pickFirst(view.logoSrc, LOGO_SRC), pickFirst(view.reportFolder))
		if (logoFile != null && logoFile.exists()) {
			return logoFile.toURI().toString()
		}
		return pickFirst(view.logoSrc, LOGO_SRC)
	}

	private boolean isImageFile(String fileName) {
		String lower = safeValue(fileName).toLowerCase(Locale.ENGLISH)
		return lower.endsWith('.png') ||
				lower.endsWith('.jpg') ||
				lower.endsWith('.jpeg') ||
				lower.endsWith('.gif') ||
				lower.endsWith('.webp') ||
				lower.endsWith('.bmp')
	}

	private List asList(def value) {
		if (value == null) return []
		if (value instanceof Collection) return new ArrayList(value as Collection)
		if (value.getClass().isArray()) return (value as Object[]).toList()
		return [value]
	}

	private long toLong(def value) {
		String raw = safeValue(value)
		if (raw.isEmpty()) {
			return 0L
		}

		try {
			return Long.parseLong(raw)
		} catch (Exception ignored) {
		}

		try {
			String clean = raw.replace(',', '.')
			if (clean.endsWith('s')) {
				clean = clean.substring(0, clean.length() - 1)
				return Math.round(Double.parseDouble(clean) * 1000d)
			}
		} catch (Exception ignored) {
		}

		return 0L
	}

	private double percent(int value, int total) {
		if (total <= 0) return 0d
		return ((double) value / (double) total) * 100d
	}

	private String shorten(String text, int max) {
		String value = safeValue(text)
		if (value.length() <= max) return value
		return value.substring(0, Math.max(0, max - 3)) + '...'
	}

	private String safeValue(def value) {
		return value == null ? '' : String.valueOf(value).trim()
	}

	private String pickFirst(Object... values) {
		if (values == null) return ''
		for (Object value : values) {
			String text = safeValue(value)
			if (!text.isEmpty()) return text
		}
		return ''
	}

	private Object pickFirstObject(Object... values) {
		if (values == null) return null
		for (Object value : values) {
			if (value == null) continue
			if (value instanceof CharSequence && safeValue(value).isEmpty()) continue
			return value
		}
		return null
	}

	private String htmlEscape(def value) {
		String text = safeValue(value)
		return text
				.replace('&', '&amp;')
				.replace('<', '&lt;')
				.replace('>', '&gt;')
				.replace('"', '&quot;')
				.replace("'", '&#39;')
	}

	private String jsEscape(def value) {
		String text = safeValue(value)
		return text
				.replace('\\', '\\\\')
				.replace("'", "\\'")
				.replace('\r', '')
				.replace('\n', '\\n')
	}

