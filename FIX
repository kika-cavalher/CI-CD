	private List<Map> buildScenariosFromJUnit(File junitFile, File reportRoot, Map<String, Map> traceByCase) {
		List<Map> scenarios = []
		Document xml = parseXml(junitFile)

		if (xml == null) {
			return scenarios
		}

		NodeList testcases = xml.getElementsByTagName('testcase')

		for (int i = 0; i < testcases.getLength(); i++) {
			Node node = testcases.item(i)
			if (!(node instanceof Element)) {
				continue
			}

			Element testcase = (Element) node

			String rawName = safe(testcase.getAttribute('name'))
			String className = safe(testcase.getAttribute('classname'))
			String displayName = buildDisplayName(className, rawName)
			String scenarioId = buildScenarioId(displayName, i + 1)

			String status = 'passed'
			String junitMessage = ''
			String junitErrorBody = ''

			NodeList children = testcase.getChildNodes()
			for (int c = 0; c < children.getLength(); c++) {
				Node child = children.item(c)
				if (!(child instanceof Element)) {
					continue
				}

				String childName = safe(child.getNodeName()).toLowerCase(Locale.ENGLISH)

				if ('failure'.equals(childName) || 'error'.equals(childName)) {
					status = 'failed'
					junitMessage = safe(((Element) child).getAttribute('message'))
					junitErrorBody = safe(child.getTextContent())
					break
				}

				if ('skipped'.equals(childName)) {
					status = 'blocked'
					junitMessage = safe(((Element) child).getAttribute('message'))
					junitErrorBody = safe(child.getTextContent())
				}
			}

			long junitDurationMs = toDurationMillis(safe(testcase.getAttribute('time')))
			Map trace = resolveTrace(traceByCase, displayName)

			long startMs = asLong(trace.startMs)
			long endMs = asLong(trace.endMs)
			long durationMs = 0L

			if (startMs > 0L && endMs >= startMs) {
				durationMs = endMs - startMs
			} else {
				durationMs = junitDurationMs
			}

			if (safe(trace.status).equalsIgnoreCase('FAILED')) {
				status = 'failed'
			}
			if (safe(trace.status).equalsIgnoreCase('BLOCKED') || safe(trace.status).equalsIgnoreCase('SKIPPED')) {
				status = 'blocked'
			}

			String htmlFullError = extractFullErrorFromScenarioFolder(
					junitFile.parentFile,
					displayName,
					className,
					rawName
					)

			String traceFullFailure = safe(trace.fullFailure)
			String traceFailure = safe(trace.failure)

			String fullError = firstNonBlank(
					normalizeMultiline(junitErrorBody),
					normalizeMultiline(htmlFullError),
					normalizeMultiline(traceFullFailure),
					normalizeMultiline(traceFailure),
					normalizeMultiline(junitMessage)
					)

			String visualError = buildShortError(
					firstNonBlank(junitMessage, traceFailure),
					fullError,
					displayName
					)

			List<Map> steps = normalizeStepRows(trace.steps)
			if (steps.isEmpty() && 'failed'.equals(status) && !visualError.isEmpty()) {
				steps << [
					status    : 'failed',
					timestamp : endMs > 0L ? formatClock(endMs) : '--',
					detail    : visualError,
					icon      : resolveStepIcon(visualError, 'failed')
				]
			}

			List<Map> evidence = collectEvidence(
					reportRoot,
					junitFile.parentFile,
					displayName,
					trace.evidencePaths as List<String>,
					startMs,
					endMs
					)

			scenarios << [
				id            : scenarioId,
				name          : displayName,
				scenarioName  : displayName,
				status        : status,
				result        : status,
				durationMs    : durationMs,
				durationLabel : formatDuration(durationMs),
				startTime     : startMs > 0L ? formatDateTime(startMs) : '',
				endTime       : endMs > 0L ? formatDateTime(endMs) : '',
				startLabel    : startMs > 0L ? formatDateTime(startMs) : '--',
				endLabel      : endMs > 0L ? formatDateTime(endMs) : '--',
				startShort    : startMs > 0L ? formatDateTime(startMs) : '--',
				endShort      : endMs > 0L ? formatDateTime(endMs) : '--',
				startLong     : startMs > 0L ? formatDateTime(startMs) : '--',
				endLong       : endMs > 0L ? formatDateTime(endMs) : '--',
				visualError   : visualError,
				errorSummary  : visualError,
				fullError     : fullError,
				errorDetail   : fullError,
				reportFolder  : reportRoot.absolutePath,
				steps         : steps,
				evidence      : evidence
			]
		}

		return scenarios
	}

	private List<Map> buildFallbackFromTrace(File reportRoot, Map<String, Map> traceByCase) {
		List<Map> scenarios = []

		traceByCase.eachWithIndex { String caseId, Map trace, int index ->
			long startMs = asLong(trace.startMs)
			long endMs = asLong(trace.endMs)
			long durationMs = startMs > 0L && endMs >= startMs ? (endMs - startMs) : 0L

			String rawStatus = safe(trace.status)
			String status = normalizeScenarioStatus(rawStatus)
			List<Map> steps = normalizeStepRows(trace.steps)

			String fullError = firstNonBlank(
					normalizeMultiline(safe(trace.fullFailure)),
					normalizeMultiline(safe(trace.failure))
					)

			List<Map> evidence = collectEvidence(
					reportRoot,
					reportRoot,
					caseId,
					trace.evidencePaths as List<String>,
					startMs,
					endMs
					)

			scenarios << [
				id            : buildScenarioId(caseId, index + 1),
				name          : caseId,
				scenarioName  : caseId,
				status        : status,
				result        : status,
				durationMs    : durationMs,
				durationLabel : formatDuration(durationMs),
				startTime     : startMs > 0L ? formatDateTime(startMs) : '',
				endTime       : endMs > 0L ? formatDateTime(endMs) : '',
				startLabel    : startMs > 0L ? formatDateTime(startMs) : '--',
				endLabel      : endMs > 0L ? formatDateTime(endMs) : '--',
				startShort    : startMs > 0L ? formatDateTime(startMs) : '--',
				endShort      : endMs > 0L ? formatDateTime(endMs) : '--',
				startLong     : startMs > 0L ? formatDateTime(startMs) : '--',
				endLong       : endMs > 0L ? formatDateTime(endMs) : '--',
				visualError   : firstMeaningfulLine(fullError),
				errorSummary  : firstMeaningfulLine(fullError),
				fullError     : fullError,
				errorDetail   : fullError,
				reportFolder  : reportRoot.absolutePath,
				steps         : steps,
