	private void sleepMs(long ms) {
		try {
			Thread.sleep(ms)
		} catch (InterruptedException ignored) {
			Thread.currentThread().interrupt()
		}
	}

	private String normalizeTitle(String value) {
		return safe(value).replaceAll('\\s+', ' ').trim()
	}

	private String safe(Object value) {
		return value == null ? '' : value.toString().trim()
	}

	private String escapePowerShell(String value) {
		return safe(value).replace("'", "''")
	}

	private String xpathLiteral(String value) {
		String v = safe(value)

		if (!v.contains("'")) {
			return "'${v}'"
		}

		if (!v.contains('"')) {
			return "\"${v}\""
		}

		List<String> parts = v.split("'").collect { "'${it}'" }
		return "concat(${parts.join(", \"'\", ")})"
	}

	private boolean imageFileExists(String imagePath) {
		String path = safe(imagePath)
		return path && new File(path).exists()
	}

	private boolean waitImagePresent(String imagePath, int timeoutSeconds) {
		if (!imageFileExists(imagePath)) {
			KeywordUtil.logInfo("Image file was not found: ${imagePath}")
			return false
		}

		long end = System.currentTimeMillis() + (timeoutSeconds * 1000L)

		while (System.currentTimeMillis() < end) {
			try {
				if (WindowsImageKeywords.verifyImagePresent(imagePath, FailureHandling.OPTIONAL)) {
					return true
				}
			} catch (Throwable ignored) {
			}

			sleepMs(500)
		}

		return false
	}

	private void clickImageStrict(String imagePath, int attempts, int waitAfterMs, String actionLabel) {
		if (!imageFileExists(imagePath)) {
			KeywordUtil.markFailedAndStop("${actionLabel} failed because image was not found: ${imagePath}")
		}

		for (int i = 1; i <= attempts; i++) {
			try {
				KeywordUtil.logInfo("${actionLabel}. Attempt ${i}/${attempts} using ${imagePath}")
				WindowsImageKeywords.clickImage(imagePath)
				sleepMs(waitAfterMs)
				return
			} catch (Throwable ignored) {
				sleepMs(700)
			}
		}

		KeywordUtil.markFailedAndStop("${actionLabel} failed using image: ${imagePath}")
	}



























