package jiraIntegration

import java.text.SimpleDateFormat
import java.util.Locale

import com.kms.katalon.core.util.KeywordUtil

class JiraTestPlanManager {

    JiraFlowCoordinator owner
    JiraGateway gateway

    JiraTestPlanManager(JiraFlowCoordinator owner, JiraGateway gateway) {
        this.owner = owner
        this.gateway = gateway
    }

    String findExistingTestPlanKey(String summary) {
        if (owner.FORCE_CREATE_NEW_TEST_PLAN) {
            KeywordUtil.logInfo("FORCE_CREATE_NEW_TEST_PLAN enabled. A new Test Plan will be created.")
            return ''
        }

        String expectedSummary = owner.normalizeTitle(summary)
        List issues = gateway.searchTestPlans(summary, owner.EPIC_KEY)

        if (!(issues instanceof List) || issues.isEmpty()) {
            KeywordUtil.logInfo("No Test Plan returned by Jira search for summary: ${summary}")
            return ''
        }

        List exactMatches = issues.findAll { issue ->
            owner.normalizeTitle(issue?.fields?.summary) == expectedSummary
        }

        if (exactMatches.isEmpty()) {
            KeywordUtil.logInfo("No exact Test Plan match found for summary: ${summary}")
            return ''
        }

        exactMatches = exactMatches.sort { a, b ->
            extractIssueSortMillis(b) <=> extractIssueSortMillis(a)
        }

        KeywordUtil.logInfo("Exact Test Plan matches found: ${exactMatches.size()}")
        exactMatches.each { issue ->
            KeywordUtil.logInfo(
                "Candidate Test Plan -> key: ${owner.safe(issue?.key)}, " +
                "summary: ${owner.safe(issue?.fields?.summary)}, " +
                "updated: ${owner.safe(issue?.fields?.updated)}, " +
                "created: ${owner.safe(issue?.fields?.created)}"
            )
        }

        if (!owner.isBlank(owner.MANUAL_TEST_PLAN_KEY)) {
            String manualKey = owner.safe(owner.MANUAL_TEST_PLAN_KEY)

            def manualMatch = exactMatches.find { issue ->
                owner.safe(issue?.key).equalsIgnoreCase(manualKey)
            }

            if (manualMatch != null) {
                KeywordUtil.logInfo("Using manual Test Plan key after Jira validation: ${manualKey}")
                owner.saveSuiteTestPlanKey(manualKey)
                return manualKey
            }

            KeywordUtil.logInfo("Manual Test Plan key ${manualKey} was ignored because it does not match the exact Jira search result.")
        }

        String savedKey = owner.readSavedSuiteTestPlanKey()
        if (!owner.isBlank(savedKey)) {
            def savedMatch = exactMatches.find { issue ->
                owner.safe(issue?.key).equalsIgnoreCase(savedKey)
            }

            if (savedMatch != null) {
                KeywordUtil.logInfo("Using saved Test Plan key after Jira validation: ${savedKey}")
                owner.saveSuiteTestPlanKey(savedKey)
                return savedKey
            }

            KeywordUtil.logInfo("Saved Test Plan key ${savedKey} was ignored because it no longer matches the exact Jira result for this suite.")
        }

        String newestExactKey = owner.safe(exactMatches[0]?.key)
        if (!owner.isBlank(newestExactKey)) {
            owner.saveSuiteTestPlanKey(newestExactKey)
            KeywordUtil.logInfo("Using newest exact Jira Test Plan match: ${newestExactKey}")
            return newestExactKey
        }

        return ''
    }

    String getOrCreateTestPlanKey() {
        String summary = owner.getTestPlanName()

        String existingKey = findExistingTestPlanKey(summary)
        if (!owner.isBlank(existingKey)) {
            KeywordUtil.logInfo("Resolved existing Test Plan for suite ${owner.getCurrentSuiteName()}: ${existingKey}")
            return existingKey
        }

        String createdKey = gateway.createTestPlan(summary, owner.EPIC_KEY)
        if (!owner.isBlank(createdKey) && !createdKey.startsWith('ERROR')) {
            owner.saveSuiteTestPlanKey(createdKey)
            KeywordUtil.logInfo("Created new Test Plan for suite ${owner.getCurrentSuiteName()}: ${createdKey}")
        }

        return createdKey
    }

    private long extractIssueSortMillis(def issue) {
        long updatedMillis = parseJiraDateMillis(owner.safe(issue?.fields?.updated))
        if (updatedMillis > 0L) {
            return updatedMillis
        }

        long createdMillis = parseJiraDateMillis(owner.safe(issue?.fields?.created))
        if (createdMillis > 0L) {
            return createdMillis
        }

        return 0L
    }

    private long parseJiraDateMillis(String rawValue) {
        String raw = owner.safe(rawValue)
        if (owner.isBlank(raw)) {
            return 0L
        }

        List<String> patterns = [
            "yyyy-MM-dd'T'HH:mm:ss.SSSZ",
            "yyyy-MM-dd'T'HH:mm:ssZ",
            "yyyy-MM-dd'T'HH:mm:ss.SSSX",
            "yyyy-MM-dd'T'HH:mm:ssX",
            "yyyy-MM-dd HH:mm:ss.SSS",
            "yyyy-MM-dd HH:mm:ss"
        ]

        for (String pattern : patterns) {
            try {
                return new SimpleDateFormat(pattern, Locale.ENGLISH).parse(raw).time
            } catch (Exception ignored) {
            }
        }

        return 0L
    }
}
