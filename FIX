2) ✅ Reescreve o run-ematch-command.bat COMPLETO (blindado)

Salva exatamente em
D:\Projects\eMatchStarters\run-ematch-command.bat

@echo off
setlocal EnableExtensions EnableDelayedExpansion

REM ============================================================
REM Always log in a fixed place (even if WORKSPACE is broken)
REM ============================================================
set "ROOT=D:\Projects\eMatchStarters"
set "TASKLOG=%ROOT%\logs\RunEMatchDesktop_task.log"
set "CTX_FILE=%ROOT%\run-context.properties"

if not exist "%ROOT%\logs" mkdir "%ROOT%\logs" >nul 2>&1

echo ============================================================ >> "%TASKLOG%"
echo [START] %DATE% %TIME% >> "%TASKLOG%"
echo [INFO] CTX_FILE=%CTX_FILE% >> "%TASKLOG%"

REM ============================================================
REM 1) Read context (created by Jenkins)
REM ============================================================
if not exist "%CTX_FILE%" (
  echo [ERROR] Context file not found >> "%TASKLOG%"
  goto :FAIL_EC2
)

for /f "usebackq tokens=1* delims==" %%A in ("%CTX_FILE%") do (
  set "K=%%A"
  set "V=%%B"
  if defined K set "!K!=!V!"
)

echo [INFO] WORKSPACE=!WORKSPACE! >> "%TASKLOG%"
echo [INFO] PROJECT_FILE=!PROJECT_FILE! >> "%TASKLOG%"
echo [INFO] KATALON_EXE=!KATALON_EXE! >> "%TASKLOG%"
echo [INFO] COLLECTION_PATH=!COLLECTION_PATH! >> "%TASKLOG%"
echo [INFO] BROWSER_TYPE=!BROWSER_TYPE! >> "%TASKLOG%"
echo [INFO] RETRY=!RETRY! >> "%TASKLOG%"

if not defined WORKSPACE (
  echo [ERROR] WORKSPACE is empty >> "%TASKLOG%"
  goto :FAIL_EC3
)

set "REPORTS_DIR=!WORKSPACE!\Reports"
set "LOG_DIR=!REPORTS_DIR!\logs"
set "MARKER=!REPORTS_DIR!\__jenkins_task_exitcode.txt"
set "KLOG=!LOG_DIR!\desktop_katalon.log"

if not exist "!REPORTS_DIR!" mkdir "!REPORTS_DIR!" >nul 2>&1
if not exist "!LOG_DIR!" mkdir "!LOG_DIR!" >nul 2>&1

del /f /q "!MARKER!" >nul 2>&1

echo ============================================================ > "!KLOG!"
echo [INFO] Started %DATE% %TIME% >> "!KLOG!"
echo [INFO] WORKSPACE=!WORKSPACE! >> "!KLOG!"
echo [INFO] PROJECT_FILE=!PROJECT_FILE! >> "!KLOG!"
echo [INFO] KATALON_EXE=!KATALON_EXE! >> "!KLOG!"
echo [INFO] COLLECTION_PATH=!COLLECTION_PATH! >> "!KLOG!"
echo [INFO] BROWSER_TYPE=!BROWSER_TYPE! >> "!KLOG!"
echo [INFO] RETRY=!RETRY! >> "!KLOG!"
echo ============================================================ >> "!KLOG!"

REM ============================================================
REM 2) Execute Katalon
REM ============================================================
if not exist "!KATALON_EXE!" (
  echo [ERROR] KATALON_EXE not found: !KATALON_EXE! >> "!KLOG!"
  echo [ERROR] KATALON_EXE not found >> "%TASKLOG%"
  goto :FAIL_EC4
)

if not exist "!WORKSPACE!\!PROJECT_FILE!" (
  echo [ERROR] Project file not found: !WORKSPACE!\!PROJECT_FILE! >> "!KLOG!"
  echo [ERROR] Project file not found >> "%TASKLOG%"
  goto :FAIL_EC5
)

pushd "!WORKSPACE!" >> "!KLOG!" 2>&1

echo [INFO] Running Katalon now... >> "!KLOG!"
"!KATALON_EXE!" ^
  -noSplash ^
  -runMode=console ^
  -consoleLog ^
  -projectPath="!WORKSPACE!\!PROJECT_FILE!" ^
  -retry=!RETRY! ^
  -testSuiteCollectionPath="!COLLECTION_PATH!" ^
  -browserType="!BROWSER_TYPE!" ^
  -reportFolder="!REPORTS_DIR!" ^
  1>> "!KLOG!" 2>&1

set "EC=%ERRORLEVEL%"

popd >> "!KLOG!" 2>&1

REM ============================================================
REM 3) Marker for Jenkins (ALWAYS)
REM ============================================================
echo %EC% > "!MARKER!"
echo [INFO] ExitCode=%EC% >> "!KLOG!"
echo [END]  %DATE% %TIME% ExitCode=%EC% >> "%TASKLOG%"
exit /b %EC%

:FAIL_EC2
set "EC=2"
goto :WRITE_MARKER

:FAIL_EC3
set "EC=3"
goto :WRITE_MARKER

:FAIL_EC4
set "EC=4"
goto :WRITE_MARKER

:FAIL_EC5
set "EC=5"
goto :WRITE_MARKER

:WRITE_MARKER
REM If WORKSPACE missing we cannot write marker there, so write fallback marker
if defined WORKSPACE (
  set "REPORTS_DIR=%WORKSPACE%\Reports"
  if not exist "%REPORTS_DIR%" mkdir "%REPORTS_DIR%" >nul 2>&1
  echo %EC% > "%REPORTS_DIR%\__jenkins_task_exitcode.txt"
)

echo [FAIL] %DATE% %TIME% ExitCode=%EC% >> "%TASKLOG%"
exit /b %EC%

