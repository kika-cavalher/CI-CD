	@Keyword
	void startMatch(String currentUser, String targetWindowTitle) {
		String expectedTitle = normalizeTitle(safe(targetWindowTitle) ?: resolveWindowTitle())

		KeywordUtil.logInfo("Starting eMatch for environment ${(safe(GlobalVariable.env) ?: 'REC')}")
		KeywordUtil.logInfo("Current Windows user ${safe(currentUser)}")
		KeywordUtil.logInfo("Target window title ${expectedTitle}")

		ensureWinAppDriverRunning()

		if (attachToRunningWindow(expectedTitle, 5)) {
			detectedWindowTitle = expectedTitle
			KeywordUtil.logInfo("eMatch already open with title ${detectedWindowTitle}")
			return
		}

		List<String> launchCandidates = buildLaunchCandidates()

		if (launchCandidates.isEmpty()) {
			KeywordUtil.markFailedAndStop("No valid launch candidate was found for eMatch")
		}

		for (String appPath : launchCandidates) {
			try {
				KeywordUtil.logInfo("Launching eMatch with Katalon: ${appPath}")
				Windows.startApplicationWithTitle(appPath, expectedTitle)
				sleepMs(3000)

				if (attachToRunningWindow(expectedTitle, 25)) {
					detectedWindowTitle = expectedTitle
					KeywordUtil.logInfo("eMatch window detected during startup with title ${detectedWindowTitle}")
					return
				}
			} catch (Throwable t) {
				KeywordUtil.logInfo("Launch failed for ${appPath} :: ${safe(t.message)}")
			}
		}

		KeywordUtil.markFailedAndStop("Could not open eMatch window ${expectedTitle}")
	}

	private List<String> buildLaunchCandidates() {
		List<String> candidates = []
		Set<String> seen = [] as Set<String>

		addLaunchCandidate(candidates, seen, getShortcutPath())
		addLaunchCandidate(candidates, seen, getInstalledExePath())
		addLaunchCandidate(candidates, seen, getApplicationPath())

		return candidates
	}

	private void addLaunchCandidate(List<String> candidates, Set<String> seen, String path) {
		String resolved = safe(path)

		if (!resolved) {
			return
		}

		if (!fileExists(resolved)) {
			return
		}

		String lower = resolved.toLowerCase()
		if (seen.contains(lower)) {
			return
		}

		seen << lower
		candidates << resolved
	}

