class JiraReportBuilder {

	private static final String APP_NAME = 'EMATCH'
	private static final String LOGO_SRC = 'Images/General/logo.png'
	private static final String EVIDENCE_INDEX_FILE = 'jira_images_evidence.tsv'

	private static final SimpleDateFormat OUTPUT_DATE_TIME =
	new SimpleDateFormat('dd/MM/yyyy HH:mm:ss', Locale.ENGLISH)

	private static final SimpleDateFormat OUTPUT_CLOCK =
	new SimpleDateFormat('HH:mm:ss', Locale.ENGLISH)

	private static final List<String> TRACE_FILE_NAMES = [
		'_custom_report_trace.log',
		'custom-report-trace.log'
	]

	private static final List<String> DATE_PATTERNS = [
		'yyyy-MM-dd HH:mm:ss.SSS',
		'yyyy-MM-dd HH:mm:ss',
		"yyyy-MM-dd'T'HH:mm:ss.SSSXXX",
		"yyyy-MM-dd'T'HH:mm:ss.SSS",
