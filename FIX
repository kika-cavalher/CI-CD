	private void clickImageFirstThenObject(
			String imageKey,
			String objectKey,
			String description,
			Integer timeoutSeconds
		) {

		Integer imageTimeout =
			Math.min(
				safeTimeout(timeoutSeconds),
				IMAGE_FALLBACK_TIMEOUT
			)

		Boolean clickedByImage = false

		try {
			if (imageLoader.waitForImage(
				IMAGE_GROUP,
				imageKey,
				imageTimeout
			)) {
				WindowsImageKeywords.clickImage(
					image(imageKey)
				)

				clickedByImage = true

				KeywordUtil.logInfo(
					'[IMAGE] ' +
						description +
						' clicked.\n' +
						'Group: ' +
						IMAGE_GROUP +
						'\nKey: ' +
						imageKey
				)
			}
		} catch (Throwable imageError) {
			KeywordUtil.logInfo(
				'[IMAGE] Could not click ' +
					description +
					'. Trying Windows object.\n' +
					'Reason: ' +
					safeText(imageError.message)
			)
		}

		if (clickedByImage) {
			return
		}

		WindowsTestObject targetObject =
			object(objectKey)

		if (!Windows.waitForElementPresent(
			targetObject,
			safeTimeout(timeoutSeconds),
			FailureHandling.OPTIONAL
		)) {
			takeEvidence(
				'Investigations_' +
					objectKey +
					'_NotFound.png'
			)

			KeywordUtil.markFailedAndStop(
				description +
					' was not found by image or Windows object.\n' +
					'Image: ' +
					IMAGE_GROUP +
					'.' +
					imageKey +
					'\nObject: ' +
					OBJECT_GROUP +
					'.' +
					objectKey
			)

			return
		}

		Windows.click(
			targetObject,
			FailureHandling.STOP_ON_FAILURE
		)

		KeywordUtil.logInfo(
			'[OBJECT] ' +
				description +
				' clicked.\n' +
				'Group: ' +
				OBJECT_GROUP +
				'\nKey: ' +
				objectKey
		)
	}

	private void verifyTabByName(
			String tabName,
			Integer timeoutSeconds
		) {

		Integer timeout =
			safeTimeout(timeoutSeconds)

		WindowsTestObject tabObject =
			WindowsObjectLoader.getTabByName(
				tabName
			)

		if (!Windows.waitForElementPresent(
			tabObject,
			timeout,
			FailureHandling.OPTIONAL
		)) {
			takeEvidence(
				'Investigations_TabNotOpened.png'
			)

			KeywordUtil.markFailedAndStop(
				'Expected tab was not opened.\n' +
					'Tab: ' +
					tabName
			)

			return
		}

		KeywordUtil.logInfo(
			'[PASS] Tab opened successfully: ' +
				tabName
		)
	}

	private void selectYesOnWarningPopup() {
		Robot robot = new Robot()

		robot.keyPress(KeyEvent.VK_ALT)
		robot.keyPress(KeyEvent.VK_TAB)
		robot.keyRelease(KeyEvent.VK_TAB)
		robot.keyRelease(KeyEvent.VK_ALT)

		Windows.delay(POLLING_DELAY_SECONDS)

		robot.keyPress(KeyEvent.VK_ENTER)
		robot.keyRelease(KeyEvent.VK_ENTER)

		Windows.delay(POLLING_DELAY_SECONDS)
	}

	private List<String> expectedDetailWindowTitles(
			String normalizedSource
		) {

		if (normalizedSource.equals('bilan')) {
			return [
				'Investigations (Détail - Bilan)',
				'Investigations (Detail - Bilan)'
			]
		}

		return [
			'Investigations (Détail - Résultat)',
			'Investigations (Détail - Resultat)',
			'Investigations (Detail - Resultat)'
		]
	}

	private String switchToAnyWindowTitle(
			List<String> titles,
			Integer timeoutSeconds
		) {

		long endTime =
			System.currentTimeMillis() +
				(timeoutSeconds * 1000L)

		while (System.currentTimeMillis() <= endTime) {
			for (String title : titles) {
				try {
					Windows.switchToWindowTitle(title)
					return title
				} catch (Throwable ignored) {
				}
			}

			Windows.delay(POLLING_DELAY_SECONDS)
		}

		return ''
	}

	private void waitForImagePresent(
			String imageKey,
			Integer timeoutSeconds,
			String failureMessage
		) {

		if (!imageLoader.waitForImage(
			IMAGE_GROUP,
			imageKey,
			timeoutSeconds
		)) {
			takeEvidence(
				'Investigations_ImageNotFound_' +
					imageKey +
					'.png'
			)

			KeywordUtil.markFailedAndStop(
				failureMessage +
					'\nImage group: ' +
					IMAGE_GROUP +
					'\nImage key: ' +
					imageKey
			)
		}
	}

	private File validateExcelFile(
			String filePath,
			String description
		) {

		String path = safeText(filePath)
		File file = new File(path)

		if (path.isEmpty() ||
			!file.exists() ||
			!file.isFile()) {

			KeywordUtil.markFailedAndStop(
				description +
					' was not found:\n' +
					file.absolutePath
			)
		}

		if (file.length() <= 0L) {
			KeywordUtil.markFailedAndStop(
				description +
					' is empty: ' +
					file.name
			)
		}

		return file
	}

