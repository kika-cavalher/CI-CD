    private String safeValue(def value) {
        return value == null ? '' : String.valueOf(value).trim()
    }

    private boolean isBlank(def value) {
        return safeValue(value).isEmpty()
    }

    private String firstNonBlank(def... values) {
        values.each { def value ->
            if (!isBlank(value)) {
                return safeValue(value)
            }
        }
        return ''
    }

    private String htmlEscape(def value) {
        return safeValue(value)
            .replace('&', '&amp;')
            .replace('<', '&lt;')
            .replace('>', '&gt;')
            .replace('"', '&quot;')
            .replace("'", '&#39;')
    }

    private String jsEscape(def value) {
        return safeValue(value)
            .replace('\\', '\\\\')
            .replace("'", "\\'")
            .replace('"', '\\"')
    }

    private String ellipsis(def value, int maxLen) {
        String text = safeValue(value)
        if (text.size() <= maxLen) {
            return text
        }
        return text.substring(0, Math.max(0, maxLen - 3)).trim() + '...'
    }

    private String normalizeStatus(def raw) {
        String value = safeValue(raw).toLowerCase(Locale.ENGLISH)
        switch (value) {
            case 'passed':
            case 'pass':
            case 'success':
                return 'passed'
            case 'failed':
            case 'fail':
            case 'error':
                return 'failed'
            case 'skipped':
            case 'skip':
                return 'skipped'
            default:
                return 'info'
        }
    }

    private String capitalize(String value) {
        String text = safeValue(value)
        if (text.isEmpty()) {
            return ''
        }
        return text.substring(0, 1).toUpperCase(Locale.ENGLISH) + text.substring(1).toLowerCase(Locale.ENGLISH)
    }

    private String extractClock(def raw) {
        String text = safeValue(raw)
        if (text.isEmpty()) {
            return ''
        }

        def matcher = text =~ /(\\d{1,2}:\\d{2}:\\d{2}(?:\\s?[APap][Mm])?)/
        if (matcher.find()) {
            return safeValue(matcher.group(1)).replaceAll('\\s+', ' ')
        }

        return text
    }

    private String normalizeDurationLabel(Map raw) {
        if (raw == null) {
            return '00h 00m 00s'
        }

        long ms = 0L

        if (!isBlank(raw.durationMs)) {
            try {
                ms = Long.parseLong(safeValue(raw.durationMs))
            } catch (Exception ignored) {
                ms = 0L
            }
        }

        if (ms <= 0L) {
            ms = parseDurationToMillis(firstNonBlank(raw.elapsedRaw, raw.durationLabel, raw.duration, raw.elapsed))
        }

        return formatDuration(ms)
    }

    private long parseDurationToMillis(String raw) {
        String text = safeValue(raw)
        if (text.isEmpty()) {
            return 0L
        }

        def hms = text =~ /(\\d{1,2}):(\\d{2}):(\\d{2})(?:[\\.,](\\d+))?/
        if (hms.find()) {
            long h = hms.group(1).toLong()
            long m = hms.group(2).toLong()
            long s = hms.group(3).toLong()
            long ms = hms.group(4) ? normalizeMillisPart(hms.group(4)) : 0L
            return (((h * 60L + m) * 60L) + s) * 1000L + ms
        }

        long hours = 0L
        long minutes = 0L
        long seconds = 0L
        long millis = 0L

        def hourMatch = text =~ /(\\d+)\\s*h/
        if (hourMatch.find()) {
            hours = hourMatch.group(1).toLong()
        }

        def minuteMatch = text =~ /(\\d+)\\s*m/
        if (minuteMatch.find()) {
            minutes = minuteMatch.group(1).toLong()
        }

        def secondMatch = text =~ /(\\d+(?:[\\.,]\\d+)?)\\s*s/
        if (secondMatch.find()) {
            BigDecimal sec = new BigDecimal(secondMatch.group(1).replace(',', '.'))
            seconds = sec.longValue()
            millis = sec.subtract(new BigDecimal(seconds)).multiply(new BigDecimal('1000')).longValue()
        }

        def millisMatch = text =~ /(\\d+)\\s*ms/
        if (millisMatch.find()) {
            millis = millisMatch.group(1).toLong()
        }

        return (((hours * 60L + minutes) * 60L) + seconds) * 1000L + millis
    }

    private long normalizeMillisPart(String raw) {
        String value = safeValue(raw)
        if (value.isEmpty()) {
            return 0L
        }
        if (value.length() >= 3) {
            return Long.parseLong(value.substring(0, 3))
        }
        if (value.length() == 2) {
            return Long.parseLong(value) * 10L
        }
        return Long.parseLong(value) * 100L
    }

    private String formatDuration(long millis) {
        if (millis < 0L) {
            millis = 0L
        }

        long totalSeconds = Math.floor(millis / 1000L) as long
        long hours = Math.floor(totalSeconds / 3600L) as long
        long minutes = Math.floor((totalSeconds % 3600L) / 60L) as long
        long seconds = totalSeconds % 60L

        return pad2(hours) + 'h ' + pad2(minutes) + 'm ' + pad2(seconds) + 's'
    }

    private String pad2(long value) {
        String text = String.valueOf(value)
        return text.length() < 2 ? '0' + text : text
    }

    private double round1(double value) {
        return Math.round(value * 10d) / 10d
    }

    private String resolveStepIcon(String detail, String status) {
        String text = safeValue(detail).toLowerCase(Locale.ENGLISH)

        if (safeValue(status) == 'failed') {
            return '❌'
        }
        if (safeValue(status) == 'skipped') {
            return '⏭️'
        }
        if (text.contains('waiting')) {
            return '🔎'
        }
        if (text.contains('search')) {
            return '🔎'
        }
        if (text.contains('click')) {
            return '🖱️'
        }
        if (text.contains('open')) {
            return '🚪'
        }
        if (text.contains('fill')) {
            return '✍️'
        }
        if (text.contains('import')) {
            return '📄'
        }
        if (text.contains('file')) {
            return '📄'
        }
        if (text.contains('visible') || text.contains('loaded') || text.contains('passed') || text.contains('success')) {
            return '✅'
        }
        return 'ℹ️'
    }

    private String extractUnableToMessage(def raw) {
        String text = safeValue(raw)
        if (text.isEmpty()) {
            return ''
        }

        def matcher = text =~ /(Unable to click on object [^\\n\\r]+)/
        if (matcher.find()) {
            return matcher.group(1)
        }

        matcher = text =~ /(Unable to [^\\n\\r]+)/
        if (matcher.find()) {
            return matcher.group(1)
        }

        return text.readLines().find { String line -> !safeValue(line).isEmpty() } ?: ''
    }

    private String resolveAsset(String rawPath, Map model) {
        String value = safeValue(rawPath)
        if (value.isEmpty()) {
            return ''
        }

        if (value.startsWith('file:/') || value.startsWith('http://') || value.startsWith('https://') || value.startsWith('data:')) {
            return value
        }

        File direct = new File(value)
        if (direct.exists()) {
            return direct.toURI().toString()
        }

        List<File> candidates = []

        String userDir = System.getProperty('user.dir')
        if (!isBlank(userDir)) {
            candidates.add(new File(userDir, value))
        }

        String projectRoot = safeValue(model?.projectRoot)
        if (!isBlank(projectRoot)) {
            candidates.add(new File(projectRoot, value))
        }

        String reportFolder = safeValue(model?.reportFolder)
        if (!isBlank(reportFolder)) {
            candidates.add(new File(reportFolder, value))
        }

        candidates.each { File file ->
            if (file.exists()) {
                return file.toURI().toString()
            }
        }

        return value.replace('\\', '/')
    }
}
