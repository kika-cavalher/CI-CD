	@Keyword
	boolean waitForMainScreen() {
		KeywordUtil.logInfo("Waiting for main screen using HomeGrey image")

		String homeGreyImage = new File(RunConfiguration.getProjectDir(), 'Images/General/HomeGrey.png').getAbsolutePath()

		if (!imageFileExists(homeGreyImage)) {
			KeywordUtil.markFailedAndStop("HomeGrey image not found: ${homeGreyImage}")
		}

		long end = System.currentTimeMillis() + 60000L

		while (System.currentTimeMillis() < end) {
			focusLoginWindow(detectedWindowTitle)

			if (waitImagePresent(homeGreyImage, 2)) {
				KeywordUtil.logInfo("Main screen confirmed by HomeGrey image")
				return true
			}

			sleepMs(1000)
		}

		return false
	}

