package general

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil

class ImageLoader {

	private static final Map<String, Map<String, String>> IMAGE_GROUPS = [
		'authentication': [
			'home'      : 'Images/General/Home.PNG',
			'homeGrey'  : 'Images/General/HomeGrey.PNG',
			'homeWhite' : 'Images/General/HomeWhite.PNG'
		]

		// Add new image dictionaries here:
		// 'pnlComptable': [
		// 	 'menu': 'Images/PNL Comptable/PNLComptable.png'
		// ]
	]

	@Keyword
	String getImage(String imageGroup, String imageKey) {
		validateImage(imageGroup, imageKey)

		return buildImagePath(IMAGE_GROUPS[imageGroup][imageKey])
	}

	@Keyword
	boolean isVisible(String imageGroup, String imageKey) {
		String imagePath = getImage(imageGroup, imageKey)

		try {
			if (WindowsImageKeywords.findImage(imagePath) != null) {
				KeywordUtil.logInfo("Image found: " + imageGroup + " / " + imageKey)
				return true
			}
		} catch (Exception e) {
		}

		return false
	}

	@Keyword
	boolean isAnyVisible(String imageGroup, List<String> imageKeys) {
		for (String imageKey : imageKeys) {
			if (isVisible(imageGroup, imageKey)) {
				return true
			}
		}

		return false
	}

	@Keyword
	boolean click(String imageGroup, String imageKey) {
		String imagePath = getImage(imageGroup, imageKey)

		try {
			if (WindowsImageKeywords.findImage(imagePath) != null) {
				KeywordUtil.logInfo("Clicking image: " + imageGroup + " / " + imageKey)
				WindowsImageKeywords.clickImage(imagePath)
				return true
			}
		} catch (Exception e) {
		}

		return false
	}

	@Keyword
	boolean clickFirstVisible(String imageGroup, List<String> imageKeys) {
		for (String imageKey : imageKeys) {
			if (click(imageGroup, imageKey)) {
				return true
			}
		}

		return false
	}

	private String buildImagePath(String relativePath) {
		return new File(RunConfiguration.getProjectDir(), relativePath).getAbsolutePath()
	}

	private void validateImage(String imageGroup, String imageKey) {
		if (!IMAGE_GROUPS.containsKey(imageGroup)) {
			KeywordUtil.markFailedAndStop(
				"Image group not found: " + imageGroup + "\n" +
				"Available groups: " + IMAGE_GROUPS.keySet()
			)
		}

		if (!IMAGE_GROUPS[imageGroup].containsKey(imageKey)) {
			KeywordUtil.markFailedAndStop(
				"Image key not found: " + imageKey + "\n" +
				"Group: " + imageGroup + "\n" +
				"Available keys: " + IMAGE_GROUPS[imageGroup].keySet()
			)
		}
	}
}





























package pageObject

import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import java.awt.Robot
import java.awt.event.InputEvent
import java.awt.event.KeyEvent

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.testobject.WindowsTestObject.LocatorStrategy
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import internal.GlobalVariable

class authenticationKeywords {

	private static final String IMAGE_GROUP = 'authentication'

	private static final List<String> HOME_IMAGES = [
		'homeGrey',
		'homeWhite',
		'home'
	]

	@Keyword
	def launchApplication(String targetEnvironment) {
		String environment = normalizeEnvironment(targetEnvironment)

		if (System.getProperty('user.name') == GlobalVariable.username) {
			if (environment == 'REC') {
				String cmd = 'Powershell.exe -executionpolicy remotesigned -File D:\\setResolution.ps1'
				Runtime.getRuntime().exec(cmd)
			}

			Windows.startApplicationWithTitle(
				getShortcutPath(environment),
				getVersion(environment)
			)
		} else {
			if (environment == 'REC') {
				startWinAppDriver()
			}

			Windows.startApplication(getApplicationPath(environment))
		}
	}

	@Keyword
	def switchToVersionWindow(String targetEnvironment) {
		String environment = normalizeEnvironment(targetEnvironment)

		WindowsTestObject targetWindow = new WindowsTestObject()
		targetWindow.setLocatorStrategy(LocatorStrategy.NAME)
		targetWindow.setLocator(getVersion(environment))

		try {
			Windows.switchToDesktop()
			Windows.switchToWindow(targetWindow)

			KeywordUtil.logInfo("Successfully switched to window: " + targetWindow.getLocator())
			return true
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop(
				"Target window '" + targetWindow.getLocator() + "' was not found.\n" +
				"Environment received: " + targetEnvironment + "\n" +
				"Normalized environment: " + environment + "\n" +
				"Expected window title: " + targetWindow.getLocator() + "\n" +
				"Original error: " + e.getMessage()
			)
			return false
		}
	}

	@Keyword
	def openEnvironmentSelector(String targetEnvironment) {
		String environment = normalizeEnvironment(targetEnvironment)

		if (isProductionEnvironment(environment) && !isLoginScreenVisibleSafely()) {
			KeywordUtil.logInfo("PRD main screen seems already open. Environment selector is not needed.")
			return
		}

		boolean focused = tryFocusApplicationWindow(targetEnvironment, !isProductionEnvironment(environment))

		if (!focused && isProductionEnvironment(environment)) {
			KeywordUtil.logInfo("Could not focus PRD window, but PRD may already be open. Continuing.")
			return
		}

		if (!isLoginScreenVisibleSafely()) {
			KeywordUtil.logInfo("Login screen is not visible. Environment selector is not needed.")
			return
		}

		WindowsTestObject environmentCombo = findWindowsObject('Login Page/optEnv')

		boolean isComboPresent = Windows.verifyElementPresent(
			environmentCombo,
			5,
			FailureHandling.OPTIONAL
		)

		if (!isComboPresent) {
			if (isProductionEnvironment(environment)) {
				KeywordUtil.logInfo("PRD environment combo was not found. Continuing because PRD may already be authenticated.")
				return
			}

			KeywordUtil.markFailedAndStop(
				"Failed to focus Environment eMatch combo.\n" +
				"The login screen is visible, but the environment combo was not found.\n" +
				"Environment: " + environment
			)
		}

		clickElementCenterByCoordinates(environmentCombo)
		Windows.delay(1)

		KeywordUtil.logInfo("Environment eMatch combo focused.")
	}

	@Keyword
	def selectEnvironment(String targetEnvironment) {
		String environment = normalizeEnvironment(targetEnvironment)

		if (isProductionEnvironment(environment) && !isLoginScreenVisibleSafely()) {
			KeywordUtil.logInfo("PRD main screen seems already open. Environment selection is not needed.")
			return
		}

		boolean focused = tryFocusApplicationWindow(targetEnvironment, !isProductionEnvironment(environment))

		if (!focused && isProductionEnvironment(environment)) {
			KeywordUtil.logInfo("Could not focus PRD window, but PRD may already be open. Continuing.")
			return
		}

		if (!isLoginScreenVisibleSafely()) {
			KeywordUtil.logInfo("Login screen is not visible. Environment selection is not needed.")
			return
		}

		WindowsTestObject environmentCombo = findWindowsObject('Login Page/optEnv')

		boolean isComboPresent = Windows.verifyElementPresent(
			environmentCombo,
			5,
			FailureHandling.OPTIONAL
		)

		if (!isComboPresent) {
			if (isProductionEnvironment(environment)) {
				KeywordUtil.logInfo("PRD environment combo was not found. Continuing because PRD may already be authenticated.")
				return
			}

			KeywordUtil.markFailedAndStop(
				"Failed to select Environment eMatch.\n" +
				"The login screen is visible, but the environment combo was not found.\n" +
				"Environment: " + environment
			)
		}

		KeywordUtil.logInfo("Selecting only Environment eMatch: " + environment)

		clickElementCenterByCoordinates(environmentCombo)
		Windows.delay(1)

		selectFocusedEMatchComboByKeyboard(environment)

		KeywordUtil.logInfo("Environment eMatch selected: " + environment)
	}

	@Keyword
	def clickConnectIfPresent(String targetEnvironment) {
		String environment = normalizeEnvironment(targetEnvironment)

		if (isProductionEnvironment(environment) && !isLoginScreenVisibleSafely()) {
			KeywordUtil.logInfo("PRD main screen seems already open. Connect button is not needed.")
			return
		}

		boolean focused = tryFocusApplicationWindow(targetEnvironment, !isProductionEnvironment(environment))

		if (!focused && isProductionEnvironment(environment)) {
			KeywordUtil.logInfo("Could not focus PRD window, but PRD may already be open. Continuing.")
			return
		}

		if (!isLoginScreenVisibleSafely()) {
			KeywordUtil.logInfo("Login screen is not visible. Connect button is not needed.")
			return
		}

		WindowsTestObject connectButton = findWindowsObject('Login Page/btnConnecter')

		boolean isButtonPresent = Windows.verifyElementPresent(
			connectButton,
			5,
			FailureHandling.OPTIONAL
		)

		if (!isButtonPresent) {
			KeywordUtil.logInfo("Connect button was not present. Continuing test execution.")
			return
		}

		try {
			clickElementCenterByCoordinates(connectButton)
		} catch (Exception e) {
			KeywordUtil.logInfo("Coordinate click failed. Trying normal click. Reason: " + e.getMessage())
			Windows.click(connectButton, FailureHandling.OPTIONAL)
		}

		KeywordUtil.logInfo("Connect button clicked.")
		Windows.delay(8)
	}

	@Keyword
	def waitForMainScreen(String targetEnvironment) {
		KeywordUtil.logInfo("Waiting for main screen using image validation.")

		boolean isMainScreenVisible = waitForMainScreenByImageAndLoginClosed(90)

		if (!isMainScreenVisible) {
			KeywordUtil.markFailedAndStop(
				"Main screen was not validated after login.\n" +
				"Image group: " + IMAGE_GROUP + "\n" +
				"Expected keys: " + HOME_IMAGES.toString()
			)
		}

		KeywordUtil.logInfo("Main screen validated successfully using image.")
		Windows.delay(5)
	}

	@Keyword
	def multiFormatScreen(String targetEnvironment) {
		waitForMainScreen(targetEnvironment)
	}

	@Keyword
	def clickHomeTab(String targetEnvironment) {
		boolean activeHomeVisible = CustomKeywords.'general.ImageLoader.isVisible'(
			IMAGE_GROUP,
			'homeGrey'
		)

		if (activeHomeVisible) {
			KeywordUtil.logInfo("Home tab is already active.")
			return
		}

		boolean clickedHome = CustomKeywords.'general.ImageLoader.clickFirstVisible'(
			IMAGE_GROUP,
			['homeWhite', 'home']
		)

		if (!clickedHome) {
			KeywordUtil.markFailedAndStop(
				"Could not click Home tab.\n" +
				"Image group: " + IMAGE_GROUP + "\n" +
				"Expected keys: " + HOME_IMAGES.toString()
			)
		}

		Windows.delay(5)
	}

	private boolean waitForMainScreenByImageAndLoginClosed(int timeoutSeconds) {
		int elapsedSeconds = 0

		while (elapsedSeconds < timeoutSeconds) {
			boolean homeImageVisible = CustomKeywords.'general.ImageLoader.isAnyVisible'(
				IMAGE_GROUP,
				HOME_IMAGES
			)

			boolean loginVisible = isLoginScreenVisibleSafely()

			if (homeImageVisible && !loginVisible) {
				return true
			}

			Windows.delay(2)
			elapsedSeconds = elapsedSeconds + 2
		}

		return false
	}

	private boolean isLoginScreenVisibleSafely() {
		try {
			return Windows.verifyElementPresent(
				findWindowsObject('Login Page/btnConnecter'),
				2,
				FailureHandling.OPTIONAL
			)
		} catch (Exception e) {
			return false
		}
	}

	private void selectFocusedEMatchComboByKeyboard(String environment) {
		int downCount = getEMatchDownCount(environment)

		KeywordUtil.logInfo("Selecting Environment eMatch with keyboard. Environment: " + environment + ", down count: " + downCount)

		pressAltDown()
		Windows.delay(1)

		pressKey(KeyEvent.VK_HOME)
		Windows.delay(1)

		for (int i = 0; i < downCount; i++) {
			pressKey(KeyEvent.VK_DOWN)
			Windows.delay(1)
		}

		pressKey(KeyEvent.VK_ENTER)
		Windows.delay(2)

		KeywordUtil.logInfo("Environment eMatch selected with keyboard: " + environment)
	}

	private int getEMatchDownCount(String environment) {
		switch (environment) {
			case 'PRD':
			case 'PROD':
				return 0
			case 'PREX':
				return 1
			case 'REC2':
				return 2
			case 'REC':
				return 3
			case 'DEV2':
				return 4
			case 'DEV':
				return 5
			default:
				return 3
		}
	}

	private boolean isProductionEnvironment(String environment) {
		return environment == 'PRD' || environment == 'PROD'
	}

	private void pressAltDown() {
		Robot robot = new Robot()
		robot.setAutoDelay(200)

		robot.keyPress(KeyEvent.VK_ALT)
		robot.keyPress(KeyEvent.VK_DOWN)
		robot.keyRelease(KeyEvent.VK_DOWN)
		robot.keyRelease(KeyEvent.VK_ALT)
	}

	private void clickElementCenterByCoordinates(WindowsTestObject object) {
		def rect = Windows.getElementRect(object)

		int x = rect.getX() + Math.floor(rect.getWidth() / 2).intValue()
		int y = rect.getY() + Math.floor(getSafeHeight(rect) / 2).intValue()

		mouseClick(x, y)
	}

	private boolean tryFocusApplicationWindow(String targetEnvironment, boolean stopOnFailure) {
		String environment = normalizeEnvironment(targetEnvironment)

		WindowsTestObject targetWindow = new WindowsTestObject()
		targetWindow.setLocatorStrategy(LocatorStrategy.NAME)
		targetWindow.setLocator(getVersion(environment))

		try {
			Windows.switchToDesktop()
			Windows.switchToWindow(targetWindow)
			Windows.delay(1)
			return true
		} catch (Exception e) {
			if (stopOnFailure) {
				KeywordUtil.markFailedAndStop(
					"Could not focus application window.\n" +
					"Expected window title: " + getVersion(environment) + "\n" +
					"Reason: " + e.getMessage()
				)
			}

			KeywordUtil.logInfo(
				"Could not focus application window, continuing without fatal error.\n" +
				"Expected window title: " + getVersion(environment) + "\n" +
				"Reason: " + e.getMessage()
			)

			return false
		}
	}

	private int getSafeHeight(def rect) {
		int height = rect.getHeight()

		if (height <= 0) {
			return 20
		}

		return height
	}

	private void pressKey(int keyCode) {
		Robot robot = new Robot()
		robot.setAutoDelay(200)

		robot.keyPress(keyCode)
		robot.keyRelease(keyCode)
	}

	private void mouseClick(int x, int y) {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.mouseMove(x, y)
		Thread.sleep(150)

		robot.mousePress(InputEvent.BUTTON1_DOWN_MASK)
		Thread.sleep(150)
		robot.mouseRelease(InputEvent.BUTTON1_DOWN_MASK)

		Thread.sleep(300)
	}

	private String normalizeEnvironment(String targetEnvironment) {
		if (targetEnvironment == null || targetEnvironment.trim().isEmpty()) {
			return 'REC'
		}

		return targetEnvironment.trim().toUpperCase()
	}

	private String getVersion(String environment) {
		switch (environment) {
			case 'PRD':
				return GlobalVariable.versionProd
			default:
				return GlobalVariable.version
		}
	}

	private String getShortcutPath(String environment) {
		switch (environment) {
			case 'PRD':
				return 'D:\\RunAseMatchPRD\\eMatch.lnk'
			default:
				return 'D:\\RunAseMatchReq\\eMatch.lnk'
		}
	}

	private String getApplicationPath(String environment) {
		switch (environment) {
			case 'PRD':
				return '\\\\cib.net\\soft\\ematch\\IHM\\PROD\\IXIS.Ematch.IHM.application'
			default:
				return '\\\\cib.net\\shareparis\\Soft\\ematch\\IHM\\Livraisons\\REC\\IXIS.Ematch.IHM.application'
		}
	}

	private void startWinAppDriver() {
		String command = 'C:\\Program Files (x86)\\Windows Application Driver\\WinAppDriver.exe'
		ProcessBuilder builder = new ProcessBuilder(command).inheritIO()
		builder.start()
	}
}



