1) eMatchStarters\run-ematch-command.bat (INTEIRO)

✅ Lê run-context.properties
✅ Não fixa PROJECT_PATH
✅ Cria logs\
✅ Marker SEMPRE em D:\Projects\eMatchStarters\logs\ (evita AccessDenied no workspace)
✅ Mantém janela aberta e loga o console do Katalon
✅ Escreve exit code no marker para o Jenkins

@echo off
setlocal EnableExtensions EnableDelayedExpansion

title eMatch - Katalon Runner

REM ============================================================
REM  Fixed base (only for starters folder and logs)
REM ============================================================
set "STARTERS_DIR=D:\Projects\eMatchStarters"
set "CTX_FILE=%STARTERS_DIR%\run-context.properties"
set "LOG_DIR=%STARTERS_DIR%\logs"

if not exist "%LOG_DIR%" (
    mkdir "%LOG_DIR%" >nul 2>&1
)

REM ============================================================
REM  Read context from Jenkins (no hardcode of PROJECT_PATH)
REM ============================================================
if not exist "%CTX_FILE%" (
    echo [ERROR] Context file not found: "%CTX_FILE%"
    echo 2> "%LOG_DIR%\__jenkins_task_exitcode_missing_ctx.txt"
    exit /b 2
)

for /f "usebackq tokens=1,* delims==" %%A in ("%CTX_FILE%") do (
    set "K=%%A"
    set "V=%%B"
    if not "!K!"=="" (
        set "!K!=!V!"
    )
)

REM ============================================================
REM  Optional override: allow passing collection path as arg
REM ============================================================
if not "%~1"=="" (
    set "COLLECTION_PATH=%~1"
)

REM ============================================================
REM  Validate required fields
REM ============================================================
if "%WORKSPACE%"=="" (
    echo [ERROR] WORKSPACE is empty in run-context.properties
    set "EC=2"
    goto :WRITE_EXIT
)

if "%PROJECT_PATH%"=="" (
    echo [ERROR] PROJECT_PATH is empty in run-context.properties
    set "EC=2"
    goto :WRITE_EXIT
)

if "%KATALON_EXE%"=="" (
    echo [ERROR] KATALON_EXE is empty in run-context.properties
    set "EC=2"
    goto :WRITE_EXIT
)

if "%COLLECTION_PATH%"=="" (
    echo [ERROR] COLLECTION_PATH is empty in run-context.properties
    set "EC=2"
    goto :WRITE_EXIT
)

REM ============================================================
REM  Build LOG_FILE + MARKER_FILE (always in STARTERS logs)
REM ============================================================
for /f "tokens=1-3 delims=/ " %%a in ("%date%") do set "D=%%c%%b%%a"
for /f "tokens=1-3 delims=:." %%a in ("%time%") do set "T=%%a%%b%%c"
set "T=%T: =0%"

if "%LOG_FILE%"=="" (
    set "LOG_FILE=%LOG_DIR%\katalon_%D%_%T%.log"
)

if "%MARKER_FILE%"=="" (
    set "MARKER_FILE=%LOG_DIR%\__jenkins_task_exitcode_%D%_%T%.txt"
)

REM ============================================================
REM  Print effective config
REM ============================================================
echo.
echo [INFO] WORKSPACE      = "%WORKSPACE%"
echo [INFO] PROJECT_PATH   = "%PROJECT_PATH%"
echo [INFO] KATALON_EXE    = "%KATALON_EXE%"
echo [INFO] COLLECTION_PATH= "%COLLECTION_PATH%"
echo [INFO] BROWSER_TYPE   = "%BROWSER_TYPE%"
echo [INFO] LOG_FILE       = "%LOG_FILE%"
echo [INFO] MARKER_FILE    = "%MARKER_FILE%"
echo.

REM ============================================================
REM  Run Katalon and keep window visible
REM ============================================================
pushd "%WORKSPACE%" >nul 2>&1

"%KATALON_EXE%" ^
    -noSplash ^
    -runMode=console ^
    -consoleLog ^
    -projectPath="%PROJECT_PATH%" ^
    -testSuiteCollectionPath="%COLLECTION_PATH%" ^
    -browserType="%BROWSER_TYPE%" ^
    > "%LOG_FILE%" 2>&1

set "EC=%ERRORLEVEL%"

popd >nul 2>&1

:WRITE_EXIT
echo %EC%> "%MARKER_FILE%"

echo.
echo [INFO] Exit code = %EC%
echo [INFO] Marker written: "%MARKER_FILE%"
echo [INFO] Log written   : "%LOG_FILE%"
echo.

exit /b %EC%
2) eMatchStarters\archiveMode.bat (INTEIRO)

