import static com.kms.katalon.core.testcase.TestCaseFactory.findTestCase

import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

String targetEnvironment = 'REC'
String currencySetupTestCase = 'NOT FIX/Contre-valorisation IHM/Settings/Cotre Parameters - EUR'
String filterTestCase = 'NOT FIX/Contre-valorisation IHM/PLEconomique/FilterSection'

String menuName = 'PL Économique'
String menuResultName = 'PL Économique'
String exportLabel = 'EUR'



CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'Authenticate and open application\n' +
		'Environment: ' + targetEnvironment
)

WebUI.callTestCase(
		findTestCase('Component/Authentication/Login REC'),
		[:],
		FailureHandling.STOP_ON_FAILURE
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'Configure Cotre Parameters EUR\n' +
		'Test case: ' + currencySetupTestCase
)

WebUI.callTestCase(
		findTestCase(currencySetupTestCase),
		[:],
		FailureHandling.STOP_ON_FAILURE
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'Open Comparatif Inter menu\n' +
		'Search: ' + menuName + '\n' +
		'Result: ' + menuResultName
)

CustomKeywords.'component.MenuNavigator.searchAndOpenExactMenuByText'(menuName, menuResultName, 60)

Windows.delay(40)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'Apply filter for Comparatif Inter\n' +
		'Filter test case: ' + filterTestCase
)

WebUI.callTestCase(
		findTestCase(filterTestCase),
		[:],
		FailureHandling.STOP_ON_FAILURE
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'Export Comparatif Inter file for EUR\n' +
		'Export label: ' + exportLabel + '\n' +
		'Environment: ' + targetEnvironment
)

CustomKeywords.'commands.ExportFile.exportFromTwoExportImagesToNo'(
		exportLabel,
		targetEnvironment
)

WebUI.callTestCase(
		findTestCase('Component/Authentication/Close Application'),
		[:],
		FailureHandling.STOP_ON_FAILURE
)

KeywordUtil.markPassed(
		'REC Cotre Parameters EUR filter export completed successfully.'
)

WebUI.callTestCase(
	findTestCase('Test Cases/Component/Export Files/Export File Validation'),
	[
		('exportLabel')     : exportLabel,
		('requiredHeaders') : 'Devise|Devise de ref.|Montant ccy|Montant base ccy',
		('currencyHeaders') : 'Devise|Devise de ref.',
		('amountHeaders')   : 'Montant ccy|Montant base ccy'
	],
	FailureHandling.STOP_ON_FAILURE
)
