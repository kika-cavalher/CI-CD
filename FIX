/c "C:\Gaia\run_katalon_visible_from_jenkins.bat"


@echo off
setlocal EnableExtensions EnableDelayedExpansion

REM ============================================================
REM English comments only
REM This script:
REM  - Reads full Katalon args from a file generated by Jenkins (no input redirection)
REM  - Runs Katalon in VISIBLE Chrome (noHeadless)
REM  - Writes console output to a log file (so Jenkins can show progress)
REM  - Writes exit code to a file (so Jenkins can fail the build)
REM ============================================================

set "KATALON_HOME=C:\Users\adgi5appjenkins\Documents\Katalon_Studio_Engine_Windows_64-8.1.0"

set "ARGS_FILE=C:\Gaia\katalon_args.txt"
set "LOG_FILE=C:\Gaia\katalon_visible.log"
set "EXIT_FILE=C:\Gaia\katalon_visible.exit"

if not exist "%KATALON_HOME%\katalonc.exe" (
  echo [bat] ERROR: katalonc.exe not found at "%KATALON_HOME%\katalonc.exe"
  exit /b 3
)

if not exist "%ARGS_FILE%" (
  echo [bat] ERROR: Args file not found: "%ARGS_FILE%"
  exit /b 2
)

del /q "%EXIT_FILE%" >nul 2>&1

REM Read first line as the full args string WITHOUT using input redirection (<)
set "KATALON_ARGS="
for /f "usebackq delims=" %%A in ("%ARGS_FILE%") do (
  set "KATALON_ARGS=%%A"
  goto :gotArgs
)
:gotArgs

if "%KATALON_ARGS%"=="" (
  echo [bat] ERROR: Args file is empty: "%ARGS_FILE%"
  exit /b 4
)

echo [bat] Running Katalon with args from: %ARGS_FILE% > "%LOG_FILE%"
echo [bat] ---- ARGS START ---- >> "%LOG_FILE%"
echo %KATALON_ARGS% >> "%LOG_FILE%"
echo [bat] ---- ARGS END ---- >> "%LOG_FILE%"
echo. >> "%LOG_FILE%"

"%KATALON_HOME%\katalonc.exe" -noSplash -runMode=console %KATALON_ARGS% -browserType="Chrome" -noHeadless 1>> "%LOG_FILE%" 2>&1

echo %ERRORLEVEL%> "%EXIT_FILE%"
exit /b %ERRORLEVEL%













pipeline {
  agent { label 'GI5_SWDCFRNXGI55817' }

  parameters {
    booleanParam(name: 'SHOW_BROWSER', defaultValue: true, description: 'Show Chrome UI during execution')
  }

  stages {

    stage('Start Gaia Backend and Frontend') {
      steps {
        // Start backend/frontend via Windows Scheduled Task
        bat 'schtasks /run /tn "GaiaBackFrontSetup"'
        // Give services time to boot
        sleep(time: 300, unit: 'SECONDS')
      }
    }

    stage('Get bitbucket source code') {
      steps {
        // Clean workspace (best effort; do not fail build if something is locked)
        cleanWs(deleteDirs: true, disableDeferredWipeout: true, notFailBuild: true)
        // Checkout source code
        git credentialsId: '965eceec-b3a3-4ec5-8820-a857c87dd80f',
            url: 'https://bitbucket-mut.mycloud.intrabpce.fr/scm/gi5/gaia-portal.git'
      }
    }

    stage('GAIA TSC') {
      steps {
        script {
          // Fixed config (NOT parameters): suite collection is hardcoded here
          def PROJECT_PATH = 'D:/jenkins/work/workspace/GI5/Gaia/Gaia'
          def TSC_PATH     = 'Test Suites/GAIA TSC'
          def KATALON_HOME = 'C:/Users/adgi5appjenkins/Documents/Katalon_Studio_Engine_Windows_64-8.1.0'

          if (params.SHOW_BROWSER) {
            // Visible mode: Jenkins writes args, triggers task, tails log, reads exit code
            bat """
              if not exist C:\\Gaia mkdir C:\\Gaia

              rem Write args file (TC is fixed here, not a parameter)
              echo -projectPath="${PROJECT_PATH}" -testSuiteCollectionPath="${TSC_PATH}" -consoleLog -logLevel=DEBUG -reportFolder="${PROJECT_PATH}\\\\Reports" > C:\\Gaia\\katalon_args.txt

              rem Clean previous log/exit (best effort)
              del /q C:\\Gaia\\katalon_visible.log >NUL 2>&1
              del /q C:\\Gaia\\katalon_visible.exit >NUL 2>&1
            """

            bat 'schtasks /query /tn "GaiaKatalon_Visible"'
            bat 'schtasks /run /tn "GaiaKatalon_Visible"'

            // Wait log file, then keep printing the last lines until exit code file exists
            bat '''
              @echo off
              set LOG=C:\\Gaia\\katalon_visible.log
              set EXIT=C:\\Gaia\\katalon_visible.exit

              rem Wait log to appear
              set /a t=0
              :waitlog
              if exist "%LOG%" goto tailloop
              timeout /t 2 /nobreak >nul
              set /a t+=1
              if %t% GEQ 90 (
                echo [jenkins] ERROR: log file not created by task: %LOG%
                exit /b 1
              )
              goto waitlog

              :tailloop
              powershell -NoProfile -Command "Get-Content -Path '%LOG%' -Tail 60 -ErrorAction SilentlyContinue"
              if exist "%EXIT%" goto done
              timeout /t 8 /nobreak >nul
              goto tailloop

              :done
              for /f %%C in (%EXIT%) do set CODE=%%C
              echo [jenkins] Katalon exit code=%CODE%
              if not "%CODE%"=="0" exit /b %CODE%
            '''

          } else {
            // Headless mode: run inside Jenkins and capture exit code normally
            catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
              executeKatalon(
                executeArgs: "-projectPath=\"${PROJECT_PATH}\" -browserType=\"Chrome (headless)\" -testSuiteCollectionPath=\"${TSC_PATH}\" -consoleLog -logLevel=DEBUG -reportFolder=\"${PROJECT_PATH}\\\\Reports\"",
                location: KATALON_HOME,
                version: '',
                x11Display: '',
                xvfbConfiguration: ''
              )
            }
          }
        }
      }
    }
  }
}
