    void collectXmlFiles(File currentDir, List<File> preferred, List<File> secondary, List<File> fallback) {
        if (currentDir == null || !currentDir.exists() || !currentDir.isDirectory()) {
            return
        }

        File[] children = currentDir.listFiles()
        if (children == null || children.length == 0) {
            return
        }

        String primaryName = safe(PRIMARY_XML_FILE_NAME).toLowerCase()
        String secondaryName = safe(SECONDARY_XML_FILE_NAME).toLowerCase()

        for (File child : children) {
            if (child == null) {
                continue
            }

            if (child.isDirectory()) {
                collectXmlFiles(child, preferred, secondary, fallback)
                continue
            }

            String lowerName = safe(child.name).toLowerCase()

            if (lowerName == primaryName) {
                preferred.add(child)
            } else if (lowerName == secondaryName) {
                secondary.add(child)
            } else if (lowerName.endsWith('.xml')) {
                fallback.add(child)
            }
        }
    }

    String findXmlFile(String reportFolder) {
        if (isBlank(reportFolder)) {
            return ''
        }

        File root = new File(reportFolder)
        if (!root.exists() || !root.isDirectory()) {
            return ''
        }

        List<File> preferred = new ArrayList<File>()
        List<File> secondary = new ArrayList<File>()
        List<File> fallback = new ArrayList<File>()

        collectXmlFiles(root, preferred, secondary, fallback)

        if (!preferred.isEmpty()) {
            preferred.sort { a, b -> b.lastModified() <=> a.lastModified() }
            return preferred[0].absolutePath
        }

        if (!secondary.isEmpty()) {
            secondary.sort { a, b -> b.lastModified() <=> a.lastModified() }
            return secondary[0].absolutePath
        }

        if (!fallback.isEmpty()) {
            fallback = fallback.findAll { File f ->
                String path = safe(f.absolutePath).toLowerCase()
                return !path.contains(File.separator.toLowerCase() + 'requests' + File.separator.toLowerCase()) &&
                       !path.contains(File.separator.toLowerCase() + 'videos' + File.separator.toLowerCase())
            }

            if (!fallback.isEmpty()) {
                fallback.sort { a, b -> b.lastModified() <=> a.lastModified() }
                return fallback[0].absolutePath
            }
        }

        return ''
    }

    boolean isVisualEvidence(File file) {
        if (file == null || !file.exists() || !file.isFile()) {
            return false
        }

        String lower = safe(file.name).toLowerCase()
        return lower.endsWith('.png') ||
               lower.endsWith('.jpg') ||
               lower.endsWith('.jpeg') ||
               lower.endsWith('.webp') ||
               lower.endsWith('.gif') ||
               lower.endsWith('.bmp')
    }

    boolean shouldSkipVisualEvidence(File file) {
        if (!isVisualEvidence(file)) {
            return true
        }

        String path = safe(file.absolutePath).toLowerCase()
        String separator = File.separator.toLowerCase()

        if (path.contains(separator + 'requests' + separator)) return true
        if (path.contains(separator + 'videos' + separator)) return true
        if (path.endsWith(separator + safe(GAIA_REPORT_FILE_NAME).toLowerCase())) return true
        if (path.endsWith(separator + safe(RESULT_ZIP_NAME).toLowerCase())) return true
        if (path.endsWith(separator + safe(EVIDENCE_ZIP_NAME).toLowerCase())) return true

        return false
    }

    List<String> getCandidateEvidenceFolderNames() {
        LinkedHashSet<String> names = new LinkedHashSet<String>()
        names.add(safe(EVIDENCE_FOLDER_NAME))
        names.add('evidence')
        names.add('Evidences')
        return new ArrayList<String>(names.findAll { !isBlank(it) })
    }

    File getExistingEvidenceFolder(String reportFolder) {
        if (isBlank(reportFolder)) {
            return null
        }

        File leaf = new File(reportFolder)
        List<File> candidates = new ArrayList<File>()

        for (String name : getCandidateEvidenceFolderNames()) {
            candidates.add(new File(leaf, name))
            if (leaf.parentFile != null) {
                candidates.add(new File(leaf.parentFile, name))
            }
        }

        for (File candidate : candidates) {
            if (candidate != null && candidate.exists() && candidate.isDirectory()) {
                return candidate
            }
        }

        return null
    }

    List<File> getEvidenceSearchRoots(String reportFolder) {
        List<File> roots = new ArrayList<File>()

        if (isBlank(reportFolder)) {
            return roots
        }

        File leaf = new File(reportFolder)
        if (leaf.exists() && leaf.isDirectory()) {
            roots.add(leaf)
        }

        if (leaf.parentFile != null && leaf.parentFile.exists() && leaf.parentFile.isDirectory()) {
            roots.add(leaf.parentFile)
        }

        File evidenceFolder = getExistingEvidenceFolder(reportFolder)
        if (evidenceFolder != null) {
            roots.add(evidenceFolder)
        }

        return roots.unique { File item -> item.absolutePath }
    }

    void collectFailureImagesRecursive(File currentDir, List<File> images) {
        if (currentDir == null || !currentDir.exists() || !currentDir.isDirectory()) {
            return
        }

        File[] children = currentDir.listFiles()
        if (children == null || children.length == 0) {
            return
        }

        for (File child : children) {
            if (child == null) {
                continue
            }

            if (child.isDirectory()) {
                collectFailureImagesRecursive(child, images)
                continue
            }

            if (!shouldSkipVisualEvidence(child)) {
                images.add(child)
            }
        }
    }

    List<File> collectFailureImages(String reportFolder) {
        List<File> images = new ArrayList<File>()
        List<File> roots = getEvidenceSearchRoots(reportFolder)

        for (File root : roots) {
            collectFailureImagesRecursive(root, images)
        }

        Set<String> seen = new LinkedHashSet<String>()
        List<File> uniqueImages = new ArrayList<File>()

        for (File image : images) {
            String key = ''
            try {
                key = image.canonicalPath
            } catch (Exception ignored) {
                key = image.absolutePath
            }

            if (!seen.contains(key)) {
                seen.add(key)
                uniqueImages.add(image)
            }
        }

        uniqueImages.sort { a, b -> a.lastModified() <=> b.lastModified() }
        return uniqueImages
    }

    File findFileInReportTree(String reportFolder, String fileName) {
        if (isBlank(reportFolder) || isBlank(fileName)) {
            return null
        }

        File root = new File(reportFolder)
        if (!root.exists() || !root.isDirectory()) {
            return null
        }

        List<File> matches = new ArrayList<File>()
        collectNamedFiles(root, fileName, matches)

        if (matches.isEmpty()) {
            return null
        }

        matches.sort { a, b -> b.lastModified() <=> a.lastModified() }
        return matches[0]
    }

    void collectNamedFiles(File currentDir, String fileName, List<File> matches) {
        File[] children = currentDir.listFiles()
        if (children == null) {
            return
        }

        for (File child : children) {
            if (child.isDirectory()) {
                collectNamedFiles(child, fileName, matches)
            } else if (safe(child.name).equalsIgnoreCase(safe(fileName))) {
                matches.add(child)
            }
        }
    }

