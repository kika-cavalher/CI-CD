import javax.imageio.ImageIO

class JiraImagesEvidence {

	private static final SimpleDateFormat FILE_STAMP =
	new SimpleDateFormat('yyyyMMdd_HHmmss_SSS', Locale.ENGLISH)

	private static final SimpleDateFormat TRACE_STAMP =
	new SimpleDateFormat('yyyy-MM-dd HH:mm:ss.SSS', Locale.ENGLISH)

	private static final ThreadLocal<String> CURRENT_CASE_ID = new ThreadLocal<String>()

	@Keyword
	def startCase(String caseId) {
		String safeCaseId = safe(caseId)
		if (safeCaseId.isEmpty()) {
			return
		}

		CURRENT_CASE_ID.set(safeCaseId)
		ensureCaseFolder(safeCaseId)
	}

	@Keyword
	def finishCase() {
		CURRENT_CASE_ID.remove()
	}

	@Keyword
	def recordCaseStart(String caseId, long startMs) {
		String safeCaseId = safe(caseId)
		if (safeCaseId.isEmpty()) {
			return
		}

		startCase(safeCaseId)
		appendTrace('CASE_START', safeCaseId, String.valueOf(startMs))
	}

	@Keyword
	def recordCaseEnd(String caseId, long endMs) {
		String safeCaseId = safe(caseId)
		if (safeCaseId.isEmpty()) {
			return
		}

		appendTrace('CASE_END', safeCaseId, String.valueOf(endMs))
	}

	@Keyword
	def recordCaseStatus(String caseId, String status) {
		String safeCaseId = safe(caseId)
		if (safeCaseId.isEmpty()) {
			return
		}

		appendTrace('STATUS', safeCaseId, safe(status))
	}

	@Keyword
	def recordCaseDuration(String caseId, long durationMs) {
		String safeCaseId = safe(caseId)
		if (safeCaseId.isEmpty()) {
			return
		}

		appendTrace('DURATION', safeCaseId, String.valueOf(durationMs))
	}

	@Keyword
	def note(String message) {
		String caseId = resolveCurrentCaseId()
		if (caseId.isEmpty()) {
			return
		}

		String detail = safe(message)
		if (detail.isEmpty()) {
			return
		}

		appendTrace('REPORT_STEP', caseId, detail)
	}

	@Keyword
	def checkpoint(String message) {
		note(message)
	}

	@Keyword
	String captureNow(String label = 'manual') {
		String caseId = resolveCurrentCaseId()
		if (caseId.isEmpty()) {
			return ''
		}

		return captureForCase(caseId, label)
	}

	@Keyword
	String noteAndCapture(String message, String label = 'manual') {
		note(message)
		return captureNow(label)
	}

	@Keyword
	String autoFailure(String caseId) {
		String safeCaseId = safe(caseId)
		if (safeCaseId.isEmpty()) {
			return ''
		}

		startCase(safeCaseId)
		return captureForCase(safeCaseId, 'auto-failure')
	}

	private String captureForCase(String caseId, String label) {
		File folder = ensureCaseFolder(caseId)
		if (folder == null) {
			return ''
		}

		byte[] imageBytes = captureDriverScreenshotBytes()
		if (imageBytes == null || imageBytes.length == 0) {
			imageBytes = captureDesktopScreenshotBytes()
		}

		if (imageBytes == null || imageBytes.length == 0) {
			return ''
		}

		String safeLabel = sanitizeFileName(safe(label).isEmpty() ? 'capture' : label)
		String fileName = FILE_STAMP.format(new Date()) + '_' + safeLabel + '.png'
		File target = new File(folder, fileName)

		target.bytes = imageBytes

		appendTrace('EVIDENCE', caseId, target.absolutePath)
		KeywordUtil.logInfo('Evidence screenshot saved: ' + target.absolutePath)

		return target.absolutePath
	}

	private byte[] captureDriverScreenshotBytes() {
		try {
			def driver = Windows.getDriver()
			if (driver == null) {
				return null
			}

			byte[] raw = driver.getScreenshotAs(OutputType.BYTES)
			if (raw != null && raw.length > 0) {
				return raw
			}
		} catch (Throwable ignored) {
		}

		return null
	}

	private byte[] captureDesktopScreenshotBytes() {
		try {
			Rectangle rect = new Rectangle(Toolkit.getDefaultToolkit().getScreenSize())
			BufferedImage image = new Robot().createScreenCapture(rect)
			BufferedImage normalized = normalizeImage(image)

			ByteArrayOutputStream baos = new ByteArrayOutputStream()
			ImageIO.write(normalized, 'png', baos)
			return baos.toByteArray()
		} catch (Throwable ignored) {
			return null
		}
	}

	private BufferedImage normalizeImage(BufferedImage input) {
		if (input == null) {
			return null
		}

		int width = input.width
		int height = input.height

		if (width <= 1600) {
			return input
		}

		double scale = 1600d / (double) width
		int targetWidth = 1600
		int targetHeight = Math.max(1, (int) Math.round(height * scale))

		BufferedImage output = new BufferedImage(targetWidth, targetHeight, BufferedImage.TYPE_INT_RGB)
		Graphics2D g = output.createGraphics()
		try {
			g.drawImage(input, 0, 0, targetWidth, targetHeight, null)
		} finally {
			g.dispose()
		}

		return output
	}

	private File ensureCaseFolder(String caseId) {
		File root = new File(RunConfiguration.getReportFolder(), 'Evidences')
		if (!root.exists()) {
			root.mkdirs()
		}

		File caseFolder = new File(root, sanitizeCaseFolderName(caseId))
		if (!caseFolder.exists()) {
			caseFolder.mkdirs()
		}

		return caseFolder
	}

	private String resolveCurrentCaseId() {
		String caseId = safe(CURRENT_CASE_ID.get())
		return caseId
	}

	private void appendTrace(String type, String caseId, String value) {
		File traceFile = new File(RunConfiguration.getReportFolder(), 'custom-report-trace.log')
		if (traceFile.parentFile != null && !traceFile.parentFile.exists()) {
			traceFile.parentFile.mkdirs()
		}

		String line = TRACE_STAMP.format(new Date()) +
				'\t' + safe(type) +
				'\t' + encode64(caseId) +
				'\t' + encode64(value) +
				System.lineSeparator()

		synchronized (JiraImagesEvidence.class) {
			traceFile.append(line, 'UTF-8')
		}
	}

	private String encode64(String value) {
		return Base64.encoder.encodeToString(safe(value).getBytes(StandardCharsets.UTF_8))
	}

	static String decode64(String value) {
		if (value == null || value.trim().isEmpty()) {
			return ''
		}

		try {
			return new String(Base64.decoder.decode(value.trim()), StandardCharsets.UTF_8)
		} catch (Throwable ignored) {
			return ''
		}
	}

	static String sanitizeCaseFolderName(String value) {
		String text = safeStatic(value)
				.replace('\\', '_')
				.replace('/', '_')
				.replaceAll('[^A-Za-z0-9._-]+', '_')
				.replaceAll('_+', '_')
				.replaceAll('^_+', '')
				.replaceAll('_+\$', '')

		if (text.isEmpty()) {
			text = 'scenario'
		}

		if (text.length() > 140) {
			text = text.substring(0, 140)
		}

		return text
	}

	private String sanitizeFileName(String value) {
		String text = safe(value)
				.replace('\\', '_')
				.replace('/', '_')
				.replaceAll('[^A-Za-z0-9._-]+', '_')
				.replaceAll('_+', '_')
				.replaceAll('^_+', '')
				.replaceAll('_+\$', '')

		return text.isEmpty() ? 'capture' : text
	}

	private String safe(Object value) {
		return safeStatic(value)
	}

	private static String safeStatic(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}
}





package jiraIntegration

import java.io.BufferedReader
import java.io.File
import java.io.FileInputStream
import java.io.InputStreamReader
