		int sheetIndex =
				parseIntOrZero(sheetIndexText)

		for (File file : files) {

			String validationType =
					resolveValidationTypeForFile(
					file,
					defaultValidationType
					)

			boolean needCurrencyRef =
					isCurrencyRefRequired(
					validationType
					)

			String fileErrors =
					validateRequiredHeadersForFile(
					file,
					validationType,
					sheetIndex,
					headerCurrency,
					headerCurrencyRef,
					headerAmountCcy,
					headerAmountBaseCcy,
