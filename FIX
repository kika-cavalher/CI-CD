findstr /n "^" C:\Gaia\run_katalon_visible_from_jenkins.bat

@echo off
setlocal EnableExtensions EnableDelayedExpansion

REM English comments only
REM This script is called by Task Scheduler.
REM Jenkins must create: C:\Gaia\katalon_args.txt (one single line with args).
REM This script runs Katalon with visible Chrome (noHeadless).
REM IMPORTANT: do NOT use any input/output redirection (<, >, >>, 2>&1) here.

set "KATALON_HOME=C:\Users\adgi5appjenkins\Documents\Katalon_Studio_Engine_Windows_64-8.1.0"
set "ARGS_FILE=C:\Gaia\katalon_args.txt"

if not exist "%KATALON_HOME%\katalonc.exe" (
  echo [bat] ERROR: katalonc.exe not found at "%KATALON_HOME%\katalonc.exe"
  exit /b 3
)

if not exist "%ARGS_FILE%" (
  echo [bat] ERROR: Args file not found: "%ARGS_FILE%"
  exit /b 2
)

set "KATALON_ARGS="
for /f "usebackq delims=" %%A in ("%ARGS_FILE%") do (
  set "KATALON_ARGS=%%A"
  goto :gotArgs
)
:gotArgs

if "%KATALON_ARGS%"=="" (
  echo [bat] ERROR: Args file is empty: "%ARGS_FILE%"
  exit /b 4
)

echo [bat] Running Katalon with args:
echo [bat] %KATALON_ARGS%

"%KATALON_HOME%\katalonc.exe" -noSplash -runMode=console %KATALON_ARGS% -browserType="Chrome" -noHeadless
exit /b %ERRORLEVEL%
