package component

import static com.kms.katalon.core.testdata.TestDataFactory.findTestData

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testdata.TestData
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import commands.ImageLoader
import commands.WindowsObjectLoader

class RechercheFilterKeywords {

	private ImageLoader imageLoader = new ImageLoader()

	@Keyword
	void applyAsOfDateFilter(
			String asOfDateValue,
			Integer timeoutSeconds
	) {
		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 5 : timeoutSeconds

		if (asOfDateValue == null || asOfDateValue.trim().isEmpty()) {
			KeywordUtil.markFailedAndStop(
				'As Of Date value is empty.'
			)
		}

		String safeAsOfDateValue = asOfDateValue.trim()

		addNote(
			'Configure Recherche filter\n' +
			'Filter: As Of Date\n' +
			'Value: ' + safeAsOfDateValue
		)

		openRechercheTab(safeTimeout)
		setAsOfDate(safeAsOfDateValue, safeTimeout)
		clickRechercher(safeTimeout)

		Windows.delay(5)

		imageLoader.takeEvidence(
			'Recherche_Filter_Applied.png'
		)
	}

	@Keyword
	void applyAsOfDateFilterFromTestData(
			String testDataPath,
			Integer rowIndex,
			Integer columnIndex,
			Integer timeoutSeconds
	) {
		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 5 : timeoutSeconds

		String asOfDateValue = getTestDataValue(
			testDataPath,
			rowIndex,
			columnIndex
		)

		applyAsOfDateFilter(
			asOfDateValue,
			safeTimeout
		)
	}

	private void openRechercheTab(Integer timeoutSeconds) {
		addNote(
			'Open Recherche tab\n' +
			'Image: rechercheTab'
		)

		if (!imageLoader.waitForImage('General', 'rechercheTab', timeoutSeconds)) {
			imageLoader.takeEvidence(
				'RechercheTabNotFound.png'
			)

			KeywordUtil.markFailedAndStop(
				'Recherche tab image was not found.\n' +
				'Expected image key: rechercheTab'
			)
		}

		String rechercheImage = imageLoader.getImage(
			'General',
			'rechercheTab'
		)

		WindowsImageKeywords.clickImage(rechercheImage)

		Windows.delay(1)
	}

	private void setAsOfDate(String asOfDateValue, Integer timeoutSeconds) {
		addNote(
			'Fill As Of Date field\n' +
			'Value: ' + asOfDateValue
		)

		WindowsTestObject asOfDateField = WindowsObjectLoader.getObject(
			'jvEmission',
			'asOfDateField'
		)

		if (!Windows.waitForElementPresent(
				asOfDateField,
				timeoutSeconds,
				FailureHandling.OPTIONAL
		)) {
			imageLoader.takeEvidence(
				'AsOfDateFieldNotFound.png'
			)

			KeywordUtil.markFailedAndStop(
				'As Of Date field was not found.'
			)
		}

		Windows.click(asOfDateField)
		Windows.clearText(asOfDateField)
		Windows.sendKeys(asOfDateField, asOfDateValue)
	}

	private void clickRechercher(Integer timeoutSeconds) {
		addNote(
			'Click Rechercher button'
		)

		WindowsTestObject rechercherButton = WindowsObjectLoader.getObject(
			'filter',
			'rechercherButton'
		)

		if (!Windows.waitForElementPresent(
				rechercherButton,
				timeoutSeconds,
				FailureHandling.OPTIONAL
		)) {
			rechercherButton = WindowsObjectLoader.getObject(
				'filter',
				'rechercherButtonByName'
			)
		}

		if (!Windows.waitForElementPresent(
				rechercherButton,
				timeoutSeconds,
				FailureHandling.OPTIONAL
		)) {
			imageLoader.takeEvidence(
				'RechercherButtonNotFound.png'
			)

			KeywordUtil.markFailedAndStop(
				'Rechercher button was not found.'
			)
		}

		Windows.click(rechercherButton)
	}

	private String getTestDataValue(String testDataPath, Integer rowIndex, Integer columnIndex) {
		int safeRowIndex = rowIndex == null || rowIndex <= 0 ? 1 : rowIndex
		int safeColumnIndex = columnIndex == null || columnIndex <= 0 ? 1 : columnIndex

		TestData data = findTestData(testDataPath)

		String value = data.getObjectValue(
			safeColumnIndex,
			safeRowIndex
		)

		if (value == null || value.trim().isEmpty()) {
			KeywordUtil.markFailedAndStop(
				'Test data value is empty.\n' +
				'Test data: ' + testDataPath + '\n' +
				'Row: ' + safeRowIndex + '\n' +
				'Column: ' + safeColumnIndex
			)
		}

		return value.trim()
	}

	private void addNote(String message) {
		try {
			new jiraIntegration.JiraReportSteps().note(message)
		} catch (Throwable ignored) {
			KeywordUtil.logInfo(message)
		}
	}
}


import static com.kms.katalon.core.testcase.TestCaseFactory.findTestCase

import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

String targetEnvironment = 'REC'

String exportScenarioName = 'JVEmission_ElementValorise'
String menuName = 'Elément Valorisé'
String menuResultName = 'Elément Valorisé'
String openedTabName = menuResultName

String asOfDateValue = '30/04/2010'

String loginTestCase = 'Component/Authentication/Login ' + targetEnvironment
String closeApplicationTestCase = 'Component/Authentication/Close Application'
String exportCurrentTableTestCase = 'Component/Export Files/Export Current Table By Outils'

Integer menuTimeout = 60
Integer filterTimeout = 5
Integer openedTabTimeout = 60

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Authenticate and open application\n' +
	'Environment: ' + targetEnvironment
)

WebUI.callTestCase(
	findTestCase(loginTestCase),
	[:],
	FailureHandling.STOP_ON_FAILURE
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Open target module\n' +
	'Search: ' + menuName + '\n' +
	'Result: ' + menuResultName
)

CustomKeywords.'component.MenuNavigator.searchAndOpenMenuByText'(
	menuName,
	menuResultName,
	menuTimeout
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Validate opened tab\n' +
	'Expected tab: ' + openedTabName
)

if (!Windows.waitForElementPresent(
		CustomKeywords.'commands.WindowsObjectLoader.getTabByName'(openedTabName),
		openedTabTimeout,
		FailureHandling.OPTIONAL
)) {
	CustomKeywords.'commands.ImageLoader.takeEvidence'(
		targetEnvironment + '_ElementValorise_TabNotOpened.png'
	)

	KeywordUtil.markFailedAndStop(
		'Element Valorise tab was not opened.\n' +
		'Expected tab: ' + openedTabName
	)
}

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	targetEnvironment + '_OpenElementValorise.png'
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Apply Recherche filter\n' +
	'Filter: As Of Date\n' +
	'Value: ' + asOfDateValue
)

CustomKeywords.'component.RechercheFilterKeywords.applyAsOfDateFilter'(
	asOfDateValue,
	filterTimeout
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Validate result after search\n' +
	'Check whether rows are available before export'
)

Integer rowsResult = CustomKeywords.'com.katalon.ematch.helper.EmatchHelper.checkForRows'()

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Rows validation result\n' +
	'Menu: ' + menuResultName + '\n' +
	'Result: ' + rowsResult
)

if (rowsResult != 0) {
	CustomKeywords.'commands.ImageLoader.takeEvidence'(
		targetEnvironment + '_ElementValorise_NoExportRowsResult.png'
	)

	KeywordUtil.markFailedAndStop(
		'Rows validation did not allow export.\n' +
		'Menu: ' + menuResultName + '\n' +
		'Result: ' + rowsResult
	)
}

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	targetEnvironment + '_ElementValorise_SearchResult.png'
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Export current table\n' +
	'Environment: ' + targetEnvironment + '\n' +
	'Export scenario: ' + exportScenarioName
)

WebUI.callTestCase(
	findTestCase(exportCurrentTableTestCase),
	[
		('targetEnvironment') : targetEnvironment,
		('exportScenarioName'): exportScenarioName
	],
	FailureHandling.STOP_ON_FAILURE
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Close opened tab\n' +
	'Tab: ' + openedTabName
)

CustomKeywords.'component.CloseTabKeywords.closeTabByName'(
	openedTabName,
	30
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Close application'
)

WebUI.callTestCase(
	findTestCase(closeApplicationTestCase),
	[:],
	FailureHandling.STOP_ON_FAILURE
)

KeywordUtil.markPassed(
	targetEnvironment + ' Element Valorise validation completed successfully.'
)

