    private String firstNonBlank(String... values) {
        for (String value : values) {
            if (value != null && value.toString().trim()) {
                return value.toString().trim()
            }
        }
        return ''
    }

    private String gv(String name) {
        try {
            def value = GlobalVariable."${name}"
            return value == null ? '' : value.toString().trim()
        } catch (Throwable ignored) {
            return ''
        }
    }

    private String currentEnv() {
        return firstNonBlank(
            gv('env'),
            gv('environment'),
            'REC'
        ).toUpperCase()
    }

    private void keyPress(int keyCode) {
        Robot robot = new Robot()
        robot.setAutoDelay(120)
        robot.keyPress(keyCode)
        robot.keyRelease(keyCode)
    }

    private void keyPressCombo(int modifier, int keyCode) {
        Robot robot = new Robot()
        robot.setAutoDelay(120)
        robot.keyPress(modifier)
        robot.keyPress(keyCode)
        robot.keyRelease(keyCode)
        robot.keyRelease(modifier)
    }

    private void keyPressMultiple(int keyCode, int times) {
        for (int i = 0; i < times; i++) {
            keyPress(keyCode)
        }
    }

    private boolean isPortOpen(String host, int port, int timeoutMs = 1000) {
        Socket socket = null
        try {
            socket = new Socket()
            socket.connect(new InetSocketAddress(host, port), timeoutMs)
            return true
        } catch (Throwable ignored) {
            return false
        } finally {
            try {
                socket?.close()
            } catch (Throwable ignored) {
            }
        }
    }

    private boolean waitForPort(String host, int port, int maxSeconds) {
        for (int i = 1; i <= maxSeconds; i++) {
            if (isPortOpen(host, port, 1000)) {
                KeywordUtil.logInfo("Port ${port} open on ${host} at attempt ${i}")
                return true
            }
            Windows.delay(1)
        }
        return false
    }

    private String runCommand(String... command) {
        Process process = new ProcessBuilder(command)
            .redirectErrorStream(true)
            .start()

        String output = process.inputStream.getText('CP1252')
        process.waitFor()
        return output == null ? '' : output.trim()
    }

    private String runPowerShell(String command) {
        Process process = new ProcessBuilder(
            'powershell',
            '-NoProfile',
            '-ExecutionPolicy',
            'Bypass',
            '-Command',
            command
        ).redirectErrorStream(true).start()

        String output = process.inputStream.getText('CP1252')
        process.waitFor()
        return output == null ? '' : output.trim()
    }

    private boolean processExists(String imageName) {
        try {
            String output = runCommand(
                'cmd',
                '/c',
                "tasklist /FI \"IMAGENAME eq ${imageName}\""
            )
            return output.toLowerCase().contains(imageName.toLowerCase())
        } catch (Throwable ignored) {
            return false
        }
    }

    private boolean waitForProcess(String imageName, int maxSeconds) {
        for (int i = 1; i <= maxSeconds; i++) {
            if (processExists(imageName)) {
                KeywordUtil.logInfo("Process '${imageName}' detected at attempt ${i}")
                return true
            }
            Windows.delay(1)
        }
        return false
    }

    private void killProcessIfExists(String imageName) {
        try {
            if (!processExists(imageName)) {
                return
            }

            KeywordUtil.logInfo("Killing existing process ${imageName}")
            runCommand(
                'cmd',
                '/c',
                "taskkill /F /T /IM \"${imageName}\""
            )
            Windows.delay(2)
        } catch (Throwable e) {
            KeywordUtil.logInfo("Could not kill ${imageName}: ${e.message}")
        }
    }

    private void bringWindowToFront(String title) {
        if (!title?.trim()) {
            return
        }

        try {
            String escapedTitle = title.replace("'", "''")
            runPowerShell("(New-Object -ComObject WScript.Shell).AppActivate('${escapedTitle}') | Out-Null")
            Windows.delay(1)
            KeywordUtil.logInfo("AppActivate executed for title: ${title}")
        } catch (Throwable e) {
            KeywordUtil.logInfo("Could not bring window to front: ${e.message}")
        }
    }

    private void launchWithShell(String path) {
        if (!path?.trim()) {
            return
        }

        KeywordUtil.logInfo("Launching through shell: ${path}")

        new ProcessBuilder(
            'cmd',
            '/c',
            "start \"\" \"${path}\""
        ).redirectErrorStream(true).start()
    }

    private String readMainWindowTitle() {
        try {
            String command =
                '$p = Get-Process "IXIS.eMatch.IHM" -ErrorAction SilentlyContinue | ' +
                'Where-Object { $_.MainWindowTitle -and $_.MainWindowTitle.Trim().Length -gt 0 } | ' +
                'Sort-Object StartTime -Descending | Select-Object -First 1; ' +
                'if ($p) { $p.MainWindowTitle }'
            return runPowerShell(command)
        } catch (Throwable ignored) {
            return ''
        }
    }

    private String waitForMainWindowTitle(String expectedTitle, int maxSeconds) {
        String normalizedExpected = expectedTitle == null ? '' : expectedTitle.trim()

        for (int i = 1; i <= maxSeconds; i++) {
            String detectedTitle = readMainWindowTitle()

            if (detectedTitle) {
                KeywordUtil.logInfo("Detected main window title at attempt ${i}: ${detectedTitle}")

                if (!normalizedExpected) {
                    return detectedTitle
                }

                if (detectedTitle.equalsIgnoreCase(normalizedExpected) ||
                    detectedTitle.toLowerCase().contains(normalizedExpected.toLowerCase()) ||
                    normalizedExpected.toLowerCase().contains(detectedTitle.toLowerCase())) {
                    return detectedTitle
                }

                return detectedTitle
            }

            Windows.delay(1)
        }

        return ''
    }

    private void ensureWinAppDriverStarted() {
        if (isPortOpen('127.0.0.1', WINAPPDRIVER_PORT, 1000)) {
            KeywordUtil.logInfo("WinAppDriver already running on 127.0.0.1:${WINAPPDRIVER_PORT}")
            return
        }

        String exePath = getWinAppDriverPath()
        if (!exePath) {
            throw new Exception('WinAppDriver path is empty.')
        }

        KeywordUtil.logInfo("Starting WinAppDriver minimized from ${exePath}")

        new ProcessBuilder(
            'cmd',
            '/c',
            "start \"\" /min \"${exePath}\""
        ).redirectErrorStream(true).start()

        if (!waitForPort('127.0.0.1', WINAPPDRIVER_PORT, WAIT_PORT_SECONDS)) {
            throw new Exception("WinAppDriver did not open port ${WINAPPDRIVER_PORT}.")
        }

        Windows.delay(2)
        KeywordUtil.logInfo('WinAppDriver is ready')
    }

    private WindowsDriver createRootDriver() {
        DesiredCapabilities caps = new DesiredCapabilities()
        caps.setCapability('platformName', 'Windows')
        caps.setCapability('deviceName', 'WindowsPC')
        caps.setCapability('app', 'Root')
        caps.setCapability('ms:waitForAppLaunch', '60')

        return new WindowsDriver(new URL("http://127.0.0.1:${WINAPPDRIVER_PORT}"), caps)
    }

    private WindowsDriver attachToTopLevelWindow(String nativeHandle) {
        String handle = nativeHandle?.trim()
        if (!handle) {
            throw new Exception('Native window handle is empty.')
        }

        String topLevelHandle = handle

        if (handle.toLowerCase().startsWith('0x')) {
            topLevelHandle = handle.substring(2)
        } else {
            try {
                topLevelHandle = Long.toHexString(Long.parseLong(handle))
            } catch (Throwable ignored) {
                topLevelHandle = handle
            }
        }

        topLevelHandle = topLevelHandle.toUpperCase()

        KeywordUtil.logInfo("Attaching by NativeWindowHandle: ${topLevelHandle}")

        DesiredCapabilities caps = new DesiredCapabilities()
        caps.setCapability('platformName', 'Windows')
        caps.setCapability('deviceName', 'WindowsPC')
        caps.setCapability('appTopLevelWindow', topLevelHandle)
        caps.setCapability('ms:waitForAppLaunch', '60')

        return new WindowsDriver(new URL("http://127.0.0.1:${WINAPPDRIVER_PORT}"), caps)
    }

    private WebElement findWindowElementByNames(WindowsDriver driver, List<String> names) {
        for (String name : names) {
            if (!name?.trim()) {
                continue
            }

            List<WebElement> found = driver.findElements(By.name(name))
            if (found != null && !found.isEmpty()) {
                KeywordUtil.logInfo("Window element found by name: ${name}")
                return found[0]
            }
        }
        return null
    }

    private String resolveMainWindowHandleFromRoot(List<String> titles) {
        rootDriver = createRootDriver()

        for (int i = 1; i <= 20; i++) {
            try {
                WebElement mainWindow = findWindowElementByNames(rootDriver, titles)
                if (mainWindow != null) {
                    String handle = mainWindow.getAttribute('NativeWindowHandle')
                    if (handle?.trim()) {
                        KeywordUtil.logInfo("NativeWindowHandle found at attempt ${i}: ${handle}")
                        return handle.trim()
                    }
                }
            } catch (Throwable e) {
                KeywordUtil.logInfo("Root lookup attempt ${i} failed: ${e.message}")
            }

            Windows.delay(1)
        }

        return ''
    }

    private void closeRootDriverQuietly() {
        try {
            rootDriver?.quit()
        } catch (Throwable ignored) {
        }
        rootDriver = null
    }

    private void closeAppDriverQuietly() {
        try {
            appDriver?.quit()
        } catch (Throwable ignored) {
        }
        appDriver = null
    }

    private boolean waitForAnchorImage(String imagePath, int maxSeconds, String liveTitle) {
        if (!imagePath?.trim()) {
            return false
        }

        File anchorFile = new File(imagePath)
        if (!anchorFile.exists()) {
            KeywordUtil.logInfo("Anchor image not found: ${imagePath}")
            return false
        }

        for (int i = 1; i <= maxSeconds; i++) {
            try {
                bringWindowToFront(liveTitle)
                WindowsImageKeywords.clickImage(imagePath)
                KeywordUtil.logInfo("Anchor image detected at attempt ${i}: ${imagePath}")
                Windows.delay(1)
                return true
            } catch (Throwable ignored) {
                Windows.delay(1)
            }
        }

        return false
    }

    private List<WebElement> findComboBoxes() {
        if (appDriver == null) {
            return []
        }

        try {
            return appDriver.findElements(By.className('ComboBox'))
        } catch (Throwable ignored) {
            return []
        }
    }

    private WebElement findButtonContaining(String text) {
        if (appDriver == null) {
            return null
        }

        try {
            List<WebElement> buttons = appDriver.findElements(By.className('Button'))
            for (WebElement button : buttons) {
                String name = ''
                try {
                    name = button.getText()
                } catch (Throwable ignored) {
                }

                if (!name?.trim()) {
                    try {
                        name = button.getAttribute('Name')
                    } catch (Throwable ignored) {
                    }
                }

                if (name?.toLowerCase()?.contains(text.toLowerCase())) {
                    return button
                }
            }
        } catch (Throwable ignored) {
        }

        return null
    }

    private boolean loginDialogExists() {
        if (appDriver == null) {
            return false
        }

        try {
            List<WebElement> dialogs = appDriver.findElements(By.name('Se connecter à eMatch'))
            return dialogs != null && !dialogs.isEmpty()
        } catch (Throwable ignored) {
            return false
        }
    }

