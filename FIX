		card.append('<div class="passed-content">')

		card.append('<div class="test-path">')
		card.append(safeHtml((item.className ?: '') + '/' + (item.testName ?: '')))
		card.append('</div>')

		card.append('<div class="message-line">Test Passed</div>')

		card.append('<div class="duration-line">Duration: ')
		card.append(safeHtml(formatDurationSeconds(item.timeSeconds as BigDecimal)))
		card.append('</div>')

		card.append('</div>')
		card.append('</div>')

		return card.toString()
	}

