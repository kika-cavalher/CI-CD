	private boolean rightClickImageWithinTimeout(
			String imagePath,
			Integer timeoutSeconds
	) {

		Integer timeout =
				safeTimeout(
				timeoutSeconds,
				5
				)

		for (
		Integer second = 1;
				second <= timeout;
				second++
				) {
			try {
				def found =
