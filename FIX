					'Recherche_AsOfDateFieldNotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					'As Of Date field was not found.\n' +
					'Object: Object Repository/PNL Comptable/asOfDateFilterPNLEco'
					)

			return
		}

		addNote(
				'Step 2. Fill As Of Date field\n' +
				'Value: ' +
				safeAsOfDateValue
				)

		Windows.setText(
				asOfDateField,
				safeAsOfDateValue,
				FailureHandling.STOP_ON_FAILURE
				)

		Windows.delay(1)

		WindowsTestObject searchButton =
				findWindowsObject(
				'General/btnSearch'
				)

		if (!Windows.waitForElementPresent(
				searchButton,
				safeTimeout,
				FailureHandling.OPTIONAL
				)) {

			imageLoader.takeEvidence(
					'Recherche_SearchButtonNotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					'Rechercher button was not found.\n' +
					'Object: General/btnSearch'
					)

			return
		}

		addNote(
				'Step 3. Click Rechercher button'
				)

		Windows.click(
				searchButton,
				FailureHandling.STOP_ON_FAILURE
				)

		Windows.delay(
				safeTimeout
				)

		imageLoader.takeEvidence(
				'Recherche_AsOfDate_Filter_Applied.png'
				)

		KeywordUtil.logInfo(
				'[PASS] Recherche As Of Date filter applied successfully.\n' +
				'As Of Date: ' +
