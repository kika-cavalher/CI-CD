D:\Projects\eMatchStarters\run-ematch-command.bat
@echo off
setlocal EnableExtensions EnableDelayedExpansion

rem ============================================================
rem  Generic runner for ALL suites/collections
rem  Reads: D:\Projects\eMatchStarters\run-context.properties
rem  Keys expected:
rem    WORKSPACE=<jenkins workspace full path>
rem    PROJECT_FILE=<katalon project file name>
rem    COLLECTION_PATH=<Test Suites/... collection path>
rem ============================================================

set "CTX_FILE=D:\Projects\eMatchStarters\run-context.properties"
set "LOG_DIR=D:\Projects\eMatchStarters\logs"

if not exist "%LOG_DIR%" mkdir "%LOG_DIR%" >nul 2>nul

for /f "usebackq tokens=1,* delims==" %%A in ("%CTX_FILE%") do (
  set "%%A=%%B"
)

if "%WORKSPACE%"=="" (
  echo [ERROR] WORKSPACE is empty. Check %CTX_FILE%
  exit /b 10
)

if "%PROJECT_FILE%"=="" (
  echo [ERROR] PROJECT_FILE is empty. Check %CTX_FILE%
  exit /b 11
)

if "%COLLECTION_PATH%"=="" (
  echo [ERROR] COLLECTION_PATH is empty. Check %CTX_FILE%
  exit /b 12
)

set "KATALON_EXE=C:\Users\ladgi5appjenkins\Documents\Katalon_Studio_Engine_Windows_64-8.1.0\katalonc.exe"
if not exist "%KATALON_EXE%" (
  echo [ERROR] Katalon not found: %KATALON_EXE%
  exit /b 13
)

set "PROJECT_PATH=%WORKSPACE%\%PROJECT_FILE%"
if not exist "%PROJECT_PATH%" (
  echo [ERROR] Project not found: %PROJECT_PATH%
  exit /b 14
)

set "REPORT_FOLDER=%WORKSPACE%\Reports"
if not exist "%REPORT_FOLDER%" mkdir "%REPORT_FOLDER%" >nul 2>nul

set "TS=%DATE:~-4%%DATE:~3,2%%DATE:~0,2%_%TIME:~0,2%%TIME:~3,2%%TIME:~6,2%"
set "TS=%TS: =0%"
set "OUT_LOG=%REPORT_FOLDER%\_jenkins_task_%TS%.log"
set "EXIT_FILE=%REPORT_FOLDER%\_jenkins_task_exitcode.txt"

echo ============================================================ > "%OUT_LOG%"
echo RUN CONTEXT >> "%OUT_LOG%"
echo WORKSPACE=%WORKSPACE% >> "%OUT_LOG%"
echo PROJECT_FILE=%PROJECT_FILE% >> "%OUT_LOG%"
echo COLLECTION_PATH=%COLLECTION_PATH% >> "%OUT_LOG%"
echo REPORT_FOLDER=%REPORT_FOLDER% >> "%OUT_LOG%"
echo ============================================================ >> "%OUT_LOG%"

pushd "%WORKSPACE%"

"%KATALON_EXE%" ^
  -noSplash ^
  -runMode=console ^
  -projectPath="%PROJECT_PATH%" ^
  -retry=0 ^
  -testSuiteCollectionPath="%COLLECTION_PATH%" ^
  -browserType="Windows" ^
  -reportFolder="%REPORT_FOLDER%" ^
  -reportFileName="report" ^
  > "%OUT_LOG%" 2>&1

set "RC=%ERRORLEVEL%"
echo %RC% > "%EXIT_FILE%"

popd

exit /b %RC%

✅ Esse BAT é “o único runner”.

Ele não escolhe REC/PRD
Ele só roda a Collection que o Jenkins mandar
O teste de login continua decidindo REC/PRD no runtime
