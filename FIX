@echo off
setlocal EnableExtensions EnableDelayedExpansion

REM ============================================================================
REM CONFIG
REM ============================================================================
set "JOB_LABEL=Cube Rapp Detail V2"
set "TEST_SUITE_COLLECTION=Test Suites/Cube Rapp Detail/Cube Rapp Detail V2/Cube rapp detail v2 Collection"
set "REPORT_MATCH_1=Cube Rapp Detail V2"
set "REPORT_MATCH_2=Cube rapp detail v2 Collection"

set "EXECUTION_PROFILE=default"
set "BROWSER_TYPE=Windows"
set "STARTER_DIR=D:\Projects\eMatchStarters"
set "CONTEXT_FILE=%STARTER_DIR%\run-context.properties"
set "RESULT_FILE=%STARTER_DIR%\run-result.properties"
set "LOG_FILE=%STARTER_DIR%\logs\run-ematch-command.log"
set "KATALON_CONSOLE_LOG=%STARTER_DIR%\logs\katalon-console.log"
set "GENERIC_TASK=\eMatch Automation\RunEMatchCommand"
set "WIN_DRIVER_TASK=startWinDriver"

set "WAIT_SECONDS=5"
set "MAX_WAIT_MINUTES=300"
set "TAIL_RUN_LOG=30"
set "TAIL_KATALON_LOG=80"

REM ============================================================================
REM RUNTIME
REM ============================================================================
if "%WORKSPACE%"=="" set "WORKSPACE=%CD%"
set /a WAIT_MAX_CYCLES=(MAX_WAIT_MINUTES*60)/WAIT_SECONDS
if %WAIT_MAX_CYCLES% LEQ 0 set "WAIT_MAX_CYCLES=3600"

for /f %%I in ('powershell -NoProfile -Command "(Get-Date).ToString('yyyy-MM-dd HH:mm:ss')"') do set "RUN_STARTED_AT=%%I"
if not defined RUN_STARTED_AT set "RUN_STARTED_AT=1970-01-01 00:00:00"

set "RUN_ID=%RANDOM%%RANDOM%%RANDOM%"
set "EXPECTED_RUN_ID=%RUN_ID%"

echo.
echo ==================================================
echo [INFO] Starting %JOB_LABEL%
echo [INFO] WORKSPACE=%WORKSPACE%
echo [INFO] TEST_SUITE_COLLECTION=%TEST_SUITE_COLLECTION%
echo [INFO] EXECUTION_PROFILE=%EXECUTION_PROFILE%
echo [INFO] BROWSER_TYPE=%BROWSER_TYPE%
echo [INFO] STARTER_DIR=%STARTER_DIR%
echo [INFO] CONTEXT_FILE=%CONTEXT_FILE%
echo [INFO] RESULT_FILE=%RESULT_FILE%
echo [INFO] LOG_FILE=%LOG_FILE%
echo [INFO] KATALON_CONSOLE_LOG=%KATALON_CONSOLE_LOG%
echo [INFO] GENERIC_TASK=%GENERIC_TASK%
echo [INFO] WIN_DRIVER_TASK=%WIN_DRIVER_TASK%
echo [INFO] RUN_STARTED_AT=%RUN_STARTED_AT%
echo ==================================================
echo.

if "%JOB_LABEL%"=="" (
    echo [ERROR] JOB_LABEL is empty.
    exit /b 1
)

if "%TEST_SUITE_COLLECTION%"=="" (
    echo [ERROR] TEST_SUITE_COLLECTION is empty.
    exit /b 1
)

if not exist "%STARTER_DIR%" (
    echo [ERROR] STARTER_DIR not found: %STARTER_DIR%
    exit /b 1
)

if not exist "%STARTER_DIR%\logs" mkdir "%STARTER_DIR%\logs"

if exist "%LOG_FILE%" del /f /q "%LOG_FILE%" >nul 2>&1
if exist "%KATALON_CONSOLE_LOG%" del /f /q "%KATALON_CONSOLE_LOG%" >nul 2>&1

(
    echo RUN_ID=%EXPECTED_RUN_ID%
    echo JOB_LABEL=%JOB_LABEL%
    echo WORKSPACE=%WORKSPACE%
    echo TEST_SUITE_COLLECTION=%TEST_SUITE_COLLECTION%
    echo EXECUTION_PROFILE=%EXECUTION_PROFILE%
    echo BROWSER_TYPE=%BROWSER_TYPE%
    echo KATALON_HOME=C:\Users\adgi5appjenkins\Documents\Katalon_Studio_Engine_Windows_64-8.1.0
)>"%CONTEXT_FILE%"

echo [INFO] Context file written:
type "%CONTEXT_FILE%"
echo.

(
    echo RUN_ID=%EXPECTED_RUN_ID%
    echo STATUS=QUEUED
    echo EXIT_CODE=999
    echo UPDATED_AT=%DATE% %TIME%
)>"%RESULT_FILE%"

echo [INFO] Initial result file:
type "%RESULT_FILE%"
echo.

echo [INFO] Starting WinAppDriver task...
schtasks /run /tn "%WIN_DRIVER_TASK%" >nul 2>&1
if errorlevel 1 (
    echo [ERROR] Could not start scheduled task "%WIN_DRIVER_TASK%".
    call :printTaskInfo
    exit /b 1
)

echo [INFO] Starting visible Katalon task...
schtasks /run /tn "%GENERIC_TASK%" >nul 2>&1
if errorlevel 1 (
    echo [ERROR] Could not start scheduled task "%GENERIC_TASK%".
    schtasks /end /tn "%WIN_DRIVER_TASK%" >nul 2>&1
    call :printTaskInfo
    exit /b 1
)

set /a WAIT_COUNT=0

:waitResult
set /a WAIT_COUNT+=1
set "FILE_RUN_ID="
set "STATUS="
set "EXIT_CODE="
set "UPDATED_AT="

if exist "%RESULT_FILE%" (
    for /f "usebackq tokens=1,* delims==" %%A in ("%RESULT_FILE%") do (
        if /I "%%A"=="RUN_ID" set "FILE_RUN_ID=%%B"
        if /I "%%A"=="STATUS" set "STATUS=%%B"
        if /I "%%A"=="EXIT_CODE" set "EXIT_CODE=%%B"
        if /I "%%A"=="UPDATED_AT" set "UPDATED_AT=%%B"
    )
)

if %WAIT_COUNT% EQU 1 echo [INFO] Waiting result file update...
if %WAIT_COUNT% EQU 2 echo [INFO] Still waiting result file update...
if %WAIT_COUNT% GEQ 3 if %WAIT_COUNT% LEQ 5 echo [INFO] Still waiting...

if %WAIT_COUNT% GEQ 6 if !FILE_RUN_ID!==%EXPECTED_RUN_ID% if /I "!STATUS!"=="FINISHED" goto resultDone
if %WAIT_COUNT% GEQ 6 if !FILE_RUN_ID!==%EXPECTED_RUN_ID% if /I "!STATUS!"=="FAILED" goto resultDone

set /a SNAPSHOT_MOD=WAIT_COUNT%%12
if %SNAPSHOT_MOD% EQU 0 call :printTaskInfo

if %WAIT_COUNT% GEQ %WAIT_MAX_CYCLES% goto timeoutWait

ping -n %WAIT_SECONDS% 127.0.0.1 >nul
goto waitResult

:timeoutWait
echo [ERROR] Timeout waiting run-result.properties update.
echo [ERROR] FILE_RUN_ID=%FILE_RUN_ID%
echo [ERROR] STATUS=%STATUS%
echo [ERROR] EXIT_CODE=%EXIT_CODE%
echo [ERROR] UPDATED_AT=%UPDATED_AT%
call :printTaskInfo
call :printResultFile
call :printLog "%LOG_FILE%" "run-ematch-command.log" "%TAIL_RUN_LOG%"
call :printLog "%KATALON_CONSOLE_LOG%" "katalon-console.log" "%TAIL_KATALON_LOG%"
call :printReportsSummary
call :stopTasks
exit /b 1

:resultDone
echo.
echo [INFO] Result file updated.
echo [INFO] RUN_ID=%FILE_RUN_ID%
echo [INFO] STATUS=%STATUS%
echo [INFO] EXIT_CODE=%EXIT_CODE%
echo [INFO] UPDATED_AT=%UPDATED_AT%
echo.

call :printTaskInfo
call :printResultFile
call :printLog "%LOG_FILE%" "run-ematch-command.log" "%TAIL_RUN_LOG%"
call :printLog "%KATALON_CONSOLE_LOG%" "katalon-console.log" "%TAIL_KATALON_LOG%"
call :printReportsSummary

call :validateExecution
if errorlevel 1 (
    call :stopTasks
    exit /b 1
)

echo [INFO] %JOB_LABEL% execution finished successfully.
if not "%EXIT_CODE%"=="0" (
    echo [WARN] Katalon returned EXIT_CODE=%EXIT_CODE%, but Jenkins will keep SUCCESS because execution finished.
)

call :stopTasks
exit /b 0

:validateExecution
echo [INFO] Validating current execution...

set "HAS_ARTIFACTS=0"
powershell -NoProfile -Command ^
"$root=Join-Path $env:WORKSPACE 'Reports';" ^
"$start=[datetime]::ParseExact($env:RUN_STARTED_AT,'yyyy-MM-dd HH:mm:ss',$null);" ^
"$m1=$env:REPORT_MATCH_1;" ^
"$m2=$env:REPORT_MATCH_2;" ^
"if(Test-Path $root){" ^
"  $files=Get-ChildItem -Path $root -Recurse -File -ErrorAction SilentlyContinue ^| Where-Object { $_.LastWriteTime -ge $start -and $_.FullName -like ('*'+$m1+'*') -and $_.FullName -like ('*'+$m2+'*') -and ($_.Name -eq 'JUnit_Report.xml' -or $_.Name -eq 'execution0.log' -or $_.Extension -ieq '.html') };" ^
"  if($files.Count -gt 0){ exit 0 } else { exit 1 }" ^
"} else { exit 1 }"
if not errorlevel 1 set "HAS_ARTIFACTS=1"

set "HARD_ERROR=0"
powershell -NoProfile -Command ^
"$parts=@();" ^
"if(Test-Path $env:KATALON_CONSOLE_LOG){ $parts += (Get-Content -Path $env:KATALON_CONSOLE_LOG -Raw) };" ^
"if(Test-Path $env:LOG_FILE){ $parts += (Get-Content -Path $env:LOG_FILE -Raw) };" ^
"$txt=$parts -join [Environment]::NewLine;" ^
"if($txt -match 'FilePathTooLongException' -or $txt -match 'Cannot save entity' -or $txt -match 'Test Suite Collection.*not found' -or $txt -match 'Unable to resolve class' -or $txt -match 'java\.io\.IOException: Directory' -or $txt -match 'ExecutionException'){ exit 1 } else { exit 0 }"
if errorlevel 1 set "HARD_ERROR=1"

if "%HARD_ERROR%"=="1" (
    echo [ERROR] Hard execution error detected for %JOB_LABEL%.
    exit /b 1
)

if "%HAS_ARTIFACTS%"=="1" exit /b 0

echo [ERROR] No report artifacts were generated for %JOB_LABEL%.
exit /b 1

:stopTasks
schtasks /end /tn "%GENERIC_TASK%" >nul 2>&1
schtasks /end /tn "%WIN_DRIVER_TASK%" >nul 2>&1
taskkill /f /im WinAppDriver.exe >nul 2>&1
taskkill /f /im katalonc.exe >nul 2>&1
taskkill /f /im KatalonStudio.exe >nul 2>&1
ping -n 3 127.0.0.1 >nul
exit /b 0

:printTaskInfo
echo [INFO] Scheduled task status snapshot:
echo [INFO] ---- %WIN_DRIVER_TASK% ----
schtasks /query /tn "%WIN_DRIVER_TASK%" /fo LIST 2>nul | findstr /I /C:"Status:" /C:"Last Run Time:" /C:"Last Result:"
echo [INFO] ---- %GENERIC_TASK% ----
schtasks /query /tn "%GENERIC_TASK%" /fo LIST 2>nul | findstr /I /C:"Status:" /C:"Last Run Time:" /C:"Last Result:"
echo.
exit /b 0

:printResultFile
if exist "%RESULT_FILE%" (
    echo [INFO] Current run-result.properties:
    type "%RESULT_FILE%"
    echo.
) else (
    echo [WARN] Result file not found: %RESULT_FILE%
    echo.
)
exit /b 0

:printLog
set "TARGET_FILE=%~1"
set "TARGET_TITLE=%~2"
set "TARGET_LINES=%~3"

if exist "%TARGET_FILE%" (
    echo [INFO] Last lines from %TARGET_TITLE%:
    powershell -NoProfile -Command "Get-Content -Path '%TARGET_FILE%' -Tail %TARGET_LINES% -ErrorAction SilentlyContinue"
    echo.
) else (
    echo [WARN] File not found: %TARGET_FILE%
    echo.
)
exit /b 0

:printReportsSummary
if exist "%WORKSPACE%\Reports" (
    echo [INFO] Reports folder found: %WORKSPACE%\Reports
    echo [INFO] Relevant report artifacts:
    powershell -NoProfile -Command ^
    "$root=Join-Path $env:WORKSPACE 'Reports';" ^
    "Get-ChildItem -Path $root -Recurse -File -ErrorAction SilentlyContinue ^| Where-Object { $_.FullName -like ('*'+$env:REPORT_MATCH_1+'*') -or $_.FullName -like ('*'+$env:REPORT_MATCH_2+'*') } ^| Sort-Object LastWriteTime -Descending ^| Select-Object -First 20 ^| ForEach-Object { Write-Host ('[REPORT] ' + $_.LastWriteTime.ToString('yyyy-MM-dd HH:mm:ss') + '  ' + $_.FullName) }"
    echo.
) else (
    echo [WARN] Reports folder not found: %WORKSPACE%\Reports
    echo.
)
exit /b 0











