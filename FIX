package jenkinsIntegration

class JenkinsDesktopPipelineRunner implements Serializable {

  private final def steps

  JenkinsDesktopPipelineRunner(def steps) {
    this.steps = steps
  }

  void writeRunContextFile(String targetFile, Map<String, String> ctx) {
    String content = ctx.collect { k, v -> "${k}=${v}" }.join("\r\n") + "\r\n"

    steps.echo "Writing run-context.properties to: ${targetFile}"

    String ps = """
      \$p = '${targetFile.replace("\\", "\\\\")}'
      \$dir = Split-Path -Parent \$p
      if (!(Test-Path \$dir)) { New-Item -ItemType Directory -Force -Path \$dir | Out-Null }
      Set-Content -Path \$p -Value @'
${content}
'@ -Encoding ASCII
    """.trim()

    steps.bat """@echo off
powershell -NoProfile -ExecutionPolicy Bypass -Command "${escapeForCmd(ps)}"
"""
  }

  int runScheduledTaskAndWaitMarker(String taskName, String markerPath, int timeoutMinutes) {
    steps.echo "Running Task Scheduler: ${taskName}"
    steps.bat """@echo off
schtasks /run /tn "${taskName}"
if errorlevel 1 exit /b 1
"""

    steps.timeout(time: timeoutMinutes, unit: 'MINUTES') {
      steps.echo "Waiting marker file: ${markerPath}"
      while (true) {
        if (steps.fileExists(markerPath)) break
        steps.sleep time: 3, unit: 'SECONDS'
      }
    }

    String ecText = steps.readFile(markerPath).trim()
    int ec = 1
    try {
      ec = Integer.parseInt(ecText)
    } catch (Exception ignored) {
      ec = 1
    }

    steps.echo "Desktop task finished. ExitCode=${ec}"
    return ec
  }

  void deleteIfExists(String path) {
    steps.bat """@echo off
if exist "${path}" del /f /q "${path}"
exit /b 0
"""
  }

  private static String escapeForCmd(String s) {
    return s
      .replace("^", "^^")
      .replace("&", "^&")
      .replace("<", "^<")
      .replace(">", "^>")
      .replace("|", "^|")
      .replace("\"", "\\\"")
      .replace("\r", "")
      .replace("\n", " ")
  }
}
