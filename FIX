package commands

import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import com.katalon.ematch.helper.EmatchHelper
import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.driver.WindowsDriverFactory
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows
import com.kms.katalon.core.windows.keyword.helper.WindowsActionHelper

import general.ImageLoader
import internal.GlobalVariable

class ExportFile {

	private ImageLoader imageLoader = new ImageLoader()

	@Keyword
	String expandModuleDesResponsabiliteAndDownload(Integer intervalSeconds, Integer maxTimes) {
		String currentEnvironment = getCurrentEnvironment()
		String imageGroup = 'ModuleDesResponsabiliteExport_' + currentEnvironment

		Map<String, String> images = loadRequiredImages(imageGroup)

		Windows.delay(15)

		validateImageVisible(images.allRow, 'allRow', currentEnvironment)

		clickImageInsideImage(
			images.allRow,
			images.expandArrow,
			'ExpandArrow inside AllRow'
		)

		Windows.delay(25)

		waitForImageOptional(
			images.isAllOpen,
			12,
			'Full expansion indicator was not detected: isAllOpen'
		)

		takeEvidence('ExpandAllOpened_' + currentEnvironment + '.png')

		clickImageInsideImage(
			images.lastRowArrow,
			images.expandArrow,
			'ExpandArrow inside last row'
		)

		Windows.delay(10)

		waitForImageRequired(
			images.totalCurrentYear,
			12,
			'Current year total image was not detected: totalCurrentYear'
		)

		takeEvidence('ExpandCurrentYear_' + currentEnvironment + '.png')

		validateExpandedTable(images, currentEnvironment)

		return downloadFileFromOutilsAndRegister(intervalSeconds, maxTimes)
	}

	private String getCurrentEnvironment() {
		try {
			String environmentText = Windows.getText(findWindowsObject('Object Repository/General/curEnv'))

			if (environmentText.equalsIgnoreCase('Recette')) {
				return 'Rec'
			}

			return 'PROD'
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop(
				'Could not identify current environment from Object Repository/General/curEnv. Reason: ' + e.getMessage()
			)
		}

		return null
	}

	private Map<String, String> loadRequiredImages(String imageGroup) {
		Map<String, String> images = [
			allRow          : imageLoader.getImage(imageGroup, 'allRow'),
			expandArrow     : imageLoader.getImage(imageGroup, 'expandArrow'),
			lastRowArrow    : imageLoader.getImage(imageGroup, 'lastRowArrow'),
			isAllOpen       : imageLoader.getImage(imageGroup, 'isAllOpen'),
			totalCurrentYear: imageLoader.getImage(imageGroup, 'totalCurrentYear')
		]

		images.each { String key, String path ->
			if (!new File(path).exists()) {
				KeywordUtil.markFailedAndStop('Image file not found. Key: ' + key + ', Path: ' + path)
			}
		}

		KeywordUtil.logInfo('All export image files exist for group: ' + imageGroup)

		return images
	}

	private void validateImageVisible(String imagePath, String imageName, String currentEnvironment) {
		try {
			if (!WindowsImageKeywords.findImage(imagePath)) {
				KeywordUtil.markFailedAndStop(
					'Base image is not visible on screen. Image: ' + imageName + ', Environment: ' + currentEnvironment
				)
			}
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop(
				'Could not validate image visibility. Image: ' + imageName + ', Reason: ' + e.getMessage()
			)
		}
	}

	private void clickImageInsideImage(String parentImage, String childImage, String actionName) {
		try {
			WindowsImageKeywords.clickImageInImage(parentImage, childImage)
			KeywordUtil.logInfo('Clicked image successfully: ' + actionName)
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop(
				'Could not click image: ' + actionName + '. Reason: ' + e.getMessage()
			)
		}
	}

	private void waitForImageRequired(String imagePath, Integer timeoutSeconds, String errorMessage) {
		try {
			if (!WindowsImageKeywords.waitForImage(imagePath, timeoutSeconds)) {
				KeywordUtil.markFailedAndStop(errorMessage)
			}
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop(errorMessage + '. Reason: ' + e.getMessage())
		}
	}

	private void waitForImageOptional(String imagePath, Integer timeoutSeconds, String warningMessage) {
		try {
			if (!WindowsImageKeywords.waitForImage(imagePath, timeoutSeconds)) {
				KeywordUtil.markWarning(warningMessage)
			}
		} catch (Exception e) {
			KeywordUtil.markWarning(warningMessage + '. Reason: ' + e.getMessage())
		}
	}

	private void validateExpandedTable(Map<String, String> images, String currentEnvironment) {
		boolean totalCurrentYearVisible = false
		boolean isAllOpenVisible = false

		try {
			totalCurrentYearVisible = WindowsImageKeywords.findImage(images.totalCurrentYear)
			isAllOpenVisible = WindowsImageKeywords.findImage(images.isAllOpen)
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop(
				'Could not validate expanded table in environment: ' + currentEnvironment + '. Reason: ' + e.getMessage()
			)
		}

		if (!totalCurrentYearVisible || !isAllOpenVisible) {
			KeywordUtil.markFailed(
				'The table was not expanded correctly in environment: ' + currentEnvironment
			)
		} else {
			KeywordUtil.logInfo(
				'The table expanded correctly in environment: ' + currentEnvironment
			)
		}
	}

	private String downloadFileFromOutilsAndRegister(Integer intervalSeconds, Integer maxTimes) {
		def compareFiles = GlobalVariable.compareFiles as ArrayList

		if (compareFiles == null) {
			compareFiles = []
			GlobalVariable.compareFiles = compareFiles
		}

		Integer beforeDownloadSize = compareFiles.size()

		String downloadedFile = new EmatchHelper().downloadFileFromOutils(intervalSeconds, maxTimes)

		compareFiles.add(downloadedFile)

		Integer afterDownloadSize = compareFiles.size()

		if (beforeDownloadSize == afterDownloadSize) {
			KeywordUtil.markFailed('Cube Balance des Responsabilités file was not downloaded correctly')
		} else {
			KeywordUtil.markPassed('Cube Balance des Responsabilités file downloaded correctly: ' + downloadedFile)
		}

		return downloadedFile
	}

	private void takeEvidence(String fileName) {
		try {
			String evidenceDir = RunConfiguration.getReportFolder() + '\\Evidences\\'
			new File(evidenceDir).mkdirs()

			WindowsActionHelper
				.create(WindowsDriverFactory.getWindowsSession())
				.takeScreenshot(evidenceDir + fileName)

			KeywordUtil.logInfo('Evidence captured: ' + evidenceDir + fileName)
		} catch (Exception e) {
			KeywordUtil.logInfo('Could not capture evidence: ' + e.getMessage())
		}
	}
}














