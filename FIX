	private Map resolveTrace(Map<String, Map> traceByCase, List<String> candidates) {
		for (String candidate : candidates) {
			String cleanCandidate = safe(candidate)

			if (traceByCase.containsKey(cleanCandidate)) {
				return traceByCase[cleanCandidate]
			}

			String normalizedTarget = normalizeKey(cleanCandidate)

			for (Map.Entry<String, Map> entry : traceByCase.entrySet()) {
				if (normalizeKey(entry.key) == normalizedTarget) {
					return entry.value
				}
			}
		}

		return [
			startMs : 0L,
			endMs   : 0L,
			status  : '',
			failure : '',
			steps   : []
