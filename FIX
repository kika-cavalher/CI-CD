	private boolean looksLikeErrorLine(String line) {
		String lower = safeValue(line).toLowerCase(Locale.ENGLISH)

		boolean error = false
		error = error || lower.contains('exception')
		error = error || lower.contains('root cause')
		error = error || lower.contains('caused by:')
		error = error || lower.contains('unable to ')
		error = error || lower.contains('stacktrace')
		error = error || lower.startsWith('at ')
		return error
	}

	private String extractShortError(def source) {
		String text = safeValue(source)
		if (isBlank(text)) {
			return ''
		}

		List<String> lines = text.readLines().collect { safeValue(it) }.findAll { !isBlank(it) }
		if (lines.isEmpty()) {
			return ''
		}

		String preferred = lines.find { String line ->
			String lower = line.toLowerCase(Locale.ENGLISH)
			boolean match = false
			match = match || lower.contains('unable to ')
			match = match || lower.contains('element click intercepted')
			match = match || lower.contains('object repository')
			match = match || lower.contains('no such element')
			match = match || lower.contains('timeout')
			return match
		}

		String value = safeValue(preferred ?: lines.first())
		value = value.replace('com.kms.katalon.core.exception.StepFailedException:', '').trim()
		value = value.replace('(Root cause:', '').trim()

		int atIndex = value.indexOf(' at ')
		if (atIndex > 0) {
			value = value.substring(0, atIndex).trim()
		}

		if (value.length() > 180) {
			value = value.substring(0, 177) + '...'
		}

		return value
	}

	private void attachEvidenceToFailedScenarios(File reportDir, List<Map> scenarios) {
		scenarios.each { Map scenario ->
			scenario.evidences = []
		}

		List<File> candidates = findEvidenceImages(reportDir)
		if (candidates.isEmpty()) {
			return
		}

		candidates.sort { File a, File b -> a.lastModified() <=> b.lastModified() }

		List<Map> failedScenarios = scenarios.findAll { Map item ->
			safeValue(item.status) == 'failed'
		}

		failedScenarios.each { Map scenario ->
			File selected = pickEvidenceForScenario(reportDir, candidates, scenario)
			if (selected == null || !selected.exists()) {
				return
			}

			File bundled = ensureEvidenceInReportFolder(reportDir, selected)
			String href = buildEvidenceHref(bundled, reportDir)
			String previewSrc = buildEvidencePreviewSrc(bundled)

			scenario.evidences = [
				[
					name         : bundled.name,
					fileName     : bundled.name,
					href         : href,
					imgSrc       : previewSrc,
					imageSrc     : previewSrc,
					imageDataUri : previewSrc,
					image        : true
				]
			]
		}
	}

	private List<File> findEvidenceImages(File reportDir) {
		List<File> roots = []
		Set<String> seen = [] as Set
		List<File> images = []

		if (reportDir != null && reportDir.exists()) {
			roots << reportDir
		}

		if (reportDir?.parentFile != null && reportDir.parentFile.exists()) {
			roots << reportDir.parentFile
		}

		if (reportDir?.parentFile?.parentFile != null && reportDir.parentFile.parentFile.exists()) {
			roots << reportDir.parentFile.parentFile
		}

		roots.unique { File item -> item.absolutePath }.each { File root ->
			root.eachFileRecurse { File file ->
				if (!file.isFile()) {
					return
				}

				if (!isImageFile(file.name)) {
					return
				}

				try {
					String key = file.canonicalPath
					if (seen.add(key)) {
						images << file
					}
				} catch (Exception ignored) {
					if (seen.add(file.absolutePath)) {
						images << file
					}
				}
			}
		}

		images.sort { File a, File b -> a.lastModified() <=> b.lastModified() }
		return images
	}

	private File pickEvidenceForScenario(File reportDir, List<File> candidates, Map scenario) {
		if (candidates == null || candidates.isEmpty()) {
			return null
		}

		long startMillis = resolveScenarioAbsoluteTime(reportDir, safeValue(scenario.startLabel))
		long endMillis = resolveScenarioAbsoluteTime(reportDir, safeValue(scenario.endLabel))

		if (startMillis > 0L && endMillis >= startMillis) {
			List<File> insideWindow = candidates.findAll { File file ->
				long modified = file.lastModified()
				return modified >= (startMillis - 5000L) && modified <= (endMillis + 15000L)
			}

			if (!insideWindow.isEmpty()) {
				insideWindow.sort { File a, File b -> a.lastModified() <=> b.lastModified() }
				return insideWindow.last()
			}

			List<File> sortedByDistance = candidates.sort { File a, File b ->
				long da = Math.abs(a.lastModified() - endMillis)
				long db = Math.abs(b.lastModified() - endMillis)
				return da <=> db
			}

			return sortedByDistance.first()
		}

		return candidates.last()
	}

	private long resolveScenarioAbsoluteTime(File reportDir, String timeLabel) {
		if (isBlank(timeLabel)) {
			return 0L
		}

		String raw = safeValue(timeLabel)

		try {
			List<String> patterns = [
				'yyyy-MM-dd HH:mm:ss',
				'yyyy-MM-dd HH:mm:ss.SSS',
				'MM.dd.yyyy hh:mm:ss a',
				'dd.MM.yyyy HH:mm:ss'
			]

			for (String pattern : patterns) {
				try {
					Date parsed = new SimpleDateFormat(pattern, Locale.ENGLISH).parse(raw)
					return parsed.time
				} catch (Exception ignored) {
				}
			}

			String baseDate = new SimpleDateFormat('yyyy-MM-dd', Locale.ENGLISH).format(new Date(reportDir.lastModified()))
			Date clockDate = new SimpleDateFormat('yyyy-MM-dd HH:mm:ss', Locale.ENGLISH).parse(baseDate + ' ' + raw)
			return clockDate.time
		} catch (Exception ignored) {
			return 0L
		}
	}

	private File ensureEvidenceInReportFolder(File reportDir, File source) {
		if (source == null || !source.exists()) {
			return source
		}

		File evidenceDir = new File(reportDir, 'evidence')
		if (!evidenceDir.exists()) {
			evidenceDir.mkdirs()
		}

		File target = new File(evidenceDir, source.name)

		try {
			if (!target.exists() || target.length() != source.length()) {
				Files.copy(source.toPath(), target.toPath(), StandardCopyOption.REPLACE_EXISTING)
				target.setLastModified(source.lastModified())
			}
		} catch (Exception ignored) {
			return source
		}

		return target
	}

	private String buildEvidenceHref(File file, File reportDir) {
		if (file == null || !file.exists()) {
			return ''
		}

		try {
			String reportBase = reportDir.canonicalPath.replace('\\', '/') + '/'
			String filePath = file.canonicalPath.replace('\\', '/')

			if (filePath.startsWith(reportBase)) {
				return filePath.substring(reportBase.length())
			}
		} catch (Exception ignored) {
		}

		return file.toURI().toString()
	}

	private String buildEvidencePreviewSrc(File file) {
		if (file == null || !file.exists()) {
			return ''
		}

		if (!isImageFile(file.name)) {
			return ''
		}

		try {
			byte[] content = Files.readAllBytes(file.toPath())
			String mime = resolveImageMime(file.name)
			return 'data:' + mime + ';base64,' + Base64.encoder.encodeToString(content)
		} catch (Exception ignored) {
			return file.toURI().toString()
		}
	}

	private String resolveImageMime(String fileName) {
		String lower = safeValue(fileName).toLowerCase(Locale.ENGLISH)

		if (lower.endsWith('.png')) {
			return 'image/png'
		}
		if (lower.endsWith('.jpg') || lower.endsWith('.jpeg')) {
			return 'image/jpeg'
		}
		if (lower.endsWith('.webp')) {
			return 'image/webp'
		}
		if (lower.endsWith('.gif')) {
			return 'image/gif'
		}
		if (lower.endsWith('.bmp')) {
			return 'image/bmp'
		}

		return 'image/png'
	}

	private boolean isImageFile(String fileName) {
		String lower = safeValue(fileName).toLowerCase(Locale.ENGLISH)
		return lower.endsWith('.png') ||
				lower.endsWith('.jpg') ||
				lower.endsWith('.jpeg') ||
				lower.endsWith('.webp') ||
				lower.endsWith('.gif') ||
				lower.endsWith('.bmp')
	}

	private void collectEvidenceImages(File folder, List<File> images) {
		if (folder == null || !folder.exists()) {
			return
		}

		File[] files = folder.listFiles()
		if (files == null) {
			return
		}

		files.each { File file ->
			if (file.isDirectory()) {
				collectEvidenceImages(file, images)
				return
			}

			String lower = file.name.toLowerCase(Locale.ENGLISH)

			boolean isImage = false
			isImage = isImage || lower.endsWith('.png')
			isImage = isImage || lower.endsWith('.jpg')
			isImage = isImage || lower.endsWith('.jpeg')
			isImage = isImage || lower.endsWith('.webp')

			boolean isLogo = lower.contains('gaia-logo')

			if (isImage && !isLogo) {
				images << file
			}
		}
	}
	private String resolveAssetUrl(File reportDir, String relativePath) {
		File projectRoot = findProjectRoot(reportDir)
		File asset = new File(projectRoot, relativePath)
		if (asset.exists()) {
			return asset.toURI().toString()
		}
		return ''
	}

	private File findProjectRoot(File reportDir) {
		File current = reportDir
		while (current != null) {
			if ('Reports'.equalsIgnoreCase(current.name)) {
				return current.parentFile != null ? current.parentFile : current
			}
			current = current.parentFile
		}
		return reportDir
	}

	// =========================================================================
	// STEP DECORATION
	// =========================================================================

	private String resolveStepEmoji(String title) {
		String lower = safeValue(title).toLowerCase(Locale.ENGLISH)

		boolean isSearch = lower.contains('search') || lower.contains('find') || lower.contains('wait')
		if (isSearch) {
			return '🔎'
		}

		boolean isClick = lower.contains('click') || lower.contains('select') || lower.contains('open') || lower.contains('navigate')
		if (isClick) {
			return '🖱️'
		}

		boolean isFill = lower.contains('fill') || lower.contains('input') || lower.contains('type') || lower.contains('write')
		if (isFill) {
			return '⌨️'
		}

		boolean isUpload = lower.contains('import') || lower.contains('upload') || lower.contains('file')
		if (isUpload) {
			return '📄'
		}

		boolean isValidation = lower.contains('verify') || lower.contains('assert') || lower.contains('match') || lower.contains('contain')
		if (isValidation) {
			return '✅'
		}

		return '🔹'
	}
}



