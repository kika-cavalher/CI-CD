	private String validateRowsForValidationTypeInFile(
			File file,
			String validationType,
			int sheetIndex,
			String headerCurrency,
			String headerCurrencyRef) {

		StringBuilder errors = new StringBuilder()

		FileInputStream input = null
		Workbook workbook = null

		try {

			KeywordUtil.logInfo("🔎 [VALIDATE ROWS] file=" + file.getName() + " | validationType=" + validationType)

			input = new FileInputStream(file)
			workbook = WorkbookFactory.create(input)

			if (workbook.getNumberOfSheets() <= sheetIndex) {

				errors.append("[ERROR] File '")
						.append(file.getName())
						.append("' does not contain sheet index ")
						.append(sheetIndex)
						.append(".\n")
			} else {

				Sheet sheet = workbook.getSheetAt(sheetIndex)
				DataFormatter formatter = new DataFormatter()
				FormulaEvaluator evaluator = workbook.getCreationHelper().createFormulaEvaluator()

				int currencyCol = findHeaderColumn(sheet, headerCurrency, formatter)
				int currencyRefCol = findHeaderColumn(sheet, headerCurrencyRef, formatter)

				boolean needCurrencyRef = isCurrencyRefRequired(validationType)

				if (currencyCol < 0 || (needCurrencyRef && currencyRefCol < 0)) {

					errors.append("[ERROR] File '")
							.append(file.getName())
							.append("' cannot validate rows because required currency headers are missing.\n")
				} else {

					int matchingRows = 0
					int lastRowNum = sheet.getLastRowNum()

					for (int i = 1; i <= lastRowNum; i++) {

						Row row = sheet.getRow(i)

						if (row != null && !isRowEmpty(row, formatter, evaluator)) {

							String currency = getCellText(row, currencyCol, formatter, evaluator)
							String currencyRef = needCurrencyRef ? getCellText(row, currencyRefCol, formatter, evaluator) : ''

							if (shouldValidateRow(validationType, currency, currencyRef)) {
								matchingRows++
							}
						}
					}

					KeywordUtil.logInfo("🔎 [ROWS FOUND] file=" + file.getName() + " | validationType=" + validationType + " | rows=" + matchingRows)

					if (matchingRows == 0) {
						errors.append("[ERROR] File '")
								.append(file.getName())
								.append("' has no rows corresponding to validation type ")
								.append(validationType)
								.append(".\n")
					}
				}
			}
		} catch (Exception e) {

			errors.append("[ERROR] Row validation failed for file '")
					.append(file.getName())
					.append("': ")
					.append(e.getClass().getSimpleName())
					.append(" | ")
					.append(e.getMessage())
					.append("\n")
		} finally {

			try {
				if (workbook != null) {
					workbook.close()
				}
			} catch (Exception ignored) {}

			try {
				if (input != null) {
					input.close()
				}
			} catch (Exception ignored) {}
		}

		return errors.toString()
	}

	private String validateAmountsInFile(
			File file,
			String validationType,
			int sheetIndex,
			String headerCurrency,
			String headerCurrencyRef,
			String headerAmountCcy,
			String headerAmountBaseCcy) {

		StringBuilder errors = new StringBuilder()

		FileInputStream input = null
		Workbook workbook = null

		try {

			KeywordUtil.logInfo("💰 [VALIDATE AMOUNTS] file=" + file.getName() + " | validationType=" + validationType)

			input = new FileInputStream(file)
			workbook = WorkbookFactory.create(input)

			if (workbook.getNumberOfSheets() <= sheetIndex) {

				errors.append("[ERROR] File '")
						.append(file.getName())
						.append("' does not contain sheet index ")
						.append(sheetIndex)
						.append(".\n")
			} else {

				Sheet sheet = workbook.getSheetAt(sheetIndex)
				DataFormatter formatter = new DataFormatter()
				FormulaEvaluator evaluator = workbook.getCreationHelper().createFormulaEvaluator()

				int currencyCol = findHeaderColumn(sheet, headerCurrency, formatter)
				int currencyRefCol = findHeaderColumn(sheet, headerCurrencyRef, formatter)
				int amountCcyCol = findHeaderColumn(sheet, headerAmountCcy, formatter)
				int amountBaseCol = findHeaderColumn(sheet, headerAmountBaseCcy, formatter)

				boolean needCurrencyRef = isCurrencyRefRequired(validationType)

				if (currencyCol < 0 || amountCcyCol < 0 || amountBaseCol < 0 || (needCurrencyRef && currencyRefCol < 0)) {

					errors.append("[ERROR] File '")
							.append(file.getName())
							.append("' cannot validate amounts because required headers are missing.\n")
				} else {

					int lastRowNum = sheet.getLastRowNum()
					int processed = 0
					int validatedRows = 0
					int skippedNullRow = 0
					int skippedEmptyRow = 0
					int invalidComparable = 0
					int fallbackTextComparison = 0

					for (int i = 1; i <= lastRowNum; i++) {

						Row row = sheet.getRow(i)

						if (row == null) {

							skippedNullRow++
						} else if (isRowEmpty(row, formatter, evaluator)) {

							skippedEmptyRow++
						} else {

							processed++

							String currency = getCellText(row, currencyCol, formatter, evaluator)
							String currencyRef = needCurrencyRef ? getCellText(row, currencyRefCol, formatter, evaluator) : ''

							if (shouldValidateRow(validationType, currency, currencyRef)) {

								validatedRows++

								String amountCcyText = getCellText(row, amountCcyCol, formatter, evaluator)
								String amountBaseText = getCellText(row, amountBaseCol, formatter, evaluator)

								ComparisonResult comparisonResult = compareAmountValues(
										row,
										amountCcyCol,
										amountBaseCol,
										formatter,
										evaluator
										)

								if (comparisonResult.usedTextFallback) {
									fallbackTextComparison++
								}

								if (!comparisonResult.comparable) {

									invalidComparable++

									errors.append("[ERROR] File '")
											.append(file.getName())
											.append("' row ")
											.append(i + 1)
											.append(" has non-comparable amount values. ")
											.append(headerAmountCcy)
											.append("='")
											.append(amountCcyText)
											.append("' | ")
											.append(headerAmountBaseCcy)
											.append("='")
											.append(amountBaseText)
											.append("'\n")
								} else if (!comparisonResult.equals) {

									errors.append("[ERROR] File '")
											.append(file.getName())
											.append("' row ")
											.append(i + 1)
											.append(" has different amounts. ")
											.append(headerCurrency)
											.append("='")
											.append(currency)
											.append("'")

									if (needCurrencyRef) {
										errors.append(" | ")
												.append(headerCurrencyRef)
												.append("='")
												.append(currencyRef)
												.append("'")
									}

									errors.append(" | ")
											.append(headerAmountCcy)
											.append("='")
											.append(amountCcyText)
											.append("' | ")
											.append(headerAmountBaseCcy)
											.append("='")
											.append(amountBaseText)
											.append("' | comparison=")
											.append(comparisonResult.message)
											.append("\n")
								}
							}
						}

						if (i % 200 == 0) {
							KeywordUtil.logInfo("🟦 [PROGRESS] file=" + file.getName() +
									" | row=" + i + "/" + lastRowNum +
									" | processed=" + processed +
									" | validatedRows=" + validatedRows +
									" | nullRow=" + skippedNullRow +
									" | emptyRow=" + skippedEmptyRow +
									" | nonComparable=" + invalidComparable +
									" | fallbackTextComparison=" + fallbackTextComparison)
						}
					}

					KeywordUtil.logInfo("✅ [AMOUNT LOOP END] file=" + file.getName() +
							" | processed=" + processed +
							" | validatedRows=" + validatedRows +
							" | skippedNullRow=" + skippedNullRow +
							" | skippedEmptyRow=" + skippedEmptyRow +
							" | nonComparable=" + invalidComparable +
							" | fallbackTextComparison=" + fallbackTextComparison +
							" | lastRowNum=" + lastRowNum)
				}
			}
		} catch (Exception e) {

			errors.append("[ERROR] Amount validation failed for file '")
					.append(file.getName())
					.append("': ")
					.append(e.getClass().getSimpleName())
					.append(" | ")
					.append(e.getMessage())
					.append("\n")
		} finally {

			try {
				if (workbook != null) {
					workbook.close()
				}
			} catch (Exception ignored) {}

			try {
				if (input != null) {
					input.close()
				}
			} catch (Exception ignored) {}
		}

		return errors.toString()
	}

	private String collectDiscrepanciesFromFile(
			File file,
			String validationType,
			int sheetIndex,
			List<String> keyHeaders,
			List<String> compareHeaders,
			Map<String, String> expectedValuesByKey,
			Map<String, String> sourceByKey) {

		StringBuilder errors = new StringBuilder()

		FileInputStream input = null
		Workbook workbook = null

		try {

			KeywordUtil.logInfo("🔁 [DISCREPANCY CHECK] file=" + file.getName() + " | validationType=" + validationType)

			input = new FileInputStream(file)
			workbook = WorkbookFactory.create(input)

			if (workbook.getNumberOfSheets() <= sheetIndex) {

				errors.append("[ERROR] File '")
						.append(file.getName())
						.append("' does not contain sheet index ")
						.append(sheetIndex)
						.append(".\n")
			} else {

				Sheet sheet = workbook.getSheetAt(sheetIndex)
				DataFormatter formatter = new DataFormatter()
				FormulaEvaluator evaluator = workbook.getCreationHelper().createFormulaEvaluator()

				Map<String, Integer> keyColumns = resolveHeaderColumns(sheet, keyHeaders, formatter)
				Map<String, Integer> compareColumns = resolveHeaderColumns(sheet, compareHeaders, formatter)

				if (keyColumns.size() != keyHeaders.size() || compareColumns.size() != compareHeaders.size()) {

					errors.append("[ERROR] File '")
							.append(file.getName())
							.append("' cannot run discrepancy validation because one or more configured headers were not found.\n")
				} else {

					int lastRowNum = sheet.getLastRowNum()

					for (int i = 1; i <= lastRowNum; i++) {

						Row row = sheet.getRow(i)

						if (row != null && !isRowEmpty(row, formatter, evaluator)) {

							String key = buildValueByHeaders(row, keyHeaders, keyColumns, formatter, evaluator)
							String value = buildValueByHeaders(row, compareHeaders, compareColumns, formatter, evaluator)

							String fullKey = key

							if (!expectedValuesByKey.containsKey(fullKey)) {

								expectedValuesByKey.put(fullKey, value)
								sourceByKey.put(fullKey, file.getName() + " row " + (i + 1))
							} else {

								String expectedValue = expectedValuesByKey.get(fullKey)

								if (!safeText(expectedValue).equals(safeText(value))) {

									errors.append("[ERROR] Discrepancy found for key [")
											.append(fullKey)
											.append("]. Expected from ")
											.append(sourceByKey.get(fullKey))
											.append(": ")
											.append(expectedValue)
											.append(" | Found in ")
											.append(file.getName())
											.append(" row ")
											.append(i + 1)
											.append(": ")
											.append(value)
											.append("\n")
								}
							}
						}
					}
				}
			}
		} catch (Exception e) {

			errors.append("[ERROR] Discrepancy validation failed for file '")
					.append(file.getName())
					.append("': ")
					.append(e.getClass().getSimpleName())
					.append(" | ")
					.append(e.getMessage())
					.append("\n")
		} finally {

			try {
				if (workbook != null) {
					workbook.close()
				}
			} catch (Exception ignored) {}

			try {
				if (input != null) {
					input.close()
				}
			} catch (Exception ignored) {}
		}

		return errors.toString()
	}

	private List<File> collectExcelFiles(File folder, boolean includeSubFolders) {

		List<File> result = []

		File[] children = folder.listFiles()

		if (children != null) {

			for (File child : children) {

				if (child.isFile() && isExcelFile(child.getName()) && !child.getName().startsWith('~$')) {

					result.add(child)
				} else if (includeSubFolders && child.isDirectory()) {

					List<File> childFiles = collectExcelFiles(child, includeSubFolders)

					for (File childFile : childFiles) {
						result.add(childFile)
					}
				}
			}
		}

		return result
	}

	private List<File> parseFiles(String filesToValidate) {

		List<File> result = []
		List<String> paths = splitText(filesToValidate)

		for (String path : paths) {

			String cleanPath = safeText(path)

			if (cleanPath.length() > 0) {
				result.add(new File(cleanPath))
			}
		}

		return result.unique { File file ->
			file.getAbsolutePath().toLowerCase()
		}
	}

	private List<String> splitText(String value) {

		List<String> result = []

		String text = safeText(value)
				.replace('\r\n', String.valueOf(LIST_SEPARATOR))
				.replace('\n', String.valueOf(LIST_SEPARATOR))
				.replace(';', String.valueOf(LIST_SEPARATOR))

		if (text.length() > 0) {

			String[] parts = text.split('\\|')

			for (String part : parts) {

				String clean = safeText(part)

				if (clean.length() > 0) {
					result.add(clean)
				}
			}
		}

		return result.unique()
	}

	private boolean isExcelFile(String fileName) {

		String name = safeText(fileName).toLowerCase()

		return name.endsWith('.xlsx') ||
				name.endsWith('.xls') ||
				name.endsWith('.xlsm')
	}

	private String resolveValidationTypeForFile(File file, String defaultValidationType) {

		String source = safeText(file.getAbsolutePath()).toUpperCase()

		if (source.contains('EUR')) {
			return 'EUR'
		}

		if (source.contains('USD')) {
			return 'USD'
		}

		if (source.contains('MIXTE') || source.contains('MIX')) {
			return 'MIXTE'
		}

		return normalizeValidationType(defaultValidationType)
	}

	private String normalizeValidationType(String validationType) {

		String value = safeText(validationType).toUpperCase()

		if (value.contains('EUR')) {
			return 'EUR'
		}

		if (value.contains('USD')) {
			return 'USD'
		}

		if (value.contains('MIX')) {
			return 'MIXTE'
		}

		return safeText(validationType)
	}

	private boolean isCurrencyRefRequired(String validationType) {
		return !('EUR'.equalsIgnoreCase(validationType) || 'USD'.equalsIgnoreCase(validationType))
	}

	private boolean shouldValidateRow(String validationType, String currency, String currencyRef) {

		String type = normalizeValidationType(validationType)

		if ('EUR'.equalsIgnoreCase(type)) {
			return 'EUR'.equalsIgnoreCase(safeText(currency))
		}

		if ('USD'.equalsIgnoreCase(type)) {
			return 'USD'.equalsIgnoreCase(safeText(currency))
		}

		return safeText(currency).length() > 0 && safeText(currency).equalsIgnoreCase(safeText(currencyRef))
	}

	private int findHeaderColumn(Sheet sheet, String headerName, DataFormatter formatter) {

		Row headerRow = sheet.getRow(0)

		if (headerRow == null) {
			KeywordUtil.logInfo("[ERROR] Header row not found in row 1.")
			return -1
		}

		String expectedHeader = normalizeHeader(headerName)
		short lastCellNum = headerRow.getLastCellNum()

		if (lastCellNum <= 0) {
			KeywordUtil.logInfo("[ERROR] Header row is empty.")
			return -1
		}

		for (int i = 0; i < lastCellNum; i++) {

			Cell cell = headerRow.getCell(i)
			String value = cell == null ? '' : formatter.formatCellValue(cell).trim()

			if (normalizeHeader(value).equals(expectedHeader)) {
				return i
			}
		}

		KeywordUtil.logInfo("[ERROR] Header '" + headerName + "' not found.")
		return -1
	}

	private Map<String, Integer> resolveHeaderColumns(Sheet sheet, List<String> headers, DataFormatter formatter) {

		Map<String, Integer> result = [:]

		for (String header : headers) {

			int columnIndex = findHeaderColumn(sheet, header, formatter)

			if (columnIndex >= 0) {
				result.put(header, columnIndex)
			}
		}

		return result
	}

	private String buildValueByHeaders(
			Row row,
			List<String> headers,
			Map<String, Integer> columns,
			DataFormatter formatter,
			FormulaEvaluator evaluator) {

		List<String> values = []

		for (String header : headers) {

			Integer columnIndex = columns.get(header)
			String cellText = getCellText(row, columnIndex, formatter, evaluator)

			BigDecimal number = parseNumber(cellText)

			if (number != null) {
				cellText = round2(number).toPlainString()
			}

			values.add(header + '=' + normalizeValue(cellText))
		}

		return values.join(' | ')
	}

	private String normalizeHeader(String value) {

		return safeText(value)
				.replace('\u00A0', ' ')
				.replaceAll('\\s+', ' ')
				.trim()
				.toLowerCase()
	}

	private String normalizeValue(String value) {

		return safeText(value)
				.replace('\u00A0', ' ')
				.replaceAll('\\s+', ' ')
				.trim()
	}

	private String getCellText(Row row, int col, DataFormatter formatter, FormulaEvaluator evaluator) {

		if (row == null || col < 0) {
			return ''
		}

		Cell cell = row.getCell(col)

		if (cell == null) {
			return ''
		}

		try {
			return formatter.formatCellValue(cell, evaluator).trim()
		} catch (Exception e) {
			return formatter.formatCellValue(cell).trim()
		}
	}

	private BigDecimal getCellNumber(Row row, int col, DataFormatter formatter, FormulaEvaluator evaluator) {

		if (row == null || col < 0) {
			return null
		}

		Cell cell = row.getCell(col)

		if (cell == null) {
			return null
		}

		try {

			CellType cellType = cell.getCellType()

			if (cellType == CellType.NUMERIC) {
				return BigDecimal.valueOf(cell.getNumericCellValue())
			}

			if (cellType == CellType.FORMULA) {

				CellValue evaluatedValue = evaluator.evaluate(cell)

				if (evaluatedValue != null && evaluatedValue.getCellType() == CellType.NUMERIC) {
					return BigDecimal.valueOf(evaluatedValue.getNumberValue())
				}
			}

			String text = getCellText(row, col, formatter, evaluator)

			return parseNumber(text)
		} catch (Exception e) {

			try {
				String text = getCellText(row, col, formatter, evaluator)
				return parseNumber(text)
			} catch (Exception ignored) {
				return null
			}
		}
	}

	private ComparisonResult compareAmountValues(
			Row row,
			int amountCcyCol,
			int amountBaseCol,
			DataFormatter formatter,
			FormulaEvaluator evaluator) {

		String amountCcyText = getCellText(row, amountCcyCol, formatter, evaluator)
		String amountBaseText = getCellText(row, amountBaseCol, formatter, evaluator)

		BigDecimal amountCcy = getCellNumber(row, amountCcyCol, formatter, evaluator)
		BigDecimal amountBase = getCellNumber(row, amountBaseCol, formatter, evaluator)

		if (amountCcy != null && amountBase != null) {

			BigDecimal ccy = round2(amountCcy)
			BigDecimal base = round2(amountBase)

			return new ComparisonResult(
					true,
					ccy.compareTo(base) == 0,
					false,
					'numeric: ' + ccy + ' vs ' + base
					)
		}

		String normalizedCcy = normalizeComparableAmountText(amountCcyText)
		String normalizedBase = normalizeComparableAmountText(amountBaseText)

		if (normalizedCcy.length() == 0 && normalizedBase.length() == 0) {
			return new ComparisonResult(true, true, true, 'both empty')
		}

		if (normalizedCcy.length() == 0 || normalizedBase.length() == 0) {
			return new ComparisonResult(
					true,
					false,
					true,
					'one amount empty: ' + normalizedCcy + ' vs ' + normalizedBase
					)
		}

		BigDecimal parsedCcyFromText = parseNumber(normalizedCcy)
		BigDecimal parsedBaseFromText = parseNumber(normalizedBase)

		if (parsedCcyFromText != null && parsedBaseFromText != null) {

			BigDecimal ccy = round2(parsedCcyFromText)
			BigDecimal base = round2(parsedBaseFromText)

			return new ComparisonResult(
					true,
					ccy.compareTo(base) == 0,
					true,
					'text numeric fallback: ' + ccy + ' vs ' + base
					)
		}

		return new ComparisonResult(
				true,
				normalizedCcy.equalsIgnoreCase(normalizedBase),
				true,
				'text fallback: ' + normalizedCcy + ' vs ' + normalizedBase
				)
	}

	private String normalizeComparableAmountText(String value) {

		String text = safeText(value)

		if (text.length() == 0) {
			return ''
		}

		BigDecimal number = parseNumber(text)

		if (number != null) {
			return round2(number).toPlainString()
		}

		return text
				.replace('\u00A0', ' ')
				.replace('\u202F', ' ')
				.replaceAll('\\s+', '')
				.trim()
	}

	private BigDecimal parseNumber(String value) {

		String text = safeText(value)

		if (text.length() == 0) {
			return null
		}

		text = text
				.replace('\u00A0', ' ')
				.replace('\u202F', ' ')
				.replace('\u2212', '-')
				.replace('\u2012', '-')
				.replace('\u2013', '-')
				.replace('\u2014', '-')
				.replace('\u2015', '-')
				.trim()

		boolean negativeByParentheses = text.startsWith('(') && text.endsWith(')')
		boolean negativeByTrailingMinus = text.endsWith('-')

		text = text
				.replaceAll('[^0-9,\\.\\-\\(\\)]', '')
				.replace('(', '')
				.replace(')', '')

		if (negativeByTrailingMinus && text.endsWith('-')) {
			text = text.substring(0, text.length() - 1)
		}

		boolean hasNegativeSign = text.startsWith('-') || negativeByParentheses || negativeByTrailingMinus

		text = text.replace('-', '')

		if (text.length() == 0) {
			return null
		}

		String normalized = normalizeNumericSeparators(text)

		if (normalized.length() == 0) {
			return null
		}

		BigDecimal result = new BigDecimal(normalized)

		if (hasNegativeSign && result.compareTo(BigDecimal.ZERO) > 0) {
			result = result.multiply(BigDecimal.valueOf(-1))
		}

		return result
	}

	private String normalizeNumericSeparators(String text) {

		String value = safeText(text)

		if (value.length() == 0) {
			return ''
		}

		int commaCount = countOccurrences(value, ',')
		int dotCount = countOccurrences(value, '.')

		if (commaCount > 0 && dotCount > 0) {

			int lastComma = value.lastIndexOf(',')
			int lastDot = value.lastIndexOf('.')

			if (lastComma > lastDot) {
				value = value.replace('.', '')
				value = value.replace(',', '.')
			} else {
				value = value.replace(',', '')
			}

			return value
		}

		if (commaCount > 0) {
			return normalizeSingleSeparatorNumber(value, ',')
		}

		if (dotCount > 0) {
			return normalizeSingleSeparatorNumber(value, '.')
		}

		return value
	}

	private String normalizeSingleSeparatorNumber(String value, String separator) {

		int separatorCount = countOccurrences(value, separator)

		if (separatorCount == 0) {
			return value
		}

		if (separatorCount > 1) {

			int lastSeparator = value.lastIndexOf(separator)
			String decimals = value.substring(lastSeparator + 1)

			if (decimals.length() == 1 || decimals.length() == 2) {
				String integerPart = value.substring(0, lastSeparator).replace(separator, '')
				return integerPart + '.' + decimals
			}

			return value.replace(separator, '')
		}

		int separatorIndex = value.indexOf(separator)
		String before = value.substring(0, separatorIndex)
		String after = value.substring(separatorIndex + 1)

		if (after.length() == 3 && before.length() >= 1 && before.length() <= 3) {
			return before + after
		}

		if (separator == ',') {
			return before + '.' + after
		}

		return value
	}

	private BigDecimal round2(BigDecimal value) {

		if (value == null) {
			return null
		}

		return value.setScale(2, RoundingMode.HALF_UP)
	}

	private boolean isRowEmpty(Row row, DataFormatter formatter, FormulaEvaluator evaluator) {

		if (row == null) {
			return true
		}

		short lastCellNum = row.getLastCellNum()

		if (lastCellNum <= 0) {
			return true
		}

		for (int i = 0; i < lastCellNum; i++) {

			Cell cell = row.getCell(i)

			if (cell != null) {

				String value = ''

				try {
					value = formatter.formatCellValue(cell, evaluator).trim()
				} catch (Exception e) {
					value = formatter.formatCellValue(cell).trim()
				}

				if (value.length() > 0) {
					return false
				}
			}
		}

		return true
	}

	private int parseIntOrZero(String value) {

		try {
			return Integer.parseInt(safeText(value))
		} catch (Exception e) {
			return 0
		}
	}

	private int countOccurrences(String text, String token) {

		int count = 0
		int index = 0

		while (index >= 0) {

			index = text.indexOf(token, index)

			if (index >= 0) {
				count++
				index = index + token.length()
			}
		}

		return count
	}

	private boolean isTrue(String value) {

		String text = safeText(value).toLowerCase()

		return text == 'true' ||
				text == 'yes' ||
				text == 'y' ||
				text == '1' ||
				text == 'sim'
	}

	private String safeText(Object value) {

		if (value == null) {
			return ''
		}

		return value.toString().trim()
	}

	private static class ComparisonResult {

		boolean comparable
		boolean equals
		boolean usedTextFallback
		String message

		ComparisonResult(boolean comparable, boolean equals, boolean usedTextFallback, String message) {
			this.comparable = comparable
			this.equals = equals
			this.usedTextFallback = usedTextFallback
			this.message = message
		}
	}
