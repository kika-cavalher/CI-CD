	private Integer safeTimeout(
		Integer requestedTimeout,
		Integer defaultTimeout
	) {

		if (
			requestedTimeout == null ||
			requestedTimeout <= 0
		) {
			return defaultTimeout
		}

		return requestedTimeout
	}


	private String safeText(Object value) {

		return value == null
			? ''
			: value.toString().trim()
	}


	private String safeMessage(Exception exception) {

		String message =
			safeText(exception?.getMessage())

		return message.isEmpty()
			? exception?.getClass()?.getSimpleName()
			: message
	}



	private String waitForFavoriteConfirmation(
		String favoriteTitle,
		Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds, 5)

		List<WindowsTestObject> confirmationObjects = [
			buildXpathObject(
				"//*[contains(@Name," +
				xpathLiteral(favoriteTitle) +
				") and (" +
				"contains(@Name,'enregistré avec succès') or " +
				"contains(@Name,'enregistre avec succes') or " +
				"contains(@Name,'enregistré') or " +
				"contains(@Name,'enregistre')" +
			")]"
			),
			buildXpathObject(
				"//*[contains(@Name,'enregistré avec succès') or " +
				"contains(@Name,'enregistre avec succes')]"
			),
			buildXpathObject(
				"//*[@LocalizedControlType='window' or " +
				"@LocalizedControlType='dialog']" +
				"//*[contains(@Name," +
					xpathLiteral(favoriteTitle) +
				")]"
			)
		]

		int elapsedSeconds = 0

		while (elapsedSeconds < timeout) {

			for (WindowsTestObject confirmationObject : confirmationObjects) {
				try {
					if (Windows.waitForElementPresent(
						confirmationObject,
						1,
						FailureHandling.OPTIONAL
					)) {
						return 'Windows element with favorite success message'
					}
				} catch (Exception ignored) {
				}
			}

			if (imageLoader.isVisible(
				GENERAL_IMAGE_GROUP,
				'iconeModal'
			)) {
				return 'General.iconeModal image'
			}

			if (imageLoader.isVisible(
				GENERAL_IMAGE_GROUP,
				'iconeModalPRD'
			)) {
				return 'General.iconeModalPRD image'
			}

			Windows.delay(1)
			elapsedSeconds++
		}

		return ''
	}


	private WindowsTestObject buildXpathObject(String xpath) {

		WindowsTestObject object = new WindowsTestObject()
		object.setLocatorStrategy(LocatorStrategy.XPATH)
		object.setLocator(xpath)

		return object
	}


	private String xpathLiteral(String value) {

		String safeValue = safeText(value)

		if (!safeValue.contains("'")) {
			return "'" + safeValue + "'"
		}

		if (!safeValue.contains('"')) {
			return '"' + safeValue + '"'
		}

		List<String> parts = safeValue.split("'") as List<String>

		return "concat('" +
			parts.join("', \"'\", '") +
			"')"
	}


	private void pressKeyboardKey(Integer keyCode) {

		Robot robot = new Robot()
		robot.setAutoDelay(80)

		robot.keyPress(keyCode)
		robot.keyRelease(keyCode)
	}
