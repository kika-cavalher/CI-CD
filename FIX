		def response = WS.sendRequest(findTestObject(REQUEST_UPDATE_TEST_PLAN, [
			('testPlanKey'): testPlanKey,
			('jsonBody')   : jsonBodyString
		]))

		int status = WS.getResponseStatusCode(response)
		KeywordUtil.logInfo("Update Test Plan status: " + status)
		return status
	}

