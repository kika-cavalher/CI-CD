// ======================================================
// DELETE FAVORITE
// ======================================================

@Keyword
void deleteCreatedFavorite(
	String favoriteTitle,
	String favoriteImageKey
) {

	Integer controlTimeout = 5
	Integer favoriteTimeout = 10
	Integer deletionWaitSeconds = 5

	logStep(
		'DELETE FAVORITE',
		'Favorite title: ' + favoriteTitle + '\n' +
		'Favorite image key: ' + favoriteImageKey
	)


	// ======================================================
	// CLOSE OPENED TABS
	// ======================================================

	KeywordUtil.logInfo(
		'[DELETE FAVORITE] Closing opened tabs before accessing Favorites.'
	)

	pressKeyboardKey(
		KeyEvent.VK_ESCAPE
	)

	Windows.delay(1)

	WindowsTestObject closeAllTabsButton = null

	try {
		closeAllTabsButton =
			object(
				'closeAllTabsTopBar'
			)
	} catch (Throwable ignored) {
	}

	if (
		closeAllTabsButton != null &&
		Windows.waitForElementPresent(
			closeAllTabsButton,
			controlTimeout,
			FailureHandling.OPTIONAL
		)
	) {
		String enabledValue =
			safeText(
				Windows.getAttribute(
					closeAllTabsButton,
					'IsEnabled',
					FailureHandling.OPTIONAL
				)
			)

		if (!enabledValue.equalsIgnoreCase('False')) {
			Windows.click(
				closeAllTabsButton,
				FailureHandling.STOP_ON_FAILURE
			)

			Windows.delay(2)

			boolean confirmationClicked =
				clickFirstVisibleImage(
					GENERAL_IMAGE_GROUP,
					[
						'yes',
						'yesUnderline',
						'yesButton',
						'oui'
					],
					3
				)

			if (!confirmationClicked) {
				KeywordUtil.logInfo(
					'[DELETE FAVORITE] Close confirmation image was not found. ' +
					'Pressing ENTER.'
				)

				pressKeyboardKey(
					KeyEvent.VK_ENTER
				)
			}

			Windows.delay(5)
		}
	}

	KeywordUtil.logInfo(
		'[DELETE FAVORITE] Opened tabs closing flow completed.'
	)


	// ======================================================
	// OPEN FAVORITES TAB
	// ======================================================

	pressKeyboardKey(
		KeyEvent.VK_ESCAPE
	)

	Windows.delay(1)

	boolean favoritesTabClicked =
		clickFirstVisibleImage(
			GUI_IMAGE_GROUP,
			[
				'favoritesTab'
			],
			controlTimeout
		)

	if (!favoritesTabClicked) {
		WindowsTestObject favoritesTab = null

		try {
			favoritesTab =
				object(
					'favoritesTab'
				)
		} catch (Throwable ignored) {
		}

		if (
			favoritesTab != null &&
			Windows.waitForElementPresent(
				favoritesTab,
				controlTimeout,
				FailureHandling.OPTIONAL
			)
		) {
			Windows.click(
				favoritesTab,
				FailureHandling.STOP_ON_FAILURE
			)

			favoritesTabClicked = true
		}
	}

	if (!favoritesTabClicked) {
		takeEvidence(
			'GUI_FavoritesTabNotFoundForDelete.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorites tab was not found by image or element.'
		)

		return
	}

	Windows.delay(3)


	// ======================================================
	// RIGHT CLICK FAVORITE IN THE LIST
	// ======================================================

	String favoriteImagePath =
		optionalImage(
			GUI_IMAGE_GROUP,
			favoriteImageKey
		)

	boolean favoriteContextMenuOpened = false

	if (!favoriteImagePath.isEmpty()) {
		try {
			KeywordUtil.logInfo(
				'[DELETE FAVORITE] Searching favorite using image.\n' +
				'Image key: ' + favoriteImageKey
			)

			WindowsImageKeywords.rightClickImage(
				favoriteImagePath
			)

			favoriteContextMenuOpened = true

			KeywordUtil.logInfo(
				'[DELETE FAVORITE] Favorite found by image.\n' +
				'Right click executed successfully.'
			)
		} catch (Throwable imageError) {
			KeywordUtil.logInfo(
				'[DELETE FAVORITE] Favorite was not found by image.\n' +
				'Image key: ' + favoriteImageKey + '\n' +
				'Reason: ' +
					safeText(
						imageError.getMessage()
					)
			)
		}
	}

	if (!favoriteContextMenuOpened) {
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Trying exact TreeItem fallback.\n' +
			'Favorite: ' + favoriteTitle
		)

		WindowsTestObject favoriteTreeItem =
			buildXpathObject(
				"//*[@Name=" +
					xpathLiteral(favoriteTitle) +
					" and contains(@ControlType,'TreeItem')]"
			)

		boolean favoriteFoundByElement =
			Windows.waitForElementPresent(
				favoriteTreeItem,
				favoriteTimeout,
				FailureHandling.OPTIONAL
			)

		if (favoriteFoundByElement) {
			Windows.rightClick(
				favoriteTreeItem,
				FailureHandling.STOP_ON_FAILURE
			)

			favoriteContextMenuOpened = true

			KeywordUtil.logInfo(
				'[DELETE FAVORITE] Favorite found as TreeItem.\n' +
				'Right click executed successfully.'
			)
		}
	}

	if (!favoriteContextMenuOpened) {
		takeEvidence(
			'GUI_FavoriteNotFoundForDelete.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorite was not found for deletion by image or TreeItem.\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'Image key: ' + favoriteImageKey
		)

		return
	}

	Windows.delay(2)


	// ======================================================
	// CLICK SUPPRIMER LE FAVORI
	// ======================================================

	boolean deleteCommandClicked = false

	String deleteFavoriteImagePath =
		optionalImage(
			GUI_IMAGE_GROUP,
			'deleteFavoriteBtn'
		)

	if (!deleteFavoriteImagePath.isEmpty()) {
		try {
			KeywordUtil.logInfo(
				'[DELETE FAVORITE] Clicking delete command by image.\n' +
				'Image key: deleteFavoriteBtn'
			)

			WindowsImageKeywords.clickImage(
				deleteFavoriteImagePath
			)

			deleteCommandClicked = true
		} catch (Throwable imageError) {
			KeywordUtil.logInfo(
				'[DELETE FAVORITE] Delete command image was not found.\n' +
				'Trying Windows element fallback.'
			)
		}
	}

	if (!deleteCommandClicked) {
		WindowsTestObject deleteFavoriteButton =
			buildXpathObject(
				"//*[@Name='Supprimer le favori' and " +
				"(@LocalizedControlType='button' or " +
				"contains(@ControlType,'Button'))]"
			)

		boolean deleteButtonFound =
			Windows.waitForElementPresent(
				deleteFavoriteButton,
				controlTimeout,
				FailureHandling.OPTIONAL
			)

		if (deleteButtonFound) {
			Windows.click(
				deleteFavoriteButton,
				FailureHandling.STOP_ON_FAILURE
			)

			deleteCommandClicked = true
		}
	}

	if (!deleteCommandClicked) {
		takeEvidence(
			'GUI_DeleteFavoriteButtonNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Delete command was not found by image or element.\n' +
			'Expected command: Supprimer le favori\n' +
			'Image key: deleteFavoriteBtn'
		)

		return
	}

	Windows.delay(
		deletionWaitSeconds
	)


	// ======================================================
	// VERIFY FAVORITE IS NO LONGER DISPLAYED
	// ======================================================

	WindowsTestObject remainingFavoriteTreeItem =
		buildXpathObject(
			"//*[@Name=" +
				xpathLiteral(favoriteTitle) +
				" and contains(@ControlType,'TreeItem')]"
		)

	boolean favoriteStillPresentByElement =
		Windows.waitForElementPresent(
			remainingFavoriteTreeItem,
			2,
			FailureHandling.OPTIONAL
		)

	boolean favoriteStillPresentByImage = false

	if (!favoriteImagePath.isEmpty()) {
		try {
			WindowsImageKeywords.clickImage(
				favoriteImagePath
			)

			favoriteStillPresentByImage = true
		} catch (Throwable ignored) {
			favoriteStillPresentByImage = false
		}
	}

	takeEvidence(
		'GUI_FavoriteAfterDelete.png'
	)

	if (
		favoriteStillPresentByElement ||
		favoriteStillPresentByImage
	) {
		KeywordUtil.markFailedAndStop(
			'Favorite is still displayed after deletion.\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'Found by TreeItem: ' +
				favoriteStillPresentByElement + '\n' +
			'Found by image: ' +
				favoriteStillPresentByImage
		)

		return
	}

	KeywordUtil.markPassed(
		'Favorite deleted successfully.\n' +
		'Favorite: ' + favoriteTitle + '\n' +
		'Favorite is no longer displayed.'
	)
}
