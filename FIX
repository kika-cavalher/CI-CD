pipeline {
  agent { label 'GI5_SWDCFRNXGI55817' }

  parameters {
    booleanParam(name: 'SHOW_BROWSER', defaultValue: true, description: 'Show Chrome UI using Scheduled Task (works even if agent is Windows Service).')
  }

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 60, unit: 'MINUTES')
  }

  environment {
    KATALON_HOME      = 'C:/Users/adgi5appjenkins/Documents/Katalon_Studio_Engine_Windows_64-8.1.0'
    FIXED_GAIA_DIR    = 'D:/jenkins/work/workspace/GI5/Gaia/Gaia'
    GAIA_TSC_PATH     = 'Test Suites/GAIA TSC'
    REPORT_FOLDER     = "${env.WORKSPACE}\\Reports"
    KATALON_LOG_FILE  = "${env.WORKSPACE}\\katalon_console.log"
  }

  stages {

    stage('Start Gaia Backend and Frontend') {
      steps {
        script {
          echo "[gaia-start] Starting Backend + Frontend (Scheduled Task)"
          bat 'schtasks /run /tn "GaiaBackFrontSetup"'
          echo "[gaia-start] Waiting 300 seconds..."
          sleep(time: 300, unit: 'SECONDS')
        }
      }
    }

    stage('Get Bitbucket Source Code') {
      steps {
        cleanWs(deleteDirs: true, disableDeferredWipeout: true, notFailBuild: true)
        echo "[checkout] Cloning gaia-portal..."
        git credentialsId: '965eceec-b3a3-4ec5-8820-a857c87dd80f',
            url: 'https://bitbucket-mut.mycloud.intrabpce.fr/scm/gi5/gaia-portal.git'
      }
    }

    stage('Resolve Katalon Project Path') {
      steps {
        script {
          def resolvedDir = powershell(returnStdout: true, script: """
            \$ErrorActionPreference = "SilentlyContinue"
            function FindPrjDir(\$root) {
              if (!(Test-Path \$root)) { return '' }
              \$p = Get-ChildItem -Path \$root -Recurse -Filter '*.prj' -File -ErrorAction SilentlyContinue | Select-Object -First 1
              if (\$p) { return \$p.Directory.FullName }
              return ''
            }
            \$dir = FindPrjDir '${env.FIXED_GAIA_DIR}'
            if ([string]::IsNullOrWhiteSpace(\$dir)) { \$dir = FindPrjDir '${env.WORKSPACE}' }
            if ([string]::IsNullOrWhiteSpace(\$dir)) { '' } else { \$dir }
            exit 0
          """).trim()

          if (!resolvedDir) {
            error("[path] Could not find any *.prj under FIXED_GAIA_DIR or WORKSPACE.")
          }

          env.RESOLVED_PROJECT_DIR = resolvedDir
          echo "[path] RESOLVED_PROJECT_DIR: ${env.RESOLVED_PROJECT_DIR}"
        }
      }
    }

    stage('GAIA TSC (VISIBLE or HEADLESS)') {
      steps {
        script {
          echo "[katalon] SHOW_BROWSER=${params.SHOW_BROWSER}"

          // Pick which Scheduled Task to run
          def taskName = params.SHOW_BROWSER ? 'GaiaKatalon_Visible' : 'GaiaKatalon_Headless'
          echo "[katalon] Running Scheduled Task: ${taskName}"

          // Trigger task
          bat "schtasks /run /tn \"${taskName}\""

          // Wait for Katalon log to appear (means it started)
          powershell """
            \$ErrorActionPreference = "SilentlyContinue"
            function Log(\$m){ Write-Host "[katalon] \$m" }

            New-Item -ItemType Directory -Force -Path '${env.REPORT_FOLDER}' | Out-Null

            \$log = '${env.KATALON_LOG_FILE}'
            \$tries = 0
            while (\$tries -lt 60 -and !(Test-Path \$log)) {
              Start-Sleep -Seconds 2
              \$tries++
            }

            if (Test-Path \$log) { Log "Detected log file: \$log" }
            else { Log "WARNING: log file not detected yet (task may still be starting)." }

            exit 0
          """

          // Tail log while running (best effort)
          powershell """
            \$ErrorActionPreference = "SilentlyContinue"
            \$log = '${env.KATALON_LOG_FILE}'
            if (Test-Path \$log) {
              Write-Host "[katalon] Last 60 lines:"
              Get-Content \$log -Tail 60 | ForEach-Object { Write-Host ("[katalon] " + \$_) }
            } else {
              Write-Host "[katalon] No katalon_console.log to tail yet."
            }
            exit 0
          """
        }
      }
    }
  }

  post {
    always {
      echo "[post] Archiving reports/logs..."
      archiveArtifacts artifacts: 'katalon_console.log, Reports/**/*.*', allowEmptyArchive: true
    }
  }
}
