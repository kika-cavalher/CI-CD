package commands

import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import com.katalon.ematch.helper.EmatchHelper
import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import internal.GlobalVariable

class ExportFile {

	@Keyword
	String downloadFromOutilsAndRegister(Integer intervalSeconds, Integer maxTimes, String exportLabel) {
		String currentEnvironment = getCurrentEnvironment()
		ArrayList compareFiles = getCompareFiles()

		Integer beforeDownloadSize = compareFiles.size()

		String downloadedFile = new EmatchHelper().downloadFileFromOutils(
			intervalSeconds,
			maxTimes
		)

		validateDownloadedFileName(downloadedFile, exportLabel)

		compareFiles.add(downloadedFile)

		validateDownloadWasRegistered(
			beforeDownloadSize,
			compareFiles.size(),
			downloadedFile,
			exportLabel,
			currentEnvironment
		)

		validateDownloadedFileExists(downloadedFile, exportLabel)

		return downloadedFile
	}

	@Keyword
	String getCurrentEnvironment() {
		try {
			String environmentText = Windows.getText(findWindowsObject('Object Repository/General/curEnv'))

			if (environmentText.equalsIgnoreCase('Recette')) {
				return 'Rec'
			}

			return 'PROD'
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop(
				'Could not identify current environment from Object Repository/General/curEnv. Reason: ' + e.getMessage()
			)
		}

		return null
	}

	@Keyword
	String getExportImageGroup(String imageGroupPrefix) {
		return imageGroupPrefix + '_' + getCurrentEnvironment()
	}

	@Keyword
	void validateDownloadedFileExists(String fileName, String exportLabel) {
		String filePath = getEvidenceFilePath(fileName)
		File exportedFile = new File(filePath)

		if (!exportedFile.exists()) {
			KeywordUtil.markFailedAndStop(
				exportLabel + ' file was registered but does not exist in Evidences folder.\n' +
				'Expected file: ' + filePath
			)
		}

		if (exportedFile.length() <= 0) {
			KeywordUtil.markFailedAndStop(
				exportLabel + ' file exists but is empty.\n' +
				'File: ' + filePath
			)
		}

		KeywordUtil.logInfo(exportLabel + ' file exists and is not empty: ' + filePath)
	}

	@Keyword
	void validateCompareFilesHasMinimumSize(Integer minimumSize) {
		ArrayList compareFiles = getCompareFiles()

		if (compareFiles.size() < minimumSize) {
			KeywordUtil.markFailedAndStop(
				'compareFiles does not have the expected number of files.\n' +
				'Expected minimum: ' + minimumSize + '\n' +
				'Actual size: ' + compareFiles.size()
			)
		}

		KeywordUtil.logInfo('compareFiles size is valid: ' + compareFiles.size())
	}

	@Keyword
	String getLastDownloadedFile() {
		ArrayList compareFiles = getCompareFiles()

		if (compareFiles == null || compareFiles.isEmpty()) {
			KeywordUtil.markFailedAndStop('No downloaded file found in GlobalVariable.compareFiles.')
		}

		return compareFiles.last()
	}

	private ArrayList getCompareFiles() {
		ArrayList compareFiles = GlobalVariable.compareFiles as ArrayList

		if (compareFiles == null) {
			compareFiles = []
			GlobalVariable.compareFiles = compareFiles
		}

		return compareFiles
	}

	private void validateDownloadedFileName(String downloadedFile, String exportLabel) {
		if (downloadedFile == null || downloadedFile.trim().isEmpty()) {
			KeywordUtil.markFailedAndStop(
				exportLabel + ' file was not downloaded correctly. Downloaded file name is empty.'
			)
		}
	}

	private void validateDownloadWasRegistered(
		Integer beforeDownloadSize,
		Integer afterDownloadSize,
		String downloadedFile,
		String exportLabel,
		String currentEnvironment
	) {
		if (afterDownloadSize <= beforeDownloadSize) {
			KeywordUtil.markFailedAndStop(
				exportLabel + ' file was not registered correctly.\n' +
				'Environment: ' + currentEnvironment + '\n' +
				'Downloaded file: ' + downloadedFile
			)
		}

		KeywordUtil.markPassed(
			exportLabel + ' file downloaded and registered correctly: ' + downloadedFile
		)
	}

	private String getEvidenceFilePath(String fileName) {
		String evidencesFolder = RunConfiguration.getReportFolder() + '\\Evidences\\'

		if (fileName.toLowerCase().endsWith('.xlsx') || fileName.toLowerCase().endsWith('.csv')) {
			return evidencesFolder + fileName
		}

		return evidencesFolder + fileName + '.xlsx'
	}
}










import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.driver.WindowsDriverFactory
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows
import com.kms.katalon.core.windows.keyword.helper.WindowsActionHelper

String menuName = 'cube balance des responsabilités'
String menuImageGroup = 'ModuleDesResponsabilite'
String exportImageGroupPrefix = 'ModuleDesResponsabiliteExport'
String expectedTab = 'BDR/BalanceDesResponsabilitesTab'
String exportLabel = 'Cube Balance des Responsabilités'

String evidenceDir = RunConfiguration.getReportFolder() + '\\Evidences\\'
new File(evidenceDir).mkdirs()

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Search and open menu: ' + menuName)

CustomKeywords.'general.MenuNavigator.searchAndOpenMenu'(
	menuName,
	menuImageGroup,
	expectedTab,
	60
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Validate opened menu screen: ' + menuName)

try {
	Windows.waitForElementPresent(findWindowsObject(expectedTab), 60)
} catch (Exception e) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'First validation failed for opened menu screen. Waiting 60 seconds and trying again. Reason: ' + e.getMessage()
	)

	Windows.delay(60)
	Windows.waitForElementPresent(findWindowsObject(expectedTab), 60)
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Take screenshot of opened menu screen: ' + menuName)

WindowsActionHelper
	.create(WindowsDriverFactory.getWindowsSession())
	.takeScreenshot(evidenceDir + 'OpenedScreen.PNG')

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Resolve export image group according to current environment')

String exportImageGroup = CustomKeywords.'commands.ExportFile.getExportImageGroup'(
	exportImageGroupPrefix
)

String allRow = CustomKeywords.'general.ImageLoader.getImage'(exportImageGroup, 'allRow')
String expandArrow = CustomKeywords.'general.ImageLoader.getImage'(exportImageGroup, 'expandArrow')
String lastRowArrow = CustomKeywords.'general.ImageLoader.getImage'(exportImageGroup, 'lastRowArrow')
String isAllOpen = CustomKeywords.'general.ImageLoader.getImage'(exportImageGroup, 'isAllOpen')
String totalCurrentYear = CustomKeywords.'general.ImageLoader.getImage'(exportImageGroup, 'totalCurrentYear')

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Validate export images exist for group: ' + exportImageGroup)

[allRow, expandArrow, lastRowArrow, isAllOpen, totalCurrentYear].each { String imagePath ->
	if (!new File(imagePath).exists()) {
		KeywordUtil.markFailedAndStop('Image file not found: ' + imagePath)
	}
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Wait for table to be ready before expanding rows')

Windows.delay(15)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Validate base row image is visible before expansion')

if (!WindowsImageKeywords.findImage(allRow)) {
	KeywordUtil.markFailedAndStop(
		'Base image allRow is not visible on screen for image group: ' + exportImageGroup
	)
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Expand all rows using ExpandArrow inside AllRow image')

try {
	WindowsImageKeywords.clickImageInImage(allRow, expandArrow)
} catch (Exception e) {
	KeywordUtil.markFailedAndStop(
		'Could not click ExpandArrow inside AllRow image. Reason: ' + e.getMessage()
	)
}

Windows.delay(25)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Validate full expansion indicator is visible')

if (!WindowsImageKeywords.waitForImage(isAllOpen, 12)) {
	KeywordUtil.markWarning('Full expansion indicator isAllOpen was not detected.')
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Take screenshot after expanding all rows')

WindowsActionHelper
	.create(WindowsDriverFactory.getWindowsSession())
	.takeScreenshot(evidenceDir + 'ExpandAllOpened.png')

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Expand current year row using ExpandArrow inside last row image')

try {
	WindowsImageKeywords.clickImageInImage(lastRowArrow, expandArrow)
} catch (Exception e) {
	KeywordUtil.markFailedAndStop(
		'Could not click ExpandArrow inside lastRowArrow image. Reason: ' + e.getMessage()
	)
}

Windows.delay(10)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Validate current year total is visible after expansion')

if (!WindowsImageKeywords.waitForImage(totalCurrentYear, 12)) {
	KeywordUtil.markFailedAndStop(
		'Current year total image was not detected after expansion.'
	)
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Take screenshot after expanding current year row')

WindowsActionHelper
	.create(WindowsDriverFactory.getWindowsSession())
	.takeScreenshot(evidenceDir + 'ExpandCurrentYear.png')

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Validate expanded table state before export')

if (!WindowsImageKeywords.findImage(totalCurrentYear) || !WindowsImageKeywords.findImage(isAllOpen)) {
	KeywordUtil.markFailedAndStop(
		'The table was not expanded correctly for image group: ' + exportImageGroup
	)
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Export file from Outils: ' + exportLabel)

String downloadedFile = CustomKeywords.'commands.ExportFile.downloadFromOutilsAndRegister'(
	15,
	15,
	exportLabel
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'File exported successfully: ' + downloadedFile
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Validate exported file exists in Evidences folder')

CustomKeywords.'commands.ExportFile.validateDownloadedFileExists'(
	downloadedFile,
	exportLabel
)

KeywordUtil.markPassed(exportLabel + ' export test completed successfully.')
