/*
 * Responsibility:
 * Trigger an interactive Windows Task Scheduler task and wait for a marker file.
 * Also writes the external run-context.properties reliably (with CRLF) using PowerShell EncodedCommand.
 */

import java.nio.charset.StandardCharsets
import java.util.Base64

def deleteIfExists(String path) {
  bat """@echo off
if exist "${path}" del /f /q "${path}"
exit /b 0
"""
}

def writeRunContextFile(String targetFile, Map ctx) {
  // Build content with CRLF
  def lines = []
  ctx.each { k, v ->
    lines << "${k}=${v}"
  }
  def content = lines.join("\r\n") + "\r\n"

  echo "Writing run-context.properties to: ${targetFile}"

  // PowerShell script (no cmd escaping issues, we encode it)
  def ps = """
  \$ErrorActionPreference = 'Stop'
  \$p = '${targetFile.replace("'", "''")}'
  \$dir = Split-Path -Parent \$p
  if (!(Test-Path \$dir)) { New-Item -ItemType Directory -Force -Path \$dir | Out-Null }
  Set-Content -Path \$p -Value @'
${content}
'@ -Encoding ASCII
  """.stripIndent().trim()

  // Encode in UTF-16LE for -EncodedCommand
  byte[] psBytes = ps.getBytes("UTF-16LE")
  String encoded = Base64.encoder.encodeToString(psBytes)

  bat """@echo off
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand ${encoded}
if errorlevel 1 exit /b 1
exit /b 0
"""
}

def runScheduledTaskAndWaitMarker(String taskName, String markerPath, int timeoutMinutes) {
  echo "Running Task Scheduler: ${taskName}"

  bat """@echo off
schtasks /run /tn "${taskName}"
if errorlevel 1 exit /b 1
exit /b 0
"""

  timeout(time: timeoutMinutes, unit: 'MINUTES') {
    echo "Waiting marker file: ${markerPath}"
    while (true) {
      if (fileExists(markerPath)) {
        break
      }
      sleep time: 3, unit: 'SECONDS'
    }
  }

  def ecText = readFile(markerPath).trim()
  int ec = 1
  try { ec = Integer.parseInt(ecText) } catch (ignored) { ec = 1 }

  echo "Desktop task finished. ExitCode=${ec}"
  return ec
}

