	// ---------------------------------------------------------
	// openInvestigationDetail
	// ---------------------------------------------------------
	// Uses:
	// Image: totalCcyHeader
	// Helpers: safeTimeout, normalizeSource,
	// expectedDetailWindowTitles, waitForImagePresent,
	// image, switchToAnyWindowTitle, takeEvidence

	@Keyword
	String openInvestigationDetail(
			String sourceValue,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)
		String normalizedSource =
			normalizeSource(sourceValue)

		// Resolve expected detail window titles
		List<String> expectedTitles =
			expectedDetailWindowTitles(
				normalizedSource
			)

		// Validate Total CCY header
		waitForImagePresent(
			'totalCcyHeader',
			timeout,
			'Total CCY header was not displayed before opening detail.'
		)

		WindowsImageKeywords.doubleclickImageWithCoorinates(
			image('totalCcyHeader'),
			100,
			35
		)

		// Wait for detail window
		String openedTitle =
			switchToAnyWindowTitle(
				expectedTitles,
				timeout
			)

		// Validate opened detail window
		if (openedTitle.isEmpty()) {
			KeywordUtil.markFailedAndStop(
				'Investigation detail window was not opened. ' +
				'Expected one of: ' +
				expectedTitles
			)

			return ''
		}

		// Evidence
		takeEvidence(
			'Investigations_Detail_' +
				normalizedSource.capitalize() +
				'_Opened.png'
		)

		return openedTitle
	}


	// ---------------------------------------------------------
	// closeDetailAndReturnToMain
	// ---------------------------------------------------------
	// Uses:
	// Global variable: GlobalVariable.version
	// Helpers: safeTimeout, safeText, switchToAnyWindowTitle

	@Keyword
	String closeDetailAndReturnToMain(
			String targetEnvironment,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)

		// Close detail window
		Windows.closeApplication()
		Windows.delay(POLLING_DELAY_SECONDS)

		// Build possible main window titles
		List<String> possibleMainTitles = []
		String versionTitle =
			safeText(GlobalVariable.version)

		if (!versionTitle.isEmpty()) {
			possibleMainTitles.add(versionTitle)
		}

		// Resolve environment
		String environment =
			safeText(targetEnvironment)
				.toUpperCase()

		if (environment.equals('REC')) {
			possibleMainTitles.addAll([
				'eMatch REC2',
				'eMatch REC',
				'eMatch RECETTE'
			])
		} else if (environment.equals('PRD')) {
			possibleMainTitles.addAll([
				'eMatch PRD',
				'eMatch PRODUCTION'
			])
		}

		// Remove duplicate titles
		possibleMainTitles =
			possibleMainTitles.unique()

		// Return to main eMatch window
		String openedTitle =
			switchToAnyWindowTitle(
				possibleMainTitles,
				timeout
			)

		if (openedTitle.isEmpty()) {
			KeywordUtil.markFailedAndStop(
				'Could not return to the eMatch main window. ' +
				'Expected one of: ' +
				possibleMainTitles
			)

			return ''
		}

		return openedTitle
	}



	// ---------------------------------------------------------
	// validateMainExportSourceValues
	// ---------------------------------------------------------
	// Uses:
	// Excel column: Source
	// Rules:
	// - Blank Source cells are ignored
	// - Blank cells created by merged areas are ignored
	// - Total rows without Source are ignored
	// - Only BILAN and RESULTAT are accepted
	// - Exactly two non-empty Source rows are expected

	@Keyword
	Map validateMainExportSourceValues(
			String mainFilePath
		) {

		File mainFile = validateExcelFile(
			mainFilePath,
			'Main investigations export'
		)

		Workbook workbook = null
		FileInputStream inputStream = null

		try {
			inputStream =
				new FileInputStream(mainFile)

			workbook =
				WorkbookFactory.create(
					inputStream
				)

			if (workbook.numberOfSheets <= 0) {
				KeywordUtil.markFailedAndStop(
					'Main investigations export has no worksheet: ' +
						mainFile.name
				)
			}

			Sheet sheet =
				workbook.getSheetAt(0)

			HeaderLocation sourceHeader =
				findHeader(
					sheet,
					'Source'
				)

			if (sourceHeader == null) {
				KeywordUtil.markFailedAndStop(
					'Column Source was not found in main export: ' +
						mainFile.name
				)
			}

			DataFormatter formatter =
				new DataFormatter()

			List<String> sourceValues = []

			for (Integer rowIndex =
					sourceHeader.rowIndex + 1;
				rowIndex <= sheet.lastRowNum;
				rowIndex++) {

				Row row =
					sheet.getRow(rowIndex)

				if (row == null) {
					continue
				}

				String sourceValue =
					safeText(
						formatter.formatCellValue(
							row.getCell(
								sourceHeader.columnIndex
							)
						)
					).toUpperCase()

				if (sourceValue.isEmpty()) {
					continue
				}

				sourceValues.add(
					sourceValue
				)
			}

			List<String> expectedValues = [
				'BILAN',
				'RESULTAT'
			]

			List<String> uniqueValues =
				sourceValues.unique()

			List<String> unexpectedValues =
				uniqueValues.findAll {
					String value ->
						!expectedValues.contains(value)
				}

			List<String> missingValues =
				expectedValues.findAll {
					String value ->
						!uniqueValues.contains(value)
				}

			if (!unexpectedValues.isEmpty() ||
				!missingValues.isEmpty() ||
				sourceValues.size() != 2) {

				KeywordUtil.markFailedAndStop(
					'Main export Source validation failed.\n' +
						'Expected values: ' +
						expectedValues +
						'\nActual non-empty values: ' +
						sourceValues +
						'\nUnexpected values: ' +
						unexpectedValues +
						'\nMissing values: ' +
						missingValues +
						'\nExpected non-empty Source rows: 2' +
						'\nActual non-empty Source rows: ' +
						sourceValues.size()
				)
			}

			return [
				fileName            : mainFile.name,
				sourceValues        : sourceValues,
				uniqueSourceValues  : uniqueValues,
				nonEmptySourceRows  : sourceValues.size(),
				ignoredBlankRows    :
					Math.max(
						0,
						sheet.lastRowNum -
							sourceHeader.rowIndex -
							sourceValues.size()
					)
			]
		} finally {
			try {
				workbook?.close()
			} catch (Throwable ignored) {
			}

			try {
				inputStream?.close()
			} catch (Throwable ignored) {
			}
		}
	}


