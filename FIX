package jiraIntegration

import java.io.File
import java.nio.file.Files
import java.text.SimpleDateFormat
import java.util.Base64
import java.util.Date
import java.util.Locale

import groovy.xml.XmlSlurper

class JiraGaiaReportBuilder {

    JiraFlowCoordinator flow

    JiraGaiaReportBuilder(JiraFlowCoordinator flow) {
        this.flow = flow
    }

    private String safeValue(def value) {
        return value == null ? '' : String.valueOf(value).trim()
    }

    private boolean isBlank(def value) {
        return safeValue(value).isEmpty()
    }

    private String firstNonBlank(def... values) {
        if (values == null) {
            return ''
        }

        values.each { value ->
            String text = safeValue(value)
            if (!text.isEmpty()) {
                return text
            }
        }

        return ''
    }

    private String normalizeKey(String text) {
        return safeValue(text)
            .toLowerCase(Locale.ENGLISH)
            .replaceAll(/[^a-z0-9]+/, '')
    }

    private String cleanScenarioTitle(String text) {
        return safeValue(text)
            .replaceFirst(/^SCENARIO\s*/i, '')
            .replaceFirst(/^[:\-]\s*/, '')
            .trim()
    }

    private String cleanStepTitle(String text) {
        return safeValue(text)
            .replaceFirst(/^TEST STEP:\s*/i, '')
            .trim()
    }

    private String shortError(String text) {
        String value = safeValue(text)
        if (value.isEmpty()) {
            return ''
        }

        List<String> lines = value.readLines()
        String firstMeaningful = lines.find { String line ->
            String current = safeValue(line)
            return !current.isEmpty() && !current.startsWith('at ') && !current.startsWith('Caused by:')
        }

        String result = safeValue(firstMeaningful ?: lines[0])

        int unableIndex = result.toLowerCase(Locale.ENGLISH).indexOf('unable ')
        if (unableIndex >= 0) {
            result = result.substring(unableIndex).trim()
        }

        result = result
            .replaceAll(/\s+/, ' ')
            .replaceAll(/^\d{2}:\d{2}:\d{2}(\.\d{3})?\s+(PASSED|FAILED|ERROR|INFO|WARN|WARNING|SKIPPED)\s+/i, '')
            .trim()

        if (result.length() > 180) {
            result = result.substring(0, 177) + '...'
        }

        return result
    }

    private long toMillis(def secondsValue) {
        String raw = safeValue(secondsValue).replace(',', '.')
        if (raw.isEmpty()) {
            return 0L
        }

        try {
            BigDecimal seconds = new BigDecimal(raw)
            return seconds.multiply(new BigDecimal('1000')).longValue()
        } catch (Exception ignored) {
            return 0L
        }
    }

    private long toMillisFromElapsed(String raw) {
        String value = safeValue(raw)
        if (value.isEmpty()) {
            return 0L
        }

        def matcher = (value =~ /^(\d{2}):(\d{2}):(\d{2})(?:\.(\d{1,3}))?$/)
        if (matcher.find()) {
            long hours = matcher.group(1).toLong()
            long minutes = matcher.group(2).toLong()
            long seconds = matcher.group(3).toLong()
            long millis = safeValue(matcher.group(4)).isEmpty()
                ? 0L
                : matcher.group(4).padRight(3, '0' as char).toLong()

            return (((hours * 60L) + minutes) * 60L + seconds) * 1000L + millis
        }

        return 0L
    }

    private String formatDuration(long millis) {
        long totalSeconds = Math.max(0L, millis / 1000L)
        long hours = totalSeconds / 3600L
        long minutes = (totalSeconds % 3600L) / 60L
        long seconds = totalSeconds % 60L

        return String.format('%02dh %02dm %02ds', hours, minutes, seconds)
    }

    private String formatClock(String rawDate) {
        String value = safeValue(rawDate)
        if (value.isEmpty()) {
            return ''
        }

        def matcher = (value =~ /(\d{2}):(\d{2}):(\d{2})/)
        if (matcher.find()) {
            return matcher.group(1) + ':' + matcher.group(2) + ':' + matcher.group(3)
        }

        return value
    }

    private String formatGeneratedDate(Date date) {
        if (date == null) {
            return ''
        }

        return new SimpleDateFormat('dd.MM.yyyy hh:mm:ss a', Locale.ENGLISH).format(date)
    }

    private String resolveSuiteName(String reportFolder, String suiteName) {
        if (!isBlank(suiteName)) {
            return safeValue(suiteName)
        }

        File currentFolder = new File(reportFolder)
        File parentFolder = currentFolder.parentFile
        return parentFolder != null ? safeValue(parentFolder.name) : 'GAIA Execution'
    }

    private String resolveReportFileName() {
        try {
            def meta = flow?.metaClass?.getMetaProperty('GAIA_REPORT_FILE_NAME')
            if (meta != null) {
                String value = safeValue(meta.getProperty(flow))
                if (!value.isEmpty()) {
                    return value
                }
            }
        } catch (Exception ignored) {
        }

        return 'gaiaReport.html'
    }

    private File findConsoleLogFile(File reportDir) {
        if (reportDir == null || !reportDir.exists()) {
            return null
        }

        List<File> logs = (reportDir.listFiles() ?: [] as File[])
            .findAll { File file ->
                file.isFile() && file.name.toLowerCase(Locale.ENGLISH).matches(/^execution\d+\.log$/)
            }
            .sort { File file -> file.lastModified() }

        return logs ? logs.last() : null
    }

    private List<Map> collectEvidenceFiles(File reportDir) {
        if (reportDir == null || !reportDir.exists()) {
            return []
        }

        List<File> evidenceFiles = (reportDir.listFiles() ?: [] as File[])
            .findAll { File file ->
                if (!file.isFile()) {
                    return false
                }

                String name = file.name.toLowerCase(Locale.ENGLISH)
                return name.endsWith('.png') || name.endsWith('.jpg') || name.endsWith('.jpeg') || name.endsWith('.webp')
            }
            .sort { File file -> file.lastModified() }

        List<Map> result = []
        evidenceFiles.each { File file ->
            try {
                String lower = file.name.toLowerCase(Locale.ENGLISH)
                String mimeType = 'image/png'
                if (lower.endsWith('.jpg') || lower.endsWith('.jpeg')) {
                    mimeType = 'image/jpeg'
                } else if (lower.endsWith('.webp')) {
                    mimeType = 'image/webp'
                }

                byte[] bytes = Files.readAllBytes(file.toPath())
                String base64 = Base64.encoder.encodeToString(bytes)

                result << [
                    name   : file.name,
                    dataUri: 'data:' + mimeType + ';base64,' + base64
                ]
            } catch (Exception ignored) {
            }
        }

        return result
    }

    private List<Map> parseXmlCases(String xmlPath) {
        List<Map> result = []

        if (isBlank(xmlPath)) {
            return result
        }

        File xmlFile = new File(xmlPath)
        if (!xmlFile.exists()) {
            return result
        }

        def xml
        try {
            xml = new XmlSlurper().parse(xmlFile)
        } catch (Exception ignored) {
            return result
        }

        List testcaseNodes = []
        String rootName = safeValue(xml.name())

        if (rootName == 'testsuite') {
            testcaseNodes.addAll(xml.testcase)
        } else if (rootName == 'testsuites') {
            xml.testsuite.each { suite ->
                testcaseNodes.addAll(suite.testcase)
            }
        }

        int counter = 1
        testcaseNodes.each { tc ->
            String className = safeValue(String.valueOf(tc.@classname))
            String testName = safeValue(String.valueOf(tc.@name))
            long durationMs = toMillis(String.valueOf(tc.@time))

            def failureNode = tc.failure?.size() > 0 ? tc.failure[0] : null
            def errorNode = tc.error?.size() > 0 ? tc.error[0] : null
            def skippedNode = tc.skipped?.size() > 0 ? tc.skipped[0] : null

            String status = 'passed'
            String message = ''
            String details = ''

            if (failureNode != null) {
                status = 'failed'
                message = safeValue(String.valueOf(failureNode.@message))
                details = safeValue(failureNode.text())
            } else if (errorNode != null) {
                status = 'failed'
                message = safeValue(String.valueOf(errorNode.@message))
                details = safeValue(errorNode.text())
            } else if (skippedNode != null) {
                status = 'skipped'
                message = safeValue(String.valueOf(skippedNode.@message))
                details = safeValue(skippedNode.text())
            }

            String displayName = !isBlank(testName) ? testName : className
            if (isBlank(displayName)) {
                displayName = 'Scenario ' + counter
            }

            result << [
                id             : 'xml_' + counter,
                key            : normalizeKey(displayName),
                name           : displayName,
                className      : className,
                status         : status,
                durationMs     : durationMs,
                durationText   : formatDuration(durationMs),
                message        : message,
                details        : details,
                summary        : shortError(firstNonBlank(message, details)),
                startClock     : '',
                endClock       : '',
                startFull      : '',
                endFull        : '',
                steps          : [],
                evidences      : [],
                failedStepIndex: -1
            ]

            counter++
        }

        return result
    }

    private boolean shouldIgnoreStep(String title) {
        String lower = safeValue(title).toLowerCase(Locale.ENGLISH)
        return lower.startsWith('start listener action') ||
            lower.startsWith('glue') ||
            lower.startsWith('runfeaturefile') ||
            lower.startsWith('exportkatalonreports') ||
            lower.startsWith('sampleaftertestcase') ||
            lower.startsWith('video') ||
            lower.startsWith('beforetestcase')
    }

    private Map newScenario(int index, String title) {
        return [
            id                 : 'scenario_' + index,
            key                : normalizeKey(title),
            name               : title,
            status             : 'passed',
            startClock         : '',
            endClock           : '',
            startFull          : '',
            endFull            : '',
            durationMs         : 0L,
            durationText       : formatDuration(0L),
            summary            : '',
            errorSummary       : '',
            errorDetails       : '',
            errorDetailsBuilder: new StringBuilder(),
            steps              : [],
            failureEncountered : false,
            failedStepIndex    : -1,
            evidences          : []
        ]
    }

    private Map newStep(int index, String title) {
        return [
            id              : 'step_' + index,
            title           : title,
            status          : 'info',
            timestamp       : '',
            startClock      : '',
            endClock        : '',
            durationMs      : 0L,
            durationText    : '',
            fullDetail      : '',
            fullDetailBuilder: new StringBuilder()
        ]
    }

    private void applyTimingInfo(Map target, String start, String end, String elapsed) {
        if (target == null) {
            return
        }

        target.startFull = safeValue(start)
        target.endFull = safeValue(end)
        target.startClock = formatClock(start)
        target.endClock = formatClock(end)
        target.durationMs = toMillisFromElapsed(elapsed)
        target.durationText = formatDuration((target.durationMs ?: 0L) as long)
    }

    private void fillMissingStepTimestamps(Map scenario) {
        if (scenario == null || !(scenario.steps instanceof List) || scenario.steps.isEmpty()) {
            return
        }

        if (scenario.steps.every { Map step -> !isBlank(step.timestamp) }) {
            return
        }

        String baseClock = safeValue(scenario.startClock)
        if (baseClock.isEmpty()) {
            return
        }

        def matcher = (baseClock =~ /^(\d{2}):(\d{2}):(\d{2})$/)
        if (!matcher.find()) {
            return
        }

        int baseSeconds = matcher.group(1).toInteger() * 3600 +
            matcher.group(2).toInteger() * 60 +
            matcher.group(3).toInteger()

        int totalSteps = scenario.steps.size()
        long scenarioDurationSeconds = Math.max(1L, ((scenario.durationMs ?: 0L) as long) / 1000L)
        double increment = totalSteps > 1 ? (scenarioDurationSeconds / (double) totalSteps) : 1d

        scenario.steps.eachWithIndex { Map step, int index ->
            if (isBlank(step.timestamp)) {
                int value = baseSeconds + Math.round(index * increment) as int
                int hh = (value / 3600) % 24
                int mm = (value % 3600) / 60
                int ss = value % 60
                step.timestamp = String.format('%02d:%02d:%02d', hh, mm, ss)
            }
        }
    }

    private void settleScenario(Map scenario) {
        if (scenario == null) {
            return
        }

        List<Map> steps = scenario.steps ?: []

        int failedIndex = steps.findIndexOf { Map step ->
            safeValue(step.status) == 'failed'
        }

        if (failedIndex >= 0) {
            steps.eachWithIndex { Map step, int index ->
                if (safeValue(step.status) == 'info') {
                    step.status = index < failedIndex ? 'passed' : 'skipped'
                }
            }
            scenario.status = 'failed'
            scenario.failedStepIndex = failedIndex
        } else {
            steps.each { Map step ->
                if (safeValue(step.status) == 'info') {
                    step.status = scenario.status == 'skipped' ? 'skipped' : 'passed'
                }
            }

            if (safeValue(scenario.status).isEmpty()) {
                scenario.status = 'passed'
            }
        }

        steps.each { Map step ->
            step.fullDetail = safeValue(step.fullDetailBuilder?.toString())
            step.remove('fullDetailBuilder')
        }

        scenario.errorDetails = safeValue(scenario.errorDetailsBuilder?.toString())
        scenario.remove('errorDetailsBuilder')

        if (isBlank(scenario.summary) && scenario.status == 'failed') {
            scenario.summary = shortError(firstNonBlank(scenario.errorSummary, scenario.errorDetails))
        }

        if (isBlank(scenario.durationText)) {
            scenario.durationText = formatDuration((scenario.durationMs ?: 0L) as long)
        }

        fillMissingStepTimestamps(scenario)
    }

    private List<Map> parseExecutionLog(File logFile) {
        List<Map> scenarios = []

        if (logFile == null || !logFile.exists()) {
            return scenarios
        }

        List<String> lines
        try {
            lines = logFile.readLines('UTF-8')
        } catch (Exception ignored) {
            lines = logFile.readLines()
        }

        Map currentScenario = null
        Map currentStep = null
        Map pendingTimingTarget = null
        int scenarioCounter = 1
        int stepCounter = 1

        Closure finalizeScenario = {
            if (currentScenario != null) {
                settleScenario(currentScenario)
                scenarios << currentScenario
            }
            currentScenario = null
            currentStep = null
            pendingTimingTarget = null
        }

        lines.each { String raw ->
            String line = raw == null ? '' : raw

            def scenarioMatcher = (line =~ /TEST STEP:\s*Start Test Case\s*:\s*SCENARIO\s*(.+)$/)
            if (scenarioMatcher.find()) {
                finalizeScenario.call()
                currentScenario = newScenario(scenarioCounter++, cleanScenarioTitle(scenarioMatcher.group(1)))
                pendingTimingTarget = currentScenario
                return
            }

            if (currentScenario == null) {
                return
            }

            def timingMatcher = (line =~ /Start\s*\/\s*End\s*\/\s*Elapsed:\s*(.+?)\s*\/\s*(.+?)\s*\/\s*(.+)$/)
            if (timingMatcher.find()) {
                applyTimingInfo(pendingTimingTarget, timingMatcher.group(1), timingMatcher.group(2), timingMatcher.group(3))
                return
            }

            def stepMatcher = (line =~ /TEST STEP:\s*(.+)$/)
            if (stepMatcher.find()) {
                String title = cleanStepTitle(stepMatcher.group(1))
                if (title.toLowerCase(Locale.ENGLISH).startsWith('start test case')) {
                    return
                }

                if (shouldIgnoreStep(title)) {
                    return
                }

                currentStep = newStep(stepCounter++, title)
                if (currentScenario.failureEncountered) {
                    currentStep.status = 'skipped'
                }

                currentScenario.steps << currentStep
                pendingTimingTarget = currentStep
                return
            }

            def statusMatcher = (line =~ /^(\d{2}:\d{2}:\d{2}(?:\.\d{3})?)\s+(PASSED|FAILED|ERROR|SKIPPED|INFO|WARN|WARNING)\s+(.*)$/)
            if (statusMatcher.find()) {
                if (currentStep == null) {
                    return
                }

                String timestamp = formatClock(statusMatcher.group(1))
                String status = safeValue(statusMatcher.group(2)).toUpperCase(Locale.ENGLISH)
                String message = safeValue(statusMatcher.group(3))

                if (isBlank(currentStep.timestamp)) {
                    currentStep.timestamp = timestamp
                }

                currentStep.fullDetailBuilder << timestamp << ' ' << status << ' ' << message << '\n'

                switch (status) {
                    case 'PASSED':
                        if (!currentScenario.failureEncountered) {
                            currentStep.status = 'passed'
                        }
                        break

                    case 'FAILED':
                    case 'ERROR':
                        currentStep.status = 'failed'
                        currentScenario.status = 'failed'
                        currentScenario.failureEncountered = true
                        currentScenario.failedStepIndex = (currentScenario.steps?.size() ?: 1) - 1
                        currentScenario.errorSummary = shortError(message)
                        currentScenario.summary = shortError(message)
                        currentScenario.errorDetailsBuilder << timestamp << ' ' << status << ' ' << message << '\n'
                        break

                    case 'SKIPPED':
                        currentStep.status = 'skipped'
                        break

                    default:
                        break
                }

                return
            }

            if (currentScenario.failureEncountered && currentScenario.failedStepIndex >= 0) {
                Map failedStep = currentScenario.steps[currentScenario.failedStepIndex]
                currentScenario.errorDetailsBuilder << line << '\n'
                if (failedStep != null) {
                    failedStep.fullDetailBuilder << line << '\n'
                }
            }
        }

        finalizeScenario.call()
        return scenarios
    }

    private Map findLogMatch(String scenarioName, List<Map> logScenarios, Set<String> usedIds) {
        if (!scenarioName || logScenarios == null || logScenarios.isEmpty()) {
            return null
        }

        String targetKey = normalizeKey(scenarioName)

        Map exact = logScenarios.find { Map item ->
            !usedIds.contains(safeValue(item.id)) && safeValue(item.key) == targetKey
        }
        if (exact != null) {
            return exact
        }

        Map loose = logScenarios.find { Map item ->
            if (usedIds.contains(safeValue(item.id))) {
                return false
            }

            String currentKey = safeValue(item.key)
            return !currentKey.isEmpty() && (
                currentKey.contains(targetKey) ||
                targetKey.contains(currentKey)
            )
        }

        return loose
    }

    String createGaiaHtmlReport(String reportFolder, String suiteName, String xmlPath) {
        if (isBlank(reportFolder)) {
            return ''
        }

        File reportDir = new File(reportFolder)
        if (!reportDir.exists()) {
            return ''
        }

        String resolvedSuiteName = resolveSuiteName(reportFolder, suiteName)
        List<Map> xmlCases = parseXmlCases(xmlPath)
        List<Map> logScenarios = parseExecutionLog(findConsoleLogFile(reportDir))
        List<Map> evidences = collectEvidenceFiles(reportDir)

        Set<String> usedLogIds = new LinkedHashSet<String>()
        List<Map> scenarios = []

        if (!xmlCases.isEmpty()) {
            xmlCases.eachWithIndex { Map xmlCase, int index ->
                Map logCase = findLogMatch(xmlCase.name as String, logScenarios, usedLogIds)
                if (logCase != null) {
                    usedLogIds << safeValue(logCase.id)
                }

                Map merged = [
                    id           : safeValue(firstNonBlank(logCase?.id, xmlCase.id, 'scenario_' + (index + 1))),
                    name         : safeValue(firstNonBlank(logCase?.name, xmlCase.name)),
                    status       : safeValue(firstNonBlank(logCase?.status, xmlCase.status, 'passed')),
                    startClock   : safeValue(firstNonBlank(logCase?.startClock, '')),
                    endClock     : safeValue(firstNonBlank(logCase?.endClock, '')),
                    startFull    : safeValue(firstNonBlank(logCase?.startFull, '')),
                    endFull      : safeValue(firstNonBlank(logCase?.endFull, '')),
                    durationMs   : ((logCase?.durationMs ?: 0L) as long) > 0L
                        ? (logCase.durationMs as long)
                        : (xmlCase.durationMs as long),
                    durationText : '',
                    summary      : safeValue(firstNonBlank(logCase?.summary, xmlCase.summary, xmlCase.message)),
                    errorSummary : safeValue(firstNonBlank(logCase?.errorSummary, xmlCase.message, xmlCase.summary)),
                    errorDetails : safeValue(firstNonBlank(logCase?.errorDetails, xmlCase.details, xmlCase.message)),
                    steps        : (logCase?.steps ?: []),
                    evidences    : []
                ]

                merged.durationText = formatDuration((merged.durationMs ?: 0L) as long)

                if (merged.status == 'failed') {
                    merged.evidences = evidences
                }

                if (isBlank(merged.summary)) {
                    merged.summary = merged.status == 'failed'
                        ? shortError(merged.errorSummary)
                        : (merged.status == 'skipped' ? 'Scenario skipped' : 'Scenario passed')
                }

                if (isBlank(merged.errorSummary) && merged.status == 'failed') {
                    merged.errorSummary = shortError(firstNonBlank(merged.errorDetails, merged.summary))
                }

                fillMissingStepTimestamps(merged)
                scenarios << merged
            }
        } else {
            scenarios = logScenarios.collect { Map item ->
                item.durationText = formatDuration((item.durationMs ?: 0L) as long)
                if (item.status == 'failed') {
                    item.evidences = evidences
                }
                item
            }
        }

        int passedCount = scenarios.count { Map item -> safeValue(item.status) == 'passed' }
        int failedCount = scenarios.count { Map item -> safeValue(item.status) == 'failed' }
        int skippedCount = scenarios.count { Map item -> safeValue(item.status) == 'skipped' }

        String defaultScenarioId = safeValue(
            firstNonBlank(
                scenarios.find { Map item -> safeValue(item.status) == 'failed' }?.id,
                scenarios ? scenarios[0].id : ''
            )
        )

        List<Map> logoEvidence = collectEvidenceFiles(new File(reportFolder).parentFile ?: reportDir)
        Map model = [
            appName         : 'GAIA',
            suiteName       : resolvedSuiteName,
            reportTitle     : 'Test report - ' + resolvedSuiteName,
            reportSubtitle  : 'GAIA execution overview',
            generatedAt     : formatGeneratedDate(new Date()),
            scenarios       : scenarios,
            defaultScenarioId: defaultScenarioId,
            stats           : [
                total  : scenarios.size(),
                passed : passedCount,
                failed : failedCount,
                skipped: skippedCount
            ],
            logoDataUri     : ''
        ]

        File logo1 = new File(reportDir.parentFile ?: reportDir, 'Image' + File.separator + 'gaia-logo.png')
        File logo2 = new File(reportDir.parentFile ?: reportDir, 'gaia-logo.png')
        File logo3 = new File(reportDir, 'gaia-logo.png')
        File logoFile = [logo1, logo2, logo3].find { File current -> current != null && current.exists() }

        if (logoFile != null) {
            try {
                byte[] logoBytes = Files.readAllBytes(logoFile.toPath())
                model.logoDataUri = 'data:image/png;base64,' + Base64.encoder.encodeToString(logoBytes)
            } catch (Exception ignored) {
                model.logoDataUri = ''
            }
        }

        File htmlFile = new File(reportDir, resolveReportFileName())
        String html = new JiraGaiaHtmlTemplateBuilder().build(model)
        htmlFile.setText(html, 'UTF-8')

        return htmlFile.absolutePath
    }
}







package jiraIntegration

import groovy.json.JsonOutput

class JiraGaiaHtmlTemplateBuilder {

    static String firstNonBlank(def... values) {
        if (values == null) {
            return ''
        }

        values.each { value ->
            String text = value == null ? '' : String.valueOf(value).trim()
            if (!text.isEmpty()) {
                return text
            }
        }

        return ''
    }

    private String safeValue(def value) {
        return value == null ? '' : String.valueOf(value).trim()
    }

    private String jsonForHtml(Map model) {
        return JsonOutput.toJson(model).replace('</', '<\\/')
    }

    String build(Map model) {
        String modelJson = jsonForHtml(model ?: [:])

        return """<!DOCTYPE html>
