	private String htmlToPlainText(File htmlFile) {
		try {
			String text = htmlFile.getText('UTF-8')

			text = text
					.replaceAll('(?is)<script.*?>.*?</script>', ' ')
					.replaceAll('(?is)<style.*?>.*?</style>', ' ')
					.replaceAll('(?i)<br\\s*/?>', '\n')
					.replaceAll('(?i)</(p|div|tr|li|h1|h2|h3|h4|h5|h6|table|section|article)>', '\n')
					.replaceAll('(?i)<td[^>]*>', ' ')
					.replaceAll('(?i)<th[^>]*>', ' ')
					.replaceAll('(?s)<[^>]+>', ' ')
					.replace('&nbsp;', ' ')
					.replace('&amp;', '&')
					.replace('&lt;', '<')
					.replace('&gt;', '>')
					.replace('&quot;', '"')
					.replace('&#39;', "'")

			List<String> lines = text.readLines().collect { String line ->
				line.replaceAll(/[ \t]+/, ' ').trim()
			}

			return lines.join('\n')
