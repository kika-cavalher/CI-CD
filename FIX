import com.kms.katalon.core.annotation.AfterTestCase
import com.kms.katalon.core.annotation.BeforeTestCase
import com.kms.katalon.core.context.TestCaseContext

import jiraIntegration.ImagesEvidence

class WindowsFailureReportListener {

    @BeforeTestCase
    def beforeCase(TestCaseContext testCaseCtx) {
        ImagesEvidence.startCase(testCaseCtx)
    }

    @AfterTestCase
    def afterCase(TestCaseContext testCaseCtx) {
        ImagesEvidence.finishCase(testCaseCtx)
    }
}










package jiraIntegration

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.context.TestCaseContext
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import org.openqa.selenium.OutputType

import javax.imageio.ImageIO
import java.awt.GraphicsEnvironment
import java.awt.Rectangle
import java.awt.Robot
import java.awt.Toolkit
import java.awt.image.BufferedImage
import java.text.SimpleDateFormat
import java.util.Locale

class ImagesEvidence {

    private static final SimpleDateFormat FILE_STAMP =
        new SimpleDateFormat('yyyyMMdd_HHmmss_SSS', Locale.ENGLISH)

    private static final SimpleDateFormat LOG_STAMP =
        new SimpleDateFormat('yyyy-MM-dd HH:mm:ss.SSS', Locale.ENGLISH)

    private static final ThreadLocal<File> CURRENT_CASE_FOLDER = new ThreadLocal<File>()
    private static final ThreadLocal<String> CURRENT_CASE_ID = new ThreadLocal<String>()

    /*
     * Adds a controlled note line for the custom report.
     */
    @Keyword
    def note(String message) {
        writeEntry('NOTE', message)
    }

    /*
     * Adds a controlled checkpoint line for the custom report.
     */
    @Keyword
    def checkpoint(String message) {
        writeEntry('CHECKPOINT', message)
    }

    /*
     * Captures a manual screenshot in the current evidence folder.
     */
    @Keyword
    File captureNow(String label = 'manual') {
        return saveScreenshot(label)
    }

    /*
     * Adds a note and captures a manual screenshot.
     */
    @Keyword
    File noteAndCapture(String message, String label = 'manual') {
        writeEntry('NOTE', message)
        return saveScreenshot(label)
    }

    /*
     * Opens the evidence context for the current test case.
     */
    static void startCase(TestCaseContext context) {
        File caseFolder = resolveCaseFolder(context)

        CURRENT_CASE_FOLDER.set(caseFolder)
        CURRENT_CASE_ID.set(safe(context?.getTestCaseId()))

        appendLine(caseFolder, buildLine('CASE_START', safe(context?.getTestCaseId())))
    }

    /*
     * Closes the evidence context for the current test case.
     * If the test failed, it automatically captures a screenshot.
     */
    static void finishCase(TestCaseContext context) {
        try {
            File caseFolder = resolveActiveCaseFolder(context)
            String status = normalizeStatus(context?.getTestCaseStatus())

            appendLine(caseFolder, buildLine('CASE_END', status))

            if (status == 'FAILED' || status == 'ERROR') {
                String compactMessage = compactFailureMessage(context?.getMessage())
                if (!compactMessage.isEmpty()) {
                    appendLine(caseFolder, buildLine('AUTO_FAIL', compactMessage))
                }

                saveFailureScreenshot(caseFolder, 'auto-failure')
            }
        } finally {
            CURRENT_CASE_FOLDER.remove()
            CURRENT_CASE_ID.remove()
        }
    }

    /*
     * Writes a user-controlled entry to evidence-notes.log.
     */
    private static void writeEntry(String type, String message) {
        File caseFolder = resolveActiveCaseFolder(null)
        appendLine(caseFolder, buildLine(type, message))
    }

    /*
     * Saves a screenshot in the active evidence folder.
     * It tries driver screenshot first, then desktop screenshot.
     */
    private static File saveScreenshot(String label) {
        File caseFolder = resolveActiveCaseFolder(null)
        return saveFailureScreenshot(caseFolder, label)
    }

    /*
     * Saves screenshot bytes from driver if possible.
     * Falls back to full desktop capture.
     */
    private static File saveFailureScreenshot(File caseFolder, String label) {
        if (caseFolder == null) {
            return null
        }

        String safeLabel = sanitizeFileName(label)
        if (safeLabel.isEmpty()) {
            safeLabel = 'screenshot'
        }

        File target = new File(caseFolder, FILE_STAMP.format(new Date()) + '_' + safeLabel + '.png')

        try {
            byte[] driverBytes = captureDriverBytes()
            if (driverBytes != null && driverBytes.length > 0) {
                target.bytes = driverBytes
                appendLine(caseFolder, buildLine('SCREENSHOT', target.absolutePath))
                KeywordUtil.logInfo('Evidence screenshot saved from driver: ' + target.absolutePath)
                return target
            }
        } catch (Throwable ignored) {
        }

        try {
            if (GraphicsEnvironment.isHeadless()) {
                appendLine(caseFolder, buildLine('SCREENSHOT_ERROR', 'Headless environment. Screenshot was not captured.'))
                return null
            }

            BufferedImage image = new Robot().createScreenCapture(
                new Rectangle(Toolkit.getDefaultToolkit().getScreenSize())
            )

            ImageIO.write(image, 'png', target)

            appendLine(caseFolder, buildLine('SCREENSHOT', target.absolutePath))
            KeywordUtil.logInfo('Evidence screenshot saved from desktop: ' + target.absolutePath)

            return target
        } catch (Throwable t) {
            appendLine(caseFolder, buildLine('SCREENSHOT_ERROR', safe(t?.getMessage())))
            KeywordUtil.logInfo('Evidence screenshot could not be captured: ' + safe(t?.getMessage()))
            return null
        }
    }

    /*
     * Tries to capture screenshot directly from the Windows driver.
     */
    private static byte[] captureDriverBytes() {
        try {
            def driver = Windows.getDriver()
            if (driver != null) {
                return driver.getScreenshotAs(OutputType.BYTES)
            }
        } catch (Throwable ignored) {
        }

        return null
    }

    /*
     * Resolves the active case folder already bound to the thread.
     */
    private static File resolveActiveCaseFolder(TestCaseContext context) {
        File active = CURRENT_CASE_FOLDER.get()

        if (active != null && active.exists()) {
            return active
        }

        File caseFolder = resolveCaseFolder(context)
        CURRENT_CASE_FOLDER.set(caseFolder)

        return caseFolder
    }

    /*
     * Builds the evidence path inside the current Katalon report folder.
     */
    private static File resolveCaseFolder(TestCaseContext context) {
        String reportFolderPath = safe(getCurrentReportFolder())

        File reportFolder = reportFolderPath.isEmpty()
            ? new File(new File(getProjectDirSafe(), 'Reports'), '_fallbackEvidence')
            : new File(reportFolderPath)

        File evidencesRoot = new File(reportFolder, 'Evidences')
        if (!evidencesRoot.exists()) {
            evidencesRoot.mkdirs()
        }

        String caseId = safe(context?.getTestCaseId())
        if (caseId.isEmpty()) {
            caseId = safe(CURRENT_CASE_ID.get())
        }
        if (caseId.isEmpty()) {
            caseId = 'general'
        }

        File caseFolder = new File(evidencesRoot, sanitizeFileName(caseId))
        if (!caseFolder.exists()) {
            caseFolder.mkdirs()
        }

        return caseFolder
    }

    /*
     * Appends a line into evidence-notes.log.
     */
    private static void appendLine(File caseFolder, String line) {
        if (caseFolder == null) {
            return
        }

        if (!caseFolder.exists()) {
            caseFolder.mkdirs()
        }

        File logFile = new File(caseFolder, 'evidence-notes.log')
        logFile << line + System.lineSeparator()
    }

    /*
     * Standard line format:
     * yyyy-MM-dd HH:mm:ss.SSS|TYPE|message
     */
    private static String buildLine(String type, String message) {
        return LOG_STAMP.format(new Date()) + '|' + safe(type) + '|' + safe(message)
    }

    /*
     * Extracts a short and stable failure summary.
     */
    private static String compactFailureMessage(String raw) {
        String value = safe(raw)
        if (value.isEmpty()) {
            return ''
        }

        List<String> lines = value.readLines()
            .collect { safe(it) }
            .findAll { !it.isEmpty() }

        if (lines.isEmpty()) {
            return ''
        }

        for (String line : lines) {
            String lower = line.toLowerCase(Locale.ENGLISH)
            if (lower.startsWith('reason:')) {
                return line.replaceFirst(/(?i)^reason:\s*/, '').trim()
            }
        }

        return lines[0]
    }

    private static String normalizeStatus(String status) {
        String value = safe(status).toUpperCase(Locale.ENGLISH)

        if (value == 'PASSED') {
            return 'PASSED'
        }
        if (value == 'FAILED' || value == 'ERROR') {
            return 'FAILED'
        }

        return 'BLOCKED'
    }

    private static String sanitizeFileName(String value) {
        return safe(value)
            .replace('\\', '_')
            .replace('/', '_')
            .replace(':', '_')
            .replace('*', '_')
            .replace('?', '_')
            .replace('"', '_')
            .replace('<', '_')
            .replace('>', '_')
            .replace('|', '_')
            .replaceAll(/\s+/, '_')
    }

    private static String getCurrentReportFolder() {
        try {
            return RunConfiguration.getReportFolder()
        } catch (Throwable ignored) {
            return ''
        }
    }

    private static String getProjectDirSafe() {
        try {
            return RunConfiguration.getProjectDir()
        } catch (Throwable ignored) {
            return new File('.').absolutePath
        }
    }

    private static String safe(Object value) {
        return value == null ? '' : String.valueOf(value).trim()
    }
}






