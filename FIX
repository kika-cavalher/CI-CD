import java.io.File

import com.kms.katalon.core.util.KeywordUtil


// ======================================================
// COMPARISON CONFIG
// ======================================================

String recEnvironment = 'REC'
String prdEnvironment = 'PRD'

String exportLabel = 'Synthese_Justification_Latent'


// ======================================================
// RESOLVE REC EXPORT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Resolve REC Synthèse export\n' +
	'Environment: ' +
	recEnvironment +
	'\nExport label: ' +
	exportLabel
)

Map recExportValidation =
	CustomKeywords.
	'commands.ExportFileValidationKeywords.validateExportedFileExistsAndHasRows'(
		recEnvironment,
		exportLabel
	)

String recExportPath =
	new File(
		recExportValidation.folderPath.toString(),
		recExportValidation.fileName.toString()
	).absolutePath

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'REC Synthèse export resolved successfully\n' +
	'File: ' +
	recExportValidation.fileName +
	'\nPath: ' +
	recExportPath +
	'\nData rows: ' +
	recExportValidation.dataRows +
	'\nFile size: ' +
	recExportValidation.fileSize +
	' bytes'
)


// ======================================================
// RESOLVE PRD EXPORT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Resolve PRD Synthèse export\n' +
	'Environment: ' +
	prdEnvironment +
	'\nExport label: ' +
	exportLabel
)

Map prdExportValidation =
	CustomKeywords.
	'commands.ExportFileValidationKeywords.validateExportedFileExistsAndHasRows'(
		prdEnvironment,
		exportLabel
	)

String prdExportPath =
	new File(
		prdExportValidation.folderPath.toString(),
		prdExportValidation.fileName.toString()
	).absolutePath

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'PRD Synthèse export resolved successfully\n' +
	'File: ' +
	prdExportValidation.fileName +
	'\nPath: ' +
	prdExportPath +
	'\nData rows: ' +
	prdExportValidation.dataRows +
	'\nFile size: ' +
	prdExportValidation.fileSize +
	' bytes'
)


// ======================================================
// COMPARE REC AND PRD EXPORTS
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Compare Synthèse REC and PRD exports\n' +
	'REC file: ' +
	recExportValidation.fileName +
	'\nPRD file: ' +
	prdExportValidation.fileName +
	'\nValidations:\n' +
	'- Number of table headers\n' +
	'- Header names and order\n' +
	'- Number of data rows\n' +
	'- Numeric data count\n' +
	'- Numeric data checksum'
)

Map comparison =
	CustomKeywords.
	'commands.RecPrdExportValidationKeywords.validateSyntheseRecPrdExports'(
		recExportPath,
		prdExportPath
	)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Synthèse REC x PRD comparison passed\n' +
	'REC file: ' +
	comparison.recFileName +
	'\nPRD file: ' +
	comparison.prdFileName +
	'\nHeaders: ' +
	comparison.recHeaders +
	'\nData rows: ' +
	comparison.recRows +
	'\nNumeric data count: ' +
	comparison.recNumericValueCount +
	'\nNumeric data checksum: ' +
	comparison.recNumericChecksum
)

KeywordUtil.markPassed(
	'Synthèse REC x PRD export and amount validations completed successfully.'
)

