@echo off
setlocal EnableExtensions EnableDelayedExpansion

set "CTX=D:\Projects\eMatchStarters\run-context.properties"

if not exist "%CTX%" (
  echo ERROR: run-context.properties not found: %CTX%
  exit /b 2
)

for /f "usebackq tokens=1,* delims==" %%A in ("%CTX%") do (
  set "%%A=%%B"
)

if "%WORKSPACE%"=="" (
  echo ERROR: WORKSPACE missing in run-context.properties
  exit /b 3
)

set "PROJECT_PATH=%WORKSPACE%\%PROJECT_FILE%"
set "EXITFILE=%REPORTS_DIR%\_jenkins_task_exitcode.txt"

if not exist "%REPORTS_DIR%" mkdir "%REPORTS_DIR%" 2>nul
if exist "%EXITFILE%" del /f /q "%EXITFILE%" 2>nul

echo ============================================================
echo Running Katalon Desktop Collection
echo WORKSPACE=%WORKSPACE%
echo PROJECT=%PROJECT_PATH%
echo COLLECTION=%COLLECTION_PATH%
echo REPORTS=%REPORTS_DIR%
echo LOGS=%LOG_DIR%
echo ============================================================

set "LOGFILE=%LOG_DIR%\katalon_%DATE:~6,4%%DATE:~3,2%%DATE:~0,2%_%TIME:~0,2%%TIME:~3,2%%TIME:~6,2%.log"
set "LOGFILE=%LOGFILE: =0%"

"%KATALON_EXE%" -noSplash -runMode=console -retry=%RETRY% -projectPath="%PROJECT_PATH%" -testSuiteCollectionPath="%COLLECTION_PATH%" -browserType="%BROWSER_TYPE%" -reportFolder="%REPORTS_DIR%" -reportFileName="JUnit_Report" -reportPlugin="junit" > "%LOGFILE%" 2>&1

set "EC=%ERRORLEVEL%"
echo %EC%> "%EXITFILE%"

echo ============================================================
echo Katalon finished with exit code: %EC%
echo Exitcode file: %EXITFILE%
echo Log file: %LOGFILE%
echo ============================================================

exit /b %EC%
