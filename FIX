class authentication {

    @Keyword
    def getCurrentWindowsUser() {
        return System.getProperty('user.name')?.trim()
    }

    @Keyword
    def isExpectedWindowsUser() {
        String currentUser = getCurrentWindowsUser()
        String expectedUser = GlobalVariable.username?.toString()?.trim()

        if (currentUser == null || expectedUser == null) {
            return false
        }

        return currentUser.equalsIgnoreCase(expectedUser)
    }

    @Keyword
    def runResolutionScript() {
        String cmd = "Powershell.exe -executionpolicy remotesigned -File  D:\\setResolution.ps1"
        Runtime.getRuntime().exec(cmd)
    }

    @Keyword
    def getApplicationPath(String environment) {
        switch (environment) {
            case 'PROD':
                return '\\\\cib.net\\shareparis\\Soft\\ematch\\IHM\\Livraisons\\PROD\\IXIS.Ematch.IHM.application'
            case 'PREX':
                return '\\\\cib.net\\shareparis\\Soft\\ematch\\IHM\\Livraisons\\PREX\\IXIS.Ematch.IHM.application'
            case 'REC2':
                return '\\\\cib.net\\shareparis\\Soft\\ematch\\IHM\\Livraisons\\REC2\\IXIS.Ematch.IHM.application'
            case 'REC':
                return '\\\\cib.net\\shareparis\\Soft\\ematch\\IHM\\Livraisons\\REC\\IXIS.Ematch.IHM.application'
            case 'DEV2':
                return '\\\\cib.net\\shareparis\\Soft\\ematch\\IHM\\Livraisons\\DEV2\\IXIS.Ematch.IHM.application'
            case 'DEV':
                return '\\\\cib.net\\shareparis\\Soft\\ematch\\IHM\\Livraisons\\DEV\\IXIS.Ematch.IHM.application'
            default:
                return '\\\\cib.net\\shareparis\\Soft\\ematch\\IHM\\Livraisons\\REC\\IXIS.Ematch.IHM.application'
        }
    }

    @Keyword
    def startEMatch(String environment) {
        if (isExpectedWindowsUser()) {
            runResolutionScript()
            Windows.startApplicationWithTitle('D:\\RunAseMatchReq\\eMatch.lnk', GlobalVariable.version)
        } else {
            String command = "C:\\Program Files (x86)\\Windows Application Driver\\WinAppDriver.exe"
            ProcessBuilder builder = new ProcessBuilder(command).inheritIO()
            builder.start()

            Windows.delay(3)
            Windows.startApplication(getApplicationPath(environment))
        }
    }

    @Keyword
    def switchToEMatchWindow() {
        WindowsTestObject targetWindow = new WindowsTestObject()
        targetWindow.setLocatorStrategy(LocatorStrategy.NAME)
        targetWindow.setLocator(GlobalVariable.version)

        Windows.switchToDesktop()
        Windows.switchToWindow(targetWindow)
    }

    @Keyword
    def openEnvironmentDropdown() {
        WinRetry.clickWithRetry('Login Page/optEnv', 3, 10)
        Windows.delay(20)
    }

    @Keyword
    def getEnvironmentIndex(String environment) {
        int env = 3

        switch (environment) {
            case 'PROD':
                env = 1
                break
            case 'PREX':
                env = 2
                break
            case 'REC2':
                env = 3
                break
            case 'REC':
                env = 4
                break
            case 'DEV2':
                env = 5
                break
            case 'DEV':
                env = 6
                break
        }

        return env
    }

    @Keyword
    def selectEnvironment(String environment) {
        int env = getEnvironmentIndex(environment)

        for (int i = 0; i < env; i++) {
            Windows.sendKeys(findWindowsObject('Login Page/optEnv'), Keys.chord(Keys.ARROW_DOWN))
        }

        Windows.sendKeys(findWindowsObject('Login Page/optEnv'), Keys.chord(Keys.ENTER))
        Windows.delay(7)
    }

    @Keyword
    def clickConnectIfPresent() {
        boolean isButtonPresent = Windows.verifyElementPresent(findWindowsObject('Login Page/btnConnecter'), 1, FailureHandling.OPTIONAL)

        if (isButtonPresent) {
            Windows.click(findWindowsObject('Login Page/btnConnecter'))
            return true
        }

        return false
    }

    @Keyword
    def waitForEMatchHome() {
        try {
            Windows.waitForElementPresent(findWindowsObject('General/txtSearch'), 60)
        } catch (Exception e) {
        }

        Windows.delay(10)
    }

    @Keyword
    def getHomeImagePath() {
        return new File(RunConfiguration.getProjectDir(), 'Images/General/Home.PNG').getAbsolutePath()
    }

    @Keyword
    def clickHomeImage() {
        WindowsImageKeywords.clickImage(getHomeImagePath())
        Windows.delay(5)
    }
}



