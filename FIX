package commands

import java.text.Normalizer

import org.apache.poi.ss.usermodel.DataFormatter
import org.apache.poi.ss.usermodel.Row
import org.apache.poi.ss.usermodel.Sheet
import org.apache.poi.ss.usermodel.Workbook
import org.apache.poi.ss.usermodel.WorkbookFactory

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration


class TestToolValidationKeywords {

	private static final String SOURCE_TABLE_KEY =
		'sourceTable'

	private static final String RESULT_TEST_TOP_KEY =
		'resultTestTop'

	private static final String RESULT_TEST_DISTINCT_KEY =
		'resultTestDistinct'

	private static final String RESULT_TEST_COUNT_KEY =
		'resultTestCount'


	// ======================================================
	// PUBLIC KEYWORD
	// ======================================================

	@Keyword
	Map validateSourceTable(
			String dataFileRelativePath,
			String expectedSourceTable,
			String expectedResult
	) {

		Map result =
			createInitialResult(
				expectedSourceTable,
				expectedResult
			)

		String validationError =
			validateParameters(
				dataFileRelativePath,
				expectedSourceTable,
				expectedResult
			)

		if (!validationError.isEmpty()) {

			return failResult(
				result,
				validationError,
				'CONFIGURATION',
				'VALID VALUE',
				'EMPTY',
				0
			)
		}

		File sourceFile =
			resolveProjectFile(
				dataFileRelativePath
			)

		result.fileName =
			sourceFile.getName()

		result.filePath =
			sourceFile.getAbsolutePath()

		if (!sourceFile.exists() ||
			!sourceFile.isFile()) {

			return failResult(
				result,
				'Test Tool source file was not found.',
				'FILE',
				sourceFile.getAbsolutePath(),
				'NOT FOUND',
				0
			)
		}

		if (sourceFile.length() <= 0) {

			return failResult(
				result,
				'Test Tool source file is empty.',
				'FILE',
				'NON-EMPTY FILE',
				'EMPTY',
				0
			)
		}

		Workbook workbook = null

		try {

			workbook =
				WorkbookFactory.create(
					sourceFile
				)

			if (workbook.getNumberOfSheets() <= 0) {

				return failResult(
					result,
					'Test Tool source file does not contain any worksheet.',
					'WORKSHEET',
					'EXISTING WORKSHEET',
					'NOT FOUND',
					0
				)
			}

			DataFormatter formatter =
				new DataFormatter()

			boolean validHeaderFound =
				false

			for (Integer sheetIndex = 0;
					sheetIndex < workbook.getNumberOfSheets();
					sheetIndex++) {

				Sheet sheet =
					workbook.getSheetAt(
						sheetIndex
					)

				Map headerLocation =
					findHeaderLocation(
						sheet,
						formatter
					)

				if (headerLocation.isEmpty()) {
					continue
				}

				Integer headerRowIndex =
					headerLocation.headerRowIndex as Integer

				Map<String, Integer> headerIndexes =
					headerLocation.headerIndexes as
						Map<String, Integer>

				String missingColumn =
					findMissingColumn(
						headerIndexes
					)

				if (!missingColumn.isEmpty()) {

					return failResult(
						result,
						'Required Test Tool column was not found.',
						missingColumn,
						'EXISTING COLUMN',
						'NOT FOUND',
						headerRowIndex + 1
					)
				}

				validHeaderFound =
					true

				Map matchingRow =
					findSourceTableRow(
						sheet,
						formatter,
						headerIndexes,
						headerRowIndex,
						expectedSourceTable
					)

				if (matchingRow.isEmpty()) {
					continue
				}

				return validateMatchingRow(
					result,
					sheet,
					formatter,
					headerIndexes,
					matchingRow,
					expectedResult
				)
			}

			if (!validHeaderFound) {

				return failResult(
					result,
					'Test Tool header was not found in the source file.',
					'SETTING : Source_Table',
					'EXISTING COLUMN',
					'NOT FOUND',
					1
				)
			}

			return failResult(
				result,
				'Expected source table was not found in the Test Tool file.',
				'SETTING : Source_Table',
				expectedSourceTable.trim(),
				'NOT FOUND',
				0
			)

		} catch (Throwable error) {

			return failResult(
				result,
				'Test Tool validation could not be completed. ' +
				'Reason: ' +
				getErrorMessage(error),
				'VALIDATION EXECUTION',
				'SUCCESS',
				getErrorMessage(error),
				0
			)

		} finally {

			closeWorkbook(
				workbook
			)
		}
	}


	// ======================================================
	// SOURCE TABLE SEARCH
	// ======================================================

	private Map findSourceTableRow(
			Sheet sheet,
			DataFormatter formatter,
			Map<String, Integer> headerIndexes,
			Integer headerRowIndex,
			String expectedSourceTable
	) {

		Integer sourceTableColumnIndex =
			headerIndexes.get(
				SOURCE_TABLE_KEY
			)

		for (Integer rowIndex =
				headerRowIndex + 1;
				rowIndex <= sheet.getLastRowNum();
				rowIndex++) {

			Row row =
				sheet.getRow(
					rowIndex
				)

			if (row == null) {
				continue
			}

			String currentSourceTable =
				getCellValue(
					row,
					sourceTableColumnIndex,
					formatter
				)

			if (isSameText(
					currentSourceTable,
					expectedSourceTable)) {

				return [
					row       : row,
					rowNumber : rowIndex + 1,
					sourceTable:
						currentSourceTable
				]
			}
		}

		return [:]
	}


	// ======================================================
	// RESULT VALIDATION
	// ======================================================

	private Map validateMatchingRow(
			Map result,
			Sheet sheet,
			DataFormatter formatter,
			Map<String, Integer> headerIndexes,
			Map matchingRow,
			String expectedResult
	) {

		Row row =
			matchingRow.row as Row

		Integer rowNumber =
			matchingRow.rowNumber as Integer

		String actualSourceTable =
			safeText(
				matchingRow.sourceTable
			)

		String resultTestTop =
			getCellValue(
				row,
				headerIndexes.get(
					RESULT_TEST_TOP_KEY
				),
				formatter
			)

		String resultTestDistinct =
			getCellValue(
				row,
				headerIndexes.get(
					RESULT_TEST_DISTINCT_KEY
				),
				formatter
			)

		String resultTestCount =
			getCellValue(
				row,
				headerIndexes.get(
					RESULT_TEST_COUNT_KEY
				),
				formatter
			)

		result.actualSourceTable =
			actualSourceTable

		result.worksheet =
			sheet.getSheetName()

		result.excelRow =
			rowNumber

		result.resultTestTop =
			resultTestTop

		result.resultTestDistinct =
			resultTestDistinct

		result.resultTestCount =
			resultTestCount

		List<Map> validations = [
			[
				column : 'RESULT TEST_TOP',
				value  : resultTestTop
			],
			[
				column : 'RESULT TEST_DISTINCT',
				value  : resultTestDistinct
			],
			[
				column : 'RESULT TEST_COUNT',
				value  : resultTestCount
			]
		]

		for (Map validation : validations) {

			String columnName =
				safeText(
					validation.column
				)

			String actualValue =
				safeText(
					validation.value
				)

			if (!isSameText(
					actualValue,
					expectedResult)) {

				return failResult(
					result,
					'Test Tool result column does not contain the expected value.',
					columnName,
					expectedResult.trim(),
					actualValue.isEmpty()
						? 'EMPTY'
						: actualValue,
					rowNumber
				)
			}
		}

		result.passed =
			true

		result.message =
			'All required Test Tool result columns contain the expected value.'

		return result
	}


	// ======================================================
	// HEADER SEARCH
	// ======================================================

	private Map findHeaderLocation(
			Sheet sheet,
			DataFormatter formatter
	) {

		Integer maximumHeaderRow =
			Math.min(
				sheet.getLastRowNum(),
				20
			)

		for (Integer rowIndex = 0;
				rowIndex <= maximumHeaderRow;
				rowIndex++) {

			Row row =
				sheet.getRow(
					rowIndex
				)

			if (row == null) {
				continue
			}

			Map<String, Integer> headerIndexes =
				findHeaderIndexes(
					row,
					formatter
				)

			if (headerIndexes.containsKey(
					SOURCE_TABLE_KEY)) {

				return [
					headerRowIndex : rowIndex,
					headerIndexes  : headerIndexes
				]
			}
		}

		return [:]
	}

	private Map<String, Integer> findHeaderIndexes(
			Row headerRow,
			DataFormatter formatter
	) {

		Map<String, Integer> indexes =
			[:]

		Integer lastCellNumber =
			headerRow.getLastCellNum() as Integer

		if (lastCellNumber == null ||
			lastCellNumber < 0) {

			return indexes
		}

		for (Integer cellIndex = 0;
				cellIndex < lastCellNumber;
				cellIndex++) {

			String headerValue =
				getCellValue(
					headerRow,
					cellIndex,
					formatter
				)

			String headerKey =
				resolveHeaderKey(
					headerValue
				)

			if (!headerKey.isEmpty() &&
				!indexes.containsKey(
					headerKey)) {

				indexes.put(
					headerKey,
					cellIndex
				)
			}
		}

		return indexes
	}

	private String resolveHeaderKey(
			String headerValue
	) {

		String normalizedHeader =
			normalizeHeader(
				headerValue
			)

		if (normalizedHeader ==
				'setting source table' ||
			normalizedHeader ==
				'source table') {

			return SOURCE_TABLE_KEY
		}

		if (normalizedHeader ==
			'result test top') {

			return RESULT_TEST_TOP_KEY
		}

		if (normalizedHeader ==
			'result test distinct') {

			return RESULT_TEST_DISTINCT_KEY
		}

		if (normalizedHeader ==
			'result test count') {

			return RESULT_TEST_COUNT_KEY
		}

		return ''
	}

	private String findMissingColumn(
			Map<String, Integer> headerIndexes
	) {

		List<Map> requiredColumns = [
			[
				key  : SOURCE_TABLE_KEY,
				name : 'SETTING : Source_Table'
			],
			[
				key  : RESULT_TEST_TOP_KEY,
				name : 'RESULT TEST_TOP'
			],
			[
				key  : RESULT_TEST_DISTINCT_KEY,
				name : 'RESULT TEST_DISTINCT'
			],
			[
				key  : RESULT_TEST_COUNT_KEY,
				name : 'RESULT TEST_COUNT'
			]
		]

		for (Map requiredColumn :
			requiredColumns) {

			String key =
				requiredColumn.key as String

			if (!headerIndexes.containsKey(key)) {

				return requiredColumn.name as String
			}
		}

		return ''
	}


	// ======================================================
	// RESULT CREATION
	// ======================================================

	private Map createInitialResult(
			String expectedSourceTable,
			String expectedResult
	) {

		return [
			passed              : false,
			fileName            : '',
			filePath            : '',
			expectedSourceTable : safeText(
				expectedSourceTable
			),
			actualSourceTable   : 'NOT FOUND',
			expectedValue       : safeText(
				expectedResult
			),
			worksheet           : '',
			excelRow            : 0,
			resultTestTop       : '',
			resultTestDistinct  : '',
			resultTestCount     : '',
			failedColumn        : '',
			actualValue         : '',
			message             : ''
		]
	}

	private Map failResult(
			Map result,
			String message,
			String failedColumn,
			String expectedValue,
			String actualValue,
			Integer excelRow
	) {

		result.passed =
			false

		result.message =
			message

		result.failedColumn =
			failedColumn

		result.expectedValue =
			expectedValue

		result.actualValue =
			actualValue

		if (excelRow != null &&
			excelRow > 0) {

			result.excelRow =
				excelRow
		}

		return result
	}


	// ======================================================
	// CELL READING
	// ======================================================

	private String getCellValue(
			Row row,
			Integer columnIndex,
			DataFormatter formatter
	) {

		if (row == null ||
			columnIndex == null ||
			columnIndex < 0) {

			return ''
		}

		def cell =
			row.getCell(
				columnIndex
			)

		if (cell == null) {
			return ''
		}

		return safeText(
			formatter.formatCellValue(
				cell
			)
		)
	}


	// ======================================================
	// SUPPORT
	// ======================================================

	private File resolveProjectFile(
			String relativePath
	) {

		String normalizedPath =
			relativePath
				.trim()
				.replace(
					'/',
					File.separator
				)
				.replace(
					'\\',
					File.separator
				)

		while (normalizedPath.startsWith(
				File.separator)) {

			normalizedPath =
				normalizedPath.substring(1)
		}

		return new File(
			RunConfiguration.getProjectDir(),
			normalizedPath
		)
	}

	private String validateParameters(
			String dataFileRelativePath,
			String expectedSourceTable,
			String expectedResult
	) {

		if (safeText(
				dataFileRelativePath
			).isEmpty()) {

			return 'Data file relative path is empty.'
		}

		if (safeText(
				expectedSourceTable
			).isEmpty()) {

			return 'Expected source table is empty.'
		}

		if (safeText(
				expectedResult
			).isEmpty()) {

			return 'Expected result is empty.'
		}

		return ''
	}

	private boolean isSameText(
			String firstValue,
			String secondValue
	) {

		return normalizeText(
			firstValue
		) == normalizeText(
			secondValue
		)
	}

	private String normalizeHeader(
			String value
	) {

		return normalizeText(value)
			.replace('_', ' ')
			.replace(':', ' ')
			.replace('-', ' ')
			.replaceAll('\\s+', ' ')
			.trim()
	}

	private String normalizeText(
			String value
	) {

		if (value == null) {
			return ''
		}

		return Normalizer
			.normalize(
				value,
				Normalizer.Form.NFD
			)
			.replaceAll(
				'\\p{M}',
				''
			)
			.trim()
			.toLowerCase()
			.replaceAll(
				'\\s+',
				' '
			)
	}

	private void closeWorkbook(
			Workbook workbook
	) {

		try {

			if (workbook != null) {
				workbook.close()
			}

		} catch (Exception ignored) {
		}
	}

	private String safeText(
			Object value
	) {

		if (value == null) {
			return ''
		}

		return value
			.toString()
			.trim()
	}

	private String getErrorMessage(
			Throwable error
	) {

		if (error == null) {
			return 'Unknown error.'
		}

		String message =
			error.getMessage()

		if (message == null ||
			message.trim().isEmpty()) {

			return error
				.getClass()
				.getSimpleName()
		}

		return message.trim()
	}
}
