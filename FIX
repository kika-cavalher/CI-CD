    private String resolveVersionFromRefLogin(String env) {
        TestData td = resolveRefLoginData()
        if (td == null) {
            return ''
        }

        String expectedEnv = normalizeEnv(env)

        try {
            int rows = td.getRowNumbers()

            for (int row = 1; row <= rows; row++) {
                String rowEnv = normalizeEnv(safe(td.getValue('Env1', row)))
                String rowVersion = safe(td.getValue('Version', row))

                if (rowEnv == expectedEnv && rowVersion) {
                    return rowVersion
                }
            }
        } catch (Throwable ignored) {
        }

        return ''
    }

    private TestData resolveRefLoginData() {
        List<String> candidates = [
            'refLogin',
            'Data Files/refLogin'
        ]

        for (String path : candidates) {
            try {
                TestData td = findTestData(path)
                if (td != null) {
                    return td
                }
            } catch (Throwable ignored) {
            }
        }

        return null
    }

    private String normalizeEnv(String env) {
        String value = safe(env).toUpperCase()

        switch (value) {
            case 'PROD':
            case 'PRD':
                return 'PROD'
            case 'PREO':
            case 'PREPROD':
            case 'BENCH':
                return 'PREO'
            case 'REC2':
            case 'QUALIFICATION':
                return 'REC2'
            case 'REC':
            case 'RECETTE':
                return 'REC'
            case 'DEV2':
            case 'SIMULATION':
                return 'DEV2'
            case 'DEV':
            case 'DEVELOPMENT':
                return 'DEV'
            default:
                return value ?: 'REC'
        }
    }

    private String resolveShortcutEnvLabel(String env) {
        switch (normalizeEnv(env)) {
            case 'PROD':
                return 'Prod'
            case 'PREO':
                return 'PREO'
            case 'REC2':
                return 'REC2'
            case 'REC':
                return 'REC'
            case 'DEV2':
                return 'DEV2'
            case 'DEV':
                return 'DEV'
            default:
                return 'REC'
        }
    }

    private String resolveApplicationEnvFolder(String env) {
        switch (normalizeEnv(env)) {
            case 'PROD':
                return 'PROD'
            case 'PREO':
                return 'PREO'
            case 'REC2':
                return 'REC2'
            case 'REC':
                return 'REC'
            case 'DEV2':
                return 'DEV2'
            case 'DEV':
                return 'DEV'
            default:
                return 'REC'
        }
    }

    private String normalizeExpectedTitle(String targetWindowTitle) {
        String title = safe(targetWindowTitle)

        if (!title) {
            title = resolveWindowTitle()
        }

        String version = extractVersion(title)
        if (version) {
            return "eMatch ${version}".trim()
        }

        title = title.replaceAll(/\s+/, ' ').trim()
        title = title.replaceFirst(/(?i)^ematch\s+ematch\s+/, 'eMatch ')

        if (!title.toLowerCase().startsWith('ematch')) {
            title = "eMatch ${title}"
        }

        return title.replaceAll(/\s+/, ' ').trim()
    }

    private String extractVersion(String text) {
        String value = safe(text)
        def matcher = (value =~ /(\d+\.\d+\.\d+\.\d+)/)
        return matcher.find() ? matcher.group(1) : ''
    }

    private void ensureWinAppDriverRunning() {
        if (isPortOpen('127.0.0.1', 4723, 1000)) {
            return
        }

        String winAppDriverPath = getWinAppDriverPath()
        if (!fileExists(winAppDriverPath)) {
            KeywordUtil.markFailedAndStop("WinAppDriver was not found at ${winAppDriverPath}")
        }

        KeywordUtil.logInfo("Starting WinAppDriver minimized from ${winAppDriverPath}")
        runDetached("start \"\" /min \"${winAppDriverPath}\"")

        long end = System.currentTimeMillis() + (25 * 1000)
        while (System.currentTimeMillis() < end) {
            if (isPortOpen('127.0.0.1', 4723, 1000)) {
                KeywordUtil.logInfo("WinAppDriver is ready on 127.0.0.1:4723")
                return
            }
            sleep(1000)
        }

        KeywordUtil.markFailedAndStop("WinAppDriver did not start on port 4723.")
    }

    private Map waitForEMatchWindow(String expectedTitle, int timeoutSeconds) {
        long end = System.currentTimeMillis() + (timeoutSeconds * 1000L)

        while (System.currentTimeMillis() < end) {
            Map window = findMatchingEMatchWindow(expectedTitle)
            if (isValidWindow(window)) {
                return window
            }
            sleep(1000)
        }

        return [title: '', handle: '']
    }

    private Map findMatchingEMatchWindow(String expectedTitle) {
        String exactTitle = normalizeExpectedTitle(expectedTitle)
        String versionOnly = extractVersion(exactTitle)

        String ps = """
\$ErrorActionPreference = 'SilentlyContinue'
\$expected = '${ps(exactTitle)}'
\$version = '${ps(versionOnly)}'

\$candidates = Get-Process -ErrorAction SilentlyContinue |
    Where-Object {
        \$_.MainWindowHandle -ne 0 -and
        \$_.MainWindowTitle -and
        (
            \$_.ProcessName -like 'IXIS.eMatch*' -or
            \$_.ProcessName -like 'eMatch*' -or
            \$_.MainWindowTitle -eq \$expected -or
            (\$version -and \$_.MainWindowTitle -like "*\$version*")
        )
    } |
    Sort-Object StartTime

\$match = \$candidates | Where-Object { \$_.MainWindowTitle -eq \$expected } | Select-Object -First 1
if (-not \$match -and \$version) {
    \$match = \$candidates | Where-Object { \$_.MainWindowTitle -like "*\$version*" } | Select-Object -First 1
}
if (-not \$match) {
    \$match = \$candidates | Select-Object -First 1
}

if (\$match -and \$match.MainWindowHandle -ne 0) {
    Write-Output ("\$([string]\$match.MainWindowTitle)||\$([int64]\$match.MainWindowHandle)")
}
"""

        String out = safe(runPowerShell(ps, 15))
        if (!out || !out.contains('||')) {
            return [title: '', handle: '']
        }

        List<String> parts = out.split(/\|\|/, 2) as List<String>
        String title = safe(parts[0])
        String handle = safe(parts[1])

        if (!title || !handle || handle == '0') {
            return [title: '', handle: '']
        }

        return [title: title, handle: handle]
    }

    private boolean isValidWindow(Map window) {
        return window != null &&
               safe(window.title) &&
               safe(window.handle) &&
               safe(window.handle) != '0'
    }

    private void activateWindow(String title, String handle) {
        String safeTitle = safe(title)
        String safeHandle = safe(handle)

        if (!safeTitle) {
            return
        }

        String ps = """
\$ErrorActionPreference = 'SilentlyContinue'
Add-Type @"
using System;
using System.Runtime.InteropServices;
public static class NativeUser32 {
    [DllImport("user32.dll")] public static extern bool ShowWindowAsync(IntPtr hWnd, int nCmdShow);
    [DllImport("user32.dll")] public static extern bool SetForegroundWindow(IntPtr hWnd);
}
"@

\$wshell = New-Object -ComObject WScript.Shell
\$null = \$wshell.AppActivate('${ps(safeTitle)}')

if ('${ps(safeHandle)}') {
    try {
        \$h = [IntPtr]::new([int64]'${ps(safeHandle)}')
        [NativeUser32]::ShowWindowAsync(\$h, 9) | Out-Null
        [NativeUser32]::SetForegroundWindow(\$h) | Out-Null
    } catch {
    }
}
"""
        runPowerShell(ps, 10)
    }

    private boolean isLoginWindowReady() {
        return waitForPresent(getEnvironmentCombo(), 5) && waitForPresent(getConnectButton(), 5)
    }

    private boolean waitForPresent(WindowsTestObject obj, int timeoutSeconds) {
        long end = System.currentTimeMillis() + (timeoutSeconds * 1000L)

        while (System.currentTimeMillis() < end) {
            try {
                if (Windows.waitForElementPresent(obj, 1, FailureHandling.OPTIONAL)) {
                    return true
                }
            } catch (Throwable ignored) {
            }
            sleep(500)
        }

        return false
    }

