/*
 * Responsibility:
 * Store and read desktop suite execution metadata.
 */

import groovy.json.JsonOutput
import groovy.json.JsonSlurperClassic

def safeFileName(String value) {
    return (value ?: '').replaceAll(/[^A-Za-z0-9._ -]/, '').replace(' ', '_')
}

def parsePropertiesText(String text) {
    def map = [:]

    if (!text?.trim()) {
        return map
    }

    text.readLines().each { line ->
        int idx = line.indexOf('=')
        if (idx > 0) {
            def key = line.substring(0, idx).trim()
            def value = line.substring(idx + 1).trim()
            map[key] = value
        }
    }

    return map
}

def splitSummary(String value) {
    if (!value?.trim()) {
        return []
    }

    return value.split('\\|\\|').collect { it.trim() }.findAll { it }
}

def readAssetMeta(script, String reportsRoot, String assetName) {
    def metaPath = "${reportsRoot}\\logs\\${safeFileName(assetName)}.meta.properties"

    if (!script.fileExists(metaPath)) {
        return [:]
    }

    return parsePropertiesText(script.readFile(file: metaPath, encoding: 'UTF-8'))
}

def saveResults(script, String reportsRoot, List results) {
    def json = JsonOutput.prettyPrint(JsonOutput.toJson(results))

    script.writeFile(
        file: "${reportsRoot}\\suite-results.json",
        text: json,
        encoding: 'UTF-8'
    )
}

def loadResults(script, String reportsRoot) {
    def filePath = "${reportsRoot}\\suite-results.json"

    if (!script.fileExists(filePath)) {
        return []
    }

    def text = script.readFile(file: filePath, encoding: 'UTF-8')
    if (!text?.trim()) {
        return []
    }

    return new JsonSlurperClassic().parseText(text)
}

