	// GENERAL HELPERS
	// ======================================================

	private int parseIntOrZero(String value) {
		try {
			return Integer.parseInt(safeText(value))
		} catch (Exception ignored) {
			return 0
		}
	}

	private int countOccurrences(
			String text,
			String token) {

		int count = 0
		int index = 0

		while (index >= 0) {
			index = text.indexOf(token, index)

			if (index >= 0) {
				count++
				index = index + token.length()
			}
		}

		return count
	}

	private boolean isTrue(String value) {
		String text = safeText(value).toLowerCase()

		return text == 'true' ||
				text == 'yes' ||
				text == 'y' ||
				text == '1' ||
				text == 'sim'
	}

	private String safeText(Object value) {
		if (value == null) {
			return ''
		}

		return value.toString().trim()
	}

	private void closeWorkbook(Workbook workbook) {
		try {
			if (workbook != null) {
				workbook.close()
			}
		} catch (Exception ignored) {
		}
	}

	private void closeInput(FileInputStream input) {
		try {
			if (input != null) {
				input.close()
			}
		} catch (Exception ignored) {
		}
	}

