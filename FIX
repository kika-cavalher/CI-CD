	List<File> getFailureImages() {
		List<File> images = []
		String reportPath = getResolvedReportPath()

		if (isBlank(reportPath)) {
			return images
		}

		File reportDir = new File(reportPath)

		reportDir.eachFileRecurse(FileType.FILES) { file ->
			String lower = file.name.toLowerCase()

			if (lower.endsWith('.png') || lower.endsWith('.jpg') || lower.endsWith('.jpeg') || lower.endsWith('.webp')) {
				images.add(file)
			}
		}

		images.sort { a, b -> a.lastModified() <=> b.lastModified() }
		return images
	}

	Map parseJUnitSuite(String xmlFilePath) {
		def xml = new XmlSlurper(false, false).parse(new File(xmlFilePath))

		String suiteName = xml.@name?.text()
		if (isBlank(suiteName)) {
			suiteName = getCurrentSuiteName()
		}

		String timestamp = new SimpleDateFormat("EEE MMM dd HH:mm:ss z yyyy").format(new Date())
		BigDecimal suiteTime = 0
		List<Map> failedTests = []
		List<Map> passedTests = []

		List<File> failureImages = getFailureImages()
		int failureImageIndex = 0

		xml.depthFirst().findAll { it.name() == 'testcase' }.each { tc ->
			String className = tc.@classname?.text()
			String testName = tc.@name?.text()
			BigDecimal timeSeconds = 0

			try {
				timeSeconds = new BigDecimal(tc.@time?.text() ?: '0')
			} catch (Exception ignored) {
				timeSeconds = 0
			}

			suiteTime += timeSeconds

			boolean failed = tc.failure.size() > 0 || tc.error.size() > 0
			String failureMessage = ''
			String stackTrace = ''
			String imageData = ''

			if (failed) {
				def node = tc.failure.size() > 0 ? tc.failure[0] : tc.error[0]
				failureMessage = node.@message?.text() ?: node.text() ?: ''
				stackTrace = node.text() ?: ''

				if (failureImageIndex < failureImages.size()) {
					imageData = toDataUri(failureImages[failureImageIndex])
					failureImageIndex++
				}
			}

			Map item = [
				className      : className,
				testName       : testName,
				timeSeconds    : timeSeconds,
				failureMessage : failureMessage,
				stackTrace     : stackTrace,
				imageData      : imageData
			]

			if (failed) {
				failedTests.add(item)
			} else {
				passedTests.add(item)
			}
		}

		return [
			suiteName   : suiteName,
			startText   : timestamp,
			endText     : timestamp,
			suiteTime   : suiteTime,
			executed    : failedTests.size() + passedTests.size(),
			passed      : passedTests.size(),
			failed      : failedTests.size(),
			skipped     : 0,
			failedTests : failedTests,
			passedTests : passedTests
		]
	}

