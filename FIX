					'REC image: General/iconeModal\n' +
					'PRD image: General/iconeModalPRD'
					)

			return
		}

		logInfo(
				'Open-file modal detected using image ' +
				detectedModalImage +
				'. Closing with TAB and ENTER.'
				)

		try {
			Robot robot = new Robot()

			robot.setAutoDelay(
					150
					)

			robot.keyPress(
					KeyEvent.VK_TAB
					)

			robot.keyRelease(
