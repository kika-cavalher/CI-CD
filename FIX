            archiveArtifacts artifacts: 'Reports/**/*', allowEmptyArchive: true, excludes: '**/*.lck'

            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE', catchInterruptions: false) {
                junit allowEmptyResults: true, testResults: 'Reports/**/JUnit_Report.xml, Reports/**/junit*.xml, Reports/**/TEST-*.xml'
            }

            script {
                def result = currentBuild.currentResult ?: 'UNKNOWN'

                if (result == 'SUCCESS') {
                    echo "SUCCESS: All good"
                } else if (result == 'UNSTABLE') {
                    echo "UNSTABLE: Finished with test failures"
                } else if (result == 'ABORTED') {
                    echo "ABORTED: Build was canceled by user"
                } else {
                    echo "FAILURE: Pipeline failed. Check console and reports"
                }
            }
        }

        aborted {
            echo 'ABORTED: cancel requested by user. Stopping visible execution now...'

            bat """
                @echo off
                REM Stop only the visible execution bridge immediately

                schtasks /end /tn "${env.VISIBLE_TASK_NAME}" >nul 2>&1
                taskkill /IM katalonc.exe /T /F >nul 2>&1
                taskkill /IM chrome.exe /T /F >nul 2>&1
                taskkill /IM chromedriver.exe /T /F >nul 2>&1
                taskkill /FI "WINDOWTITLE eq GAIA_VISIBLE_RUNNER*" /T /F >nul 2>&1
                taskkill /FI "WINDOWTITLE eq Administrator: GAIA_VISIBLE_RUNNER*" /T /F >nul 2>&1

                exit /b 0
            """
        }
    }
}

/**
 * Execute one suite.
 * Visible mode uses Windows Task Scheduler to open Chrome in the correct session.
 * Headless mode executes directly in Jenkins.
 */
def runGaiaSuite(String projectPath, Map suite) {
    def reportPath = "${env.WORKSPACE}\\${env.REPORTS_DIR}\\${suite.name}"

    echo "========================================"
    echo "Starting suite execution"
    echo "Suite Name   : ${suite.name}"
    echo "Suite Path   : ${suite.path}"
    echo "Run Mode     : ${params.RUN_MODE}"
    echo "Project Path : ${projectPath}"
    echo "Report Path  : ${reportPath}"
    echo "========================================"

    bat """
        @echo off
        REM Prepare suite report folder

        if exist "${reportPath}" rmdir /s /q "${reportPath}"
        mkdir "${reportPath}"

        exit /b 0
    """

    if (params.RUN_MODE == 'HEADLESS') {
        def chromeArgs = buildChromeArgs('HEADLESS')

        executeKatalon(
            location: env.KATALON_HOME,
            executeArgs:
                "-projectPath=\"${projectPath}\" " +
                "-testSuitePath=\"${suite.path}\" " +
                "-browserType=\"Chrome\" " +
                "-consoleLog -logLevel=DEBUG " +
                "-reportFolder=\"${reportPath}\" " +
                chromeArgs,
            version: '',
            x11Display: '',
            xvfbConfiguration: ''
        )

        echo "Headless suite finished: ${suite.name}"
        return
    }

    // Visible mode: stop old visible leftovers before starting the next suite
    bat """
        @echo off
        REM Clear visible leftovers before the next suite

        schtasks /end /tn "${env.VISIBLE_TASK_NAME}" >nul 2>&1
        taskkill /IM katalonc.exe /T /F >nul 2>&1
        taskkill /IM chrome.exe /T /F >nul 2>&1
        taskkill /IM chromedriver.exe /T /F >nul 2>&1
        taskkill /FI "WINDOWTITLE eq GAIA_VISIBLE_RUNNER*" /T /F >nul 2>&1
        taskkill /FI "WINDOWTITLE eq Administrator: GAIA_VISIBLE_RUNNER*" /T /F >nul 2>&1

        if exist "${env.VISIBLE_STATUS_FILE}" del /f /q "${env.VISIBLE_STATUS_FILE}" >nul 2>&1
        if exist "${env.VISIBLE_LOG_FILE}" del /f /q "${env.VISIBLE_LOG_FILE}" >nul 2>&1

        exit /b 0
    """

    createVisibleCommandFile(projectPath, suite, reportPath)

    bat """
        @echo off
        REM Trigger the visible task that runs in the correct Windows session

        schtasks /run /tn "${env.VISIBLE_TASK_NAME}"
        exit /b 0
    """

    waitForVisibleSuite(suite.name)

    def exitCode = bat(
        returnStdout: true,
        script: """
            @echo off
            REM Read suite result from the visible status file

            if not exist "${env.VISIBLE_STATUS_FILE}" (
                echo 999
                exit /b 0
            )

            for /f "tokens=2 delims==" %%A in ('type "${env.VISIBLE_STATUS_FILE}" ^| findstr /B "EXIT_CODE="') do echo %%A
            exit /b 0
        """
    ).trim()

    echo "Visible suite exit code for ${suite.name}: ${exitCode}"

    if (exitCode != '0') {
        bat """
            @echo off
            REM Print the visible execution log when the suite fails

            if exist "${env.VISIBLE_LOG_FILE}" (
                echo ===== VISIBLE RUNNER LOG: ${suite.name} =====
                powershell -NoProfile -Command "Get-Content '${env.VISIBLE_LOG_FILE}' | Select-Object -Last 120"
            )

            exit /b 0
        """

        error("Suite ${suite.name} failed with exit code ${exitCode}")
    }

    echo "Visible suite finished successfully: ${suite.name}"
}

/**
 * Create the command file executed by the Scheduled Task.
 * This file is recreated for each visible suite.
 */
def createVisibleCommandFile(String projectPath, Map suite, String reportPath) {
    bat """
        @echo off
        REM Recreate the visible command file with the current suite information

        (
            echo @echo off
            echo setlocal
            echo title GAIA_VISIBLE_RUNNER
            echo cd /d "${env.WORKSPACE}"
            echo call "C:\\Gaia\\set_java_17_gaia.bat"
            echo call "${env.KATALON_HOME}\\katalonc.exe" -projectPath="${projectPath}" -testSuitePath="${suite.path}" -browserType="Chrome" -consoleLog -logLevel=DEBUG -reportFolder="${reportPath}" --config -webui.chrome.args="--window-size=${env.DISPLAY_WIDTH},${env.DISPLAY_HEIGHT} --start-maximized"
            echo set EXIT_CODE=%%ERRORLEVEL%%
            echo ^> "${env.VISIBLE_STATUS_FILE}" echo EXIT_CODE=%%EXIT_CODE%%
            echo exit /b %%EXIT_CODE%%
        ) > "${env.VISIBLE_COMMAND_BAT}"

        echo ===== FILE CREATED IN C:\\Gaia =====
        type "${env.VISIBLE_COMMAND_BAT}"
        echo ====================================

        exit /b 0
    """
}

/**
 * Wait until the visible execution writes the status file.
 * Short polling makes manual abort more responsive.
 */
def waitForVisibleSuite(String suiteName) {
    int maxChecks = 240

    for (int i = 0; i < maxChecks; i++) {
        int found = bat(
            returnStatus: true,
            script: """
                @echo off
                if exist "${env.VISIBLE_STATUS_FILE}" (
                    exit /b 0
                ) else (
                    exit /b 1
                )
            """
        )

        if (found == 0) {
            echo "Status file found for suite: ${suiteName}"
            return
        }

        sleep(time: 2, unit: 'SECONDS')
    }

    error("Timeout waiting for visible suite: ${suiteName}")
}

/**
 * Build Chrome arguments according to the selected run mode.
 */
def buildChromeArgs(runMode) {
    if (runMode == 'HEADLESS') {
        def args = [
            '--headless=new',
            "--window-size=${env.DISPLAY_WIDTH},${env.DISPLAY_HEIGHT}",
            '--no-sandbox',
            '--disable-gpu',
            '--disable-dev-shm-usage'
        ]

        return "--config -webui.chrome.args='${args.join(' ')}'"
    }

    def args = [
        "--window-size=${env.DISPLAY_WIDTH},${env.DISPLAY_HEIGHT}",
        '--start-maximized'
    ]

    return "--config -webui.chrome.args='${args.join(' ')}'"
}
