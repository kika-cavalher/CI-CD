// ======================================================
// LANGUAGE
// ======================================================

@Keyword
void validateLanguageIsFrench() {
	validateLanguageIsFrench(3)
}

@Keyword
void validateLanguageIsFrench(Integer timeoutSeconds) {

	Integer timeout = safeTimeout(timeoutSeconds, 3)
	List<String> errors = []

	logStep(
			'LANGUAGE',
			'Validate that application language is already French'
			)

	// ======================================================
	// VALIDATION 1: FRENCH RADIO BUTTON STATE
	// ======================================================

	boolean languageStateImageFound =
			waitForOptionalImage(
			GENERAL_IMAGE_GROUP,
			'frLanguage',
			timeout
			)

	boolean languageStateValid = languageStateImageFound

	if (languageStateImageFound) {
		KeywordUtil.logInfo(
				'French language selection state validated by image.\n' +
				'Image: General.frLanguage'
				)
	} else {
		KeywordUtil.logInfo(
				'French language state image was not found.\n' +
				'Trying Windows elements.'
				)

		try {
			WindowsTestObject frenchRadioButton =
					WindowsObjectLoader.getObject(
					'language',
					'frenchRadioButton'
					)

			WindowsTestObject englishRadioButton =
					WindowsObjectLoader.getObject(
					'language',
					'englishRadioButton'
					)

			boolean frenchRadioPresent =
					Windows.verifyElementPresent(
					frenchRadioButton,
					timeout,
					FailureHandling.OPTIONAL
					)

			boolean englishRadioPresent =
					Windows.verifyElementPresent(
					englishRadioButton,
					timeout,
					FailureHandling.OPTIONAL
					)

			if (frenchRadioPresent && englishRadioPresent) {
				Boolean frenchSelected =
						readRadioSelectedState(
						frenchRadioButton,
						'frenchRadioButton'
						)

				Boolean englishSelected =
						readRadioSelectedState(
						englishRadioButton,
						'englishRadioButton'
						)

				languageStateValid =
						Boolean.TRUE.equals(frenchSelected) &&
						Boolean.FALSE.equals(englishSelected)

				KeywordUtil.logInfo(
						'Language radio state validation result.\n' +
						'French radio selected: ' + frenchSelected + '\n' +
						'English radio selected: ' + englishSelected
						)
			} else {
				KeywordUtil.logInfo(
						'Language radio buttons were not both available.\n' +
						'French radio present: ' + frenchRadioPresent + '\n' +
						'English radio present: ' + englishRadioPresent
						)
			}
		} catch (Exception e) {
			KeywordUtil.logInfo(
					'Could not validate language state using Windows elements.\n' +
					'Reason: ' + e.getMessage()
					)
		}
	}

	reportBooleanResult(
			languageStateValid,
			'French radio is selected and English radio is not selected.',
			'The language selection state does not indicate French.',
			errors
			)

	// ======================================================
	// VALIDATION 2: EXACT FRENCH TEXT
	// ======================================================

	boolean frenchTextImageFound =
			waitForOptionalImage(
			GENERAL_IMAGE_GROUP,
			'frenchLanguageText',
			timeout
			)

	boolean frenchTextElementFound = false

	if (frenchTextImageFound) {
		KeywordUtil.logInfo(
				'French language text validated by image.\n' +
				'Expected text: Français\n' +
				'Image: General.frenchLanguageText'
				)
	} else {
		KeywordUtil.logInfo(
				'French text image was not found.\n' +
				'Trying exact Windows element with Name Français.'
				)

		try {
			WindowsTestObject frenchLanguageText =
					WindowsObjectLoader.getObject(
					'language',
					'frenchLanguageText'
					)

			frenchTextElementFound =
					Windows.verifyElementPresent(
					frenchLanguageText,
					timeout,
					FailureHandling.OPTIONAL
					)

			KeywordUtil.logInfo(
					'French text element validation result.\n' +
					'Expected text: Français\n' +
					'Element found: ' + frenchTextElementFound
					)
		} catch (Exception e) {
			KeywordUtil.logInfo(
					'Could not validate French text using Windows element.\n' +
					'Reason: ' + e.getMessage()
					)
		}
	}

	boolean frenchTextValid =
			frenchTextImageFound ||
			frenchTextElementFound

	reportBooleanResult(
			frenchTextValid,
			'Exact French language text Français is visible.',
			'Exact French language text Français was not found.',
			errors
			)

	takeEvidence(
			'GUI_LanguageValidatedFrench.png'
			)

	if (errors.isEmpty()) {
		GlobalVariable.language = 'fr'
	}

	finishValidation(
			'French language validation',
			errors
			)
}

private boolean waitForOptionalImage(
		String imageGroup,
		String imageName,
		Integer timeoutSeconds
	) {
	try {
		return imageLoader.waitForImage(
				imageGroup,
				imageName,
				timeoutSeconds
				)
	} catch (Exception e) {
		KeywordUtil.logInfo(
				'Optional image was not found.\n' +
				'Image: ' + imageGroup + '.' + imageName + '\n' +
				'Reason: ' + e.getMessage()
				)

		return false
	}
}

private Boolean readRadioSelectedState(
		WindowsTestObject radioButton,
		String objectName
	) {
	List<String> attributes = [
		'SelectionItem.IsSelected',
		'IsSelected',
		'Toggle.ToggleState',
		'ToggleState'
	]

	for (String attributeName : attributes) {
		try {
			String attributeValue =
					Windows.getAttribute(
					radioButton,
					attributeName,
					FailureHandling.OPTIONAL
					)

			if (
			attributeValue == null ||
				attributeValue.trim().isEmpty()
				) {
				continue
			}

			String normalizedValue =
					attributeValue
					.trim()
					.toLowerCase()

			KeywordUtil.logInfo(
					'Radio button attribute read.\n' +
					'Object: ' + objectName + '\n' +
					'Attribute: ' + attributeName + '\n' +
					'Value: ' + attributeValue
					)

			if (
			normalizedValue == 'true' ||
				normalizedValue == '1' ||
				normalizedValue == 'selected' ||
				normalizedValue == 'checked' ||
				normalizedValue == 'on'
				) {
				return true
			}

			if (
			normalizedValue == 'false' ||
				normalizedValue == '0' ||
				normalizedValue == 'unselected' ||
				normalizedValue == 'unchecked' ||
				normalizedValue == 'off'
				) {
				return false
			}
		} catch (Exception ignored) {
		}
	}

	KeywordUtil.logInfo(
			'Could not determine radio button selection state.\n' +
			'Object: ' + objectName
			)

	return null
}

