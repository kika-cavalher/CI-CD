import com.kms.katalon.core.util.KeywordUtil

// ======================================================
// TEST TOOL CONFIG
// ======================================================

String dataFileRelativePath = 'Data Files/TestTool/source_tables.xlsx'

String screenName = 'Élément Valorisé'
String expectedSourceTable = 'data_section_emission_element_valorise'

// ======================================================
// TEST FLOW
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[INFO] Start Test Tool validation\n' +
		'Screen: ' + screenName + '\n' +
		'Expected source table: ' + expectedSourceTable
)

Map validationResult =
		CustomKeywords.'testTool.TestToolValidationKeywords.validateSourceTable'(
				dataFileRelativePath,
				screenName,
				expectedSourceTable
		)

if (!(validationResult.passed as Boolean)) {
	KeywordUtil.markFailedAndStop(
			'Test Tool validation failed.\n' +
			'Screen: ' + screenName + '\n' +
			'Expected source table: ' + expectedSourceTable + '\n' +
			'Actual source table: ' + validationResult.actualSourceTable
	)
}

KeywordUtil.markPassed(
		'Test Tool validation completed successfully.\n' +
		'Screen: ' + screenName + '\n' +
		'Source table: ' + validationResult.actualSourceTable
)
