	@Keyword
	void dragAndDropImage(
			String sourceImageKey,
			String targetImageKey,
			Integer waitSeconds
	) {

		Integer waitTime = safeTimeout(waitSeconds, 2)

		logStep(
				'DRAG AND DROP',
				'Source: ' + sourceImageKey + '\n' +
				'Target: ' + targetImageKey + '\n' +
				'Post-drag image validation: disabled'
				)

		String sourceImagePath =
				image(
				GUI_IMAGE_GROUP,
				sourceImageKey
				)

		String targetImagePath =
				image(
				GUI_IMAGE_GROUP,
				targetImageKey
				)

		def sourceRegion
		def targetRegion

		try {
			sourceRegion =
					WindowsImageKeywords.findImage(
					sourceImagePath
					)

			targetRegion =
					WindowsImageKeywords.findImage(
					targetImagePath
					)
		} catch (Exception e) {
			takeEvidence(
					'GUI_DragAndDropImageLookupFailed_' +
					sourceImageKey +
					'.png'
					)

			KeywordUtil.markFailedAndStop(
					'Could not locate the source or target before drag and drop.\n' +
					'Source: ' + sourceImageKey + '\n' +
					'Target: ' + targetImageKey + '\n' +
					'Reason: ' + safeMessage(e)
					)

			return
		}

		if (
		sourceRegion == null ||
				sourceRegion == false
				) {
			takeEvidence(
					'GUI_DragAndDropSourceNotFound_' +
					sourceImageKey +
					'.png'
					)

			KeywordUtil.markFailedAndStop(
					'Drag and drop source image was not found before the action.\n' +
					'Source: ' + sourceImageKey
					)

			return
		}

		if (
		targetRegion == null ||
				targetRegion == false
				) {
			takeEvidence(
					'GUI_DragAndDropTargetNotFound_' +
					targetImageKey +
					'.png'
					)

			KeywordUtil.markFailedAndStop(
					'Drag and drop target image was not found before the action.\n' +
					'Target: ' + targetImageKey
					)

			return
		}

		def sourceCenter =
				sourceRegion.getCenter()

		def targetCenter =
				targetRegion.getCenter()

		Integer sourceX =
				sourceCenter.getX() as Integer

		Integer sourceY =
				sourceCenter.getY() as Integer

		Integer targetX =
				targetCenter.getX() as Integer

		Integer targetY =
				targetCenter.getY() as Integer

		Robot robot = null
		boolean mousePressed = false

		try {
			robot = new Robot()

			robot.setAutoDelay(
					40
					)

			robot.mouseMove(
					sourceX,
					sourceY
					)

			Thread.sleep(
					250
					)

			robot.mousePress(
					InputEvent.BUTTON1_DOWN_MASK
					)

			mousePressed = true

			Thread.sleep(
					300
					)

			Integer movementSteps = 20

			for (
			Integer step = 1;
				step <= movementSteps;
				step++
				) {

				Integer currentX =
						sourceX +
						(
						(targetX - sourceX) *
						step /
						movementSteps
						) as Integer

				Integer currentY =
						sourceY +
						(
						(targetY - sourceY) *
						step /
						movementSteps
						) as Integer

				robot.mouseMove(
						currentX,
						currentY
						)

				Thread.sleep(
						35
						)
			}

			Thread.sleep(
					300
					)

			robot.mouseRelease(
					InputEvent.BUTTON1_DOWN_MASK
					)

			mousePressed = false
		} catch (Exception e) {
			if (
			mousePressed &&
					robot != null
					) {
				try {
					robot.mouseRelease(
							InputEvent.BUTTON1_DOWN_MASK
							)
				} catch (Exception ignored) {
				}
			}

			takeEvidence(
					'GUI_DragAndDropFailed_' +
					sourceImageKey +
					'.png'
					)

			KeywordUtil.markFailedAndStop(
					'Drag and drop action failed.\n' +
					'Source: ' + sourceImageKey + '\n' +
					'Target: ' + targetImageKey + '\n' +
					'Reason: ' + safeMessage(e)
					)

			return
		}

		Windows.delay(
				waitTime
				)

		KeywordUtil.logInfo(
				'[PASS] Drag and drop action completed.\n' +
				'Source: ' + sourceImageKey + '\n' +
				'Target: ' + targetImageKey + '\n' +
				'No image search or validation was executed after the drop.'
				)
	}



	@Keyword
	void validateGroupByResult(Integer timeoutSeconds) {

		Integer timeout = safeTimeout(timeoutSeconds, 10)
		List<String> errors = []

		logStep(
				'GROUP BY RESULT',
				'Open the first Grappe result row\n' +
				'Validate the first internal row\n' +
				'Expected image or object: secondGroupResultPrefix'
				)

		// ======================================================
		// TRY TO OPEN FIRST ROW USING IMAGE
		// ======================================================

		boolean firstRowClickedByImage =
				openFirstGroupResultByImage()

		boolean secondGroupVisible = false

		if (firstRowClickedByImage) {
			secondGroupVisible =
					waitForSecondGroupResult(
					timeout
					)
		}

		// ======================================================
		// ELEMENT FALLBACK IF IMAGE DID NOT OPEN THE ROW
		// ======================================================

		if (!secondGroupVisible) {
			KeywordUtil.logInfo(
					'[INFO] The internal Group By row was not visible after the image click.\n' +
					'Trying to open the first row using the Windows element.'
					)

			boolean firstRowOpenedByElement =
					openFirstGroupResultByElement(
					timeout
					)

			if (firstRowOpenedByElement) {
				secondGroupVisible =
						waitForSecondGroupResult(
						timeout
						)
			}
		}

		// ======================================================
		// FINAL VALIDATION
		// ======================================================

		if (!secondGroupVisible) {
			errors.add(
					'The first internal Group By row was not found.\n' +
					'The first Grappe row may not have opened.\n' +
					'Expected image: secondGroupResultPrefix\n' +
					'Expected object: secondGroupResultPrefix\n' +
					'Expected text: Ecart bilan vs. compte de résultat ccy'
					)
		} else {
			KeywordUtil.logInfo(
					'[PASS] First internal Group By row was found.\n' +
					'Image or object: secondGroupResultPrefix'
					)
		}

		takeEvidence(
				'GUI_GroupByResultValidated.png'
				)

		finishValidation(
				'Group By result validation',
				errors
				)
	}


	private boolean openFirstGroupResultByImage() {

		String firstGroupImagePath

		try {
			firstGroupImagePath =
					image(
					GUI_IMAGE_GROUP,
					'firstGroupResultRow'
					)
		} catch (Exception e) {
			KeywordUtil.logInfo(
					'[INFO] Could not load first Group By result image.\n' +
					'Image: firstGroupResultRow\n' +
					'Reason: ' + safeMessage(e)
					)

			return false
		}

		try {
			/*
			 * Two consecutive clicks reproduce the original behavior
			 * that was opening the first Grappe row successfully.
			 */
			WindowsImageKeywords.clickImage(
					firstGroupImagePath
					)

			Thread.sleep(150)

			try {
				WindowsImageKeywords.clickImage(
						firstGroupImagePath
						)
			} catch (Exception secondClickError) {
				KeywordUtil.logInfo(
						'[INFO] Second image click was not required or the image changed after opening.\n' +
						'Reason: ' + safeMessage(secondClickError)
						)
			}

			KeywordUtil.logInfo(
					'[PASS] First Grappe result row clicked using image.\n' +
					'Image: firstGroupResultRow'
					)

			return true
		} catch (Exception imageError) {
			KeywordUtil.logInfo(
					'[INFO] First Grappe result image was not found or could not be clicked.\n' +
					'Image: firstGroupResultRow\n' +
					'Reason: ' + safeMessage(imageError)
					)

			return false
		}
	}


	private boolean openFirstGroupResultByElement(
			Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds, 10)

		try {
			WindowsTestObject firstGroupObject =
					object(
					'firstGroupResultRow'
					)

			boolean firstGroupPresent =
					Windows.waitForElementPresent(
					firstGroupObject,
					timeout,
					FailureHandling.OPTIONAL
