private long parseDurationToMillis(String raw) {
    String value = safe(raw).replace(',', '.')
    if (blank(value)) {
        return 0L
    }

    def matcherSeconds = (value =~ /([\d.]+)\s*s/)
    if (matcherSeconds.find()) {
        try {
            return Math.round(Double.parseDouble(safe(matcherSeconds.group(1))) * 1000d)
        } catch (Exception ignored) {
            return 0L
        }
    }

    def matcherElapsed = (value =~ /(?i)Elapsed time:\s*([\d.]+)s/)
    if (matcherElapsed.find()) {
        try {
            return Math.round(Double.parseDouble(safe(matcherElapsed.group(1))) * 1000d)
        } catch (Exception ignored) {
            return 0L
        }
    }

    return 0L
}
