package jiraIntegration

import java.io.File
import java.nio.charset.StandardCharsets
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale

import javax.xml.parsers.DocumentBuilderFactory

import org.w3c.dom.Document
import org.w3c.dom.Element

class JiraGaiaReportBuilder {

    private static final String REPORT_FILE_NAME = 'gaiaReport.html'
    private static final String DEFAULT_LOGO_RELATIVE_PATH = 'Image/gaia-logo.png'

    JiraFlowCoordinator flow

    JiraGaiaReportBuilder(JiraFlowCoordinator flow) {
        this.flow = flow
    }

    String createGaiaHtmlReport(String reportFolder, String suiteName, String xmlPath) {
        if (isBlank(reportFolder) || isBlank(xmlPath)) {
            return ''
        }

        File reportDir = new File(reportFolder)
        if (!reportDir.exists()) {
            return ''
        }

        List<Map> xmlCases = parseXmlCases(xmlPath)
        List<Map> scenarios = parseExecutionScenarios(reportDir, xmlCases)

        if (scenarios.isEmpty()) {
            scenarios = buildFallbackScenarios(xmlCases)
        }

        attachEvidenceToScenarios(reportDir, scenarios)

        Map summary = buildSummary(scenarios)
        String logoSrc = resolveAssetUrl(reportDir, DEFAULT_LOGO_RELATIVE_PATH)

        Map model = [
            suiteName   : safeValue(suiteName),
            reportTitle : 'Test report - ' + safeValue(suiteName),
            subtitle    : 'GAIA execution overview',
            generatedAt : formatDisplayDate(new Date()),
            logoSrc     : logoSrc,
            summary     : summary,
            scenarios   : scenarios
        ]

        String html = new JiraGaiaHtmlTemplateBuilder().build(model)

        File htmlFile = new File(reportDir, REPORT_FILE_NAME)
        htmlFile.setText(html, 'UTF-8')
        return htmlFile.absolutePath
    }

    private List<Map> parseXmlCases(String xmlPath) {
        List<Map> result = []

        File xmlFile = new File(xmlPath)
        if (!xmlFile.exists()) {
            return result
        }

        Document document = parseXmlDocument(xmlFile)
        if (document == null) {
            return result
        }

        def testcases = document.getElementsByTagName('testcase')
        for (int index = 0; index < testcases.length; index++) {
            Element testcase = (Element) testcases.item(index)

            String className = safeValue(testcase.getAttribute('classname'))
            String testName = safeValue(testcase.getAttribute('name'))
            long durationMs = toMillisFromSeconds(testcase.getAttribute('time'))

            Element failureNode = firstChildElement(testcase, 'failure')
            Element errorNode = firstChildElement(testcase, 'error')
            Element skippedNode = firstChildElement(testcase, 'skipped')

            boolean failed = (failureNode != null) || (errorNode != null)
            boolean skipped = (skippedNode != null)

            String message = ''
            String details = ''

            if (failureNode != null) {
                message = safeValue(failureNode.getAttribute('message'))
                details = safeValue(failureNode.getTextContent())
            } else if (errorNode != null) {
                message = safeValue(errorNode.getAttribute('message'))
                details = safeValue(errorNode.getTextContent())
            } else if (skippedNode != null) {
                message = safeValue(skippedNode.getAttribute('message'))
                details = safeValue(skippedNode.getTextContent())
            }

            String displayName = buildDisplayName(className, testName)

            result << [
                index      : index + 1,
                name       : displayName,
                shortName  : isBlank(testName) ? displayName : testName,
                durationMs : durationMs,
                status     : skipped ? 'skipped' : (failed ? 'failed' : 'passed'),
                message    : message,
                details    : details
            ]
        }

        return result
    }

    private Document parseXmlDocument(File xmlFile) {
        try {
            def factory = DocumentBuilderFactory.newInstance()
            factory.setNamespaceAware(false)
            factory.setFeature('http://apache.org/xml/features/disallow-doctype-decl', true)
            factory.setFeature('http://xml.org/sax/features/external-general-entities', false)
            factory.setFeature('http://xml.org/sax/features/external-parameter-entities', false)
            factory.setFeature('http://apache.org/xml/features/nonvalidating/load-external-dtd', false)
            factory.setExpandEntityReferences(false)

            def builder = factory.newDocumentBuilder()
            return builder.parse(xmlFile)
        } catch (Exception ignored) {
            return null
        }
    }

    private Element firstChildElement(Element parent, String tagName) {
        def nodes = parent.getElementsByTagName(tagName)
        if (nodes == null || nodes.length == 0) {
            return null
        }
        return (Element) nodes.item(0)
    }

    private String buildDisplayName(String className, String testName) {
        if (!isBlank(className) && !isBlank(testName)) {
            return className + '/' + testName
        }
        if (!isBlank(testName)) {
            return testName
        }
        return className
    }

    private List<Map> parseExecutionScenarios(File reportDir, List<Map> xmlCases) {
        File logFile = findExecutionLog(reportDir)
        if (logFile == null || !logFile.exists()) {
            return []
        }

        List<String> lines = readFileLines(logFile)
        if (lines.isEmpty()) {
            return []
        }

        List<Map> scenarios = []
        Map currentScenario = null
        Map currentStep = null

        Closure finalizeStep = {
            if (currentScenario == null || currentStep == null) {
                return
            }

            currentStep.detailText = normalizeLines(currentStep.detailLines)
            currentStep.errorFull = normalizeLines(currentStep.errorLines)
            currentStep.shortError = extractShortError(currentStep.errorFull ?: currentStep.detailText)
            currentStep.detailPreview = buildStepPreview(currentStep)

            if (currentStep.status == 'skipped' && !isBlank(currentStep.shortError)) {
                currentStep.status = 'failed'
            }

            if (isBlank(currentStep.timeLabel)) {
                currentStep.timeLabel = safeValue(currentStep.startClock)
            }

            currentStep = null
        }

        Closure finalizeScenario = {
            if (currentScenario == null) {
                return
            }

            if (currentScenario.steps.isEmpty()) {
                currentScenario = null
                return
            }

            currentScenario.status = resolveScenarioStatus(currentScenario)
            currentScenario.errorShort = resolveScenarioErrorShort(currentScenario)
            currentScenario.errorFull = resolveScenarioErrorFull(currentScenario)
            currentScenario.sidebarSubtitle = resolveScenarioSidebarSubtitle(currentScenario)
            currentScenario.durationLabel = formatDurationHHMM((currentScenario.durationMs ?: 0L) as long)

            scenarios << currentScenario
            currentScenario = null
        }

        lines.each { String rawLine ->
            String line = safeValue(rawLine)

            if (line.contains('TEST STEP: Start Test Case : SCENARIO ')) {
                finalizeStep.call()
                finalizeScenario.call()

                String scenarioTitle = line.substring(line.indexOf('SCENARIO ') + 'SCENARIO '.length()).trim()

                currentScenario = [
                    id             : 'scenario-' + (scenarios.size() + 1),
                    title          : scenarioTitle,
                    status         : 'skipped',
                    startLabel     : '',
                    endLabel       : '',
                    durationMs     : 0L,
                    durationLabel  : '00h 00m',
                    steps          : [],
                    errorShort     : '',
                    errorFull      : '',
                    sidebarSubtitle: '',
                    evidences      : []
                ]
                currentStep = null
                return
            }

            if (currentScenario == null) {
                return
            }

            if (line.startsWith('Start / End / Elapsed:')) {
                if (currentStep == null) {
                    applyTimingInfo(currentScenario, line)
                } else {
                    applyTimingInfo(currentStep, line)
                }
                return
            }

            if (line.contains('TEST STEP: ') && !line.contains('Start Test Case : SCENARIO ')) {
                String stepTitle = line.substring(line.indexOf('TEST STEP: ') + 'TEST STEP: '.length()).trim()

                if (shouldIgnoreStep(stepTitle)) {
                    return
                }

                finalizeStep.call()

                currentStep = [
                    title        : stepTitle,
                    status       : 'skipped',
                    timeLabel    : '',
                    startClock   : '',
                    endClock     : '',
                    durationMs   : 0L,
                    detailLines  : [],
                    errorLines   : [],
                    detailText   : '',
                    errorFull    : '',
                    shortError   : '',
                    detailPreview: '',
                    emoji        : resolveStepEmoji(stepTitle)
                ]

                currentScenario.steps << currentStep
                return
            }

            if (currentStep == null) {
                return
            }

            Map event = parseEventLine(line)
            if (event != null) {
                if (isBlank(currentStep.timeLabel)) {
                    currentStep.timeLabel = event.timeLabel
                }

                currentStep.detailLines << (event.rawLine ?: line)

                if (event.status == 'failed') {
                    currentStep.status = 'failed'
                    currentStep.errorLines << safeValue(event.message)
                } else if (currentStep.status != 'failed' && event.status == 'passed') {
                    currentStep.status = 'passed'
                } else if (currentStep.status == 'skipped' && event.status == 'info') {
                    currentStep.status = 'info'
                }
                return
            }

            if (!isBlank(line)) {
                currentStep.detailLines << line
                if (currentStep.status == 'failed' || looksLikeErrorStack(line)) {
                    currentStep.errorLines << line
                }
            }
        }

        finalizeStep.call()
        finalizeScenario.call()

        scenarios = applyXmlFallbacks(scenarios, xmlCases)
        return scenarios
    }

    private List<Map> applyXmlFallbacks(List<Map> scenarios, List<Map> xmlCases) {
        if (scenarios.isEmpty() || xmlCases.isEmpty()) {
            return scenarios
        }

        scenarios.eachWithIndex { Map scenario, int index ->
            Map xmlCase = index < xmlCases.size() ? xmlCases[index] : null
            if (xmlCase == null) {
                return
            }

            if (((scenario.durationMs ?: 0L) as long) == 0L) {
                scenario.durationMs = (xmlCase.durationMs ?: 0L) as long
                scenario.durationLabel = formatDurationHHMM((scenario.durationMs ?: 0L) as long)
            }

            if (scenario.status == 'skipped' && safeValue(xmlCase.status) != 'skipped') {
                scenario.status = safeValue(xmlCase.status)
            }

            if (isBlank(scenario.errorShort) && !isBlank(xmlCase.message)) {
                scenario.errorShort = extractShortError(xmlCase.message)
            }

            if (isBlank(scenario.errorFull) && !isBlank(xmlCase.details)) {
                scenario.errorFull = safeValue(xmlCase.details)
            }

            if (isBlank(scenario.sidebarSubtitle)) {
                scenario.sidebarSubtitle = resolveScenarioSidebarSubtitle(scenario)
            }
        }

        return scenarios
    }

    private List<Map> buildFallbackScenarios(List<Map> xmlCases) {
        List<Map> scenarios = []

        xmlCases.eachWithIndex { Map xmlCase, int index ->
            String title = safeValue(xmlCase.shortName)

            Map step = [
                title        : title,
                status       : safeValue(xmlCase.status),
                timeLabel    : '',
                startClock   : '',
                endClock     : '',
                durationMs   : (xmlCase.durationMs ?: 0L) as long,
                detailLines  : !isBlank(xmlCase.details) ? xmlCase.details.readLines() : [],
                errorLines   : !isBlank(xmlCase.details) ? xmlCase.details.readLines() : [],
                detailText   : safeValue(xmlCase.details),
                errorFull    : safeValue(xmlCase.details),
                shortError   : extractShortError(xmlCase.message ?: xmlCase.details),
                detailPreview: title,
                emoji        : resolveStepEmoji(title)
            ]

            Map scenario = [
                id             : 'scenario-' + (index + 1),
                title          : title,
                status         : safeValue(xmlCase.status),
                startLabel     : '',
                endLabel       : '',
                durationMs     : (xmlCase.durationMs ?: 0L) as long,
                durationLabel  : formatDurationHHMM((xmlCase.durationMs ?: 0L) as long),
                steps          : [step],
                errorShort     : extractShortError(xmlCase.message ?: xmlCase.details),
                errorFull      : safeValue(xmlCase.details),
                sidebarSubtitle: extractShortError(xmlCase.message ?: xmlCase.details),
                evidences      : []
            ]

            scenarios << scenario
        }

        return scenarios
    }

    private Map buildSummary(List<Map> scenarios) {
        int passed = scenarios.count { Map item -> safeValue(item.status) == 'passed' }
        int failed = scenarios.count { Map item -> safeValue(item.status) == 'failed' }
        int skipped = scenarios.count { Map item -> safeValue(item.status) == 'skipped' }
        int info = scenarios.count { Map item -> safeValue(item.status) == 'info' }

        long totalDuration = 0L
        scenarios.each { Map item ->
            totalDuration += ((item.durationMs ?: 0L) as long)
        }

        List<String> startValues = scenarios.collect { safeValue(it.startLabel) }.findAll { !isBlank(it) }
        List<String> endValues = scenarios.collect { safeValue(it.endLabel) }.findAll { !isBlank(it) }

        return [
            total        : scenarios.size(),
            passed       : passed,
            failed       : failed,
            skipped      : skipped,
            info         : info,
            totalDuration: totalDuration,
            durationLabel: formatDurationHHMM(totalDuration),
            startLabel   : startValues ? startValues.first() : '',
            endLabel     : endValues ? endValues.last() : ''
        ]
    }

    private void attachEvidenceToScenarios(File reportDir, List<Map> scenarios) {
        List<File> imageFiles = collectEvidenceImages(reportDir)
        if (imageFiles.isEmpty() || scenarios.isEmpty()) {
            return
        }

        List<Map> targets = scenarios.findAll { Map item -> safeValue(item.status) == 'failed' }
        if (targets.isEmpty()) {
            targets = scenarios
        }

        int targetIndex = 0
        imageFiles.each { File image ->
            Map target = targets[targetIndex]

            if (target.evidences == null) {
                target.evidences = []
            }

            target.evidences << [
                name      : image.name,
                filePath  : image.absolutePath,
                openUrl   : image.toURI().toString(),
                previewUrl: image.toURI().toString()
            ]

            if (targetIndex < targets.size() - 1) {
                targetIndex++
            }
        }
    }

    private List<File> collectEvidenceImages(File reportDir) {
        List<File> images = []

        reportDir.eachFileRecurse { File file ->
            if (!file.isFile()) {
                return
            }

            String lowerName = file.name.toLowerCase(Locale.ENGLISH)
            boolean isImage = lowerName.endsWith('.png')
            isImage = isImage || lowerName.endsWith('.jpg')
            isImage = isImage || lowerName.endsWith('.jpeg')
            isImage = isImage || lowerName.endsWith('.webp')

            if (isImage) {
                images << file
            }
        }

        images.sort { File left, File right ->
            left.lastModified() <=> right.lastModified()
        }

        return images
    }

    private File findExecutionLog(File reportDir) {
        List<File> candidates = []

        reportDir.eachFileRecurse { File file ->
            if (!file.isFile()) {
                return
            }

            String lowerName = file.name.toLowerCase(Locale.ENGLISH)
            boolean isExecutionLog = lowerName.startsWith('execution') && lowerName.endsWith('.log')
            if (isExecutionLog) {
                candidates << file
            }
        }

        if (candidates.isEmpty()) {
            return null
        }

        candidates.sort { File left, File right ->
            right.lastModified() <=> left.lastModified()
        }

        return candidates.first()
    }

    private List<String> readFileLines(File file) {
        try {
            return file.readLines(StandardCharsets.UTF_8.name())
        } catch (Exception ignored) {
            try {
                return file.readLines()
            } catch (Exception ignoredAgain) {
                return []
            }
        }
    }

    private Map parseEventLine(String line) {
        def matcher = (line =~ /^(\\d{2}:\\d{2}:\\d{2}\\.\\d{3})\\s+([A-Z]+)\\s+(.*)$/)
        if (!matcher.find()) {
            return null
        }

        String rawStatus = safeValue(matcher.group(2)).toUpperCase(Locale.ENGLISH)
        String message = safeValue(matcher.group(3))

        return [
            timeLabel: formatClockLabel(matcher.group(1)),
            status   : normalizeEventStatus(rawStatus),
            message  : message,
            rawLine  : line
        ]
    }

    private String normalizeEventStatus(String rawStatus) {
        if (rawStatus == 'PASSED') {
            return 'passed'
        }
        if (rawStatus == 'FAILED' || rawStatus == 'ERROR') {
            return 'failed'
        }
        if (rawStatus == 'SKIPPED') {
            return 'skipped'
        }
        return 'info'
    }

    private boolean shouldIgnoreStep(String title) {
        String lower = safeValue(title).toLowerCase(Locale.ENGLISH)

        boolean ignored = false
        ignored = ignored || lower.startsWith('start listener action')
        ignored = ignored || lower.startsWith('glue')
        ignored = ignored || lower.startsWith('runfeaturefile')
        ignored = ignored || lower.startsWith('exportkatalonreports')
        ignored = ignored || lower.startsWith('sampleaftertestcase')
        ignored = ignored || lower.startsWith('video')
        ignored = ignored || lower.startsWith('beforetestcase')

        return ignored
    }

    private void applyTimingInfo(Map target, String timingLine) {
        def matcher = (timingLine =~ /^Start \\/ End \\/ Elapsed:\\s*(.+?)\\s*\\/\\s*(.+?)\\s*\\/\\s*(.+)$/)
        if (!matcher.find()) {
            return
        }

        String rawStart = safeValue(matcher.group(1))
        String rawEnd = safeValue(matcher.group(2))
        String rawElapsed = safeValue(matcher.group(3))

        target.startLabel = formatDateLabel(rawStart)
        target.endLabel = formatDateLabel(rawEnd)
        target.startClock = formatClockFromDate(rawStart)
        target.endClock = formatClockFromDate(rawEnd)
        target.durationMs = toMillisFromElapsed(rawElapsed)
    }

    private String formatDateLabel(String raw) {
        if (isBlank(raw)) {
            return ''
        }

        try {
            Date value = new SimpleDateFormat('yyyy-MM-dd HH:mm:ss.SSS', Locale.ENGLISH).parse(raw)
            return new SimpleDateFormat('MM.dd.yyyy hh:mm:ss a', Locale.ENGLISH).format(value)
        } catch (Exception ignored) {
            return raw
        }
    }

    private String formatClockFromDate(String raw) {
        if (isBlank(raw)) {
            return ''
        }

        try {
            Date value = new SimpleDateFormat('yyyy-MM-dd HH:mm:ss.SSS', Locale.ENGLISH).parse(raw)
            return new SimpleDateFormat('hh:mm:ss a', Locale.ENGLISH).format(value)
        } catch (Exception ignored) {
            return raw
        }
    }

    private String formatClockLabel(String raw) {
        if (isBlank(raw)) {
            return ''
        }

        try {
            Date value = new SimpleDateFormat('HH:mm:ss.SSS', Locale.ENGLISH).parse(raw)
            return new SimpleDateFormat('hh:mm:ss a', Locale.ENGLISH).format(value)
        } catch (Exception ignored) {
            return raw
        }
    }

    private long toMillisFromSeconds(def secondsValue) {
        String raw = safeValue(secondsValue).replace(',', '.')
        if (isBlank(raw)) {
            return 0L
        }

        try {
            double seconds = Double.parseDouble(raw)
            return Math.round(seconds * 1000d)
        } catch (Exception ignored) {
            return 0L
        }
    }

    private long toMillisFromElapsed(def elapsedValue) {
        String raw = safeValue(elapsedValue)
        if (isBlank(raw)) {
            return 0L
        }

        def matcher = (raw =~ /^(\\d{2}):(\\d{2}):(\\d{2})\\.(\\d{3})$/)
        if (!matcher.find()) {
            return 0L
        }

        long hours = matcher.group(1) as long
        long minutes = matcher.group(2) as long
        long seconds = matcher.group(3) as long
        long millis = matcher.group(4) as long

        return (((hours * 60L + minutes) * 60L) + seconds) * 1000L + millis
    }

    private String formatDurationHHMM(long durationMs) {
        long totalMinutes = durationMs > 0L ? (long) Math.floor(durationMs / 60000L) : 0L
        long hours = (long) Math.floor(totalMinutes / 60L)
        long minutes = totalMinutes % 60L

        return String.format(Locale.ENGLISH, '%02dh %02dm', hours, minutes)
    }

    private String formatDisplayDate(Date value) {
        return new SimpleDateFormat('MM.dd.yyyy hh:mm:ss a', Locale.ENGLISH).format(value)
    }

    private boolean looksLikeErrorStack(String line) {
        String lower = safeValue(line).toLowerCase(Locale.ENGLISH)

        boolean match = false
        match = match || lower.startsWith('at ')
        match = match || lower.startsWith('caused by:')
        match = match || lower.contains('root cause')
        match = match || lower.contains('exception')
        match = match || lower.contains('webdriver')
        match = match || lower.contains('session info')
        match = match || lower.contains('build info')
        match = match || lower.contains('driver info')
        match = match || lower.contains('capabilities')
        match = match || lower.contains('stacktrace')

        return match
    }

    private String buildStepPreview(Map step) {
        return safeValue(step.title)
    }

    private String resolveScenarioStatus(Map scenario) {
        boolean hasFail = scenario.steps.any { Map step ->
            safeValue(step.status) == 'failed'
        }
        if (hasFail) {
            return 'failed'
        }

        boolean hasPass = scenario.steps.any { Map step ->
            safeValue(step.status) == 'passed'
        }
        if (hasPass) {
            return 'passed'
        }

        boolean hasInfo = scenario.steps.any { Map step ->
            safeValue(step.status) == 'info'
        }
        if (hasInfo) {
            return 'info'
        }

        return 'skipped'
    }

    private String resolveScenarioErrorShort(Map scenario) {
        Map failedStep = scenario.steps.find { Map step ->
            safeValue(step.status) == 'failed'
        }

        if (failedStep != null) {
            return extractShortError(failedStep.shortError ?: failedStep.errorFull ?: failedStep.detailText)
        }

        return ''
    }

    private String resolveScenarioErrorFull(Map scenario) {
        Map failedStep = scenario.steps.find { Map step ->
            safeValue(step.status) == 'failed'
        }

        if (failedStep != null) {
            return safeValue(failedStep.errorFull ?: failedStep.detailText)
        }

        return ''
    }

    private String resolveScenarioSidebarSubtitle(Map scenario) {
        if (!isBlank(scenario.errorShort)) {
            return scenario.errorShort
        }

        Map firstStep = scenario.steps ? scenario.steps.first() : null
        return firstStep != null ? safeValue(firstStep.title) : ''
    }

    private String extractShortError(def source) {
        String text = safeValue(source)
        if (isBlank(text)) {
            return ''
        }

        List<String> lines = text.readLines().collect { safeValue(it) }.findAll { !isBlank(it) }
        if (lines.isEmpty()) {
            return ''
        }

        String preferred = lines.find { String line ->
            String lower = line.toLowerCase(Locale.ENGLISH)
            boolean good = false
            good = good || lower.contains('unable to ')
            good = good || lower.contains('element click intercepted')
            good = good || lower.contains('object repository')
            good = good || lower.contains('no such element')
            good = good || lower.contains('timeout')
            good = good || lower.contains('assert')
            return good
        }

        String base = safeValue(preferred ?: lines.first())
        base = base.replace('com.kms.katalon.core.exception.StepFailedException:', '').trim()
        base = base.replace('org.codehaus.groovy.runtime.InvokerInvocationException:', '').trim()
        base = base.replaceAll(/\\s+/, ' ').trim()

        int rootCauseIndex = base.indexOf('(Root cause:')
        if (rootCauseIndex > 0) {
            base = base.substring(0, rootCauseIndex).trim()
        }

        int atIndex = base.indexOf(' at com.kms')
        if (atIndex > 0) {
            base = base.substring(0, atIndex).trim()
        }

        if (base.length() > 150) {
            return base.substring(0, 147) + '...'
        }

        return base
    }

    private String resolveStepEmoji(String title) {
        String lower = safeValue(title).toLowerCase(Locale.ENGLISH)

        if (lower.contains('wait') || lower.contains('search') || lower.contains('find')) {
            return '🔎'
        }
        if (lower.contains('click') || lower.contains('select') || lower.contains('open')) {
            return '🖱️'
        }
        if (lower.contains('fill') || lower.contains('type') || lower.contains('input')) {
            return '⌨️'
        }
        if (lower.contains('import') || lower.contains('upload')) {
            return '📥'
        }
        if (lower.contains('save')) {
            return '💾'
        }
        if (lower.contains('reload') || lower.contains('refresh')) {
            return '🔄'
        }
        if (lower.contains('delete') || lower.contains('remove')) {
            return '🗑️'
        }
        if (lower.contains('match') || lower.contains('validate') || lower.contains('assert')) {
            return '✅'
        }
        if (lower.contains('portal') || lower.contains('page') || lower.contains('home')) {
            return '🌐'
        }
        return '📝'
    }

    private String normalizeLines(List lines) {
        if (lines == null || lines.isEmpty()) {
            return ''
        }

        return lines.collect { safeValue(it) }.join('\n').trim()
    }

    private String safeValue(def value) {
        return value == null ? '' : String.valueOf(value).trim()
    }

    private boolean isBlank(def value) {
        return safeValue(value).isEmpty()
    }

    private String resolveAssetUrl(File startDir, String relativePath) {
        File assetFile = resolveProjectFile(startDir, relativePath)
        if (assetFile == null || !assetFile.exists()) {
            return ''
        }
        return assetFile.toURI().toString()
    }

    private File resolveProjectFile(File startDir, String relativePath) {
        File current = startDir
        while (current != null) {
            File candidate = new File(current, relativePath)
            if (candidate.exists()) {
                return candidate
            }
            current = current.parentFile
        }
        return null
    }
}
