		}
	}


	private List resolveCompareFiles() {

		List compareFiles = []

		if (GlobalVariable.compareFiles instanceof Collection) {
			compareFiles.addAll(
					GlobalVariable.compareFiles as Collection
					)
		}

		return compareFiles
	}


	private String resolveDownloadedFilePath(
			String evidencePath,
			Object value
	) {

		String fileValue = safeText(value)
		File directFile = new File(fileValue)

		if (directFile.exists()) {
			return directFile.getAbsolutePath()
		}

		return new File(
				evidencePath,
				fileValue
				).getAbsolutePath()
	}


	private WindowsTestObject object(String objectKey) {

		return WindowsObjectLoader.getObject(
				GUI_OBJECT_GROUP,
				objectKey
				)
	}


	private String image(
			String groupName,
			String imageKey
	) {

		return imageLoader.getImage(
				groupName,
				imageKey
				)
	}


	private String optionalImage(
			String groupName,
			String imageKey
	) {

		try {
			String configuredPath = safeText(
					imageLoader.getImage(
					groupName,
					imageKey
					)
					)

			if (configuredPath.isEmpty()) {
				return ''
			}

			File configuredFile = new File(configuredPath)
			File imageFile = configuredFile.isAbsolute()
					? configuredFile
					: new File(
					RunConfiguration.getProjectDir(),
					configuredPath
					)

			if (!imageFile.exists() || !imageFile.isFile()) {
				return ''
			}

			return imageFile.getAbsolutePath()
		} catch (Throwable ignored) {
			return ''
		}
	}


	private void takeEvidence(String fileName) {

		imageLoader.takeEvidence(fileName)
	}


	private void reportBooleanResult(
			boolean success,
			String successMessage,
			String failureMessage,
			List<String> errors
	) {

		if (success) {
			KeywordUtil.logInfo(
					'[PASS] ' + successMessage
					)

			return
		}

		errors.add(failureMessage)
		KeywordUtil.logInfo('[FAIL] ' + failureMessage)
	}


	private void finishValidation(
			String validationName,
			List<String> errors
	) {

		if (!errors.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					validationName +
					' failed.\n' +
					errors.collect { String error ->
						'- ' + error
					}.join('\n')
					)

			return
		}

		KeywordUtil.markPassed(
				validationName +
				' completed successfully.'
				)
	}


