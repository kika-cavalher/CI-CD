Validations export RECXPRD
import com.kms.katalon.core.util.KeywordUtil

Integer threshold = 3

def addNote = { String message ->
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(message)
}

Map result = CustomKeywords.'commands.ExportFileComparator.compareRecProdExportFiles'(
	threshold
)

addNote(
	'📊 REC x PRD Export Validation\n' +
	'Feature: ' + result.featureName + '\n' +
	'Threshold: ' + result.threshold
)

addNote(
	'📁 Files location\n' +
	'Shared folder:\n' +
	result.sharedFolder
)

addNote(
	'📄 Files selected for validation\n' +
	'REC file: ' + result.recFileName + '\n' +
	'REC path: ' + result.recFilePath + '\n\n' +
	'PRD file: ' + result.prdFileName + '\n' +
	'PRD path: ' + result.prdFilePath
)

addNote(
	'🧾 Validation summary\n' +
	'Total validations: ' + result.totalValidations + '\n' +
	'Passed: ' + result.passedValidations + '\n' +
	'Failed: ' + result.failedValidations
)

List<Map> validations = result.validations as List<Map>

validations.eachWithIndex { Map validation, int index ->
	String statusIcon = validation.status == 'PASS' ? '✅' : '❌'

	addNote(
		statusIcon + ' Validation ' + (index + 1) + ' - ' + validation.name + '\n' +
		'Status: ' + validation.status + '\n' +
		validation.details
	)
}

if (result.differences != null && !result.differences.isEmpty()) {
	List<String> differences = result.differences as List<String>

	addNote(
		'❌ Differences found\n' +
		'Total differences listed: ' + differences.size() + '\n\n' +
		differences.join('\n')
	)
}

if (result.errorsText != null && result.errorsText != '') {
	addNote(
		'❌ Final result\n' +
		'REC x PRD export validation finished with mismatches.'
	)

	KeywordUtil.markFailed('\n' + result.errorsText)
} else {
	addNote(
		'✅ Final result\n' +
		'REC x PRD export validation completed successfully.\n' +
		'No mismatches were found between REC and PRD files.'
	)

	KeywordUtil.markPassed(
		'REC/PRD export validation completed successfully'
	)
}



