	def updateSummaryTestCase(String execIDTestCase, String summaryName) {
		println 'Updating Test Summary...';
		List<String> summaryTxt = summaryName.split("/");
		String changedSummaryName = summaryTxt[summaryTxt.count { }-1];
		String pathName;
		for (int i = 0; i < summaryTxt.size()-1; i++) {
			pathName +=  summaryTxt[i] + "/";
		}
		def response = WS.sendRequest(findTestObject('Jira Integration/updateSummary', [('issueID'): execIDTestCase, ('summary'): changedSummaryName]));

		return WS.getResponseStatusCode(response);
	}

