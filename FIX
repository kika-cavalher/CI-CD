    // MODEL NORMALIZATION
    // ============================================================

    private Map normalizePageModel(Map model) {
        Map normalized = [:]

        String reportTitle = safeValue(model?.reportTitle)
        String suiteFromTitle = safeValue(reportTitle).replaceFirst('^Test report\\s*-\\s*', '').trim()

        String suiteName = firstNonBlank(
            model?.reportSuiteName,
            model?.suiteDisplayName,
            model?.titleSuiteName,
            model?.suiteName,
            suiteFromTitle
        )

        if (isBlank(reportTitle)) {
            reportTitle = REPORT_TITLE_PREFIX + suiteName
        }

        List<Map> scenarios = normalizeScenarios(model, suiteName)

        Map summary = [
            total  : scenarios.size(),
            passed : scenarios.count { Map it -> safeValue(it.status) == 'passed' },
            failed : scenarios.count { Map it -> safeValue(it.status) == 'failed' },
            skipped: scenarios.count { Map it -> safeValue(it.status) == 'skipped' }
        ]

        normalized.reportTitle = reportTitle
        normalized.reportSuiteName = suiteName
        normalized.generatedAt = firstNonBlank(model?.generatedAt, model?.generatedOn, model?.generatedDate)
        normalized.logoSrc = resolveAsset(firstNonBlank(model?.logoSrc, LOGO_SRC), model)
        normalized.summary = summary
        normalized.scenarios = scenarios

        return normalized
    }

    private List<Map> normalizeScenarios(Map model, String defaultSuiteName) {
        List rawScenarios = []
        if (model?.scenarios instanceof Collection) {
            rawScenarios = model.scenarios as List
        } else if (model?.tests instanceof Collection) {
            rawScenarios = model.tests as List
        }

        List<Map> normalized = []
        int idx = 0

        rawScenarios.each { def raw ->
            idx++

            String scenarioId = safeValue(raw?.id)
            if (isBlank(scenarioId)) {
                scenarioId = 'scenario_' + idx
            }

            String scenarioName = firstNonBlank(
                raw?.scenarioName,
                raw?.name,
                raw?.title,
                raw?.shortName,
                'Scenario ' + idx
            )

            String status = normalizeStatus(raw?.status ?: raw?.finalStatus ?: raw?.result)

            String suiteName = firstNonBlank(
                raw?.suiteName,
                raw?.suiteDisplayName,
                defaultSuiteName
            )

            String errorSummary = firstNonBlank(
                raw?.errorSummary,
                raw?.message,
                raw?.summary,
                extractUnableToMessage(raw?.errorLog ?: raw?.stackTrace ?: raw?.details)
            )

            List<Map> steps = normalizeSteps(raw?.steps)
            List<Map> evidences = normalizeEvidences(raw?.evidences ?: raw?.evidenceFiles ?: raw?.images, model)

            Map item = [
                id             : scenarioId,
                name           : scenarioName,
                status         : status,
                suiteName      : suiteName,
                startClock     : extractClock(firstNonBlank(raw?.startClock, raw?.startTime, raw?.startLabel, raw?.start)),
                endClock       : extractClock(firstNonBlank(raw?.endClock, raw?.endTime, raw?.endLabel, raw?.end)),
                durationLabel  : normalizeDurationLabel(raw),
                listTime       : extractClock(firstNonBlank(raw?.startClock, raw?.startTime, raw?.startLabel, raw?.start)),
                listDuration   : normalizeDurationLabel(raw),
                errorSummary   : errorSummary,
                errorLog       : firstNonBlank(raw?.errorLog, raw?.stackTrace, raw?.details),
                steps          : steps,
                evidences      : evidences,
                showDetailLink : status == 'failed'
            ]

            normalized.add(item)
        }

        return normalized
    }

    private List<Map> normalizeSteps(def rawSteps) {
        List<Map> normalized = []
        if (!(rawSteps instanceof Collection)) {
            return normalized
        }

        rawSteps.each { def raw ->
            String detail = firstNonBlank(raw?.detail, raw?.message, raw?.title, raw?.name)
            String status = normalizeStatus(raw?.status ?: raw?.type ?: raw?.result)
            String ts = extractClock(firstNonBlank(raw?.timestamp, raw?.time, raw?.clock, raw?.startTime, raw?.startClock))
            String fullDetail = firstNonBlank(raw?.fullDetail, raw?.details, raw?.log, raw?.stackTrace)

            normalized.add([
                status    : status,
                timestamp : ts,
                detail    : detail,
                fullDetail: fullDetail,
                icon      : resolveStepIcon(detail, status)
            ])
        }

        return normalized
    }

    private List<Map> normalizeEvidences(def rawEvidences, Map model) {
        List<Map> evidences = []
        if (!(rawEvidences instanceof Collection)) {
            return evidences
        }

        rawEvidences.each { def raw ->
            String name = ''
            String rawPath = ''

            if (raw instanceof Map) {
                name = firstNonBlank(raw?.name, raw?.title, raw?.label, raw?.fileName)
                rawPath = firstNonBlank(raw?.absolutePath, raw?.href, raw?.src, raw?.path, raw?.filePath, name)
            } else {
                name = safeValue(raw)
                rawPath = safeValue(raw)
            }

            String href = resolveAsset(rawPath, model)
            String lower = safeValue(name).toLowerCase(Locale.ENGLISH)
            boolean isImage = lower.endsWith('.png') || lower.endsWith('.jpg') || lower.endsWith('.jpeg') || lower.endsWith('.gif') || lower.endsWith('.webp')

            evidences.add([
                name   : name,
                href   : href,
                isImage: isImage
            ])
        }

        return evidences
    }

