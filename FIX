    @Keyword
    boolean waitForMainScreen() {
        try {
            boolean loaded = Windows.waitForElementPresent(
                findWindowsObject('General/txtSearch'),
                MAIN_SCREEN_TIMEOUT_SEC,
                FailureHandling.OPTIONAL
            )

            if (loaded) {
                Windows.delay(AFTER_MAIN_SCREEN_DELAY_SEC)
            }

            return loaded
        } catch (Exception ignored) {
            return false
        }
    }

    @Keyword
    void activateHomeTab() {
        String home = new File(RunConfiguration.getProjectDir(), 'Images/General/Home.PNG').getAbsolutePath()
        String homeGrey = new File(RunConfiguration.getProjectDir(), 'Images/General/HomeGrey.PNG').getAbsolutePath()
        String homeWhite = new File(RunConfiguration.getProjectDir(), 'Images/General/HomeWhite.PNG').getAbsolutePath()

        try {
            if (new File(home).exists()) {
                WindowsImageKeywords.clickImage(home)
                Windows.delay(AFTER_HOME_CLICK_DELAY_SEC)
                return
            }
        } catch (Exception ignored) {
        }

        try {
            if (new File(homeGrey).exists()) {
                def activeTab = WindowsImageKeywords.findImage(homeGrey)
                if (activeTab != null) {
                    return
                }
            }
        } catch (Exception ignored) {
        }

        try {
            if (new File(homeWhite).exists()) {
                def inactiveTab = WindowsImageKeywords.findImage(homeWhite)
                if (inactiveTab != null) {
                    WindowsImageKeywords.clickImage(homeWhite)
                    Windows.delay(AFTER_HOME_CLICK_DELAY_SEC)
                    return
                }
            }
        } catch (Exception ignored) {
        }
    }

    @Keyword
    void ensureWinAppDriverRunning() {
        if (isPortOpen('127.0.0.1', 4723)) {
            return
        }

        File exe = new File(WINAPPDRIVER_EXE)
        if (!exe.exists()) {
            KeywordUtil.markFailedAndStop("WinAppDriver not found: ${WINAPPDRIVER_EXE}")
        }

        new ProcessBuilder(WINAPPDRIVER_EXE).start()

        long deadline = System.currentTimeMillis() + (WINAPPDRIVER_START_TIMEOUT_SEC * 1000L)

        while (System.currentTimeMillis() < deadline) {
            if (isPortOpen('127.0.0.1', 4723)) {
                KeywordUtil.logInfo('WinAppDriver started successfully.')
                return
            }
            Thread.sleep(1000)
        }

        KeywordUtil.markFailedAndStop("WinAppDriver did not start within ${WINAPPDRIVER_START_TIMEOUT_SEC} seconds.")
    }

    private String getLauncherBat(String environment) {
        String env = normalizeEnvironment(environment)
        return env == PRD ? LAUNCHER_BAT_PRD : LAUNCHER_BAT_REC
    }

    private String normalizeEnvironment(String environment) {
        String env = (environment ?: '').trim().toUpperCase()

        if (!env) {
            env = REC
        }

        if (env == 'PROD') {
            env = PRD
        }

        if (!(env in [REC, PRD])) {
            KeywordUtil.markFailedAndStop("Invalid environment '${env}'. Use REC or PRD.")
        }

        return env
    }

    private void runResolutionScriptIfExists() {
        File script = new File(RESOLUTION_SCRIPT_PATH)

        if (!script.exists()) {
            return
        }

        Map result = runCommand("powershell -ExecutionPolicy Bypass -File \"${RESOLUTION_SCRIPT_PATH}\"", 60)

        if (result.exitCode != 0) {
            KeywordUtil.logInfo("Resolution script output:\n${result.output}")
            KeywordUtil.markFailedAndStop("Resolution script failed: ${RESOLUTION_SCRIPT_PATH}")
        }
    }

    private void clickWithRetry(String objectId, int retries, int delaySec) {
        Exception lastError = null

        for (int i = 1; i <= retries; i++) {
            try {
                Windows.click(findWindowsObject(objectId))
                return
            } catch (Exception e) {
                lastError = e
                Windows.delay(delaySec)
            }
        }

        KeywordUtil.markFailedAndStop("Could not click '${objectId}' after ${retries} attempts. Last error: ${lastError?.message}")
    }

    private void startDetachedCommand(String commandLine) {
        new ProcessBuilder('cmd', '/c', commandLine)
            .redirectErrorStream(true)
            .start()
    }

    private Map runCommand(String commandLine, int timeoutSec) {
        Process process = new ProcessBuilder('cmd', '/c', commandLine)
            .redirectErrorStream(true)
            .start()

        boolean finished = process.waitFor(timeoutSec, TimeUnit.SECONDS)

        if (!finished) {
            process.destroyForcibly()
            return [
                exitCode: -1,
                output  : "Command timed out after ${timeoutSec} seconds.\nCommand: ${commandLine}"
            ]
        }

        String output = process.inputStream.getText('Cp1252')

        return [
            exitCode: process.exitValue(),
            output  : output
        ]
    }

    private boolean isPortOpen(String host, int port) {
        Socket socket = null
        try {
            socket = new Socket(host, port)
            return true
        } catch (Throwable ignored) {
            return false
        } finally {
            try {
                socket?.close()
            } catch (Throwable ignored) {
            }
        }
    }
}











