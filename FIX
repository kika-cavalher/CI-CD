import static com.kms.katalon.core.testcase.TestCaseFactory.findTestCase

import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI


// ======================================================
// MODULE CONFIG
// ======================================================

String targetEnvironment = 'REC'

String menuName = 'pl comptable'
String menuResultName = 'PL Comptable'

String openedTabName = menuResultName

String exportScenarioName =
	'PNLComptable_ConsultationPNLComptable'

String exportLabel =
	exportScenarioName

String loginTestCase =
	'Component/Authentication/Login ' +
	targetEnvironment

String closeApplicationTestCase =
	'Component/Authentication/Close Application'


// ======================================================
// RECHERCHE DATA
// ======================================================

String sectionValue = '5F6'

String transactionCurrencyValue = 'AED'

String minimumAccountingDate = '31/03/2026'

String maximumAccountingDate = '31/03/2026'


// ======================================================
// TIMEOUT CONFIG
// ======================================================

Integer menuTimeout = 60
Integer openedTabTimeout = 120
Integer filterTimeout = 30
Integer filteredContentDelay = 30


// ======================================================
// AUTHENTICATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Authenticate and open application\n' +
	'Environment: ' +
	targetEnvironment
)

WebUI.callTestCase(
	findTestCase(
		loginTestCase
	),
	[:],
	FailureHandling.STOP_ON_FAILURE
)


// ======================================================
// OPEN PNL COMPTABLE
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Open PNL Comptable screen\n' +
	'Search: ' +
	menuName +
	'\nResult: ' +
	menuResultName
)

CustomKeywords.
'component.MenuNavigator.searchAndOpenMenuByText'(
	menuName,
	menuResultName,
	menuTimeout
)


// ======================================================
// VALIDATE OPENED TAB
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Validate PNL Comptable tab\n' +
	'Expected tab: ' +
	openedTabName
)

CustomKeywords.
'pageObject.PNLComptableKeywords.validateOpenedTab'(
	openedTabName,
	targetEnvironment,
	openedTabTimeout
)


// ======================================================
// APPLY RECHERCHE FILTERS
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Apply PNL Comptable Recherche filters\n' +
	'Section: ' +
	sectionValue +
	'\nTransaction currency: ' +
	transactionCurrencyValue +
	'\nMinimum accounting date: ' +
	minimumAccountingDate +
	'\nMaximum accounting date: ' +
	maximumAccountingDate
)

Map rechercheResult =
	CustomKeywords.
	'pageObject.PNLComptableKeywords.applyRechercheFilters'(
		sectionValue,
		transactionCurrencyValue,
		minimumAccountingDate,
		maximumAccountingDate,
		filterTimeout
	)


// ======================================================
// WAIT FOR FILTERED CONTENT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Wait for filtered PNL Comptable content\n' +
	'Delay: ' +
	filteredContentDelay +
	' seconds'
)

CustomKeywords.
'pageObject.PNLComptableKeywords.waitForFilteredContent'(
	targetEnvironment,
	filteredContentDelay
)


// ======================================================
// EXPORT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Export filtered PNL Comptable table\n' +
	'Flow: Exports tab > Export button > Save > Non\n' +
	'Environment: ' +
	targetEnvironment +
	'\nExport scenario: ' +
	exportScenarioName
)

CustomKeywords.
'commands.ExportFile.exportFromTwoExportImagesToNo'(
	exportScenarioName,
	targetEnvironment
)


// ======================================================
// VALIDATE DOWNLOADED FILE
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Validate exported PNL Comptable file\n' +
	'Environment: ' +
	targetEnvironment +
	'\nExport label: ' +
	exportLabel
)

Map exportValidation =
	CustomKeywords.
	'commands.ExportFileValidationKeywords.validateExportedFileExistsAndHasRows'(
		targetEnvironment,
		exportLabel
	)


// ======================================================
// CLOSE APPLICATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Close application\n' +
	'Environment: ' +
	targetEnvironment
)

WebUI.callTestCase(
	findTestCase(
		closeApplicationTestCase
	),
	[:],
	FailureHandling.STOP_ON_FAILURE
)

KeywordUtil.markPassed(
	targetEnvironment +
	' PNL Comptable Recherche filter and export completed successfully.\n' +
	'Exported file: ' +
	exportValidation.fileName
)

