	@Keyword
	void attachToLoginWindow(String targetWindowTitle) {
		String expectedTitle = normalizeTitle(safe(detectedWindowTitle) ?: safe(targetWindowTitle))

		KeywordUtil.logInfo("Attaching to login window. Expected title ${expectedTitle}")

		ensureWinAppDriverRunning()

		Map<String, String> found = waitForWindow(expectedTitle, 45)
		if (!safe(found.title)) {
			KeywordUtil.markFailedAndStop("Could not find eMatch window with title ${expectedTitle}")
		}

		detectedWindowTitle = normalizeTitle(found.title)
		KeywordUtil.logInfo("Detected main window title ${detectedWindowTitle}")

		Object handleValue = found.handle
		String handleDec = safe(handleValue)

		if (!handleDec) {
			handleDec = safe(findWindowHandleByTitle(detectedWindowTitle))
		}

		if (!handleDec) {
			KeywordUtil.markFailedAndStop("Could not resolve native window handle for title ${detectedWindowTitle}")
		}

		KeywordUtil.logInfo("Detected main window handle ${handleDec}")

		waitForStableMainWindow(detectedWindowTitle, handleDec, 6)

		WindowsDriver driver = attachExistingWindowByHandle(handleDec)
		sleepMs(2000)

		String attachedTitle = ''
		try {
			attachedTitle = safe(driver?.getTitle())
		} catch (Throwable ignored) {
		}

		KeywordUtil.logInfo("Attached driver title ${attachedTitle}")

		if (safe(attachedTitle) || waitForAnyLoginIndicator(20)) {
			return
		}

		KeywordUtil.markFailedAndStop("Could not finish attach to login window ${detectedWindowTitle}")
	}






