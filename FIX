import org.jenkinsci.plugins.workflow.steps.FlowInterruptedException

properties([
    disableConcurrentBuilds()
])

def NODE_LABEL = 'GI5_SWDCFRNXGI55817'
def SHORT_WORKSPACE = 'D:\\jenkins\\ws\\PNLECO'

// true = trigger next pipeline
// false = do not trigger next pipeline
def RUN_NEXT_JOB = false

// Full Jenkins job path for the next pipeline
def NEXT_JOB = ''

// Maximum execution time for each collection
def COLLECTION_TIMEOUT_HOURS = 5

def executionFailed = false
def manuallyAborted = false

// Stop all running tools used by the current execution
def stopCurrentExecution = {
    bat '''
@echo off
schtasks /end /tn "\\eMatch Automation\\RunEMatchCommand" >nul 2>nul
schtasks /end /tn "startWinDriver" >nul 2>nul
taskkill /f /im WinAppDriver.exe /t >nul 2>nul
taskkill /f /im katalonc.exe /t >nul 2>nul
taskkill /f /im KatalonStudio.exe /t >nul 2>nul
ping -n 6 127.0.0.1 >nul
exit /b 0
'''
}

// Check whether the interruption was caused by a manual abort
def isManualAbort = { FlowInterruptedException err ->
    try {
        return err.causes.any { cause ->
            cause.getClass().getName().contains('UserInterruption')
        }
    } catch (ignored) {
        return false
    }
}

// Execute one collection and always stop the current execution afterwards
def runCollection = { String stageName, String cmdFile ->
    stage(stageName) {
        try {
            timeout(time: COLLECTION_TIMEOUT_HOURS, unit: 'HOURS') {
                bat "call \"%WORKSPACE%\\jenkins\\${cmdFile}\""
                echo "${stageName} completed successfully."
            }
        } catch (FlowInterruptedException err) {
            if (isManualAbort(err)) {
                manuallyAborted = true
                currentBuild.result = 'ABORTED'
                echo "${stageName} was manually aborted."
                throw err
            }

            executionFailed = true
            echo "${stageName} timed out or was interrupted: ${err}"
        } catch (Throwable err) {
            executionFailed = true
            echo "${stageName} failed: ${err}"
        } finally {
            stage("Stop ${stageName}") {
                stopCurrentExecution()
            }
        }
    }
}

node(NODE_LABEL) {
    ws(SHORT_WORKSPACE) {
        stage('Checkout') {
            checkout scm
        }

        runCollection('Consultation PNLEco Collection', 'ConsultationPNLEco.cmd')
        runCollection('Consultation PNLEco Brut Collection', 'ConsultationPNLEcoBrut.cmd')
    }
}

if (manuallyAborted) {
    echo 'Build manually aborted. Next pipeline will not be scheduled.'
    return
}

stage('Trigger next pipeline') {
    if (RUN_NEXT_JOB && NEXT_JOB?.trim()) {
        echo "Scheduling next pipeline: ${NEXT_JOB}"
        build job: NEXT_JOB,
              wait: false,
              propagate: false
    } else {
        echo 'Next pipeline disabled.'
    }
}

currentBuild.result = executionFailed ? 'FAILURE' : 'SUCCESS'
return
