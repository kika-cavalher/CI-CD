import java.awt.Robot
import java.awt.event.KeyEvent

import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.testobject.WindowsTestObject.LocatorStrategy
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

// ======================================================
// CHANGE ONLY THIS VALUE
// ======================================================
String exportLabel = 'Mixte'

// ======================================================
// ELEMENT CONFIG
// ======================================================
String settingsFooterName = 'MNU_FILE'
String contreValorisationName = 'Contre-valorisation'
String modulesFooterName = 'Modules'

// ======================================================
// TIMEOUT CONFIG
// ======================================================
Integer timeout = 10
Integer delayAfterClick = 2
Integer delayAfterPopupOpen = 2

// ======================================================
// TEST FLOW
// ======================================================
Robot robot = new Robot()
robot.setAutoDelay(120)

def buildNameObject = { String elementName ->
	WindowsTestObject object = new WindowsTestObject()
	object.setLocatorStrategy(LocatorStrategy.NAME)
	object.setLocator(elementName)
	return object
}

def clickByName = { String elementName, String description ->
	WindowsTestObject object = buildNameObject(elementName)

	Windows.waitForElementPresent(
		object,
		timeout,
		FailureHandling.STOP_ON_FAILURE
	)

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		description + '\n' +
		'Element: ' + elementName
	)

	Windows.click(object)
	Windows.delay(delayAfterClick)
}

def pressKey = { Integer keyCode ->
	robot.keyPress(keyCode)
	robot.keyRelease(keyCode)
	Windows.delay(1)
}

def typeCurrencyByKeyboard = { String currency ->
	currency.each { String character ->
		String upperCharacter = character.toUpperCase()

		if (upperCharacter == ' ') {
			pressKey(KeyEvent.VK_SPACE)
		} else {
			int keyCode = KeyEvent."VK_${upperCharacter}"

			robot.keyPress(keyCode)
			robot.keyRelease(keyCode)
			Windows.delay(1)
		}
	}
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Open Settings'
)

clickByName(
	settingsFooterName,
	'Open Settings footer'
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Open Cotre Parameters'
)

clickByName(
	contreValorisationName,
	'Open Cotre Parameters setting'
)

Windows.delay(delayAfterPopupOpen)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Move focus to currency field\n' +
	'Action: TAB x2'
)

pressKey(KeyEvent.VK_TAB)
pressKey(KeyEvent.VK_TAB)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Select currency\n' +
	'Currency: ' + exportLabel + '\n' +
	'Input method: keyboard typing'
)

typeCurrencyByKeyboard(exportLabel)

Windows.delay(1)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Confirm selected currency\n' +
	'Action: TAB to Valider and ENTER'
)

pressKey(KeyEvent.VK_TAB)
pressKey(KeyEvent.VK_ENTER)

Windows.delay(5)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Return to Modules'
)

clickByName(
	modulesFooterName,
	'Return to Modules footer'
)

KeywordUtil.markPassed(
	'Cotre Parameters ' + exportLabel + ' configured successfully.'
)
