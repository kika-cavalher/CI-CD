	@Keyword
	def clickConnectIfPresent(String targetEnvironment) {
		stopImmediatelyIfFatalFailureWasAlreadyDetected()

		String environment =
				normalizeEnvironment(targetEnvironment)

		if (isProductionEnvironment(environment)) {
			KeywordUtil.logInfo(
					'PRD does not use connect button. ' +
					'Skipping connect action.'
					)

			saveCurrentEnvironment(environment)
			return
		}

		validateCorrectVersionWindowOrStop(environment)

		if (!isLoginScreenVisibleSafely()) {
			KeywordUtil.markFailedAndStop(
					'Login screen is not visible before clicking connect.\n' +
					'Environment: ' + environment
					)
		}

		WindowsTestObject connectButton =
				WindowsObjectLoader.getObject(
				'authentication',
				'connectButton'
				)

		boolean isButtonPresent =
				Windows.verifyElementPresent(
				connectButton,
				5,
				FailureHandling.OPTIONAL
				)

		if (!isButtonPresent) {
			KeywordUtil.markFailedAndStop(
					'Connect button was not found by NAME.\n' +
					'Expected Name: Se connecter\n' +
					'Environment: ' + environment
					)
		}

		try {
			clickElementCenterByCoordinates(connectButton)
		} catch (Exception e) {
			KeywordUtil.logInfo(
					'Coordinate click failed. Trying normal click. Reason: ' +
					e.getMessage()
					)

			Windows.click(
					connectButton,
					FailureHandling.OPTIONAL
					)
		}

		boolean loginClosed =
				waitUntilLoginScreenIsClosed(
				MAIN_SCREEN_TIMEOUT_SECONDS
				)

		if (!loginClosed) {
			KeywordUtil.markFailedAndStop(
					'Connect button was clicked, but login screen is still visible.\n' +
					'Environment: ' + environment
					)
		}

		saveCurrentEnvironment(environment)

		KeywordUtil.logInfo(
				'Connect button clicked and login screen closed.'
				)
	}


	@Keyword
	def waitForMainScreen(String targetEnvironment) {
		stopImmediatelyIfFatalFailureWasAlreadyDetected()

		String environment =
				normalizeEnvironment(targetEnvironment)

		boolean loginClosed =
				waitUntilLoginScreenIsClosed(
				MAIN_SCREEN_TIMEOUT_SECONDS
				)

		if (!loginClosed) {
			KeywordUtil.markFailedAndStop(
					'Main screen was not validated after login.\n' +
					'Login screen is still visible.\n' +
					'Environment: ' + environment
					)
		}

		saveCurrentEnvironment(environment)

		KeywordUtil.logInfo(
				'Main screen validated because login screen is closed.\n' +
				'Current environment saved from targetEnvironment: ' +
				environment
				)

		Windows.delay(1)
	}


	@Keyword
	def multiFormatScreen(String targetEnvironment) {
