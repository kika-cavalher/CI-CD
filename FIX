                break

            case 'PTS':
                configuredPath = firstNonBlank(gv('shortcutPathPts'), gv('shortcutPathPTS'))
                if (configuredPath) return configuredPath
                break

            default:
                configuredPath = firstNonBlank(gv('shortcutPathRec'), gv('shortcutPathREC'))
                if (configuredPath) return configuredPath
                break
        }

        String user = getCurrentWindowsUser()

        switch (env) {
            case 'PROD':
            case 'PRD':
                return "C:\\Users\\${user}\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\NATIXIS\\eMatch PROD.appref-ms"

            case 'PTS':
                return "C:\\Users\\${user}\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\NATIXIS\\eMatch PTS.appref-ms"

            default:
                return "C:\\Users\\${user}\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\NATIXIS\\eMatch REC.appref-ms"
        }
    }

