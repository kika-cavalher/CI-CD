import com.kms.katalon.core.util.KeywordUtil


// ======================================================
// VALIDATION CONFIG
// ======================================================

Integer expectedColumnIndex = 18
String expectedColumnName = 'Montant ccy'

String validationName = 'PNL Eco'

String exportRootFolder = 'C:\\KatalonExports'
String exportGroupFolder = 'PNL_Eco'
String exportFeatureFolder = 'PnlEco'


// ======================================================
// TEST FLOW
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Start REC x PRD validation\n' +
	'Feature: ' +
	validationName +
	'\nValidations:\n' +
	'- Compare table row count\n' +
	'- Compare table headers\n' +
	'- Compare sum of Montant ccy\n' +
	'Expected Excel column: S\n' +
	'Expected zero-based column index: ' +
	expectedColumnIndex +
	'\nExpected column name: ' +
	expectedColumnName +
	'\nExport root: ' +
	exportRootFolder +
	'\nExport folder: ' +
	exportGroupFolder +
	'\\' +
	exportFeatureFolder
)

Map result =
	CustomKeywords.
	'commands.RecPrdExportValidationKeywords.validateLatestRecPrdExportTreatBlankAsZero'(
		exportRootFolder,
		exportGroupFolder,
		exportFeatureFolder,
		expectedColumnIndex,
		expectedColumnName
	)

Boolean success =
	result != null &&
	result.success == true

String errors =
	result == null
		? '[ERROR] Validation keyword returned no result.'
		: safeText(
			result.errors
			)

String passedDetails =
	result == null
		? ''
		: safeText(
			result.passedDetails
			)

String resolvedColumnName =
	result == null
		? expectedColumnName
		: safeText(
			result.columnName
			)

if (resolvedColumnName.isEmpty()) {
	resolvedColumnName =
		expectedColumnName
}

String recFileName =
	result == null
		? 'REC file was not resolved.'
		: displayValue(
			result.recFileName,
			'REC file was not resolved.'
			)

String prdFileName =
	result == null
		? 'PRD file was not resolved.'
		: displayValue(
			result.prdFileName,
			'PRD file was not resolved.'
			)

String selectedFolderPath =
	result == null
		? 'Export folder was not resolved.'
		: displayValue(
			result.selectedFolderPath,
			'Export folder was not resolved.'
			)


// ======================================================
// REPORT SELECTED FILES
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	(success ? '[PASS] ' : '[FAIL] ') +
	'Files selected for PNL Eco validation\n' +
	'Folder: ' +
	selectedFolderPath +
	'\nREC file: ' +
	recFileName +
	'\nPRD file: ' +
	prdFileName
)


// ======================================================
// REPORT TABLE ROW VALIDATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	(success ? '[PASS] ' : '[FAIL] ') +
	'PNL Eco row count validation\n' +
	'REC rows: ' +
	displayValue(
		result?.recRows,
		'REC row count was not returned.'
		) +
	'\nPRD rows: ' +
	displayValue(
		result?.prdRows,
		'PRD row count was not returned.'
		)
)


// ======================================================
// REPORT HEADER VALIDATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	(success ? '[PASS] ' : '[FAIL] ') +
	'PNL Eco header validation\n' +
	'REC headers: ' +
	displayValue(
		result?.recHeaders,
		'REC headers were not returned.'
		) +
	'\nPRD headers: ' +
	displayValue(
		result?.prdHeaders,
		'PRD headers were not returned.'
		)
)


// ======================================================
// REPORT MONTANT CCY VALIDATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	(success ? '[PASS] ' : '[FAIL] ') +
	'PNL Eco Montant ccy validation\n' +
	'Column: ' +
	resolvedColumnName +
	'\nExcel column: S' +
	'\nZero-based column index: ' +
	expectedColumnIndex +
	'\nREC numeric values: ' +
	displayValue(
		result?.recNumericValues,
		'REC numeric value count was not returned.'
		) +
	'\nPRD numeric values: ' +
	displayValue(
		result?.prdNumericValues,
		'PRD numeric value count was not returned.'
		) +
	'\nREC sum: ' +
	displayValue(
		result?.recSum,
		'REC sum was not returned.'
		) +
	'\nPRD sum: ' +
	displayValue(
		result?.prdSum,
		'PRD sum was not returned.'
		) +
	'\nREC minimum: ' +
	displayValue(
		result?.recMinimum,
		'REC minimum was not returned.'
		) +
	'\nPRD minimum: ' +
	displayValue(
		result?.prdMinimum,
		'PRD minimum was not returned.'
		) +
	'\nREC maximum: ' +
