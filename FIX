let currentMode = 'tests';
let currentCaseIndex = 0;
let currentSearch = '';

function escapeHtml(value){
    if(value === null || value === undefined){
        return '';
    }
    return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

function truncateText(value, size){
    const text = String(value || '').replace(/\\s+/g, ' ').trim();
    if(text.length <= size){
        return text;
    }
    return text.substring(0, Math.max(0, size - 3)) + '...';
}

function statusClass(status){
    const value = String(status || '').toLowerCase();
    if(value === 'pass') return 'status-pass';
    if(value === 'fail') return 'status-fail';
    if(value === 'skip') return 'status-skip';
    return 'status-info';
}

function statusLabel(status){
    const value = String(status || '').toLowerCase();
    if(value === 'pass') return 'Pass';
    if(value === 'fail') return 'Fail';
    if(value === 'skip') return 'Skip';
    return 'Info';
}

function filteredCases(){
    const query = String(currentSearch || '').toLowerCase().trim();
    if(!query){
        return REPORT_MODEL.cases;
    }

    return REPORT_MODEL.cases.filter(item => {
        const haystack = [
            item.shortName,
            item.scenarioName,
            item.shortSummary,
            item.statusLabel
        ].join(' ').toLowerCase();

        return haystack.includes(query);
    });
}

function buildCaseList(){
    const list = document.getElementById('case-list');
    const visibleCases = filteredCases();

    if(currentCaseIndex >= visibleCases.length){
        currentCaseIndex = 0;
    }

    let html = '';

    visibleCases.forEach((item, index) => {
        html += `
            <li class="case-item">
                <button type="button" class="case-button ${index === currentCaseIndex ? 'active' : ''}" data-index="${index}">
                    <div class="case-main">
                        <div class="case-name" title="${escapeHtml(item.shortName)}">${escapeHtml(item.shortName)}</div>
                        <div class="case-desc" title="${escapeHtml(item.shortSummary)}">${escapeHtml(truncateText(item.shortSummary, 70))}</div>
                        <div class="case-meta">
                            <span>${escapeHtml(item.startTag)}</span>
                            <span>${escapeHtml(item.durationText)}</span>
                        </div>
                    </div>
                    <div class="case-status-col">
                        <span class="status-pill ${statusClass(item.status)}">${escapeHtml(item.statusLabel)}</span>
                        <span class="case-duration">${escapeHtml(item.durationText)}</span>
                    </div>
                </button>
            </li>
        `;
    });

    if(!html){
        html = '<li class="case-item"><div class="case-button"><div class="case-main"><div class="case-name">No scenario found</div></div></div></li>';
    }

    list.innerHTML = html;

    Array.from(list.querySelectorAll('.case-button')).forEach(button => {
        button.addEventListener('click', function(){
            currentCaseIndex = parseInt(this.getAttribute('data-index'), 10) || 0;
            buildCaseList();
            renderCurrentView();
        });
    });
}

function buildMetaPill(label, value, extraClass){
    return `<span class="meta-pill ${extraClass || ''}"><strong>${escapeHtml(label)}:</strong> ${escapeHtml(value)}</span>`;
}

function renderTestsView(){
    const container = document.getElementById('tests-view');
    const visibleCases = filteredCases();
    const item = visibleCases[currentCaseIndex];

    if(!item){
        container.innerHTML = '<div class="no-data">No scenario available.</div>';
        return;
