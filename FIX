	private void validateEnabledState(
			String objectKey,
			String description,
			boolean expectedEnabled,
			Integer timeout,
			List<String> errors
	) {

		WindowsTestObject targetObject = object(objectKey)

		boolean present =
				Windows.waitForElementPresent(
				targetObject,
				timeout,
				FailureHandling.OPTIONAL
				)

		if (!present) {
			errors.add(description + ' was not found.')
			return
		}

		String enabledAttribute = safeText(
				Windows.getAttribute(
				targetObject,
				'IsEnabled',
				FailureHandling.OPTIONAL
				)
				)

		boolean actualEnabled =
				enabledAttribute.equalsIgnoreCase('True')

		if (actualEnabled == expectedEnabled) {
			KeywordUtil.logInfo(
					'[PASS] ' + description +
					' enabled state is correct.'
					)
		} else {
			errors.add(
					description +
					' enabled state is incorrect.\n' +
					'Expected: ' + expectedEnabled + '\n' +
					'Actual: ' + actualEnabled
					)
		}
	}



	private boolean clickFirstVisibleImage(
			String groupName,
			List<String> imageKeys,
			Integer timeoutSeconds
	) {

		Integer timeout =
				safeTimeout(
				timeoutSeconds,
				3
				)

		Map<String, String> availableImages = [:]

		for (String imageKey : imageKeys) {
			String imagePath =
					optionalImage(
					groupName,
					imageKey
					)

			if (!imagePath.isEmpty()) {
				availableImages.put(
						imageKey,
						imagePath
						)
			}
		}

		if (availableImages.isEmpty()) {
			KeywordUtil.logInfo(
					'[FAIL] No image file was resolved.\n' +
					'Group: ' + groupName + '\n' +
					'Image keys: ' + imageKeys
					)

			return false
		}

		KeywordUtil.logInfo(
				'[IMAGE] Searching.\n' +
				'Group: ' + groupName + '\n' +
				'Image keys: ' + imageKeys + '\n' +
				'Timeout: ' + timeout + ' seconds'
				)

		for (
		Integer second = 1;
				second <= timeout;
				second++
				) {

			for (
			Map.Entry<String, String> imageEntry :
			availableImages.entrySet()
					) {
				try {
					def found =
							WindowsImageKeywords.findImage(
							imageEntry.getValue()
							)

					if (found != null && found != false) {
						WindowsImageKeywords.clickImage(
								imageEntry.getValue()
								)

						KeywordUtil.logInfo(
								'[IMAGE] Clicked: ' +
								groupName +
								'.' +
								imageEntry.getKey()
								)

						return true
					}
				} catch (Throwable ignored) {
				}
			}

			if (second < timeout) {
				Windows.delay(1)
			}
		}

		KeywordUtil.logInfo(
				'[IMAGE] Not found within ' +
				timeout +
				' seconds.\n' +
				'Group: ' + groupName + '\n' +
				'Image keys: ' + imageKeys
				)

		return false
	}


	private void clickImage(
			String groupName,
			String imageKey,
			Integer timeout
	) {

		KeywordUtil.logInfo(
				'[IMAGE] Waiting for image.\n' +
				'Group: ' + groupName + '\n' +
				'Image key: ' + imageKey + '\n' +
				'Timeout: ' + timeout + ' seconds'
				)

		boolean found =
				imageLoader.waitForImage(
				groupName,
				imageKey,
				timeout
				)

		if (!found) {
			takeEvidence(
					'GUI_ImageNotFound_' +
					imageKey +
					'.png'
					)

			KeywordUtil.markFailedAndStop(
					'Image was not found.\n' +
					'Group: ' + groupName + '\n' +
					'Key: ' + imageKey
					)

			return
		}

		try {
			WindowsImageKeywords.clickImage(
