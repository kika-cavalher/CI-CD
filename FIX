	private String resolveTargetVersion() {
		String gv = safe(GlobalVariable.version)
		if (gv) {
			return gv
		}

		String envValue = normalizeEnvCode(safe(GlobalVariable.env) ?: 'REC')

		try {
			def td
			try {
				td = findTestData('refLogin')
			} catch (Throwable ignored) {
				td = findTestData('Data Files/refLogin')
			}

			if (td != null) {
				int rows = td.getRowNumbers()
				for (int row = 1; row <= rows; row++) {
					String rowEnv = normalizeEnvCode(safe(td.getValue('Env 1', row)))
					String rowVersion = safe(td.getValue('Version', row))

					if (rowEnv == envValue && rowVersion) {
						return rowVersion
					}
				}
			}
		} catch (Throwable ignored) {
		}

		return ''
	}

	private String normalizeResolvedTitle(String versionOrTitle) {
		String value = safe(versionOrTitle)
		if (!value) {
			return 'eMatch'
		}

		value = value.replaceAll('\\s+', ' ').trim()

		if (value.toLowerCase().startsWith('ematch ')) {
			return normalizeTitle(value)
		}

		return normalizeTitle("eMatch ${value}")
	}

	private String normalizeEnvCode(String env) {
		String value = safe(env).toUpperCase()

		if (!value) {
			return 'REC'
		}

		if (value == 'PROD') return 'PROD'
		if (value == 'PREX') return 'PREX'
		if (value == 'PREPO') return 'PREPO'
		if (value == 'REC2') return 'REC2'
		if (value == 'REC') return 'REC'
		if (value == 'DEV2') return 'DEV2'
		if (value == 'DEV') return 'DEV'

		return value
	}

	private boolean fileExists(String path) {
		String value = safe(path)
		return value && new File(value).exists()
	}

	private boolean isPortOpen(String host, int port, int timeoutMs) {
		try {
			Socket socket = new Socket()
			socket.connect(new InetSocketAddress(host, port), timeoutMs)
			socket.close()
			return true
		} catch (Throwable ignored) {
			return false
		}
	}

	private String runPowerShell(String script) {
		Process process = new ProcessBuilder(
			'powershell.exe',
			'-NoProfile',
			'-ExecutionPolicy', 'Bypass',
			'-Command', script
		)
		.redirectErrorStream(true)
		.start()

		String output = process.inputStream.getText('UTF-8')
		process.waitFor()
		return safe(output)
	}

	private void runDetachedPowerShell(String script) {
		new ProcessBuilder(
			'powershell.exe',
			'-NoProfile',
			'-ExecutionPolicy', 'Bypass',
			'-Command', script
		).start()
	}

	private Robot robot() {
		if (cachedRobot == null) {
			cachedRobot = new Robot()
			cachedRobot.setAutoDelay(100)
		}
		return cachedRobot
	}

	private void robotKey(int keyCode) {
		Robot r = robot()
		r.keyPress(keyCode)
		r.keyRelease(keyCode)
		sleepMs(150)
	}

	private void sleepMs(long ms) {
		try {
			Thread.sleep(ms)
		} catch (InterruptedException ignored) {
			Thread.currentThread().interrupt()
		}
	}

	private String normalizeTitle(String value) {
		return safe(value).replaceAll('\\s+', ' ').trim()
	}

	private String safe(Object value) {
		return value == null ? '' : value.toString().trim()
	}

	private String escapePowerShell(String value) {
		return safe(value).replace("'", "''")
	}
