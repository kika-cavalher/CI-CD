	private File validateExcelFile(
			String filePath,
			String description
		) {

		String path = safeText(filePath)
		File file = new File(path)

		if (path.isEmpty() ||
			!file.exists() ||
			!file.isFile()) {

			KeywordUtil.markFailedAndStop(
				description +
					' was not found:\n' +
					file.absolutePath
			)
		}

		if (file.length() <= 0L) {
			KeywordUtil.markFailedAndStop(
				description +
					' is empty: ' +
					file.name
			)
		}

		return file
	}

