    String firstNonBlank(
        def a = null,
        def b = null,
        def c = null,
        def d = null,
        def e = null,
        def f = null,
        def g = null,
        def h = null,
        def i = null,
        def j = null,
        def k = null,
        def l = null
    ) {
        return firstNonBlankFromCollection([a, b, c, d, e, f, g, h, i, j, k, l])
    }

    String firstNonBlank(Collection values) {
        return firstNonBlankFromCollection(values)
    }

    private String firstNonBlankFromCollection(Collection values) {
        if (values == null) {
            return ''
        }

        for (def value : values) {
            String text = safeValue(value)
            if (!text.isEmpty()) {
                return text
            }
        }

        return ''
    }

    private Object firstPresent(
        def a = null,
        def b = null,
        def c = null,
        def d = null,
        def e = null,
        def f = null,
        def g = null,
        def h = null,
        def i = null,
        def j = null,
        def k = null,
        def l = null
    ) {
        List values = [a, b, c, d, e, f, g, h, i, j, k, l]

        for (def value : values) {
            if (value == null) {
                continue
            }

            if (value instanceof CharSequence && safeValue(value).isEmpty()) {
                continue
            }

            return value
        }

        return null
    }

    private Map normalizeModel(Map model) {
        Map safeModel = model ?: [:]

        String suiteName = firstNonBlank(
            safeModel.suiteName,
            safeModel.testSuiteName,
            safeModel.suite,
            safeModel.executionName,
            safeModel.title,
            'Execution'
        )

        String reportTitle = REPORT_TITLE_PREFIX + suiteName

        List<Map> scenarios = normalizeScenarios(safeModel)

        int passedCount = scenarios.count { it.status == 'passed' }
        int failedCount = scenarios.count { it.status == 'failed' }
        int skippedCount = scenarios.count { it.status == 'skipped' }
        int totalCount = scenarios.size()

        return [
            reportTitle   : reportTitle,
            suiteName     : suiteName,
            generatedLabel: buildGeneratedLabel(safeModel),
            reportFolder  : firstNonBlank(safeModel.reportFolder, safeModel.baseFolder, safeModel.executionFolder),
            logoSrc       : firstNonBlank(safeModel.logoSrc, LOGO_SRC),
            scenarios     : scenarios,
            passedCount   : passedCount,
            failedCount   : failedCount,
            skippedCount  : skippedCount,
            totalCount    : totalCount
        ]
    }

    private List<Map> normalizeScenarios(Map model) {
        List rawList = asList(firstPresent(
            model.scenarios,
            model.tests,
            model.cases,
            model.executions,
            model.items
        ))

        List<Map> result = []

        rawList.eachWithIndex { def rawItem, int index ->
            Map item = rawItem instanceof Map ? rawItem : [name: safeValue(rawItem)]

            String scenarioName = firstNonBlank(
                item.scenarioName,
                item.name,
                item.title,
                item.displayName,
                item.shortName,
                item.caseName,
                item.testName,
                "Scenario ${index + 1}"
            )

            String scenarioId = firstNonBlank(item.id, item.key, "scenario-${index + 1}")
            String status = normalizeStatus(firstNonBlank(item.status, item.result, item.outcome, item.finalStatus))
            String shortError = shorten(firstNonBlank(
                item.visualError,
                item.errorSummary,
                item.errorShort,
                item.failureMessage,
                item.message
            ), 95)

            String rawStart = firstNonBlank(item.startLabel, item.startTime, item.startDateTime, item.startDate)
            String rawEnd = firstNonBlank(item.endLabel, item.endTime, item.endDateTime, item.endDate)

            long durationMs = normalizeDurationMs(item, rawStart, rawEnd)
            String durationLabel = formatDuration(durationMs)

            List<Map> steps = normalizeSteps(item)
            if (steps.isEmpty()) {
                steps = parseStepsFromRawText(firstNonBlank(
                    item.fullError,
                    item.errorDetail,
                    item.stackTrace,
                    item.details,
                    item.rawLog,
                    item.stepTrace
                ))
            }

            List<Map> evidence = normalizeEvidence(item, model)
            if (status == 'failed' && evidence.size() > 1) {
                evidence = [evidence.last()]
            }

            result.add([
                id            : scenarioId,
                name          : scenarioName,
                summary       : shortError,
                status        : status,
                startShort    : extractClockLabel(rawStart),
                endShort      : extractClockLabel(rawEnd),
                startLong     : formatDateTimeLabel(rawStart),
                endLong       : formatDateTimeLabel(rawEnd),
                durationLabel : durationLabel,
                visualError   : firstNonBlank(
                    item.visualError,
                    item.errorSummary,
                    item.errorShort,
                    item.failureMessage,
                    item.message
                ),
                fullError     : firstNonBlank(
                    item.fullError,
                    item.errorDetail,
                    item.stackTrace,
                    item.stacktrace,
                    item.details,
                    item.errorLog
                ),
                steps         : steps,
                evidence      : evidence
            ])
        }

        return result
    }

    private List<Map> normalizeSteps(Map item) {
        List rawSteps = asList(firstPresent(
            item.steps,
            item.stepRows,
            item.stepItems,
            item.timeline,
            item.events,
            item.logs
        ))

        List<Map> result = []

        rawSteps.each { def raw ->
            Map row = raw instanceof Map ? raw : [detail: safeValue(raw)]

            String status = normalizeStatus(firstNonBlank(
                row.status,
                row.result,
                row.outcome,
                row.level
            ))

            String detail = firstNonBlank(
                row.detail,
                row.message,
                row.text,
                row.title,
                row.name
            )

            if (detail.isEmpty()) {
                return
            }

            result.add([
                status   : status,
                timestamp: extractClockLabel(firstNonBlank(
                    row.timestamp,
                    row.time,
                    row.at,
                    row.label
                )),
                detail   : detail,
                icon     : resolveStepIcon(detail, status)
            ])
        }

        return result
    }

    private List<Map> parseStepsFromRawText(String rawText) {
        List<Map> result = []

        if (rawText.isEmpty()) {
            return result
        }

        List<String> lines = rawText.readLines()

        lines.each { String rawLine ->
            String line = safeValue(rawLine)
            if (line.isEmpty()) {
                return
            }

            def matcherA = line =~ /^(\d{2}:\d{2}:\d{2}(?:\.\d{3})?)\s+(PASSED|FAILED|ERROR|INFO|SKIPPED)\s+(.*)$/
            if (matcherA.find()) {
                String status = normalizeStatus(matcherA.group(2))
                String detail = safeValue(matcherA.group(3))

                result.add([
                    status   : status,
                    timestamp: cleanClock(matcherA.group(1)),
                    detail   : detail,
                    icon     : resolveStepIcon(detail, status)
                ])
                return
            }

            def matcherB = line =~ /^(Given|When|Then|And)\s+(.+?)(?:\.{2,}|\s+)(passed|failed|skipped)$/i
            if (matcherB.find()) {
                String detail = matcherB.group(1) + ' ' + matcherB.group(2)
                String status = normalizeStatus(matcherB.group(3))

                result.add([
                    status   : status,
                    timestamp: '',
                    detail   : detail,
                    icon     : resolveStepIcon(detail, status)
                ])
            }
        }

        return result
    }

    private List<Map> normalizeEvidence(Map item, Map model) {
        List rawEvidence = asList(firstPresent(
            item.evidence,
            item.evidences,
            item.images,
            item.attachments
        ))

        String baseFolder = firstNonBlank(
            item.reportFolder,
            model.reportFolder,
            model.baseFolder,
            model.executionFolder
        )

        List<Map> result = []

        rawEvidence.each { def raw ->
            if (raw == null) {
                return
            }

            String name = ''
            String path = ''

            if (raw instanceof Map) {
                name = firstNonBlank(raw.name, raw.fileName, raw.title, raw.label)
                path = firstNonBlank(raw.href, raw.path, raw.file, raw.absolutePath, raw.relativePath)
            } else {
                path = safeValue(raw)
                name = new File(path).name
            }

            File resolved = resolveFile(path, baseFolder)
            if (resolved == null || !resolved.exists()) {
                return
            }

            String href = resolved.toURI().toString()
            boolean image = isImageFile(resolved.name)

            result.add([
                name   : name.isEmpty() ? resolved.name : name,
                href   : href,
                image  : image,
                imgSrc : image ? href : ''
            ])
        }

        return result
    }

    private File resolveFile(String path, String baseFolder) {
        String raw = safeValue(path)
        if (raw.isEmpty()) {
            return null
        }

        File direct = new File(raw)
        if (direct.exists()) {
            return direct
        }

        if (!safeValue(baseFolder).isEmpty()) {
            File byBase = new File(baseFolder, raw)
            if (byBase.exists()) {
                return byBase
            }
        }

        return direct
    }

    private String resolveLogoHref(Map view) {
        File logoFile = resolveFile(firstNonBlank(view.logoSrc, LOGO_SRC), firstNonBlank(view.reportFolder))
        if (logoFile != null && logoFile.exists()) {
            return logoFile.toURI().toString()
        }

        return firstNonBlank(view.logoSrc, LOGO_SRC)
    }

