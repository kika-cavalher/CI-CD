	// =========================================================================
	// STATIC HELPERS
	// =========================================================================

	private static String safeValueStatic(def value) {
		return value == null ? '' : String.valueOf(value).trim()
	}

	private static boolean isBlankStatic(def value) {
		return safeValueStatic(value).isEmpty()
	}

	private static long toLongStatic(def value) {
		String raw = safeValueStatic(value)
		if (raw.isEmpty()) {
			return 0L
		}

		try {
			return Long.parseLong(raw)
		} catch (Exception ignored) {
		}

		try {
			return Math.round(Double.parseDouble(raw.replace(',', '.')))
		} catch (Exception ignored) {
		}

		return 0L
	}

	private static long toMillisFromCompactSecondsStatic(def rawValue) {
		String raw = safeValueStatic(rawValue).replace(',', '.').replace('s', '').trim()
		if (raw.isEmpty()) {
			return 0L
		}

		try {
			double seconds = Double.parseDouble(raw)
			return Math.round(seconds * 1000d)
		} catch (Exception ignored) {
			return 0L
		}
	}

	private static String formatDurationFullStatic(long durationMs) {
		long totalSeconds = durationMs > 0L ? Math.round(durationMs / 1000d) : 0L
		long hours = (long) Math.floor(totalSeconds / 3600L)
		long minutes = (long) Math.floor((totalSeconds % 3600L) / 60L)
		long seconds = totalSeconds % 60L
		return String.format(Locale.ENGLISH, '%02dh %02dm %02ds', hours, minutes, seconds)
	}

	private static String formatSecondsStatic(long durationMs) {
		return String.format(Locale.ENGLISH, '%.3f', durationMs / 1000d)
	}

	private static String extractShortErrorStatic(def source) {
		String text = safeValueStatic(source)
		if (isBlankStatic(text)) {
			return ''
		}

		List<String> lines = text.readLines().collect { safeValueStatic(it) }.findAll { !isBlankStatic(it) }
		if (lines.isEmpty()) {
			return ''
		}

		String preferred = lines.find { String line ->
			String lower = line.toLowerCase(Locale.ENGLISH)
			return lower.contains('stepfailedexception') ||
					lower.contains('steperrorexception') ||
					lower.contains('missingmethodexception') ||
					lower.contains('classnotfoundexception') ||
					lower.contains('unable to ') ||
					lower.contains('cannot ') ||
					lower.contains('timeout') ||
					lower.contains('not found')
		}

		String value = safeValueStatic(preferred ?: lines.first())
		value = value.replace('com.kms.katalon.core.exception.StepFailedException:', '').trim()
		value = value.replace('com.kms.katalon.core.exception.StepErrorException:', '').trim()
		value = value.replace('(Root cause:', '').trim()

		int atIndex = value.indexOf(' at ')
		if (atIndex > 0) {
			value = value.substring(0, atIndex).trim()
		}

		if (value.length() > 220) {
			value = value.substring(0, 217) + '...'
		}

		return value
	}

	private static String appendTextStatic(def original, def extra) {
		String left = safeValueStatic(original)
		String right = safeValueStatic(extra)

		if (isBlankStatic(left)) {
			return right
		}
		if (isBlankStatic(right)) {
			return left
		}
		return left + '\n' + right
	}

	private static String firstNonBlankStatic(Object... values) {
		if (values == null) {
			return ''
		}

		for (Object value : values) {
			String text = safeValueStatic(value)
			if (!text.isEmpty()) {
				return text
			}
		}

		return ''
	}

	private static String xmlEscapeStatic(def value) {
		String text = safeValueStatic(value)
		return text
				.replace('&', '&amp;')
				.replace('<', '&lt;')
				.replace('>', '&gt;')
				.replace('"', '&quot;')
				.replace("'", '&apos;')
	}
