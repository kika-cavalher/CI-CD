    private boolean launchDesktopApplication(String installedExePath, String launcherBat, String shortcutPath) {
        if (installedExePath?.trim() && new File(installedExePath).exists()) {
            KeywordUtil.logInfo("Launching installed exe first: ${installedExePath}")
            launchWithShell(installedExePath)
            return true
        }

        if (launcherBat?.trim() && new File(launcherBat).exists()) {
            KeywordUtil.logInfo("Launching launcher bat fallback: ${launcherBat}")
            launchWithShell(launcherBat)
            return true
        }

        if (shortcutPath?.trim() && new File(shortcutPath).exists()) {
            KeywordUtil.logInfo("Launching shortcut fallback: ${shortcutPath}")
            launchWithShell(shortcutPath)
            return true
        }

        return false
    }

    @Keyword
    boolean startMatch(String currentUser, String targetWindowTitle) {
        String env = currentEnv()
        String shortcutPath = getShortcutPath()
        String applicationPath = getApplicationPath()
        String launcherBat = getLauncherBat()
        String installedExePath = getInstalledExePath()

        KeywordUtil.logInfo("Starting eMatch for environment ${env}")
        KeywordUtil.logInfo("Current Windows user ${currentUser}")
        KeywordUtil.logInfo("Target window title ${targetWindowTitle}")
        KeywordUtil.logInfo("Shortcut path ${shortcutPath}")
        KeywordUtil.logInfo("Application path ${applicationPath}")
        KeywordUtil.logInfo("Installed exe path ${installedExePath}")
        KeywordUtil.logInfo("Launcher bat ${launcherBat}")

        ensureWinAppDriverStarted()
        killProcessIfExists('IXIS.eMatch.IHM.exe')

        boolean launched = launchDesktopApplication(installedExePath, launcherBat, shortcutPath)
        if (!launched) {
            throw new Exception("No valid launcher found. Shortcut='${shortcutPath}' Launcher='${launcherBat}' Exe='${installedExePath}'")
        }

        if (!waitForProcess('IXIS.eMatch.IHM.exe', WAIT_PROCESS_SECONDS)) {
            throw new Exception('eMatch process did not appear after launch.')
        }

        String liveTitle = waitForMainWindowTitle(targetWindowTitle, WAIT_TITLE_SECONDS)
        if (!liveTitle) {
            throw new Exception("eMatch process started but no window title appeared. Expected='${targetWindowTitle}'")
        }

        bringWindowToFront(liveTitle)
        Windows.delay(2)
        KeywordUtil.logInfo("eMatch launch confirmed with title: ${liveTitle}")

        return true
    }

    @Keyword
    boolean startEMatch(String currentUser, String targetWindowTitle) {
        return startMatch(currentUser, targetWindowTitle)
    }

    @Keyword
    boolean attachToLoginWindow(String targetWindowTitle) {
        KeywordUtil.logInfo("Attaching to login window. Expected title ${targetWindowTitle}")

        ensureWinAppDriverStarted()

        String liveTitle = waitForMainWindowTitle(targetWindowTitle, 30)
        if (!liveTitle) {
            String detectedTitles = listDetectedTitles()
            throw new Exception("Window title not detected. Expected='${targetWindowTitle}' Detected='${detectedTitles}'")
        }

        bringWindowToFront(liveTitle)

        String refreshIconPath = getRefreshIconPath()
        boolean anchorReady = waitForAnchorImage(refreshIconPath, WAIT_IMAGE_SECONDS, liveTitle)
        if (!anchorReady) {
            throw new Exception("Anchor image was not found on screen: ${refreshIconPath}")
        }

        bringWindowToFront(liveTitle)
        openRootSessionOnce()

        List<String> titlesToTry = [liveTitle, targetWindowTitle].findAll { it?.trim() }.unique()

        for (int round = 1; round <= WAIT_ATTACH_ROUNDS; round++) {
            for (String title : titlesToTry) {
                try {
                    bringWindowToFront(title)
                    Windows.switchToWindowTitle(title)
                    Windows.delay(1)

                    if (isLoginWindowReady()) {
                        KeywordUtil.logInfo("Attached to login window using title '${title}' at round ${round}")
                        return true
                    }
                } catch (Throwable e) {
                    KeywordUtil.logInfo("Attach by title failed at round ${round} for '${title}': ${e.message}")
                }
            }

            for (int idx = 0; idx <= 10; idx++) {
                try {
                    Windows.switchToWindowIndex(idx)
                    Windows.delay(1)

                    if (isLoginWindowReady()) {
                        KeywordUtil.logInfo("Attached to login window using index ${idx} at round ${round}")
                        return true
                    }
                } catch (Throwable ignored) {
                }
            }

            if (round % 5 == 0) {
                bringWindowToFront(liveTitle)
                waitForAnchorImage(refreshIconPath, 3, liveTitle)
                reopenRootSession()
            }

            Windows.delay(1)
        }

        throw new Exception("Login window opened but attach failed. Expected='${targetWindowTitle}' Detected='${listDetectedTitles()}'")
    }

    @Keyword
    boolean openEnvironmentDropdown() {
        try {
            Windows.click(findWindowsObject('Login Page/optEnv'))
            Windows.delay(1)
            return true
        } catch (Throwable ignored) {
            KeywordUtil.logInfo('Object click for environment dropdown failed. Using keyboard fallback.')
            keyPressCombo(KeyEvent.VK_ALT, KeyEvent.VK_DOWN)
            Windows.delay(1)
            return true
        }
    }

    @Keyword
    int resolveEnvironmentIndex(String envName) {
        String env = (envName ?: '').trim().toUpperCase()

        switch (env) {
            case 'PROD':
            case 'PRD':
                return 1
            case 'PREQ':
            case 'BENCH':
                return 2
            case 'QUAL':
            case 'QUALIFICATION':
                return 3
            case 'REC':
            case 'RECETTE':
                return 4
            case 'SIM':
            case 'SIMULATION':
                return 5
            case 'DEV':
            case 'DEVELOPMENT':
                return 6
            default:
                return 4
        }
    }

    @Keyword
    boolean selectEnvironment(String envName) {
        int envIndex = resolveEnvironmentIndex(envName)

        try {
            Windows.click(findWindowsObject('Login Page/optEnv'))
            Windows.delay(1)
        } catch (Throwable ignored) {
        }

        keyPress(KeyEvent.VK_HOME)
        Windows.delay(1)

        if (envIndex > 1) {
            keyPressMultiple(KeyEvent.VK_DOWN, envIndex - 1)
            Windows.delay(1)
        }

        keyPress(KeyEvent.VK_ENTER)
        Windows.delay(1)

        return true
    }

