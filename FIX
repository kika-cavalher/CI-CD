	@Keyword
	String getCurrentWindowsUser() {
		return System.getProperty('user.name') ?: ''
	}

	@Keyword
	String getShortcutPath() {
		return firstNonBlank(
			readGlobal('EMATCH_LNK_PATH'),
			readGlobal('shortcutPath'),
			System.getenv('EMATCH_LNK_PATH'),
			DEFAULT_EMATCH_LNK_PATH
		)
	}

	@Keyword
	String getApplicationPath() {
		return firstNonBlank(
			readGlobal('EMATCH_APPLICATION_PATH'),
			readGlobal('applicationPath'),
			System.getenv('EMATCH_APPLICATION_PATH'),
			DEFAULT_EMATCH_APPLICATION_PATH
		)
	}

	@Keyword
	String getWinAppDriverPath() {
		return firstNonBlank(
			readGlobal('WINAPPDRIVER_EXE'),
