	)
}

CustomKeywords.
'commands.ImageLoader.takeEvidence'(
	targetEnvironment +
	'_PNLComptable_Opened.png'
)


// ======================================================
// APPLY RECHERCHE FILTERS
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Apply PNL Comptable Recherche filters\n' +
	'Section: ' +
	sectionValue +
	'\nTransaction currency: ' +
	transactionCurrencyValue +
	'\nMinimum accounting date: ' +
	minimumAccountingDate +
	'\nMaximum accounting date: ' +
	maximumAccountingDate
)

Map rechercheResult =
	CustomKeywords.
	'component.RechercheKeywords.applySequentialRechercheFiltersWithTabs'(
		rechercheValues,
		tabsToFirstFilter,
		tabsBetweenFilters,
		filterTimeout
	)

CustomKeywords.
'commands.ImageLoader.takeEvidence'(
	targetEnvironment +
	'_PNLComptable_RechercheApplied.png'
)


// ======================================================
// WAIT FOR FILTERED CONTENT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Wait for filtered PNL Comptable content\n' +
	'Delay: ' +
	filteredContentDelay +
	' seconds'
)

Windows.delay(
	filteredContentDelay
)

CustomKeywords.
'commands.ImageLoader.takeEvidence'(
	targetEnvironment +
	'_PNLComptable_FilteredResult.png'
)


// ======================================================
// EXPORT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Export filtered PNL Comptable table\n' +
	'Flow: Exports tab > Export button > Save > Non\n' +
	'Environment: ' +
	targetEnvironment +
	'\nExport scenario: ' +
	exportScenarioName +
	'\nExport label: ' +
	exportLabel
)

CustomKeywords.
'commands.ExportFile.exportFromTwoExportImagesToNo'(
	exportScenarioName,
	targetEnvironment
)


// ======================================================
// CLOSE APPLICATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Close application\n' +
	'Environment: ' +
	targetEnvironment
)

WebUI.callTestCase(
	findTestCase(
		closeApplicationTestCase
	),
	[:],
	FailureHandling.STOP_ON_FAILURE
)

KeywordUtil.markPassed(
	targetEnvironment +
	' PNL Comptable Recherche filter and export completed successfully.\n' +
	'Section: ' +
	sectionValue +
	'\nTransaction currency: ' +
	transactionCurrencyValue +
	'\nAccounting date range: ' +
	minimumAccountingDate +
	' to ' +
	maximumAccountingDate
)




