def runSuite(scriptRef, Map suite, int timeoutMinutes) {
    def safeLabel = suite.label.replaceAll('[\\\\/:*?"<>|]', '_')
    def suiteLog  = "${scriptRef.env.LOGS_DIR}\\${safeLabel}.log"

    int exitCode = 999
    boolean timedOut = false
    long startedAt = System.currentTimeMillis()

    scriptRef.catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
        try {
            printSuiteStart(scriptRef, suite.label, suite.path, timeoutMinutes)

            scriptRef.bat """
                @echo off
                if exist "${suiteLog}" del /f /q "${suiteLog}" >nul 2>&1
            """

            try {
                scriptRef.timeout(time: timeoutMinutes, unit: 'MINUTES') {
                    exitCode = scriptRef.powershell(
                        returnStatus: true,
                        script: """
                            \$arguments = @(
                                '-noSplash',
                                '-runMode=console',
                                '-consoleLog',
                                '-projectPath="${scriptRef.env.PROJECT_PATH}"',
                                '-retry=0',
                                '-testSuitePath="${suite.path}"',
                                '-browserType="${scriptRef.env.BROWSER_TYPE}"',
                                '-executionProfile="${scriptRef.env.EXEC_PROFILE}"',
                                '-reportFolder="${scriptRef.env.REPORTS_ROOT}"'
                            )

                            \$process = Start-Process -FilePath "${scriptRef.env.KATALON_EXE}" `
                                                     -ArgumentList \$arguments `
                                                     -RedirectStandardOutput "${suiteLog}" `
                                                     -RedirectStandardError "${suiteLog}" `
                                                     -Wait `
                                                     -PassThru
                            exit \$process.ExitCode
                        """
                    )
                }
            } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException ex) {
                timedOut = true
                exitCode = 124
                stopGaiaProcessesFast(scriptRef, "Timeout on ${suite.label}")
            }

            def summary = collectSuiteSummary(scriptRef, suite, startedAt, exitCode, timedOut, suiteLog)
            saveSuiteSummary(scriptRef, suite.label, summary)
            printSuiteResult(scriptRef, summary)
            printExecutionSummary(scriptRef)

            if (summary.status != 'PASSED') {
                scriptRef.error("Suite failed: ${suite.label}")
            }
        } catch (Exception ex) {
            def fallback = [
                label    : suite.label,
                path     : suite.path,
                status   : 'FAILED',
                mood     : '❌',
                message  : shortenReason(ex.message ?: 'Unexpected pipeline error'),
                executed : 0,
                passed   : 0,
                failed   : 0,
                skipped  : 0,
                report   : '',
                junit    : ''
            ]
            saveSuiteSummary(scriptRef, suite.label, fallback)
            printSuiteResult(scriptRef, fallback)
            printExecutionSummary(scriptRef)
            throw ex
        }
    }
}

def collectSuiteSummary(scriptRef, Map suite, long startedAt, int exitCode, boolean timedOut, String suiteLog) {
    def artifacts = findLatestSuiteArtifacts(scriptRef, suite.label, startedAt)
    def junitInfo = artifacts.junit ? parseJUnitFromFile(scriptRef.readFile(file: artifacts.junit)) : defaultJUnitSummary()
    def logReason = scriptRef.fileExists(suiteLog) ? extractShortReason(scriptRef.readFile(file: suiteLog), timedOut) : ''

    String status = 'PASSED'
    String mood = '✅'
    String message = ''

    if (timedOut) {
        status = 'FAILED'
        mood = '⏰'
        message = 'Execution timed out | Suite exceeded allowed time | Review timeout or slow steps'
    } else if (exitCode != 0 || junitInfo.failed > 0) {
        status = 'FAILED'
        mood = '❌'
        message = logReason ?: 'Validation failed | Review the first failed step | Open suite report for details'
    } else {
        status = 'PASSED'
        mood = '✅'
        message = junitInfo.executed > 0
            ? "${junitInfo.passed}/${junitInfo.executed} test cases passed | Suite finished successfully"
            : 'Suite finished successfully | No failed test cases found'
    }

    return [
        label    : suite.label,
        path     : suite.path,
        status   : status,
        mood     : mood,
        message  : shortenReason(message),
        executed : junitInfo.executed,
        passed   : junitInfo.passed,
        failed   : junitInfo.failed,
        skipped  : junitInfo.skipped,
        report   : artifacts.report ?: '',
        junit    : artifacts.junit ?: '',
        baseDir  : artifacts.baseDir ?: ''
    ]
}

def printSuiteStart(scriptRef, String label, String path, int timeoutMinutes) {
    scriptRef.echo '╔════════════════════════════════════════════════════════════╗'
    scriptRef.echo fitLine("║ 🚀 STARTING SUITE")
    scriptRef.echo fitLine("║ ${label}")
    scriptRef.echo fitLine("║ 📁 ${path}")
    scriptRef.echo fitLine("║ ⏱️ ${timeoutMinutes} min timeout")
    scriptRef.echo '╚════════════════════════════════════════════════════════════╝'
}

def printSuiteResult(scriptRef, Map summary) {
    scriptRef.echo '╔════════════════════════════════════════════════════════════╗'
    scriptRef.echo fitLine("║ ${summary.mood}")
    scriptRef.echo fitLine("║ ${summary.label}")
    scriptRef.echo fitLine("║ ${summary.message}")
    scriptRef.echo fitLine("║ Executed: ${summary.executed} | Passed: ${summary.passed} | Failed: ${summary.failed} | Skipped: ${summary.skipped}")
    scriptRef.echo '╚════════════════════════════════════════════════════════════╝'
}

def printExecutionSummary(scriptRef) {
    def results = loadSuiteResults(scriptRef)
    def all = results.values() as List

    int passed = all.count { it.status == 'PASSED' }
    int failed = all.count { it.status == 'FAILED' }

    scriptRef.echo '============================================================'
    scriptRef.echo "📌 EXECUTION SUMMARY | Passed: ${passed} | Failed: ${failed}"
    scriptRef.echo '============================================================'
}

