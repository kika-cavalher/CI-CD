	private List<Map> collectEvidence(File reportRoot, String scenarioName, List<String> tracedPaths, Map<String, List<String>> evidenceByCase) {
		LinkedHashSet<File> candidates = new LinkedHashSet<File>()

		(tracedPaths ?: []).each { String path ->
			addCandidateFile(candidates, reportRoot, path)
		}

		List<String> indexedPaths = evidenceByCase[normalizeKey(scenarioName)] ?: []
		indexedPaths.each { String path ->
			addCandidateFile(candidates, reportRoot, path)
		}

		File evidencesRoot = new File(reportRoot, 'Evidences')
		if (evidencesRoot.exists()) {
			evidencesRoot.eachFileRecurse { File file ->
				if (isImageFile(file)) {
					candidates << file
				}
			}
		}

		if (candidates.isEmpty()) {
			reportRoot.eachFileRecurse { File file ->
				if (isImageFile(file) && !file.name.equalsIgnoreCase('logo.png')) {
					candidates << file
				}
			}
		}

		String scenarioKey = normalizeKey(scenarioName)
		List<String> tokens = tokenize(scenarioName)

		List<Map> scored = []

		candidates.each { File image ->
			String pathKey = normalizeKey(image.absolutePath)
			int score = 0

			if (!scenarioKey.isEmpty() && pathKey.contains(scenarioKey)) {
				score += 100
			}

			tokens.each { String token ->
				if (token.length() >= 4 && pathKey.contains(token)) {
					score += 8
				}
			}

			if (safe(image.parentFile?.absolutePath).toLowerCase(Locale.ENGLISH).contains('evidences')) {
				score += 3
			}

			scored << [
				file  : image,
				score : score
			]
		}

		scored = scored.sort { Map a, Map b ->
			int byScore = (b.score as int) <=> (a.score as int)
			if (byScore != 0) {
				return byScore
			}
			return ((b.file as File).lastModified()) <=> ((a.file as File).lastModified())
		}

		List<Map> result = []

		scored.each { Map row ->
			File file = row.file as File

			if (!file.exists() || !file.isFile() || file.length() <= 0L) {
				return
			}

			if (result.size() >= 6) {
				return
			}

			result << [
				name   : file.name,
				href   : file.toURI().toString(),
				image  : true,
				imgSrc : file.toURI().toString()
			]
		}

		return result.unique { Map item -> safe(item.href) }
	}

	private void addCandidateFile(Set<File> target, File reportRoot, String rawPath) {
		String text = safe(rawPath)
		if (text.isEmpty()) {
			return
		}

		File absolute = new File(text)
		if (absolute.exists() && absolute.isFile()) {
			target << absolute
			return
		}

		File relativeToRoot = new File(reportRoot, text)
		if (relativeToRoot.exists() && relativeToRoot.isFile()) {
			target << relativeToRoot
		}
	}

	private boolean isImageFile(File file) {
		if (file == null || !file.exists() || !file.isFile()) {
