package component

import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import java.awt.Robot
import java.awt.event.KeyEvent

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows


class RechercheFilterKeywords {

	private static final String SEARCH_IMAGE_PATH =
			'Images/General/Recherce.PNG'

	private static final String AS_OF_DATE_OBJECT =
			'JV Emission/txtAsOfDate'

	private static final String CURRENCY_OBJECT =
			'JV Emission/txtCurrency'

	private static final String SEARCH_BUTTON_OBJECT =
			'General/btnSearch'


	// ======================================================
	// ELEMENT VALORISE FILTER
	// ======================================================

	@Keyword
	void applyElementValoriseAsOfDateFilter(
			String asOfDateValue,
			Integer timeout) {

		int resolvedTimeout = normalizeTimeout(timeout)

		KeywordUtil.logInfo(
				'[RECHERCHE FILTER] ' +
				'Type=Element Valorise' +
				' | As Of Date=' + safeText(asOfDateValue)
		)

		openRechercheTab(resolvedTimeout)

		setFieldValue(
				findWindowsObject(AS_OF_DATE_OBJECT),
				asOfDateValue,
				resolvedTimeout,
				'As Of Date'
		)

		clickSearchButton(resolvedTimeout)

		KeywordUtil.markPassed(
				'Element Valorise As Of Date filter applied successfully.\n' +
				'As Of Date: ' + safeText(asOfDateValue)
		)
	}


	// ======================================================
	// EMISSION FILTREE FILTERS
	// ======================================================

	@Keyword
	void applyEmissionFiltreeFilters(
			String asOfDateValue,
			String currencyValue,
			Integer timeout) {

		int resolvedTimeout = normalizeTimeout(timeout)

		KeywordUtil.logInfo(
				'[RECHERCHE FILTER] ' +
				'Type=Emission Filtree' +
				' | As Of Date=' + safeText(asOfDateValue) +
				' | Currency=' + safeText(currencyValue)
		)

		validateRequiredValue(
				asOfDateValue,
				'As Of Date'
		)

		validateRequiredValue(
				currencyValue,
				'Currency'
		)

		openRechercheTab(resolvedTimeout)

		setFieldValue(
				findWindowsObject(AS_OF_DATE_OBJECT),
				asOfDateValue,
				resolvedTimeout,
				'As Of Date'
		)

		setFieldValue(
				findWindowsObject(CURRENCY_OBJECT),
				currencyValue,
				resolvedTimeout,
				'Currency'
		)

		clickSearchButton(resolvedTimeout)

		KeywordUtil.markPassed(
				'Emission Filtree filters applied successfully.\n' +
				'As Of Date: ' + safeText(asOfDateValue) + '\n' +
				'Currency: ' + safeText(currencyValue)
		)
	}


	// ======================================================
	// OPEN RECHERCHE TAB
	// ======================================================

	private void openRechercheTab(Integer timeout) {

		String searchImage = new File(
				RunConfiguration.getProjectDir(),
				SEARCH_IMAGE_PATH
		).getAbsolutePath()

		File searchImageFile = new File(searchImage)

		if (!searchImageFile.exists() ||
			!searchImageFile.isFile()) {

			KeywordUtil.markFailedAndStop(
					'Recherche image was not found.\n' +
					'Image: ' + searchImageFile.getAbsolutePath()
			)
		}

		KeywordUtil.logInfo(
				'[RECHERCHE FILTER] Open Recherche tab'
		)

		try {
			WindowsImageKeywords.clickImage(searchImage)
		} catch (Exception exception) {
			KeywordUtil.markFailedAndStop(
					'Recherche tab could not be opened.\n' +
					'Image: ' + searchImageFile.getName() + '\n' +
					'Reason: ' + safeText(exception.getMessage())
			)
		}

		Windows.delay(1)
	}


	// ======================================================
	// SET FIELD VALUE
	// ======================================================

	private void setFieldValue(
			WindowsTestObject fieldObject,
			String value,
			Integer timeout,
			String fieldName) {

		if (fieldObject == null) {
			KeywordUtil.markFailedAndStop(
					fieldName +
					' object was not found.'
			)
		}

		if (!Windows.waitForElementPresent(
				fieldObject,
				timeout,
				FailureHandling.OPTIONAL
		)) {
			KeywordUtil.markFailedAndStop(
					fieldName +
					' field was not found.'
			)
		}

		KeywordUtil.logInfo(
				'[RECHERCHE FILTER] Fill ' +
				fieldName +
				' | Value=' +
				safeText(value)
		)

		try {
			Windows.click(
					fieldObject,
					FailureHandling.STOP_ON_FAILURE
			)

			Windows.clearText(
					fieldObject,
					FailureHandling.OPTIONAL
			)

			Windows.sendKeys(
					fieldObject,
					value,
					FailureHandling.STOP_ON_FAILURE
			)

		} catch (Exception firstException) {

			KeywordUtil.logInfo(
					'[RECHERCHE FILTER] ' +
					'Standard input failed for ' +
					fieldName +
					'. Using keyboard fallback.'
			)

			fillUsingKeyboard(
					fieldObject,
					value,
					fieldName
			)
		}
	}


	// ======================================================
	// KEYBOARD FALLBACK
	// ======================================================

	private void fillUsingKeyboard(
			WindowsTestObject fieldObject,
			String value,
			String fieldName) {

		try {
			Windows.click(
					fieldObject,
					FailureHandling.STOP_ON_FAILURE
			)

			Robot robot = new Robot()

			robot.keyPress(KeyEvent.VK_CONTROL)
			robot.keyPress(KeyEvent.VK_A)
			robot.keyRelease(KeyEvent.VK_A)
			robot.keyRelease(KeyEvent.VK_CONTROL)

			robot.keyPress(KeyEvent.VK_DELETE)
			robot.keyRelease(KeyEvent.VK_DELETE)

			Windows.sendKeys(
					fieldObject,
					value,
					FailureHandling.STOP_ON_FAILURE
			)

		} catch (Exception exception) {
			KeywordUtil.markFailedAndStop(
					fieldName +
					' field could not be filled.\n' +
					'Value: ' + safeText(value) + '\n' +
					'Reason: ' +
					safeText(exception.getMessage())
			)
		}
	}


	// ======================================================
	// CLICK SEARCH
	// ======================================================

	private void clickSearchButton(Integer timeout) {

		WindowsTestObject searchButton =
				findWindowsObject(
						SEARCH_BUTTON_OBJECT
				)

		if (searchButton == null) {
			KeywordUtil.markFailedAndStop(
					'Rechercher button object was not found.'
			)
		}

		if (!Windows.waitForElementPresent(
				searchButton,
				timeout,
				FailureHandling.OPTIONAL
		)) {
			KeywordUtil.markFailedAndStop(
					'Rechercher button was not found.'
			)
		}

		KeywordUtil.logInfo(
				'[RECHERCHE FILTER] Click Rechercher button'
		)

		Windows.click(
				searchButton,
				FailureHandling.STOP_ON_FAILURE
		)
	}


	// ======================================================
	// VALIDATION
	// ======================================================

	private void validateRequiredValue(
			String value,
			String fieldName) {

		if (safeText(value).isEmpty()) {
			KeywordUtil.markFailedAndStop(
					fieldName +
					' value was not configured.'
			)
		}
	}


	private Integer normalizeTimeout(Integer timeout) {

		if (timeout == null || timeout <= 0) {
			return 5
		}

		return timeout
	}


	private String safeText(Object value) {

		if (value == null) {
			return ''
		}

		return value.toString().trim()
	}
}
