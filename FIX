package jiraIntegration

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import org.openqa.selenium.OutputType

import java.awt.Color
import java.awt.Font
import java.awt.Graphics2D
import java.awt.Rectangle
import java.awt.RenderingHints
import java.awt.Robot
import java.awt.Toolkit
import java.awt.image.BufferedImage
import java.io.ByteArrayOutputStream
import java.nio.charset.StandardCharsets
import java.text.SimpleDateFormat
import java.util.Base64
import java.util.Date
import java.util.Locale

import javax.imageio.ImageIO

class JiraImagesEvidence {

    private static final SimpleDateFormat FILE_STAMP =
        new SimpleDateFormat('yyyyMMdd_HHmmss_SSS', Locale.ENGLISH)

    private static final ThreadLocal<String> CURRENT_CASE_ID = new ThreadLocal<String>()
    private static final String TRACE_FILE_NAME = '_custom_report_trace.log'

    @Keyword
    def startCase(String caseId) {
        String safeCaseId = safe(caseId)
        if (safeCaseId.isEmpty()) {
            return
        }

        CURRENT_CASE_ID.set(safeCaseId)
        ensureCaseFolder(safeCaseId)
    }

    @Keyword
    def finishCase() {
        CURRENT_CASE_ID.remove()
    }

    @Keyword
    def recordCaseStart(String caseId, long startMs) {
        String safeCaseId = safe(caseId)
        if (safeCaseId.isEmpty()) {
            return
        }

        startCase(safeCaseId)
        appendTrace('CASE_START', safeCaseId, '', startMs)
    }

    @Keyword
    def recordCaseEnd(String caseId, long endMs) {
        String safeCaseId = safe(caseId)
        if (safeCaseId.isEmpty()) {
            return
        }

        appendTrace('CASE_END', safeCaseId, '', endMs)
    }

    @Keyword
    def recordCaseStatus(String caseId, String status) {
        String safeCaseId = safe(caseId)
        if (safeCaseId.isEmpty()) {
            return
        }

        appendTrace('STATUS', safeCaseId, safe(status), System.currentTimeMillis())
    }

    @Keyword
    def recordCaseDuration(String caseId, long durationMs) {
        String safeCaseId = safe(caseId)
        if (safeCaseId.isEmpty()) {
            return
        }

        appendTrace('DURATION', safeCaseId, String.valueOf(durationMs), System.currentTimeMillis())
    }

    @Keyword
    def note(String message) {
        String caseId = resolveCurrentCaseId()
        if (caseId.isEmpty()) {
            return
        }

        String detail = safe(message)
        if (detail.isEmpty()) {
            return
        }

        appendTrace('STEP', caseId, detail, System.currentTimeMillis())
    }

    @Keyword
    def checkpoint(String message) {
        note(message)
    }

    @Keyword
    def recordFailure(String message) {
        String caseId = resolveCurrentCaseId()
        if (caseId.isEmpty()) {
            return
        }

        String detail = safe(message)
        if (detail.isEmpty()) {
            return
        }

        appendTrace('STEP_FAIL', caseId, detail, System.currentTimeMillis())
        captureForCase(caseId, 'auto-failure', detail)
    }

    @Keyword
    String captureNow(String label = 'manual') {
        String caseId = resolveCurrentCaseId()
        if (caseId.isEmpty()) {
            return ''
        }

        return captureForCase(caseId, label, '')
    }

    @Keyword
    String noteAndCapture(String message, String label = 'manual') {
        note(message)
        return captureNow(label)
    }

    @Keyword
    String autoFailure(String caseId) {
        String safeCaseId = safe(caseId)
        if (safeCaseId.isEmpty()) {
            return ''
        }

        startCase(safeCaseId)
        return captureForCase(safeCaseId, 'auto-failure', 'Automatic failure evidence')
    }

    private String captureForCase(String caseId, String label, String fallbackText) {
        File folder = ensureCaseFolder(caseId)
        if (folder == null) {
            return ''
        }

        byte[] imageBytes = captureDriverScreenshotBytes()
        if (isBlankOrInvalidImage(imageBytes)) {
            imageBytes = captureDesktopScreenshotBytes()
        }

        if (isBlankOrInvalidImage(imageBytes)) {
            imageBytes = createPlaceholderPng(caseId, label, fallbackText)
        }

        if (imageBytes == null || imageBytes.length == 0) {
            return ''
        }

        String safeLabel = sanitizeFileName(safe(label).isEmpty() ? 'capture' : label)
        String fileName = FILE_STAMP.format(new Date()) + '_' + safeLabel + '.png'
        File target = new File(folder, fileName)

        target.bytes = imageBytes

        appendTrace('EVIDENCE', caseId, target.absolutePath, System.currentTimeMillis())
        KeywordUtil.logInfo('Evidence screenshot saved: ' + target.absolutePath)

        return target.absolutePath
    }

    private byte[] captureDriverScreenshotBytes() {
        try {
            def driver = Windows.getDriver()
            if (driver == null) {
                return null
            }

            byte[] raw = driver.getScreenshotAs(OutputType.BYTES)
            if (raw != null && raw.length > 0) {
                return raw
            }
        } catch (Throwable ignored) {
        }

        return null
    }

    private byte[] captureDesktopScreenshotBytes() {
        try {
            Rectangle rect = new Rectangle(Toolkit.getDefaultToolkit().getScreenSize())
            BufferedImage image = new Robot().createScreenCapture(rect)
            BufferedImage normalized = normalizeImage(image)

            ByteArrayOutputStream baos = new ByteArrayOutputStream()
            ImageIO.write(normalized, 'png', baos)
            return baos.toByteArray()
        } catch (Throwable ignored) {
            return null
        }
    }

    private byte[] createPlaceholderPng(String caseId, String label, String fallbackText) {
        try {
            BufferedImage image = new BufferedImage(1400, 800, BufferedImage.TYPE_INT_RGB)
            Graphics2D g = image.createGraphics()

            try {
                g.setRenderingHint(RenderingHints.KEY_TEXT_ANTIALIASING, RenderingHints.VALUE_TEXT_ANTIALIAS_ON)
                g.setColor(Color.WHITE)
                g.fillRect(0, 0, image.width, image.height)

                g.setColor(new Color(220, 73, 61))
                g.setFont(new Font('Arial', Font.BOLD, 30))
                g.drawString('Evidence fallback image', 40, 70)

                g.setColor(Color.DARK_GRAY)
                g.setFont(new Font('Arial', Font.PLAIN, 22))
                g.drawString('Case: ' + safe(caseId), 40, 130)
                g.drawString('Label: ' + safe(label), 40, 170)

                String message = safe(fallbackText)
                if (message.isEmpty()) {
                    message = 'Screenshot could not be captured from driver or desktop.'
                }

                List<String> lines = wrapText(message, 90)
                int y = 240
                g.setFont(new Font('Arial', Font.PLAIN, 20))
                lines.each { String line ->
                    g.drawString(line, 40, y)
                    y += 32
                }
            } finally {
                g.dispose()
            }

            ByteArrayOutputStream baos = new ByteArrayOutputStream()
            ImageIO.write(image, 'png', baos)
            return baos.toByteArray()
        } catch (Throwable ignored) {
            return null
        }
    }

    private List<String> wrapText(String text, int maxLen) {
        List<String> result = []
        String remaining = safe(text)

        while (!remaining.isEmpty()) {
            if (remaining.length() <= maxLen) {
                result << remaining
                break
            }

            int splitAt = remaining.lastIndexOf(' ', maxLen)
            if (splitAt <= 0) {
                splitAt = maxLen
            }

            result << remaining.substring(0, splitAt).trim()
            remaining = remaining.substring(splitAt).trim()
        }

        return result
    }

    private BufferedImage normalizeImage(BufferedImage input) {
        if (input == null) {
            return null
        }

        int width = input.width
        int height = input.height

        if (width <= 1600) {
            return input
        }

        double scale = 1600d / (double) width
        int targetWidth = 1600
        int targetHeight = Math.max(1, (int) Math.round(height * scale))

        BufferedImage output = new BufferedImage(targetWidth, targetHeight, BufferedImage.TYPE_INT_RGB)
        Graphics2D g = output.createGraphics()
        try {
            g.drawImage(input, 0, 0, targetWidth, targetHeight, null)
        } finally {
            g.dispose()
        }

        return output
    }

    private boolean isBlankOrInvalidImage(byte[] bytes) {
        if (bytes == null || bytes.length == 0) {
            return true
        }

        try {
            BufferedImage image = ImageIO.read(new ByteArrayInputStream(bytes))
            if (image == null || image.width <= 0 || image.height <= 0) {
                return true
            }

            int stepX = Math.max(1, image.width.intdiv(20))
            int stepY = Math.max(1, image.height.intdiv(20))

            int samples = 0
            int bright = 0
            int dark = 0
            int sameAsFirst = 0
            Integer firstRgb = null

            for (int y = 0; y < image.height; y += stepY) {
                for (int x = 0; x < image.width; x += stepX) {
                    int rgb = image.getRGB(x, y)
                    Color c = new Color(rgb)
                    int avg = (c.red + c.green + c.blue) / 3

                    if (firstRgb == null) {
                        firstRgb = rgb
                    }

                    if (rgb == firstRgb) {
                        sameAsFirst++
                    }

                    if (avg >= 245) {
                        bright++
                    }

                    if (avg <= 10) {
                        dark++
                    }

                    samples++
                }
            }

            if (samples == 0) {
                return true
            }

            double brightRatio = (double) bright / (double) samples
            double darkRatio = (double) dark / (double) samples
            double sameRatio = (double) sameAsFirst / (double) samples

            return brightRatio >= 0.98d || darkRatio >= 0.98d || sameRatio >= 0.98d
        } catch (Throwable ignored) {
            return true
        }
    }

    private File ensureCaseFolder(String caseId) {
        File root = new File(RunConfiguration.getReportFolder(), 'Evidences')
        if (!root.exists()) {
            root.mkdirs()
        }

        File caseFolder = new File(root, sanitizeCaseFolderName(caseId))
        if (!caseFolder.exists()) {
            caseFolder.mkdirs()
        }

        return caseFolder
    }

    private String resolveCurrentCaseId() {
        return safe(CURRENT_CASE_ID.get())
    }

    private void appendTrace(String type, String caseId, String value, long eventMs) {
        File traceFile = new File(RunConfiguration.getReportFolder(), TRACE_FILE_NAME)
        if (traceFile.parentFile != null && !traceFile.parentFile.exists()) {
            traceFile.parentFile.mkdirs()
        }

        String payload64 = Base64.encoder.encodeToString(safe(value).getBytes(StandardCharsets.UTF_8))
        String line =
            safe(type) + '\t' +
            String.valueOf(eventMs > 0L ? eventMs : System.currentTimeMillis()) + '\t' +
            safe(caseId) + '\t' +
            payload64 +
            System.lineSeparator()

        synchronized (JiraImagesEvidence.class) {
            traceFile.append(line, 'UTF-8')
        }
    }

    static String sanitizeCaseFolderName(String value) {
        String text = safeStatic(value)
            .replace('\\', '_')
            .replace('/', '_')
            .replaceAll('[^A-Za-z0-9._-]+', '_')
            .replaceAll('_+', '_')
            .replaceAll('^_+', '')
            .replaceAll('_+$', '')

        if (text.isEmpty()) {
            text = 'scenario'
        }

        if (text.length() > 140) {
            text = text.substring(0, 140)
        }

        return text
    }

    private String sanitizeFileName(String value) {
        String text = safe(value)
            .replace('\\', '_')
            .replace('/', '_')
            .replaceAll('[^A-Za-z0-9._-]+', '_')
            .replaceAll('_+', '_')
            .replaceAll('^_+', '')
            .replaceAll('_+$', '')

        return text.isEmpty() ? 'capture' : text
    }

    private String safe(Object value) {
        return safeStatic(value)
    }

    private static String safeStatic(Object value) {
        return value == null ? '' : String.valueOf(value).trim()
    }
}
