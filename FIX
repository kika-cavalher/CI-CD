	// ---------------------------------------------------------
	// normalizeSource
	// Used by: applySourceFilter, openInvestigationDetail
	// ---------------------------------------------------------

	private String normalizeSource(
			String sourceValue
	) {

		String value =
				safeText(sourceValue)
				.toLowerCase()

		value =
				java.text.Normalizer.normalize(
				value,
				java.text.Normalizer.Form.NFD
				).replaceAll('\\p{M}', '')

		return value
	}

	// ---------------------------------------------------------
	// safeTimeout
	// Shared Investigations timeout helper
	// ---------------------------------------------------------

	private Integer safeTimeout(
			Integer timeoutSeconds
	) {

		return timeoutSeconds != null &&
				timeoutSeconds > 0
				? timeoutSeconds
				: DEFAULT_TIMEOUT
	}

	// ---------------------------------------------------------
	// safeText
	// Shared Investigations text helper
	// ---------------------------------------------------------

	private String safeText(
			Object value
	) {

		return value == null
				? ''
				: value.toString().trim()
	}


