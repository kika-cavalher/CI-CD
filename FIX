class JiraTestPlanManager {

	private final JiraFlowCoordinator flow
	private final JiraGateway gateway

	JiraTestPlanManager(JiraFlowCoordinator flow, JiraGateway gateway) {
		this.flow = flow
		this.gateway = gateway
	}

	String getOrCreateTestPlanKey() {
		if (!flow.isBlank(flow.MANUAL_TEST_PLAN_KEY)) {
			KeywordUtil.logInfo("Using MANUAL_TEST_PLAN_KEY: ${flow.MANUAL_TEST_PLAN_KEY}")
			return flow.safe(flow.MANUAL_TEST_PLAN_KEY)
		}

		if (!flow.FORCE_CREATE_NEW_TEST_PLAN) {
			String saved = flow.readSavedSuiteTestPlanKey()
			if (!flow.isBlank(saved)) {
				Map savedIssue = gateway.getIssue(saved)
				if (savedIssue.ok) {
					KeywordUtil.logInfo("Using saved Test Plan key: ${saved}")
					return saved
				}
			}
		}

		String existing = findExistingTestPlanKeyBySummary(flow.getTestPlanName())
		if (!flow.isBlank(existing)) {
			flow.saveSuiteTestPlanKey(existing)
			return existing
		}

		return createTestPlan(flow.getTestPlanName())
	}

	private String findExistingTestPlanKeyBySummary(String summary) {
		String escapedSummary = summary.replace('"', '\\"')
		String jql = "project = \"${flow.PROJECT_KEY}\" AND issuetype = \"Test Plan\" AND summary ~ \"\\\"${escapedSummary}\\\"\" ORDER BY created DESC"

		Map result = gateway.searchIssues(jql, 20)
		if (!result.ok) {
			return ''
		}

		List issues = result.json?.issues instanceof List ? (result.json.issues as List) : []
		for (def issue : issues) {
			String issueSummary = flow.safe(issue?.fields?.summary)
			if (issueSummary.equalsIgnoreCase(summary)) {
				return flow.safe(issue?.key)
			}
		}

		return ''
	}

	private String createTestPlan(String summary) {
		Map fields = [
			project  : [key: flow.PROJECT_KEY],
			summary  : summary,
			issuetype: [name: 'Test Plan']
		]

		List<String> labels = flow.splitLabels()
		if (!labels.isEmpty()) {
			fields.labels = labels
		}

		Map created = gateway.createIssue(fields)
		if (!created.ok) {
			return 'ERROR_CREATE_TEST_PLAN'
		}

		String issueKey = flow.safe(created.json?.key)
		if (flow.isBlank(issueKey)) {
			return 'ERROR_CREATE_TEST_PLAN'
		}

		if (!flow.isBlank(flow.ASSIGNEE_NAME)) {
			gateway.assignIssue(issueKey, flow.ASSIGNEE_NAME)
		}

		flow.saveSuiteTestPlanKey(issueKey)
		KeywordUtil.logInfo("New Test Plan created successfully: ${issueKey}")
		return issueKey
	}
