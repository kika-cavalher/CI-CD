import internal.GlobalVariable

class ValidationKeyword {

	// ========================================================================
	// Method to verify the page title of a section
	// ========================================================================
	@Keyword
	void verifyPageTitle(String title) {
		TestObject pageTitle = findTestObject('Object Repository/Common/Common PageTitle',[('title'): title])

		try {
			WebUI.verifyElementPresent(pageTitle,100)
		} catch (ElementNotVisibleException e) {
			KeywordUtil.logInfo("The element '${pageTitle}' is present but not visible. Error: ${e.message}")
		}
	}

	// ========================================================================
	// Method to verify if the message was successful
	// ========================================================================
	@Keyword
	void verifySuccessfulMessage() {
		try {
			TestObject successMessage = findTestObject('Object Repository/Settings/Context/Sucess Message')
			boolean isElementPresent = WebUI.waitForElementVisible(successMessage,4)
			if (isElementPresent) {
				KeywordUtil.logInfo("The message '${WebUI.getText(successMessage)}' was founded!")
			}
			else {
				throw new StepFailedException("Message founded: "+WebUI.getText(successMessage))
			}
		}catch (StepFailedException e) {
			KeywordUtil.markFailed("Erro: " + e.getMessage())
		}
	}

	// ========================================================================
	// Method to wait for the download to complete
	// ========================================================================
	@Keyword
	void waitForFileDownload(String filename, int timeoutInSeconds) {
		String projectDir = RunConfiguration.getProjectDir() +"/Downloads/"+filename

		File file = new File(projectDir)
		long startTime = System.currentTimeMillis()
		long timeoutMillis = timeoutInSeconds * 1000

		while (!file.exists()) {
			if (System.currentTimeMillis() - startTime > timeoutMillis) {
				KeywordUtil.markFailed("We couldn't find the file ${filename} during your download attempt.")
				return
			}
			Thread.sleep(1000) // wait for 1 second
		}

		KeywordUtil.logInfo("File downloaded successfully: ${file.getAbsolutePath()}")
	}

	// =================================
	// Search by context type
	// =================================
	@Keyword
	void filterByContextType (String ContextType, String tableName, String showOrHide) {
		WebUI.verifyElementPresent(findTestObject("Object Repository/Settings/Context/Context Type Input"), 5)
		WebUI.setText(findTestObject("Object Repository/Settings/Context/Context Type Input"), ContextType)
		TestObject firstResult = findTestObject('Object Repository/Common/FirstElement')
		try {
			String elementText = WebUI.getText(firstResult)
			if (elementText.contains(ContextType)) {
				WebUI.click(firstResult)
			}
		} catch (NoSuchElementException e) {
			KeywordUtil.logInfo("The element '${firstResult}' was not found in the DOM. Error: ${e.message}")
		} catch (ElementNotVisibleException e) {
			KeywordUtil.logInfo("The element '${firstResult}' is present but not visible. Error: ${e.message}")
		}
		
		WebUI.click(findTestObject('Object Repository/Common/Load'))

		filterByTableName(ContextType,tableName,showOrHide)

		WebUI.executeJavaScript("location.reload(true);", null)
	}


	// =================================
	// Search by text field
	// =================================
	@Keyword
	void searchFilter(String tableName) {
		WebUI.executeJavaScript("window.scrollBy(0, 250);", null)
		WebUI.delay(2)
		WebUI.click(findTestObject('Object Repository/Common/Filters/Filters Button'))
		WebUI.click(findTestObject('Object Repository/Common/Table Name Filter Option'))
		WebUI.setText(findTestObject('Object Repository/Common/Filter Value'),tableName)
		WebUI.delay(1)
		WebUI.click(findTestObject('Object Repository/Common/Search Icon'))
	}


	// ============================
	// Search by table name filter
	// ============================
	@Keyword
	void filterByTableName (String ContextType, String tableName,String showOrHide) {
		searchFilter(tableName)

		try {
			boolean result = WebUI.verifyElementPresent(findTestObject('Object Repository/Common/Table Rows', [('tableName'): tableName]), 5)

			if (showOrHide == 'NA') {
				if (result) {
					KeywordUtil.markFailed("Table '${tableName}' should not be present for this Context Type: '${ContextType}!'")
				}
			}
			else if (showOrHide == 'C' || showOrHide == 'S') {
				if (!result) {
					KeywordUtil.markFailed("Table '${tableName}' should be present for this Context Type: '${ContextType}'!")
				}
			}
		} catch (StepFailedException e) {
			KeywordUtil.markWarning("O objeto 'Filter Result' não está presente: " + e.message)
		}
	}

	@Keyword
	void checkErrors(String tb, List<String> errors ) {
		TestObject section = findTestObject('Object Repository/Correction/B2C CM/Correction Details/Invalid Records Section',[("tab"):tb])
		WebUI.scrollToElement(section, 10)
		WebUI.click(section)
		WebUI.delay(5)

		String table = tb.substring(0, 1).toUpperCase() + tb.substring(1).toLowerCase()

		if (table.equalsIgnoreCase("Others")){
			table = "Autres"
		}

		for (int i= 0; i < errors.size(); i++) {
			if (errors.get(i).equalsIgnoreCase("Duplicates in file") || errors.get(i).equalsIgnoreCase("Duplicates")) {
				TestObject duplicateInFile = findTestObject('Object Repository/Correction/B2C CM/Correction Details/Invalid Records Section',[("tab"):errors.get(i)])
				WebUI.click(duplicateInFile)

				String globalTable = GlobalVariable."${table}"

				if (globalTable){
					TestObject element = findTestObject('Object Repository/Correction/B2C CM/Correction Details/Duplicated Li',[("element"):GlobalVariable."${table}"])
					scroll()
					WebUI.getText(element) == null ? KeywordUtil.logInfo("The error was not found!" +WebUI.getText(element)) :  KeywordUtil.logInfo("The error was found correctly" +WebUI.getText(element))
				}
				else {
					List<String> rows = GlobalVariable.rowDuplicatedInUI

					for (int row= 0; row < rows.size(); row++) {
						TestObject element = findTestObject('Object Repository/Correction/B2C CM/Correction Details/Duplicated Li',[("element"):rows.get(row)])
						scroll()
						WebUI.getText(element) == null ? KeywordUtil.logInfo("The error was not found! " +WebUI.getText(element)) :  KeywordUtil.logInfo("The error was found correctly! " +WebUI.getText(element))
					}
				}
			}
			else {
				TestObject tabEmpty = findTestObject('Object Repository/Correction/B2C CM/Correction Details/Invalid Records Section',[("tab"):errors.get(i)])
				WebUI.getText(tabEmpty) == null ? KeywordUtil.logInfo("The error ${errors.get(i)} was not found!") : KeywordUtil.logInfo("The error ${errors.get(i)} was found correctly!")
			}
		}
	}

	void scroll(){
		TestObject scroll = findTestObject('Object Repository/Correction/B2C CM/Correction Details/Errors Alert Popup')
		WebElement WebElement = WebUI.findWebElement(scroll, 5)
		JavascriptExecutor js = (JavascriptExecutor) DriverFactory.getWebDriver()
		js.executeScript("arguments[0].scrollBottom += 15;", WebElement)
	}

	@Keyword
	List<String> getRowAsListOfStrings(int row_id) {
		String saveXpath = "//div[@role='row'][${row_id}]//div[@role='cell']"
		TestObject saveObject = new TestObject().addProperty('xpath', ConditionType.EQUALS, saveXpath)
		List<WebElement> cellElements = WebUI.findWebElements(saveObject,5)
		List<String> cellValues = new ArrayList<>()

		for (WebElement Cell: cellElements) {
			String cellValue = Cell.getText();
			if (cellValue.isEmpty()) {
				cellValue = Cell.getAttribute("value");
			}
			cellValues.add(cellValue);
		}

		return cellValues
	}
}
