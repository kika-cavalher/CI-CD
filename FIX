import internal.GlobalVariable as GlobalVariable

final String SET_ENV_BAT               = 'D:\\Projects\\eMatchStarters\\set-ematch-env.bat'
final String START_EMATCH_BAT          = 'D:\\Projects\\eMatchStarters\\run-ematch-command.bat'
final String WINAPPDRIVER_EXE          = 'C:\\Program Files (x86)\\Windows Application Driver\\WinAppDriver.exe'
final String RESOLUTION_SCRIPT         = 'D:\\setResolution.ps1'

final int WINAPPDRIVER_PORT            = 4723
final int WINAPPDRIVER_TIMEOUT_SEC     = 20
final int START_TIMEOUT_SEC            = 180
final int ATTACH_TIMEOUT_SEC           = 90
final int ATTACH_RETRY_SEC             = 2

final String REC_LOGIN_TESTCASE        = 'Test Cases/Connection/eMatch - Login REC'
final String PRD_LOGIN_TESTCASE        = 'Test Cases/Connection/Login (PROD)'

String envName = resolveEnvironment()
Map cfg = resolveConfig(envName)

note("==========================================")
note("eMatch generic launcher started")
note("Environment      : ${envName}")
note("Window title     : ${cfg.windowTitle}")
note("Launcher bat     : ${START_EMATCH_BAT}")
note("Login test case  : ${cfg.loginTestCase}")
note("==========================================")

setGlobalEnvironment(envName)
ensureFileExists(SET_ENV_BAT)
ensureFileExists(START_EMATCH_BAT)
ensureWinAppDriver()
runResolutionIfPresent()
saveEnvironmentForLauncher(envName)
launchEnvironment(envName)
attachToEmatchWindow(cfg.windowTitle, ATTACH_TIMEOUT_SEC, ATTACH_RETRY_SEC)
callLoginTestCase(cfg.loginTestCase, envName)

note("eMatch generic launcher finished successfully")

def resolveEnvironment() {
    String envName = ''
    try {
        envName = (GlobalVariable.environment ?: '').toString().trim().toUpperCase()
    } catch (Throwable ignored) {
        envName = ''
    }

    if (!envName) {
        envName = 'REC'
    }

    if (!(envName in ['REC', 'PRD'])) {
        throw new StepFailedException("Invalid environment '${envName}'. Use REC or PRD.")
    }

    return envName
}

def resolveConfig(String envName) {
    if (envName == 'PRD') {
        return [
            windowTitle   : 'eMatch - Login PRD',
            loginTestCase : PRD_LOGIN_TESTCASE
        ]
    }

    return [
        windowTitle   : 'eMatch - Login REC',
        loginTestCase : REC_LOGIN_TESTCASE
    ]
}

void setGlobalEnvironment(String envName) {
    try {
        GlobalVariable.environment = envName
        note("GlobalVariable.environment set to ${envName}")
    } catch (Throwable ignored) {
        note("Could not overwrite GlobalVariable.environment at runtime. Continuing with ${envName}")
    }
}

void runResolutionIfPresent() {
    File script = new File(RESOLUTION_SCRIPT)
    if (!script.exists()) {
        note("Resolution script not found. Skipping: ${RESOLUTION_SCRIPT}")
        return
    }

    note("Running resolution script...")
    Map result = runCommand(
        ['powershell', '-ExecutionPolicy', 'Bypass', '-File', RESOLUTION_SCRIPT],
        60
    )

    if (result.exitCode != 0) {
        throw new StepFailedException("Resolution script failed.\n${result.output}")
    }
}

void ensureWinAppDriver() {
    if (isPortOpen('127.0.0.1', WINAPPDRIVER_PORT)) {
        note("WinAppDriver already running on port ${WINAPPDRIVER_PORT}")
        return
    }

    ensureFileExists(WINAPPDRIVER_EXE)
    note("Starting WinAppDriver...")

    File logDir = new File(RunConfiguration.getProjectDir() + '\\Reports\\desktop_logs')
    if (!logDir.exists()) {
        logDir.mkdirs()
    }

    File logFile = new File(logDir, 'winappdriver.log')

    ProcessBuilder pb = new ProcessBuilder(WINAPPDRIVER_EXE)
    pb.redirectErrorStream(true)
    pb.redirectOutput(ProcessBuilder.Redirect.appendTo(logFile))
    pb.start()

    long deadline = System.currentTimeMillis() + (WINAPPDRIVER_TIMEOUT_SEC * 1000L)
    while (System.currentTimeMillis() < deadline) {
        if (isPortOpen('127.0.0.1', WINAPPDRIVER_PORT)) {
            note("WinAppDriver started successfully")
            return
        }
        sleep(1000)
    }

    throw new StepFailedException("WinAppDriver did not start within ${WINAPPDRIVER_TIMEOUT_SEC} seconds.")
}

void saveEnvironmentForLauncher(String envName) {
    note("Saving environment for launcher: ${envName}")
    Map result = runCommand(
        ['cmd', '/c', "\"${SET_ENV_BAT}\" ${envName}"],
        30
    )

    if (result.exitCode != 0) {
        throw new StepFailedException("set-ematch-env.bat failed.\n${result.output}")
    }

    note(result.output)
}

void launchEnvironment(String envName) {
    note("Launching eMatch for environment: ${envName}")
    Map result = runCommand(
        ['cmd', '/c', "\"${START_EMATCH_BAT}\" ${envName}"],
        START_TIMEOUT_SEC
    )

    note(result.output)

    if (result.exitCode != 0) {
        throw new StepFailedException("run-ematch-command.bat failed for ${envName}.\n${result.output}")
    }
}

void attachToEmatchWindow(String windowTitle, int timeoutSec, int retrySec) {
    note("Attaching to window: ${windowTitle}")

    long deadline = System.currentTimeMillis() + (timeoutSec * 1000L)
    Throwable lastError = null

    while (System.currentTimeMillis() < deadline) {
        try {
            Windows.startExistingApplication(windowTitle)

            WindowsTestObject mainWindow = new WindowsTestObject('eMatchMainWindow')
            mainWindow.setLocatorStrategy(LocatorStrategy.XPATH)
            mainWindow.setLocator("//*[contains(@Name,'${escapeForXpath(windowTitle)}')]")

            Windows.verifyElementPresent(mainWindow, 5)
            Windows.switchToWindowTitle(windowTitle, FailureHandling.OPTIONAL)
            note("Attached to eMatch window successfully")
            return
        } catch (Throwable t) {
            lastError = t
            sleep(retrySec * 1000L)
        }
    }

    throw new StepFailedException("Could not attach to window '${windowTitle}'. Last error: ${lastError?.message}", lastError)
}

void callLoginTestCase(String testCasePath, String envName) {
    note("Calling login test case: ${testCasePath}")

    def tc = findTestCase(testCasePath)
    if (tc == null) {
        throw new StepFailedException("Login test case not found: ${testCasePath}")
    }

    WebUI.callTestCase(
        tc,
        ['environment': envName],
        FailureHandling.STOP_ON_FAILURE
    )
}

Map runCommand(List<String> command, long timeoutSec) {
    note("Running command: ${command.join(' ')}")

    ProcessBuilder pb = new ProcessBuilder(command)
    pb.redirectErrorStream(true)

    Process process = pb.start()
    boolean finished = process.waitFor(timeoutSec, TimeUnit.SECONDS)

    if (!finished) {
        process.destroyForcibly()
        return [
            exitCode : -1,
            output   : "Command timed out after ${timeoutSec} seconds."
        ]
    }

    String output = new String(process.inputStream.bytes, 'Cp1252')

    return [
        exitCode : process.exitValue(),
        output   : output
    ]
}

boolean isPortOpen(String host, int port) {
    Socket socket = null
    try {
        socket = new Socket(host, port)
        return true
    } catch (Throwable ignored) {
        return false
    } finally {
        try {
            socket?.close()
        } catch (Throwable ignored) {
        }
    }
}

void ensureFileExists(String path) {
    if (!new File(path).exists()) {
        throw new StepFailedException("Required file not found: ${path}")
    }
}

String escapeForXpath(String value) {
    return value.replace("'", "&apos;")
}

void note(String message) {
    KeywordUtil.logInfo(message)
    try {
        CustomKeywords.'jiraIntegration.JiraReportSteps.note'(message)
    } catch (Throwable ignored) {
    }
}
