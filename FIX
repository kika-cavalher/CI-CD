    List<Map> parseXmlCases(String xmlPath) {
        List<Map> result = []

        if (owner.isBlank(xmlPath)) {
            return result
        }

        File xmlFile = new File(xmlPath)
        if (!xmlFile.exists()) {
            return result
        }

        def xml
        try {
            xml = new XmlSlurper().parse(xmlFile)
        } catch (Exception ignored) {
            return result
        }

        List testcaseNodes = []

        String rootName = owner.safe(xml.name())

        if (rootName == 'testsuite') {
            testcaseNodes.addAll(xml.testcase)
        } else if (rootName == 'testsuites') {
            xml.testsuite.each { suite ->
                testcaseNodes.addAll(suite.testcase)
            }
        }

        testcaseNodes.each { tc ->
            String className = owner.safe(tc.@classname)
            String testName = owner.safe(tc.@name)
            long durationMs = owner.toMillis(tc.@time)

            def failureNode = tc.failure?.size() > 0 ? tc.failure[0] : null
            def errorNode = tc.error?.size() > 0 ? tc.error[0] : null
            def skippedNode = tc.skipped?.size() > 0 ? tc.skipped[0] : null

            boolean failed = failureNode != null || errorNode != null
            boolean skipped = skippedNode != null

            String message = ''
            String details = ''

            if (failureNode != null) {
                message = owner.safe(failureNode.@message)
                details = owner.safe(failureNode.text())
            } else if (errorNode != null) {
                message = owner.safe(errorNode.@message)
                details = owner.safe(errorNode.text())
            } else if (skippedNode != null) {
                message = owner.safe(skippedNode.@message)
                details = owner.safe(skippedNode.text())
            }

            String displayName = ''
            if (!owner.isBlank(className) && !owner.isBlank(testName)) {
                displayName = className + '/' + testName
            } else if (!owner.isBlank(testName)) {
                displayName = testName
            } else {
                displayName = className
            }

            Map row = [:]
            row.name = displayName
            row.shortName = owner.isBlank(testName) ? displayName : testName
            row.durationMs = durationMs
            row.status = skipped ? 'skipped' : (failed ? 'failed' : 'passed')
            row.message = message
            row.details = details

            result.add(row)
        }

        return result
    }

    List<String> getFailureSummaryLines(String message, String details) {
        List<String> lines = []

        String safeMessage = owner.safe(message)
        String safeDetails = owner.safe(details)

        if (!owner.isBlank(safeMessage)) {
            lines.add(safeMessage)
        }

        safeDetails.readLines().each { String raw ->
            String line = owner.safe(raw)

            if (owner.isBlank(line)) {
                return
            }

            if (line.startsWith('at ')) {
                return
            }

            if (line.startsWith('Caused by: at ')) {
                return
            }

            if (line.contains('com.kms.katalon') && line.length() > 120) {
                return
            }

            if (line.contains('org.openqa.selenium') && line.length() > 120) {
                return
            }

            lines.add(line)
        }

        List<String> cleaned = []
        lines.each { String item ->
            String normalized = owner.safe(item).replaceAll(/\s+/, ' ').trim()
            if (!owner.isBlank(normalized) && !cleaned.contains(normalized)) {
                cleaned.add(normalized)
            }
        }

        if (cleaned.isEmpty() && !owner.isBlank(safeDetails)) {
            safeDetails.readLines().each { String raw ->
                String line = owner.safe(raw)
                if (!owner.isBlank(line) && cleaned.size() < 3) {
                    cleaned.add(line)
                }
            }
        }

        if (cleaned.size() > 3) {
            return cleaned.subList(0, 3)
        }

        return cleaned
    }

    String buildHeaderCard(String label, String value) {
        String safeLabel = owner.htmlEscape(owner.safe(label))
        String safeValue = owner.htmlEscape(owner.safe(value))

        return """
            <div class="stat-card">
                <div class="stat-label">${safeLabel}</div>
                <div class="stat-value">${safeValue}</div>
            </div>
        """
    }

    String buildFailedCaseHtml(Map item, File baseDir) {
        StringBuilder block = new StringBuilder()

        String itemName = owner.safe(item.name)
        String itemMessage = owner.safe(item.message)
        String itemDetails = owner.safe(item.details)
        long itemDuration = (item.durationMs ?: 0L) as long

        List<String> summaryLines = getFailureSummaryLines(itemMessage, itemDetails)

        block.append('<div class="case-card failed">\n')
        block.append('<div class="case-title">')
        block.append(owner.htmlEscape(itemName))
        block.append('</div>\n')

        block.append('<div class="case-meta">Duration: ')
        block.append(owner.htmlEscape(owner.formatDurationMillis(itemDuration)))
        block.append('</div>\n')

        summaryLines.each { String line ->
            String safeLine = owner.safe(line)
            block.append('<div class="failure-line">')
            block.append(owner.htmlEscape(safeLine))
            block.append('</div>\n')
        }

        block.append('<div class="details-wrap">\n')
        block.append('<details>\n')
        block.append('<summary>See full error log</summary>\n')
        block.append('<pre>')
        block.append(owner.htmlEscape(itemDetails))
        block.append('</pre>\n')
        block.append('</details>\n')
        block.append('</div>\n')

        File image = item.image as File
        if (image != null && image.exists()) {
            String imgSrc = owner.relativeUri(baseDir, image)
            block.append('<img class="failure-image" src="')
            block.append(owner.htmlEscape(imgSrc))
            block.append('" alt="Failure evidence">\n')
        }

        block.append('</div>\n')
        return block.toString()
    }

    String buildPassedCaseHtml(Map item) {
