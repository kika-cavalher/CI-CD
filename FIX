import static com.kms.katalon.core.testcase.TestCaseFactory.findTestCase

import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows


// ======================================================
// MODULE CONFIG
// ======================================================

String targetEnvironment = 'REC'
String exportLabel = 'EUR'

String menuName = 'Liste des périmètres'
String menuResultName = 'Liste des périmètres'
String openedTabName = 'Liste des périmètres'

String favoriteTitle = 'Katalon Fav Test'
String favoriteImageKey = 'menuKatalonFavTest'

String formulaireFilterValue = '10E'

String loginTestCase = 'Component/Authentication/Login ' + targetEnvironment

String closeApplicationTestCase = 'Component/Authentication/Close Application'

String exportScenarioName = 'GUI_FavoriteView'


// ======================================================
// TIMEOUT CONFIG
// ======================================================

Integer landingPageTimeout = 5
Integer menuTimeout = 20
Integer openedTabTimeout = 10

Integer favoriteControlTimeout = 5
Integer favoritePopupTimeout = 5
Integer favoriteOpenTimeout = 5

Integer configurationFormTimeout = 10


// ======================================================
// AUTHENTICATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'Authenticate and open application\n' +
		'Environment: ' + targetEnvironment
)

WebUI.callTestCase(
		findTestCase(loginTestCase),
		[:],
		FailureHandling.STOP_ON_FAILURE
)


// ======================================================
// LANDING PAGE VALIDATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'Validate GUI landing page\n' +
		'- Bottom bar information\n' +
		'- Calendar controls\n' +
		'- Top bar controls and enabled states'
)

CustomKeywords.'pageObject.guiValidation.validateLandingPage'(
		landingPageTimeout
)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
		targetEnvironment + '_GUI_LandingPage.png'
)


// ======================================================
// CREATE FAVORITE
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'Open target module\n' +
		'Search: ' + menuName + '\n' +
		'Result: ' + menuResultName
)

CustomKeywords.'component.MenuSettings.searchAndOpenMenuByText'(
		menuName,
		menuResultName,
		menuTimeout
)

CustomKeywords.'pageObject.guiValidation.applyFormulaireFilter'(
		formulaireFilterValue
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'Validate opened tab\n' +
		'Expected tab: ' + openedTabName
)


CustomKeywords.'commands.ImageLoader.takeEvidence'(
		targetEnvironment + '_GUI_TargetModuleOpened.png'
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'Create favorite\n' +
		'Title: ' + favoriteTitle + '\n' +
		'Flow:\n' +
		'- Click Create Favorite\n' +
		'- Fill favorite title by image\n' +
		'- Save favorite\n' +
		'- Confirm success modal'
)

CustomKeywords.'pageObject.guiValidation.createFavoriteFromCurrentModule'(
		favoriteTitle,
		favoriteControlTimeout,
		favoritePopupTimeout
)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
		targetEnvironment + '_GUI_FavoriteCreated.png'
)


// ======================================================
// OPEN FAVORITE
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'Close all tabs and open created favorite\n' +
		'Favorite: ' + favoriteTitle + '\n' +
		'Expected tab to close: ' + openedTabName
)

CustomKeywords.'pageObject.guiValidation.closeAllTabsAndOpenFavorite'(
		favoriteTitle,
		openedTabName,
		favoriteImageKey,
		favoriteOpenTimeout
)

CustomKeywords.'component.CloseTabKeywords.verifyTabByName'(
		openedTabName,
		openedTabTimeout
)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
		targetEnvironment + '_GUI_FavoriteOpened.png'
)


// ======================================================
// DOWNLOAD FAVORITE VIEW AND VALIDATE
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Export PL Economique file\n' +
	'Export label: ' + exportLabel + '\n' +
	'Environment: ' + targetEnvironment
)

CustomKeywords.'commands.ExportFile.exportFromTwoExportImagesToNo'(
	exportLabel,
	targetEnvironment
)

	
CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Validate downloaded export\n' +
	'Environment: ' + targetEnvironment + '\n' +
	'Export label: ' + exportLabel + '\n' +
	'Validations:\n' +
	'- File exists in the folder used by ExportFile\n' +
	'- File is not empty\n' +
	'- Data row quantity is greater than zero'
	)
	
	Map exportValidation = CustomKeywords.'commands.ExportFileValidationKeywords.validateExportedFileExistsAndHasRows'(
			targetEnvironment,
			exportLabel
		)
	
CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Downloaded export validation passed\n' +
	'File: ' + exportValidation.fileName + '\n' +
	'Data rows: ' + exportValidation.dataRows + '\n' +
	'File size: ' + exportValidation.fileSize + ' bytes\n' +
	'Folder: ' + exportValidation.folderPath
)
	
	

// ======================================================
// DELETE FAVORITE
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Delete created favorite\n' +
	'Environment: ' + targetEnvironment + '\n' +
	'Favorite: ' + favoriteTitle + '\n' +
	'Favorite image key: ' + favoriteImageKey + '\n' +
	'Flow:\n' +
	'- Open Favorites tab\n' +
	'- Find favorite by element or image\n' +
	'- Open context menu with right click\n' +
	'- Select Supprimer le favori\n' +
	'- Confirm favorite is no longer displayed\n' +
	'- Close all opened tabs'
)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	targetEnvironment +
	'_GUI_FavoriteBeforeDelete.png'
)

CustomKeywords.'pageObject.guiValidation.deleteCreatedFavorite'(
	favoriteTitle,
	favoriteImageKey
)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	targetEnvironment +
	'_GUI_FavoriteAfterDelete.png'
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Favorite deletion completed successfully\n' +
	'Environment: ' + targetEnvironment + '\n' +
	'Favorite: ' + favoriteTitle + '\n' +
	'Result: favorite is no longer displayed and all tabs were closed'
)

// ======================================================
// CLOSE APPLICATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'Close application\n' +
		'Environment: ' + targetEnvironment
)

WebUI.callTestCase(
		findTestCase(closeApplicationTestCase),
		[:],
		FailureHandling.STOP_ON_FAILURE
)

KeywordUtil.markPassed(
		targetEnvironment +
		' favorite create, open, compare and delete flow completed successfully.'
)








