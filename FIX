	@Keyword
	boolean waitForMainScreen() {
		KeywordUtil.logInfo("Waiting for main screen using image and object fallback")

		String homeGreyImage = new File(
			RunConfiguration.getProjectDir(),
			'Images/General/HomeGrey.png'
		).getAbsolutePath()

		long end = System.currentTimeMillis() + 60000L
		int loginGoneRounds = 0

		while (System.currentTimeMillis() < end) {
			if (waitImagePresent(homeGreyImage, 2)) {
				KeywordUtil.logInfo("Main screen confirmed by HomeGrey image")
				return true
			}

			try {
				if (waitPresent(mainSearchObj(), 1) || waitPresent(homeTabObj(), 1)) {
					KeywordUtil.logInfo("Main screen confirmed by Windows object")
					return true
				}
			} catch (Throwable ignored) {
			}

			boolean loginStillVisible = false
			try {
				loginStillVisible = waitPresent(envComboObj(), 1) || waitPresent(connectBtnObj(), 1)
			} catch (Throwable ignored) {
			}

			if (!loginStillVisible) {
				loginGoneRounds++
				if (loginGoneRounds >= 5) {
					KeywordUtil.logInfo("Login popup disappeared repeatedly. Considering main screen loaded.")
					return true
				}
			} else {
				loginGoneRounds = 0
			}

			sleepMs(1000)
		}

		return false
	}

