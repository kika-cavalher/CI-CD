// =========================================================
// SUITE NAME RESOLUTION
// =========================================================

boolean isIgnorableFolderName(String folderName) {
	if (isBlank(folderName)) {
		return true
	}

	String name = folderName.trim()

	if (name.equalsIgnoreCase('Reports')) return true
	if (name.equalsIgnoreCase('logs')) return true
	if (name.equalsIgnoreCase('videos')) return true
	if (name.equalsIgnoreCase('cucumber_report')) return true
	if (name.equalsIgnoreCase('PreLoad')) return true
	if (name.equalsIgnoreCase(EVIDENCE_FOLDER_NAME)) return true
	if (isTimestampFolderName(name)) return true

	return false
}

String extractSuiteNameFromReportPath(String reportPath) {
	if (isBlank(reportPath)) {
		return ''
	}

	String normalized = reportPath.replace('\\', '/').trim()
	List<String> parts = normalized.split('/').findAll { !isBlank(it) }

	if (parts.isEmpty()) {
		return ''
	}

	int reportsIndex = parts.findIndexOf { it.equalsIgnoreCase('Reports') }

	/*
	 * Expected real path:
	 * .../Reports/<timestamp>/<Suite Name>/<timestamp>
	 *
	 * We want:
	 * <Suite Name>
	 */
	if (reportsIndex >= 0) {
		int firstAfterReports = reportsIndex + 1
		int secondAfterReports = reportsIndex + 2
		int thirdAfterReports = reportsIndex + 3

		if (firstAfterReports < parts.size()) {
			String p1 = parts[firstAfterReports]

			if (isTimestampFolderName(p1)) {
				if (secondAfterReports < parts.size()) {
					String p2 = parts[secondAfterReports]

					if (!isIgnorableFolderName(p2)) {
						return normalizeSuiteName(p2)
					}
				}
			} else {
				if (!isIgnorableFolderName(p1)) {
					return normalizeSuiteName(p1)
				}
			}
		}
	}

	// fallback walking backwards
	for (int i = parts.size() - 1; i >= 0; i--) {
		String part = parts[i]
		if (!isIgnorableFolderName(part)) {
			return normalizeSuiteName(part)
		}
	}

	return ''
}

String getCurrentSuiteName() {
	String reportPath = getResolvedReportPath()

	if (!isBlank(reportPath)) {
		String suiteName = extractSuiteNameFromReportPath(reportPath)
		if (!isBlank(suiteName)) {
			KeywordUtil.logInfo("Suite name detected from report path: ${suiteName}")
			return suiteName
		}
	}

	String lastRunPath = readLastRunPath()
	if (!isBlank(lastRunPath)) {
		String suiteName = extractSuiteNameFromReportPath(lastRunPath)
		if (!isBlank(suiteName)) {
			KeywordUtil.logInfo("Suite name detected from LastRun path: ${suiteName}")
			return suiteName
		}
	}

	return 'UnknownTestSuite'
}

String getSanitizedSuiteName() {
	return getCurrentSuiteName().replaceAll('[\\\\/:*?"<>|]', '_')
}

String getExecutionSummary() {
	return getCurrentSuiteName() + ' ' + nowExecution()
}

String getTestPlanName() {
	return getCurrentSuiteName() + TEST_PLAN_SUFFIX
}



// =========================================================
// SHORT ERROR SUMMARY
// =========================================================

String getShortErrorLog(String stackTrace) {
	if (isBlank(stackTrace)) {
		return ''
	}

	List<String> lines = stackTrace
		.readLines()
		.findAll { !isBlank(it) }
		.collect { it.trim() }

	if (lines.isEmpty()) {
		return ''
	}

	List<String> important = []

	for (String line : lines) {
		String lower = line.toLowerCase()

		if (
			lower.contains('exception')
			|| lower.contains('error')
			|| lower.contains('caused by')
			|| lower.contains('stepfailedexception')
			|| lower.contains('unable')
			|| lower.contains('not found')
			|| lower.contains('not clickable')
			|| lower.contains('timed out')
			|| lower.contains('assert')
		) {
			important.add(line)
		}

		if (important.size() == 3) {
			break
		}
	}

	if (important.isEmpty()) {
		important = lines.take(3)
	}

	return important.join('\n')
}



