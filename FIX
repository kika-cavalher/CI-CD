import java.util.Base64
import java.util.Date
import java.util.Locale

import javax.xml.parsers.DocumentBuilderFactory
import javax.xml.XMLConstants

import org.w3c.dom.Document
import org.w3c.dom.Element
import org.w3c.dom.Node
import org.w3c.dom.NodeList
import org.xml.sax.InputSource

class JiraReportBuilder {

    private static final String APP_NAME = 'EMATCH'
    private static final String LOGO_SRC = 'Images/General/logo.png'

    private static final SimpleDateFormat OUTPUT_DATE_TIME =
        new SimpleDateFormat('dd/MM/yyyy HH:mm:ss', Locale.ENGLISH)

    private static final SimpleDateFormat OUTPUT_CLOCK =
        new SimpleDateFormat('dd/MM/yyyy HH:mm:ss', Locale.ENGLISH)

    private static final SimpleDateFormat TRACE_DATE =
        new SimpleDateFormat('yyyy-MM-dd HH:mm:ss.SSS', Locale.ENGLISH)

    private static final List<String> DATE_PATTERNS = [
        "yyyy-MM-dd HH:mm:ss.SSS",
        "yyyy-MM-dd HH:mm:ss",
        "yyyy-MM-dd'T'HH:mm:ss.SSSXXX",
        "yyyy-MM-dd'T'HH:mm:ss.SSS",
        "yyyy-MM-dd'T'HH:mm:ss",
        'dd/MM/yyyy HH:mm:ss',
        'dd/MM/yyyy HH:mm:ss.SSS'
    ]

    File buildReport(String reportFolderPath) {
        return buildReport(new File(safe(reportFolderPath).isEmpty() ? '.' : reportFolderPath), '', '')
    }

    File buildReport(File reportFolder) {
        return buildReport(reportFolder, '', '')
    }

    File buildReport(String reportFolderPath, String suiteName, String executionTitle) {
        return buildReport(new File(safe(reportFolderPath).isEmpty() ? '.' : reportFolderPath), suiteName, executionTitle)
    }

    File buildReport(File reportFolder, String suiteName, String executionTitle) {
        File root = reportFolder ?: new File('.')
        if (!root.exists()) {
            throw new RuntimeException('Report folder does not exist: ' + root.absolutePath)
        }

        Map model = buildModel(root, suiteName, executionTitle)
        String html = new JiraHtmlTemplateBuilder().buildHtml(model)

        File target = new File(root, 'eMatchReport.html')
        target.write(html, 'UTF-8')
        return target
    }

    Map buildModel(File reportFolder, String suiteName, String executionTitle) {
        Map trace = readTrace(reportFolder)
        Map logSteps = readExecutionLogSteps(reportFolder)

        List<File> junitFiles = collectJUnitFiles(reportFolder)
        List<Map> scenarios = []

        junitFiles.each { File xmlFile ->
            scenarios.addAll(readScenariosFromJUnit(xmlFile, reportFolder, trace, logSteps))
        }

        if (scenarios.isEmpty()) {
            scenarios = buildFallbackScenario(reportFolder, suiteName)
        }

        String resolvedSuiteName = resolveSuiteName(reportFolder, suiteName, scenarios)
        String resolvedExecutionTitle = firstNonBlank(executionTitle, resolvedSuiteName)

        int passedCount = scenarios.count { Map row -> safe(row.status) == 'passed' }
        int failedCount = scenarios.count { Map row -> safe(row.status) == 'failed' }
        int blockedCount = scenarios.count { Map row -> safe(row.status) == 'blocked' }

        return [
            appName        : APP_NAME,
            reportTitle    : 'Test report - ' + resolvedExecutionTitle,
            suiteName      : resolvedSuiteName,
            executionTitle : resolvedExecutionTitle,
            generatedLabel : 'Generated ' + OUTPUT_DATE_TIME.format(new Date()),
            generatedAt    : OUTPUT_DATE_TIME.format(new Date()),
            reportFolder   : reportFolder.absolutePath,
            logoSrc        : LOGO_SRC,
            scenarios      : scenarios,
            passedCount    : passedCount,
            failedCount    : failedCount,
            blockedCount   : blockedCount,
            totalCount     : scenarios.size()
        ]
    }

    private List<Map> readScenariosFromJUnit(File xmlFile, File reportFolder, Map trace, Map logSteps) {
        Document document = parseXml(xmlFile)
        if (document == null) {
            return []
        }

        List<Map> scenarios = []
        List<Element> testCases = collectTestCaseElements(document)

        testCases.eachWithIndex { Element testCaseElement, int index ->
            String rawName = attr(testCaseElement, 'name')
            String className = attr(testCaseElement, 'classname')
            String scenarioName = buildScenarioName(className, rawName)
            String scenarioId = buildScenarioId(scenarioName, index + 1)

            Element failureElement = firstChildElement(testCaseElement, 'failure')
            Element errorElement = firstChildElement(testCaseElement, 'error')
            Element skippedElement = firstChildElement(testCaseElement, 'skipped')

            String status = 'passed'
            Element resultElement = null

            if (failureElement != null) {
                status = 'failed'
                resultElement = failureElement
            } else if (errorElement != null) {
                status = 'failed'
                resultElement = errorElement
            } else if (skippedElement != null) {
                status = 'blocked'
                resultElement = skippedElement
            }

            String fullError = firstNonBlank(
                textContent(resultElement),
                attr(resultElement, 'message')
            )

            String shortError = buildShortError(
                attr(resultElement, 'message'),
                fullError
            )

            Map traceForCase = traceForCase(trace, scenarioName)
            List<Map> traceSteps = stepsForCase(trace, scenarioName)
            List<Map> logStepList = stepsFromExecutionLogs(logSteps, scenarioName)
            List<Map> mergedSteps = mergeSteps(traceSteps, logStepList)

            long startMs = toLong(traceForCase.startMs)
            long endMs = toLong(traceForCase.endMs)
            long durationMs = toLong(traceForCase.durationMs)

            if (durationMs <= 0L) {
                durationMs = parseJUnitDuration(attr(testCaseElement, 'time'))
            }

            if (startMs <= 0L && endMs > 0L && durationMs > 0L) {
                startMs = Math.max(0L, endMs - durationMs)
            }

            if (endMs <= 0L && startMs > 0L && durationMs > 0L) {
                endMs = startMs + durationMs
            }

            if (startMs <= 0L && endMs <= 0L && durationMs > 0L) {
                endMs = System.currentTimeMillis()
                startMs = endMs - durationMs
            }

            List<Map> evidence = evidenceForCase(reportFolder, scenarioName)

            scenarios << [
                id            : scenarioId,
                name          : scenarioName,
                scenarioName  : scenarioName,
                status        : status,
                durationMs    : durationMs,
                durationLabel : formatDuration(durationMs),
                startMs       : startMs,
                endMs         : endMs,
                startLabel    : formatDateTime(startMs),
                endLabel      : formatDateTime(endMs),
                visualError   : shortError,
                errorSummary  : shortError,
                fullError     : fullError,
                reportFolder  : reportFolder.absolutePath,
                steps         : mergedSteps,
                evidence      : evidence
            ]
        }

        return scenarios
    }

    private List<Map> buildFallbackScenario(File reportFolder, String suiteName) {
        return [[
            id            : 'scenario-1',
            name          : firstNonBlank(suiteName, 'Execution'),
            scenarioName  : firstNonBlank(suiteName, 'Execution'),
            status        : 'blocked',
            durationMs    : 0L,
            durationLabel : formatDuration(0L),
            startMs       : 0L,
            endMs         : 0L,
            startLabel    : '--',
            endLabel      : '--',
            visualError   : '',
            errorSummary  : '',
            fullError     : '',
            reportFolder  : reportFolder.absolutePath,
            steps         : [],
            evidence      : []
        ]]
    }

    private Map readTrace(File reportFolder) {
        Map result = [
            startByCase   : [:],
            endByCase     : [:],
            durationByCase: [:],
            statusByCase  : [:],
            stepsByCase   : [:]
        ]

        File traceFile = new File(reportFolder, 'custom-report-trace.log')
        if (!traceFile.exists() || !traceFile.isFile()) {
            return result
        }

        traceFile.eachLine('UTF-8') { String line ->
            List<String> parts = safe(line).split('\t', 4).toList()
            if (parts.size() < 4) {
                return
            }

            String type = safe(parts[1])
            String caseId = decode64(parts[2])
            String value = decode64(parts[3])

            if (caseId.isEmpty()) {
                return
            }

            long lineMs = parseDateMillis(parts[0])

            if ('CASE_START' == type) {
                result.startByCase[caseId] = toLong(value) > 0L ? toLong(value) : lineMs
                return
            }

            if ('CASE_END' == type) {
                result.endByCase[caseId] = toLong(value) > 0L ? toLong(value) : lineMs
                return
            }

            if ('DURATION' == type) {
                result.durationByCase[caseId] = toLong(value)
                return
            }

            if ('STATUS' == type) {
                result.statusByCase[caseId] = safe(value)
                return
            }

            if ('REPORT_STEP' == type) {
                if (!result.stepsByCase.containsKey(caseId)) {
                    result.stepsByCase[caseId] = []
                }
                result.stepsByCase[caseId] << [
                    detail: safe(value),
                    timeMs: lineMs
                ]
                return
            }
        }

        return result
    }

    private Map readExecutionLogSteps(File reportFolder) {
        Map stepsByCase = [:]

        List<File> logFiles = []
        reportFolder.eachFileRecurse(FileType.FILES) { File file ->
            String lower = safe(file.name).toLowerCase(Locale.ENGLISH)
            if (lower.endsWith('.log')) {
                logFiles << file
            }
        }

        logFiles = logFiles.sort { File a, File b -> a.absolutePath <=> b.absolutePath }

        logFiles.each { File logFile ->
            String currentCase = ''

            logFile.eachLine('UTF-8') { String rawLine ->
                String line = safe(rawLine)
                if (line.isEmpty()) {
                    return
                }

                String started = extractCaseStart(line)
                if (!started.isEmpty()) {
                    currentCase = started
                    return
                }

                String ended = extractCaseEnd(line)
                if (!ended.isEmpty()) {
                    if (ended == currentCase) {
                        currentCase = ''
                    }
                    return
                }

                int markerIndex = line.indexOf('[REPORT_STEP]')
                if (markerIndex < 0 || currentCase.isEmpty()) {
                    return
                }

                String detail = safe(line.substring(markerIndex + '[REPORT_STEP]'.length()))
                if (detail.isEmpty()) {
                    return
                }

                if (!stepsByCase.containsKey(currentCase)) {
                    stepsByCase[currentCase] = []
                }

                stepsByCase[currentCase] << [
                    detail: detail,
                    timeMs: parseDateMillis(extractTimestamp(line))
                ]
            }
        }

        return stepsByCase
    }

    private String extractCaseStart(String line) {
        int index = line.indexOf('START Test Cases/')
        if (index >= 0) {
            return safe(line.substring(index + 'START '.length()))
        }

        int secondIndex = line.indexOf('Start Test Case :')
        if (secondIndex >= 0) {
            return safe(line.substring(secondIndex + 'Start Test Case :'.length()))
        }

        return ''
    }

    private String extractCaseEnd(String line) {
        int index = line.indexOf('END Test Cases/')
        if (index >= 0) {
            return safe(line.substring(index + 'END '.length()))
        }

        int secondIndex = line.indexOf('End Test Case :')
        if (secondIndex >= 0) {
            return safe(line.substring(secondIndex + 'End Test Case :'.length()))
        }

        return ''
    }

    private Map traceForCase(Map trace, String caseId) {
        return [
            startMs   : trace.startByCase[caseId],
            endMs     : trace.endByCase[caseId],
            durationMs: trace.durationByCase[caseId],
            status    : trace.statusByCase[caseId]
        ]
    }

    private List<Map> stepsForCase(Map trace, String caseId) {
        List<Map> rows = trace.stepsByCase[caseId] instanceof List ? (trace.stepsByCase[caseId] as List<Map>) : []
        return rows.collect { Map row ->
            [
                detail: safe(row.detail),
                timeMs: toLong(row.timeMs)
            ]
        }
    }

    private List<Map> stepsFromExecutionLogs(Map logSteps, String caseId) {
        List<Map> rows = logSteps[caseId] instanceof List ? (logSteps[caseId] as List<Map>) : []
        return rows.collect { Map row ->
            [
                detail: safe(row.detail),
                timeMs: toLong(row.timeMs)
            ]
        }
    }

    private List<Map> mergeSteps(List<Map> traceSteps, List<Map> logSteps) {
        Map<String, Map> merged = [:]

        (traceSteps + logSteps).each { Map row ->
            String detail = safe(row.detail)
            if (detail.isEmpty()) {
                return
            }

            String key = detail
            if (!merged.containsKey(key)) {
                merged[key] = [
                    detail: detail,
                    timeMs: toLong(row.timeMs)
                ]
            }
        }

        List<Map> result = merged.values().toList()
        result = result.sort { Map a, Map b ->
            toLong(a.timeMs) <=> toLong(b.timeMs)
        }

        return result
    }

    private List<Map> evidenceForCase(File reportFolder, String caseId) {
        List<File> images = []

        File evidencesRoot = new File(reportFolder, 'Evidences')
        if (!evidencesRoot.exists()) {
            return []
        }

        String expectedFolderName = JiraImagesEvidence.sanitizeCaseFolderName(caseId)
        File exactFolder = new File(evidencesRoot, expectedFolderName)

        if (exactFolder.exists() && exactFolder.isDirectory()) {
            exactFolder.eachFileRecurse(FileType.FILES) { File file ->
                if (isImage(file)) {
                    images << file
                }
            }
        }

        if (images.isEmpty()) {
            evidencesRoot.eachFileRecurse(FileType.FILES) { File file ->
                if (!isImage(file)) {
                    return
                }

                String pathKey = normalizeKey(file.parentFile?.name)
                if (pathKey == normalizeKey(expectedFolderName) || pathKey.contains(normalizeKey(expectedFolderName))) {
                    images << file
                }
            }
        }

        images = images.sort { File a, File b -> a.lastModified() <=> b.lastModified() }

        return images.collect { File file ->
            [
                name  : file.name,
                href  : file.toURI().toString(),
                imgSrc: file.toURI().toString(),
                image : true
            ]
        }
    }

    private boolean isImage(File file) {
        String lower = safe(file?.name).toLowerCase(Locale.ENGLISH)
        return lower.endsWith('.png') ||
            lower.endsWith('.jpg') ||
            lower.endsWith('.jpeg') ||
            lower.endsWith('.gif') ||
            lower.endsWith('.bmp') ||
            lower.endsWith('.webp')
    }

    private List<File> collectJUnitFiles(File reportFolder) {
        List<File> files = []

        reportFolder.eachFileRecurse(FileType.FILES) { File file ->
            String lower = safe(file.name).toLowerCase(Locale.ENGLISH)
            if (lower == 'junit_report.xml' || lower == 'junitreport.xml' || lower == 'junit.xml') {
                files << file
            }
        }

        return files.sort { File a, File b -> a.absolutePath <=> b.absolutePath }
    }

    private Document parseXml(File file) {
        try {
            DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance()
            factory.setNamespaceAware(false)
            factory.setXIncludeAware(false)
            factory.setExpandEntityReferences(false)
            factory.setFeature(XMLConstants.FEATURE_SECURE_PROCESSING, true)
            try {
                factory.setAttribute(XMLConstants.ACCESS_EXTERNAL_DTD, '')
                factory.setAttribute(XMLConstants.ACCESS_EXTERNAL_SCHEMA, '')
            } catch (Throwable ignored) {
            }

            return factory.newDocumentBuilder().parse(file)
        } catch (Throwable ignored) {
            return null
        }
    }

    private List<Element> collectTestCaseElements(Document document) {
        List<Element> result = []
        if (document == null) {
            return result
        }

        NodeList nodeList = document.getElementsByTagName('testcase')
        for (int i = 0; i < nodeList.length; i++) {
            Node node = nodeList.item(i)
            if (node instanceof Element) {
                result << (Element) node
            }
        }

        return result
    }

    private Element firstChildElement(Element parent, String tagName) {
        if (parent == null) {
            return null
        }

        NodeList nodeList = parent.getElementsByTagName(tagName)
        if (nodeList == null || nodeList.length == 0) {
            return null
        }

        for (int i = 0; i < nodeList.length; i++) {
            Node node = nodeList.item(i)
            if (node instanceof Element && node.parentNode == parent) {
                return (Element) node
            }
        }

        return null
    }

    private String attr(Element element, String name) {
        if (element == null) {
            return ''
        }
        return safe(element.getAttribute(name))
    }

    private String textContent(Element element) {
        if (element == null) {
            return ''
        }
        return safe(element.textContent)
    }

    private String buildScenarioName(String className, String rawName) {
        String cleanClass = safe(className)
        String cleanName = safe(rawName)

        if (!cleanClass.isEmpty()) {
            if (cleanClass == cleanName) {
                return cleanClass
            }

            if (cleanClass.endsWith('/' + cleanName)) {
                return cleanClass
            }

            if (!cleanName.isEmpty()) {
                return cleanClass + '/' + cleanName
            }

            return cleanClass
        }

        return cleanName
    }

    private String resolveSuiteName(File reportFolder, String suiteName, List<Map> scenarios) {
        if (!safe(suiteName).isEmpty()) {
            return safe(suiteName)
        }

        String parent = safe(reportFolder.parentFile?.name)
        if (!parent.isEmpty() && !parent.matches('\\d{8}_\\d{6}')) {
            return parent
        }

        if (scenarios != null && !scenarios.isEmpty()) {
            return safe(scenarios[0].name)
        }

        return 'Execution'
    }

    private String buildScenarioId(String value, int index) {
        String text = safe(value)
            .replace('\\', '-')
            .replace('/', '-')
            .replaceAll('[^A-Za-z0-9._-]+', '-')
            .replaceAll('-+', '-')
            .replaceAll('^-+', '')
            .replaceAll('-+\$', '')

        return text.isEmpty() ? 'scenario-' + index : text
    }

    private String buildShortError(String message, String fullError) {
        String candidate = firstNonBlank(message, fullError)
        if (candidate.isEmpty()) {
            return ''
        }

        List<String> lines = candidate
            .replace('\r', '\n')
            .split('\n')
            .collect { String row -> safe(row) }
            .findAll { String row -> !row.isEmpty() }

        if (lines.isEmpty()) {
            return ''
        }

        return lines[0]
    }

    private long parseJUnitDuration(String secondsValue) {
        String value = safe(secondsValue)
        if (value.isEmpty()) {
            return 0L
        }

        try {
            BigDecimal seconds = new BigDecimal(value.replace(',', '.'))
            return seconds.multiply(new BigDecimal('1000')).longValue()
        } catch (Throwable ignored) {
            return 0L
        }
    }

    private String extractTimestamp(String line) {
        String text = safe(line)
        if (text.isEmpty()) {
            return ''
        }

        List<String> patterns = [
            '\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d{3}',
            '\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}',
            '\\d{2}/\\d{2}/\\d{4} \\d{2}:\\d{2}:\\d{2}'
        ]

        for (String pattern : patterns) {
            def matcher = text =~ pattern
            if (matcher.find()) {
                return safe(matcher.group(0))
            }
        }

        return ''
    }

    private long parseDateMillis(String raw) {
        String value = safe(raw)
        if (value.isEmpty()) {
            return 0L
        }

        for (String pattern : DATE_PATTERNS) {
            try {
                return new SimpleDateFormat(pattern, Locale.ENGLISH).parse(value).time
            } catch (Throwable ignored) {
            }
        }

        return 0L
    }

    private String formatDateTime(long millis) {
        if (millis <= 0L) {
            return '--'
        }
        return OUTPUT_CLOCK.format(new Date(millis))
    }

    private String formatDuration(long durationMs) {
        long totalSeconds = Math.max(0L, Math.round(durationMs / 1000d))
        long hours = (long) (totalSeconds / 3600L)
        long minutes = (long) ((totalSeconds % 3600L) / 60L)
        long seconds = (long) (totalSeconds % 60L)

        return String.format(Locale.ENGLISH, '%02dh %02dm %02ds', hours, minutes, seconds)
    }

    private String normalizeKey(String value) {
        return safe(value)
            .toLowerCase(Locale.ENGLISH)
            .replaceAll('[^a-z0-9]+', '')
    }

    private long toLong(Object value) {
        try {
            return Long.parseLong(String.valueOf(value))
        } catch (Throwable ignored) {
            return 0L
        }
    }

    private String decode64(String value) {
        if (safe(value).isEmpty()) {
            return ''
        }

        try {
            return new String(Base64.decoder.decode(value), StandardCharsets.UTF_8)
        } catch (Throwable ignored) {
            return ''
        }
    }

    private String firstNonBlank(Object... values) {
        if (values == null) {
            return ''
        }

        for (Object value : values) {
            String text = safe(value)
            if (!text.isEmpty()) {
                return text
            }
        }

        return ''
    }

    private String safe(Object value) {
        return value == null ? '' : String.valueOf(value).trim()
    }
}












package jiraIntegration

import java.io.File
import java.net.URI
import java.util.Locale

class JiraHtmlTemplateBuilder {

    private static final String APP_NAME = 'EMATCH'
    private static final String STATUS_PASS = '#68b84b'
    private static final String STATUS_FAIL = '#e05b4d'
    private static final String STATUS_BLOCKED = '#d7b436'
    private static final String STATUS_INFO = '#6930ff'

    String buildHtml(Map model) {
        Map view = normalizeModel(model)

        StringBuilder html = new StringBuilder()
        html.append('<!DOCTYPE html>\n')
        html.append('<html lang="en">\n')
        html.append('<head>\n')
        html.append('<meta charset="UTF-8">\n')
        html.append('<meta name="viewport" content="width=device-width, initial-scale=1.0">\n')
        html.append('<title>').append(htmlEscape(view.reportTitle)).append('</title>\n')
        html.append(buildStyles())
        html.append('</head>\n')
        html.append('<body>\n')

        html.append('<header class="top-banner">')
        html.append('<div class="top-left">')
        html.append('<img class="brand-logo" src="').append(htmlEscape(resolveLogoHref(view))).append('" alt="EMATCH logo">')
        html.append('<div class="brand-copy">')
        html.append('<div class="banner-title">').append(htmlEscape(view.reportTitle)).append('</div>')
        html.append('<div class="banner-subtitle">EMATCH execution overview</div>')
        html.append('</div>')
        html.append('</div>')
        html.append('<div class="top-right">')
        html.append('<div>').append(htmlEscape(view.generatedLabel)).append('</div>')
        html.append('<div>Project ').append(htmlEscape(APP_NAME)).append('</div>')
        html.append('</div>')
        html.append('</header>')

        html.append('<div class="page">')

        html.append('<aside class="sidebar">')
        html.append('<div class="sidebar-tabs">')
        html.append('<button id="tab-tests" class="sidebar-tab active" type="button" onclick="showTab(\'tests\')">Tests</button>')
        html.append('<button id="tab-charts" class="sidebar-tab" type="button" onclick="showTab(\'charts\')">Charts</button>')
        html.append('</div>')

        html.append('<div id="tests-sidebar">')
        html.append('<div class="search-wrap">')
        html.append('<input id="scenarioSearch" class="search-input" type="text" placeholder="Search test name, path, or status." onkeyup="filterScenarios()">')
        html.append('</div>')
        html.append('<div id="scenarioList" class="scenario-list">')

        if (view.scenarios.isEmpty()) {
            html.append('<div class="empty-sidebar">No scenarios found.</div>')
        } else {
            view.scenarios.eachWithIndex { Map scenario, int index ->
                html.append(buildScenarioListItem(scenario, index == 0))
            }
        }

        html.append('</div>')
        html.append('</div>')

        html.append('<div id="charts-sidebar" class="hidden">')
        html.append(buildChartsSidebar(view))
        html.append('</div>')
        html.append('</aside>')

        html.append('<main class="content">')

        if (view.scenarios.isEmpty()) {
            html.append('<section class="scenario-panel active"><div class="scenario-title">No execution data found.</div></section>')
        } else {
            view.scenarios.eachWithIndex { Map scenario, int index ->
                html.append(buildScenarioPanel(scenario, view, index == 0))
            }
        }

        html.append(buildChartsPanel(view))
        html.append('</main>')
        html.append('</div>')
        html.append(buildScripts())
        html.append('</body>\n')
        html.append('</html>\n')

        return html.toString()
    }

    private Map normalizeModel(Map model) {
        Map safeModel = model ?: [:]
        List<Map> scenarios = []

        asList(safeModel.scenarios).eachWithIndex { def raw, int index ->
            Map row = raw instanceof Map ? (raw as Map) : [:]

            String status = normalizeStatus(pickFirst(row.status, 'blocked'))
            List<Map> steps = normalizeSteps(row.steps)
            List<Map> evidence = normalizeEvidence(row.evidence)

            scenarios << [
                id           : pickFirst(row.id, 'scenario-' + (index + 1)),
                name         : pickFirst(row.name, row.scenarioName, 'Scenario ' + (index + 1)),
                status       : status,
                durationLabel: pickFirst(row.durationLabel, '00h 00m 00s'),
                startLabel   : pickFirst(row.startLabel, '--'),
                endLabel     : pickFirst(row.endLabel, '--'),
                visualError  : pickFirst(row.visualError, row.errorSummary, ''),
                fullError    : pickFirst(row.fullError, ''),
                steps        : steps,
                evidence     : evidence
            ]
        }

        return [
            reportTitle   : pickFirst(safeModel.reportTitle, safeModel.executionTitle, safeModel.suiteName, 'Execution'),
            generatedLabel: pickFirst(safeModel.generatedLabel, ''),
            suiteName     : pickFirst(safeModel.suiteName, 'Execution'),
            reportFolder  : pickFirst(safeModel.reportFolder, ''),
            logoSrc       : pickFirst(safeModel.logoSrc, ''),
            scenarios     : scenarios,
            passedCount   : asInt(safeModel.passedCount),
            failedCount   : asInt(safeModel.failedCount),
            blockedCount  : asInt(safeModel.blockedCount),
            totalCount    : asInt(safeModel.totalCount)
        ]
    }

    private List<Map> normalizeSteps(def rawSteps) {
        List<Map> result = []
        asList(rawSteps).each { def raw ->
            Map row = raw instanceof Map ? (raw as Map) : [detail: safeValue(raw)]
            String detail = pickFirst(row.detail, row.message, row.text)
            if (!detail.isEmpty()) {
                result << [detail: detail]
            }
        }
        return result
    }

    private List<Map> normalizeEvidence(def rawEvidence) {
        List<Map> result = []
        asList(rawEvidence).each { def raw ->
            Map row = raw instanceof Map ? (raw as Map) : [:]
            String href = pickFirst(row.href, row.imgSrc, '')
            String name = pickFirst(row.name, new File(href).name, 'Evidence')
            result << [
                name  : name,
                href  : href,
                imgSrc: pickFirst(row.imgSrc, href),
                image : Boolean.TRUE.equals(row.image) || isImageFile(href)
            ]
        }
        return result.findAll { Map row -> !safeValue(row.href).isEmpty() || !safeValue(row.imgSrc).isEmpty() }
    }

    private String buildScenarioListItem(Map scenario, boolean selected) {
        StringBuilder sb = new StringBuilder()
        sb.append('<button type="button" class="scenario-list-item')
        if (selected) {
            sb.append(' selected')
        }
        sb.append('" data-sid="').append(htmlEscape(scenario.id)).append('" onclick="showScenario(\'').append(jsEscape(scenario.id)).append('\')">')

        sb.append('<div class="scenario-list-title">').append(htmlEscape(scenario.name)).append('</div>')
        sb.append('<div class="scenario-list-foot">')
        sb.append('<span class="status-pill ').append(htmlEscape(scenario.status)).append('">').append(htmlEscape(statusLabel(scenario.status))).append('</span>')
        sb.append('<span class="scenario-duration">').append(htmlEscape(scenario.durationLabel)).append('</span>')
        sb.append('</div>')
        sb.append('</button>')

        return sb.toString()
    }

    private String buildScenarioPanel(Map scenario, Map view, boolean selected) {
        boolean failed = safeValue(scenario.status) == 'failed'

        StringBuilder sb = new StringBuilder()
        sb.append('<section class="scenario-panel')
        if (selected) {
            sb.append(' active')
        }
        sb.append('" id="panel-').append(htmlEscape(scenario.id)).append('">')

        sb.append('<div class="scenario-title">').append(htmlEscape(scenario.name)).append('</div>')

        sb.append('<div class="scenario-meta-row">')
        sb.append(buildMetaChip('Suite', view.suiteName, 'plain'))
        sb.append(buildMetaChip('Status', statusLabel(scenario.status), scenario.status))
        sb.append(buildMetaChip('Start', pickFirst(scenario.startLabel, '--'), 'purple'))
        sb.append(buildMetaChip('End', pickFirst(scenario.endLabel, '--'), 'purple'))
        sb.append(buildMetaChip('Duration', pickFirst(scenario.durationLabel, '00h 00m 00s'), 'purple'))
        sb.append('</div>')

        sb.append('<div class="section-title">Steps</div>')
        sb.append('<div class="steps-box">')

        List<Map> steps = scenario.steps instanceof List ? (scenario.steps as List<Map>) : []
        if (steps.isEmpty()) {
            sb.append('<div class="empty-inline">No step details available.</div>')
        } else {
            sb.append('<div class="steps-list">')
            steps.each { Map row ->
                sb.append('<div class="step-line">')
                sb.append('<span class="step-bullet">•</span>')
                sb.append('<div class="step-text">').append(htmlEscape(pickFirst(row.detail, ''))).append('</div>')
                sb.append('</div>')
            }
            sb.append('</div>')
        }
        sb.append('</div>')

        if (failed) {
            sb.append('<div class="error-block">')
            sb.append('<div class="error-title">Visual Error Log</div>')
            if (!safeValue(scenario.visualError).isEmpty()) {
                sb.append('<div class="error-summary">').append(htmlEscape(scenario.visualError)).append('</div>')
            }
            if (!safeValue(scenario.fullError).isEmpty()) {
                sb.append('<details class="details-box">')
                sb.append('<summary>🔎 View full error</summary>')
                sb.append('<pre>').append(htmlEscape(scenario.fullError)).append('</pre>')
                sb.append('</details>')
            }
            sb.append('</div>')

            sb.append('<div class="evidence-block">')
            sb.append('<div class="evidence-title">Evidence</div>')

            List<Map> evidence = scenario.evidence instanceof List ? (scenario.evidence as List<Map>) : []
            if (evidence.isEmpty()) {
                sb.append('<div class="empty-inline">No evidence was found for this scenario.</div>')
            } else {
                evidence.each { Map ev ->
                    sb.append('<div class="evidence-item">')
                    sb.append('<div class="evidence-name">').append(htmlEscape(ev.name)).append('</div>')
                    if (!safeValue(ev.href).isEmpty()) {
                        sb.append('<div class="evidence-link"><a href="').append(htmlEscape(ev.href)).append('" target="_blank" rel="noopener noreferrer">🔎 Open evidence</a></div>')
                    }
                    if (Boolean.TRUE.equals(ev.image) && !safeValue(ev.imgSrc).isEmpty()) {
                        sb.append('<img class="evidence-image" src="').append(htmlEscape(ev.imgSrc)).append('" alt="Evidence">')
                    }
                    sb.append('</div>')
                }
            }

            sb.append('</div>')
        }

        sb.append('</section>')
        return sb.toString()
    }

    private String buildChartsSidebar(Map view) {
        StringBuilder sb = new StringBuilder()
        sb.append('<div class="chart-side-wrap">')
        sb.append('<div class="chart-side-title">Execution Status</div>')
        sb.append('<div class="legend-list">')
        sb.append(buildLegendLine('Passed', STATUS_PASS, view.passedCount))
        sb.append(buildLegendLine('Failed', STATUS_FAIL, view.failedCount))
        sb.append(buildLegendLine('Blocked', STATUS_BLOCKED, view.blockedCount))
        sb.append('</div>')
        sb.append('</div>')
        return sb.toString()
    }

    private String buildChartsPanel(Map view) {
        double failedPercent = percent(view.failedCount, view.totalCount)
        double passedPercent = percent(view.passedCount, view.totalCount)
        double blockedPercent = percent(view.blockedCount, view.totalCount)

        String donutStyle = 'background: conic-gradient(' +
            STATUS_FAIL + ' 0 ' + fmt(failedPercent) + '%,' +
            STATUS_PASS + ' ' + fmt(failedPercent) + '% ' + fmt(failedPercent + passedPercent) + '%,' +
            STATUS_BLOCKED + ' ' + fmt(failedPercent + passedPercent) + '% 100%);'

        StringBuilder sb = new StringBuilder()
        sb.append('<section id="charts-panel" class="charts-panel hidden">')
        sb.append('<div class="chart-main-title">Global Overview</div>')
        sb.append('<div class="charts-layout">')

        sb.append('<div class="donut-card">')
        sb.append('<div class="donut" style="').append(donutStyle).append('">')
        sb.append('<div class="donut-center">')
        sb.append('<div class="donut-number">').append(String.valueOf(view.totalCount)).append('</div>')
        sb.append('<div class="donut-label">Tests</div>')
        sb.append('</div>')
        sb.append('</div>')
        sb.append('</div>')

        sb.append('<div class="chart-bars">')
        sb.append(buildBarRow('Passed', view.passedCount, view.totalCount, STATUS_PASS))
        sb.append(buildBarRow('Failed', view.failedCount, view.totalCount, STATUS_FAIL))
        sb.append(buildBarRow('Blocked', view.blockedCount, view.totalCount, STATUS_BLOCKED))
        sb.append('</div>')

        sb.append('</div>')
        sb.append('</section>')
        return sb.toString()
    }

    private String buildBarRow(String label, int value, int total, String color) {
        double width = percent(value, total)

        StringBuilder sb = new StringBuilder()
        sb.append('<div class="bar-row">')
        sb.append('<div class="bar-row-top">')
        sb.append('<span class="bar-label">').append(htmlEscape(label)).append('</span>')
        sb.append('<span class="bar-value">').append(String.valueOf(value)).append('</span>')
        sb.append('</div>')
        sb.append('<div class="bar-track"><div class="bar-fill" style="width:')
            .append(fmt(width)).append('%; background:').append(color).append('"></div></div>')
        sb.append('<div class="bar-foot">').append(String.valueOf(total == 0 ? 0 : Math.round(width))).append('% of execution</div>')
        sb.append('</div>')
        return sb.toString()
    }

    private String buildLegendLine(String label, String color, int value) {
        StringBuilder sb = new StringBuilder()
        sb.append('<div class="legend-line">')
        sb.append('<span class="legend-dot" style="background:').append(color).append('"></span>')
        sb.append('<span class="legend-text">').append(htmlEscape(label)).append('</span>')
        sb.append('<span class="legend-value">').append(String.valueOf(value)).append('</span>')
        sb.append('</div>')
        return sb.toString()
    }

    private String buildMetaChip(String label, String value, String type) {
        return '<div class="meta-chip ' + htmlEscape(type) + '">' +
            '<span class="meta-label">' + htmlEscape(label) + ':</span> ' +
            '<span class="meta-value">' + htmlEscape(value) + '</span>' +
            '</div>'
    }

    private String resolveLogoHref(Map view) {
        String raw = pickFirst(view.logoSrc, '')
        if (raw.isEmpty()) {
            return ''
        }

        File direct = new File(raw)
        if (direct.exists()) {
            return direct.toURI().toString()
        }

        String baseFolder = pickFirst(view.reportFolder, '')
        if (!baseFolder.isEmpty()) {
            File byProject = new File(baseFolder, raw)
            if (byProject.exists()) {
                return byProject.toURI().toString()
            }

            File projectRoot = new File(baseFolder).parentFile?.parentFile?.parentFile
            if (projectRoot != null) {
                File byRoot = new File(projectRoot, raw)
                if (byRoot.exists()) {
                    return byRoot.toURI().toString()
                }
            }
        }

        try {
            if (raw.startsWith('file:/')) {
                return new File(new URI(raw)).toURI().toString()
            }
        } catch (Throwable ignored) {
        }

        return raw
    }

    private String normalizeStatus(String raw) {
        String value = safeValue(raw).toLowerCase(Locale.ENGLISH)
        if (value == 'passed' || value == 'pass' || value == 'success') {
            return 'passed'
        }
        if (value == 'failed' || value == 'fail' || value == 'error') {
            return 'failed'
        }
        if (value == 'blocked' || value == 'skipped' || value == 'skip' || value == 'not_run') {
            return 'blocked'
        }
        return 'blocked'
    }

    private String statusLabel(String status) {
        String value = safeValue(status)
        if (value == 'passed') {
            return 'Passed'
        }
        if (value == 'failed') {
            return 'Failed'
        }
        if (value == 'blocked') {
            return 'Blocked'
        }
        return 'Blocked'
    }

    private List asList(def value) {
        if (value == null) {
            return []
        }
        if (value instanceof Collection) {
            return new ArrayList(value as Collection)
        }
        if (value.getClass().isArray()) {
            return (value as Object[]).toList()
        }
        return [value]
    }

    private int asInt(def value) {
        try {
            return Integer.parseInt(String.valueOf(value))
        } catch (Throwable ignored) {
            return 0
        }
    }

    private double percent(int value, int total) {
        if (total <= 0) {
            return 0d
        }
        return ((double) value / (double) total) * 100d
    }

    private String fmt(double value) {
        return String.format(Locale.ENGLISH, '%.2f', value)
    }

    private boolean isImageFile(String fileName) {
        String lower = safeValue(fileName).toLowerCase(Locale.ENGLISH)
        return lower.endsWith('.png') ||
            lower.endsWith('.jpg') ||
            lower.endsWith('.jpeg') ||
            lower.endsWith('.gif') ||
            lower.endsWith('.bmp') ||
            lower.endsWith('.webp')
    }

    private String pickFirst(Object... values) {
        if (values == null) {
            return ''
        }

        for (Object value : values) {
            String text = safeValue(value)
            if (!text.isEmpty()) {
                return text
            }
        }

        return ''
    }

    private String safeValue(def value) {
        return value == null ? '' : String.valueOf(value).trim()
    }

    private String htmlEscape(def value) {
        String text = safeValue(value)
        return text
            .replace('&', '&amp;')
            .replace('<', '&lt;')
            .replace('>', '&gt;')
            .replace('"', '&quot;')
            .replace("'", '&#39;')
    }

    private String jsEscape(def value) {
        String text = safeValue(value)
        return text
            .replace('\\', '\\\\')
            .replace("'", "\\'")
            .replace('\r', '')
            .replace('\n', '\\n')
    }

    private String buildStyles() {
        return '''
<style>
* {
    box-sizing: border-box;
}
body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    color: #15212b;
    background: #ffffff;
}
.top-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 12px 18px;
    background: #4b1fb8;
    color: #ffffff;
