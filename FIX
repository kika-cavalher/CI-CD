		if (!opened) {
			KeywordUtil.markFailedAndStop(
				'Expected tab was not opened.\n' +
				'Tab: ' + safeText(openedTabName) + '\n' +
				'Timeout: ' + safeTimeout + ' seconds.'
			)
		}

		KeywordUtil.markPassed(
			'Opened tab validated: ' + openedTabName
		)
	}


