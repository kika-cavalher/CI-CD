
def SUITE = [
    NODE_LABEL               : 'GI5_SWDCFRNXGI55817',
    CUSTOM_WORKSPACE_PATH    : 'D:/Jenkins/work/workspace/GI5/eMatch_Regression/Archive Mode',

    STARTERS_DIR             : 'D:/Projects/eMatchStarters',
    TASK_NAME                : '\\eMatch Automation\\RunEMatchDesktop',

    WINAPPDRIVER_EXE         : 'C:/Program Files (x86)/Windows Application Driver/WinAppDriver.exe',
    AUTO_START_WINAPPDRIVER  : true,

    KATALON_EXE              : 'C:/Users/adgi5appjenkins/Documents/Katalon_Studio_Engine_Windows_64-8.1.0/katalonc.exe',
    PROJECT_FILE             : 'eMatch POC.prj',

    SUITE_NAME               : 'Archive Mode Collection',
    SUITE_TYPE               : 'COLLECTION',
    SUITE_PATH               : 'Test Suites/Archive Mode/Archive Mode Collection',

    EXECUTION_PROFILE        : 'default',
    BROWSER_TYPE             : 'Windows',
    RETRY                    : 0,
    TIMEOUT_MINUTES          : 180,

    NEXT_JOB_NAME            : '',
    WAIT_FOR_NEXT_JOB        : false,
    PROPAGATE_NEXT_JOB_FAIL  : false
]

pipeline {
    agent {
        node {
            label "${SUITE.NODE_LABEL}"
            customWorkspace "${SUITE.CUSTOM_WORKSPACE_PATH}"
        }
    }

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        timeout(time: ((SUITE.TIMEOUT_MINUTES as int) + 30), unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "Workspace: ${pwd()}"
            }
        }

        stage('Run Desktop Suite') {
            steps {
                script {
                    def desktopRunner = load('jenkinsIntegration/JenkinsDesktopPipelineRunner.groovy')

                    String workspaceDir = pwd().replace('/', '\\')
                    String projectPath  = "${workspaceDir}\\${SUITE.PROJECT_FILE}"

                    echo '=================================================='
                    echo '[START ASSET]'
                    echo "Name    : ${SUITE.SUITE_NAME}"
                    echo "Type    : ${SUITE.SUITE_TYPE}"
                    echo "Path    : ${SUITE.SUITE_PATH}"
                    echo "Timeout : ${SUITE.TIMEOUT_MINUTES} min"
                    echo '=================================================='

                    desktopRunner.runDesktopAsset(
                        workspaceDir          : workspaceDir,
                        projectPath           : projectPath,
                        katalonExe            : SUITE.KATALON_EXE,
                        starterDir            : SUITE.STARTERS_DIR,
                        taskName              : SUITE.TASK_NAME,
                        executionProfile      : SUITE.EXECUTION_PROFILE,
                        browserType           : SUITE.BROWSER_TYPE,
                        assetType             : SUITE.SUITE_TYPE,
                        assetPath             : SUITE.SUITE_PATH,
                        winAppDriverExe       : SUITE.WINAPPDRIVER_EXE,
                        autoStartWinAppDriver : SUITE.AUTO_START_WINAPPDRIVER,
                        retry                 : SUITE.RETRY,
                        timeoutMinutes        : SUITE.TIMEOUT_MINUTES as int
                    )
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts allowEmptyArchive: true, artifacts: 'Reports/**/*'
            junit allowEmptyResults: true, testResults: 'Reports/**/JUnit_Report.xml'
        }

        cleanup {
            script {
                String nextJob = (SUITE.NEXT_JOB_NAME ?: '').toString().trim()

                if (nextJob && ((currentBuild.currentResult ?: 'SUCCESS') == 'SUCCESS')) {
                    echo '=================================================='
                    echo "Triggering next job: ${nextJob}"
                    echo '=================================================='

                    build job: nextJob,
                        wait: SUITE.WAIT_FOR_NEXT_JOB as boolean,
                        propagate: SUITE.PROPAGATE_NEXT_JOB_FAIL as boolean
                }
            }
        }
    }
}
