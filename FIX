import internal.GlobalVariable


// ======================================================
// MODULE CONFIG
// ======================================================

String targetEnvironment = 'REC'
String comparisonEnvironment = 'PRD'

String menuName = 'synthèse Justification Latent'
String menuResultName = 'synthèse Justification Latent'

String sectionFilterValue = '2LL'

String exportLabel = 'Synthese_Justification_Latent'

String targetLoginTestCase =
	'Component/Authentication/Login ' +
	targetEnvironment

String comparisonLoginTestCase =
	'Component/Authentication/Login ' +
	comparisonEnvironment

String closeApplicationTestCase =
	'Component/Authentication/Close Application'


// ======================================================
// RECHERCHE CONFIG
// ======================================================

String rechercheImageGroup = 'General'

String rechercheObjectGroup =
	'syntheseJustificationLatent'

String rechercheTabImageKey =
	'rechercheTab'

String rechercheTabObjectKey =
	'rechercheTab'

String rechercheInputObjectKey =
	'dateFilterInput'

String rechercheButtonObjectKey =
	'rechercherButton'


// ======================================================
// TIMEOUT CONFIG
// ======================================================

Integer menuTimeout = 20
Integer screenLoadTimeout = 90
Integer filterTimeout = 60
Integer rechercheTimeout = 60


// ======================================================
// RESOLVE CLOSING DATE
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Resolve closing date used in REC and PRD\n' +
	'Current value: ' +
		GlobalVariable.arreteDate
)

if (GlobalVariable.arreteDate == null ||
	GlobalVariable.arreteDate
		.toString()
		.trim()
		.isEmpty()) {

	GlobalVariable.arreteDate =
		CustomKeywords.
		'general.MenuHandling.getArreteDateWithSlash'()
}

String closingDate =
	GlobalVariable.arreteDate
		.toString()
		.replace('/', '')

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Closing date resolved successfully\n' +
	'Value used in Recherche: ' +
		closingDate
)


// ======================================================
// AUTHENTICATION - REC
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Authenticate and open application\n' +
	'Environment: ' +
	targetEnvironment
)

WebUI.callTestCase(
	findTestCase(targetLoginTestCase),
	[:],
	FailureHandling.STOP_ON_FAILURE
)


// ======================================================
// OPEN SYNTHÈSE - REC
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Open Synthèse Justification Latent screen\n' +
	'Environment: ' +
	targetEnvironment +
	'\nSearch: ' +
	menuName +
	'\nResult: ' +
	menuResultName
)

CustomKeywords.'component.MenuNavigator.searchAndOpenMenuByText'(
	menuName,
	menuResultName,
	menuTimeout
)


// ======================================================
// VALIDATE SYNTHÈSE TAB - REC
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Validate Synthèse Justification Latent tab\n' +
	'Environment: ' +
	targetEnvironment
)

CustomKeywords.
'pageObject.JustificationDesComptesDeLatentKeywords.validateSyntheseTabOpened'(
	screenLoadTimeout
)


// ======================================================
// APPLY SECTION FILTER - REC
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Apply Synthèse Section filter\n' +
	'Environment: ' +
	targetEnvironment +
	'\nValue: ' +
	sectionFilterValue
)

CustomKeywords.
'pageObject.JustificationDesComptesDeLatentKeywords.applySyntheseSectionFilter'(
	sectionFilterValue,
	filterTimeout
)


// ======================================================
// APPLY RECHERCHE FILTER - REC
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Open Recherche tab and apply date filter\n' +
	'Environment: ' +
	targetEnvironment +
	'\nClosing date: ' +
	closingDate
)

Map recRechercheResult =
	CustomKeywords.
	'component.RechercheKeywords.applyRechercheTextFilter'(
		rechercheImageGroup,
		rechercheObjectGroup,
		rechercheTabImageKey,
		rechercheTabObjectKey,
		rechercheInputObjectKey,
		rechercheButtonObjectKey,
		closingDate,
		rechercheTimeout
	)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'REC Recherche filter applied successfully\n' +
	'Value: ' +
	recRechercheResult.value
)


// ======================================================
// EXPORT SYNTHÈSE - REC
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Export Synthèse file\n' +
	'Environment: ' +
	targetEnvironment +
	'\nExport label: ' +
	exportLabel
)

CustomKeywords.'commands.ExportFile.exportFromTwoExportImagesToNo'(
	exportLabel,
	targetEnvironment
)

Map recExportValidation =
	CustomKeywords.
	'commands.ExportFileValidationKeywords.validateExportedFileExistsAndHasRows'(
		targetEnvironment,
		exportLabel
	)

String recExportPath =
	new File(
		recExportValidation.folderPath.toString(),
		recExportValidation.fileName.toString()
	).absolutePath

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'REC Synthèse export validation passed\n' +
	'File: ' +
	recExportValidation.fileName +
	'\nData rows: ' +
	recExportValidation.dataRows +
	'\nFile size: ' +
	recExportValidation.fileSize +
	' bytes'
)


