    private static Map<String, String> findMatchingWindow(String expectedTitle) {
        String normalized = normalizeTitle(expectedTitle)
        String version = extractVersionFromTitle(normalized)

        String script = """
\$ErrorActionPreference = 'SilentlyContinue'
\$expected = '${ps(normalized)}'
\$version  = '${ps(version)}'

\$proc = Get-Process -ErrorAction SilentlyContinue |
    Where-Object {
        \$_.MainWindowHandle -ne 0 -and
        \$_.MainWindowTitle -and
        (
            \$_.MainWindowTitle -eq \$expected -or
            \$_.MainWindowTitle -eq "eMatch \$version" -or
            \$_.MainWindowTitle -like "*\$version*" -or
            \$_.MainWindowTitle -like "eMatch*"
        )
    } |
    Sort-Object StartTime -Descending |
    Select-Object -First 1

if (\$proc) {
    Write-Output (\$proc.MainWindowTitle + "|" + \$proc.MainWindowHandle + "|" + \$proc.ProcessName)
}
"""

        String out = safe(runPowerShell(script, 15))
        if (!out) {
            return [title: '', handle: '', process: '']
        }

        String[] parts = out.split("\\|", 3)
        return [
            title  : parts.length > 0 ? safe(parts[0]) : '',
            handle : parts.length > 1 ? safe(parts[1]) : '',
            process: parts.length > 2 ? safe(parts[2]) : ''
        ]
    }

    private static Map<String, String> waitForWindow(String expectedTitle, int timeoutSeconds) {
        long end = System.currentTimeMillis() + (timeoutSeconds * 1000L)

        while (System.currentTimeMillis() < end) {
            Map<String, String> found = findMatchingWindow(expectedTitle)
            if (safe(found.title)) {
                return found
            }
            sleepMs(1000)
        }

        return [title: '', handle: '', process: '']
    }

    private static String getInstalledExePathFromRunningWindow(String expectedTitle) {
        String normalized = normalizeTitle(expectedTitle)
        String version = extractVersionFromTitle(normalized)

        String script = """
\$ErrorActionPreference = 'SilentlyContinue'
\$expected = '${ps(normalized)}'
\$version  = '${ps(version)}'

\$proc = Get-Process -ErrorAction SilentlyContinue |
    Where-Object {
        \$_.MainWindowHandle -ne 0 -and
        \$_.Path -and
        (
            \$_.MainWindowTitle -eq \$expected -or
            \$_.MainWindowTitle -like "*\$version*" -or
            \$_.MainWindowTitle -like "eMatch*"
        )
    } |
    Sort-Object StartTime -Descending |
    Select-Object -First 1

if (\$proc) { \$proc.Path }
"""

        return safe(runPowerShell(script, 10))
    }

