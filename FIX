import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import java.awt.Robot
import java.awt.event.KeyEvent

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.driver.WindowsDriverFactory
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows
import com.kms.katalon.core.windows.keyword.helper.WindowsActionHelper

// Determine environment
String currEnv = Windows.getText(findWindowsObject('Object Repository/General/curEnv')).equals('Recette') ? "Rec" : "PROD"

// Image references
String imgDir = RunConfiguration.getProjectDir() + '/Images/BDR/'
String firstDimension = new File(imgDir, 'measures.PNG').getAbsolutePath()
String lastDimension = new File(imgDir, 'provic.png').getAbsolutePath()
String provicOpen = new File(imgDir, 'provicOpen.png').getAbsolutePath()
String normeOpen = new File(imgDir, 'normeOpen.png').getAbsolutePath()
String endOfDimensions = new File(imgDir, 'endOfDimensions.PNG').getAbsolutePath()
String startOfDimensions = new File(imgDir, "startOfDimension_${currEnv}.PNG").getAbsolutePath()

String firstPageRef = new File(imgDir, "FirstPageOfDimensions${currEnv}.PNG").getAbsolutePath()
String secondPageRef = new File(imgDir, "SecondPageOfDimensions${currEnv}.PNG").getAbsolutePath()
String thirdPageRef = new File(imgDir, "ThirdPageOfDimensions${currEnv}.PNG").getAbsolutePath()

// Initialize
String errors = ''
Robot robot = new Robot()

// Step 1: Click first dimension to focus
WindowsImageKeywords.clickImage(firstDimension)

// Step 2: Expand all dimensions (scroll until endOfDimensions image found)
int maxOpen = 95
int maxScrolls = 30
int scrollCount = 0

while (!WindowsImageKeywords.findImage(normeOpen) && scrollCount < maxOpen) {
	scrollCount++
	robot.keyPress(KeyEvent.VK_RIGHT)
	robot.keyRelease(KeyEvent.VK_RIGHT)
	
	robot.keyPress(KeyEvent.VK_DOWN)
	robot.keyRelease(KeyEvent.VK_DOWN)
}

if (scrollCount >= maxScrolls) {
	KeywordUtil.markWarning("endOfDimensions image not found after ${maxScrolls} scrolls.")
}

// Step 3: Return to top of the dimensions
scrollCount = 0
while (!WindowsImageKeywords.findImage(firstDimension) && scrollCount < maxScrolls) {
	scrollCount++
	Windows.click(findWindowsObject('Object Repository/BDR/scrollUpDimensions'))
	println("Searching for start image... Found: " + WindowsImageKeywords.findImage(firstDimension))
}

if (scrollCount >= maxScrolls) {
	KeywordUtil.markWarning("Could not scroll to top — startOfDimensions not found after ${maxScrolls} attempts.")
}

// Step 4: Capture and compare the first page
String reportDir = RunConfiguration.getReportFolder() + "\\Evidences\\"
WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession())
	.takeScreenshot(reportDir + "First_Page_Dimensions_${currEnv}.PNG")

if (!WindowsImageKeywords.findImage(firstPageRef)) {
	errors += "\n The dimensions list (Begin Scroll) does not match in env: ${currEnv}\n"
}

// Step 5: Scroll to mid-list
for (int i = 0; i < 22; i++) {
	Windows.click(findWindowsObject('Object Repository/BDR/scrollDownDimensions'))
}

WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession())
	.takeScreenshot(reportDir + "Second_Page_Dimensions_${currEnv}.PNG")

if (!WindowsImageKeywords.findImage(secondPageRef)) {
	errors += "\n The dimensions list (Mid Scroll) does not match in env: ${currEnv}\n"
}

// Step 6: Scroll to end
while (!WindowsImageKeywords.findImage(lastDimension) && scrollCount < maxScrolls) {
    scrollCount++
    Windows.click(findWindowsObject('Object Repository/BDR/scrollDownDimensions'))
}

WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession())
	.takeScreenshot(reportDir + "Third_Page_Dimensions_${currEnv}.PNG")

if (!WindowsImageKeywords.findImage(thirdPageRef)) {
	errors += "\n The dimensions list (End Scroll) does not match in env: ${currEnv}\n"
}

// Step 7: Final validation
if (errors != '') {
	KeywordUtil.logInfo('\n' + errors)
} else {
	KeywordUtil.logInfo("✅ All dimension pages validated successfully for env: ${currEnv}")
}


import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import org.openqa.selenium.WebElement
import org.openqa.selenium.interactions.Actions

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.driver.WindowsDriverFactory
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows
import com.kms.katalon.core.windows.keyword.helper.WindowsActionHelper

import io.appium.java_client.AppiumDriver as AppiumDriver

// ======================
// CONFIGURATION
// ======================
String currEnv = Windows.getText(findWindowsObject('Object Repository/General/curEnv')).equalsIgnoreCase('Recette') ? 'Rec' : 'PROD'
String imgDir = RunConfiguration.getProjectDir() + File.separator + 'Images' + File.separator + 'BDR' + File.separator

String zoneLignes = new File(imgDir, 'ZoneLignes.png').getAbsolutePath()
String zoneLignesArrowDown = new File(imgDir, 'ZoneLignes_arrowDown.png').getAbsolutePath()
String tableColWithArrows = new File(imgDir, 'tableWithArrows.png').getAbsolutePath()

String evidenceDir = RunConfiguration.getReportFolder() + "\\Evidences\\"
new File(evidenceDir).mkdirs()

// ======================
// VALIDATE IMAGE FILES EXIST
// ======================
[zoneLignes, zoneLignesArrowDown, tableColWithArrows].each { path ->
	if (!new File(path).exists()) {
		KeywordUtil.markFailedAndStop("❌ Missing image file: ${path}")
	}
}
KeywordUtil.logInfo("✅ All image files verified for ${currEnv}")

// ======================
// STEP 1 – Click on dropdown arrow inside ZoneLignes
// ======================
try {
	Windows.delay(2)
	boolean zoneFound = WindowsImageKeywords.findImage(zoneLignes)
	if (!zoneFound) {
		KeywordUtil.markFailedAndStop("❌ Base image ZoneLignes not visible on screen.")
	}
	
	WindowsImageKeywords.clickImageInImage(zoneLignes, zoneLignesArrowDown)
	KeywordUtil.logInfo("🖱️ Clicked arrow-down inside ZoneLignes.")
} catch (Exception e) {
	KeywordUtil.markFailedAndStop("❌ Failed clicking arrow in ZoneLignes: ${e.message}")
}

// ======================
// STEP 2 – Drag from 'mois d'arrêté' to 'mesures' zone
// ======================
try {
	WebElement fromElement = Windows.findElement(findWindowsObject('Object Repository/BDR/moisDarreteDimension'))
	WebElement toElement = Windows.findElement(findWindowsObject('Object Repository/BDR/measuresListDimensions'))

	if (fromElement == null || toElement == null) {
		KeywordUtil.markFailedAndStop("❌ Could not find one or both UI elements for drag-and-drop.")
	}

	AppiumDriver<?> driver = Windows.getDriver()
	Actions action = new Actions(driver)
	action.moveToElement(fromElement)
		  .clickAndHold()
		  .moveToElement(toElement)
		  .release()
		  .perform()

	KeywordUtil.logInfo("🔀 Drag-and-drop completed from moisDarreteDimension → measuresListDimensions.")
} catch (Exception e) {
	KeywordUtil.markFailedAndStop("❌ Drag-and-drop failed: ${e.message}")
}

// ======================
// STEP 3 – Wait for table with arrows to appear
// ======================
boolean tableVisible = false
try {
	tableVisible = WindowsImageKeywords.waitForImage(tableColWithArrows, 20)
	if (tableVisible) {
		KeywordUtil.logInfo("✅ Table with arrows detected on screen.")
	} else {
		KeywordUtil.markWarning("⚠️ Table with arrows not detected after timeout.")
	}
} catch (Exception e) {
	KeywordUtil.markWarning("⚠️ Error while waiting for table image: ${e.message}")
}

// ======================
// STEP 4 – Capture Evidence
// ======================
String screenshotPath = evidenceDir + "DimensionDeselected_${currEnv}.png"
WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession()).takeScreenshot(screenshotPath)
KeywordUtil.logInfo("📸 Screenshot saved: ${screenshotPath}")

// ======================
// STEP 5 – Final Verification
// ======================
if (!WindowsImageKeywords.findImage(tableColWithArrows)) {
	KeywordUtil.markFailed("❌ The table is not expandable or not visible in ${currEnv}.")
} else {
	KeywordUtil.markPassed("✅ The table is expandable and visible in ${currEnv}.")
}

