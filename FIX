properties([
    disableConcurrentBuilds()
])

def NODE_LABEL = 'GI5_SWDCFRNXGI55817'
def NEXT_JOB = 'GI5/eMatch_Regression/Retournement des internes'

def currentExecutionResult = 'SUCCESS'
def nextPipelineResult = 'NOT_BUILT'

stage('Run current pipeline') {
    node(NODE_LABEL) {
        checkout scm

        try {
            bat 'call "%WORKSPACE%\\jenkins\\ArchiveMode.cmd"'
        } catch (Throwable err) {
            currentExecutionResult = 'FAILURE'
            echo "Current execution failed: ${err}"
        } finally {
            stage('Stop current execution') {
                bat '''
@echo off
schtasks /end /tn "\\eMatch Automation\\RunEMatchCommand" >nul 2>nul
schtasks /end /tn "startWinDriver" >nul 2>nul
taskkill /f /im WinAppDriver.exe /t >nul 2>nul
taskkill /f /im katalonc.exe /t >nul 2>nul
taskkill /f /im KatalonStudio.exe /t >nul 2>nul
ping -n 6 127.0.0.1 >nul
'''
            }
        }
    }
}

stage('Trigger next pipeline') {
    def downstream = build(
        job: NEXT_JOB,
        wait: true,
        propagate: false
    )

    nextPipelineResult = downstream?.result ?: 'UNKNOWN'
    echo "Next pipeline result: ${nextPipelineResult}"
}

if (currentExecutionResult != 'SUCCESS') {
    currentBuild.result = 'FAILURE'
} else {
    currentBuild.result = 'SUCCESS'
}
