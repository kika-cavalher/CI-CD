		imageHtml = """
		<div class="case-image-wrap">
			<img class="case-image" src="${item.imageData}" alt="Failure evidence" />
		</div>
		"""
	}

	return """
	<div class="test-case failed">
		<div class="case-header">
			<div class="case-title">${safeHtml((item.className ?: '') + '/' + (item.testName ?: ''))}</div>
		</div>

		<div class="case-meta">❗ Mandatory failure</div>
