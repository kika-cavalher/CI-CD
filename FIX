    @Keyword
    void startEmatch(String currentUser, String targetWindowTitle) {
        String env = resolveEnvironment()

        String remoteShortcut = resolveExistingFileByBaseName(getShortcutPath(env))
        String localInstalledExe = resolveInstalledExePath()
        String localAppRef = resolveExistingFileByBaseName(getLocalAppRefPath(env))
        String applicationPath = getApplicationPath(env)

        String launchTarget = resolveLaunchTarget(remoteShortcut, localInstalledExe, localAppRef, applicationPath)

        KeywordUtil.logInfo("Starting eMatch for environment: ${env}")
        KeywordUtil.logInfo("Current Windows user: ${currentUser}")
        KeywordUtil.logInfo("Target window title: ${targetWindowTitle}")
        KeywordUtil.logInfo("Remote shortcut resolved: ${remoteShortcut}")
        KeywordUtil.logInfo("Local installed exe resolved: ${localInstalledExe}")
        KeywordUtil.logInfo("Local appref resolved: ${localAppRef}")
        KeywordUtil.logInfo("Application path: ${applicationPath}")
        KeywordUtil.logInfo("Launch target chosen: ${launchTarget}")

        runResolutionScriptIfExists()
        ensureWinAppDriverRunning()

        if (!launchTarget) {
            KeywordUtil.markFailedAndStop(
                "Could not resolve any launch target for environment '${env}'. " +
                "remoteShortcut='${remoteShortcut}', localInstalledExe='${localInstalledExe}', localAppRef='${localAppRef}', application='${applicationPath}'"
            )
        }

        try {
            Windows.startApplication(launchTarget)
            Windows.delay(AFTER_START_DELAY_SEC)
            KeywordUtil.logInfo("eMatch launch command executed with Katalon: ${launchTarget}")
        } catch (Exception e) {
            KeywordUtil.markFailedAndStop(
                "Could not launch eMatch for environment '${env}' using '${launchTarget}'. Error: ${e.getMessage()}"
            )
        }
    }

    @Keyword
    void attachToLoginWindow(String targetWindowTitle) {
        String exactTitle = (targetWindowTitle ?: '').trim()

        List<String> titlesToTry = []
        if (exactTitle) {
            titlesToTry << exactTitle
        }
        titlesToTry << GENERIC_WINDOW_FALLBACK
        titlesToTry = titlesToTry.unique()

        boolean attached = false
        int elapsedTime = 0
        Exception lastError = null

        Windows.delay(AFTER_ATTACH_DELAY_SEC)

        while (!attached && elapsedTime < WINDOW_ATTACH_TIMEOUT_SEC) {
            for (String title : titlesToTry) {
                try {
                    KeywordUtil.logInfo("Trying to attach using window title: ${title}")

                    try {
                        Windows.switchToWindowTitle(title)
                    } catch (Exception ignored) {
                        WindowsTestObject targetWindow = new WindowsTestObject("targetWindow_${title}")
                        targetWindow.setLocatorStrategy(LocatorStrategy.NAME)
                        targetWindow.setLocator(title)
                        Windows.switchToWindow(targetWindow)
                    }

                    try {
                        Windows.maximizeWindow(FailureHandling.OPTIONAL)
                    } catch (Exception ignored) {
                    }

                    attached = true
                    KeywordUtil.logInfo("Attached successfully using title: ${title}")
                    break
                } catch (Exception e) {
                    lastError = e
                    KeywordUtil.logInfo("Attach failed for title '${title}': ${e.getMessage()}")
                }
            }

            if (!attached) {
                Windows.delay(WINDOW_ATTACH_RETRY_SEC)
                elapsedTime += WINDOW_ATTACH_RETRY_SEC
            }
        }

        if (!attached) {
            KeywordUtil.markFailedAndStop(
                "Could not attach to eMatch window. Titles tried: ${titlesToTry}. Last error: ${lastError?.message}"
            )
        }
    }

