@Keyword
void deleteCreatedFavorite(String favoriteTitle) {

	Integer favoriteSearchTimeout = 20
	Integer deleteCommandTimeout = 5

	Integer maximumDeleteChecks = 5
	Integer waitPerDeleteCheckSeconds = 20

	logStep(
		'DELETE FAVORITE',
		'Favorite title: ' + favoriteTitle + '\n' +
		'Delete validation attempts: ' +
			maximumDeleteChecks + '\n' +
		'Wait per attempt: ' +
			waitPerDeleteCheckSeconds +
			' seconds'
	)


	// ======================================================
	// OPEN FAVORITES TAB
	// ======================================================

	WindowsTestObject favoritesTab =
		object(
			'favoritesTab'
		)

	if (!Windows.waitForElementPresent(
		favoritesTab,
		favoriteSearchTimeout,
		FailureHandling.OPTIONAL
	)) {
		takeEvidence(
			'GUI_FavoritesTabNotFoundForDelete.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorites tab was not found before deletion.'
		)

		return
	}

	KeywordUtil.logInfo(
		'[DELETE FAVORITE] Clicking Favorites tab.'
	)

	Windows.click(
		favoritesTab,
		FailureHandling.STOP_ON_FAILURE
	)

	Windows.delay(2)


	// ======================================================
	// FIND FAVORITE
	// ======================================================

	WindowsTestObject favoriteItem =
		WindowsObjectLoader.getTreeItemByName(
			favoriteTitle
		)

	boolean favoriteFound =
		Windows.waitForElementPresent(
			favoriteItem,
			favoriteSearchTimeout,
			FailureHandling.OPTIONAL
		)

	if (!favoriteFound) {
		takeEvidence(
			'GUI_FavoriteNotFoundForDelete.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorite was not found for deletion.\n' +
			'Favorite: ' + favoriteTitle
		)

		return
	}


	// ======================================================
	// OPEN FAVORITE CONTEXT MENU
	// ======================================================

	KeywordUtil.logInfo(
		'[DELETE FAVORITE] Favorite found. Opening context menu.\n' +
		'Favorite: ' + favoriteTitle
	)

	Windows.rightClick(
		favoriteItem,
		FailureHandling.STOP_ON_FAILURE
	)

	Windows.delay(2)


	// ======================================================
	// CLICK DELETE COMMAND
	// ELEMENT FIRST, IMAGE FALLBACK
	// ======================================================

	boolean deleteCommandClicked = false

	WindowsTestObject deleteFavoriteButton =
		object(
			'deleteFavoriteButton'
		)

	boolean deleteButtonFound =
		Windows.waitForElementPresent(
			deleteFavoriteButton,
			deleteCommandTimeout,
			FailureHandling.OPTIONAL
		)

	if (deleteButtonFound) {
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Clicking delete command by element.'
		)

		Windows.click(
			deleteFavoriteButton,
			FailureHandling.STOP_ON_FAILURE
		)

		deleteCommandClicked = true
	} else {
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Delete command element was not found.\n' +
			'Trying image fallback: deleteFavoriteBtn'
		)

		deleteCommandClicked =
			clickFirstVisibleImage(
				GUI_IMAGE_GROUP,
				[
					'deleteFavoriteBtn'
				],
				deleteCommandTimeout
			)
	}

	if (!deleteCommandClicked) {
		takeEvidence(
			'GUI_DeleteFavoriteButtonNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Delete Favorite command was not found by element or image.\n' +
			'Expected command: Supprimer le favori\n' +
			'Image key: deleteFavoriteBtn'
		)

		return
	}


	// ======================================================
	// WAIT UNTIL FAVORITE DISAPPEARS
	// 5 ATTEMPTS OF 20 SECONDS
	// ======================================================

	boolean favoriteDeleted = false

	for (
		Integer deleteCheckAttempt = 1;
		deleteCheckAttempt <= maximumDeleteChecks;
		deleteCheckAttempt++
	) {
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Waiting for favorite deletion.\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'Attempt: ' +
				deleteCheckAttempt +
				'/' +
				maximumDeleteChecks + '\n' +
			'Wait time: ' +
				waitPerDeleteCheckSeconds +
				' seconds'
		)

		Windows.delay(
			waitPerDeleteCheckSeconds
		)

		if (Windows.waitForElementPresent(
			favoritesTab,
			2,
			FailureHandling.OPTIONAL
		)) {
			Windows.click(
				favoritesTab,
				FailureHandling.OPTIONAL
			)

			Windows.delay(1)
		}

		boolean favoriteStillPresent =
			Windows.waitForElementPresent(
				favoriteItem,
				2,
				FailureHandling.OPTIONAL
			)

		if (!favoriteStillPresent) {
			favoriteDeleted = true

			KeywordUtil.logInfo(
				'[PASS] Favorite is no longer displayed.\n' +
				'Attempt: ' +
				deleteCheckAttempt +
				'/' +
				maximumDeleteChecks
			)

			break
		}

		if (deleteCheckAttempt < maximumDeleteChecks) {
			KeywordUtil.logInfo(
				'[DELETE FAVORITE] Favorite is still displayed.\n' +
				'Another 20-second validation will be executed.'
			)
		}
	}

	takeEvidence(
		'GUI_FavoriteAfterDelete.png'
	)

	if (!favoriteDeleted) {
		KeywordUtil.markFailedAndStop(
			'Favorite is still visible after deletion.\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'Attempts: ' + maximumDeleteChecks + '\n' +
			'Wait per attempt: ' +
				waitPerDeleteCheckSeconds +
				' seconds\n' +
			'Maximum total wait: 100 seconds'
		)

		return
	}


	// ======================================================
	// CLOSE ALL TABS
	// ======================================================

	WindowsTestObject closeAllTabsButton =
		object(
			'closeAllTabsTopBar'
		)

	if (!Windows.waitForElementPresent(
		closeAllTabsButton,
		5,
		FailureHandling.OPTIONAL
	)) {
		takeEvidence(
			'GUI_CloseAllTabsButtonNotFoundAfterDelete.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorite was deleted, but the Close All Tabs button was not found.'
		)

		return
	}

	KeywordUtil.logInfo(
		'[DELETE FAVORITE] Closing all opened tabs.'
	)

	Windows.click(
		closeAllTabsButton,
		FailureHandling.STOP_ON_FAILURE
	)

	Windows.delay(2)

	boolean closeTabsConfirmed =
		clickFirstVisibleImage(
			GENERAL_IMAGE_GROUP,
			[
				'yes',
				'yesUnderline',
				'yesButton',
				'oui'
			],
			3
		)

	if (!closeTabsConfirmed) {
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] Close confirmation image was not found.\n' +
			'Pressing ENTER.'
		)

		pressKeyboardKey(
			KeyEvent.VK_ENTER
		)
	}

	Windows.delay(5)

	takeEvidence(
		'GUI_AllTabsClosedAfterFavoriteDelete.png'
	)

	KeywordUtil.markPassed(
		'Favorite deleted successfully.\n' +
		'Favorite: ' + favoriteTitle + '\n' +
		'Favorite is no longer displayed.\n' +
		'All opened tabs were closed.'
	)
}
