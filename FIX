package jiraIntegration

import java.io.BufferedReader
import java.io.File
import java.io.FileInputStream
import java.io.InputStreamReader
import java.math.BigDecimal
import java.nio.charset.StandardCharsets
import java.text.SimpleDateFormat
import java.util.Locale
import java.util.regex.Matcher
import java.util.regex.Pattern

import javax.xml.XMLConstants
import javax.xml.parsers.DocumentBuilderFactory

import org.w3c.dom.Document
import org.w3c.dom.Element
import org.w3c.dom.Node
import org.w3c.dom.NodeList

class JiraReportBuilder {

    private static final String APP_NAME = 'EMATCH'
    private static final String LOGO_SRC = 'Image/ematch-logo.png'

    private static final SimpleDateFormat OUTPUT_DATE_TIME =
        new SimpleDateFormat('dd/MM/yyyy HH:mm:ss', Locale.ENGLISH)

    private static final SimpleDateFormat OUTPUT_STAMP =
        new SimpleDateFormat('yyyy-MM-dd HH.mm.ss', Locale.ENGLISH)

    private static final List<String> DATE_PATTERNS = [
        'yyyy-MM-dd HH:mm:ss.SSS',
        'yyyy-MM-dd HH:mm:ss',
        'dd/MM/yyyy HH:mm:ss'
    ]

    private static final Pattern LOG_TS_PATTERN =
        Pattern.compile('(\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}(?:\\.\\d{3})?)')

    File buildReport(String reportFolderPath) {
        return buildReport(new File(safe(reportFolderPath).isEmpty() ? '.' : reportFolderPath), '', '')
    }

    File buildReport(String reportFolderPath, String suiteName, String executionTitle) {
        return buildReport(new File(safe(reportFolderPath).isEmpty() ? '.' : reportFolderPath), suiteName, executionTitle)
    }

    File buildReport(File reportFolder) {
        return buildReport(reportFolder, '', '')
    }

    File buildReport(File reportFolder, String suiteName, String executionTitle) {
        Map model = buildModel(reportFolder, suiteName, executionTitle)
        String html = new JiraHtmlTemplateBuilder().build(model)

        File target = new File(reportFolder, 'eMatchReport.html')
        target.write(html, 'UTF-8')
        return target
    }

    Map buildModel(File reportFolder) {
        return buildModel(reportFolder, '', '')
    }

    Map buildModel(File reportFolder, String suiteName, String executionTitle) {
        File root = reportFolder ?: new File('.')

        if (!root.exists()) {
            return emptyModel(root)
        }

        List<File> junitFiles = collectJUnitFiles(root)
        List<Map> scenarios = []

        junitFiles.each { File junit ->
            scenarios.addAll(buildScenariosFromJUnit(junit, root))
        }

        if (scenarios.isEmpty()) {
            scenarios = buildFallbackScenarioList(root)
        }

        String resolvedSuiteName = firstNonBlank(
            suiteName,
            detectSuiteName(root, scenarios),
            'Execution'
        )

        String resolvedExecutionTitle = firstNonBlank(
            executionTitle,
            resolvedSuiteName + ' ' + OUTPUT_STAMP.format(new Date())
        )

        return [
            appName       : APP_NAME,
            suiteName     : resolvedSuiteName,
            executionName : resolvedExecutionTitle,
            title         : resolvedExecutionTitle,
            generatedAt   : OUTPUT_DATE_TIME.format(new Date()),
            reportFolder  : root.absolutePath,
            logoSrc       : LOGO_SRC,
            scenarios     : scenarios
        ]
    }

    private Map emptyModel(File root) {
        return [
            appName       : APP_NAME,
            suiteName     : 'Execution',
            executionName : 'Execution',
            title         : 'Execution',
            generatedAt   : OUTPUT_DATE_TIME.format(new Date()),
            reportFolder  : root?.absolutePath ?: new File('.').absolutePath,
            logoSrc       : LOGO_SRC,
            scenarios     : []
        ]
    }

    private List<Map> buildScenariosFromJUnit(File junitFile, File reportRoot) {
        List<Map> result = []
        Document document = parseXml(junitFile)

        if (document == null) {
            return result
        }

        NodeList testcases = document.getElementsByTagName('testcase')

        for (int i = 0; i < testcases.length; i++) {
            Element testcase = (Element) testcases.item(i)

            String rawName = firstNonBlank(
                testcase.getAttribute('name'),
                "Scenario ${i + 1}"
            )

            String className = safe(testcase.getAttribute('classname'))
            String displayName = buildDisplayName(className, rawName)

            Element failureNode = firstDirectChild(testcase, 'failure')
            Element errorNode = firstDirectChild(testcase, 'error')
            Element skippedNode = firstDirectChild(testcase, 'skipped')

            String status = 'passed'
            Element resultNode = null

            if (failureNode != null) {
                status = 'failed'
                resultNode = failureNode
            } else if (errorNode != null) {
                status = 'failed'
                resultNode = errorNode
            } else if (skippedNode != null) {
                status = 'blocked'
                resultNode = skippedNode
            }

            String fullError = safe(resultNode?.getTextContent())
            String visualError = buildShortError(fullError, displayName)

            List<String> caseIds = candidateCaseIds(displayName, rawName, className)
            Map timing = extractTimingForCase(reportRoot, caseIds, toDurationMillis(testcase.getAttribute('time')))
            List<Map> steps = extractReportSteps(reportRoot, caseIds)
            List<Map> evidence = collectEvidence(reportRoot, caseIds, status)

            result << [
                id           : buildScenarioId(displayName, i + 1),
                name         : displayName,
                scenarioName : displayName,
                status       : status,
                result       : status,
                durationMs   : timing.durationMs,
                durationLabel: formatDuration(timing.durationMs as long),
                startTime    : safe(timing.startLabel),
                endTime      : safe(timing.endLabel),
                startLabel   : safe(timing.startLabel),
                endLabel     : safe(timing.endLabel),
                visualError  : visualError,
                errorSummary : visualError,
                fullError    : fullError,
                reportFolder : reportRoot.absolutePath,
                steps        : steps,
                evidence     : evidence
            ]
        }

        return result
    }

    private List<Map> buildFallbackScenarioList(File reportRoot) {
        List<Map> fallback = []
        List<String> caseIds = collectCaseIdsFromMarkers(reportRoot)

        caseIds.eachWithIndex { String caseId, int index ->
            Map timing = extractTimingForCase(reportRoot, [caseId], 0L)
            String status = extractStatusForCase(reportRoot, [caseId])
            String fullError = extractFailureForCase(reportRoot, [caseId])
            String visualError = buildShortError(fullError, caseId)
            List<Map> steps = extractReportSteps(reportRoot, [caseId])
            List<Map> evidence = collectEvidence(reportRoot, [caseId], status)

            fallback << [
                id           : buildScenarioId(caseId, index + 1),
                name         : caseId,
                scenarioName : caseId,
                status       : status,
                result       : status,
                durationMs   : timing.durationMs,
                durationLabel: formatDuration(timing.durationMs as long),
                startTime    : safe(timing.startLabel),
                endTime      : safe(timing.endLabel),
                startLabel   : safe(timing.startLabel),
                endLabel     : safe(timing.endLabel),
                visualError  : visualError,
                errorSummary : visualError,
                fullError    : fullError,
                reportFolder : reportRoot.absolutePath,
                steps        : steps,
                evidence     : evidence
            ]
        }

        return fallback
    }

    private Document parseXml(File file) {
        try {
            DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance()

            try { factory.setFeature(XMLConstants.FEATURE_SECURE_PROCESSING, true) } catch (Throwable ignored) {}
            try { factory.setFeature('http://apache.org/xml/features/disallow-doctype-decl', true) } catch (Throwable ignored) {}
            try { factory.setFeature('http://xml.org/sax/features/external-general-entities', false) } catch (Throwable ignored) {}
            try { factory.setFeature('http://xml.org/sax/features/external-parameter-entities', false) } catch (Throwable ignored) {}

            factory.setNamespaceAware(false)
            factory.setExpandEntityReferences(false)
            factory.setXIncludeAware(false)

            return factory.newDocumentBuilder().parse(file)
        } catch (Throwable ignored) {
            return null
        }
    }

    private Element firstDirectChild(Element parent, String tagName) {
        if (parent == null) {
            return null
        }

        NodeList children = parent.getChildNodes()
        for (int i = 0; i < children.length; i++) {
            Node node = children.item(i)
            if (node instanceof Element && tagName.equalsIgnoreCase(node.getNodeName())) {
                return (Element) node
            }
        }

        return null
    }

    private List<File> collectJUnitFiles(File root) {
        List<File> files = []

        root.eachFileRecurse { File file ->
            if (!file.isFile()) {
                return
            }

            String lower = safe(file.name).toLowerCase(Locale.ENGLISH)
            if (lower == 'junit_report.xml' || lower == 'junitreport.xml' || lower == 'junit.xml') {
                files << file
            }
        }

        files = files
            .findAll { it.exists() }
            .unique { it.absolutePath }
            .sort { File a, File b -> a.absolutePath <=> b.absolutePath }

        return files
    }

    private List<File> collectLogFiles(File root) {
        List<File> files = []

        root.eachFileRecurse { File file ->
            if (!file.isFile()) {
                return
            }

            String lower = safe(file.name).toLowerCase(Locale.ENGLISH)
            if (lower.endsWith('.log') || lower.endsWith('.txt')) {
                files << file
            }
        }

        files = files
            .findAll { it.exists() && it.length() > 0L }
            .sort { File a, File b ->
                priorityOfLog(a) <=> priorityOfLog(b) ?: (a.absolutePath <=> b.absolutePath)
            }

        return files
    }

    private int priorityOfLog(File file) {
        String lower = safe(file.name).toLowerCase(Locale.ENGLISH)
        if (lower == 'execution0.log') {
            return 0
        }
        if (lower.contains('execution')) {
            return 1
        }
        return 5
    }

    private Map extractTimingForCase(File reportRoot, List<String> caseIds, long fallbackDurationMs) {
        long startMs = 0L
        long endMs = 0L
        long durationMs = fallbackDurationMs

        List<File> logs = collectLogFiles(reportRoot)

        logs.each { File logFile ->
            boolean insideCase = false
            long firstBlockTs = 0L
            long lastBlockTs = 0L

            eachLine(logFile) { String line ->
                String startedCase = extractBoundaryCase(line, 'START Test Cases/')
                if (!startedCase.isEmpty()) {
                    insideCase = matchesCase(startedCase, caseIds)
                    if (insideCase) {
                        long blockTs = extractLogTimestampMs(line)
                        if (blockTs > 0L && firstBlockTs == 0L) {
                            firstBlockTs = blockTs
                        }
                    }
                    return
                }

                String endedCase = extractBoundaryCase(line, 'END Test Cases/')
                if (!endedCase.isEmpty()) {
                    if (matchesCase(endedCase, caseIds)) {
                        insideCase = false
                        long blockTs = extractLogTimestampMs(line)
                        if (blockTs > 0L) {
                            lastBlockTs = blockTs
                        }
                    }
                    return
                }

                List<String> startMarker = parseMarker(line, '[REPORT_CASE_START]')
                if (startMarker.size() >= 2 && matchesCase(startMarker[0], caseIds)) {
                    long value = parseDateMillis(startMarker[1])
                    if (value > 0L) {
                        startMs = value
                    }
                    return
                }

                List<String> endMarker = parseMarker(line, '[REPORT_CASE_END]')
                if (endMarker.size() >= 2 && matchesCase(endMarker[0], caseIds)) {
                    long value = parseDateMillis(endMarker[1])
                    if (value > 0L) {
                        endMs = value
                    }
                    return
                }

                List<String> durationMarker = parseMarker(line, '[REPORT_DURATION]')
                if (durationMarker.size() >= 2 && matchesCase(durationMarker[0], caseIds)) {
                    durationMs = asLong(durationMarker[1])
                    return
                }

                if (insideCase) {
                    long ts = extractLogTimestampMs(line)
                    if (ts > 0L) {
                        if (firstBlockTs == 0L) {
                            firstBlockTs = ts
                        }
                        lastBlockTs = ts
                    }
                }
            }

            if (startMs == 0L && firstBlockTs > 0L) {
                startMs = firstBlockTs
            }

            if (endMs == 0L && lastBlockTs > 0L) {
                endMs = lastBlockTs
            }
        }

        if (startMs > 0L && endMs >= startMs) {
            durationMs = Math.max(0L, endMs - startMs)
        }

        return [
            startMs    : startMs,
            endMs      : endMs,
            durationMs : durationMs,
            startLabel : startMs > 0L ? OUTPUT_DATE_TIME.format(new Date(startMs)) : '--',
            endLabel   : endMs > 0L ? OUTPUT_DATE_TIME.format(new Date(endMs)) : '--'
        ]
    }

    private String extractStatusForCase(File reportRoot, List<String> caseIds) {
        String found = ''

        collectLogFiles(reportRoot).each { File logFile ->
            eachLine(logFile) { String line ->
                List<String> parts = parseMarker(line, '[REPORT_STATUS]')
                if (parts.size() >= 2 && matchesCase(parts[0], caseIds)) {
                    found = normalizeStatus(parts[1])
                }
            }
        }

        return found.isEmpty() ? 'blocked' : found
    }

    private String extractFailureForCase(File reportRoot, List<String> caseIds) {
        String found = ''

        collectLogFiles(reportRoot).each { File logFile ->
            eachLine(logFile) { String line ->
                List<String> parts = parseMarker(line, '[REPORT_FAILURE]')
                if (parts.size() >= 2 && matchesCase(parts[0], caseIds)) {
                    found = parts[1]
                }
            }
        }

        return found
    }

    private List<Map> extractReportSteps(File reportRoot, List<String> caseIds) {
        List<Map> steps = []
        List<File> logs = collectLogFiles(reportRoot)

        logs.each { File logFile ->
            boolean insideCase = false

            eachLine(logFile) { String line ->
                String startedCase = extractBoundaryCase(line, 'START Test Cases/')
                if (!startedCase.isEmpty()) {
                    insideCase = matchesCase(startedCase, caseIds)
                    return
                }

                String endedCase = extractBoundaryCase(line, 'END Test Cases/')
                if (!endedCase.isEmpty()) {
                    if (matchesCase(endedCase, caseIds)) {
                        insideCase = false
                    }
                    return
                }

                List<String> parts = parseMarker(line, '[REPORT_STEP]')
                if (parts.isEmpty()) {
                    return
                }

                if (parts.size() >= 3) {
                    if (matchesCase(parts[0], caseIds)) {
                        steps << [detail: parts[2]]
                    }
                    return
                }

                if (parts.size() == 2 && matchesCase(parts[0], caseIds)) {
                    steps << [detail: parts[1]]
                    return
                }

                if (parts.size() == 1 && insideCase) {
                    steps << [detail: parts[0]]
                }
            }
        }

        return steps
            .findAll { Map row -> !safe(row.detail).isEmpty() }
            .unique { Map row -> safe(row.detail) }
    }

    private List<Map> collectEvidence(File reportRoot, List<String> caseIds, String status) {
        if (status == 'passed') {
            return []
        }

        File evidencesRoot = new File(reportRoot, 'Evidences')
        if (!evidencesRoot.exists()) {
            return []
        }

        List<String> candidateFolders = caseIds.collect { String id -> sanitizeCaseId(id) }.findAll { !it.isEmpty() }.unique()
        List<File> matches = []

        evidencesRoot.eachFileRecurse { File file ->
            if (!file.isFile()) {
                return
            }

            String lower = safe(file.name).toLowerCase(Locale.ENGLISH)
            boolean isImage = lower.endsWith('.png') || lower.endsWith('.jpg') || lower.endsWith('.jpeg') || lower.endsWith('.gif') || lower.endsWith('.bmp') || lower.endsWith('.webp')
            if (!isImage) {
                return
            }

            String pathLower = safe(file.absolutePath).toLowerCase(Locale.ENGLISH)
            boolean matched = candidateFolders.any { String folderName ->
                pathLower.contains(folderName.toLowerCase(Locale.ENGLISH))
            }

            if (matched) {
                matches << file
            }
        }

        matches = matches.sort { File a, File b -> b.lastModified() <=> a.lastModified() }

        List<Map> result = []
        matches.each { File file ->
            result << [
                name  : file.name,
                href  : file.toURI().toString(),
                image : true,
                imgSrc: file.toURI().toString()
            ]
        }

        return result
    }

    private List<String> collectCaseIdsFromMarkers(File reportRoot) {
        List<String> caseIds = []

        collectLogFiles(reportRoot).each { File logFile ->
            eachLine(logFile) { String line ->
                List<String> parts = parseMarker(line, '[REPORT_CASE_START]')
                if (parts.size() >= 2) {
                    caseIds << parts[0]
                }
            }
        }

        return caseIds.unique()
    }

    private void eachLine(File file, Closure consumer) {
        BufferedReader reader = null
        try {
            reader = new BufferedReader(new InputStreamReader(new FileInputStream(file), StandardCharsets.UTF_8))
            String line
            while ((line = reader.readLine()) != null) {
                consumer.call(line)
            }
        } catch (Throwable ignored) {
        } finally {
            try {
                reader?.close()
            } catch (Throwable ignored) {
            }
        }
    }

    private List<String> parseMarker(String line, String marker) {
        String text = safe(line)
        int idx = text.indexOf(marker)
        if (idx < 0) {
            return []
        }

        String payload = safe(text.substring(idx + marker.length()))
        if (payload.startsWith(':')) {
            payload = safe(payload.substring(1))
        }
        if (payload.startsWith('-')) {
            payload = safe(payload.substring(1))
        }

        List<String> parts = payload.split(/\\s+\\|\\s+/).collect { String value ->
            safe(value)
        }.findAll { String value ->
            !value.isEmpty()
        }

        return parts
    }

    private String extractBoundaryCase(String line, String marker) {
        String text = safe(line)
        int idx = text.indexOf(marker)
        if (idx < 0) {
            return ''
        }
        return safe(text.substring(idx + 'START '.length())).trim()
    }

    private long extractLogTimestampMs(String line) {
        Matcher matcher = LOG_TS_PATTERN.matcher(safe(line))
        if (matcher.find()) {
            return parseDateMillis(matcher.group(1))
        }
        return 0L
    }

    private long parseDateMillis(String value) {
        String text = safe(value)
        if (text.isEmpty()) {
            return 0L
        }

        for (String pattern : DATE_PATTERNS) {
            try {
                return new SimpleDateFormat(pattern, Locale.ENGLISH).parse(text).time
            } catch (Throwable ignored) {
            }
        }

        return 0L
    }

    private String buildDisplayName(String className, String rawName) {
        String cls = safe(className)
        String name = safe(rawName)

        if (!cls.isEmpty()) {
            if (cls.startsWith('Test Cases/')) {
                return cls
            }
            if (cls.contains('/')) {
                return cls
            }
        }

        return name
    }

    private List<String> candidateCaseIds(String displayName, String rawName, String className) {
        return [
            safe(displayName),
            safe(rawName),
            safe(className)
        ].findAll { String value ->
            !value.isEmpty()
        }.unique()
    }

    private boolean matchesCase(String value, List<String> candidates) {
        String left = normalizeCaseId(value)
        return candidates.any { String candidate ->
            normalizeCaseId(candidate) == left
        }
    }

    private String normalizeCaseId(String value) {
        return safe(value)
            .replace('\\', '/')
            .replaceAll(/\\s+/, ' ')
            .trim()
    }

    private String normalizeStatus(String value) {
        String lower = safe(value).toLowerCase(Locale.ENGLISH)
        if (lower == 'passed' || lower == 'pass' || lower == 'success') {
            return 'passed'
        }
        if (lower == 'failed' || lower == 'fail' || lower == 'error') {
            return 'failed'
        }
        return 'blocked'
    }

    private String buildShortError(String fullError, String displayName) {
        String text = safe(fullError)
        if (text.isEmpty()) {
            return ''
        }

        int reasonIndex = text.indexOf('Reason:')
        if (reasonIndex >= 0) {
            String tail = text.substring(reasonIndex + 'Reason:'.length()).trim()
            List<String> lines = tail.readLines().findAll { String line ->
                String clean = safe(line)
                !clean.isEmpty() && !clean.startsWith('at ')
            }
            if (!lines.isEmpty()) {
                return lines[0]
            }
        }

        List<String> lines = text.readLines().findAll { String line ->
            String clean = safe(line)
            !clean.isEmpty() && !clean.startsWith('at ')
        }

        if (!lines.isEmpty()) {
            return lines[0]
        }

        return safe(displayName) + ' FAILED.'
    }

    private String detectSuiteName(File root, List<Map> scenarios) {
        String parentName = safe(root?.parentFile?.name)
        if (!parentName.isEmpty() && !parentName.matches(/\\d{8}_\\d{6}/)) {
            return parentName
        }

        if (scenarios != null && !scenarios.isEmpty()) {
            return safe(scenarios[0].name)
        }

        return 'Execution'
    }

    private String buildScenarioId(String value, int index) {
        String text = safe(value)
            .replace('\\', '/')
            .replaceAll(/[^A-Za-z0-9/_-]+/, '-')
            .replaceAll(/-+/, '-')
            .replaceAll(/^[-/]+|[-/]+$/, '')

        return text.isEmpty() ? "scenario-${index}" : text
    }

    private long toDurationMillis(String secondsValue) {
        String value = safe(secondsValue)
        if (value.isEmpty()) {
            return 0L
        }

        try {
            BigDecimal seconds = new BigDecimal(value.replace(',', '.'))
            return seconds.multiply(new BigDecimal('1000')).longValue()
        } catch (Throwable ignored) {
            return 0L
        }
    }

    private String formatDuration(long durationMs) {
        long totalSeconds = Math.round(Math.max(0L, durationMs) / 1000d)
        long hours = (long) (totalSeconds / 3600L)
        long minutes = (long) ((totalSeconds % 3600L) / 60L)
        long seconds = (long) (totalSeconds % 60L)

        return String.format(Locale.ENGLISH, '%02dh %02dm %02ds', hours, minutes, seconds)
    }

    private long asLong(Object value) {
        try {
            return Long.parseLong(String.valueOf(value))
        } catch (Throwable ignored) {
            return 0L
        }
    }

    private String sanitizeCaseId(String value) {
        return safe(value)
            .replace('\\', '_')
            .replace('/', '_')
            .replace(':', '_')
            .replace('*', '_')
            .replace('?', '_')
            .replace('"', '_')
            .replace('<', '_')
            .replace('>', '_')
            .replace('|', '_')
            .replaceAll(/[^A-Za-z0-9._-]+/, '_')
            .replaceAll(/_+/, '_')
            .replaceAll(/^_+|_+$/, '')
    }

    private String firstNonBlank(Object... values) {
        if (values == null) {
            return ''
        }

        for (Object value : values) {
            String text = safe(value)
            if (!text.isEmpty()) {
                return text
            }
        }

        return ''
    }

    private String safe(Object value) {
        return value == null ? '' : String.valueOf(value).trim()
    }
}









package jiraIntegration

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil

import internal.GlobalVariable

import java.io.File
import java.io.FileOutputStream
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale
import java.util.zip.ZipEntry
import java.util.zip.ZipOutputStream

class JiraFlowCoordinator {

    private static final String JIRA_BASE_URL = 'https://jira-mut.d.bbg'
    private static final String PROJECT_KEY = 'GI5PRD'
    private static final String TEST_PLAN_ISSUE_TYPE_ID = '10604'
    private static final String EPIC_LINK_FIELD_ID = 'customfield_10006'

    private static final String DEFAULT_EPIC_KEY = 'GI5PRD-9877'
    private static final String TEST_PLAN_ASSIGNEE = 'cavalherer'

    private static final boolean FORCE_CREATE_NEW_TEST_PLAN = false

    /*
     * Leave empty if your token already comes from:
     * 1) GlobalVariable.JIRA_TOKEN
     * 2) GlobalVariable.jiraToken
     * 3) System env JIRA_TOKEN
     */
    private static final String JIRA_TOKEN = ''

    @Keyword
    String jiraImport(String epicKey = '') {
        try {
            KeywordUtil.logInfo('============================================================')
            KeywordUtil.logInfo('Starting Jira import flow')
            KeywordUtil.logInfo('============================================================')

            String token = resolveToken()

            if (blank(token)) {
                throw new RuntimeException('JIRA token is empty. Fill JIRA_TOKEN or GlobalVariable.JIRA_TOKEN or env JIRA_TOKEN.')
            }

            String effectiveEpicKey = !blank(epicKey) ? safe(epicKey) : DEFAULT_EPIC_KEY

            File reportFolder = locateTargetReportFolder()
            File latestRunFolder = findLatestRunFolder(new File(RunConfiguration.getProjectDir(), 'Reports'))
            File junitXml = findJUnitXml(reportFolder)

            if (reportFolder == null || !reportFolder.exists()) {
                throw new RuntimeException('Could not locate the target report folder.')
            }

            if (junitXml == null || !junitXml.exists()) {
                throw new RuntimeException('JUnit XML was not found inside the selected report folder.')
            }

            String suiteName = safe(reportFolder.parentFile?.name)
            String executionTitle = buildExecutionTitle(suiteName, latestRunFolder)

            KeywordUtil.logInfo('Using report folder: ' + reportFolder.absolutePath)
            KeywordUtil.logInfo('Suite name detected from report path: ' + suiteName)
            KeywordUtil.logInfo('Execution title used: ' + executionTitle)
            KeywordUtil.logInfo('Test Plan title used: ' + suiteName + ' Test Plan')
            KeywordUtil.logInfo('Epic key used: ' + effectiveEpicKey)
            KeywordUtil.logInfo('Assignee used on Test Plan: ' + TEST_PLAN_ASSIGNEE)
            KeywordUtil.logInfo('JUnit XML found: ' + junitXml.absolutePath)

            File customReport = buildCustomHtmlReport(reportFolder, suiteName, executionTitle)
            KeywordUtil.logInfo('Custom Jira report created: ' + customReport.absolutePath)

            File resultsZip = new File(reportFolder, 'Results.zip')
            createZipFromFolder(reportFolder, resultsZip, [
                'Results.zip',
                'Evidences.zip'
            ])
            KeywordUtil.logInfo('Results ZIP created: ' + resultsZip.absolutePath)

            File evidencesZip = createEvidencesZip(reportFolder)
            if (evidencesZip != null && evidencesZip.exists()) {
                KeywordUtil.logInfo('Evidences ZIP created: ' + evidencesZip.absolutePath)
            }

            JiraGateway gateway = new JiraGateway(JIRA_BASE_URL, token)

            JiraTestPlanManager testPlanManager = new JiraTestPlanManager(
                gateway,
                PROJECT_KEY,
                TEST_PLAN_ISSUE_TYPE_ID,
                EPIC_LINK_FIELD_ID,
                effectiveEpicKey,
                TEST_PLAN_ASSIGNEE
            )

            String testPlanKey = testPlanManager.getOrCreateTestPlanKey(
                suiteName,
                '',
                FORCE_CREATE_NEW_TEST_PLAN
            )

            List<File> attachments = []
            attachments << customReport
            attachments << resultsZip

            if (evidencesZip != null && evidencesZip.exists()) {
                attachments << evidencesZip
            }

            JiraExecutionPublisher publisher = new JiraExecutionPublisher(gateway)

            Map publishResponse = publisher.publishExecution([
                junitXml      : junitXml,
                customReport  : customReport,
                reportFolder  : reportFolder,
                projectKey    : PROJECT_KEY,
                testPlanKey   : testPlanKey,
                executionTitle: executionTitle,
                attachments   : attachments
            ])

            String executionKey = safe(publishResponse.executionKey)

            KeywordUtil.logInfo('Jira import completed successfully.')
            KeywordUtil.logInfo('Test Plan key: ' + testPlanKey)
            KeywordUtil.logInfo('Execution key: ' + executionKey)
            KeywordUtil.logInfo('============================================================')

            return executionKey
        } catch (Exception e) {
            KeywordUtil.markFailed('Jira import failed: ' + safe(e.message))
            throw e
        }
    }

    private File buildCustomHtmlReport(File reportFolder, String suiteName, String executionTitle) {
        JiraReportBuilder reportBuilder = new JiraReportBuilder()
        File customReport = reportBuilder.buildReport(reportFolder, suiteName, executionTitle)

        if (customReport == null || !customReport.exists()) {
            throw new RuntimeException('Custom HTML report was not generated.')
        }

        return customReport
    }

    private String resolveToken() {
        if (!blank(JIRA_TOKEN)) {
            return JIRA_TOKEN
        }

        String envToken = System.getenv('JIRA_TOKEN')
        if (!blank(envToken)) {
            return envToken
        }

        List<String> candidates = [
            'JIRA_TOKEN',
            'jiraToken',
            'jira_token',
            'JiraToken',
            'TOKEN'
        ]

        for (String fieldName : candidates) {
            try {
                def value = GlobalVariable."${fieldName}"
                if (!blank(safe(value))) {
                    return safe(value)
                }
            } catch (Exception ignored) {
            }
        }

        return ''
    }

    private File locateTargetReportFolder() {
        File reportsRoot = new File(RunConfiguration.getProjectDir(), 'Reports')
        File latestRunFolder = findLatestRunFolder(reportsRoot)

        if (latestRunFolder == null || !latestRunFolder.exists()) {
            throw new RuntimeException('No timestamp report folder was found under Reports.')
        }

        List<File> candidates = []

        latestRunFolder.eachFileRecurse { File dir ->
            if (!dir.isDirectory()) {
                return
            }

            boolean hasJUnit = new File(dir, 'JUnit_Report.xml').exists()
            String lowerName = safe(dir.name).toLowerCase(Locale.ENGLISH)

            if (hasJUnit && !lowerName.contains('jira import') && !lowerName.contains('collection')) {
                candidates << dir
            }
        }

        if (candidates.isEmpty()) {
            throw new RuntimeException('No main suite report folder with JUnit_Report.xml was found.')
        }

        candidates = candidates.sort { File a, File b ->
            b.lastModified() <=> a.lastModified()
        }

        return candidates[0]
    }

    private File findLatestRunFolder(File reportsRoot) {
        if (reportsRoot == null || !reportsRoot.exists()) {
            return null
        }

        List<File> folders = reportsRoot.listFiles()?.findAll { File file ->
            file.isDirectory()
        } ?: []

        if (folders.isEmpty()) {
            return null
        }

        folders = folders.sort { File a, File b ->
            b.lastModified() <=> a.lastModified()
        }

        return folders[0]
    }

    private File findJUnitXml(File reportFolder) {
        if (reportFolder == null || !reportFolder.exists()) {
            return null
        }

        List<File> xmls = []

        reportFolder.eachFileRecurse { File file ->
            if (file.isFile() && file.name.equalsIgnoreCase('JUnit_Report.xml')) {
                xmls << file
            }
        }

        if (xmls.isEmpty()) {
            return null
        }

        xmls = xmls.sort { File a, File b ->
            b.lastModified() <=> a.lastModified()
        }

        return xmls[0]
    }

    private String buildExecutionTitle(String suiteName, File latestRunFolder) {
        String formattedDate = new SimpleDateFormat('yyyy-MM-dd HH.mm.ss').format(new Date())

        if (latestRunFolder != null) {
            try {
                Date parsed = new SimpleDateFormat('yyyyMMdd_HHmmss').parse(latestRunFolder.name)
                formattedDate = new SimpleDateFormat('yyyy-MM-dd HH.mm.ss').format(parsed)
            } catch (Exception ignored) {
            }
        }

        return safe(suiteName) + ' ' + formattedDate
    }

    private void createZipFromFolder(File sourceFolder, File targetZip, List<String> excludedNames) {
        if (sourceFolder == null || !sourceFolder.exists()) {
            return
        }

        if (targetZip.exists()) {
            targetZip.delete()
        }

        ZipOutputStream zos = null

        try {
            zos = new ZipOutputStream(new FileOutputStream(targetZip))

            sourceFolder.eachFileRecurse { File file ->
                if (!file.isFile()) {
                    return
                }

                if (excludedNames?.contains(file.name)) {
                    return
                }

                String relativePath = sourceFolder.toPath().relativize(file.toPath()).toString().replace('\\', '/')
                ZipEntry entry = new ZipEntry(relativePath)
                zos.putNextEntry(entry)
                zos << file.bytes
                zos.closeEntry()
            }
        } finally {
            try {
                zos?.close()
            } catch (Exception ignored) {
            }
        }
    }

    private File createEvidencesZip(File sourceFolder) {
        if (sourceFolder == null || !sourceFolder.exists()) {
            return null
        }

        List<File> images = []

        sourceFolder.eachFileRecurse { File file ->
            if (!file.isFile()) {
                return
            }

            String name = safe(file.name).toLowerCase(Locale.ENGLISH)
            if (name.endsWith('.png') || name.endsWith('.jpg') || name.endsWith('.jpeg') || name.endsWith('.gif') || name.endsWith('.bmp') || name.endsWith('.webp')) {
                images << file
            }
        }

        if (images.isEmpty()) {
            return null
        }

        File zipFile = new File(sourceFolder, 'Evidences.zip')

        if (zipFile.exists()) {
            zipFile.delete()
        }

        ZipOutputStream zos = null

        try {
            zos = new ZipOutputStream(new FileOutputStream(zipFile))

            images.each { File file ->
                String relativePath = sourceFolder.toPath().relativize(file.toPath()).toString().replace('\\', '/')
                ZipEntry entry = new ZipEntry(relativePath)
                zos.putNextEntry(entry)
                zos << file.bytes
                zos.closeEntry()
            }
        } finally {
            try {
                zos?.close()
            } catch (Exception ignored) {
            }
        }

        return zipFile
    }

    private boolean blank(String value) {
        return safe(value).isEmpty()
    }

    private String safe(Object value) {
        return value == null ? '' : String.valueOf(value).trim()
    }
}
