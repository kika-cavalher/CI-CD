	@Keyword
	void validateOpenedTab(
		String openedTabName,
		Integer timeoutSeconds
	) {
		int safeTimeout = safeTimeout(timeoutSeconds, 60)

		WindowsTestObject tabObject =
			windowsObjectLoader.getTabByName(openedTabName)

		boolean opened = Windows.waitForElementPresent(
			tabObject,
			safeTimeout,
			FailureHandling.OPTIONAL
		)

		if (!opened) {
			KeywordUtil.markFailedAndStop(
				'Expected tab was not opened.\n' +
				'Tab: ' + safeText(openedTabName) + '\n' +
				'Timeout: ' + safeTimeout + ' seconds.'
			)
		}

		KeywordUtil.markPassed(
			'Opened tab validated: ' + openedTabName
		)
	}


