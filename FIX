	private WindowsDriver attachExistingWindowByHandle(Object handleValue) {
		String handleDec = safe(handleValue)

		if (!handleDec) {
			KeywordUtil.markFailedAndStop("Window handle is empty")
		}

		long handleLong
		try {
			handleLong = Long.parseLong(handleDec)
		} catch (Throwable ignored) {
			KeywordUtil.markFailedAndStop("Window handle is invalid: ${handleDec}")
			return null
		}

		String handleHex = Long.toHexString(handleLong).toUpperCase()
		URL serverUrl = new URL(DEFAULT_WINAPPDRIVER_URL)

		DesiredCapabilities caps = new DesiredCapabilities()
		caps.setCapability('platformName', 'Windows')
		caps.setCapability('deviceName', 'WindowsPC')
		caps.setCapability('appTopLevelWindow', handleHex)
		caps.setCapability('ms:waitForAppLaunch', '60')

		KeywordUtil.logInfo("Attaching by native handle ${handleHex} using ${serverUrl}")

		WindowsDriver driver = new WindowsDriver(serverUrl, caps)
		registerWindowsDriver(driver)
		return driver
	}

	private void registerWindowsDriver(WindowsDriver driver) {
		try {
			Class<?> factoryClass = Class.forName('com.kms.katalon.core.windows.driver.WindowsDriverFactory')

			def candidateMethods = ['changeWindowsDriver', 'changeDriver', 'setWindowsDriver']
			boolean methodInvoked = false

			for (String methodName : candidateMethods) {
				try {
					def method = factoryClass.methods.find { it.name == methodName && it.parameterCount == 1 }
					if (method != null) {
						method.invoke(null, driver)
						KeywordUtil.logInfo("Windows driver registered through ${methodName}")
						methodInvoked = true
						break
					}
				} catch (Throwable ignored) {
				}
			}

			try {
				def windowsSessionField = factoryClass.getDeclaredField('windowsSession')
				windowsSessionField.setAccessible(true)
				windowsSessionField.set(null, driver)
				KeywordUtil.logInfo("WindowsDriverFactory.windowsSession field updated")
			} catch (Throwable ignored) {
			}

			try {
				def windowsDriverField = factoryClass.getDeclaredField('windowsDriver')
				windowsDriverField.setAccessible(true)
				windowsDriverField.set(null, driver)
				KeywordUtil.logInfo("WindowsDriverFactory.windowsDriver field updated")
			} catch (Throwable ignored) {
			}

			try {
				DriverFactory.changeWebDriver(driver)
				KeywordUtil.logInfo("DriverFactory.changeWebDriver also updated")
			} catch (Throwable ignored) {
			}

			if (!methodInvoked) {
				KeywordUtil.logInfo("No public WindowsDriverFactory change method found. Session fields were updated directly.")
			}
		} catch (Throwable t) {
			KeywordUtil.markFailedAndStop("Could not register Windows driver session: ${safe(t.message)}")
		}
	}

