        try {
            def direct = GlobalVariable.JIRA_TOKEN
            if (!isBlank(direct)) {
                return safe(direct)
            }
        } catch (Exception ignored) {
        }

        try {
            def fallback = GlobalVariable.token
            if (!isBlank(fallback)) {
                return safe(fallback)
            }
        } catch (Exception ignored) {
        }

        return safe(owner.JIRA_TOKEN)
    }

    void validateRequiredConfiguration() {
        List<String> missing = []

        if (isBlank(resolveToken())) {
            missing << 'JIRA token'
        }
        if (isBlank(owner.PROJECT_KEY)) {
            missing << 'PROJECT_KEY'
        }
        if (isBlank(owner.JIRA_BASE_URL)) {
            missing << 'JIRA_BASE_URL'
        }

