pipeline {
    agent {
        node {
            // Use the same Jenkins agent every time
            label 'GI5_SWDCFRNXGI55817'

            // Force the same workspace path to avoid @2, @3 and temp workspaces
            customWorkspace 'D:\\jenkins\\work\\workspace\\GI5\\Gaia\\Gaia_Corrections'
        }
    }

    options {
        // Add timestamps to all log lines
        timestamps()

        // Enable ANSI colors in console
        ansiColor('xterm')

        // Prevent parallel executions of the same pipeline
        disableConcurrentBuilds()

        // Global timeout for the whole pipeline
        timeout(time: 75, unit: 'MINUTES')

        // Keep a small build history
        buildDiscarder(logRotator(numToKeepStr: '10', daysToKeepStr: '14'))

        // Checkout will be done manually
        skipDefaultCheckout(true)
    }

    parameters {
        string(
            name: 'STARTUP_WAIT_SECONDS',
            defaultValue: '60',
            description: 'Seconds to wait after Gaia startup'
        )

        string(
            name: 'SUITE_TIMEOUT_MINUTES',
            defaultValue: '10',
            description: 'Maximum minutes for each suite'
        )
    }

    environment {
        // Fixed workspace and project paths
        WORK_DIR = 'D:\\jenkins\\work\\workspace\\GI5\\Gaia\\Gaia_Corrections'
        PROJECT_PATH = 'D:\\jenkins\\work\\workspace\\GI5\\Gaia\\Gaia_Corrections\\gaia-portal.prj'
        REPORTS_DIR = 'Reports'

        // Katalon engine location
        KATALON_HOME = 'C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0'

        // Git repository configuration
        GIT_URL = 'https://bitbucket-mut.mycloud.intrabpce.fr/scm/gi5/gaia-portal.git'
        GIT_CRED = '965eceec-b3a3-4ec5-8820-a857c87dd80f'

        // Scheduled tasks
        GAIA_START_TASK = 'GaiaBackFrontSetup'
        VISIBLE_TASK_NAME = 'GaiaKatalon_Visible'

        // Fixed visible execution files
        RUNNER_BAT = 'C:\\Gaia\\run_katalon_visible_from_jenkins.bat'
        STATUS_FILE = 'C:\\Gaia\\gaia_visible_status.txt'
    }

    stages {
        stage('Prepare Environment') {
            steps {
                script {
                    echo '========================================'
                    echo 'Starting Gaia pipeline'
                    echo "Build Number : ${env.BUILD_NUMBER}"
                    echo "Node         : ${env.NODE_NAME}"
                    echo "Workspace    : ${env.WORKSPACE}"
                    echo "Work Dir     : ${env.WORK_DIR}"
                    echo "Project Path : ${env.PROJECT_PATH}"
                    echo 'Run Mode     : VISIBLE'
                    echo '========================================'
                }

                bat """
                    @echo off
                    REM Clean reports folder before execution
                    if exist "${env.WORK_DIR}\\${env.REPORTS_DIR}" rmdir /s /q "${env.WORK_DIR}\\${env.REPORTS_DIR}"
                    mkdir "${env.WORK_DIR}\\${env.REPORTS_DIR}"

                    REM Remove old visible status file
                    if exist "${env.STATUS_FILE}" del /f /q "${env.STATUS_FILE}" >nul 2>&1

                    exit /b 0
                """
            }
        }

        stage('Start Gaia Backend and Frontend') {
            steps {
                bat """
                    @echo off
                    REM Trigger backend and frontend startup task
                    schtasks /run /tn "${env.GAIA_START_TASK}"
                    exit /b 0
                """

                script {
                    echo "Waiting ${params.STARTUP_WAIT_SECONDS} seconds for Gaia startup..."
                }

                sleep(time: params.STARTUP_WAIT_SECONDS.toInteger(), unit: 'SECONDS')
            }
        }

        stage('Checkout Repository') {
            steps {
                dir("${env.WORK_DIR}") {
                    // Clean only the current fixed workspace
                    deleteDir()

                    // Checkout master branch into the same workspace
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/master']],
                        userRemoteConfigs: [[url: env.GIT_URL, credentialsId: env.GIT_CRED]],
                        extensions: [
                            [$class: 'WipeWorkspace'],
                            [$class: 'CloneOption', shallow: false, noTags: false, timeout: 30]
                        ]
                    ])
                }

                script {
                    echo 'Checkout completed successfully'
                }
            }
        }

        stage('Execute Gaia Suites Separately') {
            steps {
                script {
                    // Execute each suite separately
                    // If one suite fails, continue to the next one
                    def suites = [
                        [name: 'PreLoad',                path: 'Test Suites/PreLoad'],
                        [name: 'Help',                   path: 'Test Suites/Help'],
                        [name: 'AddCorrection',          path: 'Test Suites/AddCorrection'],
                        [name: 'ComputationSelection',   path: 'Test Suites/Computation Selection'],
                        [name: 'CorrectedDuplication',   path: 'Test Suites/CorrectedDuplication'],
                        [name: 'CorrectionDetails',      path: 'Test Suites/CorrectionDetails'],
                        [name: 'DownloadInvalidRecords', path: 'Test Suites/DownloadInvalidRecords']
                    ]

                    for (suite in suites) {
                        catchError(
                            buildResult: 'UNSTABLE',
                            stageResult: 'FAILURE',
                            catchInterruptions: false
                        ) {
                            timeout(time: params.SUITE_TIMEOUT_MINUTES.toInteger(), unit: 'MINUTES') {
                                runVisibleGaiaSuite(suite)
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Archiving reports...'

            archiveArtifacts artifacts: 'Reports/**/*', allowEmptyArchive: true, excludes: '**/*.lck'

            catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE', catchInterruptions: false) {
                junit allowEmptyResults: true, testResults: 'Reports/**/JUnit_Report.xml, Reports/**/junit*.xml, Reports/**/TEST-*.xml'
            }
        }

        success {
            echo 'SUCCESS: Pipeline finished successfully'
        }

        unstable {
            echo 'UNSTABLE: Some suites failed, but execution continued'
        }

        failure {
            echo 'FAILURE: Pipeline failed'
        }

        aborted {
            echo 'ABORTED: Pipeline was canceled by user'
        }
    }
}

/**
 * Rebuild the same runner batch for the current suite,
 * trigger the visible scheduled task,
 * wait for the status file,
 * and continue to the next suite if this one fails.
 */
def runVisibleGaiaSuite(Map suite) {
    def reportPath = "${env.WORK_DIR}\\${env.REPORTS_DIR}\\${suite.name}"

    echo '========================================'
    echo 'Starting suite execution'
    echo "Suite Name   : ${suite.name}"
    echo "Suite Path   : ${suite.path}"
    echo "Run Mode     : VISIBLE"
    echo "Project Path : ${env.PROJECT_PATH}"
    echo "Report Path  : ${reportPath}"
    echo '========================================'

    bat """
        @echo off
        REM Recreate the report folder for the current suite
        if exist "${reportPath}" rmdir /s /q "${reportPath}"
        mkdir "${reportPath}"

        REM Remove previous status file before starting the new suite
        if exist "${env.STATUS_FILE}" del /f /q "${env.STATUS_FILE}" >nul 2>&1

        exit /b 0
    """

    def runnerContent = """@echo off
setlocal
title GAIA_VISIBLE_RUNNER

set STATUS_FILE=C:\\Gaia\\gaia_visible_status.txt

if exist "%STATUS_FILE%" del /f /q "%STATUS_FILE%"

call "C:\\Gaia\\set_java_17_gaia.bat"

cd /d "${env.WORK_DIR}"

echo Current folder:
cd

echo Starting Katalon...

"${env.KATALON_HOME}\\katalonc.exe" ^
-projectPath="${env.PROJECT_PATH}" ^
-testSuitePath="${suite.path}" ^
-browserType="Chrome" ^
-consoleLog ^
-logLevel=DEBUG ^
-reportFolder="${reportPath}"

set EXIT_CODE=%ERRORLEVEL%
echo EXIT_CODE=%EXIT_CODE%>"%STATUS_FILE%"

echo Finished with code %EXIT_CODE%
exit /b %EXIT_CODE%
"""

    writeFile file: 'run_katalon_visible_from_jenkins_local.bat', text: runnerContent

    bat """
        @echo off
        REM Copy the suite-specific runner to the fixed visible runner path
        copy /Y "${env.WORK_DIR}\\run_katalon_visible_from_jenkins_local.bat" "${env.RUNNER_BAT}" >nul

        echo ===== FILE CREATED IN C:\\Gaia =====
        type "${env.RUNNER_BAT}"
        echo ====================================

        REM Trigger the visible scheduled task
        schtasks /run /tn "${env.VISIBLE_TASK_NAME}"

        exit /b 0
    """

    powershell """
        \$statusFile = "${env.STATUS_FILE}"
        \$timeoutSeconds = ${params.SUITE_TIMEOUT_MINUTES.toInteger() * 60}
        \$start = Get-Date

        Write-Host "Waiting for visible suite: ${suite.name}"

        while (-not (Test-Path \$statusFile)) {
            if (((Get-Date) - \$start).TotalSeconds -ge \$timeoutSeconds) {
                Write-Error "Timeout waiting for visible suite ${suite.name}"
                exit 1
            }

            Start-Sleep -Seconds 2
        }

        Write-Host "Status file found for suite: ${suite.name}"
        Get-Content \$statusFile
    """

    def exitCode = bat(
        returnStdout: true,
        script: """
            @echo off
            if not exist "${env.STATUS_FILE}" (
                echo 999
                exit /b 0
            )

            for /f "tokens=2 delims==" %%A in ('type "${env.STATUS_FILE}" ^| findstr /B "EXIT_CODE="') do echo %%A
            exit /b 0
        """
    ).trim()

    echo "Visible suite exit code for ${suite.name}: ${exitCode}"

    if (exitCode != '0') {
        error("Suite ${suite.name} failed with exit code ${exitCode}")
    }

    echo "Visible suite finished successfully: ${suite.name}"
}
