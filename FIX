@echo off
setlocal EnableExtensions

set "TARGET_ENV=%~1"
if not defined TARGET_ENV set "TARGET_ENV=REC"

if /I "%TARGET_ENV%"=="REC" (
    set "LAUNCHER=D:\RecEmatchAsUser.bat"
    set "WINDOW_TITLE=eMatch - Login REC"
) else if /I "%TARGET_ENV%"=="PRD" (
    set "LAUNCHER=D:\ProdEmatchAsUser.bat"
    set "WINDOW_TITLE=eMatch - Login PRD"
) else (
    echo [ERROR] Invalid environment: %TARGET_ENV%
    echo [ERROR] Valid values: REC or PRD
    exit /b 1
)

set "RESOLUTION_SCRIPT=D:\setResolution.ps1"

echo [INFO] ==========================================
echo [INFO] Environment : %TARGET_ENV%
echo [INFO] Launcher    : %LAUNCHER%
echo [INFO] Window      : %WINDOW_TITLE%
echo [INFO] ==========================================

if exist "%RESOLUTION_SCRIPT%" (
    echo [INFO] Running resolution script...
    powershell -ExecutionPolicy Bypass -File "%RESOLUTION_SCRIPT%"
)

timeout /t 2 /nobreak >nul

if not exist "%LAUNCHER%" (
    echo [ERROR] Launcher not found: %LAUNCHER%
    exit /b 1
)

call "%LAUNCHER%"
set "RC=%ERRORLEVEL%"

if not "%RC%"=="0" (
    echo [ERROR] Launcher returned %RC%
    exit /b %RC%
)

echo [INFO] Waiting for window to appear...

powershell -NoProfile -Command "$deadline=(Get-Date).AddSeconds(120); do { $p=Get-Process | Where-Object { $_.MainWindowTitle -like '*%WINDOW_TITLE%*' }; if ($p) { exit 0 }; Start-Sleep -Seconds 2 } while ((Get-Date) -lt $deadline); exit 1"

if errorlevel 1 (
    echo [ERROR] Window did not appear: %WINDOW_TITLE%
    exit /b 1
)

echo [SUCCESS] Window detected: %WINDOW_TITLE%
exit /b 0




