package pageObject

import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import java.net.Socket

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import groovy.io.FileType
import internal.GlobalVariable

class authentication {

    private String gv(String name) {
        try {
            def value = GlobalVariable."${name}"
            return value == null ? '' : value.toString().trim()
        } catch (Throwable ignored) {
            return ''
        }
    }

    private String firstNonBlank(String... values) {
        for (String value : values) {
            if (value != null && value.toString().trim()) {
                return value.toString().trim()
            }
        }
        return ''
    }

    private String currentEnv() {
        String raw = firstNonBlank(
            gv('env'),
            gv('environment'),
            'REC'
        ).toUpperCase()

        if (raw == 'PRD') {
            return 'PROD'
        }

        if (raw in ['REC', 'PTS', 'PROD']) {
            return raw
        }

        return 'REC'
    }

    private String envFolder(String env) {
        switch (env) {
            case 'PROD':
                return 'PROD'
            case 'PTS':
                return 'PTS'
            default:
                return 'REC'
        }
    }

    private String envShortcutFileName(String env) {
        switch (env) {
            case 'PROD':
                return 'eMatch PROD.appref-ms'
            case 'PTS':
                return 'eMatch PTS.appref-ms'
            default:
                return 'eMatch REC.appref-ms'
        }
    }

    private String resolveVersionToken(String env) {
        switch (env) {
            case 'PROD':
                return firstNonBlank(
                    gv('versionProd'),
                    gv('versionPRD'),
                    gv('versionPROD'),
                    gv('version')
                )
            case 'PTS':
                return firstNonBlank(
                    gv('versionPts'),
                    gv('versionPTS'),
                    gv('version')
                )
            default:
                return firstNonBlank(
                    gv('versionRec'),
                    gv('versionREC'),
                    gv('version')
                )
        }
    }

    private boolean isPortOpen(String host, int port, int timeoutMs = 1000) {
        try {
            Socket socket = new Socket()
            socket.connect(new InetSocketAddress(host, port), timeoutMs)
            socket.close()
            return true
        } catch (Throwable ignored) {
            return false
        }
    }

    private boolean isWinAppDriverRunning() {
        return isPortOpen('127.0.0.1', 4723, 1000)
    }

    private void ensureWinAppDriverStarted() {
        if (isWinAppDriverRunning()) {
            KeywordUtil.logInfo('WinAppDriver already running on 127.0.0.1:4723')
            return
        }

        String exePath = getWinAppDriverPath()
        if (!exePath) {
            throw new Exception('WinAppDriver path is empty.')
        }

        File exe = new File(exePath)
        if (!exe.exists()) {
            throw new Exception("WinAppDriver executable not found at: ${exePath}")
        }

        KeywordUtil.logInfo("Starting WinAppDriver from: ${exePath}")
        new ProcessBuilder(exePath)
            .redirectErrorStream(true)
            .start()

        int retries = 20
        for (int i = 1; i <= retries; i++) {
            if (isWinAppDriverRunning()) {
                KeywordUtil.logInfo("WinAppDriver started successfully on attempt ${i}")
                Windows.delay(1)
                return
            }
            Windows.delay(1)
        }

        throw new Exception("WinAppDriver did not start on 127.0.0.1:4723 using path: ${exePath}")
    }

    private boolean tryAttach(String targetWindowTitle, int attempts, int delaySeconds) {
        Exception lastError = null

        for (int i = 1; i <= attempts; i++) {
            try {
                Windows.switchToWindowTitle(targetWindowTitle)
                KeywordUtil.logInfo("Attached to window '${targetWindowTitle}' on attempt ${i}")
                return true
            } catch (Exception e) {
                lastError = e
                KeywordUtil.logInfo("Window '${targetWindowTitle}' not attached yet on attempt ${i}: ${e.message}")
                Windows.delay(delaySeconds)
            }
        }

        if (lastError != null) {
            KeywordUtil.logInfo("Final attach error for '${targetWindowTitle}': ${lastError.message}")
        }

        return false
    }

    private List<String> buildLaunchTargets() {
        List<String> targets = []

        String installedExe = getInstalledExePath()
        String shortcut = getShortcutPath()
        String application = getApplicationPath()

        if (installedExe) {
            targets << installedExe
        }

        if (shortcut) {
            targets << shortcut
        }

        if (application) {
            targets << application
        }

        return targets.findAll { it != null && it.toString().trim() }.unique()
    }

    @Keyword
    String getCurrentWindowsUser() {
        return firstNonBlank(
            System.getProperty('user.name'),
            System.getenv('USERNAME')
        )
    }

    @Keyword
    String resolveWindowTitle() {
        String env = currentEnv()
        String versionToken = resolveVersionToken(env)

        if (!versionToken) {
            throw new Exception("No version variable found for environment '${env}'.")
        }

        if (versionToken.toLowerCase().startsWith('ematch')) {
            return versionToken
        }

        return "eMatch ${versionToken}".trim()
    }

    @Keyword
    String getShortcutPath() {
        String env = currentEnv()

        String configuredPath = ''
        switch (env) {
            case 'PROD':
                configuredPath = firstNonBlank(
                    gv('shortcutPathProd'),
                    gv('shortcutPathPRD'),
                    gv('shortcutPathPROD')
                )
                break
            case 'PTS':
                configuredPath = firstNonBlank(
                    gv('shortcutPathPts'),
                    gv('shortcutPathPTS')
                )
                break
            default:
                configuredPath = firstNonBlank(
                    gv('shortcutPathRec'),
                    gv('shortcutPathREC')
                )
                break
        }

        if (configuredPath) {
            return configuredPath
        }

        String user = getCurrentWindowsUser()
        return "C:\\Users\\${user}\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\NATIXIS\\${envShortcutFileName(env)}"
    }

    @Keyword
    String getApplicationPath() {
        String env = currentEnv()

        String configuredPath = ''
        switch (env) {
            case 'PROD':
                configuredPath = firstNonBlank(
                    gv('applicationPathProd'),
                    gv('applicationPathPRD'),
                    gv('applicationPathPROD')
                )
                break
            case 'PTS':
                configuredPath = firstNonBlank(
                    gv('applicationPathPts'),
                    gv('applicationPathPTS')
                )
                break
            default:
                configuredPath = firstNonBlank(
                    gv('applicationPathRec'),
                    gv('applicationPathREC')
                )
                break
        }

        if (configuredPath) {
            return configuredPath
        }

        return "\\\\cib.net\\shareparis\\Soft\\ematch\\IHM\\Livraisons\\${envFolder(env)}\\IXIS.eMatch.IHM.application"
    }

    @Keyword
    String getInstalledExePath() {
        String configuredPath = firstNonBlank(
            gv('installedExePath'),
            gv('localInstalledExe'),
            gv('applicationExePath')
        )

        if (configuredPath) {
            return configuredPath
        }

        String localAppData = System.getenv('LOCALAPPDATA')
        if (!localAppData) {
            return ''
        }

        File root = new File(localAppData, 'Apps\\2.0')
        if (!root.exists()) {
            return ''
        }

        String found = ''
        root.eachFileRecurse(FileType.FILES) { File file ->
            if (!found && file.name.equalsIgnoreCase('IXIS.eMatch.IHM.exe')) {
                found = file.absolutePath
            }
        }

        return found
    }

    @Keyword
    String getResolutionScriptPath() {
        return firstNonBlank(
            gv('resolutionScriptPath'),
            'D:\\Projects\\eMatchStarters\\set-resolution.ps1'
        )
    }

    @Keyword
    String getWinAppDriverPath() {
        return firstNonBlank(
            gv('winAppDriverPath'),
            'C:\\Program Files (x86)\\Windows Application Driver\\WinAppDriver.exe'
        )
    }

    @Keyword
    String getLauncherBat() {
        String env = currentEnv()

        switch (env) {
            case 'PROD':
                return firstNonBlank(
                    gv('launcherBatProd'),
                    gv('launcherBatPRD'),
                    gv('launcherBatPROD'),
                    'D:\\Projects\\eMatchStarters\\runAsEMatchPRD\\eMatch.bat'
                )
            case 'PTS':
                return firstNonBlank(
                    gv('launcherBatPts'),
                    gv('launcherBatPTS'),
                    'D:\\Projects\\eMatchStarters\\runAsEMatchPTS\\eMatch.bat'
                )
            default:
                return firstNonBlank(
                    gv('launcherBatRec'),
                    gv('launcherBatREC'),
                    'D:\\Projects\\eMatchStarters\\runAsEMatchREC\\eMatch.bat'
                )
        }
    }

    @Keyword
    boolean startEMatch(String currentUser, String targetWindowTitle) {
        String env = currentEnv()
        List<String> launchTargets = buildLaunchTargets()
        Exception lastError = null

        KeywordUtil.logInfo("Starting eMatch for environment: ${env}")
        KeywordUtil.logInfo("Current Windows user: ${currentUser}")
        KeywordUtil.logInfo("Target window title: ${targetWindowTitle}")
        KeywordUtil.logInfo("Shortcut path: ${getShortcutPath()}")
        KeywordUtil.logInfo("Application path: ${getApplicationPath()}")
        KeywordUtil.logInfo("Installed exe path: ${getInstalledExePath()}")

        ensureWinAppDriverStarted()

        if (tryAttach(targetWindowTitle, 2, 2)) {
            KeywordUtil.logInfo("Target window already attached before launch.")
            return true
        }

        if (launchTargets.isEmpty()) {
            throw new Exception("No launch target was resolved for environment '${env}'.")
        }

        for (String launchTarget : launchTargets) {
            try {
                KeywordUtil.logInfo("Trying launch target: ${launchTarget}")
                Windows.startApplicationWithTitle(launchTarget, targetWindowTitle)
                Windows.delay(8)

                if (tryAttach(targetWindowTitle, 12, 3)) {
                    KeywordUtil.logInfo("eMatch launched successfully using: ${launchTarget}")
                    return true
                }
            } catch (Exception e) {
                lastError = e
                KeywordUtil.logInfo("Launch failed with '${launchTarget}': ${e.message}")
                Windows.delay(5)
            }
        }

        throw new Exception(
            "Unable to launch eMatch window '${targetWindowTitle}'. " +
            "Tried: ${launchTargets.join(' | ')}. " +
            "Last error: ${lastError?.message}"
        )
    }

    @Keyword
    boolean attachToLoginWindow(String targetWindowTitle) {
        ensureWinAppDriverStarted()

        boolean attached = tryAttach(targetWindowTitle, 40, 3)

        if (!attached) {
            throw new Exception("Unable to attach to login window '${targetWindowTitle}' after multiple attempts.")
        }

        return true
    }

    @Keyword
    boolean openEnvironmentDropdown() {
        Exception lastError = null
        List<String> candidateObjects = [
            'Object Repository/Login Page/optEnv',
            'Login Page/optEnv'
        ]

        for (String objectId : candidateObjects) {
            try {
                KeywordUtil.logInfo("Trying to click environment dropdown using object: ${objectId}")
                Windows.click(findWindowsObject(objectId))
                KeywordUtil.logInfo("Environment dropdown opened successfully.")
                return true
            } catch (Exception e) {
                lastError = e
                KeywordUtil.logInfo("Dropdown click failed with '${objectId}': ${e.message}")
            }
        }

        throw new Exception("Unable to open environment dropdown. Last error: ${lastError?.message}")
    }

    @Keyword
    int resolveEnvironmentIndex(String envName) {
        String env = (envName ?: '').trim().toUpperCase()

        switch (env) {
            case 'REC':
                return 1
            case 'PTS':
                return 2
            case 'PROD':
            case 'PRD':
                return 3
            default:
                return 1
        }
    }

    @Keyword
    boolean selectEnvironment(String envName) {
        KeywordUtil.logInfo("Selecting environment: ${envName}")
        return true
    }

    @Keyword
    boolean isConnectButtonPresent() {
        try {
            return Windows.verifyElementPresent(findWindowsObject('Object Repository/Login Page/btnConnect'), 5, FailureHandling.OPTIONAL)
        } catch (Throwable ignored) {
            return false
        }
    }

    @Keyword
    boolean clickConnectButton() {
        Windows.click(findWindowsObject('Object Repository/Login Page/btnConnect'))
        return true
    }

    @Keyword
    boolean waitForMainScreen() {
        try {
            return Windows.verifyElementPresent(findWindowsObject('Object Repository/General/txtSearch'), 30, FailureHandling.OPTIONAL)
        } catch (Throwable ignored) {
            return false
        }
    }

    @Keyword
    boolean activateHomeTab() {
        KeywordUtil.logInfo('Activating Home tab')
        return true
    }
}
