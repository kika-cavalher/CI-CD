import java.util.Locale

import com.kms.katalon.core.annotation.AfterTestCase
import com.kms.katalon.core.annotation.AfterTestSuite
import com.kms.katalon.core.annotation.BeforeTestCase
import com.kms.katalon.core.annotation.BeforeTestSuite
import com.kms.katalon.core.context.TestCaseContext
import com.kms.katalon.core.context.TestSuiteContext
import com.kms.katalon.core.util.KeywordUtil

class ematchReport {

    @BeforeTestSuite
    def beforeTestSuite(TestSuiteContext testSuiteContext) {
        try {
            CustomKeywords.'jiraIntegration.JiraReportSteps.reset'()
            CustomKeywords.'jiraIntegration.JiraReportSteps.setSuiteName'(cleanSuiteName(testSuiteContext?.getTestSuiteId()))
        } catch (Throwable t) {
            KeywordUtil.logInfo('[REPORT_LISTENER] beforeTestSuite failed: ' + safe(t.getMessage()))
        }
    }

    @BeforeTestCase
    def beforeTestCase(TestCaseContext testCaseContext) {
        try {
            String caseId = safe(testCaseContext?.getTestCaseId())
            CustomKeywords.'jiraIntegration.JiraReportSteps.startCase'(caseId)
        } catch (Throwable t) {
            KeywordUtil.logInfo('[REPORT_LISTENER] beforeTestCase failed: ' + safe(t.getMessage()))
        }
    }

    @AfterTestCase
    def afterTestCase(TestCaseContext testCaseContext) {
        String caseId = safe(testCaseContext?.getTestCaseId())
        String rawStatus = safe(testCaseContext?.getTestCaseStatus())
        String rawMessage = safe(testCaseContext?.getMessage())
        String finalStatus = normalizeStatus(caseId, rawStatus, rawMessage)

        try {
            if ('FAILED'.equals(finalStatus)) {
                CustomKeywords.'jiraIntegration.JiraReportSteps.fail'(rawMessage)
                CustomKeywords.'jiraIntegration.JiraImagesEvidence.autoFailure'(caseId)
            }

            CustomKeywords.'jiraIntegration.JiraReportSteps.finishCase'(finalStatus)
        } catch (Throwable t) {
            KeywordUtil.logInfo('[REPORT_LISTENER] afterTestCase processing failed: ' + safe(t.getMessage()))
        }

        try {
            CustomKeywords.'jiraIntegration.JiraHtmlReportBuilder.buildReport'()
        } catch (Throwable t) {
            KeywordUtil.logInfo('[REPORT_LISTENER] HTML refresh failed: ' + safe(t.getMessage()))
        }
    }

    @AfterTestSuite
    def afterTestSuite(TestSuiteContext testSuiteContext) {
        try {
            CustomKeywords.'jiraIntegration.JiraHtmlReportBuilder.buildReport'()
        } catch (Throwable t) {
            KeywordUtil.logInfo('[REPORT_LISTENER] afterTestSuite failed: ' + safe(t.getMessage()))
        }
    }

    private String normalizeStatus(String caseId, String rawStatus, String rawMessage) {
        String status = safe(rawStatus).toUpperCase(Locale.ENGLISH)

        if (status in ['FAILED', 'FAIL', 'ERROR']) {
            return 'FAILED'
        }

        if (status in ['SKIPPED', 'BLOCKED']) {
            return 'BLOCKED'
        }

        boolean storedFailure = false
        try {
            storedFailure = CustomKeywords.'jiraIntegration.JiraReportSteps.caseHasFailure'(caseId)
        } catch (Throwable ignored) {
            storedFailure = false
        }

        if (storedFailure) {
            return 'FAILED'
        }

        if (!safe(rawMessage).isEmpty() && !'PASSED'.equals(status)) {
            return 'FAILED'
        }

        return 'PASSED'
    }

    private String cleanSuiteName(String suiteId) {
        String value = safe(suiteId)
        if (value.startsWith('Test Suites/')) {
            return value.substring('Test Suites/'.length())
        }
        return value
    }

    private String safe(Object value) {
        return value == null ? '' : String.valueOf(value).trim()
    }
}
