	@Keyword
	def checkForRows() {
		//Returns number of rows if displayed in screen, otherwise returns 0
		String env
		try {
			env = Windows.getText(findWindowsObject('Object Repository/General/curEnv'));
		} catch (Exception e) {
			Windows.delay(30)
			String envImg = new File(RunConfiguration.getProjectDir(), 'Images/General/envImage.PNG').getAbsolutePath();
			def a = WindowsImageKeywords.findImage(envImg)
			if(a==true) {
				env='REC'
			}else {
				env='PROD'
			}
		}

		if (Windows.verifyElementPresent(findWindowsObject('Object Repository/Acapulco/txtLineCount'), 15, FailureHandling.OPTIONAL)) {
			String rows = Windows.getText(findWindowsObject('Object Repository/Acapulco/txtLineCount'));
			WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession()).takeScreenshot(RunConfiguration.getReportFolder() + '\\Evidences\\' + env + '_Rows.PNG');
			if (rows.replaceAll("\\D+","").length() == 0) return 0;
			else return rows.replaceAll("\\D+","").toInteger();
		}
		WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession()).takeScreenshot(RunConfiguration.getReportFolder() + '\\Evidences\\' + env + '_Rows.PNG');
		return 0;
	}

	@Keyword
	def saveToPath() {

		//Save file inside Report folder as Evidence
		Robot robot = new Robot();
		Windows.click(findWindowsObject('Object Repository/Acapulco/filePath'));
		Windows.delay(2);
		String directory = RunConfiguration.getReportFolder() + '\\Evidences';
		StringSelection ss = new StringSelection(directory);
		Toolkit.getDefaultToolkit().getSystemClipboard().setContents(ss, null);
		Windows.delay(2);
		robot.keyPress(KeyEvent.VK_CONTROL);
		robot.keyPress(KeyEvent.VK_V);
		robot.keyRelease(KeyEvent.VK_V);
		robot.keyRelease(KeyEvent.VK_CONTROL);
		robot.keyPress(KeyEvent.VK_ENTER);
		robot.keyRelease(KeyEvent.VK_ENTER);

		Windows.click(findWindowsObject('General/btnSave'));

		Windows.delay(5);

		ImageLoader imageLoader = new ImageLoader()
		Map<String, String> imagesGeneral = imageLoader.loadImagesGeneral()
		def yesImage1 = imagesGeneral.yesEn
		def yesImage2 = imagesGeneral.yesUnderline

		int maxWaitTime = 20
		int delayInterval = 2
		int elapsedTime = 0
		boolean imageFound = false

		while (elapsedTime < maxWaitTime) {
			if (WindowsImageKeywords.findImage(yesImage1)) {
				WindowsImageKeywords.clickImage(yesImage1)
				KeywordUtil.logInfo("Clicked on the 'Yes' image (yesEn).")
				imageFound = true
				break
			} else if (WindowsImageKeywords.findImage(yesImage2)) {
				WindowsImageKeywords.clickImage(yesImage2)
				KeywordUtil.logInfo("Clicked on the 'Yes' image (yesUnderline).")
				imageFound = true
				break
			}
			Windows.delay(delayInterval)
			elapsedTime += delayInterval
		}

		if (!imageFound) {
			KeywordUtil.logInfo("The 'Yes' image was not found within the timeout period. Proceeding without clicking 'Yes'.")
		}
	}

