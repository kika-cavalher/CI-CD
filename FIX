@echo off
setlocal EnableExtensions

set "RUNAS_USER=cib\cavalheren"
set "EMATCH_APP=\\cib.net\shareparis\Soft\ematch\IHM\PROD\IXIS.Ematch.IHM.application"

runas /user:"%RUNAS_USER%" /savecred "\"C:\Windows\Microsoft.NET\Framework\v4.0.30319\dfsvc.exe\""
timeout /t 2 /nobreak >nul
runas /user:"%RUNAS_USER%" /savecred "\"C:\Windows\System32\rundll32.exe\" \"C:\Windows\System32\dfshim.dll\",ShOpenVerbApplication \"%EMATCH_APP%\""

exit /b %errorlevel%






@echo off
setlocal EnableExtensions

set "TARGET_ENV=%~1"
if not defined TARGET_ENV set "TARGET_ENV=%EMATCH_ENV%"
if not defined TARGET_ENV set "TARGET_ENV=REC"

if /I "%TARGET_ENV%"=="REC" (
    set "LAUNCHER=D:\RecEmatchAsUser.bat"
) else if /I "%TARGET_ENV%"=="PRD" (
    set "LAUNCHER=D:\ProdEmatchAsUser.bat"
) else (
    echo [ERROR] Invalid environment: %TARGET_ENV%
    echo [ERROR] Use REC or PRD
    exit /b 1
)

set "RESOLUTION_SCRIPT=D:\setResolution.ps1"

echo [INFO] Environment: %TARGET_ENV%
echo [INFO] Launcher   : %LAUNCHER%

if exist "%RESOLUTION_SCRIPT%" (
    powershell -ExecutionPolicy Bypass -File "%RESOLUTION_SCRIPT%"
)

timeout /t 2 /nobreak >nul

if not exist "%LAUNCHER%" (
    echo [ERROR] Launcher not found: %LAUNCHER%
    exit /b 1
)

call "%LAUNCHER%"
set "RC=%ERRORLEVEL%"

if not "%RC%"=="0" (
    echo [ERROR] Launcher returned %RC%
    exit /b %RC%
)

echo [INFO] Waiting for eMatch window...

powershell -NoProfile -Command ^
"$deadline=(Get-Date).AddSeconds(120);" ^
"do {" ^
"  $p=Get-Process | Where-Object { $_.MainWindowTitle -like '*eMatch*' };" ^
"  if ($p) { exit 0 }" ^
"  Start-Sleep -Seconds 2" ^
"} while ((Get-Date) -lt $deadline);" ^
"exit 1"

if errorlevel 1 (
    echo [ERROR] eMatch window did not appear
    exit /b 1
)

echo [SUCCESS] eMatch window detected
exit /b 0


/c "D:\Projects\eMatchStarters\run-ematch-command.bat REC"





