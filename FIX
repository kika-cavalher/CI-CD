''')
}

def runCollection = { Map item ->
    stage(item.stageName) {
        try {
            timeout(time: 5, unit: 'HOURS') {
                int rc = bat(
                    returnStatus: true,
                    script: """@echo off
call "${env.WORKSPACE}\\jenkins\\${item.cmdFile}"
"""
                )

                echo "${item.stageName} wrapper exit code: ${rc}"
                if (rc != 0) {
                    echo "${item.stageName} finished with wrapper issues, but pipeline will continue."
                } else {
                    echo "${item.stageName} completed successfully."
                }
            }
        } catch (Throwable err) {
            echo "${item.stageName} raised an exception, but pipeline will continue."
            echo "${err.toString()}"
        }
    }

    stage("Stop ${item.stageName}") {
        stopVisibleExecution()
    }
}

node(NODE_LABEL) {
    ws(SHORT_WORKSPACE) {
        stage('Checkout') {
            deleteDir()
            checkout scm
        }

        collections.each { item ->
            runCollection(item)
        }
    }
}

stage('Trigger next pipeline') {
