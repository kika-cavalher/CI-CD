import static com.kms.katalon.core.testcase.TestCaseFactory.findTestCase

import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows


// ======================================================
// MODULE CONFIG
// ======================================================

String targetEnvironment = 'REC'
String language = 'fr'

String favoriteTitle = 'Katalon Fav Test'
String favoriteImageKey = 'katalonCreatedFavorite'
String filterValue = '10E'

String configurationMenuName =
	language.equalsIgnoreCase('fr')
		? 'Liste des périmètres'
		: 'List of perimeters'

String configurationMenuResultName =
	configurationMenuName

String configurationFormObjectKey =
	'listePerimetresForm'

String loginTestCase =
	'Component/Authentication/Login ' +
	targetEnvironment

String closeApplicationTestCase =
	'Component/Authentication/Close Application'


// ======================================================
// TIMEOUT CONFIG
// ======================================================

Integer landingPageTimeout = 5
Integer menuTimeout = 20
Integer configurationFormTimeout = 10
Integer filterTimeout = 5
Integer favoriteControlTimeout = 4
Integer favoritePopupTimeout = 10
Integer favoriteOpenTimeout = 15


// ======================================================
// AUTHENTICATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Authenticate and open application\n' +
	'Environment: ' + targetEnvironment
)

WebUI.callTestCase(
	findTestCase(loginTestCase),
	[:],
	FailureHandling.STOP_ON_FAILURE
)


// ======================================================
// LANDING PAGE VALIDATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Validate GUI landing page\n' +
	'- Bottom bar information\n' +
	'- Calendar controls\n' +
	'- Top bar controls and enabled states'
)

CustomKeywords.'pageObject.guiValidation.validateLandingPage'(
	landingPageTimeout
)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	targetEnvironment +
	'_GUI_LandingPage.png'
)


// ======================================================
// OPEN CONFIGURATION SCREEN
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Open configuration screen\n' +
	'Search: ' + configurationMenuName + '\n' +
	'Result: ' + configurationMenuResultName + '\n' +
	'Language: ' + language
)

CustomKeywords.'component.MenuNavigator.searchAndOpenMenuByText'(
	configurationMenuName,
	configurationMenuResultName,
	menuTimeout
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Validate configuration screen\n' +
	'Expected object: guiBehavior.' +
	configurationFormObjectKey
)

if (!Windows.waitForElementPresent(
	CustomKeywords.'commands.WindowsObjectLoader.getObject'(
		'guiBehavior',
		configurationFormObjectKey
	),
	configurationFormTimeout,
	FailureHandling.OPTIONAL
)) {
	CustomKeywords.'commands.ImageLoader.takeEvidence'(
		targetEnvironment +
		'_GUI_ListePerimetres_NotOpened.png'
	)

	KeywordUtil.markFailedAndStop(
		'Configuration screen was not opened.\n' +
		'Menu: ' + configurationMenuName + '\n' +
		'Expected object: guiBehavior.' +
		configurationFormObjectKey
	)
}

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	targetEnvironment +
	'_GUI_ListePerimetres_Open.png'
)


// ======================================================
// APPLY FILTER
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Apply section filter before creating favorite\n' +
	'Filter value: ' + filterValue
)

CustomKeywords.'pageObject.guiValidation.applySectionFilter'(
	filterValue,
	language,
	filterTimeout
)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	targetEnvironment +
	'_GUI_FilteredDataBeforeFavorite.png'
)


// ======================================================
// DOWNLOAD ORIGINAL VIEW
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Download original filtered view\n' +
	'Purpose: create the reference file for favorite comparison'
)

CustomKeywords.'pageObject.guiValidation.resetDownloadedFiles'()

CustomKeywords.'pageObject.guiValidation.downloadCurrentView'(
	''
)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	targetEnvironment +
	'_GUI_OriginalViewDownloaded.png'
)


// ======================================================
// CREATE FAVORITE
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Create favorite\n' +
	'Title: ' + favoriteTitle + '\n' +
	'Validate controls before and after filling the title'
)

CustomKeywords.'pageObject.guiValidation.startFavoriteCreation'(
	favoriteControlTimeout
)

CustomKeywords.'pageObject.guiValidation.enterFavoriteTitle'(
	favoriteTitle,
	favoriteControlTimeout
)

CustomKeywords.'pageObject.guiValidation.saveFavorite'(
	favoritePopupTimeout
)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	targetEnvironment +
	'_GUI_FavoriteCreatedPopup.png'
)

CustomKeywords.'pageObject.guiValidation.confirmFavoriteCreation'()


// ======================================================
// OPEN FAVORITE
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Close current tab and open created favorite\n' +
	'Favorite: ' + favoriteTitle
)

CustomKeywords.'pageObject.guiValidation.closeAllOpenedTabs'()

CustomKeywords.'pageObject.guiValidation.openCreatedFavorite'(
	favoriteImageKey,
	favoriteOpenTimeout
)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	targetEnvironment +
	'_GUI_FavoriteOpened.png'
)


// ======================================================
// DOWNLOAD FAVORITE VIEW
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Download favorite view\n' +
	'Purpose: compare favorite data with the original filtered view'
)

CustomKeywords.'pageObject.guiValidation.downloadCurrentView'(
	'favorite File'
)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	targetEnvironment +
	'_GUI_FavoriteViewDownloaded.png'
)


// ======================================================
// COMPARE FILES
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Compare original and favorite files\n' +
	'Expected result: both exported files contain the same data'
)

CustomKeywords.'pageObject.guiValidation.compareDownloadedFiles'()


// ======================================================
// DELETE FAVORITE
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Delete created favorite\n' +
	'Favorite: ' + favoriteTitle + '\n' +
	'Expected result: favorite is no longer displayed'
)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	targetEnvironment +
	'_GUI_FavoriteBeforeDelete.png'
)

CustomKeywords.'pageObject.guiValidation.deleteCreatedFavorite'(
	favoriteImageKey
)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
	targetEnvironment +
	'_GUI_FavoriteAfterDelete.png'
)


// ======================================================
// CLOSE APPLICATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Close application\n' +
	'Environment: ' + targetEnvironment
)

WebUI.callTestCase(
	findTestCase(closeApplicationTestCase),
	[:],
	FailureHandling.STOP_ON_FAILURE
)

KeywordUtil.markPassed(
	targetEnvironment +
	' favorite create, open, compare and delete flow completed successfully.'
)
