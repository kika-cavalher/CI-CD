    private WindowsTestObject byXpath(String objectId, String xpath) {
        WindowsTestObject obj = new WindowsTestObject(objectId)
        obj.setLocatorStrategy(LocatorStrategy.XPATH)
        obj.setLocator(xpath)
        return obj
    }

    private void pressKey(Robot robot, int keyCode) {
        robot.keyPress(keyCode)
        robot.keyRelease(keyCode)
        sleep(150)
    }

    private void runDetached(String command) {
        new ProcessBuilder('cmd', '/c', command).start()
    }

    private String runPowerShell(String script, int timeoutSeconds) {
        Process proc = new ProcessBuilder(
            'powershell.exe',
            '-NoProfile',
            '-ExecutionPolicy', 'Bypass',
            '-Command', script
        ).redirectErrorStream(true).start()

        boolean finished = proc.waitFor(timeoutSeconds, TimeUnit.SECONDS)
        if (!finished) {
            proc.destroyForcibly()
            return ''
        }

        return safe(proc.inputStream.getText('UTF-8'))
    }

    private boolean fileExists(String path) {
        String value = safe(path)
        return value ? new File(value).exists() : false
    }

    private boolean isPortOpen(String host, int port, int timeoutMillis) {
        Socket socket = new Socket()
        try {
            socket.connect(new InetSocketAddress(host, port), timeoutMillis)
            return true
        } catch (Throwable ignored) {
            return false
        } finally {
            try {
                socket.close()
            } catch (Throwable ignored) {
            }
        }
    }

    private String ps(String value) {
        return safe(value).replace("'", "''")
    }

    private String safe(Object value) {
        return value == null ? '' : String.valueOf(value).trim()
    }
}
