	String buildGaiaReport() {
		String xmlPath = getXmlFilePath()

		if (isBlank(xmlPath)) {
			KeywordUtil.logInfo('Gaia HTML report was not created because XML file was not found.')
			return null
		}

		String reportPath = getResolvedReportPath()

		if (isBlank(reportPath)) {
			KeywordUtil.logInfo('Gaia HTML report was not created because report folder was not found.')
			return null
		}

		Map suiteData = parseSuiteData(xmlPath)
		String html = buildGaiaReportHtml(suiteData)

		File htmlFile = new File(reportPath + File.separator + GAIA_REPORT_FILE_NAME)
		htmlFile.write(html, 'UTF-8')

		KeywordUtil.logInfo("Gaia HTML report created successfully: ${htmlFile.absolutePath}")
		return htmlFile.absolutePath
	}

	// =========================================================
	// JIRA COMMUNICATION
	// =========================================================

	String importResults(String junitXmlPath) {
		KeywordUtil.logInfo("Importing execution results using token ${maskToken(JIRA_TOKEN)}")
		KeywordUtil.logInfo("Using Jira project: ${PROJECT_KEY}")
		KeywordUtil.logInfo("Using XML file: ${junitXmlPath}")

		def response = WS.sendRequest(findTestObject(REQUEST_IMPORT_RESULTS, [
			('filePath') : junitXmlPath,
			('project')  : PROJECT_KEY,
			('token')    : JIRA_TOKEN
		]))

		int status = WS.getResponseStatusCode(response)
		String body = response.getResponseBodyContent()

		KeywordUtil.logInfo("Import Results status: ${status}")
		KeywordUtil.logInfo("Import Results response: ${body}")

		if (!(status == 200 || status == 204)) {
			return 'ERROR' + status.toString()
		}

		def parsedJson = new JsonSlurper().parseText(body)
		String execKey = parsedJson?.testExecIssue?.key

		if (isBlank(execKey)) {
			return 'ERROR_EXEC_ID_NOT_FOUND'
		}

		KeywordUtil.logInfo("Test Execution created successfully: ${execKey}")
		return execKey
	}

	String getExistingTestPlan() {
		KeywordUtil.logInfo("Searching existing Test Plan with summary: ${getTestPlanName()}")

		def response = WS.sendRequest(findTestObject(REQUEST_GET_TEST_PLAN, [
			('project') : PROJECT_KEY,
			('summary') : getTestPlanName(),
			('token')   : JIRA_TOKEN
		]))

		int status = WS.getResponseStatusCode(response)
		String body = response.getResponseBodyContent()

		KeywordUtil.logInfo("Get Test Plan status: ${status}")
		KeywordUtil.logInfo("Get Test Plan response: ${body}")

		if (status != 200) {
			return ''
		}

		def parsedJson = new JsonSlurper().parseText(body)
		int total = parsedJson?.total ?: 0

		if (total < 1) {
			return ''
		}

		def issues = parsedJson?.issues ?: []
		if (issues.isEmpty()) {
			return ''
		}

		String key = issues[0]?.key ?: ''
		if (!isBlank(key)) {
			KeywordUtil.logInfo("Existing Test Plan found: ${key}")
		}

		return key
	}

	String createTestPlan(String summary) {
		KeywordUtil.logInfo("Creating new Test Plan with summary: ${summary}")

		def response = WS.sendRequest(findTestObject(REQUEST_CREATE_TEST_PLAN, [
			('token')   : JIRA_TOKEN,
			('project') : PROJECT_KEY,
			('summary') : summary,
			('epic')    : EPIC_KEY
		]))

		int status = WS.getResponseStatusCode(response)
		String body = response.getResponseBodyContent()

		KeywordUtil.logInfo("Create Test Plan status: ${status}")
		KeywordUtil.logInfo("Create Test Plan response: ${body}")

		if (!(status == 200 || status == 201)) {
			return 'ERROR' + status.toString()
		}

		def parsedJson = new JsonSlurper().parseText(body)
		String testPlanKey = parsedJson?.key ?: ''

		if (isBlank(testPlanKey)) {
			return 'ERROR_TEST_PLAN_KEY_NOT_FOUND'
		}

		KeywordUtil.logInfo("Test Plan created successfully: ${testPlanKey}")
		return testPlanKey
	}

	String getOrCreateTestPlan() {
		if (!isBlank(MANUAL_TEST_PLAN_KEY)) {
			KeywordUtil.logInfo("Using manual Test Plan key: ${MANUAL_TEST_PLAN_KEY}")
			return MANUAL_TEST_PLAN_KEY.trim()
		}

		if (RESET_SAVED_TEST_PLAN_KEY) {
			resetTestPlanKey()
		}

		if (FORCE_CREATE_NEW_TEST_PLAN) {
			String forcedKey = createTestPlan(getTestPlanName())

			if (!isBlank(forcedKey) && !forcedKey.contains('ERROR')) {
				saveTestPlanKey(forcedKey)
			}

			return forcedKey
		}

		String savedKey = getSavedTestPlanKey()

		if (!isBlank(savedKey)) {
			KeywordUtil.logInfo("Using saved Test Plan key: ${savedKey}")
			return savedKey
		}

		String existingKey = getExistingTestPlan()

		if (!isBlank(existingKey)) {
			saveTestPlanKey(existingKey)
			return existingKey
		}

		String newKey = createTestPlan(getTestPlanName())

		if (!isBlank(newKey) && !newKey.contains('ERROR')) {
			saveTestPlanKey(newKey)
		}

		return newKey
	}

	int updateTestPlan(String testPlanKey, List<String> testExecKeys) {
		KeywordUtil.logInfo("Associating execution ${testExecKeys} to Test Plan ${testPlanKey}")

		def jsonBody = [
			addTestsToPlan: true,
			add           : testExecKeys
		]

		def response = WS.sendRequest(findTestObject(REQUEST_UPDATE_TEST_PLAN, [
			('token')       : JIRA_TOKEN,
			('testPlanKey') : testPlanKey,
			('jsonBody')    : JsonOutput.toJson(jsonBody)
		]))

		int status = WS.getResponseStatusCode(response)
		String body = response.getResponseBodyContent()

		KeywordUtil.logInfo("Update Test Plan status: ${status}")
		KeywordUtil.logInfo("Update Test Plan response: ${body}")

		return status
	}

	int updateTestExecution(String execID) {
		KeywordUtil.logInfo("Updating Test Execution info for ${execID}")

		def response = WS.sendRequest(findTestObject(REQUEST_UPDATE_TEST_EXECUTION, [
			('issueID') : execID,
			('token')   : JIRA_TOKEN,
			('summary') : getExecutionSummary(),
			('env')     : ENVIRONMENT,
			('labels')  : LABELS
		]))

		int status = WS.getResponseStatusCode(response)
		String body = response.getResponseBodyContent()

		KeywordUtil.logInfo("Update Test Execution status: ${status}")
		KeywordUtil.logInfo("Update Test Execution response: ${body}")

		return status
	}

	int uploadAttachment(String issueKey, String filePath) {
		if (isBlank(filePath)) {
			KeywordUtil.logInfo('Skipping attachment upload because file path is empty.')
			return 0
		}

		KeywordUtil.logInfo("Uploading attachment to execution ${issueKey}: ${filePath}")

		def response = WS.sendRequest(findTestObject(REQUEST_UPLOAD_ATTACHMENT, [
			('token')     : JIRA_TOKEN,
			('evidences') : new File(filePath),
			('execID')    : issueKey
		]))

		int status = WS.getResponseStatusCode(response)
		String body = response.getResponseBodyContent()

		KeywordUtil.logInfo("Upload attachment status: ${status}")
		KeywordUtil.logInfo("Upload attachment response: ${body}")

		return status
	}

	int updateIssueStatus(String issueKey, String transitionId) {
		if (isBlank(transitionId)) {
			KeywordUtil.logInfo("No transition configured for issue ${issueKey}")
			return 200
		}

		KeywordUtil.logInfo("Updating issue status for ${issueKey} with transition ${transitionId}")

		def response = WS.sendRequest(findTestObject(REQUEST_TRANSITION_STATUS, [
			('token')        : JIRA_TOKEN,
			('issueID')      : issueKey,
			('transitionID') : transitionId
		]))

		int status = WS.getResponseStatusCode(response)
		String body = response.getResponseBodyContent()

		KeywordUtil.logInfo("Transition status response code: ${status}")
		KeywordUtil.logInfo("Transition response body: ${body}")

		return status
	}

	// =========================================================
	// MAIN FLOW
	// =========================================================

	@Keyword
	def jiraImport() {
		logSection('Starting Jira import flow 🚀')

		KeywordUtil.logInfo("Suite name: ${getCurrentSuiteName()}")
		KeywordUtil.logInfo("Execution summary: ${getExecutionSummary()}")
		KeywordUtil.logInfo("Test Plan name: ${getTestPlanName()}")
		KeywordUtil.logInfo("Using token: ${maskToken(JIRA_TOKEN)}")
		KeywordUtil.logInfo("Project key: ${PROJECT_KEY}")
		KeywordUtil.logInfo("Epic key: ${EPIC_KEY}")
		KeywordUtil.logInfo("Report path: ${getResolvedReportPath()}")

		String xmlFile = getXmlFilePath()

		if (isBlank(xmlFile)) {
			KeywordUtil.markFailed('No XML file found for Jira import.')
			return
		}

		String gaiaReportFile = buildGaiaReport()
		String zipReport = zipReports()
		String zipEvidence = zipEvidences()

		String execID = importResults(xmlFile)

		if (isBlank(execID) || execID.contains('ERROR')) {
			KeywordUtil.markFailed("Test Execution creation failed: ${execID}")
			return
		}

		String testPlanKey = getOrCreateTestPlan()

		if (isBlank(testPlanKey) || testPlanKey.contains('ERROR')) {
			KeywordUtil.markFailed("Test Plan could not be created or resolved: ${testPlanKey}")
			return
		}

		int updatePlanStatus = updateTestPlan(testPlanKey, [execID])
		int updateExecutionStatus = updateTestExecution(execID)

		int uploadExecGaiaReportStatus = uploadAttachment(execID, gaiaReportFile)
		int uploadExecResultsStatus = uploadAttachment(execID, zipReport)
		int uploadExecEvidenceStatus = uploadAttachment(execID, zipEvidence)

		int transitionExecutionStatus = updateIssueStatus(execID, TEST_EXECUTION_TRANSITION_ID)
		int transitionPlanStatus = updateIssueStatus(testPlanKey, TEST_PLAN_TRANSITION_ID)

		logSection('Jira import finished ✅')

		KeywordUtil.logInfo("Execution key: ${execID}")
		KeywordUtil.logInfo("Test Plan key: ${testPlanKey}")
		KeywordUtil.logInfo("Gaia report attachment status: ${uploadExecGaiaReportStatus}")
		KeywordUtil.logInfo("Results.zip attachment status: ${uploadExecResultsStatus}")
		KeywordUtil.logInfo("Evidences.zip attachment status: ${uploadExecEvidenceStatus}")
		KeywordUtil.logInfo("Update Test Plan status: ${updatePlanStatus}")
		KeywordUtil.logInfo("Update Test Execution status: ${updateExecutionStatus}")
		KeywordUtil.logInfo("Transition Execution status: ${transitionExecutionStatus}")
		KeywordUtil.logInfo("Transition Test Plan status: ${transitionPlanStatus}")
	}
