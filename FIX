	private void runResolutionScriptIfAvailable() {
		String scriptPath = getResolutionScriptPath()
		if (!scriptPath) {
			return
		}

		File scriptFile = new File(scriptPath)
		if (!scriptFile.exists()) {
			KeywordUtil.logInfo("Resolution script not found. Skipping: ${scriptPath}")
			return
		}

		try {
			KeywordUtil.logInfo("Running resolution script: ${scriptPath}")
			new ProcessBuilder(
				'Powershell.exe',
				'-executionpolicy',
				'remotesigned',
				'-File',
				scriptPath
			).redirectErrorStream(true).start()
			Windows.delay(2)
		} catch (Throwable e) {
			KeywordUtil.logInfo("Resolution script could not be executed: ${e.message}")
		}
	}

	private boolean startLocalUsingTitle(String targetWindowTitle) {
		String localLauncherPath = getLocalLauncherPath()
		if (!localLauncherPath) {
			KeywordUtil.logInfo('Local launcher path is empty.')
			return false
		}

		File launcher = new File(localLauncherPath)
		if (!launcher.exists()) {
			KeywordUtil.logInfo("Local launcher does not exist: ${localLauncherPath}")
			return false
		}

		runResolutionScriptIfAvailable()
		KeywordUtil.logInfo("Starting local eMatch with title. Path: ${localLauncherPath}; title: ${targetWindowTitle}")
		Windows.startApplicationWithTitle(localLauncherPath, targetWindowTitle)
		return true
	}

	private boolean startRemoteUsingApplicationPath() {
		String applicationPath = getApplicationPath()
		if (!applicationPath) {
			KeywordUtil.logInfo('Application path is empty.')
			return false
		}

		KeywordUtil.logInfo("Starting remote eMatch from application path without Windows.startApplication: ${applicationPath}")
		return launchClickOnceApplication(applicationPath)
	}

	@Keyword
	boolean startEMatch(String currentUser, String targetWindowTitle) {
		String env = currentEnv()
		String shortcutPath = getShortcutPath()
		String installedExePath = getInstalledExePath()

		KeywordUtil.logInfo("Starting eMatch for environment: ${env}")
		KeywordUtil.logInfo("Current Windows user: ${currentUser}")
		KeywordUtil.logInfo("Target window title: ${targetWindowTitle}")
		KeywordUtil.logInfo("Shortcut path: ${shortcutPath}")
		KeywordUtil.logInfo("Application path: ${getApplicationPath()}")
		KeywordUtil.logInfo("Installed exe path: ${installedExePath}")
		KeywordUtil.logInfo("Configured execution user: ${gv('username')}")
		KeywordUtil.logInfo("Is local execution user: ${isLocalExecutionUser()}")

		ensureWinAppDriverStarted()

		if (isLoginWindowReady()) {
			KeywordUtil.logInfo('Login window already available before launch.')
			return true
		}

		killProcessIfExists('IXIS.eMatch.IHM.exe')

		boolean started = false
		if (isLocalExecutionUser()) {
			started = startLocalUsingTitle(targetWindowTitle)
		} else {
			started = startRemoteUsingApplicationPath()
		}

		if (!started) {
			throw new Exception("Unable to start eMatch for environment '${env}'.")
		}

		Windows.delay(5)
		return true
	}

	@Keyword
	boolean attachToLoginWindow(String targetWindowTitle) {
		ensureWinAppDriverStarted()

		if (isLoginWindowReady()) {
			KeywordUtil.logInfo("Login window already available for '${targetWindowTitle}'.")
			return true
		}

		Windows.switchToDesktop()

		WindowsTestObject targetWindow = new WindowsTestObject()
		targetWindow.setLocatorStrategy(LocatorStrategy.NAME)
		targetWindow.setLocator(targetWindowTitle)

		Exception lastError = null
		boolean attached = false

		for (int i = 1; i <= 20; i++) {
			try {
				Windows.switchToWindow(targetWindow)
				attached = true
				KeywordUtil.logInfo("Attached to window by title '${targetWindowTitle}' at attempt ${i}")
				break
			} catch (Throwable e) {
				lastError = e
				Windows.delay(1)
			}
		}

		if (!attached) {
			KeywordUtil.logInfo("Attach by title failed for '${targetWindowTitle}'. Falling back to window index.")
			attached = attachToLoginByWindowIndex(8, 5)
		}

		if (!attached) {
			throw new Exception("Unable to attach to login window for '${targetWindowTitle}'. Last error: ${lastError?.message}")
		}

		boolean loginReady = waitForLoginWindowReady(20)
		if (!loginReady) {
			throw new Exception('Login window attached but objects were not detected.')
		}

		return true
	}

	@Keyword
	boolean openEnvironmentDropdown() {
		Exception lastError = null
		List<String> candidateObjects = [
			'Object Repository/Login Page/optEnv',
			'Login Page/optEnv'
		]

		for (String objectId : candidateObjects) {
			try {
				KeywordUtil.logInfo("Trying to click environment dropdown using object: ${objectId}")
				Windows.click(findWindowsObject(objectId))
				Windows.delay(1)
				return true
			} catch (Exception e) {
				lastError = e
				KeywordUtil.logInfo("Dropdown click failed with '${objectId}': ${e.message}")
			}
		}

		throw new Exception("Unable to open environment dropdown. Last error: ${lastError?.message}")
	}

	@Keyword
	int resolveEnvironmentIndex(String envName) {
		String env = (envName ?: '').trim().toUpperCase()

		switch (env) {
			case 'PROD':
			case 'PRD':
				return 1
			case 'PREQ':
			case 'BENCH':
				return 2
			case 'QUAL':
			case 'QUALIFICATION':
				return 3
			case 'REC':
			case 'RECETTE':
				return 4
			case 'SIM':
			case 'SIMULATION':
				return 5
			case 'DEV':
			case 'DEVELOPMENT':
				return 6
			default:
				return 4
		}
	}

	@Keyword
	boolean selectEnvironment(String envName) {
		int envIndex = resolveEnvironmentIndex(envName)

		KeywordUtil.logInfo("Selecting environment '${envName}' using index ${envIndex}")

		keyPress(KeyEvent.VK_HOME)
		Windows.delay(1)

		if (envIndex > 1) {
			keyPressMultiple(KeyEvent.VK_DOWN, envIndex - 1)
			Windows.delay(1)
		}

		keyPress(KeyEvent.VK_ENTER)
		Windows.delay(1)

		return true
	}

	@Keyword
	boolean isConnectButtonPresent() {
		List<String> candidateObjects = [
			'Object Repository/Login Page/btnConnect',
			'Login Page/btnConnect'
		]

		for (String objectId : candidateObjects) {
			if (safeVerifyPresent(objectId, 2)) {
				return true
			}
		}

		return false
	}

	@Keyword
	boolean clickConnectButton() {
		Exception lastError = null
		List<String> candidateObjects = [
			'Object Repository/Login Page/btnConnect',
			'Login Page/btnConnect'
		]

		for (String objectId : candidateObjects) {
			try {
				Windows.click(findWindowsObject(objectId))
				Windows.delay(1)
				return true
			} catch (Exception e) {
				lastError = e
			}
		}

		throw new Exception("Unable to click connect button. Last error: ${lastError?.message}")
	}

	@Keyword
	boolean waitForMainScreen() {
		List<String> candidateObjects = [
			'Object Repository/General/txtSearch',
			'General/txtSearch'
		]

		for (int i = 1; i <= 30; i++) {
			for (String objectId : candidateObjects) {
				if (safeVerifyPresent(objectId, 1)) {
					KeywordUtil.logInfo("Main screen detected with object '${objectId}' at attempt ${i}")
					return true
				}
			}
			Windows.delay(1)
		}

		return false
	}

	@Keyword
	boolean activateHomeTab() {
		List<String> candidateObjects = [
			'Object Repository/General/tabHome',
			'General/tabHome'
		]

		for (String objectId : candidateObjects) {
			if (safeClick(objectId, 2)) {
				KeywordUtil.logInfo("Home tab activated with object '${objectId}'")
				return true
			}
		}

		KeywordUtil.logInfo('Home tab object not found. Continuing without explicit click.')
		return true
	}
}

