            }

            .step-title-line .title-text {
                min-width: 0;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                display: inline-block;
            }

            .detail-link {
                display: inline-block;
                margin-top: 6px;
                font-size: 12px;
                color: #2e75b5;
                text-decoration: none;
                cursor: pointer;
            }

            .detail-link:hover {
                text-decoration: underline;
            }

            .step-detail-box {
                display: none;
                margin-top: 8px;
