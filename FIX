	private void closeOpenFileModal() {

		logInfo(
				'Searching for open-file modal.\n' +
				'REC image: General/iconeModal\n' +
				'PRD image: General/iconeModalPRD\n' +
				'Timeout per image: ' +
				OPEN_FILE_MODAL_TIMEOUT_SECONDS +
				' seconds.'
				)

		String detectedModalImage = null

		try {
			boolean recModalFound =
					imageLoader.waitForImage(
					GENERAL_IMAGE_GROUP,
					'iconeModal',
					OPEN_FILE_MODAL_TIMEOUT_SECONDS
					)

			if (recModalFound) {
				detectedModalImage = 'iconeModal'
			}
		} catch (Throwable throwable) {

			logInfo(
					'REC open-file modal search returned an exception.\n' +
					'Message: ' +
					safeExceptionMessage(
					throwable
					)
					)
		}

		if (detectedModalImage == null) {

			logInfo(
					'REC modal was not found. Searching for PRD modal.'
					)

			try {
				boolean prdModalFound =
						imageLoader.waitForImage(
						GENERAL_IMAGE_GROUP,
						'iconeModalPRD',
						OPEN_FILE_MODAL_TIMEOUT_SECONDS
						)

				if (prdModalFound) {
					detectedModalImage = 'iconeModalPRD'
				}
			} catch (Throwable throwable) {

				logInfo(
						'PRD open-file modal search returned an exception.\n' +
						'Message: ' +
						safeExceptionMessage(
						throwable
						)
						)
			}
		}

		if (detectedModalImage == null) {

			logInfo(
					'Open-file modal was not found.\n' +
					'No modal is open. Continuing the export flow.'
					)

			return
		}

		Integer maximumCloseAttempts = 2

		for (
		Integer attempt = 1;
				attempt <= maximumCloseAttempts;
				attempt++
				) {

			logInfo(
					'Open-file modal detected using image: ' +
					detectedModalImage +
					'.\n' +
					'Close attempt: ' +
					attempt +
					' of ' +
					maximumCloseAttempts +
					'.\n' +
					'Action: TAB and ENTER.'
					)

			try {
				Robot robot =
						new Robot()

				robot.setAutoDelay(
						150
						)

				robot.keyPress(
						KeyEvent.VK_TAB
						)

				robot.keyRelease(
						KeyEvent.VK_TAB
						)

				Thread.sleep(
						300
						)

				robot.keyPress(
						KeyEvent.VK_ENTER
						)

				robot.keyRelease(
						KeyEvent.VK_ENTER
						)
			} catch (Exception exception) {

				imageLoader.takeEvidence(
						'OpenFileModalKeyboardError_Attempt' +
						attempt +
						'.png'
						)

				if (attempt < maximumCloseAttempts) {

					logInfo(
							'Could not execute TAB and ENTER on attempt ' +
							attempt +
							'. Trying again.\n' +
							'Message: ' +
							safeExceptionMessage(
							exception
							)
							)

					Windows.delay(
							SHORT_UI_DELAY_SECONDS
							)

					continue
				}

				KeywordUtil.markFailedAndStop(
						'Could not close open-file modal after two attempts.\n' +
						'Last message: ' +
						safeExceptionMessage(
						exception
						)
						)

				return
			}

			Windows.delay(
					SHORT_UI_DELAY_SECONDS
					)

			boolean recModalStillVisible =
					imageLoader.isVisible(
					GENERAL_IMAGE_GROUP,
					'iconeModal'
					)

			boolean prdModalStillVisible =
					imageLoader.isVisible(
					GENERAL_IMAGE_GROUP,
					'iconeModalPRD'
					)

			if (!recModalStillVisible &&
					!prdModalStillVisible) {

				logInfo(
						'Open-file modal closed successfully.\n' +
						'Attempt used: ' +
						attempt +
						' of ' +
						maximumCloseAttempts
						)

				return
			}

			if (attempt < maximumCloseAttempts) {

				logInfo(
						'Open-file modal is still visible after attempt ' +
						attempt +
						'. Trying TAB and ENTER again.'
						)

				Windows.delay(
						SHORT_UI_DELAY_SECONDS
						)
			}
		}

		imageLoader.takeEvidence(
				'OpenFileModalStillVisibleAfterRetry.png'
				)

		KeywordUtil.markFailedAndStop(
				'Open-file modal is still visible after two TAB and ENTER attempts.\n' +
				'Evidence: OpenFileModalStillVisibleAfterRetry.png'
				)
	}

