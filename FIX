package jiraIntegration

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import org.openqa.selenium.OutputType

import javax.imageio.ImageIO

import java.awt.GraphicsEnvironment
import java.awt.Rectangle
import java.awt.Robot
import java.awt.Toolkit
import java.awt.image.BufferedImage
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale

class JiraImagesEvidence {

    private static final SimpleDateFormat FILE_STAMP =
        new SimpleDateFormat('yyyyMMdd_HHmmss_SSS', Locale.ENGLISH)

    private static final SimpleDateFormat LOG_STAMP =
        new SimpleDateFormat('yyyy-MM-dd HH:mm:ss.SSS', Locale.ENGLISH)

    private static final ThreadLocal<String> CURRENT_CASE_ID = new ThreadLocal<String>()
    private static final ThreadLocal<File> CURRENT_CASE_FOLDER = new ThreadLocal<File>()
    private static final ThreadLocal<File> CURRENT_CASE_TRACE = new ThreadLocal<File>()

    @Keyword
    def startCase(String caseId) {
        String safeCaseId = safe(caseId)
        File caseFolder = ensureCaseFolder(safeCaseId)
        File traceFile = new File(caseFolder, 'report_steps.log')

        CURRENT_CASE_ID.set(safeCaseId)
        CURRENT_CASE_FOLDER.set(caseFolder)
        CURRENT_CASE_TRACE.set(traceFile)

        appendToFile(traceFile, '[CASE_START] ' + safeCaseId + ' | ' + now())
        appendToRootTrace('[EVIDENCE_CASE_START] ' + safeCaseId + ' | ' + now())
    }

    @Keyword
    def finishCase(String caseId, String status, String message = '') {
        String safeCaseId = safe(caseId)
        String safeStatus = safe(status).toUpperCase(Locale.ENGLISH)

        File caseFolder = ensureCaseFolder(safeCaseId)
        File traceFile = new File(caseFolder, 'report_steps.log')

        appendToFile(traceFile, '[CASE_END] ' + safeCaseId + ' | ' + now() + ' | ' + safeStatus)
        appendToRootTrace('[EVIDENCE_CASE_END] ' + safeCaseId + ' | ' + now() + ' | ' + safeStatus)

        if (safeStatus == 'FAILED' || safeStatus == 'BLOCKED') {
            String savedPath = captureAutomaticFailureScreenshot(caseFolder, 'auto-failure')
            if (!savedPath.isEmpty()) {
                appendToRootTrace('[REPORT_EVIDENCE] ' + safeCaseId + ' | ' + savedPath)
            }

            if (!safe(message).isEmpty()) {
                File failureFile = new File(caseFolder, 'failure.txt')
                failureFile.setText(message, 'UTF-8')
            }
        }

        CURRENT_CASE_ID.remove()
        CURRENT_CASE_FOLDER.remove()
        CURRENT_CASE_TRACE.remove()
    }

    @Keyword
    def note(String message) {
        writeControlledStep('NOTE', message)
    }

    @Keyword
    def checkpoint(String message) {
        writeControlledStep('CHECKPOINT', message)
    }

    @Keyword
    String captureNow(String label = 'manual-capture') {
        String safeLabel = safe(label)
        if (safeLabel.isEmpty()) {
            safeLabel = 'manual-capture'
        }

        File caseFolder = resolveCurrentCaseFolder()
        String savedPath = captureScreenshot(caseFolder, safeLabel)

        if (!savedPath.isEmpty()) {
            writeControlledStep('CAPTURE', safeLabel)
            appendToRootTrace('[REPORT_EVIDENCE] ' + resolveCurrentCaseId() + ' | ' + savedPath)
        }

        return savedPath
    }

    @Keyword
    String noteAndCapture(String message, String label = 'manual-capture') {
        note(message)
        return captureNow(label)
    }

    private void writeControlledStep(String type, String message) {
        String caseId = resolveCurrentCaseId()
        File caseTrace = resolveCurrentCaseTrace()

        String cleanMessage = safe(message)
        String stamp = now()

        String marker = '[REPORT_STEP] ' + caseId + ' | ' + stamp + ' | ' + safe(type) + ' | ' + cleanMessage

        appendToFile(caseTrace, marker)
        appendToRootTrace(marker)
        KeywordUtil.logInfo(marker)
    }

    private String captureAutomaticFailureScreenshot(File caseFolder, String label) {
        String savedPath = captureScreenshot(caseFolder, label)

        if (!savedPath.isEmpty()) {
            KeywordUtil.logInfo('Evidence screenshot saved automatically: ' + savedPath)
        }

        return savedPath
    }

    private String captureScreenshot(File caseFolder, String label) {
        if (caseFolder == null) {
            return ''
        }

        caseFolder.mkdirs()

        String baseName = FILE_STAMP.format(new Date()) + '_' + sanitizeFileName(label)
        File targetFile = new File(caseFolder, baseName + '.png')

        try {
            def driver = Windows.getDriver()
            if (driver != null) {
                byte[] bytes = driver.getScreenshotAs(OutputType.BYTES)
                if (bytes != null && bytes.length > 0) {
                    targetFile.bytes = bytes
                    return targetFile.absolutePath
                }
            }
        } catch (Throwable ignored) {
        }

        try {
            if (!GraphicsEnvironment.isHeadless()) {
                Robot robot = new Robot()
                Rectangle rectangle = new Rectangle(Toolkit.getDefaultToolkit().getScreenSize())
                BufferedImage image = robot.createScreenCapture(rectangle)
                ImageIO.write(image, 'png', targetFile)
                return targetFile.absolutePath
            }
        } catch (Throwable ignored) {
        }

        return ''
    }

    private File ensureCaseFolder(String caseId) {
        File root = new File(RunConfiguration.getReportFolder(), 'Evidences')
        File caseFolder = new File(root, sanitizeFolderName(caseId))
        caseFolder.mkdirs()
        return caseFolder
    }

    private File resolveCurrentCaseFolder() {
        File current = CURRENT_CASE_FOLDER.get()
        if (current != null) {
            return current
        }

        String caseId = resolveCurrentCaseId()
        return ensureCaseFolder(caseId)
    }

    private File resolveCurrentCaseTrace() {
        File trace = CURRENT_CASE_TRACE.get()
        if (trace != null) {
            return trace
        }

        File traceFile = new File(resolveCurrentCaseFolder(), 'report_steps.log')
        CURRENT_CASE_TRACE.set(traceFile)
        return traceFile
    }

    private String resolveCurrentCaseId() {
        String current = safe(CURRENT_CASE_ID.get())
        if (!current.isEmpty()) {
            return current
        }

        return 'UNKNOWN_CASE'
    }

    private void appendToRootTrace(String text) {
        try {
            File rootTrace = new File(RunConfiguration.getReportFolder(), 'report_trace.log')
            appendToFile(rootTrace, text)
        } catch (Throwable ignored) {
        }
    }

    private void appendToFile(File file, String text) {
        if (file == null) {
            return
        }

        file.parentFile?.mkdirs()
        file << text + System.lineSeparator()
    }

    private String now() {
        return LOG_STAMP.format(new Date())
    }

    private String sanitizeFolderName(String value) {
        String text = safe(value)
            .replace('\\', '_')
            .replace('/', '_')
            .replaceAll(/[^A-Za-z0-9._ -]+/, '_')
            .replaceAll(/_+/, '_')
            .trim()

        if (text.isEmpty()) {
            text = 'UNKNOWN_CASE'
        }

        return text
    }

    private String sanitizeFileName(String value) {
        String text = safe(value)
            .replaceAll(/[^A-Za-z0-9._-]+/, '_')
            .replaceAll(/_+/, '_')
            .trim()

        if (text.isEmpty()) {
            text = 'capture'
        }

        return text
    }

    private String safe(Object value) {
        return value == null ? '' : String.valueOf(value).trim()
    }
}
