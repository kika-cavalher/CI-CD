	// ======================================================
	// CREATE FAVORITE
	// Only favoriteFilterField uses image recognition.
	// ======================================================

	@Keyword
	void createFavoriteFromCurrentModule(
		String favoriteTitle,
		Integer controlTimeoutSeconds,
		Integer popupTimeoutSeconds
	) {

		Integer controlTimeout = safeTimeout(controlTimeoutSeconds, 5)
		Integer popupTimeout = safeTimeout(popupTimeoutSeconds, 5)

		logStep(
			'CREATE FAVORITE',
			'Favorite title: ' + favoriteTitle
		)

		WindowsTestObject createFavoriteButton =
			object('createFavoriteTopBar')

		if (!Windows.waitForElementPresent(
			createFavoriteButton,
			controlTimeout,
			FailureHandling.OPTIONAL
		)) {
			takeEvidence('GUI_CreateFavoriteButtonNotFound.png')

			KeywordUtil.markFailedAndStop(
				'Create Favorite button was not found.'
			)

			return
		}

		Windows.click(
			createFavoriteButton,
			FailureHandling.STOP_ON_FAILURE
		)

		Windows.delay(1)

		typeOnImage(
			GUI_IMAGE_GROUP,
			'favoriteFilterField',
			favoriteTitle,
			controlTimeout
		)

		Windows.delay(1)

		WindowsTestObject saveFavoriteButton =
			object('favoriteSaveTopBar')

		if (!Windows.waitForElementPresent(
			saveFavoriteButton,
			controlTimeout,
			FailureHandling.OPTIONAL
		)) {
			takeEvidence('GUI_SaveFavoriteButtonNotFound.png')

			KeywordUtil.markFailedAndStop(
				'Save Favorite button was not found.'
			)

			return
		}

		String saveEnabled = safeText(
			Windows.getAttribute(
				saveFavoriteButton,
				'IsEnabled',
				FailureHandling.OPTIONAL
			)
		)

		if (!saveEnabled.equalsIgnoreCase('True')) {
			takeEvidence('GUI_SaveFavoriteButtonDisabled.png')

			KeywordUtil.markFailedAndStop(
				'Save Favorite button is disabled after filling the title.'
			)

			return
		}

		Windows.click(
			saveFavoriteButton,
			FailureHandling.STOP_ON_FAILURE
		)

		String modalDetection = waitForFavoriteConfirmation(
			favoriteTitle,
			popupTimeout
		)

		if (modalDetection.isEmpty()) {
			takeEvidence('GUI_FavoriteConfirmationModalNotFound.png')

			KeywordUtil.markFailedAndStop(
				'Favorite confirmation modal was not found.\n' +
				'Favorite: ' + favoriteTitle
			)

			return
		}

		takeEvidence('GUI_FavoriteConfirmationModal.png')

		Windows.delay(5)

		boolean confirmationClosed = clickFirstVisibleImage(
			GENERAL_IMAGE_GROUP,
			['okModal', 'okModal2Version'],
			3
		)

		if (!confirmationClosed) {
			pressKeyboardKey(KeyEvent.VK_ENTER)
		}

		Windows.delay(2)

		KeywordUtil.markPassed(
			'Favorite created successfully.\n' +
			'Title: ' + favoriteTitle + '\n' +
			'Confirmation detected by: ' + modalDetection
		)
	}
