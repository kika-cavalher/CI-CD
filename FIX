import com.kms.katalon.core.util.KeywordUtil

import internal.GlobalVariable as GlobalVariable

String environment = 'REC'
GlobalVariable.env = environment

String currentUser = CustomKeywords.'pageObject.authentication.getCurrentWindowsUser'()
String targetWindowTitle = CustomKeywords.'pageObject.authentication.resolveWindowTitle'()
String shortcutPath = CustomKeywords.'pageObject.authentication.getShortcutPath'()
String applicationPath = CustomKeywords.'pageObject.authentication.getApplicationPath'()
String launcherBat = CustomKeywords.'pageObject.authentication.getLauncherBat'()
String resolutionScriptPath = CustomKeywords.'pageObject.authentication.getResolutionScriptPath'()
String winAppDriverPath = CustomKeywords.'pageObject.authentication.getWinAppDriverPath'()
String installedExePath = CustomKeywords.'pageObject.authentication.getInstalledExePath'()

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Verify username, version and startup context')
CustomKeywords.'jiraIntegration.JiraReportSteps.note'("environment = ${environment}")
CustomKeywords.'jiraIntegration.JiraReportSteps.note'("env = ${GlobalVariable.env}")
CustomKeywords.'jiraIntegration.JiraReportSteps.note'("currentUser = ${currentUser}")
CustomKeywords.'jiraIntegration.JiraReportSteps.note'("targetWindowTitle = ${targetWindowTitle}")
CustomKeywords.'jiraIntegration.JiraReportSteps.note'("shortcutPath = ${shortcutPath}")
CustomKeywords.'jiraIntegration.JiraReportSteps.note'("applicationPath = ${applicationPath}")
CustomKeywords.'jiraIntegration.JiraReportSteps.note'("installedExePath = ${installedExePath}")
CustomKeywords.'jiraIntegration.JiraReportSteps.note'("launcherBat = ${launcherBat}")
CustomKeywords.'jiraIntegration.JiraReportSteps.note'("resolutionScriptPath = ${resolutionScriptPath}")
CustomKeywords.'jiraIntegration.JiraReportSteps.note'("winAppDriverPath = ${winAppDriverPath}")

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Starting eMatch application')
CustomKeywords.'pageObject.authentication.startMatch'()

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Attaching to login window')
CustomKeywords.'pageObject.authentication.attachToLoginWindow'(targetWindowTitle)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Opening environment dropdown')
CustomKeywords.'pageObject.authentication.openEnvironmentDropdown'()

int envIndex = CustomKeywords.'pageObject.authentication.resolveEnvironmentIndex'(GlobalVariable.env)
CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Selecting environment '${GlobalVariable.env}' with index ${envIndex}")
CustomKeywords.'pageObject.authentication.selectEnvironment'(GlobalVariable.env)

boolean isButtonPresent = CustomKeywords.'pageObject.authentication.isConnectButtonPresent'()

if (isButtonPresent) {
    CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Connect button was present and will be clicked.')
    CustomKeywords.'pageObject.authentication.clickConnectButton'()
    KeywordUtil.logInfo('Connect button was present and was clicked.')
} else {
    CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Connect button was not present. Continuing test execution.')
    KeywordUtil.logInfo('Connect button was not present. Continuing test execution.')
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Waiting for main eMatch screen')
boolean mainScreenLoaded = CustomKeywords.'pageObject.authentication.waitForMainScreen'()

if (!mainScreenLoaded) {
    CustomKeywords.'jiraIntegration.JiraReportSteps.note'("eMatch main screen was not loaded. Object 'General/txtSearch' not found.")
    KeywordUtil.markFailedAndStop("eMatch main screen was not loaded. Object 'General/txtSearch' not found.")
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Activating Home tab')
CustomKeywords.'pageObject.authentication.activateHomeTab'()

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('eMatch startup flow completed successfully')
KeywordUtil.markPassed("eMatch startup flow completed successfully for environment ${GlobalVariable.env}")
