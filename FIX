class authentication {

    private String gv(String name) {
        try {
            def value = GlobalVariable."${name}"
            return value == null ? '' : value.toString().trim()
        } catch (Throwable ignored) {
            return ''
        }
    }

    private String firstNonBlank(String... values) {
        for (String value : values) {
            if (value != null && value.toString().trim()) {
                return value.toString().trim()
            }
        }
        return ''
    }

    private String currentEnv() {
        String raw = firstNonBlank(
            gv('env'),
            gv('environment'),
            'REC'
        ).toUpperCase()

        if (raw == 'PRD') {
            return 'PROD'
        }

        return raw ?: 'REC'
    }

    private String envFolder(String env) {
        switch (env) {
            case 'PROD':
                return 'PROD'
            case 'PTS':
                return 'PTS'
            default:
                return 'REC'
        }
    }

    private String envShortcutFileName(String env) {
        switch (env) {
            case 'PROD':
                return 'eMatch PROD.appref-ms'
            case 'PTS':
                return 'eMatch PTS.appref-ms'
            default:
                return 'eMatch REC.appref-ms'
        }
    }

    private String resolveVersionToken(String env) {
        switch (env) {
            case 'PROD':
                return firstNonBlank(
                    gv('versionProd'),
                    gv('versionPRD'),
                    gv('versionPROD'),
                    gv('version')
                )
            case 'PTS':
                return firstNonBlank(
                    gv('versionPts'),
                    gv('versionPTS'),
                    gv('version')
                )
            default:
                return firstNonBlank(
                    gv('versionRec'),
                    gv('versionREC'),
                    gv('version')
                )
        }
    }

    private boolean isPortOpen(String host, int port, int timeoutMs = 1000) {
        Socket socket = null
        try {
            socket = new Socket()
            socket.connect(new InetSocketAddress(host, port), timeoutMs)
            return true
        } catch (Throwable ignored) {
            return false
        } finally {
            try {
                socket?.close()
            } catch (Throwable ignored) {
            }
        }
    }

    private boolean waitForPort(String host, int port, int maxSeconds) {
        for (int i = 1; i <= maxSeconds; i++) {
            if (isPortOpen(host, port, 1000)) {
                KeywordUtil.logInfo("Port ${port} is open on ${host} at attempt ${i}")
                return true
            }
            Windows.delay(1)
        }
        return false
    }

    private boolean processExists(String imageName) {
        try {
            Process process = new ProcessBuilder(
                'cmd',
                '/c',
                "tasklist /FI \"IMAGENAME eq ${imageName}\""
            ).redirectErrorStream(true).start()

            String output = process.inputStream.getText('CP1252')
            process.waitFor()

            return output != null && output.toLowerCase().contains(imageName.toLowerCase())
        } catch (Throwable ignored) {
            return false
        }
    }

    private void killProcessIfExists(String imageName) {
        try {
            if (!processExists(imageName)) {
                return
            }

            KeywordUtil.logInfo("Killing existing process: ${imageName}")
            new ProcessBuilder(
                'cmd',
                '/c',
                "taskkill /F /T /IM \"${imageName}\""
            ).redirectErrorStream(true).start().waitFor()

            Windows.delay(2)
        } catch (Throwable e) {
            KeywordUtil.logInfo("Unable to kill process ${imageName}: ${e.message}")
        }
    }

    private boolean safeVerifyPresent(String objectId, int timeoutSeconds = 1) {
        try {
            return Windows.verifyElementPresent(
                findWindowsObject(objectId),
                timeoutSeconds,
                FailureHandling.OPTIONAL
            )
        } catch (Throwable ignored) {
            return false
        }
    }

    private boolean safeClick(String objectId, int timeoutSeconds = 2) {
        try {
            Windows.waitForElementPresent(
                findWindowsObject(objectId),
                timeoutSeconds,
                FailureHandling.OPTIONAL
            )
            Windows.click(findWindowsObject(objectId))
            return true
        } catch (Throwable ignored) {
            return false
        }
    }

    private boolean isLoginWindowReady() {
        return safeVerifyPresent('Object Repository/Login Page/optEnv', 1) ||
               safeVerifyPresent('Login Page/optEnv', 1) ||
               safeVerifyPresent('Object Repository/Login Page/btnConnect', 1) ||
               safeVerifyPresent('Login Page/btnConnect', 1)
    }

    private boolean waitForLoginWindowReady(int maxSeconds) {
        for (int i = 1; i <= maxSeconds; i++) {
            if (isLoginWindowReady()) {
                KeywordUtil.logInfo("Login window became ready at attempt ${i}")
                return true
            }
            Windows.delay(1)
        }
        return false
    }

    private boolean waitForWindowAttachment(String targetWindowTitle, int maxSeconds) {
        for (int i = 1; i <= maxSeconds; i++) {
            try {
                Windows.switchToWindowTitle(targetWindowTitle)
                Windows.delay(1)
                KeywordUtil.logInfo("Attached to window '${targetWindowTitle}' at attempt ${i}")
                return true
            } catch (Throwable e) {
                if (i == 1 || i % 5 == 0) {
                    KeywordUtil.logInfo("Window '${targetWindowTitle}' not attached yet at attempt ${i}: ${e.message}")
                }
            }
            Windows.delay(1)
        }
        return false
    }

    private void keyPress(int keyCode) {
        Robot robot = new Robot()
        robot.setAutoDelay(120)
        robot.keyPress(keyCode)
        robot.keyRelease(keyCode)
    }

    private void keyPressMultiple(int keyCode, int times) {
        for (int i = 0; i < times; i++) {
            keyPress(keyCode)
        }
    }

    private boolean tryStartWinAppDriver(String exePath) {
        try {
            KeywordUtil.logInfo("Starting WinAppDriver minimized from ${exePath}")
            new ProcessBuilder(
                'cmd',
                '/c',
                "start \"\" /min \"${exePath}\""
            ).redirectErrorStream(true).start()
            return true
        } catch (Throwable firstError) {
            KeywordUtil.logInfo("Minimized WinAppDriver start failed: ${firstError.message}")

            try {
                new ProcessBuilder(exePath)
                    .redirectErrorStream(true)
                    .start()
                return true
            } catch (Throwable secondError) {
                KeywordUtil.logInfo("Direct WinAppDriver start failed: ${secondError.message}")
                return false
            }
        }
    }

    private void ensureWinAppDriverStarted() {
        if (isPortOpen('127.0.0.1', 4723, 1000)) {
            KeywordUtil.logInfo('WinAppDriver already running on 127.0.0.1:4723')
            return
        }

        String exePath = getWinAppDriverPath()
        if (!exePath) {
            throw new Exception('WinAppDriver path is empty.')
        }

        File exe = new File(exePath)
        if (!exe.exists()) {
            throw new Exception("WinAppDriver executable not found at: ${exePath}")
        }

        boolean launched = tryStartWinAppDriver(exePath)
        if (!launched) {
            throw new Exception("Unable to launch WinAppDriver from: ${exePath}")
        }

        boolean started = waitForPort('127.0.0.1', 4723, 10)
        if (!started) {
            throw new Exception("WinAppDriver did not open port 4723 after startup. Path used: ${exePath}")
        }

        Windows.delay(2)
        KeywordUtil.logInfo('WinAppDriver is ready on 127.0.0.1:4723')
    }

    @Keyword
    String getCurrentWindowsUser() {
        return firstNonBlank(
            System.getProperty('user.name'),
            System.getenv('USERNAME')
        )
    }

    @Keyword
    String resolveWindowTitle() {
        String env = currentEnv()
        String versionToken = resolveVersionToken(env)

        if (!versionToken) {
            throw new Exception("No version variable found for environment '${env}'.")
        }

        if (versionToken.toLowerCase().startsWith('ematch')) {
            return versionToken
        }

        return "eMatch ${versionToken}".trim()
    }

    @Keyword
    String getShortcutPath() {
        String env = currentEnv()

        String configuredPath = ''
        switch (env) {
            case 'PROD':
                configuredPath = firstNonBlank(
                    gv('shortcutPathProd'),
                    gv('shortcutPathPRD'),
                    gv('shortcutPathPROD')
                )
                break
            case 'PTS':
                configuredPath = firstNonBlank(
                    gv('shortcutPathPts'),
                    gv('shortcutPathPTS')
                )
                break
            default:
                configuredPath = firstNonBlank(
                    gv('shortcutPathRec'),
                    gv('shortcutPathREC')
                )
                break
        }

        if (configuredPath) {
            return configuredPath
        }

        String user = getCurrentWindowsUser()
        return "C:\\Users\\${user}\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\NATIXIS\\${envShortcutFileName(env)}"
    }

