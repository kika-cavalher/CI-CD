/*
 * Responsibility:
 * Run one desktop Katalon asset through one generic scheduled task that executes
 * the generated command BAT in the interactive desktop session.
 */

def safeFileName(String value) {
    return (value ?: '').replaceAll(/[^A-Za-z0-9._ -]/, '').replace(' ', '_')
}

def runAsset(script, Map cfg, Map asset) {
    def assetKey = safeFileName(asset.name)
    def desktopCommandFile = 'D:\\Projects\\eMatchStarters\\run-ematch-command.bat'

    return script.withEnv([
        "KATALON_EXE=${cfg.katalonExe}",
        "PROJECT_PATH=${cfg.projectPath}",
        "REPORTS_ROOT=${cfg.reportsRoot}",
        "ASSET_NAME=${asset.name}",
        "ASSET_TYPE=${asset.type}",
        "ASSET_PATH=${asset.path}",
        "ASSET_KEY=${assetKey}",
        "ASSET_TIMEOUT_MINUTES=${(asset.timeoutMinutes ?: cfg.defaultTimeoutMinutes).toString()}",
        "DESKTOP_RUNNER_TASK=${cfg.desktopRunnerTask}",
        "WIN_DRIVER_TASK=${cfg.winDriverTask}",
        "DESKTOP_COMMAND_FILE=${desktopCommandFile}"
    ]) {
        script.powershell(
            returnStatus: true,
            script: '''
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

function Clean-Text {
    param([string]$Value)

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return ''
    }

    return (($Value -replace '[\\r\\n]+', ' ') -replace '\\s+', ' ').Trim()
}

function Short-Text {
    param(
        [string]$Value,
        [int]$Max = 180
    )

    $text = Clean-Text $Value

    if ($text.Length -gt $Max) {
        return $text.Substring(0, $Max - 3) + '...'
    }

    return $text
}

function Read-NewContent {
    param(
        [string]$Path,
        [ref]$Offset
    )

    if (-not (Test-Path $Path)) {
        return @()
    }

    $fs = $null
    $sr = $null

    try {
        $fs = [System.IO.File]::Open($Path, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, [System.IO.FileShare]::ReadWrite)
        [void]$fs.Seek($Offset.Value, [System.IO.SeekOrigin]::Begin)
        $sr = New-Object System.IO.StreamReader($fs)
        $content = $sr.ReadToEnd()
        $Offset.Value = $fs.Position

        if ([string]::IsNullOrWhiteSpace($content)) {
            return @()
        }

        return @($content -split "`r?`n")
    }
    catch {
        return @()
    }
    finally {
        if ($sr) { $sr.Close() }
        if ($fs) { $fs.Close() }
    }
}

function Start-TaskSafe {
    param([string]$TaskName)

    if ([string]::IsNullOrWhiteSpace($TaskName)) {
        return
    }

    Write-Host ("[INFO] Starting scheduled task: " + $TaskName)
    schtasks /run /tn $TaskName | Out-Host
}

function Stop-TaskSafe {
    param([string]$TaskName)

    if ([string]::IsNullOrWhiteSpace($TaskName)) {
        return
    }

    try {
        Write-Host ("[INFO] Stopping scheduled task: " + $TaskName)
        schtasks /end /tn $TaskName 1>$null 2>$null
    }
    catch {
    }
}

function Get-JUnitSummary {
    param([string]$JunitFile)

    $result = [ordered]@{
        Executed = 0
        Passed   = 0
        Failed   = 0
        Skipped  = 0
        Reason   = ''
    }

    if ([string]::IsNullOrWhiteSpace($JunitFile) -or -not (Test-Path $JunitFile)) {
        return $result
    }

    try {
        [xml]$xml = Get-Content $JunitFile

        $testcases = @()

        if ($xml.testsuite) {
            $testcases = @($xml.testsuite.testcase)
        }
        elseif ($xml.testsuites) {
            foreach ($ts in @($xml.testsuites.testsuite)) {
                $testcases += @($ts.testcase)
            }
        }

        $testcases = @($testcases | Where-Object { $_ })
        $result.Executed = $testcases.Count

        $failedNodes = @($testcases | Where-Object { $_.failure -or $_.error })
        $skippedNodes = @($testcases | Where-Object { $_.skipped })

        $result.Failed = $failedNodes.Count
        $result.Skipped = $skippedNodes.Count
        $result.Passed = $result.Executed - $result.Failed - $result.Skipped

        if ($failedNodes.Count -gt 0) {
            $firstBad = $failedNodes[0]

            if ($firstBad.failure) {
                $result.Reason = Short-Text (($firstBad.failure.message + ' ' + $firstBad.failure.InnerText)) 150
            }
            elseif ($firstBad.error) {
                $result.Reason = Short-Text (($firstBad.error.message + ' ' + $firstBad.error.InnerText)) 150
            }
        }
    }
    catch {
        $result.Reason = Short-Text $_.Exception.Message 150
    }

    return $result
}

function Find-LatestJunit {
    param([string]$Root)

    $candidate = Get-ChildItem -Path $Root -Filter 'JUnit_Report.xml' -File -Recurse -ErrorAction SilentlyContinue |
        Sort-Object LastWriteTime -Descending |
        Select-Object -First 1

    if ($candidate) {
        return $candidate.FullName
    }

    return ''
}

$logsDir = Join-Path $env:REPORTS_ROOT 'logs'
if (-not (Test-Path $logsDir)) {
    New-Item -ItemType Directory -Path $logsDir -Force | Out-Null
}

$stdoutLog = Join-Path $logsDir ($env:ASSET_KEY + '.desktop.log')
$statusFile = Join-Path $logsDir ($env:ASSET_KEY + '.status.txt')
$metaFile   = Join-Path $logsDir ($env:ASSET_KEY + '.meta.properties')

Remove-Item $stdoutLog -Force -ErrorAction SilentlyContinue
Remove-Item $statusFile -Force -ErrorAction SilentlyContinue
Remove-Item $metaFile   -Force -ErrorAction SilentlyContinue

$assetArgument = ''
if ($env:ASSET_TYPE -eq 'COLLECTION') {
    $assetArgument = '-testSuiteCollectionPath="' + $env:ASSET_PATH + '"'
}
else {
    $assetArgument = '-testSuitePath="' + $env:ASSET_PATH + '"'
}

$desktopBat = @"
@echo off
setlocal
del /f /q "$statusFile" 2>nul
cd /d "D:\\jenkins\\work\\workspace\\GI5\\eMatch_Regression"
"$env:KATALON_EXE" -noSplash -runMode=console -consoleLog -projectPath="$env:PROJECT_PATH" -retry=0 $assetArgument -browserType="Windows" -reportFolder="$env:REPORTS_ROOT" 1>> "$stdoutLog" 2>&1
set EXIT_CODE=%ERRORLEVEL%
> "$statusFile" echo EXIT_CODE=%EXIT_CODE%
exit /b %EXIT_CODE%
"@

Set-Content -Path $env:DESKTOP_COMMAND_FILE -Value $desktopBat -Encoding ASCII

Write-Host '------------------------------------------------------------'
Write-Host ('🚀 ASSET START | ' + $env:ASSET_NAME)
Write-Host ('📁 Path        | ' + $env:ASSET_PATH)
Write-Host ('🧪 Type        | ' + $env:ASSET_TYPE)
Write-Host ('📄 Command Bat | ' + $env:DESKTOP_COMMAND_FILE)
Write-Host '------------------------------------------------------------'

Start-TaskSafe -TaskName $env:WIN_DRIVER_TASK
Start-Sleep -Seconds 2
Start-TaskSafe -TaskName $env:DESKTOP_RUNNER_TASK

$stdoutOffset = 0L
$deadline = (Get-Date).AddMinutes([int]$env:ASSET_TIMEOUT_MINUTES)
$exitCode = 124

while ((Get-Date) -lt $deadline) {
    $stdoutLines = Read-NewContent -Path $stdoutLog -Offset ([ref]$stdoutOffset)

    foreach ($line in $stdoutLines) {
        $text = Clean-Text $line
        if (-not [string]::IsNullOrWhiteSpace($text)) {
            Write-Host ('[KATALON] ' + $text)
        }
    }

    if (Test-Path $statusFile) {
        $exitLine = Get-Content $statusFile -ErrorAction SilentlyContinue | Select-Object -First 1
        if ($exitLine -match 'EXIT_CODE=(\\d+)') {
            $exitCode = [int]$Matches[1]
        }
        else {
            $exitCode = 1
        }

        break
    }

    Start-Sleep -Seconds 2
}

$stdoutLines = Read-NewContent -Path $stdoutLog -Offset ([ref]$stdoutOffset)
foreach ($line in $stdoutLines) {
    $text = Clean-Text $line
    if (-not [string]::IsNullOrWhiteSpace($text)) {
        Write-Host ('[KATALON] ' + $text)
    }
}

if ($exitCode -eq 124) {
    Write-Host ('[TIMEOUT] Asset exceeded timeout of ' + $env:ASSET_TIMEOUT_MINUTES + ' minutes')
}

$junitFile = Find-LatestJunit -Root $env:REPORTS_ROOT
$junitSummary = Get-JUnitSummary -JunitFile $junitFile

$status = 'PASSED'
$icon = '✅'

if ($exitCode -eq 124) {
    $status = 'TIMEOUT'
    $icon = '⏰'
}
elseif ($exitCode -ne 0 -or $junitSummary.Failed -gt 0) {
    $status = 'FAILED'
    $icon = '❌'
}

$reason = $junitSummary.Reason
if ([string]::IsNullOrWhiteSpace($reason) -and $status -eq 'TIMEOUT') {
    $reason = 'Asset execution exceeded timeout'
}
if ([string]::IsNullOrWhiteSpace($reason) -and $status -eq 'FAILED') {
    $reason = 'Asset failed without explicit JUnit reason'
}

$metaLines = @()
$metaLines += ('SUITE_NAME=' + $env:ASSET_NAME)
$metaLines += ('SUITE_TYPE=' + $env:ASSET_TYPE)
$metaLines += ('SUITE_PATH=' + $env:ASSET_PATH)
$metaLines += ('STATUS=' + $status)
$metaLines += ('ICON=' + $icon)
$metaLines += ('EXIT_CODE=' + $exitCode)
$metaLines += ('EXECUTED=' + $junitSummary.Executed)
$metaLines += ('PASSED=' + $junitSummary.Passed)
$metaLines += ('FAILED=' + $junitSummary.Failed)
$metaLines += ('SKIPPED=' + $junitSummary.Skipped)
$metaLines += ('DURATION_SECONDS=0')
$metaLines += ('REASON=' + (Short-Text $reason 150))
$metaLines += ('SCREENSHOT_REL=')
$metaLines += ('LOG_REL=logs/' + $env:ASSET_KEY + '.desktop.log')
$metaLines += ('CASE_SUMMARY=')
$metaLines += ('STEP_SUMMARY=')

Set-Content -Path $metaFile -Value $metaLines -Encoding UTF8

Stop-TaskSafe -TaskName $env:DESKTOP_RUNNER_TASK
Stop-TaskSafe -TaskName $env:WIN_DRIVER_TASK

Write-Host '------------------------------------------------------------'
Write-Host ('🏁 ASSET END   | ' + $env:ASSET_NAME)
Write-Host ('📌 STATUS      | ' + $status)
Write-Host ('📄 LOG         | Reports/logs/' + $env:ASSET_KEY + '.desktop.log')
if (-not [string]::IsNullOrWhiteSpace($reason)) {
    Write-Host ('🧾 REASON      | ' + $reason)
}
Write-Host '------------------------------------------------------------'

exit $exitCode
'''
        )
    }
}

