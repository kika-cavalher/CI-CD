class JiraGaiaReportBuilder {

    JiraFlowCoordinator flow

    JiraGaiaReportBuilder(JiraFlowCoordinator flow) {
        this.flow = flow
    }

    String createGaiaHtmlReport(String reportFolder, String suiteName, String xmlPath) {
        if (isBlank(reportFolder)) {
            return ''
        }

        File baseDir = new File(reportFolder)
        if (!baseDir.exists()) {
            return ''
        }

        String resolvedSuiteName = resolveSuiteName(baseDir, suiteName)

        List<Map> xmlCases = parseXmlCases(xmlPath)
        File executionLog = findExecutionLog(baseDir)
        List<Map> scenarios = parseScenariosFromExecutionLog(executionLog)

        mergeXmlDataIntoScenarios(scenarios, xmlCases)
        finalizeScenario
