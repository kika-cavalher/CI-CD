import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI


// ======================================================
// MODULE CONFIG
// ======================================================

String targetEnvironment = 'REC'

String menuName = 'investigations'
String menuResultName = 'investigations'

String sectionFilterValue = '2G3'
String bilanSourceValue = 'bilan'
String resultatSourceValue = 'resultat'

String mainExportLabel = 'Investigations_Main'
String bilanExportLabel = 'Investigations_Bilan_Detail'
String resultatExportLabel = 'Investigations_Resultat_Detail'

String loginTestCase =
	'Component/Authentication/Login ' +
	targetEnvironment

String closeApplicationTestCase =
	'Component/Authentication/Close Application'


// ======================================================
// REUSABLE FILTER CONFIG
// ======================================================

String filterImageGroup = 'JustificationDesComptesDeLatent'

String filterObjectGroup = 'justificationDesComptesDeLatent'

String sourceHoverImageKey = 'sourceParent'

String sourceHoverObjectKey = 'sourceHeader'

String grayFilterButtonImageKey = 'filterButton'

String grayFilterButtonObjectKey = 'filterButton'

String sourceTextInputImageKey = 'textFilterFR'

String sourceTextInputObjectKey = 'filterTextInput'

String sourceCloseButtonImageKey = 'closeFiltersButtonFR'

String sourceCloseButtonObjectKey = 'closeFilterButtonFR'

String bilanCheckboxImageKey = 'bilan'

String bilanCheckboxObjectKey = 'sourceBilanCheckbox'

String resultatCheckboxImageKey = 'resultat'

String resultatCheckboxObjectKey = 'sourceResultatCheckbox'


// ======================================================
// TIMEOUT CONFIG
// ======================================================

Integer menuTimeout = 20
Integer popupTimeout = 60
Integer filterTimeout = 60
Integer alertTimeout = 15
Integer screenLoadTimeout = 90
Integer detailWindowTimeout = 90


// ======================================================
// AUTHENTICATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Authenticate and open application\n' +
	'Environment: ' + targetEnvironment
)

WebUI.callTestCase(
	findTestCase(loginTestCase),
	[:],
	FailureHandling.STOP_ON_FAILURE
)


// ======================================================
// OPEN INVESTIGATIONS
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Open Investigations screen\n' +
	'Search: ' + menuName + '\n' +
	'Result: ' + menuResultName
)

CustomKeywords.'component.MenuNavigator.searchAndOpenMenuByText'(
	menuName,
	menuResultName,
	menuTimeout
)


// ======================================================
// SELECT FIRST DATE AND APPLY
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Configure Investigations dates popup\n' +
	'- Clean the selected dates list\n' +
	'- Select the first available date\n' +
	'- Double click the selected date\n' +
	'- Apply the selection\n' +
	'- Wait for the Investigations tab'
)

Map datesSelection =
	CustomKeywords.
	'pageObject.JustificationDesComptesDeLatentKeywords.validateDefaultDatesAndApply'(
		popupTimeout,
		screenLoadTimeout
	)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Investigations date applied successfully\n' +
	'Selected date: ' + datesSelection.selectedDate + '\n' +
	'Opened tab: ' + datesSelection.openedTab
)


// ======================================================
// VALIDATE REF COMPTA REQUIRED ALERT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Validate error when REF COMPTA is not selected\n' +
	'Action: Double click first Total (ccy) result'
)

CustomKeywords.
'pageObject.JustificationDesComptesDeLatentKeywords.validateMissingRefComptaAlert'(
	alertTimeout
)


// ======================================================
// APPLY REF COMPTA FILTER
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Apply REF COMPTA filter\n' +
	'- Clear current selection\n' +
	'- Drag REF COMPTA to the target area\n' +
	'- Validate filter was applied\n' +
	'- Validate available filter list was updated'
)

CustomKeywords.
'pageObject.JustificationDesComptesDeLatentKeywords.applyRefComptaFilter'(
	filterTimeout
)


// ======================================================
// APPLY SECTION FILTER
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Apply Section filter\n' +
	'Value: ' + sectionFilterValue
)

CustomKeywords.
'pageObject.JustificationDesComptesDeLatentKeywords.applySectionFilter'(
	sectionFilterValue,
	filterTimeout
)


// ======================================================
// EXPORT MAIN INVESTIGATIONS FILE
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Export main Investigations file\n' +
	'Environment: ' + targetEnvironment + '\n' +
	'Export label: ' + mainExportLabel
)

CustomKeywords.'commands.ExportFile.exportFromTwoExportImagesToNo'(
	mainExportLabel,
	targetEnvironment
)

Map mainExportValidation =
	CustomKeywords.
	'commands.ExportFileValidationKeywords.validateExportedFileExistsAndHasRows'(
		targetEnvironment,
		mainExportLabel
	)

String mainExportPath = new File(
	mainExportValidation.folderPath.toString(),
	mainExportValidation.fileName.toString()
).absolutePath

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Main Investigations export validation passed\n' +
	'File: ' + mainExportValidation.fileName + '\n' +
	'Data rows: ' + mainExportValidation.dataRows + '\n' +
	'File size: ' + mainExportValidation.fileSize + ' bytes'
)


// ======================================================
// VALIDATE SOURCE VALUES IN MAIN EXPORT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Validate Source values in main Investigations export\n' +
	'Expected non-empty values:\n' +
	'- BILAN\n' +
	'- RESULTAT\n' +
	'Blank Source cells and total rows are ignored'
)

Map mainSourceValidation =
	CustomKeywords.
	'pageObject.JustificationDesComptesDeLatentKeywords.validateMainExportSourceValues'(
		mainExportPath
	)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Main export Source validation passed\n' +
	'File: ' + mainSourceValidation.fileName + '\n' +
	'Source values: ' + mainSourceValidation.sourceValues + '\n' +
	'Non-empty Source rows: ' +
		mainSourceValidation.nonEmptySourceRows + '\n' +
	'Ignored blank or total rows: ' +
		mainSourceValidation.ignoredBlankRows
)


// ======================================================
// FILTER BY BILAN SOURCE
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Apply Source filter\n' +
	'Hover: ' + sourceHoverObjectKey + '\n' +
	'Search and select only: ' +
		bilanSourceValue.toUpperCase()
)

CustomKeywords.
'pageObject.JustificationDesComptesDeLatentKeywords.applySourceFilter'(
	bilanSourceValue,
	filterTimeout
)


// ======================================================
// EXPORT FILTERED BILAN FILE
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Export Investigations after BILAN filter\n' +
	'No screen validation is performed before the export\n' +
	'Export label: ' + bilanExportLabel
)

CustomKeywords.'commands.ExportFile.exportFromTwoExportImagesToNo'(
	bilanExportLabel,
	targetEnvironment
)

Map bilanExportValidation =
	CustomKeywords.
	'commands.ExportFileValidationKeywords.validateExportedFileExistsAndHasRows'(
		targetEnvironment,
		bilanExportLabel
	)

String bilanExportPath = new File(
	bilanExportValidation.folderPath.toString(),
	bilanExportValidation.fileName.toString()
).absolutePath

Map bilanSourceValidation =
	CustomKeywords.
	'pageObject.JustificationDesComptesDeLatentKeywords.validateFilteredExportSourceValue'(
		bilanExportPath,
		bilanSourceValue,
		1
	)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Filtered BILAN export validation passed\n' +
	'File: ' + bilanSourceValidation.fileName + '\n' +
	'Source values: ' + bilanSourceValidation.sourceValues + '\n' +
	'Non-empty Source rows: ' +
		bilanSourceValidation.nonEmptySourceRows
)


// ======================================================
// CLEAR PREVIOUS BILAN SOURCE FILTER
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Clear previous BILAN Source filter before applying RESULTAT'
)

CustomKeywords.
'pageObject.JustificationDesComptesDeLatentKeywords.clearSourceFilterBeforeNextSelection'(
	resultatSourceValue,
	filterTimeout
)


// ======================================================
// FILTER BY RESULTAT SOURCE
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Apply Source filter\n' +
	'Hover: ' + sourceHoverObjectKey + '\n' +
	'Search and select only: ' +
		resultatSourceValue.toUpperCase()
)




// ======================================================
// EXPORT FILTERED RESULTAT FILE
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Export Investigations after RESULTAT filter\n' +
	'No screen validation is performed before the export\n' +
	'Export label: ' + resultatExportLabel
)

