✅ Não mexe em PROJECT_PATH nem nada do Jenkins
✅ Mantém espaçamento e legibilidade

@echo off
setlocal EnableExtensions

title eMatch - Archive Mode

set "COLLECTION=Test Suites/Archive Mode/Archive Mode Collection"

call "D:\Projects\eMatchStarters\run-ematch-command.bat" "%COLLECTION%"

exit /b %ERRORLEVEL%
