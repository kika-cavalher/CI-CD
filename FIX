	def readLastRunPath() {
		try {
			File file = new File(RunConfiguration.projectDir + '\\LastRun.xlsx')

			if (!file.exists()) {
				return null
			}

			FileInputStream fis = new FileInputStream(file)
			XSSFWorkbook wb = new XSSFWorkbook(fis)
			XSSFSheet sheet = wb.getSheetAt(0)
			XSSFRow row = sheet.getRow(0)
			String result = row.getCell(0).stringCellValue
			wb.close()
			fis.close()

			if (result != null && !result.trim().isEmpty()) {
				return result
			}

			return null
		} catch (Exception e) {
			KeywordUtil.logInfo("Could not read LastRun.xlsx: " + e.message)
			return null
		}
	}

	def containsUsefulReportFiles(File dir) {
		if (dir == null || !dir.exists() || !dir.isDirectory()) {
			return false
		}

		boolean found = false

		dir.eachFileRecurse(FileType.FILES) { file ->
			String name = file.name.toLowerCase()

			if (name.contains(XML_FILE_NAME_CONTAINS.toLowerCase())
				|| name.equalsIgnoreCase('cucumber.xml')
				|| name.equalsIgnoreCase('junit_report.xml')
				|| name.equalsIgnoreCase(HTML_REPORT_NAME.toLowerCase())
				|| name.endsWith('.html')
				|| name.equalsIgnoreCase('execution.log')) {
				found = true
			}
		}

		return found
	}

	def findLatestUsefulReportFolder(File rootDir) {
		if (rootDir == null || !rootDir.exists() || !rootDir.isDirectory()) {
			return null
		}

		List<File> candidates = []

		rootDir.eachFileRecurse(FileType.DIRECTORIES) { dir ->
			if (containsUsefulReportFiles(dir)) {
				candidates.add(dir)
			}
		}

		if (candidates.isEmpty()) {
			return null
		}

		return candidates.max { it.lastModified() }
	}

	def getResolvedReportPath() {
		List<String> attempted = []

		try {
			String currentPath = RunConfiguration.getReportFolder()

			if (currentPath != null && !currentPath.trim().isEmpty()) {
				attempted.add(currentPath)

				File currentDir = new File(currentPath)

				if (containsUsefulReportFiles(currentDir)) {
					KeywordUtil.logInfo("Using RunConfiguration report folder: ${currentDir.absolutePath}")
					return currentDir.absolutePath
				}
			}
		} catch (Exception e) {
			KeywordUtil.logInfo("RunConfiguration report path could not be used: " + e.message)
		}

		String lastRunPath = readLastRunPath()

		if (lastRunPath != null) {
			attempted.add(lastRunPath)

			File lastRunDir = new File(lastRunPath)

			if (containsUsefulReportFiles(lastRunDir)) {
				KeywordUtil.logInfo("Using LastRun.xlsx report folder: ${lastRunDir.absolutePath}")
				return lastRunDir.absolutePath
			}
		}

		List<File> searchRoots = []

		try {
			searchRoots.add(new File(RunConfiguration.projectDir + '\\Reports'))
		} catch (Exception e) {
		}

		try {
			searchRoots.add(new File(System.getProperty("user.dir") + '\\Reports'))
		} catch (Exception e) {
		}

		searchRoots = searchRoots.findAll { it != null && it.exists() && it.isDirectory() }

		for (File root : searchRoots) {
			File latest = findLatestUsefulReportFolder(root)

			if (latest != null) {
				KeywordUtil.logInfo("Using auto-detected report folder: ${latest.absolutePath}")
				return latest.absolutePath
			}
		}

		KeywordUtil.markFailed("No valid report folder found. Attempted paths: ${attempted}")
		return null
	}

