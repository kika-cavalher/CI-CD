package pageObject

import java.text.SimpleDateFormat

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import commands.ImageLoader
import commands.WindowsObjectLoader
import component.RechercheKeywords


class PNLComptableKeywords {

	private static final Integer DEFAULT_TIMEOUT = 20

	private final ImageLoader imageLoader =
		new ImageLoader()

	private final RechercheKeywords rechercheKeywords =
		new RechercheKeywords()


	// ======================================================
	// VALIDATE OPENED TAB
	// ======================================================

	@Keyword
	void validateOpenedTab(
			String openedTabName,
			String evidencePrefix,
			Integer timeoutSeconds
	) {

		Integer timeout =
				safeTimeout(
				timeoutSeconds
				)

		String tabName =
				requiredText(
				openedTabName,
				'PNL Comptable opened tab name'
				)

		String prefix =
				safeText(
				evidencePrefix
				)

		WindowsTestObject tabObject =
				WindowsObjectLoader.getTabByName(
				tabName
				)

		if (!Windows.waitForElementPresent(
				tabObject,
				timeout,
				FailureHandling.OPTIONAL
				)) {

			takeEvidence(
				prefix +
				'_PNLComptable_TabNotOpened.png'
				)

			KeywordUtil.markFailedAndStop(
				'PNL Comptable tab was not opened.\n' +
				'Expected tab: ' +
				tabName
				)

			return
		}

		takeEvidence(
			prefix +
				'_PNLComptable_Opened.png'
				)

		KeywordUtil.logInfo(
			'[PASS] PNL Comptable tab opened successfully.\n' +
				'Opened tab: ' +
				tabName
				)
	}


	// ======================================================
	// APPLY RECHERCHE FILTERS
	// ======================================================

	@Keyword
	Map applyRechercheFilters(
			String sectionValue,
			String transactionCurrencyValue,
			String minimumAccountingDate,
			String maximumAccountingDate,
			Integer timeoutSeconds
	) {

		String section =
				requiredText(
				sectionValue,
				'Section'
				)

		String transactionCurrency =
				requiredText(
				transactionCurrencyValue,
				'Transaction currency'
				)

		String minimumDate =
				requiredText(
				minimumAccountingDate,
				'Minimum accounting date'
				)

		String maximumDate =
				requiredText(
				maximumAccountingDate,
				'Maximum accounting date'
				)

		validateAccountingDate(
				minimumDate,
				'Minimum accounting date'
				)

		validateAccountingDate(
				maximumDate,
				'Maximum accounting date'
				)

		List<String> filterValues = [
			section,
			transactionCurrency,
			minimumDate,
			maximumDate
		]

		List<Integer> tabsBeforeValues = [
			18,
			9,
			7,
			1
		]

		Map rechercheResult =
				rechercheKeywords.
				applyRechercheFiltersWithTabSteps(
				filterValues,
				tabsBeforeValues,
				safeTimeout(
				timeoutSeconds
				)
				)

		takeEvidence(
			'PNLComptable_RechercheApplied.png'
				)

		KeywordUtil.logInfo(
			'[PASS] PNL Comptable Recherche filters applied.\n' +
				'Section: ' +
				section +
				'\nTransaction currency: ' +
				transactionCurrency +
				'\nMinimum accounting date: ' +
				minimumDate +
				'\nMaximum accounting date: ' +
				maximumDate
				)

		return [
			sectionValue             : section,
			transactionCurrencyValue : transactionCurrency,
			minimumAccountingDate    : minimumDate,
			maximumAccountingDate    : maximumDate,
			rechercheResult          : rechercheResult
		]
	}


	// ======================================================
	// WAIT FOR FILTERED CONTENT
	// ======================================================

	@Keyword
	void waitForFilteredContent(
			String evidencePrefix,
			Integer delaySeconds
	) {

		Integer delay =
				delaySeconds != null &&
				delaySeconds >= 0
					? delaySeconds
					: 0

		String prefix =
				safeText(
				evidencePrefix
				)

		if (delay > 0) {
			Windows.delay(
				delay
				)
		}

		takeEvidence(
			prefix +
				'_PNLComptable_FilteredResult.png'
				)
	}


	// ======================================================
	// INTERNAL HELPERS
	// ======================================================

	private void validateAccountingDate(
			String accountingDate,
			String label
	) {

		String dateValue =
				requiredText(
				accountingDate,
				label
				)

		SimpleDateFormat dateFormat =
				new SimpleDateFormat(
				'dd/MM/yyyy'
				)

		dateFormat.setLenient(
				false
				)

		try {
			dateFormat.parse(
				dateValue
				)
		} catch (Throwable dateError) {
			KeywordUtil.markFailedAndStop(
				label +
					' has an invalid format or value.\n' +
					'Expected format: dd/MM/yyyy\n' +
					'Actual value: ' +
					dateValue
					)
		}
	}


	private void takeEvidence(
			String fileName
	) {

		imageLoader.takeEvidence(
			fileName
			)
	}


	private Integer safeTimeout(
			Integer timeoutSeconds
	) {

		return timeoutSeconds != null &&
			timeoutSeconds > 0
				? timeoutSeconds
				: DEFAULT_TIMEOUT
	}


	private String requiredText(
			Object value,
			String label
	) {

		String text =
				safeText(
				value
				)

		if (text.isEmpty()) {
			KeywordUtil.markFailedAndStop(
				label +
					' cannot be empty.'
					)
		}

		return text
	}


	private String safeText(
			Object value
	) {

		return value == null
			? ''
			: value.toString().trim()
	}
}









































package component

import java.awt.Robot
import java.awt.Toolkit
import java.awt.datatransfer.StringSelection
import java.awt.event.KeyEvent

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import commands.ImageLoader
import commands.WindowsObjectLoader


class RechercheKeywords {

	private static final Integer DEFAULT_TIMEOUT = 20
	private static final Integer POLLING_DELAY_SECONDS = 1

	private static final String RECHERCHE_IMAGE_GROUP =
	'General'

	private static final String RECHERCHE_OBJECT_GROUP =
	'filter'

	private static final String RECHERCHE_BUTTON_IMAGE_KEY =
	'rechercheTab'

	private static final String RECHERCHE_BUTTON_OBJECT_KEY =
	'rechercheButton'

	private static final String RECHERCHER_BUTTON_IMAGE_KEY =
	'rechercherButton'

	private static final String RECHERCHER_BUTTON_OBJECT_KEY =
	'rechercherButton'

	private final ImageLoader imageLoader =
	new ImageLoader()


	// ======================================================
	// APPLY RECHERCHE FILTER USING KEYBOARD NAVIGATION
	// ======================================================

	@Keyword
	Map applyRechercheFilterWithTabs(
			String imageGroup,
			String objectGroup,
			String rechercheButtonImageKey,
			String rechercheButtonObjectKey,
			String rechercherButtonImageKey,
			String rechercherButtonObjectKey,
			String filterValue,
			Integer tabsToInput,
			Integer timeoutSeconds
	) {

		Integer timeout =
				safeTimeout(timeoutSeconds)

		Integer tabCount =
				tabsToInput != null &&
				tabsToInput >= 0
				? tabsToInput
				: 2

		String value =
				safeText(filterValue)

		if (value.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Recherche filter value cannot be empty.'
					)

			return [:]
		}

		clickObjectFirstThenImage(
				imageGroup,
				objectGroup,
				rechercheButtonImageKey,
				rechercheButtonObjectKey,
				'Recherche button',
				timeout
				)

		Windows.delay(
				POLLING_DELAY_SECONDS
				)

		focusInputWithTabsAndReplaceText(
				value,
				tabCount
				)

		Windows.delay(
				POLLING_DELAY_SECONDS
				)

		clickObjectFirstThenImage(
				imageGroup,
				objectGroup,
				rechercherButtonImageKey,
				rechercherButtonObjectKey,
				'Rechercher button',
				timeout
				)

		Windows.delay(2)

		KeywordUtil.logInfo(
				'[PASS] Recherche filter applied successfully.\n' +
				'Value: ' +
				value +
				'\nTabs used to reach input: ' +
				tabCount
				)

		return [
			value      : value,
			tabsToInput: tabCount,
			objectGroup: objectGroup
		]
	}


	// ======================================================
	// APPLY MULTIPLE RECHERCHE FILTERS
	// ======================================================

	@Keyword
	Map applySequentialRechercheFiltersWithTabs(
			List<String> filterValues,
			Integer tabsToFirstInput,
			Integer tabsBetweenInputs,
			Integer timeoutSeconds
	) {

		Integer timeout =
				safeTimeout(timeoutSeconds)

		Integer firstInputTabs =
				tabsToFirstInput != null &&
				tabsToFirstInput >= 0
				? tabsToFirstInput
				: 2

		Integer betweenInputTabs =
				tabsBetweenInputs != null &&
				tabsBetweenInputs > 0
				? tabsBetweenInputs
				: 1

		List<String> values =
				filterValues == null
				? []
				: filterValues.collect { Object value ->
					safeText(value)
				}

		if (values.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Recherche filter values cannot be empty.'
					)

			return [:]
		}

		Integer emptyValueIndex =
				values.findIndexOf { String value ->
					value.isEmpty()
				}

		if (emptyValueIndex >= 0) {
			KeywordUtil.markFailedAndStop(
					'Recherche filter value cannot be empty.\n' +
					'Position: ' +
					(emptyValueIndex + 1)
					)

			return [:]
		}

		clickObjectFirstThenImage(
				RECHERCHE_IMAGE_GROUP,
				RECHERCHE_OBJECT_GROUP,
				RECHERCHE_BUTTON_IMAGE_KEY,
				RECHERCHE_BUTTON_OBJECT_KEY,
				'Recherche button',
				timeout
				)

		Windows.delay(
				POLLING_DELAY_SECONDS
				)

		focusFirstInputAndFillSequence(
				values,
				firstInputTabs,
				betweenInputTabs
				)

		Windows.delay(
				POLLING_DELAY_SECONDS
				)

		clickObjectFirstThenImage(
				RECHERCHE_IMAGE_GROUP,
				RECHERCHE_OBJECT_GROUP,
				RECHERCHER_BUTTON_IMAGE_KEY,
				RECHERCHER_BUTTON_OBJECT_KEY,
				'Rechercher button',
				timeout
				)

		Windows.delay(2)

		KeywordUtil.logInfo(
				'[PASS] Sequential Recherche filters applied successfully.\n' +
				'Values: ' +
				values +
				'\nTabs to first input: ' +
				firstInputTabs +
				'\nTabs between inputs: ' +
				betweenInputTabs
				)

		return [
			values           : values,
			filterCount      : values.size(),
			tabsToFirstInput : firstInputTabs,
			tabsBetweenInputs: betweenInputTabs
		]
	}


	// ======================================================
	// APPLY RECHERCHE FILTERS USING INDIVIDUAL TAB STEPS
	// ======================================================

	@Keyword
	Map applyRechercheFiltersWithTabSteps(
			List<String> filterValues,
			List<Integer> tabsBeforeValues,
			Integer timeoutSeconds
	) {

		Integer timeout =
				safeTimeout(
				timeoutSeconds
				)

		List<String> values =
				filterValues == null
				? []
				: filterValues.collect { Object value ->
					safeText(
					value
					)
				}

		List<Integer> tabSteps =
				tabsBeforeValues == null
				? []
				: tabsBeforeValues.collect { Object value ->
					value == null
						? 0
						: Integer.valueOf(
							value.toString()
							)
				}

		if (values.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Recherche filter values cannot be empty.'
					)

			return [:]
		}

		if (values.size() != tabSteps.size()) {
			KeywordUtil.markFailedAndStop(
					'Recherche values and TAB steps must have the same size.\n' +
					'Values: ' +
					values.size() +
					'\nTAB steps: ' +
					tabSteps.size()
					)

			return [:]
		}

		Integer invalidValueIndex =
				values.findIndexOf { String value ->
					value.isEmpty()
				}

		if (invalidValueIndex >= 0) {
			KeywordUtil.markFailedAndStop(
					'Recherche filter value cannot be empty.\n' +
					'Position: ' +
					(invalidValueIndex + 1)
					)

			return [:]
		}

		Integer invalidTabIndex =
				tabSteps.findIndexOf { Integer tabCount ->
					tabCount == null ||
					tabCount < 0
				}

		if (invalidTabIndex >= 0) {
			KeywordUtil.markFailedAndStop(
					'Recherche TAB step cannot be negative.\n' +
					'Position: ' +
					(invalidTabIndex + 1) +
					'\nActual value: ' +
					tabSteps.get(
					invalidTabIndex
					)
					)

			return [:]
		}

		clickObjectFirstThenImage(
				RECHERCHE_IMAGE_GROUP,
				RECHERCHE_OBJECT_GROUP,
				RECHERCHE_BUTTON_IMAGE_KEY,
				RECHERCHE_BUTTON_OBJECT_KEY,
				'Recherche button',
				timeout
				)

		Windows.delay(
				POLLING_DELAY_SECONDS
				)

		Robot robot =
				new Robot()

		for (Integer index = 0;
				index < values.size();
				index++) {

			pressTabs(
					robot,
					tabSteps.get(
					index
					)
					)

			replaceFocusedText(
					robot,
					values.get(
					index
					)
					)
		}

		Windows.delay(
				POLLING_DELAY_SECONDS
				)

		clickObjectFirstThenImage(
				RECHERCHE_IMAGE_GROUP,
				RECHERCHE_OBJECT_GROUP,
				RECHERCHER_BUTTON_IMAGE_KEY,
				RECHERCHER_BUTTON_OBJECT_KEY,
				'Rechercher button',
				timeout
				)

		Windows.delay(2)

		KeywordUtil.logInfo(
				'[PASS] Recherche filters applied using individual TAB steps.\n' +
				'Values: ' +
				values +
				'\nTAB steps: ' +
				tabSteps
				)

		return [
			values   : values,
			tabSteps : tabSteps,
			filterCount: values.size()
		]
	}


	// ======================================================
	// INTERNAL HELPERS
	// ======================================================

	private void focusFirstInputAndFillSequence(
			List<String> values,
			Integer tabsToFirstInput,
			Integer tabsBetweenInputs
	) {

		Robot robot =
				new Robot()

		pressTabs(
				robot,
				tabsToFirstInput
				)

		for (Integer index = 0;
				index < values.size();
				index++) {

			replaceFocusedText(
					robot,
					values.get(index)
					)

			if (index < values.size() - 1) {
				pressTabs(
						robot,
						tabsBetweenInputs
						)
			}
		}
	}


	private void focusInputWithTabsAndReplaceText(
			String value,
			Integer tabsToInput
	) {

		Robot robot =
				new Robot()

		pressTabs(
				robot,
				tabsToInput
				)

		replaceFocusedText(
				robot,
				value
				)
	}


	private void pressTabs(
			Robot robot,
			Integer tabCount
	) {

		for (Integer index = 0;
				index < tabCount;
				index++) {

			robot.keyPress(
					KeyEvent.VK_TAB
					)
			robot.keyRelease(
					KeyEvent.VK_TAB
					)

			Thread.sleep(200L)
		}
	}


	private void replaceFocusedText(
			Robot robot,
			String value
	) {

		robot.keyPress(
				KeyEvent.VK_CONTROL
				)
		robot.keyPress(
				KeyEvent.VK_A
				)
		robot.keyRelease(
				KeyEvent.VK_A
				)
		robot.keyRelease(
				KeyEvent.VK_CONTROL
				)

		robot.keyPress(
				KeyEvent.VK_BACK_SPACE
				)
		robot.keyRelease(
				KeyEvent.VK_BACK_SPACE
				)

		Toolkit
				.getDefaultToolkit()
				.getSystemClipboard()
				.setContents(
				new StringSelection(value),
				null
				)

		robot.keyPress(
				KeyEvent.VK_CONTROL
				)
		robot.keyPress(
				KeyEvent.VK_V
				)
		robot.keyRelease(
				KeyEvent.VK_V
				)
		robot.keyRelease(
				KeyEvent.VK_CONTROL
				)

		Thread.sleep(300L)
	}


	private void clickObjectFirstThenImage(
			String imageGroup,
			String objectGroup,
			String imageKey,
			String objectKey,
			String description,
			Integer timeoutSeconds
	) {

		Integer timeout =
				safeTimeout(timeoutSeconds)

		Integer objectTimeout =
				Math.min(
				timeout,
				5
				)

		try {
			WindowsTestObject targetObject =
					WindowsObjectLoader.getObject(
					objectGroup,
					objectKey
					)

			if (targetObject != null &&
					Windows.waitForElementPresent(
					targetObject,
					objectTimeout,
					FailureHandling.OPTIONAL
					)) {

				Windows.click(
					targetObject,
					FailureHandling.STOP_ON_FAILURE
					)

				KeywordUtil.logInfo(
					'[OBJECT] ' +
						description +
						' clicked.'
						)

				return
			}
		} catch (Throwable objectError) {
			KeywordUtil.logInfo(
					'[OBJECT] Could not click ' +
					description +
					'. Trying image.\n' +
					'Reason: ' +
					safeText(objectError.message)
					)
		}

		Integer imageTimeout =
				Math.min(
				timeout,
				5
				)

		try {
			if (imageLoader.waitForImage(
					imageGroup,
					imageKey,
					imageTimeout
					)) {

				WindowsImageKeywords.clickImage(
					imageLoader.getImage(
					imageGroup,
					imageKey
					)
					)

				KeywordUtil.logInfo(
					'[IMAGE] ' +
						description +
						' clicked.'
						)

				return
			}
		} catch (Throwable imageError) {
			KeywordUtil.logInfo(
					'[IMAGE] Could not click ' +
					description +
					'.\nReason: ' +
					safeText(imageError.message)
					)
		}

		KeywordUtil.markFailedAndStop(
				description +
				' was not found by Windows object or image.\n' +
				'Object group: ' +
				objectGroup +
				'\nObject key: ' +
				objectKey +
				'\nImage group: ' +
				imageGroup +
				'\nImage key: ' +
				imageKey
				)
	}


	private Integer safeTimeout(
			Integer timeoutSeconds
	) {

		return timeoutSeconds != null &&
				timeoutSeconds > 0
				? timeoutSeconds
				: DEFAULT_TIMEOUT
	}


	private String safeText(
			Object value
	) {

		return value == null
				? ''
				: value.toString().trim()
	}
}




