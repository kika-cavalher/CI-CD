    private static String safe(def value) {
        return value == null ? '' : value.toString().trim()
    }

    private static String ps(def value) {
        return safe(value).replace("'", "''")
    }

    private static boolean fileExists(String path) {
        return safe(path) && new File(path).exists()
    }

    private static void sleepMs(long ms) {
        try {
            Thread.sleep(ms)
        } catch (Throwable ignored) {
        }
    }

    private static String readEnv() {
        String env = ''
        try {
            env = safe(GlobalVariable.env)
        } catch (Throwable ignored) {
        }
        return env ? env.toUpperCase() : 'REC'
    }

    private static String normalizeTitle(String title) {
        String value = safe(title).replaceAll(/\s+/, ' ').trim()
        value = value.replaceFirst(/(?i)^ematch\s+ematch\s+/, 'eMatch ')
        value = value.replaceFirst(/(?i)^ematch\s+/, 'eMatch ')
        return value
    }

    private static String extractVersionFromTitle(String title) {
        String value = normalizeTitle(title)
        return value.replaceFirst(/(?i)^eMatch\s+/, '').trim()
    }

    private static String runPowerShell(String script, int timeoutSeconds = 30) {
        try {
            Process process = new ProcessBuilder(
                'powershell',
                '-NoProfile',
                '-ExecutionPolicy', 'Bypass',
                '-Command',
                script
            ).redirectErrorStream(true).start()

            StringBuilder output = new StringBuilder()
            long end = System.currentTimeMillis() + (timeoutSeconds * 1000L)

            while (System.currentTimeMillis() < end) {
                while (process.inputStream.available() > 0) {
                    output.append((char) process.inputStream.read())
                }

                try {
                    process.exitValue()
                    while (process.inputStream.available() > 0) {
                        output.append((char) process.inputStream.read())
                    }
                    return output.toString().trim()
                } catch (IllegalThreadStateException ignored) {
                }

                sleepMs(200)
            }

            process.destroyForcibly()
            return output.toString().trim()
        } catch (Throwable t) {
            KeywordUtil.logInfo("PowerShell failed: ${safe(t.message)}")
            return ''
        }
    }

    private static void runDetached(String command) {
        try {
            new ProcessBuilder('cmd', '/c', command).start()
        } catch (Throwable t) {
            KeywordUtil.logInfo("Detached command failed: ${safe(t.message)}")
        }
    }

