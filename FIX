// ======================================================
// SIMPLE EXPORTED FILE VALIDATION
// Uses the exact folder and file naming logic from ExportFile.
// Large XLSX/XLSM files are counted using SAX streaming.
// ======================================================

@Keyword
Map validateExportedFileExistsAndHasRows(
		String targetEnvironment,
		String exportLabel) {

	String environment = safeText(targetEnvironment)
	String expectedExportLabel = safeText(exportLabel)

	if (expectedExportLabel.isEmpty()) {
		KeywordUtil.markFailedAndStop(
				'Simple export validation failed.\n' +
				'Export label was not configured.'
				)

		return [success: false]
	}

	ExportFile exportFileKeyword = new ExportFile()

	String exportFolderPath =
			exportFileKeyword.getCurrentExportFolderPath(
			environment,
			expectedExportLabel
			)

	KeywordUtil.logInfo(
			'Simple export validation started.\n' +
			'Environment: ' + environment + '\n' +
			'Export label: ' + expectedExportLabel + '\n' +
			'Folder: ' + exportFolderPath
			)

	String folderValidation =
			validateEvidenceFolderExists(
			exportFolderPath
			)

	if (!safeText(folderValidation).isEmpty()) {
		KeywordUtil.markFailedAndStop(
				'Simple export validation failed.\n' +
				folderValidation.trim()
				)

		return [
			success   : false,
			folderPath: exportFolderPath
		]
	}

	String exportedFilePath =
			exportFileKeyword.findLatestExportedFilePath(
			environment,
			expectedExportLabel
			)

	if (safeText(exportedFilePath).isEmpty()) {
		KeywordUtil.markFailedAndStop(
				'Simple export validation failed.\n' +
				'Downloaded Excel file was not found.\n' +
				'Environment: ' + environment + '\n' +
				'Export label: ' + expectedExportLabel + '\n' +
				'Folder: ' + exportFolderPath
				)

		return [
			success   : false,
			folderPath: exportFolderPath
		]
	}

	String fileValidation =
			validateExcelFilesFound(
			exportedFilePath
			)

	if (!safeText(fileValidation).isEmpty()) {
		KeywordUtil.markFailedAndStop(
				'Simple export validation failed.\n' +
				fileValidation.trim()
				)

		return [
			success   : false,
			filePath  : exportedFilePath,
			folderPath: exportFolderPath
		]
	}

	File exportedFile = new File(exportedFilePath)

	if (exportedFile.length() <= 0) {
		KeywordUtil.markFailedAndStop(
				'Simple export validation failed.\n' +
				'Downloaded file is empty.\n' +
				'File: ' + exportedFile.getName() + '\n' +
				'Path: ' + exportedFile.getAbsolutePath()
				)

		return [
			success   : false,
			filePath  : exportedFilePath,
			folderPath: exportFolderPath
		]
	}

	String lowerFileName = exportedFile.getName().toLowerCase(Locale.ENGLISH)
	boolean supportsStreaming =
			lowerFileName.endsWith('.xlsx') ||
			lowerFileName.endsWith('.xlsm')

	boolean useStreamingImmediately =
			supportsStreaming &&
			exportedFile.length() >= LARGE_EXCEL_STREAMING_THRESHOLD_BYTES

	Integer dataRows = null
	String validationMode = ''
	String validationReason = ''

	if (useStreamingImmediately) {
		KeywordUtil.logInfo(
				'Large Excel file detected.\n' +
				'File: ' + exportedFile.getName() + '\n' +
				'File size: ' + exportedFile.length() + ' bytes\n' +
				'Validation mode: STREAMING ROW COUNT\n' +
				'Reason: file size is greater than or equal to ' +
				LARGE_EXCEL_STREAMING_THRESHOLD_BYTES + ' bytes.'
				)

		try {
			dataRows = countXlsxDataRowsStreaming(exportedFile)
			validationMode = 'STREAMING ROW COUNT'
			validationReason =
					'The file was large, so only the first worksheet row quantity ' +
					'was read without loading the complete workbook into memory.'
		} catch (Throwable throwable) {
			KeywordUtil.markFailedAndStop(
					'Simple export validation failed while reading the large Excel file.\n' +
					'File: ' + exportedFile.getName() + '\n' +
					'Validation mode: STREAMING ROW COUNT\n' +
					'Exception: ' + throwable.getClass().getSimpleName() + '\n' +
					'Message: ' + safeText(throwable.getMessage())
					)

			return [
				success       : false,
				fileName      : exportedFile.getName(),
				filePath      : exportedFile.getAbsolutePath(),
				folderPath    : exportFolderPath,
				fileSize      : exportedFile.length(),
				validationMode: 'STREAMING ROW COUNT'
			]
		}
	} else {
		FileInputStream input = null
		Workbook workbook = null

		try {
			input = new FileInputStream(exportedFile)
			workbook = WorkbookFactory.create(input)

			if (workbook.getNumberOfSheets() <= 0) {
				KeywordUtil.markFailedAndStop(
						'Simple export validation failed.\n' +
						'Downloaded Excel file does not contain worksheets.\n' +
						'File: ' + exportedFile.getName()
						)

				return [
					success   : false,
					filePath  : exportedFilePath,
					folderPath: exportFolderPath
				]
			}

			Sheet sheet = workbook.getSheetAt(0)
			DataFormatter formatter = new DataFormatter()
			FormulaEvaluator evaluator =
					workbook
					.getCreationHelper()
					.createFormulaEvaluator()

			dataRows =
					countNonEmptyDataRows(
					sheet,
					formatter,
					evaluator
					)

			validationMode = 'STANDARD WORKBOOK'
			validationReason =
					'The workbook was small enough to be loaded normally.'

		} catch (OutOfMemoryError memoryError) {
			closeWorkbook(workbook)
			workbook = null
			closeInput(input)
			input = null

			if (!supportsStreaming) {
				KeywordUtil.markFailedAndStop(
						'Simple export validation failed because the Excel file is too large for available Java memory.\n' +
						'File: ' + exportedFile.getName() + '\n' +
						'File type: legacy XLS does not support the XLSX streaming fallback.\n' +
						'Exception: ' + memoryError.getClass().getSimpleName() + '\n' +
						'Message: ' + safeText(memoryError.getMessage())
						)

				return [
					success   : false,
					fileName  : exportedFile.getName(),
					filePath  : exportedFile.getAbsolutePath(),
					folderPath: exportFolderPath,
					fileSize  : exportedFile.length()
				]
			}

			KeywordUtil.logInfo(
					'Standard Excel reading exceeded available Java memory.\n' +
					'File: ' + exportedFile.getName() + '\n' +
					'Fallback: STREAMING ROW COUNT'
					)

			try {
				dataRows = countXlsxDataRowsStreaming(exportedFile)
				validationMode = 'STREAMING ROW COUNT'
				validationReason =
						'The standard Apache POI workbook reading exceeded available ' +
						'Java memory. Validation continued using SAX streaming.'
			} catch (Throwable streamingError) {
				KeywordUtil.markFailedAndStop(
						'Simple export validation failed.\n' +
						'The standard workbook reading exceeded available Java memory ' +
						'and the streaming fallback also failed.\n' +
						'File: ' + exportedFile.getName() + '\n' +
						'Standard exception: ' +
						memoryError.getClass().getSimpleName() + ' | ' +
						safeText(memoryError.getMessage()) + '\n' +
						'Streaming exception: ' +
						streamingError.getClass().getSimpleName() + ' | ' +
						safeText(streamingError.getMessage())
						)

				return [
					success       : false,
					fileName      : exportedFile.getName(),
					filePath      : exportedFile.getAbsolutePath(),
					folderPath    : exportFolderPath,
					fileSize      : exportedFile.length(),
					validationMode: 'STREAMING ROW COUNT'
				]
			}
		} catch (Exception exception) {
			KeywordUtil.markFailedAndStop(
					'Simple export validation failed while reading the Excel file.\n' +
					'File: ' + exportedFile.getName() + '\n' +
					'Exception: ' + exception.getClass().getSimpleName() + '\n' +
					'Message: ' + safeText(exception.getMessage())
					)

			return [
				success   : false,
				fileName  : exportedFile.getName(),
				filePath  : exportedFile.getAbsolutePath(),
				folderPath: exportFolderPath
			]
		} finally {
			closeWorkbook(workbook)
			closeInput(input)
		}
	}

	if (dataRows == null || dataRows <= 0) {
		KeywordUtil.markFailedAndStop(
				'Simple export validation failed.\n' +
				'Downloaded Excel file does not contain data rows.\n' +
				'File: ' + exportedFile.getName() + '\n' +
				'Validation mode: ' + validationMode + '\n' +
				'Data rows: ' + (dataRows == null ? 'Not available' : dataRows)
				)

		return [
			success       : false,
			fileName      : exportedFile.getName(),
			filePath      : exportedFile.getAbsolutePath(),
			folderPath    : exportFolderPath,
			dataRows      : dataRows,
			fileSize      : exportedFile.length(),
			validationMode: validationMode
		]
	}

	Map result = [
		success         : true,
		fileName        : exportedFile.getName(),
		filePath        : exportedFile.getAbsolutePath(),
		folderPath      : exportFolderPath,
		dataRows        : dataRows,
		fileSize        : exportedFile.length(),
		validationMode  : validationMode,
		validationReason: validationReason
	]

	KeywordUtil.markPassed(
			'Downloaded export validated successfully.\n' +
			'File exists: YES\n' +
			'File: ' + exportedFile.getName() + '\n' +
			'File size: ' + exportedFile.length() + ' bytes\n' +
			'Validation mode: ' + validationMode + '\n' +
			'Validation reason: ' + validationReason + '\n' +
			'Data rows: ' + dataRows + '\n' +
			'Folder: ' + exportFolderPath
			)

	return result
}


// ======================================================
// LARGE XLSX/XLSM STREAMING HELPERS
// ======================================================

private Integer countXlsxDataRowsStreaming(File excelFile) {

	if (excelFile == null || !excelFile.exists() || !excelFile.isFile()) {
		throw new IllegalArgumentException(
				'Excel file was not found for streaming row count.'
				)
	}

	OPCPackage opcPackage = null
	InputStream sheetInput = null

	try {
		opcPackage = OPCPackage.open(excelFile)
		XSSFReader reader = new XSSFReader(opcPackage)
		Iterator<InputStream> sheets = reader.getSheetsData()

		if (sheets == null || !sheets.hasNext()) {
			throw new IllegalStateException(
					'Excel workbook does not contain worksheets.'
					)
		}

		sheetInput = sheets.next()

		SAXParserFactory parserFactory = SAXParserFactory.newInstance()
		parserFactory.setNamespaceAware(true)

		XMLReader xmlReader =
				parserFactory
				.newSAXParser()
				.getXMLReader()

		StreamingRowCountHandler handler =
				new StreamingRowCountHandler()

		xmlReader.setContentHandler(handler)
		xmlReader.parse(new InputSource(sheetInput))

		Integer physicalRows = handler.getPhysicalRows()

		if (physicalRows <= 0) {
			return 0
		}

		// The first physical row is treated as the header,
		// following the same behavior as countNonEmptyDataRows.
		return Math.max(physicalRows - 1, 0)
	} finally {
		closeInputStream(sheetInput)
		closeOpcPackage(opcPackage)
	}
}

private void closeInputStream(InputStream input) {
	try {
		if (input != null) {
			input.close()
		}
	} catch (Exception ignored) {
	}
}

private void closeOpcPackage(OPCPackage opcPackage) {
	try {
		if (opcPackage != null) {
			opcPackage.close()
		}
	} catch (Exception ignored) {
	}
}

private static class StreamingRowCountHandler
		extends DefaultHandler {

	private Integer physicalRows = 0

	@Override
	void startElement(
			String uri,
			String localName,
			String qName,
			Attributes attributes) {

		String elementName =
				localName == null || localName.isEmpty()
				? qName
				: localName

		if ('row'.equalsIgnoreCase(elementName)) {
			physicalRows++
		}
	}

	Integer getPhysicalRows() {
		return physicalRows
	}
}
