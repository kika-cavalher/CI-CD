package jiraIntegration

import com.kms.katalon.core.util.KeywordUtil

class JiraTestPlanManager {

	JiraFlowCoordinator owner
	JiraGateway gateway

	JiraTestPlanManager(JiraFlowCoordinator owner, JiraGateway gateway) {
		this.owner = owner
		this.gateway = gateway
	}

	String getOrCreateTestPlanKey() {
		if (!owner.isBlank(owner.MANUAL_TEST_PLAN_KEY)) {
			KeywordUtil.logInfo("Using manual Test Plan key: ${owner.MANUAL_TEST_PLAN_KEY}")
			return owner.safe(owner.MANUAL_TEST_PLAN_KEY)
		}

		if (!owner.FORCE_CREATE_NEW_TEST_PLAN) {
			String savedKey = getSavedValidTestPlanKey()
			if (!owner.isBlank(savedKey)) {
				return savedKey
			}

			String existingKey = findExistingTestPlanKey()
			if (!owner.isBlank(existingKey)) {
				owner.saveSuiteTestPlanKey(existingKey)
				return existingKey
			}
		}

		String createdKey = createTestPlan()
		if (!owner.isBlank(createdKey) && !createdKey.startsWith('ERROR')) {
			owner.saveSuiteTestPlanKey(createdKey)
		}

		return createdKey
	}

	String getSavedValidTestPlanKey() {
		String savedKey = owner.readSavedSuiteTestPlanKey()
		if (owner.isBlank(savedKey)) {
			return ''
		}

		Map savedIssueResult = gateway.getIssueByKey(savedKey)
		int statusCode = (savedIssueResult?.statusCode ?: 0) as int

		if (statusCode != 200) {
			KeywordUtil.logInfo("Saved Test Plan key is no longer valid: ${savedKey}")
			return ''
		}

		String expectedSummary = owner.getTestPlanName()
		String savedSummary = owner.safe(savedIssueResult?.issue?.fields?.summary)
		String savedType = owner.safe(savedIssueResult?.issue?.fields?.issuetype?.name)

		if (owner.normalizeTitle(savedSummary) == owner.normalizeTitle(expectedSummary) &&
			owner.normalizeTitle(savedType) == 'test plan') {
			KeywordUtil.logInfo("Using saved Test Plan key for suite ${owner.getCurrentSuiteName()}: ${savedKey}")
			return savedKey
		}

		KeywordUtil.logInfo("Saved Test Plan key does not match current suite/title. Ignoring key: ${savedKey}")
		return ''
	}

	String findExistingTestPlanKey() {
		String expectedSummary = owner.getTestPlanName()
		Map response = gateway.searchTestPlans(expectedSummary, owner.EPIC_KEY)

		int statusCode = (response?.statusCode ?: 0) as int
		if (statusCode != 200) {
			KeywordUtil.logInfo("Search Test Plan failed with status: ${statusCode}")
			return ''
		}

		List issues = response?.issues instanceof List ? (response.issues as List) : []
		if (issues.isEmpty()) {
			KeywordUtil.logInfo("No existing Test Plan found for summary: ${expectedSummary}")
			return ''
		}

		def matchedIssue = issues.find { issue ->
			String issueSummary = owner.safe(issue?.fields?.summary)
			String issueType = owner.safe(issue?.fields?.issuetype?.name)

			return owner.normalizeTitle(issueSummary) == owner.normalizeTitle(expectedSummary) &&
					owner.normalizeTitle(issueType) == 'test plan'
		}

		if (matchedIssue == null) {
			KeywordUtil.logInfo("Search returned Test Plans, but none matched summary exactly: ${expectedSummary}")
			return ''
		}

		String key = owner.safe(matchedIssue?.key)
		if (!owner.isBlank(key)) {
			KeywordUtil.logInfo("Existing Test Plan found: ${key}")
		}

		return key
	}

	String createTestPlan() {
		String summary = owner.getTestPlanName()
		KeywordUtil.logInfo("Creating new Test Plan with summary: ${summary}")

		String createdKey = gateway.createTestPlan(summary, owner.EPIC_KEY)

		if (owner.isBlank(createdKey)) {
			return 'ERROR: empty Test Plan key returned from Jira'
		}

		if (createdKey.startsWith('ERROR')) {
			return createdKey
		}

		KeywordUtil.logInfo("New Test Plan created successfully: ${createdKey}")
		return createdKey
	}
}







package jiraIntegration

import java.net.URLEncoder
import java.nio.charset.StandardCharsets

import com.kms.katalon.core.testobject.HttpBodyContent
import com.kms.katalon.core.testobject.RequestObject
import com.kms.katalon.core.testobject.ResponseObject
import com.kms.katalon.core.testobject.TestObjectProperty
import com.kms.katalon.core.testobject.ConditionType
import com.kms.katalon.core.testobject.impl.HttpTextBodyContent
import com.kms.katalon.core.testobject.impl.HttpFileBodyContent
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webservice.keyword.WSBuiltInKeywords as WS

import groovy.json.JsonBuilder
import groovy.json.JsonSlurper
import internal.GlobalVariable

class JiraGateway {

	JiraFlowCoordinator owner
	JsonSlurper jsonSlurper = new JsonSlurper()

	JiraGateway(JiraFlowCoordinator owner) {
		this.owner = owner
	}

	void validateRequiredConfiguration() {
		List<String> missing = []

		if (owner.isBlank(resolveToken())) {
			missing << 'JIRA token'
		}
		if (owner.isBlank(owner.PROJECT_KEY)) {
			missing << 'PROJECT_KEY'
		}
		if (owner.isBlank(owner.JIRA_BASE_URL)) {
			missing << 'JIRA_BASE_URL'
		}

		if (!missing.isEmpty()) {
			KeywordUtil.markFailedAndStop('Missing Jira configuration: ' + missing.join(', '))
		}
	}

	String importExecutionResults(String xmlPath) {
		if (owner.isBlank(xmlPath)) {
			return 'ERROR: XML path is empty'
		}

		RequestObject request = new RequestObject('Runtime Import Results')
		request.setRestUrl(owner.JIRA_BASE_URL + '/rest/raven/1.0/import/execution/junit?projectKey=' + encode(owner.PROJECT_KEY))
		request.setRestRequestMethod('POST')
		request.setHttpHeaderProperties([
			header('Authorization', 'Bearer ' + resolveToken()),
			header('Content-Type', 'multipart/form-data')
		])
		request.setBodyContent(new HttpFileBodyContent(xmlPath))

		ResponseObject response = WS.sendRequest(request)

		int status = response.getStatusCode()
		String body = safeBody(response)

		KeywordUtil.logInfo("Import Results status: ${status}")
		KeywordUtil.logInfo("Import Results response: ${body}")

		if (status < 200 || status >= 300) {
			return "ERROR: import execution failed with status ${status}"
		}

		def parsed = parseJson(body)
		String key = owner.safe(parsed?.testExecIssue?.key ?: parsed?.key ?: parsed?.id)

		if (owner.isBlank(key)) {
			return 'ERROR: execution key not found in import response'
		}

		return key
	}

	int addExecutionToTestPlan(String testPlanKey, String executionKey) {
		if (owner.isBlank(testPlanKey) || owner.isBlank(executionKey)) {
			return 0
		}

		Map payload = [
			add: [executionKey]
		]

		RequestObject request = new RequestObject('Runtime Add Execution To Test Plan')
		request.setRestUrl(owner.JIRA_BASE_URL + '/rest/raven/2.0/api/testplan/' + encode(testPlanKey) + '/testexecution')
		request.setRestRequestMethod('POST')
		request.setHttpHeaderProperties(jsonHeaders())
		request.setBodyContent(jsonBody(payload))

		ResponseObject response = WS.sendRequest(request)
		int status = response.getStatusCode()

		KeywordUtil.logInfo("Add execution to Test Plan status: ${status}")
		KeywordUtil.logInfo("Add execution to Test Plan response: ${safeBody(response)}")

		return status
	}

	int updateTestExecution(String issueKey, String summary, String labels, String environment) {
		if (owner.isBlank(issueKey)) {
			return 0
		}

		List<String> labelList = []
		if (!owner.isBlank(labels)) {
			labelList = labels.split(',').collect { owner.safe(it) }.findAll { !owner.isBlank(it) }
		}

		Map fields = [
			summary: owner.safe(summary),
			labels : labelList
		]

		if (!owner.isBlank(environment)) {
			fields.environment = owner.safe(environment)
		}

		RequestObject request = new RequestObject('Runtime Update Test Execution')
		request.setRestUrl(owner.JIRA_BASE_URL + '/rest/api/2/issue/' + encode(issueKey))
		request.setRestRequestMethod('PUT')
		request.setHttpHeaderProperties(jsonHeaders())
		request.setBodyContent(jsonBody([fields: fields]))

		ResponseObject response = WS.sendRequest(request)
		int status = response.getStatusCode()

		KeywordUtil.logInfo("Update Test Execution status: ${status}")
		KeywordUtil.logInfo("Update Test Execution response: ${safeBody(response)}")

		return status
	}

	int uploadAttachment(String issueKey, String filePath) {
		if (owner.isBlank(issueKey) || owner.isBlank(filePath)) {
			return 0
		}

		RequestObject request = new RequestObject('Runtime Upload Attachment')
		request.setRestUrl(owner.JIRA_BASE_URL + '/rest/api/2/issue/' + encode(issueKey) + '/attachments')
		request.setRestRequestMethod('POST')
		request.setHttpHeaderProperties([
			header('Authorization', 'Bearer ' + resolveToken()),
			header('X-Atlassian-Token', 'no-check'),
			header('Content-Type', 'multipart/form-data')
		])
		request.setBodyContent(new HttpFileBodyContent(filePath))

		ResponseObject response = WS.sendRequest(request)
		int status = response.getStatusCode()

		KeywordUtil.logInfo("Upload attachment status (${filePath}): ${status}")
		KeywordUtil.logInfo("Upload attachment response: ${safeBody(response)}")

		return status
	}

	String createTestPlan(String summary, String epicKey) {
		String epicFieldId = resolveEpicFieldId()

		Map fields = [
			project  : [key: owner.PROJECT_KEY],
			summary  : owner.safe(summary),
			issuetype: [name: 'Test Plan']
		]

		if (!owner.isBlank(epicKey) && !owner.isBlank(epicFieldId)) {
			fields[epicFieldId] = owner.safe(epicKey)
		}

		RequestObject request = new RequestObject('Runtime Create Test Plan')
		request.setRestUrl(owner.JIRA_BASE_URL + '/rest/api/2/issue')
		request.setRestRequestMethod('POST')
		request.setHttpHeaderProperties(jsonHeaders())
		request.setBodyContent(jsonBody([fields: fields]))

		ResponseObject response = WS.sendRequest(request)

		int status = response.getStatusCode()
		String body = safeBody(response)

		KeywordUtil.logInfo("Create Test Plan status: ${status}")
		KeywordUtil.logInfo("Create Test Plan response: ${body}")

		if (status < 200 || status >= 300) {
			return "ERROR: create test plan failed with status ${status}"
		}

		def parsed = parseJson(body)
		String key = owner.safe(parsed?.key)

		if (owner.isBlank(key)) {
			return 'ERROR: created Test Plan key not found in response'
		}

		return key
	}

	Map searchTestPlans(String summary, String epicKey) {
		String jql =
				'project = "' + owner.PROJECT_KEY + '" ' +
				'AND issuetype = "Test Plan" ' +
				'ORDER BY created DESC'

		KeywordUtil.logInfo("Searching Test Plan using JQL: ${jql}")

		String url =
				owner.JIRA_BASE_URL +
				'/rest/api/2/search' +
				'?jql=' + encode(jql) +
				'&maxResults=200' +
				'&fields=' + encode('summary,created,issuetype')

		RequestObject request = new RequestObject('Runtime Search Test Plan')
		request.setRestUrl(url)
		request.setRestRequestMethod('GET')
		request.setHttpHeaderProperties(defaultGetHeaders())

		ResponseObject response = WS.sendRequest(request)

		int status = response.getStatusCode()
		String body = safeBody(response)

		KeywordUtil.logInfo("Get Test Plan status: ${status}")
		KeywordUtil.logInfo("Get Test Plan response: ${body}")

		def parsed = parseJson(body)

		return [
			statusCode: status,
			body      : body,
			issues    : parsed?.issues instanceof List ? parsed.issues : []
		]
	}

	Map getIssueByKey(String issueKey) {
		if (owner.isBlank(issueKey)) {
			return [statusCode: 0, issue: null, body: '']
		}

		String url =
				owner.JIRA_BASE_URL +
				'/rest/api/2/issue/' + encode(issueKey) +
				'?fields=' + encode('summary,created,issuetype')

		RequestObject request = new RequestObject('Runtime Get Issue By Key')
		request.setRestUrl(url)
		request.setRestRequestMethod('GET')
		request.setHttpHeaderProperties(defaultGetHeaders())

		ResponseObject response = WS.sendRequest(request)

		int status = response.getStatusCode()
		String body = safeBody(response)

		KeywordUtil.logInfo("Get Issue By Key status: ${status}")
		KeywordUtil.logInfo("Get Issue By Key response: ${body}")

		def parsed = parseJson(body)

		return [
			statusCode: status,
			body      : body,
			issue     : parsed
		]
	}

	private String resolveToken() {
		try {
			def direct = GlobalVariable.JIRA_TOKEN
			if (!owner.isBlank(direct)) {
				return owner.safe(direct)
			}
		} catch (Exception ignored) {
		}

		try {
			def fallback = GlobalVariable.token
			if (!owner.isBlank(fallback)) {
				return owner.safe(fallback)
			}
		} catch (Exception ignored) {
		}

		return owner.safe(owner.JIRA_TOKEN)
	}

	private String resolveEpicFieldId() {
		return 'customfield_10006'
	}

	private List<TestObjectProperty> defaultGetHeaders() {
		return [
			header('Authorization', 'Bearer ' + resolveToken()),
			header('Accept', 'application/json')
		]
	}

	private List<TestObjectProperty> jsonHeaders() {
		return [
			header('Authorization', 'Bearer ' + resolveToken()),
			header('Accept', 'application/json'),
			header('Content-Type', 'application/json')
		]
	}

	private TestObjectProperty header(String name, String value) {
		return new TestObjectProperty(name, ConditionType.EQUALS, value)
	}

	private HttpBodyContent jsonBody(Object payload) {
		String text = new JsonBuilder(payload).toString()
		return new HttpTextBodyContent(text, 'UTF-8', 'application/json')
	}

	private Object parseJson(String body) {
		if (owner.isBlank(body)) {
			return [:]
		}

		try {
			return jsonSlurper.parseText(body)
		} catch (Exception ignored) {
			return [:]
		}
	}

	private String safeBody(ResponseObject response) {
		try {
			return owner.safe(response?.getResponseBodyContent())
		} catch (Exception ignored) {
			return ''
		}
	}

	private String encode(String value) {
		return URLEncoder.encode(owner.safe(value), StandardCharsets.UTF_8.toString())
	}
}










package jiraIntegration

import java.io.File
import java.io.FileInputStream
import java.text.SimpleDateFormat
import java.util.ArrayList
import java.util.Date
import java.util.LinkedHashSet
import java.util.List
import java.util.Locale
import java.util.Set

import org.apache.poi.xssf.usermodel.XSSFRow
import org.apache.poi.xssf.usermodel.XSSFSheet
import org.apache.poi.xssf.usermodel.XSSFWorkbook

import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil

class JiraFlowCoordinator {

	// ============================================================
	// REQUIRED CONFIGURATION
	// ============================================================

	String JIRA_TOKEN    = '/DuaQa'
	String PROJECT_KEY   = 'L96B2C'
	String EPIC_KEY      = 'L96B2C-8234'
	String JIRA_BASE_URL = 'https://jira-mut.d.bbg'

	// ============================================================
	// OPTIONAL CONFIGURATION
	// ============================================================

	String ENVIRONMENT                 = 'REC'
	String LABELS                      = 'automate'
	String MANUAL_TEST_PLAN_KEY        = ''

	boolean FORCE_CREATE_NEW_TEST_PLAN = false
	boolean RESET_SAVED_TEST_PLAN_KEY  = false

	String TEST_PLAN_SUFFIX            = ' Test Plan'
	String PRIMARY_XML_FILE_NAME       = 'cucumber.xml'
	String SECONDARY_XML_FILE_NAME     = 'JUnit_Report.xml'
	String GAIA_REPORT_FILE_NAME       = 'gaiaReport.html'
	String RESULT_ZIP_NAME             = 'Results.zip'
	String EVIDENCE_FOLDER_NAME        = 'evidence'
	String EVIDENCE_ZIP_NAME           = 'Evidences.zip'

	// ============================================================
	// BASIC HELPERS
	// ============================================================

	String safe(def value) {
		return value == null ? '' : value.toString().trim()
	}

	boolean isBlank(def value) {
		return safe(value).isEmpty()
	}

	boolean isTimestampFolderName(String name) {
		String value = safe(name)
		return value ==~ /\d{8}_\d{6}/ || value ==~ /\d{14}/
	}

	String sanitizeFileName(String value) {
		return safe(value).replaceAll(/[\\\/:*?"<>|]/, '_').trim()
	}

	String nowExecution() {
		return new SimpleDateFormat('yyyy-MM-dd HH.mm.ss').format(new Date())
	}

	String formatHeaderDate(Date date) {
		return new SimpleDateFormat('EEE MMM dd HH:mm:ss z yyyy', Locale.ENGLISH).format(date)
	}

	String formatDurationMillis(long millis) {
		long totalSeconds = (long) (millis / 1000)
		long minutes = (long) (totalSeconds / 60)
		long seconds = (long) (totalSeconds % 60)
		long remainingMillis = (long) (millis % 1000)
		return "${minutes}m ${seconds}s ${remainingMillis}ms"
	}

	String htmlEscape(def value) {
		String text = safe(value)
		return text
				.replace('&', '&amp;')
				.replace('<', '&lt;')
				.replace('>', '&gt;')
				.replace('"', '&quot;')
				.replace("'", '&#39;')
	}

	String relativeUri(File baseDir, File file) {
		String basePath = baseDir.toURI().toString()
		String filePath = file.toURI().toString()
		return filePath.replace(basePath, '')
	}

	String normalizeTitle(String value) {
		return safe(value)
				.replace('\u00A0', ' ')
				.replaceAll(/\s+/, ' ')
				.trim()
				.toLowerCase()
	}

	long toMillis(def secondsValue) {
		try {
			BigDecimal seconds = new BigDecimal(safe(secondsValue))
			return (long) (seconds * 1000)
		} catch (Exception ignored) {
			return 0L
		}
	}

	String readCellAsString(def cell) {
		if (cell == null) {
			return ''
		}

		try {
			cell.setCellType(org.apache.poi.ss.usermodel.CellType.STRING)
		} catch (Exception ignored) {
		}

		return safe(cell.toString())
	}

	// ============================================================
	// REPORT PATH AND SUITE NAME
	// ============================================================

	String getReportPathFromLastRunFile() {
		File file = new File(RunConfiguration.projectDir + File.separator + 'LastRun.xlsx')
		if (!file.exists()) {
			return ''
		}

		FileInputStream fis = null
		XSSFWorkbook wb = null

		try {
			fis = new FileInputStream(file)
			wb = new XSSFWorkbook(fis)
			XSSFSheet sheet = wb.getSheetAt(0)
			XSSFRow row = sheet.getRow(0)

			if (row == null) {
				return ''
			}

			return readCellAsString(row.getCell(0))
		} catch (Exception e) {
			KeywordUtil.logInfo("LastRun.xlsx read skipped: ${e.message}")
			return ''
		} finally {
			try {
				wb?.close()
			} catch (Exception ignored) {
			}
			try {
				fis?.close()
			} catch (Exception ignored) {
			}
		}
	}

	String getReportsRootPath() {
		return RunConfiguration.projectDir + File.separator + 'Reports'
	}

	String getLatestLeafReportFolderFromReportsRoot() {
		File reportsRoot = new File(getReportsRootPath())
		if (!reportsRoot.exists() || !reportsRoot.isDirectory()) {
			return ''
		}

		List<File> candidates = new ArrayList<File>()
		collectLeafReportFolders(reportsRoot, candidates)

		if (candidates.isEmpty()) {
			return ''
		}

		candidates = candidates.unique()
		candidates.sort { a, b -> b.lastModified() <=> a.lastModified() }

		return safe(candidates[0].absolutePath)
	}

	void collectLeafReportFolders(File currentDir, List<File> candidates) {
		if (currentDir == null || !currentDir.exists() || !currentDir.isDirectory()) {
			return
		}

		if (containsXmlReport(currentDir)) {
			candidates.add(currentDir)
			return
		}

		File[] children = currentDir.listFiles()
		if (children == null || children.length == 0) {
			return
		}

		for (File child : children) {
			if (child != null && child.isDirectory()) {
				collectLeafReportFolders(child, candidates)
			}
		}
	}

	boolean containsXmlReport(File dir) {
		if (dir == null || !dir.exists() || !dir.isDirectory()) {
			return false
		}

		File[] files = dir.listFiles()
		if (files == null || files.length == 0) {
			return false
		}

		String primaryName = safe(PRIMARY_XML_FILE_NAME).toLowerCase()
		String secondaryName = safe(SECONDARY_XML_FILE_NAME).toLowerCase()

		for (File file : files) {
			if (file != null && file.isFile()) {
				String lowerName = safe(file.name).toLowerCase()

				if (lowerName == primaryName) {
					return true
				}

				if (lowerName == secondaryName) {
					return true
				}
			}
		}

		return false
	}

	String resolveExistingReportFolderCandidate(String rawPath) {
		String value = safe(rawPath)
		if (isBlank(value)) {
			return ''
		}

		try {
			File direct = new File(value)
			if (direct.exists() && direct.isDirectory()) {
				return direct.canonicalPath
			}
		} catch (Exception ignored) {
		}

		String normalized = value.replace('\\', '/')
		List<String> parts = normalized.tokenize('/')

		if (parts.isEmpty()) {
			return ''
		}

		String leafName = safe(parts[parts.size() - 1])
		String parentName = parts.size() > 1 ? safe(parts[parts.size() - 2]) : ''

		String matched = findEquivalentLeafFolderUnderReportsRoot(parentName, leafName)
		if (!isBlank(matched)) {
			return matched
		}

		return ''
	}

	String findEquivalentLeafFolderUnderReportsRoot(String expectedParentName, String expectedLeafName) {
		File reportsRoot = new File(getReportsRootPath())
		if (!reportsRoot.exists() || !reportsRoot.isDirectory()) {
			return ''
		}

		List<File> candidates = new ArrayList<File>()
		collectLeafReportFolders(reportsRoot, candidates)

		if (candidates.isEmpty()) {
			return ''
		}

		for (File candidate : candidates) {
			if (candidate == null) {
				continue
			}

			String leafName = safe(candidate.name)
			String parentName = candidate.parentFile != null ? safe(candidate.parentFile.name) : ''

			if (!isBlank(expectedParentName) && !isBlank(expectedLeafName)) {
				if (leafName.equalsIgnoreCase(expectedLeafName) && parentName.equalsIgnoreCase(expectedParentName)) {
					try {
						return candidate.canonicalPath
					} catch (Exception ignored) {
						return candidate.absolutePath
					}
				}
			}

			if (!isBlank(expectedLeafName) && leafName.equalsIgnoreCase(expectedLeafName)) {
				try {
					return candidate.canonicalPath
				} catch (Exception ignored) {
					return candidate.absolutePath
				}
			}
		}

		return ''
	}

	String getResolvedReportFolder() {
		List<String> candidates = new ArrayList<String>()

		String current = safe(RunConfiguration.getReportFolder())
		if (!isBlank(current)) {
			candidates.add(current)
		}

		String fromLastRun = getReportPathFromLastRunFile()
		if (!isBlank(fromLastRun)) {
			candidates.add(fromLastRun)
		}

		String latest = getLatestLeafReportFolderFromReportsRoot()
		if (!isBlank(latest)) {
			candidates.add(latest)
		}

		for (String candidate : candidates) {
			String resolved = resolveExistingReportFolderCandidate(candidate)
			if (!isBlank(resolved)) {
				return resolved
			}
		}

		return ''
	}

	String getCurrentSuiteName() {
		String reportFolder = getResolvedReportFolder()
		if (isBlank(reportFolder)) {
			return ''
		}

		File currentFolder = new File(reportFolder)
		String currentName = safe(currentFolder.name)

		if (isTimestampFolderName(currentName) && currentFolder.parentFile != null) {
			return safe(currentFolder.parentFile.name)
		}

		return currentName
	}

