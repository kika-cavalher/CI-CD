	boolean RESET_SAVED_TEST_PLAN_KEY  = false

	// ============================================================
	// JIRA AUTH / BEHAVIOUR
	// ============================================================

	String AUTH_HEADER_NAME            = 'Authorization'
	String AUTH_HEADER_PREFIX          = 'Bearer '

