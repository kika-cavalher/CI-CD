                            <a class="detail-toggle" href="javascript:void(0)" onclick="toggleBlock('evidence-${item.id}-${idx}')">🔎 Open evidence</a>
                            <div id="evidence-${item.id}-${idx}" class="detail-expanded" style="display:none;background:#fff;color:#111827;border:0;padding:10px 0 0 0;max-height:none;">
