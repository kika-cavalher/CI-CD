	@Keyword
	void dragAndDropImage(
			String sourceImageKey,
			String targetImageKey,
			Integer waitSeconds
	) {

		Integer waitTime = safeTimeout(waitSeconds, 2)

		logStep(
				'DRAG AND DROP',
				'Source: ' + sourceImageKey + '\n' +
				'Target: ' + targetImageKey
				)

		try {
			WindowsImageKeywords.dragAndDrop(
					image(GUI_IMAGE_GROUP, sourceImageKey),
					image(GUI_IMAGE_GROUP, targetImageKey)
					)

			Windows.delay(waitTime)

			KeywordUtil.logInfo(
					'[PASS] Drag and drop completed.'
					)
		} catch (Exception e) {
			takeEvidence(
					'GUI_DragAndDropFailed_' +
					sourceImageKey +
					'.png'
					)

			KeywordUtil.markFailedAndStop(
					'Drag and drop failed.\n' +
					'Source: ' + sourceImageKey + '\n' +
					'Target: ' + targetImageKey + '\n' +
					'Reason: ' + safeMessage(e)
					)
		}
	}


	@Keyword
	void validateGroupByResult(Integer timeoutSeconds) {

		Integer timeout = safeTimeout(timeoutSeconds, 5)
		List<String> errors = []

		String expectedSecondRowPrefix =
				'Ecart bilan vs. compte de résultat ccy'

		logStep(
				'GROUP BY RESULT',
				'Double-click the first Group By result row\n' +
				'Validate that line 2 starts with: ' +
				expectedSecondRowPrefix
				)

		boolean firstRowOpenedByImage =
				doubleClickGroupByImage(
						'firstGroupResultRow'
						)

		if (!firstRowOpenedByImage) {
			KeywordUtil.logInfo(
					'[INFO] First row image was not found. ' +
					'Trying the Windows element.'
					)

			doubleClickFirstGroupByElement(
					'firstGroupResultRow',
					timeout,
					errors
					)
		}

		if (errors.isEmpty()) {
			Windows.delay(1)
		}

		boolean secondRowFoundByImage = false

		if (errors.isEmpty()) {
			secondRowFoundByImage =
					findSecondGroupByRowByImage(
							'secondGroupResultPrefix'
							)
		}

		if (
		errors.isEmpty() &&
				!secondRowFoundByImage
				) {
			KeywordUtil.logInfo(
					'[INFO] Second row image was not found. ' +
					'Trying the Windows element.'
					)

			validateSecondGroupByElement(
					'secondGroupResultPrefix',
					expectedSecondRowPrefix,
					timeout,
					errors
					)
		}

		takeEvidence(
				'GUI_GroupByResultValidated.png'
				)

		finishValidation(
				'Group By result validation',
				errors
				)
	}


	private boolean doubleClickGroupByImage(
			String imageKey
	) {

		try {
			String imagePath =
					image(
							GUI_IMAGE_GROUP,
							imageKey
							)

			WindowsImageKeywords.click(imagePath)
			WindowsImageKeywords.click(imagePath)

			KeywordUtil.logInfo(
					'[PASS] First Group By row was opened ' +
					'using image: ' + imageKey
					)

			return true
		} catch (Exception e) {
			KeywordUtil.logInfo(
					'[INFO] Could not open the first Group By row ' +
					'using image.\n' +
					'Image: ' + imageKey + '\n' +
					'Reason: ' + safeMessage(e)
					)

			return false
		}
	}


	private void doubleClickFirstGroupByElement(
			String objectKey,
			Integer timeout,
			List<String> errors
	) {

		WindowsTestObject firstRowObject =
				object(objectKey)

		boolean firstRowPresent =
				Windows.waitForElementPresent(
						firstRowObject,
						timeout,
						FailureHandling.OPTIONAL
						)

		if (!firstRowPresent) {
			errors.add(
					'First Group By result row was not found.\n' +
					'Image: firstGroupResultRow\n' +
					'Object: ' + objectKey
					)

			return
		}

		try {
			Windows.doubleClick(
					firstRowObject,
					FailureHandling.STOP_ON_FAILURE
					)

			KeywordUtil.logInfo(
					'[PASS] First Group By row was opened ' +
					'using the Windows element.'
					)
		} catch (Exception e) {
			errors.add(
					'Could not double-click the first ' +
					'Group By result row.\n' +
					'Object: ' + objectKey + '\n' +
					'Reason: ' + safeMessage(e)
					)
		}
	}


	private boolean findSecondGroupByRowByImage(
			String imageKey
	) {

		try {
			WindowsImageKeywords.click(
					image(
							GUI_IMAGE_GROUP,
							imageKey
							)
					)

			KeywordUtil.logInfo(
					'[PASS] Line 2 starts with the expected text. ' +
					'Validated using image: ' + imageKey
					)

			return true
		} catch (Exception e) {
			KeywordUtil.logInfo(
					'[INFO] Expected line 2 was not found by image.\n' +
					'Image: ' + imageKey + '\n' +
					'Reason: ' + safeMessage(e)
					)

			return false
		}
	}


	private void validateSecondGroupByElement(
			String objectKey,
			String expectedPrefix,
			Integer timeout,
			List<String> errors
	) {

		WindowsTestObject secondRowObject =
				object(objectKey)

		boolean secondRowPresent =
				Windows.waitForElementPresent(
						secondRowObject,
						timeout,
						FailureHandling.OPTIONAL
						)

		if (!secondRowPresent) {
			errors.add(
					'Second Group By result row was not found.\n' +
					'Expected prefix: ' + expectedPrefix + '\n' +
					'Image: secondGroupResultPrefix\n' +
					'Object: ' + objectKey
					)

			return
		}

		String actualText =
				readGroupByRowText(
						secondRowObject
						)

		String normalizedExpected =
				safeText(expectedPrefix)
				.replaceAll(/\s+/, ' ')
				.trim()

		String normalizedActual =
				safeText(actualText)
				.replaceAll(/\s+/, ' ')
				.trim()

		boolean startsWithExpectedText =
				normalizedActual.length() >=
				normalizedExpected.length() &&
				normalizedActual.regionMatches(
						true,
						0,
						normalizedExpected,
						0,
						normalizedExpected.length()
						)

		if (!startsWithExpectedText) {
			errors.add(
					'Unexpected text on the second Group By row.\n' +
					'Expected prefix: ' + normalizedExpected + '\n' +
					'Actual: ' + normalizedActual
					)

			return
		}

		KeywordUtil.logInfo(
				'[PASS] Line 2 starts with: ' +
				normalizedExpected
				)
	}


	private String readGroupByRowText(
			WindowsTestObject targetObject
	) {

		String value =
				safeText(
						Windows.getAttribute(
								targetObject,
								'Name',
								FailureHandling.OPTIONAL
								)
						)

		if (!value.isEmpty()) {
			return value
		}

		value =
				safeText(
						Windows.getAttribute(
								targetObject,
								'LegacyValue',
								FailureHandling.OPTIONAL
								)
						)

		return value
	}
