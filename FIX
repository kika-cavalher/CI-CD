	private Robot robot() {
		if (cachedRobot == null) {
			cachedRobot = new Robot()
			cachedRobot.setAutoDelay(120)
		}
		return cachedRobot
	}

	private void robotKey(int keyCode) {
		Robot r = robot()
		r.keyPress(keyCode)
		r.keyRelease(keyCode)
		sleepMs(200)
	}

	private void robotCombo(int modifierKey, int keyCode) {
		Robot r = robot()
		r.keyPress(modifierKey)
		r.keyPress(keyCode)
		r.keyRelease(keyCode)
		r.keyRelease(modifierKey)
		sleepMs(200)
	}

	private void focusLoginWindow(String title) {
		String targetTitle = normalizeTitle(safe(title) ?: safe(detectedWindowTitle) ?: resolveWindowTitle())

		try {
			Windows.switchToDesktop()
			sleepMs(300)
		} catch (Throwable ignored) {
		}

		try {
			WindowsTestObject windowObj = new WindowsTestObject('loginWindow')
			windowObj.setLocatorStrategy(LocatorStrategy.NAME)
			windowObj.setLocator(targetTitle)
			Windows.switchToWindow(windowObj)
			sleepMs(800)
		} catch (Throwable ignored) {
		}
	}
	// =========================================================================
	// SECTION 13 - GENERIC UTILS
	// =========================================================================

	private void sleepMs(long ms) {
		try {
			Thread.sleep(ms)
		} catch (InterruptedException ignored) {
			Thread.currentThread().interrupt()
		}
	}

	private String normalizeTitle(String value) {
		return safe(value).replaceAll('\\s+', ' ').trim()
	}

	private String safe(Object value) {
		return value == null ? '' : value.toString().trim()
	}

	private String escapePowerShell(String value) {
		return safe(value).replace("'", "''")
	}

	private String xpathLiteral(String value) {
		String v = safe(value)

		if (!v.contains("'")) {
			return "'${v}'"
		}

		if (!v.contains('"')) {
			return "\"${v}\""
		}

		List<String> parts = v.split("'").collect { "'${it}'" }
		return "concat(${parts.join(", \"'\", ")})"
	}

	private String projectImagePath(String relativePath) {
		return new File(RunConfiguration.getProjectDir(), relativePath).getAbsolutePath()
	}

	private boolean imageFileExists(String imagePath) {
		String path = safe(imagePath)
		return path && new File(path).exists()
	}

	private boolean waitImagePresent(String imagePath, int timeoutSeconds) {
		if (!imageFileExists(imagePath)) {
			return false
		}

		long end = System.currentTimeMillis() + (timeoutSeconds * 1000L)

		while (System.currentTimeMillis() < end) {
			try {
				if (WindowsImageKeywords.verifyImagePresent(imagePath, FailureHandling.OPTIONAL)) {
					return true
				}
			} catch (Throwable ignored) {
			}

			sleepMs(500)
		}

		return false
	}

	private boolean clickImageIfExists(String imagePath, int attempts, int delaySeconds, String actionLabel) {
		if (!imageFileExists(imagePath)) {
			KeywordUtil.logInfo("Image file was not found for action: ${actionLabel} -> ${imagePath}")
			return false
		}

		for (int i = 1; i <= attempts; i++) {
			try {
				KeywordUtil.logInfo("${actionLabel}. Attempt ${i}/${attempts} using ${imagePath}")
				WindowsImageKeywords.clickImage(imagePath)
				sleepMs(delaySeconds * 1000L)
				return true
			} catch (Throwable ignored) {
				sleepMs(700)
			}
		}

		return false
	}

	private String resolveEnvironmentImagePath(String normalizedEnv) {
		switch (normalizeEnvCode(normalizedEnv)) {
			case 'REC':
				return projectImagePath('Images/General/recEnvironnement.png')
			case 'REC2':
				return projectImagePath('Images/General/rec2Environnement.png')
			case 'PREPO':
				return projectImagePath('Images/General/prepoEnvironnement.png')
			case 'PROD':
				return projectImagePath('Images/General/prodEnvironnement.png')
			case 'DEV2':
				return projectImagePath('Images/General/dev2Environnement.png')
			case 'DEV':
				return projectImagePath('Images/General/devEnvironnement.png')
			default:
				return projectImagePath('Images/General/recEnvironnement.png')
		}
	}







