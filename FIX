	private void validateEnabledState(
		String objectKey,
		String description,
		boolean expectedEnabled,
		Integer timeout,
		List<String> errors
	) {

		WindowsTestObject targetObject = object(objectKey)

		boolean present =
			Windows.waitForElementPresent(
				targetObject,
				timeout,
				FailureHandling.OPTIONAL
			)

		if (!present) {
			errors.add(description + ' was not found.')
			return
		}

		String enabledAttribute = safeText(
			Windows.getAttribute(
				targetObject,
				'IsEnabled',
				FailureHandling.OPTIONAL
			)
		)

		boolean actualEnabled =
			enabledAttribute.equalsIgnoreCase('True')

		if (actualEnabled == expectedEnabled) {
			KeywordUtil.logInfo(
				'[PASS] ' + description +
				' enabled state is correct.'
			)
		} else {
			errors.add(
				description +
				' enabled state is incorrect.\n' +
				'Expected: ' + expectedEnabled + '\n' +
				'Actual: ' + actualEnabled
			)
		}
	}


	private boolean clickFirstVisibleImage(
		String groupName,
		List<String> imageKeys,
		Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds, 3)

		for (String imageKey : imageKeys) {
			String imagePath = optionalImage(
				groupName,
				imageKey
			)

			if (imagePath.isEmpty()) {
				continue
			}

			int elapsed = 0

			while (elapsed < timeout) {
				try {
					def found =
						WindowsImageKeywords.findImage(imagePath)

					if (found != null && found != false) {
						WindowsImageKeywords.clickImage(imagePath)

						KeywordUtil.logInfo(
							'[IMAGE] Clicked: ' +
							groupName + '.' + imageKey
						)

						return true
					}
				} catch (Throwable ignored) {
				}

				Windows.delay(1)
				elapsed++
			}
		}

		return false
	}


