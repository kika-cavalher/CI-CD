for %%F in ("%LOG_DIR%") do (
    if not exist "%%~fF" mkdir "%%~fF" >nul 2>&1
)

for %%F in ("%MARKER_FILE%") do (
    if not exist "%%~dpF" mkdir "%%~dpF" >nul 2>&1
)

for %%F in ("%CURRENT_LOG_FILE%") do (
    if not exist "%%~dpF" mkdir "%%~dpF" >nul 2>&1
)

for %%F in ("%LIVE_LOG_PID_FILE%") do (
    if not exist "%%~dpF" mkdir "%%~dpF" >nul 2>&1
)

for %%F in ("%LIVE_LOG_SCRIPT_FILE%") do (
    if not exist "%%~dpF" mkdir "%%~dpF" >nul 2>&1
