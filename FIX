@echo off
setlocal EnableExtensions EnableDelayedExpansion

REM ============================================================
REM CONFIG
REM ============================================================
set "JOB_LABEL=GUI - Group By"
set "TEST_SUITE_COLLECTION=Test Suites/GUI behavior/GUI - Group By/Group By Collection"

set "EXECUTION_PROFILE=default"
set "BROWSER_TYPE=Windows"
set "STARTER_DIR=D:\Projects\eMatchStarters"
set "CONTEXT_FILE=%STARTER_DIR%\run-context.properties"
set "RESULT_FILE=%STARTER_DIR%\run-result.properties"
set "LOG_FILE=%STARTER_DIR%\logs\run-ematch-command.log"
set "KATALON_CONSOLE_LOG=%STARTER_DIR%\logs\katalon-console.log"
set "GENERIC_TASK=\eMatch Automation\RunEMatchCommand"
set "WIN_DRIVER_TASK=startWinDriver"

set "WAIT_SECONDS=5"
set "MAX_WAIT_MINUTES=300"

if "%WORKSPACE%"=="" set "WORKSPACE=%CD%"

set /a WAIT_MAX_CYCLES=(MAX_WAIT_MINUTES*60)/WAIT_SECONDS
if %WAIT_MAX_CYCLES% LEQ 0 set "WAIT_MAX_CYCLES=3600"

for /f "usebackq delims=" %%I in (`powershell -NoProfile -Command "(Get-Date).ToString('yyyy-MM-dd HH:mm:ss')"`) do set "RUN_STARTED_AT=%%I"
if not defined RUN_STARTED_AT set "RUN_STARTED_AT=1970-01-01 00:00:00"

set "RUN_ID=%RANDOM%%RANDOM%%RANDOM%"
set "EXPECTED_RUN_ID=%RUN_ID%"

echo.
echo ============================================================
echo [INFO] Starting %JOB_LABEL%
echo [INFO] WORKSPACE=%WORKSPACE%
echo [INFO] TEST_SUITE_COLLECTION=%TEST_SUITE_COLLECTION%
echo [INFO] EXECUTION_PROFILE=%EXECUTION_PROFILE%
echo [INFO] BROWSER_TYPE=%BROWSER_TYPE%
echo [INFO] STARTER_DIR=%STARTER_DIR%
echo [INFO] CONTEXT_FILE=%CONTEXT_FILE%
echo [INFO] RESULT_FILE=%RESULT_FILE%
echo [INFO] LOG_FILE=%LOG_FILE%
echo [INFO] KATALON_CONSOLE_LOG=%KATALON_CONSOLE_LOG%
echo [INFO] GENERIC_TASK=%GENERIC_TASK%
echo [INFO] WIN_DRIVER_TASK=%WIN_DRIVER_TASK%
echo [INFO] RUN_STARTED_AT=%RUN_STARTED_AT%
echo ============================================================
echo.

if "%JOB_LABEL%"=="" (
    echo [ERROR] JOB_LABEL is empty.
    exit /b 1
)

if "%TEST_SUITE_COLLECTION%"=="" (
    echo [ERROR] TEST_SUITE_COLLECTION is empty.
    exit /b 1
)

if not exist "%STARTER_DIR%" (
    echo [ERROR] STARTER_DIR not found: %STARTER_DIR%
    exit /b 1
)

if not exist "%STARTER_DIR%\logs" mkdir "%STARTER_DIR%\logs" >nul 2>nul

schtasks /end /tn "%GENERIC_TASK%" >nul 2>nul
schtasks /end /tn "%WIN_DRIVER_TASK%" >nul 2>nul
taskkill /f /im WinAppDriver.exe >nul 2>nul
taskkill /f /im katalonc.exe >nul 2>nul
taskkill /f /im KatalonStudio.exe >nul 2>nul
ping -n 3 127.0.0.1 >nul

del /f /q "%LOG_FILE%" >nul 2>nul
del /f /q "%KATALON_CONSOLE_LOG%" >nul 2>nul

(
    echo RUN_ID=%EXPECTED_RUN_ID%
    echo JOB_LABEL=%JOB_LABEL%
    echo WORKSPACE=%WORKSPACE%
    echo TEST_SUITE_COLLECTION=%TEST_SUITE_COLLECTION%
    echo EXECUTION_PROFILE=%EXECUTION_PROFILE%
    echo BROWSER_TYPE=%BROWSER_TYPE%
    echo KATALON_HOME=C:\Users\adgi5appjenkins\Documents\Katalon_Studio_Engine_Windows_64-8.1.0
) > "%CONTEXT_FILE%"

(
    echo RUN_ID=%EXPECTED_RUN_ID%
    echo STATUS=QUEUED
    echo EXIT_CODE=999
    for /f "usebackq delims=" %%I in (`powershell -NoProfile -Command "(Get-Date).ToString('dd/MM/yyyy HH:mm:ss,ff')"`) do echo UPDATED_AT=%%I
) > "%RESULT_FILE%"

echo [INFO] Context file written:
type "%CONTEXT_FILE%"
echo.
echo [INFO] Initial result file:
type "%RESULT_FILE%"
echo.

echo [INFO] Starting WinAppDriver task...
schtasks /run /tn "%WIN_DRIVER_TASK%" >nul 2>nul

echo [INFO] Starting visible Katalon task...
schtasks /run /tn "%GENERIC_TASK%" >nul 2>nul
if errorlevel 1 (
    echo [ERROR] Could not start scheduled task "%GENERIC_TASK%".
    call :printTaskInfo
    exit /b 1
)

set /a WAIT_COUNT=0

:waitResult
set /a WAIT_COUNT+=1

set "FILE_RUN_ID="
set "STATUS="
set "EXIT_CODE="
set "UPDATED_AT="

for /f "usebackq tokens=1,* delims==" %%A in ("%RESULT_FILE%") do (
    if /i "%%A"=="RUN_ID" set "FILE_RUN_ID=%%B"
    if /i "%%A"=="STATUS" set "STATUS=%%B"
    if /i "%%A"=="EXIT_CODE" set "EXIT_CODE=%%B"
    if /i "%%A"=="UPDATED_AT" set "UPDATED_AT=%%B"
)

if !WAIT_COUNT! EQU 1 echo [INFO] Waiting result file update...
if !WAIT_COUNT! EQU 2 echo [INFO] Still waiting result file update...
if !WAIT_COUNT! GTR 2 if !WAIT_COUNT! LEQ 5 echo [INFO] Still waiting...

if !WAIT_COUNT! EQU 5 call :printTaskInfo
if !WAIT_COUNT! EQU 10 call :printTaskInfo
if !WAIT_COUNT! EQU 20 call :printTaskInfo

if /i "!FILE_RUN_ID!"=="%EXPECTED_RUN_ID%" if /i "!STATUS!"=="FINISHED" goto resultDone

if !WAIT_COUNT! GEQ %WAIT_MAX_CYCLES% (
    echo [ERROR] Timeout waiting run-result.properties update.
    echo [ERROR] FILE_RUN_ID=!FILE_RUN_ID!
    echo [ERROR] STATUS=!STATUS!
    echo [ERROR] EXIT_CODE=!EXIT_CODE!
    echo [ERROR] UPDATED_AT=!UPDATED_AT!
    call :printTaskInfo
    call :printResultFile
    call :printLog "%LOG_FILE%" "run-ematch-command.log" 30
    call :printLog "%KATALON_CONSOLE_LOG%" "katalon-console.log" 80
    exit /b 1
)

ping -n %WAIT_SECONDS% 127.0.0.1 >nul
goto waitResult

:resultDone
echo.
echo [INFO] Result file updated.
echo [INFO] RUN_ID=!FILE_RUN_ID!
echo [INFO] STATUS=!STATUS!
echo [INFO] EXIT_CODE=!EXIT_CODE!
echo [INFO] UPDATED_AT=!UPDATED_AT!
echo.

schtasks /end /tn "%WIN_DRIVER_TASK%" >nul 2>nul

call :printTaskInfo
call :printResultFile
call :printLog "%LOG_FILE%" "run-ematch-command.log" 30
call :printLog "%KATALON_CONSOLE_LOG%" "katalon-console.log" 80
call :printReportsSummary
call :validateExecution

if errorlevel 1 exit /b 1

echo [INFO] %JOB_LABEL% execution finished successfully.
if not "!EXIT_CODE!"=="0" (
    echo [WARN] Katalon returned EXIT_CODE=!EXIT_CODE!, but Jenkins will keep SUCCESS because execution finished.
)

exit /b 0

:validateExecution
echo [INFO] Validating current execution...

set "HAS_ARTIFACTS=0"
if exist "%WORKSPACE%\Reports" (
    dir /s /b "%WORKSPACE%\Reports\*.xml" >nul 2>&1 && set "HAS_ARTIFACTS=1"
    dir /s /b "%WORKSPACE%\Reports\*.html" >nul 2>&1 && set "HAS_ARTIFACTS=1"
    dir /s /b "%WORKSPACE%\Reports\execution0.log" >nul 2>&1 && set "HAS_ARTIFACTS=1"
)

if "%HAS_ARTIFACTS%"=="0" (
    echo [ERROR] No report artifacts were generated for %JOB_LABEL%.
    exit /b 1
)

exit /b 0

:printTaskInfo
echo [INFO] Scheduled task status snapshot:
echo [INFO] ---- %WIN_DRIVER_TASK% ----
schtasks /query /tn "%WIN_DRIVER_TASK%" /fo list | findstr /i /c:"Status:" /c:"Last Result:" /c:"Last Run Time:"
echo [INFO] ---- %GENERIC_TASK% ----
schtasks /query /tn "%GENERIC_TASK%" /fo list | findstr /i /c:"Status:" /c:"Last Result:" /c:"Last Run Time:"
echo.
exit /b 0

:printResultFile
if exist "%RESULT_FILE%" (
    echo [INFO] Current run-result.properties:
    type "%RESULT_FILE%"
    echo.
) else (
    echo [WARN] Result file not found: %RESULT_FILE%
    echo.
)
exit /b 0

:printLog
set "TARGET_FILE=%~1"
set "TARGET_TITLE=%~2"
set "TARGET_TAIL=%~3"

if exist "%TARGET_FILE%" (
    echo [INFO] Last lines from %TARGET_TITLE%:
    powershell -NoProfile -Command "Get-Content -Path '%TARGET_FILE%' -Tail %TARGET_TAIL% -ErrorAction SilentlyContinue"
    echo.
) else (
    echo [WARN] File not found: %TARGET_FILE%
    echo.
)
exit /b 0

:printReportsSummary
if exist "%WORKSPACE%\Reports" (
    echo [INFO] Reports folder found: %WORKSPACE%\Reports
    echo [INFO] Relevant report artifacts:
    powershell -NoProfile -Command ^
        "$root='%WORKSPACE%\Reports';" ^
        "Get-ChildItem -Path $root -Recurse -File -ErrorAction SilentlyContinue |" ^
        "Where-Object { $_.Name -like 'JUnit_Report.xml' -or $_.Name -like '*.html' -or $_.Name -like 'execution0.log' } |" ^
        "Sort-Object LastWriteTime -Descending |" ^
        "Select-Object -First 20 |" ^
        "ForEach-Object { Write-Host ('[REPORT] ' + $_.LastWriteTime.ToString('yyyy-MM-dd HH:mm:ss') + '  ' + $_.FullName) }"
    echo.
) else (
    echo [WARN] Reports folder not found: %WORKSPACE%\Reports
    echo.
)
exit /b 0








properties([
    disableConcurrentBuilds(),
    buildDiscarder(logRotator(numToKeepStr: '15'))
])

def NODE_LABEL = 'GI5_SWDCFRNXGI55817'
def SHORT_WORKSPACE = 'D:\\jenkins\\ws\\GUI_BEHAV'

def RUN_NEXT_JOB = true
def NEXT_JOB = 'GI5/eMatch_Regression/ReportGeneration'

def executionFailed = false
def manuallyAborted = false

def isTimeoutError = { Throwable err ->
    def text = "${err?.getClass()?.getName() ?: ''} ${err?.getMessage() ?: ''}".toLowerCase()
    return text.contains('timeout') || text.contains('exceededtimeout')
}

def isManualAbortError = { Throwable err ->
    def text = "${err?.getClass()?.getName() ?: ''} ${err?.getMessage() ?: ''}".toLowerCase()
    return text.contains('flowinterruptedexception') || text.contains('aborted by')
}

def stopCurrentExecution = {
    bat '''
@echo off
schtasks /end /tn "\\eMatch Automation\\RunEMatchCommand" >nul 2>nul
schtasks /end /tn "startWinDriver" >nul 2>nul
taskkill /f /im WinAppDriver.exe >nul 2>nul
taskkill /f /im katalonc.exe >nul 2>nul
taskkill /f /im KatalonStudio.exe >nul 2>nul
ping -n 3 127.0.0.1 >nul
exit /b 0
'''
}

def runCollection = { String stageName, String cmdFile ->
    if (manuallyAborted) {
        echo "${stageName} skipped because build was manually aborted."
        return
    }

    stage(stageName) {
        try {
            timeout(time: 5, unit: 'HOURS') {
                bat "call \"${env.WORKSPACE}\\jenkins\\${cmdFile}\""
            }
            echo "${stageName} completed successfully."
        } catch (Throwable err) {
            if (isManualAbortError(err)) {
                manuallyAborted = true
                currentBuild.result = 'ABORTED'
                echo "${stageName} was manually aborted."
                throw err
            }

            executionFailed = true

            if (isTimeoutError(err)) {
                echo "${stageName} exceeded the 5 hour limit and was stopped."
            } else {
                echo "${stageName} failed: ${err}"
            }
        } finally {
            stage("Stop ${stageName}") {
                stopCurrentExecution()
            }
        }
    }
}

node(NODE_LABEL) {
    ws(SHORT_WORKSPACE) {
        stage('Checkout') {
            deleteDir()
            checkout scm
        }

        runCollection('GUI Behavior Collection', 'GuiBehaviour.cmd')
        runCollection('GUI Group By Collection', 'GuiGroupBy.cmd')
        runCollection('GUI Language Behaviour Collection', 'GuiLanguageBehaviour.cmd')
    }
}

if (manuallyAborted) {
    currentBuild.result = 'ABORTED'
    echo 'Build was manually aborted. Next pipeline will not be scheduled.'
    return
}

stage('Trigger next pipeline') {
    if (RUN_NEXT_JOB && NEXT_JOB?.trim()) {
        echo "Scheduling next pipeline: ${NEXT_JOB}"
        build job: NEXT_JOB, wait: false, propagate: false
    } else {
        echo 'Next pipeline disabled.'
    }
}

currentBuild.result = 'SUCCESS'
return
