	// =========================================================
	// HELPERS
	// =========================================================

	String maskToken(String token) {
		if (token == null || token.trim().isEmpty()) {
			return 'EMPTY'
		}

		if (token.length() <= 10) {
			return '***'
		}

		return token.take(6) + '...' + token.takeRight(4)
	}

	String getTimestamp() {
		return new SimpleDateFormat("yyyy-MM-dd HH.mm.ss").format(new Date())
	}

	boolean isTimestampFolderName(String name) {
		if (name == null) {
			return false
		}

		return name ==~ /\d{8,}_\d{4,}/ || name ==~ /\d{8,}/
	}

	// =========================================================
	// REPORT PATH
	// =========================================================

	String readLastRunPath() {
		try {
			File file = new File(RunConfiguration.projectDir + '\\LastRun.xlsx')

			if (!file.exists()) {
				return null
			}

			FileInputStream fis = new FileInputStream(file)
			XSSFWorkbook wb = new XSSFWorkbook(fis)
			XSSFSheet sheet = wb.getSheetAt(0)
			XSSFRow row = sheet.getRow(0)
			String result = row?.getCell(0)?.stringCellValue

			wb.close()
			fis.close()

			return result?.trim()
		} catch (Exception e) {
			KeywordUtil.logInfo("Could not read LastRun.xlsx: ${e.message}")
			return null
		}
	}

	boolean directoryContainsUsefulFiles(File dir) {
		if (dir == null || !dir.exists() || !dir.isDirectory()) {
			return false
		}

		boolean found = false

		dir.eachFileRecurse(FileType.FILES) { file ->
			String name = file.name.toLowerCase()

			if (name.equalsIgnoreCase(PRIMARY_XML_FILE_NAME.toLowerCase())
				|| name.contains(SECONDARY_XML_FILE_NAME.toLowerCase())
				|| name.endsWith('.html')
				|| name.equalsIgnoreCase('execution.log')
				|| name.equalsIgnoreCase('junit_report.xml')
				|| name.equalsIgnoreCase('cucumber.xml')) {
				found = true
			}
		}

		return found
	}

	File findLatestUsefulDirectory(File rootDir) {
		if (rootDir == null || !rootDir.exists() || !rootDir.isDirectory()) {
			return null
		}

		List<File> candidates = []

		if (directoryContainsUsefulFiles(rootDir)) {
			candidates.add(rootDir)
		}

		rootDir.eachFileRecurse(FileType.DIRECTORIES) { dir ->
			if (directoryContainsUsefulFiles(dir)) {
				candidates.add(dir)
			}
		}

		if (candidates.isEmpty()) {
			return null
		}

		return candidates.max { it.lastModified() }
	}

	String getResolvedReportPath() {
		List<String> candidatePaths = []

		try {
			String runConfigPath = RunConfiguration.getReportFolder()

			if (runConfigPath != null && !runConfigPath.trim().isEmpty()) {
				candidatePaths.add(runConfigPath.trim())
			}
		} catch (Exception e) {
			KeywordUtil.logInfo("Could not use RunConfiguration.getReportFolder(): ${e.message}")
		}

		String lastRunPath = readLastRunPath()

		if (lastRunPath != null && !lastRunPath.trim().isEmpty()) {
			candidatePaths.add(lastRunPath)
		}

		candidatePaths.add(RunConfiguration.projectDir + '\\Reports')
		candidatePaths.add(System.getProperty('user.dir') + '\\Reports')

		for (String path : candidatePaths) {
			if (path == null || path.trim().isEmpty()) {
				continue
			}

			File root = new File(path)

			if (!root.exists()) {
				continue
			}

			if (directoryContainsUsefulFiles(root)) {
				KeywordUtil.logInfo("Using report folder: ${root.absolutePath}")
				return root.absolutePath
			}

			File latest = findLatestUsefulDirectory(root)

			if (latest != null) {
				KeywordUtil.logInfo("Using nested report folder: ${latest.absolutePath}")
				return latest.absolutePath
			}
		}

		KeywordUtil.markFailed("No valid report folder found.")
		return null
	}

	// =========================================================
	// SUITE NAME
	// =========================================================

	String getCurrentSuiteName() {
		String reportPath = getResolvedReportPath()

		if (reportPath == null || reportPath.trim().isEmpty()) {
			return 'UnknownTestSuite'
		}

		File pointer = new File(reportPath)

		while (pointer != null) {
			String folderName = pointer.getName()

			if (folderName != null
				&& !folderName.equalsIgnoreCase('Reports')
				&& !folderName.equalsIgnoreCase('logs')
				&& !folderName.equalsIgnoreCase('videos')
				&& !folderName.equalsIgnoreCase('cucumber_report')
				&& !folderName.equalsIgnoreCase('PreLoad')
				&& !isTimestampFolderName(folderName)) {
				return folderName
			}

			pointer = pointer.getParentFile()
		}

		return 'UnknownTestSuite'
	}

	String getSanitizedSuiteName() {
		return getCurrentSuiteName().replaceAll('[\\\\/:*?"<>|]', '_')
	}

	String getSummaryName() {
		return getCurrentSuiteName() + ' ' + getTimestamp()
	}

	String getTestPlanName() {
		return getCurrentSuiteName() + TEST_PLAN_SUFFIX
	}

	// =========================================================
	// TEST PLAN KEY FILE
	// =========================================================

	String getSuiteTestPlanFilePath() {
		File folder = new File(TEST_PLAN_KEYS_FOLDER)

		if (!folder.exists()) {
			folder.mkdirs()
		}

		return folder.absolutePath + '\\' + getSanitizedSuiteName() + '.txt'
	}

	String getSavedTestPlanKey() {
		File file = new File(getSuiteTestPlanFilePath())

		if (!file.exists()) {
			return ''
		}

		String key = file.text?.trim()

		if (key == null || key.isEmpty()) {
			return ''
		}

		KeywordUtil.logInfo("Saved Test Plan key found for suite '${getCurrentSuiteName()}': ${key}")
		return key
	}

	void saveTestPlanKey(String testPlanKey) {
		if (testPlanKey == null || testPlanKey.trim().isEmpty()) {
			return
		}

		File file = new File(getSuiteTestPlanFilePath())
		file.write(testPlanKey.trim(), 'UTF-8')

		KeywordUtil.logInfo("Saved Test Plan key '${testPlanKey}' for suite '${getCurrentSuiteName()}'.")
	}

	@Keyword
	def resetTestPlanKey() {
		File file = new File(getSuiteTestPlanFilePath())

		if (!file.exists()) {
			KeywordUtil.logInfo("No saved Test Plan key file found for this suite.")
			return
		}

		file.write('', 'UTF-8')
		KeywordUtil.logInfo("Saved Test Plan key cleared for suite '${getCurrentSuiteName()}'.")
	}

	// =========================================================
	// REPORT FILES
	// =========================================================

	String getXmlFilePath() {
		String reportPath = getResolvedReportPath()

		if (reportPath == null || reportPath.trim().isEmpty()) {
			return null
		}

		File reportDir = new File(reportPath)
		String xmlPath = null

		reportDir.eachFileRecurse(FileType.FILES) { file ->
			if (file.name.equalsIgnoreCase(PRIMARY_XML_FILE_NAME)) {
				xmlPath = file.absolutePath
			}
		}

		if (xmlPath == null) {
			reportDir.eachFileRecurse(FileType.FILES) { file ->
				if (file.name.toLowerCase().contains(SECONDARY_XML_FILE_NAME.toLowerCase())) {
					xmlPath = file.absolutePath
				}
			}
		}

		if (xmlPath == null) {
			KeywordUtil.markFailed("No XML file found inside report directory: ${reportDir.absolutePath}")
			return null
		}

		KeywordUtil.logInfo("XML file found: ${xmlPath}")
		return xmlPath
	}

	String getHtmlReportFilePath() {
		String reportPath = getResolvedReportPath()

		if (reportPath == null || reportPath.trim().isEmpty()) {
			return null
		}

		File reportDir = new File(reportPath)

		File exact = null
		File fallback = null

		reportDir.eachFileRecurse(FileType.FILES) { file ->
			if (file.name.equalsIgnoreCase(HTML_REPORT_NAME)) {
				exact = file
			}

			if (fallback == null
				&& file.name.toLowerCase().endsWith('.html')
				&& !file.name.toLowerCase().contains('preload')) {
				fallback = file
			}
		}

		if (exact != null) {
			KeywordUtil.logInfo("HTML report found by configured name: ${exact.absolutePath}")
			return exact.absolutePath
		}

		if (fallback != null) {
			KeywordUtil.logInfo("HTML report found by fallback search: ${fallback.absolutePath}")
			return fallback.absolutePath
		}

		KeywordUtil.logInfo("No HTML report found.")
		return null
	}

	boolean isFileAllowedInZip(File file, String zipFileName) {
		if (file == null || !file.isFile()) {
			return false
		}

		String lowerName = file.name.toLowerCase()

		if (lowerName.endsWith('.lck')) {
			return false
		}

		if (lowerName.endsWith('.zip')) {
			return false
		}

		if (file.name.equalsIgnoreCase(zipFileName)) {
			return false
		}

		return true
	}

	String zipReports() {
		String reportPath = getResolvedReportPath()

		if (reportPath == null || reportPath.trim().isEmpty()) {
			return null
		}

		String zippedFile = reportPath + File.separator + REPORT_ZIP_NAME
		def output = new ZipOutputStream(new FileOutputStream(zippedFile))

		new File(reportPath).eachFile { file ->
			if (!isFileAllowedInZip(file, REPORT_ZIP_NAME)) {
				return
			}

			try {
				output.putNextEntry(new ZipEntry(file.name))

				def zipInput = new FileInputStream(file)
				byte[] buffer = new byte[1024]
				int bytesRead

				while ((bytesRead = zipInput.read(buffer)) != -1) {
					output.write(buffer, 0, bytesRead)
				}

				output.closeEntry()
				zipInput.close()
				KeywordUtil.logInfo("Added report file to ZIP: ${file.name}")
			} catch (Exception e) {
				KeywordUtil.markWarning("Could not add file to report ZIP: ${file.name} - ${e.message}")
			}
		}

		output.close()
		KeywordUtil.logInfo("Report ZIP created successfully: ${zippedFile}")
		return zippedFile
	}

	String zipEvidences() {
		String reportPath = getResolvedReportPath()

		if (reportPath == null || reportPath.trim().isEmpty()) {
			return null
		}

		String evidencePath = reportPath + File.separator + EVIDENCE_FOLDER_NAME
		File evidenceFolder = new File(evidencePath)

		if (!evidenceFolder.exists() || !evidenceFolder.isDirectory()) {
			KeywordUtil.logInfo("Evidence folder not found: ${evidenceFolder.absolutePath}")
			return null
		}

		String zippedFile = evidencePath + File.separator + EVIDENCE_ZIP_NAME
		def output = new ZipOutputStream(new FileOutputStream(zippedFile))

		evidenceFolder.eachFileRecurse(FileType.FILES) { file ->
			if (!isFileAllowedInZip(file, EVIDENCE_ZIP_NAME)) {
				return
			}

			try {
				String relativePath = evidenceFolder.toPath().relativize(file.toPath()).toString().replace("\\", "/")

				output.putNextEntry(new ZipEntry(relativePath))

				def zipInput = new FileInputStream(file)
				byte[] buffer = new byte[1024]
				int bytesRead

				while ((bytesRead = zipInput.read(buffer)) != -1) {
					output.write(buffer, 0, bytesRead)
				}

				output.closeEntry()
				zipInput.close()
				KeywordUtil.logInfo("Added evidence file to ZIP: ${relativePath}")
			} catch (Exception e) {
				KeywordUtil.markWarning("Could not add evidence file to ZIP: ${file.name} - ${e.message}")
			}
		}

		output.close()
		KeywordUtil.logInfo("Evidence ZIP created successfully: ${zippedFile}")
		return zippedFile
	}

	// =========================================================
