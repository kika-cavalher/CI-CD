	// XML
	// ============================================================

	String findXmlFile(String reportFolder) {
		if (isBlank(reportFolder)) {
			return ''
		}

		File root = new File(reportFolder)
		if (!root.exists() || !root.isDirectory()) {
			return ''
		}

		List<File> preferred = []
		List<File> fallback = []
		collectXmlFiles(root, preferred, fallback)

		if (!preferred.isEmpty()) {
			preferred.sort { File a, File b -> b.lastModified() <=> a.lastModified() }
			return preferred[0].absolutePath
		}

		if (!fallback.isEmpty()) {
			fallback.sort { File a, File b -> b.lastModified() <=> a.lastModified() }
			return fallback[0].absolutePath
		}

		return ''
	}

	void collectXmlFiles(File currentDir, List<File> preferred, List<File> fallback) {
		if (currentDir == null || !currentDir.exists() || !currentDir.isDirectory()) {
			return
		}

		File[] children = currentDir.listFiles()
		if (children == null || children.length == 0) {
			return
		}

		String primaryName = safe(PRIMARY_XML_FILE_NAME).toLowerCase(Locale.ENGLISH)
		String secondaryName = safe(SECONDARY_XML_FILE_NAME).toLowerCase(Locale.ENGLISH)

		for (File child : children) {
			if (child == null) {
				continue
			}

			if (child.isDirectory()) {
				collectXmlFiles(child, preferred, fallback)
				continue
			}

			String lowerName = safe(child.name).toLowerCase(Locale.ENGLISH)
			if (lowerName == primaryName) {
				preferred.add(child)
			} else if (lowerName == secondaryName) {
				fallback.add(child)
			}
		}
	}

	String resolveXmlPathForImport(String reportFolder) {
		int maxAttempts = XML_WAIT_TIMEOUT_SECONDS <= 0 ? 1 : XML_WAIT_TIMEOUT_SECONDS

		for (int attempt = 1; attempt <= maxAttempts; attempt++) {
			String xmlPath = findXmlFile(reportFolder)
			if (!isBlank(xmlPath)) {
				return xmlPath
			}

			if (attempt < maxAttempts) {
				KeywordUtil.logInfo("Final JUnit XML not available yet. Waiting 1 second (${attempt}/${maxAttempts}).")
				sleep(1000L)
			}
		}

		return ''
	}

	// ============================================================
	// MAIN FLOW
	// ============================================================

	def jiraImport() {
		return jiraImport('')
	}

	def jiraImport(String epicKeyOverride) {
		if (!isBlank(epicKeyOverride)) {
			EPIC_KEY = safe(epicKeyOverride)
		}

		JiraGateway gateway = new JiraGateway(this)
		JiraTestPlanManager testPlanManager = new JiraTestPlanManager(this, gateway)
		JiraGaiaReportBuilder reportBuilder = new JiraGaiaReportBuilder(this)
		JiraExecutionPublisher executionPublisher = new JiraExecutionPublisher(this, gateway)

		gateway.validateRequiredConfiguration()

		KeywordUtil.logInfo("============================================================")
		KeywordUtil.logInfo("Starting Jira import flow")
		KeywordUtil.logInfo("============================================================")

		String reportFolder = getResolvedReportFolder()
		if (isBlank(reportFolder)) {
			KeywordUtil.markFailed("Report folder could not be resolved.")
			return
		}

		KeywordUtil.logInfo("Using report folder: ${reportFolder}")

		String suiteName = getCurrentSuiteName()
		if (isBlank(suiteName)) {
			KeywordUtil.markFailed("Suite name could not be resolved from report path.")
			return
		}

		KeywordUtil.logInfo("Suite name detected from report path: ${suiteName}")

		String executionSummary = getExecutionSummary()
		String testPlanSummary = getTestPlanName()

		KeywordUtil.logInfo("Execution title used: ${executionSummary}")
		KeywordUtil.logInfo("Test Plan title used: ${testPlanSummary}")

		String initialXmlPath = findXmlFile(reportFolder)
		if (isBlank(initialXmlPath)) {
			KeywordUtil.logInfo("JUnit XML not available yet. Custom HTML will be created from execution log and existing HTML reports.")
		} else {
			KeywordUtil.logInfo("XML file found immediately: ${initialXmlPath}")
		}

		String customReportPath = reportBuilder.createCustomHtmlReport(reportFolder, suiteName, initialXmlPath)
		if (isBlank(customReportPath)) {
			KeywordUtil.markWarning("Custom HTML report could not be created.")
		} else {
			KeywordUtil.logInfo("Custom HTML report created: ${customReportPath}")
		}

		String testPlanKey = testPlanManager.getOrCreateTestPlanKey()
		if (isBlank(testPlanKey) || testPlanKey.startsWith('ERROR')) {
			KeywordUtil.markFailed("Test Plan could not be created or resolved: ${testPlanKey}")
			return
		}

		String xmlPath = resolveXmlPathForImport(reportFolder)
		if (isBlank(xmlPath)) {
			KeywordUtil.markFailed("JUnit_Report.xml was not found in report folder after waiting.")
			return
		}

		KeywordUtil.logInfo("XML file used for Jira import: ${xmlPath}")

		if (isBlank(initialXmlPath) || !safe(initialXmlPath).equalsIgnoreCase(safe(xmlPath))) {
			String refreshedReportPath = reportBuilder.createCustomHtmlReport(reportFolder, suiteName, xmlPath)
			if (!isBlank(refreshedReportPath)) {
				KeywordUtil.logInfo("Custom HTML report refreshed with final XML data: ${refreshedReportPath}")
			}
		}

		Map executionResult = executionPublisher.publishExecution(xmlPath, executionSummary, testPlanKey)

		String executionKey = safe(executionResult.executionKey)
		if (isBlank(executionKey) || executionKey.startsWith('ERROR')) {
			KeywordUtil.markFailed("Execution import failed: ${executionKey}")
			return
		}

		KeywordUtil.logInfo("============================================================")
		KeywordUtil.logInfo("Jira import finished")
		KeywordUtil.logInfo("============================================================")
		KeywordUtil.logInfo("Execution key: ${executionKey}")
		KeywordUtil.logInfo("Execution title used: ${executionSummary}")
		KeywordUtil.logInfo("Test Plan key: ${testPlanKey}")
		KeywordUtil.logInfo("Test Plan title used: ${testPlanSummary}")
		KeywordUtil.logInfo("HTML report attachment status: ${executionResult.gaiaReportStatus}")
		KeywordUtil.logInfo("Evidences.zip attachment status: ${executionResult.evidencesStatus}")
		KeywordUtil.logInfo("Results.zip attachment status: ${executionResult.resultsStatus}")
		KeywordUtil.logInfo("Add execution to Test Plan status: ${executionResult.addExecutionStatus}")
		KeywordUtil.logInfo("Update Test Execution status: ${executionResult.updateExecutionStatus}")

		return executionKey
	}
