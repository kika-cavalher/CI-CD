@echo off
setlocal EnableExtensions EnableDelayedExpansion

REM ------------------------------------------------------------
REM Read run context
REM ------------------------------------------------------------
set "CTX_FILE=D:\Projects\eMatchStarters\run-context.properties"
if not exist "%CTX_FILE%" (
  echo [ERROR] Missing run context: "%CTX_FILE%"
  exit /b 2
)

for /f "usebackq tokens=1,* delims==" %%A in ("%CTX_FILE%") do (
  set "K=%%A"
  set "V=%%B"
  if not "!K!"=="" set "!K!=!V!"
)

REM ------------------------------------------------------------
REM Validate required vars
REM ------------------------------------------------------------
if "%WORKSPACE%"=="" (
  echo [ERROR] WORKSPACE is empty
  exit /b 2
)

if "%KATALON_EXE%"=="" (
  echo [ERROR] KATALON_EXE is empty
  exit /b 2
)

if "%PROJECT_FILE%"=="" (
  echo [ERROR] PROJECT_FILE is empty
  exit /b 2
)

if "%COLLECTION_PATH%"=="" (
  echo [ERROR] COLLECTION_PATH is empty
  exit /b 2
)

REM ------------------------------------------------------------
REM Paths
REM ------------------------------------------------------------
set "PROJECT_FILE_PATH=%WORKSPACE%\%PROJECT_FILE%"
set "REPORTS_DIR=%WORKSPACE%\Reports"
set "MARKER_FILE=%REPORTS_DIR%\__jenkins_task_exitcode.txt"
set "LOG_FILE=%REPORTS_DIR%\desktop_task.log"

if not exist "%REPORTS_DIR%" mkdir "%REPORTS_DIR%" >nul 2>&1
if exist "%MARKER_FILE%" del /f /q "%MARKER_FILE%" >nul 2>&1

echo [INFO] WORKSPACE=%WORKSPACE%               > "%LOG_FILE%"
echo [INFO] PROJECT_FILE=%PROJECT_FILE_PATH%  >> "%LOG_FILE%"
echo [INFO] KATALON_EXE=%KATALON_EXE%          >> "%LOG_FILE%"
echo [INFO] COLLECTION=%COLLECTION_PATH%       >> "%LOG_FILE%"
echo [INFO] BROWSER_TYPE=%BROWSER_TYPE%        >> "%LOG_FILE%"
echo [INFO] RETRY=%RETRY%                      >> "%LOG_FILE%"
echo ---------------------------------------------------------- >> "%LOG_FILE%"

REM ------------------------------------------------------------
REM Run Katalon (desktop)
REM ------------------------------------------------------------
pushd "%WORKSPACE%"

"%KATALON_EXE%" ^
  -noSplash ^
  -runMode=console ^
  -consoleLog ^
  -projectPath="%PROJECT_FILE_PATH%" ^
  -testSuiteCollectionPath="%COLLECTION_PATH%" ^
  -browserType="%BROWSER_TYPE%" ^
  -retry=%RETRY% ^
  -reportFolder="%REPORTS_DIR%" ^
  1>> "%LOG_FILE%" 2>&1

set "EC=%ERRORLEVEL%"

popd

REM ------------------------------------------------------------
REM Write marker for Jenkins
REM ------------------------------------------------------------
echo %EC%> "%MARKER_FILE%"

echo ---------------------------------------------------------- >> "%LOG_FILE%"
echo [INFO] ExitCode=%EC%                                     >> "%LOG_FILE%"
echo [INFO] Marker=%MARKER_FILE%                               >> "%LOG_FILE%"

exit /b %EC%
