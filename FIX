	private void waitForExportedFileOrStop(
			File exportedFile,
			Integer timeoutSeconds) {

		int safeTimeout =
				timeoutSeconds == null ||
				timeoutSeconds <= 0
				? EXPORT_FILE_TIMEOUT_SECONDS
				: timeoutSeconds

		int elapsedSeconds = 0
		long previousSize = -1
		int stableSizeChecks = 0

		while (elapsedSeconds < safeTimeout) {

			boolean fileExists =
					exportedFile.exists() &&
					exportedFile.isFile()

			long currentSize =
					fileExists
					? exportedFile.length()
					: 0

			if (fileExists &&
					currentSize > 0) {

				if (currentSize == previousSize) {
					stableSizeChecks++
				} else {
					previousSize = currentSize
					stableSizeChecks = 0
				}

				if (stableSizeChecks >=
						REQUIRED_STABLE_SIZE_CHECKS) {

					logInfo(
							'Exported file found and writing completed.\n' +
							'Path: ' + exportedFile.getAbsolutePath() + '\n' +
							'Size bytes: ' + currentSize + '\n' +
							'Elapsed seconds: ' + elapsedSeconds
							)

					return
				}
			}

			if (elapsedSeconds == 0 ||
					elapsedSeconds % FILE_LOG_INTERVAL_SECONDS == 0) {

				logInfo(
						'Export file is still being generated.\n' +
						'Elapsed seconds: ' + elapsedSeconds + ' of ' + safeTimeout + '\n' +
						'File exists: ' + fileExists + '\n' +
						'Current size bytes: ' + currentSize + '\n' +
						'Stable size checks: ' + stableSizeChecks + ' of ' + REQUIRED_STABLE_SIZE_CHECKS + '\n' +
						'Expected path: ' + exportedFile.getAbsolutePath()
						)
			}

			Windows.delay(
					1
					)

			elapsedSeconds++
		}

		imageLoader.takeEvidence(
				'ExportedFileNotFound.png'
				)

		KeywordUtil.markFailedAndStop(
				'Exported file was not found, remained empty or did not finish writing.\n' +
				'Expected path: ' + exportedFile.getAbsolutePath() + '\n' +
				'Timeout seconds: ' + safeTimeout + '\n' +
				'File exists: ' + exportedFile.exists() + '\n' +
				'Final size bytes: ' + (exportedFile.exists() ? exportedFile.length() : 0)
				)
	}


	private void closeOpenFileModal() {

		List<String> noButtonImageKeys = [
			'no',
			'noEn'
		]

		List<String> modalImageKeys = [
			'iconeModal',
			'iconeModal2',
			'iconeModalPRD'
		]

		Integer maximumCloseAttempts = 2

		logInfo(
				'Closing open-file modal.\n' +
				'First strategy: click Non button by image.\n' +
				'Non button images: ' +
				noButtonImageKeys +
				'\nModal images: ' +
				modalImageKeys +
				'\nMaximum close attempts: ' +
				maximumCloseAttempts
				)

		for (
		Integer attempt = 1;
				attempt <= maximumCloseAttempts;
				attempt++
				) {

			logInfo(
					'Open-file modal close attempt: ' +
					attempt +
					' of ' +
					maximumCloseAttempts
					)

			boolean noButtonClicked =
					clickFirstAvailableImage(
					noButtonImageKeys,
					OPEN_FILE_MODAL_TIMEOUT_SECONDS
					)

			if (noButtonClicked) {

				Windows.delay(
						SHORT_UI_DELAY_SECONDS
						)

				if (!isAnyImageVisible(
						modalImageKeys
						)) {

					logInfo(
							'Open-file modal closed successfully by clicking Non.\n' +
							'Attempt: ' +
							attempt
							)

					return
				}
			}

			String visibleModalImage =
					findFirstVisibleImage(
					modalImageKeys,
					OPEN_FILE_MODAL_TIMEOUT_SECONDS
					)

			if (visibleModalImage == null) {

				logInfo(
						'Open-file modal is not visible.\n' +
						'Continuing the export flow.'
						)

				return
			}

			try {
				imageLoader.clickImageOrStop(
						GENERAL_IMAGE_GROUP,
						visibleModalImage
						)
			} catch (Throwable throwable) {

				logInfo(
						'Could not click the modal image to restore focus.\n' +
						'Image key: ' +
						visibleModalImage +
						'\nMessage: ' +
						safeExceptionMessage(
						throwable
							)
						)
			}

			Windows.delay(
					SHORT_UI_DELAY_SECONDS
					)

			noButtonClicked =
					clickFirstAvailableImage(
					noButtonImageKeys,
					OPEN_FILE_MODAL_TIMEOUT_SECONDS
					)

			if (noButtonClicked) {

				Windows.delay(
						SHORT_UI_DELAY_SECONDS
						)

				if (!isAnyImageVisible(
						modalImageKeys
						)) {

					logInfo(
							'Open-file modal closed successfully by clicking Non after restoring focus.\n' +
							'Attempt: ' +
							attempt
							)

					return
				}
			}

			try {
				Robot robot =
						new Robot()

				robot.setAutoDelay(
						150
						)

				robot.keyPress(
						KeyEvent.VK_TAB
						)

				robot.keyRelease(
						KeyEvent.VK_TAB
						)

				Thread.sleep(
						300
						)

				robot.keyPress(
						KeyEvent.VK_ENTER
						)

				robot.keyRelease(
						KeyEvent.VK_ENTER
						)
			} catch (Exception exception) {

				imageLoader.takeEvidence(
						'OpenFileModalKeyboardError_Attempt' +
						attempt +
						'.png'
						)
			}

			Windows.delay(
					SHORT_UI_DELAY_SECONDS
					)

			if (!isAnyImageVisible(
					modalImageKeys
					)) {

				logInfo(
						'Open-file modal closed successfully.\n' +
						'Attempt: ' +
						attempt
						)

				return
			}

			if (attempt < maximumCloseAttempts) {

				logInfo(
						'Open-file modal is still visible. Retrying complete close flow.'
						)

				Windows.delay(
						SHORT_UI_DELAY_SECONDS
						)
			}
		}

		imageLoader.takeEvidence(
				'OpenFileModalStillVisibleAfterRetry.png'
				)

		KeywordUtil.markFailedAndStop(
				'Open-file modal is still visible after two complete close attempts.\n' +
				'Evidence: OpenFileModalStillVisibleAfterRetry.png'
				)
	}



	private void validateExportedFile(
			File exportedFile) {

		if (exportedFile == null) {

			KeywordUtil.markFailedAndStop(
					'Exported file reference is null.'
					)

			return
		}

		if (!exportedFile.exists() ||
				!exportedFile.isFile() ||
				exportedFile.length() <= 0) {

			KeywordUtil.markFailedAndStop(
					'Exported file is invalid.\n' +
					'Path: ' + exportedFile.getAbsolutePath() + '\n' +
					'Exists: ' + exportedFile.exists() + '\n' +
					'Size bytes: ' + (exportedFile.exists() ? exportedFile.length() : 0)
					)

			return
		}

		String lowerName =
				exportedFile
				.getName()
				.toLowerCase()

		if (!lowerName.endsWith('.xlsx') &&
				!lowerName.endsWith('.xlsm') &&
				!lowerName.endsWith('.xls')) {

			KeywordUtil.markFailedAndStop(
					'Exported file does not have a supported Excel extension. File: ' +
					exportedFile.getName()
					)

			return
		}

		logInfo(
				'Exported file validated successfully.\n' +
				'File: ' + exportedFile.getName() + '\n' +
				'Size bytes: ' + exportedFile.length()
				)
	}


	private File resolveShortExportDirectory(
			String environment,
			String collectionName,
			String featureName) {

		File executionDirectory =
				resolveShortExportRoot()

		File collectionDirectory = new File(
				executionDirectory,
				collectionName
				)

		return new File(
