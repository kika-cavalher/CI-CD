✅ 2) BAT único (genérico) — run-ematch-command.bat (INTEIRO)

Esse é o único BAT que você precisa manter.

📄 D:\Projects\eMatchStarters\run-ematch-command.bat

@echo off
setlocal EnableExtensions EnableDelayedExpansion

set "CTX_FILE=D:\Projects\eMatchStarters\run-context.properties"
if not exist "%CTX_FILE%" exit /b 2

for /f "usebackq tokens=1,* delims==" %%A in ("%CTX_FILE%") do (
  set "K=%%A"
  set "V=%%B"
  if not "!K!"=="" set "!K!=!V!"
)

if "%WORKSPACE%"=="" exit /b 3
if "%PROJECT_FILE%"=="" exit /b 3
if "%KATALON_EXE%"=="" exit /b 3
if "%COLLECTION_PATH%"=="" exit /b 3
if "%BROWSER_TYPE%"=="" exit /b 3
if "%RETRY%"=="" set "RETRY=0"

set "REPORTS_DIR=%WORKSPACE%\Reports"
set "LOG_DIR=%REPORTS_DIR%\logs"
set "MARKER=%REPORTS_DIR%\__jenkins_task_exitcode.txt"
set "LOG_FILE=%REPORTS_DIR%\__desktop_task.log"
set "PROJECT_PATH=%WORKSPACE%\%PROJECT_FILE%"

if not exist "%REPORTS_DIR%" mkdir "%REPORTS_DIR%" >nul 2>&1
if not exist "%LOG_DIR%"    mkdir "%LOG_DIR%"    >nul 2>&1
del /f /q "%MARKER%" 2>nul

echo ============================================================>> "%LOG_FILE%"
echo [INFO] Started: %DATE% %TIME%>> "%LOG_FILE%"
echo [INFO] WORKSPACE=%WORKSPACE%>> "%LOG_FILE%"
echo [INFO] PROJECT_FILE=%PROJECT_FILE%>> "%LOG_FILE%"
echo [INFO] PROJECT_PATH=%PROJECT_PATH%>> "%LOG_FILE%"
echo [INFO] KATALON_EXE=%KATALON_EXE%>> "%LOG_FILE%"
echo [INFO] COLLECTION_PATH=%COLLECTION_PATH%>> "%LOG_FILE%"
echo [INFO] BROWSER_TYPE=%BROWSER_TYPE%>> "%LOG_FILE%"
echo [INFO] RETRY=%RETRY%>> "%LOG_FILE%"
echo ============================================================>> "%LOG_FILE%"

if not exist "%KATALON_EXE%" (
  echo [ERROR] KATALON_EXE not found>> "%LOG_FILE%"
  echo 9> "%MARKER%"
  exit /b 9
)

if not exist "%PROJECT_PATH%" (
  echo [ERROR] Project file not found>> "%LOG_FILE%"
  echo 10> "%MARKER%"
  exit /b 10
)

pushd "%WORKSPACE%" >nul 2>&1

"%KATALON_EXE%" ^
  -noSplash ^
  -runMode=console ^
  -consoleLog ^
  -projectPath="%PROJECT_PATH%" ^
  -retry=%RETRY% ^
  -testSuiteCollectionPath="%COLLECTION_PATH%" ^
  -browserType="%BROWSER_TYPE%" ^
  -reportFolder="%REPORTS_DIR%" ^
  1>> "%LOG_FILE%" 2>&1

set "EC=%ERRORLEVEL%"

popd >nul 2>&1

echo [INFO] Finished: %DATE% %TIME% ExitCode=%EC%>> "%LOG_FILE%"
echo %EC%> "%MARKER%"

exit /b %EC%
✅ 3) Jenkinsfile por suíte (só muda COLLECTION_PATH)

Cada build você cria um Jenkinsfile diferente, mas sem criar novas tasks/bats.

Archive Mode Jenkinsfile (inteiro)
pipeline {
  agent { label 'GI5_SWDCFRNXGI55817' }

  options {
    timestamps()
    ansiColor('xterm')
    disableConcurrentBuilds()
    timeout(time: 4, unit: 'HOURS')
  }

  stages {
    stage('Prepare Context') {
      steps {
        script {
          def runner = load 'jenkinsIntegration/JenkinsDesktopPipelineRunner.groovy'

          def marker = "${env.WORKSPACE}\\Reports\\__jenkins_task_exitcode.txt"
          runner.deleteIfExists(this, marker)

          runner.writeRunContextFile(this, 'D:\\Projects\\eMatchStarters\\run-context.properties', [
            WORKSPACE       : env.WORKSPACE,
            PROJECT_FILE    : 'eMatch POC.prj',
            KATALON_EXE      : 'C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0\\katalonc.exe',
            COLLECTION_PATH : 'Test Suites/Archive Mode/Archive Mode Collection',
            BROWSER_TYPE    : 'Windows',
            RETRY           : '0'
          ])

          env.DESKTOP_MARKER = marker
        }
      }
    }

    stage('Run Desktop') {
      steps {
        script {
          def runner = load 'jenkinsIntegration/JenkinsDesktopPipelineRunner.groovy'
          int ec = runner.runScheduledTaskAndWaitMarker(this, '\\eMatch Automation\\RunEMatchDesktop', env.DESKTOP_MARKER, 180)
          if (ec != 0) error("ExitCode=${ec}")
        }
      }
    }
  }

  post {
    always { archiveArtifacts artifacts: 'Reports/**', allowEmptyArchive: true }
  }
}
