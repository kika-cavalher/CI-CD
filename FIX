properties([
    disableConcurrentBuilds()
])

def NODE_LABEL = 'GI5_SWDCFRNXGI55817'
def SHORT_WORKSPACE = 'D:\\jenkins\\ws\\ARCHIVE_MODE'
def MAX_EXECUTION_HOURS = 5

// true = schedule the next Jenkins pipeline
// false = finish after the current pipeline
def RUN_NEXT_JOB = true

// Full Jenkins job path for the next pipeline
def NEXT_JOB = 'GI5/eMatch_Regression/BDR_Module des Responsabilite'

def executionFailed = false
def executionTimedOut = false
def manuallyAborted = false

def stopCurrentExecution = {
    bat '''
@echo off
schtasks /end /tn "\\eMatch Automation\\RunEMatchCommand" >nul 2>nul
schtasks /end /tn "startWinDriver" >nul 2>nul
taskkill /f /im WinAppDriver.exe /t >nul 2>nul
taskkill /f /im katalonc.exe /t >nul 2>nul
taskkill /f /im KatalonStudio.exe /t >nul 2>nul
ping -n 6 127.0.0.1 >nul
exit /b 0
'''
}

def isTimeoutAbort = { Throwable err ->
    return err instanceof org.jenkinsci.plugins.workflow.steps.FlowInterruptedException &&
           err.causes.any { cause -> cause.getClass().getName().contains('ExceededTimeout') }
}

node(NODE_LABEL) {
    ws(SHORT_WORKSPACE) {
        stage('Checkout') {
            checkout scm
        }

        stage('Run current pipeline') {
            try {
                timeout(time: MAX_EXECUTION_HOURS, unit: 'HOURS') {
                    bat 'call "%WORKSPACE%\\jenkins\\ArchiveMode.cmd"'
                }
            } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException err) {
                if (isTimeoutAbort(err)) {
                    executionFailed = true
                    executionTimedOut = true
                    echo "Execution timed out after ${MAX_EXECUTION_HOURS} hours."
                } else {
                    manuallyAborted = true
                    executionFailed = true
                    echo 'Execution was manually aborted.'
                }
            } catch (Throwable err) {
                executionFailed = true
                echo "Current execution failed: ${err}"
            } finally {
                stage('Stop current execution') {
                    stopCurrentExecution()
                }
            }
        }
    }
}

if (manuallyAborted) {
    currentBuild.result = 'ABORTED'
    echo 'Build manually aborted. Next pipeline will not be scheduled.'
    return
}

stage('Trigger next pipeline') {
    if (RUN_NEXT_JOB && NEXT_JOB?.trim()) {
        echo "Scheduling next pipeline: ${NEXT_JOB}"
        build job: NEXT_JOB,
              wait: false,
              propagate: false
    } else {
        echo 'Next pipeline disabled.'
    }
}

currentBuild.result = executionFailed ? 'FAILURE' : 'SUCCESS'

if (executionTimedOut) {
    echo 'Execution reached the maximum timeout and was stopped before moving on.'
}

return






