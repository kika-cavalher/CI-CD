    @Keyword
    String getInstalledExePath() {
        String currentUser = getCurrentWindowsUser()

        List<String> candidates = [
            "C:\\Users\\${currentUser}\\AppData\\Local\\Apps\\2.0",
            "C:\\Users\\${currentUser}\\AppData\\Local\\Microsoft\\Windows\\INetCache\\IE"
        ]

        for (String basePath : candidates) {
            File baseDir = new File(basePath)
            if (!baseDir.exists()) {
                continue
            }

            List<File> matches = []
            baseDir.eachFileRecurse { File file ->
                try {
                    if (file.isFile() && file.name.equalsIgnoreCase('IXIS.eMatch.IHM.exe')) {
                        matches << file
                    }
                } catch (Throwable ignored) {
                }
            }

            if (!matches.isEmpty()) {
                matches.sort { a, b -> b.lastModified() <=> a.lastModified() }
                String resolved = matches.first().absolutePath
                KeywordUtil.logInfo("Installed exe path resolved: ${resolved}")
                return resolved
            }
        }

        KeywordUtil.logInfo('Installed exe path not found')
        return ''
    }

    @Keyword
    boolean startEMatch(String currentUser, String targetWindowTitle) {
        String env = currentEnv()
        String shortcutPath = getShortcutPath()

        KeywordUtil.logInfo("Starting eMatch for environment ${env}")
        KeywordUtil.logInfo("Current Windows user ${currentUser}")
        KeywordUtil.logInfo("Target window title ${targetWindowTitle}")
        KeywordUtil.logInfo("Shortcut path ${shortcutPath}")
        KeywordUtil.logInfo("Application path ${getApplicationPath()}")
        KeywordUtil.logInfo("Installed exe path ${getInstalledExePath()}")

        ensureWinAppDriverStarted()
        killProcessIfExists('IXIS.eMatch.IHM.exe')

        File shortcut = new File(shortcutPath)
        if (!shortcut.exists()) {
            throw new Exception("Shortcut does not exist: ${shortcutPath}")
        }

        Windows.startApplication(shortcutPath)

        boolean processReady = waitForProcess('IXIS.eMatch.IHM.exe', 60)
        if (!processReady) {
            throw new Exception('eMatch process did not appear after launch.')
        }

        Windows.delay(6)
        return true
    }

    @Keyword
    boolean attachToLoginWindow(String targetWindowTitle) {
        KeywordUtil.logInfo("Attaching to login window with title ${targetWindowTitle}")

        for (int round = 1; round <= 60; round++) {
            try {
                Windows.switchToWindowTitle(targetWindowTitle)
                Windows.delay(1)

                if (isLoginWindowReady()) {
                    KeywordUtil.logInfo("Attached by exact title at round ${round}")
                    return true
                }
            } catch (Throwable e) {
                KeywordUtil.logInfo("Exact title attach failed at round ${round}: ${e.message}")
            }

            for (int index = 0; index <= 5; index++) {
                try {
                    Windows.switchToWindowIndex(index)
                    Windows.delay(1)

                    if (isLoginWindowReady()) {
                        KeywordUtil.logInfo("Attached by window index ${index} at round ${round}")
                        return true
                    }
                } catch (Throwable ignored) {
                }
            }

            Windows.delay(1)
        }

        throw new Exception("eMatch opened but login window was not attached. Expected title: ${targetWindowTitle}")
    }

    @Keyword
