	}


	private static class RowCountStreamingHandler
	implements XSSFSheetXMLHandler.SheetContentsHandler {

		int rows = 0
		private boolean rowHasValue = false

		@Override
		void startRow(int rowNum) {
			rowHasValue = false
		}

		@Override
		void endRow(int rowNum) {
			if (rowNum > 0 && rowHasValue) {
				rows++
			}
		}

		@Override
		void cell(
				String cellReference,
				String formattedValue,
				XSSFComment comment) {

			if (formattedValue != null &&
					!formattedValue.trim().isEmpty()) {

				rowHasValue = true
			}
		}

		@Override
		void headerFooter(
				String text,
				boolean isHeader,
				String tagName) {
		}
	}


	private Map readFileData(
			File file,
			int columnIndex,
			String expectedColumnName,
			String environment,
			boolean treatBlankCellsAsZero) {

		Map result = [
			columnName                 : '',
			headers                    : [],
			headerCount                : 0,
			rows                       : 0,
			numericValues              : 0,
			zeroValues                 : 0,
			nonZeroValues              : 0,
			blankValues                : 0,
			blankValuesTreatedAsZero   : 0,
			unreadableValues           : 0,
			nonNumericDigest           : '',
			nonNumericRawDigest        : '',
			nonNumericValueCounts      : [:],
			nonNumericSamples          : [:],
			unreadableSamples          : [],
			onlyZeroValues             : false,
			columnStatus               : 'NOT_ANALYSED',
			sum                        : null,
			minimum                    : null,
			maximum                    : null,
			errors                     : ''
		]

		StringBuilder errors = new StringBuilder()
		FileInputStream input = null
		Workbook workbook = null

		try {
			input = new FileInputStream(file)
			workbook = WorkbookFactory.create(input)

			if (workbook.getNumberOfSheets() == 0) {
				errors.append('[ERROR] ')
						.append(environment)
						.append(
						' workbook does not contain worksheets.\n'
						)
						.append('File: ')
						.append(file.getName())

				result.errors = errors.toString()
				return result
			}

			Sheet sheet = workbook.getSheetAt(0)
			DataFormatter formatter = new DataFormatter()

			FormulaEvaluator evaluator =
					workbook
					.getCreationHelper()
					.createFormulaEvaluator()

			List<String> headers =
					trimTrailingEmptyHeaders(
					readSyntheseRowValues(
					sheet.getRow(0),
					formatter,
					evaluator
					)
					)

			result.headers = headers
			result.headerCount =
					headers.findAll { String header ->

						!safeText(header).isEmpty()
					}.size()

			String columnName =
					readHeaderName(
					sheet,
					columnIndex,
					formatter
					)

			result.columnName = columnName

			if (columnName.isEmpty()) {
				errors.append('[ERROR] ')
						.append(environment)
						.append(
						' column header was not found.\n'
						)
						.append('Column index: ')
						.append(columnIndex)
						.append('\n')
			} else if (!normalizeText(columnName).equals(
					normalizeText(expectedColumnName))) {

				errors.append('[ERROR] Unexpected ')
						.append(environment)
						.append(
						' column header.\n'
						)
						.append('Expected: ')
						.append(safeText(expectedColumnName))
						.append('\nFound: ')
						.append(columnName)
						.append('\n')
			}

			BigDecimal sum = BigDecimal.ZERO
			BigDecimal minimum = null
			BigDecimal maximum = null

			int numericValues = 0
			int zeroValues = 0
			int nonZeroValues = 0
			int blankValues = 0
			int blankValuesTreatedAsZero = 0
			int unreadableValues = 0
			int rows = 0
			List<String> unreadableSamples = []

			Map<String, Integer> nonNumericValueCounts = [:]
			Map<String, Integer> nonNumericRawValueCounts = [:]
			Map<String, String> nonNumericSamples = [:]

			for (int rowIndex = 1;
					rowIndex <= sheet.getLastRowNum();
					rowIndex++) {

				Row row = sheet.getRow(rowIndex)

				if (row == null ||
						isRowEmpty(row, formatter)) {

					continue
				}

				rows++

				Cell targetCell = row.getCell(columnIndex)

				BigDecimal value =
						getCellNumber(
						row,
						columnIndex,
						formatter,
						evaluator
						)

				if (value == null) {
					String displayText =
							readCellDisplayText(
							targetCell,
							formatter,
							evaluator
							)

					BigDecimal displayedNumericValue =
							parseNumber(displayText)

					if (displayedNumericValue != null) {
						value = displayedNumericValue
					} else if (isZeroPlaceholder(displayText)) {
						value = BigDecimal.ZERO
					} else if (isBlankCell(targetCell, displayText)) {
						blankValues++

						if (treatBlankCellsAsZero) {
							value = BigDecimal.ZERO
							blankValuesTreatedAsZero++
						} else {
							continue
						}
					} else {
						unreadableValues++

						String rawNonNumericValue =
								safeText(displayText)

						String normalizedNonNumericValue =
								normalizeNonNumericValue(
								rawNonNumericValue
								)

						incrementValueCount(
								nonNumericValueCounts,
								normalizedNonNumericValue
								)

						incrementValueCount(
								nonNumericRawValueCounts,
								rawNonNumericValue
								)

						if (!nonNumericSamples.containsKey(
								normalizedNonNumericValue
								)) {

							nonNumericSamples.put(
									normalizedNonNumericValue,
									rawNonNumericValue
									)
						}

						if (unreadableSamples.size() < 5) {
							unreadableSamples.add(
									'Row ' +
									(rowIndex + 1) +
									': "' +
									displayText +
									'"'
									)
						}

						continue
					}
				}

				sum = sum.add(value)

				if (minimum == null ||
						value.compareTo(minimum) < 0) {

					minimum = value
				}

				if (maximum == null ||
						value.compareTo(maximum) > 0) {

					maximum = value
				}

				if (value.compareTo(BigDecimal.ZERO) == 0) {
					zeroValues++
				} else {
					nonZeroValues++
				}

				numericValues++
			}

			result.rows = rows
			result.numericValues = numericValues
			result.zeroValues = zeroValues
			result.nonZeroValues = nonZeroValues
			result.blankValues = blankValues
			result.blankValuesTreatedAsZero =
					blankValuesTreatedAsZero
			result.unreadableValues = unreadableValues
			result.nonNumericValueCounts = nonNumericValueCounts
			result.nonNumericSamples = nonNumericSamples
			result.nonNumericDigest =
					unreadableValues > 0
					? digestValueCounts(
						nonNumericValueCounts
						)
					: ''
			result.nonNumericRawDigest =
					unreadableValues > 0
					? digestValueCounts(
						nonNumericRawValueCounts
						)
					: ''
			result.unreadableSamples = unreadableSamples

			if (rows == 0) {
				result.columnStatus = 'NO_DATA_ROWS'

				errors.append('[ERROR] ')
						.append(environment)
						.append(' export does not contain data rows.\n')
						.append('Column: ')
						.append(columnName)
						.append('\nRows analysed: 0\n')
			} else {
				if (numericValues > 0) {
					result.sum = round2(sum)
					result.minimum = round2(minimum)
					result.maximum = round2(maximum)
					result.onlyZeroValues = nonZeroValues == 0

					if (result.onlyZeroValues) {
						result.columnStatus =
								blankValuesTreatedAsZero > 0
								? 'ONLY_ZERO_VALUES_WITH_BLANKS_AS_ZERO'
								: 'ONLY_ZERO_VALUES'
					} else {
						result.columnStatus = 'NUMERIC_VALUES_FOUND'
					}
				}

				if (unreadableValues > 0) {

					result.columnStatus =
							numericValues > 0
							? 'NUMERIC_VALUES_WITH_NON_NUMERIC_CELLS'
							: 'NON_NUMERIC_VALUES'
				} else if (numericValues == 0 &&
						blankValues == rows) {

					result.columnStatus = 'EMPTY_COLUMN'
				} else if (numericValues == 0) {

					result.columnStatus = 'NO_NUMERIC_VALUES'
				}
			}

			result.errors = errors.toString().trim()
			return result
		} finally {
			closeWorkbook(workbook)
			closeInput(input)
		}
	}


