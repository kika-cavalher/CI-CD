			errors              : '',
			passedDetails       : '',
			exportRootFolder    : safeText(exportRootFolder),
			exportGroupFolder   : safeText(exportGroupFolder),
			exportFeatureFolder : safeText(exportFeatureFolder),
			columnIndex         : columnIndex,
			columnName          : safeText(expectedColumnName),
			recColumnName       : '',
			prdColumnName       : '',
			selectedFolderPath  : '',
			recFileName         : 'NOT FOUND',
			prdFileName         : 'NOT FOUND',
			recRows             : null,
			prdRows             : null,
			recNumericValues    : null,
			prdNumericValues    : null,
			recSum              : null,
			prdSum              : null,
			recMinimum          : null,
			prdMinimum          : null,
			recMaximum          : null,
			prdMaximum          : null
		]
	}


	private Map finalizeResult(
			Map result,
			StringBuilder errors,
			StringBuilder passedDetails) {

		result.errors =
				errors
				.toString()
				.trim()

		result.passedDetails =
				passedDetails
				.toString()
				.trim()

		result.success =
				result.errors.isEmpty()

		return result
	}


	private Map resolveLatestRecPrdFiles(
			File exportRoot,
			String expectedGroupFolder,
			String expectedFeatureFolder) {

		Map result = [
			recFile       : null,
			prdFile       : null,
			selectedFolder: null
		]

		List<File> matchingFeatureFolders = []

		collectMatchingFeatureFolders(
				exportRoot,
				expectedGroupFolder,
				expectedFeatureFolder,
				matchingFeatureFolders
				)

		List<Map> validPairs = []

		for (File featureFolder :
		matchingFeatureFolders) {

			File[] folderFiles =
					featureFolder.listFiles()

			if (folderFiles == null) {
				continue
			}

			List<File> recFiles =
					folderFiles.findAll { File file ->

						isEnvironmentExcelFile(
								file,
								'REC'
								)
					}

			List<File> prdFiles =
					folderFiles.findAll { File file ->

						isEnvironmentExcelFile(
								file,
								'PRD'
								)
					}

			if (recFiles.isEmpty() ||
					prdFiles.isEmpty()) {

				continue
			}

			recFiles.sort { File first, File second ->

				second.lastModified() <=>
						first.lastModified()
			}

			prdFiles.sort { File first, File second ->

				second.lastModified() <=>
						first.lastModified()
			}

			File recFile =
					recFiles.get(0)

			File prdFile =
					prdFiles.get(0)

			validPairs.add([
				recFile       : recFile,
				prdFile       : prdFile,
				selectedFolder: featureFolder,
				pairTimestamp : Math.max(
				recFile.lastModified(),
				prdFile.lastModified()
				)
			])
		}

		if (validPairs.isEmpty()) {
			return result
		}

		validPairs.sort { Map first, Map second ->

			(second.pairTimestamp as Long) <=>
					(first.pairTimestamp as Long)
		}

		Map latestPair =
				validPairs.get(0)

		result.recFile =
				latestPair.recFile

		result.prdFile =
				latestPair.prdFile

		result.selectedFolder =
				latestPair.selectedFolder

		return result
	}


	private void collectMatchingFeatureFolders(
			File currentFolder,
			String expectedGroupFolder,
			String expectedFeatureFolder,
			List<File> result) {

		if (currentFolder == null ||
				!currentFolder.exists() ||
				!currentFolder.isDirectory()) {

			return
		}

		File parentFolder =
				currentFolder.getParentFile()

		boolean featureMatches =
				normalizeText(
				currentFolder.getName()
				).equals(
				normalizeText(
				expectedFeatureFolder
				)
				)

		boolean groupMatches =
				parentFolder != null &&
				normalizeText(
				parentFolder.getName()
				).equals(
				normalizeText(
				expectedGroupFolder
				)
				)

		if (featureMatches &&
				groupMatches) {

			result.add(currentFolder)
			return
		}

		File[] children =
				currentFolder.listFiles()

		if (children == null) {
			return
		}

		for (File child : children) {
			if (child != null &&
					child.isDirectory()) {

				collectMatchingFeatureFolders(
						child,
						expectedGroupFolder,
