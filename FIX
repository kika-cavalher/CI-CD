
import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.driver.WindowsDriverFactory
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows
import com.kms.katalon.core.windows.keyword.helper.WindowsActionHelper

import internal.GlobalVariable as GlobalVariable

String imgDir = RunConfiguration.getProjectDir() + File.separator + 'Images' + File.separator + 'BDR' + File.separator
String currEnv = Windows.getText(findWindowsObject('Object Repository/General/curEnv')).equalsIgnoreCase('Recette') ? 'Rec' : 'PROD'

String allRow = new File(imgDir, "AllRow_${currEnv}.png").getAbsolutePath()
String expandArrow = new File(imgDir, "ExpandArrow_${currEnv}.png").getAbsolutePath()
String lastRowArrow = new File(imgDir, "lastRowArrow_${currEnv}.png").getAbsolutePath()
String isAllOpen = new File(imgDir, "isAllOpen_${currEnv}.png").getAbsolutePath()
String totalCurrentYear = new File(imgDir, "totalCurrentYear_${currEnv}.png").getAbsolutePath()

String evidenceDir = RunConfiguration.getReportFolder() + "\\Evidences\\"
new File(evidenceDir).mkdirs()

Windows.delay(15)

[allRow, expandArrow, lastRowArrow, isAllOpen, totalCurrentYear].each { path ->
	if (!new File(path).exists()) {
		KeywordUtil.markFailedAndStop("❌ Image file not found at: ${path}")
	}
}
KeywordUtil.logInfo("✅ All image files exist, continuing...")

Windows.delay(5)

boolean foundAllRow = WindowsImageKeywords.findImage(allRow)
if (!foundAllRow) {
	KeywordUtil.markFailedAndStop("❌ Base image (AllRow_${currEnv}) not visible on screen.")
}

try {
	WindowsImageKeywords.clickImageInImage(allRow, expandArrow)
	KeywordUtil.logInfo("🖱️ Clicked ExpandArrow inside AllRow image.")
} catch (Exception e) {
	KeywordUtil.markFailedAndStop("❌ Could not click ExpandArrow inside AllRow image: ${e.message}")
}

Windows.delay(15)
Windows.delay(10)

if (!WindowsImageKeywords.waitForImage(isAllOpen, 12)) {
	KeywordUtil.markWarning("⚠️ Full expansion indicator (isAllOpen) not detected.")
}

WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession())
	.takeScreenshot(evidenceDir + "ExpandAllOpened_${currEnv}.png")

try {
	WindowsImageKeywords.clickImageInImage(lastRowArrow, expandArrow)
	KeywordUtil.logInfo("🖱️ Clicked ExpandArrow inside last row.")
} catch (Exception e) {
	KeywordUtil.markFailedAndStop("❌ Could not click ExpandArrow inside lastRowArrow: ${e.message}")
}

Windows.delay(10)

WindowsImageKeywords.waitForImage(totalCurrentYear, 12)

WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession())
	.takeScreenshot(evidenceDir + "ExpandCurrentYear_${currEnv}.png")

if (!WindowsImageKeywords.findImage(totalCurrentYear) || !WindowsImageKeywords.findImage(isAllOpen)) {
	KeywordUtil.markFailed("❌ The table was not expanded correctly in ${currEnv}.")
} else {
	KeywordUtil.logInfo("✅ The table expanded correctly in ${currEnv}.")
}

def compareFiles = GlobalVariable.compareFiles as ArrayList
Integer beforeDownloadLen = compareFiles.size()

compareFiles.add(CustomKeywords.'com.katalon.ematch.helper.EmatchHelper.downloadFileFromOutils'(15, 15))

Integer afterDownloadLen = compareFiles.size()

beforeDownloadLen == afterDownloadLen
	? KeywordUtil.markFailed('Cube Balance des Responsabilités file not downloaded correctly')
	: KeywordUtil.markPassed('Cube Balance des Responsabilités file downloaded correctly')
