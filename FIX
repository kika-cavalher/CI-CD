@Keyword
def jiraImport() {
	KeywordUtil.logInfo('============================================================')
	KeywordUtil.logInfo('Starting Jira import flow')
	KeywordUtil.logInfo('============================================================')

	String reportFolder = getReportPath()
	KeywordUtil.logInfo('Using report folder: ' + safe(reportFolder))

	String suiteName = getCurrentSuiteName()
	KeywordUtil.logInfo('Suite name detected from report path: ' + safe(suiteName))

	if (isBlank(reportFolder) || !new File(reportFolder).exists()) {
		KeywordUtil.markFailed('Report folder could not be resolved.')
		return
	}

	if (isBlank(suiteName)) {
		KeywordUtil.markFailed('Suite name could not be resolved from report path.')
		return
	}

	String executionTitle = getExecutionSummary()
	String testPlanTitle = getTestPlanName()

	KeywordUtil.logInfo('Execution title used: ' + executionTitle)
	KeywordUtil.logInfo('Test Plan title used: ' + testPlanTitle)

	String xmlPath = findExecutionXmlPath()
	if (isBlank(xmlPath)) {
		KeywordUtil.markFailed('Execution XML file was not found.')
		return
	}

	KeywordUtil.logInfo('XML file found: ' + xmlPath)

	String gaiaReportPath = createGaiaHtmlReport()
	KeywordUtil.logInfo('Gaia report created: ' + safe(gaiaReportPath))

	String resultsZipPath = zipReports()
	String evidencesZipPath = zipEvidences()

	String executionKey = importExecutionResults(xmlPath)
	if (executionKey.startsWith('ERROR')) {
		KeywordUtil.markFailed('Execution could not be created or imported: ' + executionKey)
		return
	}

	String testPlanKey = getOrCreateTestPlanKey()
	if (isBlank(testPlanKey) || testPlanKey.startsWith('ERROR')) {
		KeywordUtil.markFailed('Test Plan could not be created or resolved: ' + testPlanKey)
		return
	}

	int updateExecutionStatus = updateIssue(
		executionKey,
		buildUpdateExecutionBody(executionTitle, testPlanKey)
	)

	int addExecutionStatus = addExecutionToTestPlan(testPlanKey, executionKey)

	int gaiaReportUploadStatus = uploadAttachment(executionKey, gaiaReportPath)
	int resultsZipUploadStatus = uploadAttachment(executionKey, resultsZipPath)
	int evidencesZipUploadStatus = uploadAttachment(executionKey, evidencesZipPath)

	int transitionExecutionStatus = transitionIssue(executionKey, TEST_EXECUTION_TRANSITION_ID)
	int transitionTestPlanStatus = transitionIssue(testPlanKey, TEST_PLAN_TRANSITION_ID)

	KeywordUtil.logInfo('============================================================')
	KeywordUtil.logInfo('Jira import finished')
	KeywordUtil.logInfo('============================================================')
	KeywordUtil.logInfo('Execution key: ' + executionKey)
	KeywordUtil.logInfo('Execution title used: ' + executionTitle)
	KeywordUtil.logInfo('Test Plan key: ' + testPlanKey)
	KeywordUtil.logInfo('Test Plan title used: ' + testPlanTitle)
	KeywordUtil.logInfo('Gaia report attachment status: ' + gaiaReportUploadStatus)
	KeywordUtil.logInfo('Results.zip attachment status: ' + resultsZipUploadStatus)
	KeywordUtil.logInfo('Evidences.zip attachment status: ' + evidencesZipUploadStatus)
	KeywordUtil.logInfo('Update Test Execution status: ' + updateExecutionStatus)
	KeywordUtil.logInfo('Add execution to Test Plan status: ' + addExecutionStatus)
	KeywordUtil.logInfo('Transition Execution status: ' + transitionExecutionStatus)
	KeywordUtil.logInfo('Transition Test Plan status: ' + transitionTestPlanStatus)

	if (!(updateExecutionStatus in [200, 204])) {
		KeywordUtil.markFailed('Failed updating Test Execution ' + executionKey)
		return
	}

	if (!(addExecutionStatus in [200, 204])) {
		KeywordUtil.markFailed('Failed linking Test Execution ' + executionKey + ' to Test Plan ' + testPlanKey)
		return
	}
}
