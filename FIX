	private void validatePresent(
		String objectKey,
		String description,
		Integer timeout,
		List<String> errors
	) {

		logObjectSearch(objectKey, description)

		boolean present =
			Windows.waitForElementPresent(
				object(objectKey),
				timeout,
				FailureHandling.OPTIONAL
			)

		reportBooleanResult(
			present,
			description + ' was found.',
			description + ' was not found.',
			errors
		)
	}


	private void validateEnabledState(
		String objectKey,
		String description,
		boolean expectedEnabled,
		Integer timeout,
		List<String> errors
	) {

		WindowsTestObject targetObject = object(objectKey)

		boolean present =
			Windows.waitForElementPresent(
				targetObject,
				timeout,
				FailureHandling.OPTIONAL
			)

		if (!present) {
			errors.add(description + ' was not found.')
			return
		}

		String enabledAttribute = safeText(
			Windows.getAttribute(
				targetObject,
				'IsEnabled',
				FailureHandling.OPTIONAL
			)
		)

		boolean actualEnabled =
			enabledAttribute.equalsIgnoreCase('True')

		if (actualEnabled == expectedEnabled) {
			KeywordUtil.logInfo(
				'[PASS] ' + description +
				' enabled state is correct.'
			)
		} else {
			errors.add(
				description +
				' enabled state is incorrect.\n' +
				'Expected: ' + expectedEnabled + '\n' +
				'Actual: ' + actualEnabled
			)
		}
	}


	private void clickImage(
		String groupName,
		String imageKey,
		Integer timeout
	) {

		boolean found =
			imageLoader.waitForImage(
				groupName,
				imageKey,
				timeout
			)

		if (!found) {
			takeEvidence(
				'GUI_ImageNotFound_' +
				imageKey +
				'.png'
			)

			KeywordUtil.markFailedAndStop(
				'Image was not found.\n' +
				'Group: ' + groupName + '\n' +
				'Key: ' + imageKey
			)

			return
		}

		try {
			WindowsImageKeywords.clickImage(
				image(groupName, imageKey)
			)
		} catch (Exception e) {
			takeEvidence(
				'GUI_ImageClickFailed_' +
				imageKey +
				'.png'
			)

			KeywordUtil.markFailedAndStop(
				'Image click failed.\n' +
				'Group: ' + groupName + '\n' +
				'Key: ' + imageKey + '\n' +
				'Reason: ' + safeMessage(e)
			)
		}
	}


	private void typeOnImage(
		String groupName,
		String imageKey,
		String value,
		Integer timeout
	) {

		boolean found =
			imageLoader.waitForImage(
				groupName,
				imageKey,
				timeout
			)

		if (!found) {
			takeEvidence(
				'GUI_InputImageNotFound_' +
				imageKey +
				'.png'
			)

			KeywordUtil.markFailedAndStop(
				'Input image was not found.\n' +
				'Group: ' + groupName + '\n' +
				'Key: ' + imageKey
			)

			return
		}

		try {
			WindowsImageKeywords.typeOnImage(
				image(groupName, imageKey),
				value
			)
		} catch (Exception e) {
			takeEvidence(
				'GUI_TypeOnImageFailed_' +
				imageKey +
				'.png'
			)

			KeywordUtil.markFailedAndStop(
				'Could not enter value using image.\n' +
				'Image: ' + imageKey + '\n' +
				'Reason: ' + safeMessage(e)
			)
		}
	}


