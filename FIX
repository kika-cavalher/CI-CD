✅ TC 3: Export Expanded Table
import com.kms.katalon.core.util.KeywordUtil

String menuName = CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.getMenuName'()
String exportLabel = CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.getExportLabel'()

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Search and open menu: ' + menuName)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.openMenu'(
	60
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Validate opened menu screen: ' + menuName)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.validateOpenedMenu'(
	60
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Take screenshot of opened menu screen: ' + menuName)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.takeEvidence'(
	'OpenedScreen.png'
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Resolve export image group according to current environment')

String exportImageGroup = CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.getExportImageGroup'()

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Validate export images exist for group: ' + exportImageGroup)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.validateImagesExist'(
	exportImageGroup
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Wait for table to be ready before expanding rows')

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.waitSeconds'(
	15
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Validate base row image is visible before expansion')

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.waitForImageVisible'(
	exportImageGroup,
	'allRow',
	12
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Expand all rows using ExpandArrow inside AllRow image')

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.clickImageInsideImage'(
	exportImageGroup,
	'allRow',
	'expandArrow'
)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.waitSeconds'(
	25
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Validate full expansion indicator is visible')

boolean allRowsOpen = CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.waitForImageOptional'(
	exportImageGroup,
	'isAllOpen',
	12
)

if (!allRowsOpen) {
	KeywordUtil.markWarning('Full expansion indicator isAllOpen was not detected.')
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Take screenshot after expanding all rows')

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.takeEvidence'(
	'ExpandAllOpened.png'
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Expand current year row using ExpandArrow inside last row image')

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.clickImageInsideImage'(
	exportImageGroup,
	'lastRowArrow',
	'expandArrow'
)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.waitSeconds'(
	10
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Validate current year total is visible after expansion')

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.waitForImageVisible'(
	exportImageGroup,
	'totalCurrentYear',
	12
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Take screenshot after expanding current year row')

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.takeEvidence'(
	'ExpandCurrentYear.png'
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Validate expanded table state before export')

boolean totalCurrentYearVisible = CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.isImageVisible'(
	exportImageGroup,
	'totalCurrentYear'
)

boolean allOpenVisible = CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.isImageVisible'(
	exportImageGroup,
	'isAllOpen'
)

if (!totalCurrentYearVisible || !allOpenVisible) {
	KeywordUtil.markFailedAndStop(
		'The table was not expanded correctly for image group: ' + exportImageGroup
	)
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Export file from Outils: ' + exportLabel)

String downloadedFile = CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.exportFromOutils'(
	15,
	15
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'File exported successfully: ' + downloadedFile
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Validate exported file exists in Evidences folder')

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.validateExportedFileExists'(
	downloadedFile
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	exportLabel + ' export test completed successfully'
)

KeywordUtil.markPassed(exportLabel + ' export test completed successfully')
✅ TC 4: Validations export RECXPRD
import com.kms.katalon.core.util.KeywordUtil

String exportLabel = CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.getExportLabel'()
Integer threshold = 3

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Start validation of downloaded ' + exportLabel + ' files'
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Validate REC and PROD exported files exist'
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Compare REC and PROD headers, structure and numeric values using threshold: ' + threshold
)

String errors = CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.validateRecProdExportFiles'(
	threshold
)

if (errors != '') {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'File comparison finished with mismatches between REC and PROD'
	)

	KeywordUtil.markFailed('\n' + errors)
} else {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'File comparison finished successfully with no mismatches'
	)

	KeywordUtil.markPassed(
		exportLabel + ' REC/PROD validation completed successfully'
	)
}
