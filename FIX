		List<File> files = []

		roots.findAll { File it -> it != null && it.exists() && it.isDirectory() }
				.unique { File it -> it.absolutePath }
				.each { File root ->
					root.eachFileRecurse { File file ->
						if (!file.isFile()) {
							return
						}

						String lower = safe(file.name).toLowerCase(Locale.ENGLISH)
						if (!lower.endsWith('.html')) {
							return
						}

						if (lower == 'ematchreport.html') {
