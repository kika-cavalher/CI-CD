	String findXmlFile(String reportFolder) {
		if (isBlank(reportFolder)) {
			return ''
		}

		File root = new File(reportFolder)
		if (!root.exists()) {
			return ''
		}

		List<File> preferred = []
		List<File> fallback = []

		root.eachFileRecurse(FileType.FILES) { File file ->
			String lower = safe(file.name).toLowerCase()

			if (lower == PRIMARY_XML_FILE_NAME.toLowerCase()) {
				preferred << file
			} else if (lower == SECONDARY_XML_FILE_NAME.toLowerCase()) {
				fallback << file
			}
		}

		if (!preferred.isEmpty()) {
			preferred.sort { a, b -> b.lastModified() <=> a.lastModified() }
			return preferred[0].absolutePath
		}

		if (!fallback.isEmpty()) {
			fallback.sort { a, b -> b.lastModified() <=> a.lastModified() }
			return fallback[0].absolutePath
		}

		return ''
	}

	boolean isVisualEvidence(File file) {
		if (file == null || !file.exists() || !file.isFile()) {
			return false
		}

		String lower = safe(file.name).toLowerCase()
		return lower.endsWith('.png') || lower.endsWith('.jpg') || lower.endsWith('.jpeg') || lower.endsWith('.webp')
	}

	boolean shouldSkipVisualEvidence(File file) {
		if (!isVisualEvidence(file)) {
			return true
		}

		String path = safe(file.absolutePath).toLowerCase()
		if (path.contains(File.separator + 'requests' + File.separator)) return true
		if (path.contains(File.separator + 'videos' + File.separator)) return true
		if (path.endsWith(File.separator + GAIA_REPORT_FILE_NAME.toLowerCase())) return true

		return false
	}

	List<File> collectFailureImages(String reportFolder) {
		List<File> images = []
		File root = new File(reportFolder)

		if (!root.exists()) {
			return images
		}

		root.eachFileRecurse(FileType.FILES) { File file ->
			if (!shouldSkipVisualEvidence(file)) {
				images << file
			}
		}

		images.sort { a, b -> a.lastModified() <=> b.lastModified() }
		return images
	}

