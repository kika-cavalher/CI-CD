@echo off
setlocal EnableExtensions EnableDelayedExpansion

set "CTX_FILE=D:\Projects\eMatchStarters\run-context.properties"
set "LOG_DIR=D:\Projects\eMatchStarters\logs"

if not exist "%LOG_DIR%" (
  mkdir "%LOG_DIR%" >nul 2>&1
)

set "STAMP=%DATE:~6,4%%DATE:~3,2%%DATE:~0,2%_%TIME:~0,2%%TIME:~3,2%%TIME:~6,2%"
set "STAMP=%STAMP: =0%"
set "LOG_FILE=%LOG_DIR%\RunEMatchDesktop_task_%STAMP%.log"

echo ============================================================>> "%LOG_FILE%"
echo [INFO] START RunEMatchDesktop                              >> "%LOG_FILE%"
echo [INFO] CTX_FILE=%CTX_FILE%                                 >> "%LOG_FILE%"
echo ============================================================>> "%LOG_FILE%"

if not exist "%CTX_FILE%" (
  echo [ERROR] CTX_FILE not found: %CTX_FILE%                   >> "%LOG_FILE%"
  exit /b 2
)

for /f "usebackq tokens=1,* delims==" %%A in ("%CTX_FILE%") do (
  set "K=%%A"
  set "V=%%B"
  if not "!K!"=="" (
    set "!K!=!V!"
  )
)

if "%WORKSPACE%"=="" (
  echo [ERROR] WORKSPACE is empty                               >> "%LOG_FILE%"
  exit /b 3
)

if "%KATALON_EXE%"=="" (
  echo [ERROR] KATALON_EXE is empty                              >> "%LOG_FILE%"
  exit /b 4
)

if "%PROJECT_FILE%"=="" (
  echo [ERROR] PROJECT_FILE is empty                             >> "%LOG_FILE%"
  exit /b 5
)

if "%COLLECTION_PATH%"=="" (
  echo [ERROR] COLLECTION_PATH is empty                           >> "%LOG_FILE%"
  exit /b 6
)

set "PROJECT_PATH=%WORKSPACE%\%PROJECT_FILE%"
set "REPORTS_DIR=%WORKSPACE%\Reports"
set "MARKER=%REPORTS_DIR%\__jenkins_task_exitcode.txt"

if not exist "%REPORTS_DIR%" (
  mkdir "%REPORTS_DIR%" >nul 2>&1
)

del /f /q "%MARKER%" >nul 2>&1

echo [INFO] WORKSPACE=%WORKSPACE%                                >> "%LOG_FILE%"
echo [INFO] PROJECT_PATH=%PROJECT_PATH%                          >> "%LOG_FILE%"
echo [INFO] KATALON_EXE=%KATALON_EXE%                            >> "%LOG_FILE%"
echo [INFO] COLLECTION_PATH=%COLLECTION_PATH%                    >> "%LOG_FILE%"
echo [INFO] BROWSER_TYPE=%BROWSER_TYPE%                          >> "%LOG_FILE%"
echo [INFO] RETRY=%RETRY%                                        >> "%LOG_FILE%"
echo [INFO] REPORTS_DIR=%REPORTS_DIR%                            >> "%LOG_FILE%"
echo [INFO] MARKER=%MARKER%                                      >> "%LOG_FILE%"

pushd "%WORKSPACE%"

echo [INFO] Running Katalon...                                   >> "%LOG_FILE%"
"%KATALON_EXE%" -noSplash -runMode=console -consoleLog ^
  -projectPath="%PROJECT_PATH%" ^
  -retry=%RETRY% ^
  -testSuiteCollectionPath="%COLLECTION_PATH%" ^
  -browserType="%BROWSER_TYPE%" ^
  -reportFolder="%REPORTS_DIR%" ^
  1>> "%LOG_FILE%" 2>&1

set "EC=%ERRORLEVEL%"

popd

echo [INFO] ExitCode=%EC%                                        >> "%LOG_FILE%"
echo %EC%> "%MARKER%"

echo ============================================================>> "%LOG_FILE%"
echo [INFO] END RunEMatchDesktop                                 >> "%LOG_FILE%"
echo ============================================================>> "%LOG_FILE%"

exit /b %EC%








def deleteIfExists(String path) {
  bat """@echo off
if exist "${path}" del /f /q "${path}"
exit /b 0
"""
}

def writeRunContextFile(String targetFile, Map ctx) {
  def lines = []
  ctx.each { k, v ->
    lines << "${k}=${v}".toString()
  }

  // CRLF garantido
  def content = lines.join("\r\n") + "\r\n"

  echo "Writing run-context.properties to: ${targetFile}"

  // Jenkins writeFile é o mais estável aqui (evita PS escaping e evita arquivo “1 linha”)
  writeFile file: targetFile, text: content, encoding: 'ASCII'
}

def runScheduledTaskAndWaitMarker(String taskName, String markerPath, int timeoutMinutes) {
  echo "Running Task Scheduler: ${taskName}"

  bat """@echo off
schtasks /run /tn "${taskName}"
if errorlevel 1 exit /b 1
"""

  timeout(time: timeoutMinutes, unit: 'MINUTES') {
    echo "Waiting marker file: ${markerPath}"
    while (true) {
      if (fileExists(markerPath)) break
      sleep time: 3, unit: 'SECONDS'
    }
  }

  def ecText = readFile(markerPath).trim()
  int ec = 1
  try { ec = Integer.parseInt(ecText) } catch (ignored) { ec = 1 }

  echo "Desktop task finished. ExitCode=${ec}"
  return ec
}

return this







pipeline {
  agent { label 'GI5_SWDCFRNXGI55817' }

  options {
    timestamps()
    ansiColor('xterm')
    disableConcurrentBuilds()
    timeout(time: 4, unit: 'HOURS')
  }

  stages {
    stage('Prepare Context') {
      steps {
        script {
          def runner = load 'jenkinsIntegration/JenkinsDesktopPipelineRunner.groovy'

          def CONFIG = [
            CTX_FILE        : 'D:\\Projects\\eMatchStarters\\run-context.properties',
            TASK_NAME       : '\\eMatch Automation\\RunEMatchDesktop',
            PROJECT_FILE    : 'eMatch POC.prj',
            KATALON_EXE      : 'C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0\\katalonc.exe',
            COLLECTION_PATH : 'Test Suites/Archive Mode/Archive Mode Collection',
            BROWSER_TYPE    : 'Windows',
            RETRY           : '0'
          ]

          def marker = "${env.WORKSPACE}\\Reports\\__jenkins_task_exitcode.txt"

          runner.deleteIfExists(marker)

          runner.writeRunContextFile(CONFIG.CTX_FILE, [
            WORKSPACE        : env.WORKSPACE,
            PROJECT_FILE     : CONFIG.PROJECT_FILE,
            KATALON_EXE       : CONFIG.KATALON_EXE,
            COLLECTION_PATH  : CONFIG.COLLECTION_PATH,
            BROWSER_TYPE     : CONFIG.BROWSER_TYPE,
            RETRY            : CONFIG.RETRY
          ])

          env.DESKTOP_TASK_NAME = CONFIG.TASK_NAME
          env.DESKTOP_MARKER    = marker
        }
      }
    }

    stage('Run Desktop') {
      steps {
        script {
          def runner = load 'jenkinsIntegration/JenkinsDesktopPipelineRunner.groovy'
          int ec = runner.runScheduledTaskAndWaitMarker(env.DESKTOP_TASK_NAME, env.DESKTOP_MARKER, 180)
          if (ec != 0) {
            error("Desktop execution failed. ExitCode=${ec}")
          }
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'Reports/**', allowEmptyArchive: true
    }
  }
}









