class authentication {

    private static final String DEFAULT_EMATCH_LNK_PATH =
        'D:\\RunAseMatchReq\\eMatch.lnk'

    private static final String DEFAULT_EMATCH_APPLICATION_PATH =
        '\\\\cib.net\\shareparis\\Soft\\ematch\\IHM\\Livraisons\\REC\\IXIS.Ematch.IHM.application'

    private static final String DEFAULT_WINAPPDRIVER_EXE =
        'C:\\Program Files (x86)\\Windows Application Driver\\WinAppDriver.exe'

    private static final String DEFAULT_RESOLUTION_SCRIPT_PATH =
        'D:\\setResolution.ps1'

    private static final int WINDOW_ATTACH_TIMEOUT_SEC = 60
    private static final int WINDOW_ATTACH_RETRY_SEC = 2
    private static final int AFTER_ENV_DROPDOWN_DELAY_SEC = 20
    private static final int AFTER_ENV_SELECTION_DELAY_SEC = 7
    private static final int MAIN_SCREEN_TIMEOUT_SEC = 60
    private static final int AFTER_MAIN_SCREEN_DELAY_SEC = 10
    private static final int AFTER_HOME_CLICK_DELAY_SEC = 5
    private static final int STARTUP_WINDOW_WAIT_SEC = 20
    private static final int WINAPPDRIVER_WAIT_SEC = 15

    @Keyword
    String getCurrentWindowsUser() {
        return System.getProperty('user.name') ?: ''
    }

    @Keyword
    String getShortcutPath() {
        String byGlobal = firstNonBlank(
            gv('EMATCH_LNK_PATH'),
            gv('ematchLnkPath'),
            gv('shortcutPath')
        )

        return firstNonBlank(byGlobal, DEFAULT_EMATCH_LNK_PATH)
    }

    @Keyword
    String getApplicationPath() {
        String byGlobal = firstNonBlank(
            gv('EMATCH_APPLICATION_PATH'),
            gv('ematchApplicationPath'),
            gv('applicationPath')
        )

        return firstNonBlank(byGlobal, DEFAULT_EMATCH_APPLICATION_PATH)
    }

    @Keyword
    String getWinAppDriverPath() {
        String byEnv = safe(System.getenv('WINAPPDRIVER_EXE'))
        String byGlobal = firstNonBlank(
            gv('WINAPPDRIVER_EXE'),
            gv('winAppDriverPath'),
            gv('WinAppDriverPath')
        )

        return firstNonBlank(byEnv, byGlobal, DEFAULT_WINAPPDRIVER_EXE)
    }

    @Keyword
    String getResolutionScriptPath() {
        String byGlobal = firstNonBlank(
            gv('RESOLUTION_SCRIPT_PATH'),
            gv('resolutionScriptPath')
        )

        return firstNonBlank(byGlobal, DEFAULT_RESOLUTION_SCRIPT_PATH)
    }

    @Keyword
    String resolveWindowTitle() {
        String version = safe(GlobalVariable.version)
        String versionProd = safe(GlobalVariable.versionProd)

        if (version) {
            return version
        }

        if (versionProd) {
            return versionProd
        }

        KeywordUtil.markFailedAndStop(
            'GlobalVariable.version and GlobalVariable.versionProd are both empty.'
        )
        return ''
    }

    @Keyword
    void runResolutionScriptIfAvailable() {
        try {
            String scriptPath = getResolutionScriptPath()
            File resolutionScript = new File(scriptPath)

            if (!resolutionScript.exists()) {
                KeywordUtil.logInfo("Resolution script not found. Skipping: ${scriptPath}")
                return
            }

            String cmd = "Powershell.exe -executionpolicy remotesigned -File \"${scriptPath}\""
            Runtime.getRuntime().exec(cmd)
            KeywordUtil.logInfo("Resolution script executed: ${scriptPath}")
        } catch (Exception e) {
            KeywordUtil.logInfo("Resolution script failed but flow will continue: ${e.getMessage()}")
        }
    }

    @Keyword
    void startEmatch(String currentUser, String targetWindowTitle) {
        String shortcutPath = getShortcutPath()
        String applicationPath = getApplicationPath()
        String winAppDriverPath = getWinAppDriverPath()

        KeywordUtil.logInfo('========================================')
        KeywordUtil.logInfo('eMatch startup context')
        KeywordUtil.logInfo("Windows user    : ${safe(currentUser)}")
        KeywordUtil.logInfo("Global username : ${safe(GlobalVariable.username)}")
        KeywordUtil.logInfo("Window title    : ${safe(targetWindowTitle)}")
        KeywordUtil.logInfo("Shortcut path   : ${safe(shortcutPath)}")
        KeywordUtil.logInfo("Application path: ${safe(applicationPath)}")
        KeywordUtil.logInfo("WinAppDriver    : ${safe(winAppDriverPath)}")
        KeywordUtil.logInfo('========================================')

        runResolutionScriptIfAvailable()

        String shortcutError = ''
        String appError = ''

        try {
            if (new File(shortcutPath).exists()) {
                KeywordUtil.logInfo('Trying shortcut flow first.')
                Windows.startApplicationWithTitle(shortcutPath, targetWindowTitle)
                Windows.delay(5)

                if (waitUntilWindowExists(targetWindowTitle, STARTUP_WINDOW_WAIT_SEC)) {
                    KeywordUtil.logInfo('eMatch started successfully using shortcut flow.')
                    return
                }

                shortcutError = "Shortcut flow did not expose window '${targetWindowTitle}' within ${STARTUP_WINDOW_WAIT_SEC} seconds."
                KeywordUtil.logInfo(shortcutError)
            } else {
                shortcutError = "Shortcut file not found: ${shortcutPath}"
                KeywordUtil.logInfo(shortcutError)
            }
        } catch (Exception e) {
            shortcutError = "Shortcut flow failed: ${e.getClass().getName()} - ${e.getMessage()}"
            KeywordUtil.logInfo(shortcutError)
        }

        try {
            KeywordUtil.logInfo('Trying WinAppDriver/application flow.')
            ensureWinAppDriverRunning(winAppDriverPath)
            Windows.startApplication(applicationPath)
            Windows.delay(5)

            if (waitUntilWindowExists(targetWindowTitle, STARTUP_WINDOW_WAIT_SEC)) {
                KeywordUtil.logInfo('eMatch started successfully using WinAppDriver/application flow.')
                return
            }

            appError = "Application flow did not expose window '${targetWindowTitle}' within ${STARTUP_WINDOW_WAIT_SEC} seconds."
            KeywordUtil.logInfo(appError)
        } catch (Exception e) {
            appError = "Application flow failed: ${e.getClass().getName()} - ${e.getMessage()}"
            KeywordUtil.logInfo(appError)
        }

        KeywordUtil.markFailedAndStop(
            "Failed to start eMatch. Shortcut flow: ${shortcutError} | Application flow: ${appError}"
        )
    }

    @Keyword
    void attachToLoginWindow(String targetWindowTitle) {
        WindowsTestObject targetWindow = new WindowsTestObject()
        targetWindow.setLocatorStrategy(LocatorStrategy.NAME)
        targetWindow.setLocator(targetWindowTitle)

        int elapsedTime = 0
        boolean windowFound = false

        while (elapsedTime < WINDOW_ATTACH_TIMEOUT_SEC) {
            try {
                Windows.switchToDesktop()
                Windows.switchToWindow(targetWindow)
                windowFound = true
                KeywordUtil.logInfo("Attached to target window: ${targetWindowTitle}")
                break
            } catch (Exception e) {
                Windows.delay(WINDOW_ATTACH_RETRY_SEC)
                elapsedTime += WINDOW_ATTACH_RETRY_SEC
            }
        }

        if (!windowFound) {
            KeywordUtil.markFailedAndStop(
                "Target window '${targetWindowTitle}' could not be found within ${WINDOW_ATTACH_TIMEOUT_SEC} seconds."
            )
        }
    }

    @Keyword
    void openEnvironmentDropdown() {
        WinRetry.clickWithRetry('Login Page/optEnv', 3, 10)
        Windows.delay(AFTER_ENV_DROPDOWN_DELAY_SEC)
    }

    @Keyword
    int resolveEnvironmentIndex(String environment) {
        int env = 3

        switch (safe(environment)) {
            case 'PROD':
                env = 1
                break
            case 'PREX':
                env = 2
                break
            case 'REC2':
                env = 3
                break
            case 'REC':
                env = 4
                break
            case 'DEV2':
                env = 5
                break
            case 'DEV':
                env = 6
                break
        }

        return env
    }

    @Keyword
    void selectEnvironment(String environment) {
        int env = resolveEnvironmentIndex(environment)

        for (int i = 0; i < env; i++) {
            Windows.sendKeys(findWindowsObject('Login Page/optEnv'), Keys.chord(Keys.ARROW_DOWN))
        }

        Windows.sendKeys(findWindowsObject('Login Page/optEnv'), Keys.chord(Keys.ENTER))
        Windows.delay(AFTER_ENV_SELECTION_DELAY_SEC)
    }

    @Keyword
    boolean isConnectButtonPresent() {
        return Windows.verifyElementPresent(
            findWindowsObject('Login Page/btnConnecter'),
            1,
            FailureHandling.OPTIONAL
        )
    }

    @Keyword
    void clickConnectButton() {
        Windows.click(findWindowsObject('Login Page/btnConnecter'))
    }

    @Keyword
    boolean waitForMainScreen() {
        try {
            boolean loaded = Windows.waitForElementPresent(
                findWindowsObject('General/txtSearch'),
                MAIN_SCREEN_TIMEOUT_SEC,
                FailureHandling.OPTIONAL
            )

            if (loaded) {
                Windows.delay(AFTER_MAIN_SCREEN_DELAY_SEC)
            }

            return loaded
        } catch (Exception e) {
            return false
        }
    }

    @Keyword
    void activateHomeTab() {
        String home = new File(RunConfiguration.getProjectDir(), 'Images/General/Home.PNG').getAbsolutePath()
        String homeGrey = new File(RunConfiguration.getProjectDir(), 'Images/General/HomeGrey.PNG').getAbsolutePath()
        String homeWhite = new File(RunConfiguration.getProjectDir(), 'Images/General/HomeWhite.PNG').getAbsolutePath()

        try {
            if (new File(home).exists()) {
                WindowsImageKeywords.clickImage(home)
                Windows.delay(AFTER_HOME_CLICK_DELAY_SEC)
                return
            }
        } catch (Exception ignored) {
        }

        try {
            if (new File(homeGrey).exists()) {
                def activeTab = WindowsImageKeywords.findImage(homeGrey)
                if (activeTab != null) {
                    return
                }
            }
        } catch (Exception ignored) {
        }

        try {
            if (new File(homeWhite).exists()) {
                def inactiveTab = WindowsImageKeywords.findImage(homeWhite)
                if (inactiveTab != null) {
                    Windows.click(inactiveTab)
                    Windows.delay(AFTER_HOME_CLICK_DELAY_SEC)
                    return
                }
            }
        } catch (Exception ignored) {
        }
    }

    private boolean waitUntilWindowExists(String targetWindowTitle, int timeoutSec) {
        WindowsTestObject targetWindow = new WindowsTestObject()
        targetWindow.setLocatorStrategy(LocatorStrategy.NAME)
        targetWindow.setLocator(targetWindowTitle)

        int elapsed = 0

        while (elapsed < timeoutSec) {
            try {
                Windows.switchToDesktop()
                Windows.switchToWindow(targetWindow)
                return true
            } catch (Exception ignored) {
                Windows.delay(1)
                elapsed++
            }
        }

        return false
    }

    private void ensureWinAppDriverRunning(String exePath) {
        if (isWinAppDriverListening()) {
            KeywordUtil.logInfo('WinAppDriver already listening on 127.0.0.1:4723.')
            return
        }

        File exe = new File(exePath)
        if (!exe.exists()) {
            KeywordUtil.markFailedAndStop("WinAppDriver.exe was not found at: ${exePath}")
        }

        KeywordUtil.logInfo("Starting WinAppDriver from: ${exePath}")
        new ProcessBuilder(exePath).inheritIO().start()

        int waited = 0
        while (waited < WINAPPDRIVER_WAIT_SEC) {
            if (isWinAppDriverListening()) {
                KeywordUtil.logInfo('WinAppDriver started successfully.')
                return
            }

            Windows.delay(1)
            waited++
        }

        KeywordUtil.markFailedAndStop(
            "Failed to start WinAppDriver. It did not start listening within ${WINAPPDRIVER_WAIT_SEC} seconds."
        )
    }

    private boolean isWinAppDriverListening() {
        Socket socket = null

        try {
            socket = new Socket()
            socket.connect(new InetSocketAddress('127.0.0.1', 4723), 1000)
            return true
        } catch (Exception ignored) {
            return false
        } finally {
            try {
                socket?.close()
            } catch (Exception ignored) {
            }
        }
    }

    private String gv(String name) {
        try {
            def value = GlobalVariable."${name}"
            return safe(value)
        } catch (Throwable ignored) {
            return ''
        }
    }

    private String firstNonBlank(String... values) {
        for (String value : values) {
            if (safe(value)) {
                return safe(value)
            }
        }
        return ''
    }

    private String safe(Object value) {
        return value == null ? '' : String.valueOf(value).trim()
    }
}
