	String getShortErrorLog(String stackTrace) {
		if (isBlank(stackTrace)) {
			return ''
		}

		List<String> lines = stackTrace
			.readLines()
			.findAll { !isBlank(it) }
			.collect { it.trim() }

		List<String> important = []

		for (String line : lines) {
			String lower = line.toLowerCase()

			if (
				lower.contains('exception')
				|| lower.contains('error')
				|| lower.contains('caused by')
				|| lower.contains('stepfailedexception')
				|| lower.contains('unable')
				|| lower.contains('not found')
				|| lower.contains('not clickable')
				|| lower.contains('timed out')
			) {
				important.add(line)
			}

			if (important.size() >= 3) {
				break
			}
		}

		if (important.isEmpty()) {
			important = lines.take(3)
		}

		return important.join('\n')
	}

	String buildFailureCard(Map item) {
		String fullStack = item.stackTrace as String
		String shortStack = getShortErrorLog(fullStack)

		StringBuilder html = new StringBuilder()

		html.append('<div class="case failed">')
		html.append('<div class="case-title">')
		html.append(safeHtml((item.className ?: '') + '/' + (item.testName ?: '')))
		html.append('</div>')

		html.append('<div class="case-line">❗ Mandatory failure</div>')

		if (!isBlank(item.failureMessage as String)) {
			html.append('<div class="case-line">')
			html.append(safeHtml(item.failureMessage as String))
			html.append('</div>')
		}

		if (!isBlank(shortStack)) {
			html.append('<pre class="case-short-log">')
			html.append(safeHtml(shortStack))
			html.append('</pre>')
		}

		html.append('<div class="case-line case-duration">Duration: ')
		html.append(safeHtml(formatDurationSeconds(item.timeSeconds as BigDecimal)))
		html.append('</div>')

		html.append('<details class="case-details">')
		html.append('<summary>See full error log</summary>')
		html.append('<pre class="case-full-log">')
		html.append(safeHtml(fullStack))
		html.append('</pre>')
		html.append('</details>')

		if (!isBlank(item.imageData as String)) {
			html.append('<div class="case-image-wrap">')
			html.append('<img class="case-image" src="')
			html.append(item.imageData as String)
			html.append('" alt="Failure evidence"/>')
			html.append('</div>')
		}

		html.append('</div>')

		return html.toString()
	}

