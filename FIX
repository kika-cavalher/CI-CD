function Clean-Text {
    param([string]$Value)

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return ''
    }

    return (($Value -replace '[\\r\\n]+', ' ') -replace '\\s+', ' ').Trim()
}

function Short-Text {
    param(
        [string]$Value,
        [int]$Max = 180
    )

    $text = Clean-Text $Value

    if ($text.Length -gt $Max) {
        return $text.Substring(0, $Max - 3) + '...'
    }

