					'Open-file modal is still visible after TAB and ENTER.'
					)
		}

		KeywordUtil.logInfo(
				'Open-file modal closed successfully.'
				)
	}

	private void validateExportedExcelFileHasRowsAndValues(
			File exportedFile
	) {
		if (exportedFile == null ||
				!exportedFile.exists() ||
				!exportedFile.isFile()) {
			KeywordUtil.markFailedAndStop(
					'Exported file does not exist for validation.\n' +
					'Path: ' +
					(exportedFile == null ?
					'null' :
					exportedFile.getAbsolutePath())
					)
		}

		if (exportedFile.length() <= 0) {
			KeywordUtil.markFailedAndStop(
					'Exported file is empty.\n' +
					'Path: ' +
					exportedFile.getAbsolutePath()
					)
		}

		Workbook workbook = null

		try {
			workbook = WorkbookFactory.create(
					exportedFile
					)

			if (workbook.getNumberOfSheets() <= 0) {
				KeywordUtil.markFailedAndStop(
						'Exported Excel file has no sheets.\n' +
						'Path: ' +
						exportedFile.getAbsolutePath()
						)
			}

			Sheet sheet = workbook.getSheetAt(0)

			FormulaEvaluator evaluator =
					workbook
					.getCreationHelper()
					.createFormulaEvaluator()

			DataFormatter formatter =
					new DataFormatter()

			int nonEmptyRows = 0
			int nonEmptyCells = 0

			for (int rowIndex = 0;
					rowIndex <= sheet.getLastRowNum();
					rowIndex++) {
				Row row = sheet.getRow(
						rowIndex
						)

				if (row == null) {
					continue
				}

				boolean rowHasValue = false
				int lastCellNumber = row.getLastCellNum()

				if (lastCellNumber < 0) {
					continue
				}

				for (int cellIndex = 0;
						cellIndex < lastCellNumber;
						cellIndex++) {
					Cell cell = row.getCell(
							cellIndex
							)

					if (cell == null) {
						continue
					}

					String value =
							formatter.formatCellValue(
							cell,
							evaluator
							)

					if (value != null &&
							!value.trim().isEmpty()) {
						nonEmptyCells =
								nonEmptyCells + 1

						rowHasValue = true
					}
				}

				if (rowHasValue) {
					nonEmptyRows =
							nonEmptyRows + 1
				}
			}

			KeywordUtil.logInfo(
					'Exported Excel validation result.\n' +
					'File: ' + exportedFile.getName() + '\n' +
					'Non-empty rows: ' + nonEmptyRows + '\n' +
					'Non-empty cells: ' + nonEmptyCells
					)

			if (nonEmptyRows <= 1) {
				KeywordUtil.markFailedAndStop(
						'Exported Excel file does not have enough rows with values.\n' +
						'File: ' + exportedFile.getName() + '\n' +
						'Non-empty rows: ' + nonEmptyRows
						)
			}

			if (nonEmptyCells <= 0) {
				KeywordUtil.markFailedAndStop(
						'Exported Excel file does not have values.\n' +
						'File: ' + exportedFile.getName()
						)
			}
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop(
					'Could not validate exported Excel file.\n' +
					'File: ' + exportedFile.getName() + '\n' +
					'Reason: ' + e.getMessage()
					)
		} finally {
			try {
				if (workbook != null) {
					workbook.close()
				}
			} catch (Exception ignored) {
			}
		}
	}

	private String buildAutomaticExportFileName(
			String environment,
			String featureName,
			String exportLabelSuffix
	) {
		String timestamp = new SimpleDateFormat(
				'yyyyMMdd_HHmmss'
				).format(
				new Date()
				)

		String safeEnvironment = shortenFilePart(
				sanitizeFileName(
				environment == null ||
				environment.trim().isEmpty() ?
				'REC' :
				environment
				),
				6
				)

		String safeFeatureName = shortenFilePart(
				sanitizeFileName(
				featureName == null ||
				featureName.trim().isEmpty() ?
				'Export' :
				featureName
				),
				MAX_FEATURE_LENGTH
				)

		String safeExportLabelSuffix = shortenFilePart(
				sanitizeFileName(
				exportLabelSuffix == null ?
				'' :
				exportLabelSuffix
				),
				MAX_LABEL_LENGTH
				)

		String baseFileName =
				safeEnvironment +
				'_' +
				timestamp +
				'_' +
				safeFeatureName

		if (safeExportLabelSuffix != null &&
				!safeExportLabelSuffix.trim().isEmpty() &&
				safeExportLabelSuffix != 'Export') {
			baseFileName =
					baseFileName +
					'_' +
					safeExportLabelSuffix
		}

		return baseFileName + '.xlsx'
	}

	private String resolveExportLabelSuffixForFileName(
			String exportLabel
	) {
		if (exportLabel == null ||
				exportLabel.trim().isEmpty()) {
			return ''
		}

		String value = sanitizeFileName(
				exportLabel
				)

		value = value.replaceFirst(
				'(?i)^REC_',
				''
				)

		value = value.replaceFirst(
				'(?i)^PRD_',
				''
				)

		value = value.replaceFirst(
				'(?i)^REC-',
				''
				)

		value = value.replaceFirst(
				'(?i)^PRD-',
				''
				)

		value = value.replaceFirst(
				'(?i)^REC ',
				''
				)

		value = value.replaceFirst(
				'(?i)^PRD ',
				''
				)

		if (value == null ||
				value.trim().isEmpty()) {
			return ''
		}

		return value
	}

	private String resolveEnvironmentName(
			String targetEnvironment,
			String exportLabel
	) {
		String environmentFromParameter =
				normalizeEnvironmentNameStrict(
				targetEnvironment
				)

		if (environmentFromParameter != null) {
			KeywordUtil.logInfo(
					'Environment resolved from targetEnvironment parameter: ' +
					environmentFromParameter
					)

			return environmentFromParameter
		}

		List<String> globalVariableNames = [
			'targetEnvironment',
			'currentEnvironment',
			'environment',
			'env',
			'ENV',
			'currentEnv',
			'environmentName'
		]

		for (String variableName : globalVariableNames) {
			String globalValue =
					getGlobalVariableValue(
					variableName
					)

			String normalizedValue =
					normalizeEnvironmentNameStrict(
					globalValue
					)

			if (normalizedValue != null) {
				KeywordUtil.logInfo(
						'Environment resolved from GlobalVariable.' +
						variableName +
						': ' +
						normalizedValue
						)

				return normalizedValue
			}
		}

		String environmentFromProfile =
				normalizeEnvironmentNameStrict(
				RunConfiguration.getExecutionProfile()
				)

		if (environmentFromProfile != null) {
			KeywordUtil.logInfo(
					'Environment resolved from execution profile: ' +
					environmentFromProfile
					)

			return environmentFromProfile
		}

		String environmentFromVisibleScreen =
				getEnvironmentFromVisibleScreen()

		if (environmentFromVisibleScreen != null) {
			KeywordUtil.logInfo(
					'Environment resolved from visible screen: ' +
					environmentFromVisibleScreen
					)

			return environmentFromVisibleScreen
		}

		String environmentFromLabel =
				normalizeEnvironmentNamePrefixOnly(
				exportLabel
				)

		if (environmentFromLabel != null) {
			KeywordUtil.logInfo(
					'Environment resolved from export label prefix: ' +
					environmentFromLabel
					)

			return environmentFromLabel
		}

		KeywordUtil.logInfo(
				'Environment not resolved. Defaulting to REC.'
				)

		return 'REC'
	}

	private String normalizeEnvironmentNameStrict(
			String rawEnvironment
	) {
		if (rawEnvironment == null ||
				rawEnvironment.trim().isEmpty()) {
			return null
		}

		String value =
				rawEnvironment
				.trim()
				.toUpperCase()

		if (value == 'PRD' ||
				value == 'PROD' ||
				value == 'PRODUCTION') {
			return 'PRD'
		}

		if (value == 'REC' ||
				value == 'RECETTE') {
			return 'REC'
		}

		if (value.startsWith('PRD_') ||
				value.startsWith('PRD-') ||
				value.startsWith('PRD ')) {
			return 'PRD'
		}

		if (value.startsWith('REC_') ||
				value.startsWith('REC-') ||
				value.startsWith('REC ')) {
			return 'REC'
		}

		return null
	}

	private String normalizeEnvironmentNamePrefixOnly(
			String rawEnvironment
	) {
		if (rawEnvironment == null ||
				rawEnvironment.trim().isEmpty()) {
			return null
		}

		String value =
				rawEnvironment
				.trim()
				.toUpperCase()

		if (value == 'PRD' ||
				value.startsWith('PRD_') ||
				value.startsWith('PRD-') ||
				value.startsWith('PRD ')) {
			return 'PRD'
		}

		if (value == 'REC' ||
				value.startsWith('REC_') ||
				value.startsWith('REC-') ||
				value.startsWith('REC ')) {
			return 'REC'
		}

		return null
	}

	private String getEnvironmentFromVisibleScreen() {
		if (isAnyTextVisibleOnCurrentWindow(
				[
					'PROD',
					'PRODUCTION',
					'PRD'
				]
				)) {
			return 'PRD'
		}

		if (isAnyTextVisibleOnCurrentWindow(
