	Document parseXmlFile(String xmlPath) {
		DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance()
		factory.setNamespaceAware(false)
		factory.setIgnoringComments(true)
		factory.setIgnoringElementContentWhitespace(true)
		return factory.newDocumentBuilder().parse(new File(xmlPath))
	}

	Element findFirstChildElement(Element parent, List<String> names) {
		NodeList children = parent.getChildNodes()
		for (int i = 0; i < children.getLength(); i++) {
			Node node = children.item(i)
			if (node instanceof Element) {
				String nodeName = safe(node.getNodeName())
				if (names.any { it.equalsIgnoreCase(nodeName) }) {
					return (Element) node
				}
			}
		}
		return null
	}

	String getXmlFilePath() {
		String reportPath = getReportPath()
		if (isBlank(reportPath)) return ''

		File folder = new File(reportPath)
		if (!folder.exists()) return ''

		String found = ''

		folder.eachFileRecurse(FileType.FILES) { File file ->
			if (!isBlank(found)) return
			if (file.name.equalsIgnoreCase(PRIMARY_XML_FILE_NAME) || file.name.equalsIgnoreCase(SECONDARY_XML_FILE_NAME)) {
				found = file.absolutePath
			}
		}

		return found
	}

	List<File> getFailureEvidenceImages() {
		String reportPath = getReportPath()
		if (isBlank(reportPath)) return []

		File folder = new File(reportPath)
		if (!folder.exists()) return []

		List<File> images = []

		folder.eachFileRecurse(FileType.FILES) { File file ->
			String lower = file.name.toLowerCase()
			if (lower.endsWith('.png') || lower.endsWith('.jpg') || lower.endsWith('.jpeg')) {
				if (!lower.contains('navbar') && !lower.contains('homepage') && !lower.contains('logo')) {
					images.add(file)
				}
			}
		}

		images.sort { a, b -> a.lastModified() <=> b.lastModified() }
		return images
	}

	String fileToBase64DataUri(File file) {
		if (file == null || !file.exists()) return ''

		String mime = 'image/png'
		String lower = file.name.toLowerCase()
		if (lower.endsWith('.jpg') || lower.endsWith('.jpeg')) {
			mime = 'image/jpeg'
		}

		byte[] bytes = Files.readAllBytes(file.toPath())
		String base64 = bytes.encodeBase64().toString()
		return "data:${mime};base64,${base64}"
	}

	String getShortErrorLog(String stackTrace, String failureMessage, String testName) {
		List<String> selected = []

		if (!isBlank(failureMessage)) {
			selected.add(failureMessage.trim())
		}

		if (!isBlank(testName)) {
			selected.add(testName.trim())
		}

		if (!isBlank(stackTrace)) {
			List<String> lines = stackTrace.readLines()
				.collect { it?.trim() }
				.findAll { !isBlank(it) }

			for (String line : lines) {
				String lower = line.toLowerCase()
				if (
					lower.contains('exception')
					|| lower.contains('error')
					|| lower.contains('caused by')
					|| lower.contains('timed out')
					|| lower.contains('not found')
					|| lower.contains('not clickable')
					|| lower.contains('unable')
					|| lower.contains('line ')
				) {
					if (!selected.contains(line)) {
						selected.add(line)
					}
				}
				if (selected.size() >= 3) break
			}
		}

		if (selected.isEmpty() && !isBlank(stackTrace)) {
			selected.addAll(stackTrace.readLines().collect { it?.trim() }.findAll { !isBlank(it) }.take(3))
		}

		return selected.take(3).join('\n')
	}

	Map parseSuiteData(String xmlPath) {
		Document doc = parseXmlFile(xmlPath)
		doc.getDocumentElement().normalize()

		NodeList testcases = doc.getElementsByTagName('testcase')

		BigDecimal totalTime = 0
		int executed = 0
		int failed = 0
		int skipped = 0

		List<Map> failedTests = []
		List<Map> passedTests = []

		List<File> evidenceImages = getFailureEvidenceImages()
		int evidenceIndex = 0

		for (int i = 0; i < testcases.getLength(); i++) {
			Element tc = (Element) testcases.item(i)

			executed++

			String className = safe(tc.getAttribute('classname'))
			String testName = safe(tc.getAttribute('name'))

			BigDecimal timeSeconds = 0
			try {
				timeSeconds = new BigDecimal(safe(tc.getAttribute('time')))
			} catch (Exception ignored) {
				timeSeconds = 0
			}

			totalTime = totalTime + timeSeconds

			Element failureElement = findFirstChildElement(tc, ['failure', 'error'])
			Element skippedElement = findFirstChildElement(tc, ['skipped'])

			if (skippedElement != null) {
				skipped++
				continue
			}

			if (failureElement != null) {
				failed++

				String failureMessage = safe(failureElement.getAttribute('message'))
				String stackTrace = safe(failureElement.getTextContent())

				File imageFile = null
				if (evidenceIndex < evidenceImages.size()) {
					imageFile = evidenceImages[evidenceIndex]
					evidenceIndex++
				}

				failedTests.add([
					className      : className,
					testName       : testName,
					failureMessage : failureMessage,
					stackTrace     : stackTrace,
					timeSeconds    : timeSeconds,
					imageData      : imageFile != null ? fileToBase64DataUri(imageFile) : '',
					shortLog       : getShortErrorLog(stackTrace, failureMessage, testName)
				])
			} else {
				passedTests.add([
					className    : className,
					testName     : testName,
					timeSeconds  : timeSeconds
				])
			}
		}

		int passed = executed - failed - skipped
		if (passed < 0) passed = 0

		String suiteDisplay = getCurrentSuiteName()
		if (!isBlank(suiteDisplay)) {
			suiteDisplay = 'Test Suites/' + suiteDisplay
		}

		return [
			suiteName   : suiteDisplay,
			startText   : new SimpleDateFormat('EEE MMM dd HH:mm:ss z yyyy').format(new Date()),
			endText     : new SimpleDateFormat('EEE MMM dd HH:mm:ss z yyyy').format(new Date()),
			suiteTime   : totalTime,
			executed    : executed,
			passed      : passed,
			failed      : failed,
			skipped     : skipped,
			failedTests : failedTests,
			passedTests : passedTests
		]
	}

