            dir.exists() &&
            dir.isDirectory() &&
            !isImportReportFolder(dir.absolutePath)
        }

        if (candidates.isEmpty()) {
            return ''
        }

        candidates = candidates.unique { File item -> item.absolutePath }
        candidates.sort { a, b -> b.lastModified() <=> a.lastModified() }

        return safe(candidates[0].absolutePath)
    }

    void collectLeafReportFolders(File currentDir, List<File> candidates) {
        if (currentDir == null || !currentDir.exists() || !currentDir.isDirectory()) {
            return
        }

        if (looksLikeReportLeaf(currentDir)) {
            candidates.add(currentDir)
        }

        File[] children = currentDir.listFiles()
        if (children == null) {
            return
        }

        for (File child : children) {
            if (child != null && child.isDirectory()) {
                collectLeafReportFolders(child, candidates)
            }
        }
    }

    boolean looksLikeReportLeaf(File dir) {
        if (dir == null || !dir.exists() || !dir.isDirectory()) {
            return false
        }

        File[] children = dir.listFiles()
        if (children == null || children.length == 0) {
            return false
        }

        for (File child : children) {
            if (child == null || !child.isFile()) {
                continue
            }

            String lowerName = safe(child.name).toLowerCase(Locale.ENGLISH)

            if (lowerName.startsWith('execution') && lowerName.endsWith('.log')) {
                return true
            }
            if (lowerName == safe(PRIMARY_XML_FILE_NAME).toLowerCase(Locale.ENGLISH)) {
                return true
            }
            if (lowerName == safe(SECONDARY_XML_FILE_NAME).toLowerCase(Locale.ENGLISH)) {
                return true
            }
            if (lowerName == 'report.html') {
                return true
            }
        }

        return false
    }

