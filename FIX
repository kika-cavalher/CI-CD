    private static final Pattern STEP_LINE_PATTERN = Pattern.compile('^(\\d+)\\s*-\\s*(.+?)\\s*\\(([\\d.,]+)s\\)$')
    private static final Pattern EVENT_LINE_PATTERN = Pattern.compile('^(\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{3})?)\\s+([A-Z]+)\\s+(.*)$')
    private static final Pattern PREFIXED_LOG_PATTERN = Pattern.compile('^\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2}\\.\\d{3}\\s+[A-Z]+\\s+.+?\\s+-\\s+(.*)$')

    JiraFlowCoordinator owner
    JiraHtmlTemplateBuilder templateBuilder

    JiraReportBuilder(JiraFlowCoordinator owner) {
        this.owner = owner
        this.templateBuilder = new JiraHtmlTemplateBuilder(owner)
    }

    String createHtmlReport(String reportFolder, String suiteName, String xmlPath, String executionSummary) {
        if (owner.isBlank(reportFolder) || owner.isBlank(xmlPath)) {
            return ''
        }

        File reportDir = new File(reportFolder)
        if (!reportDir.exists() || !reportDir.isDirectory()) {
            return ''
        }

        Map xmlData = parseXmlResults(xmlPath)
        List<Map> scenarios = parseExecutionLog(reportDir)

        if (scenarios.isEmpty()) {
            scenarios = buildFallbackScenarios((xmlData.testCases ?: []) as List<Map>)
        } else {
            enrichScenariosWithXmlData(scenarios, (xmlData.testCases ?: []) as List<Map>)
        }

        attachEvidenceToFailedScenarios(reportDir, scenarios)

        Map model = [
            suiteName       : suiteName,
            executionSummary: executionSummary,
            environment     : owner.ENVIRONMENT,
            projectKey      : owner.PROJECT_KEY,
            generatedAt     : new Date(),
            totals          : buildTotals(scenarios, xmlData),
            scenarios       : scenarios,
            headerColor     : owner.REPORT_HEADER_COLOR,
            accentColor     : owner.REPORT_ACCENT_COLOR,
            backgroundColor : owner.REPORT_BACKGROUND_COLOR
        ]

        String html = templateBuilder.build(model)

        File output = new File(reportDir, owner.CUSTOM_REPORT_FILE_NAME)
        output.setText(html, 'UTF-8')

        return output.absolutePath
    }

    Map parseXmlResults(String xmlPath) {
        List<Map> testCases = new ArrayList<Map>()
        int totalTests = 0
        int totalFailures = 0
        int totalSkipped = 0
        long totalDurationMs = 0L

        File xmlFile = new File(xmlPath)
        if (!xmlFile.exists()) {
            return [
                totals: [tests: 0, failures: 0, passed: 0, skipped: 0, durationMs: 0L, durationLabel: '00h 00m 00s'],
                testCases: testCases
            ]
        }

        Document document = parseXmlDocument(xmlFile)
        if (document == null) {
            return [
                totals: [tests: 0, failures: 0, passed: 0, skipped: 0, durationMs: 0L, durationLabel: '00h 00m 00s'],
                testCases: testCases
            ]
        }

        def nodes = document.getElementsByTagName('testcase')
        for (int i = 0; i < nodes.length; i++) {
            Element testcase = (Element) nodes.item(i)

            String className = safe(testcase.getAttribute('classname'))
            String name = safe(testcase.getAttribute('name'))
            long durationMs = toMillisFromSeconds(testcase.getAttribute('time'))

            Element failureNode = firstChildElement(testcase, 'failure')
            Element errorNode = firstChildElement(testcase, 'error')
            Element skippedNode = firstChildElement(testcase, 'skipped')

            boolean failed = failureNode != null || errorNode != null
            boolean skipped = skippedNode != null

            String failureMessage = ''
            String fullError = ''

            if (failureNode != null) {
                failureMessage = safe(failureNode.getAttribute('message'))
                fullError = safe(failureNode.getTextContent())
            } else if (errorNode != null) {
                failureMessage = safe(errorNode.getAttribute('message'))
                fullError = safe(errorNode.getTextContent())
            } else if (skippedNode != null) {
                failureMessage = safe(skippedNode.getAttribute('message'))
                fullError = safe(skippedNode.getTextContent())
            }

            totalTests++
            if (failed) totalFailures++
            if (skipped) totalSkipped++
            totalDurationMs += durationMs

            testCases.add([
                index         : i + 1,
                name          : buildDisplayName(className, name),
                shortName     : owner.isBlank(name) ? buildDisplayName(className, name) : name,
                className     : className,
                durationMs    : durationMs,
                durationLabel : formatDuration(durationMs),
                status        : skipped ? 'skipped' : (failed ? 'failed' : 'passed'),
                failureMessage: failureMessage,
                fullError     : fullError
            ])
        }

        return [
            totals: [
                tests        : totalTests,
                failures     : totalFailures,
                passed       : Math.max(totalTests - totalFailures - totalSkipped, 0),
                skipped      : totalSkipped,
                durationMs   : totalDurationMs,
                durationLabel: formatDuration(totalDurationMs)
            ],
            testCases: testCases
        ]
    }

    List<Map> parseExecutionLog(File reportDir) {
        File logFile = findExecutionLog(reportDir)
        if (logFile == null || !logFile.exists() || !logFile.isFile()) {
            return []
        }

        List<String> lines = readFileLines(logFile)
        if (lines.isEmpty()) {
            return []
        }

        List<Map> scenarios = new ArrayList<Map>()
        Map currentScenario = null
        String currentCasePath = ''
        long currentCaseDurationMs = 0L

        for (String rawLine : lines) {
            String line = sanitizeLogLine(rawLine)
            if (owner.isBlank(line)) {
                continue
            }

            if (line.startsWith('START Test Suites/') || line.startsWith('END Test Suites/')) {
                continue
            }

            if (line.startsWith('START Test Cases/') || line.startsWith('Test Cases/')) {
                Matcher scenarioMatcher = SCENARIO_LINE_PATTERN.matcher(line.replace('START ', ''))
                if (scenarioMatcher.find()) {
                    if (currentScenario != null) {
                        finalizeScenario(currentScenario)
                        scenarios.add(currentScenario)
                    }

                    currentCasePath = safe(scenarioMatcher.group(1))
                    currentCaseDurationMs = toMillisFromCompactSeconds(scenarioMatcher.group(2))

                    currentScenario = newScenarioMap(currentCasePath)
                    currentScenario.durationMs = currentCaseDurationMs
                    currentScenario.durationLabel = formatDuration(currentCaseDurationMs)
                    continue
                }
            }

            if (line.startsWith('END Test Cases/')) {
                continue
            }

            if (currentScenario == null) {
                continue
            }

            if (line.startsWith('Start / End / Elapsed:')) {
                applyTimingInfo(currentScenario, line)
                continue
            }

            if (line.startsWith('TEST STEP:')) {
                String stepTitle = cleanupStepTitle(extractAfter(line, 'TEST STEP:'))
                if (shouldIgnoreStep(stepTitle)) {
                    continue
                }
                currentScenario.steps.add(newStepMap(stepTitle, 0L))
                continue
            }

            Matcher stepMatcher = STEP_LINE_PATTERN.matcher(line)
            if (stepMatcher.find()) {
                String stepTitle = cleanupStepTitle(stepMatcher.group(2))
                if (shouldIgnoreStep(stepTitle)) {
                    continue
                }

                long stepDuration = toMillisFromCompactSeconds(stepMatcher.group(3))
                currentScenario.steps.add(newStepMap(stepTitle, stepDuration))
                continue
            }

            Matcher eventMatcher = EVENT_LINE_PATTERN.matcher(line)
            if (eventMatcher.find()) {
                String timeLabel = formatClock(eventMatcher.group(1))
                String status = normalizeLogStatus(eventMatcher.group(2))
                String message = safe(eventMatcher.group(3))

                Map targetStep = currentScenario.steps ? currentScenario.steps.last() : null
                if (targetStep != null) {
                    if (owner.isBlank(targetStep.timeLabel)) {
                        targetStep.timeLabel = timeLabel
                    }
                    targetStep.detailText = appendText(targetStep.detailText, message)

                    if ('failed'.equals(status)) {
                        targetStep.status = 'failed'
                        targetStep.errorFull = appendText(targetStep.errorFull, message)
                        if (owner.isBlank(targetStep.shortError)) {
                            targetStep.shortError = shortenError(message)
                        }
                    } else if ('passed'.equals(status) && !'failed'.equals(targetStep.status)) {
                        targetStep.status = 'passed'
                    } else if ('skipped'.equals(status) && !'failed'.equals(targetStep.status)) {
                        targetStep.status = 'skipped'
                    }
                }
                continue
            }

            if (line.startsWith('Reason:') || line.startsWith('Caused by:') || looksLikeErrorLine(line)) {
                Map targetStep = currentScenario.steps ? currentScenario.steps.last() : null
                if (targetStep != null) {
                    targetStep.status = 'failed'
                    targetStep.errorFull = appendText(targetStep.errorFull, line)
                    targetStep.detailText = appendText(targetStep.detailText, line)
                    if (owner.isBlank(targetStep.shortError)) {
                        targetStep.shortError = shortenError(line)
                    }
                } else {
                    currentScenario.errorFull = appendText(currentScenario.errorFull, line)
                    if (owner.isBlank(currentScenario.errorShort)) {
                        currentScenario.errorShort = shortenError(line)
                    }
                    currentScenario.status = 'failed'
                }
                continue
            }
        }

        if (currentScenario != null) {
            finalizeScenario(currentScenario)
            scenarios.add(currentScenario)
        }

        return scenarios
    }

    List<Map> buildFallbackScenarios(List<Map> xmlCases) {
        List<Map> scenarios = new ArrayList<Map>()

        int index = 1
        for (Map xmlCase : xmlCases) {
            Map scenario = newScenarioMap(safe(xmlCase.name))
            scenario.title = safe(xmlCase.name)
            scenario.status = safe(xmlCase.status)
            scenario.durationMs = toLong(xmlCase.durationMs)
            scenario.durationLabel = formatDuration(toLong(xmlCase.durationMs))
            scenario.errorShort = shortenError(xmlCase.failureMessage)
            scenario.errorFull = safe(xmlCase.fullError)

            scenario.steps.add([
                title        : safe(xmlCase.shortName),
                status       : safe(xmlCase.status),
                timeLabel    : '',
                durationMs   : toLong(xmlCase.durationMs),
                durationLabel: formatDuration(toLong(xmlCase.durationMs)),
                detailText   : safe(xmlCase.shortName),
                errorFull    : safe(xmlCase.fullError),
                shortError   : shortenError(xmlCase.failureMessage),
                icon         : resolveStepIcon(safe(xmlCase.shortName), safe(xmlCase.status))
            ])

            finalizeScenario(scenario)
            scenarios.add(scenario)
            index++
        }

        return scenarios
    }

    void enrichScenariosWithXmlData(List<Map> scenarios, List<Map> xmlCases) {
        int max = Math.min(scenarios.size(), xmlCases.size())

        for (int i = 0; i < max; i++) {
            Map scenario = scenarios[i]
            Map xmlCase = xmlCases[i]

            if (toLong(scenario.durationMs) <= 0L) {
                scenario.durationMs = toLong(xmlCase.durationMs)
            }
            scenario.durationLabel = formatDuration(toLong(scenario.durationMs))

            if (owner.isBlank(scenario.errorShort)) {
                scenario.errorShort = shortenError(xmlCase.failureMessage)
            }
            if (owner.isBlank(scenario.errorFull)) {
                scenario.errorFull = safe(xmlCase.fullError)
            }

            if (!scenario.steps.isEmpty()) {
                Map lastStep = scenario.steps.last()
                if ('failed'.equals(scenario.status) || 'failed'.equals(xmlCase.status)) {
                    if (owner.isBlank(lastStep.shortError)) {
                        lastStep.shortError = scenario.errorShort
                    }
                    if (owner.isBlank(lastStep.errorFull)) {
                        lastStep.errorFull = scenario.errorFull
                    }
                    if (!'failed'.equals(lastStep.status)) {
                        lastStep.status = 'failed'
                    }
                }
            } else {
                scenario.steps.add([
                    title        : safe(xmlCase.shortName),
                    status       : safe(xmlCase.status),
                    timeLabel    : '',
                    durationMs   : toLong(xmlCase.durationMs),
                    durationLabel: formatDuration(toLong(xmlCase.durationMs)),
                    detailText   : safe(xmlCase.shortName),
                    errorFull    : safe(xmlCase.fullError),
                    shortError   : shortenError(xmlCase.failureMessage),
                    icon         : resolveStepIcon(safe(xmlCase.shortName), safe(xmlCase.status))
                ])
            }

            finalizeScenario(scenario)
        }
    }

    Map buildTotals(List<Map> scenarios, Map xmlData) {
        int total = scenarios.size()
        int failed = scenarios.count { Map item -> 'failed'.equals(safe(item.status)) }
        int passed = scenarios.count { Map item -> 'passed'.equals(safe(item.status)) }
        int skipped = scenarios.count { Map item -> 'skipped'.equals(safe(item.status)) }

        long durationMs = 0L
        for (Map scenario : scenarios) {
            durationMs += toLong(scenario.durationMs)
        }

        if (total == 0 && xmlData?.totals instanceof Map) {
            return xmlData.totals
        }

        return [
            tests        : total,
            failures     : failed,
            passed       : passed,
            skipped      : skipped,
            durationMs   : durationMs,
            durationLabel: formatDuration(durationMs)
        ]
    }

    void attachEvidenceToFailedScenarios(File reportDir, List<Map> scenarios) {
        List<Map> nativeEvidences = extractEvidenceFromNativeHtml(reportDir)
        if (nativeEvidences.isEmpty()) {
            nativeEvidences = buildEvidenceFromFiles(owner.collectFailureImages(reportDir))
        }

        List<Map> failedScenarios = scenarios.findAll { Map item -> 'failed'.equals(safe(item.status)) }
        if (failedScenarios.isEmpty() || nativeEvidences.isEmpty()) {
            return
        }

        int limit = Math.min(failedScenarios.size(), nativeEvidences.size())
        for (int i = 0; i < limit; i++) {
            failedScenarios[i].evidence = [nativeEvidences[i]]
        }
    }

    List<Map> extractEvidenceFromNativeHtml(File reportDir) {
        File nativeHtml = findNativeKatalonHtmlReport(reportDir)
        if (nativeHtml == null || !nativeHtml.exists()) {
            return []
        }

        String html = ''
        try {
            html = nativeHtml.getText('UTF-8')
        } catch (Exception e) {
            return []
        }

        List<Map> result = new ArrayList<Map>()
        Set<String> seen = new LinkedHashSet<String>()

        Matcher matcher = IMG_TAG_PATTERN.matcher(html)
        int index = 1

        while (matcher.find()) {
            String src = safe(matcher.group(1))
            if (!isUsefulEvidenceSource(src)) {
                continue
            }
            if (!seen.add(src)) {
                continue
            }

            String imgSrc = src
            if (!src.toLowerCase(Locale.ENGLISH).startsWith('data:image')) {
                File resolved = new File(reportDir, src.replace('/', File.separatorChar))
                if (resolved.exists() && resolved.isFile()) {
                    imgSrc = toDataUri(resolved)
                }
            }

            if (owner.isBlank(imgSrc)) {
                continue
            }

            result.add([
                name  : 'Failure Screenshot ' + index,
                href  : '',
                image : true,
                imgSrc: imgSrc
            ])
            index++
        }

        return result
    }

    List<Map> buildEvidenceFromFiles(List<File> files) {
        List<Map> result = new ArrayList<Map>()
        int index = 1

        for (File file : files) {
            String dataUri = toDataUri(file)
            if (owner.isBlank(dataUri)) {
                continue
            }

            result.add([
                name  : owner.safe(file.name) ?: ('Failure Screenshot ' + index),
                href  : '',
                image : true,
                imgSrc: dataUri
            ])
            index++
        }

        return result
    }

    File findNativeKatalonHtmlReport(File reportDir) {
        if (reportDir == null || !reportDir.exists() || !reportDir.isDirectory()) {
            return null
        }

        File[] files = reportDir.listFiles()
        if (files == null) {
            return null
        }

        List<File> htmlFiles = new ArrayList<File>()
        String excluded = owner.safe(owner.CUSTOM_REPORT_FILE_NAME).toLowerCase(Locale.ENGLISH)

        for (File file : files) {
            if (file == null || !file.isFile()) {
                continue
            }

            String lower = owner.safe(file.name).toLowerCase(Locale.ENGLISH)
            if (!lower.endsWith('.html')) {
                continue
            }
            if (lower == excluded) {
                continue
            }
            htmlFiles.add(file)
        }

        if (htmlFiles.isEmpty()) {
            return null
        }

        File preferred = htmlFiles.find { File file ->
            String lower = owner.safe(file.name).toLowerCase(Locale.ENGLISH)
            return lower == owner.safe(reportDir.name).toLowerCase(Locale.ENGLISH) + '.html'
        }
        if (preferred != null) {
            return preferred
        }

        htmlFiles.sort { File a, File b -> b.lastModified() <=> a.lastModified() }
        return htmlFiles[0]
    }

    File findExecutionLog(File reportDir) {
        if (reportDir == null || !reportDir.exists() || !reportDir.isDirectory()) {
            return null
        }

        File[] files = reportDir.listFiles()
        if (files == null) {
            return null
        }

        List<File> logs = new ArrayList<File>()
        for (File file : files) {
            if (file != null && file.isFile()) {
                String lower = safe(file.name).toLowerCase(Locale.ENGLISH)
                if (lower.startsWith('execution') && lower.endsWith('.log')) {
                    logs.add(file)
                }
            }
        }

        if (logs.isEmpty()) {
            return null
        }

        logs.sort { File a, File b -> b.lastModified() <=> a.lastModified() }
        return logs[0]
    }

    List<String> readFileLines(File file) {
        try {
            return Files.readAllLines(file.toPath(), StandardCharsets.UTF_8)
        } catch (Exception ignored) {
            try {
                return file.readLines()
            } catch (Exception ignoredAgain) {
                return []
            }
        }
    }

    Document parseXmlDocument(File xmlFile) {
        try {
            DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance()
            factory.setNamespaceAware(false)
            factory.setExpandEntityReferences(false)
            factory.setFeature('http://apache.org/xml/features/disallow-doctype-decl', true)
            factory.setFeature('http://xml.org/sax/features/external-general-entities', false)
            factory.setFeature('http://xml.org/sax/features/external-parameter-entities', false)
            factory.setFeature('http://apache.org/xml/features/nonvalidating/load-external-dtd', false)

            return factory.newDocumentBuilder().parse(xmlFile)
        } catch (Exception ignored) {
            return null
        }
    }

    Element firstChildElement(Element parent, String tagName) {
        def nodes = parent.getElementsByTagName(tagName)
        if (nodes == null || nodes.length == 0) {
            return null
        }
        return (Element) nodes.item(0)
    }

    Map newScenarioMap(String title) {
        return [
            title        : cleanupScenarioTitle(title),
            status       : 'passed',
            startLabel   : '',
            endLabel     : '',
            durationMs   : 0L,
            durationLabel: formatDuration(0L),
            steps        : new ArrayList<Map>(),
            errorShort   : '',
            errorFull    : '',
            evidence     : new ArrayList<Map>()
        ]
    }

    Map newStepMap(String title, long durationMs) {
        return [
            title        : cleanupStepTitle(title),
            status       : 'info',
            timeLabel    : '',
            durationMs   : durationMs,
            durationLabel: formatDuration(durationMs),
            detailText   : '',
            errorFull    : '',
            shortError   : '',
            icon         : resolveStepIcon(title, 'info')
        ]
    }

    void finalizeScenario(Map scenario) {
        List<Map> steps = scenario.steps instanceof List ? (scenario.steps as List<Map>) : []

        boolean failed = steps.any { Map item -> 'failed'.equals(safe(item.status)) } || 'failed'.equals(safe(scenario.status))
        boolean skipped = !failed && steps.any { Map item -> 'skipped'.equals(safe(item.status)) }

        if (failed) {
            scenario.status = 'failed'
        } else if (skipped) {
            scenario.status = 'skipped'
        } else if (steps.any { Map item -> 'passed'.equals(safe(item.status)) }) {
            scenario.status = 'passed'
        }

        for (Map step : steps) {
            step.durationLabel = formatDuration(toLong(step.durationMs))
            step.icon = resolveStepIcon(step.title, step.status)
            if ('failed'.equals(safe(step.status))) {
                if (owner.isBlank(scenario.errorShort)) {
                    scenario.errorShort = shortenError(step.shortError ?: step.errorFull ?: step.detailText)
                }
                if (owner.isBlank(scenario.errorFull)) {
                    scenario.errorFull = safe(step.errorFull ?: step.detailText)
                }
            }
        }

        long totalDuration = toLong(scenario.durationMs)
        if (totalDuration <= 0L) {
            for (Map step : steps) {
                totalDuration += toLong(step.durationMs)
            }
            scenario.durationMs = totalDuration
        }
        scenario.durationLabel = formatDuration(toLong(scenario.durationMs))
    }

    void applyTimingInfo(Map scenario, String line) {
        String text = extractAfter(line, 'Start / End / Elapsed:')
        List<String> parts = text.tokenize('/').collect { String item -> safe(item) }

        if (parts.size() >= 1) {
            scenario.startLabel = parts[0]
        }
        if (parts.size() >= 2) {
            scenario.endLabel = parts[1]
        }
        if (parts.size() >= 3 && toLong(scenario.durationMs) <= 0L) {
            scenario.durationMs = toMillisFromElapsed(parts[2])
            scenario.durationLabel = formatDuration(toLong(scenario.durationMs))
        }
    }

    String sanitizeLogLine(String rawLine) {
        String line = safe(rawLine)
        if (owner.isBlank(line)) {
            return ''
        }

        Matcher prefixed = PREFIXED_LOG_PATTERN.matcher(line)
        if (prefixed.find()) {
            line = safe(prefixed.group(1))
        }

        line = line.replace('\t', ' ')
        line = line.replaceAll('\\s+', ' ').trim()
        return line
    }

    String extractAfter(String line, String token) {
        int index = line.indexOf(token)
        if (index < 0) {
            return safe(line)
        }
        return safe(line.substring(index + token.length()))
    }

    String cleanupScenarioTitle(String value) {
        String text = safe(value)
        if (text.startsWith('Test Cases/')) {
            text = text.substring('Test Cases/'.length())
        }
        return text.trim()
    }

    String cleanupStepTitle(String value) {
        return safe(value).trim()
    }

    boolean shouldIgnoreStep(String title) {
        String lower = safe(title).toLowerCase(Locale.ENGLISH)
        return lower.startsWith('beforecase') ||
               lower.startsWith('aftercase') ||
               lower.startsWith('aftersuite') ||
               lower.startsWith('beforesuite') ||
               lower.startsWith('video') ||
               lower.startsWith('exportkatalonreports')
    }

    boolean looksLikeErrorLine(String line) {
        String lower = safe(line).toLowerCase(Locale.ENGLISH)
        return lower.contains('exception') ||
               lower.contains('stepfailexception') ||
               lower.contains('root cause') ||
               lower.contains('caused by:') ||
               lower.startsWith('at ') ||
               lower.contains('unable to') ||
               lower.contains('timeout')
    }

    String normalizeLogStatus(String rawStatus) {
        String lower = safe(rawStatus).toLowerCase(Locale.ENGLISH)
        if (lower == 'passed' || lower == 'pass' || lower == 'success') return 'passed'
        if (lower == 'failed' || lower == 'error') return 'failed'
        if (lower == 'skipped' || lower == 'skip') return 'skipped'
        return 'info'
    }

    String resolveStepIcon(String title, String status) {
        if ('failed'.equals(safe(status))) {
            return '❌'
        }
        if ('skipped'.equals(safe(status))) {
            return '⏭️'
        }

        String lower = safe(title).toLowerCase(Locale.ENGLISH)
        if (lower.contains('wait') || lower.contains('find') || lower.contains('search')) return '🔎'
        if (lower.contains('click') || lower.contains('select')) return '🖱️'
        if (lower.contains('settext') || lower.contains('fill') || lower.contains('type') || lower.contains('input')) return '⌨️'
        if (lower.contains('import') || lower.contains('upload') || lower.contains('file')) return '📄'
        if (lower.contains('verify') || lower.contains('assert')) return '✅'
        return 'ℹ️'
    }

    String shortenError(def value) {
        String text = safe(value)
        if (owner.isBlank(text)) {
            return ''
        }

        List<String> lines = text.readLines().collect { String item -> safe(item) }.findAll { String item -> !owner.isBlank(item) }
        if (lines.isEmpty()) {
            return ''
        }

        String first = lines[0]
        first = first.replace('com.kms.katalon.core.exception.StepFailedException:', '').trim()

        int atIndex = first.indexOf(' at ')
        if (atIndex > 0) {
            first = first.substring(0, atIndex).trim()
        }

        if (first.length() > 180) {
            first = first.substring(0, 177) + '...'
        }

        return first
    }

    String appendText(String current, String addition) {
        String base = safe(current)
        String extra = safe(addition)

        if (owner.isBlank(base)) return extra
        if (owner.isBlank(extra)) return base

        return base + '\n' + extra
    }

    String buildDisplayName(String className, String name) {
        if (!owner.isBlank(className) && !owner.isBlank(name)) {
            return className + '/' + name
        }
        if (!owner.isBlank(name)) {
            return name
        }
        return className
    }

    boolean isUsefulEvidenceSource(String src) {
        String lower = safe(src).toLowerCase(Locale.ENGLISH)
        if (owner.isBlank(lower)) {
            return false
        }

        if (lower.startsWith('data:image') && lower.length() > 500) {
            return true
        }

        boolean imagePath = lower.endsWith('.png') ||
                            lower.endsWith('.jpg') ||
                            lower.endsWith('.jpeg') ||
                            lower.endsWith('.webp') ||
                            lower.endsWith('.gif') ||
                            lower.endsWith('.bmp') ||
                            lower.contains('screenshot')

        if (!imagePath) {
            return false
        }

        if (lower.contains('logo')) return false
        if (lower.contains('icon')) return false
        if (lower.contains('favicon')) return false
        if (lower.contains('sprite')) return false

        return true
    }

    String toDataUri(File file) {
        if (file == null || !file.exists() || !file.isFile()) {
            return ''
        }

        try {
            byte[] bytes = Files.readAllBytes(file.toPath())
            String mime = resolveMimeType(file.name)
            return 'data:' + mime + ';base64,' + Base64.encoder.encodeToString(bytes)
        } catch (Exception ignored) {
            return ''
        }
    }

    String resolveMimeType(String name) {
        String lower = safe(name).toLowerCase(Locale.ENGLISH)
        if (lower.endsWith('.png')) return 'image/png'
        if (lower.endsWith('.jpg') || lower.endsWith('.jpeg')) return 'image/jpeg'
        if (lower.endsWith('.webp')) return 'image/webp'
        if (lower.endsWith('.gif')) return 'image/gif'
        if (lower.endsWith('.bmp')) return 'image/bmp'
        return 'image/png'
    }

    String formatClock(String rawClock) {
        String value = safe(rawClock)
        int dotIndex = value.indexOf('.')
        return dotIndex > 0 ? value.substring(0, dotIndex) : value
    }

    long toMillisFromElapsed(String raw) {
        String value = safe(raw)
        if (owner.isBlank(value)) {
            return 0L
        }

        if (value.matches('\\d{2}:\\d{2}:\\d{2}\\.\\d{3}')) {
            String[] hms = value.split(':')
            String[] secMs = hms[2].split('\\.')

            long hours = Long.parseLong(hms[0])
            long minutes = Long.parseLong(hms[1])
            long seconds = Long.parseLong(secMs[0])
            long millis = Long.parseLong(secMs[1])

            return (((hours * 60L + minutes) * 60L) + seconds) * 1000L + millis
        }

        return toMillisFromCompactSeconds(value)
    }

    long toMillisFromCompactSeconds(String raw) {
        String value = safe(raw).replace(',', '.').replace('s', '').trim()
        if (owner.isBlank(value)) {
            return 0L
        }

        try {
            return Math.round(Double.parseDouble(value) * 1000d)
        } catch (Exception ignored) {
            return 0L
        }
    }

    long toMillisFromSeconds(String raw) {
        return toMillisFromCompactSeconds(raw)
    }

    long toLong(def value) {
        try {
            return Long.parseLong(safe(value))
        } catch (Exception ignored) {
            return 0L
        }
    }

    String formatDuration(long durationMs) {
        if (durationMs < 0L) {
            durationMs = 0L
        }

        long totalSeconds = Math.round(durationMs / 1000d)
        long hours = (long) (totalSeconds / 3600L)
        long minutes = (long) ((totalSeconds % 3600L) / 60L)
        long seconds = (long) (totalSeconds % 60L)

        return String.format(Locale.ENGLISH, '%02dh %02dm %02ds', hours, minutes, seconds)
    }

    String safe(def value) {
        return owner.safe(value)
    }
}
