    @Keyword
    String getCurrentWindowsUser() {
        String user = System.getenv('USERNAME')
        if (!user?.trim()) {
            user = System.getProperty('user.name')
        }
        return safe(user)
    }

    @Keyword
    String readEnv() {
        try {
            return normalizeEnv(String.valueOf(GlobalVariable.env ?: 'REC'))
        } catch (Throwable ignored) {
            return 'REC'
        }
    }

    @Keyword
    String resolveWindowTitle() {
        String env = readEnv()
        String rawVersion = resolveVersionFromRefLogin(env)

        if (!rawVersion) {
            try {
                rawVersion = safe(GlobalVariable.version)
            } catch (Throwable ignored) {
            }
        }

        if (!rawVersion) {
            rawVersion = '26.1.1.3'
        }

        rawVersion = safe(rawVersion)
        rawVersion = rawVersion.replaceFirst(/(?i)^ematch\s+/, '').trim()

        return "eMatch ${rawVersion}".replaceAll(/\s+/, ' ').trim()
    }

