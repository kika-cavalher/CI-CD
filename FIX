	@Keyword
	void resetDownloadedFiles() {

		GlobalVariable.compareFiles = new ArrayList()

		KeywordUtil.logInfo(
			'Downloaded file list was reset.'
		)
	}


	@Keyword
	void downloadCurrentView(String fileLabel) {

		List compareFiles = resolveCompareFiles()
		Integer beforeDownloadSize = compareFiles.size()

		takeEvidence(
			beforeDownloadSize == 0
				? 'GUI_OriginalFileDownload.png'
				: 'GUI_FavoriteFileDownload.png'
		)

		try {
			Class helperClass = this.class.classLoader.loadClass(
				'com.katalon.ematch.helper.EmatchHelper'
			)

			def helper = helperClass.newInstance()

			def downloadedFile = helper.downloadFileFromMainScreenWithCopyPaste(
				20,
				30,
				safeText(fileLabel)
			)

			if (downloadedFile != null) {
				compareFiles.add(downloadedFile)
			}
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop(
				'Current view could not be downloaded.\n' +
				'Reason: ' + safeMessage(e)
			)

			return
		}

		GlobalVariable.compareFiles = compareFiles

		if (compareFiles.size() <= beforeDownloadSize) {
			KeywordUtil.markFailedAndStop(
				'Downloaded file was not added to compareFiles.'
			)

			return
		}

		KeywordUtil.markPassed(
			'Current view downloaded successfully.'
		)
	}


	@Keyword
	void compareDownloadedFiles() {

		List compareFiles = resolveCompareFiles()

		if (compareFiles.size() < 2) {
			KeywordUtil.markFailedAndStop(
				'Two files are required for comparison.\n' +
				'Files found: ' + compareFiles
			)

			return
		}

		String evidencePath =
			RunConfiguration.getReportFolder() +
			'\\Evidences\\'

		String file1 = resolveDownloadedFilePath(
			evidencePath,
			compareFiles[0]
		)

		String file2 = resolveDownloadedFilePath(
			evidencePath,
			compareFiles[1]
		)

		String errors = ''

		try {
			Class validationClass = this.class.classLoader.loadClass(
				'com.katalon.keywords.excelHandling.ExcelValidations'
			)

			def validation = validationClass.newInstance()

			errors = safeText(
				validation.compareSubFilesNoExceptions(
					file1,
					file2,
					errors
				)
			)
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop(
				'Downloaded files could not be compared.\n' +
				'Reason: ' + safeMessage(e)
			)

			return
		}

		if (!errors.isEmpty()) {
			KeywordUtil.markFailed(
				'Downloaded file comparison failed.\n' +
				errors
			)

			return
		}

		KeywordUtil.markPassed(
			'Original and favorite files contain the same data.'
		)
	}


	// ======================================================
	// DELETE FAVORITE
	// ======================================================

	@Keyword
	void deleteCreatedFavorite(String favoriteTitle) {

		Integer timeout = 5

		logStep(
			'DELETE FAVORITE',
			'Favorite title: ' + favoriteTitle
		)

		WindowsTestObject favoritesTab =
			object('favoritesTab')

		if (!Windows.waitForElementPresent(
			favoritesTab,
			timeout,
			FailureHandling.OPTIONAL
		)) {
			takeEvidence('GUI_FavoritesTabNotFoundForDelete.png')

			KeywordUtil.markFailedAndStop(
				'Favorites tab was not found before deletion.'
			)

			return
		}

		Windows.click(
			favoritesTab,
			FailureHandling.STOP_ON_FAILURE
		)

		Windows.delay(1)

		WindowsTestObject favoriteItem =
			WindowsObjectLoader.getTreeItemByName(
				favoriteTitle
			)

		if (!Windows.waitForElementPresent(
			favoriteItem,
			timeout,
			FailureHandling.OPTIONAL
		)) {
			takeEvidence('GUI_FavoriteNotFoundForDelete.png')

			KeywordUtil.markFailedAndStop(
				'Favorite was not found for deletion.\n' +
				'Favorite: ' + favoriteTitle
			)

			return
		}

		Windows.rightClick(
			favoriteItem,
			FailureHandling.STOP_ON_FAILURE
		)

		Windows.delay(1)

		WindowsTestObject deleteFavoriteButton =
			object('deleteFavoriteButton')

		if (!Windows.waitForElementPresent(
			deleteFavoriteButton,
			timeout,
			FailureHandling.OPTIONAL
		)) {
			takeEvidence('GUI_DeleteFavoriteButtonNotFound.png')

			KeywordUtil.markFailedAndStop(
				'Delete Favorite command was not found.'
			)

			return
		}

		Windows.click(
			deleteFavoriteButton,
			FailureHandling.STOP_ON_FAILURE
		)

		Windows.delay(2)

		boolean favoriteStillPresent =
			Windows.waitForElementPresent(
				favoriteItem,
				2,
				FailureHandling.OPTIONAL
			)

		takeEvidence('GUI_FavoriteAfterDelete.png')

		if (favoriteStillPresent) {
			KeywordUtil.markFailedAndStop(
				'Favorite is still visible after deletion.\n' +
				'Favorite: ' + favoriteTitle
			)

			return
		}

		KeywordUtil.markPassed(
			'Favorite deleted successfully.\n' +
			'Favorite: ' + favoriteTitle
		)
	}


