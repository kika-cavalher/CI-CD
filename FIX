class RecPrdExportValidationKeywords {

	@Keyword
	Map validateLatestRecPrdExport(
			String exportRootFolder,
			String exportGroupFolder,
			String exportFeatureFolder,
			Integer columnIndex,
			String expectedColumnName) {

		Map result = createEmptyResult(
				exportRootFolder,
				exportGroupFolder,
				exportFeatureFolder,
				columnIndex,
				expectedColumnName
				)

		StringBuilder errors = new StringBuilder()
		StringBuilder passedDetails = new StringBuilder()

		File recFile = null
		File prdFile = null

		try {
			File exportRoot = new File(safeText(exportRootFolder))
			int validatedColumnIndex =
					columnIndex == null
					? -1
					: columnIndex.intValue()

			if (!exportRoot.exists()) {
				errors.append('[ERROR] Export root folder does not exist.\n')
						.append('Folder: ')
						.append(exportRoot.getAbsolutePath())

				return finalizeResult(
						result,
						errors,
						passedDetails
						)
			}

			if (!exportRoot.isDirectory()) {
				errors.append('[ERROR] Export root path is not a folder.\n')
						.append('Path: ')
						.append(exportRoot.getAbsolutePath())

				return finalizeResult(
						result,
						errors,
						passedDetails
						)
			}

			if (validatedColumnIndex < 0) {
				errors.append('[ERROR] Invalid column index.\n')
						.append('Column index: ')
						.append(validatedColumnIndex)

				return finalizeResult(
						result,
						errors,
						passedDetails
						)
			}

			KeywordUtil.logInfo(
					'[REC X PRD SEARCH] root=' +
					exportRoot.getAbsolutePath() +
					' | group=' +
					safeText(exportGroupFolder) +
					' | feature=' +
					safeText(exportFeatureFolder)
					)

			Map selectedFiles = resolveLatestRecPrdFiles(
					exportRoot,
					exportGroupFolder,
					exportFeatureFolder
					)

			recFile = selectedFiles.recFile as File
			prdFile = selectedFiles.prdFile as File

			File selectedFolder =
					selectedFiles.selectedFolder as File

			result.recFileName =
					recFile == null
					? 'NOT FOUND'
					: recFile.getName()

			result.prdFileName =
					prdFile == null
					? 'NOT FOUND'
					: prdFile.getName()

			result.selectedFolderPath =
					selectedFolder == null
					? ''
					: selectedFolder.getAbsolutePath()

			if (recFile == null) {
				errors.append('[ERROR] REC exported file was not found.\n')
						.append('Search root: ')
						.append(exportRoot.getAbsolutePath())
						.append('\nExpected folder: ')
						.append(safeText(exportGroupFolder))
						.append('\\')
						.append(safeText(exportFeatureFolder))
						.append('\n')
			}

			if (prdFile == null) {
				errors.append('[ERROR] PRD exported file was not found.\n')
						.append('Search root: ')
						.append(exportRoot.getAbsolutePath())
						.append('\nExpected folder: ')
						.append(safeText(exportGroupFolder))
						.append('\\')
						.append(safeText(exportFeatureFolder))
						.append('\n')
			}

			if (errors.length() > 0) {
				return finalizeResult(
						result,
						errors,
						passedDetails
						)
			}

			KeywordUtil.logInfo(
					'[REC X PRD SEARCH] selectedFolder=' +
					selectedFolder.getAbsolutePath() +
					' | REC=' +
					recFile.getName() +
					' | PRD=' +
					prdFile.getName()
					)

			/*
			 * Read REC and PRD sequentially.
			 * This avoids keeping both large workbooks
			 * in memory at the same time.
			 */
			Map recData = readFileData(
					recFile,
					validatedColumnIndex,
					expectedColumnName,
					'REC'
					)

			System.gc()

			Map prdData = readFileData(
					prdFile,
					validatedColumnIndex,
					expectedColumnName,
					'PRD'
					)

			System.gc()

			result.recColumnName =
					safeText(recData.columnName)

			result.prdColumnName =
					safeText(prdData.columnName)

			result.columnName =
					!safeText(recData.columnName).isEmpty()
					? safeText(recData.columnName)
					: safeText(expectedColumnName)

			result.recRows = recData.rows
			result.prdRows = prdData.rows

			result.recNumericValues =
					recData.numericValues

			result.prdNumericValues =
					prdData.numericValues

			result.recZeroValues =
					recData.zeroValues

			result.prdZeroValues =
					prdData.zeroValues

			result.recNonZeroValues =
					recData.nonZeroValues

			result.prdNonZeroValues =
					prdData.nonZeroValues

			result.recOnlyZeroValues =
					recData.onlyZeroValues

			result.prdOnlyZeroValues =
					prdData.onlyZeroValues

			result.recColumnStatus =
					recData.columnStatus

			result.prdColumnStatus =
					prdData.columnStatus

			result.recSum = recData.sum
			result.prdSum = prdData.sum

			result.recMinimum =
					recData.minimum

			result.prdMinimum =
					prdData.minimum

			result.recMaximum =
					recData.maximum

			result.prdMaximum =
					prdData.maximum

			if (!safeText(recData.errors).isEmpty()) {
				errors.append(
						safeText(recData.errors)
						)
						.append('\n')
			}

			if (!safeText(prdData.errors).isEmpty()) {
				errors.append(
						safeText(prdData.errors)
						)
						.append('\n')
			}

			if (errors.length() > 0) {
				return finalizeResult(
						result,
						errors,
						passedDetails
						)
			}

			if (!normalizeText(result.recColumnName).equals(
					normalizeText(result.prdColumnName))) {

				errors.append(
						'[ERROR] REC and PRD column headers are different.\n'
						)
						.append('REC: ')
						.append(result.recColumnName)
						.append('\nPRD: ')
						.append(result.prdColumnName)
						.append('\n')
			}

			if ((result.recRows as int) !=
					(result.prdRows as int)) {

				errors.append('[ERROR] Number of rows is different.\n')
						.append('REC: ')
						.append(result.recRows)
						.append('\nPRD: ')
						.append(result.prdRows)
						.append('\n')
			} else {
				passedDetails.append(
						'[PASS] Number of rows is equal.\n'
						)
						.append('REC: ')
						.append(result.recRows)
						.append('\nPRD: ')
						.append(result.prdRows)
						.append('\n')
			}

			appendColumnValueSummary(
					passedDetails,
					'REC',
					result.columnName as String,
					result.recNumericValues as Integer,
					result.recZeroValues as Integer,
					result.recNonZeroValues as Integer,
					result.recOnlyZeroValues == true,
					result.recSum as BigDecimal,
					result.recMinimum as BigDecimal,
					result.recMaximum as BigDecimal
					)

			appendColumnValueSummary(
					passedDetails,
					'PRD',
					result.columnName as String,
					result.prdNumericValues as Integer,
					result.prdZeroValues as Integer,
					result.prdNonZeroValues as Integer,
					result.prdOnlyZeroValues == true,
					result.prdSum as BigDecimal,
					result.prdMinimum as BigDecimal,
					result.prdMaximum as BigDecimal
					)

			appendComparison(
					errors,
					passedDetails,
					'Column sum',
					result.columnName as String,
					result.recSum as BigDecimal,
					result.prdSum as BigDecimal
					)

			appendComparison(
					errors,
					passedDetails,
					'Minimum value',
					result.columnName as String,
					result.recMinimum as BigDecimal,
					result.prdMinimum as BigDecimal
					)

			appendComparison(
					errors,
					passedDetails,
					'Maximum value',
					result.columnName as String,
					result.recMaximum as BigDecimal,
					result.prdMaximum as BigDecimal
					)
		} catch (OutOfMemoryError error) {
			KeywordUtil.logInfo(
					'Complete Excel validation exceeded the available JVM memory.\n' +
					'Fallback validation will compare only the number of rows.\n' +
					'Reason: ' +
					safeText(error.getMessage())
					)

			errors.setLength(0)
			passedDetails.setLength(0)
			clearStatistics(result)

			try {
				System.gc()
				Thread.sleep(1000)
			} catch (Exception ignored) {
			}

			if (recFile == null ||
					prdFile == null) {

				errors.append(
						'[ERROR] Row-count fallback could not be executed because REC or PRD file was not resolved.'
						)
			} else {
				int recRows =
						readRowCountStreaming(
						recFile,
						'REC'
						)

				int prdRows =
						readRowCountStreaming(
						prdFile,
						'PRD'
						)

				result.recRows = recRows
				result.prdRows = prdRows
				result.fallbackUsed = true
				result.validationMode =
						'ROW_COUNT_FALLBACK'

				passedDetails.append(
						'[INFO] Full column validation was replaced by row-count validation because the Excel file exceeded available memory.\n'
						)

				if (recRows != prdRows) {
					errors.append(
							'[ERROR] Number of rows is different.\n'
							)
							.append('REC: ')
							.append(recRows)
							.append('\nPRD: ')
							.append(prdRows)
				} else {
					passedDetails.append(
							'[PASS] Number of rows is equal.\n'
							)
							.append('REC: ')
							.append(recRows)
							.append('\nPRD: ')
							.append(prdRows)
				}
			}
		} catch (Exception exception) {
			errors.append(
					'[ERROR] REC x PRD export validation failed.\n'
					)
					.append('Exception: ')
					.append(
					exception
					.getClass()
					.getSimpleName()
					)
					.append('\nMessage: ')
					.append(
					safeText(
					exception.getMessage()
					)
					)
		}

		return finalizeResult(
				result,
				errors,
				passedDetails
				)
	}


	private int readRowCountStreaming(
			File file,
			String environment) {

		String lowerName =
				file.getName().toLowerCase()

		if (!lowerName.endsWith('.xlsx') &&
				!lowerName.endsWith('.xlsm')) {

			return readRowCountWithWorkbook(
					file,
					environment
					)
		}

		OPCPackage opcPackage = null
		InputStream sheetInput = null

		try {
			opcPackage = OPCPackage.open(file)

			XSSFReader reader =
					new XSSFReader(opcPackage)

			StylesTable styles =
					reader.getStylesTable()

			ReadOnlySharedStringsTable sharedStrings =
					new ReadOnlySharedStringsTable(
					opcPackage
					)

			Iterator<InputStream> sheets =
					reader.getSheetsData()

			if (!sheets.hasNext()) {
				throw new IllegalStateException(
				environment +
					' workbook does not contain worksheets.'
					)
			}

			sheetInput = sheets.next()

			RowCountStreamingHandler rowHandler =
					new RowCountStreamingHandler()

			XSSFSheetXMLHandler sheetHandler =
					new XSSFSheetXMLHandler(
					styles,
					null,
					sharedStrings,
					rowHandler,
					new DataFormatter(),
					false
					)

			SAXParserFactory parserFactory =
					SAXParserFactory.newInstance()

			parserFactory.setNamespaceAware(true)

			XMLReader parser =
					parserFactory
					.newSAXParser()
					.getXMLReader()

			parser.setContentHandler(sheetHandler)
			parser.parse(
					new InputSource(sheetInput)
					)

			return rowHandler.rows
		} finally {
			try {
				if (sheetInput != null) {
					sheetInput.close()
				}
			} catch (Exception ignored) {
			}

			try {
				if (opcPackage != null) {
					opcPackage.close()
				}
			} catch (Exception ignored) {
			}
		}
	}


	private int readRowCountWithWorkbook(
			File file,
			String environment) {

		FileInputStream input = null
		Workbook workbook = null

		try {
			input = new FileInputStream(file)

			workbook =
					WorkbookFactory.create(input)

			if (workbook.getNumberOfSheets() == 0) {
				throw new IllegalStateException(
				environment +
					' workbook does not contain worksheets.'
					)
			}

			Sheet sheet =
					workbook.getSheetAt(0)

			DataFormatter formatter =
					new DataFormatter()

			int rows = 0

			for (int rowIndex = 1;
					rowIndex <= sheet.getLastRowNum();
					rowIndex++) {

				Row row =
						sheet.getRow(rowIndex)

				if (row != null &&
						!isRowEmpty(
						row,
						formatter
						)) {

					rows++
				}
			}

			return rows
		} finally {
			try {
				if (workbook != null) {
					workbook.close()
				}
			} catch (Exception ignored) {
			}

			try {
				if (input != null) {
					input.close()
				}
			} catch (Exception ignored) {
			}
		}
	}


	private void clearStatistics(Map result) {

		result.recColumnName = ''
		result.prdColumnName = ''

		result.recRows = null
		result.prdRows = null

		result.recNumericValues = null
		result.prdNumericValues = null

		result.recZeroValues = null
		result.prdZeroValues = null

		result.recNonZeroValues = null
		result.prdNonZeroValues = null

		result.recOnlyZeroValues = false
		result.prdOnlyZeroValues = false

		result.recColumnStatus = 'NOT_ANALYSED'
		result.prdColumnStatus = 'NOT_ANALYSED'

		result.recSum = null
		result.prdSum = null

		result.recMinimum = null
		result.prdMinimum = null

		result.recMaximum = null
		result.prdMaximum = null
	}


	private static class RowCountStreamingHandler
	implements XSSFSheetXMLHandler.SheetContentsHandler {

		int rows = 0

		private boolean rowHasValue = false

		@Override
		void startRow(int rowNum) {
			rowHasValue = false
		}

		@Override
		void endRow(int rowNum) {

			if (rowNum > 0 &&
					rowHasValue) {

				rows++
			}
		}

		@Override
		void cell(
				String cellReference,
				String formattedValue,
				XSSFComment comment) {

			if (formattedValue != null &&
					!formattedValue
					.trim()
					.isEmpty()) {

				rowHasValue = true
			}
		}

		@Override
		void headerFooter(
				String text,
				boolean isHeader,
				String tagName) {
		}
	}


	private Map readFileData(
			File file,
			int columnIndex,
			String expectedColumnName,
			String environment) {

		Map result = [
			columnName      : '',
			rows            : 0,
			numericValues   : 0,
			zeroValues      : 0,
			nonZeroValues   : 0,
			onlyZeroValues  : false,
			columnStatus    : 'NOT_ANALYSED',
			sum             : null,
			minimum         : null,
			maximum         : null,
			errors          : ''
		]

		StringBuilder errors =
				new StringBuilder()

		FileInputStream input = null
		Workbook workbook = null

		try {
			input = new FileInputStream(file)

			workbook =
					WorkbookFactory.create(input)

			if (workbook.getNumberOfSheets() == 0) {
				errors.append('[ERROR] ')
						.append(environment)
						.append(
						' workbook does not contain worksheets.\n'
						)
						.append('File: ')
						.append(file.getName())

				result.errors =
						errors.toString()

				return result
			}

			Sheet sheet =
					workbook.getSheetAt(0)

			DataFormatter formatter =
					new DataFormatter()

			FormulaEvaluator evaluator =
					workbook
					.getCreationHelper()
					.createFormulaEvaluator()

			String columnName =
					readHeaderName(
					sheet,
					columnIndex,
					formatter
					)

			result.columnName = columnName

			if (columnName.isEmpty()) {
				errors.append('[ERROR] ')
						.append(environment)
						.append(
						' column header was not found.\n'
						)
						.append('Column index: ')
						.append(columnIndex)
						.append('\n')
			} else if (!normalizeText(columnName).equals(
					normalizeText(expectedColumnName))) {

				errors.append('[ERROR] Unexpected ')
						.append(environment)
						.append(
						' column header.\n'
						)
						.append('Expected: ')
						.append(
						safeText(
						expectedColumnName
						)
						)
						.append('\nFound: ')
						.append(columnName)
						.append('\n')
			}

			BigDecimal sum =
					BigDecimal.ZERO

			BigDecimal minimum = null
			BigDecimal maximum = null

			int numericValues = 0
			int zeroValues = 0
			int nonZeroValues = 0
			int rows = 0

			for (int rowIndex = 1;
					rowIndex <= sheet.getLastRowNum();
					rowIndex++) {

				Row row =
						sheet.getRow(rowIndex)

				if (row == null ||
						isRowEmpty(
						row,
						formatter
						)) {

					continue
				}

				rows++

				BigDecimal value =
						getCellNumber(
						row,
						columnIndex,
						formatter,
						evaluator
						)

				if (value == null) {
					continue
				}

				sum = sum.add(value)

				if (minimum == null ||
						value.compareTo(minimum) < 0) {

					minimum = value
				}

				if (maximum == null ||
						value.compareTo(maximum) > 0) {

					maximum = value
				}

				if (value.compareTo(BigDecimal.ZERO) == 0) {
					zeroValues++
				} else {
					nonZeroValues++
				}

				numericValues++
			}

			result.rows = rows
			result.numericValues = numericValues
			result.zeroValues = zeroValues
			result.nonZeroValues = nonZeroValues

			if (numericValues == 0) {
				result.columnStatus = 'NO_READABLE_NUMERIC_VALUES'

				errors.append('[ERROR] ')
						.append(environment)
						.append(
						' column does not contain readable numeric values.\n'
						)
						.append('Column: ')
						.append(columnName)
						.append('\nRows analysed: ')
						.append(rows)
						.append('\nNumeric values read: 0\n')
			} else {
				result.sum = round2(sum)
				result.minimum = round2(minimum)
				result.maximum = round2(maximum)

				result.onlyZeroValues =
						nonZeroValues == 0

				result.columnStatus =
						result.onlyZeroValues
						? 'ONLY_ZERO_VALUES'
						: 'NUMERIC_VALUES_FOUND'
			}

			result.errors =
					errors
					.toString()
					.trim()

			return result
		} finally {
			closeWorkbook(workbook)
			closeInput(input)
		}
	}


	private Map createEmptyResult(
			String exportRootFolder,
			String exportGroupFolder,
			String exportFeatureFolder,
			Integer columnIndex,
			String expectedColumnName) {

		return [
			success             : false,
			errors              : '',
			passedDetails       : '',
			exportRootFolder    : safeText(exportRootFolder),
			exportGroupFolder   : safeText(exportGroupFolder),
			exportFeatureFolder : safeText(exportFeatureFolder),
			columnIndex         : columnIndex,
			columnName          : safeText(expectedColumnName),
			recColumnName       : '',
			prdColumnName       : '',
			selectedFolderPath  : '',
			recFileName         : 'NOT FOUND',
			prdFileName         : 'NOT FOUND',
			recRows             : null,
			prdRows             : null,
			recNumericValues    : null,
			prdNumericValues    : null,
			recZeroValues       : null,
			prdZeroValues       : null,
			recNonZeroValues    : null,
			prdNonZeroValues    : null,
			recOnlyZeroValues   : false,
			prdOnlyZeroValues   : false,
			recColumnStatus     : 'NOT_ANALYSED',
			prdColumnStatus     : 'NOT_ANALYSED',
			recSum              : null,
			prdSum              : null,
			recMinimum          : null,
			prdMinimum          : null,
			recMaximum          : null,
			prdMaximum          : null
		]
	}


	private Map finalizeResult(
			Map result,
			StringBuilder errors,
			StringBuilder passedDetails) {

		result.errors =
				errors
				.toString()
				.trim()

		result.passedDetails =
				passedDetails
				.toString()
				.trim()

		result.success =
				result.errors.isEmpty()

		return result
	}


	private Map resolveLatestRecPrdFiles(
			File exportRoot,
			String expectedGroupFolder,
			String expectedFeatureFolder) {

		Map result = [
			recFile       : null,
			prdFile       : null,
			selectedFolder: null
		]

		List<File> matchingFeatureFolders = []

		collectMatchingFeatureFolders(
				exportRoot,
				expectedGroupFolder,
				expectedFeatureFolder,
				matchingFeatureFolders
				)

		List<Map> validPairs = []

		for (File featureFolder :
		matchingFeatureFolders) {

			File[] folderFiles =
					featureFolder.listFiles()

			if (folderFiles == null) {
				continue
			}

			List<File> recFiles =
					folderFiles.findAll { File file ->

						isEnvironmentExcelFile(
								file,
								'REC'
								)
					}

			List<File> prdFiles =
					folderFiles.findAll { File file ->

						isEnvironmentExcelFile(
								file,
								'PRD'
								)
					}

			if (recFiles.isEmpty() ||
					prdFiles.isEmpty()) {

				continue
			}

			recFiles.sort { File first, File second ->

				second.lastModified() <=>
						first.lastModified()
			}

			prdFiles.sort { File first, File second ->

				second.lastModified() <=>
						first.lastModified()
			}

			File recFile =
					recFiles.get(0)

			File prdFile =
					prdFiles.get(0)

			validPairs.add([
				recFile       : recFile,
				prdFile       : prdFile,
				selectedFolder: featureFolder,
				pairTimestamp : Math.max(
				recFile.lastModified(),
				prdFile.lastModified()
				)
			])
		}

		if (validPairs.isEmpty()) {
			return result
		}

		validPairs.sort { Map first, Map second ->

			(second.pairTimestamp as Long) <=>
					(first.pairTimestamp as Long)
		}

		Map latestPair =
				validPairs.get(0)

		result.recFile =
				latestPair.recFile

		result.prdFile =
				latestPair.prdFile

		result.selectedFolder =
				latestPair.selectedFolder

		return result
	}


	private void collectMatchingFeatureFolders(
			File currentFolder,
			String expectedGroupFolder,
			String expectedFeatureFolder,
			List<File> result) {

		if (currentFolder == null ||
				!currentFolder.exists() ||
				!currentFolder.isDirectory()) {

			return
		}

		File parentFolder =
				currentFolder.getParentFile()

		boolean featureMatches =
				normalizeText(
				currentFolder.getName()
				).equals(
				normalizeText(
				expectedFeatureFolder
				)
				)

		boolean groupMatches =
				parentFolder != null &&
				normalizeText(
				parentFolder.getName()
				).equals(
				normalizeText(
				expectedGroupFolder
				)
				)

		if (featureMatches &&
				groupMatches) {

			result.add(currentFolder)
			return
		}

		File[] children =
				currentFolder.listFiles()

		if (children == null) {
			return
		}

		for (File child : children) {
			if (child != null &&
					child.isDirectory()) {

				collectMatchingFeatureFolders(
						child,
						expectedGroupFolder,
						expectedFeatureFolder,
						result
						)
			}
		}
	}


	private boolean isEnvironmentExcelFile(
			File file,
			String environment) {

		if (file == null ||
				!file.exists() ||
				!file.isFile()) {

			return false
		}

		String fileName =
				file.getName()

		if (fileName.startsWith('~$')) {
			return false
		}

		return fileName
				.toUpperCase()
				.startsWith(
				safeText(environment)
				.toUpperCase() +
				'_'
				) &&
				isExcelFileName(fileName)
	}


	private boolean isExcelFileName(
			String fileName) {

		String normalizedName =
				safeText(fileName)
				.toLowerCase()

		return normalizedName.endsWith('.xlsx') ||
				normalizedName.endsWith('.xls') ||
				normalizedName.endsWith('.xlsm')
	}


	private String readHeaderName(
			Sheet sheet,
			int columnIndex,
			DataFormatter formatter) {

		if (sheet == null ||
				columnIndex < 0) {

			return ''
		}

		Row headerRow =
				sheet.getRow(0)

		if (headerRow == null) {
			return ''
		}

		Cell headerCell =
				headerRow.getCell(columnIndex)

		if (headerCell == null) {
			return ''
		}

		return formatter
				.formatCellValue(headerCell)
				.trim()
	}


	private BigDecimal getCellNumber(
			Row row,
			int columnIndex,
			DataFormatter formatter,
			FormulaEvaluator evaluator) {

		if (row == null ||
				columnIndex < 0) {

			return null
		}

		Cell cell =
				row.getCell(columnIndex)

		if (cell == null) {
			return null
		}

		try {
			CellType cellType =
					cell.getCellType()

			if (cellType == CellType.NUMERIC) {
				return BigDecimal.valueOf(
						cell.getNumericCellValue()
						)
			}

			if (cellType == CellType.STRING) {
				String stringValue =
						cell.getStringCellValue()

				BigDecimal parsedStringValue =
						parseNumber(stringValue)

				if (parsedStringValue != null) {
					return parsedStringValue
				}

				if (isZeroPlaceholder(stringValue)) {
					return BigDecimal.ZERO
				}
			}

			if (cellType == CellType.FORMULA) {
				CellType cachedResultType =
						cell.getCachedFormulaResultType()

				if (cachedResultType ==
						CellType.NUMERIC) {

					return BigDecimal.valueOf(
							cell.getNumericCellValue()
							)
				}

				if (cachedResultType ==
						CellType.STRING) {

					String cachedText =
							cell.getStringCellValue()

					BigDecimal cachedStringValue =
							parseNumber(cachedText)

					if (cachedStringValue != null) {
						return cachedStringValue
					}

					if (isZeroPlaceholder(cachedText)) {
						return BigDecimal.ZERO
					}
				}

				if (evaluator != null) {
					try {
						CellValue evaluatedValue =
								evaluator.evaluate(cell)

						if (evaluatedValue != null) {
							if (evaluatedValue.getCellType() ==
									CellType.NUMERIC) {

								return BigDecimal.valueOf(
										evaluatedValue
										.getNumberValue()
										)
							}

							if (evaluatedValue.getCellType() ==
									CellType.STRING) {

								String evaluatedText =
										evaluatedValue
										.getStringValue()

								BigDecimal evaluatedStringValue =
										parseNumber(evaluatedText)

								if (evaluatedStringValue != null) {
									return evaluatedStringValue
								}

								if (isZeroPlaceholder(evaluatedText)) {
									return BigDecimal.ZERO
								}
							}
						}

						String formattedFormulaText =
								formatter.formatCellValue(
								cell,
								evaluator
								)

						BigDecimal formattedFormulaValue =
								parseNumber(formattedFormulaText)

						if (formattedFormulaValue != null) {
							return formattedFormulaValue
						}

						if (isZeroPlaceholder(formattedFormulaText)) {
							return BigDecimal.ZERO
						}
					} catch (Exception ignored) {
						/*
						 * Some exported workbooks contain formulas that Apache POI
						 * cannot evaluate. Continue with the cached/formatted value
						 * instead of discarding a valid zero.
						 */
					}
				}
			}

			String formattedText =
					formatter.formatCellValue(cell)

			BigDecimal formattedValue =
					parseNumber(formattedText)

			if (formattedValue != null) {
				return formattedValue
			}

			if (isZeroPlaceholder(formattedText)) {
				return BigDecimal.ZERO
			}

			return null
		} catch (Exception exception) {
			KeywordUtil.logInfo(
					'[EXCEL VALUE WARNING] Value could not be read.\n' +
					'Row: ' +
					(row.getRowNum() + 1) +
					'\nColumn index: ' +
					columnIndex +
					'\nCell type: ' +
					safeText(cell.getCellType()) +
					'\nReason: ' +
					safeText(
					exception.getMessage()
					)
					)

			return null
		}
	}


	private boolean isZeroPlaceholder(
			String value) {

		String text = safeText(value)

		if (text.isEmpty()) {
			return false
		}

		text = text
				.replace('\u00A0', ' ')
				.replace('\u202F', ' ')
				.replace('\u2212', '-')
				.replace('\u2012', '-')
				.replace('\u2013', '-')
				.replace('\u2014', '-')
				.replace('\u2015', '-')
				.trim()

		String compact =
				text
				.replaceAll('\\s+', '')
				.replaceAll('[€$£¥%]', '')

		if (compact.matches('^-+$')) {
			return true
		}

		return compact.matches(
				'^\\(?[+-]?0([\\.,]0+)?\\)?$'
				)
	}


	private boolean isRowEmpty(
			Row row,
			DataFormatter formatter) {

		if (row == null ||
				row.getLastCellNum() <= 0) {

			return true
		}

		for (int columnIndex = 0;
				columnIndex < row.getLastCellNum();
				columnIndex++) {

			Cell cell =
					row.getCell(columnIndex)

			if (cell == null) {
				continue
			}

			if (!formatter
					.formatCellValue(cell)
					.trim()
					.isEmpty()) {

				return false
			}
		}

		return true
	}


	private void appendColumnValueSummary(
			StringBuilder passedDetails,
			String environment,
			String columnName,
			Integer numericValues,
			Integer zeroValues,
			Integer nonZeroValues,
			boolean onlyZeroValues,
			BigDecimal sum,
			BigDecimal minimum,
			BigDecimal maximum) {

		if (onlyZeroValues) {
			passedDetails.append('[INFO] ')
					.append(environment)
					.append(
					' column contains only zero values.\n'
					)
					.append('Column: ')
					.append(columnName)
					.append('\nNumeric values read: ')
					.append(numericValues)
					.append('\nZero values: ')
					.append(zeroValues)
					.append('\nSum: ')
					.append(sum)
					.append('\nMinimum: ')
					.append(minimum)
					.append('\nMaximum: ')
					.append(maximum)
					.append('\n')

			return
		}

		passedDetails.append('[INFO] ')
				.append(environment)
				.append(
				' column contains numeric values.\n'
				)
				.append('Column: ')
				.append(columnName)
				.append('\nNumeric values read: ')
				.append(numericValues)
				.append('\nZero values: ')
				.append(zeroValues)
				.append('\nNon-zero values: ')
				.append(nonZeroValues)
				.append('\n')
	}


	private void appendComparison(
			StringBuilder errors,
			StringBuilder passedDetails,
			String validationLabel,
			String columnName,
			BigDecimal recValue,
			BigDecimal prdValue) {

		if (recValue == null ||
				prdValue == null) {

			errors.append('[ERROR] ')
					.append(validationLabel)
					.append(
					' could not be compared.\n'
					)

			return
		}

		if (recValue.compareTo(prdValue) != 0) {
			errors.append('[ERROR] ')
					.append(validationLabel)
					.append(' is different.\n')
					.append('Column: ')
					.append(columnName)
					.append('\nREC: ')
					.append(recValue)
					.append('\nPRD: ')
					.append(prdValue)
					.append('\n')
		} else {
			passedDetails.append('[PASS] ')
					.append(validationLabel)
					.append(' is equal.\n')
					.append('Column: ')
					.append(columnName)
					.append('\nValue: ')
					.append(recValue)
					.append('\n')
		}
	}


	private BigDecimal parseNumber(
			String value) {

		String text =
				safeText(value)

		if (text.isEmpty()) {
			return null
		}

		text = text
				.replace('\u00A0', ' ')
				.replace('\u202F', ' ')
				.replace('\u2212', '-')
				.replace('\u2012', '-')
				.replace('\u2013', '-')
				.replace('\u2014', '-')
				.replace('\u2015', '-')
				.trim()

		boolean negativeByParentheses =
				text.startsWith('(') &&
				text.endsWith(')')

		boolean negativeByTrailingMinus =
				text.endsWith('-')

		text = text
				.replaceAll(
				'[^0-9,\\.\\-\\(\\)]',
				''
				)
				.replace('(', '')
				.replace(')', '')

		if (negativeByTrailingMinus &&
				text.endsWith('-')) {

			text = text.substring(
					0,
					text.length() - 1
					)
		}

		boolean negative =
				text.startsWith('-') ||
				negativeByParentheses ||
				negativeByTrailingMinus

		text = text.replace('-', '')

		if (text.isEmpty()) {
			return null
		}

		String normalizedNumber =
				normalizeNumericSeparators(text)

		if (normalizedNumber.isEmpty()) {
			return null
		}

		try {
			BigDecimal result =
					new BigDecimal(
					normalizedNumber
					)

			if (negative &&
					result.compareTo(
					BigDecimal.ZERO
					) > 0) {

				result = result.negate()
			}

			return result
		} catch (Exception ignored) {
			return null
		}
	}


	private String normalizeNumericSeparators(
			String value) {

		int commaCount =
				countOccurrences(
				value,
				','
				)

		int dotCount =
				countOccurrences(
				value,
				'.'
				)

		if (commaCount > 0 &&
				dotCount > 0) {

			int lastComma =
					value.lastIndexOf(',')

			int lastDot =
					value.lastIndexOf('.')

			if (lastComma > lastDot) {
				return value
						.replace('.', '')
						.replace(',', '.')
			}

			return value.replace(',', '')
		}

		if (commaCount > 0) {
			return normalizeSingleSeparatorNumber(
					value,
					','
					)
		}

		if (dotCount > 0) {
			return normalizeSingleSeparatorNumber(
					value,
					'.'
					)
		}

		return value
	}


	private String normalizeSingleSeparatorNumber(
			String value,
			String separator) {

		int separatorCount =
				countOccurrences(
				value,
				separator
				)

		if (separatorCount == 0) {
			return value
		}

		if (separatorCount > 1) {
			int lastSeparator =
					value.lastIndexOf(
					separator
					)

			String decimals =
					value.substring(
					lastSeparator + 1
					)

			if (decimals.length() == 1 ||
					decimals.length() == 2) {

				String integerPart =
						value
						.substring(
						0,
						lastSeparator
						)
						.replace(
						separator,
						''
						)

				return integerPart +
						'.' +
						decimals
			}

			return value.replace(
					separator,
					''
					)
		}

		int separatorIndex =
				value.indexOf(separator)

		String before =
				value.substring(
				0,
				separatorIndex
				)

		String after =
				value.substring(
				separatorIndex + 1
				)

		if (after.length() == 3 &&
				before.length() >= 1 &&
				before.length() <= 3) {

			return before + after
		}

		if (separator == ',') {
			return before +
					'.' +
					after
		}

		return value
	}


	private BigDecimal round2(
			BigDecimal value) {

		if (value == null) {
			return null
		}

		return value.setScale(
				2,
				RoundingMode.HALF_EVEN
				)
	}


	private int countOccurrences(
			String text,
			String token) {

		int count = 0
		int index = 0

		while (index >= 0) {
			index = text.indexOf(
					token,
					index
					)

			if (index >= 0) {
				count++

				index +=
						token.length()
			}
		}

		return count
	}


	private String normalizeText(
			Object value) {

		String text =
				safeText(value)

		if (text.isEmpty()) {
			return ''
		}

		text = Normalizer.normalize(
				text,
				Normalizer.Form.NFD
				)

		text = text.replaceAll(
				'\\p{InCombiningDiacriticalMarks}+',
				''
				)

		return text
				.toLowerCase()
				.replace(' ', '_')
				.replace('-', '_')
				.replaceAll('_+', '_')
				.trim()
	}


	private String safeText(
			Object value) {

		if (value == null) {
			return ''
		}

		return value
				.toString()
				.trim()
	}


	private void closeWorkbook(
			Workbook workbook) {

		try {
			if (workbook != null) {
				workbook.close()
			}
		} catch (Exception ignored) {
		}
	}


	private void closeInput(
			FileInputStream input) {

		try {
			if (input != null) {
				input.close()
			}
		} catch (Exception ignored) {
		}
	}

	// ======================================================
	// SYNTHÈSE REC X PRD EXPORT VALIDATION
	// ======================================================

	@Keyword
	Map validateSyntheseRecPrdExports(String recFilePath, String prdFilePath) {
		File recFile = validateSyntheseExcelFile(recFilePath, 'REC Synthèse export')
		File prdFile = validateSyntheseExcelFile(prdFilePath, 'PRD Synthèse export')
		Map recData = readSyntheseWorkbookData(recFile, 'REC')
		Map prdData = readSyntheseWorkbookData(prdFile, 'PRD')

		List<String> errors = []
		List<String> passedDetails = []

		appendSyntheseIntegerComparison('Number of table headers', recData.headerCount as Integer, prdData.headerCount as Integer, errors, passedDetails)
		appendSyntheseHeaderComparison(recData.headers as List<String>, prdData.headers as List<String>, errors, passedDetails)
		appendSyntheseIntegerComparison('Number of data rows', recData.dataRows as Integer, prdData.dataRows as Integer, errors, passedDetails)
		appendSyntheseIntegerComparison('Numeric data count', recData.numericValueCount as Integer, prdData.numericValueCount as Integer, errors, passedDetails)
		appendSyntheseDecimalComparison('Numeric data checksum', recData.numericChecksum as BigDecimal, prdData.numericChecksum as BigDecimal, errors, passedDetails)

		Map result = [
			success: errors.isEmpty(),
			recFileName: recFile.name, prdFileName: prdFile.name,
			recFilePath: recFile.absolutePath, prdFilePath: prdFile.absolutePath,
			recHeaders: recData.headerCount, prdHeaders: prdData.headerCount,
			recRows: recData.dataRows, prdRows: prdData.dataRows,
			recNumericValueCount: recData.numericValueCount, prdNumericValueCount: prdData.numericValueCount,
			recNumericChecksum: recData.numericChecksum, prdNumericChecksum: prdData.numericChecksum,
			passedDetails: passedDetails.join('\n'), errors: errors.join('\n')
		]

		if (!errors.isEmpty()) {
			KeywordUtil.markFailedAndStop('Synthèse REC x PRD export validation failed.\n\n' + result.errors)
			return result
		}

		KeywordUtil.logInfo('[PASS] Synthèse REC x PRD export validation completed.\n' + result.passedDetails)
		return result
	}

	private Map readSyntheseWorkbookData(File file, String environment) {
		FileInputStream input = null
		Workbook workbook = null
		try {
			input = new FileInputStream(file)
			workbook = WorkbookFactory.create(input)
			if (workbook.numberOfSheets <= 0) {
				throw new IllegalStateException(environment + ' Synthèse export does not contain worksheets.')
			}

			Sheet sheet = workbook.getSheetAt(0)
			DataFormatter formatter = new DataFormatter()
			FormulaEvaluator evaluator = workbook.creationHelper.createFormulaEvaluator()
			Integer headerRowIndex = findSyntheseHeaderRowIndex(sheet, formatter, evaluator)
			Row headerRow = sheet.getRow(headerRowIndex)
			List<String> headers = readSyntheseRowValues(headerRow, formatter, evaluator)
			Integer dataRows = 0
			Integer numericValueCount = 0
			BigDecimal numericChecksum = BigDecimal.ZERO

			for (Integer rowIndex = headerRowIndex + 1; rowIndex <= sheet.lastRowNum; rowIndex++) {
				Row row = sheet.getRow(rowIndex)
				if (row == null) continue
				List<String> rowValues = readSyntheseRowValues(row, formatter, evaluator)
				if (isSyntheseEmptyRow(rowValues)) continue
				dataRows++

				for (Integer columnIndex = 0; columnIndex < row.lastCellNum; columnIndex++) {
					BigDecimal value = readSyntheseNumericValue(row.getCell(columnIndex), formatter, evaluator)
					if (value == null) continue
					numericChecksum = numericChecksum.add(value)
					numericValueCount++
				}
			}

			return [
				headers: headers,
				headerCount: headers.findAll { String header -> !safeText(header).isEmpty() }.size(),
				dataRows: dataRows, numericValueCount: numericValueCount,
				numericChecksum: numericChecksum.setScale(2, RoundingMode.HALF_EVEN)
			]
		} finally {
			closeWorkbook(workbook)
			closeInput(input)
		}
	}

	private Integer findSyntheseHeaderRowIndex(Sheet sheet, DataFormatter formatter, FormulaEvaluator evaluator) {
		Integer bestRowIndex = 0
		Integer bestFilledCells = 0
		Integer maxRowIndex = Math.min(sheet.lastRowNum, 30)
		for (Integer rowIndex = 0; rowIndex <= maxRowIndex; rowIndex++) {
			Row row = sheet.getRow(rowIndex)
			if (row == null) continue
			List<String> values = readSyntheseRowValues(row, formatter, evaluator)
			Integer filledCells = values.findAll { String value -> !safeText(value).isEmpty() }.size()
			if (filledCells > bestFilledCells) {
				bestFilledCells = filledCells; bestRowIndex = rowIndex
			}
		}
		return bestRowIndex
	}

	private List<String> readSyntheseRowValues(Row row, DataFormatter formatter, FormulaEvaluator evaluator) {
		List<String> values = []
		if (row == null || row.lastCellNum < 0) return values
		for (Integer columnIndex = 0; columnIndex < row.lastCellNum; columnIndex++) {
			Cell cell = row.getCell(columnIndex)
			try {
				values.add(cell == null ? '' : formatter.formatCellValue(cell, evaluator).trim())
			}
			catch (Throwable ignored) {
				values.add('')
			}
		}
		return values
	}

	private BigDecimal readSyntheseNumericValue(Cell cell, DataFormatter formatter, FormulaEvaluator evaluator) {
		if (cell == null) return null
		try {
			if (cell.cellType == CellType.NUMERIC) return BigDecimal.valueOf(cell.numericCellValue)
			if (cell.cellType == CellType.FORMULA) {
				CellValue evaluated = evaluator.evaluate(cell)
				if (evaluated != null && evaluated.cellType == CellType.NUMERIC) return BigDecimal.valueOf(evaluated.numberValue)
			}
			return parseNumber(formatter.formatCellValue(cell, evaluator))
		} catch (Throwable ignored) {
			return null
		}
	}

	private void appendSyntheseIntegerComparison(String label, Integer recValue, Integer prdValue, List<String> errors, List<String> passedDetails) {
		if (recValue != prdValue) {
			errors.add('[ERROR] ' + label + ' is different.\nREC: ' + recValue + '\nPRD: ' + prdValue); return
		}
		passedDetails.add('[PASS] ' + label + ' is equal: ' + recValue)
	}

	private void appendSyntheseHeaderComparison(List<String> recHeaders, List<String> prdHeaders, List<String> errors, List<String> passedDetails) {
		Integer maximumHeaders = Math.max(recHeaders.size(), prdHeaders.size())
		List<String> differences = []
		for (Integer index = 0; index < maximumHeaders; index++) {
			String recHeader = index < recHeaders.size() ? recHeaders[index] : ''
			String prdHeader = index < prdHeaders.size() ? prdHeaders[index] : ''
			if (!normalizeText(recHeader).equals(normalizeText(prdHeader))) {
				differences.add('Column ' + (index + 1) + ': REC "' + recHeader + '" | PRD "' + prdHeader + '"')
			}
		}
		if (!differences.isEmpty()) {
			errors.add('[ERROR] Table headers do not match.\n' + differences.join('\n')); return
		}
		passedDetails.add('[PASS] Table headers match in the same order.')
	}

	private void appendSyntheseDecimalComparison(String label, BigDecimal recValue, BigDecimal prdValue, List<String> errors, List<String> passedDetails) {
		if (recValue == null || prdValue == null || recValue.compareTo(prdValue) != 0) {
			errors.add('[ERROR] ' + label + ' is different.\nREC: ' + recValue + '\nPRD: ' + prdValue)
			return
		}
		passedDetails.add('[PASS] ' + label + ' is equal: ' + recValue)
	}

	private File validateSyntheseExcelFile(String filePath, String description) {
		String path = safeText(filePath)
		File file = new File(path)
		if (path.isEmpty() || !file.exists() || !file.isFile()) {
			KeywordUtil.markFailedAndStop(description + ' was not found:\n' + file.absolutePath)
			return file
		}
		if (file.length() <= 0L) KeywordUtil.markFailedAndStop(description + ' is empty: ' + file.name)
		return file
	}

	private Boolean isSyntheseEmptyRow(List<String> values) {
		return values == null || values.isEmpty() || values.every { String value -> safeText(value).isEmpty() }
	}
