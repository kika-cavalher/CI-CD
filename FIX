		<div class="section-title failed-title">❌ Failed (${suiteData.failed})</div>
		${failedBlock.toString().trim().isEmpty() ? '<div class="empty-block">No failed tests.</div>' : failedBlock.toString()}
	</div>

	<div class="section">
		<div class="section-title passed-title">✅ Passed (${suiteData.passed})</div>
		${passedBlock.toString().trim().isEmpty() ? '<div class="empty-block">No passed tests.</div>' : passedBlock.toString()}
	</div>
</div>
</body>
</html>
"""
	}

	String buildGaiaReport() {
		String xmlPath = getXmlFilePath()

		if (isBlank(xmlPath)) {
			KeywordUtil.logInfo("Gaia HTML report was not created because XML file was not found.")
			return null
		}

		String reportPath = getResolvedReportPath()

		if (isBlank(reportPath)) {
			KeywordUtil.logInfo("Gaia HTML report was not created because report folder was not found.")
			return null
		}

		File gaiaFolder = new File(reportPath + File.separator + GAIA_REPORT_FOLDER_NAME)

		if (!gaiaFolder.exists()) {
			gaiaFolder.mkdirs()
		}

		Map suiteData = parseJUnitSuite(xmlPath)
		String html = buildGaiaReportHtml(suiteData)

		File htmlFile = new File(gaiaFolder, HTML_REPORT_NAME)
		htmlFile.write(html, 'UTF-8')

		KeywordUtil.logInfo("Gaia HTML report created successfully: ${htmlFile.absolutePath}")
		return htmlFile.absolutePath
	}

