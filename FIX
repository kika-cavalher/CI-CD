boolean waitUntilFileReady(String filePath, int maxAttempts = 10, int sleepMillis = 700) {
	if (isBlank(filePath)) {
		return false
	}

	File file = new File(filePath)
	if (!file.exists()) {
		return false
	}

	for (int i = 1; i <= maxAttempts; i++) {
		try {
			RandomAccessFile raf = new RandomAccessFile(file, 'r')
			try {
				long size = raf.length()
				if (size >= 0) {
					return true
				}
			} finally {
				raf.close()
			}
		} catch (Exception ignored) {
		}

		Thread.sleep(sleepMillis)
	}

	return false
}

String createSafeUploadCopy(String originalFilePath, String targetName) {
	if (isBlank(originalFilePath)) {
		return ''
	}

	File original = new File(originalFilePath)
	if (!original.exists() || original.length() == 0) {
		return ''
	}

	String reportFolder = getResolvedReportPath()
	File tempFolder = new File(reportFolder + File.separator + '_jira_upload_tmp')
	if (!tempFolder.exists()) {
		tempFolder.mkdirs()
	}

	File safeCopy = new File(tempFolder, targetName)

	if (safeCopy.exists()) {
		safeCopy.delete()
	}

	Files.copy(original.toPath(), safeCopy.toPath(), StandardCopyOption.REPLACE_EXISTING)

	return safeCopy.absolutePath
}

String getShortErrorLog(String stackTrace) {
	if (isBlank(stackTrace)) {
		return ''
	}

	List<String> lines = stackTrace
		.readLines()
		.findAll { !isBlank(it) }
		.collect { it.trim() }

	List<String> important = []

	for (String line : lines) {
		String lower = line.toLowerCase()

		if (
			lower.contains('exception')
			|| lower.contains('error')
			|| lower.contains('caused by')
			|| lower.contains('stepfailedexception')
			|| lower.contains('timed out')
			|| lower.contains('not clickable')
			|| lower.contains('not found')
			|| lower.contains('unable')
			|| lower.contains('failed')
		) {
			important.add(line)
		}

		if (important.size() >= 3) {
			break
		}
	}

	if (important.isEmpty()) {
		important = lines.take(3)
	}

	return important.join('\n')
}

String buildFailureCardHtml(Map item) {
