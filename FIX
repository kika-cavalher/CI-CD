    private long parseMarkerTime(String value) {
        try {
            return REPORT_MARKER_TIME.parse(safe(value)).time
        } catch (Throwable ignored) {
            return 0L
        }
    }

    private long parseDurationMillis(String value) {
        String text = safe(value)
        if (text.isEmpty()) {
            return 0L
        }

        try {
            return Math.round(Double.parseDouble(text.replace(',', '.')) * 1000d)
        } catch (Throwable ignored) {
            return 0L
        }
    }

    private String formatDateTime(long millis) {
        if (millis <= 0L) {
            return '--'
        }

        return OUTPUT_DATE_TIME.format(new Date(millis))
    }

    private String formatClock(long millis) {
        if (millis <= 0L) {
            return '--'
        }

        return OUTPUT_CLOCK.format(new Date(millis))
    }

    private String formatDuration(long durationMs) {
        if (durationMs < 0L) {
            durationMs = 0L
        }

        long totalSeconds = Math.round(durationMs / 1000.0d)
        long hours = (long) (totalSeconds / 3600L)
        long minutes = (long) ((totalSeconds % 3600L) / 60L)
        long seconds = (long) (totalSeconds % 60L)

        return String.format(Locale.ENGLISH, '%02dh %02dm %02ds', hours, minutes, seconds)
    }

    private List<String> readLines(File file) {
        try {
            return file.readLines('UTF-8')
        } catch (Throwable ignored) {
            try {
                return file.readLines()
            } catch (Throwable ignoredAgain) {
                return []
            }
        }
    }

    private String textAttr(GPathResult node, String attr) {
        try {
