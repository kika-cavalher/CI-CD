def safeFileName(String value) {
    return (value ?: '').replaceAll(/[^A-Za-z0-9._ -]/, '').replace(' ', '_')
}

def bootstrapSupportFiles(script) {
    script.deleteDir()

    script.checkout([
        $class: 'GitSCM',
        branches: [[name: script.env.GIT_BRANCH]],
        userRemoteConfigs: [[url: script.env.GIT_URL, credentialsId: script.env.GIT_CRED]],
        extensions: [
            [$class: 'CloneOption', shallow: false, noTags: false, timeout: 30],
            [$class: 'SparseCheckoutPaths', sparseCheckoutPaths: [
                [path: 'jenkinsPipelines'],
                [path: 'jenkinsIntegration']
            ]]
        ]
    ])
}

def fullCheckout(script) {
    script.deleteDir()

    script.checkout([
        $class: 'GitSCM',
        branches: [[name: script.env.GIT_BRANCH]],
        userRemoteConfigs: [[url: script.env.GIT_URL, credentialsId: script.env.GIT_CRED]],
        extensions: [
            [$class: 'CloneOption', shallow: false, noTags: false, timeout: 30]
        ]
    ])
}

