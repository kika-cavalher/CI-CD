					'Image key: iconeModal\n' +
					'Timeout: ' +
					OPEN_FILE_MODAL_TIMEOUT_SECONDS +
					' seconds.'
				)

		String detectedModalImage = null

		if (imageLoader.waitForImage(
				GENERAL_IMAGE_GROUP,
					'iconeModal',
					OPEN_FILE_MODAL_TIMEOUT_SECONDS
				)) {

			detectedModalImage =
					'iconeModal'
		}

		if (detectedModalImage == null) {

			logInfo(
					'REC open-file modal was not found.\n' +
						'Searching for PRD open-file modal.\n' +
						'Image key: iconeModalPRD\n' +
						'Timeout: ' +
						OPEN_FILE_MODAL_TIMEOUT_SECONDS +
						' seconds.'
					)

			if (imageLoader.waitForImage(
					GENERAL_IMAGE_GROUP,
						'iconeModalPRD',
						OPEN_FILE_MODAL_TIMEOUT_SECONDS
					)) {

				detectedModalImage =
						'iconeModalPRD'
			}
		}

		if (detectedModalImage == null) {

			imageLoader.takeEvidence(
					'OpenFileModalNotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					'Open-file modal was not found.\n' +
						'REC image: ' +
						GENERAL_IMAGE_GROUP +
						'/iconeModal\n' +
						'PRD image: ' +
						GENERAL_IMAGE_GROUP +
						'/iconeModalPRD\n' +
						'Timeout per image: ' +
						OPEN_FILE_MODAL_TIMEOUT_SECONDS +
						' seconds.'
					)

			return
		}

		logInfo(
				'Open-file modal detected.\n' +
					'Image key: ' +
					detectedModalImage + '\n' +
					'Closing modal with TAB and ENTER.'
				)

		try {
			Robot robot = new Robot()

			robot.setAutoDelay(150)

			robot.keyPress(
					KeyEvent.VK_TAB
					)

			robot.keyRelease(
					KeyEvent.VK_TAB
					)

			Windows.delay(
					SHORT_UI_DELAY_SECONDS
					)

			robot.keyPress(
					KeyEvent.VK_ENTER
					)

			robot.keyRelease(
					KeyEvent.VK_ENTER
					)
