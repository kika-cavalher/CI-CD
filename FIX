import java.util.Date
import java.util.Locale
import java.net.URI

class JiraHtmlTemplateBuilder {

    private static final String APP_NAME = 'EMATCH'
    private static final String REPORT_TITLE_PREFIX = 'Test report - '

    /*
     * Troque somente esta variável se quiser mudar o logo.
