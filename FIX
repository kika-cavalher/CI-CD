	private String buildAutomaticExportFileName(
			String environment,
			String featureName,
			String exportLabelSuffix) {

		String timestamp =
				new SimpleDateFormat(
				'yyyyMMdd_HHmmss'
				).format(
				new Date()
				)

		String safeEnvironment = shortenFilePart(
				sanitizeFileName(
				environment == null ||
					environment.trim().isEmpty()
						? 'REC'
						: environment
				),
				6
				)

		String safeFeatureName = shortenFilePart(
				sanitizeFileName(
				featureName == null ||
					featureName.trim().isEmpty()
						? 'Export'
						: featureName
				),
				MAX_FEATURE_LENGTH
				)

		String safeExportLabelSuffix = shortenFilePart(
				sanitizeFileName(
				exportLabelSuffix == null
					? ''
					: exportLabelSuffix
				),
				MAX_LABEL_LENGTH
				)

		String baseFileName =
				safeEnvironment +
				'_' +
				timestamp +
				'_' +
				safeFeatureName

		if (safeExportLabelSuffix != null &&
				!safeExportLabelSuffix.trim().isEmpty() &&
				safeExportLabelSuffix != 'Export') {

			baseFileName +=
					'_' +
					safeExportLabelSuffix
		}

		return baseFileName +
				'.xlsx'
	}


	private String resolveExportLabelSuffixForFileName(
			String exportLabel) {

		if (exportLabel == null ||
				exportLabel.trim().isEmpty()) {

			return ''
		}

		String value =
				sanitizeFileName(
				exportLabel
				)

		value = value.replaceFirst(
				'(?i)^REC_',
					''
				)

		value = value.replaceFirst(
				'(?i)^PRD_',
					''
				)

		value = value.replaceFirst(
				'(?i)^REC-',
					''
				)

		value = value.replaceFirst(
				'(?i)^PRD-',
					''
				)

		value = value.replaceFirst(
				'(?i)^REC ',
					''
				)

		value = value.replaceFirst(
				'(?i)^PRD ',
					''
				)

		return value == null ||
				value.trim().isEmpty()
					? ''
					: value
	}


	// ======================================================
	// ENVIRONMENT
	// ======================================================

	private String resolveEnvironmentName(
			String targetEnvironment,
			String exportLabel) {

		String environment =
				normalizeEnvironmentNameStrict(
				targetEnvironment
				)

		if (environment != null) {
			return environment
		}

		List<String> globalVariableNames = [
			'targetEnvironment',
			'currentEnvironment',
			'environment',
			'env',
			'ENV',
			'currentEnv',
			'environmentName'
		]

		for (String variableName : globalVariableNames) {

			environment =
					normalizeEnvironmentNameStrict(
					getGlobalVariableValue(
					variableName
					)
					)

			if (environment != null) {
				return environment
			}
		}

		environment =
				normalizeEnvironmentNameStrict(
				RunConfiguration
				.getExecutionProfile()
				)

		if (environment != null) {
			return environment
		}

		environment =
				normalizeEnvironmentNamePrefixOnly(
				exportLabel
				)

		return environment == null
					? 'REC'
					: environment
	}


	private String normalizeEnvironmentNameStrict(
			String rawEnvironment) {

		if (rawEnvironment == null ||
				rawEnvironment.trim().isEmpty()) {

			return null
		}

		String value =
				rawEnvironment
				.trim()
				.toUpperCase()

		if (value == 'PRD' ||
				value == 'PROD' ||
				value == 'PRODUCTION' ||
				value.startsWith('PRD_') ||
				value.startsWith('PRD-') ||
				value.startsWith('PRD ')) {

			return 'PRD'
		}

		if (value == 'REC' ||
				value == 'RECETTE' ||
				value.startsWith('REC_') ||
				value.startsWith('REC-') ||
				value.startsWith('REC ')) {

			return 'REC'
		}

		return null
	}


	private String normalizeEnvironmentNamePrefixOnly(
			String rawEnvironment) {

		return normalizeEnvironmentNameStrict(
				rawEnvironment
				)
	}


	private String getGlobalVariableValue(
			String variableName) {

		try {
			def value =
					GlobalVariable."${variableName}"

			if (value != null &&
					!value
					.toString()
					.trim()
					.isEmpty()) {

				return value.toString()
			}
		} catch (Exception ignored) {
		}

		return null
	}


