	private void validateBottomBar(
		Integer timeout,
		List<String> errors
	) {

		logObjectSearch(
			'bottomBarFields',
			'Bottom bar information'
		)

		WindowsTestObject bottomBarFields = object(
			'bottomBarFields'
		)

		List<RemoteWebElement> fields = []

		try {
			fields = Windows.findElements(
				bottomBarFields,
			) as List<RemoteWebElement>
		} catch (Exception e) {
			errors.add(
				'Bottom bar elements could not be read.'
			)

			KeywordUtil.logInfo(
				'[FAIL] Bottom bar elements could not be read.\n' +
				'Reason: ' + safeMessage(e)
			)

			return
		}

		List<String> values = fields.collect {
			RemoteWebElement element ->
				safeText(element?.getText())
		}.findAll {
			String value ->
				!value.isEmpty()
		}

		KeywordUtil.logInfo(
			'[INFO] Bottom bar values found: ' + values
		)

		if (values.isEmpty()) {
			errors.add(
				'Bottom bar does not contain readable information.'
			)

			KeywordUtil.logInfo(
				'[FAIL] Bottom bar contains no readable information.'
			)

			return
		}

		boolean environmentFound = values.any {
			String value ->
				value.equalsIgnoreCase('Recette') ||
				value.equalsIgnoreCase('Production') ||
				value.equalsIgnoreCase('REC') ||
				value.equalsIgnoreCase('PRD')
		}

		boolean closingDateFound = values.any {
			String value ->
				value ==~ /.*\d{2}\/\d{2}\/\d{4}.*/
		}

		boolean currencyFound = values.any {
			String value ->
				value ==~ /(?i).*\b[A-Z]{3}\b.*/
		}

		boolean userInformationFound = values.size() >= 3

		reportBooleanResult(
			environmentFound,
			'Environment is displayed in the bottom bar.',
			'Environment is not displayed in the bottom bar.',
			errors
		)

		reportBooleanResult(
			closingDateFound,
			'Closing date is displayed in the bottom bar.',
			'Closing date is not correctly displayed.',
			errors
		)

		reportBooleanResult(
			currencyFound,
			'Currency is displayed in the bottom bar.',
			'Currency is not correctly displayed.',
			errors
		)

		reportBooleanResult(
			userInformationFound,
			'Bottom bar contains user and application information.',
			'Bottom bar user information is incomplete.',
			errors
		)
	}


