private String resolveExistingTestPlanKey(String projectKey, String epicKey, String testPlanTitle) {
    List<Map> candidates = []

    if (!isBlank(epicKey)) {
        candidates.addAll(searchIssuesByJql(buildExactTestPlanJql(projectKey, epicKey, testPlanTitle)))
    }

    if (candidates.isEmpty()) {
        candidates.addAll(searchIssuesByJql(buildExactTestPlanJql(projectKey, '', testPlanTitle)))
    }

    if (candidates.isEmpty()) {
        return ''
    }

    List<Map> exactMatches = candidates.findAll { Map issue ->
        normalizeSummary(issue?.fields?.summary) == normalizeSummary(testPlanTitle)
    }

    if (exactMatches.isEmpty()) {
        return ''
    }

    exactMatches.sort { Map issue ->
        safeValue(issue?.fields?.created)
    }

    return safeValue(exactMatches.first()?.key)
}

private String buildExactTestPlanJql(String projectKey, String epicKey, String testPlanTitle) {
    StringBuilder jql = new StringBuilder()

    jql.append('project = "').append(escapeJql(projectKey)).append('" ')
    jql.append('AND issuetype = "Test Plan" ')
    jql.append('AND summary ~ "\\"').append(escapeJql(testPlanTitle)).append('\\"" ')

    if (!isBlank(epicKey)) {
        jql.append('AND "Epic Link" = "').append(escapeJql(epicKey)).append('" ')
    }

    jql.append('ORDER BY created ASC')

    return jql.toString()
}

private String normalizeSummary(def value) {
    return safeValue(value)
        .toLowerCase(Locale.ENGLISH)
        .replaceAll(/\s+/, ' ')
        .trim()
}

private String escapeJql(def value) {
    return safeValue(value).replace('"', '\\"')
}
Important

searchIssuesByJql(...) above should call your existing Jira search REST helper.
If your project already has a method that searches Jira with JQL, keep that one and just use it here.

Why this fixes it

first it searches inside the Epic

if nothing is found, it searches in the project

then it compares by normalized exact summary

if it finds one, it reuses

only creates a new one when there is truly none

