package commands

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.driver.WindowsDriverFactory
import com.kms.katalon.core.windows.keyword.helper.WindowsActionHelper

class ImageLoader {

	private static final Map<String, Map<String, String>> IMAGE_GROUPS = [
		'authentication': [
			'homeGrey'  : 'Images/General/HomeGrey.PNG',
			'homeWhite' : 'Images/General/HomeWhite.PNG',
			'home'      : 'Images/General/Home.PNG'
		],

		'ModuleDesResponsabilite': [
			'menuImage': 'Images/BDR/CubeBalanceDesResponsabilites.PNG'
		],

		'ModuleDesResponsabiliteExport_Rec': [
			'allRow'          : 'Images/BDR/AllRow_Rec.png',
			'expandArrow'     : 'Images/BDR/ExpandArrow_Rec.png',
			'lastRowArrow'    : 'Images/BDR/lastRowArrow_Rec.png',
			'isAllOpen'       : 'Images/BDR/isAllOpen_Rec.png',
			'totalCurrentYear': 'Images/BDR/totalCurrentYear_Rec.png'
		],

		'ModuleDesResponsabiliteExport_PROD': [
			'allRow'          : 'Images/BDR/AllRow_PROD.png',
			'expandArrow'     : 'Images/BDR/ExpandArrow_PROD.png',
			'lastRowArrow'    : 'Images/BDR/lastRowArrow_PROD.png',
			'isAllOpen'       : 'Images/BDR/isAllOpen_PROD.png',
			'totalCurrentYear': 'Images/BDR/totalCurrentYear_PROD.png'
		],

		'ModuleDesResponsabiliteDimensions_Rec': [
			'firstDimension'     : 'Images/BDR/measures.PNG',
			'lastDimension'      : 'Images/BDR/provic.png',
			'provicOpen'         : 'Images/BDR/provicOpen.png',
			'normeOpen'          : 'Images/BDR/normeOpen.png',
			'endOfDimensions'    : 'Images/BDR/endOfDimensions.PNG',
			'startOfDimensions'  : 'Images/BDR/startOfDimensions_Rec.PNG',
			'firstPageRef'       : 'Images/BDR/FirstPageOfDimensionsRec.PNG',
			'secondPageRef'      : 'Images/BDR/SecondPageOfDimensionsRec.PNG',
			'thirdPageRef'       : 'Images/BDR/ThirdPageOfDimensionsRec.PNG',
			'zoneLignes'         : 'Images/BDR/ZoneLignes.PNG',
			'zoneLignesArrowDown': 'Images/BDR/ZoneLignes_arrowDown.PNG',
			'tableColWithArrows' : 'Images/BDR/tableWithArrows.png'
		],

		'ModuleDesResponsabiliteDimensions_PROD': [
			'firstDimension'     : 'Images/BDR/measures.PNG',
			'lastDimension'      : 'Images/BDR/provic.png',
			'provicOpen'         : 'Images/BDR/provicOpen.png',
			'normeOpen'          : 'Images/BDR/normeOpen.png',
			'endOfDimensions'    : 'Images/BDR/endOfDimensions.PNG',
			'startOfDimensions'  : 'Images/BDR/startOfDimensions_PROD.PNG',
			'firstPageRef'       : 'Images/BDR/FirstPageOfDimensionsPROD.PNG',
			'secondPageRef'      : 'Images/BDR/SecondPageOfDimensionsPROD.PNG',
			'thirdPageRef'       : 'Images/BDR/ThirdPageOfDimensionsPROD.PNG',
			'zoneLignes'         : 'Images/BDR/ZoneLignes.PNG',
			'zoneLignesArrowDown': 'Images/BDR/ZoneLignes_arrowDown.PNG',
			'tableColWithArrows' : 'Images/BDR/tableWithArrows.png'
		]
	]

	@Keyword
	String getImage(String imageGroup, String imageKey) {
		validateImageKey(imageGroup, imageKey)

		String relativePath = IMAGE_GROUPS[imageGroup][imageKey]
		File imageFile = resolveImageFileOrStop(imageGroup, imageKey, relativePath)

		return imageFile.getAbsolutePath()
	}

	@Keyword
	Map<String, String> getImages(String imageGroup) {
		validateGroup(imageGroup)

		Map<String, String> images = [:]

		IMAGE_GROUPS[imageGroup].each { String imageKey, String relativePath ->
			images[imageKey] = resolveImageFileOrStop(imageGroup, imageKey, relativePath).getAbsolutePath()
		}

		return images
	}

	@Keyword
	void validateGroupImagesExist(String imageGroup) {
		validateGroup(imageGroup)

		IMAGE_GROUPS[imageGroup].each { String imageKey, String relativePath ->
			resolveImageFileOrStop(imageGroup, imageKey, relativePath)
		}

		KeywordUtil.logInfo('All images exist for group: ' + imageGroup)
	}

	@Keyword
	boolean tryClickFirstVisibleInGroup(String imageGroup) {
		if (!IMAGE_GROUPS.containsKey(imageGroup)) {
			KeywordUtil.logInfo('Image group not found for optional click: ' + imageGroup)
			return false
		}

		for (String imageKey : IMAGE_GROUPS[imageGroup].keySet()) {
			String relativePath = IMAGE_GROUPS[imageGroup][imageKey]
			File imageFile = resolveImageFileOptional(relativePath)

			if (imageFile == null || !imageFile.exists()) {
				KeywordUtil.logInfo(
					'Optional image file not resolved. Group: ' + imageGroup + ', key: ' + imageKey + ', path: ' + relativePath
				)
				continue
			}

			try {
				if (isImageFound(WindowsImageKeywords.findImage(imageFile.getAbsolutePath()))) {
					WindowsImageKeywords.clickImage(imageFile.getAbsolutePath())

					KeywordUtil.logInfo(
						'Clicked optional visible image. Group: ' + imageGroup + ', key: ' + imageKey
					)

					return true
				}
			} catch (Exception e) {
				KeywordUtil.logInfo(
					'Optional image click failed. Group: ' + imageGroup + ', key: ' + imageKey + ', reason: ' + e.getMessage()
				)
			}
		}

		return false
	}

	@Keyword
	boolean isVisible(String imageGroup, String imageKey) {
		String imagePath = getImage(imageGroup, imageKey)

		try {
			return isImageFound(WindowsImageKeywords.findImage(imagePath))
		} catch (Exception e) {
			KeywordUtil.logInfo(
				'Image visibility check failed. Group: ' + imageGroup + ', key: ' + imageKey + ', reason: ' + e.getMessage()
			)

			return false
		}
	}

	@Keyword
	boolean waitForImage(String imageGroup, String imageKey, int timeoutSeconds) {
		String imagePath = getImage(imageGroup, imageKey)

		try {
			return WindowsImageKeywords.waitForImage(imagePath, timeoutSeconds)
		} catch (Exception e) {
			KeywordUtil.logInfo(
				'Wait for image failed. Group: ' + imageGroup + ', key: ' + imageKey + ', reason: ' + e.getMessage()
			)

			return false
		}
	}

	@Keyword
	void waitForImageOrStop(String imageGroup, String imageKey, int timeoutSeconds) {
		boolean found = waitForImage(
			imageGroup,
			imageKey,
			timeoutSeconds
		)

		if (!found) {
			takeEvidence('ImageNotVisible_' + sanitizeFileName(imageGroup + '_' + imageKey) + '.png')

			KeywordUtil.markFailedAndStop(
				'Image was found on disk, but was not visible on screen before timeout.\n' +
				'Group: ' + imageGroup + '\n' +
				'Key: ' + imageKey + '\n' +
				'Timeout: ' + timeoutSeconds + ' seconds\n' +
				'Path: ' + getImage(imageGroup, imageKey)
			)
		}
	}

	@Keyword
	void clickImageOrStop(String imageGroup, String imageKey) {
		String imagePath = getImage(imageGroup, imageKey)

		try {
			if (isImageFound(WindowsImageKeywords.findImage(imagePath))) {
				WindowsImageKeywords.clickImage(imagePath)
				KeywordUtil.logInfo('Clicked image: ' + imageGroup + ' / ' + imageKey)
				return
			}
		} catch (Exception e) {
			KeywordUtil.logInfo('Click image failed: ' + e.getMessage())
		}

		takeEvidence('ImageClickFailed_' + sanitizeFileName(imageGroup + '_' + imageKey) + '.png')

		KeywordUtil.markFailedAndStop(
			'Image was found on disk, but could not be clicked on screen.\n' +
			'Group: ' + imageGroup + '\n' +
			'Key: ' + imageKey + '\n' +
			'Path: ' + imagePath
		)
	}

	@Keyword
	void clickImageInsideImageOrStop(String imageGroup, String parentImageKey, String childImageKey) {
		String parentImage = getImage(imageGroup, parentImageKey)
		String childImage = getImage(imageGroup, childImageKey)

		try {
			WindowsImageKeywords.clickImageInImage(parentImage, childImage)
			KeywordUtil.logInfo('Clicked image inside image: ' + parentImageKey + ' / ' + childImageKey)
		} catch (Exception e) {
			takeEvidence('ImageInsideImageClickFailed_' + sanitizeFileName(imageGroup + '_' + parentImageKey + '_' + childImageKey) + '.png')

			KeywordUtil.markFailedAndStop(
				'Could not click image inside image.\n' +
				'Group: ' + imageGroup + '\n' +
				'Parent image: ' + parentImageKey + '\n' +
				'Child image: ' + childImageKey + '\n' +
				'Parent path: ' + parentImage + '\n' +
				'Child path: ' + childImage + '\n' +
				'Reason: ' + e.getMessage()
			)
		}
	}

	@Keyword
	void takeEvidence(String fileName) {
		try {
			String evidenceDir = RunConfiguration.getReportFolder() + '\\Evidences\\'
			new File(evidenceDir).mkdirs()

			WindowsActionHelper
				.create(WindowsDriverFactory.getWindowsSession())
				.takeScreenshot(evidenceDir + fileName)

			KeywordUtil.logInfo('Evidence captured: ' + evidenceDir + fileName)
		} catch (Exception e) {
			KeywordUtil.logInfo('Could not capture evidence: ' + e.getMessage())
		}
	}

	private File resolveImageFileOrStop(String imageGroup, String imageKey, String relativePath) {
		File imageFile = resolveImageFileOptional(relativePath)

		if (imageFile != null && imageFile.exists()) {
			return imageFile
		}

		File expectedFile = new File(RunConfiguration.getProjectDir(), normalizeRelativePath(relativePath))

		KeywordUtil.markFailedAndStop(
			'Image file not found.\n' +
			'Group: ' + imageGroup + '\n' +
			'Key: ' + imageKey + '\n' +
			'Expected relative path: ' + relativePath + '\n' +
			'Resolved absolute path: ' + expectedFile.getAbsolutePath() + '\n' +
			'Project dir: ' + RunConfiguration.getProjectDir() + '\n' +
			'Available files in folder:\n' + getAvailableFilesFromImageFolder(expectedFile)
		)

		return null
	}

	private File resolveImageFileOptional(String relativePath) {
		String normalizedRelativePath = normalizeRelativePath(relativePath)
		File exactFile = new File(RunConfiguration.getProjectDir(), normalizedRelativePath)

		if (exactFile.exists()) {
			return exactFile
		}

		File parentFolder = exactFile.getParentFile()

		if (parentFolder == null || !parentFolder.exists() || !parentFolder.isDirectory()) {
			return null
		}

		String expectedName = normalizeName(exactFile.getName())
		File[] files = parentFolder.listFiles()

		if (files == null) {
			return null
		}

		for (File file : files) {
			if (normalizeName(file.getName()) == expectedName) {
				return file
			}
		}

		return null
	}

	private String getAvailableFilesFromImageFolder(File expectedFile) {
		try {
			File parentFolder = expectedFile.getParentFile()

			if (parentFolder == null || !parentFolder.exists()) {
				return 'Folder not found: ' + parentFolder
			}

			File[] files = parentFolder.listFiles()

			if (files == null || files.length == 0) {
				return 'Folder is empty: ' + parentFolder.getAbsolutePath()
			}

			return files.collect { File file -> file.getName() }.sort().join('\n')
		} catch (Exception e) {
			return 'Could not list available files. Reason: ' + e.getMessage()
		}
	}

	private String normalizeRelativePath(String relativePath) {
		return relativePath
			.replace('/', File.separator)
			.replace('\\', File.separator)
			.trim()
	}

	private String normalizeName(String name) {
		return name
			.trim()
			.toLowerCase()
	}

	private String sanitizeFileName(String value) {
		return value.replaceAll('[^a-zA-Z0-9_\\-]', '_')
	}

	private boolean isImageFound(def imageResult) {
		return imageResult != null && imageResult != false
	}

	private void validateGroup(String imageGroup) {
		if (!IMAGE_GROUPS.containsKey(imageGroup)) {
			KeywordUtil.markFailedAndStop(
				'Image group not found: ' + imageGroup + '\n' +
				'Available groups: ' + IMAGE_GROUPS.keySet()
			)
		}
	}

	private void validateImageKey(String imageGroup, String imageKey) {
		validateGroup(imageGroup)

		if (!IMAGE_GROUPS[imageGroup].containsKey(imageKey)) {
			KeywordUtil.markFailedAndStop(
				'Image key not found: ' + imageKey + '\n' +
				'Group: ' + imageGroup + '\n' +
				'Available keys: ' + IMAGE_GROUPS[imageGroup].keySet()
			)
		}
	}
}





package commands

import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import java.awt.Robot
import java.awt.Toolkit
import java.awt.datatransfer.StringSelection
import java.awt.event.InputEvent
import java.awt.event.KeyEvent

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.testobject.WindowsTestObject.LocatorStrategy
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.driver.WindowsDriverFactory
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows
import com.kms.katalon.core.windows.keyword.helper.WindowsActionHelper

class MenuNavigator {

	private ImageLoader imageLoader = new ImageLoader()

	@Keyword
	def searchAndOpenMenu(String menuName, String imageGroup, String expectedObjectPath, int timeoutSeconds) {
		KeywordUtil.logInfo('Searching and opening menu: ' + menuName)

		WindowsTestObject searchBox = resolveSearchBox()

		clickElementCenterByCoordinates(searchBox)
		Windows.delay(1)

		clearFocusedField()
		pasteText(menuName)

		Windows.delay(3)

		boolean menuClickedByImage = imageLoader.tryClickFirstVisibleInGroup(imageGroup)

		if (!menuClickedByImage) {
			KeywordUtil.logInfo(
				'Menu image was not visible after search. Pressing ENTER once to open the selected search result.'
			)

			pressEnter()
			Windows.delay(3)
		}

		boolean expectedScreenOpened = waitForExpectedObject(expectedObjectPath, timeoutSeconds)

		if (!expectedScreenOpened) {
			takeEvidence('ExpectedScreenNotFound.png')

			KeywordUtil.markFailedAndStop(
				'Menu was not opened correctly.\n' +
				'Menu name: ' + menuName + '\n' +
				'Image group: ' + imageGroup + '\n' +
				'Expected object: ' + expectedObjectPath + '\n' +
				'The menu image was tried once only, then ENTER was pressed once. No retry loop was executed.'
			)
		}

		takeEvidence('OpenedScreen.png')

		KeywordUtil.logInfo('Menu opened successfully: ' + menuName)
	}

	private WindowsTestObject resolveSearchBox() {
		List<WindowsTestObject> candidates = []

		try {
			candidates.add(findWindowsObject('General/txtSearch'))
		} catch (Exception ignored) {
		}

		candidates.add(buildXpathObject("//*[contains(@Name,'Type keywords here')]"))
		candidates.add(buildXpathObject("//*[contains(@Name,'Type keywords')]"))
		candidates.add(buildXpathObject("//*[@LocalizedControlType='combo box' and contains(@Name,'Type')]"))
		candidates.add(buildXpathObject("//*[@LocalizedControlType='edit' and contains(@Name,'Type')]"))
		candidates.add(buildXpathObject("//*[contains(@ClassName,'ComboBox') and contains(@Name,'Type')]"))

		for (WindowsTestObject candidate : candidates) {
			try {
				boolean isPresent = Windows.verifyElementPresent(
					candidate,
					2,
					FailureHandling.OPTIONAL
				)

				if (isPresent) {
					KeywordUtil.logInfo('Search field found.')
					return candidate
				}
			} catch (Exception ignored) {
			}
		}

		takeEvidence('SearchFieldNotFound.png')

		KeywordUtil.markFailedAndStop(
			'Search field was not found.\n' +
			'Tried Object Repository: General/txtSearch\n' +
			'Tried dynamic XPath using Name: Type keywords here'
		)

		return null
	}

	private WindowsTestObject buildXpathObject(String xpath) {
		WindowsTestObject object = new WindowsTestObject()
		object.setLocatorStrategy(LocatorStrategy.XPATH)
		object.setLocator(xpath)

		return object
	}

	private boolean waitForExpectedObject(String expectedObjectPath, int timeoutSeconds) {
		String cleanPath = expectedObjectPath
			.replace('Object Repository/', '')
			.replace('Object Repository\\', '')

		try {
			return Windows.waitForElementPresent(
				findWindowsObject(cleanPath),
				timeoutSeconds,
				FailureHandling.OPTIONAL
			)
		} catch (Exception e) {
			KeywordUtil.logInfo(
				'Expected object validation failed. Object: ' + cleanPath + ', reason: ' + e.getMessage()
			)

			return false
		}
	}

	private void clickElementCenterByCoordinates(WindowsTestObject object) {
		def rect = Windows.getElementRect(object)

		int x = rect.getX() + Math.floor(rect.getWidth() / 2).intValue()
		int y = rect.getY() + Math.floor(getSafeHeight(rect) / 2).intValue()

		mouseClick(x, y)
	}

	private void clearFocusedField() {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_CONTROL)

		Windows.delay(1)

		robot.keyPress(KeyEvent.VK_BACK_SPACE)
		robot.keyRelease(KeyEvent.VK_BACK_SPACE)
	}

	private void pasteText(String text) {
		StringSelection selection = new StringSelection(text)
		Toolkit.getDefaultToolkit().getSystemClipboard().setContents(selection, null)

		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_V)
		robot.keyRelease(KeyEvent.VK_V)
		robot.keyRelease(KeyEvent.VK_CONTROL)
	}

	private void pressEnter() {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_ENTER)
		robot.keyRelease(KeyEvent.VK_ENTER)
	}

	private void mouseClick(int x, int y) {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.mouseMove(x, y)
		Windows.delay(1)

		robot.mousePress(InputEvent.BUTTON1_DOWN_MASK)
		Windows.delay(1)
		robot.mouseRelease(InputEvent.BUTTON1_DOWN_MASK)

		Windows.delay(1)
	}

	private int getSafeHeight(def rect) {
		int height = rect.getHeight()

		if (height <= 0) {
			return 20
		}

		return height
	}

	private void takeEvidence(String fileName) {
		try {
			String evidenceDir = RunConfiguration.getReportFolder() + '\\Evidences\\'
			new File(evidenceDir).mkdirs()

			WindowsActionHelper
				.create(WindowsDriverFactory.getWindowsSession())
				.takeScreenshot(evidenceDir + fileName)

			KeywordUtil.logInfo('Evidence captured: ' + evidenceDir + fileName)
		} catch (Exception e) {
			KeywordUtil.logInfo('Could not capture evidence: ' + e.getMessage())
		}
	}
}
