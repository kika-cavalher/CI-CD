/*
 * Responsibility:
 * Clean Jenkins console output for suite execution.
 */

def cleanText(String value) {
    return (value ?: '').replaceAll(/\s+/, ' ').trim()
}

def formatDurationSeconds(def rawValue) {
    long total = 0L

    try {
        total = (rawValue ?: '0').toString().toLong()
    }
    catch (ignored) {
        total = 0L
    }

    long hours = (long) (total / 3600)
    long minutes = (long) ((total % 3600) / 60)
    long seconds = (long) (total % 60)

    return String.format('%02d:%02d:%02d', hours, minutes, seconds)
}

def sumDurationSeconds(List results) {
    long total = 0L

    results.each { item ->
        try {
            total += (item.durationSeconds ?: '0').toString().toLong()
        }
        catch (ignored) {
        }
    }

    return total
}

def printSuiteHeader(script, String suiteName, String suitePath, String timeoutMinutes) {
    script.echo '------------------------------------------------------------'
    script.echo '🚀 [START SUITE]'
    script.echo "📛 Name    : ${suiteName}"
    script.echo "📁 Path    : ${suitePath}"
    script.echo "⏱️ Timeout : ${timeoutMinutes} min"
    script.echo '------------------------------------------------------------'
}

def printSuiteResult(script, Map result) {
    script.echo '------------------------------------------------------------'
    script.echo "${result.icon ?: '❔'} ${result.name ?: ''}"
    script.echo "⏱️ Time    : ${formatDurationSeconds(result.durationSeconds)}"
    script.echo "📊 Stats   : Executed=${result.executed} | Passed=${result.passed} | Failed=${result.failed} | Skipped=${result.skipped}"

    if (result.reason) {
        script.echo "🧾 Reason  : ${cleanText(result.reason)}"
    }

    if (result.primaryArtifactRel) {
        script.echo "🖼️ Image   : Reports/${result.primaryArtifactRel}"
    }

    if (result.logRel) {
        script.echo "📄 Log     : Reports/${result.logRel}"
    }

    (result.caseSummary ?: []).take(3).each { line ->
        script.echo "🧪 Case    : ${cleanText(line.toString())}"
    }

    (result.stepSummary ?: []).take(3).each { line ->
        script.echo "➡️ Step    : ${cleanText(line.toString())}"
    }

    script.echo '------------------------------------------------------------'
}

def printRunningSummary(script, List results) {
    def passed = results.count { it.status == 'PASSED' }
    def failed = results.count { it.status == 'FAILED' }
    def timeout = results.count { it.status == 'TIMEOUT' }
    def totalTime = formatDurationSeconds(sumDurationSeconds(results))

    script.currentBuild.description = "✅ ${passed} | ❌ ${failed + timeout} | ${totalTime}"

    script.echo '------------------------------------------------------------'
    script.echo "📌 RUNNING SUMMARY | ✅=${passed} | ❌=${failed} | ⏰=${timeout} | ⏱️=${totalTime}"
    script.echo '------------------------------------------------------------'
}

def printFinalSummary(script, List results, String currentResult) {
    def passed = results.count { it.status == 'PASSED' }
    def failed = results.count { it.status == 'FAILED' }
    def timeout = results.count { it.status == 'TIMEOUT' }
    def totalTime = formatDurationSeconds(sumDurationSeconds(results))
    def total = results.size()

    script.currentBuild.description = "✅ ${passed} | ❌ ${failed + timeout} | ${totalTime}"

    script.echo '============================================================'

    if (total == 0) {
        script.echo '⚠️ PIPELINE STOPPED BEFORE ANY SUITE WAS EXECUTED'
    }
    else if (currentResult == 'ABORTED') {
        script.echo '🛑 PIPELINE ABORTED'
    }
    else if (failed > 0 || timeout > 0) {
        script.echo '❌ PIPELINE FINISHED WITH ERRORS'
    }
    else {
        script.echo '✅ PIPELINE FINISHED SUCCESSFULLY'
    }

    script.echo "📌 FINAL SUMMARY | ✅=${passed} | ❌=${failed} | ⏰=${timeout} | ⏱️=${totalTime}"
    script.echo '============================================================'

    results.each { result ->
        script.echo '------------------------------------------------------------'
        script.echo "${result.icon ?: '❔'} ${result.name ?: ''}"
        script.echo "⏱️ Time    : ${formatDurationSeconds(result.durationSeconds)}"
        script.echo "📊 Stats   : Executed=${result.executed} | Passed=${result.passed} | Failed=${result.failed} | Skipped=${result.skipped}"

        if (result.reason) {
            script.echo "🧾 Reason  : ${cleanText(result.reason)}"
        }

        if (result.primaryArtifactRel) {
            script.echo "🖼️ Image   : Reports/${result.primaryArtifactRel}"
        }

        script.echo '------------------------------------------------------------'
    }
}

