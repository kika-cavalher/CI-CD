String combineValidationResults(
		Object... values
) {
	List<String> results = []

	if (values == null) {
		return ''
	}

	for (Object value : values) {
		String text =
				value == null ?
					'' :
					String.valueOf(
					value
						).trim()

		if (!text.isEmpty()) {
			results.add(
					text
					)
		}
	}

	return results.join(
			'\n'
			)
}

Boolean hasValidationFailure(
		String validationResult
) {
	String result =
			validationResult == null ?
				'' :
				validationResult.trim()

	if (result.isEmpty()) {
		return false
	}

	if (isSkippedResult(
			result
			)) {
		return false
	}

	String upper =
			result.toUpperCase(
			Locale.ENGLISH
				)

	if (upper == 'PASS' ||
			upper == 'PASSED' ||
			upper == 'SUCCESS') {
		return false
	}

	if (upper.startsWith(
			'[PASS]'
			) ||
			upper.startsWith(
			'[PASSED]'
			) ||
			upper.startsWith(
			'[SUCCESS]'
			)) {
		return false
	}

	if (upper.contains(
			'RESULT: PASSED'
			)) {
		return false
	}

	return true
}

Boolean isSkippedResult(
		String validationResult
) {
	String result =
			validationResult == null ?
				'' :
				validationResult.trim()

	result =
			result.replaceFirst(
			'^\\s*[^A-Za-z0-9\\[]+\\s*',
			''
				)

	return result.startsWith(
			'[SKIPPED]'
			)
}

