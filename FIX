Map<String, String> exportedFiles = [:]

for (String environment : targetEnvironments) {
	String loginTestCase = 'Component/Authentication/Login ' + environment
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Authenticate and open application\nEnvironment: ' + environment)
	WebUI.callTestCase(findTestCase(loginTestCase), [:], FailureHandling.STOP_ON_FAILURE)

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Open Synthèse Justification Latent\nEnvironment: ' + environment + '\nSearch: ' + menuName + '\nResult: ' + menuResultName)
	CustomKeywords.'component.MenuNavigator.searchAndOpenMenuByText'(menuName, menuResultName, menuTimeout)
	CustomKeywords.'pageObject.JustificationDesComptesDeLatentKeywords.validateSyntheseTabOpened'(screenLoadTimeout)

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Apply Synthèse Section filter\nEnvironment: ' + environment + '\nValue: ' + sectionFilterValue)
	CustomKeywords.'pageObject.JustificationDesComptesDeLatentKeywords.applySyntheseSectionFilter'(sectionFilterValue, filterTimeout)

	if (GlobalVariable.arreteDate == null || GlobalVariable.arreteDate.toString().trim().isEmpty()) {
		GlobalVariable.arreteDate = CustomKeywords.'general.MenuHandling.getArreteDateWithSlash'()
	}
	String closingDate = GlobalVariable.arreteDate.toString().replace('/', '')

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Apply Synthèse Recherche filter\nEnvironment: ' + environment + '\nClosing date: ' + closingDate)
	CustomKeywords.'component.RechercheKeywords.applyRechercheTextFilter'(
		rechercheImageGroup, rechercheObjectGroup, rechercheTabImageKey, rechercheTabObjectKey,
		rechercheInputObjectKey, rechercheButtonObjectKey, closingDate, rechercheTimeout
	)

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Export Synthèse file\nEnvironment: ' + environment + '\nExport label: ' + exportLabel)
	CustomKeywords.'commands.ExportFile.exportFromTwoExportImagesToNo'(exportLabel, environment)
	Map exportValidation = CustomKeywords.'commands.ExportFileValidationKeywords.validateExportedFileExistsAndHasRows'(environment, exportLabel)
	String exportedFilePath = new File(exportValidation.folderPath.toString(), exportValidation.fileName.toString()).absolutePath
	exportedFiles[environment] = exportedFilePath

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Synthèse export completed\nEnvironment: ' + environment + '\nFile: ' + exportValidation.fileName + '\nRows: ' + exportValidation.dataRows)

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Close application\nEnvironment: ' + environment)
	WebUI.callTestCase(findTestCase(closeApplicationTestCase), [:], FailureHandling.STOP_ON_FAILURE)
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Compare Synthèse REC and PRD exports\nValidations:\n- Number of headers\n- Header names and order\n- Number of data rows\n- Numeric data count\n- Numeric data checksum')
Map comparison = CustomKeywords.'commands.RecPrdExportValidationKeywords.validateSyntheseRecPrdExports'(exportedFiles.REC, exportedFiles.PRD)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Synthèse REC x PRD comparison passed\nREC file: ' + comparison.recFileName + '\nPRD file: ' + comparison.prdFileName + '\nHeaders: ' + comparison.recHeaders + '\nRows: ' + comparison.recRows + '\nNumeric data count: ' + comparison.recNumericValueCount + '\nNumeric checksum: ' + comparison.recNumericChecksum)
KeywordUtil.markPassed('REC and PRD Synthèse filters, exports and comparison completed successfully.')












