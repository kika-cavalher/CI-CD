	void filterBySourceInvestigations(String filterToApply) {


		String sourceAscending = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/sourceAscending.PNG').getAbsolutePath()
		String sourceDescending = new File(RunConfiguration.getProjectDir(), 'Images/Justification des Comptes de Latent/sourceDescending.PNG').getAbsolutePath()
