Validations export RECXPRD

import com.kms.katalon.core.util.KeywordUtil

Integer threshold = 3

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Start validation of downloaded REC and PRD files'
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Validate REC and PRD exported files exist'
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Compare REC and PRD headers, rows and configured columns using threshold: ' + threshold
)

String errors = CustomKeywords.'commands.ExportFileComparator.validateRecProdExportFiles'(
	threshold
)

if (errors != '') {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'File comparison finished with mismatches between REC and PRD'
	)

	KeywordUtil.markFailed('\n' + errors)
} else {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'File comparison finished successfully with no mismatches'
	)

	KeywordUtil.markPassed(
		'REC/PRD export validation completed successfully'
	)
}
