@echo off
setlocal EnableExtensions EnableDelayedExpansion

rem ============================================================
rem  eMatch Desktop Runner (Katalon Runtime)
rem  Reads: D:\Projects\eMatchStarters\run-context.properties
rem  Writes:
rem    - %LOG_DIR%\katalon_YYYYMMDD_HHMMSS.log
rem    - %REPORTS_DIR%\_jenkins_task_exitcode.txt
rem ============================================================

set "BASE_DIR=D:\Projects\eMatchStarters"
set "CTX_FILE=%BASE_DIR%\run-context.properties"

if not exist "%CTX_FILE%" (
  echo [ERROR] Context file not found: "%CTX_FILE%"
  exit /b 2
)

rem ---- Load properties (key=value) ----
for /f "usebackq tokens=1,* delims==" %%A in ("%CTX_FILE%") do (
  set "K=%%A"
  set "V=%%B"
  if not "!K!"=="" (
    set "!K!=!V!"
  )
)

rem ---- Validate required keys ----
call :require WORKSPACE
call :require PROJECT_FILE
call :require KATALON_EXE
call :require COLLECTION_PATH
call :require REPORTS_DIR
call :require LOG_DIR
call :require BROWSER_TYPE
if errorlevel 1 exit /b 2

rem ---- Normalize / ensure folders ----
if not exist "%LOG_DIR%" mkdir "%LOG_DIR%" >nul 2>nul
if not exist "%REPORTS_DIR%" mkdir "%REPORTS_DIR%" >nul 2>nul

if not exist "%KATALON_EXE%" (
  echo [ERROR] Katalon executable not found: "%KATALON_EXE%"
  exit /b 3
)

set "TS=%DATE:~6,4%%DATE:~3,2%%DATE:~0,2%_%TIME:~0,2%%TIME:~3,2%%TIME:~6,2%"
set "TS=%TS: =0%"
set "LOG_FILE=%LOG_DIR%\katalon_%TS%.log"
set "EXIT_FILE=%REPORTS_DIR%\_jenkins_task_exitcode.txt"

echo =========================================================== 
echo [INFO] WORKSPACE      = %WORKSPACE%
echo [INFO] PROJECT_FILE   = %PROJECT_FILE%
echo [INFO] KATALON_EXE    = %KATALON_EXE%
echo [INFO] COLLECTION     = %COLLECTION_PATH%
echo [INFO] REPORTS_DIR    = %REPORTS_DIR%
echo [INFO] LOG_FILE       = %LOG_FILE%
echo [INFO] BROWSER_TYPE   = %BROWSER_TYPE%
echo [INFO] RETRY          = %RETRY%
echo =========================================================== 

pushd "%WORKSPACE%" 2>nul
if errorlevel 1 (
  echo [ERROR] Cannot cd to WORKSPACE: "%WORKSPACE%"
  exit /b 4
)

rem ---- Run Katalon (multi-line, no wrap issues) ----
"%KATALON_EXE%" ^
  -noSplash ^
  -runMode=console ^
  -retry=%RETRY% ^
  -projectPath="%WORKSPACE%\%PROJECT_FILE%" ^
  -testSuiteCollectionPath="%COLLECTION_PATH%" ^
  -browserType="%BROWSER_TYPE%" ^
  -reportFolder="%REPORTS_DIR%" ^
  -reportFileName="report" ^
  > "%LOG_FILE%" 2>&1

set "EC=%ERRORLEVEL%"

echo [INFO] KATALON EXITCODE = %EC%
echo %EC%>"%EXIT_FILE%"

popd

exit /b %EC%

:require
set "REQ_KEY=%~1"
for /f "tokens=* delims= " %%Z in ("!%REQ_KEY%!") do set "%REQ_KEY%=%%Z"
if "!%REQ_KEY%!"=="" (
  echo [ERROR] Missing property: %REQ_KEY%
  exit /b 1
)
exit /b 0
