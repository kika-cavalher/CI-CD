def COLLECTION_TIMEOUT_MINUTES = 210

def executionFailed = false
def manualAborted = false
def testsWereExecuted = false
def triggerFailed = false

def timedOutCollections = []
def failedCollections = []

def asErrorText = { Throwable err ->
	def parts = []
	def current = err

	while (current != null) {
		parts << "${current.getClass().getName()}: ${current.getMessage() ?: ''}"

		try {
			if (current instanceof org.jenkinsci.plugins.workflow.steps.FlowInterruptedException) {
				current.getCauses()?.each { interruptionCause ->
					parts << "${interruptionCause.getClass().getName()}: ${interruptionCause.toString()}"
				}
			}
		} catch (Throwable ignored) {
			parts << '[WARN] Unable to inspect interruption causes.'
		}

		current = current.getCause()
	}

	return parts.join(' | ').toLowerCase()
}

def isTimeoutError = { Throwable err ->
	def text = asErrorText(err)

	return text.contains('exceededtimeout') ||
			text.contains('timeout has been exceeded') ||
			text.contains('timeoutstep') ||
			text.contains('org.jenkinsci.plugins.workflow.steps.timeout')
}

def isManualAbortError = { Throwable err ->
	def text = asErrorText(err)

	return !isTimeoutError(err) &&
			(
				text.contains('userinterruption') ||
				text.contains('flowinterruptedexception') ||
				text.contains('aborted')
			)
}

def runCollection = { Map collection ->

	def cmdFile = collection.cmd
	def stageName = collection.stage

	try {

		stage(stageName) {
			timeout(time: COLLECTION_TIMEOUT_MINUTES, unit: 'MINUTES') {
				node(NODE_LABEL) {

					ws("${env.WORKSPACE}\\${SHORT_WORKSPACE}") {

						echo "[INFO] Starting stage: ${stageName}"
						echo "[INFO] Command file: ${cmdFile}"
						echo "[INFO] Workspace: ${pwd()}"
						echo "[INFO] Stage timeout: 3 hours and 30 minutes"

						checkout scm

						if (!fileExists("jenkins/${cmdFile}")) {
							executionFailed = true
							error("[ERROR] Command file was not found: jenkins/${cmdFile}")
						}

						def startedMarker = "jenkins_started_${stageName.replaceAll('[^A-Za-z0-9]', '_')}.txt"
						def finishedMarker = "jenkins_finished_${stageName.replaceAll('[^A-Za-z0-9]', '_')}.txt"

						bat(
							script: """
								@echo off
								if exist "${startedMarker}" del /f /q "${startedMarker}"
								if exist "${finishedMarker}" del /f /q "${finishedMarker}"
								echo started > "${startedMarker}"
							""",
							returnStatus: true
						)

						def exitCode = bat(
							script: """
								@echo off
								echo [INFO] Executing test command...
								call "jenkins\\${cmdFile}"
								set TEST_EXIT_CODE=%ERRORLEVEL%
								echo finished > "${finishedMarker}"
								echo [INFO] Test command finished with exit code %TEST_EXIT_CODE%
								exit /b %TEST_EXIT_CODE%
							""",
							returnStatus: true
						)

						def started = fileExists(startedMarker)
						def finished = fileExists(finishedMarker)

						echo "[INFO] Command exit code: ${exitCode}"
						echo "[INFO] Started marker exists: ${started}"
						echo "[INFO] Finished marker exists: ${finished}"

						if (!started || !finished) {
							executionFailed = true
							error("[ERROR] Tests were not executed correctly for stage: ${stageName}")
						}

						testsWereExecuted = true

						echo "[INFO] Tests were executed for stage: ${stageName}"
						echo "[INFO] Jenkins status rule: test failures do not fail the stage."
						echo "[INFO] Ignoring test exit code for Jenkins stage status: ${exitCode}"
					}
				}
			}
		}

	} catch (Throwable err) {

		if (isTimeoutError(err)) {
			executionFailed = true
			timedOutCollections << stageName
			currentBuild.result = 'FAILURE'

			echo "[ERROR] Stage timeout exceeded after 3 hours and 30 minutes: ${stageName}"
			echo '[INFO] Timeout was captured and will not stop the remaining collections or the next pipeline trigger.'
			return
		}

		if (isManualAbortError(err)) {
			manualAborted = true
			currentBuild.result = 'ABORTED'

			echo "[WARN] Manual abort detected during stage: ${stageName}"
			echo '[INFO] Remaining collections in this pipeline will stop, but the next pipeline trigger will still be attempted.'

			throw err
		}

		executionFailed = true
		failedCollections << stageName
		currentBuild.result = 'FAILURE'

		echo "[ERROR] Jenkins error captured in stage: ${stageName}"
		echo "[ERROR] ${err.getClass().getName()}: ${err.getMessage() ?: 'No error message available'}"
		echo '[INFO] The error will not stop the remaining collections or the next pipeline trigger.'
	}
}

try {

	COLLECTIONS.each { collection ->
		runCollection(collection)
	}

} catch (Throwable err) {

	if (isTimeoutError(err)) {
		executionFailed = true
		currentBuild.result = 'FAILURE'

		echo '[ERROR] Pipeline timeout was captured.'
		echo '[INFO] The next pipeline trigger will still be attempted.'
	} else if (isManualAbortError(err)) {
		manualAborted = true
		currentBuild.result = 'ABORTED'

		echo '[WARN] Pipeline was manually aborted.'
		echo '[INFO] The next pipeline trigger will still be attempted.'
	} else {
		executionFailed = true
		currentBuild.result = 'FAILURE'

		echo "[ERROR] Pipeline error captured: ${err.getClass().getName()}: ${err.getMessage() ?: 'No error message available'}"
		echo '[INFO] The next pipeline trigger will still be attempted.'
	}

} finally {

	if (RUN_NEXT_JOB && NEXT_JOB?.trim()) {

		try {

			stage('Trigger next pipeline') {
				echo "[INFO] Triggering next pipeline independently of the current build result: ${NEXT_JOB}"

				build job: NEXT_JOB,
						wait: false,
						propagate: false

				echo '[INFO] Next pipeline triggered.'
			}

		} catch (Throwable triggerError) {

			triggerFailed = true
			executionFailed = true
			currentBuild.result = 'FAILURE'

			echo "[ERROR] Failed to trigger next pipeline: ${NEXT_JOB}"
			echo "[ERROR] ${triggerError.getClass().getName()}: ${triggerError.getMessage() ?: 'No error message available'}"
		}

	} else {
		echo '[INFO] Next pipeline trigger is disabled or NEXT_JOB is empty.'
	}

	stage('Final status') {
		echo "[INFO] Tests were executed: ${testsWereExecuted}"
		echo "[INFO] Execution failed: ${executionFailed}"
		echo "[INFO] Manual aborted: ${manualAborted}"
		echo "[INFO] Trigger failed: ${triggerFailed}"
		echo "[INFO] Timed out collections: ${timedOutCollections ?: 'None'}"
		echo "[INFO] Failed collections: ${failedCollections ?: 'None'}"

		if (manualAborted) {
			currentBuild.result = 'ABORTED'
			echo '[INFO] Jenkins result: ABORTED because the build was manually aborted.'
			echo '[INFO] The next pipeline trigger was still attempted.'
		} else if (!testsWereExecuted || executionFailed || triggerFailed) {
			currentBuild.result = 'FAILURE'
			echo '[ERROR] Jenkins result: FAILURE because execution or trigger had an infrastructure error.'
			echo '[INFO] The next pipeline trigger was still attempted.'
		} else {
			currentBuild.result = 'SUCCESS'
			echo '[INFO] Jenkins result: SUCCESS because tests were executed.'
			echo '[INFO] Test case failures are ignored for Jenkins status.'
		}
	}
}
