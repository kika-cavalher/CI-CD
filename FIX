	private void clickImageFirstThenObject(
			String imageKey,
			String objectKey,
			String description,
			Integer timeoutSeconds
	) {

		Integer imageTimeout =
				Math.min(
				safeTimeout(timeoutSeconds),
				IMAGE_FALLBACK_TIMEOUT
				)

		Boolean clickedByImage = false

		try {
			if (imageLoader.waitForImage(
					IMAGE_GROUP,
					imageKey,
					imageTimeout
					)) {
				WindowsImageKeywords.clickImage(
						image(imageKey)
						)

				clickedByImage = true

				KeywordUtil.logInfo(
						'[IMAGE] ' +
						description +
						' clicked.\n' +
						'Group: ' +
						IMAGE_GROUP +
						'\nKey: ' +
						imageKey
						)
			}
		} catch (Throwable imageError) {
			KeywordUtil.logInfo(
					'[IMAGE] Could not click ' +
					description +
					'. Trying Windows object.\n' +
					'Reason: ' +
					safeText(imageError.message)
					)
		}

		if (clickedByImage) {
			return
		}

		WindowsTestObject targetObject =
				object(objectKey)

		if (!Windows.waitForElementPresent(
				targetObject,
				safeTimeout(timeoutSeconds),
				FailureHandling.OPTIONAL
				)) {
			takeEvidence(
					'Investigations_' +
					objectKey +
					'_NotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					description +
					' was not found by image or Windows object.\n' +
					'Image: ' +
					IMAGE_GROUP +
					'.' +
					imageKey +
					'\nObject: ' +
					OBJECT_GROUP +
					'.' +
					objectKey
					)

			return
		}

		Windows.click(
				targetObject,
				FailureHandling.STOP_ON_FAILURE
				)

		KeywordUtil.logInfo(
				'[OBJECT] ' +
				description +
				' clicked.\n' +
				'Group: ' +
				OBJECT_GROUP +
				'\nKey: ' +
				objectKey
				)
	}

