		String preferred = lines.find { String line ->
			String lower = line.toLowerCase(Locale.ENGLISH)
			boolean match = false
			match = match || lower.contains('unable to ')
			match = match || lower.contains('element click intercepted')
			match = match || lower.contains('object repository')
			match = match || lower.contains('no such element')
