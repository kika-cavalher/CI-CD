	private File resolveShortExportRoot() {

		File baseRoot =
				resolveWritableBaseExportRoot()

		File executionRoot =
				resolveExecutionRootFolder()

		String executionName =
				executionRoot == null
					? ''
					: executionRoot.getName()

		if (executionName == null ||
				executionName.trim().isEmpty()) {

			executionName =
					'Unknown_Execution'
		}

		File executionDirectory = new File(
				baseRoot,
				shortenFilePart(
				sanitizeFileName(
				executionName
				),
					48
				)
				)

		if (!executionDirectory.exists()) {

			boolean created =
					executionDirectory.mkdirs()

			if (!created &&
					!executionDirectory.exists()) {

				KeywordUtil.markFailedAndStop(
						'Could not create suite execution export directory.\n' +
							'Directory: ' +
							executionDirectory.getAbsolutePath()
						)

				return null
			}
		}

		return executionDirectory
	}


	private File resolveWritableBaseExportRoot() {

		File preferredRoot =
				new File(
				SHORT_EXPORT_ROOT
				)

		try {
			if (!preferredRoot.exists()) {
				preferredRoot.mkdirs()
			}

			if (preferredRoot.exists() &&
					preferredRoot.isDirectory() &&
					preferredRoot.canWrite()) {

				logInfo(
						'Using preferred export root.\n' +
							'Directory: ' +
							preferredRoot.getAbsolutePath()
						)

				return preferredRoot
			}
		} catch (Exception exception) {

			logInfo(
					'Preferred export root could not be used.\n' +
						'Directory: ' +
						preferredRoot.getAbsolutePath() + '\n' +
						'Message: ' +
						safeExceptionMessage(
						exception
						)
					)
		}

		File temporaryRoot = new File(
				System.getProperty(
				'java.io.tmpdir'
				),
				'KatalonExports'
				)

		if (!temporaryRoot.exists()) {
			temporaryRoot.mkdirs()
		}

		logInfo(
				'Using temporary export root.\n' +
					'Directory: ' +
					temporaryRoot.getAbsolutePath()
				)

		return temporaryRoot
	}


	private File resolveExecutionRootFolder() {

		String reportFolderPath =
				RunConfiguration.getReportFolder()

		if (reportFolderPath == null ||
				reportFolderPath.trim().isEmpty()) {

			return new File(
					RunConfiguration.getProjectDir(),
						'Reports\\Unknown_Execution'
					)
		}

		File current =
				new File(
				reportFolderPath
				)

		while (current != null) {

			File parent =
					current.getParentFile()

			if (parent != null &&
					parent.getName()
					.equalsIgnoreCase(
					'Reports'
					)) {

				return current
			}

			current = parent
		}

		return new File(
				reportFolderPath
				)
	}


	private File ensurePathIsShortEnough(
			File proposedFile,
			String environment,
			String exportLabelSuffix) {

		if (proposedFile
				.getAbsolutePath()
				.length() <=
				MAX_WINDOWS_PATH_LENGTH) {

			return proposedFile
		}

		String timestamp =
				new SimpleDateFormat(
				'yyyyMMdd_HHmmss'
				).format(
				new Date()
				)

		String shortEnvironment = shortenFilePart(
				sanitizeFileName(
				environment
				),
				6
				)

		String shortLabel = shortenFilePart(
				sanitizeFileName(
				exportLabelSuffix
				),
				12
				)

		String shortFileName =
				shortEnvironment +
				'_' +
				timestamp

		if (shortLabel != null &&
				!shortLabel.trim().isEmpty()) {

			shortFileName +=
					'_' +
					shortLabel
		}

		File shortFile = new File(
				proposedFile.getParentFile(),
					shortFileName +
					'.xlsx'
				)

		if (shortFile
				.getAbsolutePath()
				.length() >
				MAX_WINDOWS_PATH_LENGTH) {

			KeywordUtil.markFailedAndStop(
					'Could not create an export path shorter than the configured limit.\n' +
						'Maximum path length: ' +
						MAX_WINDOWS_PATH_LENGTH + '\n' +
						'Path: ' +
						shortFile.getAbsolutePath()
					)

			return null
		}

		logInfo(
				'Original export path exceeded the configured limit.\n' +
					'A shorter file name will be used.\n' +
					'Short path: ' +
					shortFile.getAbsolutePath()
				)

		return shortFile
	}


	// ======================================================
	// EXPORTED FILE VALIDATION
	// ======================================================

	private void validateExportedFile(
			File exportedFile) {

		if (exportedFile == null) {

			KeywordUtil.markFailedAndStop(
					'Exported file reference is null.'
					)

			return
		}

		if (!exportedFile.exists() ||
				!exportedFile.isFile() ||
				exportedFile.length() <= 0) {

			KeywordUtil.markFailedAndStop(
					'Exported file is invalid.\n' +
						'Path: ' +
						exportedFile.getAbsolutePath() + '\n' +
						'Exists: ' +
						exportedFile.exists() + '\n' +
						'Is file: ' +
						exportedFile.isFile() + '\n' +
						'Size bytes: ' +
						(
							exportedFile.exists()
								? exportedFile.length()
								: 0
						)
					)

			return
		}

		String lowerName =
				exportedFile
				.getName()
				.toLowerCase()

		if (!lowerName.endsWith('.xlsx') &&
				!lowerName.endsWith('.xlsm') &&
				!lowerName.endsWith('.xls')) {

			KeywordUtil.markFailedAndStop(
					'Exported file does not have a supported Excel extension.\n' +
						'File: ' +
						exportedFile.getName()
					)

			return
		}

		logInfo(
				'Exported file validation completed successfully.\n' +
					'File: ' +
					exportedFile.getName() + '\n' +
					'Path: ' +
					exportedFile.getAbsolutePath() + '\n' +
					'Size bytes: ' +
					exportedFile.length()
				)
	}


