		result.recNumericValues = null
		result.prdNumericValues = null
		result.recZeroValues = null
		result.prdZeroValues = null
		result.recNonZeroValues = null
		result.prdNonZeroValues = null
		result.recBlankValues = null
		result.prdBlankValues = null
		result.recBlankValuesTreatedAsZero = null
		result.prdBlankValuesTreatedAsZero = null
		result.recUnreadableValues = null
		result.prdUnreadableValues = null
		result.recNonNumericDigest = ''
		result.prdNonNumericDigest = ''
		result.recNonNumericRawDigest = ''
		result.prdNonNumericRawDigest = ''
		result.recNonNumericValueCounts = [:]
		result.prdNonNumericValueCounts = [:]
		result.recNonNumericSamples = [:]
		result.prdNonNumericSamples = [:]
