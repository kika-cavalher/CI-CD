import com.kms.katalon.core.annotation.*
import com.kms.katalon.core.context.*

import jiraIntegration.JiraImagesEvidence

class ematchReport {

    @BeforeTestCase
    def before(TestCaseContext ctx) {

        JiraImagesEvidence.init(ctx.getTestCaseId())
    }

    @AfterTestCase
    def after(TestCaseContext ctx) {

        String status = ctx.getTestCaseStatus()

        if (status in ["FAILED", "ERROR"]) {

            JiraImagesEvidence.captureAutoFailure()
        }
    }
}





package jiraIntegration

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows
import org.openqa.selenium.OutputType

import java.awt.*
import java.awt.image.BufferedImage
import java.text.SimpleDateFormat
import javax.imageio.ImageIO

class JiraImagesEvidence {

    private static final SimpleDateFormat FILE_STAMP =
        new SimpleDateFormat("yyyyMMdd_HHmmss_SSS")

    private static final ThreadLocal<File> CURRENT_CASE_FOLDER = new ThreadLocal<>()

    // ===============================
    // INIT PER TEST CASE
    // ===============================
    static void init(String testCaseId) {

        String reportFolder = RunConfiguration.getReportFolder()

        File base = new File(reportFolder, "Evidences")
        base.mkdirs()

        String safeName = testCaseId.replaceAll("[^a-zA-Z0-9]", "_")

        File caseFolder = new File(base, safeName)
        caseFolder.mkdirs()

        CURRENT_CASE_FOLDER.set(caseFolder)
    }

    // ===============================
    // AUTO FAILURE SCREENSHOT
    // ===============================
    static String captureAutoFailure() {

        try {
            File folder = CURRENT_CASE_FOLDER.get()
            if (folder == null) return null

            String name = FILE_STAMP.format(new Date()) + "_auto-failure.png"
            File file = new File(folder, name)

            BufferedImage img = captureDesktop()
            ImageIO.write(img, "png", file)

            println "📸 Evidence screenshot saved: ${file.absolutePath}"

            return file.absolutePath

        } catch (Exception e) {
            println "⚠ Failed to capture auto screenshot: ${e.message}"
            return null
        }
    }

    // ===============================
    // MANUAL KEYWORDS (OPTIONAL)
    // ===============================
    @Keyword
    def note(String msg) {
        println "📝 NOTE: ${msg}"
    }

    @Keyword
    def captureNow(String name) {
        saveCustom(name)
    }

    @Keyword
    def noteAndCapture(String msg, String name) {
        note(msg)
        saveCustom(name)
    }

    private static void saveCustom(String name) {
        try {
            File folder = CURRENT_CASE_FOLDER.get()
            if (folder == null) return

            String fileName = FILE_STAMP.format(new Date()) + "_" + name + ".png"
            File file = new File(folder, fileName)

            BufferedImage img = captureDesktop()
            ImageIO.write(img, "png", file)

            println "📸 Manual screenshot saved: ${file.absolutePath}"

        } catch (Exception e) {
            println "⚠ Failed manual screenshot: ${e.message}"
        }
    }

    private static BufferedImage captureDesktop() {
        Robot robot = new Robot()
        Rectangle screen = new Rectangle(Toolkit.getDefaultToolkit().getScreenSize())
        return robot.createScreenCapture(screen)
    }
}
