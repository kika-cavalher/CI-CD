package jiraIntegration

import groovy.io.FileType

import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale

import javax.xml.parsers.DocumentBuilderFactory

import org.w3c.dom.Document
import org.w3c.dom.Element
import org.w3c.dom.NodeList

class JiraReportBuilder {

    private static final String APP_NAME = 'EMATCH'
    private static final String LOGO_SRC = 'Image/ematch-logo.png'

    private static final SimpleDateFormat REPORT_MARKER_TIME =
        new SimpleDateFormat('yyyy-MM-dd HH:mm:ss.SSS', Locale.ENGLISH)

    private static final SimpleDateFormat OUTPUT_DATE_TIME =
        new SimpleDateFormat('dd/MM/yyyy HH:mm:ss', Locale.ENGLISH)

    private static final SimpleDateFormat OUTPUT_CLOCK =
        new SimpleDateFormat('HH:mm:ss', Locale.ENGLISH)

    File buildReport(String reportFolderPath) {
        return buildReport(new File(safe(reportFolderPath).isEmpty() ? '.' : reportFolderPath))
    }

    File buildReport(String reportFolderPath, String suiteName, String executionTitle) {
        return buildReport(
            new File(safe(reportFolderPath).isEmpty() ? '.' : reportFolderPath),
            suiteName,
            executionTitle
        )
    }

    File buildReport(File reportFolder) {
        return buildReport(reportFolder, '', '')
    }

    File buildReport(File reportFolder, String suiteName, String executionTitle) {
        File root = reportFolder ?: new File('.')
        Map model = buildModel(root, suiteName, executionTitle)

        String html = new JiraHtmlTemplateBuilder().build(model)

        File output = new File(root, 'eMatchReport.html')
        output.setText(html, 'UTF-8')

        return output
    }

    private Map buildModel(File reportFolder, String suiteNameArg, String executionTitleArg) {
        Map<String, Map> traceIndex = parseTraceIndex(reportFolder)
        List<Map> scenarios = buildScenariosFromJUnit(reportFolder, traceIndex)

        if (scenarios.isEmpty()) {
            scenarios = buildScenariosFromTraceOnly(reportFolder, traceIndex)
        }

        if (scenarios.isEmpty()) {
            scenarios << [
                id            : 'scenario-1',
                name          : 'Execution',
                scenarioName  : 'Execution',
                status        : 'blocked',
                result        : 'blocked',
                durationMs    : 0L,
                durationLabel : '00h 00m 00s',
                startTime     : '',
                endTime       : '',
                startLabel    : '--',
                endLabel      : '--',
                startShort    : '--',
                endShort      : '--',
                startLong     : '--',
                endLong       : '--',
                visualError   : '',
                errorSummary  : '',
                fullError     : '',
                errorDetail   : '',
                reportFolder  : reportFolder.absolutePath,
                steps         : [],
                evidence      : []
            ]
        }

        String suiteName = resolveSuiteName(reportFolder, suiteNameArg, scenarios)
        String executionTitle = safe(executionTitleArg).isEmpty() ? suiteName : safe(executionTitleArg)

        return [
            appName         : APP_NAME,
            suiteName       : suiteName,
            executionName   : executionTitle,
            title           : executionTitle,
            generatedAt     : OUTPUT_DATE_TIME.format(new Date()),
            reportFolder    : reportFolder.absolutePath,
            baseFolder      : reportFolder.absolutePath,
            executionFolder : reportFolder.absolutePath,
            logoSrc         : LOGO_SRC,
            scenarios       : scenarios
        ]
    }

    private List<Map> buildScenariosFromJUnit(File reportFolder, Map<String, Map> traceIndex) {
        List<Map> result = []
        List<File> junitFiles = collectJUnitFiles(reportFolder)

        junitFiles.each { File junitFile ->
            Document document = parseXmlDocument(junitFile)
            if (document == null) {
                return
            }

            List<Element> testcaseElements = collectTestCaseElements(document)

            testcaseElements.eachWithIndex { Element testcaseElement, int index ->
                String rawName = firstNonBlank(
                    attr(testcaseElement, 'name'),
                    attr(testcaseElement, 'classname'),
                    "Scenario ${index + 1}"
                )

                String className = safe(attr(testcaseElement, 'classname'))
                String displayName = buildDisplayName(className, rawName)
                String scenarioId = buildScenarioId(displayName, index + 1)

                Map trace = findBestTrace(traceIndex, displayName, rawName)
                String junitStatus = resolveJUnitStatus(testcaseElement)
                String finalStatus = normalizeScenarioStatus(firstNonBlank(trace.status, junitStatus))

                String junitError = extractJUnitError(testcaseElement)
                String fullError = firstNonBlank(trace.fullError, junitError)
                String visualError = buildShortError(fullError)

                long junitDurationMs = parseDurationMillis(attr(testcaseElement, 'time'))
                long startMs = asLong(trace.startMs)
                long endMs = asLong(trace.endMs)
                long durationMs = asLong(trace.durationMs)

                if (durationMs <= 0L) {
                    durationMs = junitDurationMs
                }

                if (durationMs <= 0L && startMs > 0L && endMs >= startMs) {
                    durationMs = endMs - startMs
                }

                if (endMs <= 0L && startMs > 0L && durationMs > 0L) {
                    endMs = startMs + durationMs
                }

                List<Map> steps = buildScenarioSteps(trace.steps as List<Map>, finalStatus, visualError, endMs)
                List<Map> evidence = collectEvidence(reportFolder, displayName, rawName)

                result << [
                    id            : scenarioId,
                    name          : displayName,
                    scenarioName  : displayName,
                    status        : finalStatus,
                    result        : finalStatus,
                    durationMs    : durationMs,
                    durationLabel : formatDuration(durationMs),
                    startTime     : formatDateTime(startMs),
                    endTime       : formatDateTime(endMs),
                    startLabel    : formatDateTime(startMs),
                    endLabel      : formatDateTime(endMs),
                    startShort    : formatClock(startMs),
                    endShort      : formatClock(endMs),
                    startLong     : formatDateTime(startMs),
                    endLong       : formatDateTime(endMs),
                    visualError   : visualError,
                    errorSummary  : visualError,
                    fullError     : fullError,
                    errorDetail   : fullError,
                    reportFolder  : reportFolder.absolutePath,
                    steps         : steps,
                    evidence      : evidence
                ]
            }
        }

        return result
    }

    private List<Map> buildScenariosFromTraceOnly(File reportFolder, Map<String, Map> traceIndex) {
        List<Map> result = []

        traceIndex.values().toList().sort { Map a, Map b ->
            asLong(a.startMs) <=> asLong(b.startMs)
        }.eachWithIndex { Map trace, int index ->
            String displayName = safe(trace.caseId)
            if (displayName.isEmpty()) {
                return
            }

            String finalStatus = normalizeScenarioStatus(trace.status)
            long startMs = asLong(trace.startMs)
            long endMs = asLong(trace.endMs)
            long durationMs = asLong(trace.durationMs)

            if (durationMs <= 0L && startMs > 0L && endMs >= startMs) {
                durationMs = endMs - startMs
            }

            if (endMs <= 0L && startMs > 0L && durationMs > 0L) {
                endMs = startMs + durationMs
            }

            String visualError = buildShortError(safe(trace.fullError))
            List<Map> steps = buildScenarioSteps(trace.steps as List<Map>, finalStatus, visualError, endMs)
            List<Map> evidence = collectEvidence(reportFolder, displayName, displayName)

            result << [
                id            : buildScenarioId(displayName, index + 1),
                name          : displayName,
                scenarioName  : displayName,
                status        : finalStatus,
                result        : finalStatus,
                durationMs    : durationMs,
                durationLabel : formatDuration(durationMs),
                startTime     : formatDateTime(startMs),
                endTime       : formatDateTime(endMs),
                startLabel    : formatDateTime(startMs),
                endLabel      : formatDateTime(endMs),
                startShort    : formatClock(startMs),
                endShort      : formatClock(endMs),
                startLong     : formatDateTime(startMs),
                endLong       : formatDateTime(endMs),
                visualError   : visualError,
                errorSummary  : visualError,
                fullError     : safe(trace.fullError),
                errorDetail   : safe(trace.fullError),
                reportFolder  : reportFolder.absolutePath,
                steps         : steps,
                evidence      : evidence
            ]
        }

        return result
    }

    private Map<String, Map> parseTraceIndex(File reportFolder) {
        Map<String, Map> index = [:]

        List<String> lines = collectTraceLines(reportFolder)
        lines.each { String line ->
            parseMarkerLine(index, safe(line))
        }

        return index
    }

    private List<String> collectTraceLines(File reportFolder) {
        List<String> lines = []
        if (reportFolder == null || !reportFolder.exists()) {
            return lines
        }

        File mainTrace = new File(reportFolder, 'report_trace.log')
        if (mainTrace.exists()) {
            lines.addAll(readLines(mainTrace))
        }

        reportFolder.eachFileRecurse(FileType.FILES) { File file ->
            String lower = file.name.toLowerCase(Locale.ENGLISH)
            if (!lower.endsWith('.log') && !lower.endsWith('.txt')) {
                return
            }

            if (mainTrace.exists() && file.absolutePath == mainTrace.absolutePath) {
                return
            }

            List<String> fileLines = readLines(file)
            fileLines.findAll { String row -> row.contains('[REPORT_') }.each { String row ->
                lines << row
            }
        }

        return lines
    }

    private void parseMarkerLine(Map<String, Map> index, String line) {
        if (line.isEmpty()) {
            return
        }

        def startMatcher = line =~ /\[REPORT_CASE_START\]\s*(.*?)\s*\|\s*(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3})$/
        if (startMatcher.find()) {
            String caseId = safe(startMatcher.group(1))
            Map row = ensureTraceRow(index, caseId)
            row.startMs = parseMarkerTime(startMatcher.group(2))
            return
        }

        def endMatcher = line =~ /\[REPORT_CASE_END\]\s*(.*?)\s*\|\s*(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3})$/
        if (endMatcher.find()) {
            String caseId = safe(endMatcher.group(1))
            Map row = ensureTraceRow(index, caseId)
            row.endMs = parseMarkerTime(endMatcher.group(2))
            return
        }

        def statusMatcher = line =~ /\[REPORT_STATUS\]\s*(.*?)\s*\|\s*(PASSED|FAILED|BLOCKED)$/
        if (statusMatcher.find()) {
            String caseId = safe(statusMatcher.group(1))
            Map row = ensureTraceRow(index, caseId)
            row.status = safe(statusMatcher.group(2))
            return
        }

        def durationMatcher = line =~ /\[REPORT_DURATION\]\s*(.*?)\s*\|\s*(\d+)$/
        if (durationMatcher.find()) {
            String caseId = safe(durationMatcher.group(1))
            Map row = ensureTraceRow(index, caseId)
            row.durationMs = parseLongSafe(durationMatcher.group(2))
            return
        }

        def failureMatcher = line =~ /\[REPORT_FAILURE\]\s*(.*?)\s*\|\s*(.*)$/
        if (failureMatcher.find()) {
            String caseId = safe(failureMatcher.group(1))
            Map row = ensureTraceRow(index, caseId)
            row.fullError = safe(failureMatcher.group(2))
            return
        }

        def stepMatcher = line =~ /\[REPORT_STEP\]\s*(.*?)\s*\|\s*(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3})\s*\|\s*(NOTE|CHECKPOINT|CAPTURE)\s*\|\s*(.*)$/
        if (stepMatcher.find()) {
            String caseId = safe(stepMatcher.group(1))
            Map row = ensureTraceRow(index, caseId)

            row.steps << [
                timeMs : parseMarkerTime(stepMatcher.group(2)),
                type   : safe(stepMatcher.group(3)),
                detail : safe(stepMatcher.group(4))
            ]
        }
    }

    private Map ensureTraceRow(Map<String, Map> index, String caseId) {
        String key = safe(caseId)
        if (!index.containsKey(key)) {
            index[key] = [
                caseId     : key,
                startMs    : 0L,
                endMs      : 0L,
                durationMs : 0L,
                status     : '',
                fullError  : '',
                steps      : []
            ]
        }
        return index[key]
    }

    private List<File> collectJUnitFiles(File reportFolder) {
        List<File> result = []

        if (reportFolder == null || !reportFolder.exists()) {
            return result
        }

        reportFolder.eachFileRecurse(FileType.FILES) { File file ->
            String lowerName = file.name.toLowerCase(Locale.ENGLISH)
            if (lowerName == 'junit_report.xml' ||
                lowerName == 'junit.xml' ||
                lowerName == 'junit-report.xml' ||
                lowerName == 'cucumber.xml') {
                result << file
            }
        }

        result = result.unique { File file -> file.absolutePath }
        result.sort { File a, File b -> a.absolutePath <=> b.absolutePath }

        return result
    }

    private Document parseXmlDocument(File xmlFile) {
        try {
            DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance()
            factory.setNamespaceAware(false)
            factory.setValidating(false)

            try {
                factory.setFeature('http://apache.org/xml/features/disallow-doctype-decl', true)
            } catch (Throwable ignored) {
            }

            try {
                factory.setFeature('http://xml.org/sax/features/external-general-entities', false)
            } catch (Throwable ignored) {
            }

            try {
                factory.setFeature('http://xml.org/sax/features/external-parameter-entities', false)
            } catch (Throwable ignored) {
            }

            try {
                factory.setFeature('http://apache.org/xml/features/nonvalidating/load-external-dtd', false)
            } catch (Throwable ignored) {
            }

            def builder = factory.newDocumentBuilder()
            Document document = builder.parse(xmlFile)
            document.documentElement?.normalize()

            return document
        } catch (Throwable ignored) {
            return null
        }
    }

    private List<Element> collectTestCaseElements(Document document) {
        List<Element> result = []
        if (document == null) {
            return result
        }

        NodeList nodes = document.getElementsByTagName('testcase')
        for (int i = 0; i < nodes.length; i++) {
            if (nodes.item(i) instanceof Element) {
                result << (Element) nodes.item(i)
            }
        }

        return result
    }

    private String resolveJUnitStatus(Element testcaseElement) {
        if (hasChildTag(testcaseElement, 'failure') || hasChildTag(testcaseElement, 'error')) {
            return 'failed'
        }

        if (hasChildTag(testcaseElement, 'skipped')) {
            return 'blocked'
        }

        return 'passed'
    }

    private String extractJUnitError(Element testcaseElement) {
        Element failureElement = firstChildElementByTagName(testcaseElement, 'failure')
        if (failureElement != null) {
            return firstNonBlank(
                safe(failureElement.textContent),
                safe(failureElement.getAttribute('message'))
            )
        }

        Element errorElement = firstChildElementByTagName(testcaseElement, 'error')
        if (errorElement != null) {
            return firstNonBlank(
                safe(errorElement.textContent),
                safe(errorElement.getAttribute('message'))
            )
        }

        Element skippedElement = firstChildElementByTagName(testcaseElement, 'skipped')
        if (skippedElement != null) {
            return firstNonBlank(
                safe(skippedElement.textContent),
                safe(skippedElement.getAttribute('message'))
            )
        }

        return ''
    }

    private boolean hasChildTag(Element parent, String tagName) {
        return firstChildElementByTagName(parent, tagName) != null
    }

    private Element firstChildElementByTagName(Element parent, String tagName) {
        if (parent == null) {
            return null
        }

        NodeList childNodes = parent.getChildNodes()
        for (int i = 0; i < childNodes.length; i++) {
            def node = childNodes.item(i)
            if (node instanceof Element && safe(((Element) node).tagName) == safe(tagName)) {
                return (Element) node
            }
        }

        return null
    }

    private String attr(Element element, String attrName) {
        if (element == null) {
            return ''
        }

        try {
            return safe(element.getAttribute(attrName))
        } catch (Throwable ignored) {
            return ''
        }
    }

    private Map findBestTrace(Map<String, Map> traceIndex, String displayName, String rawName) {
        if (traceIndex.containsKey(displayName)) {
            return traceIndex[displayName]
        }

        if (traceIndex.containsKey(rawName)) {
            return traceIndex[rawName]
        }

        String normalizedDisplay = normalizeKey(displayName)
        String normalizedRaw = normalizeKey(rawName)

        for (Map.Entry<String, Map> entry : traceIndex.entrySet()) {
            String normalizedKey = normalizeKey(entry.key)
            if (!normalizedDisplay.isEmpty() && normalizedKey == normalizedDisplay) {
                return entry.value
            }
            if (!normalizedRaw.isEmpty() && normalizedKey == normalizedRaw) {
                return entry.value
            }
        }

        return [
            caseId     : displayName,
            startMs    : 0L,
            endMs      : 0L,
            durationMs : 0L,
            status     : '',
            fullError  : '',
            steps      : []
        ]
    }

    private List<Map> buildScenarioSteps(List<Map> rawSteps, String scenarioStatus, String visualError, long endMs) {
        List<Map> result = []

        (rawSteps ?: []).sort { Map a, Map b ->
            asLong(a.timeMs) <=> asLong(b.timeMs)
        }.each { Map row ->
            String detail = safe(row.detail)
            if (detail.isEmpty()) {
                return
            }

            result << [
                status    : 'passed',
                timestamp : formatClock(asLong(row.timeMs)),
                detail    : detail,
                icon      : resolveStepIcon(safe(row.type))
            ]
        }

        if (scenarioStatus == 'failed' && !safe(visualError).isEmpty()) {
            result << [
                status    : 'failed',
                timestamp : formatClock(endMs),
                detail    : visualError,
                icon      : '❌'
            ]
        }

        if (scenarioStatus == 'blocked' && result.isEmpty()) {
            result << [
                status    : 'blocked',
                timestamp : formatClock(endMs),
                detail    : safe(visualError).isEmpty() ? 'Test did not execute.' : visualError,
                icon      : '⏸️'
            ]
        }

        return result
    }

    private List<Map> collectEvidence(File reportFolder, String displayName, String rawName) {
        List<File> images = []

        File evidencesRoot = new File(reportFolder, 'Evidences')
        if (!evidencesRoot.exists()) {
            return []
        }

        List<String> folderCandidates = [
            sanitizeFolderName(displayName),
            sanitizeFolderName(rawName)
        ].findAll { String item -> !safe(item).isEmpty() }.unique()

        folderCandidates.each { String folderName ->
            File caseFolder = new File(evidencesRoot, folderName)
            if (caseFolder.exists()) {
                caseFolder.eachFileRecurse(FileType.FILES) { File file ->
                    if (isImage(file)) {
                        images << file
                    }
                }
            }
        }

        if (images.isEmpty()) {
            String normDisplay = normalizeKey(displayName)
            String normRaw = normalizeKey(rawName)

            evidencesRoot.eachFileRecurse(FileType.FILES) { File file ->
                if (!isImage(file)) {
                    return
                }

                String pathKey = normalizeKey(file.absolutePath)
                if ((!normDisplay.isEmpty() && pathKey.contains(normDisplay)) ||
                    (!normRaw.isEmpty() && pathKey.contains(normRaw))) {
                    images << file
                }
            }
        }

        images = images.unique { File file -> file.absolutePath }
        images.sort { File a, File b -> b.lastModified() <=> a.lastModified() }

        return images.take(5).collect { File file ->
            [
                name  : file.name,
                href  : file.toURI().toString(),
                image : true,
                imgSrc: file.toURI().toString()
            ]
        }
    }

    private boolean isImage(File file) {
        String lower = file.name.toLowerCase(Locale.ENGLISH)
        return lower.endsWith('.png') ||
               lower.endsWith('.jpg') ||
               lower.endsWith('.jpeg') ||
               lower.endsWith('.gif') ||
               lower.endsWith('.bmp') ||
               lower.endsWith('.webp')
    }

    private String resolveSuiteName(File reportFolder, String suiteNameArg, List<Map> scenarios) {
        String supplied = safe(suiteNameArg)
        if (!supplied.isEmpty() && !looksLikeTimestampFolder(supplied)) {
            return supplied
        }

        if (reportFolder != null && reportFolder.parentFile != null) {
            String parentName = safe(reportFolder.parentFile.name)
            if (!parentName.isEmpty() && !looksLikeTimestampFolder(parentName)) {
                return parentName
            }
        }

        if (scenarios != null && !scenarios.isEmpty()) {
            String firstScenario = safe(scenarios[0].name)
            if (firstScenario.contains('/')) {
                List<String> parts = firstScenario.split('/') as List<String>
                if (parts.size() >= 2) {
                    return parts[1]
                }
            }
        }

        return 'Execution'
    }

    private boolean looksLikeTimestampFolder(String value) {
        String text = safe(value)
        return text ==~ /\d{8}_\d{6}/
    }

    private String buildDisplayName(String className, String rawName) {
        String cleanClass = safe(className)
        String cleanName = safe(rawName)

        if (!cleanClass.isEmpty()) {
            if (!cleanName.isEmpty() && cleanClass != cleanName && !cleanClass.endsWith('/' + cleanName)) {
                return cleanClass + '/' + cleanName
            }
            return cleanClass
        }

        return cleanName
    }

    private String buildScenarioId(String value, int index) {
        String normalized = safe(value)
            .replace('\\', '/')
            .replaceAll(/[^A-Za-z0-9\/_-]+/, '-')
            .replaceAll(/-+/, '-')
            .replaceAll(/^[-\/]+|[-\/]+$/, '')

        if (normalized.isEmpty()) {
            normalized = "scenario-${index}"
        }

        return normalized
    }

    private String normalizeScenarioStatus(String rawStatus) {
        String status = safe(rawStatus).toLowerCase(Locale.ENGLISH)

        switch (status) {
            case 'passed':
            case 'pass':
            case 'success':
                return 'passed'
            case 'failed':
            case 'fail':
            case 'error':
                return 'failed'
            case 'blocked':
            case 'skipped':
            case 'skip':
            default:
                return 'blocked'
        }
    }

    private String buildShortError(String fullError) {
        List<String> meaningful = []

        safe(fullError).readLines().each { String line ->
            String clean = safe(line)

            if (clean.isEmpty()) {
                return
            }

            if (clean.equalsIgnoreCase('Reason:')) {
                return
            }

            if (clean.startsWith('at ')) {
                return
            }

            if (clean.startsWith('Build info:')) {
                return
            }

            if (clean.startsWith('System info:')) {
                return
            }

            if (clean.startsWith('Driver info:')) {
                return
            }

            meaningful << clean
        }

        if (meaningful.isEmpty()) {
            return ''
        }

        return meaningful.take(2).join(' | ')
    }

    private String resolveStepIcon(String type) {
        switch (safe(type).toUpperCase(Locale.ENGLISH)) {
            case 'CHECKPOINT':
                return '✅'
            case 'CAPTURE':
                return '🖼️'
            default:
                return '📝'
        }
    }

    private long parseMarkerTime(String value) {
        try {
            return REPORT_MARKER_TIME.parse(safe(value)).time
        } catch (Throwable ignored) {
            return 0L
        }
    }

    private long parseDurationMillis(String value) {
        String text = safe(value)
        if (text.isEmpty()) {
            return 0L
        }

        try {
            return Math.round(Double.parseDouble(text.replace(',', '.')) * 1000d)
        } catch (Throwable ignored) {
            return 0L
        }
    }

    private long parseLongSafe(String value) {
        try {
            return Long.parseLong(safe(value))
        } catch (Throwable ignored) {
            return 0L
        }
    }

    private long asLong(Object value) {
        if (value instanceof Number) {
            return ((Number) value).longValue()
        }

        try {
            return Long.parseLong(safe(value))
        } catch (Throwable ignored) {
            return 0L
        }
    }

    private String formatDateTime(long millis) {
        if (millis <= 0L) {
            return '--'
        }

        return OUTPUT_DATE_TIME.format(new Date(millis))
    }

    private String formatClock(long millis) {
        if (millis <= 0L) {
            return '--'
        }

        return OUTPUT_CLOCK.format(new Date(millis))
    }

    private String formatDuration(long durationMs) {
        if (durationMs < 0L) {
            durationMs = 0L
        }

        long totalSeconds = Math.round(durationMs / 1000.0d)
        long hours = (long) (totalSeconds / 3600L)
        long minutes = (long) ((totalSeconds % 3600L) / 60L)
        long seconds = (long) (totalSeconds % 60L)

        return String.format(Locale.ENGLISH, '%02dh %02dm %02ds', hours, minutes, seconds)
    }

    private List<String> readLines(File file) {
        try {
            return file.readLines('UTF-8')
        } catch (Throwable ignored) {
            try {
                return file.readLines()
            } catch (Throwable ignoredAgain) {
                return []
            }
        }
    }

    private String sanitizeFolderName(String value) {
        return safe(value)
            .replace('\\', '_')
            .replace('/', '_')
            .replaceAll(/[^A-Za-z0-9._ -]+/, '_')
            .replaceAll(/_+/, '_')
            .trim()
    }

    private String normalizeKey(String value) {
        return safe(value)
            .toLowerCase(Locale.ENGLISH)
            .replaceAll(/[^a-z0-9]+/, '')
    }

    private String firstNonBlank(Object... values) {
        for (Object value : values) {
            String text = safe(value)
            if (!text.isEmpty()) {
                return text
            }
        }
        return ''
    }

    private String safe(Object value) {
        return value == null ? '' : String.valueOf(value).trim()
    }
}
