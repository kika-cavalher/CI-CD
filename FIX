class JiraGateway {

	private final Object owner
	private final JsonSlurper jsonSlurper = new JsonSlurper()

	JiraGateway() {
		this(null)
	}

	JiraGateway(Object owner) {
		this.owner = owner
	}

	// =========================================================================
	// PUBLIC API
	// =========================================================================

	Map getIssueByKey(String issueKey) {
		if (blank(issueKey)) {
			return [status: 0, body: '', json: null]
		}

		String url = buildUrl("/rest/api/2/issue/${encodePath(issueKey)}", [
			expand: 'renderedFields,names,schema,operations,editmeta,changelog,versionedRepresentations'
		])

		return doJsonRequest('GET', url, null)
	}

	Map searchIssues(String jql, int maxResults = 200) {
		String url = buildUrl('/rest/api/2/search')

		Map payload = [
			jql       : safe(jql),
			startAt   : 0,
			maxResults: maxResults,
			fields    : ['summary', 'issuetype', 'created']
		]

		return doJsonRequest('POST', url, payload)
	}

	Map searchTestPlans(String projectKey, String summary) {
		String jql = buildTestPlanJql(projectKey, summary)
		return searchIssues(jql, 200)
	}

	Map createTestPlan(String summary, String description = '') {
		String projectKey = firstNonBlank(readOwnerText('PROJECT_KEY'), readOwnerText('PROJECT'), readOwnerText('JIRA_PROJECT_KEY'))
		String issueTypeName = firstNonBlank(readOwnerText('TEST_PLAN_ISSUE_TYPE_NAME'), 'Test Plan')

		Map payload = [
			fields: [
				project    : [key: projectKey],
				summary    : safe(summary),
				description: safe(description),
				issuetype  : [name: issueTypeName]
			]
		]

		String url = buildUrl('/rest/api/2/issue')
		return doJsonRequest('POST', url, payload)
	}

	Map updateTestExecution(String testExecutionKey, String executionTitle, String executionDescription = '') {
		String issueKey = safe(testExecutionKey)

		if (blank(issueKey)) {
			return [status: 0, body: 'Skipped update because testExecutionKey is empty', json: null]
		}

		Map fields = [:]

		if (!blank(executionTitle)) {
			fields.summary = safe(executionTitle)
		}

		if (!blank(executionDescription)) {
			fields.description = safe(executionDescription)
		}

		if (fields.isEmpty()) {
			return [status: 0, body: 'Skipped update because there are no fields to update', json: null]
		}

		String url = buildUrl("/rest/api/2/issue/${encodePath(issueKey)}")
		return doJsonRequest('PUT', url, [fields: fields])
	}

	Map addExecutionToTestPlan(String testPlanKey, String testExecutionKey) {
		if (blank(testPlanKey) || blank(testExecutionKey)) {
			return [status: 0, body: 'Skipped link because testPlanKey or testExecutionKey is empty', json: null]
		}

		String url = buildUrl("/rest/raven/2.0/api/testplan/${encodePath(testPlanKey)}/testexecution")
		List payload = [safe(testExecutionKey)]

		return doJsonRequest('POST', url, payload)
	}

	Map importExecutionResults(File xmlFile) {
		String projectKey = firstNonBlank(readOwnerText('PROJECT_KEY'), readOwnerText('PROJECT'), readOwnerText('JIRA_PROJECT_KEY'))
		return importJunitExecution(xmlFile, projectKey, '')
	}

	Map importJunitExecution(File xmlFile, String projectKey = '', String testPlanKey = '') {
		if (xmlFile == null || !xmlFile.exists()) {
			return [status: 0, body: 'JUnit XML file was not found', json: null]
		}

		Map query = [:]

		if (!blank(projectKey)) {
			query.projectKey = safe(projectKey)
		}

		if (!blank(testPlanKey)) {
			query.testPlanKey = safe(testPlanKey)
		}

		String url = buildUrl('/rest/raven/1.0/import/execution/junit', query)

		return doMultipartFileRequest(
			url,
			xmlFile,
			'file',
			'text/xml',
			[
				'Accept': 'application/json'
			]
		)
	}

	Map addAttachmentToIssue(String issueKey, File file) {
		if (blank(issueKey) || file == null || !file.exists()) {
			return [status: 0, body: 'Skipped attachment because issueKey or file is invalid', json: null]
		}

		String url = buildUrl("/rest/api/2/issue/${encodePath(issueKey)}/attachments")

		return doMultipartFileRequest(
			url,
			file,
			'file',
			'application/octet-stream',
			[
				'X-Atlassian-Token': 'no-check',
				'Accept'           : 'application/json'
			]
		)
	}

	// =========================================================================
	// HTTP
	// =========================================================================

	private Map doJsonRequest(String method, String url, Object payload) {
		HttpURLConnection connection = null

		try {
			connection = openConnection(url, method)
			connection.setRequestProperty('Accept', 'application/json')

			if (payload != null) {
				connection.setDoOutput(true)
				connection.setRequestProperty('Content-Type', 'application/json')

				String json = JsonOutput.toJson(payload)
				connection.outputStream.withWriter('UTF-8') { writer ->
					writer.write(json)
				}
			}

			int status = connection.responseCode
			String body = readBody(connection)

			return [
				status: status,
				body  : body,
				json  : parseJson(body)
			]
		} finally {
			connection?.disconnect()
		}
	}

	private Map doMultipartFileRequest(String url, File file, String fieldName, String contentType, Map extraHeaders = [:]) {
		HttpURLConnection connection = null
		String boundary = '----OpenAIBoundary' + System.currentTimeMillis()

		try {
			connection = openConnection(url, 'POST')
			connection.setDoOutput(true)
			connection.setRequestProperty('Content-Type', "multipart/form-data; boundary=${boundary}")

			extraHeaders.each { String headerName, Object headerValue ->
				connection.setRequestProperty(headerName, safe(headerValue))
			}

			byte[] fileBytes = Files.readAllBytes(file.toPath())

			connection.outputStream.withCloseable { output ->
				output.write(("--${boundary}\r\n").getBytes(StandardCharsets.UTF_8))
				output.write(("Content-Disposition: form-data; name=\"${safe(fieldName)}\"; filename=\"${safe(file.name)}\"\r\n").getBytes(StandardCharsets.UTF_8))
				output.write(("Content-Type: ${safe(contentType)}\r\n\r\n").getBytes(StandardCharsets.UTF_8))
				output.write(fileBytes)
				output.write("\r\n".getBytes(StandardCharsets.UTF_8))
				output.write(("--${boundary}--\r\n").getBytes(StandardCharsets.UTF_8))
				output.flush()
			}

			int status = connection.responseCode
			String body = readBody(connection)

			return [
				status: status,
				body  : body,
				json  : parseJson(body)
			]
		} finally {
			connection?.disconnect()
		}
	}

	private HttpURLConnection openConnection(String url, String method) {
		HttpURLConnection connection = (HttpURLConnection) new URL(url).openConnection()
		connection.setRequestMethod(method)
		connection.setConnectTimeout(60000)
		connection.setReadTimeout(60000)
		connection.setUseCaches(false)
		connection.setDoInput(true)

		String authHeader = resolveAuthorizationHeader()
		if (!blank(authHeader)) {
			connection.setRequestProperty('Authorization', authHeader)
		}

		return connection
	}

	private String readBody(HttpURLConnection connection) {
		InputStream stream = null

		try {
			stream = connection.responseCode >= 400 ? connection.errorStream : connection.inputStream
			if (stream == null) {
				return ''
			}
			return stream.getText('UTF-8')
		} catch (Exception ignored) {
			return ''
		} finally {
			try {
				stream?.close()
			} catch (Exception ignored) {
			}
		}
	}

	// =========================================================================
	// HELPERS
	// =========================================================================

	private String buildTestPlanJql(String projectKey, String summary) {
		String project = safe(projectKey)
		String testPlanIssueType = firstNonBlank(readOwnerText('TEST_PLAN_ISSUE_TYPE_NAME'), 'Test Plan')
		String escapedSummary = safe(summary).replace('\\', '\\\\').replace('"', '\\"')

		return "project = \"${project}\" AND issuetype = \"${testPlanIssueType}\" AND summary ~ \"\\\"${escapedSummary}\\\"\" ORDER BY created DESC"
	}

	private String buildUrl(String path, Map query = [:]) {
		String baseUrl = firstNonBlank(
			readOwnerText('JIRA_BASE_URL'),
			readOwnerText('BASE_URL'),
			readOwnerText('JIRA_URL')
		)

		String normalizedPath = safe(path)
		StringBuilder builder = new StringBuilder()
		builder.append(baseUrl)
		builder.append(normalizedPath)

		Map cleanQuery = query.findAll { key, value -> !blank(value) }
		if (!cleanQuery.isEmpty()) {
			builder.append('?')
			builder.append(cleanQuery.collect { key, value ->
				encodeQueryParam(key) + '=' + encodeQueryParam(value)
			}.join('&'))
		}

		return builder.toString()
	}

	private String resolveAuthorizationHeader() {
		String rawToken = firstNonBlank(
			readOwnerText('AUTHORIZATION_HEADER'),
			readOwnerText('JIRA_AUTHORIZATION_HEADER'),
			readOwnerText('JIRA_TOKEN'),
			readOwnerText('TOKEN')
		)

		if (blank(rawToken)) {
			return ''
		}

		if (rawToken.startsWith('Basic ') || rawToken.startsWith('Bearer ')) {
			return rawToken
		}

		return 'Basic ' + rawToken
	}

	private Object parseJson(String body) {
		if (blank(body)) {
			return null
		}

		try {
			return jsonSlurper.parseText(body)
		} catch (Exception ignored) {
			return null
		}
	}

	private String readOwnerText(String propertyName) {
		if (owner == null || blank(propertyName)) {
			return ''
		}

		try {
			def value = owner."${propertyName}"
			return safe(value)
		} catch (MissingPropertyException ignored) {
			return ''
		} catch (Exception ignored) {
			return ''
		}
	}

	private String encodePath(Object value) {
		return URLEncoder.encode(safe(value), 'UTF-8').replace('+', '%20')
	}

	private String encodeQueryParam(Object value) {
		return URLEncoder.encode(safe(value), 'UTF-8')
	}

	String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}

	boolean blank(Object value) {
		return safe(value).isEmpty()
	}

	private String firstNonBlank(Object... values) {
		if (values == null) {
			return ''
		}

		for (Object value : values) {
			String text = safe(value)
			if (!text.isEmpty()) {
				return text
			}
		}

		package jiraIntegration

import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.exception.StepErrorException

import java.io.File
import java.nio.file.Files
import java.nio.file.StandardCopyOption
import java.util.zip.ZipEntry
import java.util.zip.ZipOutputStream

class JiraExecutionPublisher {

	private final Object owner
	private final JiraGateway gateway

	JiraExecutionPublisher() {
		this(null, null)
	}

	JiraExecutionPublisher(Object owner) {
		this(owner, null)
	}

	JiraExecutionPublisher(Object owner, JiraGateway gateway) {
		this.owner = owner
		this.gateway = gateway != null ? gateway : new JiraGateway(owner)
	}

	// =========================================================================
	// MAIN ENTRYPOINT
	// =========================================================================

	Map publishExecution(Object... args) {
		Map request = normalizeRequest(args)

		File reportFolder = resolveReportFolder(request)
		File xmlFile = resolveXmlFile(request, reportFolder)

		if (xmlFile == null || !xmlFile.exists()) {
			throw new StepErrorException('JUnit_Report.xml was not found in the report folder.')
		}

		String projectKey = firstNonBlank(
			request.projectKey,
			readOwnerText('PROJECT_KEY'),
			readOwnerText('PROJECT'),
			readOwnerText('JIRA_PROJECT_KEY')
		)

		String executionTitle = firstNonBlank(
			request.executionTitle,
			readOwnerText('EXECUTION_TITLE'),
			reportFolder?.parentFile?.name,
			xmlFile.name
		)

		String testPlanKey = firstNonBlank(
			request.testPlanKey,
			request.savedTestPlanKey,
			readOwnerText('MANUAL_TEST_PLAN_KEY'),
			readOwnerText('SAVED_TEST_PLAN_KEY')
		)

		KeywordUtil.logInfo("Importing XML file: ${xmlFile.absolutePath}")

		Map importResponse = gateway.importJunitExecution(xmlFile, projectKey, '')
		KeywordUtil.logInfo("Import Results status: ${importResponse.status}")
		KeywordUtil.logInfo("Import Results response: ${safe(importResponse.body)}")

		if (!(importResponse.status in [200, 201])) {
			throw new StepErrorException("Import execution failed with status ${importResponse.status}")
		}

		String executionKey = extractExecutionKey(importResponse)
		if (blank(executionKey)) {
			throw new StepErrorException('Could not resolve the Test Execution key from the import response.')
		}

		Map updateResponse = gateway.updateTestExecution(executionKey, executionTitle, executionTitle)
		KeywordUtil.logInfo("Update Test Execution status: ${updateResponse.status}")
		KeywordUtil.logInfo("Update Test Execution response: ${safe(updateResponse.body)}")

		if (!(updateResponse.status in [200, 204])) {
			throw new StepErrorException("Update Test Execution failed with status ${updateResponse.status}")
		}

		if (!blank(testPlanKey)) {
			Map addExecutionResponse = gateway.addExecutionToTestPlan(testPlanKey, executionKey)
			KeywordUtil.logInfo("Add execution to Test Plan status: ${addExecutionResponse.status}")
			KeywordUtil.logInfo("Add execution to Test Plan response: ${safe(addExecutionResponse.body)}")

			if (!(addExecutionResponse.status in [200, 201, 204])) {
				throw new StepErrorException("Add execution to Test Plan failed with status ${addExecutionResponse.status}")
			}
		}

		publishAttachmentsAndReport([
			executionKey : executionKey,
			reportFolder : reportFolder,
			htmlReport   : request.htmlReport,
			resultZip    : request.resultZip,
			evidenceZip  : request.evidenceZip,
			evidenceFolder: request.evidenceFolder
		])

		return [
			status          : 200,
			executionKey    : executionKey,
			testExecutionKey: executionKey,
			importResponse  : importResponse,
			updateResponse  : updateResponse
		]
	}

	// =========================================================================
	// ATTACHMENTS
	// =========================================================================

	Map publishAttachmentsAndReport(Object... args) {
		Map request = normalizeRequest(args)

		String executionKey = firstNonBlank(
			request.executionKey,
			request.testExecutionKey,
			request.issueKey
		)

		if (blank(executionKey)) {
			return [status: 0, attached: 0]
		}

		File reportFolder = resolveReportFolder(request)
		List<File> attachments = resolveAttachmentFiles(request, reportFolder)

		int attached = 0

		attachments.each { File file ->
			try {
				Map response = gateway.addAttachmentToIssue(executionKey, file)
				KeywordUtil.logInfo("Attach file ${file.name} status: ${response.status}")
				KeywordUtil.logInfo("Attach file ${file.name} response: ${safe(response.body)}")

				if (response.status in [200, 201]) {
					attached++
				}
			} catch (Exception ex) {
				KeywordUtil.logInfo("Attachment skipped for ${file?.absolutePath}: ${safe(ex.message)}")
			}
		}

		return [status: 200, attached: attached]
	}

	// =========================================================================
	// REQUEST NORMALIZATION
	// =========================================================================

	private Map normalizeRequest(Object... args) {
		Map request = [:]

		if (args == null) {
			return request
		}

		List flatArgs = []
		args.each { Object arg ->
			if (arg instanceof Object[]) {
				flatArgs.addAll((arg as Object[]).toList())
			} else {
				flatArgs << arg
			}
		}

		flatArgs.each { Object arg ->
			if (arg == null) {
				return
			}

			if (arg instanceof Map) {
				request.putAll(arg as Map)
				return
			}

			if (arg instanceof File) {
				applyFileToRequest(request, arg as File)
				return
			}

			String text = safe(arg)
			if (blank(text)) {
				return
			}

			File possibleFile = new File(text)
			if (possibleFile.exists()) {
				applyFileToRequest(request, possibleFile)
				return
			}

			if (looksLikeIssueKey(text)) {
				if (blank(request.testPlanKey)) {
					request.testPlanKey = text
				} else if (blank(request.executionKey)) {
					request.executionKey = text
				}
				return
			}

			if (blank(request.executionTitle)) {
				request.executionTitle = text
				return
			}

			if (blank(request.reportFolder)) {
				request.reportFolder = text
			}
		}

		return request
	}

	private void applyFileToRequest(Map request, File file) {
		if (file == null) {
			return
		}

		if (file.isDirectory()) {
			if (blank(request.reportFolder)) {
				request.reportFolder = file.absolutePath
			}
			return
		}

		String lowerName = safe(file.name).toLowerCase(Locale.ENGLISH)

		if (lowerName.endsWith('.xml')) {
			request.xmlFile = file.absolutePath
			return
		}

		if (lowerName.endsWith('.html')) {
			request.htmlReport = file.absolutePath
			return
		}

		if (lowerName.endsWith('.zip')) {
			if (lowerName.contains('evidence')) {
				request.evidenceZip = file.absolutePath
			} else {
				request.resultZip = file.absolutePath
			}
		}
	}

	// =========================================================================
	// RESOLUTION
	// =========================================================================

	private File resolveReportFolder(Map request) {
		String path = firstNonBlank(
			request.reportFolder,
			request.folder,
			request.baseFolder,
			readOwnerText('CUSTOM_REPORT_PATH'),
			readOwnerText('REPORT_FOLDER')
		)

		if (!blank(path)) {
			File folder = new File(path)
			if (folder.exists() && folder.isDirectory()) {
				return folder
			}
		}

		return null
	}

	private File resolveXmlFile(Map request, File reportFolder) {
		String explicitXml = firstNonBlank(
			request.xmlFile,
			request.junitXml,
			request.primaryXml
		)

		if (!blank(explicitXml)) {
			File explicitFile = new File(explicitXml)
			if (explicitFile.exists() && explicitFile.isFile()) {
				return explicitFile
			}
		}

		String primaryName = firstNonBlank(readOwnerText('PRIMARY_XML_FILE_NAME'), 'JUnit_Report.xml')
		String secondaryName = firstNonBlank(readOwnerText('SECONDARY_XML_FILE_NAME'), 'cucumberReport.xml')

		if (reportFolder != null && reportFolder.exists()) {
			File primary = new File(reportFolder, primaryName)
			if (primary.exists() && primary.isFile()) {
				return primary
			}

			File secondary = new File(reportFolder, secondaryName)
			if (secondary.exists() && secondary.isFile()) {
				return secondary
			}

			List<File> xmlCandidates = reportFolder.listFiles()?.findAll { File file ->
				file.isFile() && safe(file.name).toLowerCase(Locale.ENGLISH).endsWith('.xml')
			} ?: []

			if (!xmlCandidates.isEmpty()) {
				xmlCandidates.sort { File a, File b -> b.lastModified() <=> a.lastModified() }
				return xmlCandidates[0]
			}
		}

		return null
	}

	private List<File> resolveAttachmentFiles(Map request, File reportFolder) {
		List<File> files = []

		File htmlReport = resolveAttachmentFile(
			firstNonBlank(request.htmlReport),
			reportFolder,
			firstNonBlank(readOwnerText('HTML_REPORT_FILE_NAME'), 'jiraReport.html')
		)
		if (htmlReport != null) {
			files << htmlReport
		}

		File resultZip = resolveAttachmentFile(
			firstNonBlank(request.resultZip),
			reportFolder,
			firstNonBlank(readOwnerText('RESULT_ZIP_NAME'), 'Results.zip')
		)
		if (resultZip != null) {
			files << resultZip
		}

		File evidenceZip = resolveAttachmentFile(
			firstNonBlank(request.evidenceZip),
			reportFolder,
			firstNonBlank(readOwnerText('EVIDENCE_ZIP_NAME'), 'Evidences.zip')
		)

		if (evidenceZip == null) {
			File evidenceFolder = resolveAttachmentFile(
				firstNonBlank(request.evidenceFolder),
				reportFolder,
				firstNonBlank(readOwnerText('EVIDENCE_FOLDER_NAME'), 'evidence')
			)

			if (evidenceFolder != null && evidenceFolder.exists() && evidenceFolder.isDirectory()) {
				File generatedZip = new File(reportFolder, firstNonBlank(readOwnerText('EVIDENCE_ZIP_NAME'), 'Evidences.zip'))
				zipFolder(evidenceFolder, generatedZip)
				if (generatedZip.exists()) {
					evidenceZip = generatedZip
				}
			}
		}

		if (evidenceZip != null) {
			files << evidenceZip
		}

		return files.findAll { File file -> file != null && file.exists() && file.isFile() }
	}

	private File resolveAttachmentFile(String explicitPath, File reportFolder, String defaultName) {
		if (!blank(explicitPath)) {
			File explicitFile = new File(explicitPath)
			if (explicitFile.exists()) {
				return explicitFile
			}
		}

		if (reportFolder == null || blank(defaultName)) {
			return null
		}

		File byDefault = new File(reportFolder, defaultName)
		if (byDefault.exists()) {
			return byDefault
		}

		return null
	}

	private void zipFolder(File sourceFolder, File zipFile) {
		if (sourceFolder == null || !sourceFolder.exists() || !sourceFolder.isDirectory()) {
			return
		}

		zipFile.parentFile?.mkdirs()

		ZipOutputStream zipOutput = null

		try {
			zipOutput = new ZipOutputStream(new FileOutputStream(zipFile))
			sourceFolder.eachFileRecurse { File child ->
				if (!child.isFile()) {
					return
				}

				String relativePath = sourceFolder.toPath().relativize(child.toPath()).toString().replace('\\', '/')
				zipOutput.putNextEntry(new ZipEntry(relativePath))
				zipOutput.write(Files.readAllBytes(child.toPath()))
				zipOutput.closeEntry()
			}
		} finally {
			try {
				zipOutput?.close()
			} catch (Exception ignored) {
			}
		}
	}

	// =========================================================================
	// RESPONSE HELPERS
	// =========================================================================

	private String extractExecutionKey(Map importResponse) {
		Object json = importResponse?.json

		if (json instanceof Map) {
			Map map = json as Map

			String key = firstNonBlank(
				map?.testExecIssue?.key,
				map?.testExecutionKey,
				map?.key,
				map?.issueKey
			)

			if (!blank(key)) {
				return key
			}
		}

		String body = safe(importResponse?.body)
		def matcher = (body =~ /"key"\s*:\s*"([A-Z][A-Z0-9_]+-\d+)"/)
		if (matcher.find()) {
			return safe(matcher.group(1))
		}

		return ''
	}

	// =========================================================================
	// SMALL HELPERS
	// =========================================================================

	Map publish(Map request) {
		return publishExecution(request)
	}

	private String readOwnerText(String propertyName) {
		if (owner == null || blank(propertyName)) {
			return ''
		}

		try {
			def value = owner."${propertyName}"
			return safe(value)
		} catch (MissingPropertyException ignored) {
			return ''
		} catch (Exception ignored) {
			return ''
		}
	}

	private boolean looksLikeIssueKey(String text) {
		return safe(text) ==~ /^[A-Z][A-Z0-9_]+-\d+$/
	}

	private String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}

	private boolean blank(Object value) {
		return safe(value).isEmpty()
	}

	private String firstNonBlank(Object... values) {
		if (values == null) {
			return ''
		}

		for (Object value : values) {
			String text = safe(value)
			if (!text.isEmpty()) {
				return text
			}
		}

		return ''
	}
