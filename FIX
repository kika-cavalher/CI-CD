	@Keyword
	boolean clickFirstVisibleInGroup(String groupName, Integer timeoutSeconds) {
		Map<String, String> images = getImages(groupName)

		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 10 : timeoutSeconds
		int elapsedSeconds = 0

		while (elapsedSeconds <= safeTimeout) {
			for (String imageKey : images.keySet()) {
				String imagePath = images[imageKey]

				try {
					def found = WindowsImageKeywords.findImage(imagePath)

					if (found != null && found != false) {
						try {
							WindowsImageKeywords.clickImage(imagePath)

							KeywordUtil.logInfo(
								'First visible image clicked successfully.\n' +
								'Group: ' + groupName + '\n' +
								'Key: ' + imageKey + '\n' +
								'Path: ' + imagePath
							)

							return true
						} catch (Exception clickError) {
							try {
								WindowsImageKeywords.doubleClickImage(imagePath)

								KeywordUtil.logInfo(
									'First visible image double clicked successfully.\n' +
									'Group: ' + groupName + '\n' +
									'Key: ' + imageKey + '\n' +
									'Path: ' + imagePath
								)

								return true
							} catch (Exception doubleClickError) {
								KeywordUtil.logInfo(
									'Image was found but click failed.\n' +
									'Group: ' + groupName + '\n' +
									'Key: ' + imageKey + '\n' +
									'Reason: ' + doubleClickError.getMessage()
								)
							}
						}
					}
				} catch (Exception ignored) {
				}
			}

			if (elapsedSeconds == safeTimeout) {
				break
			}

			Windows.delay(1)
			elapsedSeconds++
		}

		takeEvidence('FirstVisibleImageNotFound_' + groupName + '.png')
		return false
	}

	@Keyword
	void clickImageOrStop(String groupName, String imageKey) {
		String imagePath = getImage(groupName, imageKey)

		waitForImageOrStop(groupName, imageKey, 10)

		try {
			WindowsImageKeywords.clickImage(imagePath)
			KeywordUtil.logInfo('Image clicked successfully: ' + imageKey)
		} catch (Exception e) {
			takeEvidence('ClickImageFailed_' + imageKey + '.png')

			KeywordUtil.markFailedAndStop(
				'Could not click image.\n' +
				'Group: ' + groupName + '\n' +
				'Key: ' + imageKey + '\n' +
				'Path: ' + imagePath + '\n' +
				'Reason: ' + e.getMessage()
			)
		}
	}

	@Keyword
	void clickImageInsideImageOrStop(String groupName, String parentImageKey, String childImageKey) {
		String parentPath = getImage(groupName, parentImageKey)
		String childPath = getImage(groupName, childImageKey)

		waitForImageOrStop(groupName, parentImageKey, 10)
		waitForImageOrStop(groupName, childImageKey, 10)

		try {
			WindowsImageKeywords.clickImageInImage(parentPath, childPath)
			KeywordUtil.logInfo(
				'clickImageInImage executed successfully.\n' +
				'Parent: ' + parentImageKey + '\n' +
				'Child: ' + childImageKey
			)
		} catch (Exception e) {
			takeEvidence('ClickInsideImageFailed_' + childImageKey + '.png')

			KeywordUtil.markFailedAndStop(
				'Could not click child image inside parent image.\n' +
				'Group: ' + groupName + '\n' +
				'Parent: ' + parentImageKey + '\n' +
				'Child: ' + childImageKey + '\n' +
				'Reason: ' + e.getMessage()
			)
		}
	}

	@Keyword
	void takeEvidence(String fileName) {
		try {
			String evidenceDir = RunConfiguration.getReportFolder() + '\\Evidences\\'
			new File(evidenceDir).mkdirs()

			WindowsActionHelper
				.create(WindowsDriverFactory.getWindowsSession())
				.takeScreenshot(evidenceDir + fileName)

			KeywordUtil.logInfo('Evidence captured: ' + evidenceDir + fileName)
		} catch (Exception e) {
			KeywordUtil.logInfo('Could not capture evidence: ' + e.getMessage())
		}
	}

	private String resolveExistingProjectPath(String relativePath) {
		File directFile = new File(RunConfiguration.getProjectDir(), relativePath)

		if (directFile.exists()) {
			return directFile.getAbsolutePath()
		}

		File parentFolder = directFile.getParentFile()

		if (parentFolder != null && parentFolder.exists()) {
			File[] candidates = parentFolder.listFiles()

			if (candidates != null) {
				String targetName = directFile.getName()

				File exactIgnoreCase = candidates.find { File candidate ->
					candidate.getName().equalsIgnoreCase(targetName)
				}

				if (exactIgnoreCase != null) {
					return exactIgnoreCase.getAbsolutePath()
				}
			}
		}

		return directFile.getAbsolutePath()
	}
