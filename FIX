package jiraIntegration

import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil

import java.text.SimpleDateFormat
import java.util.zip.ZipEntry
import java.util.zip.ZipOutputStream

class JiraFlowCoordinator {

	// ============================================================
	// REQUIRED CONFIGURATION
	// ============================================================

	String JIRA_TOKEN = ''
	String PROJECT_KEY = 'GI5PRD'
	String EPIC_KEY = 'GISPRD-9877'
	String JIRA_BASE_URL = 'https://jira-mut.d.bbg'

	// ============================================================
	// OPTIONAL CONFIGURATION
	// ============================================================

	String MANUAL_TEST_PLAN_KEY = ''
	boolean FORCE_CREATE_NEW_TEST_PLAN = false
	String TEST_PLAN_ISSUE_TYPE_ID = '10604'
	String TEST_PLAN_SUFFIX = ' Test Plan'

	String PRIMARY_XML_FILE_NAME = 'JUnit_Report.xml'
	String CUSTOM_REPORT_FILE_NAME = 'JiraReport.html'
	String RESULT_ZIP_NAME = 'Results.zip'
	String EVIDENCE_ZIP_NAME = 'Evidences.zip'

	Map jiraImport(String epicKey = '') {
		logSeparator()
		KeywordUtil.logInfo('Starting Jira import flow')
		logSeparator()

		validateRequiredConfiguration()

		File currentReportFolder = new File(RunConfiguration.getReportFolder())
		File suiteRunFolder = resolveTargetSuiteRunFolder(currentReportFolder)
		String suiteName = resolveSuiteName(suiteRunFolder)

		KeywordUtil.logInfo('Using report folder: ' + suiteRunFolder.absolutePath)
		KeywordUtil.logInfo('Suite name detected from report path: ' + suiteName)

		String executionTitle = suiteName + ' ' + new SimpleDateFormat('yyyy-MM-dd HH.mm.ss').format(new Date())
		KeywordUtil.logInfo('Execution title used: ' + executionTitle)
		KeywordUtil.logInfo('Test Plan title used: ' + suiteName + TEST_PLAN_SUFFIX)

		JiraGateway gateway = new JiraGateway(JIRA_BASE_URL, resolveToken())
		JiraTestPlanManager testPlanManager = new JiraTestPlanManager(gateway, PROJECT_KEY, TEST_PLAN_ISSUE_TYPE_ID)
		JiraReportBuilder reportBuilder = new JiraReportBuilder()
		JiraExecutionPublisher publisher = new JiraExecutionPublisher(gateway)

		File junitXml = reportBuilder.resolveJunitXml(suiteRunFolder)
		KeywordUtil.logInfo('JUnit XML found: ' + junitXml.absolutePath)

		File customReport = reportBuilder.createHtmlReport(suiteRunFolder, suiteName, executionTitle)
		KeywordUtil.logInfo('Custom Jira report created: ' + customReport.absolutePath)

		File resultsZip = createResultsZip(suiteRunFolder)
		File evidencesZip = reportBuilder.createEvidencesZip(suiteRunFolder)

		if (resultsZip != null && resultsZip.exists()) {
			KeywordUtil.logInfo('Results ZIP created: ' + resultsZip.absolutePath)
		}

		if (evidencesZip != null && evidencesZip.exists()) {
			KeywordUtil.logInfo('Evidence ZIP created: ' + evidencesZip.absolutePath)
		}

		String testPlanKey = testPlanManager.getOrCreateTestPlanKey(
			suiteName,
			MANUAL_TEST_PLAN_KEY,
			FORCE_CREATE_NEW_TEST_PLAN
		)

		Map result = publisher.publishExecution([
			junitXml      : junitXml,
			customReport  : customReport,
			reportFolder  : suiteRunFolder,
			projectKey    : PROJECT_KEY,
			testPlanKey   : testPlanKey,
			executionTitle: executionTitle,
			attachments   : [resultsZip, evidencesZip].findAll { it instanceof File && it.exists() }
		])

		KeywordUtil.logInfo('Jira import completed successfully.')
		return result
	}

	// ============================================================
	// TARGET FOLDER RESOLUTION
	// ============================================================

	private File resolveTargetSuiteRunFolder(File currentReportFolder) {
		if (currentReportFolder == null || !currentReportFolder.exists()) {
			throw new RuntimeException('Current Katalon report folder was not found.')
		}

		if (containsJUnitReport(currentReportFolder) && !isJiraImportPath(currentReportFolder.absolutePath)) {
			return currentReportFolder
		}

		File suiteFolder = currentReportFolder.parentFile
		File collectionFolder = suiteFolder != null ? suiteFolder.parentFile : null

		if (collectionFolder == null || !collectionFolder.exists()) {
			throw new RuntimeException('Could not resolve the collection report folder from: ' + currentReportFolder.absolutePath)
		}

		List<File> candidates = []

		File[] suiteFolders = collectionFolder.listFiles()
		if (suiteFolders != null) {
			suiteFolders.each { File childSuiteFolder ->
				if (childSuiteFolder.isDirectory() && !isJiraImportPath(childSuiteFolder.name)) {
					File bestRun = findLatestRunFolderWithJUnit(childSuiteFolder)
					if (bestRun != null) {
						candidates << bestRun
					}
				}
			}
		}

		if (candidates.isEmpty()) {
			throw new RuntimeException('No suite report folder with JUnit_Report.xml was found under: ' + collectionFolder.absolutePath)
		}

		candidates.sort { a, b -> b.lastModified() <=> a.lastModified() }
		return candidates[0]
	}

	private File findLatestRunFolderWithJUnit(File suiteFolder) {
		if (suiteFolder == null || !suiteFolder.exists()) {
			return null
		}

		if (containsJUnitReport(suiteFolder)) {
			return suiteFolder
		}

		List<File> runFolders = []
		File[] children = suiteFolder.listFiles()
		if (children != null) {
			children.each { File child ->
				if (child.isDirectory() && containsJUnitReport(child)) {
					runFolders << child
				}
			}
		}

		if (runFolders.isEmpty()) {
			return null
		}

		runFolders.sort { a, b -> b.lastModified() <=> a.lastModified() }
		return runFolders[0]
	}

	private boolean containsJUnitReport(File folder) {
		if (folder == null || !folder.exists()) {
			return false
		}

		File direct = new File(folder, PRIMARY_XML_FILE_NAME)
		if (direct.exists()) {
			return true
		}

		File[] children = folder.listFiles()
		if (children == null) {
			return false
		}

		for (File child : children) {
			if (child.isFile() && child.name.equalsIgnoreCase(PRIMARY_XML_FILE_NAME)) {
				return true
			}
			if (child.isDirectory() && containsJUnitReport(child)) {
				return true
			}
		}

		return false
	}

	private String resolveSuiteName(File suiteRunFolder) {
		if (suiteRunFolder == null) {
			return 'Execution'
		}

		File parent = suiteRunFolder.parentFile
		if (parent != null && !blank(parent.name)) {
			return parent.name
		}

		return suiteRunFolder.name
	}

	private boolean isJiraImportPath(String text) {
		String lower = safe(text).toLowerCase(Locale.ENGLISH)
		return lower.contains('jira import')
	}

	// ============================================================
	// VALIDATION
	// ============================================================

	private void validateRequiredConfiguration() {
		if (blank(resolveToken())) {
			throw new RuntimeException('JIRA_TOKEN is empty.')
		}

		if (blank(PROJECT_KEY)) {
			throw new RuntimeException('PROJECT_KEY is empty.')
		}

		if (blank(JIRA_BASE_URL)) {
			throw new RuntimeException('JIRA_BASE_URL is empty.')
		}
	}

	private String resolveToken() {
		if (!blank(JIRA_TOKEN)) {
			return JIRA_TOKEN
		}

		String envToken = System.getenv('JIRA_TOKEN')
		if (!blank(envToken)) {
			return envToken
		}

		return ''
	}

	// ============================================================
	// ZIP HELPERS
	// ============================================================

	private File createResultsZip(File suiteRunFolder) {
		File out = new File(suiteRunFolder, RESULT_ZIP_NAME)

		ZipOutputStream zos = new ZipOutputStream(new FileOutputStream(out))
		try {
			List<File> allFiles = []
			collectFilesRecursively(suiteRunFolder, allFiles)

			allFiles.findAll { File file ->
				String lower = file.name.toLowerCase(Locale.ENGLISH)
				return !lower.endsWith('.zip')
			}.each { File file ->
				String entryName = relativePath(suiteRunFolder, file)
				zos.putNextEntry(new ZipEntry(entryName))
				file.withInputStream { is ->
					byte[] buffer = new byte[8192]
					int len
					while ((len = is.read(buffer)) != -1) {
						zos.write(buffer, 0, len)
					}
				}
				zos.closeEntry()
			}
		} finally {
			zos.close()
		}

		return out
	}

	private void collectFilesRecursively(File folder, List<File> output) {
		if (folder == null || !folder.exists()) {
			return
		}

		File[] children = folder.listFiles()
		if (children == null) {
			return
		}

		children.each { File child ->
			if (child.isDirectory()) {
				collectFilesRecursively(child, output)
			} else {
				output << child
			}
		}
	}

	private String relativePath(File root, File file) {
		String rootPath = root.absolutePath.replace('\\', '/')
		String filePath = file.absolutePath.replace('\\', '/')
		String relative = filePath.substring(rootPath.length())
		while (relative.startsWith('/')) {
			relative = relative.substring(1)
		}
		return relative
	}

	// ============================================================
	// HELPERS
	// ============================================================

	private void logSeparator() {
		KeywordUtil.logInfo('============================================================')
	}

	private boolean blank(String value) {
		return safe(value).isEmpty()
	}

	private String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}
