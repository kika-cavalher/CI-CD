	// ---------------------------------------------------------
	// closeMissingRefComptaAlert
	// Used by: validateMissingRefComptaAlert
	// ---------------------------------------------------------

	private void closeMissingRefComptaAlert(
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)
		Integer shortTimeout = Math.min(timeout, 5)

		// Attempt 1: OK button by image
		try {
			if (imageLoader.waitForImage(
				IMAGE_GROUP,
				'okErrorButton',
				shortTimeout
			)) {
				WindowsImageKeywords.clickImage(
					image('okErrorButton')
				)

				if (waitForMissingRefComptaAlertClosed(
					shortTimeout
				)) {
					KeywordUtil.logInfo(
						'[PASS] Missing REF COMPTA alert closed using the OK image.'
					)

					return
				}
			}
		} catch (Throwable okImageError) {
			KeywordUtil.logInfo(
				'[IMAGE] Could not close alert using the OK image.\n' +
					'Reason: ' +
					safeText(okImageError.message)
			)
		}

		// Attempt 2: OK button by Windows object
		WindowsTestObject okButtonObject =
			object('missingRefComptaAlertOkButton')

		if (Windows.waitForElementPresent(
			okButtonObject,
			shortTimeout,
			FailureHandling.OPTIONAL
		)) {
			try {
				Windows.click(
					okButtonObject,
					FailureHandling.OPTIONAL
				)

				if (waitForMissingRefComptaAlertClosed(
					shortTimeout
				)) {
					KeywordUtil.logInfo(
						'[PASS] Missing REF COMPTA alert closed using the OK Windows object.'
					)

					return
				}
			} catch (Throwable okObjectError) {
				KeywordUtil.logInfo(
					'[OBJECT] Could not close alert using the OK Windows object.\n' +
						'Reason: ' +
						safeText(okObjectError.message)
				)
			}
		}

		// Attempt 3: focus modal icon and press ENTER
		try {
			if (imageLoader.waitForImage(
				IMAGE_GROUP,
				'alertModalIcon',
				shortTimeout
			)) {
				WindowsImageKeywords.clickImage(
					image('alertModalIcon')
				)

				Robot robot = new Robot()

				robot.keyPress(KeyEvent.VK_ENTER)
				robot.keyRelease(KeyEvent.VK_ENTER)

				if (waitForMissingRefComptaAlertClosed(
					shortTimeout
				)) {
					KeywordUtil.logInfo(
						'[PASS] Missing REF COMPTA alert closed using modal focus and ENTER.'
					)

					return
				}
			}
		} catch (Throwable modalError) {
			KeywordUtil.logInfo(
				'[IMAGE] Could not close alert using modal icon and ENTER.\n' +
					'Reason: ' +
					safeText(modalError.message)
			)
		}

		takeEvidence(
			'Investigations_MissingRefComptaAlertNotClosed.png'
		)

		KeywordUtil.markFailedAndStop(
			'The missing REF COMPTA alert was displayed but could not be closed.'
		)
	}


	// ---------------------------------------------------------
	// waitForMissingRefComptaAlertClosed
	// Used by: closeMissingRefComptaAlert
	// ---------------------------------------------------------

	private Boolean waitForMissingRefComptaAlertClosed(
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)
		long endTime =
			System.currentTimeMillis() +
				(timeout * 1000L)

		WindowsTestObject alertObject =
			object('missingRefComptaAlert')

		while (System.currentTimeMillis() <= endTime) {
			Boolean alertImageVisible = false
			Boolean alertObjectVisible = false

			try {
				alertImageVisible =
					imageLoader.waitForImage(
						IMAGE_GROUP,
						'alertModalIcon',
						1
					)
			} catch (Throwable ignored) {
				alertImageVisible = false
			}

			try {
				alertObjectVisible =
					Windows.waitForElementPresent(
						alertObject,
						1,
						FailureHandling.OPTIONAL
					)
			} catch (Throwable ignored) {
				alertObjectVisible = false
			}

			if (!alertImageVisible &&
				!alertObjectVisible) {

				return true
			}

			Windows.delay(POLLING_DELAY_SECONDS)
		}

		return false
	}

