    @Keyword
    boolean waitForMainScreen() {
        String liveTitle = waitForMainWindowTitle(resolveWindowTitle(), 30)
        String refreshIconPath = getRefreshIconPath()

        for (int i = 1; i <= WAIT_MAIN_SCREEN_SECONDS; i++) {
            try {
                if (safeVerifyPresent('General/txtSearch', 1)) {
                    KeywordUtil.logInfo("Main screen detected by object at attempt ${i}")
                    return true
                }
            } catch (Throwable ignored) {
            }

            try {
                bringWindowToFront(liveTitle)
                WindowsImageKeywords.clickImage(refreshIconPath)
                KeywordUtil.logInfo("Main screen anchor confirmed by image at attempt ${i}")
                return true
            } catch (Throwable ignored) {
            }

            Windows.delay(1)
        }

        return false
    }

