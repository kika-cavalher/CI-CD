class ExportFile {

	private ImageLoader imageLoader = new ImageLoader()

	@Keyword
	void exportFromOutilsToNo(String exportLabel) {
		KeywordUtil.logInfo('Step 1. Open Outils menu.')
		imageLoader.waitForImageOrStop('General', 'outilsMenu', 15)
		imageLoader.clickImageOrStop('General', 'outilsMenu')
		Windows.delay(2)

		KeywordUtil.logInfo('Step 2. Validate Export button and click it.')
		imageLoader.waitForImageOrStop('General', 'exportButton', 15)
		imageLoader.clickImageOrStop('General', 'exportButton')
		Windows.delay(3)

		KeywordUtil.logInfo('Step 3. Save file inside execution REC/PRD export folder.')
		saveToExecutionRecPrdExportFolder()

		KeywordUtil.logInfo('Step 4. If Kodal asks to open the exported file, close it with No.')
		clickNoUntilOpenFileModalCloses(2, 10)

		KeywordUtil.logInfo('Export flow finished without opening exported file.')
	}

	private void saveToExecutionRecPrdExportFolder() {
		File directory = resolveExecutionRecPrdExportFolder()
		directory.mkdirs()

		String featureNameFromTargetFolder = directory.getName()
		String environment = resolveEnvironmentName(directory)
		String fileName = buildAutomaticExportFileName(environment, featureNameFromTargetFolder)

		KeywordUtil.logInfo('Execution REC/PRD export directory: ' + directory.getAbsolutePath())
		KeywordUtil.logInfo('Resolved export environment: ' + environment)
		KeywordUtil.logInfo('Export feature name from target folder: ' + featureNameFromTargetFolder)
		KeywordUtil.logInfo('Export file name: ' + fileName)

		Windows.click(findWindowsObject('Object Repository/Acapulco/filePath'))
		Windows.delay(2)

		pasteAndEnter(directory.getAbsolutePath())

		Windows.delay(2)

		setFileName(fileName)

		Windows.click(findWindowsObject('General/btnSave'))
		Windows.delay(5)
	}

	private File resolveExecutionRecPrdExportFolder() {
		File executionRootFolder = resolveExecutionRootFolder()
		String collectionName = sanitizeFileName(resolveCurrentCollectionName())
		String featureName = sanitizeFileName(resolveCurrentFeatureName())

		return new File(
				executionRootFolder,
				'Shared_REC_PRD_Exports\\' + collectionName + '\\' + featureName
				)
	}

	private File resolveExecutionRootFolder() {
		String reportFolderPath = RunConfiguration.getReportFolder()

		if (reportFolderPath == null || reportFolderPath.trim().isEmpty()) {
			return new File(RunConfiguration.getProjectDir(), 'Reports\\Unknown_Execution')
		}

		File current = new File(reportFolderPath)

		while (current != null) {
			File parent = current.getParentFile()

			if (parent != null && parent.getName().equalsIgnoreCase('Reports')) {
				return current
			}

			current = parent
		}

		return new File(reportFolderPath)
	}

	private String buildAutomaticExportFileName(String environment, String featureName) {
		String timestamp = new SimpleDateFormat('yyyyMMdd_HHmmss').format(new Date())
		String safeEnvironment = environment == null || environment.trim().isEmpty() ? 'REC' : environment
		String safeFeatureName = featureName == null || featureName.trim().isEmpty() ? resolveCurrentFeatureName() : featureName

		return sanitizeFileName(safeEnvironment + '_' + timestamp + '_' + safeFeatureName) + '.xlsx'
	}

	private String resolveEnvironmentName(File targetDirectory) {
		String visibleEnvironment = getEnvironmentFromVisibleScreen()

		if (visibleEnvironment != null) {
			return visibleEnvironment
		}

		List<String> candidates = []

		addCandidate(candidates, getUiEnvironmentText())
		addCandidate(candidates, getGlobalVariableValue('environment'))
		addCandidate(candidates, getGlobalVariableValue('env'))
		addCandidate(candidates, getGlobalVariableValue('ENV'))
		addCandidate(candidates, getGlobalVariableValue('currentEnv'))
		addCandidate(candidates, getGlobalVariableValue('environmentName'))
		addCandidate(candidates, RunConfiguration.getExecutionProfile())

		for (String candidate : candidates) {
			String normalized = normalizeEnvironmentName(candidate)

			if (normalized != null) {
				return normalized
			}
		}

		String environmentFromCurrentFiles = resolveEnvironmentFromCurrentExportFiles(targetDirectory)

		if (environmentFromCurrentFiles != null) {
			return environmentFromCurrentFiles
		}

		return 'REC'
	}

	private String getEnvironmentFromVisibleScreen() {
		if (isAnyTextVisibleOnCurrentWindow([
			'PROD',
			'PRODUCTION',
			'PRD'
		])) {
			return 'PRD'
		}

		if (isAnyTextVisibleOnCurrentWindow([
			'RECETTE',
			'REC'
		])) {
			return 'REC'
		}

		return null
	}

	private boolean isAnyTextVisibleOnCurrentWindow(List<String> texts) {
		for (String text : texts) {
			if (isTextVisibleOnCurrentWindow(text)) {
				return true
			}
		}

		return false
	}

	private boolean isTextVisibleOnCurrentWindow(String text) {
		if (text == null || text.trim().isEmpty()) {
			return false
		}

		String upperText = text.trim().toUpperCase()

		try {
			WindowsTestObject object = new WindowsTestObject('visibleText_' + sanitizeObjectName(upperText))
			object.setLocatorStrategy(LocatorStrategy.XPATH)
			object.setLocator(
					"//*[contains(translate(@Name, 'abcdefghijklmnopqrstuvwxyz', 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'), '" + upperText + "')]"
					)

			return Windows.verifyElementPresent(object, 1, FailureHandling.OPTIONAL)
		} catch (Exception ignored) {
		}

		return false
	}

	private String resolveEnvironmentFromCurrentExportFiles(File targetDirectory) {
		if (targetDirectory == null || !targetDirectory.exists() || !targetDirectory.isDirectory()) {
			return null
		}

		File[] files = targetDirectory.listFiles()

		if (files == null) {
			return null
		}

		boolean hasRec = false
		boolean hasPrd = false

		for (File file : files) {
			if (!file.isFile()) {
				continue
			}

			String fileName = file.getName().toUpperCase()

			if (!fileName.endsWith('.XLSX')) {
				continue
			}

			if (fileName.startsWith('REC_')) {
				hasRec = true
			}

			if (fileName.startsWith('PRD_')) {
				hasPrd = true
			}
		}

		if (hasRec && !hasPrd) {
			KeywordUtil.logInfo('Environment fallback using current export files: REC already exists and PRD does not exist. Using PRD.')
			return 'PRD'
		}

		if (!hasRec && hasPrd) {
			KeywordUtil.logInfo('Environment fallback using current export files: PRD already exists and REC does not exist. Using REC.')
			return 'REC'
		}

		return null
	}

	private String getUiEnvironmentText() {
		try {
			String value = Windows.getText(findWindowsObject('Object Repository/General/curEnv'))

			if (value != null && !value.trim().isEmpty()) {
				return value
			}
		} catch (Exception ignored) {
		}

		try {
			String value = Windows.getText(findWindowsObject('General/curEnv'))

			if (value != null && !value.trim().isEmpty()) {
				return value
			}
		} catch (Exception ignored) {
		}

		return null
	}

	private String getGlobalVariableValue(String variableName) {
		try {
			def value = GlobalVariable."${variableName}"

			if (value != null && !value.toString().trim().isEmpty()) {
				return value.toString()
			}
		} catch (Exception ignored) {
		}

		return null
	}

	private void addCandidate(List<String> candidates, String value) {
		if (value != null && !value.trim().isEmpty()) {
			candidates.add(value)
		}
	}

	private String normalizeEnvironmentName(String rawEnvironment) {
		if (rawEnvironment == null || rawEnvironment.trim().isEmpty()) {
			return null
		}

		String value = rawEnvironment.trim().toUpperCase()

		boolean hasPrd = value.contains('PRD') ||
				value.contains('PROD') ||
				value.contains('PRODUCTION')

		boolean hasRec = value.contains('REC') ||
				value.contains('RECETTE')

		if (hasPrd) {
			return 'PRD'
		}

		if (hasRec) {
			return 'REC'
		}

		return null
	}

	private String resolveCurrentCollectionName() {
		List<String> validParts = getValidReportFolderParts()

		if (!validParts.isEmpty()) {
			return validParts[0]
		}

		return 'Collection'
	}

	private String resolveCurrentFeatureName() {
		List<String> validParts = getValidReportFolderParts()

		if (!validParts.isEmpty()) {
			return validParts.last()
		}

		return 'Export'
	}

	private List<String> getValidReportFolderParts() {
		List<String> validParts = []
		String reportFolderPath = RunConfiguration.getReportFolder()

		if (reportFolderPath == null || reportFolderPath.trim().isEmpty()) {
			return validParts
		}

		File executionRootFolder = resolveExecutionRootFolder()
		String fullPath = new File(reportFolderPath).getAbsolutePath()
		String rootPath = executionRootFolder.getAbsolutePath()

		if (!fullPath.toLowerCase().startsWith(rootPath.toLowerCase())) {
			return validParts
		}

		String relativePath = fullPath.substring(rootPath.length())
		relativePath = relativePath.replaceAll('^\\\\+', '')

		if (relativePath.trim().isEmpty()) {
			return validParts
		}

		List<String> parts = relativePath.replace('/', '\\').split('\\\\') as List<String>

		for (String part : parts) {
			if (isValidFeatureNamePart(part)) {
				validParts.add(part.trim())
			}
		}

		return validParts
	}

	private boolean isValidFeatureNamePart(String part) {
		if (part == null || part.trim().isEmpty()) {
			return false
		}

		String value = part.trim()
		String lower = value.toLowerCase()

		if (value ==~ /\d{8}_\d{6}/ || value ==~ /\d{14}/) {
			return false
		}

		if (value ==~ /^\d+\.\s*.*/) {
			return false
		}

		List<String> ignoredExactValues = [
			'reports',
			'evidences',
			'exports',
			'test cases',
			'test suites',
			'connection',
			'authentication',
			'login rec',
			'login prd'
		]

		if (ignoredExactValues.contains(lower)) {
			return false
		}

		List<String> ignoredContainsValues = [
			'export',
			'validation',
			'validations',
			'validate',
			'compare',
			'close application',
			'open module',
			'login'
		]

		for (String ignored : ignoredContainsValues) {
			if (lower.contains(ignored)) {
				return false
			}
		}

		return true
	}

	private String sanitizeFileName(String text) {
		if (text == null || text.trim().isEmpty()) {
			return 'Export'
		}

		String normalized = Normalizer.normalize(text, Normalizer.Form.NFD)
				.replaceAll('\\p{InCombiningDiacriticalMarks}+', '')

		return normalized
				.replaceAll('[\\\\/:*?"<>|]', '_')
				.replaceAll('\\s+', '_')
				.replaceAll('_+', '_')
				.replaceAll('^_|_$', '')
				.trim()
	}

	private void setFileName(String fileName) {
		boolean fileNameFieldFocused = focusFileNameField()

		if (!fileNameFieldFocused) {
			imageLoader.takeEvidence('FileNameFieldNotFocused.png')

			KeywordUtil.markFailedAndStop(
					'Could not focus export file name field before saving.\n' +
					'Expected file name: ' + fileName
					)
		}

		clearFocusedField()
		pasteText(fileName)
		Windows.delay(1)
	}

	private boolean focusFileNameField() {
		List<WindowsTestObject> candidateObjects = [
			buildFileNameFieldByAutomationId(),
			buildFileNameFieldByName('File name'),
			buildFileNameFieldByName('Nom du fichier'),
			buildFileNameFieldByName('Nome do ficheiro'),
			buildFileNameFieldByName('Nome do arquivo')
		]

		for (WindowsTestObject object : candidateObjects) {
			try {
				if (Windows.verifyElementPresent(object, 1, FailureHandling.OPTIONAL)) {
					Windows.click(object)
					Windows.delay(1)
					KeywordUtil.logInfo('File name field focused using dynamic Windows object: ' + object.getObjectId())
					return true
				}
			} catch (Exception ignored) {
			}
		}

		try {
			Windows.click(findWindowsObject('General/txtFileName'))
			Windows.delay(1)
			KeywordUtil.logInfo('File name field focused using General/txtFileName.')
			return true
		} catch (Exception ignored) {
			KeywordUtil.logInfo('General/txtFileName was not available.')
		}

		try {
			focusFileNameFieldWithShortcut()
			Windows.delay(1)
			KeywordUtil.logInfo('File name field focused using ALT + N.')
			return true
		} catch (Exception ignored) {
		}

		return false
	}

	private WindowsTestObject buildFileNameFieldByAutomationId() {
		WindowsTestObject object = new WindowsTestObject('fileNameFieldAutomationId')
		object.setLocatorStrategy(LocatorStrategy.XPATH)
		object.setLocator("//*[@AutomationId='FileNameControlHost']")

		return object
	}

	private WindowsTestObject buildFileNameFieldByName(String name) {
		WindowsTestObject object = new WindowsTestObject('fileNameField_' + sanitizeObjectName(name))
		object.setLocatorStrategy(LocatorStrategy.XPATH)
		object.setLocator(
				"//*[contains(translate(@Name, 'abcdefghijklmnopqrstuvwxyz', 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'), '" + name.toUpperCase() + "')]"
				)

		return object
	}

	private void clickNoUntilOpenFileModalCloses(Integer interval, Integer maxTimes) {
		Integer safeInterval = interval == null || interval <= 0 ? 2 : interval
		Integer safeMaxTimes = maxTimes == null || maxTimes <= 0 ? 10 : maxTimes

		for (int attempt = 1; attempt <= safeMaxTimes; attempt++) {
			Windows.delay(safeInterval)

			if (clickNoButtonIfPresent()) {
				Windows.delay(2)

				if (!isOpenFileModalVisible()) {
					KeywordUtil.logInfo('Open file modal closed by clicking No button. Attempt: ' + attempt)
					return
				}

				KeywordUtil.logInfo('Open file modal is still visible after clicking No. Attempt: ' + attempt)
				continue
			}

			if (focusOpenFileModalIfPresent()) {
				KeywordUtil.logInfo('Open file modal focused. Trying ALT + N. Attempt: ' + attempt)
				pressAltN()
				Windows.delay(2)

				if (!isOpenFileModalVisible()) {
					KeywordUtil.logInfo('Open file modal closed with ALT + N.')
					return
				}
			}

			if (!isOpenFileModalVisible()) {
				KeywordUtil.logInfo('Open file modal is no longer visible.')
				return
			}
		}

		if (isOpenFileModalVisible()) {
			imageLoader.takeEvidence('OpenFileModalStillVisible.png')

			KeywordUtil.markFailedAndStop(
					'Open file modal remained visible after trying to close it.\n' +
					'Expected modal: Export de données / Export data\n' +
					'Close strategies tried: click Non/No button and ALT + N'
					)
		}

		KeywordUtil.logInfo('Open file modal did not appear or was already closed. Continuing.')
	}

	private boolean clickNoButtonIfPresent() {
		List<String> buttonNames = [
			'Non',
			'No',
			'Não',
			'Nao'
		]

		for (String buttonName : buttonNames) {
			WindowsTestObject exactButton = buildButtonByExactName(buttonName)

			if (Windows.verifyElementPresent(exactButton, 1, FailureHandling.OPTIONAL)) {
				Windows.click(exactButton)
				KeywordUtil.logInfo('Clicked open-file modal button: ' + buttonName)
				return true
			}
		}

		return false
	}

	private boolean isOpenFileModalVisible() {
		if (isAnyButtonVisible([
			'Non',
			'No',
			'Não',
			'Nao',
			'Oui',
			'Yes',
			'Sim'
		])) {
			return true
		}

		return focusOpenFileModalIfPresent()
	}

	private boolean isAnyButtonVisible(List<String> buttonNames) {
		for (String buttonName : buttonNames) {
			WindowsTestObject button = buildButtonByExactName(buttonName)

			if (Windows.verifyElementPresent(button, 1, FailureHandling.OPTIONAL)) {
				return true
			}
		}

		return false
	}

	private boolean focusOpenFileModalIfPresent() {
		List<String> possibleTitles = [
			'Export de données',
			'Export de donnees',
			'Export data',
			'Data export'
		]

		for (String title : possibleTitles) {
			try {
				Windows.switchToWindowTitle(title)
				Windows.delay(1)
				return true
			} catch (Exception ignored) {
			}
		}

		return false
	}

	private WindowsTestObject buildButtonByExactName(String name) {
		WindowsTestObject object = new WindowsTestObject('button_' + sanitizeObjectName(name))
		object.setLocatorStrategy(LocatorStrategy.XPATH)
		object.setLocator("//Button[@Name=\"" + name + "\"]")

		return object
	}

	private String sanitizeObjectName(String text) {
		if (text == null) {
			return 'empty'
		}

		return text.replaceAll('[^a-zA-Z0-9]', '_')
	}

	private void focusFileNameFieldWithShortcut() {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_ALT)
		robot.keyPress(KeyEvent.VK_N)
		robot.keyRelease(KeyEvent.VK_N)
		robot.keyRelease(KeyEvent.VK_ALT)
	}

	private void pressAltN() {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_ALT)
		robot.keyPress(KeyEvent.VK_N)
		robot.keyRelease(KeyEvent.VK_N)
		robot.keyRelease(KeyEvent.VK_ALT)
	}

	private void clearFocusedField() {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_CONTROL)

		Windows.delay(1)

		robot.keyPress(KeyEvent.VK_BACK_SPACE)
		robot.keyRelease(KeyEvent.VK_BACK_SPACE)
	}

	private void pasteAndEnter(String text) {
		pasteText(text)

		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_ENTER)
		robot.keyRelease(KeyEvent.VK_ENTER)
	}

	private void pasteText(String text) {
		StringSelection selection = new StringSelection(text)
		Toolkit.getDefaultToolkit().getSystemClipboard().setContents(selection, null)

		Windows.delay(1)

		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_V)
		robot.keyRelease(KeyEvent.VK_V)
		robot.keyRelease(KeyEvent.VK_CONTROL)
	}
}
