    List<Map> parseXmlCases(String xmlPath) {
        List<Map> result = []

        if (isBlank(xmlPath)) {
            return result
        }

        File xmlFile = new File(xmlPath)
        if (!xmlFile.exists()) {
            return result
        }

        def xml
        try {
            xml = new XmlSlurper().parse(xmlFile)
        } catch (Exception ignored) {
            return result
        }

        List testcaseNodes = []
        String rootName = safeValue(xml.name())

        if (rootName == 'testsuite') {
            testcaseNodes.addAll(xml.testcase)
        } else if (rootName == 'testsuites') {
            xml.testsuite.each { suite ->
                testcaseNodes.addAll(suite.testcase)
            }
        }

        testcaseNodes.each { tc ->
            String className = safeValue(tc.@classname?.text())
            String testName = safeValue(tc.@name?.text())
            long durationMs = toMillis(tc.@time?.text())

            def failureNode = tc.failure?.size() > 0 ? tc.failure[0] : null
            def errorNode = tc.error?.size() > 0 ? tc.error[0] : null
            def skippedNode = tc.skipped?.size() > 0 ? tc.skipped[0] : null

            boolean failed = (failureNode != null) || (errorNode != null)
            boolean skipped = skippedNode != null

            String message = ''
            String details = ''

            if (failureNode != null) {
                message = safeValue(failureNode.@message?.text())
                details = safeValue(failureNode.text())
            } else if (errorNode != null) {
                message = safeValue(errorNode.@message?.text())
                details = safeValue(errorNode.text())
            } else if (skippedNode != null) {
                message = safeValue(skippedNode.@message?.text())
                details = safeValue(skippedNode.text())
            }

            String displayName = ''
            if (!isBlank(className) && !isBlank(testName)) {
                displayName = className + '/' + testName
            } else if (!isBlank(testName)) {
                displayName = testName
            } else {
                displayName = className
            }

            result.add([
                name      : displayName,
                shortName : isBlank(testName) ? displayName : testName,
                durationMs: durationMs,
                status    : skipped ? 'skipped' : (failed ? 'failed' : 'passed'),
                message   : message,
                details   : details
            ])
        }

        return result
    }

    String createGaiaHtmlReport(String reportFolder, String suiteName, String xmlPath) {
        if (isBlank(reportFolder) || isBlank(xmlPath)) {
            return ''
        }

        List<Map> cases = parseXmlCases(xmlPath)
        List<Map> failedCases = cases.findAll { Map item -> safeValue(item.status) == 'failed' }
        List<Map> passedCases = cases.findAll { Map item -> safeValue(item.status) == 'passed' }
        List<Map> skippedCases = cases.findAll { Map item -> safeValue(item.status) == 'skipped' }

        List<File> failureImages = collectFailureImages(reportFolder)

        int imageIndex = 0
        failedCases.each { Map item ->
            if (imageIndex < failureImages.size()) {
                item.image = failureImages[imageIndex]
                imageIndex++
            } else {
                item.image = null
            }
        }

        long totalDurationMs = 0L
        cases.each { Map item ->
            totalDurationMs += ((item.durationMs ?: 0L) as long)
        }

        File baseDir = new File(reportFolder)
        Date endDate = new Date(baseDir.lastModified())
        Date startDate = new Date(Math.max(0L, endDate.time - totalDurationMs))
        int executed = cases.size()

        String avgTest = executed > 0
            ? formatDurationMillis((long) (totalDurationMs / executed))
            : '0m 0s 0ms'

        File htmlFile = new File(reportFolder + File.separator + getGaiaReportFileName())

        ExtentSparkReporter spark = new ExtentSparkReporter(htmlFile.absolutePath)
        applyGaiaTheme(spark)

        ExtentReports extent = new ExtentReports()
        extent.attachReporter(spark)

        extent.setSystemInfo('Application', 'GAIA')
        extent.setSystemInfo('Suite', safeValue(suiteName))
        extent.setSystemInfo('Start', formatHeaderDate(startDate))
        extent.setSystemInfo('End', formatHeaderDate(endDate))
        extent.setSystemInfo('Suite Duration', formatDurationMillis(totalDurationMs))
        extent.setSystemInfo('Executed', String.valueOf(executed))
        extent.setSystemInfo('Passed', String.valueOf(passedCases.size()))
        extent.setSystemInfo('Failed', String.valueOf(failedCases.size()))
        extent.setSystemInfo('Skipped', String.valueOf(skippedCases.size()))
        extent.setSystemInfo('Avg/Test', avgTest)

        if (cases.isEmpty()) {
            extent.createTest(safeValue(suiteName)).warning('No test cases found in XML report.')
            extent.flush()
            return htmlFile.absolutePath
        }

        cases.each { Map item ->
            String itemName = safeValue(item.name)
            String itemStatus = safeValue(item.status)
            String itemDetails = safeValue(item.details)
            String itemMessage = safeValue(item.message)
            long itemDuration = (item.durationMs ?: 0L) as long

            ExtentTest test = extent.createTest(itemName)
            test.assignCategory(safeValue(suiteName))
            test.info("Duration: ${formatDurationMillis(itemDuration)}")

            if (itemStatus == 'failed') {
                List<String> summaryLines = getFailureSummaryLines(itemMessage, itemDetails)

                if (summaryLines.isEmpty()) {
                    test.fail('Test failed')
                } else {
                    summaryLines.each { String line ->
                        test.fail(line)
                    }
                }

                if (!itemDetails.isEmpty()) {
                    test.info("""
                        <details class="gaia-details">
                            <summary>See full error log</summary>
                            <pre>${htmlEscape(itemDetails)}</pre>
                        </details>
                    """)
                }

                File imageFile = item.image as File
                String base64Image = fileToBase64(imageFile)
                if (!base64Image.isEmpty()) {
                    test.fail(
                        'Failure evidence',
                        MediaEntityBuilder
                            .createScreenCaptureFromBase64String(base64Image, imageFile.name)
                            .build()
                    )
                }
            } else if (itemStatus == 'skipped') {
                test.skip('Test Skipped')
                if (!itemMessage.isEmpty()) {
                    test.skip(itemMessage)
                }
            } else {
                test.pass('Test Passed')
            }
        }

        extent.flush()
        return htmlFile.absolutePath
    }
