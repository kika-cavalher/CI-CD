	// ======================================================
	// GENERIC RECHERCHE AS OF DATE FILTER WITH RETRY
	// ======================================================

	@Keyword
	void applyRechercheAsOfDateFilterWithRetry(
			String asOfDateValue,
			Integer timeoutSeconds,
			Integer maximumAttempts
	) {

		if (asOfDateValue == null ||
			asOfDateValue.trim().isEmpty()) {

			KeywordUtil.markFailedAndStop(
					'As Of Date value is empty.'
					)

			return
		}

		String safeAsOfDateValue =
				asOfDateValue.trim()

		Integer safeTimeout =
				timeoutSeconds == null ||
				timeoutSeconds <= 0
					? DEFAULT_RETRY_TIMEOUT_SECONDS
					: timeoutSeconds

		Integer safeMaximumAttempts =
				maximumAttempts == null ||
				maximumAttempts <= 0
					? DEFAULT_RETRY_ATTEMPTS
					: maximumAttempts

		robot.setAutoDelay(120)

		addNote(
				'Apply Recherche As Of Date filter with retry\n' +
				'As Of Date: ' +
				safeAsOfDateValue +
				'\nTimeout per attempt: ' +
				safeTimeout +
				' seconds\nMaximum attempts: ' +
				safeMaximumAttempts +
				'\nLookup strategy: Windows object first, image fallback'
				)

		Boolean rechercheOpened =
				openRechercheTabWithRetry(
				safeTimeout,
				safeMaximumAttempts
				)

		if (!rechercheOpened) {
			imageLoader.takeEvidence(
					'Recherche_TabNotOpened_AfterRetries.png'
					)

			KeywordUtil.markFailedAndStop(
					'Recherche tab was not opened after all attempts.\n' +
					'Attempts: ' +
					safeMaximumAttempts +
					'\nTimeout per attempt: ' +
					safeTimeout +
					' seconds\nObject key: filter/rechercheTab\n' +
					'Image key: General/rechercheTab'
					)

			return
		}

		Windows.delay(1)

		Boolean dateFilled =
				fillAsOfDateWithRetry(
				safeAsOfDateValue,
				safeTimeout,
				safeMaximumAttempts
				)

		if (!dateFilled) {
			imageLoader.takeEvidence(
					'Recherche_AsOfDateFieldNotFound_AfterRetries.png'
					)

			KeywordUtil.markFailedAndStop(
					'As Of Date field was not filled after all attempts.\n' +
					'Attempts: ' +
					safeMaximumAttempts +
					'\nObject: Object Repository/PNL Comptable/asOfDateFilterPNLEco\n' +
					'Image key: General/asOfDateField'
					)

			return
		}

		Windows.delay(1)

		Boolean searchClicked =
				clickRechercherButtonWithRetry(
				safeTimeout,
				safeMaximumAttempts
				)

		if (!searchClicked) {
			imageLoader.takeEvidence(
					'Recherche_RechercherButtonNotFound_AfterRetries.png'
					)

			KeywordUtil.markFailedAndStop(
					'Rechercher button was not clicked after all attempts.\n' +
					'Attempts: ' +
					safeMaximumAttempts +
					'\nObject: General/btnSearch\n' +
					'Image key: General/rechercherButton'
					)

			return
		}

		Windows.delay(
				safeTimeout
				)

		imageLoader.takeEvidence(
				'Recherche_AsOfDate_Filter_Applied.png'
				)

		KeywordUtil.logInfo(
				'[PASS] Recherche As Of Date filter applied successfully.\n' +
				'As Of Date: ' +
				safeAsOfDateValue +
				'\nMaximum attempts: ' +
				safeMaximumAttempts
				)
	}


