PL Economique - Validation
import org.apache.poi.ss.usermodel.*
import org.apache.poi.ss.usermodel.WorkbookFactory as WorkbookFactory
import com.kms.katalon.core.configuration.RunConfiguration as RunConfiguration
import com.kms.katalon.core.util.KeywordUtil as KeywordUtil
import internal.GlobalVariable as GlobalVariable

String errors = ''

def rows  = GlobalVariable.compareRows as ArrayList
def files = GlobalVariable.compareFiles as ArrayList

String evPath = ((RunConfiguration.getReportFolder() + '\\Evidences\\Evidence_') + GlobalVariable.currencyType) + '\\'
String validationType = GlobalVariable.currencyType   // EUR / USD / Mixte

// Getting file path
String file1 = evPath + files.get(0)

FileInputStream input1 = null
Workbook wbEnv1 = null

try {

    KeywordUtil.logInfo("🟦 [START] PL Economique validation")
    KeywordUtil.logInfo("📄 [FILE] " + file1)
    KeywordUtil.logInfo("⚙️ [CONFIG] currencyType=" + validationType)

    input1 = new FileInputStream(file1)
    wbEnv1 = WorkbookFactory.create(input1)

    Sheet sheetEnv1 = wbEnv1.getSheetAt(0)

    int lastRowNum   = sheetEnv1.getLastRowNum()                 // last index (0-based)
    int physicalRows = sheetEnv1.getPhysicalNumberOfRows()       // physical rows count

    KeywordUtil.logInfo("📊 [SHEET] lastRowNum(index)=" + lastRowNum + " | physicalRows=" + physicalRows + " | rowsToCheck=" + Math.max(0, lastRowNum))

    int Devise      = findHeaderColumn(sheetEnv1, "Devise")
    int DeviseRef   = findHeaderColumn(sheetEnv1, "Devise de ref.")
    int MontantCcy  = findHeaderColumn(sheetEnv1, "Montant ccy")
    int MontantBase = findHeaderColumn(sheetEnv1, "Montant base ccy")

    KeywordUtil.logInfo("🧾 [HEADERS] Devise=" + Devise + " | DeviseRef=" + DeviseRef + " | MontantCcy=" + MontantCcy + " | MontantBase=" + MontantBase)

    boolean needDeviseRef = !(validationType.contains("EUR") || validationType.contains("USD"))

    // ✅ Stop early if any required header is missing
    if (Devise < 0 || MontantCcy < 0 || MontantBase < 0 || (needDeviseRef && DeviseRef < 0)) {
        KeywordUtil.markFailed("[ERROR] Missing required headers. Check Excel header names (Devise / Devise de ref. / Montant ccy / Montant base ccy).")
        return
    }

    int processed = 0
    int skippedNullRow = 0
    int skippedEmptyRow = 0
    int invalidNumeric = 0

    DataFormatter df = new DataFormatter()

    // ✅ IMPORTANT: no 'continue' (Katalon Script mode may not support ContinueStatement)
    for (int i = 1; i <= lastRowNum; i++) {

        Row row = sheetEnv1.getRow(i)

        if (row != null) {

            short lastCell = row.getLastCellNum()

            if (lastCell > 0) {

                processed++

                String devise    = getCellText(row, Devise, df)
                String deviseRef = needDeviseRef ? getCellText(row, DeviseRef, df) : ""

                Double montantCcy  = getCellNumber(row, MontantCcy, df)
                Double montantBase = getCellNumber(row, MontantBase, df)

                if (montantCcy == null || montantBase == null) {
                    invalidNumeric++
                    errors += "[ERROR] In row number ${i} numeric values are invalid.\n"
                } else {

                    double ccy  = round2(montantCcy)
                    double base = round2(montantBase)

                    if (validationType.contains('EUR')) {

                        if ("EUR".equalsIgnoreCase(devise) && ccy != base) {
                            errors += "[ERROR] In row number ${i} the amounts of EUR are different.\n"
                        }

                    } else if (validationType.contains('USD')) {

                        if ("USD".equalsIgnoreCase(devise) && ccy != base) {
                            errors += "[ERROR] In row number ${i} the amounts of USD are different.\n"
                        }

                    } else {

                        if (devise.equalsIgnoreCase(deviseRef) && ccy != base) {
                            errors += "[ERROR] In row number ${i} the amounts should be same, but they are different.\n"
                        }
                    }
                }

            } else {
                skippedEmptyRow++
            }

        } else {
            skippedNullRow++
        }

        // light progress log every 200 rows (keeps console readable)
        if (i % 200 == 0) {
            KeywordUtil.logInfo("🟦 [PROGRESS] i=" + i + "/" + lastRowNum + " | processed=" + processed + " | nullRow=" + skippedNullRow + " | emptyRow=" + skippedEmptyRow + " | invalidNumeric=" + invalidNumeric)
        }
    }

    KeywordUtil.logInfo("✅ [LOOP END] processed=" + processed + " | skippedNullRow=" + skippedNullRow + " | skippedEmptyRow=" + skippedEmptyRow + " | invalidNumeric=" + invalidNumeric + " | lastRowNum=" + lastRowNum)

    if (errors.trim().length() > 0) {
        KeywordUtil.markFailed(errors)
    } else {
        KeywordUtil.markPassed("\n[SUCCESS] Validation of PL Economique finished successfully!\n")
    }

} catch (Exception e) {

    KeywordUtil.markFailed("[ERROR] Excel validation failed: " + e.getClass().getSimpleName() + " | " + e.getMessage())

} finally {

    try { if (wbEnv1 != null) wbEnv1.close() } catch (Exception ignored) {}
    try { if (input1 != null) input1.close() } catch (Exception ignored) {}
}


// =========================
// Helpers
// =========================

int findHeaderColumn(Sheet sheet, String headerName) {

    Row headerRow = sheet.getRow(0)
    if (headerRow == null) {
        KeywordUtil.logInfo("[ERROR] Header row not found (row 0).")
        return -1
    }

    DataFormatter df = new DataFormatter()

    for (int i = 0; i < headerRow.getLastCellNum(); i++) {
        Cell cell = headerRow.getCell(i)
        String value = (cell == null) ? "" : df.formatCellValue(cell).trim()

        if (value.equalsIgnoreCase(headerName)) {
            return i
        }
    }

    KeywordUtil.logInfo("[ERROR] The Header '" + headerName + "' not found.")
    return -1
}

String getCellText(Row row, int col, DataFormatter df) {
    Cell cell = row.getCell(col)
    if (cell == null) return ""
    return df.formatCellValue(cell).trim()
}

Double getCellNumber(Row row, int col, DataFormatter df) {

    Cell cell = row.getCell(col)
    if (cell == null) return null

    try {
        if (cell.getCellType() == CellType.NUMERIC) {
            return cell.getNumericCellValue()
        }

        // if number is stored as text
        String txt = df.formatCellValue(cell).trim()
        if (txt.length() == 0) return null

        // handle "1 234,56" or "1234,56"
        txt = txt.replace(" ", "").replace(",", ".")
        return Double.parseDouble(txt)

    } catch (Exception e) {
        return null
    }
}

double round2(Double v) {
    return Math.round(v * 100.0d) / 100.0d
}


