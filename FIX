	// ======================================================
	// REC X PRD COLUMN STATISTICS
	// ======================================================

	@Keyword
	Map validateRecPrdColumnStatistics(
			List filesToValidate,
			Integer columnIndex,
			String expectedColumnName) {

		Map result = [
			success       : false,
			errors        : '',
			passedDetails : '',
			recFileName   : '',
			prdFileName   : '',
			columnName    : safeText(expectedColumnName),
			recRows       : null,
			prdRows       : null,
			recSum        : null,
			prdSum        : null,
			recMinimum    : null,
			prdMinimum    : null,
			recMaximum    : null,
			prdMaximum    : null
		]

		StringBuilder errors = new StringBuilder()
		StringBuilder passedDetails = new StringBuilder()
		FileInputStream inputRec = null
		FileInputStream inputPrd = null
		Workbook workbookRec = null
		Workbook workbookPrd = null

		try {
			if (filesToValidate == null || filesToValidate.size() < 2) {
				errors.append('[ERROR] REC x PRD validation needs 2 files.\n')
						.append('Expected files: 2\n')
						.append('Available files: ')
						.append(filesToValidate == null ? 0 : filesToValidate.size())

				result.errors = errors.toString()
				return result
			}

			int validatedColumnIndex = columnIndex == null
					? -1
					: columnIndex.intValue()

			if (validatedColumnIndex < 0) {
				errors.append('[ERROR] Invalid column index.\n')
						.append('Column index: ')
						.append(validatedColumnIndex)

				result.errors = errors.toString()
				return result
			}

			File recFile = null
			File prdFile = null

			for (Object fileValue : filesToValidate) {
				if (fileValue == null) {
					continue
				}

				File candidate = fileValue instanceof File
						? fileValue as File
						: new File(safeText(fileValue))

				String candidateName = candidate.getName().toUpperCase()

				if (candidateName.startsWith('REC_')) {
					recFile = candidate
				}

				if (candidateName.startsWith('PRD_')) {
					prdFile = candidate
				}
			}

			if (recFile == null && filesToValidate.size() > 0) {
				Object recValue = filesToValidate.get(0)
				recFile = recValue instanceof File
						? recValue as File
						: new File(safeText(recValue))
			}

			if (prdFile == null && filesToValidate.size() > 1) {
				Object prdValue = filesToValidate.get(1)
				prdFile = prdValue instanceof File
						? prdValue as File
						: new File(safeText(prdValue))
			}

			result.recFileName = recFile == null ? 'NOT FOUND' : recFile.getName()
			result.prdFileName = prdFile == null ? 'NOT FOUND' : prdFile.getName()

			if (recFile == null || !recFile.exists() || !recFile.isFile()) {
				errors.append('[ERROR] REC exported file was not found.\n')
						.append('File: ')
						.append(result.recFileName)
						.append('\n')
			}

			if (prdFile == null || !prdFile.exists() || !prdFile.isFile()) {
				errors.append('[ERROR] PRD exported file was not found.\n')
						.append('File: ')
						.append(result.prdFileName)
						.append('\n')
			}

			if (errors.length() > 0) {
				result.errors = errors.toString().trim()
				return result
			}

			if (!isExcelFile(recFile.getName())) {
				errors.append('[ERROR] REC file is not a supported Excel file.\n')
						.append('File: ')
						.append(recFile.getName())
						.append('\n')
			}

			if (!isExcelFile(prdFile.getName())) {
				errors.append('[ERROR] PRD file is not a supported Excel file.\n')
						.append('File: ')
						.append(prdFile.getName())
						.append('\n')
			}

			if (errors.length() > 0) {
				result.errors = errors.toString().trim()
				return result
			}

			KeywordUtil.logInfo(
					'📊 [REC X PRD STATISTICS] ' +
					'REC=' + recFile.getName() +
					' | PRD=' + prdFile.getName() +
					' | columnIndex=' + validatedColumnIndex
					)

			inputRec = new FileInputStream(recFile)
			inputPrd = new FileInputStream(prdFile)
			workbookRec = WorkbookFactory.create(inputRec)
			workbookPrd = WorkbookFactory.create(inputPrd)

			if (workbookRec.getNumberOfSheets() == 0) {
				errors.append('[ERROR] REC workbook does not contain sheets.\n')
						.append('File: ')
						.append(recFile.getName())
						.append('\n')
			}

			if (workbookPrd.getNumberOfSheets() == 0) {
				errors.append('[ERROR] PRD workbook does not contain sheets.\n')
						.append('File: ')
						.append(prdFile.getName())
						.append('\n')
			}

			if (errors.length() > 0) {
				result.errors = errors.toString().trim()
				return result
			}

			Sheet sheetRec = workbookRec.getSheetAt(0)
			Sheet sheetPrd = workbookPrd.getSheetAt(0)
			DataFormatter formatter = new DataFormatter()
			FormulaEvaluator recEvaluator = workbookRec.getCreationHelper().createFormulaEvaluator()
			FormulaEvaluator prdEvaluator = workbookPrd.getCreationHelper().createFormulaEvaluator()
			String configuredColumnName = safeText(expectedColumnName)
			String recColumnName = readHeaderName(sheetRec, validatedColumnIndex, formatter)
			String prdColumnName = readHeaderName(sheetPrd, validatedColumnIndex, formatter)
			String resolvedColumnName = !recColumnName.isEmpty()
					? recColumnName
					: configuredColumnName

			result.columnName = resolvedColumnName

			if (recColumnName.isEmpty()) {
				errors.append('[ERROR] REC column was not found.\n')
						.append('Column index: ')
						.append(validatedColumnIndex)
						.append('\n')
			}

			if (prdColumnName.isEmpty()) {
				errors.append('[ERROR] PRD column was not found.\n')
						.append('Column index: ')
						.append(validatedColumnIndex)
						.append('\n')
			}

			if (!configuredColumnName.isEmpty() &&
					!recColumnName.isEmpty() &&
					!normalizeHeader(recColumnName).equals(normalizeHeader(configuredColumnName))) {

				errors.append('[ERROR] Unexpected REC column.\n')
						.append('Expected: ')
						.append(configuredColumnName)
						.append('\n')
						.append('Found: ')
						.append(recColumnName)
						.append('\n')
			}

			if (!configuredColumnName.isEmpty() &&
					!prdColumnName.isEmpty() &&
					!normalizeHeader(prdColumnName).equals(normalizeHeader(configuredColumnName))) {

				errors.append('[ERROR] Unexpected PRD column.\n')
						.append('Expected: ')
						.append(configuredColumnName)
						.append('\n')
						.append('Found: ')
						.append(prdColumnName)
						.append('\n')
			}

			if (!recColumnName.isEmpty() &&
					!prdColumnName.isEmpty() &&
					!normalizeHeader(recColumnName).equals(normalizeHeader(prdColumnName))) {

				errors.append('[ERROR] REC and PRD column names are different.\n')
						.append('REC: ')
						.append(recColumnName)
						.append('\n')
						.append('PRD: ')
						.append(prdColumnName)
						.append('\n')
			}

			int recRows = countNonEmptyDataRows(sheetRec, formatter, recEvaluator)
			int prdRows = countNonEmptyDataRows(sheetPrd, formatter, prdEvaluator)

			result.recRows = recRows
			result.prdRows = prdRows

			if (recRows != prdRows) {
				errors.append('[ERROR] Number of rows is different.\n')
						.append('REC: ')
						.append(recRows)
						.append('\n')
						.append('PRD: ')
						.append(prdRows)
						.append('\n')
			} else {
				passedDetails.append('[PASS] Number of rows is equal.\n')
						.append('REC: ')
						.append(recRows)
						.append('\n')
						.append('PRD: ')
						.append(prdRows)
						.append('\n')
			}

			Map recStatistics = calculateColumnStatistics(
					sheetRec,
					validatedColumnIndex,
					formatter,
					recEvaluator
					)

			Map prdStatistics = calculateColumnStatistics(
					sheetPrd,
					validatedColumnIndex,
					formatter,
					prdEvaluator
					)

			int recNumericValues = recStatistics.numericValues as int
			int prdNumericValues = prdStatistics.numericValues as int

			if (recNumericValues == 0) {
				errors.append('[ERROR] REC column does not contain numeric values.\n')
						.append('Column: ')
						.append(resolvedColumnName)
						.append('\n')
			}

			if (prdNumericValues == 0) {
				errors.append('[ERROR] PRD column does not contain numeric values.\n')
						.append('Column: ')
						.append(resolvedColumnName)
						.append('\n')
			}

			if (recNumericValues == 0 || prdNumericValues == 0) {
				result.errors = errors.toString().trim()
				result.passedDetails = passedDetails.toString().trim()
				return result
			}

			BigDecimal recSum = round2(recStatistics.sum as BigDecimal)
			BigDecimal prdSum = round2(prdStatistics.sum as BigDecimal)
			BigDecimal recMinimum = round2(recStatistics.minimum as BigDecimal)
			BigDecimal prdMinimum = round2(prdStatistics.minimum as BigDecimal)
			BigDecimal recMaximum = round2(recStatistics.maximum as BigDecimal)
			BigDecimal prdMaximum = round2(prdStatistics.maximum as BigDecimal)

			result.recSum = recSum
			result.prdSum = prdSum
			result.recMinimum = recMinimum
			result.prdMinimum = prdMinimum
			result.recMaximum = recMaximum
			result.prdMaximum = prdMaximum

			appendComparisonResult(
					errors,
					passedDetails,
					'Column sum',
					resolvedColumnName,
					recSum,
					prdSum
					)

			appendComparisonResult(
					errors,
					passedDetails,
					'Minimum value',
					resolvedColumnName,
					recMinimum,
					prdMinimum
					)

			appendComparisonResult(
					errors,
					passedDetails,
					'Maximum value',
					resolvedColumnName,
					recMaximum,
					prdMaximum
					)

			result.success = errors.length() == 0
			result.errors = errors.toString().trim()
			result.passedDetails = passedDetails.toString().trim()
		} catch (Exception e) {
			errors.append('[ERROR] REC x PRD column statistics validation failed.\n')
					.append('Exception: ')
					.append(e.getClass().getSimpleName())
					.append('\n')
					.append('Message: ')
					.append(safeText(e.getMessage()))

			result.success = false
			result.errors = errors.toString().trim()
			result.passedDetails = passedDetails.toString().trim()
		} finally {
			closeWorkbook(workbookRec)
			closeWorkbook(workbookPrd)
			closeInput(inputRec)
			closeInput(inputPrd)
		}

		return result
	}


	// ======================================================
	// SIMPLE EXPORTED FILE VALIDATION
	// Uses the exact folder and file naming logic from ExportFile.
	// ======================================================

	@Keyword
	Map validateExportedFileExistsAndHasRows(
			String targetEnvironment,
			String exportLabel) {

		String environment = safeText(targetEnvironment)
		String expectedExportLabel = safeText(exportLabel)

		if (expectedExportLabel.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Simple export validation failed.\n' +
					'Export label was not configured.'
					)

			return [success: false]
		}

		ExportFile exportFileKeyword = new ExportFile()

		String exportFolderPath =
				exportFileKeyword.getCurrentExportFolderPath(
				environment,
				expectedExportLabel
				)

		KeywordUtil.logInfo(
				'Simple export validation started.\n' +
				'Environment: ' + environment + '\n' +
				'Export label: ' + expectedExportLabel + '\n' +
				'Folder: ' + exportFolderPath
				)

		String folderValidation =
				validateEvidenceFolderExists(
				exportFolderPath
				)

		if (!safeText(folderValidation).isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Simple export validation failed.\n' +
					folderValidation.trim()
					)

			return [
				success   : false,
				folderPath: exportFolderPath
			]
		}

		String exportedFilePath =
				exportFileKeyword.findLatestExportedFilePath(
				environment,
				expectedExportLabel
				)

		if (safeText(exportedFilePath).isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Simple export validation failed.\n' +
					'Downloaded Excel file was not found.\n' +
					'Environment: ' + environment + '\n' +
					'Export label: ' + expectedExportLabel + '\n' +
					'Folder: ' + exportFolderPath
					)

			return [
				success   : false,
				folderPath: exportFolderPath
			]
		}

		String fileValidation =
				validateExcelFilesFound(
				exportedFilePath
				)

		if (!safeText(fileValidation).isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Simple export validation failed.\n' +
					fileValidation.trim()
					)

			return [
				success   : false,
				filePath  : exportedFilePath,
				folderPath: exportFolderPath
			]
		}

		File exportedFile = new File(exportedFilePath)

		if (exportedFile.length() <= 0) {
			KeywordUtil.markFailedAndStop(
					'Simple export validation failed.\n' +
					'Downloaded file is empty.\n' +
					'File: ' + exportedFile.getName() + '\n' +
					'Path: ' + exportedFile.getAbsolutePath()
					)

			return [
				success   : false,
				filePath  : exportedFilePath,
				folderPath: exportFolderPath
			]
		}

		FileInputStream input = null
		Workbook workbook = null

		try {
			input = new FileInputStream(exportedFile)
			workbook = WorkbookFactory.create(input)

			if (workbook.getNumberOfSheets() <= 0) {
				KeywordUtil.markFailedAndStop(
						'Simple export validation failed.\n' +
						'Downloaded Excel file does not contain worksheets.\n' +
						'File: ' + exportedFile.getName()
						)

				return [
					success   : false,
					filePath  : exportedFilePath,
					folderPath: exportFolderPath
				]
			}

			Sheet sheet = workbook.getSheetAt(0)
			DataFormatter formatter = new DataFormatter()
			FormulaEvaluator evaluator =
					workbook
					.getCreationHelper()
					.createFormulaEvaluator()

			Integer dataRows =
					countNonEmptyDataRows(
					sheet,
					formatter,
					evaluator
					)

			if (dataRows <= 0) {
				KeywordUtil.markFailedAndStop(
						'Simple export validation failed.\n' +
						'Downloaded Excel file does not contain data rows.\n' +
						'File: ' + exportedFile.getName() + '\n' +
						'Data rows: ' + dataRows
						)

				return [
					success   : false,
					fileName  : exportedFile.getName(),
					filePath  : exportedFile.getAbsolutePath(),
					folderPath: exportFolderPath,
					dataRows  : dataRows,
					fileSize  : exportedFile.length()
				]
			}

			Map result = [
				success   : true,
				fileName  : exportedFile.getName(),
				filePath  : exportedFile.getAbsolutePath(),
				folderPath: exportFolderPath,
				dataRows  : dataRows,
				fileSize  : exportedFile.length()
			]

			KeywordUtil.markPassed(
					'Downloaded export validated successfully.\n' +
					'File exists: YES\n' +
					'File: ' + exportedFile.getName() + '\n' +
					'File size: ' + exportedFile.length() + ' bytes\n' +
					'Data rows: ' + dataRows + '\n' +
					'Folder: ' + exportFolderPath
					)

			return result
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop(
					'Simple export validation failed while reading the Excel file.\n' +
					'File: ' + exportedFile.getName() + '\n' +
					'Exception: ' + e.getClass().getSimpleName() + '\n' +
					'Message: ' + safeText(e.getMessage())
					)

			return [
				success   : false,
				fileName  : exportedFile.getName(),
				filePath  : exportedFile.getAbsolutePath(),
				folderPath: exportFolderPath
			]
		} finally {
			closeWorkbook(workbook)
			closeInput(input)
		}
	}


	// ======================================================
	// PRIVATE HEADER VALIDATION
	// ======================================================

	private String validateRequiredHeadersForFile(
			File file,
			String validationType,
			int sheetIndex,
			String headerCurrency,
			String headerCurrencyRef,
			String headerAmountCcy,
			String headerAmountBaseCcy,
			boolean needCurrencyRef) {

		StringBuilder errors = new StringBuilder()
		FileInputStream input = null
		Workbook workbook = null

		try {
			KeywordUtil.logInfo(
					'🧾 [VALIDATE HEADERS] file=' + file.getName() +
					' | validationType=' + validationType
					)

			input = new FileInputStream(file)
			workbook = WorkbookFactory.create(input)

			if (workbook.getNumberOfSheets() <= sheetIndex) {
				errors.append("[ERROR] File '")
						.append(file.getName())
						.append("' does not contain sheet index ")
						.append(sheetIndex)
						.append('.\n')
			} else {
				Sheet sheet = workbook.getSheetAt(sheetIndex)
				DataFormatter formatter = new DataFormatter()
				int currencyCol = findHeaderColumn(sheet, headerCurrency, formatter)
				int currencyRefCol = findHeaderColumn(sheet, headerCurrencyRef, formatter)
				int amountCcyCol = findHeaderColumn(sheet, headerAmountCcy, formatter)
				int amountBaseCol = findHeaderColumn(sheet, headerAmountBaseCcy, formatter)

				if (currencyCol < 0) {
					errors.append("[ERROR] File '")
							.append(file.getName())
							.append("' missing header: ")
							.append(headerCurrency)
							.append('\n')
				}

				if (needCurrencyRef && currencyRefCol < 0) {
					errors.append("[ERROR] File '")
							.append(file.getName())
							.append("' missing header: ")
							.append(headerCurrencyRef)
							.append('\n')
				}

				if (amountCcyCol < 0) {
					errors.append("[ERROR] File '")
							.append(file.getName())
							.append("' missing header: ")
							.append(headerAmountCcy)
							.append('\n')
				}

				if (amountBaseCol < 0) {
					errors.append("[ERROR] File '")
							.append(file.getName())
							.append("' missing header: ")
							.append(headerAmountBaseCcy)
							.append('\n')
				}
			}
		} catch (Exception e) {
			errors.append("[ERROR] Header validation failed for file '")
					.append(file.getName())
					.append("': ")
					.append(e.getClass().getSimpleName())
					.append(' | ')
					.append(e.getMessage())
					.append('\n')
		} finally {
			closeWorkbook(workbook)
			closeInput(input)
		}

		return errors.toString()
	}


