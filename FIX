				sb.append(buildStepRow(step))
			}
			sb.append('</div>')
		}

		String summaryError = firstErrorLine(pickFirst(scenario.visualError, scenario.fullError, ''))
		String fullError = pickFirst(scenario.fullError, scenario.visualError, '')

		if ('failed'.equalsIgnoreCase(scenario.status) && (!summaryError.isEmpty() || !fullError.isEmpty())) {
			sb.append('<div class="error-block">')
			sb.append('<div class="error-title">Visual Error Log</div>')
			sb.append('<div class="error-summary">' + htmlEscape(summaryError) + '</div>')

			if (!fullError.isEmpty()) {
				sb.append('<details class="details-box">')
				sb.append('<summary>🔎 View full error</summary>')
				sb.append('<pre>' + htmlEscape(fullError) + '</pre>')
				sb.append('</details>')
			}

			sb.append('</div>')
		}

		sb.append('<div class="evidence-block">')
		sb.append('<div class="evidence-title">Evidence</div>')

		List<Map> evidenceList = scenario.evidence instanceof List ? (scenario.evidence as List<Map>) : []

		if (evidenceList.isEmpty()) {
			sb.append('<div class="evidence-empty">No evidence was found for this scenario.</div>')
		} else {
			evidenceList.each { Map evidence ->
				sb.append('<details class="evidence-item">')
				sb.append('<summary>🖼 ' + htmlEscape(pickFirst(evidence.name, 'Open evidence')) + '</summary>')

				if (!pickFirst(evidence.href, '').isEmpty()) {
					sb.append('<div class="evidence-links"><a href="' + htmlEscape(evidence.href) + '" target="_blank" rel="noopener noreferrer">🔎 Open evidence</a></div>')
				}

				if (Boolean.TRUE.equals(evidence.image) && !pickFirst(evidence.imgSrc, '').isEmpty()) {
					sb.append('<img class="evidence-image" src="' + htmlEscape(evidence.imgSrc) + '" alt="Evidence">')
				}

				sb.append('</details>')
			}
		}

		sb.append('</div>')
		sb.append('</section>')

		return sb.toString()
	}

	private String buildStepRow(Map step) {
		StringBuilder sb = new StringBuilder()
		sb.append('<div class="step-row">')
		sb.append('<div class="col-status"><span class="status-pill ' + htmlEscape(step.status) + '">' + htmlEscape(statusLabel(step.status)) + '</span></div>')
		sb.append('<div class="col-time">' + htmlEscape(pickFirst(step.timestamp, '--')) + '</div>')
		sb.append('<div class="col-detail"><span class="step-icon">' + htmlEscape(pickFirst(step.icon, 'ℹ️')) + '</span> ' + htmlEscape(pickFirst(step.detail, '')) + '</div>')
		sb.append('</div>')
		return sb.toString()
	}

	private String buildMetaChip(String label, String value, String type) {
		return '<div class="meta-chip ' + htmlEscape(type) + '"><span class="meta-label">' + htmlEscape(label) + ':</span> <span class="meta-value">' + htmlEscape(value) + '</span></div>'
	}

	private String buildChartsSidebar(Map view) {
		StringBuilder sb = new StringBuilder()
		sb.append('<div class="chart-side-wrap">')
		sb.append('<div class="chart-side-title">Execution Status</div>')
		sb.append('<div class="legend-list">')
		sb.append(buildLegendLine('Passed', STATUS_PASS, view.passedCount as int))
		sb.append(buildLegendLine('Failed', STATUS_FAIL, view.failedCount as int))
		sb.append(buildLegendLine('Skipped', STATUS_SKIP, view.skippedCount as int))
		sb.append('</div></div>')
		return sb.toString()
	}

	private String buildChartsPanel(Map view) {
		double failPercent = percent(view.failedCount as int, view.totalCount as int)
		double passPercent = percent(view.passedCount as int, view.totalCount as int)
		double skipPercent = percent(view.skippedCount as int, view.totalCount as int)

		String donutStyle = 'background: conic-gradient(' +
				STATUS_FAIL + ' 0 ' + String.format(Locale.ENGLISH, '%.2f', failPercent) + '%,' +
				STATUS_PASS + ' ' + String.format(Locale.ENGLISH, '%.2f', failPercent) + '% ' +
				String.format(Locale.ENGLISH, '%.2f', failPercent + passPercent) + '%,' +
				STATUS_SKIP + ' ' + String.format(Locale.ENGLISH, '%.2f', failPercent + passPercent) + '% 100%);'

		StringBuilder sb = new StringBuilder()
		sb.append('<section id="charts-panel" class="charts-panel hidden">')
		sb.append('<div class="chart-main-title">Global Overview</div>')
		sb.append('<div class="charts-layout">')

		sb.append('<div><div class="donut-card"><div class="donut" style="' + donutStyle + '"><div class="donut-center"><div class="donut-number">' + String.valueOf(view.totalCount) + '</div><div class="donut-label">Tests</div></div></div></div></div>')
		sb.append('<div><div class="chart-bars">')
		sb.append(buildBarRow('Passed', view.passedCount as int, view.totalCount as int, STATUS_PASS))
		sb.append(buildBarRow('Failed', view.failedCount as int, view.totalCount as int, STATUS_FAIL))
		sb.append(buildBarRow('Skipped', view.skippedCount as int, view.totalCount as int, STATUS_SKIP))
		sb.append('</div></div>')

		sb.append('</div>')
		sb.append('</section>')
		return sb.toString()
	}

	private String buildLegendLine(String label, String color, int value) {
		return '<div class="legend-line"><span class="legend-dot" style="background:' + color + '"></span><span class="legend-text">' + htmlEscape(label) + '</span><span class="legend-value">' + String.valueOf(value) + '</span></div>'
	}

	private String buildBarRow(String label, int value, int total, String color) {
		double width = percent(value, total)

		StringBuilder sb = new StringBuilder()
		sb.append('<div class="bar-row">')
		sb.append('<div class="bar-row-top"><span class="bar-label">' + htmlEscape(label) + '</span><span class="bar-value">' + String.valueOf(value) + '</span></div>')
		sb.append('<div class="bar-track"><div class="bar-fill" style="width:' + String.format(Locale.ENGLISH, '%.2f', width) + '%; background:' + color + '"></div></div>')
		sb.append('<div class="bar-foot">' + String.valueOf(total == 0 ? 0 : Math.round(width)) + '% of execution</div>')
		sb.append('</div>')
		return sb.toString()
	}

	private String buildGeneratedLabel(Map model) {
		String raw = pickFirst(model.generatedAt, model.generatedLabel, model.createdAt, model.executionDate)
		if (!raw.isEmpty()) {
			return 'Generated ' + raw
		}
		return 'Generated ' + new SimpleDateFormat('dd/MM/yyyy HH:mm:ss').format(new Date())
	}

	private String firstErrorLine(String text) {
		List<String> lines = safeValue(text).readLines().collect { safeValue(it) }.findAll { !it.isEmpty() }
		return lines.isEmpty() ? '' : lines[0]
	}

	private String resolveStepIcon(String detail, String status) {
		String lower = safeValue(detail).toLowerCase(Locale.ENGLISH)

		if (status == 'failed') return '❌'
		if (status == 'passed') return '✅'
		if (status == 'skipped') return '⏭️'
		if (lower.contains('click') || lower.contains('select') || lower.contains('tap')) return '🖱️'
		if (lower.contains('open') || lower.contains('navigate') || lower.contains('url')) return '🌐'
		if (lower.contains('wait')) return '⏳'
		if (lower.contains('fill') || lower.contains('input') || lower.contains('type')) return '⌨️'
		if (lower.contains('import') || lower.contains('export') || lower.contains('report')) return '📄'

		return 'ℹ️'
	}

	private String normalizeStatus(String raw) {
		String text = safeValue(raw).toLowerCase(Locale.ENGLISH)

		switch (text) {
			case 'pass':
			case 'passed':
			case 'success':
				return 'passed'
			case 'fail':
			case 'failed':
			case 'error':
				return 'failed'
			case 'skip':
			case 'skipped':
			case 'blocked':
				return 'skipped'
			default:
				return 'info'
		}
	}

	private String statusLabel(String status) {
		switch (safeValue(status)) {
			case 'passed':
				return 'Passed'
			case 'failed':
				return 'Failed'
			case 'skipped':
				return 'Skipped'
			default:
				return 'Info'
		}
	}

	private String resolveLogoHref(Map view) {
		File logoFile = resolveFile(pickFirst(view.logoSrc, LOGO_SRC), pickFirst(view.reportFolder))
		if (logoFile != null && logoFile.exists()) {
			return logoFile.toURI().toString()
		}
		return pickFirst(view.logoSrc, LOGO_SRC)
	}

	private File resolveFile(String path, String baseFolder) {
		String raw = safeValue(path)
		if (raw.isEmpty()) {
			return null
		}

		try {
			if (raw.toLowerCase(Locale.ENGLISH).startsWith('file:/')) {
				File uriFile = new File(new URI(raw))
				if (uriFile.exists()) {
					return uriFile
				}
			}
		} catch (Exception ignored) {
		}

		File direct = new File(raw)
		if (direct.exists()) {
			return direct
		}

		if (!safeValue(baseFolder).isEmpty()) {
			File byBase = new File(baseFolder, raw)
			if (byBase.exists()) {
				return byBase
			}
		}

		return direct
	}

	private boolean isImageFile(String fileName) {
		String lower = safeValue(fileName).toLowerCase(Locale.ENGLISH)
		return lower.endsWith('.png') ||
				lower.endsWith('.jpg') ||
				lower.endsWith('.jpeg') ||
				lower.endsWith('.gif') ||
				lower.endsWith('.webp') ||
				lower.endsWith('.bmp')
	}

	private List asList(def value) {
		if (value == null) return []
		if (value instanceof Collection) return new ArrayList(value as Collection)
		if (value.getClass().isArray()) return (value as Object[]).toList()
		return [value]
	}

	private double percent(int value, int total) {
		if (total <= 0) return 0d
		return ((double) value / (double) total) * 100d
	}

	private String shorten(String text, int max) {
		String value = safeValue(text)
		if (value.length() <= max) return value
		return value.substring(0, Math.max(0, max - 3)) + '...'
	}

	private String safeValue(def value) {
		return value == null ? '' : String.valueOf(value).trim()
	}

	private String pickFirst(Object... values) {
		if (values == null) return ''
		for (Object value : values) {
			String text = safeValue(value)
			if (!text.isEmpty()) return text
		}
		return ''
	}

	private String htmlEscape(def value) {
		String text = safeValue(value)
		return text
				.replace('&', '&amp;')
				.replace('<', '&lt;')
				.replace('>', '&gt;')
				.replace('"', '&quot;')
				.replace("'", '&#39;')
	}

	private String jsEscape(def value) {
		String text = safeValue(value)
		return text
				.replace('\\', '\\\\')
				.replace("'", "\\'")
				.replace('\r', '')
				.replace('\n', '\\n')
	}

