package jiraIntegration

import java.awt.GraphicsDevice
import java.awt.GraphicsEnvironment
import java.awt.MouseInfo
import java.awt.Point
import java.awt.Rectangle
import java.awt.Robot
import java.awt.image.BufferedImage
import java.nio.file.Files
import java.nio.file.StandardCopyOption
import java.text.SimpleDateFormat

import javax.imageio.ImageIO

import org.openqa.selenium.OutputType

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.driver.WindowsDriverFactory

class JiraImagesEvidence {

	private static final String EVIDENCE_FOLDER_NAME = 'Evidences'

	@Keyword
	String autoFailure(String caseId) {
		String effectiveCaseId = safe(caseId)

		if (effectiveCaseId.isEmpty()) {
			KeywordUtil.logInfo('[JIRA_EVIDENCE] autoFailure skipped because caseId is empty.')
			return ''
		}

		try {
			File reportFolder = resolveReportFolder()
			File evidenceRoot = new File(reportFolder, EVIDENCE_FOLDER_NAME)
			File caseFolder = new File(evidenceRoot, sanitizeForPath(effectiveCaseId))

			ensureFolder(evidenceRoot)
			ensureFolder(caseFolder)
			cleanupOldPng(caseFolder)

			String timestamp = new SimpleDateFormat('yyyyMMdd_HHmmss_SSS').format(new Date())
			String fileName = timestamp + '_' + sanitizeForPath(effectiveCaseId) + '_auto_failure.png'
			File targetFile = new File(caseFolder, fileName)

			boolean captured = false

			if (!isRemoteExecution()) {
				captured = tryDriverWindowScreenshot(targetFile)

				if (!captured) {
					captured = tryPointerMonitorScreenshot(targetFile)
				}

				if (!captured) {
					captured = tryPrimaryMonitorScreenshot(targetFile)
				}
			} else {
				captured = tryDriverWindowScreenshot(targetFile)

				if (!captured) {
					captured = tryAllMonitorsScreenshot(targetFile)
				}

				if (!captured) {
					captured = tryPointerMonitorScreenshot(targetFile)
				}
			}

			if (!captured || !targetFile.exists() || targetFile.length() <= 0L) {
				KeywordUtil.logInfo('[JIRA_EVIDENCE] Evidence capture failed for case: ' + effectiveCaseId)
				return ''
			}

			String relativePath = relativizePath(reportFolder, targetFile)

			JiraReportSteps.registerEvidenceStatic(
				effectiveCaseId,
				targetFile.name,
				relativePath,
				targetFile.absolutePath
			)

			KeywordUtil.logInfo('[JIRA_EVIDENCE] Saved: ' + targetFile.absolutePath)
			return targetFile.absolutePath
		} catch (Throwable t) {
			KeywordUtil.logInfo('[JIRA_EVIDENCE] autoFailure failed: ' + safe(t.message))
			return ''
		}
	}

	private static boolean tryDriverWindowScreenshot(File targetFile) {
		try {
			def driver = WindowsDriverFactory.getWindowsDriver()

			if (driver == null) {
				return false
			}

			File temp = driver.getScreenshotAs(OutputType.FILE)

			if (temp == null || !temp.exists() || temp.length() <= 0L) {
				return false
			}

			Files.copy(temp.toPath(), targetFile.toPath(), StandardCopyOption.REPLACE_EXISTING)
			return targetFile.exists() && targetFile.length() > 0L
		} catch (Throwable ignored) {
			return false
		}
	}

	private static boolean tryPointerMonitorScreenshot(File targetFile) {
		try {
			GraphicsEnvironment ge = GraphicsEnvironment.localGraphicsEnvironment
			GraphicsDevice[] devices = ge.screenDevices
			Point pointer = MouseInfo.pointerInfo != null ? MouseInfo.pointerInfo.location : null

			Rectangle bounds = null

			if (pointer != null) {
				for (GraphicsDevice device : devices) {
					Rectangle candidate = device.defaultConfiguration.bounds
					if (candidate != null && candidate.contains(pointer)) {
						bounds = candidate
						break
					}
				}
			}

			if (bounds == null && ge.defaultScreenDevice != null) {
				bounds = ge.defaultScreenDevice.defaultConfiguration.bounds
			}

			return bounds != null && captureRectangle(bounds, targetFile)
		} catch (Throwable ignored) {
			return false
		}
	}

	private static boolean tryPrimaryMonitorScreenshot(File targetFile) {
		try {
			GraphicsEnvironment ge = GraphicsEnvironment.localGraphicsEnvironment
			GraphicsDevice device = ge.defaultScreenDevice

			if (device == null || device.defaultConfiguration == null || device.defaultConfiguration.bounds == null) {
				return false
			}

			return captureRectangle(device.defaultConfiguration.bounds, targetFile)
		} catch (Throwable ignored) {
			return false
		}
	}

	private static boolean tryAllMonitorsScreenshot(File targetFile) {
		try {
			GraphicsEnvironment ge = GraphicsEnvironment.localGraphicsEnvironment
			GraphicsDevice[] devices = ge.screenDevices

			Rectangle union = null

			for (GraphicsDevice device : devices) {
				Rectangle bounds = device.defaultConfiguration != null ? device.defaultConfiguration.bounds : null

				if (bounds == null) {
					continue
				}

				union = union == null ? new Rectangle(bounds) : union.union(bounds)
			}

			return union != null && captureRectangle(union, targetFile)
		} catch (Throwable ignored) {
			return false
		}
	}

	private static boolean captureRectangle(Rectangle bounds, File targetFile) {
		try {
			Robot robot = new Robot()
			BufferedImage image = robot.createScreenCapture(bounds)
			ImageIO.write(image, 'png', targetFile)
			return targetFile.exists() && targetFile.length() > 0L
		} catch (Throwable ignored) {
			return false
		}
	}

	private static File resolveReportFolder() {
		String runFolder = safe(RunConfiguration.getReportFolder())

		if (!runFolder.isEmpty()) {
			File direct = new File(runFolder)
			ensureFolder(direct)
			return direct
		}

		File reportsRoot = new File(RunConfiguration.getProjectDir(), 'Reports')
		ensureFolder(reportsRoot)

		File latest = findLatestLeafFolder(reportsRoot)
		if (latest != null) {
			return latest
		}

		File fallback = new File(reportsRoot, new SimpleDateFormat('yyyyMMdd_HHmmss').format(new Date()))
		ensureFolder(fallback)
		return fallback
	}

	private static File findLatestLeafFolder(File root) {
		List<File> folders = []

		root.eachFileRecurse { File file ->
			if (file.isDirectory()) {
				folders << file
			}
		}

		folders = folders.findAll { File folder ->
			File[] children = folder.listFiles()
			return children != null && children.any { File child -> child.isFile() }
		}

		if (folders.isEmpty()) {
			return null
		}

		folders.sort { File a, File b ->
			Long.valueOf(b.lastModified()).compareTo(Long.valueOf(a.lastModified()))
		}

		return folders[0]
	}

	private static String relativizePath(File reportFolder, File targetFile) {
		try {
			return reportFolder.toPath().relativize(targetFile.toPath()).toString().replace('\\', '/')
		} catch (Throwable ignored) {
			return targetFile.name
		}
	}

	private static void cleanupOldPng(File caseFolder) {
		File[] files = caseFolder.listFiles()

		if (files == null) {
			return
		}

		files.findAll { File f ->
			f.isFile() && f.name.toLowerCase(Locale.ENGLISH).endsWith('.png')
		}.each { File f ->
			try {
				f.delete()
			} catch (Throwable ignored) {
			}
		}
	}

	private static boolean isRemoteExecution() {
		Map<String, String> env = System.getenv()

		return !safe(env['JENKINS_URL']).isEmpty() ||
			   !safe(env['WORKSPACE']).isEmpty() ||
			   !safe(env['BUILD_NUMBER']).isEmpty() ||
			   !safe(env['NODE_NAME']).isEmpty()
	}

	private static void ensureFolder(File folder) {
		if (folder != null && !folder.exists()) {
			folder.mkdirs()
		}
	}

	private static String sanitizeForPath(String value) {
		return safe(value).replaceAll('[^A-Za-z0-9._-]+', '_')
	}

	private static String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}
}
