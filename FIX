			}
		}

		return errors.toString()
	}


	@Keyword
	String validateHeaderExists(
			String filesToValidate,
			String sheetIndexText,
			String headerName) {

		StringBuilder errors =
				new StringBuilder()

		List<File> files =
				parseFiles(filesToValidate)

		int sheetIndex =
				parseIntOrZero(sheetIndexText)

		for (File file : files) {

			FileInputStream input = null
			Workbook workbook = null

			try {

				input =
						new FileInputStream(file)

				workbook =
						WorkbookFactory.create(input)

				if (
				workbook.getNumberOfSheets() <=
						sheetIndex
						) {

					errors.append(
							"[ERROR] File '"
							)
							.append(file.getName())
							.append(
							"' does not contain sheet index "
							)
							.append(sheetIndex)
							.append('.\n')
				} else {

					Sheet sheet =
							workbook.getSheetAt(
							sheetIndex
							)

					DataFormatter formatter =
							new DataFormatter()

					int column =
							findHeaderColumn(
							sheet,
							headerName,
							formatter
							)

					if (column < 0) {

						errors.append(
								"[ERROR] File '"
								)
								.append(file.getName())
								.append(
								"' missing header: "
								)
								.append(headerName)
								.append('\n')
					}
				}
			} catch (Exception e) {

				errors.append(
						"[ERROR] Header exists validation failed for file '"
						)
						.append(file.getName())
						.append("': ")
						.append(
						e.getClass()
						.getSimpleName()
						)
						.append(' | ')
						.append(e.getMessage())
						.append('\n')
			} finally {

				closeWorkbook(workbook)
				closeInput(input)
			}
		}

		return errors.toString()
	}


