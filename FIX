package jiraIntegration

import java.io.BufferedReader
import java.io.File
import java.io.FileInputStream
import java.io.InputStreamReader
import java.math.BigDecimal
import java.nio.charset.StandardCharsets
import java.text.SimpleDateFormat
import java.util.Locale
import java.util.regex.Pattern

import javax.xml.XMLConstants
import javax.xml.parsers.DocumentBuilder
import javax.xml.parsers.DocumentBuilderFactory

import org.w3c.dom.Document
import org.w3c.dom.Element
import org.w3c.dom.Node
import org.w3c.dom.NodeList

class JiraReportBuilder {

    private static final String APP_NAME = 'EMATCH'
    private static final String LOGO_SRC = 'Images/General/logo.png'

    private static final SimpleDateFormat OUTPUT_DATE_TIME =
        new SimpleDateFormat('dd/MM/yyyy HH:mm:ss', Locale.ENGLISH)

    private static final SimpleDateFormat OUTPUT_CLOCK =
        new SimpleDateFormat('HH:mm:ss', Locale.ENGLISH)

    private static final SimpleDateFormat INPUT_LOG_TIME =
        new SimpleDateFormat('yyyy-MM-dd HH:mm:ss.SSS', Locale.ENGLISH)

    private static final Pattern REPORT_STEP_PATTERN =
        Pattern.compile('\\[REPORT_STEP\\]\\s*(.+)$')

    private static final Pattern START_CASE_PATTERN =
        Pattern.compile('START\\s+(Test Cases/.+)$')

    private static final Pattern END_CASE_PATTERN =
        Pattern.compile('END\\s+(Test Cases/.+)$')

    File buildReport(File reportFolder, String suiteName, String executionTitle) {
        Map model = buildModel(reportFolder, suiteName, executionTitle)

        String html = new JiraHtmlTemplateBuilder().build(model)

        File out = new File(reportFolder, 'eMatchReport.html')
        out.write(html, 'UTF-8')
        return out
    }

    private Map buildModel(File reportFolder, String suiteName, String executionTitle) {
        File root = reportFolder ?: new File('.')

        Map<String, Map> logData = parseExecutionLogs(root)
        List<File> junitFiles = collectJUnitFiles(root)
        List<Map> scenarios = []

        junitFiles.each { File junit ->
            scenarios.addAll(parseJUnitFile(junit, logData, root))
        }

        if (scenarios.isEmpty()) {
            scenarios = buildFallbackScenarios(logData, root)
        }

        String resolvedSuiteName = safe(suiteName)
        if (resolvedSuiteName.isEmpty()) {
            resolvedSuiteName = detectSuiteName(root, scenarios)
        }

        String resolvedExecutionTitle = safe(executionTitle)
        if (resolvedExecutionTitle.isEmpty()) {
            resolvedExecutionTitle = resolvedSuiteName
        }

        int passedCount = scenarios.count { safe(it.status) == 'passed' }
        int failedCount = scenarios.count { safe(it.status) == 'failed' }
        int blockedCount = scenarios.count { safe(it.status) == 'blocked' }

        return [
            appName       : APP_NAME,
            logoSrc       : LOGO_SRC,
            reportFolder  : root.absolutePath,
            suiteName     : resolvedSuiteName,
            executionName : resolvedExecutionTitle,
            title         : resolvedExecutionTitle,
            generatedAt   : OUTPUT_DATE_TIME.format(new Date()),
            scenarios     : scenarios,
            passedCount   : passedCount,
            failedCount   : failedCount,
            blockedCount  : blockedCount,
            totalCount    : scenarios.size()
        ]
    }

    private List<Map> parseJUnitFile(File junitFile, Map<String, Map> logData, File reportRoot) {
        List<Map> result = []
        Document doc = parseXml(junitFile)

        if (doc == null) {
            return result
        }

        NodeList testcases = doc.getElementsByTagName('testcase')

        for (int i = 0; i < testcases.length; i++) {
            Element testcase = (Element) testcases.item(i)

            String className = attr(testcase, 'classname')
            String rawName = attr(testcase, 'name')
            String caseId = buildCaseName(className, rawName, i + 1)

            Element failureNode = firstChild(testcase, 'failure')
            Element errorNode = firstChild(testcase, 'error')
            Element skippedNode = firstChild(testcase, 'skipped')

            String status = 'passed'
            String fullError = ''
            String visualError = ''

            if (failureNode != null) {
                status = 'failed'
                fullError = extractNodeText(failureNode)
            } else if (errorNode != null) {
                status = 'failed'
                fullError = extractNodeText(errorNode)
            } else if (skippedNode != null) {
                status = 'blocked'
                fullError = extractNodeText(skippedNode)
            }

            if (status == 'failed') {
                visualError = buildShortError(fullError)
            }

            Map logEntry = findLogEntry(logData, caseId)

            long startMs = asLong(logEntry.startMs)
            long endMs = asLong(logEntry.endMs)

            long durationMs = 0L
            if (startMs > 0L && endMs >= startMs) {
                durationMs = endMs - startMs
            } else {
                durationMs = toDurationMillis(attr(testcase, 'time'))
            }

            List<String> steps = normalizeSteps(logEntry.steps)

            List<Map> evidence = []
            if (status == 'failed') {
                evidence = collectEvidence(reportRoot, caseId)
            }

            result << [
                id            : buildScenarioId(caseId, i + 1),
                name          : caseId,
                status        : status,
                startMs       : startMs,
                endMs         : endMs,
                startLabel    : formatDateTime(startMs),
                endLabel      : formatDateTime(endMs),
                durationMs    : durationMs,
                durationLabel : formatDuration(durationMs),
                steps         : steps,
                visualError   : visualError,
                fullError     : fullError,
                evidence      : evidence
            ]
        }

        return result
    }

    private List<Map> buildFallbackScenarios(Map<String, Map> logData, File reportRoot) {
        List<Map> scenarios = []
        int index = 1

        logData.each { String caseId, Map row ->
            long startMs = asLong(row.startMs)
            long endMs = asLong(row.endMs)
            long durationMs = (startMs > 0L && endMs >= startMs) ? (endMs - startMs) : 0L

            scenarios << [
                id            : buildScenarioId(caseId, index++),
                name          : caseId,
                status        : 'passed',
                startMs       : startMs,
                endMs         : endMs,
                startLabel    : formatDateTime(startMs),
                endLabel      : formatDateTime(endMs),
                durationMs    : durationMs,
                durationLabel : formatDuration(durationMs),
                steps         : normalizeSteps(row.steps),
                visualError   : '',
                fullError     : '',
                evidence      : []
            ]
        }

        return scenarios
    }

    private Map<String, Map> parseExecutionLogs(File root) {
        Map<String, Map> result = [:]

        List<File> logFiles = collectLogFiles(root)

        logFiles.each { File logFile ->
            String currentCase = ''

            eachLineSafely(logFile) { String line ->
                String safeLine = safe(line)
                if (safeLine.isEmpty()) {
                    return
                }

                def startMatcher = START_CASE_PATTERN.matcher(safeLine)
                if (startMatcher.find()) {
                    currentCase = safe(startMatcher.group(1))
                    Map row = ensureCaseRow(result, currentCase)
                    long startMs = parseLogMillis(safeLine)
                    if (row.startMs == null || asLong(row.startMs) <= 0L) {
                        row.startMs = startMs
                    }
                    return
                }

                def endMatcher = END_CASE_PATTERN.matcher(safeLine)
                if (endMatcher.find()) {
                    String endedCase = safe(endMatcher.group(1))
                    Map row = ensureCaseRow(result, endedCase)
                    row.endMs = parseLogMillis(safeLine)
                    currentCase = ''
                    return
                }

                if (currentCase.isEmpty()) {
                    return
                }

                def reportStepMatcher = REPORT_STEP_PATTERN.matcher(safeLine)
                if (reportStepMatcher.find()) {
                    String detail = safe(reportStepMatcher.group(1))
                    if (!detail.isEmpty()) {
                        Map row = ensureCaseRow(result, currentCase)
                        row.steps << detail
                    }
                }
            }
        }

        result.each { String caseId, Map row ->
            row.steps = normalizeSteps(row.steps)

            long startMs = asLong(row.startMs)
            long endMs = asLong(row.endMs)

            if (startMs > 0L && endMs >= startMs) {
                row.durationMs = endMs - startMs
            } else {
                row.durationMs = 0L
            }
        }

        return result
    }

    private Map ensureCaseRow(Map<String, Map> result, String caseId) {
        if (!result.containsKey(caseId)) {
            result[caseId] = [
                startMs   : 0L,
                endMs     : 0L,
                durationMs: 0L,
                steps     : []
            ]
        }
        return result[caseId]
    }

    private Map findLogEntry(Map<String, Map> logData, String caseId) {
        if (logData.containsKey(caseId)) {
            return logData[caseId]
        }

        String target = normalizeKey(caseId)

        for (Map.Entry<String, Map> entry : logData.entrySet()) {
            if (normalizeKey(entry.key) == target) {
                return entry.value
            }
        }

        return [:]
    }

    private List<File> collectJUnitFiles(File root) {
        List<File> result = []

        if (root == null || !root.exists()) {
            return result
        }

        root.eachFileRecurse { File file ->
            if (!file.isFile()) {
                return
            }

            String lower = safe(file.name).toLowerCase(Locale.ENGLISH)
            if (lower == 'junit_report.xml') {
                result << file
            }
        }

        result.sort { File a, File b -> a.absolutePath <=> b.absolutePath }
        return result
    }

    private List<File> collectLogFiles(File root) {
        List<File> result = []

        if (root == null || !root.exists()) {
            return result
        }

        root.eachFileRecurse { File file ->
            if (!file.isFile()) {
                return
            }

            String lower = safe(file.name).toLowerCase(Locale.ENGLISH)
            if (lower.endsWith('.log')) {
                result << file
            }
        }

        result = result.findAll { File file ->
            file.length() > 0L
        }

        result.sort { File a, File b ->
            int priorityA = logPriority(a.name)
            int priorityB = logPriority(b.name)

            if (priorityA != priorityB) {
                return priorityA <=> priorityB
            }

            return a.lastModified() <=> b.lastModified()
        }

        return result
    }

    private int logPriority(String name) {
        String lower = safe(name).toLowerCase(Locale.ENGLISH)

        if (lower == 'execution0.log') {
            return 0
        }
        if (lower.contains('execution')) {
            return 1
        }
        if (lower.endsWith('.log')) {
            return 2
        }
        return 10
    }

    private List<Map> collectEvidence(File root, String caseId) {
        List<Map> result = []

        if (root == null || !root.exists()) {
            return result
        }

        String normalizedCase = normalizeKey(caseId)
        List<File> imageFiles = []

        root.eachFileRecurse { File file ->
            if (!file.isFile()) {
                return
            }

            String lower = safe(file.name).toLowerCase(Locale.ENGLISH)
            if (lower.endsWith('.png') ||
                lower.endsWith('.jpg') ||
                lower.endsWith('.jpeg') ||
                lower.endsWith('.gif') ||
                lower.endsWith('.bmp') ||
                lower.endsWith('.webp')) {
                imageFiles << file
            }
        }

        List<Map> scored = []

        imageFiles.each { File file ->
            String normalizedPath = normalizeKey(file.absolutePath)
            int score = 0

            if (normalizedPath.contains(normalizedCase)) {
                score += 100
            }

            if (normalizedPath.contains('evidences')) {
                score += 20
            }

            if (normalizedPath.contains('autofailure') || normalizedPath.contains('auto-failure')) {
                score += 10
            }

            if (normalizedPath.contains('failure') || normalizedPath.contains('failed')) {
                score += 5
            }

            scored << [
                file : file,
                score: score
            ]
        }

        scored.sort { Map a, Map b ->
            int byScore = (b.score as int) <=> (a.score as int)
            if (byScore != 0) {
                return byScore
            }
            return ((b.file as File).lastModified()) <=> ((a.file as File).lastModified())
        }

        scored.findAll { Map row ->
            (row.score as int) > 0
        }.take(3).each { Map row ->
            File file = row.file as File
            result << [
                name  : file.name,
                href  : file.toURI().toString(),
                imgSrc: file.toURI().toString()
            ]
        }

        return result
    }

    private Document parseXml(File file) {
        try {
            DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance()
            factory.setNamespaceAware(false)
            factory.setValidating(false)
            factory.setFeature(XMLConstants.FEATURE_SECURE_PROCESSING, true)

            DocumentBuilder builder = factory.newDocumentBuilder()
            return builder.parse(file)
        } catch (Throwable ignored) {
            return null
        }
    }

    private Element firstChild(Element parent, String tagName) {
        if (parent == null) {
            return null
        }

        NodeList children = parent.getElementsByTagName(tagName)
        if (children == null || children.length == 0) {
            return null
        }

        Node node = children.item(0)
        return (node instanceof Element) ? (Element) node : null
    }

    private String extractNodeText(Element element) {
        if (element == null) {
            return ''
        }

        String text = safe(element.getTextContent())
        return text
    }

    private String buildShortError(String fullError) {
        String raw = safe(fullError)
        if (raw.isEmpty()) {
            return ''
        }

        List<String> lines = raw
            .replace('\r', '\n')
            .split('\n')
            .collect { String it -> safe(it) }
            .findAll { String it ->
                !it.isEmpty() && !it.startsWith('at ') && !it.startsWith('Caused by:')
            }

        if (lines.isEmpty()) {
            return ''
        }

        String first = lines[0]
        if (first.equalsIgnoreCase('Reason:') && lines.size() > 1) {
            first = lines[1]
        }

        return first
    }

    private String buildCaseName(String className, String rawName, int index) {
        String cleanClass = safe(className)
        String cleanName = safe(rawName)

        if (!cleanClass.isEmpty() && cleanClass.startsWith('Test Cases/')) {
            return cleanClass
        }

        if (!cleanClass.isEmpty() && !cleanName.isEmpty()) {
            if (cleanClass.endsWith(cleanName)) {
                return cleanClass
            }
            return cleanClass + '/' + cleanName
        }

        if (!cleanClass.isEmpty()) {
            return cleanClass
        }

        if (!cleanName.isEmpty()) {
            return cleanName
        }

        return 'Scenario ' + index
    }

    private String detectSuiteName(File root, List<Map> scenarios) {
        if (root != null && root.parentFile != null) {
            String parentName = safe(root.parentFile.name)
            if (!parentName.isEmpty()) {
                return parentName
            }
        }

        if (root != null) {
            String folderName = safe(root.name)
            if (!folderName.isEmpty()) {
                return folderName
            }
        }

        if (scenarios != null && !scenarios.isEmpty()) {
            return safe(scenarios[0].name)
        }

        return 'Execution'
    }

    private String buildScenarioId(String value, int index) {
        String text = safe(value)
            .replace('\\', '/')
            .replaceAll('[^A-Za-z0-9/_-]+', '-')
            .replaceAll('-+', '-')
            .replaceAll('^[-/]+|[-/]+\$', '')

        if (text.isEmpty()) {
            return 'scenario-' + index
        }

        return text
    }

    private List<String> normalizeSteps(def rawSteps) {
        List<String> result = []

        if (rawSteps == null) {
            return result
        }

        if (rawSteps instanceof Collection) {
            rawSteps.each { Object item ->
                String step = safe(item)
                if (!step.isEmpty()) {
                    result << step
                }
            }
        } else {
            String step = safe(rawSteps)
            if (!step.isEmpty()) {
                result << step
            }
        }

        result = result.unique()
        return result
    }

    private long parseLogMillis(String line) {
        String text = safe(line)
        if (text.length() < 23) {
            return 0L
        }

        try {
            return INPUT_LOG_TIME.parse(text.substring(0, 23)).time
        } catch (Throwable ignored) {
            return 0L
        }
    }

    private long toDurationMillis(String secondsValue) {
        String value = safe(secondsValue)
        if (value.isEmpty()) {
            return 0L
        }

        try {
            BigDecimal seconds = new BigDecimal(value.replace(',', '.'))
            return seconds.multiply(new BigDecimal('1000')).longValue()
        } catch (Throwable ignored) {
            return 0L
        }
    }

    private String formatDateTime(long millis) {
        if (millis <= 0L) {
            return '--'
        }
        return OUTPUT_DATE_TIME.format(new Date(millis))
    }

    private String formatDuration(long durationMs) {
        if (durationMs < 0L) {
            durationMs = 0L
        }

        long totalSeconds = Math.round(durationMs / 1000d)
        long hours = (long) (totalSeconds / 3600L)
        long minutes = (long) ((totalSeconds % 3600L) / 60L)
        long seconds = (long) (totalSeconds % 60L)

        return String.format(Locale.ENGLISH, '%02dh %02dm %02ds', hours, minutes, seconds)
    }

    private String normalizeKey(String value) {
        return safe(value)
            .toLowerCase(Locale.ENGLISH)
            .replaceAll('[^a-z0-9]+', '')
    }

    private String attr(Element element, String attrName) {
        try {
            return safe(element.getAttribute(attrName))
        } catch (Throwable ignored) {
            return ''
        }
    }

    private void eachLineSafely(File file, Closure consumer) {
        BufferedReader reader = null
        try {
            reader = new BufferedReader(new InputStreamReader(new FileInputStream(file), StandardCharsets.UTF_8))
            String line
            while ((line = reader.readLine()) != null) {
                consumer.call(line)
            }
        } catch (Throwable ignored) {
        } finally {
            try {
                reader?.close()
            } catch (Throwable ignored) {
            }
        }
    }

    private long asLong(def value) {
        try {
            return Long.parseLong(String.valueOf(value))
        } catch (Throwable ignored) {
            return 0L
        }
    }

    private String safe(def value) {
        return value == null ? '' : String.valueOf(value).trim()
    }
}














package jiraIntegration

import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale

class JiraHtmlTemplateBuilder {

    private static final String STATUS_PASS = '#68b84b'
    private static final String STATUS_FAIL = '#e05b4d'
    private static final String STATUS_BLOCKED = '#c58a11'
    private static final String STATUS_INFO = '#6527d7'

    String build(Map model) {
        Map view = normalizeModel(model)

        StringBuilder html = new StringBuilder()

        html.append('<!DOCTYPE html>\n')
        html.append('<html lang="en">\n')
        html.append('<head>\n')
        html.append('<meta charset="UTF-8">\n')
        html.append('<meta name="viewport" content="width=device-width, initial-scale=1.0">\n')
        html.append('<title>')
        html.append(htmlEscape(view.executionName))
        html.append('</title>\n')
        html.append(buildStyles())
        html.append('</head>\n')
        html.append('<body>\n')

        html.append('<header class="top-banner">\n')
        html.append('  <div class="brand-area">\n')
        html.append('    <div class="brand-logo-wrap"><img class="brand-logo" src="')
        html.append(htmlEscape(view.logoSrc))
        html.append('" alt="EMATCH logo"></div>\n')
        html.append('    <div class="brand-copy">\n')
        html.append('      <div class="brand-title">Test report - ')
        html.append(htmlEscape(view.executionName))
        html.append('</div>\n')
        html.append('      <div class="brand-subtitle">EMATCH execution overview</div>\n')
        html.append('    </div>\n')
        html.append('  </div>\n')
        html.append('</header>\n')

        html.append('<div class="page">\n')

        html.append('<aside class="sidebar">\n')
        html.append('  <div class="sidebar-tabs">\n')
        html.append('    <button id="tab-tests" class="sidebar-tab active" type="button" onclick="showTab(\'tests\')">Tests</button>\n')
        html.append('    <button id="tab-charts" class="sidebar-tab" type="button" onclick="showTab(\'charts\')">Charts</button>\n')
        html.append('  </div>\n')

        html.append('  <div id="tests-sidebar-block">\n')
        html.append('    <div class="search-wrap">\n')
        html.append('      <input id="scenarioSearch" class="search-input" type="text" placeholder="Search test name, path, or status." onkeyup="filterScenarios()">\n')
        html.append('    </div>\n')
        html.append('    <div id="scenarioList" class="scenario-list">\n')

        view.scenarios.eachWithIndex { Map scenario, int index ->
            html.append(buildSidebarItem(scenario, index == 0))
        }

        html.append('    </div>\n')
        html.append('  </div>\n')

        html.append('  <div id="charts-sidebar-block" class="hidden">\n')
        html.append(buildChartsSidebar(view))
        html.append('  </div>\n')

        html.append('</aside>\n')

        html.append('<main class="content">\n')

        view.scenarios.eachWithIndex { Map scenario, int index ->
            html.append(buildScenarioPanel(scenario, view, index == 0))
        }

        html.append(buildChartsPanel(view))
        html.append('</main>\n')
        html.append('</div>\n')

        html.append(buildScripts())
        html.append('</body>\n')
        html.append('</html>\n')

        return html.toString()
    }

    private Map normalizeModel(Map model) {
        List<Map> scenarios = []

        List rawScenarios = model?.scenarios instanceof List ? (List) model.scenarios : []

        rawScenarios.eachWithIndex { Object raw, int index ->
            Map row = raw instanceof Map ? (Map) raw : [:]

            scenarios << [
                id           : pickFirst(row.id, 'scenario-' + (index + 1)),
                name         : pickFirst(row.name, 'Scenario ' + (index + 1)),
                status       : normalizeStatus(row.status),
                startLabel   : pickFirst(row.startLabel, '--'),
                endLabel     : pickFirst(row.endLabel, '--'),
                durationLabel: pickFirst(row.durationLabel, '00h 00m 00s'),
                steps        : normalizeSteps(row.steps),
                visualError  : pickFirst(row.visualError, ''),
                fullError    : pickFirst(row.fullError, ''),
                evidence     : normalizeEvidence(row.evidence)
            ]
        }

        int passed = scenarios.count { it.status == 'passed' }
        int failed = scenarios.count { it.status == 'failed' }
        int blocked = scenarios.count { it.status == 'blocked' }

        return [
            suiteName    : pickFirst(model?.suiteName, 'Execution'),
            executionName: pickFirst(model?.executionName, model?.title, 'Execution'),
            logoSrc      : pickFirst(model?.logoSrc, 'Images/General/logo.png'),
            scenarios    : scenarios,
            passedCount  : passed,
            failedCount  : failed,
            blockedCount : blocked,
            totalCount   : scenarios.size()
        ]
    }

    private List<String> normalizeSteps(def rawSteps) {
        List<String> result = []

        if (rawSteps == null) {
            return result
        }

        if (rawSteps instanceof Collection) {
            rawSteps.each { Object item ->
                String step
                if (item instanceof Map) {
                    step = safeValue(((Map) item).text ?: ((Map) item).detail)
                } else {
                    step = safeValue(item)
                }

                if (!step.isEmpty()) {
                    result << step
                }
            }
        } else {
            String step = safeValue(rawSteps)
            if (!step.isEmpty()) {
                result << step
            }
        }

        return result
    }

    private List<Map> normalizeEvidence(def rawEvidence) {
        List<Map> result = []

        if (rawEvidence == null) {
            return result
        }

        if (rawEvidence instanceof Collection) {
            rawEvidence.each { Object item ->
                if (item instanceof Map) {
                    Map row = (Map) item
                    result << [
                        name  : pickFirst(row.name, 'Evidence'),
                        href  : pickFirst(row.href, ''),
                        imgSrc: pickFirst(row.imgSrc, '')
                    ]
                }
            }
        }

        return result
    }

    private String buildSidebarItem(Map scenario, boolean selected) {
        StringBuilder sb = new StringBuilder()

        sb.append('<button type="button" class="sidebar-item')
        if (selected) {
            sb.append(' selected')
        }
        sb.append('" data-sid="')
        sb.append(htmlEscape(scenario.id))
        sb.append('" onclick="showScenario(\'')
        sb.append(jsEscape(scenario.id))
        sb.append('\')">\n')

        sb.append('<div class="sidebar-item-main">\n')
        sb.append('  <div class="sidebar-item-name">')
        sb.append(htmlEscape(scenario.name))
        sb.append('</div>\n')
        sb.append('</div>\n')

        sb.append('<div class="sidebar-item-side">\n')
        sb.append('  <span class="status-pill ')
        sb.append(htmlEscape(scenario.status))
        sb.append('">')
        sb.append(htmlEscape(statusLabel(scenario.status)))
        sb.append('</span>\n')
        sb.append('  <div class="sidebar-item-duration">')
        sb.append(htmlEscape(scenario.durationLabel))
        sb.append('</div>\n')
        sb.append('</div>\n')

        sb.append('</button>\n')
        return sb.toString()
    }

    private String buildScenarioPanel(Map scenario, Map view, boolean selected) {
        StringBuilder sb = new StringBuilder()

        sb.append('<section class="scenario-panel')
        if (selected) {
            sb.append(' active')
        }
        sb.append('" id="panel-')
        sb.append(htmlEscape(scenario.id))
        sb.append('">\n')

        sb.append('<div class="scenario-title">')
        sb.append(htmlEscape(scenario.name))
        sb.append('</div>\n')

        sb.append('<div class="meta-row">\n')
        sb.append(buildMetaChip('Suite', view.suiteName, 'plain'))
        sb.append(buildMetaChip('Status', statusLabel(scenario.status), scenario.status))
        sb.append(buildMetaChip('Start', scenario.startLabel, 'purple'))
        sb.append(buildMetaChip('End', scenario.endLabel, 'purple'))
        sb.append(buildMetaChip('Duration', scenario.durationLabel, 'purple'))
        sb.append('</div>\n')

        sb.append('<div class="steps-block">\n')
        sb.append('  <div class="section-title">Steps</div>\n')

        if (scenario.steps.isEmpty()) {
            sb.append('  <div class="empty-steps">No step details available.</div>\n')
        } else {
            sb.append('  <div class="steps-list">\n')
            scenario.steps.each { String step ->
                sb.append('    <div class="step-line">')
                sb.append(htmlEscape(step))
                sb.append('</div>\n')
            }
            sb.append('  </div>\n')
        }

        sb.append('</div>\n')

        if (scenario.status == 'failed') {
            sb.append('<div class="failed-card">\n')
            sb.append('  <div class="failed-card-title">Visual Error Log</div>\n')
            sb.append('  <div class="failed-card-summary">')
            sb.append(htmlEscape(scenario.visualError))
            sb.append('</div>\n')

            if (!safeValue(scenario.fullError).isEmpty()) {
                sb.append('  <details class="details-box">\n')
                sb.append('    <summary>🔎 View full error</summary>\n')
                sb.append('    <pre>')
                sb.append(htmlEscape(scenario.fullError))
                sb.append('</pre>\n')
                sb.append('  </details>\n')
            }

            sb.append('</div>\n')

            sb.append('<div class="failed-card">\n')
            sb.append('  <div class="failed-card-title">Evidence</div>\n')

            if (scenario.evidence.isEmpty()) {
                sb.append('  <div class="failed-card-empty">No evidence was found for this scenario.</div>\n')
            } else {
                scenario.evidence.each { Map ev ->
                    sb.append('  <div class="evidence-name">')
                    sb.append(htmlEscape(ev.name))
                    sb.append('</div>\n')

                    if (!safeValue(ev.href).isEmpty()) {
                        sb.append('  <div class="evidence-link"><a href="')
                        sb.append(htmlEscape(ev.href))
                        sb.append('" target="_blank" rel="noopener noreferrer">🔎 Open evidence</a></div>\n')
                    }

                    if (!safeValue(ev.imgSrc).isEmpty()) {
                        sb.append('  <img class="evidence-image" src="')
                        sb.append(htmlEscape(ev.imgSrc))
                        sb.append('" alt="Evidence">\n')
                    }
                }
            }

            sb.append('</div>\n')
        }

        sb.append('</section>\n')
        return sb.toString()
    }

    private String buildMetaChip(String label, String value, String type) {
        StringBuilder sb = new StringBuilder()
        sb.append('<div class="meta-chip ')
        sb.append(htmlEscape(type))
        sb.append('"><span class="meta-label">')
        sb.append(htmlEscape(label))
        sb.append(':</span> <span class="meta-value">')
        sb.append(htmlEscape(value))
        sb.append('</span></div>')
        return sb.toString()
    }

    private String buildChartsSidebar(Map view) {
        StringBuilder sb = new StringBuilder()
        sb.append('<div class="charts-side-box">\n')
        sb.append('  <div class="charts-side-title">Execution Status</div>\n')
        sb.append(buildLegendLine('Passed', STATUS_PASS, view.passedCount as int))
        sb.append(buildLegendLine('Failed', STATUS_FAIL, view.failedCount as int))
        sb.append(buildLegendLine('Blocked', STATUS_BLOCKED, view.blockedCount as int))
        sb.append('</div>\n')
        return sb.toString()
    }

    private String buildChartsPanel(Map view) {
        double passPct = percent(view.passedCount as int, view.totalCount as int)
        double failPct = percent(view.failedCount as int, view.totalCount as int)
        double blockPct = percent(view.blockedCount as int, view.totalCount as int)

        double afterFail = failPct
        double afterPass = failPct + passPct

        StringBuilder sb = new StringBuilder()

        sb.append('<section id="charts-panel" class="charts-panel hidden">\n')
        sb.append('  <div class="charts-main-title">Global Overview</div>\n')
        sb.append('  <div class="charts-layout">\n')

        sb.append('    <div class="donut-card">\n')
        sb.append('      <div class="donut" style="background: conic-gradient(')
        sb.append(STATUS_FAIL).append(' 0 ').append(formatPercent(afterFail)).append('%, ')
        sb.append(STATUS_PASS).append(' ').append(formatPercent(afterFail)).append('% ').append(formatPercent(afterPass)).append('%, ')
        sb.append(STATUS_BLOCKED).append(' ').append(formatPercent(afterPass)).append('% 100%);">\n')
        sb.append('        <div class="donut-center">\n')
        sb.append('          <div class="donut-number">').append(String.valueOf(view.totalCount)).append('</div>\n')
        sb.append('          <div class="donut-label">Tests</div>\n')
        sb.append('        </div>\n')
        sb.append('      </div>\n')
        sb.append('    </div>\n')

        sb.append('    <div class="bars-card">\n')
        sb.append(buildBarRow('Passed', view.passedCount as int, view.totalCount as int, STATUS_PASS))
        sb.append(buildBarRow('Failed', view.failedCount as int, view.totalCount as int, STATUS_FAIL))
        sb.append(buildBarRow('Blocked', view.blockedCount as int, view.totalCount as int, STATUS_BLOCKED))
        sb.append('    </div>\n')

        sb.append('  </div>\n')
        sb.append('</section>\n')

        return sb.toString()
    }

    private String buildLegendLine(String label, String color, int value) {
        return '<div class="legend-line"><span class="legend-dot" style="background:' + color + '"></span><span class="legend-text">' + htmlEscape(label) + '</span><span class="legend-value">' + value + '</span></div>\n'
    }

    private String buildBarRow(String label, int value, int total, String color) {
        double pct = percent(value, total)

        StringBuilder sb = new StringBuilder()
        sb.append('<div class="bar-row">\n')
        sb.append('  <div class="bar-row-top"><span class="bar-label">')
        sb.append(htmlEscape(label))
        sb.append('</span><span class="bar-value">')
        sb.append(value)
        sb.append('</span></div>\n')
        sb.append('  <div class="bar-track"><div class="bar-fill" style="width:')
        sb.append(formatPercent(pct))
        sb.append('%; background:')
        sb.append(color)
        sb.append('"></div></div>\n')
        sb.append('  <div class="bar-foot">')
        sb.append(Math.round(pct))
        sb.append('% of execution</div>\n')
        sb.append('</div>\n')
        return sb.toString()
    }

