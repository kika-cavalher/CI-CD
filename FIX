Map validateAmountColumnsWithTolerance(
		String filesText,
		String sheetIndexText,
		String headerCurrency,
		String headerAmountCcy,
		String headerAmountBaseCcy,
		String tolerancePercentText,
		String maxErrorsPerFileText) {

	List<File> files = parseFileList(filesText)
	Integer sheetIndex = parseIntOrDefault(sheetIndexText, 0)
	BigDecimal tolerancePercent = parseDecimalOrDefault(tolerancePercentText, new BigDecimal('3'))
	Integer maxErrorsPerFile = parseIntOrDefault(maxErrorsPerFileText, 999)

	List<Map> fileResults = []
	Boolean globalFailed = false

	for (int i = 0; i < files.size(); i++) {
		File file = files[i]

		Map fileResult = validateAmountColumnsForSingleFile(
				file,
				i + 1,
				sheetIndex,
				headerCurrency,
				headerAmountCcy,
				headerAmountBaseCcy,
				tolerancePercent,
				maxErrorsPerFile
		)

		fileResults.add(fileResult)

		if ('FAILED'.equals(fileResult.status)) {
			globalFailed = true
		}
	}

	return [
		failed          : globalFailed,
		tolerancePercent: tolerancePercent,
		files           : fileResults
	]
}

Map validateAmountColumnsForSingleFile(
		File file,
		Integer fileIndex,
		Integer sheetIndex,
		String headerCurrency,
		String headerAmountCcy,
		String headerAmountBaseCcy,
		BigDecimal tolerancePercent,
		Integer maxErrorsPerFile) {

	List<Map> wrongRows = []
	List<Map> acceptedRows = []
	List<String> fileErrors = []

	Workbook workbook = null

	try {
		if (file == null || !file.exists() || !file.isFile()) {
			return [
				index       : fileIndex,
				name        : file == null ? 'Unknown file' : file.getName(),
				status      : 'FAILED',
				wrongRows   : wrongRows,
				acceptedRows: acceptedRows,
				errors      : ['File was not found.']
			]
		}

		workbook = WorkbookFactory.create(file)

		if (sheetIndex < 0 || sheetIndex >= workbook.getNumberOfSheets()) {
			return [
				index       : fileIndex,
				name        : file.getName(),
				status      : 'FAILED',
				wrongRows   : wrongRows,
				acceptedRows: acceptedRows,
				errors      : ['Sheet index ' + sheetIndex + ' was not found. Available sheets: ' + workbook.getNumberOfSheets()]
			]
		}

		Sheet sheet = workbook.getSheetAt(sheetIndex)
		DataFormatter formatter = new DataFormatter(Locale.ENGLISH)
		def evaluator = workbook.getCreationHelper().createFormulaEvaluator()

		Map headerInfo = findHeaderColumns(
				sheet,
				formatter,
				evaluator,
				[
					headerCurrency,
					headerAmountCcy,
					headerAmountBaseCcy
				]
		)

		if (!Boolean.TRUE.equals(headerInfo.found)) {
			return [
				index       : fileIndex,
				name        : file.getName(),
				status      : 'FAILED',
				wrongRows   : wrongRows,
				acceptedRows: acceptedRows,
				errors      : ['Required amount columns were not found: ' + headerInfo.missingColumns.join(' | ')]
			]
		}

		Integer headerRowIndex = headerInfo.headerRowIndex as Integer
		Map<String, Integer> columns = headerInfo.columns as Map<String, Integer>

		Integer currencyCol = columns[normalizeHeader(headerCurrency)]
		Integer amountCcyCol = columns[normalizeHeader(headerAmountCcy)]
		Integer amountBaseCcyCol = columns[normalizeHeader(headerAmountBaseCcy)]

		for (int rowIndex = headerRowIndex + 1; rowIndex <= sheet.getLastRowNum(); rowIndex++) {
			Row row = sheet.getRow(rowIndex)

			if (row == null) {
				continue
			}

			String currencyValue = cellText(row.getCell(currencyCol, Row.MissingCellPolicy.RETURN_BLANK_AS_NULL), formatter, evaluator)
			String amountCcyText = cellText(row.getCell(amountCcyCol, Row.MissingCellPolicy.RETURN_BLANK_AS_NULL), formatter, evaluator)
			String amountBaseCcyText = cellText(row.getCell(amountBaseCcyCol, Row.MissingCellPolicy.RETURN_BLANK_AS_NULL), formatter, evaluator)

			if (currencyValue.isEmpty() && amountCcyText.isEmpty() && amountBaseCcyText.isEmpty()) {
				continue
			}

			BigDecimal amountCcy = parseDecimalOrNull(amountCcyText)
			BigDecimal amountBaseCcy = parseDecimalOrNull(amountBaseCcyText)

			BigDecimal difference = null
			BigDecimal differencePercent = null

			if (amountCcy == null || amountBaseCcy == null) {
				wrongRows.add([
					rowNumber        : rowIndex + 1,
					devise           : currencyValue,
					amountCcy        : amountCcyText,
					amountBaseCcy    : amountBaseCcyText,
					difference       : '-',
					differencePercent: '-',
					reason           : 'Cannot calculate difference because one amount is missing or not numeric.'
				])

				continue
			}

			difference = amountCcy.subtract(amountBaseCcy).abs()

			if (difference.compareTo(BigDecimal.ZERO) == 0) {
				continue
			}

			if (amountBaseCcy.compareTo(BigDecimal.ZERO) == 0) {
				differencePercent = new BigDecimal('100')
			} else {
				differencePercent = difference
						.divide(amountBaseCcy.abs(), 10, RoundingMode.HALF_UP)
						.multiply(new BigDecimal('100'))
			}

			Boolean accepted = differencePercent.compareTo(tolerancePercent) <= 0

			Map rowResult = [
				rowNumber        : rowIndex + 1,
				devise           : currencyValue,
				amountCcy        : amountCcyText,
				amountBaseCcy    : amountBaseCcyText,
				difference       : formatDecimal(difference),
				differencePercent: formatDecimal(differencePercent) + '%',
				reason           : accepted ? 'Accepted within tolerance.' : 'Difference is above the accepted tolerance.'
			]

			if (accepted) {
				acceptedRows.add(rowResult)
			} else {
				wrongRows.add(rowResult)
			}
		}
	} catch (Throwable throwable) {
		fileErrors.add(throwable.getClass().getSimpleName() + ': ' + safeText(throwable.getMessage()))
	} finally {
		try {
			workbook?.close()
		} catch (Throwable ignored) {
		}
	}

	String status = 'PASSED'

	if (!fileErrors.isEmpty() || !wrongRows.isEmpty()) {
		status = 'FAILED'
	} else if (!acceptedRows.isEmpty()) {
		status = 'PASSED WITH ACCEPTED DIFFERENCES'
	}

	return [
		index       : fileIndex,
		name        : file == null ? 'Unknown file' : file.getName(),
		status      : status,
		wrongRows   : wrongRows,
		acceptedRows: acceptedRows,
		errors      : fileErrors
	]
}

Map findHeaderColumns(
		Sheet sheet,
		DataFormatter formatter,
		def evaluator,
		List<String> requiredHeaders) {

	Integer maxHeaderScanRows = Math.min(sheet.getLastRowNum(), 50)

	for (int rowIndex = 0; rowIndex <= maxHeaderScanRows; rowIndex++) {
		Row row = sheet.getRow(rowIndex)

		if (row == null) {
			continue
		}

		Map<String, Integer> columns = [:]

		for (int cellIndex = row.getFirstCellNum(); cellIndex < row.getLastCellNum(); cellIndex++) {
			if (cellIndex < 0) {
				continue
			}

			String value = cellText(row.getCell(cellIndex, Row.MissingCellPolicy.RETURN_BLANK_AS_NULL), formatter, evaluator)
			String key = normalizeHeader(value)

			if (!key.isEmpty()) {
				columns[key] = cellIndex
			}
		}

		List<String> missingColumns = []

		for (String requiredHeader : requiredHeaders) {
			String requiredKey = normalizeHeader(requiredHeader)

			if (!columns.containsKey(requiredKey)) {
				missingColumns.add(requiredHeader)
			}
		}

		if (missingColumns.isEmpty()) {
			return [
				found         : true,
				headerRowIndex: rowIndex,
				columns       : columns,
				missingColumns: []
			]
		}
	}

	return [
		found         : false,
		headerRowIndex: -1,
		columns       : [:],
		missingColumns: requiredHeaders
	]
}

String buildAmountComparisonReport(Map amountComparisonResult) {
	List<String> lines = []

	BigDecimal tolerancePercent = amountComparisonResult.tolerancePercent as BigDecimal
	List<Map> fileResults = amountComparisonResult.files as List<Map>

	lines.add('Accepted difference: <= ' + formatDecimal(tolerancePercent) + '%')
	lines.add('Checked files: ' + fileResults.size())
	lines.add('')

	for (Map fileResult : fileResults) {
		lines.add('File ' + fileResult.index + ': ' + fileResult.status + ' - ' + fileResult.name)
	}

	List<Map> failedFiles = fileResults.findAll { Map fileResult ->
		'FAILED'.equals(fileResult.status)
	}

	List<Map> acceptedDifferenceFiles = fileResults.findAll { Map fileResult ->
		'PASSED WITH ACCEPTED DIFFERENCES'.equals(fileResult.status)
	}

	if (failedFiles.isEmpty() && acceptedDifferenceFiles.isEmpty()) {
		lines.add('')
		lines.add('Result: all amount values are equal.')
		return lines.join('\n')
	}

	if (!failedFiles.isEmpty()) {
		lines.add('')
		lines.add('Wrong values grouped by file:')

		for (Map fileResult : failedFiles) {
			lines.add('')
			lines.add(fileResult.name)

			List<String> fileErrors = fileResult.errors as List<String>
			List<Map> wrongRows = fileResult.wrongRows as List<Map>

			if (!fileErrors.isEmpty()) {
				lines.add('File errors:')

				for (String error : fileErrors) {
					lines.add('- ' + error)
				}
			}

			if (!wrongRows.isEmpty()) {
				lines.add('Row | Devise | Montant ccy | Montant base ccy | Difference | Difference % | Reason')
				lines.add('--- | --- | --- | --- | --- | --- | ---')

				for (Map row : wrongRows) {
					lines.add(
							tableValue(row.rowNumber) + ' | ' +
							tableValue(row.devise) + ' | ' +
							tableValue(row.amountCcy) + ' | ' +
							tableValue(row.amountBaseCcy) + ' | ' +
							tableValue(row.difference) + ' | ' +
							tableValue(row.differencePercent) + ' | ' +
							tableValue(row.reason)
					)
				}
			}
		}
	}

	if (!acceptedDifferenceFiles.isEmpty()) {
		lines.add('')
		lines.add('Accepted differences grouped by file:')

		for (Map fileResult : acceptedDifferenceFiles) {
			lines.add('')
			lines.add(fileResult.name)
			lines.add('Row | Devise | Montant ccy | Montant base ccy | Difference | Difference % | Reason')
			lines.add('--- | --- | --- | --- | --- | --- | ---')

			List<Map> acceptedRows = fileResult.acceptedRows as List<Map>

			for (Map row : acceptedRows) {
				lines.add(
						tableValue(row.rowNumber) + ' | ' +
						tableValue(row.devise) + ' | ' +
						tableValue(row.amountCcy) + ' | ' +
						tableValue(row.amountBaseCcy) + ' | ' +
						tableValue(row.difference) + ' | ' +
						tableValue(row.differencePercent) + ' | ' +
						tableValue(row.reason)
				)
			}
		}
	}

	return lines.join('\n')
}

String cellText(Cell cell, DataFormatter formatter, def evaluator) {
	if (cell == null) {
		return ''
	}

	try {
		return formatter.formatCellValue(cell, evaluator).trim()
	} catch (Throwable ignored) {
		try {
			return formatter.formatCellValue(cell).trim()
		} catch (Throwable ignoredAgain) {
			return ''
		}
	}
}

String normalizeHeader(String value) {
	return safeText(value)
			.toLowerCase(Locale.ENGLISH)
			.replaceAll('[^a-z0-9]+', '')
}

String combineValidationResults(Object... values) {
	List<String> results = []

	if (values == null) {
		return ''
	}

	for (Object value : values) {
		String text = value == null ? '' : String.valueOf(value).trim()

		if (!text.isEmpty()) {
			results.add(text)
		}
	}

	return results.join('\n')
}

Boolean hasValidationFailure(String validationResult) {
	String result = validationResult == null ? '' : validationResult.trim()

	if (result.isEmpty()) {
		return false
	}

	if (isSkippedResult(result)) {
		return false
	}

	String upper = result.toUpperCase(Locale.ENGLISH)

	if (upper == 'PASS' || upper == 'PASSED' || upper == 'SUCCESS') {
		return false
	}

	if (upper.startsWith('[PASS]') || upper.startsWith('[PASSED]') || upper.startsWith('[SUCCESS]')) {
		return false
	}

	if (upper.contains('RESULT: PASSED')) {
		return false
	}

	return true
}

Boolean isSkippedResult(String validationResult) {
	String result = validationResult == null ? '' : validationResult.trim()

	result = result.replaceFirst('^\\s*[^A-Za-z0-9\\[]+\\s*', '')

	return result.startsWith('[SKIPPED]')
}

List<File> parseFileList(String filesText) {
	List<File> files = []

	String text = filesText == null ? '' : filesText.trim()

	if (text.isEmpty()) {
		return files
	}

	String normalized = text
			.replace('\r\n', '|')
			.replace('\n', '|')
			.replace(';', '|')

	String[] parts = normalized.split('\\|')

	for (String part : parts) {
		String clean = part == null ? '' : part.trim()

		if (!clean.isEmpty()) {
			files.add(new File(clean))
		}
	}

	return files.unique { File file ->
		file.getAbsolutePath().toLowerCase(Locale.ENGLISH)
	}
}

List<String> extractErrorLines(String validationResult) {
	List<String> lines = []

	String result = validationResult == null ? '' : validationResult.trim()

	if (result.isEmpty()) {
		return lines
	}

	String normalized = result
			.replace('\r\n', '\n')
			.replace('\r', '\n')

	String[] parts = normalized.split('\n')

	for (String part : parts) {
		String clean = part == null ? '' : part.trim()

		if (!clean.isEmpty()) {
			lines.add(clean)
		}
	}

	if (lines.isEmpty()) {
		lines.add(result)
	}

	return lines
}

List<String> limitLines(List<String> lines, Integer limit) {
	List<String> result = []

	if (lines == null || lines.isEmpty()) {
		return result
	}

	Integer safeLimit = limit == null || limit <= 0 ? 999 : limit

	for (int i = 0; i < lines.size() && i < safeLimit; i++) {
		result.add(lines[i])
	}

	return result
}

String cleanErrorLineForReport(String errorLine, List<File> files) {
	String line = errorLine == null ? '' : errorLine.trim()

	line = line.replace('[ERROR]', '').trim()
	line = line.replace('[FAIL]', '').trim()
	line = line.replace('[FAILED]', '').trim()
	line = line.replace('[PASS]', '').trim()
	line = line.replace('[PASSED]', '').trim()
	line = line.replace('[SKIPPED]', '').trim()

	line = line.replaceFirst('^\\s*[^A-Za-z0-9\\[]+\\s*', '').trim()

	line = line.replaceAll('^com\\.kms\\.katalon\\.core\\.exception\\.StepFailedException:\\s*', '').trim()
	line = line.replaceAll('^Reason:\\s*com\\.kms\\.katalon\\.core\\.exception\\.StepFailedException:\\s*', 'Reason: ').trim()

	for (File file : files ?: []) {
		line = line.replace(file.getAbsolutePath(), file.getName())
		line = line.replace(file.getPath(), file.getName())
	}

	line = stripPathsKeepingFileNames(line)

	return line.trim()
}

String stripPathsKeepingFileNames(String value) {
	String line = value == null ? '' : value

	line = line.replace('\\', '/')
	line = line.replaceAll('[A-Za-z]:/[^\\s|"]*/([^/\\s|"]+\\.xlsx)', '$1')
	line = line.replaceAll('[A-Za-z]:/[^\\s|"]*/([^/\\s|"]+\\.xls)', '$1')

	return line
}

BigDecimal parseDecimalOrNull(String value) {
	String text = value == null ? '' : value.trim()

	if (text.isEmpty() || text == '-') {
		return null
	}

	String clean = text.replace(' ', '').replace("'", '')

	if (clean.startsWith('(') && clean.endsWith(')')) {
		clean = '-' + clean.substring(1, clean.length() - 1)
	}

	if (clean.contains(',') && clean.contains('.')) {
		Integer lastComma = clean.lastIndexOf(',')
		Integer lastDot = clean.lastIndexOf('.')

		if (lastComma > lastDot) {
			clean = clean.replace('.', '').replace(',', '.')
		} else {
			clean = clean.replace(',', '')
		}
	} else if (clean.contains(',') && !clean.contains('.')) {
		clean = clean.replace(',', '.')
	}

	try {
		return new BigDecimal(clean)
	} catch (Throwable ignored) {
		return null
	}
}

BigDecimal parseDecimalOrDefault(String value, BigDecimal defaultValue) {
	BigDecimal parsed = parseDecimalOrNull(value)
	return parsed == null ? defaultValue : parsed
}

String formatDecimal(BigDecimal value) {
	if (value == null) {
		return '-'
	}

	BigDecimal normalized = value.setScale(4, RoundingMode.HALF_UP).stripTrailingZeros()
	return normalized.toPlainString()
}

String safeText(Object value) {
	String text = value == null ? '' : String.valueOf(value).trim()
	return text.isEmpty() ? '' : text
}

String tableValue(Object value) {
	String text = safeText(value)

	if (text.isEmpty()) {
		return '-'
	}

	return text.replace('|', '/')
}

Integer parseIntOrDefault(String value, Integer defaultValue) {
	try {
		return Integer.parseInt(value == null ? '' : value.trim())
	} catch (Exception ignored) {
		return defaultValue
	}
}
