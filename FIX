import com.kms.katalon.core.util.KeywordUtil

import internal.GlobalVariable


// ======================================================
// VALIDATION CONFIG
// ======================================================

Integer expectedColumnIndex = 15
String expectedColumnName = 'Notionnel'
String validationName = 'Emission Filtrée'

String exportRootFolder = 'C:\\KatalonExports'
String exportGroupFolder = 'JV_Emissions'
String exportFeatureFolder = 'Emission_Validation_Brute'


// ======================================================
// TEST FLOW
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Start REC x PRD validation\n' +
	'Feature: ' + validationName + '\n' +
	'Expected column index: ' + expectedColumnIndex + '\n' +
	'Expected column: ' + expectedColumnName + '\n' +
	'Export root: ' + exportRootFolder + '\n' +
	'Export folder: ' +
	exportGroupFolder + '\\' + exportFeatureFolder
)

Map result =
	CustomKeywords.'commands.RecPrdExportValidationKeywords.validateLatestRecPrdExportTreatBlankAsZero'(
		exportRootFolder,
		exportGroupFolder,
		exportFeatureFolder,
		expectedColumnIndex,
		expectedColumnName
	)

boolean success =
	result != null &&
	result.success == true

boolean filesResolved =
	result != null &&
	result.filesResolved == true

boolean excelAnalysisCompleted =
	result != null &&
	result.excelAnalysisCompleted == true

String errors =
	result == null
		? '[ERROR] Validation keyword returned no result.'
		: safeText(result.errors)

String passedDetails =
	result == null
		? ''
		: safeText(result.passedDetails)

String resolvedColumnName =
	result == null
		? expectedColumnName
		: safeText(result.columnName)

if (resolvedColumnName.isEmpty()) {
	resolvedColumnName = expectedColumnName
}


// ======================================================
// REPORT SELECTED FILES
// ======================================================

StringBuilder selectedFilesReport = new StringBuilder()

selectedFilesReport
	.append(filesResolved ? '[PASS] ' : '[FAIL] ')
	.append('Files selected for validation')

if (filesResolved) {
	appendReportValue(
			selectedFilesReport,
			'Folder',
			result.selectedFolderPath
			)

	appendReportValue(
			selectedFilesReport,
			'REC file',
			result.recFileName
			)

	appendReportValue(
			selectedFilesReport,
			'PRD file',
			result.prdFileName
			)
} else {
	selectedFilesReport
		.append('\nNo matching REC and PRD export files were found.')
		.append('\nExpected feature: ')
		.append(exportGroupFolder)
		.append('\\')
		.append(exportFeatureFolder)
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	selectedFilesReport.toString()
)


// ======================================================
// REPORT EXCEL RESULT
// ======================================================

if (excelAnalysisCompleted) {

	StringBuilder excelReport = new StringBuilder()

	excelReport
		.append(success ? '[PASS] ' : '[FAIL] ')
		.append('Excel validation result')
		.append('\nFeature: ')
		.append(validationName)
		.append('\nColumn: ')
		.append(resolvedColumnName)
		.append('\nColumn index: ')
		.append(expectedColumnIndex)

	appendReportValue(
			excelReport,
			'REC rows',
			result.recRows
			)

	appendReportValue(
			excelReport,
			'PRD rows',
			result.prdRows
			)

	appendReportValue(
			excelReport,
			'REC numeric values',
			result.recNumericValues
			)

	appendReportValue(
			excelReport,
			'PRD numeric values',
			result.prdNumericValues
			)

	appendReportValue(
			excelReport,
			'REC sum',
			result.recSum
			)

	appendReportValue(
			excelReport,
			'PRD sum',
			result.prdSum
			)

	appendReportValue(
			excelReport,
			'REC minimum',
			result.recMinimum
			)

	appendReportValue(
			excelReport,
			'PRD minimum',
			result.prdMinimum
			)

	appendReportValue(
			excelReport,
			'REC maximum',
			result.recMaximum
			)

	appendReportValue(
			excelReport,
			'PRD maximum',
			result.prdMaximum
			)

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		excelReport.toString()
	)
}


// ======================================================
// FINAL RESULT
// ======================================================

if (!success) {

	String finalErrorMessage =
		errors.isEmpty()
			? 'REC x PRD validation returned an unsuccessful result.'
			: errors

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[FAIL] Final validation result\n' +
		finalErrorMessage +
		(
			passedDetails.isEmpty()
				? ''
				: '\n\nSuccessful validations\n' +
					passedDetails
		)
	)

	KeywordUtil.markFailed(
		'REC x PRD validation failed for ' +
		validationName +
		'.\n' +
		finalErrorMessage
	)

} else {

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[PASS] Final validation result\n' +
		'REC x PRD validation completed successfully.\n' +
		passedDetails
	)

	KeywordUtil.markPassed(
		'REC x PRD validation completed successfully for ' +
		validationName +
		'.'
	)
}


// ======================================================
// HELPERS
// ======================================================

void appendReportValue(
		StringBuilder report,
		String label,
		Object value) {

	String text = safeText(value)

	if (text.isEmpty()) {
		return
	}

	report
		.append('\n')
		.append(label)
		.append(': ')
		.append(text)
}


String safeText(Object value) {

	if (value == null) {
		return ''
	}

	return value.toString().trim()
}
