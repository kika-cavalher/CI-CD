private String buildChartsPanel(Map view) {
    double failPercent = percent(view.failedCount as int, view.totalCount as int)
    double passPercent = percent(view.passedCount as int, view.totalCount as int)
    double skipPercent = percent(view.skippedCount as int, view.totalCount as int)

    String donutStyle = 'background: conic-gradient(' +
        STATUS_FAIL + ' 0 ' + String.format(Locale.ENGLISH, '%.2f', failPercent) + '%,' +
        STATUS_PASS + ' ' + String.format(Locale.ENGLISH, '%.2f', failPercent) + '% ' +
        String.format(Locale.ENGLISH, '%.2f', failPercent + passPercent) + '%,' +
        STATUS_SKIP + ' ' + String.format(Locale.ENGLISH, '%.2f', failPercent + passPercent) + '% 100%);'

    StringBuilder sb = new StringBuilder()

    sb.append('<section id="charts-panel" class="charts-panel hidden">')
    sb.append('<div class="chart-main-title">Global Overview</div>')

    sb.append('<div style="display:grid; grid-template-columns:360px 1fr; gap:40px; align-items:start; max-width:1200px;">')

    sb.append('<div>')
    sb.append('<div class="donut-card" style="justify-content:flex-start; padding-top:0;">')
    sb.append('<div class="donut" style="width:288px; height:288px; ')
    sb.append(donutStyle)
    sb.append('">')
    sb.append('<div class="donut-center">')
    sb.append('<div class="donut-number">')
    sb.append(String.valueOf(view.totalCount))
    sb.append('</div>')
    sb.append('<div class="donut-label">Tests</div>')
    sb.append('</div>')
    sb.append('</div>')
    sb.append('</div>')

    sb.append('<div class="legend-list" style="margin-top:10px;">')
    sb.append(buildLegendLine('Passed', STATUS_PASS, view.passedCount))
    sb.append(buildLegendLine('Failed', STATUS_FAIL, view.failedCount))
    sb.append(buildLegendLine('Skipped', STATUS_SKIP, view.skippedCount))
    sb.append('</div>')
    sb.append('</div>')

    sb.append('<div>')
    sb.append('<div class="chart-bars" style="max-width:none;">')
    sb.append(buildBarRow('Passed', view.passedCount as int, view.totalCount as int, STATUS_PASS))
    sb.append(buildBarRow('Failed', view.failedCount as int, view.totalCount as int, STATUS_FAIL))
    sb.append(buildBarRow('Skipped', view.skippedCount as int, view.totalCount as int, STATUS_SKIP))
    sb.append('</div>')
    sb.append('</div>')

    sb.append('</div>')
    sb.append('</section>')

    return sb.toString()
}





private String buildScenarioPanel(Map scenario, Map view, boolean selected) {
    String panelClass = selected ? 'scenario-panel active' : 'scenario-panel'

    String suiteLabel = safeValue(view.suiteName)
    String scenarioName = safeValue(scenario.name)
    String scenarioStatus = safeValue(scenario.status)

    String visualError = safeValue(scenario.visualError)
    if (visualError.isEmpty()) {
        visualError = safeValue(scenario.summary)
    }
    if (visualError.isEmpty()) {
        visualError = safeValue(scenario.message)
    }

    String fullError = safeValue(scenario.fullError)
    if (fullError.isEmpty()) {
        fullError = safeValue(scenario.errorDetail)
    }
    if (fullError.isEmpty()) {
        fullError = safeValue(scenario.stackTrace)
    }
    if (fullError.isEmpty()) {
        fullError = safeValue(scenario.details)
    }
    if (fullError.isEmpty()) {
        fullError = visualError
    }

    String startLabel = safeValue(scenario.startLong)
    if (startLabel.isEmpty()) {
        startLabel = safeValue(scenario.startClock)
    }
    if (startLabel.isEmpty()) {
        startLabel = '--'
    }

    String endLabel = safeValue(scenario.endLong)
    if (endLabel.isEmpty()) {
        endLabel = safeValue(scenario.endClock)
    }
    if (endLabel.isEmpty()) {
        endLabel = '--'
    }

    String durationLabel = safeValue(scenario.durationLabel)
    if (durationLabel.isEmpty()) {
        durationLabel = '00h 00m 00s'
    }

    Map failedEvidence = null
    if (scenario.evidence instanceof List && !scenario.evidence.isEmpty()) {
        failedEvidence = scenario.evidence.find { Map ev ->
            String n = safeValue(ev.name).toLowerCase(Locale.ENGLISH)
            return n.contains('error') || n.contains('fail')
        } as Map

        if (failedEvidence == null) {
            failedEvidence = scenario.evidence[0] as Map
        }
    }

    String evidenceName = failedEvidence != null ? safeValue(failedEvidence.name) : ''
    String evidenceHref = failedEvidence != null ? safeValue(failedEvidence.href) : ''
    String evidenceImgSrc = failedEvidence != null ? safeValue(failedEvidence.imgSrc) : ''
    boolean evidenceIsImage = failedEvidence != null && Boolean.TRUE.equals(failedEvidence.image)

    StringBuilder sb = new StringBuilder()

    sb.append('<section class="')
    sb.append(panelClass)
    sb.append('" id="panel-')
    sb.append(htmlEscape(safeValue(scenario.id)))
    sb.append('">')

    sb.append('<div class="scenario-header">')
    sb.append('<div class="scenario-title">')
    sb.append(htmlEscape(scenarioName))
    sb.append('</div>')

    sb.append('<div class="scenario-meta-row">')
    sb.append(buildMetaChip('Suite', suiteLabel, 'plain'))
    sb.append(buildMetaChip('Status', statusLabel(scenarioStatus), scenarioStatus))
    sb.append(buildMetaChip('Start', startLabel, 'gradient'))
    sb.append(buildMetaChip('End', endLabel, 'gradient'))
    sb.append(buildMetaChip('Duration', durationLabel, 'gradient'))
    sb.append('</div>')
    sb.append('</div>')

    sb.append('<div class="section-title">Steps</div>')
    sb.append('<div class="steps-table">')
    sb.append('<div class="steps-head">')
    sb.append('<div class="col-status">STATUS</div>')
    sb.append('<div class="col-time">TIMESTAMP</div>')
    sb.append('<div class="col-detail">DETAILS</div>')
    sb.append('</div>')

    if (scenario.steps == null || scenario.steps.isEmpty()) {
        sb.append('<div class="step-row empty">')
        sb.append('<div class="col-status"></div>')
        sb.append('<div class="col-time"></div>')
        sb.append('<div class="col-detail">No step details available.</div>')
        sb.append('</div>')
    } else {
        scenario.steps.each { Map step ->
            sb.append(buildStepRow(step))
        }
    }

    sb.append('</div>')

    if ('failed'.equalsIgnoreCase(scenarioStatus) && !visualError.isEmpty()) {
        sb.append('<div class="error-block">')
        sb.append('<div class="error-title">Visual Error Log</div>')
        sb.append('<div class="error-summary">')
        sb.append(htmlEscape(visualError))
        sb.append('</div>')

        if (!fullError.isEmpty()) {
            sb.append('<details class="details-box">')
            sb.append('<summary>🔎 View full error</summary>')
            sb.append('<pre>')
            sb.append(htmlEscape(fullError))
            sb.append('</pre>')
            sb.append('</details>')
        }

        sb.append('</div>')
    }

    if (failedEvidence != null) {
        sb.append('<div class="evidence-block">')
        sb.append('<div class="evidence-title">Evidence</div>')
        sb.append('<details class="evidence-item">')
        sb.append('<summary>🖼 ')
        sb.append(htmlEscape(evidenceName.isEmpty() ? 'Open failed evidence' : evidenceName))
        sb.append('</summary>')

        if (!evidenceHref.isEmpty()) {
            sb.append('<div class="evidence-links">')
            sb.append('<a href="')
            sb.append(htmlEscape(evidenceHref))
            sb.append('" target="_blank" rel="noopener noreferrer">🔎 Open evidence</a>')
            sb.append('</div>')
        }

        if (evidenceIsImage && !evidenceImgSrc.isEmpty()) {
            sb.append('<img class="evidence-image" src="')
            sb.append(htmlEscape(evidenceImgSrc))
            sb.append('" alt="Evidence">')
        }

        sb.append('</details>')
        sb.append('</div>')
    }

    sb.append('</section>')
    return sb.toString()
}
