class JiraReportBuilder {

	private static final String DEFAULT_REPORT_FILE_NAME = 'customReport.html'

	JiraFlowCoordinator flow

	JiraReportBuilder(JiraFlowCoordinator flow) {
		this.flow = flow
	}

	String createHtmlReport(String reportFolder, String suiteName, String xmlPath) {
		if (isBlank(reportFolder)) {
			return ''
		}

		File reportDir = new File(reportFolder)
		if (!reportDir.exists() || !reportDir.isDirectory()) {
			return ''
		}

		String resolvedSuiteName = resolveSuiteName(reportDir, suiteName)

		List<Map> xmlCases = []
		if (!isBlank(xmlPath)) {
			xmlCases = parseXmlCases(xmlPath)
		}

		List<Map> scenarios = parseExecutionLogScenarios(reportDir)
		if (scenarios.isEmpty()) {
			scenarios = buildFallbackScenarios(xmlCases)
		} else {
			enrichScenariosWithXmlData(scenarios, xmlCases)
		}

		if (scenarios.isEmpty()) {
			return ''
		}

		attachEvidenceFromNativeHtml(reportDir, scenarios)
		attachEvidenceFromFiles(reportDir, scenarios)
		normalizeScenarioTimings(reportDir, scenarios)

		Map model = [
			appName         : flow.getAppDisplayName(),
			suiteName       : resolvedSuiteName,
			subtitle        : flow.getReportSubtitle(),
			generatedAt     : formatDisplayDate(new Date()),
			logoSrc         : resolveAssetUrl(reportDir, flow.getReportLogoRelativePath()),
			reportFolder    : reportDir.absolutePath,
			headerBackground: flow.getReportHeaderBackground(),
			accentColor     : flow.getReportAccentColor(),
			accentSoftColor : flow.getReportAccentSoftColor(),
			infoColor       : flow.getReportInfoColor(),
			scenarios       : scenarios
		]

		String html = new JiraHtmlTemplateBuilder().build(model)

		File htmlFile = new File(reportDir, resolveReportFileName())
		htmlFile.setText(html, 'UTF-8')
		return htmlFile.absolutePath
	}

	// ============================================================
	// BASIC
	// ============================================================

	private String resolveReportFileName() {
		String value = safeValue(flow?.getCustomReportFileName())
		return isBlank(value) ? DEFAULT_REPORT_FILE_NAME : value
	}

	private String safeValue(def value) {
		return value == null ? '' : String.valueOf(value).trim()
	}

	private boolean isBlank(def value) {
		return safeValue(value).isEmpty()
	}

	private long toLong(def value) {
		try {
			return Long.parseLong(safeValue(value))
		} catch (Exception ignored) {
			return 0L
		}
	}

	private String resolveSuiteName(File reportDir, String providedSuiteName) {
		if (!isBlank(providedSuiteName)) {
			return safeValue(providedSuiteName)
		}

		File parent = reportDir.parentFile
		if (parent != null && !isBlank(parent.name)) {
			return safeValue(parent.name)
		}

		return 'Execution'
	}

	// ============================================================
	// XML
	// ============================================================

	private List<Map> parseXmlCases(String xmlPath) {
		List<Map> result = []

		File xmlFile = new File(xmlPath)
		if (!xmlFile.exists()) {
			return result
		}

		Document document = parseXmlDocument(xmlFile)
		if (document == null) {
			return result
		}

		def testcases = document.getElementsByTagName('testcase')
		for (int index = 0; index < testcases.length; index++) {
			Element testcase = (Element) testcases.item(index)

			String className = safeValue(testcase.getAttribute('classname'))
			String testName = safeValue(testcase.getAttribute('name'))
			long durationMs = toMillisFromSeconds(testcase.getAttribute('time'))

			Element failureNode = firstChildElement(testcase, 'failure')
			Element errorNode = firstChildElement(testcase, 'error')
			Element skippedNode = firstChildElement(testcase, 'skipped')

			boolean failed = failureNode != null || errorNode != null
			boolean skipped = skippedNode != null

			String message = ''
			String details = ''

			if (failureNode != null) {
				message = safeValue(failureNode.getAttribute('message'))
				details = stripHtmlTags(safeValue(failureNode.getTextContent()))
			} else if (errorNode != null) {
				message = safeValue(errorNode.getAttribute('message'))
				details = stripHtmlTags(safeValue(errorNode.getTextContent()))
			} else if (skippedNode != null) {
				message = safeValue(skippedNode.getAttribute('message'))
				details = stripHtmlTags(safeValue(skippedNode.getTextContent()))
			}

			String fullName = buildDisplayName(className, testName)

			result << [
				index      : index + 1,
				title      : fullName,
				shortTitle : isBlank(testName) ? fullName : testName,
				durationMs : durationMs,
				status     : skipped ? 'skipped' : (failed ? 'failed' : 'passed'),
				errorShort : extractShortError(message ?: details),
				errorFull  : details,
				steps      : []
			]
		}

		return result
	}

	private Document parseXmlDocument(File xmlFile) {
		try {
			def factory = DocumentBuilderFactory.newInstance()
			factory.setNamespaceAware(false)
			factory.setFeature('http://apache.org/xml/features/disallow-doctype-decl', true)
			factory.setFeature('http://xml.org/sax/features/external-general-entities', false)
			factory.setFeature('http://xml.org/sax/features/external-parameter-entities', false)
			factory.setFeature('http://apache.org/xml/features/nonvalidating/load-external-dtd', false)
			factory.setExpandEntityReferences(false)

			def builder = factory.newDocumentBuilder()
			return builder.parse(xmlFile)
		} catch (Exception ignored) {
			return null
		}
	}

	private Element firstChildElement(Element parent, String tagName) {
		def nodes = parent.getElementsByTagName(tagName)
		if (nodes == null || nodes.length == 0) {
			return null
		}
		return (Element) nodes.item(0)
	}

	private String buildDisplayName(String className, String testName) {
		if (!isBlank(className) && !isBlank(testName)) {
			return className + '/' + testName
		}
		if (!isBlank(testName)) {
			return testName
		}
		return className
	}

	private List<Map> buildFallbackScenarios(List<Map> xmlCases) {
		List<Map> scenarios = []

		xmlCases.eachWithIndex { Map xmlCase, int index ->
			scenarios << [
				id          : 'scenario-' + (index + 1),
				title       : safeValue(xmlCase.title),
				status      : safeValue(xmlCase.status),
				startLabel  : '',
				endLabel    : '',
				durationMs  : toLong(xmlCase.durationMs),
				durationLabel: formatDurationFull(toLong(xmlCase.durationMs)),
				errorShort  : safeValue(xmlCase.errorShort),
				errorFull   : safeValue(xmlCase.errorFull),
				steps       : xmlCase.steps instanceof List ? xmlCase.steps : [],
				evidence    : []
			]
		}

		return scenarios
	}

	private void enrichScenariosWithXmlData(List<Map> scenarios, List<Map> xmlCases) {
		if (xmlCases == null || xmlCases.isEmpty()) {
			return
		}

		Map<String, Map> xmlByTitle = [:]
		xmlCases.each { Map item ->
			xmlByTitle[normalizeKey(item.title)] = item
			xmlByTitle[normalizeKey(item.shortTitle)] = item
		}

		scenarios.each { Map scenario ->
			Map xmlCase = xmlByTitle[normalizeKey(scenario.title)]
			if (xmlCase == null) {
				String leaf = leafTitle(scenario.title)
				xmlCase = xmlByTitle[normalizeKey(leaf)]
			}

			if (xmlCase == null) {
				return
			}

			if (toLong(scenario.durationMs) <= 0L) {
				scenario.durationMs = toLong(xmlCase.durationMs)
			}

			if (isBlank(scenario.errorShort)) {
				scenario.errorShort = safeValue(xmlCase.errorShort)
			}

			if (isBlank(scenario.errorFull)) {
				scenario.errorFull = safeValue(xmlCase.errorFull)
			}

			if (safeValue(scenario.status) == 'info' || isBlank(scenario.status)) {
				scenario.status = safeValue(xmlCase.status)
			}

			scenario.durationLabel = formatDurationFull(toLong(scenario.durationMs))
		}
	}

	// ============================================================
	// EXECUTION LOG
	// ============================================================

	private List<Map> parseExecutionLogScenarios(File reportDir) {
		File logFile = findExecutionLog(reportDir)
		if (logFile == null || !logFile.exists()) {
			return []
		}

		List<String> lines = readFileLines(logFile)
		if (lines.isEmpty()) {
			return []
		}

		List<Map> scenarios = []
		Map currentScenario = null

		for (String rawLine : lines) {
			String line = sanitizeLogLine(rawLine)
			if (isBlank(line)) {
				continue
			}

			String startedScenario = extractScenarioStart(line)
			if (!isBlank(startedScenario)) {
				if (currentScenario != null) {
					finalizeScenario(currentScenario, scenarios)
				}

				currentScenario = newScenarioMap('scenario-' + (scenarios.size() + 1), startedScenario)
				continue
			}

			if (currentScenario == null) {
				continue
			}

			String endedScenario = extractScenarioEnd(line)
			if (!isBlank(endedScenario)) {
				finalizeScenario(currentScenario, scenarios)
				currentScenario = null
				continue
			}

			Map compactStep = parseCompactStepLine(line, ((currentScenario.steps ?: []).size()) + 1)
			if (compactStep != null) {
				(currentScenario.steps as List<Map>) << compactStep
				continue
			}

			String verboseStep = extractVerboseStep(line)
			if (!isBlank(verboseStep)) {
				if (!shouldIgnoreStep(verboseStep)) {
					(currentScenario.steps as List<Map>) << [
						id         : currentScenario.id + '-step-' + (((currentScenario.steps ?: []).size()) + 1),
						title      : cleanupStepTitle(verboseStep),
						status     : inferStatusFromText(verboseStep),
						timeLabel  : '',
						durationMs : 0L,
						detailText : cleanupStepTitle(verboseStep)
					]
				}
				continue
			}

			if (line.startsWith('Elapsed time:')) {
				long elapsed = parseElapsedMillis(line)
				if (elapsed > 0L) {
					currentScenario.durationMs = elapsed
					currentScenario.durationLabel = formatDurationFull(elapsed)
				}
			}

			if (line.startsWith('Reason:')) {
				String error = line.substring('Reason:'.length()).trim()
				currentScenario.errorShort = extractShortError(error)
				currentScenario.errorFull = appendText(currentScenario.errorFull, error)
				currentScenario.status = 'failed'
				continue
			}

			if (looksLikeErrorLine(line)) {
				currentScenario.errorFull = appendText(currentScenario.errorFull, line)
				if (isBlank(currentScenario.errorShort)) {
					currentScenario.errorShort = extractShortError(line)
				}
				currentScenario.status = 'failed'
			}
		}

		if (currentScenario != null) {
			finalizeScenario(currentScenario, scenarios)
		}

		return scenarios
	}

	private Map newScenarioMap(String id, String title) {
		return [
			id           : id,
			title        : safeValue(title),
			status       : 'passed',
			startLabel   : '',
			endLabel     : '',
			durationMs   : 0L,
			durationLabel: formatDurationFull(0L),
			errorShort   : '',
			errorFull    : '',
			steps        : [],
			evidence     : []
		]
	}

	private void finalizeScenario(Map scenario, List<Map> target) {
		List<Map> steps = scenario.steps instanceof List ? (scenario.steps as List<Map>) : []
		if (toLong(scenario.durationMs) <= 0L) {
			long total = 0L
			steps.each { Map step ->
				total += toLong(step.durationMs)
			}
			scenario.durationMs = total
			scenario.durationLabel = formatDurationFull(total)
		}

		if (steps.any { Map step -> safeValue(step.status) == 'failed' }) {
			scenario.status = 'failed'
		}

		target << scenario
	}

	private File findExecutionLog(File reportDir) {
		List<File> candidates = []

		reportDir.eachFileRecurse { File file ->
			if (file != null && file.isFile()) {
				String lower = safeValue(file.name).toLowerCase(Locale.ENGLISH)
				if (lower.startsWith('execution') && lower.endsWith('.log')) {
					candidates << file
				}
			}
		}

		if (candidates.isEmpty()) {
			return null
		}

		candidates.sort { File a, File b -> a.lastModified() <=> b.lastModified() }
		return candidates.last()
	}

	private List<String> readFileLines(File file) {
		try {
			return Files.readAllLines(file.toPath(), StandardCharsets.UTF_8)
		} catch (Exception ignored) {
			try {
				return file.readLines()
			} catch (Exception ignoredAgain) {
				return []
			}
		}
	}

	private String sanitizeLogLine(String rawLine) {
		String line = safeValue(rawLine)
		if (isBlank(line)) {
			return ''
		}

		line = line.replaceAll(/\u001B\[[;\d]*m/, '')
		line = line.replace('\t', ' ')
		line = line.replaceAll(/\s+/, ' ').trim()

		def matcher = (line =~ /^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3}\s+\w+\s+.+?-\s+(.*)$/)
		if (matcher.find()) {
			line = safeValue(matcher.group(1))
		}

		return line
	}

	private String extractScenarioStart(String line) {
		def matcher = (line =~ /^START (Test Cases\/.+)$/)
		if (matcher.find()) {
			return safeValue(matcher.group(1))
		}

		matcher = (line =~ /^TEST CASE:\s*(Test Cases\/.+)$/)
		if (matcher.find()) {
			return safeValue(matcher.group(1))
		}

		return ''
	}

	private String extractScenarioEnd(String line) {
		def matcher = (line =~ /^END (Test Cases\/.+)$/)
		if (matcher.find()) {
			return safeValue(matcher.group(1))
		}
		return ''
	}

	private Map parseCompactStepLine(String line, int stepIndex) {
		def matcher = (line =~ /^(\d+)\s*-\s*(.+?)\s*\(([\d.,]+)s\)$/)
		if (!matcher.find()) {
			return null
		}

