REC - Validate Dimensions Tree And Export

import static com.kms.katalon.core.testcase.TestCaseFactory.findTestCase

import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI

String targetEnvironment = 'REC'
String exportScenarioName = 'ModuleDesResponsabilite_ValidateDimensions'

String menuName = CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.getMenuName'()
String dimensionsImageGroup = CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.getDimensionsImageGroup'()

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
    'Authenticate and open Module des Responsabilite\n' +
    'Environment: REC'
)

WebUI.callTestCase(
    findTestCase('Component/Authentication/Login REC'),
    [:],
    FailureHandling.STOP_ON_FAILURE
)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.openMenu'(60)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.validateOpenedMenu'(60)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
    'Validate complete dimensions tree'
)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.validateDimensionsImagesExist'(dimensionsImageGroup)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.validateMeasuresOpen'(dimensionsImageGroup,15)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.clickFirstDimension'(dimensionsImageGroup)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.openDimensionsUntilProvic'(dimensionsImageGroup,65)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.validateProvicOpen'(dimensionsImageGroup,15)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.validateLastDimension'(dimensionsImageGroup,15)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.scrollDimensionsToTop'(dimensionsImageGroup,100)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.validateFirstPageReference'(dimensionsImageGroup,15)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.takeEvidence'(
    'ValidateDimensionsTree.png'
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
    'Prepare expanded table and export file'
)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.prepareExpandedTableForExport'(
    dimensionsImageGroup
)

WebUI.callTestCase(
    findTestCase('Component/Export Files/Export Current Table By Outils'),
    [
        ('targetEnvironment'):targetEnvironment,
        ('exportScenarioName'):exportScenarioName
    ],
    FailureHandling.STOP_ON_FAILURE
)

WebUI.callTestCase(
    findTestCase('Component/Authentication/Close Application'),
    [:],
    FailureHandling.STOP_ON_FAILURE
)

KeywordUtil.markPassed(
    'REC validation completed successfully.'
)


