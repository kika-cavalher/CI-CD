            html.append('<div class="banner-meta-line">Generated: ')
            html.append(htmlEscape(page.generatedAt))
            html.append('</div>\n')
        }
        html.append('<div class="banner-meta-line">Project: ')
        html.append(htmlEscape(APP_NAME))
        html.append('</div>\n')
        html.append('</div>\n')
        html.append('</header>\n')

        html.append('<div class="page-shell">\n')

        // Sidebar
        html.append('<aside class="sidebar">\n')
        html.append('<div class="sidebar-tabs">\n')
        html.append('<button id="tabBtnTests" class="sidebar-tab active" type="button" onclick="switchTab(\'tests\')">Tests</button>\n')
