import com.kms.katalon.core.util.KeywordUtil

import internal.GlobalVariable

// ======================================================
// VALIDATION CONFIG
// ======================================================

// Apache POI uses zero-based indexes.
// Excel column X = index 23.
Integer expectedColumnIndex = 23
String expectedColumnName = 'Valo finale ccy'

String validationName = 'Emission Dérivée'

// ======================================================
// TEST FLOW
// ======================================================

List<String> compareFiles = []

if (GlobalVariable.compareFiles instanceof Collection) {
	compareFiles.addAll(
		(GlobalVariable.compareFiles as Collection).collect { Object value ->
			value == null ? '' : value.toString().trim()
		}
	)
}

compareFiles = compareFiles.findAll { String filePath ->
	!filePath.isEmpty()
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Start REC x PRD validation\n' +
	'Feature: ' + validationName + '\n' +
	'Expected column index: ' + expectedColumnIndex + '\n' +
	'Expected column: ' + expectedColumnName
)

if (compareFiles.size() < 2) {
	String errorMessage =
		'REC x PRD validation cannot be executed.\n' +
		'Expected files: 2\n' +
		'Files received: ' + compareFiles.size() + '\n' +
		'REC file: ' +
		(compareFiles.size() > 0
			? compareFiles.get(0)
			: 'NOT FOUND') + '\n' +
		'PRD file: ' +
		(compareFiles.size() > 1
			? compareFiles.get(1)
			: 'NOT FOUND')

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[FAIL] Files available for validation\n' +
		errorMessage
	)

	KeywordUtil.markFailedAndStop(errorMessage)
}

String recFilePath = compareFiles.get(0)
String prdFilePath = compareFiles.get(1)

File recFile = new File(recFilePath)
File prdFile = new File(prdFilePath)

if (!recFile.exists() || !prdFile.exists()) {
	String errorMessage =
		'REC x PRD validation cannot be executed.\n' +
		'REC file: ' + recFile.getAbsolutePath() + '\n' +
		'REC exists: ' + recFile.exists() + '\n' +
		'PRD file: ' + prdFile.getAbsolutePath() + '\n' +
		'PRD exists: ' + prdFile.exists()

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[FAIL] Exported file validation\n' +
		errorMessage
	)

	KeywordUtil.markFailedAndStop(errorMessage)
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'[PASS] Files selected for validation\n' +
	'REC file: ' + recFile.getName() + '\n' +
	'PRD file: ' + prdFile.getName()
)

Map result =
	CustomKeywords.'commands.ExportFileValidationKeywords.validateRecPrdColumnStatistics'(
		compareFiles,
		expectedColumnIndex,
		expectedColumnName
	)

boolean success = result.success == true

String errors = safeText(result.errors)
String passedDetails = safeText(result.passedDetails)
String resolvedColumnName = safeText(result.columnName)

if (resolvedColumnName.isEmpty()) {
	resolvedColumnName = expectedColumnName
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	(success ? '[PASS] ' : '[FAIL] ') +
	'Excel validation result\n' +
	'Feature: ' + validationName + '\n' +
	'Expected column index: ' + expectedColumnIndex + '\n' +
	'Expected column: ' + expectedColumnName + '\n' +
	'Resolved column: ' + resolvedColumnName + '\n' +
	'REC file: ' + recFile.getName() + '\n' +
	'PRD file: ' + prdFile.getName() + '\n\n' +
	'Validation statistics\n' +
	'REC rows: ' + displayValue(result.recRows) + '\n' +
	'PRD rows: ' + displayValue(result.prdRows) + '\n' +
	'REC sum: ' + displayValue(result.recSum) + '\n' +
	'PRD sum: ' + displayValue(result.prdSum) + '\n' +
	'REC minimum: ' + displayValue(result.recMinimum) + '\n' +
	'PRD minimum: ' + displayValue(result.prdMinimum) + '\n' +
	'REC maximum: ' + displayValue(result.recMaximum) + '\n' +
	'PRD maximum: ' + displayValue(result.prdMaximum)
)

if (!success) {
	String failureMessage =
		'REC x PRD validation failed for ' +
		validationName + '.\n' +
		(errors.isEmpty()
			? 'Validation returned an unsuccessful result.'
			: errors)

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[FAIL] Final validation result\n' +
		failureMessage +
		(passedDetails.isEmpty()
			? ''
			: '\n\nSuccessful validations\n' + passedDetails)
	)

	KeywordUtil.markFailed(failureMessage)
} else {
	String successMessage =
		'REC x PRD validation completed successfully for ' +
		validationName + '.'

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[PASS] Final validation result\n' +
		successMessage +
		(passedDetails.isEmpty()
			? ''
			: '\n' + passedDetails)
	)

	KeywordUtil.markPassed(successMessage)
}

// ======================================================
// SUPPORT
// ======================================================

String displayValue(Object value) {
	String text = safeText(value)

	return text.isEmpty()
		? 'NOT AVAILABLE'
		: text
}

String safeText(Object value) {
	if (value == null) {
		return ''
	}

	return value.toString().trim()
}
