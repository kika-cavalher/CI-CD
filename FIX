package pageObject

import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import org.openqa.selenium.Keys

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.testobject.WindowsTestObject.LocatorStrategy
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import general.WinRetry
import internal.GlobalVariable

class authenticationKeywords {

	@Keyword
	def launchApplication() {
		if (System.getProperty('user.name') == GlobalVariable.username) {
			String cmd = 'Powershell.exe -executionpolicy remotesigned -File D:\\setResolution.ps1'
			Runtime.getRuntime().exec(cmd)

			Windows.startApplicationWithTitle(
					'D:\\RunAseMatchReq\\eMatch.lnk',
					GlobalVariable.version
					)
		} else {
			String command = 'C:\\Program Files (x86)\\Windows Application Driver\\WinAppDriver.exe'
			ProcessBuilder builder = new ProcessBuilder(command).inheritIO()
			builder.start()

			Windows.startApplication('\\\\cib.net\\shareparis\\Soft\\ematch\\IHM\\Livraisons\\REC\\IXIS.Ematch.IHM.application')
		}
	}

	@Keyword
	def switchToVersionWindow() {
		WindowsTestObject targetWindow = new WindowsTestObject()
		targetWindow.setLocatorStrategy(LocatorStrategy.NAME)
		targetWindow.setLocator(GlobalVariable.version)

		Windows.switchToDesktop()
		Windows.switchToWindow(targetWindow)
	}

	@Keyword
	def openEnvironmentSelector() {
		WinRetry.clickWithRetry('Login Page/optEnv', 3, 10)
		Windows.delay(20)
	}

	@Keyword
	def selectEnvironment() {
		int env = 3

		switch (GlobalVariable.env) {
			case 'PROD':
				env = 1
				break
			case 'PREX':
				env = 2
				break
			case 'REC2':
				env = 3
				break
			case 'REC':
				env = 4
				break
			case 'DEV2':
				env = 5
				break
			case 'DEV':
				env = 6
				break
		}

		for (int i = 0; i < env; i++) {
			Windows.sendKeys(findWindowsObject('Login Page/optEnv'), Keys.chord(Keys.ARROW_DOWN))
		}

		Windows.sendKeys(findWindowsObject('Login Page/optEnv'), Keys.chord(Keys.ENTER))
		Windows.delay(7)
	}

	@Keyword
	def clickConnectIfPresent() {
		boolean isButtonPresent = Windows.verifyElementPresent(
				findWindowsObject('Login Page/btnConnecter'),
				1,
				FailureHandling.OPTIONAL
				)

		if (isButtonPresent) {
			Windows.click(findWindowsObject('Login Page/btnConnecter'))
			KeywordUtil.logInfo('Connect button was present and was clicked.')
		} else {
			KeywordUtil.logInfo('Connect button was not present. Continuing test execution.')
		}
	}

	@Keyword
	def waitForMainScreen() {
		try {
			Windows.waitForElementPresent(findWindowsObject('General/txtSearch'), 60)
		} catch (Exception e) {
		}

		Windows.delay(10)
	}

	@Keyword
	def clickHomeImage() {
		String home = new File(
				RunConfiguration.getProjectDir(),
				'Images/General/Home.PNG'
				).getAbsolutePath()

		WindowsImageKeywords.clickImage(home)
		Windows.delay(5)
	}
}











