	List<Map> parseXmlCases(String xmlPath) {
		List<Map> result = []

		if (isBlank(xmlPath) || !new File(xmlPath).exists()) {
			return result
		}

		def xml = new XmlSlurper().parse(new File(xmlPath))
		List testcaseNodes = []

		if (safe(xml.name()) == 'testsuite') {
			testcaseNodes.addAll(xml.testcase)
		} else if (safe(xml.name()) == 'testsuites') {
			xml.testsuite.each { suite ->
				testcaseNodes.addAll(suite.testcase)
			}
		}

		testcaseNodes.each { tc ->
			String classname = safe(tc.@classname)
			String name = safe(tc.@name)
			long durationMs = toMillis(tc.@time)

			def failureNode = tc.failure?.size() > 0 ? tc.failure[0] : null
			def errorNode = tc.error?.size() > 0 ? tc.error[0] : null
			def skippedNode = tc.skipped?.size() > 0 ? tc.skipped[0] : null

			boolean failed = failureNode != null || errorNode != null
			boolean skipped = skippedNode != null

			String message = ''
			String details = ''

			if (failureNode != null) {
				message = safe(failureNode.@message)
				details = safe(failureNode.text())
			} else if (errorNode != null) {
				message = safe(errorNode.@message)
				details = safe(errorNode.text())
			}

			String displayName = ''
			if (!isBlank(classname) && !isBlank(name)) {
				displayName = classname + '/' + name
			} else {
				displayName = !isBlank(name) ? name : classname
			}

			result << [
				name       : displayName,
				shortName  : !isBlank(name) ? name : displayName,
				durationMs : durationMs,
				status     : skipped ? 'skipped' : (failed ? 'failed' : 'passed'),
				message    : message,
				details    : details
			]
		}

		return result
	}

	List<String> getFailureSummaryLines(String message, String details) {
		List<String> lines = []

		if (!isBlank(message)) {
			lines << safe(message)
		}

		safe(details).readLines().each { String raw ->
			String line = safe(raw)
			if (isBlank(line)) return
			if (line.startsWith('at ')) return
			if (line.startsWith('Caused by: at ')) return
			if (line.contains('com.kms.katalon') && line.length() > 120) return
			if (line.contains('org.openqa.selenium') && line.length() > 120) return
			lines << line
		}

		lines = lines.collect { it.replaceAll(/\s+/, ' ').trim() }.findAll { !isBlank(it) }.unique()

		if (lines.isEmpty() && !isBlank(details)) {
			lines = safe(details).readLines()
				.collect { safe(it) }
				.findAll { !isBlank(it) }
				.take(3)
		}

		return lines.take(3)
	}

