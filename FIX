@echo off
setlocal EnableExtensions

set "CTX_FILE=D:\Projects\eMatchStarters\run-context.properties"

if not exist "%CTX_FILE%" (
    echo [ERROR] Context file not found: %CTX_FILE%
    exit /b 1
)

for /f "usebackq tokens=1* delims==" %%A in ("%CTX_FILE%") do (
    set "%%A=%%B"
)

if not defined CURRENT_LOG_FILE set "CURRENT_LOG_FILE=%REPORTS_DIR%\_desktop_logs\katalon_current.log"
if not defined MARKER_FILE set "MARKER_FILE=D:\Projects\eMatchStarters\logs\__jenkins_task_exitcode.txt"
if not defined RETRY set "RETRY=0"
if not defined BROWSER_TYPE set "BROWSER_TYPE=Windows"
if not defined OPEN_VISIBLE_APP set "OPEN_VISIBLE_APP=false"
if not defined AUTO_START_WINAPPDRIVER set "AUTO_START_WINAPPDRIVER=false"

call :ensure_parent "%CURRENT_LOG_FILE%"
call :ensure_parent "%MARKER_FILE%"

if exist "%MARKER_FILE%" del /f /q "%MARKER_FILE%" >nul 2>nul

> "%CURRENT_LOG_FILE%" echo [INFO] ============================================================
>> "%CURRENT_LOG_FILE%" echo [INFO] RUN_LABEL = %RUN_LABEL%
>> "%CURRENT_LOG_FILE%" echo [INFO] WORKSPACE = %WORKSPACE%
>> "%CURRENT_LOG_FILE%" echo [INFO] PROJECT_PATH = %PROJECT_PATH%
>> "%CURRENT_LOG_FILE%" echo [INFO] KATALON_EXE = %KATALON_EXE%
>> "%CURRENT_LOG_FILE%" echo [INFO] ASSET_TYPE = %ASSET_TYPE%
>> "%CURRENT_LOG_FILE%" echo [INFO] ASSET_PATH = %ASSET_PATH%
>> "%CURRENT_LOG_FILE%" echo [INFO] BROWSER_TYPE = %BROWSER_TYPE%
>> "%CURRENT_LOG_FILE%" echo [INFO] REPORTS_DIR = %REPORTS_DIR%
>> "%CURRENT_LOG_FILE%" echo [INFO] CURRENT_LOG_FILE = %CURRENT_LOG_FILE%
>> "%CURRENT_LOG_FILE%" echo [INFO] MARKER_FILE = %MARKER_FILE%
>> "%CURRENT_LOG_FILE%" echo [INFO] OPEN_VISIBLE_APP = %OPEN_VISIBLE_APP%
>> "%CURRENT_LOG_FILE%" echo [INFO] APP_LNK_PATH = %APP_LNK_PATH%
>> "%CURRENT_LOG_FILE%" echo [INFO] APP_EXE_PATH = %APP_EXE_PATH%
>> "%CURRENT_LOG_FILE%" echo [INFO] ============================================================

if not exist "%KATALON_EXE%" (
    >> "%CURRENT_LOG_FILE%" echo [ERROR] KATALON_EXE not found: %KATALON_EXE%
    > "%MARKER_FILE%" echo 1
    exit /b 1
)

if not exist "%PROJECT_PATH%" (
    >> "%CURRENT_LOG_FILE%" echo [ERROR] PROJECT_PATH not found: %PROJECT_PATH%
    > "%MARKER_FILE%" echo 1
    exit /b 1
)

set "RESOLVED_WINAPPDRIVER="

if defined WINAPPDRIVER_EXE if exist "%WINAPPDRIVER_EXE%" set "RESOLVED_WINAPPDRIVER=%WINAPPDRIVER_EXE%"
if not defined RESOLVED_WINAPPDRIVER if exist "C:\Program Files (x86)\Windows Application Driver\WinAppDriver.exe" set "RESOLVED_WINAPPDRIVER=C:\Program Files (x86)\Windows Application Driver\WinAppDriver.exe"
if not defined RESOLVED_WINAPPDRIVER if exist "C:\Program Files\Windows Application Driver\WinAppDriver.exe" set "RESOLVED_WINAPPDRIVER=C:\Program Files\Windows Application Driver\WinAppDriver.exe"

if not defined RESOLVED_WINAPPDRIVER (
    for %%F in ("%KATALON_EXE%") do (
        if exist "%%~dpFconfiguration\resources\extensions\WinAppDriver\WinAppDriver.exe" set "RESOLVED_WINAPPDRIVER=%%~dpFconfiguration\resources\extensions\WinAppDriver\WinAppDriver.exe"
    )
)

if /I "%AUTO_START_WINAPPDRIVER%"=="true" (
    if defined RESOLVED_WINAPPDRIVER (
        >> "%CURRENT_LOG_FILE%" echo [INFO] Starting WinAppDriver...
        start "" /min "%RESOLVED_WINAPPDRIVER%"
        timeout /t 2 /nobreak >nul
    ) else (
        >> "%CURRENT_LOG_FILE%" echo [WARN] WinAppDriver.exe not found. Auto start skipped.
    )
)

if /I "%OPEN_VISIBLE_APP%"=="true" (
    if defined APP_LNK_PATH (
        if exist "%APP_LNK_PATH%" (
            >> "%CURRENT_LOG_FILE%" echo [INFO] Opening visible app from APP_LNK_PATH...
            start "" "%APP_LNK_PATH%"
            timeout /t 8 /nobreak >nul
        ) else (
            >> "%CURRENT_LOG_FILE%" echo [WARN] APP_LNK_PATH not found: %APP_LNK_PATH%
        )
    ) else (
        if defined APP_EXE_PATH (
            if exist "%APP_EXE_PATH%" (
                >> "%CURRENT_LOG_FILE%" echo [INFO] Opening visible app from APP_EXE_PATH...
                start "" "%APP_EXE_PATH%"
                timeout /t 8 /nobreak >nul
            ) else (
                >> "%CURRENT_LOG_FILE%" echo [WARN] APP_EXE_PATH not found: %APP_EXE_PATH%
            )
        ) else (
            >> "%CURRENT_LOG_FILE%" echo [WARN] No visible app path configured.
        )
    )
)

set "KATALON_ARGS=-runMode=console -projectPath="%PROJECT_PATH%" -browserType="%BROWSER_TYPE%" -retry=%RETRY%"

if /I "%ASSET_TYPE%"=="COLLECTION" (
    set "KATALON_ARGS=%KATALON_ARGS% -testSuiteCollectionPath="%ASSET_PATH%""
) else (
    set "KATALON_ARGS=%KATALON_ARGS% -testSuitePath="%ASSET_PATH%""
)

if defined KATALON_EXTRA_ARGS (
    set "KATALON_ARGS=%KATALON_ARGS% %KATALON_EXTRA_ARGS%"
)

>> "%CURRENT_LOG_FILE%" echo [INFO] Starting Katalon execution...
call "%KATALON_EXE%" %KATALON_ARGS% >> "%CURRENT_LOG_FILE%" 2>&1

set "EXITCODE=%ERRORLEVEL%"

>> "%CURRENT_LOG_FILE%" echo [INFO] Katalon ExitCode = %EXITCODE%
> "%MARKER_FILE%" echo %EXITCODE%
>> "%CURRENT_LOG_FILE%" echo [INFO] Marker file written: %MARKER_FILE%

exit /b %EXITCODE%

:ensure_parent
for %%F in ("%~1") do (
    if not exist "%%~dpF" mkdir "%%~dpF"
)
goto :eof
