String testCaseName = 'Export File Validation'

String baseExportFolderPath = resolveExecutionExportFolder().getAbsolutePath()

String requestedFileNames = ''
String includeSubFolders = 'true'
String minimumExpectedFiles = '3'

String defaultValidationType = 'Mixte'
String sheetIndex = '0'

String headerCurrency = 'Devise'
String headerCurrencyRef = 'Devise de ref.'
String headerAmountCcy = 'Montant ccy'
String headerAmountBaseCcy = 'Montant base ccy'

String amountDifferenceTolerancePercent = '3'

String maxErrorsPerFile = '999'
String maxGeneralErrors = '999'

Boolean validationFailed = false
String filesToValidate = ''

List<Map> reportSections = []

String requiredColumnsText = headerCurrency + ' | ' +
		headerCurrencyRef + ' | ' +
		headerAmountCcy + ' | ' +
		headerAmountBaseCcy

String setupReport =
		'Folder: ' + new File(baseExportFolderPath).getName() + '\n' +
		'File search: ' + (requestedFileNames?.trim() ? requestedFileNames : 'Automatic from export folder') + '\n' +
		'Minimum files required: ' + minimumExpectedFiles + '\n' +
		'Validation type: ' + defaultValidationType + '\n' +
		'Sheet index: ' + sheetIndex + '\n' +
		'Accepted amount difference: <= ' + amountDifferenceTolerancePercent + '%'

reportSections.add([
	name  : 'Export validation setup',
	status: 'INFO',
	body  : setupReport
])

String validationResult = ''

validationResult = CustomKeywords.'commands.ExportFileValidationKeywords.validateEvidenceFolderExists'(
		baseExportFolderPath
)

String folderStatus = hasValidationFailure(validationResult) ? 'FAILED' : 'PASSED'
String folderReport = buildFolderReport(baseExportFolderPath, validationResult)

reportSections.add([
	name  : 'Export folder',
	status: folderStatus,
	body  : folderReport
])

if (folderStatus == 'FAILED') {
	validationFailed = true
}

if (!validationFailed) {
	filesToValidate = CustomKeywords.'commands.ExportFileValidationKeywords.resolveExcelFilesAsString'(
			baseExportFolderPath,
			requestedFileNames,
			includeSubFolders
	)

	List<File> files = parseFileList(filesToValidate)

	String foundFilesResult = CustomKeywords.'commands.ExportFileValidationKeywords.validateExcelFilesFound'(
			filesToValidate
	)

	String minimumFilesResult = CustomKeywords.'commands.ExportFileValidationKeywords.validateMinimumExpectedFileQuantity'(
			filesToValidate,
			minimumExpectedFiles
	)

	String fileDiscoveryResult = combineValidationResults(foundFilesResult, minimumFilesResult)

	String fileDiscoveryStatus = hasValidationFailure(fileDiscoveryResult) ? 'FAILED' : 'PASSED'
	String fileDiscoveryReport = buildFileDiscoveryReport(
			filesToValidate,
			minimumExpectedFiles,
			fileDiscoveryResult,
			maxGeneralErrors
	)

	reportSections.add([
		name  : 'Export files',
		status: fileDiscoveryStatus,
		body  : fileDiscoveryReport
	])

	if (fileDiscoveryStatus == 'FAILED') {
		validationFailed = true
	}

	if (!filesToValidate.trim().isEmpty()) {
		validationResult = CustomKeywords.'commands.ExportFileValidationKeywords.validateRequiredHeaders'(
				filesToValidate,
				defaultValidationType,
				sheetIndex,
				headerCurrency,
				headerCurrencyRef,
				headerAmountCcy,
				headerAmountBaseCcy
		)

		String requiredColumnsStatus = hasValidationFailure(validationResult) ? 'FAILED' : 'PASSED'
		String requiredColumnsReport = buildRequiredColumnsReport(
				validationResult,
				files,
				requiredColumnsText,
				parseIntOrDefault(maxGeneralErrors, 999)
		)

		reportSections.add([
			name  : 'Required columns',
			status: requiredColumnsStatus,
			body  : requiredColumnsReport
		])

		if (requiredColumnsStatus == 'FAILED') {
			validationFailed = true
		}

		validationResult = CustomKeywords.'commands.ExportFileValidationKeywords.validateRowsForValidationType'(
				filesToValidate,
				defaultValidationType,
				sheetIndex,
				headerCurrency,
				headerCurrencyRef
		)

		String currencyColumnsStatus = hasValidationFailure(validationResult) ? 'FAILED' : 'PASSED'
		String currencyColumnsReport = buildCurrencyColumnsReport(
				validationResult,
				files,
				parseIntOrDefault(maxGeneralErrors, 999)
		)

		reportSections.add([
			name  : 'Currency columns',
			status: currencyColumnsStatus,
			body  : currencyColumnsReport
		])

		if (currencyColumnsStatus == 'FAILED') {
			validationFailed = true
		}

		Map amountComparisonResult = validateAmountColumnsWithTolerance(
				filesToValidate,
				sheetIndex,
				headerCurrency,
				headerAmountCcy,
				headerAmountBaseCcy,
				amountDifferenceTolerancePercent,
				maxErrorsPerFile
		)

		String amountComparisonStatus = Boolean.TRUE.equals(amountComparisonResult.failed) ? 'FAILED' : 'PASSED'
		String amountComparisonReport = buildAmountComparisonReport(amountComparisonResult)

		reportSections.add([
			name  : 'Amount columns comparison',
			status: amountComparisonStatus,
			body  : amountComparisonReport
		])

		if (amountComparisonStatus == 'FAILED') {
			validationFailed = true
		}
	}
}

String finalReport = buildFinalReport(
		testCaseName,
		validationFailed,
		reportSections
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		(validationFailed ? '[FAIL] ' : '[PASS] ') + testCaseName + '\n' +
		finalReport
)

if (validationFailed) {
	KeywordUtil.markFailedAndStop(
			testCaseName + ' failed. Check the consolidated validation report above.'
	)
}

KeywordUtil.markPassed(
		testCaseName + ' completed successfully.'
)

File resolveExecutionExportFolder() {
	File executionRootFolder = resolveExecutionRootFolder()

	return new File(
			executionRootFolder,
			'Shared_REC_PRD_Exports'
	)
}

File resolveExecutionRootFolder() {
	String reportFolderPath = RunConfiguration.getReportFolder()

	if (reportFolderPath == null || reportFolderPath.trim().isEmpty()) {
		return new File(RunConfiguration.getProjectDir(), 'Reports\\Unknown_Execution')
	}

	File current = new File(reportFolderPath)

	while (current != null) {
		File parent = current.getParentFile()

		if (parent != null && parent.getName().equalsIgnoreCase('Reports')) {
			return current
		}

		current = parent
	}

	return new File(reportFolderPath)
}

String buildFinalReport(
		String testCaseName,
		Boolean validationFailed,
		List<Map> sections) {

	List<String> lines = []

	lines.add('==================== EXPORT FILE VALIDATION REPORT ====================')
	lines.add('Scenario: ' + testCaseName)
	lines.add('Result: ' + (validationFailed ? 'FAILED' : 'PASSED'))
	lines.add('')

	lines.add('Validation summary')
	lines.add('Validation | Result')
	lines.add('--- | ---')

	for (Map section : sections) {
		lines.add(safeText(section.name) + ' | ' + safeText(section.status))
	}

	lines.add('')
	lines.add('Detailed validations')

	for (Map section : sections) {
		lines.add('')
		lines.add(safeText(section.name))
		lines.add(''.padRight(safeText(section.name).length(), '-'))
		lines.add('Status: ' + safeText(section.status))

		String body = safeText(section.body)
		if (!body.isEmpty()) {
			lines.add(body)
		}
	}

	lines.add('')
	lines.add('==================== END OF SCENARIO: ' + testCaseName + ' | ' + (validationFailed ? 'FAILED' : 'PASSED') + ' ====================')

	return lines.join('\n')
}

String buildFolderReport(String folderPath, String validationResult) {
	File folder = new File(folderPath)

	String result = validationResult == null ? '' : validationResult.trim()

	if (hasValidationFailure(result)) {
		return 'Folder: ' + folder.getName() + '\n' +
				'Result: Not available\n' +
				'Details: ' + cleanErrorLineForReport(result, [])
	}

	return 'Folder: ' + folder.getName() + '\n' +
			'Result: Available'
}

String buildFileDiscoveryReport(
		String filesText,
		String minimumExpectedFilesText,
		String validationResult,
		String maxGeneralErrorsText) {

	List<File> files = parseFileList(filesText)

	Integer minimum = parseIntOrDefault(minimumExpectedFilesText, 0)
	Integer rowsToShow = Math.max(minimum, files.size())

	List<String> lines = []

	lines.add('Required files: ' + minimum)
	lines.add('Found files: ' + files.size())
	lines.add('')

	if (rowsToShow <= 0) {
		lines.add('No files were configured for validation.')
		return lines.join('\n')
	}

	for (int i = 0; i < rowsToShow; i++) {
		if (i < files.size()) {
			lines.add('File ' + (i + 1) + ': ' + files[i].getName())
		} else {
			lines.add('File ' + (i + 1) + ': Missing file')
		}
	}

	if (hasValidationFailure(validationResult)) {
		List<String> errors = extractErrorLines(validationResult)

		if (!errors.isEmpty()) {
			lines.add('')
			lines.add('Errors:')

			for (String error : limitLines(errors, parseIntOrDefault(maxGeneralErrorsText, 999))) {
				lines.add('- ' + cleanErrorLineForReport(error, files))
			}
		}
	}

	return lines.join('\n')
}

String buildRequiredColumnsReport(
		String validationResult,
		List<File> files,
		String requiredColumnsText,
		Integer maxGeneral) {

	List<String> lines = []

	lines.add('Columns checked: ' + requiredColumnsText)
	lines.add('Checked files: ' + (files == null ? 0 : files.size()))
	lines.add('')

	if (files != null) {
		for (int i = 0; i < files.size(); i++) {
			lines.add('File ' + (i + 1) + ': ' + files[i].getName())
		}
	}

	if (hasValidationFailure(validationResult)) {
		List<String> errors = extractErrorLines(validationResult)

		lines.add('')
		lines.add('Errors:')

		for (String error : limitLines(errors, maxGeneral)) {
			lines.add('- ' + cleanErrorLineForReport(error, files))
		}
	}

	return lines.join('\n')
}

