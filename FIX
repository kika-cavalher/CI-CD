if "%AUTO_START_WINAPPDRIVER%"=="" (
    set "AUTO_START_WINAPPDRIVER=true"
)

if "%WINAPPDRIVER_EXE%"=="" (
    set "WINAPPDRIVER_EXE=C:\Program Files (x86)\Windows Application Driver\WinAppDriver.exe"
)

for %%F in ("%REPORTS_DIR%") do (
    if not exist "%%~fF" mkdir "%%~fF" >nul 2>&1
)

for %%F in ("%LOG_DIR%") do (
    if not exist "%%~fF" mkdir "%%~fF" >nul 2>&1
)

for %%F in ("%MARKER_FILE%") do (
    if not exist "%%~dpF" mkdir "%%~dpF" >nul 2>&1
)

for %%F in ("%CURRENT_LOG_FILE%") do (
    if not exist "%%~dpF" mkdir "%%~dpF" >nul 2>&1
)

if exist "%MARKER_FILE%" del /f /q "%MARKER_FILE%" >nul 2>&1
if exist "%MARKER_FILE%.tmp" del /f /q "%MARKER_FILE%.tmp" >nul 2>&1
if exist "%CURRENT_LOG_FILE%" del /f /q "%CURRENT_LOG_FILE%" >nul 2>&1

type nul > "%CURRENT_LOG_FILE%"

for /f %%I in ('powershell -NoProfile -Command "Get-Date -Format yyyyMMdd_HHmmss"') do set "TS=%%I"
set "FINAL_LOG_FILE=%LOG_DIR%\katalon_%TS%.log"

taskkill /FI "WINDOWTITLE eq eMatch Live Log*" /T /F >nul 2>&1

start "eMatch Live Log | %RUN_LABEL%" cmd /k powershell -NoProfile -ExecutionPolicy Bypass -Command "Get-Content -LiteralPath '%CURRENT_LOG_FILE%' -Wait -Tail 20"

timeout /t 1 >nul

call :appendlog ============================================================
call :appendlog  eMatch Desktop Run
call :appendlog ============================================================
call :appendlog [INFO] RUN_LABEL       = "%RUN_LABEL%"
call :appendlog [INFO] WORKSPACE       = "%WORKSPACE%"
call :appendlog [INFO] PROJECT_PATH    = "%PROJECT_PATH%"
call :appendlog [INFO] KATALON_EXE     = "%KATALON_EXE%"
call :appendlog [INFO] ASSET_TYPE      = "%ASSET_TYPE%"
call :appendlog [INFO] ASSET_PATH      = "%ASSET_PATH%"
call :appendlog [INFO] BROWSER_TYPE    = "%BROWSER_TYPE%"
call :appendlog [INFO] RETRY           = "%RETRY%"
call :appendlog [INFO] REPORTS_DIR     = "%REPORTS_DIR%"
call :appendlog [INFO] CURRENT_LOG     = "%CURRENT_LOG_FILE%"
call :appendlog [INFO] FINAL_LOG       = "%FINAL_LOG_FILE%"
call :appendlog [INFO] MARKER_FILE     = "%MARKER_FILE%"
call :appendlog ============================================================
call :appendlog.

if /I "%AUTO_START_WINAPPDRIVER%"=="true" (
    tasklist /FI "IMAGENAME eq WinAppDriver.exe" | find /I "WinAppDriver.exe" >nul

    if errorlevel 1 (
        if exist "%WINAPPDRIVER_EXE%" (
            call :appendlog [INFO] WinAppDriver is not running. Starting it now...
            start "WinAppDriver" "%WINAPPDRIVER_EXE%"
            timeout /t 3 >nul
        ) else (
            call :appendlog [WARN] WinAppDriver executable not found: "%WINAPPDRIVER_EXE%"
        )
    ) else (
        call :appendlog [INFO] WinAppDriver is already running
    )
) else (
    call :appendlog [INFO] AUTO_START_WINAPPDRIVER=false
)

cd /d "%WORKSPACE%"

if /I "%ASSET_TYPE%"=="COLLECTION" (
    call :appendlog [INFO] Running Katalon test suite collection...

    "%KATALON_EXE%" ^
      -noSplash ^
      -runMode=console ^
      -consoleLog ^
      -projectPath="%PROJECT_PATH%" ^
      -retry=%RETRY% ^
      -testSuiteCollectionPath="%ASSET_PATH%" ^
      -browserType="%BROWSER_TYPE%" ^
      -reportFolder="%REPORTS_DIR%" ^
      >> "%CURRENT_LOG_FILE%" 2>&1
) else (
    call :appendlog [INFO] Running Katalon test suite...

    "%KATALON_EXE%" ^
      -noSplash ^
      -runMode=console ^
      -consoleLog ^
      -projectPath="%PROJECT_PATH%" ^
      -retry=%RETRY% ^
      -testSuitePath="%ASSET_PATH%" ^
      -browserType="%BROWSER_TYPE%" ^
      -reportFolder="%REPORTS_DIR%" ^
      >> "%CURRENT_LOG_FILE%" 2>&1
)

set "EXITCODE=%ERRORLEVEL%"

copy /Y "%CURRENT_LOG_FILE%" "%FINAL_LOG_FILE%" >nul 2>&1

call :appendlog.
call :appendlog [INFO] Katalon ExitCode = %EXITCODE%
call :appendlog [INFO] Writing marker file...

(
    echo %EXITCODE%
) > "%MARKER_FILE%.tmp"

move /Y "%MARKER_FILE%.tmp" "%MARKER_FILE%" >nul 2>&1

call :appendlog [INFO] Marker file written: "%MARKER_FILE%"
call :appendlog [INFO] Final log saved   : "%FINAL_LOG_FILE%"
call :appendlog.

exit /b %EXITCODE%

:appendlog
echo %*
>> "%CURRENT_LOG_FILE%" echo %*
exit /b 0




