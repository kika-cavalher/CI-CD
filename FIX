/*
 * Responsibility:
 * Minimal desktop runner:
 * - Starts WinAppDriver task
 * - Starts the desktop scheduled task (suite)
 * - Waits until the suite task stops running
 * - Stops WinAppDriver
 * - Archives + JUnit + triggers next job
 *
 * IMPORTANT:
 * - REC / PRD selection remains inside Katalon login tests
 * - Jenkins MUST NOT decide REC/PRD
 */

def run(script, Map cfg) {
    String reportsRoot = "${script.pwd()}\\Reports"

    String winDriverTask = (cfg.winDriverTask ?: '').trim()
    String desktopTask   = (cfg.desktopRunnerTask ?: '').trim()

    if (!winDriverTask) {
        script.error("winDriverTask is empty in PIPELINE_CONFIG")
    }
    if (!desktopTask) {
        script.error("desktopRunnerTask is empty in PIPELINE_CONFIG")
    }

    script.stage('Validate Environment') {
        script.bat """
@echo off
echo ------------------------------------------------------------
echo VALIDATING TOOLS AND SUPPORT FILES
echo ------------------------------------------------------------

if not exist "${script.pwd()}\\${cfg.projectFileName}" (
  echo [ERROR] Project file not found:
  echo ${script.pwd()}\\${cfg.projectFileName}
  exit /b 1
)

schtasks /query /tn "${winDriverTask}" >nul 2>nul
if errorlevel 1 (
  echo [ERROR] WinDriver scheduled task not found:
  echo ${winDriverTask}
  exit /b 1
)

schtasks /query /tn "${desktopTask}" >nul 2>nul
if errorlevel 1 (
  echo [ERROR] Desktop scheduled task not found:
  echo ${desktopTask}
  exit /b 1
)

echo [OK] Support files and scheduled tasks found
echo ------------------------------------------------------------
"""
    }

    script.stage('Prepare Artifacts') {
        script.bat """
@echo off
if exist "${reportsRoot}" rmdir /s /q "${reportsRoot}"
mkdir "${reportsRoot}"
"""
    }

    script.stage(cfg.executionStageName ?: 'Run Test Assets') {
        cfg.assets.each { asset ->
            script.stage("Run - ${asset.name}") {

                script.echo "============================================================"
                script.echo "🚀 START ASSET: ${asset.name}"
                script.echo "📌 TASK: ${desktopTask}"
                script.echo "============================================================"

                script.bat """
@echo off
setlocal EnableExtensions EnableDelayedExpansion

echo ------------------------------------------------------------
echo STARTING WINDRIVER TASK: ${winDriverTask}
echo ------------------------------------------------------------
schtasks /run /tn "${winDriverTask}"
if errorlevel 1 (
  echo [ERROR] Failed to start WinDriver task
  exit /b 1
)

echo ------------------------------------------------------------
echo STARTING DESKTOP TASK: ${desktopTask}
echo ------------------------------------------------------------
schtasks /run /tn "${desktopTask}"
if errorlevel 1 (
  echo [ERROR] Failed to start Desktop task
  schtasks /end /tn "${winDriverTask}" >nul 2>nul
  exit /b 1
)

echo ------------------------------------------------------------
echo WAITING DESKTOP TASK TO FINISH: ${desktopTask}
echo ------------------------------------------------------------

:loop
for /f "tokens=2 delims=: " %%f in ('schtasks /query /tn "${desktopTask}" /fo list ^| find "Status:"') do (
  set STATUS=%%f
)

if /i "!STATUS!"=="Running" (
  ping -n 6 localhost >nul 2>nul
  goto loop
)

echo ------------------------------------------------------------
echo DESKTOP TASK FINISHED. STATUS=!STATUS!
echo ------------------------------------------------------------

echo ------------------------------------------------------------
echo STOPPING WINDRIVER TASK: ${winDriverTask}
echo ------------------------------------------------------------
schtasks /end /tn "${winDriverTask}" >nul 2>nul

endlocal
exit /b 0
"""
            }
        }
    }

    script.stage('Collect Reports') {
        script.catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
            script.junit allowEmptyResults: true, testResults: 'Reports/**/*.xml,Reports/**/*.junit.xml'
        }

        script.catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
            script.archiveArtifacts artifacts: 'Reports/**/*', allowEmptyArchive: true
        }
    }

    if ((script.currentBuild.currentResult == null || script.currentBuild.currentResult == 'SUCCESS') &&
        (cfg.nextJobName ?: '').trim()) {
        script.echo "Triggering next Jenkins job: ${cfg.nextJobName}"
        script.build job: cfg.nextJobName, wait: false, propagate: false
    }
}

return this


winDriverTask      : 'startWinDriver',
desktopRunnerTask  : '\\\\eMatch Automation\\\\ArchiveMode',
