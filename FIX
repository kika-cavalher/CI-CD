package component

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import commands.ImageLoader
import commands.WindowsObjectLoader

class SettingsArchiveModeKeywords {

	private ImageLoader imageLoader = new ImageLoader()

	@Keyword
	void enableArchiveModeFromSettings(Integer timeoutSeconds) {
		int safeTimeout = normalizeTimeout(timeoutSeconds)

		addNote(
			'Configure Archive Mode\n' +
			'Screen: Settings\n' +
			'Option: Donnees d archive\n' +
			'Expected value: Oui\n' +
			'Validation: image only'
		)

		openSettingsMenu()
		waitArchiveModeSettingsVisible(safeTimeout)

		boolean wasChanged = ensureArchiveModeIsEnabledByImage()

		if (wasChanged) {
			waitUntilHomeIsReadyAfterArchiveModeChange()

			openSettingsMenu()
			waitArchiveModeSettingsVisible(safeTimeout)

			validateArchiveModeOuiByImage()
		}

		returnToHomeUsingHomeWhiteOnly()

		addNote(
			'Archive Mode configuration completed\n' +
			'Final value: Oui'
		)
	}

	private int normalizeTimeout(Integer timeoutSeconds) {
		if (timeoutSeconds == null || timeoutSeconds <= 0) {
			return 5
		}

		return timeoutSeconds > 5 ? 5 : timeoutSeconds
	}

	private void openSettingsMenu() {
		addNote(
			'Open Settings menu'
		)

		clickImageWithMaxTimeout(
			'General',
			'settings',
			'Settings menu',
			true
		)

		Windows.delay(2)
	}

	private void waitArchiveModeSettingsVisible(Integer timeoutSeconds) {
		addNote(
			'Wait Archive Mode settings option\n' +
			'Expected item: Donnees d archive\n' +
			'Action: wait only, do not click'
		)

		if (!Windows.waitForElementPresent(
				WindowsObjectLoader.getObject('settingsArchiveMode', 'archiveDataMenu'),
				timeoutSeconds,
				FailureHandling.OPTIONAL
		)) {
			imageLoader.takeEvidence(
				'ArchiveModeSettingsOptionNotFound.png'
			)

			KeywordUtil.markFailedAndStop(
				'Archive Mode settings option was not found.\n' +
				'Expected item: Donnees d archive'
			)
		}

		Windows.delay(1)
	}

	private boolean ensureArchiveModeIsEnabledByImage() {
		addNote(
			'Validate Archive Mode toggle by image\n' +
			'If image Non is visible, change to Oui\n' +
			'If image Oui is already visible, continue'
		)

		if (isImageVisible('General', 'archiveModeSettingsOui')) {
			addNote(
				'Archive Mode already enabled\n' +
				'Current value: Oui\n' +
				'Validation: archiveModeSettingsOui image'
			)

			return false
		}

		if (isImageVisible('General', 'archiveModeSettingsNo')) {
			addNote(
				'Archive Mode current value: Non\n' +
				'Action: click image Non to change to Oui'
			)

			clickImageWithMaxTimeout(
				'General',
				'archiveModeSettingsNo',
				'Archive Mode Non toggle',
				true
			)

			Windows.delay(3)

			return true
		}

		imageLoader.takeEvidence(
			'ArchiveModeToggleImageNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Archive Mode toggle image was not found.\n' +
			'Expected image key: archiveModeSettingsNo or archiveModeSettingsOui'
		)

		return false
	}

	private void waitUntilHomeIsReadyAfterArchiveModeChange() {
		addNote(
			'Wait application return to Home after changing Archive Mode\n' +
			'Expected image: homeGrey'
		)

		if (imageLoader.waitForImage('General', 'homeGrey', 5)) {
			addNote(
				'Application returned to Home successfully\n' +
				'Image found: homeGrey'
			)

			Windows.delay(2)
			return
		}

		addNote(
			'HomeGrey image was not found after changing Archive Mode\n' +
			'Continue because application may already be ready'
		)

		Windows.delay(2)
	}

	private void validateArchiveModeOuiByImage() {
		addNote(
			'Validate Archive Mode final value by image\n' +
			'Expected image: archiveModeSettingsOui'
		)

		if (imageLoader.waitForImage('General', 'archiveModeSettingsOui', 5)) {
			addNote(
				'Archive Mode final value confirmed\n' +
				'Current value: Oui\n' +
				'Validation: archiveModeSettingsOui image'
			)

			return
		}

		boolean isNoVisible = imageLoader.waitForImage(
			'General',
			'archiveModeSettingsNo',
			1
		)

		imageLoader.takeEvidence(
			'ArchiveModeFinalValueNotOui.png'
		)

		if (isNoVisible) {
			KeywordUtil.markFailedAndStop(
				'Archive Mode final value is still Non.\n' +
				'Expected image: archiveModeSettingsOui'
			)
		}

		KeywordUtil.markFailedAndStop(
			'Archive Mode final value could not be validated by image.\n' +
			'Expected image key: archiveModeSettingsOui'
		)
	}

	private void returnToHomeUsingHomeWhiteOnly() {
		addNote(
			'Return to Home tab\n' +
			'Image used: homeWhite'
		)

		boolean clicked = clickImageWithMaxTimeout(
			'General',
			'homeWhite',
			'Home tab',
			false
		)

		if (!clicked) {
			imageLoader.takeEvidence(
				'HomeWhiteImageNotFoundAfterArchiveModeValidation.png'
			)

			KeywordUtil.markFailedAndStop(
				'Home tab image was not found.\n' +
				'Expected image key: homeWhite'
			)
		}

		Windows.delay(2)

		addNote(
			'Home tab clicked successfully\n' +
			'Image used: homeWhite'
		)
	}

	private boolean clickImageWithMaxTimeout(
			String groupName,
			String imageKey,
			String description,
			boolean stopOnFailure
	) {
		boolean found = imageLoader.waitForImage(
			groupName,
			imageKey,
			5
		)

		if (!found) {
			if (stopOnFailure) {
				imageLoader.takeEvidence(
					description.replaceAll('[^a-zA-Z0-9]', '') + 'ImageNotFound.png'
				)

				KeywordUtil.markFailedAndStop(
					description + ' image was not found.\n' +
					'Group: ' + groupName + '\n' +
					'Key: ' + imageKey
				)
			}

			return false
		}

		try {
			String imagePath = imageLoader.getImage(
				groupName,
				imageKey
			)

			WindowsImageKeywords.clickImage(imagePath)

			addNote(
				description + ' clicked successfully\n' +
				'Image key: ' + imageKey
			)

			return true
		} catch (Throwable error) {
			imageLoader.takeEvidence(
				description.replaceAll('[^a-zA-Z0-9]', '') + 'ClickFailed.png'
			)

			if (stopOnFailure) {
				KeywordUtil.markFailedAndStop(
					description + ' image click failed.\n' +
					'Group: ' + groupName + '\n' +
					'Key: ' + imageKey + '\n' +
					'Reason: ' + error.getMessage()
				)
			}

			return false
		}
	}

	private boolean isImageVisible(String groupName, String imageKey) {
		try {
			return imageLoader.waitForImage(
				groupName,
				imageKey,
				1
			)
		} catch (Throwable ignored) {
			return false
		}
	}

	private void addNote(String message) {
		try {
			new jiraIntegration.JiraReportSteps().note(message)
		} catch (Throwable ignored) {
			KeywordUtil.logInfo(message)
		}
	}
}
