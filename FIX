package jiraIntegration

import java.io.File
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale
import java.net.URI

class JiraHtmlTemplateBuilder {

	private JiraFlowCoordinator owner

	private static final String DEFAULT_APP_NAME = 'Execution'
	private static final String REPORT_TITLE_PREFIX = 'Test report - '

	private static final String STATUS_PASS = '#68b84b'
	private static final String STATUS_FAIL = '#e05b4d'
	private static final String STATUS_SKIP = '#d7b436'

	JiraHtmlTemplateBuilder() {
		this.owner = null
	}

	JiraHtmlTemplateBuilder(JiraFlowCoordinator owner) {
		this.owner = owner
	}

	String build(Map model) {
		return buildHtml(model)
	}

	String render(Map model) {
		return buildHtml(model)
	}

	String buildHtml(Map model) {
		Map view = normalizeModel(model)

		StringBuilder html = new StringBuilder()

		html.append('<!DOCTYPE html>\n')
		html.append('<html lang="en">\n')
		html.append('<head>\n')
		html.append('<meta charset="UTF-8">\n')
		html.append('<meta name="viewport" content="width=device-width, initial-scale=1.0">\n')
		html.append('<title>')
		html.append(htmlEscape(view.reportTitle))
		html.append('</title>\n')
		html.append(buildStyles(view))
		html.append('</head>\n')
		html.append('<body>\n')

		html.append('<header class="top-banner">\n')
		html.append('  <div class="top-banner-left">\n')

		if (!safeValue(view.logoSrc).isEmpty()) {
			html.append('    <img class="brand-logo" src="')
			html.append(htmlEscape(resolveLogoHref(view)))
			html.append('" alt="')
			html.append(htmlEscape(view.appName))
			html.append(' logo">\n')
		}

		html.append('    <div class="brand-copy">\n')
		html.append('      <div class="banner-title">')
		html.append(htmlEscape(view.reportTitle))
		html.append('</div>\n')
		html.append('      <div class="banner-subtitle">')
		html.append(htmlEscape(view.subtitle))
		html.append('</div>\n')
		html.append('    </div>\n')
		html.append('  </div>\n')

		html.append('  <div class="top-banner-right">\n')
		html.append('    <div>')
		html.append(htmlEscape(view.generatedLabel))
		html.append('</div>\n')
		html.append('    <div>Project ')
		html.append(htmlEscape(view.appName))
		html.append('</div>\n')
		html.append('  </div>\n')
		html.append('</header>\n')

		html.append('<div class="page">\n')

		html.append('  <aside class="sidebar">\n')
		html.append('    <div class="sidebar-tabs">\n')
		html.append('      <button id="tab-tests" class="sidebar-tab active" type="button" onclick="showTab(\'tests\')">Tests</button>\n')
		html.append('      <button id="tab-charts" class="sidebar-tab" type="button" onclick="showTab(\'charts\')">Charts</button>\n')
		html.append('    </div>\n')

		html.append('    <div id="tests-sidebar-block">\n')
		html.append('      <div class="search-wrap">\n')
		html.append('        <input id="scenarioSearch" class="search-input" type="text" placeholder="Search test name, path, or status." onkeyup="filterScenarios()">\n')
		html.append('      </div>\n')
		html.append('      <div id="scenarioList" class="scenario-list">\n')
		view.scenarios.eachWithIndex { Map scenario, int index ->
			html.append(buildScenarioListItem(scenario, index == 0))
		}
		html.append('      </div>\n')
		html.append('    </div>\n')

		html.append('    <div id="charts-sidebar-block" class="hidden">\n')
		html.append(buildChartsSidebar(view))
		html.append('    </div>\n')

		html.append('  </aside>\n')

		html.append('  <main class="content">\n')
		view.scenarios.eachWithIndex { Map scenario, int index ->
			html.append(buildScenarioPanel(scenario, view, index == 0))
		}
		html.append(buildChartsPanel(view))
		html.append('  </main>\n')

		html.append('</div>\n')
		html.append(buildScripts())
		html.append('</body>\n')
		html.append('</html>\n')

		return html.toString()
	}
