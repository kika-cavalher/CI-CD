if "%LIVE_LOG_WINDOW_TITLE%"=="" (
    set "LIVE_LOG_WINDOW_TITLE=eMatch Live Log"
)

if "%BROWSER_TYPE%"=="" (
    set "BROWSER_TYPE=Windows"
