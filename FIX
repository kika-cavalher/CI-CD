	private String buildMetaChip(String label, String value, String type) {
		StringBuilder sb = new StringBuilder()
		sb.append('<div class="meta-chip ')
		sb.append(htmlEscape(type))
		sb.append('">')
		sb.append('<span class="meta-label">')
		sb.append(htmlEscape(label))
		sb.append(':</span> ')
		sb.append('<span class="meta-value">')
		sb.append(htmlEscape(value))
		sb.append('</span>')
		sb.append('</div>')
		return sb.toString()
	}

	private String buildCollapsedError(String fullError, String visualError, String scenarioName) {
		List<String> lines = safeValue(fullError)
				.readLines()
				.collect { safeValue(it) }
				.findAll { String line -> !line.isEmpty() }

		if (lines.isEmpty()) {
			lines = safeValue(visualError)
					.readLines()
					.collect { safeValue(it) }
					.findAll { String line -> !line.isEmpty() }
		}

		if (lines.isEmpty()) {
			return safeValue(scenarioName) + ' FAILED.'
		}

		return lines.take(2).join('\n')
	}

