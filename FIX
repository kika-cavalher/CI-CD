/*
 * Dedicated Jenkins pipeline for Archive Mode build.
 * Runs Windows Scheduled Tasks (WinAppDriver + eMatch task) and waits until it finishes.
 * Does NOT use custom Groovy libraries to avoid Jenkins DSL method errors.
 */

def AGENT_LABEL = 'GI5_SWDCFRNXGI55817'

def TASK_WINDRIVER = 'startWinDriver'
def TASK_EMATCH   = '\\eMatch Automation\\RunEMatchDesktop'

def PIPELINE_TIMEOUT_MIN = 180
def POLL_SECONDS = 5

node(AGENT_LABEL) {
  timestamps {
    ansiColor('xterm') {

      timeout(time: PIPELINE_TIMEOUT_MIN, unit: 'MINUTES') {

        stage('Checkout') {
          checkout scm
        }

        stage('Prepare Artifacts') {
          // Ensure workspace exists and create Reports folder placeholder
          bat """
            echo ============================================================
            echo PREPARE ARTIFACTS
            echo WORKSPACE: %CD%
            if not exist "Reports" mkdir "Reports"
            echo ============================================================
          """
        }

        stage('Run Test Assets') {
          echo "============================================================"
          echo "START ASSET: Archive Mode Collection"
          echo "TASK: ${TASK_EMATCH}"
          echo "============================================================"

          bat """
            @echo off
            setlocal EnableExtensions EnableDelayedExpansion

            echo ------------------------------------------------------------
            echo VALIDATING SCHEDULED TASKS
            echo ------------------------------------------------------------

            schtasks /query /tn "${TASK_WINDRIVER}" >nul 2>nul
            if errorlevel 1 (
              echo [ERROR] Task not found: ${TASK_WINDRIVER}
              exit /b 2
            )

            schtasks /query /tn "${TASK_EMATCH}" >nul 2>nul
            if errorlevel 1 (
              echo [ERROR] Task not found: ${TASK_EMATCH}
              exit /b 3
            )

            echo [OK] Support files and scheduled tasks found
            echo ------------------------------------------------------------

            echo STARTING WINDRIVER TASK: ${TASK_WINDRIVER}
            schtasks /run /tn "${TASK_WINDRIVER}"
            if errorlevel 1 (
              echo [ERROR] Failed to start task: ${TASK_WINDRIVER}
              exit /b 4
            )

            echo STARTING DESKTOP TASK: ${TASK_EMATCH}
            schtasks /run /tn "${TASK_EMATCH}"
            if errorlevel 1 (
              echo [ERROR] Failed to start task: ${TASK_EMATCH}
              schtasks /end /tn "${TASK_WINDRIVER}" >nul 2>nul
              exit /b 5
            )

            echo WAITING DESKTOP TASK TO FINISH: ${TASK_EMATCH}

            :loop
            for /f "tokens=2 delims=: " %%f in ('schtasks /query /tn "${TASK_EMATCH}" /fo list ^| find "Status:"') do (
              set STATUS=%%f
            )

            if /I "!STATUS!"=="Running" (
              ping -n ${POLL_SECONDS} localhost >nul 2>nul
              goto loop
            )

            echo DESKTOP TASK FINISHED. STATUS=!STATUS!
            echo STOPPING WINDRIVER TASK: ${TASK_WINDRIVER}
            schtasks /end /tn "${TASK_WINDRIVER}" >nul 2>nul

            exit /b 0
          """
        }

        stage('Collect Reports') {
          catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
            junit allowEmptyResults: true, testResults: 'Reports/**/JUnit_Report.xml'
          }

          catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
            archiveArtifacts allowEmptyArchive: true, artifacts: 'Reports/**/*'
          }
        }

        stage('Trigger Next Job') {
          echo "Triggering next Jenkins job: Passerelle Bilan"
          build job: 'Passerelle Bilan', wait: false
        }
      }
    }
  }
}
