package commands

import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import java.awt.Robot
import java.awt.Toolkit
import java.awt.datatransfer.StringSelection
import java.awt.event.InputEvent
import java.awt.event.KeyEvent

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.testobject.WindowsTestObject.LocatorStrategy
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.driver.WindowsDriverFactory
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows
import com.kms.katalon.core.windows.keyword.helper.WindowsActionHelper

class MenuNavigator {

	private ImageLoader imageLoader = new ImageLoader()

	@Keyword
	def searchAndOpenMenu(String menuName, String imageGroup, String expectedObjectPath, int timeoutSeconds) {
		int effectiveTimeout = timeoutSeconds <= 0 ? 60 : timeoutSeconds

		KeywordUtil.logInfo(
			'Searching and opening menu.\n' +
			'Menu name: ' + menuName + '\n' +
			'Image group: ' + imageGroup + '\n' +
			'Expected tab: ' + expectedObjectPath + '\n' +
			'Timeout: ' + effectiveTimeout + ' seconds'
		)

		imageLoader.validateGroupImagesExist(imageGroup)

		WindowsTestObject searchBox = resolveSearchBox()

		clickElementCenterByCoordinates(searchBox)
		Windows.delay(1)

		clearFocusedField()
		pasteText(menuName)
		Windows.delay(2)

		Map<String, String> images = imageLoader.getImages(imageGroup)

		boolean clickedAtLeastOnce = false
		int elapsedSeconds = 0

		while (elapsedSeconds < effectiveTimeout) {
			for (String imageKey : images.keySet()) {
				String imagePath = images[imageKey]

				try {
					def imageFound = WindowsImageKeywords.findImage(imagePath)

					if (imageFound != null && imageFound != false) {
						KeywordUtil.logInfo(
							'Menu image found.\n' +
							'Image key: ' + imageKey + '\n' +
							'Image path: ' + imagePath + '\n' +
							'Elapsed seconds: ' + elapsedSeconds
						)

						try {
							WindowsImageKeywords.clickImage(imagePath)
							clickedAtLeastOnce = true

							KeywordUtil.logInfo(
								'Single click executed on menu image.\n' +
								'Image key: ' + imageKey
							)

							Windows.delay(3)

							if (isOpenedMenuTabVisible(expectedObjectPath, 20)) {
								KeywordUtil.logInfo(
									'Menu tab opened successfully after single click.\n' +
									'Expected tab: ' + expectedObjectPath
								)
								return true
							}
						} catch (Exception clickError) {
							KeywordUtil.logInfo(
								'Single click failed on menu image.\n' +
								'Image key: ' + imageKey + '\n' +
								'Reason: ' + clickError.getMessage()
							)
						}

						try {
							WindowsImageKeywords.doubleClickImage(imagePath)
							clickedAtLeastOnce = true

							KeywordUtil.logInfo(
								'Double click executed on menu image.\n' +
								'Image key: ' + imageKey
							)

							Windows.delay(5)

							if (isOpenedMenuTabVisible(expectedObjectPath, 20)) {
								KeywordUtil.logInfo(
									'Menu tab opened successfully after double click.\n' +
									'Expected tab: ' + expectedObjectPath
								)
								return true
							}
						} catch (Exception doubleClickError) {
							KeywordUtil.logInfo(
								'Double click failed on menu image.\n' +
								'Image key: ' + imageKey + '\n' +
								'Reason: ' + doubleClickError.getMessage()
							)
						}

						KeywordUtil.logInfo(
							'Menu image was found and click was attempted, but expected tab is not open yet.\n' +
							'Expected tab: ' + expectedObjectPath
						)
					}
				} catch (Exception imageError) {
					KeywordUtil.logInfo(
						'Image search attempt failed.\n' +
						'Image key: ' + imageKey + '\n' +
						'Elapsed seconds: ' + elapsedSeconds + '\n' +
						'Reason: ' + imageError.getMessage()
					)
				}
			}

			if (elapsedSeconds == 0 || elapsedSeconds % 5 == 0) {
				KeywordUtil.logInfo(
					'Still waiting for menu image and opened tab.\n' +
					'Image group: ' + imageGroup + '\n' +
					'Expected tab: ' + expectedObjectPath + '\n' +
					'Elapsed seconds: ' + elapsedSeconds + '/' + effectiveTimeout
				)
			}

			Windows.delay(1)
			elapsedSeconds = elapsedSeconds + 1
		}

		takeEvidence('MenuNotOpened.png')

		if (!clickedAtLeastOnce) {
			KeywordUtil.markFailedAndStop(
				'Menu image was never clicked.\n' +
				'Menu name: ' + menuName + '\n' +
				'Image group: ' + imageGroup + '\n' +
				'Expected tab: ' + expectedObjectPath + '\n' +
				'Timeout: ' + effectiveTimeout + ' seconds'
			)
		}

		KeywordUtil.markFailedAndStop(
			'Menu image was clicked, but the expected tab did not open.\n' +
			'Menu name: ' + menuName + '\n' +
			'Image group: ' + imageGroup + '\n' +
			'Expected tab: ' + expectedObjectPath + '\n' +
			'Timeout: ' + effectiveTimeout + ' seconds'
		)

		return false
	}

	private boolean isOpenedMenuTabVisible(String expectedObjectPath, int timeoutSeconds) {
		String cleanPath = expectedObjectPath
			.replace('Object Repository/', '')
			.replace('Object Repository\\', '')

		try {
			WindowsTestObject openedMenuTab = findWindowsObject(cleanPath)

			boolean isPresent = Windows.verifyElementPresent(
				openedMenuTab,
				timeoutSeconds,
				FailureHandling.OPTIONAL
			)

			if (isPresent) {
				KeywordUtil.logInfo('Opened menu tab is visible: ' + cleanPath)
				return true
			}

			KeywordUtil.logInfo('Opened menu tab is not visible yet: ' + cleanPath)
			return false
		} catch (Exception e) {
			KeywordUtil.logInfo(
				'Opened menu tab validation failed.\n' +
				'Tab object: ' + cleanPath + '\n' +
				'Reason: ' + e.getMessage()
			)
			return false
		}
	}

	private WindowsTestObject resolveSearchBox() {
		List<WindowsTestObject> candidates = []

		try {
			candidates.add(findWindowsObject('General/txtSearch'))
		} catch (Exception ignored) {
		}

		candidates.add(buildXpathObject("//*[contains(@Name,'Type keywords here')]"))
		candidates.add(buildXpathObject("//*[contains(@Name,'Type keywords')]"))
		candidates.add(buildXpathObject("//*[@LocalizedControlType='combo box' and contains(@Name,'Type')]"))
		candidates.add(buildXpathObject("//*[@LocalizedControlType='edit' and contains(@Name,'Type')]"))
		candidates.add(buildXpathObject("//*[contains(@ClassName,'ComboBox') and contains(@Name,'Type')]"))

		for (WindowsTestObject candidate : candidates) {
			try {
				boolean isPresent = Windows.verifyElementPresent(
					candidate,
					2,
					FailureHandling.OPTIONAL
				)

				if (isPresent) {
					KeywordUtil.logInfo('Search field found.')
					return candidate
				}
			} catch (Exception ignored) {
			}
		}

		takeEvidence('SearchFieldNotFound.png')

		KeywordUtil.markFailedAndStop(
			'Search field was not found.\n' +
			'Tried Object Repository: General/txtSearch\n' +
			'Tried dynamic XPath fallback candidates.'
		)

		return null
	}

	private WindowsTestObject buildXpathObject(String xpath) {
		WindowsTestObject object = new WindowsTestObject()
		object.setLocatorStrategy(LocatorStrategy.XPATH)
		object.setLocator(xpath)
		return object
	}

	private void clickElementCenterByCoordinates(WindowsTestObject object) {
		def rect = Windows.getElementRect(object)

		int x = rect.getX() + Math.floor(rect.getWidth() / 2).intValue()
		int y = rect.getY() + Math.floor(getSafeHeight(rect) / 2).intValue()

		mouseClick(x, y)
	}

	private void clearFocusedField() {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_CONTROL)

		Windows.delay(1)

		robot.keyPress(KeyEvent.VK_BACK_SPACE)
		robot.keyRelease(KeyEvent.VK_BACK_SPACE)
	}

	private void pasteText(String text) {
		StringSelection selection = new StringSelection(text)
		Toolkit.getDefaultToolkit().getSystemClipboard().setContents(selection, null)

		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_V)
		robot.keyRelease(KeyEvent.VK_V)
		robot.keyRelease(KeyEvent.VK_CONTROL)

		Windows.delay(1)
	}

	private void mouseClick(int x, int y) {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.mouseMove(x, y)
		Windows.delay(1)

		robot.mousePress(InputEvent.BUTTON1_DOWN_MASK)
		Windows.delay(1)
		robot.mouseRelease(InputEvent.BUTTON1_DOWN_MASK)

		Windows.delay(1)
	}

	private int getSafeHeight(def rect) {
		int height = rect.getHeight()

		if (height <= 0) {
			return 20
		}

		return height
	}

	private void takeEvidence(String fileName) {
		try {
			String evidenceDir = RunConfiguration.getReportFolder() + '\\Evidences\\'
			new File(evidenceDir).mkdirs()

			WindowsActionHelper
				.create(WindowsDriverFactory.getWindowsSession())
				.takeScreenshot(evidenceDir + fileName)

			KeywordUtil.logInfo('Evidence captured: ' + evidenceDir + fileName)
		} catch (Exception e) {
			KeywordUtil.logInfo('Could not capture evidence: ' + e.getMessage())
		}
	}
}
