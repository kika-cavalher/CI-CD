    private String buildScenarioSidebarItem(Map scenario) {
        String summary = scenario.showDetailLink ? safeValue(scenario.errorSummary) : ''
        String shortSummary = ellipsis(summary, 68)

        StringBuilder block = new StringBuilder()
        block.append('<button type="button" class="scenario-item" data-scenario-id="')
        block.append(htmlEscape(scenario.id))
        block.append('" data-search="')
        block.append(htmlEscape((safeValue(scenario.name) + ' ' + safeValue(summary) + ' ' + safeValue(scenario.status)).toLowerCase(Locale.ENGLISH)))
        block.append('" onclick="showScenario(\'')
        block.append(jsEscape(scenario.id))
        block.append('\')">\n')

        block.append('<div class="scenario-item-leftbar"></div>\n')

        block.append('<div class="scenario-item-main">\n')
        block.append('<div class="scenario-item-toprow">\n')
        block.append('<div class="scenario-item-title" title="')
        block.append(htmlEscape(scenario.name))
        block.append('">')
        block.append(htmlEscape(ellipsis(scenario.name, 44)))
        block.append('</div>\n')
        block.append('<span class="status-badge status-')
        block.append(htmlEscape(scenario.status))
        block.append('">')
        block.append(htmlEscape(capitalize(scenario.status)))
        block.append('</span>\n')
        block.append('</div>\n')

        if (!isBlank(shortSummary)) {
            block.append('<div class="scenario-item-summary" title="')
            block.append(htmlEscape(summary))
            block.append('">')
            block.append(htmlEscape(shortSummary))
            block.append('</div>\n')
        }

        block.append('<div class="scenario-item-meta">\n')
        block.append('<span>')
        block.append(htmlEscape(safeValue(scenario.listTime)))
        block.append('</span>\n')
        block.append('<span>')
        block.append(htmlEscape(safeValue(scenario.listDuration)))
        block.append('</span>\n')
        block.append('</div>\n')
        block.append('</div>\n')
        block.append('</button>\n')

        return block.toString()
    }

    private String buildScenarioPanel(Map scenario, String reportSuiteName, boolean active) {
        String panelClass = active ? 'scenario-panel active' : 'scenario-panel'
        String detailLink = scenario.showDetailLink
            ? '<a class="scenario-detail-link" href="#error-' + htmlEscape(scenario.id) + '" onclick="openErrorCard(\'' + jsEscape(scenario.id) + '\');return false;">🔎 View full detail</a>'
            : ''

        StringBuilder html = new StringBuilder()

        html.append('<section class="')
        html.append(panelClass)
        html.append('" id="panel-')
        html.append(htmlEscape(scenario.id))
        html.append('" data-scenario-panel="')
        html.append(htmlEscape(scenario.id))
        html.append('">\n')

        html.append('<div class="scenario-header">\n')
        html.append('<div class="scenario-name">')
        html.append(htmlEscape(scenario.name))
        html.append('</div>\n')

        if (!isBlank(detailLink)) {
            html.append('<div class="scenario-detail-link-wrap">')
            html.append(detailLink)
            html.append('</div>\n')
        }

        html.append('<div class="scenario-meta-row">\n')
        html.append(buildMetaPill('Suite', reportSuiteName, 'meta-pill neutral'))
        html.append(buildMetaPill('Status', capitalize(scenario.status), 'meta-pill status-pill status-' + safeValue(scenario.status)))
        html.append(buildMetaPill('Start', safeValue(scenario.startClock), 'meta-pill gradient-pill'))
        html.append(buildMetaPill('End', safeValue(scenario.endClock), 'meta-pill gradient-pill'))
        html.append(buildMetaPill('Duration', safeValue(scenario.durationLabel), 'meta-pill dark-pill'))
        html.append('</div>\n')
        html.append('</div>\n')

        html.append('<div class="steps-title">Steps</div>\n')
        html.append('<div class="steps-table">\n')
        html.append('<div class="steps-head">\n')
        html.append('<div class="steps-col status-col">STATUS</div>\n')
        html.append('<div class="steps-col time-col">TIMESTAMP</div>\n')
        html.append('<div class="steps-col detail-col">DETAILS</div>\n')
        html.append('</div>\n')

        if (scenario.steps instanceof Collection && !scenario.steps.isEmpty()) {
            scenario.steps.each { Map step ->
                html.append(buildStepRow(step))
            }
        } else {
            html.append('<div class="step-row empty-row"><div class="steps-col detail-col only-detail">No step data available.</div></div>\n')
        }

        html.append('</div>\n')

        if (safeValue(scenario.status) == 'failed') {
            html.append(buildErrorCard(scenario))
        }

        if (scenario.evidences instanceof Collection && !scenario.evidences.isEmpty()) {
            html.append(buildEvidenceCard(scenario))
        }

        html.append('</section>\n')

        return html.toString()
    }

    private String buildStepRow(Map step) {
        StringBuilder row = new StringBuilder()
        row.append('<div class="step-row">\n')

        row.append('<div class="steps-col status-col">\n')
        row.append('<span class="status-badge status-')
        row.append(htmlEscape(step.status))
        row.append('">')
        row.append(htmlEscape(capitalize(step.status)))
        row.append('</span>\n')
        row.append('</div>\n')

        row.append('<div class="steps-col time-col">')
        row.append(htmlEscape(step.timestamp))
        row.append('</div>\n')

        row.append('<div class="steps-col detail-col">\n')
        row.append('<span class="step-icon">')
        row.append(htmlEscape(step.icon))
        row.append('</span>\n')
        row.append('<span class="step-text" title="')
        row.append(htmlEscape(step.detail))
        row.append('">')
        row.append(htmlEscape(ellipsis(step.detail, 118)))
        row.append('</span>\n')
        row.append('</div>\n')

        row.append('</div>\n')
        return row.toString()
    }

    private String buildErrorCard(Map scenario) {
        String errorSummary = firstNonBlank(
            scenario.errorSummary,
            extractUnableToMessage(scenario.errorLog),
            'Failed scenario'
        )

        StringBuilder card = new StringBuilder()
        card.append('<section class="info-card error-card" id="error-')
        card.append(htmlEscape(scenario.id))
        card.append('">\n')
        card.append('<div class="info-card-title">Visual Error Log</div>\n')
        card.append('<div class="info-card-summary">')
        card.append(htmlEscape(errorSummary))
        card.append('</div>\n')
        card.append('<details class="expand-block error-details">\n')
        card.append('<summary>🔎 View full error</summary>\n')
        card.append('<pre>')
        card.append(htmlEscape(safeValue(scenario.errorLog)))
        card.append('</pre>\n')
        card.append('</details>\n')
        card.append('</section>\n')
        return card.toString()
    }

    private String buildEvidenceCard(Map scenario) {
        StringBuilder block = new StringBuilder()
        block.append('<section class="info-card evidence-card">\n')
        block.append('<div class="info-card-title">Evidence</div>\n')

        scenario.evidences.eachWithIndex { Map ev, int idx ->
            block.append('<details class="expand-block evidence-item"')
            if (idx == 0) {
                block.append(' open')
            }
            block.append('>\n')
            block.append('<summary>📎 ')
            block.append(htmlEscape(safeValue(ev.name)))
            block.append('</summary>\n')
            block.append('<div class="evidence-body">\n')
            block.append('<a class="evidence-link" href="')
            block.append(htmlEscape(safeValue(ev.href)))
            block.append('" target="_blank">🔎 Open evidence</a>\n')

            if (ev.isImage) {
                block.append('<div class="evidence-image-wrap">\n')
                block.append('<img class="evidence-image" src="')
                block.append(htmlEscape(safeValue(ev.href)))
                block.append('" alt="Evidence" loading="lazy">\n')
                block.append('</div>\n')
            }

            block.append('</div>\n')
            block.append('</details>\n')
        }

        block.append('</section>\n')
        return block.toString()
    }

    private String buildChartsPanel(Map summary) {
        int total = summary.total as int
        int passed = summary.passed as int
        int failed = summary.failed as int
        int skipped = summary.skipped as int

        double totalSafe = total > 0 ? total : 1
        double passPct = round1((passed * 100d) / totalSafe)
        double failPct = round1((failed * 100d) / totalSafe)
        double skipPct = round1((skipped * 100d) / totalSafe)

        String donutStyle = 'background: conic-gradient(' +
            COLOR_PASS + ' 0 ' + passPct + '%, ' +
            COLOR_FAIL + ' ' + passPct + '% ' + (passPct + failPct) + '%, ' +
            COLOR_SKIP + ' ' + (passPct + failPct) + '% 100%);'

        StringBuilder html = new StringBuilder()

        html.append('<div class="charts-layout">\n')
        html.append('<div class="chart-card donut-card">\n')
        html.append('<div class="chart-title">Global Overview</div>\n')
        html.append('<div class="donut-wrap">\n')
        html.append('<div class="donut-chart" style="')
        html.append(donutStyle)
        html.append('">\n')
        html.append('<div class="donut-inner">\n')
        html.append('<div class="donut-total">')
        html.append(String.valueOf(total))
        html.append('</div>\n')
        html.append('<div class="donut-label">Tests</div>\n')
        html.append('</div>\n')
        html.append('</div>\n')
        html.append('</div>\n')
        html.append('</div>\n')

        html.append('<div class="chart-card status-card">\n')
        html.append('<div class="chart-title">Execution Status</div>\n')
        html.append(buildChartStatusRow('Passed', passed, passPct, COLOR_PASS))
        html.append(buildChartStatusRow('Failed', failed, failPct, COLOR_FAIL))
        html.append(buildChartStatusRow('Skipped', skipped, skipPct, COLOR_SKIP))
        html.append('</div>\n')
        html.append('</div>\n')

        return html.toString()
    }

    private String buildChartStatusRow(String label, int value, double pct, String color) {
        StringBuilder row = new StringBuilder()
        row.append('<div class="chart-status-row">\n')
        row.append('<div class="chart-status-top">\n')
        row.append('<span class="chart-status-name">')
        row.append(htmlEscape(label))
        row.append('</span>\n')
        row.append('<span class="chart-status-value">')
        row.append(String.valueOf(value))
        row.append('</span>\n')
        row.append('</div>\n')
        row.append('<div class="chart-status-bar">\n')
        row.append('<div class="chart-status-fill" style="width:')
        row.append(String.valueOf(Math.max(pct, value > 0 ? 2 : 0)))
        row.append('%;background:')
        row.append(color)
        row.append(';"></div>\n')
        row.append('</div>\n')
        row.append('<div class="chart-status-foot">')
        row.append(((int) Math.round(pct)).toString())
        row.append('% of execution</div>\n')
        row.append('</div>\n')
        return row.toString()
    }

    private String buildSidebarStatusLine(String label, int value, String color) {
        StringBuilder line = new StringBuilder()
        line.append('<div class="sidebar-status-line">\n')
        line.append('<div class="sidebar-status-left">\n')
        line.append('<span class="sidebar-status-dot" style="background:')
        line.append(color)
        line.append(';"></span>\n')
        line.append('<span class="sidebar-status-label">')
        line.append(htmlEscape(label))
        line.append('</span>\n')
        line.append('</div>\n')
        line.append('<span class="sidebar-status-value">')
        line.append(String.valueOf(value))
        line.append('</span>\n')
        line.append('</div>\n')
        return line.toString()
    }

    private String buildMetaPill(String label, String value, String cssClass) {
        StringBuilder pill = new StringBuilder()
        pill.append('<span class="')
        pill.append(cssClass)
        pill.append('"><strong>')
        pill.append(htmlEscape(label))
        pill.append(':</strong> ')
        pill.append(htmlEscape(value))
        pill.append('</span>')
        return pill.toString()
    }

