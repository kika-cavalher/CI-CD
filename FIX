                    </div>
                    <div class="summary-card">
                        <div class="summary-card-label">Failed</div>
                        <div class="summary-card-value" style="color:var(--fail)">${failed}</div>
                        <div class="summary-card-bar"><span style="width:${failedPct}%;background:var(--fail)"></span></div>
                    </div>
                    <div class="summary-card">
                        <div class="summary-card-label">Skipped</div>
                        <div class="summary-card-value" style="color:var(--skip)">${skipped}</div>
                        <div class="summary-card-bar"><span style="width:${skippedPct}%;background:var(--skip)"></span></div>
                    </div>
                </div>

                <div class="panel" style="padding:18px;">
                    <div class="section-title" style="margin-top:0;">Global Overview</div>
                    <div class="meta-pills" style="margin-bottom:0;">
                        ${buildMetaPill('Suite', REPORT_MODEL.suiteName || '', '')}
                        ${buildMetaPill('Start', REPORT_MODEL.startText || '', '')}
                        ${buildMetaPill('End', REPORT_MODEL.endText || '', '')}
                        ${buildMetaPill('Duration', REPORT_MODEL.durationText || '', '')}
                    </div>
                </div>
            </div>

            <div class="overview-donut-wrap">
                <div class="donut-card">
                    <div class="donut" style="background:${donutBackground};">
                        <div class="donut-center">
                            <div class="donut-total">${total}</div>
                            <div class="donut-label">Tests</div>
                        </div>
                    </div>

                    <div class="legend">
                        <div class="legend-row">
                            <div class="legend-left"><span class="legend-dot" style="background:var(--pass)"></span><span>Passed</span></div>
                            <strong>${passed}</strong>
                        </div>
                        <div class="legend-row">
                            <div class="legend-left"><span class="legend-dot" style="background:var(--fail)"></span><span>Failed</span></div>
                            <strong>${failed}</strong>
                        </div>
                        <div class="legend-row">
                            <div class="legend-left"><span class="legend-dot" style="background:var(--skip)"></span><span>Skipped</span></div>
                            <strong>${skipped}</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    `;
}

function renderCurrentView(){
    const testsView = document.getElementById('tests-view');
    const chartsView = document.getElementById('charts-view');
    const tabTests = document.getElementById('tab-tests');
    const tabCharts = document.getElementById('tab-charts');

    if(currentMode === 'tests'){
        testsView.classList.remove('hidden');
        chartsView.classList.add('hidden');
        tabTests.classList.add('active');
        tabCharts.classList.remove('active');
        renderTestsView();
    }else{
        chartsView.classList.remove('hidden');
        testsView.classList.add('hidden');
        tabCharts.classList.add('active');
        tabTests.classList.remove('active');
        renderChartsView();
    }
}

function toggleBlock(id){
    const el = document.getElementById(id);
    if(!el){
        return;
    }

    if(el.style.display === 'block'){
        el.style.display = 'none';
    }else{
        el.style.display = 'block';
    }
}

document.getElementById('tab-tests').addEventListener('click', function(){
    currentMode = 'tests';
    renderCurrentView();
});

document.getElementById('tab-charts').addEventListener('click', function(){
    currentMode = 'charts';
    renderCurrentView();
});

document.getElementById('case-search').addEventListener('input', function(e){
    currentSearch = e.target.value || '';
    currentCaseIndex = 0;
    buildCaseList();
    renderCurrentView();
});

buildCaseList();
renderCurrentView();
