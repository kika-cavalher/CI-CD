package search

import internal.GlobalVariable

class SearchKeyword {

    // Key -> GlobalVariable name
    static final Map<String, String> GLOBAL_VALUE_BY_LABEL = [
        "Computation ID": "computationID"
        // Add more if needed:
        // "Comment": "comment"
        // "Closing Date": "closingDate"
    ]

    // Returns feature value OR GlobalVariable fallback
    static String resolveValue(String key, String featureValue) {

        String value = featureValue == null ? "" : featureValue.trim()

        if (value == "" && GLOBAL_VALUE_BY_LABEL.containsKey(key)) {
            String gvName = GLOBAL_VALUE_BY_LABEL.get(key)
            value = GlobalVariable."$gvName"
        }

        return value == null ? "" : value.toString().trim()
    }
}


import search.SearchKeyword

@And("User makes a search for a {string}")
def search(String section, DataTable tb){

    GlobalVariable.section = section
    List<Map<String, String>> data = tb.asMaps()

    for (Map<String, String> map : data) {
        for (String key : map.keySet()) {

            // 🔹 NEW: resolve value using SearchKeyword logic
            String value = SearchKeyword.resolveValue(key, map.get(key))

            // Keep original behavior
            if (key.equalsIgnoreCase("Computation ID")) {
                GlobalVariable.computationID = value
            }
            else if (key.equalsIgnoreCase("Closing Date")) {
                commonKeyword.ClosingDate(key)
            }

            TestObject element = findTestObject(
                'Object Repository/Table/Common Input with Label',
                [('label'): key, ('type'): "input"]
            )

            // Keep original behavior
            if (key.equalsIgnoreCase("Closing Date")) {
                WebUI.click(element)
                commonKeyword.checkClosingDateDropdown()
            }

            WebUI.setText(element, value)

            TestObject firstResult = findTestObject('Object Repository/Common/FirstElement')

            try {
                WebUI.delay(5)
                String elementText = WebUI.getText(firstResult)
                if (elementText.contains(value)) {
                    WebUI.click(firstResult)
                }
            } catch (Exception e) {
                KeywordUtil.logInfo("The '${key}': ${value}' was not found! Error: ${e.message}")
            }
        }
    }

    WebUI.click(findTestObject('Object Repository/Table/Common Button',[('title'): "Load"]))

    WebUI.takeScreenshot(
        RunConfiguration.getReportFolder() + "/search_for_${section}_${GlobalVariable.elementId}.png"
    )
}
