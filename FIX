				findHeader(
					sheet,
					'Source'
				)

			if (sourceHeader == null) {
				KeywordUtil.markFailedAndStop(
					'Column Source was not found in filtered export: ' +
						filteredFile.name
				)

				return [:]
			}

			DataFormatter formatter =
				new DataFormatter()

