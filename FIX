
package common

import static com.kms.katalon.core.testobject.ObjectRepository.findTestObject

import java.util.Arrays

import org.openqa.selenium.Keys

import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.TestObject
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI

import cucumber.api.java.en.And
import cucumber.api.java.en.Given
import cucumber.api.java.en.Then
import cucumber.api.java.en.When
import internal.GlobalVariable

class Navigation {

	private static final int DEFAULT_TIMEOUT = 60
	private static final int SHORT_TIMEOUT = 10

	@Given("Hue home is opened")
	def hueHomeIsOpenedStep() {
		verifyHueHomeOpened()
	}

	@When("user searches for the configured default database")
	def userSearchesForConfiguredDefaultDatabaseStep() {
		searchConfiguredDefaultDatabase()
	}

	@And("user selects the first database result")
	def userSelectsFirstDatabaseResultStep() {
		selectFirstDatabaseResult()
	}

	@Then("selected database title should be displayed")
	def selectedDatabaseTitleShouldBeDisplayedStep() {
		validateSelectedDatabaseTitle()
	}

	@Given("DEV default database menu is selected")
	def devDefaultDatabaseMenuIsSelectedStep() {
		KeywordUtil.logInfo("Starting full default database menu selection flow")

		verifyHueHomeOpened()
		searchConfiguredDefaultDatabase()
		selectFirstDatabaseResult()
		validateSelectedDatabaseTitle()

		KeywordUtil.logInfo("Default database menu selection flow completed successfully")
	}

	@Given("default database menu is selected")
	def defaultDatabaseMenuIsSelectedStep() {
		KeywordUtil.logInfo("Starting full default database menu selection flow")

		verifyHueHomeOpened()
		searchConfiguredDefaultDatabase()
		selectFirstDatabaseResult()
		validateSelectedDatabaseTitle()

		KeywordUtil.logInfo("Default database menu selection flow completed successfully")
	}

	private void verifyHueHomeOpened() {
		KeywordUtil.logInfo("Verifying Hue home is opened")

		WebUI.waitForPageLoad(DEFAULT_TIMEOUT)

		String currentUrl = WebUI.getUrl()
		KeywordUtil.logInfo("Current URL: " + currentUrl)

		if (!currentUrl.contains('/hue/')) {
			KeywordUtil.markFailedAndStop("Hue is not opened. Current URL: " + currentUrl)
		}

		KeywordUtil.logInfo("Hue home is opened")
	}

	private void searchConfiguredDefaultDatabase() {
		String databaseName = getExpectedDatabaseName()

		KeywordUtil.logInfo("Searching configured database: " + databaseName)

		WebUI.waitForElementVisible(
			findTestObject('Home/input_DatabaseSearch'),
			DEFAULT_TIMEOUT,
			FailureHandling.STOP_ON_FAILURE
		)

		WebUI.click(findTestObject('Home/input_DatabaseSearch'))

		clearDatabaseSearchInput()

		WebUI.sendKeys(
			findTestObject('Home/input_DatabaseSearch'),
			databaseName
		)

		WebUI.delay(1)

		WebUI.waitForElementPresent(
			findTestObject('Home/option_DatabaseByName'),
			DEFAULT_TIMEOUT,
			FailureHandling.STOP_ON_FAILURE
		)

		KeywordUtil.logInfo("Configured database was found in the result list")
	}

	private void selectFirstDatabaseResult() {
		KeywordUtil.logInfo("Selecting database result")

		WebUI.waitForElementPresent(
			findTestObject('Home/option_DatabaseByName'),
			DEFAULT_TIMEOUT,
			FailureHandling.STOP_ON_FAILURE
		)

		try {
			WebUI.waitForElementClickable(
				findTestObject('Home/option_DatabaseByName'),
				SHORT_TIMEOUT,
				FailureHandling.STOP_ON_FAILURE
			)

			WebUI.click(findTestObject('Home/option_DatabaseByName'))
		} catch (Exception e) {
			KeywordUtil.logInfo("Normal click failed. Trying JavaScript click.")

			WebUI.executeJavaScript(
				"arguments[0].click();",
				Arrays.asList(WebUI.findWebElement(findTestObject('Home/option_DatabaseByName'), DEFAULT_TIMEOUT))
			)
		}

		WebUI.delay(2)
		WebUI.waitForPageLoad(DEFAULT_TIMEOUT)

		KeywordUtil.logInfo("Database result was selected")
	}

	private void validateSelectedDatabaseTitle() {
		String expectedDatabase = getExpectedDatabaseName()

		KeywordUtil.logInfo("Validating selected database title")
		KeywordUtil.logInfo("Expected database: " + expectedDatabase)

		WebUI.waitForElementVisible(
			findTestObject('Home/title_SelectedDatabase'),
			DEFAULT_TIMEOUT,
			FailureHandling.STOP_ON_FAILURE
		)

		String actualTitle = WebUI.getAttribute(
			findTestObject('Home/title_SelectedDatabase'),
			'title'
		)

		if (actualTitle == null || actualTitle.trim().length() == 0) {
			actualTitle = WebUI.getText(findTestObject('Home/title_SelectedDatabase'))
		}

		actualTitle = actualTitle.trim()

		KeywordUtil.logInfo("Actual selected database title: " + actualTitle)

		if (!actualTitle.equals(expectedDatabase)) {
			KeywordUtil.markFailedAndStop(
				"Wrong selected database. Expected: " + expectedDatabase + " | Actual: " + actualTitle
			)
		}

		KeywordUtil.logInfo("Selected database title was validated successfully")
	}

	private void clearDatabaseSearchInput() {
		KeywordUtil.logInfo("Clearing database search input")

		TestObject searchInput = findTestObject('Home/input_DatabaseSearch')

		WebUI.sendKeys(searchInput, Keys.chord(Keys.CONTROL, 'a'))
		WebUI.sendKeys(searchInput, Keys.BACK_SPACE)

		WebUI.delay(1)
	}

	private String getExpectedDatabaseName() {
		String databaseName = GlobalVariable.EXPECTED_DATABASE == null ? '' : GlobalVariable.EXPECTED_DATABASE.toString().trim()

		if (databaseName.length() == 0) {
			KeywordUtil.markFailedAndStop("GlobalVariable.EXPECTED_DATABASE is empty")
		}

		return databaseName
	}
}






