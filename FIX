3) JenkinsDesktopPipelineRunner.groovy (reescrito inteiro ✅)

Este arquivo resolve teu erro anterior de PowerShell com here-string e também mantém tudo simples.

jenkinsIntegration/JenkinsDesktopPipelineRunner.groovy

def deleteIfExists(String path) {
  bat """@echo off
if exist "${path}" del /f /q "${path}"
exit /b 0
"""
}

def writeRunContextFile(String targetFile, Map ctx) {
  def lines = ctx.collect { k, v -> "${k}=${v}".toString() }.join("\r\n") + "\r\n"

  echo "Writing run-context.properties to: ${targetFile}"

  def ps = """
\$ErrorActionPreference = 'Stop'
\$p = '${targetFile.replace("'", "''")}'
\$dir = Split-Path -Parent \$p
if (!(Test-Path \$dir)) { New-Item -ItemType Directory -Force -Path \$dir | Out-Null }
Set-Content -Path \$p -Value @'
${lines}
'@ -Encoding ASCII
""".trim()

  writeFile file: 'write_ctx.ps1', text: ps, encoding: 'UTF-8'

  bat """@echo off
powershell -NoProfile -ExecutionPolicy Bypass -File "%CD%\\write_ctx.ps1"
exit /b %ERRORLEVEL%
"""
}

def runScheduledTaskAndWaitMarker(String taskName, String markerPath, int timeoutMinutes) {
  echo "Running Task Scheduler: ${taskName}"

  bat """@echo off
schtasks /run /tn "${taskName}"
if errorlevel 1 exit /b 1
exit /b 0
"""

  timeout(time: timeoutMinutes, unit: 'MINUTES') {
    echo "Waiting marker file: ${markerPath}"
    while (true) {
      if (fileExists(markerPath)) break
      sleep time: 3, unit: 'SECONDS'
    }
  }

  def ecText = readFile(markerPath).trim()
  int ec = 1
  try { ec = Integer.parseInt(ecText) } catch (ignored) { ec = 1 }

  echo "Desktop task finished. ExitCode=${ec}"
  return ec
}

return this
4) Jenkinsfile_ArchiveMode.groovy (reescrito inteiro ✅)

Pontos que eu corrigi aqui ✅

Força rodar no teu nó Windows real (troca o label para o teu node)
Sempre usa load (nada de new JenkinsDesktopPipelineRunner(...))
Marker fica no workspace do job, e o BAT escreve lá porque WORKSPACE vai no ctx

jenkinsPipelines/Jenkinsfile_ArchiveMode.groovy

pipeline {
  agent { label 'GIS_SWDCFRNXGI55817' }

  options {
    timestamps()
    ansiColor('xterm')
    disableConcurrentBuilds()
    timeout(time: 4, unit: 'HOURS')
  }

  stages {
    stage('Prepare Context') {
      steps {
        script {
          def runner = load 'jenkinsIntegration/JenkinsDesktopPipelineRunner.groovy'

          def CONFIG = [
            CTX_FILE        : 'D:\\Projects\\eMatchStarters\\run-context.properties',
            TASK_NAME       : '\\eMatch Automation\\RunEMatchDesktop',
            PROJECT_FILE    : 'eMatch POC.prj',
            KATALON_EXE      : 'C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0\\katalonc.exe',
            COLLECTION_PATH : 'Test Suites/Archive Mode/Archive Mode Collection',
            BROWSER_TYPE    : 'Windows',
            RETRY           : '0'
          ]

          def marker = "${env.WORKSPACE}\\Reports\\__jenkins_task_exitcode.txt"
          runner.deleteIfExists(marker)

          runner.writeRunContextFile(CONFIG.CTX_FILE, [
            WORKSPACE        : env.WORKSPACE,
            PROJECT_FILE     : CONFIG.PROJECT_FILE,
            KATALON_EXE       : CONFIG.KATALON_EXE,
            COLLECTION_PATH  : CONFIG.COLLECTION_PATH,
            BROWSER_TYPE     : CONFIG.BROWSER_TYPE,
            RETRY            : CONFIG.RETRY
          ])

          env.DESKTOP_TASK_NAME = CONFIG.TASK_NAME
          env.DESKTOP_MARKER    = marker
        }
      }
    }

    stage('Run Desktop') {
      steps {
        script {
          def runner = load 'jenkinsIntegration/JenkinsDesktopPipelineRunner.groovy'
          int ec = runner.runScheduledTaskAndWaitMarker(env.DESKTOP_TASK_NAME, env.DESKTOP_MARKER, 180)
          if (ec != 0) {
            error("Desktop execution failed. ExitCode=${ec}")
          }
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'Reports/**', allowEmptyArchive: true
    }
  }
}
