	}

	// ============================================================
	// FILE DISCOVERY
	// ============================================================

	String findXmlFile(String reportFolder) {
		if (isBlank(reportFolder)) {
			return ''
		}

		File root = new File(reportFolder)
		if (!root.exists() || !root.isDirectory()) {
			return ''
		}

		List<File> preferred = new ArrayList<File>()
		List<File> fallback = new ArrayList<File>()
		List<File> runtime = new ArrayList<File>()
		collectXmlFiles(root, preferred, fallback, runtime)

		if (!preferred.isEmpty()) {
			preferred.sort { a, b -> b.lastModified() <=> a.lastModified() }
			return preferred[0].absolutePath
		}

		if (!fallback.isEmpty()) {
			fallback.sort { a, b -> b.lastModified() <=> a.lastModified() }
			return fallback[0].absolutePath
		}

		if (!runtime.isEmpty()) {
			runtime.sort { a, b -> b.lastModified() <=> a.lastModified() }
			return runtime[0].absolutePath
		}

		return ''
	}

	void collectXmlFiles(File currentDir, List<File> preferred, List<File> fallback, List<File> runtime) {
		if (currentDir == null || !currentDir.exists() || !currentDir.isDirectory()) {
			return
		}

		File[] children = currentDir.listFiles()
		if (children == null || children.length == 0) {
			return
		}

		String primaryName = safe(PRIMARY_XML_FILE_NAME).toLowerCase(Locale.ENGLISH)
		String secondaryName = safe(SECONDARY_XML_FILE_NAME).toLowerCase(Locale.ENGLISH)
		String runtimeName = safe(RUNTIME_XML_FILE_NAME).toLowerCase(Locale.ENGLISH)

		for (File child : children) {
			if (child == null) {
				continue
			}

			if (child.isDirectory()) {
				collectXmlFiles(child, preferred, fallback, runtime)
				continue
			}

			String lowerName = safe(child.name).toLowerCase(Locale.ENGLISH)

			if (lowerName == primaryName) {
				preferred.add(child)
			} else if (lowerName == secondaryName) {
				fallback.add(child)
			} else if (lowerName == runtimeName) {
				runtime.add(child)
			}
		}
	}

	String waitForExistingXml(String reportFolder, long timeoutMillis) {
		long started = System.currentTimeMillis()

		while ((System.currentTimeMillis() - started) <= timeoutMillis) {
			String xmlPath = findXmlFile(reportFolder)
			if (!isBlank(xmlPath) && new File(xmlPath).exists()) {
				return xmlPath
			}

			try {
				Thread.sleep(WAIT_POLL_MS)
			} catch (Exception ignored) {
			}
		}

		return ''
	}

	String resolveXmlPathForImport(String reportFolder, String suiteName, JiraGaiaReportBuilder reportBuilder) {
		String existingXml = waitForExistingXml(reportFolder, WAIT_FINAL_XML_MS)
		if (!isBlank(existingXml)) {
			KeywordUtil.logInfo("Using existing XML file for Jira import: ${existingXml}")
			return existingXml
		}

		KeywordUtil.logInfo("Final JUnit XML not available yet. Creating runtime JUnit XML from execution log.")

		String runtimeXml = reportBuilder.createRuntimeJUnitXmlFromKatalonLog(reportFolder, suiteName)
		if (!isBlank(runtimeXml) && new File(runtimeXml).exists()) {
			KeywordUtil.logInfo("Runtime JUnit XML created successfully: ${runtimeXml}")
			return runtimeXml
		}

		return ''
	}

	// ============================================================
	// XML AND SCREENSHOTS
	// ============================================================

	boolean isVisualEvidence(File file) {
		if (file == null || !file.exists() || !file.isFile()) {
			return false
		}

		String lower = safe(file.name).toLowerCase(Locale.ENGLISH)
		return lower.endsWith('.png') ||
				lower.endsWith('.jpg') ||
				lower.endsWith('.jpeg') ||
				lower.endsWith('.webp') ||
				lower.endsWith('.gif') ||
				lower.endsWith('.bmp')
	}

	boolean shouldSkipVisualEvidence(File file) {
		if (!isVisualEvidence(file)) {
			return true
		}

		String path = safe(file.absolutePath).toLowerCase(Locale.ENGLISH)
		String separator = File.separator.toLowerCase(Locale.ENGLISH)

		if (path.contains(separator + 'requests' + separator)) return true
		if (path.contains(separator + 'videos' + separator)) return true
		if (path.endsWith(separator + safe(GAIA_REPORT_FILE_NAME).toLowerCase(Locale.ENGLISH))) return true

		return false
	}

	List<File> getEvidenceSearchRoots(String reportFolder) {
		List<File> roots = new ArrayList<File>()

		if (isBlank(reportFolder)) {
			return roots
		}

		File leaf = new File(reportFolder)
		if (leaf.exists() && leaf.isDirectory()) {
			roots.add(leaf)

			File leafEvidence = new File(leaf, EVIDENCE_FOLDER_NAME)
			if (leafEvidence.exists() && leafEvidence.isDirectory()) {
				roots.add(leafEvidence)
			}
		}

		File suiteFolder = leaf.parentFile
		if (suiteFolder != null && suiteFolder.exists() && suiteFolder.isDirectory()) {
			roots.add(suiteFolder)

			File suiteEvidence = new File(suiteFolder, EVIDENCE_FOLDER_NAME)
			if (suiteEvidence.exists() && suiteEvidence.isDirectory()) {
				roots.add(suiteEvidence)
			}
		}

		return roots.unique { File item -> item.absolutePath }
	}

	List<File> collectFailureImages(String reportFolder) {
		List<File> images = new ArrayList<File>()
		List<File> roots = getEvidenceSearchRoots(reportFolder)

		if (roots.isEmpty()) {
			return images
		}

		for (File root : roots) {
			collectFailureImagesRecursive(root, images)
		}

		Set<String> seen = new LinkedHashSet<String>()
		List<File> uniqueImages = new ArrayList<File>()

		for (File image : images) {
			if (image == null) {
				continue
			}

			String key = ''
			try {
				key = image.canonicalPath
			} catch (Exception ignored) {
				key = image.absolutePath
			}

			if (!seen.contains(key)) {
				seen.add(key)
				uniqueImages.add(image)
			}
		}

		uniqueImages.sort { a, b -> a.lastModified() <=> b.lastModified() }
		return uniqueImages
	}

	void collectFailureImagesRecursive(File currentDir, List<File> images) {
		if (currentDir == null || !currentDir.exists() || !currentDir.isDirectory()) {
			return
		}

		File[] children = currentDir.listFiles()
		if (children == null || children.length == 0) {
			return
		}

		for (File child : children) {
			if (child == null) {
				continue
			}

			if (child.isDirectory()) {
				collectFailureImagesRecursive(child, images)
				continue
			}

			if (!shouldSkipVisualEvidence(child)) {
				images.add(child)
			}
		}
	}

	// ============================================================
	// MAIN FLOW
	// ============================================================

	def jiraImport() {
		return jiraImport('')
	}

	def jiraImport(String epicKeyOverride) {
		if (!isBlank(epicKeyOverride)) {
			EPIC_KEY = safe(epicKeyOverride)
		}

		JiraGateway gateway = new JiraGateway(this)
		JiraTestPlanManager testPlanManager = new JiraTestPlanManager(this, gateway)
		JiraGaiaReportBuilder reportBuilder = new JiraGaiaReportBuilder(this)
		JiraExecutionPublisher executionPublisher = new JiraExecutionPublisher(this, gateway)

		gateway.validateRequiredConfiguration()

		KeywordUtil.logInfo("============================================================")
		KeywordUtil.logInfo("Starting Jira import flow")
		KeywordUtil.logInfo("============================================================")

		String reportFolder = getResolvedReportFolder()
		if (isBlank(reportFolder)) {
			KeywordUtil.markFailed("Report folder could not be resolved.")
			return
		}

		KeywordUtil.logInfo("Using report folder: ${reportFolder}")

		String suiteName = getCurrentSuiteName()
		if (isBlank(suiteName)) {
			KeywordUtil.markFailed("Suite name could not be resolved from report path.")
			return
		}

		KeywordUtil.logInfo("Suite name detected from report path: ${suiteName}")

		String executionSummary = getExecutionSummary()
		String testPlanSummary = getTestPlanName()

		KeywordUtil.logInfo("Execution title used: ${executionSummary}")
		KeywordUtil.logInfo("Test Plan title used: ${testPlanSummary}")

		List<File> collectedImages = collectFailureImages(reportFolder)
		KeywordUtil.logInfo("Failure images found: ${collectedImages.size()}")
		collectedImages.each { File img ->
			KeywordUtil.logInfo("Failure image candidate: ${img.absolutePath}")
		}

		String xmlPath = resolveXmlPathForImport(reportFolder, suiteName, reportBuilder)
		if (isBlank(xmlPath)) {
			KeywordUtil.markFailed("Runtime JUnit XML could not be created from execution log.")
			return
		}

		KeywordUtil.logInfo("XML file selected for Jira import: ${xmlPath}")

		String gaiaReportPath = reportBuilder.createGaiaHtmlReport(reportFolder, suiteName, xmlPath)
		if (isBlank(gaiaReportPath)) {
			KeywordUtil.markWarning("HTML report could not be created.")
		} else {
			KeywordUtil.logInfo("HTML report created: ${gaiaReportPath}")
		}

		String testPlanKey = testPlanManager.getOrCreateTestPlanKey()
		if (isBlank(testPlanKey) || testPlanKey.startsWith('ERROR')) {
			KeywordUtil.markFailed("Test Plan could not be created or resolved: ${testPlanKey}")
			return
		}

		Map executionResult = executionPublisher.publishExecution(xmlPath, executionSummary, testPlanKey)

		String executionKey = safe(executionResult.executionKey)
		if (isBlank(executionKey) || executionKey.startsWith('ERROR')) {
			KeywordUtil.markFailed("Execution import failed: ${executionKey}")
			return
		}

		KeywordUtil.logInfo("============================================================")
		KeywordUtil.logInfo("Jira import finished")
		KeywordUtil.logInfo("============================================================")
		KeywordUtil.logInfo("Execution key: ${executionKey}")
		KeywordUtil.logInfo("Execution title used: ${executionSummary}")
		KeywordUtil.logInfo("Test Plan key: ${testPlanKey}")
		KeywordUtil.logInfo("Test Plan title used: ${testPlanSummary}")
		KeywordUtil.logInfo("HTML report attachment status: ${executionResult.gaiaReportStatus}")
		KeywordUtil.logInfo("Evidences.zip attachment status: ${executionResult.evidencesStatus}")
		KeywordUtil.logInfo("Results.zip attachment status: ${executionResult.resultsStatus}")
		KeywordUtil.logInfo("Add execution to Test Plan status: ${executionResult.addExecutionStatus}")
		KeywordUtil.logInfo("Update Test Execution status: ${executionResult.updateExecutionStatus}")

		return executionKey
	}
}



















package jiraIntegration

import java.io.File
import java.nio.charset.StandardCharsets
import java.nio.file.Files
import java.nio.file.StandardCopyOption
import java.text.SimpleDateFormat
import java.util.Base64
import java.util.Date
import java.util.Locale

import groovy.util.XmlSlurper

class JiraGaiaReportBuilder {

	private static final String DEFAULT_REPORT_FILE_NAME = 'customReport.html'

	JiraFlowCoordinator flow

	JiraGaiaReportBuilder(JiraFlowCoordinator flow) {
		this.flow = flow
	}

	String createGaiaHtmlReport(String reportFolder, String suiteName, String xmlPath) {
		if (isBlank(reportFolder)) {
			return ''
		}

		File reportDir = new File(reportFolder)
		if (!reportDir.exists() || !reportDir.isDirectory()) {
			return ''
		}

		File nativeHtml = waitForNativeKatalonHtmlReport(reportDir, flow.WAIT_NATIVE_HTML_MS)
		if (nativeHtml != null && nativeHtml.exists()) {
			return copyNativeReportAsCustom(reportDir, nativeHtml)
		}

		List<Map> scenarios = parseExecutionLogScenarios(reportDir)

		if (scenarios.isEmpty() && !isBlank(xmlPath)) {
			scenarios = parseXmlCases(xmlPath)
		}

		if (scenarios.isEmpty()) {
			return ''
		}

		attachEvidenceToFailedScenarios(reportDir, scenarios)

		Map model = [
			appName          : flow.getAppDisplayName(),
			suiteName        : resolveSuiteName(reportDir, suiteName),
			reportTitle      : 'Test report - ' + resolveSuiteName(reportDir, suiteName),
			subtitle         : flow.getReportSubtitle(),
			generatedAt      : formatDisplayDate(new Date()),
			logoSrc          : resolveAssetUrl(reportDir, flow.getReportLogoRelativePath()),
			reportFolder     : reportDir.absolutePath,
			headerBackground : flow.getReportHeaderBackground(),
			accentColor      : flow.getReportAccentColor(),
			accentSoftColor  : flow.getReportAccentSoftColor(),
			infoColor        : flow.getReportInfoColor(),
			scenarios        : scenarios
		]

		String html = new JiraGaiaHtmlTemplateBuilder().build(model)

		File htmlFile = new File(reportDir, resolveReportFileName())
		htmlFile.setText(html, 'UTF-8')
		return htmlFile.absolutePath
	}

	String createRuntimeJUnitXmlFromKatalonLog(String reportFolder, String suiteName) {
		if (isBlank(reportFolder)) {
			return ''
		}

		File reportDir = new File(reportFolder)
		if (!reportDir.exists() || !reportDir.isDirectory()) {
			return ''
		}

		List<Map> scenarios = parseExecutionLogScenarios(reportDir)
		if (scenarios.isEmpty()) {
			return ''
		}

		int failures = scenarios.count { Map item -> safeValue(item.status) == 'failed' }
		int skipped = scenarios.count { Map item -> safeValue(item.status) == 'skipped' }

		long totalMillis = 0L
		scenarios.each { Map item ->
			totalMillis += toLong(item.durationMs)
		}

		String suiteLabel = resolveSuiteName(reportDir, suiteName)

		StringBuilder xml = new StringBuilder()
		xml.append('<?xml version="1.0" encoding="UTF-8"?>\n')
		xml.append('<testsuite')
		xml.append(' name="').append(escapeXml(suiteLabel)).append('"')
		xml.append(' tests="').append(String.valueOf(scenarios.size())).append('"')
		xml.append(' failures="').append(String.valueOf(failures)).append('"')
		xml.append(' skipped="').append(String.valueOf(skipped)).append('"')
		xml.append(' time="').append(String.format(Locale.ENGLISH, '%.3f', ((double) totalMillis / 1000d))).append('">\n')

		scenarios.each { Map scenario ->
			long durationMs = toLong(scenario.durationMs)
			if (durationMs <= 0L) {
				durationMs = 1000L
			}

			xml.append('  <testcase')
			xml.append(' classname="').append(escapeXml(suiteLabel)).append('"')
			xml.append(' name="').append(escapeXml(safeValue(scenario.title))).append('"')
			xml.append(' time="').append(String.format(Locale.ENGLISH, '%.3f', ((double) durationMs / 1000d))).append('"')

			String status = safeValue(scenario.status)

			if (status == 'passed' || status == 'info') {
				xml.append('/>\n')
			} else if (status == 'skipped') {
				xml.append('>\n')
				xml.append('    <skipped message="Skipped"/>\n')
				xml.append('  </testcase>\n')
			} else {
				String shortError = safeValue(scenario.errorShort)
				String fullError = safeValue(scenario.errorFull)

				xml.append('>\n')
				xml.append('    <failure message="').append(escapeXml(shortError)).append('"><![CDATA[')
				xml.append(fullError.replace(']]>', ']]]]><![CDATA[>'))
				xml.append(']]></failure>\n')
				xml.append('  </testcase>\n')
			}
		}

		xml.append('</testsuite>\n')

		File runtimeXml = new File(reportDir, 'JUnit_Report_Runtime.xml')
		runtimeXml.setText(xml.toString(), 'UTF-8')
		return runtimeXml.absolutePath
	}

	// =========================================================================
	// PRIMARY SOURCE: KATALON NATIVE HTML
	// =========================================================================

	private File waitForNativeKatalonHtmlReport(File reportDir, long timeoutMillis) {
		long started = System.currentTimeMillis()

		while ((System.currentTimeMillis() - started) <= timeoutMillis) {
			File nativeHtml = findNativeKatalonHtmlReport(reportDir)
			if (nativeHtml != null && nativeHtml.exists() && nativeHtml.length() > 0) {
				return nativeHtml
			}

			try {
				Thread.sleep(flow.WAIT_POLL_MS)
			} catch (Exception ignored) {
			}
		}

		return null
	}

	private File findNativeKatalonHtmlReport(File reportDir) {
		if (reportDir == null || !reportDir.exists() || !reportDir.isDirectory()) {
			return null
		}

		File[] files = reportDir.listFiles()
		if (files == null || files.length == 0) {
			return null
		}

		List<File> htmls = []

		for (File file : files) {
			if (file == null || !file.isFile()) {
				continue
			}

			String lower = safeValue(file.name).toLowerCase(Locale.ENGLISH)

			if (!lower.endsWith('.html')) {
				continue
			}

			if (lower == safeValue(flow.GAIA_REPORT_FILE_NAME).toLowerCase(Locale.ENGLISH)) {
				continue
			}

			if (lower == 'customreport.html') {
				continue
			}

			htmls.add(file)
		}

		if (htmls.isEmpty()) {
			return null
		}

		List<File> preferred = htmls.findAll { File item ->
			safeValue(item.name) ==~ /\d{8,}_\d{6}\.html/
		}

		if (!preferred.isEmpty()) {
			preferred.sort { a, b -> b.length() <=> a.length() ?: (b.lastModified() <=> a.lastModified()) }
			return preferred[0]
		}

		htmls.sort { a, b -> b.length() <=> a.length() ?: (b.lastModified() <=> a.lastModified()) }
		return htmls[0]
	}

	private String copyNativeReportAsCustom(File reportDir, File nativeHtml) {
		if (nativeHtml == null || !nativeHtml.exists()) {
			return ''
		}

		File target = new File(reportDir, resolveReportFileName())

		try {
			if (!target.canonicalPath.equalsIgnoreCase(nativeHtml.canonicalPath)) {
				Files.copy(nativeHtml.toPath(), target.toPath(), StandardCopyOption.REPLACE_EXISTING)
			}
			return target.absolutePath
		} catch (Exception ignored) {
			return nativeHtml.absolutePath
		}
	}

	// =========================================================================
	// SECONDARY SOURCE: EXECUTION LOG
	// =========================================================================

	private List<Map> parseExecutionLogScenarios(File reportDir) {
		File logFile = findExecutionLog(reportDir)
		if (logFile == null || !logFile.exists()) {
			return []
		}

		List<String> lines = readFileLines(logFile)
		if (lines.isEmpty()) {
			return []
		}

		List<Map> scenarios = []
		Map current = null

		for (String rawLine : lines) {
			String cleanLine = sanitizeLogLine(rawLine)
			if (isBlank(cleanLine)) {
				continue
			}

			String timeLabel = extractTimeLabel(rawLine)
			long timeMs = extractTimeMillis(rawLine)

			String startPath = extractStartTestCasePath(cleanLine)
			if (!isBlank(startPath)) {
				current = finalizeScenario(current)
				if (current != null && !shouldIgnoreTestCase(current.path)) {
					scenarios.add(current)
				}

				current = newScenarioMap(startPath)
				if (!isBlank(timeLabel)) {
					current.startLabel = timeLabel
				}
				if (timeMs > 0L) {
					current.startMillis = timeMs
				}
				continue
			}

			Map statusHit = extractFinishedStatus(cleanLine)
			if (statusHit != null) {
				String path = safeValue(statusHit.path)
				String status = safeValue(statusHit.status)

				if (current != null && safeValue(current.path).equalsIgnoreCase(path)) {
					current.status = status
					if (!isBlank(timeLabel)) {
						current.endLabel = timeLabel
					}
					if (timeMs > 0L) {
						current.endMillis = timeMs
					}
					current = finalizeScenario(current)
					if (current != null && !shouldIgnoreTestCase(current.path)) {
						scenarios.add(current)
					}
					current = null
				} else {
					Map detached = newScenarioMap(path)
					detached.status = status
					detached.startLabel = timeLabel
					detached.endLabel = timeLabel
					detached.startMillis = timeMs
					detached.endMillis = timeMs
					detached.durationMs = 1000L

					if (detached != null && !shouldIgnoreTestCase(detached.path)) {
						scenarios.add(finalizeScenario(detached))
					}
				}
				continue
			}

			if (current == null) {
				continue
			}

			Map step = extractStep(cleanLine, timeLabel)
			if (step != null) {
				current.steps.add(step)
				continue
			}

			if (looksLikeErrorLine(cleanLine)) {
				current.status = 'failed'
				current.errorLines.add(cleanLine)
				if (isBlank(current.errorShort)) {
					current.errorShort = extractShortError(cleanLine)
				}
				continue
			}

			if (!looksLikeNoiseLine(cleanLine)) {
				current.detailLines.add(cleanLine)
			}
		}

		current = finalizeScenario(current)
		if (current != null && !shouldIgnoreTestCase(current.path)) {
			scenarios.add(current)
		}

		return enrichScenarioDurations(scenarios)
	}

	private Map newScenarioMap(String path) {
		return [
			id         : 'scenario-' + UUID.randomUUID().toString(),
			path       : safeValue(path),
			title      : normalizeScenarioTitle(path),
			status     : 'passed',
			startLabel : '',
			endLabel   : '',
			startMillis: 0L,
			endMillis  : 0L,
			durationMs : 0L,
			errorShort : '',
			errorFull  : '',
			detailLines: [],
			errorLines : [],
			steps      : []
		]
	}

	private Map finalizeScenario(Map scenario) {
		if (scenario == null) {
			return null
		}

		long startMillis = toLong(scenario.startMillis)
		long endMillis = toLong(scenario.endMillis)

		if (endMillis > startMillis && startMillis > 0L) {
			scenario.durationMs = endMillis - startMillis
		}

		if (toLong(scenario.durationMs) <= 0L) {
			scenario.durationMs = sumStepDurations(scenario.steps as List<Map>)
		}

		if (toLong(scenario.durationMs) <= 0L) {
			scenario.durationMs = 1000L
		}

		scenario.durationLabel = formatDurationFull(toLong(scenario.durationMs))

		if (isBlank(scenario.errorShort) && !(scenario.errorLines as List).isEmpty()) {
			scenario.errorShort = extractShortError((scenario.errorLines as List<String>).join('\n'))
		}

		scenario.errorFull = ((scenario.errorLines ?: []) as List<String>).join('\n').trim()

		if ((scenario.steps as List<Map>).isEmpty()) {
			scenario.steps = [[
				status   : scenario.status,
				timestamp: safeValue(scenario.startLabel),
				detail   : safeValue(scenario.title),
				icon     : resolveStepIcon(safeValue(scenario.title), safeValue(scenario.status))
			]]
		}

		return scenario
	}

	private List<Map> enrichScenarioDurations(List<Map> scenarios) {
		if (scenarios == null || scenarios.isEmpty()) {
			return []
		}

		scenarios.each { Map item ->
			if (toLong(item.durationMs) <= 0L) {
				item.durationMs = 1000L
				item.durationLabel = formatDurationFull(1000L)
			}
		}

		return scenarios
	}

	private String extractStartTestCasePath(String line) {
		def matcher = (safeValue(line) =~ /^START\s+(Test Cases\/.+)$/)
		if (matcher.find()) {
			return safeValue(matcher.group(1))
		}
		return ''
	}

	private Map extractFinishedStatus(String line) {
		def matcherA = (safeValue(line) =~ /^(Test Cases\/.+?)\s+(PASSED|FAILED|ERROR|SKIPPED|INCOMPLETE)\.?$/)
		if (matcherA.find()) {
			return [
				path  : safeValue(matcherA.group(1)),
				status: normalizeScenarioStatus(safeValue(matcherA.group(2)))
			]
		}

		def matcherB = (safeValue(line) =~ /^END\s+(Test Cases\/.+)$/)
		if (matcherB.find()) {
			return [
				path  : safeValue(matcherB.group(1)),
				status: 'passed'
			]
		}

		return null
	}

	private Map extractStep(String line, String timeLabel) {
		def matcherA = (safeValue(line) =~ /^TEST STEP[:\s]+(.+)$/)
		if (matcherA.find()) {
			String detail = cleanupStepTitle(safeValue(matcherA.group(1)))
			if (shouldIgnoreStep(detail)) {
				return null
			}

			return [
				status   : inferStepStatus(detail),
				timestamp: safeValue(timeLabel),
				detail   : detail,
				icon     : resolveStepIcon(detail, inferStepStatus(detail)),
				durationMs: 1000L
			]
		}

		def matcherB = (safeValue(line) =~ /^(\d+)\s*[-:]\s*(.+?)(?:\s+\(([\d.,]+s)\))?$/)
		if (matcherB.find()) {
			String detail = cleanupStepTitle(safeValue(matcherB.group(2)))
			if (shouldIgnoreStep(detail)) {
				return null
			}

			long durationMs = toMillisFromCompactSeconds(safeValue(matcherB.group(3)))
			if (durationMs <= 0L) {
				durationMs = 1000L
			}

			String status = inferStepStatus(detail)

			return [
				status   : status,
				timestamp: safeValue(timeLabel),
				detail   : detail,
				icon     : resolveStepIcon(detail, status),
				durationMs: durationMs
			]
		}

		return null
	}

	private String normalizeScenarioTitle(String path) {
		String value = safeValue(path).replace('\\', '/')
		List<String> parts = value.tokenize('/')
		return parts.isEmpty() ? value : safeValue(parts[parts.size() - 1])
	}

	private String normalizeScenarioStatus(String raw) {
		String value = safeValue(raw).toLowerCase(Locale.ENGLISH)

		if (value == 'passed') return 'passed'
		if (value == 'failed') return 'failed'
		if (value == 'error') return 'failed'
		if (value == 'incomplete') return 'failed'
		if (value == 'skipped') return 'skipped'
		return 'info'
	}

	private String inferStepStatus(String detail) {
		String lower = safeValue(detail).toLowerCase(Locale.ENGLISH)
		if (lower.contains('failed')) return 'failed'
		if (lower.contains('skipped')) return 'skipped'
		return 'passed'
	}

	// =========================================================================
	// THIRD SOURCE: XML
	// =========================================================================

	private List<Map> parseXmlCases(String xmlPath) {
		File xmlFile = new File(xmlPath)
		if (!xmlFile.exists()) {
			return []
		}

		try {
			def root = new XmlSlurper(false, false).parse(xmlFile)
			List<Map> results = []

			root.depthFirst().findAll { node ->
				safeValue(node.name()) == 'testcase'
			}.eachWithIndex { testcase, int index ->
				String className = safeValue(testcase.@classname)
				String testName = safeValue(testcase.@name)
				String durationRaw = safeValue(testcase.@time)

				def failureNode = testcase.failure?.size() > 0 ? testcase.failure[0] : null
				def errorNode = testcase.error?.size() > 0 ? testcase.error[0] : null
				def skippedNode = testcase.skipped?.size() > 0 ? testcase.skipped[0] : null

				boolean failed = failureNode != null || errorNode != null
				boolean skipped = skippedNode != null

				String details = ''
				String shortError = ''

				if (failureNode != null) {
					details = safeValue(failureNode.text())
					shortError = safeValue(failureNode.@message)
				} else if (errorNode != null) {
					details = safeValue(errorNode.text())
					shortError = safeValue(errorNode.@message)
				} else if (skippedNode != null) {
					details = safeValue(skippedNode.text())
					shortError = safeValue(skippedNode.@message)
				}

				long durationMs = toMillisFromCompactSeconds(durationRaw)
				if (durationMs <= 0L) {
					durationMs = 1000L
				}

				String title = !isBlank(testName) ? testName : className

				results.add([
					id           : 'scenario-xml-' + (index + 1),
					title        : title,
					status       : skipped ? 'skipped' : (failed ? 'failed' : 'passed'),
					startLabel   : '',
					endLabel     : '',
					durationMs   : durationMs,
					durationLabel: formatDurationFull(durationMs),
					errorShort   : extractShortError(shortError ?: details),
					errorFull    : details,
					steps        : [[
						status   : skipped ? 'skipped' : (failed ? 'failed' : 'passed'),
						timestamp: '',
						detail   : title,
						icon     : resolveStepIcon(title, skipped ? 'skipped' : (failed ? 'failed' : 'passed')),
						durationMs: durationMs
					]]
				])
			}

			return results
		} catch (Exception ignored) {
			return []
		}
	}

	// =========================================================================
	// EVIDENCE
	// =========================================================================

	private void attachEvidenceToFailedScenarios(File reportDir, List<Map> scenarios) {
		List<File> images = findEvidenceImages(reportDir)
		if (images.isEmpty()) {
			return
		}

		images.sort { a, b -> a.lastModified() <=> b.lastModified() }

		List<Map> failed = scenarios.findAll { Map item ->
			safeValue(item.status) == 'failed'
		}

		failed.eachWithIndex { Map scenario, int index ->
			File image = pickEvidence(images, index)
			if (image == null || !image.exists()) {
				return
			}

			String href = buildEvidenceHref(image, reportDir)
			String imgSrc = buildEvidencePreviewSrc(image)

			scenario.evidences = [[
				name  : image.name,
				href  : href,
				imgSrc: imgSrc,
				image : true
			]]
		}
	}

	private File pickEvidence(List<File> images, int index) {
		if (images == null || images.isEmpty()) {
			return null
		}

		if (index >= 0 && index < images.size()) {
			return images[index]
		}

		return images[images.size() - 1]
	}

	private List<File> findEvidenceImages(File reportDir) {
		List<File> images = []

		File evidenceDir = new File(reportDir, safeValue(flow.EVIDENCE_FOLDER_NAME))
		if (!evidenceDir.exists() || !evidenceDir.isDirectory()) {
			return images
		}

		evidenceDir.eachFileRecurse { File file ->
			if (file != null && file.isFile() && isImageFile(file.name)) {
				images.add(file)
			}
		}

		return images
	}

	private String buildEvidenceHref(File file, File reportDir) {
		if (file == null || !file.exists()) {
			return ''
		}

		try {
			String base = reportDir.canonicalPath.replace('\\', '/') + '/'
			String path = file.canonicalPath.replace('\\', '/')
			if (path.startsWith(base)) {
				return path.substring(base.length())
			}
		} catch (Exception ignored) {
		}

		return file.toURI().toString()
	}

	private String buildEvidencePreviewSrc(File file) {
		if (file == null || !file.exists() || !isImageFile(file.name)) {
			return ''
		}

		try {
			byte[] bytes = Files.readAllBytes(file.toPath())
			return 'data:' + resolveImageMime(file.name) + ';base64,' + Base64.encoder.encodeToString(bytes)
		} catch (Exception ignored) {
			return file.toURI().toString()
		}
	}

	// =========================================================================
	// FILE HELPERS
	// =========================================================================

	private File findExecutionLog(File reportDir) {
		File exact = new File(reportDir, 'execution0.log')
		if (exact.exists() && exact.isFile()) {
			return exact
		}

		File alt = new File(reportDir, 'execution.log')
		if (alt.exists() && alt.isFile()) {
			return alt
		}

		File[] files = reportDir.listFiles()
		if (files == null || files.length == 0) {
			return null
		}

		List<File> candidates = []

		for (File file : files) {
			if (file == null || !file.isFile()) {
				continue
			}

			String lower = safeValue(file.name).toLowerCase(Locale.ENGLISH)
			if (lower.startsWith('execution') && lower.endsWith('.log')) {
				candidates.add(file)
			}
		}

		if (candidates.isEmpty()) {
			return null
		}

		candidates.sort { a, b -> b.lastModified() <=> a.lastModified() }
		return candidates[0]
	}

	private List<String> readFileLines(File file) {
		try {
			return Files.readAllLines(file.toPath(), StandardCharsets.UTF_8)
		} catch (Exception ignored) {
			try {
				return file.readLines()
			} catch (Exception ignoredAgain) {
				return []
			}
		}
	}

	private String resolveAssetUrl(File reportDir, String relativePath) {
		if (isBlank(relativePath)) {
			return ''
		}

		File projectRoot = findProjectRoot(reportDir)
		File asset = new File(projectRoot, relativePath)
		if (asset.exists()) {
			return asset.toURI().toString()
		}
		return ''
	}

	private File findProjectRoot(File reportDir) {
		File current = reportDir
		while (current != null) {
			if ('Reports'.equalsIgnoreCase(current.name)) {
				return current.parentFile != null ? current.parentFile : current
			}
			current = current.parentFile
		}
		return reportDir
	}

	// =========================================================================
	// LOG HELPERS
	// =========================================================================

	private String sanitizeLogLine(String rawLine) {
		String line = safeValue(rawLine)
		if (isBlank(line)) {
			return ''
		}

		line = line.replaceAll(/\u001B\[[;\d]*m/, '')
		line = line.replace('\t', ' ')
		line = line.replaceAll(/\s+/, ' ').trim()

		def matcherA = (line =~ /^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3}\s+[A-Z]+\s+.+?\s+-\s+(.*)$/)
		if (matcherA.find()) {
			return safeValue(matcherA.group(1))
		}

		def matcherB = (line =~ /^\d{2}:\d{2}:\d{2}\.\d{3}\s+[A-Z]+\s+(.*)$/)
		if (matcherB.find()) {
			return safeValue(matcherB.group(1))
		}

		return line
	}

	private String extractTimeLabel(String rawLine) {
		String raw = safeValue(rawLine)

		def matcherA = (raw =~ /^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3})/)
		if (matcherA.find()) {
			try {
				Date dt = new SimpleDateFormat('yyyy-MM-dd HH:mm:ss.SSS', Locale.ENGLISH).parse(matcherA.group(1))
				return new SimpleDateFormat('HH:mm:ss', Locale.ENGLISH).format(dt)
			} catch (Exception ignored) {
			}
		}

		def matcherB = (raw =~ /^(\d{2}:\d{2}:\d{2}\.\d{3})/)
		if (matcherB.find()) {
			return cleanClock(safeValue(matcherB.group(1)))
		}

		return ''
	}

	private long extractTimeMillis(String rawLine) {
		String raw = safeValue(rawLine)

		def matcherA = (raw =~ /^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3})/)
		if (matcherA.find()) {
			try {
				Date dt = new SimpleDateFormat('yyyy-MM-dd HH:mm:ss.SSS', Locale.ENGLISH).parse(matcherA.group(1))
				return dt.time
			} catch (Exception ignored) {
			}
		}

		return 0L
	}

	private boolean looksLikeErrorLine(String line) {
		String lower = safeValue(line).toLowerCase(Locale.ENGLISH)

		return lower.contains('stepfailedexception') ||
				lower.contains('steperrorexception') ||
				lower.contains('exception') ||
				lower.contains('root cause') ||
				lower.contains('caused by:') ||
				lower.contains('unable to ') ||
				lower.contains('timeout') ||
				lower.contains('no such element') ||
				lower.contains('classnotfoundexception')
	}

	private boolean looksLikeNoiseLine(String line) {
		String lower = safeValue(line).toLowerCase(Locale.ENGLISH)

		return lower.startsWith('build info:') ||
				lower.startsWith('system info:') ||
				lower.startsWith('driver info:') ||
				lower.startsWith('capabilities') ||
				lower.startsWith('session id:')
	}

	private boolean shouldIgnoreTestCase(String path) {
		String lower = safeValue(path).toLowerCase(Locale.ENGLISH)

		return lower.contains('/jira_import_') ||
				lower.contains('/jira import') ||
				lower.contains('jiraintegration.jiraintegration.jiraimport')
	}

	private boolean shouldIgnoreStep(String detail) {
		String lower = safeValue(detail).toLowerCase(Locale.ENGLISH)

		return lower.startsWith('beforecase') ||
				lower.startsWith('aftercase') ||
				lower.startsWith('beforesuite') ||
				lower.startsWith('aftersuite') ||
				lower == 'video' ||
				lower.startsWith('exportkatalonreports')
	}

	// =========================================================================
	// GENERIC HELPERS
	// =========================================================================

	private String resolveReportFileName() {
		try {
			String value = safeValue(flow?.GAIA_REPORT_FILE_NAME)
			if (!isBlank(value)) {
				return value
			}
		} catch (Exception ignored) {
		}
		return DEFAULT_REPORT_FILE_NAME
	}

	private String resolveSuiteName(File reportDir, String providedSuiteName) {
		if (!isBlank(providedSuiteName)) {
			return safeValue(providedSuiteName)
		}

		File parent = reportDir.parentFile
		if (parent != null && !isBlank(parent.name)) {
			return safeValue(parent.name)
		}
		return 'Execution'
	}

	private long sumStepDurations(List<Map> steps) {
		long total = 0L
		if (steps == null) {
			return total
		}

		steps.each { Map step ->
			total += toLong(step.durationMs)
		}

		return total
	}

	private long toMillisFromCompactSeconds(String rawValue) {
		String raw = safeValue(rawValue).replace(',', '.').replace('s', '').trim()
		if (isBlank(raw)) {
			return 0L
		}

		try {
			return Math.round(Double.parseDouble(raw) * 1000d)
		} catch (Exception ignored) {
			return 0L
		}
	}

	private String formatDurationFull(long durationMs) {
		long totalSeconds = durationMs > 0L ? Math.round(durationMs / 1000d) : 0L
		long hours = (long) Math.floor(totalSeconds / 3600L)
		long minutes = (long) Math.floor((totalSeconds % 3600L) / 60L)
		long seconds = totalSeconds % 60L
		return String.format(Locale.ENGLISH, '%02dh %02dm %02ds', hours, minutes, seconds)
	}

	private String formatDisplayDate(Date value) {
		return new SimpleDateFormat('MM.dd.yyyy hh:mm:ss a', Locale.ENGLISH).format(value)
	}

	private String cleanupStepTitle(String value) {
		String text = safeValue(value)
		text = text.replaceAll(/\s+\(([\d.,]+s)\)\s*$/, '').trim()
		text = text.replaceAll(/[.]{2,}$/, '').trim()
		return text
	}

	private String cleanClock(String raw) {
		String text = safeValue(raw)
		if (text.contains('.')) {
			return text.substring(0, text.indexOf('.'))
		}
		return text
	}

	private String extractShortError(def source) {
		String text = safeValue(source)
		if (isBlank(text)) {
			return ''
		}

		List<String> lines = text.readLines().collect { safeValue(it) }.findAll { !isBlank(it) }
		if (lines.isEmpty()) {
			return ''
		}

		String preferred = lines.find { String line ->
			String lower = line.toLowerCase(Locale.ENGLISH)
			return lower.contains('unable to ') ||
					lower.contains('timeout') ||
					lower.contains('no such element') ||
					lower.contains('classnotfoundexception') ||
					lower.contains('stepfailedexception')
		}

		String result = safeValue(preferred ?: lines[0])
		result = result.replace('com.kms.katalon.core.exception.StepFailedException:', '').trim()
		result = result.replace('com.kms.katalon.core.exception.StepErrorException:', '').trim()

		if (result.length() > 180) {
			result = result.substring(0, 177) + '...'
		}

		return result
	}

	private String resolveStepIcon(String detail, String status) {
		String lower = safeValue(detail).toLowerCase(Locale.ENGLISH)

		if (status == 'failed') return '❌'
		if (status == 'skipped') return '⏭️'
		if (lower.contains('wait') || lower.contains('search') || lower.contains('find')) return '🔎'
		if (lower.contains('click') || lower.contains('select')) return '🖱️'
		if (lower.contains('fill') || lower.contains('input') || lower.contains('settext') || lower.contains('write')) return '⌨️'
		if (lower.contains('open') || lower.contains('navigate') || lower.contains('calltestcase')) return '🌐'
		return 'ℹ️'
	}

	private String resolveImageMime(String fileName) {
		String lower = safeValue(fileName).toLowerCase(Locale.ENGLISH)

		if (lower.endsWith('.png')) return 'image/png'
		if (lower.endsWith('.jpg') || lower.endsWith('.jpeg')) return 'image/jpeg'
		if (lower.endsWith('.gif')) return 'image/gif'
		if (lower.endsWith('.webp')) return 'image/webp'
		if (lower.endsWith('.bmp')) return 'image/bmp'

		return 'image/png'
	}

	private boolean isImageFile(String fileName) {
		String lower = safeValue(fileName).toLowerCase(Locale.ENGLISH)
		return lower.endsWith('.png') ||
				lower.endsWith('.jpg') ||
				lower.endsWith('.jpeg') ||
				lower.endsWith('.gif') ||
				lower.endsWith('.webp') ||
				lower.endsWith('.bmp')
	}

	private String escapeXml(String value) {
		return safeValue(value)
				.replace('&', '&amp;')
				.replace('<', '&lt;')
				.replace('>', '&gt;')
				.replace('"', '&quot;')
				.replace("'", '&apos;')
	}

	private String safeValue(def value) {
		return value == null ? '' : String.valueOf(value).trim()
	}

	private boolean isBlank(def value) {
		return safeValue(value).isEmpty()
	}

	private long toLong(def value) {
		String raw = safeValue(value)
		if (raw.isEmpty()) {
			return 0L
		}

		try {
			return Long.parseLong(raw)
		} catch (Exception ignored) {
		}

		try {
			return Math.round(Double.parseDouble(raw.replace(',', '.')))
		} catch (Exception ignored) {
			return 0L
		}
	}
}
