package commands

import java.io.File
import java.io.FileInputStream
import java.math.RoundingMode
import java.text.Normalizer

import org.apache.poi.ss.usermodel.Cell
import org.apache.poi.ss.usermodel.CellType
import org.apache.poi.ss.usermodel.DataFormatter
import org.apache.poi.ss.usermodel.Row
import org.apache.poi.ss.usermodel.Sheet
import org.apache.poi.ss.usermodel.Workbook
import org.apache.poi.ss.usermodel.WorkbookFactory

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.util.KeywordUtil


class RecPrdExportValidationKeywords {

	@Keyword
	Map validateLatestRecPrdExport(
			String exportRootFolder,
			String exportGroupFolder,
			String exportFeatureFolder,
			Integer columnIndex,
			String expectedColumnName) {

		Map result = createEmptyResult(
				exportRootFolder,
				exportGroupFolder,
				exportFeatureFolder,
				columnIndex,
				expectedColumnName
		)

		StringBuilder errors = new StringBuilder()
		StringBuilder passedDetails = new StringBuilder()

		try {
			File exportRoot = new File(safeText(exportRootFolder))
			int validatedColumnIndex = columnIndex == null ? -1 : columnIndex.intValue()

			if (!exportRoot.exists()) {
				errors.append('[ERROR] Export root folder does not exist.\n')
						.append('Folder: ')
						.append(exportRoot.getAbsolutePath())

				return finalizeResult(result, errors, passedDetails)
			}

			if (!exportRoot.isDirectory()) {
				errors.append('[ERROR] Export root path is not a folder.\n')
						.append('Path: ')
						.append(exportRoot.getAbsolutePath())

				return finalizeResult(result, errors, passedDetails)
			}

			if (validatedColumnIndex < 0) {
				errors.append('[ERROR] Invalid column index.\n')
						.append('Column index: ')
						.append(validatedColumnIndex)

				return finalizeResult(result, errors, passedDetails)
			}

			KeywordUtil.logInfo(
					'[REC X PRD SEARCH] root=' + exportRoot.getAbsolutePath() +
					' | group=' + safeText(exportGroupFolder) +
					' | feature=' + safeText(exportFeatureFolder)
			)

			Map selectedFiles = resolveLatestRecPrdFiles(
					exportRoot,
					exportGroupFolder,
					exportFeatureFolder
			)

			File recFile = selectedFiles.recFile as File
			File prdFile = selectedFiles.prdFile as File
			File selectedFolder = selectedFiles.selectedFolder as File

			result.recFileName = recFile == null ? 'NOT FOUND' : recFile.getName()
			result.prdFileName = prdFile == null ? 'NOT FOUND' : prdFile.getName()
			result.selectedFolderPath = selectedFolder == null ? '' : selectedFolder.getAbsolutePath()

			if (recFile == null) {
				errors.append('[ERROR] REC exported file was not found.\n')
						.append('Search root: ')
						.append(exportRoot.getAbsolutePath())
						.append('\nExpected folder: ')
						.append(safeText(exportGroupFolder))
						.append('\\')
						.append(safeText(exportFeatureFolder))
						.append('\n')
			}

			if (prdFile == null) {
				errors.append('[ERROR] PRD exported file was not found.\n')
						.append('Search root: ')
						.append(exportRoot.getAbsolutePath())
						.append('\nExpected folder: ')
						.append(safeText(exportGroupFolder))
						.append('\\')
						.append(safeText(exportFeatureFolder))
						.append('\n')
			}

			if (errors.length() > 0) {
				return finalizeResult(result, errors, passedDetails)
			}

			KeywordUtil.logInfo(
					'[REC X PRD SEARCH] selectedFolder=' + selectedFolder.getAbsolutePath() +
					' | REC=' + recFile.getName() +
					' | PRD=' + prdFile.getName()
			)

			/*
			 * Read REC and PRD sequentially.
			 * This avoids keeping both large workbooks in memory at the same time.
			 */
			Map recData = readFileData(
					recFile,
					validatedColumnIndex,
					expectedColumnName,
					'REC'
			)

			System.gc()

			Map prdData = readFileData(
					prdFile,
					validatedColumnIndex,
					expectedColumnName,
					'PRD'
			)

			System.gc()

			result.recColumnName = safeText(recData.columnName)
			result.prdColumnName = safeText(prdData.columnName)
			result.columnName = !safeText(recData.columnName).isEmpty()
					? safeText(recData.columnName)
					: safeText(expectedColumnName)

			result.recRows = recData.rows
			result.prdRows = prdData.rows
			result.recNumericValues = recData.numericValues
			result.prdNumericValues = prdData.numericValues
			result.recSum = recData.sum
			result.prdSum = prdData.sum
			result.recMinimum = recData.minimum
			result.prdMinimum = prdData.minimum
			result.recMaximum = recData.maximum
			result.prdMaximum = prdData.maximum

			if (!safeText(recData.errors).isEmpty()) {
				errors.append(safeText(recData.errors)).append('\n')
			}

			if (!safeText(prdData.errors).isEmpty()) {
				errors.append(safeText(prdData.errors)).append('\n')
			}

			if (errors.length() > 0) {
				return finalizeResult(result, errors, passedDetails)
			}

			if (!normalizeText(result.recColumnName).equals(
					normalizeText(result.prdColumnName))) {

				errors.append('[ERROR] REC and PRD column headers are different.\n')
						.append('REC: ')
						.append(result.recColumnName)
						.append('\nPRD: ')
						.append(result.prdColumnName)
						.append('\n')
			}

			if ((result.recRows as int) != (result.prdRows as int)) {
				errors.append('[ERROR] Number of rows is different.\n')
						.append('REC: ')
						.append(result.recRows)
						.append('\nPRD: ')
						.append(result.prdRows)
						.append('\n')
			} else {
				passedDetails.append('[PASS] Number of rows is equal.\n')
						.append('REC: ')
						.append(result.recRows)
						.append('\nPRD: ')
						.append(result.prdRows)
						.append('\n')
			}

			appendComparison(
					errors,
					passedDetails,
					'Column sum',
					result.columnName as String,
					result.recSum as BigDecimal,
					result.prdSum as BigDecimal
			)

			appendComparison(
					errors,
					passedDetails,
					'Minimum value',
					result.columnName as String,
					result.recMinimum as BigDecimal,
					result.prdMinimum as BigDecimal
			)

			appendComparison(
					errors,
					passedDetails,
					'Maximum value',
					result.columnName as String,
					result.recMaximum as BigDecimal,
					result.prdMaximum as BigDecimal
			)

		} catch (OutOfMemoryError error) {
			errors.append('[ERROR] Not enough memory to validate the exported files.\n')
					.append('The workbooks are too large for the current Katalon JVM memory.\n')
					.append('Message: ')
					.append(safeText(error.getMessage()))
		} catch (Exception exception) {
			errors.append('[ERROR] REC x PRD export validation failed.\n')
					.append('Exception: ')
					.append(exception.getClass().getSimpleName())
					.append('\nMessage: ')
					.append(safeText(exception.getMessage()))
		}

		return finalizeResult(result, errors, passedDetails)
	}


	private Map readFileData(
			File file,
			int columnIndex,
			String expectedColumnName,
			String environment) {

		Map result = [
			columnName   : '',
			rows         : 0,
			numericValues: 0,
			sum          : null,
			minimum      : null,
			maximum      : null,
			errors       : ''
		]

		StringBuilder errors = new StringBuilder()
		FileInputStream input = null
		Workbook workbook = null

		try {
			input = new FileInputStream(file)
			workbook = WorkbookFactory.create(input)

			if (workbook.getNumberOfSheets() == 0) {
				errors.append('[ERROR] ')
						.append(environment)
						.append(' workbook does not contain worksheets.\n')
						.append('File: ')
						.append(file.getName())

				result.errors = errors.toString()
				return result
			}

			Sheet sheet = workbook.getSheetAt(0)
			DataFormatter formatter = new DataFormatter()

			String columnName = readHeaderName(
					sheet,
					columnIndex,
					formatter
			)

			result.columnName = columnName

			if (columnName.isEmpty()) {
				errors.append('[ERROR] ')
						.append(environment)
						.append(' column header was not found.\n')
						.append('Column index: ')
						.append(columnIndex)
						.append('\n')
			} else if (!normalizeText(columnName).equals(
					normalizeText(expectedColumnName))) {

				errors.append('[ERROR] Unexpected ')
						.append(environment)
						.append(' column header.\n')
						.append('Expected: ')
						.append(safeText(expectedColumnName))
						.append('\nFound: ')
						.append(columnName)
						.append('\n')
			}

			BigDecimal sum = BigDecimal.ZERO
			BigDecimal minimum = null
			BigDecimal maximum = null
			int numericValues = 0
			int rows = 0

			for (int rowIndex = 1;
					rowIndex <= sheet.getLastRowNum();
					rowIndex++) {

				Row row = sheet.getRow(rowIndex)

				if (row == null || isRowEmpty(row, formatter)) {
					continue
				}

				rows++

				BigDecimal value = getCellNumber(
						row,
						columnIndex,
						formatter
				)

				if (value == null) {
					continue
				}

				sum = sum.add(value)

				if (minimum == null || value.compareTo(minimum) < 0) {
					minimum = value
				}

				if (maximum == null || value.compareTo(maximum) > 0) {
					maximum = value
				}

				numericValues++
			}

			result.rows = rows
			result.numericValues = numericValues

			if (numericValues == 0) {
				errors.append('[ERROR] ')
						.append(environment)
						.append(' column does not contain numeric values.\n')
						.append('Column: ')
						.append(columnName)
						.append('\n')
			} else {
				result.sum = round2(sum)
				result.minimum = round2(minimum)
				result.maximum = round2(maximum)
			}

			result.errors = errors.toString().trim()
			return result

		} finally {
			closeWorkbook(workbook)
			closeInput(input)
		}
	}


	private Map createEmptyResult(
			String exportRootFolder,
			String exportGroupFolder,
			String exportFeatureFolder,
			Integer columnIndex,
			String expectedColumnName) {

		return [
			success             : false,
			errors              : '',
			passedDetails       : '',
			exportRootFolder    : safeText(exportRootFolder),
			exportGroupFolder   : safeText(exportGroupFolder),
			exportFeatureFolder : safeText(exportFeatureFolder),
			columnIndex         : columnIndex,
			columnName          : safeText(expectedColumnName),
			recColumnName       : '',
			prdColumnName       : '',
			selectedFolderPath  : '',
			recFileName         : 'NOT FOUND',
			prdFileName         : 'NOT FOUND',
			recRows             : null,
			prdRows             : null,
			recNumericValues    : null,
			prdNumericValues    : null,
			recSum              : null,
			prdSum              : null,
			recMinimum          : null,
			prdMinimum          : null,
			recMaximum          : null,
			prdMaximum          : null
		]
	}


	private Map finalizeResult(
			Map result,
			StringBuilder errors,
			StringBuilder passedDetails) {

		result.errors = errors.toString().trim()
		result.passedDetails = passedDetails.toString().trim()
		result.success = result.errors.isEmpty()

		return result
	}


	private Map resolveLatestRecPrdFiles(
			File exportRoot,
			String expectedGroupFolder,
			String expectedFeatureFolder) {

		Map result = [
			recFile        : null,
			prdFile        : null,
			selectedFolder : null
		]

		List<File> matchingFeatureFolders = []

		collectMatchingFeatureFolders(
				exportRoot,
				expectedGroupFolder,
				expectedFeatureFolder,
				matchingFeatureFolders
		)

		List<Map> validPairs = []

		for (File featureFolder : matchingFeatureFolders) {
			File[] folderFiles = featureFolder.listFiles()

			if (folderFiles == null) {
				continue
			}

			List<File> recFiles = folderFiles.findAll { File file ->
				isEnvironmentExcelFile(file, 'REC')
			}

			List<File> prdFiles = folderFiles.findAll { File file ->
				isEnvironmentExcelFile(file, 'PRD')
			}

			if (recFiles.isEmpty() || prdFiles.isEmpty()) {
				continue
			}

			recFiles.sort { File first, File second ->
				second.lastModified() <=> first.lastModified()
			}

			prdFiles.sort { File first, File second ->
				second.lastModified() <=> first.lastModified()
			}

			File recFile = recFiles.get(0)
			File prdFile = prdFiles.get(0)

			validPairs.add([
				recFile        : recFile,
				prdFile        : prdFile,
				selectedFolder : featureFolder,
				pairTimestamp  : Math.max(
						recFile.lastModified(),
						prdFile.lastModified()
				)
			])
		}

		if (validPairs.isEmpty()) {
			return result
		}

		validPairs.sort { Map first, Map second ->
			(second.pairTimestamp as Long) <=>
			(first.pairTimestamp as Long)
		}

		Map latestPair = validPairs.get(0)

		result.recFile = latestPair.recFile
		result.prdFile = latestPair.prdFile
		result.selectedFolder = latestPair.selectedFolder

		return result
	}


	private void collectMatchingFeatureFolders(
			File currentFolder,
			String expectedGroupFolder,
			String expectedFeatureFolder,
			List<File> result) {

		if (currentFolder == null ||
				!currentFolder.exists() ||
				!currentFolder.isDirectory()) {

			return
		}

		File parentFolder = currentFolder.getParentFile()

		boolean featureMatches =
				normalizeText(currentFolder.getName()).equals(
						normalizeText(expectedFeatureFolder)
				)

		boolean groupMatches =
				parentFolder != null &&
				normalizeText(parentFolder.getName()).equals(
						normalizeText(expectedGroupFolder)
				)

		if (featureMatches && groupMatches) {
			result.add(currentFolder)
			return
		}

		File[] children = currentFolder.listFiles()

		if (children == null) {
			return
		}

		for (File child : children) {
			if (child != null && child.isDirectory()) {
				collectMatchingFeatureFolders(
						child,
						expectedGroupFolder,
						expectedFeatureFolder,
						result
				)
			}
		}
	}


	private boolean isEnvironmentExcelFile(
			File file,
			String environment) {

		if (file == null ||
				!file.exists() ||
				!file.isFile()) {

			return false
		}

		String fileName = file.getName()

		if (fileName.startsWith('~$')) {
			return false
		}

		return fileName.toUpperCase().startsWith(
				safeText(environment).toUpperCase() + '_'
		) && isExcelFileName(fileName)
	}


	private boolean isExcelFileName(String fileName) {

		String normalizedName = safeText(fileName).toLowerCase()

		return normalizedName.endsWith('.xlsx') ||
			normalizedName.endsWith('.xls') ||
			normalizedName.endsWith('.xlsm')
	}


	private String readHeaderName(
			Sheet sheet,
			int columnIndex,
			DataFormatter formatter) {

		if (sheet == null || columnIndex < 0) {
			return ''
		}

		Row headerRow = sheet.getRow(0)

		if (headerRow == null) {
			return ''
		}

		Cell headerCell = headerRow.getCell(columnIndex)

		if (headerCell == null) {
			return ''
		}

		return formatter.formatCellValue(headerCell).trim()
	}


	private BigDecimal getCellNumber(
			Row row,
			int columnIndex,
			DataFormatter formatter) {

		if (row == null || columnIndex < 0) {
			return null
		}

		Cell cell = row.getCell(columnIndex)

		if (cell == null) {
			return null
		}

		try {
			CellType cellType = cell.getCellType()

			if (cellType == CellType.NUMERIC) {
				return BigDecimal.valueOf(cell.getNumericCellValue())
			}

			if (cellType == CellType.FORMULA &&
					cell.getCachedFormulaResultType() == CellType.NUMERIC) {

				return BigDecimal.valueOf(cell.getNumericCellValue())
			}

			return parseNumber(
					formatter.formatCellValue(cell).trim()
			)
		} catch (Exception ignored) {
			return null
		}
	}


	private boolean isRowEmpty(
			Row row,
			DataFormatter formatter) {

		if (row == null || row.getLastCellNum() <= 0) {
			return true
		}

		for (int columnIndex = 0;
				columnIndex < row.getLastCellNum();
				columnIndex++) {

			Cell cell = row.getCell(columnIndex)

			if (cell == null) {
				continue
			}

			if (!formatter.formatCellValue(cell).trim().isEmpty()) {
				return false
			}
		}

		return true
	}


	private void appendComparison(
			StringBuilder errors,
			StringBuilder passedDetails,
			String validationLabel,
			String columnName,
			BigDecimal recValue,
			BigDecimal prdValue) {

		if (recValue == null || prdValue == null) {
			errors.append('[ERROR] ')
					.append(validationLabel)
					.append(' could not be compared.\n')
			return
		}

		if (recValue.compareTo(prdValue) != 0) {
			errors.append('[ERROR] ')
					.append(validationLabel)
					.append(' is different.\n')
					.append('Column: ')
					.append(columnName)
					.append('\nREC: ')
					.append(recValue)
					.append('\nPRD: ')
					.append(prdValue)
					.append('\n')
		} else {
			passedDetails.append('[PASS] ')
					.append(validationLabel)
					.append(' is equal.\n')
					.append('Column: ')
					.append(columnName)
					.append('\nValue: ')
					.append(recValue)
					.append('\n')
		}
	}


	private BigDecimal parseNumber(String value) {

		String text = safeText(value)

		if (text.isEmpty()) {
			return null
		}

		text = text
				.replace('\u00A0', ' ')
				.replace('\u202F', ' ')
				.replace('\u2212', '-')
				.replace('\u2012', '-')
				.replace('\u2013', '-')
				.replace('\u2014', '-')
				.replace('\u2015', '-')
				.trim()

		boolean negativeByParentheses =
				text.startsWith('(') &&
				text.endsWith(')')

		boolean negativeByTrailingMinus =
				text.endsWith('-')

		text = text
				.replaceAll('[^0-9,\\.\\-\\(\\)]', '')
				.replace('(', '')
				.replace(')', '')

		if (negativeByTrailingMinus && text.endsWith('-')) {
			text = text.substring(0, text.length() - 1)
		}

		boolean negative =
				text.startsWith('-') ||
				negativeByParentheses ||
				negativeByTrailingMinus

		text = text.replace('-', '')

		if (text.isEmpty()) {
			return null
		}

		String normalizedNumber = normalizeNumericSeparators(text)

		if (normalizedNumber.isEmpty()) {
			return null
		}

		try {
			BigDecimal result = new BigDecimal(normalizedNumber)

			if (negative && result.compareTo(BigDecimal.ZERO) > 0) {
				result = result.negate()
			}

			return result
		} catch (Exception ignored) {
			return null
		}
	}


	private String normalizeNumericSeparators(String value) {

		int commaCount = countOccurrences(value, ',')
		int dotCount = countOccurrences(value, '.')

		if (commaCount > 0 && dotCount > 0) {
			int lastComma = value.lastIndexOf(',')
			int lastDot = value.lastIndexOf('.')

			if (lastComma > lastDot) {
				return value
						.replace('.', '')
						.replace(',', '.')
			}

			return value.replace(',', '')
		}

		if (commaCount > 0) {
			return normalizeSingleSeparatorNumber(value, ',')
		}

		if (dotCount > 0) {
			return normalizeSingleSeparatorNumber(value, '.')
		}

		return value
	}


	private String normalizeSingleSeparatorNumber(
			String value,
			String separator) {

		int separatorCount = countOccurrences(value, separator)

		if (separatorCount == 0) {
			return value
		}

		if (separatorCount > 1) {
			int lastSeparator = value.lastIndexOf(separator)
			String decimals = value.substring(lastSeparator + 1)

			if (decimals.length() == 1 || decimals.length() == 2) {
				String integerPart = value
						.substring(0, lastSeparator)
						.replace(separator, '')

				return integerPart + '.' + decimals
			}

			return value.replace(separator, '')
		}

		int separatorIndex = value.indexOf(separator)
		String before = value.substring(0, separatorIndex)
		String after = value.substring(separatorIndex + 1)

		if (after.length() == 3 &&
				before.length() >= 1 &&
				before.length() <= 3) {

			return before + after
		}

		if (separator == ',') {
			return before + '.' + after
		}

		return value
	}


	private BigDecimal round2(BigDecimal value) {

		if (value == null) {
			return null
		}

		return value.setScale(
				2,
				RoundingMode.HALF_EVEN
		)
	}


	private int countOccurrences(
			String text,
			String token) {

		int count = 0
		int index = 0

		while (index >= 0) {
			index = text.indexOf(token, index)

			if (index >= 0) {
				count++
				index += token.length()
			}
		}

		return count
	}


	private String normalizeText(Object value) {

		String text = safeText(value)

		if (text.isEmpty()) {
			return ''
		}

		text = Normalizer.normalize(
				text,
				Normalizer.Form.NFD
		)

		text = text.replaceAll(
				'\\p{InCombiningDiacriticalMarks}+',
				''
		)

		return text
				.toLowerCase()
				.replace(' ', '_')
				.replace('-', '_')
				.replaceAll('_+', '_')
				.trim()
	}


	private String safeText(Object value) {

		if (value == null) {
			return ''
		}

		return value.toString().trim()
	}


	private void closeWorkbook(Workbook workbook) {

		try {
			if (workbook != null) {
				workbook.close()
			}
		} catch (Exception ignored) {
		}
	}


	private void closeInput(FileInputStream input) {

		try {
			if (input != null) {
				input.close()
			}
		} catch (Exception ignored) {
		}
	}
}

