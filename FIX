		this.flow = flow
	}

	String createGaiaHtmlReport(String reportFolder, String suiteName, String xmlPath) {
		if (isBlank(reportFolder)) {
			return ''
		}

		File reportDir = new File(reportFolder)
		if (!reportDir.exists() || !reportDir.isDirectory()) {
			return ''
		}

		List<Map> scenarios = parseRichScenariosFromExecutionLog(reportDir)

		if (scenarios.isEmpty()) {
			scenarios = parseRuntimeScenariosFromExecutionLog(reportDir)
		}

		if (scenarios.isEmpty() && !isBlank(xmlPath)) {
			scenarios = buildFallbackScenarios(parseXmlCases(xmlPath))
		}

		if (scenarios.isEmpty()) {
			return ''
		}

		normalizeScenarioSteps(scenarios)
		applySequentialTimingFallback(reportDir, scenarios)
		attachEvidenceToFailedScenarios(reportDir, scenarios)

		String resolvedSuiteName = resolveSuiteName(reportDir, suiteName)

		Map model = [
			appName          : flow.getAppDisplayName(),
			suiteName        : resolvedSuiteName,
			reportTitle      : 'Test report - ' + resolvedSuiteName,
			subtitle         : flow.getReportSubtitle(),
			generatedAt      : formatDisplayDate(new Date()),
			logoSrc          : resolveAssetUrl(reportDir, flow.getReportLogoRelativePath()),
			reportFolder     : reportDir.absolutePath,
			headerBackground : flow.getReportHeaderBackground(),
			accentColor      : flow.getReportAccentColor(),
			accentSoftColor  : flow.getReportAccentSoftColor(),
			infoColor        : flow.getReportInfoColor(),
			scenarios        : scenarios
		]

		String html = new JiraGaiaHtmlTemplateBuilder().build(model)

		File htmlFile = new File(reportDir, resolveReportFileName())
		htmlFile.setText(html, 'UTF-8')
		return htmlFile.absolutePath
	}

	String createRuntimeJUnitXmlFromKatalonLog(String reportFolder, String suiteName) {
		if (isBlank(reportFolder)) {
			return ''
		}

		File reportDir = new File(reportFolder)
		if (!reportDir.exists() || !reportDir.isDirectory()) {
			return ''
		}

		List<Map> scenarios = parseRuntimeScenariosFromExecutionLog(reportDir)

		if (scenarios.isEmpty()) {
			scenarios = parseRichScenariosFromExecutionLog(reportDir)
		}

		if (scenarios.isEmpty()) {
			return ''
		}

		normalizeScenarioSteps(scenarios)
		applySequentialTimingFallback(reportDir, scenarios)

		String resolvedSuiteName = resolveSuiteName(reportDir, suiteName)

		int failures = scenarios.count { Map item -> safeValue(item.status) == 'failed' }
		int skipped = scenarios.count { Map item -> safeValue(item.status) == 'skipped' }

		long totalMillis = 0L
		scenarios.each { Map item ->
			totalMillis += toLong(item.durationMs)
		}

		StringBuilder xml = new StringBuilder()
		xml.append('<?xml version="1.0" encoding="UTF-8"?>\n')
		xml.append('<testsuite')
		xml.append(' name="').append(escapeXml(resolvedSuiteName)).append('"')
		xml.append(' tests="').append(String.valueOf(scenarios.size())).append('"')
		xml.append(' failures="').append(String.valueOf(failures)).append('"')
		xml.append(' skipped="').append(String.valueOf(skipped)).append('"')
		xml.append(' time="').append(String.format(Locale.ENGLISH, '%.3f', (double) totalMillis / 1000d)).append('">\n')

		scenarios.each { Map scenario ->
			double seconds = (double) toLong(scenario.durationMs) / 1000d
			String scenarioTitle = safeValue(scenario.title)
			if (isBlank(scenarioTitle)) {
				scenarioTitle = safeValue(scenario.name)
			}

			xml.append('  <testcase')
			xml.append(' classname="').append(escapeXml(resolvedSuiteName)).append('"')
			xml.append(' name="').append(escapeXml(scenarioTitle)).append('"')
			xml.append(' time="').append(String.format(Locale.ENGLISH, '%.3f', seconds)).append('"')

			String scenarioStatus = safeValue(scenario.status)

			if (scenarioStatus == 'passed' || scenarioStatus == 'info') {
				xml.append('/>\n')
			} else if (scenarioStatus == 'skipped') {
				xml.append('>\n')
				xml.append('    <skipped message="Skipped"/>\n')
				xml.append('  </testcase>\n')
			} else {
				String shortError = safeValue(scenario.errorShort)
				String fullError = safeValue(scenario.errorFull)

				xml.append('>\n')
				xml.append('    <failure message="').append(escapeXml(shortError)).append('"><![CDATA[')
				xml.append(fullError.replace(']]>', ']]]]><![CDATA[>'))
				xml.append(']]></failure>\n')
				xml.append('  </testcase>\n')
			}
		}

		xml.append('</testsuite>\n')

		File runtimeXml = new File(reportDir, 'JUnit_Report_Runtime.xml')
		runtimeXml.setText(xml.toString(), 'UTF-8')
		return runtimeXml.absolutePath
	}

	// =========================================================================
	// RICH SCENARIO PARSER
	// =========================================================================

	private List<Map> parseRichScenariosFromExecutionLog(File reportDir) {
		File logFile = findExecutionLog(reportDir)
		if (logFile == null || !logFile.exists() || !logFile.isFile()) {
			return []
		}

		List<String> rawLines = readFileLines(logFile)
		if (rawLines.isEmpty()) {
			return []
		}

		List<Map> scenarios = []
		Map currentScenario = null
		Map currentStep = null

		for (String rawLine : rawLines) {
			String timeLabel = extractTimeLabel(rawLine)
			long timestampMs = extractTimeMillis(rawLine)
			String line = sanitizeLogLine(rawLine)

			if (isBlank(line)) {
				continue
			}

			Map testCaseMatch = parseTreeTestCaseLine(line)
			if (testCaseMatch != null) {
				currentStep = finishStep(currentStep)
				if (currentStep != null && currentScenario != null) {
					currentScenario.steps << currentStep
				}
				currentStep = null

				currentScenario = finishScenario(currentScenario)
				if (currentScenario != null) {
					scenarios << currentScenario
				}
				currentScenario = null

				String title = safeValue(testCaseMatch.title)
				if (shouldIgnoreTestCase(title)) {
					continue
				}

				currentScenario = newScenarioMap('scenario-' + (scenarios.size() + 1), normalizeTestCaseTitle(title))
				long caseDuration = toLong(testCaseMatch.durationMs)
				if (caseDuration > 0L) {
					currentScenario.durationMs = caseDuration
					currentScenario.durationLabel = formatDurationFull(caseDuration)
				}
				if (!isBlank(timeLabel)) {
					currentScenario.startLabel = timeLabel
				}
				continue
			}

			Map stepMatch = parseTreeStepLine(line)
			if (stepMatch != null) {
				if (currentScenario == null) {
					currentScenario = newScenarioMap('scenario-' + (scenarios.size() + 1), defaultScenarioTitle(reportDir))
				}

				currentStep = finishStep(currentStep)
				if (currentStep != null) {
					currentScenario.steps << currentStep
				}

				currentStep = [
					id           : currentScenario.id + '-step-' + (((currentScenario.steps ?: []).size()) + 1),
					title        : safeValue(stepMatch.title),
					status       : safeValue(stepMatch.status),
					timeLabel    : timeLabel,
					timestampMs  : timestampMs,
					durationMs   : toLong(stepMatch.durationMs),
					durationLabel: formatDurationFull(toLong(stepMatch.durationMs)),
					detailText   : safeValue(stepMatch.title),
					detailLines  : [safeValue(stepMatch.title)],
					errorLines   : [],
					errorFull    : '',
					shortError   : '',
					emoji        : resolveStepEmoji(stepMatch.title)
				]
				continue
			}

			Map event = parseEventLine(line, timeLabel, timestampMs)
			if (event != null && currentStep != null) {
				if (isBlank(currentStep.timeLabel)) {
					currentStep.timeLabel = safeValue(event.timeLabel)
				}
				if (toLong(currentStep.timestampMs) <= 0L && toLong(event.timestampMs) > 0L) {
					currentStep.timestampMs = toLong(event.timestampMs)
				}

				String eventStatus = safeValue(event.status)
				String eventMessage = safeValue(event.message)

				if (!isBlank(eventMessage)) {
					currentStep.detailLines << eventMessage
				}

				if (eventStatus == 'failed') {
					currentStep.status = 'failed'
					if (!isBlank(eventMessage)) {
						currentStep.errorLines << eventMessage
					}
					if (isBlank(currentStep.shortError)) {
						currentStep.shortError = extractShortError(eventMessage)
					}
				} else if (eventStatus == 'skipped') {
					if (safeValue(currentStep.status) != 'failed') {
						currentStep.status = 'skipped'
					}
				} else if (eventStatus == 'passed') {
					if (safeValue(currentStep.status) != 'failed') {
						currentStep.status = 'passed'
					}
				} else if (isBlank(currentStep.status)) {
					currentStep.status = 'info'
				}

				continue
			}

			if (currentStep != null) {
				if (looksLikeErrorLine(line)) {
					currentStep.status = 'failed'
					currentStep.detailLines << line
					currentStep.errorLines << line
					if (isBlank(currentStep.shortError)) {
						currentStep.shortError = extractShortError(line)
					}
				} else if (!looksLikeNoiseLine(line)) {
					currentStep.detailLines << line
				}
			}
		}

		currentStep = finishStep(currentStep)
		if (currentStep != null && currentScenario != null) {
			currentScenario.steps << currentStep
		}

		currentScenario = finishScenario(currentScenario)
		if (currentScenario != null) {
			scenarios << currentScenario
		}

		return scenarios
	}

	private Map parseTreeTestCaseLine(String line) {
		String text = safeValue(line)

		def matcherA = (text =~ /^TEST CASE[:\s]+(.+?)(?:\s+\(([\d.,]+s)\))?$/)
		if (matcherA.find()) {
			return [
				title     : safeValue(matcherA.group(1)),
				durationMs: toMillisFromCompactSeconds(safeValue(matcherA.group(2)))
			]
		}

		def matcherB = (text =~ /^(Test Cases\/.+?)(?:\s+\(([\d.,]+s)\))?$/)
		if (matcherB.find()) {
			return [
				title     : safeValue(matcherB.group(1)),
				durationMs: toMillisFromCompactSeconds(safeValue(matcherB.group(2)))
			]
		}

		return null
	}

	private Map parseTreeStepLine(String line) {
		String text = safeValue(line)

		def matcherA = (text =~ /^TEST STEP[:\s]+(.+)$/)
		if (matcherA.find()) {
			String title = cleanupStepTitle(safeValue(matcherA.group(1)))
			if (shouldIgnoreStep(title)) {
				return null
			}
			return [
				title     : title,
				status    : inferStatusFromTitle(title),
				durationMs: 1000L
			]
		}

		def matcherB = (text =~ /^(\d+)\s*-\s*(.+?)(?:\s+\(([\d.,]+s)\))?$/)
		if (matcherB.find()) {
			String title = cleanupStepTitle(safeValue(matcherB.group(2)))
			if (shouldIgnoreStep(title)) {
				return null
			}

			long durationMs = toMillisFromCompactSeconds(safeValue(matcherB.group(3)))
			if (durationMs <= 0L) {
				durationMs = 1000L
			}

			return [
				title     : title,
				status    : inferStatusFromTitle(title),
				durationMs: durationMs
			]
		}

		return null
	}

	// =========================================================================
	// RUNTIME SCENARIO PARSER
	// =========================================================================

	private List<Map> parseRuntimeScenariosFromExecutionLog(File reportDir) {
		File logFile = findExecutionLog(reportDir)
		if (logFile == null || !logFile.exists() || !logFile.isFile()) {
			return []
		}

		List<String> rawLines = readFileLines(logFile)
		if (rawLines.isEmpty()) {
			return []
		}

		List<Map> scenarios = []
		Map currentScenario = null

		for (String rawLine : rawLines) {
			String timeLabel = extractTimeLabel(rawLine)
			long timestampMs = extractTimeMillis(rawLine)
			String line = sanitizeLogLine(rawLine)

			if (isBlank(line)) {
				continue
			}

			String startTitle = extractStartTestCaseTitle(line)
			if (!isBlank(startTitle)) {
				currentScenario = finishScenario(currentScenario)
				if (currentScenario != null) {
					scenarios << currentScenario
				}

				if (shouldIgnoreTestCase(startTitle)) {
					currentScenario = null
					continue
				}

				currentScenario = newScenarioMap('scenario-' + (scenarios.size() + 1), normalizeTestCaseTitle(startTitle))
				if (!isBlank(timeLabel)) {
					currentScenario.startLabel = timeLabel
				}
				currentScenario.startMillis = timestampMs
				continue
			}

			String endTitle = extractEndTestCaseTitle(line)
			if (!isBlank(endTitle)) {
				if (currentScenario != null) {
					if (!isBlank(timeLabel)) {
						currentScenario.endLabel = timeLabel
					}
					currentScenario.endMillis = timestampMs

					long startMillis = toLong(currentScenario.startMillis)
					long endMillis = toLong(currentScenario.endMillis)
					if (startMillis > 0L && endMillis > startMillis) {
						currentScenario.durationMs = endMillis - startMillis
						currentScenario.durationLabel = formatDurationFull(toLong(currentScenario.durationMs))
					}

					currentScenario = finishScenario(currentScenario)
					if (currentScenario != null) {
						scenarios << currentScenario
					}
					currentScenario = null
				}
				continue
			}

			if (currentScenario == null) {
				continue
			}

			Map stepMatch = parseTreeStepLine(line)
			if (stepMatch != null) {
				Map step = [
					id           : currentScenario.id + '-step-' + (((currentScenario.steps ?: []).size()) + 1),
					title        : safeValue(stepMatch.title),
					status       : safeValue(stepMatch.status),
					timeLabel    : timeLabel,
					timestampMs  : timestampMs,
					durationMs   : toLong(stepMatch.durationMs),
					durationLabel: formatDurationFull(toLong(stepMatch.durationMs)),
					detailText   : safeValue(stepMatch.title),
					detailLines  : [safeValue(stepMatch.title)],
					errorLines   : [],
					errorFull    : '',
					shortError   : '',
					emoji        : resolveStepEmoji(stepMatch.title)
				]
				currentScenario.steps << finishStep(step)
				continue
			}

			if (looksLikeErrorLine(line)) {
				Map errorStep = [
					id           : currentScenario.id + '-step-' + (((currentScenario.steps ?: []).size()) + 1),
					title        : 'Execution failure',
					status       : 'failed',
					timeLabel    : timeLabel,
					timestampMs  : timestampMs,
					durationMs   : 1000L,
					durationLabel: formatDurationFull(1000L),
					detailText   : line,
					detailLines  : [line],
					errorLines   : [line],
					errorFull    : line,
					shortError   : extractShortError(line),
					emoji        : '❌'
				]
				currentScenario.steps << finishStep(errorStep)
				continue
			}
		}

		currentScenario = finishScenario(currentScenario)
		if (currentScenario != null) {
			scenarios << currentScenario
		}

		return scenarios
	}

	private String extractStartTestCaseTitle(String line) {
		String text = safeValue(line)

		def matcher = (text =~ /^START\s+(Test Cases\/.+)$/)
		if (matcher.find()) {
			return safeValue(matcher.group(1))
		}

		return ''
	}

	private String extractEndTestCaseTitle(String line) {
		String text = safeValue(line)

		def matcher = (text =~ /^END\s+(Test Cases\/.+)$/)
		if (matcher.find()) {
			return safeValue(matcher.group(1))
		}

		return ''
	}

	// =========================================================================
	// XML FALLBACK
	// =========================================================================

	private List<Map> parseXmlCases(String xmlPath) {
		File xmlFile = new File(xmlPath)
		if (!xmlFile.exists() || !xmlFile.isFile()) {
			return []
		}

		try {
			def root = new XmlSlurper(false, false).parse(xmlFile)
			List<Map> result = []

			root.depthFirst().findAll { node ->
				safeValue(node.name()) == 'testcase'
			}.eachWithIndex { testcase, int index ->
				String className = safeValue(testcase.@classname)
				String testName = safeValue(testcase.@name)
				String time = safeValue(testcase.@time)

				def failureNode = testcase.failure?.size() > 0 ? testcase.failure[0] : null
				def errorNode = testcase.error?.size() > 0 ? testcase.error[0] : null
				def skippedNode = testcase.skipped?.size() > 0 ? testcase.skipped[0] : null

				boolean failed = failureNode != null || errorNode != null
				boolean skipped = skippedNode != null

				String message = ''
				String details = ''

				if (failureNode != null) {
					message = safeValue(failureNode.@message)
					details = safeValue(failureNode.text())
				} else if (errorNode != null) {
					message = safeValue(errorNode.@message)
					details = safeValue(errorNode.text())
				} else if (skippedNode != null) {
					message = safeValue(skippedNode.@message)
					details = safeValue(skippedNode.text())
				}

				result << [
					index      : index + 1,
					name       : !isBlank(testName) ? testName : className,
					shortName  : !isBlank(testName) ? testName : className,
					durationMs : toMillisFromCompactSeconds(time),
					status     : skipped ? 'skipped' : (failed ? 'failed' : 'passed'),
					message    : message,
					details    : details
				]
			}

			return result
		} catch (Exception ignored) {
			return []
		}
	}

	private List<Map> buildFallbackScenarios(List<Map> xmlCases) {
		List<Map> scenarios = []

		xmlCases.eachWithIndex { Map xmlCase, int index ->
			String title = safeValue(xmlCase.shortName)
			if (isBlank(title)) {
				title = 'Test ' + (index + 1)
			}

			long durationMs = toLong(xmlCase.durationMs)
			if (durationMs <= 0L) {
				durationMs = 1000L
			}

			scenarios << [
				id             : 'scenario-' + (index + 1),
				title          : title,
				status         : safeValue(xmlCase.status),
				startLabel     : '',
				endLabel       : '',
				durationMs     : durationMs,
				durationLabel  : formatDurationFull(durationMs),
				steps          : [[
					id           : 'step-' + (index + 1) + '-1',
					title        : title,
					status       : safeValue(xmlCase.status),
					timeLabel    : '',
					durationMs   : durationMs,
					durationLabel: formatDurationFull(durationMs),
					detailText   : title,
					shortError   : extractShortError(xmlCase.message ?: xmlCase.details),
					errorFull    : safeValue(xmlCase.details),
					emoji        : resolveStepEmoji(title)
				]],
				errorShort     : extractShortError(xmlCase.message ?: xmlCase.details),
				errorFull      : safeValue(xmlCase.details),
				sidebarSubtitle: extractShortError(xmlCase.message ?: xmlCase.details),
				evidences      : []
			]
		}

		return scenarios
	}

	// =========================================================================
	// NORMALIZATION
	// =========================================================================

	private Map newScenarioMap(String id, String title) {
		return [
			id             : id,
			title          : title,
			status         : 'passed',
			startLabel     : '',
			endLabel       : '',
			startMillis    : 0L,
			endMillis      : 0L,
			durationMs     : 0L,
			durationLabel  : formatDurationFull(0L),
			steps          : [],
			errorShort     : '',
			errorFull      : '',
			sidebarSubtitle: '',
			evidences      : []
		]
	}

	private Map finishStep(Map currentStep) {
		if (currentStep == null) {
			return null
		}

		if (isBlank(currentStep.status)) {
			currentStep.status = 'passed'
		}

		List<String> detailLines = currentStep.detailLines instanceof List ? (currentStep.detailLines as List<String>) : []
		List<String> errorLines = currentStep.errorLines instanceof List ? (currentStep.errorLines as List<String>) : []

		if (!detailLines.isEmpty()) {
			currentStep.detailText = normalizeText(detailLines)
		} else if (isBlank(currentStep.detailText)) {
			currentStep.detailText = safeValue(currentStep.title)
		}

		if (!errorLines.isEmpty()) {
			currentStep.errorFull = normalizeText(errorLines)
		}

		if (isBlank(currentStep.shortError)) {
			currentStep.shortError = extractShortError(currentStep.errorFull ?: currentStep.detailText)
		}

		if (toLong(currentStep.durationMs) <= 0L) {
			currentStep.durationMs = 1000L
		}

		currentStep.durationLabel = formatDurationFull(toLong(currentStep.durationMs))
		return currentStep
	}

	private Map finishScenario(Map currentScenario) {
		if (currentScenario == null) {
			return null
		}

		List<Map> steps = currentScenario.steps instanceof List ? (currentScenario.steps as List<Map>) : []

		if (steps.isEmpty()) {
			steps << [
				id           : currentScenario.id + '-step-1',
				title        : safeValue(currentScenario.title),
				status       : 'passed',
				timeLabel    : safeValue(currentScenario.startLabel),
				durationMs   : Math.max(1000L, toLong(currentScenario.durationMs)),
				durationLabel: formatDurationFull(Math.max(1000L, toLong(currentScenario.durationMs))),
				detailText   : safeValue(currentScenario.title),
				shortError   : '',
				errorFull    : '',
				emoji        : resolveStepEmoji(currentScenario.title)
			]
			currentScenario.steps = steps
		}

		applyStepDurationsFromTimestamps(steps)

		long stepsTotal = sumStepDurations(steps)
		if (stepsTotal > 0L && stepsTotal > toLong(currentScenario.durationMs)) {
			currentScenario.durationMs = stepsTotal
		}

		if (toLong(currentScenario.durationMs) <= 0L) {
			currentScenario.durationMs = 1000L
		}

		currentScenario.durationLabel = formatDurationFull(toLong(currentScenario.durationMs))
		currentScenario.status = resolveScenarioStatus(steps)
		currentScenario.errorShort = resolveScenarioErrorShort(steps)
		currentScenario.errorFull = resolveScenarioErrorFull(steps)
		currentScenario.sidebarSubtitle = isBlank(currentScenario.errorShort) ? safeValue(currentScenario.title) : currentScenario.errorShort

		Map firstTimedStep = steps.find { Map item -> !isBlank(item.timeLabel) }
		Map lastTimedStep = null
		for (int i = steps.size() - 1; i >= 0; i--) {
			if (!isBlank(steps[i].timeLabel)) {
				lastTimedStep = steps[i]
				break
			}
		}

		if (isBlank(currentScenario.startLabel) && firstTimedStep != null) {
			currentScenario.startLabel = safeValue(firstTimedStep.timeLabel)
		}
		if (isBlank(currentScenario.endLabel) && lastTimedStep != null) {
			currentScenario.endLabel = safeValue(lastTimedStep.timeLabel)
		}

		return currentScenario
	}

	private void normalizeScenarioSteps(List<Map> scenarios) {
		scenarios.each { Map scenario ->
			List<Map> currentSteps = scenario.steps instanceof List ? (scenario.steps as List<Map>) : []

			currentSteps.eachWithIndex { Map step, int idx ->
				step.id = isBlank(step.id) ? (scenario.id + '-step-' + (idx + 1)) : safeValue(step.id)
				step.title = cleanupStepTitle(step.title ?: step.detailText)
				step.emoji = resolveStepEmoji(step.title)
				step.durationMs = toLong(step.durationMs) > 0L ? toLong(step.durationMs) : 1000L
				step.durationLabel = formatDurationFull(toLong(step.durationMs))
				step.timeLabel = safeValue(step.timeLabel)
				step.detailText = isBlank(step.detailText) ? safeValue(step.title) : safeValue(step.detailText)
				step.shortError = safeValue(step.shortError)
				step.errorFull = safeValue(step.errorFull)
				step.status = isBlank(step.status) ? 'passed' : safeValue(step.status)
			}

			List<Map> steps = scenario.steps instanceof List ? (scenario.steps as List<Map>) : []
			scenario.status = resolveScenarioStatus(steps)
			scenario.errorShort = resolveScenarioErrorShort(steps)
			scenario.errorFull = resolveScenarioErrorFull(steps)
			scenario.sidebarSubtitle = isBlank(scenario.errorShort) ? safeValue(scenario.title) : scenario.errorShort
			scenario.durationMs = toLong(scenario.durationMs) > 0L ? toLong(scenario.durationMs) : sumStepDurations(steps)
			scenario.durationLabel = formatDurationFull(toLong(scenario.durationMs))
		}
	}

	private void applyStepDurationsFromTimestamps(List<Map> steps) {
		if (steps == null || steps.isEmpty()) {
			return
		}

		for (int i = 0; i < steps.size(); i++) {
			Map current = steps[i]
			Map next = i + 1 < steps.size() ? steps[i + 1] : null

			long currentMs = toLong(current.timestampMs)
			long nextMs = next != null ? toLong(next.timestampMs) : 0L

			if (currentMs > 0L && nextMs > currentMs) {
				current.durationMs = nextMs - currentMs
				current.durationLabel = formatDurationFull(toLong(current.durationMs))
			}
		}
	}

	private String resolveScenarioStatus(List<Map> steps) {
		boolean hasFailed = steps.any { Map item -> safeValue(item.status) == 'failed' }
		if (hasFailed) {
			return 'failed'
		}

		boolean hasPassed = steps.any { Map item -> safeValue(item.status) == 'passed' }
		if (hasPassed) {
			return 'passed'
		}

		boolean hasInfo = steps.any { Map item -> safeValue(item.status) == 'info' }
		if (hasInfo) {
			return 'info'
		}

		return 'skipped'
	}

	private String resolveScenarioErrorShort(List<Map> steps) {
		Map failedStep = steps.find { Map item -> safeValue(item.status) == 'failed' }
		if (failedStep == null) {
			return ''
		}
		return extractShortError(failedStep.shortError ?: failedStep.errorFull ?: failedStep.detailText)
	}

	private String resolveScenarioErrorFull(List<Map> steps) {
		Map failedStep = steps.find { Map item -> safeValue(item.status) == 'failed' }
		if (failedStep == null) {
			return ''
		}
		return safeValue(failedStep.errorFull ?: failedStep.detailText)
	}

	private void applySequentialTimingFallback(File reportDir, List<Map> scenarios) {
		if (scenarios.isEmpty()) {
			return
		}

		scenarios.each { Map scenario ->
			long stepTotal = sumStepDurations((scenario.steps ?: []) as List<Map>)
			if (stepTotal > toLong(scenario.durationMs)) {
				scenario.durationMs = stepTotal
			}
			scenario.durationLabel = formatDurationFull(toLong(scenario.durationMs))
		}

		long totalDurationMs = 0L
		scenarios.each { Map item ->
			totalDurationMs += toLong(item.durationMs)
		}

		Date suiteEnd = new Date(reportDir.lastModified())
		Date suiteStart = new Date(suiteEnd.time - totalDurationMs)

		long cursor = suiteStart.time

		scenarios.each { Map scenario ->
			long scenarioDuration = toLong(scenario.durationMs)
			if (scenarioDuration <= 0L) {
				scenarioDuration = Math.max(1000L, sumStepDurations((scenario.steps ?: []) as List<Map>))
			}

			if (isBlank(scenario.startLabel)) {
				scenario.startLabel = formatTimeOnly(new Date(cursor))
			}

			if (isBlank(scenario.endLabel)) {
				scenario.endLabel = formatTimeOnly(new Date(cursor + scenarioDuration))
			}

			fillStepTimeLabels(scenario)
			scenario.durationMs = scenarioDuration
			scenario.durationLabel = formatDurationFull(scenarioDuration)

			cursor += scenarioDuration
		}
	}

	private void fillStepTimeLabels(Map scenario) {
		List<Map> steps = scenario.steps instanceof List ? (scenario.steps as List<Map>) : []
		if (steps.isEmpty()) {
			return
		}

		Date scenarioStart = parseTimeOnly(safeValue(scenario.startLabel))
		if (scenarioStart == null) {
			return
		}

		long cursor = scenarioStart.time

		steps.each { Map step ->
			if (isBlank(step.timeLabel)) {
				step.timeLabel = formatTimeOnly(new Date(cursor))
			}

			long stepDuration = toLong(step.durationMs)
			if (stepDuration <= 0L) {
				stepDuration = 1000L
			}

			cursor += stepDuration
		}
	}

