            font-size: 18px;
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: 6px;
            color: #ffffff;
        }

        .report-subtitle {
            font-size: 13px;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.92);
        }

        .banner-right {
            text-align: right;
            font-size: 11px;
            line-height: 1.55;
            color: rgba(255, 255, 255, 0.96);
        }

        .page {
            display: grid;
            grid-template-columns: 470px minmax(0, 1fr);
            min-height: calc(100vh - 110px);
        }

        .sidebar {
            background: #ffffff;
            border-right: 1px solid #dbe3ee;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: calc(100vh - 110px);
        }

        .tabs {
            display: grid;
            grid-template-columns: 1fr 1fr;
            border-bottom: 1px solid #e5e7eb;
        }

        .tab-button {
            height: 54px;
            border: 0;
            background: #ffffff;
            color: #374151;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            border-bottom: 2px solid transparent;
        }

        .tab-button.active {
            color: #111827;
            border-bottom-color: #5b92ff;
            background: #fbfdff;
        }

        .sidebar-body {
            padding: 16px 18px 18px 18px;
            flex: 1;
            overflow: auto;
        }

        .search-box {
            width: 100%;
            height: 42px;
            border: 1px solid #d0d7e2;
            border-radius: 8px;
            padding: 0 14px;
            font-size: 14px;
            outline: none;
            color: #111827;
            background: #ffffff;
            box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.03);
            margin-bottom: 16px;
        }

        .search-box:focus {
            border-color: #7aa7ff;
            box-shadow: 0 0 0 3px rgba(91, 146, 255, 0.12);
        }

        .scenario-list {
            border-top: 1px solid #edf1f7;
        }

        .scenario-item {
            width: 100%;
            padding: 16px 12px 16px 16px;
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 16px;
            background: #ffffff;
            border: 0;
            border-bottom: 1px solid #edf1f7;
            text-align: left;
            cursor: pointer;
            position: relative;
        }

        .scenario-item.active::before {
            content: '';
            position: absolute;
            left: 0;
            top: 12px;
            bottom: 12px;
            width: 3px;
            border-radius: 999px;
            background: #4b82f0;
        }

        .scenario-item:hover {
            background: #fafcff;
        }

        .scenario-name {
            font-size: 14px;
            font-weight: 700;
            color: #111827;
            line-height: 1.35;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-bottom: 8px;
        }

        .scenario-summary {
            font-size: 13px;
            color: #6b7280;
            line-height: 1.35;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin-bottom: 8px;
        }

        .scenario-meta-line {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 12px;
            color: #6b7280;
        }

        .scenario-right {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            justify-content: center;
            gap: 10px;
            min-width: 96px;
        }

        .chip {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 30px;
            padding: 0 14px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
            line-height: 1;
            white-space: nowrap;
        }

        .chip.failed {
            background: #df644e;
            color: #ffffff;
        }

        .chip.passed {
            background: #78b83a;
            color: #ffffff;
        }

        .chip.skipped {
            background: #d5b31c;
            color: #ffffff;
        }

        .chip.info {
            background: #3b82f6;
            color: #ffffff;
        }

        .chip.gradient {
            background: linear-gradient(90deg, rgba(8, 52, 111, 0.88) 0%, rgba(95, 224, 111, 0.88) 100%);
            color: #ffffff;
        }

        .chip.suite {
            background: #f3f4f6;
            color: #111827;
        }

        .scenario-duration {
            font-size: 12px;
            color: #6b7280;
        }

        .sidebar-empty {
            padding: 26px 8px;
            font-size: 13px;
            color: #6b7280;
        }

        .main {
            background: #ffffff;
            padding: 20px 28px 30px 28px;
            overflow: auto;
        }

        .main-card {
            max-width: 100%;
        }

        .main-scenario-title {
            font-size: 18px;
            font-weight: 700;
            color: #111827;
            margin: 4px 0 16px 0;
            line-height: 1.35;
        }

        .meta-row {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 22px;
        }

        .section-title {
            font-size: 15px;
            font-weight: 700;
            color: #111827;
            margin: 0 0 12px 0;
        }

        .steps-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            margin-bottom: 20px;
        }

        .steps-table thead th {
            text-align: left;
            font-size: 12px;
            color: #6b7280;
            font-weight: 700;
            padding: 0 12px 10px 0;
            letter-spacing: 0.02em;
        }

        .steps-table tbody tr {
            border-bottom: 1px solid #ebeff5;
        }

        .steps-table tbody td {
            vertical-align: middle;
            padding: 12px 12px 12px 0;
            font-size: 13px;
            color: #111827;
        }

        .steps-table .status-cell {
            width: 112px;
        }

        .steps-table .time-cell {
            width: 120px;
            color: #4b5563;
            font-weight: 600;
        }

        .step-detail {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }

        .step-icon {
            font-size: 16px;
            line-height: 1;
            flex: 0 0 auto;
        }

        .step-text {
            min-width: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .error-panel,
        .evidence-panel {
            margin-top: 20px;
            padding: 14px 16px 16px 16px;
            border-left: 3px solid #d64f43;
            background: #fffefe;
            border-radius: 8px;
            box-shadow: 0 1px 4px rgba(15, 23, 42, 0.05);
        }

        .evidence-panel {
            border-left-color: #3b82f6;
        }

        .error-panel .panel-title,
        .evidence-panel .panel-title {
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 8px;
            color: #7c2d12;
        }

        .evidence-panel .panel-title {
            color: #1d4ed8;
        }

        .error-summary-line {
            font-size: 13px;
            color: #111827;
            margin-bottom: 10px;
            line-height: 1.45;
        }

        .detail-toggle {
            display: inline-block;
            margin-bottom: 10px;
            color: #2563eb;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            user-select: none;
        }

        .detail-box {
            display: none;
            margin-top: 8px;
            background: #06162f;
            color: #f8fafc;
            border-radius: 8px;
            padding: 14px;
            overflow: auto;
            font-size: 12px;
            line-height: 1.55;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .detail-box.open {
            display: block;
        }

        .evidence-item {
            margin-top: 10px;
        }

        .evidence-image {
            display: block;
            width: 100%;
            max-width: 980px;
            height: auto;
            margin-top: 10px;
            border-radius: 8px;
            background: transparent;
            box-shadow: none;
        }

        .charts-wrap {
            display: grid;
            grid-template-columns: 360px minmax(0, 1fr);
            gap: 28px;
            align-items: start;
        }

        .chart-donut-panel,
        .chart-bars-panel {
            background: #ffffff;
            border: 1px solid #edf1f7;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 1px 4px rgba(15, 23, 42, 0.04);
        }

        .donut-wrap {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 16px;
        }

        .donut {
            width: 300px;
            height: 300px;
            border-radius: 50%;
            position: relative;
            background: #e5e7eb;
        }

        .donut::after {
            content: '';
            position: absolute;
            inset: 44px;
            border-radius: 50%;
            background: #ffffff;
        }

        .donut-center {
            position: absolute;
            inset: 0;
            z-index: 2;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            color: #111827;
        }

        .donut-center .big {
            font-size: 32px;
            line-height: 1;
            margin-bottom: 6px;
        }

        .donut-center .small {
            font-size: 14px;
            color: #6b7280;
        }

        .legend-list {
            width: 100%;
            margin-top: 8px;
        }

        .legend-row {
            display: grid;
            grid-template-columns: 18px 1fr auto;
            gap: 10px;
            align-items: center;
            margin-bottom: 12px;
            font-size: 14px;
            color: #111827;
        }

        .legend-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        .bars-stack {
            display: flex;
            flex-direction: column;
            gap: 22px;
            margin-top: 16px;
        }

        .bar-row {
            display: grid;
            grid-template-columns: 90px 1fr 52px;
            gap: 16px;
            align-items: center;
        }

        .bar-label {
            font-size: 15px;
            font-weight: 700;
            color: #111827;
        }

        .bar-track {
            width: 100%;
            height: 6px;
            border-radius: 999px;
            background: #e5e7eb;
            overflow: hidden;
        }

        .bar-fill {
            height: 100%;
            border-radius: 999px;
        }

        .bar-value {
            text-align: right;
            font-size: 14px;
            font-weight: 700;
            color: #111827;
        }

        .main-empty {
            padding: 38px 12px;
            color: #6b7280;
            font-size: 14px;
        }

        @media (max-width: 1400px) {
            .page {
                grid-template-columns: 420px minmax(0, 1fr);
            }

            .charts-wrap {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 1024px) {
            .page {
                grid-template-columns: 1fr;
            }

            .sidebar {
                min-height: auto;
                border-right: 0;
                border-bottom: 1px solid #dbe3ee;
            }

            .main {
                padding: 18px;
            }

            .donut {
                width: 240px;
                height: 240px;
            }

            .donut::after {
                inset: 34px;
            }
        }
    </style>
</head>
<body>
    <header class="top-banner">
        <div class="banner-left">
            <div class="brand-logo" id="brandLogo"></div>
            <div>
                <div class="report-title" id="reportTitle"></div>
                <div class="report-subtitle" id="reportSubtitle"></div>
            </div>
        </div>
        <div class="banner-right">
            <div id="generatedText"></div>
            <div id="projectText"></div>
        </div>
    </header>

    <div class="page">
        <aside class="sidebar">
            <div class="tabs">
                <button id="tabTests" class="tab-button active" type="button">Tests</button>
                <button id="tabCharts" class="tab-button" type="button">Charts</button>
            </div>

            <div class="sidebar-body">
                <input id="scenarioSearch" class="search-box" type="text" placeholder="Search test name, path, or status.">
                <div id="sidebarList" class="scenario-list"></div>
            </div>
        </aside>

        <main class="main">
            <div id="mainContent"></div>
        </main>
    </div>

    <script id="reportModel" type="application/json">${modelJson}</script>
    <script>
        const reportModel = JSON.parse(document.getElementById('reportModel').textContent);
        let currentTab = 'tests';
        let currentScenarioId = reportModel.defaultScenarioId || (reportModel.scenarios && reportModel.scenarios.length ? reportModel.scenarios[0].id : '');

        function escapeHtml(value) {
            if (value === null || value === undefined) {
                return '';
            }

            return String(value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function safe(value) {
            return value === null || value === undefined ? '' : String(value);
        }

        function statusClass(status) {
            const current = safe(status).toLowerCase();
            if (current === 'passed') return 'passed';
            if (current === 'failed') return 'failed';
            if (current === 'skipped') return 'skipped';
            return 'info';
        }

        function statusText(status) {
            const current = safe(status).toLowerCase();
            if (current === 'passed') return 'Passed';
            if (current === 'failed') return 'Failed';
            if (current === 'skipped') return 'Skipped';
            return 'Info';
        }

        function stepIcon(step) {
            const title = safe(step && step.title).toLowerCase();
            const status = safe(step && step.status).toLowerCase();

            if (status === 'failed') return '❌';
            if (status === 'passed' && (title.indexOf('open') >= 0 || title.indexOf('portal') >= 0 || title.indexOf('navigate') >= 0)) return '🌐';
            if (title.indexOf('wait') >= 0 || title.indexOf('search') >= 0 || title.indexOf('find') >= 0) return '🔎';
            if (title.indexOf('click') >= 0 || title.indexOf('select') >= 0 || title.indexOf('reload') >= 0) return '🖱️';
            if (title.indexOf('import') >= 0 || title.indexOf('file') >= 0) return '📄';
            if (title.indexOf('excel') >= 0 || title.indexOf('table') >= 0) return '🧾';
            if (status === 'passed') return '✅';
            if (status === 'skipped') return '⏭️';
            return 'ℹ️';
        }

        function filteredScenarios() {
            const query = safe(document.getElementById('scenarioSearch').value).toLowerCase().trim();
            if (!query) {
                return reportModel.scenarios || [];
            }

            return (reportModel.scenarios || []).filter(function(item) {
                const text = [
                    safe(item.name),
                    safe(item.summary),
                    safe(item.status),
                    safe(item.startClock)
                ].join(' ').toLowerCase();

                return text.indexOf(query) >= 0;
            });
        }

        function renderHeader() {
            const logoContainer = document.getElementById('brandLogo');
            const logo = safe(reportModel.logoDataUri);

            if (logo) {
                logoContainer.innerHTML = '<img src="' + escapeHtml(logo) + '" alt="GAIA">';
            } else {
                logoContainer.innerHTML = '<div class="brand-logo-fallback">Gaia</div>';
            }

            document.getElementById('reportTitle').textContent = safe(reportModel.reportTitle);
            document.getElementById('reportSubtitle').textContent = safe(reportModel.reportSubtitle);
            document.getElementById('generatedText').textContent = 'Generated ' + safe(reportModel.generatedAt);
            document.getElementById('projectText').textContent = 'Project ' + safe(reportModel.appName);
        }

        function renderSidebar() {
            const list = document.getElementById('sidebarList');
            const search = document.getElementById('scenarioSearch');

            if (currentTab !== 'tests') {
                search.style.display = 'none';
                list.innerHTML = '';
                return;
            }

            search.style.display = 'block';

            const items = filteredScenarios();
            if (!items.length) {
                list.innerHTML = '<div class="sidebar-empty">No scenarios found.</div>';
                return;
            }

            let html = '';
            items.forEach(function(item) {
                const activeClass = item.id === currentScenarioId ? ' active' : '';
                html += ''
                    + '<button type="button" class="scenario-item' + activeClass + '" data-id="' + escapeHtml(item.id) + '">'
                    +   '<div>'
                    +       '<div class="scenario-name">' + escapeHtml(item.name) + '</div>'
                    +       '<div class="scenario-summary">' + escapeHtml(item.summary || '') + '</div>'
                    +       '<div class="scenario-meta-line">'
                    +           '<span>' + escapeHtml(item.startClock || '') + '</span>'
                    +       '</div>'
                    +   '</div>'
                    +   '<div class="scenario-right">'
                    +       '<span class="chip ' + statusClass(item.status) + '">' + escapeHtml(statusText(item.status)) + '</span>'
                    +       '<div class="scenario-duration">' + escapeHtml(item.durationText || '') + '</div>'
                    +   '</div>'
                    + '</button>';
            });

            list.innerHTML = html;

            Array.prototype.slice.call(document.querySelectorAll('.scenario-item')).forEach(function(button) {
                button.addEventListener('click', function() {
                    currentScenarioId = button.getAttribute('data-id');
                    renderSidebar();
                    renderMain();
                });
            });
        }

        function findScenario() {
            const scenarios = reportModel.scenarios || [];
            for (let i = 0; i < scenarios.length; i++) {
                if (safe(scenarios[i].id) === safe(currentScenarioId)) {
                    return scenarios[i];
                }
            }
            return scenarios.length ? scenarios[0] : null;
        }

        function renderStepsTable(scenario) {
            const steps = scenario && scenario.steps ? scenario.steps : [];
            if (!steps.length) {
                return '<div class="main-empty">No step details available.</div>';
            }

            let rows = '';
            steps.forEach(function(step) {
                rows += ''
                    + '<tr>'
                    +   '<td class="status-cell"><span class="chip ' + statusClass(step.status) + '">' + escapeHtml(statusText(step.status)) + '</span></td>'
                    +   '<td class="time-cell">' + escapeHtml(step.timestamp || '') + '</td>'
                    +   '<td>'
                    +       '<div class="step-detail">'
                    +           '<span class="step-icon">' + escapeHtml(stepIcon(step)) + '</span>'
                    +           '<span class="step-text" title="' + escapeHtml(step.title || '') + '">' + escapeHtml(step.title || '') + '</span>'
                    +       '</div>'
                    +   '</td>'
                    + '</tr>';
            });

            return ''
                + '<table class="steps-table">'
                +   '<thead>'
                +       '<tr>'
                +           '<th class="status-cell">STATUS</th>'
                +           '<th class="time-cell">TIMESTAMP</th>'
                +           '<th>DETAILS</th>'
                +       '</tr>'
                +   '</thead>'
                +   '<tbody>' + rows + '</tbody>'
                + '</table>';
        }

        function renderErrorPanel(scenario) {
            if (!scenario || safe(scenario.status).toLowerCase() !== 'failed') {
                return '';
            }

            const summary = escapeHtml(safe(scenario.errorSummary || scenario.summary));
            const full = escapeHtml(safe(scenario.errorDetails));

            return ''
                + '<section class="error-panel">'
                +   '<div class="panel-title">Visual Error Log</div>'
                +   '<div class="error-summary-line">' + summary + '</div>'
                +   '<div class="detail-toggle" onclick="toggleDetail(\\'error_' + escapeHtml(scenario.id) + '\\')">🔎 View full error</div>'
                +   '<div id="error_' + escapeHtml(scenario.id) + '" class="detail-box">' + full + '</div>'
                + '</section>';
        }

        function renderEvidencePanel(scenario) {
            const evidences = scenario && scenario.evidences ? scenario.evidences : [];
            if (!evidences.length) {
                return '';
            }

            let blocks = '';
            evidences.forEach(function(item, index) {
                const targetId = 'evidence_' + safe(scenario.id) + '_' + index;
                blocks += ''
                    + '<div class="evidence-item">'
                    +   '<div class="detail-toggle" onclick="toggleDetail(\\'' + escapeHtml(targetId) + '\\')">🖼 ' + escapeHtml(item.name || 'Evidence') + '</div>'
                    +   '<div id="' + escapeHtml(targetId) + '" class="detail-box">'
                    +       '<img class="evidence-image" src="' + escapeHtml(item.dataUri || '') + '" alt="Evidence">'
                    +   '</div>'
                    + '</div>';
            });

            return ''
                + '<section class="evidence-panel">'
                +   '<div class="panel-title">Evidence</div>'
                +   blocks
                + '</section>';
        }

        function renderScenarioPanel(scenario) {
            if (!scenario) {
                return '<div class="main-empty">No scenario selected.</div>';
            }

            let html = ''
                + '<div class="main-card">'
                +   '<div class="main-scenario-title">' + escapeHtml(scenario.name || '') + '</div>'
                +   '<div class="meta-row">'
                +       '<span class="chip suite">Suite: ' + escapeHtml(reportModel.suiteName || '') + '</span>'
                +       '<span class="chip failed' + (safe(scenario.status).toLowerCase() === 'failed' ? '' : ' ' + statusClass(scenario.status)) + '">Status: ' + escapeHtml(statusText(scenario.status)) + '</span>'
                +       '<span class="chip gradient">Start: ' + escapeHtml(scenario.startClock || '') + '</span>'
                +       '<span class="chip gradient">End: ' + escapeHtml(scenario.endClock || '') + '</span>'
                +       '<span class="chip gradient">Duration: ' + escapeHtml(scenario.durationText || '') + '</span>'
                +   '</div>'
                +   '<div class="section-title">Steps</div>'
                +   renderStepsTable(scenario)
                +   renderErrorPanel(scenario)
                +   renderEvidencePanel(scenario)
                + '</div>';

            return html;
        }

        function donutBackground() {
            const stats = reportModel.stats || {};
            const total = Math.max(1, Number(stats.total || 0));
            const passed = Number(stats.passed || 0);
            const failed = Number(stats.failed || 0);
            const skipped = Number(stats.skipped || 0);

            const passedDeg = (passed / total) * 360;
            const failedDeg = (failed / total) * 360;
            const skippedDeg = (skipped / total) * 360;

            const a = passedDeg;
            const b = passedDeg + failedDeg;
            const c = passedDeg + failedDeg + skippedDeg;

            return 'conic-gradient('
                + '#78b83a 0deg ' + a + 'deg, '
                + '#df644e ' + a + 'deg ' + b + 'deg, '
                + '#d5b31c ' + b + 'deg ' + c + 'deg, '
                + '#e5e7eb ' + c + 'deg 360deg)';
        }

        function barRow(label, value, total, color) {
            const percent = total > 0 ? ((value / total) * 100) : 0;
            return ''
                + '<div class="bar-row">'
                +   '<div class="bar-label">' + escapeHtml(label) + '</div>'
                +   '<div class="bar-track"><div class="bar-fill" style="width:' + percent + '%; background:' + color + ';"></div></div>'
                +   '<div class="bar-value">' + escapeHtml(String(value)) + '</div>'
                + '</div>';
        }

        function renderChartsPanel() {
            const stats = reportModel.stats || {};
            const total = Number(stats.total || 0);
            const passed = Number(stats.passed || 0);
            const failed = Number(stats.failed || 0);
            const skipped = Number(stats.skipped || 0);

            return ''
                + '<div class="charts-wrap">'
                +   '<section class="chart-donut-panel">'
                +       '<div class="section-title">Execution Status</div>'
                +       '<div class="donut-wrap">'
                +           '<div class="donut" style="background:' + donutBackground() + ';">'
                +               '<div class="donut-center"><div class="big">' + escapeHtml(String(total)) + '</div><div class="small">Tests</div></div>'
