package jiraIntegration

import java.io.File
import java.util.Date

import groovy.xml.XmlSlurper

class JiraGaiaReportBuilder {

    JiraFlowCoordinator owner

    JiraGaiaReportBuilder(JiraFlowCoordinator owner) {
        this.owner = owner
    }

    List<Map> parseXmlCases(String xmlPath) {
        JiraFlowCoordinator flow = this.owner
        List<Map> result = []

        if (flow.isBlank(xmlPath)) {
            return result
        }

        File xmlFile = new File(xmlPath)
        if (!xmlFile.exists()) {
            return result
        }

        def xml
        try {
            xml = new XmlSlurper().parse(xmlFile)
        } catch (Exception ignored) {
            return result
        }

        List testcaseNodes = []

        String rootName = flow.safe(xml.name())

        if (rootName == 'testsuite') {
            testcaseNodes.addAll(xml.testcase)
        } else if (rootName == 'testsuites') {
            xml.testsuite.each { suite ->
                testcaseNodes.addAll(suite.testcase)
            }
        }

        testcaseNodes.each { tc ->
            String className = flow.safe(tc.@classname?.text())
            String testName = flow.safe(tc.@name?.text())
            long durationMs = flow.toMillis(tc.@time?.text())

            def failureNode = tc.failure?.size() > 0 ? tc.failure[0] : null
            def errorNode = tc.error?.size() > 0 ? tc.error[0] : null
            def skippedNode = tc.skipped?.size() > 0 ? tc.skipped[0] : null

            boolean failed = failureNode != null || errorNode != null
            boolean skipped = skippedNode != null

            String message = ''
            String details = ''

            if (failureNode != null) {
                message = flow.safe(failureNode.@message?.text())
                details = flow.safe(failureNode.text())
            } else if (errorNode != null) {
                message = flow.safe(errorNode.@message?.text())
                details = flow.safe(errorNode.text())
            } else if (skippedNode != null) {
                message = flow.safe(skippedNode.@message?.text())
                details = flow.safe(skippedNode.text())
            }

            String displayName = ''
            if (!flow.isBlank(className) && !flow.isBlank(testName)) {
                displayName = className + '/' + testName
            } else if (!flow.isBlank(testName)) {
                displayName = testName
            } else {
                displayName = className
            }

            Map row = [:]
            row.name = displayName
            row.shortName = flow.isBlank(testName) ? displayName : testName
            row.durationMs = durationMs
            row.status = skipped ? 'skipped' : (failed ? 'failed' : 'passed')
            row.message = message
            row.details = details

            result.add(row)
        }

        return result
    }

    List<String> getFailureSummaryLines(String message, String details) {
        JiraFlowCoordinator flow = this.owner
        List<String> lines = []

        String safeMessage = flow.safe(message)
        String safeDetails = flow.safe(details)

        if (!flow.isBlank(safeMessage)) {
            lines.add(safeMessage)
        }

        safeDetails.readLines().each { String raw ->
            String line = flow.safe(raw)

            if (flow.isBlank(line)) {
                return
            }

            if (line.startsWith('at ')) {
                return
            }

            if (line.startsWith('Caused by: at ')) {
                return
            }

            if (line.contains('com.kms.katalon') && line.length() > 120) {
                return
            }

            if (line.contains('org.openqa.selenium') && line.length() > 120) {
                return
            }

            lines.add(line)
        }

        List<String> cleaned = []
        lines.each { String item ->
            String normalized = flow.safe(item).replaceAll(/\s+/, ' ').trim()
            if (!flow.isBlank(normalized) && !cleaned.contains(normalized)) {
                cleaned.add(normalized)
            }
        }

        if (cleaned.isEmpty() && !flow.isBlank(safeDetails)) {
            safeDetails.readLines().each { String raw ->
                String line = flow.safe(raw)
                if (!flow.isBlank(line) && cleaned.size() < 3) {
                    cleaned.add(line)
                }
            }
        }

        if (cleaned.size() > 3) {
            return cleaned.subList(0, 3)
        }

        return cleaned
    }

    String buildHeaderCard(String label, String value) {
        JiraFlowCoordinator flow = this.owner
        String safeLabel = flow.htmlEscape(flow.safe(label))
        String safeValue = flow.htmlEscape(flow.safe(value))

        return """
            <div class="stat-card">
                <div class="stat-label">${safeLabel}</div>
                <div class="stat-value">${safeValue}</div>
            </div>
        """
    }

    String buildFailedCaseHtml(Map item, File baseDir) {
        JiraFlowCoordinator flow = this.owner
        StringBuilder block = new StringBuilder()

        String itemName = flow.safe(item.name)
        String itemMessage = flow.safe(item.message)
        String itemDetails = flow.safe(item.details)
        long itemDuration = (item.durationMs ?: 0L) as long

        List<String> summaryLines = getFailureSummaryLines(itemMessage, itemDetails)

        block.append('<div class="case-card failed">\n')
        block.append('<div class="case-title">')
        block.append(flow.htmlEscape(itemName))
        block.append('</div>\n')

        block.append('<div class="case-meta">Duration: ')
        block.append(flow.htmlEscape(flow.formatDurationMillis(itemDuration)))
        block.append('</div>\n')

        summaryLines.each { String line ->
            String safeLine = flow.safe(line)
            block.append('<div class="failure-line">')
            block.append(flow.htmlEscape(safeLine))
            block.append('</div>\n')
        }

        block.append('<div class="details-wrap">\n')
        block.append('<details>\n')
        block.append('<summary>See full error log</summary>\n')
        block.append('<pre>')
        block.append(flow.htmlEscape(itemDetails))
        block.append('</pre>\n')
        block.append('</details>\n')
        block.append('</div>\n')

        File image = item.image as File
        if (image != null && image.exists()) {
            String imgSrc = flow.relativeUri(baseDir, image)
            block.append('<img class="failure-image" src="')
            block.append(flow.htmlEscape(imgSrc))
            block.append('" alt="Failure evidence">\n')
        }

        block.append('</div>\n')
        return block.toString()
    }

    String buildPassedCaseHtml(Map item) {
        JiraFlowCoordinator flow = this.owner
        StringBuilder block = new StringBuilder()

        String itemName = flow.safe(item.name)
        long itemDuration = (item.durationMs ?: 0L) as long

        block.append('<div class="case-card passed">\n')
        block.append('<div class="case-title">')
        block.append(flow.htmlEscape(itemName))
        block.append('</div>\n')

        block.append('<div class="case-meta">Test Passed</div>\n')

        block.append('<div class="case-meta">Duration: ')
        block.append(flow.htmlEscape(flow.formatDurationMillis(itemDuration)))
        block.append('</div>\n')

        block.append('</div>\n')
        return block.toString()
    }

    String buildSkippedCaseHtml(Map item) {
        JiraFlowCoordinator flow = this.owner
        StringBuilder block = new StringBuilder()

        String itemName = flow.safe(item.name)
        long itemDuration = (item.durationMs ?: 0L) as long

        block.append('<div class="case-card skipped">\n')
        block.append('<div class="case-title">')
        block.append(flow.htmlEscape(itemName))
        block.append('</div>\n')

        block.append('<div class="case-meta">Test Skipped</div>\n')

        block.append('<div class="case-meta">Duration: ')
        block.append(flow.htmlEscape(flow.formatDurationMillis(itemDuration)))
        block.append('</div>\n')

        block.append('</div>\n')
        return block.toString()
    }

    String createGaiaHtmlReport(String reportFolder, String suiteName, String xmlPath) {
        JiraFlowCoordinator flow = this.owner

        if (flow.isBlank(reportFolder) || flow.isBlank(xmlPath)) {
            return ''
        }

        List<Map> cases = parseXmlCases(xmlPath)
        List<Map> failedCases = cases.findAll { Map item -> flow.safe(item.status) == 'failed' }
        List<Map> passedCases = cases.findAll { Map item -> flow.safe(item.status) == 'passed' }
        List<Map> skippedCases = cases.findAll { Map item -> flow.safe(item.status) == 'skipped' }

        List<File> failureImages = flow.collectFailureImages(reportFolder)

        int imageIndex = 0
        failedCases.each { Map item ->
            if (imageIndex < failureImages.size()) {
                item.image = failureImages[imageIndex]
                imageIndex++
            } else {
                item.image = null
            }
        }

        long totalDurationMs = 0L
        cases.each { Map item ->
            totalDurationMs += ((item.durationMs ?: 0L) as long)
        }

        File baseDir = new File(reportFolder)
        Date endDate = new Date(baseDir.lastModified())
        Date startDate = new Date(endDate.time - totalDurationMs)

        int executed = cases.size()
        String avgTest = executed > 0
            ? flow.formatDurationMillis((long) (totalDurationMs / executed))
            : '0m 0s 0ms'

        File htmlFile = new File(reportFolder + File.separator + flow.GAIA_REPORT_FILE_NAME)

        StringBuilder html = new StringBuilder()
        html.append('<!DOCTYPE html>\n')
        html.append('<html lang="en">\n')
        html.append('<head>\n')
        html.append('<meta charset="UTF-8">\n')
        html.append('<meta name="viewport" content="width=device-width, initial-scale=1.0">\n')
        html.append('<title>Gaia Test Execution Report</title>\n')
        html.append('''
