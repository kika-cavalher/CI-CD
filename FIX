private long parseDurationToMillis(String raw) {
    String value = safe(raw).replace(',', '.')
    if (blank(value)) {
        return 0L
    }

    def matcher = (value =~ /(?i)([\d.]+)\s*s/)
    if (matcher.find()) {
        try {
            return Math.round(Double.parseDouble(safe(matcher.group(1))) * 1000d)
        } catch (Exception ignored) {
            return 0L
        }
    }

    return 0L
}
