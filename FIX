properties([
    disableConcurrentBuilds()
])

def NODE_LABEL = 'GI5_SWDCFRNXGI55817'

// Ultra short workspace to avoid Windows/Katalon path length issues
def SHORT_WORKSPACE = 'D:\\J\\JLS'

// true = trigger next pipeline
// false = do not trigger any next pipeline
def RUN_NEXT_JOB = true

// Full Jenkins job path for the next pipeline
def NEXT_JOB = 'GI5/eMatch_Regression/Passerelle Bilan'

def executionFailed = false
def manuallyAborted = false

def stopCurrentExecution = {
    bat '''
@echo off
schtasks /end /tn "\\eMatch Automation\\RunEMatchCommand" >nul 2>nul
schtasks /end /tn "startWinDriver" >nul 2>nul
taskkill /f /im WinAppDriver.exe /t >nul 2>nul
taskkill /f /im katalonc.exe /t >nul 2>nul
taskkill /f /im KatalonStudio.exe /t >nul 2>nul
ping -n 6 127.0.0.1 >nul
exit /b 0
'''
}

def runCollection = { String stageName, String cmdName ->
    stage(stageName) {
        try {
            timeout(time: 5, unit: 'HOURS') {
                bat "call \"%WORKSPACE%\\jenkins\\${cmdName}\""
                echo "${stageName} completed successfully."
            }
        } catch (org.jenkinsci.plugins.workflow.steps.FlowInterruptedException err) {
            manuallyAborted = true
            echo "${stageName} was manually aborted."
        } catch (Throwable err) {
            executionFailed = true
            echo "${stageName} failed: ${err}"
        } finally {
            stage("Stop ${stageName}") {
                stopCurrentExecution()
            }
        }
    }
}

node(NODE_LABEL) {
    ws(SHORT_WORKSPACE) {
        stage('Checkout') {
            checkout scm
        }

        runCollection('Investigations Collection', 'JustificationLatentInvestigations.cmd')
        runCollection('Synthese Collection', 'JustificationLatentSynthese.cmd')
        runCollection('Table de Liaison Collection', 'JustificationLatentTableDeLiaison.cmd')
    }
}

if (manuallyAborted) {
    currentBuild.result = 'ABORTED'
    echo 'Build was manually aborted. Next pipeline will not be scheduled.'
    return
}

stage('Trigger next pipeline') {
    if (RUN_NEXT_JOB && NEXT_JOB?.trim()) {
        echo "Scheduling next pipeline: ${NEXT_JOB}"
        build job: NEXT_JOB,
              wait: false,
              propagate: false
    } else {
        echo 'Next pipeline disabled.'
    }
}

currentBuild.result = executionFailed ? 'FAILURE' : 'SUCCESS'
return
