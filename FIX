import static com.kms.katalon.core.testcase.TestCaseFactory.findTestCase

import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows


// ======================================================
// MODULE CONFIG
// ======================================================

String targetEnvironment = 'PRD'
String exportScenarioName = 'JVEmission_emissionValidations'

String menuName = 'Validations'
String menuResultName = 'Validations'
String openedTabName = menuResultName

String asOfDateValue = '30/04/2026'
String currencyValue = 'EUR'

String loginTestCase =
		'Component/Authentication/Login ' +
		targetEnvironment

String closeApplicationTestCase =
		'Component/Authentication/Close Application'


// ======================================================
// TIMEOUT CONFIG
// ======================================================

Integer menuTimeout = 60
Integer filterTimeout = 5
Integer openedTabTimeout = 60

// More time is required for large validation exports.
Integer exportLoadDelay = 10


// ======================================================
// TEST FLOW
// ======================================================

boolean applicationOpened = false

try {

	// ======================================================
	// AUTHENTICATION
	// ======================================================

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'Authenticate and open application\n' +
		'Environment: ' + targetEnvironment
	)

	WebUI.callTestCase(
		findTestCase(loginTestCase),
		[:],
		FailureHandling.STOP_ON_FAILURE
	)

	applicationOpened = true


	// ======================================================
	// OPEN MODULE
	// ======================================================

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'Open target module\n' +
		'Search: ' + menuName + '\n' +
		'Result: ' + menuResultName
	)

	CustomKeywords.'component.MenuNavigator.searchAndOpenMenuByText'(
		menuName,
		menuResultName,
		menuTimeout
	)


	// ======================================================
	// VALIDATE OPENED TAB
	// ======================================================

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'Validate opened tab\n' +
		'Expected tab: ' + openedTabName
	)

	boolean tabOpened =
		Windows.waitForElementPresent(
			CustomKeywords.'commands.WindowsObjectLoader.getTabByName'(
				openedTabName
			),
			openedTabTimeout,
			FailureHandling.OPTIONAL
		)

	if (!tabOpened) {

		CustomKeywords.'commands.ImageLoader.takeEvidence'(
			targetEnvironment +
			'_EmissionValidation_TabNotOpened.png'
		)

		KeywordUtil.markFailedAndStop(
			'Validations tab was not opened.\n' +
			'Expected tab: ' + openedTabName
		)
	}

	CustomKeywords.'commands.ImageLoader.takeEvidence'(
		targetEnvironment +
		'_OpenEmissionValidation.png'
	)


	// ======================================================
	// APPLY FILTERS
	// ======================================================

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'Apply Recherche filters\n' +
		'As Of Date: ' + asOfDateValue + '\n' +
		'Currency: ' + currencyValue
	)

	CustomKeywords.'component.RechercheFilterKeywords.applyEmissionFiltreeFilters'(
		asOfDateValue,
		currencyValue,
		filterTimeout
	)

	CustomKeywords.'commands.ImageLoader.takeEvidence'(
		targetEnvironment +
		'_EmissionValidation_SearchResult.png'
	)


	// ======================================================
	// WAIT BEFORE EXPORT
	// ======================================================

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'Wait for filtered content before export\n' +
		'Delay: ' + exportLoadDelay + ' seconds'
	)

	Windows.delay(exportLoadDelay)


	// ======================================================
	// EXPORT FILE
	// ======================================================

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'Export filtered Emission Validation table\n' +
		'Flow: Exports tab > Export button > Save > Non\n' +
		'Environment: ' + targetEnvironment + '\n' +
		'Export scenario: ' + exportScenarioName
	)

	CustomKeywords.'commands.ExportFile.exportFromTwoExportImagesToNo'(
		exportScenarioName,
		targetEnvironment
	)

	CustomKeywords.'commands.ImageLoader.takeEvidence'(
		targetEnvironment +
		'_EmissionValidation_ExportCompleted.png'
	)


	// ======================================================
	// FINAL RESULT
	// ======================================================

	KeywordUtil.markPassed(
		targetEnvironment +
		' Emission Validation filters and export completed successfully.'
	)

} finally {

	// ======================================================
	// CLOSE APPLICATION
	// ======================================================

	if (applicationOpened) {

		CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
			'Close application\n' +
			'Environment: ' + targetEnvironment
		)

		try {

			WebUI.callTestCase(
				findTestCase(closeApplicationTestCase),
				[:],
				FailureHandling.CONTINUE_ON_FAILURE
			)

		} catch (Exception exception) {

			KeywordUtil.logInfo(
				'Application close step returned an error.\n' +
				'Reason: ' +
				safeText(exception.getMessage())
			)
		}
	}
}


// ======================================================
// HELPERS
// ======================================================

String safeText(Object value) {

	if (value == null) {
		return ''
	}

	return value.toString().trim()
}
