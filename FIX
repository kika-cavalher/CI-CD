@echo off
setlocal EnableExtensions EnableDelayedExpansion

rem ============================================================
rem  eMatch Desktop runner (Task Scheduler)
rem  Reads:  D:\Projects\eMatchStarters\run-context.properties
rem  Writes: marker file (atomic) + log file
rem ============================================================

set "CTX_FILE=D:\Projects\eMatchStarters\run-context.properties"

rem Default fallback marker (safe location, not inside Reports)
set "MARKER_FILE=D:\Projects\eMatchStarters\logs\__jenkins_task_exitcode.txt"

rem Ensure logs folder exists
if not exist "D:\Projects\eMatchStarters\logs" (
  mkdir "D:\Projects\eMatchStarters\logs" >nul 2>&1
)

rem Build log file name
for /f %%i in ('powershell -NoProfile -Command "(Get-Date).ToString(\"yyyyMMdd_HHmmss\")"') do set "TS=%%i"
set "LOG_FILE=D:\Projects\eMatchStarters\logs\katalon_%TS%.log"

rem Start log
echo [INFO] Starting run-ematch-command.bat > "%LOG_FILE%"
echo [INFO] CTX_FILE=%CTX_FILE% >> "%LOG_FILE%"

rem Validate context exists
if not exist "%CTX_FILE%" (
  echo [ERROR] Context file not found: %CTX_FILE% >> "%LOG_FILE%"
  call :WriteMarker 2 "CTX_FILE_NOT_FOUND"
  exit /b 2
)

rem Load context key=val
for /f "usebackq tokens=1,* delims==" %%A in ("%CTX_FILE%") do (
  set "K=%%A"
  set "V=%%B"
  if not "!K!"=="" set "!K!=!V!"
)

rem Allow Jenkins to override marker location
if not "%MARKER_FILE%"=="" set "MARKER_FILE=%MARKER_FILE%"

rem Print resolved context
echo. >> "%LOG_FILE%"
echo [INFO] WORKSPACE=%WORKSPACE% >> "%LOG_FILE%"
echo [INFO] PROJECT_PATH=%PROJECT_PATH% >> "%LOG_FILE%"
echo [INFO] KATALON_EXE=%KATALON_EXE% >> "%LOG_FILE%"
echo [INFO] COLLECTION_PATH=%COLLECTION_PATH% >> "%LOG_FILE%"
echo [INFO] BROWSER_TYPE=%BROWSER_TYPE% >> "%LOG_FILE%"
echo [INFO] RETRY=%RETRY% >> "%LOG_FILE%"
echo [INFO] LOG_FILE=%LOG_FILE% >> "%LOG_FILE%"
echo [INFO] MARKER_FILE=%MARKER_FILE% >> "%LOG_FILE%"
echo. >> "%LOG_FILE%"

rem Hard validations (latest real issue)
if "%PROJECT_PATH%"=="" (
  echo [ERROR] PROJECT_PATH is empty in run-context.properties >> "%LOG_FILE%"
  call :WriteMarker 3 "PROJECT_PATH_EMPTY"
  exit /b 3
)

if not exist "%PROJECT_PATH%" (
  echo [ERROR] PROJECT_PATH not found: %PROJECT_PATH% >> "%LOG_FILE%"
  call :WriteMarker 4 "PROJECT_PATH_NOT_FOUND"
  exit /b 4
)

if "%KATALON_EXE%"=="" (
  echo [ERROR] KATALON_EXE is empty >> "%LOG_FILE%"
  call :WriteMarker 5 "KATALON_EXE_EMPTY"
  exit /b 5
)

if not exist "%KATALON_EXE%" (
  echo [ERROR] KATALON_EXE not found: %KATALON_EXE% >> "%LOG_FILE%"
  call :WriteMarker 6 "KATALON_EXE_NOT_FOUND"
  exit /b 6
)

if "%COLLECTION_PATH%"=="" (
  echo [ERROR] COLLECTION_PATH is empty >> "%LOG_FILE%"
  call :WriteMarker 7 "COLLECTION_PATH_EMPTY"
  exit /b 7
)

rem Move to workspace so relative paths behave
if not "%WORKSPACE%"=="" (
  pushd "%WORKSPACE%" >> "%LOG_FILE%" 2>&1
)

rem Run Katalon (console mode). This still runs in the interactive session because Task Scheduler runs it.
echo [INFO] Launching Katalon... >> "%LOG_FILE%"
echo [INFO] Command: "%KATALON_EXE%" -runMode=console -projectPath="%PROJECT_PATH%" -testSuiteCollectionPath="%COLLECTION_PATH%" -browserType="%BROWSER_TYPE%" -retry=%RETRY% >> "%LOG_FILE%"

"%KATALON_EXE%" ^
  -runMode=console ^
  -projectPath="%PROJECT_PATH%" ^
  -testSuiteCollectionPath="%COLLECTION_PATH%" ^
  -browserType="%BROWSER_TYPE%" ^
  -retry=%RETRY% >> "%LOG_FILE%" 2>&1

set "KATALON_EXIT=%ERRORLEVEL%"

if not "%WORKSPACE%"=="" (
  popd >> "%LOG_FILE%" 2>&1
)

echo. >> "%LOG_FILE%"
echo [INFO] Katalon exit code: %KATALON_EXIT% >> "%LOG_FILE%"

rem Write marker atomically (fixes your AccessDenied in Jenkins readFile)
call :WriteMarker %KATALON_EXIT% "KATALON_DONE"

exit /b %KATALON_EXIT%

rem ------------------------------------------------------------
rem Atomic marker write: write .tmp then rename to final
rem ------------------------------------------------------------
:WriteMarker
set "EC=%~1"
set "MSG=%~2"

if "%MARKER_FILE%"=="" (
  set "MARKER_FILE=D:\Projects\eMatchStarters\logs\__jenkins_task_exitcode.txt"
)

set "MARKER_DIR=%~dp0"
for %%Z in ("%MARKER_FILE%") do set "MARKER_DIR=%%~dpZ"

if not exist "%MARKER_DIR%" (
  mkdir "%MARKER_DIR%" >nul 2>&1
)

set "TMP=%MARKER_FILE%.tmp"

> "%TMP%" (
  echo %EC%
  echo %MSG%
  echo %DATE% %TIME%
  echo %LOG_FILE%
)

move /y "%TMP%" "%MARKER_FILE%" >nul 2>&1

echo [INFO] Marker written: %MARKER_FILE% >> "%LOG_FILE%"
echo [INFO] Marker value: %EC% (%MSG%) >> "%LOG_FILE%"

exit /b 0



package jenkinsIntegration

class JenkinsDesktopPipelineRunner {

    static Map runDesktopViaTaskScheduler(Map cfg) {

        String taskName      = cfg.taskName ?: 'eMatch Automation\\RunEMatchDesktop'
        String ctxFile       = cfg.ctxFile ?: 'D:\\Projects\\eMatchStarters\\run-context.properties'
        String markerFile    = cfg.markerFile ?: 'D:\\Projects\\eMatchStarters\\logs\\__jenkins_task_exitcode.txt'
        int    pollSeconds   = (cfg.pollSeconds ?: 3) as int
        int    maxWaitSecs   = (cfg.maxWaitSecs ?: (3 * 60 * 60)) as int

        echo "[INFO] Writing run-context.properties to: ${ctxFile}"
        writeFile file: ctxFile, text: cfg.ctxText

        echo "[INFO] Running Task Scheduler: ${taskName}"
        bat """
            @echo off
            schtasks /run /tn "${taskName}"
        """

        echo "[INFO] Waiting for marker file: ${markerFile}"
        int waited = 0
        while (waited < maxWaitSecs) {
            if (fileExists(markerFile)) {
                break
            }
            sleep pollSeconds
            waited += pollSeconds
        }

        if (!fileExists(markerFile)) {
            error "[ERROR] Marker file was not created within timeout: ${markerFile}"
        }

        String markerText
        try {
            markerText = readFile(markerFile).trim()
        } catch (Exception ex) {
            echo "[WARN] Failed to read marker file (maybe transient lock). Retrying once..."
            sleep 2
            markerText = readFile(markerFile).trim()
        }

        def lines = markerText.readLines()
        int exitCode = 1
        try {
            exitCode = Integer.parseInt(lines[0].trim())
        } catch (ignored) {
            exitCode = 1
        }

        echo "[INFO] Task exit code from marker: ${exitCode}"
        return [exitCode: exitCode, markerLines: lines]
    }

    static void archiveSafeArtifacts() {

        echo "[INFO] Archiving artifacts (safe mode)"
        try {
            archiveArtifacts allowEmptyArchive: true, artifacts: [
                'Reports/**/*',
                'D:\\Projects\\eMatchStarters\\logs\\*.log',
                'D:\\Projects\\eMatchStarters\\logs\\__jenkins_task_exitcode.txt'
            ].join(',')
        } catch (Exception ex) {
            echo "[WARN] archiveArtifacts failed but build will continue: ${ex.getMessage()}"
        }
    }
}
