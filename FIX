	//Update Test Path on X-Ray
	def updateTestCasePath(String execIDTestCase,  String summaryName) {
		if (summaryName.startsWith('Test Cases')) {
			println 'Updating X-Ray folder for ' + execIDTestCase + '.';
			String Paths = "";
			List<String> splited = summaryName.split("/");
			List<String> projectFolder=System.getProperty("user.dir").toString().split("\\\\")
			splited[splited.indexOf('Test Cases')]=projectFolder[projectFolder.size()-1]
			for (int i = 0; i < splited.size()-1; i++) {
				Paths +=  splited[i] + "/";
			}
			println("Moving to Path: " + Paths);
			def response = WS.sendRequest(findTestObject('Jira Integration/updateRepositoryPath', [('issueID'): execIDTestCase, ('repPath'): Paths]));
			return WS.getResponseStatusCode(response);
		}
		else return 200;
	}

