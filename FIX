package jiraIntegration

import groovy.xml.XmlUtil

import java.text.SimpleDateFormat
import java.util.zip.ZipEntry
import java.util.zip.ZipOutputStream

class JiraReportBuilder {

	static final String JUNIT_FILE_NAME = 'JUnit_Report.xml'
	static final String CUSTOM_HTML_NAME = 'JiraReport.html'

	File createHtmlReport(File suiteRunFolder, String suiteName, String executionTitle) {
		if (suiteRunFolder == null || !suiteRunFolder.exists()) {
			throw new RuntimeException('Suite report folder was not found.')
		}

		File junitXml = resolveJunitXml(suiteRunFolder)

		Map model = buildModelFromKatalonArtifacts(suiteRunFolder, junitXml, suiteName, executionTitle)

		String html = renderWithGaiaTemplate(model)

		File out = new File(suiteRunFolder, CUSTOM_HTML_NAME)
		out.setText(html, 'UTF-8')

		return out
	}

	File resolveJunitXml(File suiteRunFolder) {
		File direct = new File(suiteRunFolder, JUNIT_FILE_NAME)
		if (direct.exists()) {
			return direct
		}

		List<File> xmlFiles = []
		collectFilesRecursively(suiteRunFolder, xmlFiles) { File f ->
			f.name.equalsIgnoreCase(JUNIT_FILE_NAME)
		}

		if (!xmlFiles.isEmpty()) {
			return xmlFiles.sort { a, b -> b.lastModified() <=> a.lastModified() }[0]
		}

		throw new RuntimeException('No JUnit_Report.xml was found inside the suite report folder.')
	}

	File createResultsZip(File suiteRunFolder) {
		File out = new File(suiteRunFolder, 'Results.zip')
		zipFolder(suiteRunFolder, out) { File file ->
			String lower = file.name.toLowerCase(Locale.ENGLISH)
			return !lower.endsWith('.zip')
		}
		return out
	}

	File createEvidencesZip(File suiteRunFolder) {
		List<File> evidenceFiles = collectEvidenceFiles(suiteRunFolder)
		if (evidenceFiles.isEmpty()) {
			return null
		}

		File out = new File(suiteRunFolder, 'Evidences.zip')

		ZipOutputStream zos = new ZipOutputStream(new FileOutputStream(out))
		try {
			evidenceFiles.each { File file ->
				String entryName = buildRelativePath(suiteRunFolder, file)
				zos.putNextEntry(new ZipEntry(entryName))
				file.withInputStream { is ->
					byte[] buffer = new byte[8192]
					int len
					while ((len = is.read(buffer)) != -1) {
						zos.write(buffer, 0, len)
					}
				}
				zos.closeEntry()
			}
		} finally {
			zos.close()
		}

		return out
	}

	private Map buildModelFromKatalonArtifacts(File suiteRunFolder, File junitXml, String suiteName, String executionTitle) {
		def xml = new XmlSlurper(false, false).parse(junitXml)

		List<Map> allEvidence = collectEvidenceFiles(suiteRunFolder).collect { File file ->
			[
				name  : file.name,
				href  : file.toURI().toString(),
				imgSrc: file.toURI().toString(),
				image : isImage(file)
			]
		}

		List<Map> scenarios = []
		List testcases = xml.'**'.findAll { it.name() == 'testcase' }

		testcases.eachWithIndex { testcase, int index ->
			String testName = safe(testcase.@name)
			String className = safe(testcase.@classname)
			String fullName = !blank(testName) ? testName : (!blank(className) ? className : 'Scenario ' + (index + 1))

			Object failureNode = testcase.failure ? testcase.failure[0] : null
			Object errorNode = testcase.error ? testcase.error[0] : null
			Object skippedNode = testcase.skipped ? testcase.skipped[0] : null

			String status = 'passed'
			String visualError = ''
			String fullError = ''

			if (failureNode != null) {
				status = 'failed'
				visualError = firstNonBlank(
					safe(failureNode.@message),
					safe(failureNode.text())
				)
				fullError = firstNonBlank(
					safe(failureNode.text()),
					visualError
				)
			} else if (errorNode != null) {
				status = 'failed'
				visualError = firstNonBlank(
					safe(errorNode.@message),
					safe(errorNode.text())
				)
				fullError = firstNonBlank(
					safe(errorNode.text()),
					visualError
				)
			} else if (skippedNode != null) {
				status = 'skipped'
				visualError = firstNonBlank(
					safe(skippedNode.@message),
					'Test skipped'
				)
				fullError = visualError
			}

			long durationMs = parseSecondsToMillis(safe(testcase.@time))
			String durationLabel = formatDuration(durationMs)

			List<Map> steps = buildPseudoSteps(fullName, status, fullError)
			List<Map> evidence = matchEvidenceForTest(fullName, allEvidence)

			scenarios << [
				id           : 'scenario-' + (index + 1),
				name         : fullName,
				scenarioName : fullName,
				summary      : !blank(visualError) ? visualError : status.capitalize(),
				status       : status,
				startShort   : '',
				endShort     : '',
				startLong    : '',
				endLong      : '',
				durationLabel: durationLabel,
				visualError  : visualError,
				fullError    : fullError,
				steps        : steps,
				evidence     : evidence
			]
		}

		int passedCount = scenarios.count { it.status == 'passed' }
		int failedCount = scenarios.count { it.status == 'failed' }
		int skippedCount = scenarios.count { it.status == 'skipped' }

		String generated = new SimpleDateFormat('dd.MM.yyyy HH:mm:ss').format(new Date())

		return [
			appName        : 'eMatch',
			projectName    : 'eMatch',
			suiteName      : suiteName,
			testSuiteName  : suiteName,
			title          : executionTitle,
			reportTitle    : 'Test report - ' + suiteName,
			subtitle       : suiteName + ' execution overview',
			generatedAt    : generated,
			generatedLabel : 'Generated ' + generated,
			reportFolder   : suiteRunFolder.absolutePath,
			scenarios      : scenarios,
			tests          : scenarios,
			items          : scenarios,
			passedCount    : passedCount,
			failedCount    : failedCount,
			skippedCount   : skippedCount,
			totalCount     : scenarios.size()
		]
	}

	private String renderWithGaiaTemplate(Map model) {
		def builder = new JiraHtmlTemplateBuilder()

		if (builder.metaClass.respondsTo(builder, 'build', Map)) {
			return String.valueOf(builder.build(model))
		}

		if (builder.metaClass.respondsTo(builder, 'render', Map)) {
			return String.valueOf(builder.render(model))
		}

		if (builder.metaClass.respondsTo(builder, 'buildHtml', Map)) {
			return String.valueOf(builder.buildHtml(model))
		}

		throw new RuntimeException('JiraHtmlTemplateBuilder does not expose build(Map), render(Map), or buildHtml(Map).')
	}

	private List<Map> buildPseudoSteps(String testName, String status, String fullError) {
		List<Map> steps = []

		steps << [
			status   : status == 'failed' ? 'failed' : 'passed',
			timestamp: '',
			detail   : 'Executed test case: ' + testName,
			icon     : status == 'failed' ? '❌' : 'ℹ️'
		]

		if (!blank(fullError)) {
			fullError.readLines().findAll { !blank(it) }.take(12).each { String line ->
				steps << [
					status   : status == 'failed' ? 'failed' : 'info',
					timestamp: '',
					detail   : safe(line),
					icon     : status == 'failed' ? '❌' : 'ℹ️'
				]
			}
		}

		return steps
	}

	private List<Map> matchEvidenceForTest(String testName, List<Map> allEvidence) {
		if (allEvidence == null || allEvidence.isEmpty()) {
			return []
		}

		String normalizedTest = normalizeKey(testName)

		List<Map> matched = allEvidence.findAll { Map ev ->
			String joined = normalizeKey(safe(ev.name) + ' ' + safe(ev.href))
			return !blank(normalizedTest) && joined.contains(normalizedTest)
		}

		if (!matched.isEmpty()) {
			return matched
		}

		return allEvidence.take(3)
	}

	private List<File> collectEvidenceFiles(File folder) {
		List<File> files = []
		collectFilesRecursively(folder, files) { File f ->
			String lower = f.name.toLowerCase(Locale.ENGLISH)
			return lower.endsWith('.png') ||
				lower.endsWith('.jpg') ||
				lower.endsWith('.jpeg') ||
				lower.endsWith('.gif') ||
				lower.endsWith('.webp') ||
				lower.endsWith('.bmp')
		}
		return files.sort { a, b -> b.lastModified() <=> a.lastModified() }
	}

	private void collectFilesRecursively(File folder, List<File> output, Closure<Boolean> filter) {
		if (folder == null || !folder.exists()) {
			return
		}

		File[] children = folder.listFiles()
		if (children == null) {
			return
		}

		children.each { File child ->
			if (child.isDirectory()) {
				collectFilesRecursively(child, output, filter)
			} else if (filter.call(child)) {
				output << child
			}
		}
	}

	private void zipFolder(File sourceFolder, File targetZip, Closure<Boolean> includeFile) {
		ZipOutputStream zos = new ZipOutputStream(new FileOutputStream(targetZip))
		try {
			List<File> allFiles = []
			collectFilesRecursively(sourceFolder, allFiles) { File f ->
				includeFile == null ? true : includeFile.call(f)
			}

			allFiles.each { File file ->
				String entryName = buildRelativePath(sourceFolder, file)
				zos.putNextEntry(new ZipEntry(entryName))
				file.withInputStream { is ->
					byte[] buffer = new byte[8192]
					int len
					while ((len = is.read(buffer)) != -1) {
						zos.write(buffer, 0, len)
					}
				}
				zos.closeEntry()
			}
		} finally {
			zos.close()
		}
	}

	private String buildRelativePath(File root, File file) {
		String rootPath = root.absolutePath.replace('\\', '/')
		String filePath = file.absolutePath.replace('\\', '/')
		String relative = filePath.substring(rootPath.length())
		while (relative.startsWith('/')) {
			relative = relative.substring(1)
		}
		return relative
	}

	private long parseSecondsToMillis(String raw) {
		if (blank(raw)) {
			return 0L
		}

		try {
			return Math.round(Double.parseDouble(raw.replace(',', '.')) * 1000d)
		} catch (Exception ignored) {
			return 0L
		}
	}

	private String formatDuration(long durationMs) {
		if (durationMs < 0L) {
			durationMs = 0L
		}

		long totalSeconds = Math.round(durationMs / 1000d)
		long hours = (long) (totalSeconds / 3600L)
		long minutes = (long) ((totalSeconds % 3600L) / 60L)
		long seconds = (long) (totalSeconds % 60L)

		return String.format(Locale.ENGLISH, '%02dh %02dm %02ds', hours, minutes, seconds)
	}

	private boolean isImage(File file) {
		String lower = safe(file?.name).toLowerCase(Locale.ENGLISH)
		return lower.endsWith('.png') ||
			lower.endsWith('.jpg') ||
			lower.endsWith('.jpeg') ||
			lower.endsWith('.gif') ||
			lower.endsWith('.webp') ||
			lower.endsWith('.bmp')
	}

	private String normalizeKey(String value) {
		return safe(value)
			.toLowerCase(Locale.ENGLISH)
			.replaceAll(/[^a-z0-9]+/, '')
	}

	private String firstNonBlank(Object... values) {
		for (Object value : values) {
			String text = safe(value)
			if (!blank(text)) {
				return text
			}
		}
		return ''
	}

	private boolean blank(String value) {
		return safe(value).isEmpty()
	}

	private String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}
