	// =========================================================

	Map httpJson(String method, String endpoint, Map body = null, Map<String, String> extraHeaders = [:]) {
		HttpURLConnection connection = null
		try {
			URL url = new URL(BASE_URL + endpoint)
			connection = (HttpURLConnection) url.openConnection()
			connection.setRequestMethod(method)
			connection.setRequestProperty('Authorization', 'Bearer ' + JIRA_TOKEN)
			connection.setRequestProperty('Accept', 'application/json')
			connection.setRequestProperty('Content-Type', 'application/json')
			connection.setDoInput(true)

			extraHeaders.each { k, v ->
				connection.setRequestProperty(k, v)
			}

			if (body != null) {
				connection.setDoOutput(true)
				byte[] data = JsonOutput.toJson(body).getBytes(StandardCharsets.UTF_8)
				OutputStream os = connection.getOutputStream()
				os.write(data)
				os.flush()
				os.close()
			}

			int status = connection.getResponseCode()
			InputStreamReader isr = new InputStreamReader(
				status >= 400 ? connection.getErrorStream() : connection.getInputStream(),
				StandardCharsets.UTF_8
			)

			String responseText = ''
			if (isr != null) {
				BufferedReader br = new BufferedReader(isr)
				String line
				StringBuilder sb = new StringBuilder()
				while ((line = br.readLine()) != null) {
					sb.append(line)
				}
				br.close()
				responseText = sb.toString()
			}

			def parsed = null
			if (!isBlank(responseText)) {
				try {
					parsed = new JsonSlurper().parseText(responseText)
				} catch (Exception ignored) {
					parsed = responseText
				}
			}

			return [status: status, body: parsed, raw: responseText]
		} finally {
			try { if (connection != null) connection.disconnect() } catch (Exception ignored) {}
		}
	}

	Map httpMultipart(String method, String endpoint, File file, String formFieldName = 'file', Map<String, String> extraHeaders = [:]) {
		HttpURLConnection connection = null
		String boundary = '----KATALON-JIRA-' + System.currentTimeMillis()

		try {
			URL url = new URL(BASE_URL + endpoint)
			connection = (HttpURLConnection) url.openConnection()
			connection.setRequestMethod(method)
			connection.setRequestProperty('Authorization', 'Bearer ' + JIRA_TOKEN)
			connection.setRequestProperty('Accept', 'application/json')
			connection.setRequestProperty('X-Atlassian-Token', 'no-check')
			connection.setRequestProperty('Content-Type', 'multipart/form-data; boundary=' + boundary)
			connection.setDoOutput(true)
			connection.setDoInput(true)

			extraHeaders.each { k, v ->
				connection.setRequestProperty(k, v)
			}

			OutputStream os = connection.getOutputStream()

			String header = ''
			header += '--' + boundary + '\r\n'
			header += 'Content-Disposition: form-data; name="' + formFieldName + '"; filename="' + file.getName() + '"\r\n'
			header += 'Content-Type: application/octet-stream\r\n\r\n'
			os.write(header.getBytes(StandardCharsets.UTF_8))
			Files.copy(file.toPath(), os)
			os.write('\r\n'.getBytes(StandardCharsets.UTF_8))
			os.write(('--' + boundary + '--\r\n').getBytes(StandardCharsets.UTF_8))
			os.flush()
			os.close()

			int status = connection.getResponseCode()
			InputStreamReader isr = new InputStreamReader(
				status >= 400 ? connection.getErrorStream() : connection.getInputStream(),
				StandardCharsets.UTF_8
			)

			String responseText = ''
			if (isr != null) {
				BufferedReader br = new BufferedReader(isr)
				String line
				StringBuilder sb = new StringBuilder()
				while ((line = br.readLine()) != null) {
					sb.append(line)
				}
				br.close()
				responseText = sb.toString()
			}

			def parsed = null
			if (!isBlank(responseText)) {
				try {
					parsed = new JsonSlurper().parseText(responseText)
				} catch (Exception ignored) {
					parsed = responseText
				}
			}

			return [status: status, body: parsed, raw: responseText]
		} finally {
			try { if (connection != null) connection.disconnect() } catch (Exception ignored) {}
		}
	}

	// =========================================================
	// JIRA / XRAY METHODS
	// =========================================================

	String importExecutionResults(String xmlPath) {
		File xmlFile = new File(xmlPath)
		if (!xmlFile.exists()) {
			return 'ERROR_XML_NOT_FOUND'
		}

		Map response = httpMultipart(
			'POST',
			'/rest/raven/1.0/import/execution/junit?projectKey=' + URLEncoder.encode(PROJECT_KEY, 'UTF-8'),
			xmlFile,
			'file'
		)

		KeywordUtil.logInfo('Import results status: ' + response.status)
		KeywordUtil.logInfo('Import results response: ' + response.raw)

		if (response.status == 200 || response.status == 201 || response.status == 204) {
			try {
				return safe(response.body?.testExecIssue?.key)
			} catch (Exception ignored) {
				return ''
			}
		}

		return 'ERROR' + response.status
	}

	int updateExecutionIssue(String issueKey, String summary) {
		Map body = [
			fields: [
				summary     : summary,
				labels      : isBlank(LABELS) ? [] : LABELS.split(',').collect { it.trim() }.findAll { !isBlank(it) },
				environment : ENVIRONMENT
			]
		]

		Map response = httpJson('PUT', '/rest/api/2/issue/' + issueKey, body)
		KeywordUtil.logInfo('Update Test Execution status: ' + response.status)
		KeywordUtil.logInfo('Update Test Execution response: ' + response.raw)
		return response.status
	}

	boolean issueExists(String issueKey) {
		if (isBlank(issueKey)) {
			return false
		}
		Map response = httpJson('GET', '/rest/api/2/issue/' + issueKey)
		return response.status == 200
	}

	String findExistingTestPlanKeyByName(String summary) {
		String jql = 'project = "' + PROJECT_KEY + '" AND issuetype = "Test Plan" AND summary ~ "\\"' + summary.replace('"', '\\"') + '\\"" ORDER BY created DESC'
		String endpoint = '/rest/api/2/search?jql=' + URLEncoder.encode(jql, 'UTF-8') + '&fields=summary'

		Map response = httpJson('GET', endpoint)
		if (response.status != 200) {
			return ''
		}

		List issues = response.body?.issues ?: []
		for (def issue : issues) {
			String issueSummary = safe(issue?.fields?.summary)
			if (issueSummary.equalsIgnoreCase(summary)) {
				return safe(issue?.key)
			}
		}

		return ''
	}

	String createTestPlan(String summary) {
		Map fields = [
			project  : [key: PROJECT_KEY],
			summary  : summary,
			issuetype: [name: 'Test Plan']
		]

		if (!isBlank(LABELS)) {
			fields.labels = LABELS.split(',').collect { it.trim() }.findAll { !isBlank(it) }
		}

		if (!isBlank(EPIC_KEY)) {
			fields[EPIC_LINK_FIELD_ID] = EPIC_KEY
		}

		Map response = httpJson('POST', '/rest/api/2/issue', [fields: fields])

		KeywordUtil.logInfo('Create Test Plan status: ' + response.status)
		KeywordUtil.logInfo('Create Test Plan response: ' + response.raw)

		if (response.status == 200 || response.status == 201) {
			return safe(response.body?.key)
		}

		return 'ERROR' + response.status
	}

	String getOrCreateTestPlan() {
		if (RESET_SAVED_TEST_PLAN_KEY) {
			resetSavedTestPlanKey()
		}

		if (!isBlank(MANUAL_TEST_PLAN_KEY) && issueExists(MANUAL_TEST_PLAN_KEY)) {
			return MANUAL_TEST_PLAN_KEY
		}

		if (!FORCE_CREATE_NEW_TEST_PLAN) {
			String savedKey = readSavedTestPlanKey()
			if (!isBlank(savedKey) && issueExists(savedKey)) {
				return savedKey
			}

			String existingByName = findExistingTestPlanKeyByName(getTestPlanName())
			if (!isBlank(existingByName)) {
				saveTestPlanKey(existingByName)
				return existingByName
			}
		}

		String createdKey = createTestPlan(getTestPlanName())
		if (!isBlank(createdKey) && !createdKey.startsWith('ERROR')) {
			saveTestPlanKey(createdKey)
		}
		return createdKey
	}

	int addExecutionToTestPlan(String testPlanKey, String executionKey) {
		Map response = httpJson(
			'POST',
			'/rest/raven/1.0/api/testplan/' + testPlanKey + '/testexecution',
			[executionKey]
		)

		KeywordUtil.logInfo('Update Test Plan status: ' + response.status)
		KeywordUtil.logInfo('Update Test Plan response: ' + response.raw)

		return response.status
	}

	int updateIssueStatus(String issueKey, String transitionId) {
		if (isBlank(issueKey) || isBlank(transitionId)) {
			return 0
		}

		Map response = httpJson(
			'POST',
			'/rest/api/2/issue/' + issueKey + '/transitions',
			[transition: [id: transitionId]]
		)

		KeywordUtil.logInfo('Transition status response code: ' + response.status)
		KeywordUtil.logInfo('Transition response body: ' + response.raw)

		return response.status
	}

	int uploadAttachment(String issueKey, String filePath) {
		if (isBlank(filePath)) {
			return 0
		}

		File originalFile = new File(filePath)
		if (!originalFile.exists() || originalFile.length() == 0) {
			KeywordUtil.logInfo('Skipping attachment upload because file path is empty, missing or zero bytes.')
			return 0
		}

		String safeCopyPath = createSafeUploadCopy(originalFile.absolutePath, originalFile.name)
		if (isBlank(safeCopyPath)) {
			KeywordUtil.logInfo('Skipping attachment upload because safe copy could not be created.')
			return 0
		}

		File safeFile = new File(safeCopyPath)

		Map response = httpMultipart(
			'POST',
			'/rest/api/2/issue/' + issueKey + '/attachments',
			safeFile,
			'file'
		)

		KeywordUtil.logInfo('Upload attachment status: ' + response.status)
		KeywordUtil.logInfo('Upload attachment response: ' + response.raw)

		return response.status
	}

	// =========================================================
	// MAIN FLOW
	// =========================================================

	@Keyword
	def jiraImport() {
		logSeparator('Starting Jira import flow')

		String reportPath = getResolvedReportPath()
		String suiteName = getCurrentSuiteName()

		KeywordUtil.logInfo('Using report folder: ' + reportPath)
		KeywordUtil.logInfo('Suite name detected from report path: ' + suiteName)

		if (isBlank(reportPath)) {
			KeywordUtil.markFailed('Report folder could not be resolved.')
			return
		}

		if (isBlank(suiteName)) {
			KeywordUtil.markFailed('Suite name could not be resolved from report folder.')
			return
		}

		String executionSummary = getExecutionSummary()
		String testPlanName = getTestPlanName()

		KeywordUtil.logInfo('Execution title used: ' + executionSummary)
		KeywordUtil.logInfo('Test Plan title used: ' + testPlanName)

		String xmlFile = getXmlFilePath()
		if (isBlank(xmlFile)) {
			KeywordUtil.markFailed('XML file was not found for Jira import.')
			return
		}

		KeywordUtil.logInfo('XML file found: ' + xmlFile)

		String gaiaReportPath = buildGaiaReport()
		String reportZipPath = zipReports()
		String evidenceZipPath = zipEvidences()

		String executionKey = importExecutionResults(xmlFile)
		if (isBlank(executionKey) || executionKey.startsWith('ERROR')) {
			KeywordUtil.markFailed('Test Execution could not be created: ' + executionKey)
			return
		}

		int updateExecutionStatus = updateExecutionIssue(executionKey, executionSummary)

		String testPlanKey = getOrCreateTestPlan()
		if (isBlank(testPlanKey) || testPlanKey.startsWith('ERROR')) {
			KeywordUtil.markFailed('Test Plan could not be created or resolved: ' + testPlanKey)
			return
		}

		int updateTestPlanStatus = addExecutionToTestPlan(testPlanKey, executionKey)

		int gaiaReportAttachmentStatus = uploadAttachment(executionKey, gaiaReportPath)
		int resultsAttachmentStatus = uploadAttachment(executionKey, reportZipPath)
		int evidencesAttachmentStatus = uploadAttachment(executionKey, evidenceZipPath)

		int transitionExecutionStatus = updateIssueStatus(executionKey, EXECUTION_TRANSITION_ID)
		int transitionTestPlanStatus = updateIssueStatus(testPlanKey, TEST_PLAN_TRANSITION_ID)

		logSeparator('Jira import finished')

		KeywordUtil.logInfo('Execution key: ' + executionKey)
		KeywordUtil.logInfo('Using report folder: ' + reportPath)
		KeywordUtil.logInfo('Suite name detected from report path: ' + suiteName)
		KeywordUtil.logInfo('Execution title used: ' + executionSummary)
		KeywordUtil.logInfo('Test Plan key: ' + testPlanKey)
		KeywordUtil.logInfo('Test Plan title used: ' + testPlanName)
		KeywordUtil.logInfo('Gaia report attachment status: ' + gaiaReportAttachmentStatus)
		KeywordUtil.logInfo('Results.zip attachment status: ' + resultsAttachmentStatus)
		KeywordUtil.logInfo('Evidences.zip attachment status: ' + evidencesAttachmentStatus)
		KeywordUtil.logInfo('Update Test Plan status: ' + updateTestPlanStatus)
		KeywordUtil.logInfo('Update Test Execution status: ' + updateExecutionStatus)
		KeywordUtil.logInfo('Transition Execution status: ' + transitionExecutionStatus)
		KeywordUtil.logInfo('Transition Test Plan status: ' + transitionTestPlanStatus)
	}
