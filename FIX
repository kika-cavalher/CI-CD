	@Keyword
	Map validateDefaultDatesAndApply(
			Integer timeoutSeconds,
			Integer screenLoadTimeoutSeconds
		) {

		// Configuration
		Integer timeout = safeTimeout(timeoutSeconds)
		Integer screenLoadTimeout =
			safeTimeout(screenLoadTimeoutSeconds)

		// Clean selected dates
		clickImageFirstThenObject(
			'cleanList',
			'cleanListButton',
			'Clean dates list button',
			timeout
		)

		// Resolve first available date
		WindowsTestObject firstDateItem =
			object('firstAvailableDateItem')

		// Validate first available date
		if (!Windows.waitForElementPresent(
			firstDateItem,
			timeout,
			FailureHandling.OPTIONAL
		)) {
			takeEvidence(
				'Investigations_FirstDateNotFound.png'
			)

			KeywordUtil.markFailedAndStop(
				'The first available date was not found after cleaning the dates list.\n' +
				'Object: ' +
				OBJECT_GROUP +
				'.firstAvailableDateItem'
			)

			return [:]
		}

		// Read selected date
		String selectedDate =
			safeText(
				Windows.getText(firstDateItem)
			)

		// Select first available date
		Windows.click(
			firstDateItem,
			FailureHandling.STOP_ON_FAILURE
		)

		Windows.delay(POLLING_DELAY_SECONDS)

		// Move selected date with double click
		Windows.doubleClick(
			firstDateItem,
			FailureHandling.STOP_ON_FAILURE
		)

		Windows.delay(POLLING_DELAY_SECONDS)

		// Apply selected date
		clickImageFirstThenObject(
			'applyButton',
			'applyButton',
			'Apply dates button',
			timeout
		)

		// Validate opened tab
		verifyTabByName(
			INVESTIGATIONS_TAB_NAME,
			screenLoadTimeout
		)

		// Evidence
		takeEvidence(
			'Investigations_FirstDateApplied.png'
		)

		// Result
		return [
			selectedDate: selectedDate,
			openedTab   : INVESTIGATIONS_TAB_NAME
		]
	}


