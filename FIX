                    grid-template-columns: 1fr;
                }
            }
        ''')
        html.append('</style>')
        html.append('</head>')
        html.append('<body>')

        html.append('<header class="top-banner">')
        html.append('<div class="brand-wrap">')
        html.append('<div class="brand-logo">')
        if (!isBlank(model.logoSrc)) {
            html.append('<img src="')
            html.append(htmlEscape(model.logoSrc))
            html.append('" alt="GAIA Logo" onerror="this.style.display=\'none\';this.parentNode.querySelector(\'.brand-logo-fallback\').style.display=\'flex\';">')
        }
        html.append('<div class="brand-logo-fallback" style="display:')
        html.append(isBlank(model.logoSrc) ? 'flex' : 'none')
        html.append(';">G</div>')
        html.append('</div>')
        html.append('<div class="brand-texts">')
        html.append('<div class="report-name">')
        html.append(htmlEscape(model.reportTitle ?: (REPORT_TITLE_PREFIX + safeValue(model.suiteName))))
        html.append('</div>')
        html.append('<div class="report-subtitle">')
        html.append(htmlEscape(model.subtitle ?: 'GAIA execution overview'))
        html.append('</div>')
        html.append('</div>')
        html.append('</div>')

        html.append('<div class="banner-meta">')
        html.append('<div class="banner-pill">Generated ')
        html.append(htmlEscape(safeValue(model.generatedAt)))
        html.append('</div>')
        html.append('<div class="banner-pill">Project ')
        html.append(htmlEscape(APP_NAME))
        html.append('</div>')
        html.append('</div>')
        html.append('</header>')

        html.append('<div class="page">')

        html.append('<aside class="sidebar">')
        html.append('<div class="sidebar-top">')
        html.append('<div class="sidebar-tabs">')
        html.append('<button id="tab-tests" class="sidebar-tab active" type="button" onclick="switchTab(\'tests\')">Tests</button>')
        html.append('<button id="tab-charts" class="sidebar-tab" type="button" onclick="switchTab(\'charts\')">Charts</button>')
        html.append('</div>')
        html.append('</div>')

        html.append('<div id="sidebar-tests-panel">')
        html.append('<div class="sidebar-body">')
        html.append('<input id="scenarioSearch" class="search-box" type="text" placeholder="Search test name, path, or status." onkeyup="filterScenarios()">')
        html.append('</div>')

        html.append('<div id="scenarioList" class="scenario-list">')
        scenarios.eachWithIndex { Map scenario, int index ->
            html.append(buildScenarioListItem(scenario, index == 0))
        }
        html.append('</div>')
        html.append('</div>')

        html.append('<div id="sidebar-summary-panel" class="sidebar-summary">')
        html.append('<div class="summary-title">Execution status</div>')
        html.append(buildSidebarSummaryRow('Passed', safeInt(summary.passed), safeInt(summary.total), STATUS_PASS))
        html.append(buildSidebarSummaryRow('Failed', safeInt(summary.failed), safeInt(summary.total), STATUS_FAIL))
        html.append(buildSidebarSummaryRow('Skipped', safeInt(summary.skipped), safeInt(summary.total), STATUS_SKIP))
        html.append('</div>')
        html.append('</aside>')

        html.append('<main class="content">')

        html.append('<div id="testsContent">')
        if (scenarios.isEmpty()) {
            html.append('<div class="empty-box">No scenario data found.</div>')
        } else {
            scenarios.eachWithIndex { Map scenario, int index ->
                html.append(buildScenarioDetail(scenario, index == 0))
            }
        }
        html.append('</div>')

        html.append('<div id="chartsContent" class="chart-view">')
        html.append(buildChartView(summary))
        html.append('</div>')

        html.append('</main>')
        html.append('</div>')

        html.append('<script>')
        html.append('''
            function switchTab(tabName) {
                const testsTab = document.getElementById('tab-tests');
                const chartsTab = document.getElementById('tab-charts');
                const testsContent = document.getElementById('testsContent');
                const chartsContent = document.getElementById('chartsContent');
                const testsPanel = document.getElementById('sidebar-tests-panel');

                if (tabName === 'charts') {
                    testsTab.classList.remove('active');
                    chartsTab.classList.add('active');
                    if (testsContent) {
                        testsContent.style.display = 'none';
                    }
                    if (chartsContent) {
                        chartsContent.classList.add('active');
                    }
                    if (testsPanel) {
                        testsPanel.style.display = 'none';
                    }
                } else {
                    chartsTab.classList.remove('active');
                    testsTab.classList.add('active');
                    if (chartsContent) {
                        chartsContent.classList.remove('active');
                    }
                    if (testsContent) {
                        testsContent.style.display = 'block';
                    }
                    if (testsPanel) {
                        testsPanel.style.display = 'block';
                    }
                }
            }

            function selectScenario(id) {
                const items = document.querySelectorAll('.scenario-item');
                const panels = document.querySelectorAll('.detail-view');

                items.forEach(function(item) {
                    item.classList.toggle('active', item.getAttribute('data-scenario-id') === id);
                });

                panels.forEach(function(panel) {
                    panel.classList.toggle('active', panel.getAttribute('data-scenario-id') === id);
                });

                switchTab('tests');
            }

            function filterScenarios() {
                const input = document.getElementById('scenarioSearch');
                const value = input ? input.value.toLowerCase() : '';
                const items = document.querySelectorAll('.scenario-item');

                items.forEach(function(item) {
                    const haystack = (item.getAttribute('data-search') || '').toLowerCase();
                    item.style.display = haystack.indexOf(value) > -1 ? 'grid' : 'none';
                });
            }

            function toggleDetail(id) {
                const box = document.getElementById(id);
                if (!box) {
                    return;
                }
                box.style.display = box.style.display === 'block' ? 'none' : 'block';
            }

            document.addEventListener('DOMContentLoaded', function() {
                const firstId = ''' + JsonOutput.toJson(initialScenarioId) + ''';
                if (firstId) {
                    selectScenario(firstId);
                }
            });
        ''')
        html.append('</script>')

        html.append('</body>')
        html.append('</html>')

        return html.toString()
    }

    private String buildScenarioListItem(Map scenario, boolean active) {
        StringBuilder html = new StringBuilder()

        html.append('<div class="scenario-item')
        if (active) {
            html.append(' active')
        }
        html.append('" data-scenario-id="')
        html.append(htmlEscape(safeValue(scenario.id)))
        html.append('" data-search="')
        html.append(htmlEscape(buildScenarioSearchText(scenario)))
        html.append('" onclick="selectScenario(\'')
        html.append(jsEscape(safeValue(scenario.id)))
        html.append('\')">')

        html.append('<div class="scenario-main">')
        html.append('<div class="scenario-title">')
        html.append(htmlEscape(safeValue(scenario.title)))
        html.append('</div>')
        html.append('<div class="scenario-subtitle">')
        html.append(htmlEscape(safeValue(scenario.sidebarSubtitle)))
        html.append('</div>')
        html.append('<div class="scenario-meta">')
        html.append('<span>')
        html.append(htmlEscape(safeValue(scenario.startLabel)))
        html.append('</span>')
        html.append('<span>')
        html.append(htmlEscape(safeValue(scenario.durationLabel)))
        html.append('</span>')
        html.append('</div>')
        html.append('</div>')

        html.append('<div class="scenario-side">')
        html.append('<span class="status-badge ')
        html.append(statusCss(scenario.status))
        html.append('">')
        html.append(statusLabel(scenario.status))
        html.append('</span>')
        html.append('<div class="scenario-meta"><span>')
        html.append(htmlEscape(safeValue(scenario.durationLabel)))
        html.append('</span></div>')
        html.append('</div>')

        html.append('</div>')
        return html.toString()
    }

    private String buildScenarioSearchText(Map scenario) {
        return [
            safeValue(scenario.title),
            safeValue(scenario.sidebarSubtitle),
            safeValue(scenario.status),
            safeValue(scenario.startLabel)
        ].join(' ')
    }

    private String buildScenarioDetail(Map scenario, boolean active) {
        StringBuilder html = new StringBuilder()

        html.append('<section class="detail-view')
        if (active) {
            html.append(' active')
        }
        html.append('" data-scenario-id="')
        html.append(htmlEscape(safeValue(scenario.id)))
        html.append('">')

        html.append('<div class="scenario-heading">')
        html.append(htmlEscape(safeValue(scenario.title)))
        html.append('</div>')

        html.append('<div class="meta-chips">')
        html.append('<span class="chip suite">Suite: ')
        html.append(htmlEscape(normalizeSuiteName(scenario)))
        html.append('</span>')

        html.append('<span class="chip ')
        html.append(statusCss(scenario.status))
        html.append('">Status: ')
        html.append(htmlEscape(statusLabel(scenario.status)))
        html.append('</span>')

        html.append('<span class="chip meta">Start: ')
        html.append(htmlEscape(safeValue(scenario.startLabel)))
        html.append('</span>')

        html.append('<span class="chip meta">End: ')
        html.append(htmlEscape(safeValue(scenario.endLabel)))
        html.append('</span>')

        html.append('<span class="chip meta">Duration: ')
        html.append(htmlEscape(safeValue(scenario.durationLabel)))
        html.append('</span>')
        html.append('</div>')

        html.append('<div class="section-title">Steps</div>')
        html.append('<table class="steps-table">')
        html.append('<thead><tr>')
        html.append('<th class="col-status">Status</th>')
        html.append('<th class="col-time">Timestamp</th>')
        html.append('<th>Details</th>')
        html.append('</tr></thead>')
        html.append('<tbody>')

        List<Map> steps = (scenario.steps ?: []) as List<Map>
        steps.eachWithIndex { Map step, int index ->
            html.append(buildStepRow(scenario, step, index))
        }

        html.append('</tbody>')
        html.append('</table>')

        if (!isBlank(scenario.errorShort)) {
            html.append('<section class="visual-error">')
            html.append('<div class="visual-error-title">Visual Error Log</div>')
            html.append('<div class="visual-error-line">')
            html.append(htmlEscape(safeValue(scenario.errorShort)))
            html.append('</div>')

            if (!isBlank(scenario.errorFull)) {
                html.append('<details class="visual-error-details">')
                html.append('<summary>🔎 View full error</summary>')
                html.append('<pre class="visual-error-pre">')
                html.append(htmlEscape(safeValue(scenario.errorFull)))
                html.append('</pre>')
                html.append('</details>')
            }
            html.append('</section>')
        }

        if ((scenario.evidences ?: []).size() > 0) {
            html.append('<section class="evidence-wrap">')
            html.append('<div class="evidence-title">Evidence</div>')

            scenario.evidences.eachWithIndex { Map evidence, int evidenceIndex ->
                String imageId = safeValue(scenario.id) + '-evidence-' + evidenceIndex

                html.append('<div class="evidence-item">')
                html.append('<div class="evidence-name">')
                html.append(htmlEscape(safeValue(evidence.name)))
                html.append('</div>')

                html.append('<a class="evidence-link" href="')
                html.append(htmlEscape(safeValue(evidence.openUrl)))
                html.append('" target="_blank">🔎 Open evidence</a>')

                html.append('<img id="')
                html.append(htmlEscape(imageId))
                html.append('" class="evidence-preview" src="')
                html.append(htmlEscape(safeValue(evidence.previewUrl)))
                html.append('" alt="Evidence" onerror="this.style.display=\'none\';document.getElementById(\'')
                html.append(jsEscape(imageId + '-missing'))
                html.append('\').style.display=\'block\';">')

                html.append('<div id="')
                html.append(htmlEscape(imageId + '-missing'))
                html.append('" class="evidence-missing">Preview not available.</div>')
                html.append('</div>')
            }

            html.append('</section>')
        }

        html.append('</section>')
        return html.toString()
    }

    private String normalizeSuiteName(Map scenario) {
        String title = safeValue(scenario.title)
        int marker = title.indexOf(' - ')
        if (marker > 0) {
            return title.substring(0, marker).replace('[', '').replace(']', '').trim()
        }
        return ''
    }

    private String buildStepRow(Map scenario, Map step, int index) {
        String detailId = safeValue(scenario.id) + '-step-' + index
        StringBuilder html = new StringBuilder()

        html.append('<tr>')
        html.append('<td class="col-status">')
        html.append('<span class="status-badge ')
        html.append(statusCss(step.status))
        html.append('">')
        html.append(statusLabel(step.status))
        html.append('</span>')
        html.append('</td>')

        html.append('<td class="col-time">')
        html.append(htmlEscape(safeValue(step.timeLabel)))
        html.append('</td>')

        html.append('<td>')
        html.append('<div class="step-title-line">')
        html.append('<span>')
        html.append(htmlEscape(safeValue(step.emoji)))
        html.append('</span>')
        html.append('<span class="title-text">')
        html.append(htmlEscape(safeValue(step.title)))
        html.append('</span>')
        html.append('</div>')

        if (!isBlank(step.detailText)) {
            html.append('<a class="detail-link" href="javascript:void(0)" onclick="toggleDetail(\'')
            html.append(jsEscape(detailId))
            html.append('\')">🔎 View full detail</a>')
            html.append('<div id="')
            html.append(htmlEscape(detailId))
            html.append('" class="step-detail-box">')
            html.append(htmlEscape(safeValue(step.detailText)))
            html.append('</div>')
        }
        html.append('</td>')
        html.append('</tr>')

        return html.toString()
    }

    private String buildChartView(Map summary) {
        int total = safeInt(summary.total)
        int passed = safeInt(summary.passed)
        int failed = safeInt(summary.failed)
        int skipped = safeInt(summary.skipped)

        String donutStyle = buildDonutStyle(total, passed, failed, skipped)

        StringBuilder html = new StringBuilder()
        html.append('<section class="chart-view active">')
        html.append('<div class="chart-grid">')

        html.append('<div class="chart-card">')
        html.append('<h2>Global Overview</h2>')
        html.append('<div class="donut" style="background:')
        html.append(donutStyle)
        html.append(';">')
        html.append('<div class="donut-center">')
        html.append('<div class="donut-total">')
        html.append(total)
        html.append('</div>')
        html.append('<div class="donut-label">Tests</div>')
        html.append('</div>')
        html.append('</div>')

        html.append('<div class="chart-legend">')
        html.append(buildLegendRow('Passed', passed, STATUS_PASS))
        html.append(buildLegendRow('Failed', failed, STATUS_FAIL))
        html.append(buildLegendRow('Skipped', skipped, STATUS_SKIP))
        html.append('</div>')
        html.append('</div>')

        html.append('<div class="stats-card">')
        html.append('<h2>Execution distribution</h2>')
        html.append('<div class="big-stat-grid">')
        html.append(buildBigStat('Passed', passed, total, STATUS_PASS))
        html.append(buildBigStat('Failed', failed, total, STATUS_FAIL))
        html.append(buildBigStat('Skipped', skipped, total, STATUS_SKIP))
        html.append('</div>')
        html.append('</div>')

        html.append('</div>')
        html.append('</section>')
        return html.toString()
    }

    private String buildSidebarSummaryRow(String label, int value, int total, String color) {
        int percentage = total > 0 ? (int) Math.round((value * 100.0d) / total) : 0

        StringBuilder html = new StringBuilder()
        html.append('<div class="summary-stat">')
        html.append('<div class="summary-label-row"><span>')
        html.append(htmlEscape(label))
        html.append('</span><span>')
        html.append(value)
        html.append('</span></div>')
        html.append('<div class="summary-bar"><div class="summary-bar-fill" style="width:')
        html.append(percentage)
        html.append('%;background:')
        html.append(color)
        html.append(';"></div></div>')
        html.append('</div>')
        return html.toString()
    }

    private String buildLegendRow(String label, int value, String color) {
        StringBuilder html = new StringBuilder()
        html.append('<div class="legend-row">')
        html.append('<span class="legend-dot" style="background:')
        html.append(color)
        html.append(';"></span>')
        html.append('<span>')
        html.append(htmlEscape(label))
        html.append('</span>')
        html.append('<span>')
        html.append(value)
        html.append('</span>')
        html.append('</div>')
        return html.toString()
    }

    private String buildBigStat(String label, int value, int total, String color) {
        int percentage = total > 0 ? (int) Math.round((value * 100.0d) / total) : 0

        StringBuilder html = new StringBuilder()
        html.append('<div class="big-stat">')
        html.append('<div class="big-stat-title">')
        html.append(htmlEscape(label))
        html.append('</div>')
        html.append('<div class="big-stat-value">')
        html.append(value)
        html.append('</div>')
        html.append('<div class="big-stat-bar"><div class="big-stat-bar-fill" style="width:')
        html.append(percentage)
        html.append('%;background:')
        html.append(color)
        html.append(';"></div></div>')
        html.append('</div>')
        return html.toString()
    }

    private String buildDonutStyle(int total, int passed, int failed, int skipped) {
        if (total <= 0) {
            return 'conic-gradient(#edf2f7 0 100%)'
        }

        double passedPercent = (passed * 100.0d) / total
        double failedPercent = (failed * 100.0d) / total
        double skippedPercent = (skipped * 100.0d) / total

        double firstStop = passedPercent
        double secondStop = passedPercent + failedPercent
        double thirdStop = secondStop + skippedPercent

        return "conic-gradient(${STATUS_PASS} 0 ${firstStop}%, ${STATUS_FAIL} ${firstStop}% ${secondStop}%, ${STATUS_SKIP} ${secondStop}% ${thirdStop}%, #edf2f7 ${thirdStop}% 100%)"
    }

    private String statusCss(def status) {
        String value = safeValue(status).toLowerCase(Locale.ENGLISH)
        switch (value) {
            case 'passed':
                return 'pass'
            case 'failed':
                return 'fail'
            case 'skipped':
                return 'skip'
            default:
                return 'info'
        }
    }

    private String statusLabel(def status) {
        String value = safeValue(status).toLowerCase(Locale.ENGLISH)
        switch (value) {
            case 'passed':
                return 'Passed'
            case 'failed':
                return 'Failed'
            case 'skipped':
                return 'Skip'
            default:
                return 'Info'
        }
    }

    private int safeInt(def value) {
        try {
            return Integer.parseInt(safeValue(value))
        } catch (Exception ignored) {
            return 0
        }
    }

    private String safeValue(def value) {
        return value == null ? '' : String.valueOf(value).trim()
    }

    private boolean isBlank(def value) {
        return safeValue(value).isEmpty()
    }

    private String htmlEscape(def value) {
        String text = safeValue(value)
        return text
            .replace('&', '&amp;')
            .replace('<', '&lt;')
            .replace('>', '&gt;')
            .replace('"', '&quot;')
            .replace("'", '&#39;')
    }

    private String jsEscape(def value) {
        String text = safeValue(value)
        return text
            .replace('\\', '\\\\')
            .replace("'", "\\'")
            .replace('"', '\\"')
            .replace('\r', '')
            .replace('\n', '\\n')
    }
}
