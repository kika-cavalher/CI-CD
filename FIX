	@Keyword
	void validateLandingPage(Integer timeoutSeconds) {
		int safeTimeout = safeTimeout(timeoutSeconds, 6)
		List<String> errors = []

		List<String> bottomBarFields = readBottomBarFields()

		validateNotEmpty(
			bottomBarFields,
			2,
			'User name is not correctly displayed.',
			errors
		)

		validateNotEmpty(
			bottomBarFields,
			3,
			'eMatch environment is not correctly displayed.',
			errors
		)

		validateNotEmpty(
			bottomBarFields,
			4,
			'Athena environment is not correctly displayed.',
			errors
		)

		String closingDate = valueAt(bottomBarFields, 6)

		if (closingDate.isEmpty() || !closingDate.contains('/')) {
			errors.add('Closing date is not correctly displayed.')
		}

		validateNotEmpty(
			bottomBarFields,
			7,
			'Currency is not correctly displayed.',
			errors
		)

		if (!isImageVisible('userProfiles')) {
			errors.add('User Profiles image was not found in the bottom bar.')
		}

		validateCalendar(safeTimeout, errors)

		if (!isImageVisible('calendarDaysOfWeek')) {
			errors.add('Calendar widget does not contain the days of the week.')
		}

		if (!isImageVisible('topBar')) {
			errors.add('Top bar Access rapide layout has image differences.')
		}

		validateTopBarLandingState(safeTimeout, errors)

		failIfErrors(
			'Landing page validation failed.',
			errors
		)

		KeywordUtil.markPassed(
			'UI landing page validated successfully.'
		)
	}


