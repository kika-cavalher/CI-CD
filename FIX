package commands

import java.awt.Robot
import java.awt.event.KeyEvent

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

class DimensionsNavigator {

	private ImageLoader imageLoader = new ImageLoader()

	@Keyword
	void validateDimensionsImagesExist(String imageGroup) {
		Map images = imageLoader.getImages(imageGroup)

		List<String> requiredKeys = [
			'firstDimension',
			'lastDimensionOpen',
			'firstPageRef'
		]

		List<String> missingKeys = []

		requiredKeys.each { String key ->
			if (!images.containsKey(key)) {
				missingKeys.add(key)
			}
		}

		if (!missingKeys.isEmpty()) {
			KeywordUtil.markFailedAndStop(
				'Dimensions image group is missing required keys.\n' +
				'Image group: ' + imageGroup + '\n' +
				'Missing keys: ' + missingKeys.join(', ')
			)
		}

		KeywordUtil.logInfo('All dimensions images exist for group: ' + imageGroup)
	}

	@Keyword
	void clickDimensionImageOrStop(String imageGroup, String imageKey) {
		imageLoader.clickImageOrStop(imageGroup, imageKey)
	}

	@Keyword
	boolean isDimensionImageVisible(String imageGroup, String imageKey) {
		return imageLoader.isVisible(imageGroup, imageKey)
	}

	@Keyword
	void waitForDimensionImageOrStop(String imageGroup, String imageKey, Integer timeoutSeconds) {
		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 15 : timeoutSeconds
		imageLoader.waitForImageOrStop(imageGroup, imageKey, safeTimeout)
	}

	@Keyword
	void clickFirstDimension(String imageGroup) {
		waitForDimensionImageOrStop(imageGroup, 'firstDimension', 15)
		imageLoader.clickImageOrStop(imageGroup, 'firstDimension')
		Windows.delay(1)
	}

	@Keyword
	void validateDimensionsCompleteFlow(String imageGroup, Integer maxCycles, Integer maxScrollMoves) {
		int safeCycles = maxCycles == null || maxCycles <= 0 ? 40 : maxCycles
		int safeScrollMoves = maxScrollMoves == null || maxScrollMoves <= 0 ? 40 : maxScrollMoves

		validateDimensionsImagesExist(imageGroup)

		KeywordUtil.logInfo('Step 1. Validate Measures is visible.')
		waitForDimensionImageOrStop(imageGroup, 'firstDimension', 15)

		KeywordUtil.logInfo('Step 1. Click Measures to focus dimensions tree.')
		imageLoader.clickImageOrStop(imageGroup, 'firstDimension')
		Windows.delay(1)

		KeywordUtil.logInfo('Step 2. Navigate until Provic open becomes visible.')
		boolean provicOpened = openDimensionsUntilProvicOpen(imageGroup, safeCycles)

		if (!provicOpened) {
			imageLoader.takeEvidence('DimensionsProvicOpenNotFound.png')

			KeywordUtil.markFailedAndStop(
				'Could not open dimensions tree until last open dimension.\n' +
				'Image group: ' + imageGroup + '\n' +
				'Expected image: lastDimensionOpen\n' +
				'Max cycles: ' + safeCycles
			)
		}

		KeywordUtil.logInfo('Step 3. Validate last dimension open image after full menu open.')
		waitForDimensionImageOrStop(imageGroup, 'lastDimensionOpen', 10)

		KeywordUtil.logInfo('Step 4. Scroll to top and validate first page reference.')
		boolean firstPageVisible = scrollUntilImageVisible(
			imageGroup,
			'firstPageRef',
			true,
			safeScrollMoves
		)

		if (!firstPageVisible) {
			imageLoader.takeEvidence('DimensionsFirstPageRefNotFound.png')

			KeywordUtil.markFailedAndStop(
				'Could not find first page dimensions reference after scrolling to top.\n' +
				'Image group: ' + imageGroup + '\n' +
				'Expected image: firstPageRef\n' +
				'Max scroll moves: ' + safeScrollMoves
			)
		}

		KeywordUtil.logInfo('Dimensions flow validated successfully.')
	}

	@Keyword
	void openDimensionsUntilProvic(String imageGroup, Integer maxCycles) {
		int safeCycles = maxCycles == null || maxCycles <= 0 ? 40 : maxCycles

		boolean provicOpened = openDimensionsUntilProvicOpen(imageGroup, safeCycles)

		if (!provicOpened) {
			KeywordUtil.markFailedAndStop(
				'Could not open dimensions until Provic open.\n' +
				'Image group: ' + imageGroup + '\n' +
				'Max cycles: ' + safeCycles
			)
		}
	}

	@Keyword
	void scrollDimensionsToTop(String imageGroup) {
		boolean visible = scrollUntilImageVisible(
			imageGroup,
			'firstPageRef',
			true,
			40
		)

		if (!visible) {
			KeywordUtil.markFailedAndStop(
				'Could not scroll dimensions to top reference.\n' +
				'Image group: ' + imageGroup
			)
		}
	}

	@Keyword
	void validateProvicOpen(String imageGroup, Integer timeoutSeconds) {
		waitForDimensionImageOrStop(imageGroup, 'lastDimensionOpen', timeoutSeconds)
	}

	@Keyword
	void validateMeasuresOpen(String imageGroup, Integer timeoutSeconds) {
		waitForDimensionImageOrStop(imageGroup, 'firstDimension', timeoutSeconds)
	}

	@Keyword
	void validateFirstPageReference(String imageGroup, Integer timeoutSeconds) {
		waitForDimensionImageOrStop(imageGroup, 'firstPageRef', timeoutSeconds)
	}

	private boolean openDimensionsUntilProvicOpen(String imageGroup, int maxCycles) {
		if (imageLoader.isVisible(imageGroup, 'lastDimensionOpen')) {
			KeywordUtil.logInfo('Provic open is already visible before navigation.')
			return true
		}

		for (int cycle = 1; cycle <= maxCycles; cycle++) {
			boolean firstCycle = cycle == 1
			int rightMoves = firstCycle ? 3 : 1

			KeywordUtil.logInfo(
				'Dimensions navigation cycle ' + cycle + '/' + maxCycles + '. Sequence: ' +
				(firstCycle ? 'RIGHT, RIGHT, RIGHT, DOWN' : 'RIGHT, DOWN')
			)

			for (int i = 0; i < rightMoves; i++) {
				pressRight()
				Windows.delay(1)

				if (imageLoader.isVisible(imageGroup, 'lastDimensionOpen')) {
					KeywordUtil.logInfo(
						'Provic open became visible after RIGHT move ' + (i + 1) + ' of cycle ' + cycle + '.'
					)
					return true
				}
			}

			pressDown()
			Windows.delay(1)

			if (imageLoader.isVisible(imageGroup, 'lastDimensionOpen')) {
				KeywordUtil.logInfo('Provic open became visible after DOWN of cycle ' + cycle + '.')
				return true
			}
		}

		return imageLoader.isVisible(imageGroup, 'lastDimensionOpen')
	}

	private boolean scrollUntilImageVisible(String imageGroup, String imageKey, boolean scrollUp, int maxScrollMoves) {
		for (int i = 0; i < maxScrollMoves; i++) {
			if (imageLoader.isVisible(imageGroup, imageKey)) {
				KeywordUtil.logInfo(
					'Visible dimensions reference found.\n' +
					'Image group: ' + imageGroup + '\n' +
					'Image key: ' + imageKey + '\n' +
					'Scroll direction: ' + (scrollUp ? 'UP' : 'DOWN') + '\n' +
					'Scroll step: ' + i
				)
				return true
			}

			scrollOneStep(scrollUp)
			Windows.delay(1)
		}

		return false
	}

	private void pressRight() {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_RIGHT)
		robot.keyRelease(KeyEvent.VK_RIGHT)
	}

	private void pressDown() {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_DOWN)
		robot.keyRelease(KeyEvent.VK_DOWN)
	}

	private void scrollOneStep(boolean scrollUp) {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		if (scrollUp) {
			robot.mouseWheel(-3)
		} else {
			robot.mouseWheel(3)
		}
	}
}
