    private List<Map> buildFallbackScenarioList(String suiteName) {
        return [[
            id           : 'execution-summary',
            name         : blank(suiteName) ? 'Execution' : suiteName,
            summary      : 'No step details were found in the Katalon execution log.',
            status       : 'info',
            startShort   : '',
            endShort     : '',
            startLong    : '',
            endLong      : '',
            durationLabel: '00h 00m 00s',
            visualError  : '',
            fullError    : '',
            steps        : [[
                status   : 'info',
                timestamp: '',
                detail   : 'No step details were found in the Katalon execution log.',
                icon     : 'ℹ️'
            ]],
            evidence     : []
        ]]
    }

    // =========================================================================
    // FILE HELPERS
    // =========================================================================

    private File findExecutionLog(File reportDir) {
        List<File> candidates = []

        File exact0 = new File(reportDir, 'execution0.log')
        File exact = new File(reportDir, 'execution.log')

        if (exact0.exists() && exact0.isFile()) {
            candidates << exact0
        }
        if (exact.exists() && exact.isFile()) {
            candidates << exact
        }

        File[] children = reportDir.listFiles()
        if (children != null) {
            children.each { File file ->
                String lower = safe(file.name).toLowerCase(Locale.ENGLISH)
                if (file.isFile() && lower.startsWith('execution') && lower.endsWith('.log')) {
                    candidates << file
                }
            }
        }

        candidates = candidates.unique { File file -> canonical(file) }
        if (candidates.isEmpty()) {
            return null
        }

        candidates.sort { File a, File b -> b.lastModified() <=> a.lastModified() }
        return candidates[0]
    }

    private List<String> readLinesSafe(File file) {
        try {
            return Files.readAllLines(file.toPath(), StandardCharsets.UTF_8)
        } catch (Exception ignored) {
            try {
                return file.readLines()
            } catch (Exception ignoredAgain) {
                return []
            }
        }
    }

    private String readTextSafe(File file) {
        try {
            return new String(Files.readAllBytes(file.toPath()), StandardCharsets.UTF_8)
        } catch (Exception ignored) {
            try {
                return file.getText('UTF-8')
            } catch (Exception ignoredAgain) {
                return ''
            }
        }
    }

    // =========================================================================
    // STRING / TIME HELPERS
    // =========================================================================

    private String stripLogPrefix(String rawLine) {
        String line = safe(rawLine)
        if (blank(line)) {
            return ''
        }

        def matcher = (line =~ /^\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}\.\d{3}\s+[A-Z]+\s+.+?\s+-\s+(.*)$/)
        if (matcher.find()) {
            return safe(matcher.group(1))
        }

        return line
    }

    private String extractDateTimeLabel(String rawLine) {
        def matcher = (safe(rawLine) =~ /^(\d{4}-\d{2}-\d{2}\s+\d{2}:\d{2}:\d{2}\.\d{3})/)
        return matcher.find() ? safe(matcher.group(1)) : ''
    }

    private String extractTimeLabel(String rawLine) {
        def matcher = (safe(rawLine) =~ /^\d{4}-\d{2}-\d{2}\s+(\d{2}:\d{2}:\d{2})\.\d{3}/)
        return matcher.find() ? safe(matcher.group(1)) : ''
    }

    private long parseDurationToMillis(String raw) {
        String value = safe(raw).replace(',', '.')
        if (blank(value)) {
            return 0L
        }

        def matcher = (value =~ /([\d.]+)\s*s/i)
        if (matcher.find()) {
            try {
                return Math.round(Double.parseDouble(safe(matcher.group(1))) * 1000d)
            } catch (Exception ignored) {
                return 0L
            }
        }

        return 0L
    }

    private String formatDuration(long durationMs) {
        if (durationMs < 0L) {
            durationMs = 0L
        }

        long totalSeconds = Math.round(durationMs / 1000d)
        long hours = (long) (totalSeconds / 3600L)
        long minutes = (long) ((totalSeconds % 3600L) / 60L)
        long seconds = (long) (totalSeconds % 60L)

        return String.format(Locale.ENGLISH, '%02dh %02dm %02ds', hours, minutes, seconds)
    }

    private String resolveStepIcon(String detail, String status) {
        String lower = safe(detail).toLowerCase(Locale.ENGLISH)

        if ('failed'.equalsIgnoreCase(status)) return '❌'
        if ('skipped'.equalsIgnoreCase(status)) return '⏭️'
        if (lower.contains('click') || lower.contains('select')) return '🖱️'
        if (lower.contains('settext') || lower.contains('fill') || lower.contains('type') || lower.contains('write')) return '⌨️'
        if (lower.contains('open') || lower.contains('navigate')) return '🌐'
        if (lower.contains('wait') || lower.contains('find')) return '🔎'

        return 'ℹ️'
    }

    private boolean isImageFile(String fileName) {
        String lower = safe(fileName).toLowerCase(Locale.ENGLISH)
        return lower.endsWith('.png') ||
               lower.endsWith('.jpg') ||
               lower.endsWith('.jpeg') ||
               lower.endsWith('.gif') ||
               lower.endsWith('.bmp') ||
               lower.endsWith('.webp')
    }

    private String resolveOutputFileName() {
        List<String> props = [
            'HTML_REPORT_FILE_NAME',
            'CUSTOM_REPORT_FILE_NAME',
            'REPORT_FILE_NAME',
            'GAIA_REPORT_FILE_NAME'
        ]

        for (String prop : props) {
            try {
                def value = owner."${prop}"
                String text = safe(value)
                if (!blank(text) && text.toLowerCase(Locale.ENGLISH).endsWith('.html')) {
                    return text
                }
            } catch (Exception ignored) {
            }
        }

        return 'eMatchReport.html'
    }

    private String resolveAppName() {
        try {
            String value = safe(owner?.PROJECT_KEY)
            if (!blank(value)) {
                return value
            }
        } catch (Exception ignored) {
        }
        return 'Execution'
    }

    private String resolveSubtitle() {
        return 'Execution overview'
    }

    private String resolveLogoPath(File reportDir) {
        List<String> candidates = [
            'Image/logo.png',
            'Image/eMatch-logo.png',
            'Image/gaia-logo.png',
            'Images/logo.png'
        ]

        for (String relative : candidates) {
            File current = new File(findProjectRoot(reportDir), relative)
            if (current.exists() && current.isFile()) {
                return current.toURI().toString()
            }
        }

        return ''
    }

    private File findProjectRoot(File reportDir) {
        File current = reportDir
        while (current != null) {
            if ('Reports'.equalsIgnoreCase(current.name)) {
                return current.parentFile != null ? current.parentFile : current
            }
            current = current.parentFile
        }
        return reportDir
    }

    private String canonical(File file) {
        try {
            return file.canonicalPath
        } catch (Exception ignored) {
            return file.absolutePath
        }
    }

    private long toLong(def value) {
        try {
            return Long.parseLong(safe(value))
        } catch (Exception ignored) {
            return 0L
        }
    }

    private boolean blank(def value) {
        return safe(value).isEmpty()
    }

    private String safe(def value) {
        return value == null ? '' : value.toString().trim()
    }

    private String shorten(String value, int max) {
        String text = safe(value)
        if (text.length() <= max) {
            return text
        }
        return text.substring(0, Math.max(0, max - 3)) + '...'
    }
}
