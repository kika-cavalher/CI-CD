	boolean shouldSkipZipFile(File file, String zipTargetName) {
		String name = safe(file.name)

		if (file.isDirectory()) return true
		if (name.equalsIgnoreCase(zipTargetName)) return true
		if (name.endsWith('.lck')) return true
		if (name.equalsIgnoreCase('execution.log')) return true
		if (name.equalsIgnoreCase('execution0.log')) return true
		if (name.equalsIgnoreCase('execution.log.lck')) return true
		if (name.equalsIgnoreCase('execution0.log.lck')) return true
		return false
	}

	void addFileToZipSafely(ZipOutputStream output, File file, String entryName) {
		FileInputStream input = null

		try {
			input = new FileInputStream(file)
			output.putNextEntry(new ZipEntry(entryName))

			byte[] buffer = new byte[8192]
			int read = 0

			while ((read = input.read(buffer)) != -1) {
				output.write(buffer, 0, read)
			}

			output.closeEntry()
		} catch (IOException e) {
			KeywordUtil.logInfo("Skipping locked or inaccessible file: ${file.absolutePath} | ${e.message}")
			try { output.closeEntry() } catch (Exception ignored) {}
		} finally {
			try { input?.close() } catch (Exception ignored) {}
		}
	}

	String zipReports() {
		File reportFolder = new File(getReportPath())
		if (!reportFolder.exists()) {
			return ''
		}

		File zipFile = new File(reportFolder, REPORT_ZIP_NAME)
		if (zipFile.exists()) {
			zipFile.delete()
		}

		ZipOutputStream output = null

		try {
			output = new ZipOutputStream(new FileOutputStream(zipFile))

			reportFolder.eachFileRecurse(FileType.FILES) { File file ->
				if (shouldSkipZipFile(file, REPORT_ZIP_NAME)) {
					return
				}

				if (file.absolutePath.equalsIgnoreCase(zipFile.absolutePath)) {
					return
				}

				String entryName = relativeUri(reportFolder, file)
				addFileToZipSafely(output, file, entryName)
			}
		} finally {
			try { output?.close() } catch (Exception ignored) {}
		}

		return zipFile.exists() ? zipFile.absolutePath : ''
	}

	String zipEvidences() {
		File evidenceFolder = new File(getReportPath() + File.separator + EVIDENCE_FOLDER_NAME)
		if (!evidenceFolder.exists() || !evidenceFolder.isDirectory()) {
			return ''
		}

		File zipFile = new File(evidenceFolder, EVIDENCE_ZIP_NAME)
		if (zipFile.exists()) {
			zipFile.delete()
		}

		ZipOutputStream output = null
		boolean hasEntries = false

		try {
			output = new ZipOutputStream(new FileOutputStream(zipFile))

			evidenceFolder.eachFileRecurse(FileType.FILES) { File file ->
				if (shouldSkipZipFile(file, EVIDENCE_ZIP_NAME)) {
					return
				}

				if (file.absolutePath.equalsIgnoreCase(zipFile.absolutePath)) {
					return
				}

				String entryName = relativeUri(evidenceFolder, file)
				addFileToZipSafely(output, file, entryName)
				hasEntries = true
			}
		} finally {
			try { output?.close() } catch (Exception ignored) {}
		}

		if (!hasEntries && zipFile.exists()) {
			zipFile.delete()
			return ''
		}

		return zipFile.exists() ? zipFile.absolutePath : ''
	}

