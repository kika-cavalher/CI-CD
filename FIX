/*
 * Responsibility:
 * Helper methods used by Jenkins desktop pipelines (Task Scheduler runner)
 */

def deleteIfExists(script, String path) {
    script.bat """@echo off
if exist "${path}" del /f /q "${path}"
exit /b 0
"""
}

def writeRunContextFile(script, String targetFile, Map ctx) {
    String content = (ctx.collect { k, v -> "${k}=${v}" }.join("\r\n")) + "\r\n"

    script.echo "Writing run-context.properties to: ${targetFile}"
    script.writeFile file: targetFile, text: content, encoding: 'UTF-8'
}

def runScheduledTaskAndWaitMarker(script, String taskName, String markerPath, int timeoutMinutes) {
    script.echo "Running Task Scheduler: ${taskName}"

    int startEc = script.bat(returnStatus: true, script: """@echo off
schtasks /run /tn "${taskName}"
exit /b %ERRORLEVEL%
""")

    if (startEc != 0) {
        script.error("Failed to start scheduled task '${taskName}'. ExitCode=${startEc}")
    }

    script.timeout(time: timeoutMinutes, unit: 'MINUTES') {
        script.echo "Waiting marker file: ${markerPath}"

        while (true) {
            if (script.fileExists(markerPath)) {
                String raw = (script.readFile(markerPath) ?: '').trim()

                def m = (raw =~ /EXIT_CODE=(\d+)/)
                if (m.find()) {
                    int ec = m.group(1).toInteger()
                    script.echo "Desktop task finished. ExitCode=${ec}"
                    return ec
                }

                script.echo "Marker exists but invalid content: '${raw}'. Waiting..."
            }

            script.sleep time: 3, unit: 'SECONDS'
        }
    }

    return 124
}

