	String readLastRunPath() {
		try {
			File file = new File(RunConfiguration.projectDir + '\\LastRun.xlsx')

			if (!file.exists()) {
				return null
			}

			FileInputStream fis = new FileInputStream(file)
			XSSFWorkbook wb = new XSSFWorkbook(fis)
			XSSFSheet sheet = wb.getSheetAt(0)
			XSSFRow row = sheet.getRow(0)
			String result = row?.getCell(0)?.stringCellValue

			wb.close()
			fis.close()

			return result?.trim()
		} catch (Exception e) {
			KeywordUtil.logInfo("Could not read LastRun.xlsx: ${e.message}")
			return null
		}
	}

	boolean directoryContainsUsefulFiles(File dir) {
		if (dir == null || !dir.exists() || !dir.isDirectory()) {
			return false
		}

		boolean found = false

		dir.eachFileRecurse(FileType.FILES) { file ->
			String name = file.name.toLowerCase()

			if (name.equalsIgnoreCase(PRIMARY_XML_FILE_NAME.toLowerCase())
				|| name.contains(SECONDARY_XML_FILE_NAME.toLowerCase())
				|| name.endsWith('.html')
				|| name.equalsIgnoreCase('execution.log')
				|| name.equalsIgnoreCase('junit_report.xml')
				|| name.equalsIgnoreCase('cucumber.xml')) {
				found = true
			}
		}

		return found
	}

	File findLatestUsefulDirectory(File rootDir) {
		if (rootDir == null || !rootDir.exists() || !rootDir.isDirectory()) {
			return null
		}

		List<File> candidates = []

		if (directoryContainsUsefulFiles(rootDir)) {
			candidates.add(rootDir)
		}

		rootDir.eachFileRecurse(FileType.DIRECTORIES) { dir ->
			if (directoryContainsUsefulFiles(dir)) {
				candidates.add(dir)
			}
		}

		if (candidates.isEmpty()) {
			return null
		}

		return candidates.max { it.lastModified() }
	}

	String getResolvedReportPath() {
		List<String> candidatePaths = []

		try {
			String runConfigPath = RunConfiguration.getReportFolder()

			if (!isBlank(runConfigPath)) {
				candidatePaths.add(runConfigPath.trim())
			}
		} catch (Exception e) {
			KeywordUtil.logInfo("Could not read RunConfiguration report folder: ${e.message}")
		}

		String lastRunPath = readLastRunPath()

		if (!isBlank(lastRunPath)) {
			candidatePaths.add(lastRunPath)
		}

		candidatePaths.add(RunConfiguration.projectDir + '\\Reports')
		candidatePaths.add(System.getProperty('user.dir') + '\\Reports')

		for (String path : candidatePaths) {
			if (isBlank(path)) {
				continue
			}

			File root = new File(path)

			if (!root.exists()) {
				continue
			}

			if (directoryContainsUsefulFiles(root)) {
				KeywordUtil.logInfo("Using report folder: ${root.absolutePath}")
				return root.absolutePath
			}

			File latest = findLatestUsefulDirectory(root)

			if (latest != null) {
				KeywordUtil.logInfo("Using nested report folder: ${latest.absolutePath}")
				return latest.absolutePath
			}
		}

		KeywordUtil.markFailed("No valid report folder found.")
		return null
	}

