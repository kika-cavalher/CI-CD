		int minimumExpectedFiles = parseIntOrZero(minimumExpectedFilesText)

		if (minimumExpectedFiles <= 0) {
			return "[SKIPPED] Minimum expected file quantity was not configured."
		}

		StringBuilder errors = new StringBuilder()

		List<File> files = parseFiles(filesToValidate)

		KeywordUtil.logInfo("📄 [FILE COUNT] found=" + files.size() + " | minimumExpected=" + minimumExpectedFiles)

		if (files.size() < minimumExpectedFiles) {
			errors.append("[ERROR] Expected at least ")
					.append(minimumExpectedFiles)
					.append(" Excel files, but found ")
					.append(files.size())
					.append(".\n")
		}

		return errors.toString()
	}

