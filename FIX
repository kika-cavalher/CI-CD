@echo off
setlocal EnableExtensions EnableDelayedExpansion

rem ============================================================
rem eMatch generic runner (called by Task Scheduler)
rem Reads: D:\Projects\eMatchStarters\run-context.properties
rem Writes:
rem   - %WORKSPACE%\Reports\_jenkins_task_exitcode.txt
rem ============================================================

set "CTX=D:\Projects\eMatchStarters\run-context.properties"

if not exist "%CTX%" (
  echo [ERROR] run-context.properties not found: %CTX%
  exit /b 2
)

rem ---- Load properties (KEY=VALUE) into environment ----
for /f "usebackq tokens=1,* delims==" %%A in ("%CTX%") do (
  set "K=%%A"
  set "V=%%B"
  if not "!K!"=="" (
    set "!K!=!V!"
  )
)

rem ---- Required vars ----
if "%WORKSPACE%"=="" (
  echo [ERROR] WORKSPACE is empty in %CTX%
  exit /b 3
)
if "%KATALON_EXE%"=="" (
  echo [ERROR] KATALON_EXE is empty in %CTX%
  exit /b 4
)
if "%PROJECT_FILE%"=="" (
  echo [ERROR] PROJECT_FILE is empty in %CTX%
  exit /b 5
)
if "%COLLECTION_PATH%"=="" (
  echo [ERROR] COLLECTION_PATH is empty in %CTX%
  exit /b 6
)

rem ---- Make sure Reports folder exists in workspace ----
if not exist "%WORKSPACE%\Reports" (
  mkdir "%WORKSPACE%\Reports" 2>nul
)

rem ---- Optional: log folder ----
if "%LOG_DIR%"=="" set "LOG_DIR=D:\Projects\eMatchStarters\logs"
if not exist "%LOG_DIR%" mkdir "%LOG_DIR%" 2>nul

set "TS=%DATE:~6,4%%DATE:~3,2%%DATE:~0,2%_%TIME:~0,2%%TIME:~3,2%%TIME:~6,2%"
set "TS=%TS: =0%"
set "RUNLOG=%LOG_DIR%\katalon_%TS%.log"

echo ===========================================================  > "%RUNLOG%"
echo WORKSPACE=%WORKSPACE%                                      >> "%RUNLOG%"
echo PROJECT_FILE=%PROJECT_FILE%                                >> "%RUNLOG%"
echo COLLECTION_PATH=%COLLECTION_PATH%                          >> "%RUNLOG%"
echo KATALON_EXE=%KATALON_EXE%                                  >> "%RUNLOG%"
echo ===========================================================  >> "%RUNLOG%"

rem ---- Run from workspace to force Reports under workspace ----
cd /d "%WORKSPACE%"

rem ---- Build command (your working Katalon pattern) ----
set "CMD=%KATALON_EXE% -projectPath=""%WORKSPACE%\%PROJECT_FILE%"" -noSplash -runMode=console -retry=0 -testSuiteCollectionPath=""%COLLECTION_PATH%"" -browserType=""Windows"""

echo [INFO] Running: %CMD%                                      >> "%RUNLOG%"
echo.                                                           >> "%RUNLOG%"

call %CMD% >> "%RUNLOG%" 2>&1
set "EXITCODE=%ERRORLEVEL%"

rem ---- Write exit code file where Jenkins expects ----
echo %EXITCODE% > "%WORKSPACE%\Reports\_jenkins_task_exitcode.txt"

echo.                                                           >> "%RUNLOG%"
echo [INFO] ExitCode=%EXITCODE%                                 >> "%RUNLOG%"
echo [INFO] ExitCodeFile=%WORKSPACE%\Reports\_jenkins_task_exitcode.txt >> "%RUNLOG%"

exit /b %EXITCODE%








pipeline {
  agent { label 'GI5_SWDCFRNXGI55817' }

  options {
    timestamps()
    ansiColor('xterm')
    timeout(time: 180, unit: 'MINUTES')
  }

  stages {

    stage('Prepare Run Context') {
      steps {
        script {
          def ws = pwd()
          echo "WORKSPACE: ${ws}"

          def ctx = """WORKSPACE=${ws}
KATALON_EXE=C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0\\katalonc.exe
PROJECT_FILE=eMatch POC.prj
COLLECTION_PATH=Test Suites/Archive Mode/Archive Mode Collection
LOG_DIR=D:\\Projects\\eMatchStarters\\logs
"""
          writeFile file: 'run-context.properties', text: ctx

          bat """
            copy /Y "${ws}\\run-context.properties" "D:\\Projects\\eMatchStarters\\run-context.properties"
          """
        }
      }
    }

    stage('Run Archive Mode') {
      steps {
        bat """
          echo ============================================================
          echo START ASSET: Archive Mode Collection
          echo TASK: \\eMatch Automation\\RunEMatchDesktop
          echo ============================================================

          schtasks /run /tn "startWinDriver"
          schtasks /run /tn "\\eMatch Automation\\RunEMatchDesktop"

          :loop
          for /f "tokens=2 delims=: " %%f in ('schtasks /query /tn "\\eMatch Automation\\RunEMatchDesktop" /fo list ^| find "Status:"') do (
              if "%%f"=="Running" (
                  ping -n 6 localhost >nul 2>nul
                  goto loop
              )
          )

          schtasks /end /tn "startWinDriver"
        """
      }
    }

    stage('Collect Reports') {
      steps {
        script {
          def exitFile = "${pwd()}\\Reports\\_jenkins_task_exitcode.txt"
          if (fileExists(exitFile)) {
            echo "Exit code file found: ${exitFile}"
            def code = readFile(exitFile).trim()
            echo "Desktop task exit code: ${code}"
          } else {
            echo "Exit code file NOT found: ${exitFile}"
          }
        }

        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
          junit allowEmptyResults: true, testResults: 'Reports/**/JUnit_Report.xml'
        }

        catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
          archiveArtifacts allowEmptyArchive: true, artifacts: 'Reports/**/*'
        }
      }
    }

    stage('Trigger Next Job') {
      steps {
        echo "Triggering next Jenkins job: Passerelle Bilan"
        build job: 'Passerelle Bilan', wait: false
      }
    }
  }
}



