	@Keyword
	void attachToLoginWindow(String targetWindowTitle) {
		String expectedTitle = normalizeTitle(safe(detectedWindowTitle) ?: safe(targetWindowTitle) ?: resolveWindowTitle())

		KeywordUtil.logInfo("Attaching to login window. Expected title ${expectedTitle}")

		ensureWinAppDriverRunning()

		if (!attachToRunningWindow(expectedTitle, 30)) {
			KeywordUtil.markFailedAndStop("Could not find eMatch window with title ${expectedTitle}")
		}

		detectedWindowTitle = expectedTitle
		KeywordUtil.logInfo("Attached to login window ${detectedWindowTitle}")

		focusLoginWindow(detectedWindowTitle)

		if (waitForLoginIndicators(15)) {
			return
		}

		KeywordUtil.logInfo("Login indicators were not confirmed by object. Continuing with image-based login flow.")
	}

	private boolean attachToRunningWindow(String expectedTitle, int timeoutSeconds) {
		long end = System.currentTimeMillis() + (timeoutSeconds * 1000L)

		while (System.currentTimeMillis() < end) {
			try {
				Windows.switchToDesktop()
			} catch (Throwable ignored) {
			}

			try {
				WindowsTestObject windowObj = appWindowObj(expectedTitle)
				Windows.switchToWindow(windowObj)
				sleepMs(1000)
				return true
			} catch (Throwable ignored) {
			}

			sleepMs(1000)
		}

		return false
	}

	private boolean waitForLoginIndicators(int timeoutSeconds) {
		long end = System.currentTimeMillis() + (timeoutSeconds * 1000L)

		while (System.currentTimeMillis() < end) {
			try {
				if (waitPresent(envComboObj(), 2)) {
					return true
				}
			} catch (Throwable ignored) {
			}

			try {
				if (waitPresent(connectBtnObj(), 2)) {
					return true
				}
			} catch (Throwable ignored) {
			}

			sleepMs(500)
		}

		return false
	}

