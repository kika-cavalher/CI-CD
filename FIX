/*
 * Responsibility:
 * This file is responsible only for starting and stopping Gaia.
 * It preserves the scheduled task approach that already works in your machine.
 * It is backward compatible with older Jenkinsfiles that do not pass readiness parameters.
 */

def start(script, Map cfg) {
	/*
	 * Responsibility:
	 * Trigger the scheduled task that starts Gaia.
	 * If readiness parameters are provided, wait until Gaia is really ready.
	 * Otherwise, keep the legacy behavior and only wait a fixed amount of time.
	 */

	def taskName = cfg.taskName ?: ''
	def waitSeconds = (cfg.waitSeconds ?: 40).toString()
	def backPort = cfg.containsKey('backPort') && cfg.backPort != null ? cfg.backPort.toString() : ''
	def frontPort = cfg.containsKey('frontPort') && cfg.frontPort != null ? cfg.frontPort.toString() : ''
	def frontUrl = cfg.containsKey('frontUrl') && cfg.frontUrl != null ? cfg.frontUrl.toString() : ''
	def useReadiness = (backPort?.trim() && frontPort?.trim() && frontUrl?.trim()) ? 'true' : 'false'

	script.withEnv([
		"TASK_NAME=${taskName}",
		"WAIT_SECONDS=${waitSeconds}",
		"BACK_PORT=${backPort}",
		"FRONT_PORT=${frontPort}",
		"FRONT_URL=${frontUrl}",
		"USE_READINESS=${useReadiness}"
	]) {
		script.powershell '''
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

function Test-ListeningPort {
    param([int]$Port)

    try {
        $listener = Get-NetTCPConnection -LocalPort $Port -State Listen -ErrorAction SilentlyContinue |
            Select-Object -First 1

        return ($null -ne $listener)
    }
    catch {
        return $false
    }
}

function Wait-ListeningPort {
    param(
        [int]$Port,
        [string]$Label,
        [datetime]$Deadline
    )

    while ((Get-Date) -lt $Deadline) {
        if (Test-ListeningPort -Port $Port) {
            Write-Host ('✅ ' + $Label + ' is listening on port ' + $Port)
            return
        }

        Start-Sleep -Seconds 2
    }

    throw ($Label + ' did not start listening on port ' + $Port + ' before timeout')
}

function Wait-HttpReady {
    param(
        [string]$Url,
        [datetime]$Deadline
    )

    while ((Get-Date) -lt $Deadline) {
        try {
            $response = Invoke-WebRequest -Uri $Url -UseBasicParsing -TimeoutSec 5 -ErrorAction Stop

            if ($response.StatusCode -eq 200 -and -not [string]::IsNullOrWhiteSpace($response.Content)) {
                Write-Host ('✅ Frontend responded with HTTP 200 at ' + $Url)
                return
            }
        }
        catch {
        }

        Start-Sleep -Seconds 2
    }

    throw ('Frontend URL was not ready before timeout: ' + $Url)
}

Write-Host '============================================================'
Write-Host '🚀 STARTING GAIA THROUGH SCHEDULED TASK'
Write-Host ('🕒 Max wait seconds: ' + $env:WAIT_SECONDS)
Write-Host ('🔌 Back port: ' + ($(if ([string]::IsNullOrWhiteSpace($env:BACK_PORT)) { 'N/A' } else { $env:BACK_PORT })))
Write-Host ('🌐 Front port: ' + ($(if ([string]::IsNullOrWhiteSpace($env:FRONT_PORT)) { 'N/A' } else { $env:FRONT_PORT })))
Write-Host ('🔗 Front URL : ' + ($(if ([string]::IsNullOrWhiteSpace($env:FRONT_URL)) { 'N/A' } else { $env:FRONT_URL })))
Write-Host '============================================================'

schtasks /run /tn $env:TASK_NAME | Out-Host

if ($env:USE_READINESS -ne 'true') {
    Write-Host 'ℹ️ Legacy mode detected'
    Write-Host 'ℹ️ Readiness parameters were not provided by Jenkinsfile'
    Write-Host ('ℹ️ Waiting fixed time only: ' + $env:WAIT_SECONDS + ' seconds')
    Start-Sleep -Seconds ([int]$env:WAIT_SECONDS)

    Write-Host '✅ Gaia scheduled task triggered'
    Write-Host '============================================================'
    return
}

$deadline = (Get-Date).AddSeconds([int]$env:WAIT_SECONDS)

Start-Sleep -Seconds 3

Wait-ListeningPort -Port ([int]$env:BACK_PORT) -Label 'Gaia backend' -Deadline $deadline
Wait-ListeningPort -Port ([int]$env:FRONT_PORT) -Label 'Gaia frontend' -Deadline $deadline
Wait-HttpReady -Url $env:FRONT_URL -Deadline $deadline

Write-Host '✅ Gaia scheduled task triggered and application is ready'
Write-Host '============================================================'
'''
	}
}

def stop(script, Map cfg) {
	/*
	 * Responsibility:
	 * Stop Gaia by killing processes bound to the known ports first,
	 * then stop remaining Gaia related processes.
	 */

	script.withEnv([
		"BACK_PORT=${cfg.backPort.toString()}",
		"FRONT_PORT=${cfg.frontPort.toString()}"
	]) {
		script.powershell '''
$ErrorActionPreference = 'SilentlyContinue'
$ProgressPreference = 'SilentlyContinue'

function Stop-ProcessListeningOnPort {
    param([int]$Port)

    try {
        $owners = Get-NetTCPConnection -LocalPort $Port -ErrorAction SilentlyContinue |
            Select-Object -ExpandProperty OwningProcess -Unique

        foreach ($ownerPid in $owners) {
            if ($ownerPid) {
                Stop-Process -Id $ownerPid -Force -ErrorAction SilentlyContinue
            }
        }
    }
    catch {
    }
}

Write-Host '============================================================'
Write-Host '🧹 STOPPING GAIA PROCESSES'
Write-Host '============================================================'

Stop-ProcessListeningOnPort -Port ([int]$env:BACK_PORT)
Stop-ProcessListeningOnPort -Port ([int]$env:FRONT_PORT)

$targets = Get-CimInstance Win32_Process | Where-Object {
    $cmd = [string]$_.CommandLine
    $name = [string]$_.Name

    ($cmd -match 'gaia-start-back\\.bat') -or
    ($cmd -match 'gaia-start-front\\.bat') -or
    ($cmd -match 'gaia-start\\.bat') -or
    ($cmd -match 'web_portal_back') -or
    ($cmd -match 'web_portal') -or
    (($name -match 'cmd\\.exe|java\\.exe|node\\.exe|notepad\\.exe') -and ($cmd -match 'gaia'))
}

foreach ($proc in ($targets | Sort-Object ProcessId -Descending)) {
    try {
        Stop-Process -Id $proc.ProcessId -Force -ErrorAction SilentlyContinue
    }
    catch {
    }
}

Write-Host '✅ Gaia stop command finished'
Write-Host '============================================================'
'''
	}
}

return this






/*
 * Responsibility:
 * This file prints a clean and readable view in the Jenkins console.
 */

def fitText(String value, int width) {
	def text = (value ?: '').replaceAll(/\\s+/, ' ').trim()

	if (text.size() > width) {
		return text.take(width - 3) + '...'
	}

	return text.padRight(width)
}

def printSuiteHeader(script, String suiteName, String suitePath, String timeoutMinutes) {
	script.echo '╔════════════════════════════════════════════════════════════╗'
	script.echo "║ ${fitText('🚀 STARTING SUITE', 58)} ║"
	script.echo "║ ${fitText(suiteName, 58)} ║"
	script.echo "║ ${fitText('📁 ' + suitePath, 58)} ║"
	script.echo "║ ${fitText('⏱️ ' + timeoutMinutes + ' min timeout', 58)} ║"
	script.echo '╚════════════════════════════════════════════════════════════╝'
}

def printSuiteResult(script, Map result) {
	script.echo '╔════════════════════════════════════════════════════════════╗'
	script.echo "║ ${fitText((result.icon ?: '') + ' ' + (result.name ?: ''), 58)} ║"
	script.echo "║ ${fitText('Executed: ' + result.executed + ' | Passed: ' + result.passed + ' | Failed: ' + result.failed + ' | Skipped: ' + result.skipped, 58)} ║"

	if (result.reason) {
		script.echo "║ ${fitText('Reason: ' + result.reason, 58)} ║"
	}

	if (result.screenshotRel) {
		script.echo "║ ${fitText('Screenshot: Reports/' + result.screenshotRel, 58)} ║"
	}

	if (result.logRel) {
		script.echo "║ ${fitText('Log: Reports/' + result.logRel, 58)} ║"
	}

	(result.caseSummary ?: []).take(3).each { line ->
		script.echo "║ ${fitText(line.toString(), 58)} ║"
	}

	script.echo '╚════════════════════════════════════════════════════════════╝'
}

def printRunningSummary(script, List results) {
	def passed = results.count { it.status == 'PASSED' }
	def failed = results.count { it.status == 'FAILED' }
	def timeout = results.count { it.status == 'TIMEOUT' }

	script.currentBuild.description = "✅ ${passed} | ❌ ${failed} | ⏰ ${timeout}"

	script.echo '============================================================'
	script.echo "📌 EXECUTION SUMMARY | Passed: ${passed} | Failed: ${failed} | Timeout: ${timeout}"
	script.echo '============================================================'
}

def printFinalSummary(script, List results, String currentResult) {
	def passed = results.count { it.status == 'PASSED' }
	def failed = results.count { it.status == 'FAILED' }
	def timeout = results.count { it.status == 'TIMEOUT' }
	def total = results.size()

	script.currentBuild.description = "✅ ${passed} | ❌ ${failed} | ⏰ ${timeout}"

	script.echo '============================================================'

	if (total == 0) {
		script.echo '⚠️ PIPELINE STOPPED BEFORE ANY SUITE WAS EXECUTED'
	}
	else if (currentResult == 'ABORTED') {
		script.echo '🛑 PIPELINE ABORTED'
	}
	else if (failed > 0 || timeout > 0) {
		script.echo '❌ PIPELINE FINISHED WITH ERRORS'
	}
	else {
		script.echo '✅ PIPELINE FINISHED SUCCESSFULLY'
	}

	script.echo "📌 FINAL SUMMARY | Passed: ${passed} | Failed: ${failed} | Timeout: ${timeout}"
	script.echo '============================================================'
}

return this
