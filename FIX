	private void reportBooleanResult(
			boolean success,
			String successMessage,
			String failureMessage,
			List<String> errors
	) {

		if (success) {
			KeywordUtil.logInfo(
					'[PASS] ' + successMessage
					)

			return
		}

		errors.add(failureMessage)
		KeywordUtil.logInfo('[FAIL] ' + failureMessage)
	}


	private void finishValidation(
			String validationName,
			List<String> errors
	) {

		if (!errors.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					validationName +
					' failed.\n' +
					errors.collect { String error ->
						'- ' + error
					}.join('\n')
					)

			return
		}

		KeywordUtil.markPassed(
				validationName +
				' completed successfully.'
				)
	}


