package jiraIntegration

import java.io.BufferedInputStream
import java.io.BufferedOutputStream
import java.io.ByteArrayOutputStream
import java.io.DataOutputStream
import java.io.File
import java.io.FileInputStream
import java.net.HttpURLConnection
import java.net.URLEncoder
import java.nio.charset.StandardCharsets

import groovy.json.JsonOutput
import groovy.json.JsonSlurper

class JiraGateway {

	private final JiraFlowCoordinator flow

	JiraGateway(JiraFlowCoordinator flow) {
		this.flow = flow
	}

	void validateRequiredConfiguration() {
		if (isBlank(flow.JIRA_BASE_URL)) {
			throw new IllegalStateException('JIRA_BASE_URL is required.')
		}
		if (isBlank(flow.PROJECT_KEY)) {
			throw new IllegalStateException('PROJECT_KEY is required.')
		}
		if (isBlank(flow.JIRA_TOKEN)) {
			throw new IllegalStateException('JIRA_TOKEN is required.')
		}
	}

	Map getIssue(String issueKey) {
		return request('GET', "/rest/api/2/issue/${url(issueKey)}", null)
	}

	Map searchIssues(String jql, int maxResults) {
		String path = "/rest/api/2/search?jql=${url(jql)}&maxResults=${maxResults}"
		return request('GET', path, null)
	}

	Map createIssue(Map fields) {
		return request('POST', '/rest/api/2/issue', [fields: fields])
	}

	Map updateIssueFields(String issueKey, Map fields) {
		return request('PUT', "/rest/api/2/issue/${url(issueKey)}", [fields: fields])
	}

	Map assignIssue(String issueKey, String assigneeName) {
		if (isBlank(issueKey) || isBlank(assigneeName)) {
			return [status: 200, ok: true]
		}

		Map result = request('PUT', "/rest/api/2/issue/${url(issueKey)}/assignee", [name: assigneeName])
		if (!result.ok) {
			result = request('PUT', "/rest/api/2/issue/${url(issueKey)}/assignee", [displayName: assigneeName])
		}
		return result
	}

	Map importExecutionResults(File junitFile, String projectKey, String testPlanKey) {
		StringBuilder path = new StringBuilder('/rest/raven/1.0/import/execution/junit')
		path.append('?projectKey=').append(url(projectKey))

		if (!isBlank(testPlanKey)) {
			path.append('&testPlanKey=').append(url(testPlanKey))
		}

		return uploadMultipart(path.toString(), junitFile, 'file', false)
	}

	Map uploadAttachment(String issueKey, File file) {
		Map headers = ['X-Atlassian-Token': 'no-check']
		return uploadMultipart("/rest/api/2/issue/${url(issueKey)}/attachments", file, 'file', false, headers)
	}

	private Map uploadMultipart(String path, File file, String fieldName, boolean parseJson = false, Map extraHeaders = [:]) {
		if (file == null || !file.exists() || !file.isFile()) {
			return [status: 0, ok: false, body: '', json: [:], message: 'File not found']
		}

		String boundary = '----ChatGPTBoundary' + System.currentTimeMillis()
		HttpURLConnection connection = null
		DataOutputStream output = null
		BufferedInputStream input = null

		try {
			connection = openConnection('POST', path)
			connection.setDoOutput(true)
			connection.setRequestProperty('Content-Type', 'multipart/form-data; boundary=' + boundary)

			extraHeaders.each { String key, def value ->
				connection.setRequestProperty(key, String.valueOf(value))
			}

			output = new DataOutputStream(new BufferedOutputStream(connection.getOutputStream()))

			output.writeBytes('--' + boundary + '\r\n')
			output.writeBytes('Content-Disposition: form-data; name="' + fieldName + '"; filename="' + file.name + '"\r\n')
			output.writeBytes('Content-Type: application/octet-stream\r\n\r\n')

			input = new BufferedInputStream(new FileInputStream(file))
			byte[] buffer = new byte[8192]
			int read = 0
			while ((read = input.read(buffer)) != -1) {
				output.write(buffer, 0, read)
			}

			output.writeBytes('\r\n--' + boundary + '--\r\n')
			output.flush()

			int status = connection.getResponseCode()
			String body = readResponseBody(connection)
			Object json = [:]

			if (parseJson || looksLikeJson(body)) {
				try {
					json = new JsonSlurper().parseText(body ?: '{}')
				} catch (Exception ignored) {
					json = [:]
				}
			}

			return [status: status, ok: (status >= 200 && status < 300), body: body, json: json]
		} catch (Exception e) {
			return [status: 0, ok: false, body: '', json: [:], message: e.message]
		} finally {
			try { input?.close() } catch (Exception ignored) {}
			try { output?.close() } catch (Exception ignored) {}
			try { connection?.disconnect() } catch (Exception ignored) {}
		}
	}

	private Map request(String method, String path, Object body) {
		HttpURLConnection connection = null
		try {
			connection = openConnection(method, path)

			if (body != null) {
				connection.setDoOutput(true)
				connection.setRequestProperty('Content-Type', 'application/json')
				String payload = JsonOutput.toJson(body)
				connection.getOutputStream().withWriter('UTF-8') { writer ->
					writer << payload
				}
			}

			int status = connection.getResponseCode()
			String responseBody = readResponseBody(connection)

			Object json = [:]
			if (looksLikeJson(responseBody)) {
				try {
					json = new JsonSlurper().parseText(responseBody)
				} catch (Exception ignored) {
					json = [:]
				}
			}

			return [status: status, ok: (status >= 200 && status < 300), body: responseBody, json: json]
		} catch (Exception e) {
			return [status: 0, ok: false, body: '', json: [:], message: e.message]
		} finally {
			try { connection?.disconnect() } catch (Exception ignored) {}
		}
	}

	private HttpURLConnection openConnection(String method, String path) {
		URL urlObj = new URL(normalizeBaseUrl(flow.JIRA_BASE_URL) + path)
		HttpURLConnection connection = (HttpURLConnection) urlObj.openConnection()
		connection.setRequestMethod(method)
		connection.setConnectTimeout(30000)
		connection.setReadTimeout(60000)
		connection.setUseCaches(false)
		connection.setDoInput(true)
		connection.setRequestProperty('Accept', 'application/json')
		connection.setRequestProperty(flow.AUTH_HEADER_NAME, safe(flow.AUTH_HEADER_PREFIX) + safe(flow.JIRA_TOKEN))
		return connection
	}

	private String readResponseBody(HttpURLConnection connection) {
		try {
			if (connection == null) {
				return ''
			}

			def stream = connection.getResponseCode() >= 400 ? connection.getErrorStream() : connection.getInputStream()
			if (stream == null) {
				return ''
			}

			ByteArrayOutputStream output = new ByteArrayOutputStream()
			byte[] buffer = new byte[8192]
			int read = 0
			while ((read = stream.read(buffer)) != -1) {
				output.write(buffer, 0, read)
			}
			stream.close()

			return new String(output.toByteArray(), StandardCharsets.UTF_8)
		} catch (Exception ignored) {
			return ''
		}
	}

	private boolean looksLikeJson(String text) {
		String value = safe(text)
		return value.startsWith('{') || value.startsWith('[')
	}

	private String normalizeBaseUrl(String value) {
		String base = safe(value)
		return base.endsWith('/') ? base.substring(0, base.length() - 1) : base
	}

	private String url(String value) {
		return URLEncoder.encode(safe(value), 'UTF-8')
	}

	private String safe(def value) {
		return value == null ? '' : value.toString().trim()
	}

	private boolean isBlank(def value) {
		return safe(value).isEmpty()
	}
