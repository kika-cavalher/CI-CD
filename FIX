	'PRD sum: ' + displayValue(result?.prdSum) + '\n' +
	'REC minimum: ' +
	displayValue(result?.recMinimum) + '\n' +
	'PRD minimum: ' +
	displayValue(result?.prdMinimum) + '\n' +
	'REC maximum: ' +
	displayValue(result?.recMaximum) + '\n' +
	'PRD maximum: ' +
	displayValue(result?.prdMaximum)
)


// ======================================================
// FINAL RESULT
// ======================================================

if (!success) {

	String finalErrorMessage =
		errors.isEmpty()
			? 'REC x PRD validation returned an unsuccessful result.'
			: errors

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[FAIL] Final validation result\n' +
		finalErrorMessage +
		(
			passedDetails.isEmpty()
				? ''
				: '\n\nSuccessful validations\n' +
					passedDetails
		)
	)

	KeywordUtil.markFailed(
		'REC x PRD validation failed for ' +
		validationName +
		'.\n' +
		finalErrorMessage
	)

} else {

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[PASS] Final validation result\n' +
		'REC x PRD validation completed successfully.\n' +
