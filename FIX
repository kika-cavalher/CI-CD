    @Keyword
    String getResolutionScriptPath() {
        String projectDir = RunConfiguration.getProjectDir()

        List<String> candidates = [
            "${projectDir}\\Scripts\\set_resolution.ps1",
            "${projectDir}\\Scripts\\set-resolution.ps1",
            "${projectDir}\\set_resolution.ps1",
            "${projectDir}\\set-resolution.ps1",
            'D:\\Projects\\eMatchStarters\\set-resolution.ps1'
        ]

        return firstExistingFile(candidates)
    }

    @Keyword
    String getWinAppDriverPath() {
        List<String> candidates = [
            'C:\\Program Files (x86)\\Windows Application Driver\\WinAppDriver.exe',
            'C:\\Program Files\\Windows Application Driver\\WinAppDriver.exe'
        ]

        return firstExistingFile(candidates)
    }

    @Keyword
    String getInstalledExePath() {
        String localAppData = System.getenv('LOCALAPPDATA')
        if (!localAppData) {
            return ''
        }

        File appsRoot = new File(localAppData, 'Apps\\2.0')
        if (!appsRoot.exists()) {
            return ''
        }

        List<File> matches = []
        appsRoot.eachFileRecurse { File file ->
            if (file.isFile() && file.name.equalsIgnoreCase('IXIS.eMatch.HIM.exe')) {
                matches << file
            }
        }

        if (matches.isEmpty()) {
            return ''
        }

        matches.sort { a, b -> b.lastModified() <=> a.lastModified() }
        return matches[0].absolutePath
    }

    @Keyword
    def startMatch(String currentUser, String targetWindowTitle) {
        KeywordUtil.logInfo("Starting eMatch for environment ${(readEnv() ?: 'REC')}")

        ensureWinAppDriverRunning()
        closeStaleMatchProcesses()
        safeQuitAppSession()
        safeQuitDesktopSession()
        sleepMs(1500)

        String installedExePath = getInstalledExePath()
        String shortcutPath = getShortcutPath()
        String launcherBat = getLauncherBat()

        boolean launched = false

        if (shortcutPath?.trim() && new File(shortcutPath).exists()) {
            KeywordUtil.logInfo("Launching shortcut: ${shortcutPath}")
            launchShortcut(shortcutPath)
            launched = true
        } else if (installedExePath?.trim() && new File(installedExePath).exists()) {
            KeywordUtil.logInfo("Launching installed exe: ${installedExePath}")
            launchExecutable(installedExePath)
            launched = true
        } else if (launcherBat?.trim() && new File(launcherBat).exists()) {
            KeywordUtil.logInfo("Launching launcher bat: ${launcherBat}")
            launchBat(launcherBat)
            launched = true
        }

        if (!launched) {
            throw new IllegalStateException('Could not launch eMatch. Shortcut, installed exe and launcher bat were not found.')
        }

        waitForStartupSignal(STARTUP_SIGNAL_TIMEOUT_SECONDS)
        KeywordUtil.logInfo('Launch command sent successfully. Window attach will be handled by attachToLoginWindow.')
        return true
    }

    @Keyword
    def attachToLoginWindow(String targetWindowTitle) {
        KeywordUtil.logInfo("Attaching to login window. Expected title ${targetWindowTitle}")

        ensureDesktopSession()

        WebElement matchWindow = waitAndFindWindow(targetWindowTitle, DEFAULT_ATTACH_TIMEOUT_SECONDS)
        if (matchWindow == null) {
            throw new IllegalStateException("Could not find eMatch window with title '${targetWindowTitle}'")
        }

        String nativeHandle = readNativeHandle(matchWindow)
        if (!nativeHandle?.trim()) {
            throw new IllegalStateException("NativeWindowHandle was not found for '${targetWindowTitle}'")
        }

        String hexHandle = decimalToHex(nativeHandle)
        KeywordUtil.logInfo("Detected main window title at handle ${nativeHandle}")
        KeywordUtil.logInfo("Attaching by native handle ${hexHandle}")

        recreateAppSession(hexHandle)
        waitUntilTrue(30, 500) { appSession != null && isSessionAlive(appSession) }

        focusAttachedWindow()

        KeywordUtil.logInfo('Attached to eMatch session successfully by window handle')
        return true
    }

    @Keyword
    def openEnvironmentDropdown() {
        ensureAppSession()

        KeywordUtil.logInfo('Opening environment dropdown')
        focusAttachedWindow()
        sleepMs(500)

        pressAltDown()
        sleepMs(700)

        return true
    }

    @Keyword
    int resolveEnvironmentIndex(String env) {
        String normalized = normalizeEnv(env)

        Map<String, Integer> map = [
            'PROD'   : 0,
            'PREPROD': 1,
            'REC2'   : 2,
            'REC'    : 3,
            'DEV2'   : 4,
            'DEV'    : 5
        ]

        return map.containsKey(normalized) ? map[normalized] : 3
    }

    @Keyword
    def selectEnvironment(String env) {
        ensureAppSession()

        int envIndex = resolveEnvironmentIndex(env)
        KeywordUtil.logInfo("Selecting environment ${env} with index ${envIndex}")

        focusAttachedWindow()
        sleepMs(400)

        pressKey(KeyEvent.VK_HOME)
        sleepMs(300)

        for (int i = 0; i < envIndex; i++) {
            pressKey(KeyEvent.VK_DOWN)
            sleepMs(250)
        }

        pressKey(KeyEvent.VK_ENTER)
        sleepMs(1000)

        return true
    }

    @Keyword
    boolean isConnectButtonPresent() {
        ensureAppSession()
        return findConnectButton(5) != null
    }

    @Keyword
    def clickConnectButton() {
        ensureAppSession()

        WebElement button = findConnectButton(10)
        if (button != null) {
            KeywordUtil.logInfo('Connect button was present and will be clicked.')
            button.click()
            sleepMs(1200)
            return true
        }

        throw new IllegalStateException('Connect button was not found.')
    }

    @Keyword
    boolean waitForMainScreen() {
        ensureAppSession()

        boolean loaded = waitUntilTrue(60, 1000) {
            if (isAnyElementPresent(appSession, By.xpath("//*[contains(@Name,'Rafraich')]"))) {
                return true
            }

            if (isAnyElementPresent(appSession, By.xpath("//*[contains(@Name,'Rafraîch')]"))) {
                return true
            }

            if (isAnyElementPresent(appSession, By.xpath("//*[contains(@Name,'Accueil')]"))) {
                return true
            }

            if (!isConnectButtonPresentSafely()) {
                return true
            }

            return false
        }

        if (!loaded) {
            KeywordUtil.logInfo('Main eMatch screen was not confirmed by ribbon or login disappearance.')
        }

        return loaded
    }

    @Keyword
    def activateHomeTab() {
        ensureAppSession()

        List<By> locators = [
            By.name('Accueil'),
            By.xpath("//*[contains(@Name,'Accueil')]")
        ]

        for (By locator : locators) {
            if (isAnyElementPresent(appSession, locator)) {
                try {
                    appSession.findElement(locator).click()
                    sleepMs(800)
                    return true
                } catch (Throwable ignored) {
                }
            }
        }

        KeywordUtil.logInfo('Home tab was not explicitly clicked. Continuing because the main window is already attached.')
        return true
    }

    private String readEnv() {
        try {
            String env = String.valueOf(GlobalVariable.env ?: '').trim()
            return env ? env : 'REC'
        } catch (Throwable ignored) {
            return 'REC'
        }
    }

    private String normalizeEnv(String env) {
        String value = String.valueOf(env ?: '').trim().toUpperCase()

        if (!value) {
            return 'REC'
        }

        if (value in ['PROD', 'PRODUCTION']) return 'PROD'
        if (value in ['PREPROD', 'PRE-PROD', 'BENCH']) return 'PREPROD'
        if (value in ['REC2', 'QUALIFICATION']) return 'REC2'
        if (value in ['REC', 'RECETTE']) return 'REC'
        if (value in ['DEV2', 'SIMULATION']) return 'DEV2'
        if (value in ['DEV', 'DEVELOPMENT', 'DÉVELOPPEMENT']) return 'DEV'

        return value
    }

    private String firstExistingFile(List<String> candidates) {
        for (String path : candidates) {
            if (path?.trim() && new File(path).exists()) {
                return path
            }
        }
        return candidates ? String.valueOf(candidates[0] ?: '') : ''
    }

    private void ensureWinAppDriverRunning() {
        if (isPortOpen('127.0.0.1', 4723, 500)) {
            KeywordUtil.logInfo('WinAppDriver already running on 127.0.0.1:4723')
            return
        }

        String winAppDriverPath = getWinAppDriverPath()
        if (!winAppDriverPath?.trim() || !new File(winAppDriverPath).exists()) {
            throw new IllegalStateException("WinAppDriver.exe was not found. Expected path: ${winAppDriverPath}")
        }

        KeywordUtil.logInfo("Starting WinAppDriver minimized from ${winAppDriverPath}")
        new ProcessBuilder(
            'cmd',
            '/c',
            "start \"\" /min \"${winAppDriverPath}\" 127.0.0.1 4723"
        ).start()

        boolean opened = waitUntilTrue(20, 500) {
            isPortOpen('127.0.0.1', 4723, 500)
        }

        if (!opened) {
            throw new IllegalStateException('WinAppDriver did not start on port 4723.')
        }
    }

    private void ensureDesktopSession() {
        if (desktopSession != null && isSessionAlive(desktopSession)) {
            return
        }

        safeQuitDesktopSession()

        DesiredCapabilities caps = new DesiredCapabilities()
        caps.setCapability('app', 'Root')
        caps.setCapability('platformName', 'Windows')
        caps.setCapability('deviceName', 'WindowsPC')
        caps.setCapability('ms:waitForAppLaunch', '25')

        desktopSession = new WindowsDriver<WebElement>(new URL(WINAPPDRIVER_URL), caps)
        desktopSession.manage().timeouts().implicitlyWait(Duration.ofSeconds(1))
    }

    private void ensureAppSession() {
        if (appSession != null && isSessionAlive(appSession)) {
            return
        }

        throw new IllegalStateException('App session is not attached. attachToLoginWindow must run first.')
    }

    private boolean isSessionAlive(WindowsDriver<WebElement> session) {
        try {
            session.getTitle()
            return true
        } catch (Throwable ignored) {
            return false
        }
    }

    private void recreateAppSession(String hexHandle) {
        safeQuitAppSession()

        DesiredCapabilities caps = new DesiredCapabilities()
        caps.setCapability('appTopLevelWindow', hexHandle)
        caps.setCapability('platformName', 'Windows')
        caps.setCapability('deviceName', 'WindowsPC')
        caps.setCapability('ms:waitForAppLaunch', '25')

        appSession = new WindowsDriver<WebElement>(new URL(WINAPPDRIVER_URL), caps)
        appSession.manage().timeouts().implicitlyWait(Duration.ofSeconds(1))
    }

    private void safeQuitDesktopSession() {
        try {
            desktopSession?.quit()
        } catch (Throwable ignored) {
        }
        desktopSession = null
    }

    private void safeQuitAppSession() {
        try {
            appSession?.quit()
        } catch (Throwable ignored) {
        }
        appSession = null
    }

    private WebElement waitAndFindWindow(String expectedTitle, int timeoutSeconds) {
        ensureDesktopSession()

        final WebElement[] found = [null] as WebElement[]
        int round = 0

        waitUntilTrue(timeoutSeconds, 1000) {
            round++

            try {
                found[0] = findWindowByTitle(expectedTitle)

                if (found[0] != null) {
                    KeywordUtil.logInfo("Detected main window title at attempt ${round}: ${expectedTitle}")
                    return true
                }

                KeywordUtil.logInfo("Window title not found yet at attempt ${round}: ${expectedTitle}")
                return false
            } catch (Throwable t) {
                KeywordUtil.logInfo("Window search failed at attempt ${round}: ${t.message}")
                return false
            }
        }

        return found[0]
    }

    private WebElement findWindowByTitle(String expectedTitle) {
        List<WebElement> exact = safeFindElements(desktopSession, By.name(expectedTitle))
        if (exact && !exact.isEmpty()) {
            return exact[0]
        }

        List<WebElement> partial = safeFindElements(desktopSession, By.xpath("//*[contains(@Name,'eMatch')]"))
        if (partial && !partial.isEmpty()) {
            for (WebElement element : partial) {
                try {
                    String name = String.valueOf(element.getAttribute('Name') ?: '').trim()
                    if (name.equalsIgnoreCase(expectedTitle)) {
                        return element
                    }
                } catch (Throwable ignored) {
                }
            }

            for (WebElement element : partial) {
                try {
                    String name = String.valueOf(element.getAttribute('Name') ?: '').trim()
                    if (name.toLowerCase().contains('ematch')) {
                        return element
                    }
                } catch (Throwable ignored) {
                }
            }
        }

        return null
    }

    private String readNativeHandle(WebElement element) {
        try {
            return String.valueOf(element.getAttribute('NativeWindowHandle') ?: '').trim()
        } catch (Throwable ignored) {
            return ''
        }
    }

    private String decimalToHex(String value) {
        long parsed = Long.parseLong(value.trim())
        return Long.toHexString(parsed).toUpperCase()
    }

    private void focusAttachedWindow() {
        try {
            appSession.findElement(By.name(resolveWindowTitle())).click()
            sleepMs(300)
            return
        } catch (Throwable ignored) {
        }

        try {
            appSession.getPageSource()
            sleepMs(300)
        } catch (Throwable ignored) {
        }
    }

    private WebElement findConnectButton(int timeoutSeconds) {
        final WebElement[] found = [null] as WebElement[]

        waitUntilTrue(timeoutSeconds, 500) {
            List<WebElement> buttons = safeFindElements(appSession, By.name('Se connecter'))
            if (buttons && !buttons.isEmpty()) {
                found[0] = buttons[0]
                return true
            }

            buttons = safeFindElements(appSession, By.xpath("//*[contains(@Name,'connecter')]"))
            if (buttons && !buttons.isEmpty()) {
                found[0] = buttons[0]
                return true
            }

            return false
        }

        return found[0]
    }

    private boolean isConnectButtonPresentSafely() {
        try {
            return findConnectButton(1) != null
        } catch (Throwable ignored) {
            return false
        }
    }

    private List<WebElement> safeFindElements(WindowsDriver<WebElement> session, By locator) {
        try {
            return session.findElements(locator)
        } catch (Throwable ignored) {
            return []
        }
    }

    private boolean isAnyElementPresent(WindowsDriver<WebElement> session, By locator) {
        try {
            List<WebElement> elements = session.findElements(locator)
            return elements != null && !elements.isEmpty()
        } catch (Throwable ignored) {
            return false
        }
    }

    private void waitForStartupSignal(int timeoutSeconds) {
        long end = System.currentTimeMillis() + (timeoutSeconds * 1000L)

        while (System.currentTimeMillis() < end) {
            try {
                if (isAnyMatchProcessRunning()) {
                    KeywordUtil.logInfo('eMatch process detected after launch')
                    return
                }

                ensureDesktopSession()
                WebElement window = findWindowByTitle(resolveWindowTitle())
                if (window != null) {
                    KeywordUtil.logInfo("eMatch window detected during startup wait: ${resolveWindowTitle()}")
                    return
                }
            } catch (Throwable ignored) {
            }

            sleepMs(1000)
        }

        KeywordUtil.logInfo('Startup signal not detected yet, continuing to attach step')
    }

    private boolean isAnyMatchProcessRunning() {
        try {
            Process p = new ProcessBuilder(
                'cmd',
                '/c',
                'tasklist /FI "IMAGENAME eq IXIS.eMatch.HIM.exe"'
            ).start()

            String output = p.inputStream.getText('CP850')
            return output != null && output.toLowerCase().contains('ixis.ematch.him.exe')
        } catch (Throwable ignored) {
            return false
        }
    }

    private void closeStaleMatchProcesses() {
        try {
            runCommand('taskkill /F /IM "IXIS.eMatch.HIM.exe" /T')
        } catch (Throwable ignored) {
        }

        sleepMs(1200)
    }

    private void launchShortcut(String shortcutPath) {
        String escapedPath = shortcutPath.replace("'", "''")

        new ProcessBuilder(
            'powershell',
            '-NoProfile',
            '-ExecutionPolicy', 'Bypass',
            '-Command',
            "Start-Process -FilePath '${escapedPath}'"
        ).start()
    }

    private void launchExecutable(String exePath) {
        new ProcessBuilder(
            'cmd',
            '/c',
            "start \"\" \"${exePath}\""
        ).start()
    }

    private void launchBat(String batPath) {
        new ProcessBuilder(
            'cmd',
            '/c',
            "start \"\" \"${batPath}\""
        ).start()
    }

    private String runCommand(String command) {
        Process p = new ProcessBuilder('cmd', '/c', command).start()
        p.waitFor()
        return p.inputStream.getText('CP850')
    }

    private boolean isPortOpen(String host, int port, int timeoutMs) {
        try {
            Socket socket = new Socket()
            socket.connect(new java.net.InetSocketAddress(host, port), timeoutMs)
            socket.close()
            return true
        } catch (Throwable ignored) {
            return false
        }
    }

    private boolean waitUntilTrue(int timeoutSeconds, int pollMs, Closure<Boolean> condition) {
        long end = System.currentTimeMillis() + (timeoutSeconds * 1000L)

        while (System.currentTimeMillis() < end) {
            try {
                if (Boolean.TRUE.equals(condition.call())) {
                    return true
                }
            } catch (Throwable ignored) {
            }

            sleepMs(pollMs)
        }

        return false
    }

    private void sleepMs(long ms) {
        try {
            Thread.sleep(ms)
        } catch (InterruptedException ignored) {
            Thread.currentThread().interrupt()
        }
    }

    private void pressAltDown() {
        Robot robot = new Robot()
        robot.setAutoDelay(80)

        robot.keyPress(KeyEvent.VK_ALT)
        robot.keyPress(KeyEvent.VK_DOWN)
        robot.keyRelease(KeyEvent.VK_DOWN)
        robot.keyRelease(KeyEvent.VK_ALT)
    }

    private void pressKey(int keyCode) {
        Robot robot = new Robot()
        robot.setAutoDelay(80)

        robot.keyPress(keyCode)
        robot.keyRelease(keyCode)
    }
}
