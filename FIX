def failAndStop = { String message ->
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(message)
	KeywordUtil.markFailed(message)
	KeywordUtil.markFailedAndStop(message)
}

def isPortOpen = { String host, int port ->
	try {
		Socket socket = new Socket(host, port)
		socket.close()
		return true
	} catch (Exception e) {
		return false
	}
}

def waitForWinAppDriver = { int timeoutSec ->
	int elapsed = 0

	while (elapsed < timeoutSec) {
		if (isPortOpen('127.0.0.1', 4723)) {
			CustomKeywords.'jiraIntegration.JiraReportSteps.note'('WinAppDriver is listening on port 4723')
			return true
		}

		Windows.delay(1)
		elapsed++
	}

	return false
}

def ensureWinAppDriverStarted = {
	if (isPortOpen('127.0.0.1', 4723)) {
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'('WinAppDriver already running')
		return
	}

	File driverFile = new File(WINAPPDRIVER_EXE)
	if (!driverFile.exists()) {
		failAndStop("WinAppDriver.exe not found at: ${WINAPPDRIVER_EXE}")
	}

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Starting WinAppDriver: ${WINAPPDRIVER_EXE}")

	new ProcessBuilder(WINAPPDRIVER_EXE).start()

	boolean started = waitForWinAppDriver(15)

	if (!started) {
		failAndStop('WinAppDriver did not start listening on port 4723')
	}
}

def buildWindowObject = { String title ->
	WindowsTestObject targetWindow = new WindowsTestObject()
	targetWindow.setLocatorStrategy(LocatorStrategy.NAME)
	targetWindow.setLocator(title)
	return targetWindow
}

def switchToWindowWithRetry = { String title ->
	WindowsTestObject targetWindow = buildWindowObject(title)

	int elapsedTime = 0
	boolean windowFound = false

	while (elapsedTime < WINDOW_ATTACH_TIMEOUT_SEC) {
		try {
			Windows.switchToDesktop()
			Windows.switchToWindow(targetWindow)
			windowFound = true
			CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Attached to window: ${title}")
			break
		} catch (Exception e) {
			CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Window not ready yet: ${title} | ${e.getMessage()}")
			Windows.delay(WINDOW_ATTACH_RETRY_SEC)
			elapsedTime += WINDOW_ATTACH_RETRY_SEC
		}
	}

	if (!windowFound) {
		failAndStop("Target window '${title}' could not be found within ${WINDOW_ATTACH_TIMEOUT_SEC} seconds.")
	}
}

def selectEnvironmentByKeyboard = { String envName ->
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Selecting environment: ${envName}")

	int env = 4

	switch (envName) {
		case 'PROD':
			env = 1
			break
		case 'PREX':
			env = 2
			break
		case 'REC2':
			env = 3
			break
		case 'REC':
			env = 4
			break
		case 'DEV2':
			env = 5
			break
		case 'DEV':
			env = 6
			break
	}

	Windows.click(findWindowsObject('Login Page/optEnv'))
	Windows.delay(1)

	for (int i = 0; i < env; i++) {
		Windows.sendKeys(findWindowsObject('Login Page/optEnv'), Keys.chord(Keys.ARROW_DOWN))
	}

	Windows.sendKeys(findWindowsObject('Login Page/optEnv'), Keys.chord(Keys.ENTER))
	Windows.delay(5)
}

def clickConnectIfPresent = {
	boolean isButtonPresent = Windows.verifyElementPresent(
		findWindowsObject('Login Page/btnConnecter'),
		1,
		FailureHandling.OPTIONAL
	)

	if (isButtonPresent) {
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Connect button was present and will be clicked')
		Windows.click(findWindowsObject('Login Page/btnConnecter'))
	} else {
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Connect button not present, continuing')
	}
}

def activateHomeTabIfNeeded = {
	String homeGrey = new File(RunConfiguration.getProjectDir(), 'Images/General/HomeGrey.PNG').getAbsolutePath()
	String homeWhite = new File(RunConfiguration.getProjectDir(), 'Images/General/HomeWhite.PNG').getAbsolutePath()

	try {
		def activeTab = WindowsImageKeywords.findImage(homeGrey)
		if (activeTab != null) {
			CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Home tab already active')
			return
		}
	} catch (Exception ignored) {
	}

	try {
		def inactiveTab = WindowsImageKeywords.findImage(homeWhite)
		if (inactiveTab != null) {
			CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Home tab inactive, clicking')
			Windows.click(inactiveTab)
			Windows.delay(5)
		} else {
			CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Home tab image not found')
		}
	} catch (Exception e) {
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Error while activating Home tab: ${e.getMessage()}")
	}
}

try {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Ensuring WinAppDriver before starting application')
	ensureWinAppDriverStarted()

	if (currentUser == 'adgi5appjenkins') {
		try {
			if (new File(RESOLUTION_SCRIPT_PATH).exists()) {
				CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Running resolution script: ${RESOLUTION_SCRIPT_PATH}")
				String cmd = "Powershell.exe -ExecutionPolicy Bypass -File ${RESOLUTION_SCRIPT_PATH}"
				Runtime.getRuntime().exec(cmd)
				Windows.delay(2)
			}
		} catch (Exception e) {
			CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Resolution script failed but flow will continue: ${e.getMessage()}")
		}

		CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Starting eMatch using shortcut with title: ${GlobalVariable.versionProd}")
		Windows.startApplicationWithTitle(EMATCH_LNK_PATH, GlobalVariable.versionProd)
	} else {
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Starting eMatch using .application path")
		Windows.startApplication(EMATCH_APPLICATION_PATH)
	}

	Windows.delay(5)

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Selecting credentials modal')
	switchToWindowWithRetry(GlobalVariable.versionProd)

	selectEnvironmentByKeyboard(GlobalVariable.env)

	clickConnectIfPresent()

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Waiting for main eMatch screen')
	boolean loaded = Windows.waitForElementPresent(findWindowsObject('General/txtSearch'), SEARCH_BOX_TIMEOUT_SEC)

	if (!loaded) {
		failAndStop("eMatch main screen was not loaded. Object 'General/txtSearch' not found.")
	}

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Opened login screen')

	Windows.delay(10)

	activateHomeTabIfNeeded()

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'('eMatch startup flow completed successfully')
}
catch (Throwable t) {
	failAndStop("Failed to start and initialize eMatch. ${t.getClass().getName()}: ${t.getMessage()}")
}
