package connection

import static com.kms.katalon.core.testcase.TestCaseFactory.findTestCase

import java.util.regex.Pattern

import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI

import cucumber.api.java.en.Given
import cucumber.api.java.en.Then

class AuthenticationSteps {

    @Given("user opens Google")
    def userOpensGoogle() {
        WebUI.openBrowser('')
        WebUI.navigateToUrl('https://www.google.com')
    }

    @Then('page title should contain "(.*)"')
    def pageTitleShouldContain(String expectedTitle) {
        String currentTitle = WebUI.getWindowTitle()
        WebUI.verifyMatch(currentTitle, ".*${Pattern.quote(expectedTitle)}.*", true)
        WebUI.closeBrowser()
    }
}
