pipeline {
  agent { label 'GI5_SWDCFRNXGI55817' }

  parameters {
    booleanParam(name: 'SHOW_BROWSER', defaultValue: true, description: 'Show Chrome UI using Scheduled Task (requires RDP session active).')
  }

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 75, unit: 'MINUTES')
  }

  environment {
    REPO_URL          = 'https://bitbucket-mut.mycloud.intrabpce.fr/scm/gi5/gaia-portal.git'
    REPO_CRED         = '965eceec-b3a3-4ec5-8820-a857c87dd80f'
    WORK_DIR          = "${env.WORKSPACE}"
    REPORTS_DIR       = "${env.WORKSPACE}\\Reports"
    KATALON_LOG       = "${env.WORKSPACE}\\katalon_console.log"
  }

  stages {

    stage('Start Gaia Backend and Frontend') {
      steps {
        echo "[gaia-start] Trigger GaiaBackFrontSetup"
        bat 'schtasks /run /tn "GaiaBackFrontSetup"'
        echo "[gaia-start] Waiting 300 seconds..."
        sleep(time: 300, unit: 'SECONDS')
      }
    }

    stage('PreClean (unlock workspace)') {
      steps {
        powershell '''
          $ErrorActionPreference="SilentlyContinue"
          function Log($m){ Write-Host "[preclean] $m" }

          Log "Killing common lockers (best effort)..."

          # Kill browsers/drivers that lock reports or drivers
          $names = @(
            "chrome","chromedriver","msedge","msedgedriver","geckodriver",
            "katalonc","katalon","eclipse","java"
          )

          foreach($n in $names){
            Get-Process -Name $n -ErrorAction SilentlyContinue | ForEach-Object {
              try { Stop-Process -Id $_.Id -Force -ErrorAction SilentlyContinue; Log ("Stopped: " + $_.Name + " PID=" + $_.Id) } catch {}
            }
          }

          Log "PreClean done."
          exit 0
        '''
      }
    }

    stage('Hard clean workspace (retry)') {
      steps {
        script {
          echo "[clean] Trying Jenkins cleanWs..."
          cleanWs(deleteDirs: true, disableDeferredWipeout: true, notFailBuild: true)

          // If .git is corrupt or leftover, nuke it explicitly
          powershell '''
            $ErrorActionPreference="SilentlyContinue"
            function Log($m){ Write-Host "[clean] $m" }

            $git = Join-Path $env:WORKSPACE ".git"
            if(Test-Path $git){
              Log "Found .git leftover. Removing..."
              cmd /c "rmdir /s /q \"$git\" & exit 0" | Out-Null
            }

            exit 0
          '''
        }
      }
    }

    stage('Checkout gaia-portal (fresh)') {
      steps {
        echo "[checkout] Fresh clone..."
        checkout([$class: 'GitSCM',
          branches: [[name: '*/master']],
          userRemoteConfigs: [[credentialsId: env.REPO_CRED, url: env.REPO_URL]],
          extensions: [
            [$class: 'WipeWorkspace'],                 // stronger than cleanWs for Git step
            [$class: 'CleanBeforeCheckout']            // ensures clean checkout behavior
          ]
        ])
        echo "[checkout] Done."
      }
    }

    stage('Run GAIA TSC (VISIBLE or HEADLESS)') {
      steps {
        script {
          def taskName = params.SHOW_BROWSER ? 'GaiaKatalon_Visible' : 'GaiaKatalon_Headless'
          echo "[katalon] Trigger scheduled task: ${taskName}"

          // Start task
          bat "schtasks /run /tn \"${taskName}\""

          // Wait until log file appears (means task started)
          powershell """
            \$ErrorActionPreference="SilentlyContinue"
            function Log(\$m){ Write-Host "[katalon] \$m" }

            New-Item -ItemType Directory -Force -Path '${env.REPORTS_DIR}' | Out-Null

            \$log = '${env.KATALON_LOG}'
            \$i=0
            while(\$i -lt 120 -and !(Test-Path \$log)){
              Start-Sleep -Seconds 2
              \$i++
            }

            if(Test-Path \$log){ Log "Log detected: \$log" } else { Log "WARNING: log not detected yet." }
            exit 0
          """

          // Tail last lines (best effort)
          powershell """
            \$ErrorActionPreference="SilentlyContinue"
            \$log='${env.KATALON_LOG}'
            if(Test-Path \$log){
              Write-Host "[katalon] Last 80 lines:"
              Get-Content \$log -Tail 80 | ForEach-Object { Write-Host ("[katalon] " + \$_) }
            } else {
              Write-Host "[katalon] No katalon_console.log found."
            }
            exit 0
          """
        }
      }
    }
  }

  post {
    always {
      echo "[post] Archiving logs & reports..."
      archiveArtifacts artifacts: 'katalon_console.log, Reports/**/*.*', allowEmptyArchive: true
    }
  }
}
 
