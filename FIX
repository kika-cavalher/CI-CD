		def matcherA = (raw =~ /^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3})/)
		if (matcherA.find()) {
			try {
				Date value = new SimpleDateFormat('yyyy-MM-dd HH:mm:ss.SSS', Locale.ENGLISH).parse(matcherA.group(1))
				return new SimpleDateFormat('HH:mm:ss', Locale.ENGLISH).format(value)
