	)

	KeywordUtil.markPassed(
		'REC x PRD validation completed successfully for ' +
		validationName +
		'.'
	)
}


// ======================================================
// HELPERS
// ======================================================

String displayValue(Object value) {

	String text = safeText(value)

	return text.isEmpty()
		? 'NOT AVAILABLE'
		: text
}


String safeText(Object value) {

	if (value == null) {
		return ''
	}

	return value.toString().trim()
}






