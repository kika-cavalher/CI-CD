	def getSavedTestPlanKey() {
		File file = new File(getSuiteTestPlanFilePath())

		if (!file.exists()) {
			return ''
		}

		String key = file.text?.trim()

		if (key == null || key.isEmpty()) {
			return ''
		}

		KeywordUtil.logInfo("Saved Test Plan key found for suite '${getCurrentSuiteName()}': ${key}")
		return key
	}

	def saveTestPlanKey(String testPlanKey) {
		if (testPlanKey == null || testPlanKey.trim().isEmpty()) {
			return
		}

		File file = new File(getSuiteTestPlanFilePath())
		file.write(testPlanKey.trim(), 'UTF-8')

		KeywordUtil.logInfo("Saved Test Plan key '${testPlanKey}' for suite '${getCurrentSuiteName()}'.")
	}

	@Keyword
	def resetTestPlanKey() {
		File file = new File(getSuiteTestPlanFilePath())

		if (!file.exists()) {
			KeywordUtil.logInfo("No saved Test Plan key file found for this suite.")
			return
		}

		file.write('', 'UTF-8')
		KeywordUtil.logInfo("Saved Test Plan key cleared for suite '${getCurrentSuiteName()}'.")
	}

