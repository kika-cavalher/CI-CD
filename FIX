pipeline {
    agent none

    options {
        // Add timestamp to every console line
        timestamps()

        // Enable colored console output
        ansiColor('xterm')

        // Prevent concurrent builds of this pipeline
        disableConcurrentBuilds()

        // Global timeout for the whole pipeline
        timeout(time: 50, unit: 'MINUTES')

        // Keep Jenkins history under control
        buildDiscarder(logRotator(numToKeepStr: '10', daysToKeepStr: '14'))

        // Skip automatic checkout because checkout is done manually
        skipDefaultCheckout(true)
    }

    parameters {
        choice(
            name: 'RUN_MODE',
            choices: ['VISIBLE', 'HEADLESS'],
            description: 'Choose how Chrome should run'
        )

        string(
            name: 'STARTUP_WAIT_SECONDS',
            defaultValue: '60',
            description: 'Seconds to wait after Gaia startup'
        )
    }

    environment {
        // Katalon Engine installation path
        KATALON_HOME = 'C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0'

        // Git repository information
        GIT_URL      = 'https://bitbucket-mut.mycloud.intrabpce.fr/scm/gi5/gaia-portal.git'
        GIT_CRED     = '965eceec-b3a3-4ec5-8820-a857c87dd80f'

        // Fixed project file name inside the workspace
        PROJECT_FILE = 'gaia-portal.prj'

        // Reports directory inside the fixed workspace
        REPORTS_DIR  = 'Reports'

        // Browser resolution
        DISPLAY_WIDTH  = '1920'
        DISPLAY_HEIGHT = '1080'

        // Fixed workspace to avoid @2, @3 and @tmp folders
        FIXED_WS = 'D:\\jenkins\\work\\workspace\\GI5\\Gaia\\Gaia'

        // Gaia startup scheduled task
        GAIA_START_TASK = 'GaiaBackFrontSetup'
    }

    stages {
        stage('Execute on fixed node') {
            agent {
                node {
                    // Always use the existing Jenkins node
                    label 'GI5_SWDCFRNXGI55817'

                    // Always use the same workspace
                    customWorkspace 'D:\\jenkins\\work\\workspace\\GI5\\Gaia\\Gaia'
                }
            }

            stages {

                stage('Environment Setup') {
                    steps {
                        script {
                            echo "========================================"
                            echo "Starting Gaia pipeline"
                            echo "Build Number : ${env.BUILD_NUMBER}"
                            echo "Node         : ${env.NODE_NAME}"
                            echo "Workspace    : ${env.WORKSPACE}"
                            echo "Run Mode     : ${params.RUN_MODE}"
                            echo "Project File : ${env.PROJECT_FILE}"
                            echo "========================================"
                        }

                        bat """
                            @echo off
                            REM Prepare report folders in the fixed workspace

                            echo Preparing reports directory...

                            if exist "${env.REPORTS_DIR}" (
                                echo Cleaning existing reports...
                                rmdir /s /q "${env.REPORTS_DIR}"
                            )

                            mkdir "${env.REPORTS_DIR}"
                            mkdir "${env.REPORTS_DIR}\\_jenkins_summary"

                            echo Reports directory ready
                            exit /b 0
                        """

                        script {
                            writeFile file: "${env.REPORTS_DIR}\\_jenkins_summary\\build_description.txt", text: ""
                            echo "Environment setup completed"
                        }
                    }
                }

                stage('Start Gaia Backend and Frontend') {
                    steps {
                        script {
                            echo "========================================"
                            echo "Starting Gaia backend and frontend"
                            echo "Task Name: ${env.GAIA_START_TASK}"
                            echo "========================================"
                        }

                        bat """
                            @echo off
                            REM Start Gaia backend and frontend from Task Scheduler

                            schtasks /run /tn "${env.GAIA_START_TASK}"
                            exit /b 0
                        """

                        script {
                            echo "Waiting ${params.STARTUP_WAIT_SECONDS}s for Gaia to start..."
                        }

                        sleep(time: params.STARTUP_WAIT_SECONDS.toInteger(), unit: 'SECONDS')

                        script {
                            echo "Gaia startup wait finished"
                        }
                    }
                }

                stage('Checkout gaia-portal') {
                    steps {
                        script {
                            echo "========================================"
                            echo "Cleaning fixed workspace before checkout"
                            echo "Workspace: ${env.WORKSPACE}"
                            echo "========================================"
                        }

                        deleteDir()

                        script {
                            echo "========================================"
                            echo "Checking out repository"
                            echo "Branch: master"
                            echo "Repo  : ${env.GIT_URL}"
                            echo "========================================"
                        }

                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: '*/master']],
                            userRemoteConfigs: [[url: env.GIT_URL, credentialsId: env.GIT_CRED]],
                            extensions: [
                                [$class: 'WipeWorkspace'],
                                [$class: 'CloneOption', shallow: false, noTags: false, timeout: 30]
                            ]
                        ])

                        bat """
                            @echo off
                            REM Recreate reports folders after checkout

                            if not exist "${env.REPORTS_DIR}" mkdir "${env.REPORTS_DIR}"
                            if not exist "${env.REPORTS_DIR}\\_jenkins_summary" mkdir "${env.REPORTS_DIR}\\_jenkins_summary"

                            exit /b 0
                        """

                        script {
                            writeFile file: "${env.REPORTS_DIR}\\_jenkins_summary\\build_description.txt", text: ""
                            echo "Checkout completed successfully"
                        }
                    }
                }

                stage('Run GAIA TSC') {
                    steps {
                        script {
                            def browserType = 'Chrome'
                            def chromeArgs = buildChromeArgs(params.RUN_MODE)
                            def projectPath = "${env.WORKSPACE}\\${env.PROJECT_FILE}"
                            def reportPath  = "${env.WORKSPACE}\\${env.REPORTS_DIR}"

                            echo "========================================"
                            echo "Starting Katalon"
                            echo "Suite Collection : Test Suites/GAIA TSC"
                            echo "Browser          : ${browserType}"
                            echo "Run Mode         : ${params.RUN_MODE}"
                            echo "Node             : ${env.NODE_NAME}"
                            echo "Workspace        : ${env.WORKSPACE}"
                            echo "Project Path     : ${projectPath}"
                            echo "Report Folder    : ${reportPath}"
                            echo "========================================"

                            // Do not swallow manual aborts
                            catchError(
                                buildResult: 'SUCCESS',
                                stageResult: 'FAILURE',
                                catchInterruptions: false
                            ) {
                                executeKatalon(
                                    location: env.KATALON_HOME,
                                    executeArgs:
                                        "-projectPath=\"${projectPath}\" " +
                                        "-testSuiteCollectionPath=\"Test Suites/GAIA TSC\" " +
                                        "-browserType=\"${browserType}\" " +
                                        "-consoleLog -logLevel=DEBUG " +
                                        "-reportFolder=\"${reportPath}\" " +
                                        chromeArgs,
                                    version: '',
                                    x11Display: '',
                                    xvfbConfiguration: ''
                                )
                            }

                            echo "Katalon execution finished"
                        }
                    }
                }
            }

            post {
                always {
                    script {
                        echo "Archiving reports..."
                    }

                    archiveArtifacts artifacts: 'Reports/**/*', allowEmptyArchive: true, excludes: '**/*.lck'

                    catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE', catchInterruptions: false) {
                        junit allowEmptyResults: true, testResults: 'Reports/**/JUnit_Report.xml, Reports/**/junit*.xml, Reports/**/TEST-*.xml'
                    }

                    script {
                        def result = currentBuild.currentResult ?: 'UNKNOWN'

                        if (result == 'SUCCESS') {
                            echo "SUCCESS: All good"
                        } else if (result == 'UNSTABLE') {
                            echo "UNSTABLE: Finished with test failures"
                        } else if (result == 'ABORTED') {
                            echo "ABORTED: Build was canceled by user"
                        } else {
                            echo "FAILURE: Pipeline failed. Check console and reports"
                        }
                    }
                }

                aborted {
                    echo 'ABORTED: Cancel requested by user. Stopping external processes now...'

                    bat """
                        @echo off
                        REM Stop external processes immediately when the build is aborted

                        schtasks /end /tn "${env.GAIA_START_TASK}" >nul 2>&1

                        taskkill /IM katalonc.exe /T /F >nul 2>&1
                        taskkill /IM chrome.exe /T /F >nul 2>&1
                        taskkill /IM chromedriver.exe /T /F >nul 2>&1

                        exit /b 0
                    """
                }
            }
        }
    }
}

/**
 * Build Chrome arguments according to the selected run mode.
 */
def buildChromeArgs(runMode) {
    if (runMode == 'HEADLESS') {
        def args = [
            '--headless=new',
            "--window-size=${env.DISPLAY_WIDTH},${env.DISPLAY_HEIGHT}",
            '--no-sandbox',
            '--disable-gpu',
            '--disable-dev-shm-usage'
        ]

        return "--config -webui.chrome.args='${args.join(' ')}'"
    }

    def args = [
        "--window-size=${env.DISPLAY_WIDTH},${env.DISPLAY_HEIGHT}",
        '--start-maximized'
    ]

    return "--config -webui.chrome.args='${args.join(' ')}'"
}
