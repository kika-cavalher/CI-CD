	@Keyword
	String validateHeaderExists(String filesToValidate, String sheetIndexText, String headerName) {

		StringBuilder errors = new StringBuilder()

		List<File> files = parseFiles(filesToValidate)
		int sheetIndex = parseIntOrZero(sheetIndexText)

		for (File file : files) {

			FileInputStream input = null
			Workbook workbook = null

			try {

				input = new FileInputStream(file)
				workbook = WorkbookFactory.create(input)

				if (workbook.getNumberOfSheets() <= sheetIndex) {

					errors.append("[ERROR] File '")
							.append(file.getName())
							.append("' does not contain sheet index ")
							.append(sheetIndex)
							.append(".\n")
				} else {

					Sheet sheet = workbook.getSheetAt(sheetIndex)
					DataFormatter formatter = new DataFormatter()

					int column = findHeaderColumn(sheet, headerName, formatter)

					if (column < 0) {
						errors.append("[ERROR] File '")
								.append(file.getName())
								.append("' missing header: ")
								.append(headerName)
								.append("\n")
					}
				}
			} catch (Exception e) {

				errors.append("[ERROR] Header exists validation failed for file '")
						.append(file.getName())
						.append("': ")
						.append(e.getClass().getSimpleName())
						.append(" | ")
						.append(e.getMessage())
						.append("\n")
			} finally {

				try {
					if (workbook != null) {
						workbook.close()
					}
				} catch (Exception ignored) {}

				try {
					if (input != null) {
						input.close()
					}
				} catch (Exception ignored) {}
			}
		}

		return errors.toString()
	}

	@Keyword
	String validateNoDiscrepanciesBetweenFiles(
			String filesToValidate,
			String defaultValidationType,
			String sheetIndexText,
			String keyHeadersText,
			String compareHeadersText) {

		String keyHeadersClean = safeText(keyHeadersText)
		String compareHeadersClean = safeText(compareHeadersText)

		if (keyHeadersClean.length() == 0 || compareHeadersClean.length() == 0) {
			return "[SKIPPED] Discrepancy validation was not executed because key headers or compare headers were not configured."
		}

		StringBuilder errors = new StringBuilder()

		List<File> files = parseFiles(filesToValidate)
		int sheetIndex = parseIntOrZero(sheetIndexText)

		if (files.size() < 2) {
			return "[SKIPPED] Discrepancy validation needs at least 2 files."
		}

		List<String> keyHeaders = splitText(keyHeadersText)
		List<String> compareHeaders = splitText(compareHeadersText)

		Map<String, String> expectedValuesByKey = [:]
		Map<String, String> sourceByKey = [:]

		for (File file : files) {

			String validationType = resolveValidationTypeForFile(file, defaultValidationType)

			String fileErrors = collectDiscrepanciesFromFile(
					file,
					validationType,
					sheetIndex,
					keyHeaders,
					compareHeaders,
					expectedValuesByKey,
					sourceByKey
					)

			if (fileErrors.trim().length() > 0) {
				errors.append(fileErrors)
			}
		}

		return errors.toString()
	}

