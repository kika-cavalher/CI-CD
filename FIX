@Keyword
def boolean errorWindow (String name) {
	try {
		String errorTop = new File(RunConfiguration.getProjectDir(), 'Images/Requetes SQL/errorTop.PNG').getAbsolutePath()
		String okBtn = new File(RunConfiguration.getProjectDir(), 'Images/Requetes SQL/okBtn.PNG').getAbsolutePath()

		float old = org.sikuli.basics.Settings.AutoWaitTimeout
		org.sikuli.basics.Settings.AutoWaitTimeout = 0f
		try {
			if(WindowsImageKeywords.findImage(errorTop)){
				WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession()).takeScreenshot(RunConfiguration.getReportFolder()+"\\Evidences\\"+'[ERROR]_' + name + '.PNG')
				Windows.delay(1)
				WindowsImageKeywords.clickImage(okBtn)
				return true
			}
			return false
		} finally {
			org.sikuli.basics.Settings.AutoWaitTimeout = old
		}

	} catch (Exception e) {
		println "No error pop up."
		return false
	}
}
