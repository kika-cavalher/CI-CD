	private void clickImageFirstThenElement(
			String buttonDescription,
			String imageKey,
			String objectKey) {

		long actionStartedAt =
				System.currentTimeMillis()

		logInfo(
				'Searching for ' +
					buttonDescription +
					' button using image.\n' +
					'Image group: ' +
					GENERAL_IMAGE_GROUP + '\n' +
					'Image key: ' +
					imageKey + '\n' +
					'Image timeout: ' +
					IMAGE_BUTTON_TIMEOUT_SECONDS +
					' seconds.'
				)

		boolean imageFound = false

		try {
			imageFound = imageLoader.waitForImage(
					GENERAL_IMAGE_GROUP,
						imageKey,
						IMAGE_BUTTON_TIMEOUT_SECONDS
					)
		} catch (Exception exception) {

			logInfo(
					buttonDescription +
						' image verification returned an exception.\n' +
						'The Windows element fallback will be used.\n' +
						'Message: ' +
						safeExceptionMessage(exception)
					)
		}

		if (imageFound) {

			logInfo(
					buttonDescription +
						' button image found.\n' +
						'Clicking image now.'
					)

			imageLoader.clickImageOrStop(
					GENERAL_IMAGE_GROUP,
						imageKey
					)

			logInfo(
					buttonDescription +
						' button clicked using image.\n' +
						'Elapsed milliseconds: ' +
						elapsedMilliseconds(
						actionStartedAt
						)
					)

			return
		}

		logInfo(
				buttonDescription +
					' button image was not found within ' +
					IMAGE_BUTTON_TIMEOUT_SECONDS +
					' seconds.\n' +
					'Trying Windows element fallback.\n' +
					'Object group: ' +
					EXPORT_OBJECT_GROUP + '\n' +
					'Object key: ' +
					objectKey + '\n' +
					'Element timeout: ' +
					ELEMENT_BUTTON_TIMEOUT_SECONDS +
					' seconds.'
				)

		WindowsTestObject buttonObject =
				getRequiredWindowsObject(
				objectKey
				)

		boolean elementFound = false

		try {
			elementFound =
					Windows.verifyElementPresent(
					buttonObject,
						ELEMENT_BUTTON_TIMEOUT_SECONDS,
						FailureHandling.OPTIONAL
					)
		} catch (Exception exception) {

			imageLoader.takeEvidence(
					buttonDescription +
						'ElementVerificationError.png'
					)

			KeywordUtil.markFailedAndStop(
					buttonDescription +
						' button element verification failed.\n' +
						'Object group: ' +
						EXPORT_OBJECT_GROUP + '\n' +
						'Object key: ' +
						objectKey + '\n' +
						'Configured timeout: ' +
						ELEMENT_BUTTON_TIMEOUT_SECONDS +
						' seconds.\n' +
						'Message: ' +
						safeExceptionMessage(exception)
					)

			return
		}

		if (!elementFound) {

			imageLoader.takeEvidence(
					buttonDescription +
						'ButtonNotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					buttonDescription +
						' button was not found using image or Windows element.\n' +
						'Image key: ' +
						imageKey + '\n' +
						'Object group: ' +
						EXPORT_OBJECT_GROUP + '\n' +
						'Object key: ' +
						objectKey + '\n' +
						'Image timeout: ' +
						IMAGE_BUTTON_TIMEOUT_SECONDS +
						' seconds.\n' +
						'Element timeout: ' +
						ELEMENT_BUTTON_TIMEOUT_SECONDS +
						' seconds.'
					)

			return
		}

		logInfo(
				buttonDescription +
					' Windows element found.\n' +
					'Clicking element now.'
				)

		try {
			Windows.click(
					buttonObject,
						FailureHandling.STOP_ON_FAILURE
					)
		} catch (Exception exception) {

			imageLoader.takeEvidence(
					buttonDescription +
						'ButtonClickError.png'
					)

			KeywordUtil.markFailedAndStop(
					buttonDescription +
						' button was found but could not be clicked.\n' +
						'Object group: ' +
						EXPORT_OBJECT_GROUP + '\n' +
						'Object key: ' +
						objectKey + '\n' +
						'Message: ' +
						safeExceptionMessage(exception)
					)

			return
		}

		logInfo(
				buttonDescription +
					' button clicked using Windows element fallback.\n' +
					'Elapsed milliseconds: ' +
					elapsedMilliseconds(
					actionStartedAt
					)
				)
	}


	// ======================================================
	// SAVE FILE
	// ======================================================

	private File saveToShortExportFolder(
			String exportLabel,
			String targetEnvironment) {

		long saveFlowStartedAt =
				System.currentTimeMillis()

		String environment = resolveEnvironmentName(
				targetEnvironment,
				exportLabel
				)

		String collectionName = shortenFilePart(
				sanitizeFileName(
				resolveCurrentCollectionName()
				),
				MAX_COLLECTION_LENGTH
				)

		String featureName = shortenFilePart(
				sanitizeFileName(
				resolveCurrentFeatureName()
				),
				MAX_FEATURE_LENGTH
				)

		String exportLabelSuffix = shortenFilePart(
				resolveExportLabelSuffixForFileName(
				exportLabel
				),
				MAX_LABEL_LENGTH
				)

		File directory = resolveShortExportDirectory(
				environment,
				collectionName,
				featureName
				)

		if (!directory.exists()) {

			logInfo(
					'Export directory does not exist.\n' +
						'Creating directory: ' +
						directory.getAbsolutePath()
					)

			boolean created =
					directory.mkdirs()

			if (!created &&
					!directory.exists()) {

				KeywordUtil.markFailedAndStop(
						'Could not create short export directory.\n' +
							'Directory: ' +
							directory.getAbsolutePath()
						)

				return null
			}
		}

		String fileName = buildAutomaticExportFileName(
				environment,
				featureName,
				exportLabelSuffix
				)

		File exportedFile = new File(
				directory,
				fileName
				)

		exportedFile = ensurePathIsShortEnough(
				exportedFile,
				environment,
				exportLabelSuffix
				)

		logInfo(
				'Save dialog export configuration prepared.\n' +
					'Environment: ' +
					environment + '\n' +
					'Collection: ' +
					collectionName + '\n' +
					'Feature: ' +
					featureName + '\n' +
					'Export label: ' +
					exportLabelSuffix + '\n' +
					'Directory: ' +
					exportedFile
					.getParentFile()
					.getAbsolutePath() + '\n' +
					'File name: ' +
					exportedFile.getName() + '\n' +
					'Full path length: ' +
					exportedFile
					.getAbsolutePath()
					.length() + '\n' +
					'Save dialog timeout: ' +
					SAVE_DIALOG_TIMEOUT_SECONDS +
					' seconds.'
				)

		clickRequiredWindowsObject(
				'filePath',
				'Save dialog path field',
				SAVE_DIALOG_TIMEOUT_SECONDS
				)

		Windows.delay(SHORT_UI_DELAY_SECONDS)

		clearFocusedField()

		String exportDirectory =
				exportedFile
				.getParentFile()
				.getAbsolutePath()

		logInfo(
				'Entering export directory in Save dialog.\n' +
					'Directory: ' +
					exportDirectory
				)

		pasteAndEnter(
				exportDirectory
				)

		Windows.delay(PANEL_OPEN_DELAY_SECONDS)

		logInfo(
				'Entering export file name.\n' +
					'File name: ' +
					exportedFile.getName()
				)

		setFileName(
				exportedFile.getName()
				)

		clickRequiredWindowsObject(
				'saveButton',
				'Save button',
				SAVE_DIALOG_TIMEOUT_SECONDS
				)

		Windows.delay(SAVE_DIALOG_OPEN_DELAY_SECONDS)

		logInfo(
				'Save button clicked.\n' +
					'Waiting for the exported file to be created.\n' +
					'Expected path: ' +
					exportedFile.getAbsolutePath() + '\n' +
					'Export file timeout: ' +
					EXPORT_FILE_TIMEOUT_SECONDS +
					' seconds.'
				)

		waitForExportedFileOrStop(
				exportedFile,
				EXPORT_FILE_TIMEOUT_SECONDS
				)

		logInfo(
				'Save flow completed.\n' +
					'Elapsed milliseconds: ' +
					elapsedMilliseconds(
					saveFlowStartedAt
					)
				)

		return exportedFile
	}


	private void setFileName(
			String fileName) {

		long focusStartedAt =
				System.currentTimeMillis()

		logInfo(
				'Searching for the file name field.\n' +
					'Candidate timeout: 1 second per object.'
				)

		if (!focusFileNameField()) {

			imageLoader.takeEvidence(
					'FileNameFieldNotFocused.png'
					)

			KeywordUtil.markFailedAndStop(
					'Could not focus the export file name field.\n' +
						'Expected file name: ' +
						fileName + '\n' +
						'Windows object group: ' +
						EXPORT_OBJECT_GROUP
					)

			return
		}

		logInfo(
				'File name field focused successfully.\n' +
					'Elapsed milliseconds: ' +
					elapsedMilliseconds(
					focusStartedAt
					)
				)

		clearFocusedField()

		pasteText(
				fileName
				)

		Windows.delay(SHORT_UI_DELAY_SECONDS)

		logInfo(
				'File name entered successfully.\n' +
					'File name: ' +
					fileName
				)
	}


	private boolean focusFileNameField() {

		List<String> candidateObjectKeys = [
			'fileNameField',
			'fileNameFieldAutomationId',
			'fileNameFieldEnglish',
			'fileNameFieldFrench',
			'fileNameFieldPortuguesePortugal',
			'fileNameFieldPortugueseBrazil'
		]

		for (String objectKey : candidateObjectKeys) {

			logInfo(
					'Checking file name field object.\n' +
						'Object key: ' +
						objectKey + '\n' +
						'Timeout: 1 second.'
					)

			WindowsTestObject candidateObject =
					getOptionalWindowsObject(
					objectKey
					)

			if (candidateObject == null) {

				logInfo(
						'File name field object is not configured.\n' +
							'Object key: ' +
							objectKey
						)

				continue
			}

			try {
				boolean found =
						Windows.verifyElementPresent(
						candidateObject,
							1,
							FailureHandling.OPTIONAL
						)

				if (found) {

					Windows.click(
							candidateObject,
								FailureHandling.STOP_ON_FAILURE
							)

					Windows.delay(
							SHORT_UI_DELAY_SECONDS
							)

					logInfo(
							'File name field focused using Windows object.\n' +
								'Object key: ' +
								objectKey
							)

					return true
				}
			} catch (Exception exception) {

				logInfo(
						'File name field candidate could not be used.\n' +
							'Object key: ' +
							objectKey + '\n' +
							'Message: ' +
							safeExceptionMessage(
							exception
							)
						)
			}
		}

		logInfo(
				'File name field objects were not available.\n' +
					'Trying Windows Alt+N shortcut.'
				)

		try {
			focusFileNameFieldWithShortcut()

			Windows.delay(
					SHORT_UI_DELAY_SECONDS
					)

			logInfo(
					'File name field focused using Alt+N shortcut.'
					)

			return true
		} catch (Exception exception) {

			logInfo(
					'Alt+N shortcut could not focus the file name field.\n' +
						'Message: ' +
						safeExceptionMessage(
						exception
						)
					)
		}

		return false
	}


	private void waitForExportedFileOrStop(
			File exportedFile,
			Integer timeoutSeconds) {

		int safeTimeout =
				timeoutSeconds == null ||
				timeoutSeconds <= 0
				? EXPORT_FILE_TIMEOUT_SECONDS
				: timeoutSeconds

		int elapsedSeconds = 0
		long previousSize = -1
		int stableSizeChecks = 0

		while (elapsedSeconds < safeTimeout) {

			boolean fileExists =
					exportedFile.exists() &&
					exportedFile.isFile()

			long currentSize =
					fileExists
						? exportedFile.length()
						: 0

			if (fileExists &&
					currentSize > 0) {

				if (currentSize == previousSize) {
					stableSizeChecks++
				} else {
					previousSize = currentSize
					stableSizeChecks = 0
				}

				if (stableSizeChecks >=
						REQUIRED_STABLE_SIZE_CHECKS) {

					logInfo(
							'Exported file found and writing completed.\n' +
								'Path: ' +
								exportedFile.getAbsolutePath() + '\n' +
								'Size bytes: ' +
								currentSize + '\n' +
								'Elapsed seconds: ' +
								elapsedSeconds + '\n' +
								'Stable size checks: ' +
								stableSizeChecks
							)

					return
				}
			}

			if (elapsedSeconds == 0 ||
					elapsedSeconds % 10 == 0) {

				logInfo(
						'Export file is still being generated.\n' +
							'Elapsed seconds: ' +
							elapsedSeconds +
							' of ' +
							safeTimeout + '\n' +
							'File exists: ' +
							fileExists + '\n' +
							'Current size bytes: ' +
							currentSize + '\n' +
							'Stable size checks: ' +
							stableSizeChecks +
							' of ' +
							REQUIRED_STABLE_SIZE_CHECKS + '\n' +
							'Expected path: ' +
							exportedFile.getAbsolutePath()
						)
			}

			Windows.delay(
					FILE_POLL_INTERVAL_SECONDS
					)

			elapsedSeconds +=
					FILE_POLL_INTERVAL_SECONDS
		}

		imageLoader.takeEvidence(
				'ExportedFileNotFound.png'
				)

		KeywordUtil.markFailedAndStop(
