/*
 * Responsibility:
 * Helper for Jenkins desktop pipelines:
 * - delete marker files
 * - write run-context.properties safely (no broken cmd escaping)
 * - run scheduled task and wait marker file
 */

def deleteIfExists(String path) {
  bat """@echo off
if exist "${path}" del /f /q "${path}"
exit /b 0
"""
}

def writeRunContextFile(String targetFile, Map ctx) {
  echo "Writing run-context.properties to: ${targetFile}"

  def lines = (ctx ?: [:]).collect { k, v -> "${k}=${v}" }

  // PowerShell-safe quoting for single quotes
  def linesEsc = lines.collect { it.replace("'", "''") }
  def pathEsc  = (targetFile ?: '').replace("'", "''")

  def ps = """
\$ErrorActionPreference = 'Stop'
\$p = '${pathEsc}'
\$dir = Split-Path -Parent \$p
if (!(Test-Path \$dir)) { New-Item -ItemType Directory -Force -Path \$dir | Out-Null }

\$lines = @(
  '${linesEsc.join("'\r\n  '")}'
)

# guarantees CRLF at end
\$content = (\$lines -join "`r`n") + "`r`n"
Set-Content -Path \$p -Value \$content -Encoding ASCII
""".trim()

  // IMPORTANT: run via Jenkins powershell step (avoid cmd quoting problems)
  def rc = powershell(returnStatus: true, script: ps)
  if (rc != 0) {
    error("Failed to write run-context.properties. ExitCode=${rc}")
  }
}

def runScheduledTaskAndWaitMarker(String taskName, String markerPath, int timeoutMinutes) {
  echo "Running Task Scheduler: ${taskName}"

  bat """@echo off
schtasks /run /tn "${taskName}"
if errorlevel 1 exit /b 1
"""

  timeout(time: timeoutMinutes, unit: 'MINUTES') {
    echo "Waiting marker file: ${markerPath}"
    while (true) {
      if (fileExists(markerPath)) break
      sleep time: 3, unit: 'SECONDS'
    }
  }

  def ecText = readFile(markerPath).trim()
  int ec = 1
  try { ec = Integer.parseInt(ecText) } catch (ignored) { ec = 1 }

  echo "Desktop task finished. ExitCode=${ec}"
  return ec
}

