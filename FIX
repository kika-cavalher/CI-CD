    }

    private String statusClass(def status) {
        String value = safeValue(status).toLowerCase()
        if (value == 'pass' || value == 'passed') {
            return 'pass'
        }
        if (value == 'fail' || value == 'failed') {
            return 'fail'
        }
        if (value == 'skip' || value == 'skipped') {
            return 'skip'
        }
        return 'info'
    }

    private String statusLabel(def status) {
        String css = statusClass(status)
        if (css == 'pass') {
            return 'Pass'
        }
        if (css == 'fail') {
            return 'Fail'
        }
        if (css == 'skip') {
            return 'Skip'
        }
        return 'Info'
    }

    private String oneLine(def value, int maxSize) {
        String text = safeValue(value).replaceAll('\\s+', ' ').trim()
        if (text.size() <= maxSize) {
            return text
        }
        return text.substring(0, Math.max(0, maxSize - 1)).trim() + '…'
    }

    private String formatPct(def value) {
        return String.format(Locale.US, '%.2f', toDouble(value))
    }

    private int toInt(def value) {
        try {
            return Integer.parseInt(safeValue(value))
        } catch (Exception ignored) {
            return 0
        }
    }

    private long toLong(def value) {
        try {
            return Long.parseLong(safeValue(value))
        } catch (Exception ignored) {
            return 0L
        }
    }

    private double toDouble(def value) {
        try {
            return Double.parseDouble(safeValue(value))
        } catch (Exception ignored) {
            return 0D
        }
    }

    private String jsEscape(def value) {
        return safeValue(value)
            .replace('\\', '\\\\')
            .replace("'", "\\'")
            .replace('"', '\\"')
            .replace('\\r', '')
            .replace('\\n', '\\n')
    }

    private String htmlEscape(def value) {
        String text = safeValue(value)
        return text
            .replace('&', '&amp;')
            .replace('<', '&lt;')
            .replace('>', '&gt;')
            .replace('"', '&quot;')
            .replace("'", '&#39;')
    }

    private String safeValue(def value) {
        return value == null ? '' : String.valueOf(value).trim()
    }

    private boolean isBlank(def value) {
        return safeValue(value).isEmpty()
    }
