import static com.kms.katalon.core.testcase.TestCaseFactory.findTestCase
import static com.kms.katalon.core.testdata.TestDataFactory.findTestData

import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testdata.TestData
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import internal.GlobalVariable


// ======================================================
// MODULE CONFIG
// ======================================================

String targetEnvironment = 'REC'

String menuName = 'pl comptable'
String menuResultName = 'PL Comptable'
String openedTabName = menuResultName

String exportScenarioName =
	'PNLComptable_ConsultationPNLComptable'

String exportLabel =
	exportScenarioName

String testDataPath =
	'Data Files/PNL Comptable/' +
	'RAPPNL - Consultation PNL Comptable/' +
	'testInput Consultation PNL Comptable'

String loginTestCase =
	'Component/Authentication/Login ' +
	targetEnvironment

String closeApplicationTestCase =
	'Component/Authentication/Close Application'


// ======================================================
// RECHERCHE CONFIG
// ======================================================

Integer tabsToFirstFilter = 2
Integer tabsBetweenFilters = 1


// ======================================================
// TIMEOUT CONFIG
// ======================================================

Integer menuTimeout = 60
Integer openedTabTimeout = 120
Integer filterTimeout = 20
Integer filteredContentDelay = 75


// ======================================================
// RESOLVE FILTER DATA
// ======================================================

TestData testData =
	findTestData(
		testDataPath
	)

String sectionValue =
	testData
		.getValue(
			1,
			1
		)
		.toString()
		.trim()

String transactionCurrencyValue =
	testData
		.getValue(
			2,
			1
		)
		.toString()
		.trim()

String accountingDate =
	GlobalVariable.arreteDate == null
		? ''
		: GlobalVariable.arreteDate
			.toString()
			.trim()

if (accountingDate.isEmpty()) {
	accountingDate =
		CustomKeywords.
		'general.MenuHandling.getArreteDateWithSlash'()

	GlobalVariable.arreteDate =
		accountingDate
}

List<String> accountingDateParts =
	accountingDate
		.split('/') as List<String>

if (accountingDateParts.size() != 3 ||
		accountingDateParts.get(2).trim().isEmpty()) {

	KeywordUtil.markFailedAndStop(
		'Accounting date has an invalid format.\n' +
		'Expected format: dd/MM/yyyy\n' +
		'Actual value: ' +
		accountingDate
	)
}

String accountingYear =
	accountingDateParts
		.get(2)
		.trim()

String minimumAccountingDate =
	'01/01/' +
	accountingYear

String maximumAccountingDate =
	accountingDate

List<String> rechercheValues = [
	sectionValue,
	transactionCurrencyValue,
	minimumAccountingDate,
	maximumAccountingDate
]

if (rechercheValues.any {
		String value ->
			value == null ||
			value.trim().isEmpty()
		}) {

	KeywordUtil.markFailedAndStop(
		'PNL Comptable Recherche data contains an empty value.\n' +
		'Section: ' +
		sectionValue +
		'\nTransaction currency: ' +
		transactionCurrencyValue +
		'\nMinimum accounting date: ' +
		minimumAccountingDate +
		'\nMaximum accounting date: ' +
		maximumAccountingDate
	)
}


// ======================================================
// AUTHENTICATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Authenticate and open application\n' +
	'Environment: ' +
	targetEnvironment
)

WebUI.callTestCase(
	findTestCase(
		loginTestCase
	),
	[:],
	FailureHandling.STOP_ON_FAILURE
)


// ======================================================
// OPEN PNL COMPTABLE
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Open PNL Comptable screen\n' +
	'Search: ' +
	menuName +
	'\nResult: ' +
	menuResultName
)

CustomKeywords.
'component.MenuNavigator.searchAndOpenMenuByText'(
	menuName,
	menuResultName,
	menuTimeout
)


// ======================================================
// VALIDATE OPENED TAB
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Validate PNL Comptable tab\n' +
	'Expected tab: ' +
	openedTabName
)

if (!Windows.waitForElementPresent(
		CustomKeywords.
		'commands.WindowsObjectLoader.getTabByName'(
			openedTabName
		),
		openedTabTimeout,
		FailureHandling.OPTIONAL
		)) {

	CustomKeywords.
	'commands.ImageLoader.takeEvidence'(
