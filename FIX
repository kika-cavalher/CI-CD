pipeline {
    agent {
        node {
            label 'GI5_SWDCFRNXGI55817'
            customWorkspace 'D:\\jenkins\\work\\workspace\\GI5\\eMatch_Regression\\Archive Mode'
        }
    }

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        timeout(time: 4, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '20', daysToKeepStr: '30'))
        skipDefaultCheckout(true)
    }

    environment {
        STARTERS_DIR = 'D:\\Projects\\eMatchStarters'
        CTX_FILE     = 'D:\\Projects\\eMatchStarters\\run-context.properties'
        TASK_NAME    = '\\eMatch Automation\\RunEMatchDesktop'

        KATALON_EXE  = 'C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0\\katalonc.exe'
        PROJECT_FILE = 'eMatch POC.prj'
        COLLECTION   = 'Test Suites\\Archive Mode\\Archive Mode Collection'
        BROWSER_TYPE = 'Windows'
        RETRY        = '0'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo "Workspace: ${pwd()}"
            }
        }

        stage('Prepare Context + Reports') {
            steps {
                script {
                    def ws = pwd()
                    def projectPath = "${ws}\\${env.PROJECT_FILE}"
                    def reportsDir = "${ws}\\Reports"
                    def desktopLogsDir = "${reportsDir}\\_desktop_logs"
                    def startersLogsDir = "${env.STARTERS_DIR}\\logs"
                    def markerFile = "${startersLogsDir}\\__jenkins_task_exitcode.txt"
                    def currentLogFile = "${desktopLogsDir}\\katalon_current.log"
                    def runLabel = "Archive Mode Build ${env.BUILD_NUMBER}"

                    bat """
@echo off
setlocal

if not exist "${reportsDir}" mkdir "${reportsDir}"
if not exist "${desktopLogsDir}" mkdir "${desktopLogsDir}"
if not exist "${env.STARTERS_DIR}" mkdir "${env.STARTERS_DIR}"
if not exist "${startersLogsDir}" mkdir "${startersLogsDir}"

del /f /q "${markerFile}" 2>nul
del /f /q "${markerFile}.tmp" 2>nul
del /f /q "${currentLogFile}" 2>nul

(
  echo WORKSPACE=${ws}
  echo PROJECT_PATH=${projectPath}
  echo KATALON_EXE=${env.KATALON_EXE}
  echo ASSET_TYPE=COLLECTION
  echo ASSET_PATH=${env.COLLECTION}
  echo BROWSER_TYPE=${env.BROWSER_TYPE}
  echo RETRY=${env.RETRY}
  echo REPORTS_DIR=${reportsDir}
  echo LOG_DIR=${desktopLogsDir}
  echo CURRENT_LOG_FILE=${currentLogFile}
  echo MARKER_FILE=${markerFile}
  echo RUN_LABEL=${runLabel}
) > "${env.CTX_FILE}"

echo -------------------- run-context.properties --------------------
type "${env.CTX_FILE}"
echo ----------------------------------------------------------------

endlocal
"""
                }
            }
        }

        stage('Run Desktop (Task Scheduler)') {
            steps {
                script {
                    def markerFile = "${env.STARTERS_DIR}\\logs\\__jenkins_task_exitcode.txt"
                    def currentLogFile = "${pwd()}\\Reports\\_desktop_logs\\katalon_current.log"

                    bat """
@echo off
echo ------------------------------------------------------------
echo START ASSET: Archive Mode Collection
echo TASK: ${env.TASK_NAME}
echo ------------------------------------------------------------
schtasks /run /tn "${env.TASK_NAME}"
exit /b %ERRORLEVEL%
"""

                    withEnv([
                        "MARKER_FILE=${markerFile}",
                        "CURRENT_LOG_FILE=${currentLogFile}",
                        "RUN_TIMEOUT_MINUTES=180"
                    ]) {
                        timeout(time: 180, unit: 'MINUTES') {
                            powershell(
                                script: '''
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

function Clean-Text {
    param([string]$Value)

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return ''
    }

    return (($Value -replace '[\\r\\n]+', ' ') -replace '\\s+', ' ').Trim()
}

function Read-NewContent {
    param(
        [string]$Path,
        [ref]$Offset
    )

    if (-not (Test-Path -LiteralPath $Path)) {
        return @()
    }

    $fs = $null
    $sr = $null

    try {
        $fs = [System.IO.File]::Open($Path, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, [System.IO.FileShare]::ReadWrite)
        [void]$fs.Seek($Offset.Value, [System.IO.SeekOrigin]::Begin)
        $sr = New-Object System.IO.StreamReader($fs)
        $content = $sr.ReadToEnd()
        $Offset.Value = $fs.Position

        if ([string]::IsNullOrWhiteSpace($content)) {
            return @()
        }

        return @($content -split "`r?`n")
    }
    catch {
        return @()
    }
    finally {
        if ($sr) { $sr.Close() }
        if ($fs) { $fs.Close() }
    }
}

$logPath = $env:CURRENT_LOG_FILE
$markerPath = $env:MARKER_FILE
$timeoutMinutes = [int]$env:RUN_TIMEOUT_MINUTES

$offset = 0L
$deadline = (Get-Date).AddMinutes($timeoutMinutes)
$lastHeartbeat = Get-Date

Write-Host "[INFO] Waiting for desktop execution..."
Write-Host "[INFO] Live log file : $logPath"
Write-Host "[INFO] Marker file   : $markerPath"

while ((Get-Date) -lt $deadline) {
    $newLines = Read-NewContent -Path $logPath -Offset ([ref]$offset)

    if ($newLines.Count -gt 0) {
        foreach ($line in $newLines) {
            $text = Clean-Text $line
            if (-not [string]::IsNullOrWhiteSpace($text)) {
                Write-Host ("[KATALON] " + $text)
            }
        }

        $lastHeartbeat = Get-Date
    }
    else {
        if ((New-TimeSpan -Start $lastHeartbeat -End (Get-Date)).TotalSeconds -ge 15) {
            Write-Host "[WAIT] Desktop run is still active. Waiting for new log lines..."
            $lastHeartbeat = Get-Date
        }
    }

    if (Test-Path -LiteralPath $markerPath) {
        break
    }

    Start-Sleep -Seconds 2
}

$newLines = Read-NewContent -Path $logPath -Offset ([ref]$offset)
if ($newLines.Count -gt 0) {
    foreach ($line in $newLines) {
        $text = Clean-Text $line
        if (-not [string]::IsNullOrWhiteSpace($text)) {
            Write-Host ("[KATALON] " + $text)
        }
    }
}

if (-not (Test-Path -LiteralPath $markerPath)) {
    throw "Marker file was not created within timeout: $markerPath"
}
'''
                            )
                        }

                        def markerText = powershell(
                            returnStdout: true,
                            script: '''
$path = $env:MARKER_FILE
$maxAttempts = 15

for ($i = 1; $i -le $maxAttempts; $i++) {
    try {
        if (Test-Path -LiteralPath $path) {
            $content = Get-Content -LiteralPath $path -ErrorAction Stop | Select-Object -First 1
            if ($null -ne $content -and $content.ToString().Trim() -ne '') {
                Write-Output $content.ToString().Trim()
                exit 0
            }
        }
    }
    catch {
    }

    Start-Sleep -Seconds 2
}

throw "Unable to read marker file: $path"
'''
                        ).trim()

                        echo "Marker content: '${markerText}'"

                        int exitCode = 999
                        try {
                            exitCode = Integer.parseInt(markerText)
                        }
                        catch (ignored) {
                            exitCode = 999
                        }

                        currentBuild.description = "Archive | Exit=${exitCode}"

                        if (exitCode != 0) {
                            error("Desktop execution failed. Check Reports\\_desktop_logs\\katalon_current.log")
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    archiveArtifacts artifacts: 'Reports/**', allowEmptyArchive: true
                }

                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    junit allowEmptyResults: true, testResults: 'Reports/**/JUnit_Report.xml,Reports/**/JUnit*.xml,Reports/**/junit*.xml'
                }
            }
        }
    }
}






