	private void clearAllFilterValues(
			String imageGroup,
			String objectGroup,
			String selectAllCheckedImageKey,
			String selectAllObjectKey,
			Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds)
		Integer imageTimeout = Math.min(timeout, 10)

		Boolean allCurrentlyChecked = false

		try {
			allCurrentlyChecked =
					imageLoader.waitForImage(
					imageGroup,
					selectAllCheckedImageKey,
					imageTimeout
					)
		} catch (Throwable ignored) {
			allCurrentlyChecked = false
		}

		if (allCurrentlyChecked) {
			WindowsImageKeywords.clickImage(
					image(
					imageGroup,
					selectAllCheckedImageKey
					)
					)

			Windows.delay(POLLING_DELAY_SECONDS)

			KeywordUtil.logInfo(
					'[IMAGE] All filter values deselected.'
					)

			return
		}

		WindowsTestObject selectAllObject =
				object(
				objectGroup,
				selectAllObjectKey
				)

		if (!Windows.waitForElementPresent(
				selectAllObject,
				timeout,
				FailureHandling.OPTIONAL
				)) {
			KeywordUtil.markFailedAndStop(
					'Select all filter option was not found.\n' +
					'Image group: ' + imageGroup + '\n' +
					'Image key: ' + selectAllCheckedImageKey + '\n' +
					'Object group: ' + objectGroup + '\n' +
					'Object key: ' + selectAllObjectKey
					)

			return
		}

		// Current state is partial or unchecked.
		// First click selects all.
		Windows.click(
				selectAllObject,
				FailureHandling.STOP_ON_FAILURE
				)

		Windows.delay(POLLING_DELAY_SECONDS)

		// Second click deselects all.
		Windows.click(
				selectAllObject,
				FailureHandling.STOP_ON_FAILURE
				)

		Windows.delay(POLLING_DELAY_SECONDS)

		KeywordUtil.logInfo(
				'[OBJECT] All filter values deselected.'
				)
	}


	private void clickFilterButtonInsideSameHeader(
			String objectGroup,
			String headerObjectKey,
			Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds)

		WindowsTestObject headerObject =
				object(
				objectGroup,
				headerObjectKey
				)

		if (!Windows.waitForElementPresent(
				headerObject,
				timeout,
				FailureHandling.OPTIONAL
				)) {
			KeywordUtil.markFailedAndStop(
					'Hovered header was not found for the filter click.\n' +
					'Object group: ' + objectGroup + '\n' +
					'Object key: ' + headerObjectKey
					)

			return
		}

		List<RemoteWebElement> headerElements =
				Windows.findElements(
				headerObject
				)

		if (headerElements == null ||
				headerElements.isEmpty()) {

			KeywordUtil.markFailedAndStop(
					'Hovered header coordinates could not be resolved.\n' +
					'Object group: ' + objectGroup + '\n' +
					'Object key: ' + headerObjectKey
					)

			return
		}

		String boundingRectangle =
				safeText(
				headerElements
				.get(0)
				.getAttribute(
				'BoundingRectangle'
				)
				)

		Map<String, Integer> coordinates =
				parseBoundingRectangle(
				boundingRectangle
				)

		if (coordinates.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Hovered header BoundingRectangle could not be parsed.\n' +
					'Object group: ' + objectGroup + '\n' +
					'Object key: ' + headerObjectKey + '\n' +
					'BoundingRectangle: ' + boundingRectangle
					)

			return
		}

		Integer clickX =
				coordinates.right - 8

		Integer clickY =
				coordinates.top +
				(
				coordinates.bottom -
				coordinates.top
				).intdiv(2)

		Robot robot = new Robot()

		// This move stays inside the same header that already has hover.
		robot.mouseMove(
				clickX,
				clickY
				)

		Thread.sleep(250L)

		robot.mousePress(
				InputEvent.BUTTON1_DOWN_MASK
				)

		robot.mouseRelease(
				InputEvent.BUTTON1_DOWN_MASK
				)

		Windows.delay(POLLING_DELAY_SECONDS)

		KeywordUtil.logInfo(
				'[COORDINATE] Filter button clicked inside the same header: ' +
				headerObjectKey
				)
	}

	private void clickResultCheckboxSquareImageFirst(
			String imageGroup,
			String objectGroup,
			String imageKey,
			String objectKey,
			String description,
			Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds)
		Integer imageTimeout = Math.min(timeout, 10)

		Boolean resultImageFound = false

		try {
			resultImageFound =
					imageLoader.waitForImage(
					imageGroup,
					imageKey,
					imageTimeout
					)
		} catch (Throwable ignored) {
			resultImageFound = false
		}

		WindowsTestObject checkboxObject =
				object(
				objectGroup,
				objectKey
				)

		if (Windows.waitForElementPresent(
				checkboxObject,
				timeout,
				FailureHandling.OPTIONAL
				)) {
			List<RemoteWebElement> checkboxElements =
					Windows.findElements(
					checkboxObject
					)

			if (checkboxElements != null &&
					!checkboxElements.isEmpty()) {

				String boundingRectangle =
						safeText(
						checkboxElements
						.get(0)
						.getAttribute(
						'BoundingRectangle'
						)
						)

				Map<String, Integer> coordinates =
						parseBoundingRectangle(
						boundingRectangle
						)

				if (!coordinates.isEmpty()) {
					Integer checkboxX =
							coordinates.left + 8

					Integer checkboxY =
							coordinates.top +
							(
							coordinates.bottom -
							coordinates.top
							).intdiv(2)

					Robot robot = new Robot()

					robot.mouseMove(
							checkboxX,
							checkboxY
							)

					Thread.sleep(250L)

					robot.mousePress(
							InputEvent.BUTTON1_DOWN_MASK
							)

					robot.mouseRelease(
							InputEvent.BUTTON1_DOWN_MASK
							)

					KeywordUtil.logInfo(
							resultImageFound
							? '[IMAGE + OBJECT COORDINATE] ' +
							description +
							' clicked on the checkbox square.'
							: '[OBJECT COORDINATE] ' +
							description +
							' clicked on the checkbox square.'
							)

					return
				}
			}
		}

		if (resultImageFound) {
			WindowsImageKeywords.clickImage(
					image(
					imageGroup,
					imageKey
					)
					)

			KeywordUtil.logInfo(
					'[IMAGE] ' +
					description +
					' clicked.'
					)

			return
		}

		KeywordUtil.markFailedAndStop(
				description +
				' was not found.\n' +
				'Image group: ' + imageGroup + '\n' +
				'Image key: ' + imageKey + '\n' +
				'Object group: ' + objectGroup + '\n' +
				'Object key: ' + objectKey
				)
	}

	private void clickFirstAvailableImageThenObject(
			String imageGroup,
			String objectGroup,
			List<String> imageKeys,
			String objectKey,
			String description,
			Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds)
		Integer imageTimeout = Math.min(timeout, 10)

		List<String> safeImageKeys =
				imageKeys == null
				? []
				: imageKeys.findAll { String key ->
					!safeText(key).isEmpty()
				}

		for (String imageKey : safeImageKeys) {
			try {
				if (imageLoader.waitForImage(
						imageGroup,
						imageKey,
						imageTimeout
						)) {
					WindowsImageKeywords.clickImage(
							image(
							imageGroup,
							imageKey
							)
							)

					KeywordUtil.logInfo(
							'[IMAGE] ' +
							description +
							' clicked using key: ' +
							imageKey
							)

					return
				}
			} catch (Throwable imageError) {
				KeywordUtil.logInfo(
						'[IMAGE] Could not click ' +
						description +
						' using key ' +
						imageKey +
						'.\nReason: ' +
						safeText(imageError.message)
						)
			}
		}

		WindowsTestObject targetObject =
				object(
				objectGroup,
				objectKey
				)

		if (!Windows.waitForElementPresent(
				targetObject,
				timeout,
				FailureHandling.OPTIONAL
				)) {
			KeywordUtil.markFailedAndStop(
					description +
					' was not found by any image or Windows object.\n' +
					'Image group: ' + imageGroup + '\n' +
					'Image keys: ' + safeImageKeys + '\n' +
					'Object group: ' + objectGroup + '\n' +
					'Object key: ' + objectKey
					)

			return
		}

		Windows.click(
				targetObject,
				FailureHandling.STOP_ON_FAILURE
				)

		KeywordUtil.logInfo(
				'[OBJECT] ' +
				description +
				' clicked.'
				)
	}

	private void replaceTextImageFirstThenObject(
			String imageGroup,
			String objectGroup,
			String imageKey,
			String objectKey,
			String value,
			Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds)
		Integer imageTimeout = Math.min(timeout, 10)

		try {
			if (imageLoader.waitForImage(
					imageGroup,
					imageKey,
					imageTimeout
					)) {
				replaceTextOnImage(
						image(imageGroup, imageKey),
						value
						)

				KeywordUtil.logInfo(
						'[IMAGE] Filter text entered successfully.'
						)

				return
			}
		} catch (Throwable imageError) {
			KeywordUtil.logInfo(
					'[IMAGE] Could not use the filter text input. Trying Windows object.\n' +
					'Reason: ' +
					safeText(imageError.message)
					)
		}

		WindowsTestObject inputObject =
				object(objectGroup, objectKey)

		if (!Windows.waitForElementPresent(
				inputObject,
				timeout,
				FailureHandling.OPTIONAL
				)) {
			KeywordUtil.markFailedAndStop(
					'Filter text input was not found by image or Windows object.\n' +
					'Image group: ' + imageGroup + '\n' +
					'Image key: ' + imageKey + '\n' +
					'Object group: ' + objectGroup + '\n' +
					'Object key: ' + objectKey
					)

			return
		}

		Windows.click(
				inputObject,
				FailureHandling.STOP_ON_FAILURE
				)

		Robot robot = new Robot()

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_CONTROL)

		robot.keyPress(KeyEvent.VK_BACK_SPACE)
		robot.keyRelease(KeyEvent.VK_BACK_SPACE)

		Windows.setText(
				inputObject,
				value
				)

		KeywordUtil.logInfo(
				'[OBJECT] Filter text entered successfully.'
				)
	}

	private void replaceTextOnImage(
			String imagePath,
			String value
	) {

		WindowsImageKeywords.clickImage(imagePath)

		Robot robot = new Robot()

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_CONTROL)

		robot.keyPress(KeyEvent.VK_BACK_SPACE)
		robot.keyRelease(KeyEvent.VK_BACK_SPACE)

		WindowsImageKeywords.typeOnImage(
				imagePath,
				value
				)
	}

	private Boolean waitForImage(
			String imageGroup,
			String imageKey,
			Integer timeoutSeconds
	) {

		return imageLoader.waitForImage(
				imageGroup,
				imageKey,
				timeoutSeconds
				)
	}

	private void waitForImagePresent(
			String imageGroup,
			String imageKey,
			Integer timeoutSeconds,
			String failureMessage
	) {

		if (!waitForImage(
				imageGroup,
				imageKey,
				timeoutSeconds
				)) {
			KeywordUtil.markFailedAndStop(
					failureMessage + '\n' +
					'Image group: ' + imageGroup + '\n' +
					'Image key: ' + imageKey
					)
		}
	}

	private String image(
			String imageGroup,
			String imageKey
	) {

		return imageLoader.getImage(
				imageGroup,
				imageKey
				)
	}

	private Integer safeTimeout(Integer timeoutSeconds) {
		return timeoutSeconds != null &&
				timeoutSeconds > 0
				? timeoutSeconds
				: DEFAULT_TIMEOUT
	}

	private String safeText(Object value) {
		return value == null
				? ''
				: value.toString().trim()
	}
}


































