=========================================
Open Module des Responsabilite
=========================================

import com.kms.katalon.core.util.KeywordUtil

String menuName = CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.getMenuName'()

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
    'Open and validate target menu\n' +
    'Menu: ' + menuName
)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.openMenu'(60)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.validateOpenedMenu'(60)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.takeEvidence'(
    'OpenModuleDesResponsabilite.png'
)

KeywordUtil.markPassed(
    'Menu opened successfully: ' + menuName
)


=========================================
Validate List Dimensions
=========================================

import com.kms.katalon.core.util.KeywordUtil

String dimensionsImageGroup = CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.getDimensionsImageGroup'()

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
    'Validate dimensions tree structure\n' +
    'Image group: ' + dimensionsImageGroup
)

KeywordUtil.logInfo(
    'Current dimensions image group: ' + dimensionsImageGroup
)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.validateDimensionsImagesExist'(
    dimensionsImageGroup
)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.validateMeasuresOpen'(
    dimensionsImageGroup,
    15
)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.clickFirstDimension'(
    dimensionsImageGroup
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
    'Expand dimensions tree and validate bottom reference images'
)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.openDimensionsUntilProvic'(
    dimensionsImageGroup,
    65
)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.validateProvicOpen'(
    dimensionsImageGroup,
    15
)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.validateLastDimension'(
    dimensionsImageGroup,
    15
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
    'Scroll dimensions tree to top and validate initial reference image'
)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.scrollDimensionsToTop'(
    dimensionsImageGroup,
    100
)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.validateFirstPageReference'(
    dimensionsImageGroup,
    15
)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.takeEvidence'(
    'ValidateListDimensions.png'
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
    'Prepare expanded table for export'
)

CustomKeywords.'pageObject.ModuleDesResponsabiliteKeywords.prepareExpandedTableForExport'(
    dimensionsImageGroup
)


=========================================
Export Current Table By Outils
=========================================

String targetEnvironment = binding.hasVariable('targetEnvironment') ? targetEnvironment : ''
String exportScenarioName = binding.hasVariable('exportScenarioName') ? exportScenarioName : 'ModuleDesResponsabilite_Export'

String exportLabel = targetEnvironment != ''
    ? targetEnvironment + '_' + exportScenarioName
    : exportScenarioName

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
    'Export current table using Outils\n' +
    'Environment: ' + targetEnvironment + '\n' +
    'Export file: ' + exportLabel
)

CustomKeywords.'commands.ExportFile.exportFromOutilsToNo'(
    exportLabel
)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
    exportLabel + '.png'
)


