String buildFailureCard(Map item) {
	StringBuilder card = new StringBuilder()

	card.append('<div class="case-block failed">')
	card.append('<div class="case-title">')
	card.append(safeHtml((item.className ?: '') + '/' + (item.testName ?: '')))
	card.append('</div>')

	card.append('<div class="case-line">')
	card.append('<span class="icon">❗</span> Mandatory failure')
	card.append('</div>')

	if (!isBlank(item.failureMessage as String)) {
		card.append('<div class="case-line error-message">')
		card.append(safeHtml(item.failureMessage as String))
		card.append('</div>')
	}

	card.append('<div class="case-line duration">')
	card.append('Duration: ')
	card.append(safeHtml(formatDurationSeconds(item.timeSeconds as BigDecimal)))
	card.append('</div>')

	card.append('<details class="details-block">')
	card.append('<summary>See full error log</summary>')
	card.append('<pre>')
	card.append(safeHtml(item.stackTrace as String))
	card.append('</pre>')
	card.append('</details>')

	if (!isBlank(item.imageData as String)) {
		card.append('<div class="image-wrap">')
		card.append('<img src="')
		card.append(item.imageData as String)
		card.append('" alt="Failure evidence" class="failure-image"/>')
		card.append('</div>')
	}

	card.append('</div>')

	return card.toString()
}

String buildPassedCard(Map item) {
	StringBuilder card = new StringBuilder()

	card.append('<div class="case-block passed">')
