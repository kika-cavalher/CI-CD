@Keyword
int resolveEnvironmentLegacyIndex(String env) {
	String value = safe(env).toUpperCase()

	switch (value) {
		case 'PROD':
			return 1
		case 'PREX':
		case 'PREPO':
			return 2
		case 'REC2':
			return 3
		case 'REC':
			return 4
		case 'DEV2':
			return 5
		case 'DEV':
			return 6
		default:
			return 4
	}
}

@Keyword
String resolveEnvironmentDisplayValue(String env) {
	String value = safe(env).toUpperCase()

	switch (value) {
		case 'PROD':
			return 'Production (PROD)'
		case 'PREX':
		case 'PREPO':
			return 'Bench (PREX)'
		case 'REC2':
			return 'Qualification (REC2)'
		case 'REC':
			return 'Recette (REC)'
		case 'DEV2':
			return 'Simulation (DEV2)'
		case 'DEV':
			return 'Developpement (DEV)'
		default:
			return 'Recette (REC)'
	}
}

@Keyword
void selectEnvironment(String env) {
	String displayValue = resolveEnvironmentDisplayValue(env)
	int legacyIndex = resolveEnvironmentLegacyIndex(env)

	KeywordUtil.logInfo("Selecting environment ${displayValue}")

	openEnvironmentDropdown()

	WindowsTestObject item = envListItemObj(displayValue)

	if (waitPresent(item, 5)) {
		Windows.click(item)
		sleepMs(1500)
		return
	}

	KeywordUtil.logInfo("Direct click on environment item failed. Using simple keyboard fallback.")

	Robot r = robot()
	r.keyPress(KeyEvent.VK_HOME)
	r.keyRelease(KeyEvent.VK_HOME)
	sleepMs(300)

	for (int i = 0; i < legacyIndex; i++) {
		r.keyPress(KeyEvent.VK_DOWN)
		r.keyRelease(KeyEvent.VK_DOWN)
		sleepMs(250)
	}

	r.keyPress(KeyEvent.VK_ENTER)
	r.keyRelease(KeyEvent.VK_ENTER)
	sleepMs(1500)
}

