	def getReportPath() {
		FileInputStream fis = new FileInputStream(RunConfiguration.projectDir + '\\LastRun.xlsx')
		XSSFWorkbook wb = new XSSFWorkbook(fis)
		XSSFSheet sheet = wb.getSheetAt(0)
		XSSFRow row = sheet.getRow(0)
		String result = row.getCell(0).stringCellValue
		wb.close()
		fis.close()
		return result
	}

	def getTimestamp() {
		return new SimpleDateFormat("yyyy-MM-dd HH.mm.ss").format(new Date())
	}

	def getCurrentSuiteName() {
		String reportPath = getReportPath()

		if (reportPath == null || reportPath.trim().isEmpty()) {
			KeywordUtil.markWarning("Report path is empty. Using fallback suite name.")
			return 'UnknownTestSuite'
		}

		File currentReportFolder = new File(reportPath)

		if (!currentReportFolder.exists()) {
			KeywordUtil.markWarning("Report folder does not exist: ${reportPath}")
			return 'UnknownTestSuite'
		}

		File suiteFolder = currentReportFolder.getParentFile()

		if (suiteFolder == null || suiteFolder.getName() == null || suiteFolder.getName().trim().isEmpty()) {
			KeywordUtil.markWarning("Could not detect suite folder from report path.")
			return 'UnknownTestSuite'
		}

		String suiteName = suiteFolder.getName().trim()

		KeywordUtil.logInfo("Detected report path: ${reportPath}")
		KeywordUtil.logInfo("Detected suite folder: ${suiteFolder.absolutePath}")
		KeywordUtil.logInfo("Current Test Suite name detected: ${suiteName}")

		return suiteName
	}

	def getSanitizedSuiteName() {
		return getCurrentSuiteName().replaceAll('[\\\\/:*?"<>|]', '_')
	}

	def getSummaryName() {
		return getCurrentSuiteName() + ' ' + getTimestamp()
	}

	def getTestPlanName() {
		return getCurrentSuiteName() + TEST_PLAN_SUFFIX
	}

	def getAutoDescription() {
		String configuredDescription = getDescription()

		if (configuredDescription == null || configuredDescription.trim().isEmpty()) {
			return getCurrentSuiteName()
		}

		return configuredDescription
	}

	def getSuiteTestPlanFilePath() {
		File folder = new File(TEST_PLAN_KEYS_FOLDER)

		if (!folder.exists()) {
			folder.mkdirs()
		}

		return folder.absolutePath + '\\' + getSanitizedSuiteName() + '.txt'
	}

	def getSavedTestPlanKey() {
		File file = new File(getSuiteTestPlanFilePath())

		if (!file.exists()) {
			return ''
		}

		String key = file.text?.trim()

		if (key == null || key.isEmpty()) {
			return ''
		}

		KeywordUtil.logInfo("Saved Test Plan key found for suite '${getCurrentSuiteName()}': ${key}")
		return key
	}

	def saveTestPlanKey(String testPlanKey) {
		if (testPlanKey == null || testPlanKey.trim().isEmpty()) {
			return
		}

		File file = new File(getSuiteTestPlanFilePath())
		file.write(testPlanKey.trim(), 'UTF-8')

		KeywordUtil.logInfo("Saved Test Plan key '${testPlanKey}' for suite '${getCurrentSuiteName()}'.")
	}

	@Keyword
	def resetTestPlanKey() {
		File file = new File(getSuiteTestPlanFilePath())

		if (!file.exists()) {
			KeywordUtil.logInfo("No saved Test Plan key file found for this suite.")
			return
		}

		file.write('', 'UTF-8')
		KeywordUtil.logInfo("Saved Test Plan key cleared for suite '${getCurrentSuiteName()}'.")
	}

