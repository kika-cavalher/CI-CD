
import java.net.URL

import org.openqa.selenium.remote.DesiredCapabilities

import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.driver.DriverFactory
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import io.appium.java_client.windows.WindowsDriver



@Keyword
void attachToLoginWindow(String targetWindowTitle) {
    String expectedTitle = normalizeTitle(safe(detectedWindowTitle) ? detectedWindowTitle : targetWindowTitle)

    KeywordUtil.logInfo("Attaching to login window. Expected title ${expectedTitle}")

    ensureWinAppDriverRunning()

    Map<String, String> found = waitForWindow(expectedTitle, 30)
    if (!safe(found.title)) {
        KeywordUtil.markFailedAndStop("Could not find eMatch window with title ${expectedTitle}")
    }

    detectedWindowTitle = normalizeTitle(found.title)
    KeywordUtil.logInfo("Detected main window title ${detectedWindowTitle}")

    String handleDec = safe(found.handle) ? safe(found.handle) : findWindowHandleByTitle(detectedWindowTitle)
    if (!safe(handleDec)) {
        KeywordUtil.markFailedAndStop("Could not resolve native window handle for title ${detectedWindowTitle}")
    }

    KeywordUtil.logInfo("Detected main window handle ${handleDec}")

    WindowsDriver driver = attachExistingWindowByHandle(handleDec)
    sleepMs(2000)

    if (Windows.waitForElementPresent(loginDialogObj(), 10)) {
        KeywordUtil.logInfo("Login dialog attached successfully by native handle")
        return
    }

    if (Windows.waitForElementPresent(envComboObj(), 10)) {
        KeywordUtil.logInfo("Environment combo attached successfully by native handle")
        return
    }

    KeywordUtil.markFailedAndStop(
        "Could not attach to login window ${detectedWindowTitle} after native handle attach"
    )
}

private WindowsDriver attachExistingWindowByHandle(String handleDec) {
    long handleLong = Long.parseLong(handleDec.trim())
    String handleHex = "0x" + Long.toHexString(handleLong).toUpperCase()

    URL serverUrl = new URL(getWinAppDriverUrl())

    DesiredCapabilities caps = new DesiredCapabilities()
    caps.setCapability("platformName", "Windows")
    caps.setCapability("deviceName", "WindowsPC")
    caps.setCapability("appTopLevelWindow", handleHex)
    caps.setCapability("ms:waitForAppLaunch", "60")

    KeywordUtil.logInfo("Attaching by native handle ${handleHex} using ${serverUrl}")

    WindowsDriver driver = new WindowsDriver(serverUrl, caps)
    registerWindowsDriver(driver)
    return driver
}

private void registerWindowsDriver(WindowsDriver driver) {
    try {
        Class factoryClass = Class.forName("com.kms.katalon.core.windows.driver.WindowsDriverFactory")
        def method = factoryClass.getMethod("changeDriver", driver.getClass())
        method.invoke(null, driver)
        KeywordUtil.logInfo("Windows driver registered through WindowsDriverFactory.changeDriver")
        return
    } catch (Throwable ignored) {
    }

    DriverFactory.changeWebDriver(driver)
    KeywordUtil.logInfo("Windows driver registered through DriverFactory.changeWebDriver")
}

private String findWindowHandleByTitle(String exactTitle) {
    String escapedTitle = exactTitle.replace("'", "''")

    String script = """
\$p = Get-Process |
    Where-Object { \$_.MainWindowTitle -eq '${escapedTitle}' } |
    Select-Object -First 1

if (\$p -and \$p.MainWindowHandle) {
    Write-Output \$p.MainWindowHandle
}
"""

    String output = runPowerShell(script).trim()
    return safe(output)
}

private String runPowerShell(String script) {
    Process process = new ProcessBuilder(
        "powershell.exe",
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-Command", script
    )
    .redirectErrorStream(true)
    .start()

    String output = process.inputStream.getText("UTF-8")
    process.waitFor()
    return output ?: ""
}
