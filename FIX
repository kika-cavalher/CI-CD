package pageObject

import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import java.io.File

import org.openqa.selenium.Keys

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.testobject.WindowsTestObject.LocatorStrategy
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import general.WinRetry
import internal.GlobalVariable as GlobalVariable

class authentication {

	private static final String EMATCH_LNK_PATH = 'D:\\RunAseMatchReq\\eMatch.lnk'
	private static final String EMATCH_APPLICATION_PATH = '\\\\cib.net\\shareparis\\Soft\\ematch\\IHM\\Livraisons\\REC\\IXIS.Ematch.IHM.application'
	private static final String WINAPPDRIVER_EXE = 'C:\\Program Files (x86)\\Windows Application Driver\\WinAppDriver.exe'
	private static final String RESOLUTION_SCRIPT_PATH = 'D:\\setResolution.ps1'

	private static final int WINDOW_ATTACH_TIMEOUT_SEC = 60
	private static final int WINDOW_ATTACH_RETRY_SEC = 2
	private static final int AFTER_ENV_DROPDOWN_DELAY_SEC = 20
	private static final int AFTER_ENV_SELECTION_DELAY_SEC = 7
	private static final int MAIN_SCREEN_TIMEOUT_SEC = 60
	private static final int AFTER_MAIN_SCREEN_DELAY_SEC = 10
	private static final int AFTER_HOME_CLICK_DELAY_SEC = 5

	@Keyword
	def loginToEmatch() {
		String currentUser = System.getProperty('user.name') ?: ''
		String targetWindowTitle = resolveWindowTitle()

		CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Verify set Username and version')
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Runtime user.name: ${currentUser}")
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'("GlobalVariable.username: ${GlobalVariable.username}")
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'("GlobalVariable.version: ${GlobalVariable.version}")
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'("GlobalVariable.versionProd: ${GlobalVariable.versionProd}")
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'("GlobalVariable.env: ${GlobalVariable.env}")
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'("EMATCH_LNK_PATH: ${EMATCH_LNK_PATH}")
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'("EMATCH_APPLICATION_PATH: ${EMATCH_APPLICATION_PATH}")
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Resolved target window title: ${targetWindowTitle}")

		startApplicationFlow(currentUser, targetWindowTitle)
		attachToLoginWindow(targetWindowTitle)
		openEnvironmentDropdown()
		selectEnvironment()
		clickConnectIfPresent()
		waitForMainScreen()
		activateHomeTab()

		CustomKeywords.'jiraIntegration.JiraReportSteps.note'('eMatch startup flow completed successfully')
	}

	private String resolveWindowTitle() {
		String version = GlobalVariable.version?.toString()?.trim()
		String versionProd = GlobalVariable.versionProd?.toString()?.trim()

		if (version) {
			return version
		}

		if (versionProd) {
			return versionProd
		}

		KeywordUtil.markFailedAndStop("GlobalVariable.version and GlobalVariable.versionProd are both empty.")
		return ''
	}

	private void startApplicationFlow(String currentUser, String targetWindowTitle) {
		try {
			if (currentUser == GlobalVariable.username) {
				CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Windows user matches GlobalVariable.username. Starting with shortcut flow.")

				runResolutionScriptIfAvailable()

				CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Starting eMatch using shortcut: ${EMATCH_LNK_PATH}")
				Windows.startApplicationWithTitle(EMATCH_LNK_PATH, targetWindowTitle)
			} else {
				CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Windows user does not match GlobalVariable.username. Starting with WinAppDriver flow.")
				startWinAppDriver()
				CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Starting eMatch using application path: ${EMATCH_APPLICATION_PATH}")
				Windows.startApplication(EMATCH_APPLICATION_PATH)
			}
		} catch (Exception e) {
			CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Failed to start eMatch. ${e.getClass().getName()}: ${e.getMessage()}")
			KeywordUtil.markFailed("Failed to start eMatch.")
			KeywordUtil.markFailed("Exception: ${e.getClass().getName()} - ${e.getMessage()}")
			KeywordUtil.markFailedAndStop("Stopping test case due to startup failure.")
		}
	}

	private void runResolutionScriptIfAvailable() {
		try {
			File resolutionScript = new File(RESOLUTION_SCRIPT_PATH)

			if (resolutionScript.exists()) {
				CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Running resolution script: ${RESOLUTION_SCRIPT_PATH}")
				String cmd = "Powershell.exe -executionpolicy remotesigned -File ${RESOLUTION_SCRIPT_PATH}"
				Runtime.getRuntime().exec(cmd)
			} else {
				CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Resolution script not found. Continuing without it: ${RESOLUTION_SCRIPT_PATH}")
			}
		} catch (Exception e) {
			CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Resolution script failed but execution will continue. ${e.getMessage()}")
		}
	}

	private void startWinAppDriver() {
		try {
			File driver = new File(WINAPPDRIVER_EXE)

			if (!driver.exists()) {
				KeywordUtil.markFailedAndStop("WinAppDriver.exe not found at: ${WINAPPDRIVER_EXE}")
			}

			CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Starting WinAppDriver: ${WINAPPDRIVER_EXE}")

			ProcessBuilder builder = new ProcessBuilder(WINAPPDRIVER_EXE).inheritIO()
			builder.start()

			Windows.delay(2)
		} catch (Exception e) {
			CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Failed to start WinAppDriver. ${e.getClass().getName()}: ${e.getMessage()}")
			KeywordUtil.markFailedAndStop("Could not start WinAppDriver: ${e.getMessage()}")
		}
	}

	private void attachToLoginWindow(String targetWindowTitle) {
		WindowsTestObject targetWindow = new WindowsTestObject()
		targetWindow.setLocatorStrategy(LocatorStrategy.NAME)
		targetWindow.setLocator(targetWindowTitle)

		int elapsedTime = 0
		boolean windowFound = false

		while (elapsedTime < WINDOW_ATTACH_TIMEOUT_SEC) {
			try {
				Windows.switchToDesktop()
				Windows.switchToWindow(targetWindow)
				windowFound = true
				CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Attached to target window: ${targetWindowTitle}")
				break
			} catch (Exception e) {
				CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Window not ready yet: ${targetWindowTitle} | ${e.getMessage()}")
				Windows.delay(WINDOW_ATTACH_RETRY_SEC)
				elapsedTime += WINDOW_ATTACH_RETRY_SEC
			}
		}

		if (!windowFound) {
			KeywordUtil.markFailedAndStop("Target window '${targetWindowTitle}' could not be found within ${WINDOW_ATTACH_TIMEOUT_SEC} seconds.")
		}
	}

	private void openEnvironmentDropdown() {
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Opening environment dropdown')

		WinRetry.clickWithRetry('Login Page/optEnv', 3, 10)

		Windows.delay(AFTER_ENV_DROPDOWN_DELAY_SEC)
	}

	private void selectEnvironment() {
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Selecting environment: ${GlobalVariable.env}")

		int env = 3

		switch (GlobalVariable.env) {
			case 'PROD':
				env = 1
				break
			case 'PREX':
				env = 2
				break
			case 'REC2':
				env = 3
				break
			case 'REC':
				env = 4
				break
			case 'DEV2':
				env = 5
				break
			case 'DEV':
				env = 6
				break
		}

		for (int i = 0; i < env; i++) {
			Windows.sendKeys(findWindowsObject('Login Page/optEnv'), Keys.chord(Keys.ARROW_DOWN))
		}

		Windows.sendKeys(findWindowsObject('Login Page/optEnv'), Keys.chord(Keys.ENTER))

		Windows.delay(AFTER_ENV_SELECTION_DELAY_SEC)
	}

	private void clickConnectIfPresent() {
		boolean isButtonPresent = Windows.verifyElementPresent(
			findWindowsObject('Login Page/btnConnecter'),
			1,
			FailureHandling.OPTIONAL
		)

		if (isButtonPresent) {
			CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Connect button was present and was clicked.')
			Windows.click(findWindowsObject('Login Page/btnConnecter'))
			KeywordUtil.logInfo("Connect button was present and was clicked.")
		} else {
			CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Connect button was not present. Continuing test execution.')
			KeywordUtil.logInfo("Connect button was not present. Continuing test execution.")
		}
	}

	private void waitForMainScreen() {
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Waiting for main eMatch screen')

		boolean mainScreenLoaded = false

		try {
			mainScreenLoaded = Windows.waitForElementPresent(
				findWindowsObject('General/txtSearch'),
				MAIN_SCREEN_TIMEOUT_SEC,
				FailureHandling.OPTIONAL
			)
		} catch (Exception e) {
			mainScreenLoaded = false
		}

		if (!mainScreenLoaded) {
			KeywordUtil.markFailedAndStop("eMatch main screen was not loaded. Object 'General/txtSearch' not found.")
		}

		Windows.delay(AFTER_MAIN_SCREEN_DELAY_SEC)
	}

	private void activateHomeTab() {
		CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Trying to activate Home tab')

		String home = new File(RunConfiguration.getProjectDir(), 'Images/General/Home.PNG').getAbsolutePath()
		String homeGrey = new File(RunConfiguration.getProjectDir(), 'Images/General/HomeGrey.PNG').getAbsolutePath()
		String homeWhite = new File(RunConfiguration.getProjectDir(), 'Images/General/HomeWhite.PNG').getAbsolutePath()

		try {
			if (new File(home).exists()) {
				CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Clicking Home.PNG: ${home}")
				WindowsImageKeywords.clickImage(home)
				Windows.delay(AFTER_HOME_CLICK_DELAY_SEC)
				return
			}
		} catch (Exception e) {
			CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Home.PNG click failed. ${e.getMessage()}")
		}

		try {
			if (new File(homeGrey).exists()) {
				def activeTab = WindowsImageKeywords.findImage(homeGrey)
				if (activeTab != null) {
					CustomKeywords.'jiraIntegration.JiraReportSteps.note'('HomeGrey found, Home tab is already active.')
					return
				}
			}
		} catch (Exception e) {
			CustomKeywords.'jiraIntegration.JiraReportSteps.note'("HomeGrey detection failed. ${e.getMessage()}")
		}

		try {
			if (new File(homeWhite).exists()) {
				def inactiveTab = WindowsImageKeywords.findImage(homeWhite)
				if (inactiveTab != null) {
					CustomKeywords.'jiraIntegration.JiraReportSteps.note'('HomeWhite found, clicking inactive Home tab.')
					Windows.click(inactiveTab)
					Windows.delay(AFTER_HOME_CLICK_DELAY_SEC)
					return
				}
			}
		} catch (Exception e) {
			CustomKeywords.'jiraIntegration.JiraReportSteps.note'("HomeWhite click failed. ${e.getMessage()}")
		}

		CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Home tab image was not found, continuing flow.')
	}
}


CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Starting eMatch authentication test case')

CustomKeywords.'pageObject.authentication.loginToEmatch'()

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Finished eMatch authentication test case')
