	private List<File> collectExcelFiles(
			File folder,
			boolean includeSubFolders) {

		List<File> result = []

		File[] children =
				folder.listFiles()

		if (children == null) {
			return result
		}

		for (File child : children) {

			if (
			child.isFile() &&
					isExcelFile(child.getName()) &&
					!child.getName().startsWith('~$')
					) {

				result.add(child)
			} else if (
			includeSubFolders &&
					child.isDirectory()
					) {

				result.addAll(
						collectExcelFiles(
						child,
						includeSubFolders
						)
						)
			}
		}

		return result
	}


	private List<File> parseFiles(
			String filesToValidate) {

		List<File> result = []

		List<String> paths =
				splitText(filesToValidate)

		for (String path : paths) {

			String cleanPath =
					safeText(path)

			if (!cleanPath.isEmpty()) {
				result.add(
						new File(cleanPath)
						)
			}
		}

		return result.unique { File file ->

			file
					.getAbsolutePath()
					.toLowerCase()
		}
	}


	private List<String> splitText(
			String value) {

		List<String> result = []

		String text =
				safeText(value)
				.replace(
				'\r\n',
				LIST_SEPARATOR
				)
				.replace(
				'\n',
				LIST_SEPARATOR
				)
				.replace(
				';',
				LIST_SEPARATOR
				)

		if (!text.isEmpty()) {

			String[] parts =
					text.split('\\|')

			for (String part : parts) {

				String clean =
						safeText(part)

				if (!clean.isEmpty()) {
					result.add(clean)
				}
			}
		}

		return result.unique()
	}


	private boolean isExcelFile(
			String fileName) {

		String name =
				safeText(fileName)
				.toLowerCase()

		return name.endsWith('.xlsx') ||
				name.endsWith('.xls') ||
				name.endsWith('.xlsm')
	}


	// ======================================================
	// VALIDATION TYPE HELPERS
	// ======================================================

	private String resolveValidationTypeForFile(
			File file,
			String defaultValidationType) {

		String source =
				safeText(
				file.getAbsolutePath()
				)
				.toUpperCase()

		if (source.contains('EUR')) {
			return 'EUR'
		}

		if (source.contains('USD')) {
			return 'USD'
		}

		if (
		source.contains('MIXTE') ||
				source.contains('MIX')
				) {
			return 'MIXTE'
		}

		return normalizeValidationType(
				defaultValidationType
				)
	}


	private String normalizeValidationType(
			String validationType) {

		String value =
				safeText(validationType)
				.toUpperCase()

		if (value.contains('EUR')) {
			return 'EUR'
		}

		if (value.contains('USD')) {
			return 'USD'
		}

		if (value.contains('MIX')) {
			return 'MIXTE'
		}

		return safeText(validationType)
	}


	private boolean isCurrencyRefRequired(
			String validationType) {

		return !(
				'EUR'.equalsIgnoreCase(
				validationType
				) ||
				'USD'.equalsIgnoreCase(
				validationType
				)
				)
	}


	private boolean shouldValidateRow(
			String validationType,
			String currency,
			String currencyRef) {

		String type =
				normalizeValidationType(
				validationType
				)

		if ('EUR'.equalsIgnoreCase(type)) {

			return 'EUR'.equalsIgnoreCase(
					safeText(currency)
					)
		}

		if ('USD'.equalsIgnoreCase(type)) {

			return 'USD'.equalsIgnoreCase(
					safeText(currency)
					)
		}

		return !safeText(currency).isEmpty() &&
				safeText(currency)
				.equalsIgnoreCase(
				safeText(currencyRef)
				)
	}


	// ======================================================
	// HEADER HELPERS
	// ======================================================

	private int findHeaderColumn(
			Sheet sheet,
			String headerName,
			DataFormatter formatter) {

		Row headerRow =
				sheet.getRow(0)

		if (headerRow == null) {

			KeywordUtil.logInfo(
					'[ERROR] Header row not found in row 1.'
					)

			return -1
		}

		String expectedHeader =
				normalizeHeader(headerName)

		short lastCellNum =
				headerRow.getLastCellNum()

		if (lastCellNum <= 0) {

			KeywordUtil.logInfo(
					'[ERROR] Header row is empty.'
					)

			return -1
		}

		for (
		int i = 0;
				i < lastCellNum;
				i++
				) {

			Cell cell =
					headerRow.getCell(i)

			String value =
					cell == null
					? ''
					: formatter
					.formatCellValue(cell)
					.trim()

			if (
			normalizeHeader(value)
					.equals(expectedHeader)
					) {
				return i
			}
		}

		KeywordUtil.logInfo(
				"[ERROR] Header '" +
				headerName +
				"' not found."
				)

		return -1
	}


	private Map<String, Integer> resolveHeaderColumns(
			Sheet sheet,
			List<String> headers,
			DataFormatter formatter) {

		Map<String, Integer> result =
				[:]

		for (String header : headers) {

			int columnIndex =
					findHeaderColumn(
					sheet,
					header,
					formatter
					)

			if (columnIndex >= 0) {
				result.put(
						header,
						columnIndex
						)
			}
		}

		return result
	}


	private String buildValueByHeaders(
			Row row,
			List<String> headers,
			Map<String, Integer> columns,
			DataFormatter formatter,
			FormulaEvaluator evaluator) {

		List<String> values = []

		for (String header : headers) {

			Integer columnIndex =
					columns.get(header)

			String cellText =
					getCellText(
					row,
					columnIndex,
					formatter,
					evaluator
					)

			BigDecimal number =
					parseNumber(cellText)

			if (number != null) {

				cellText =
						round2(number)
						.toPlainString()
			}

			values.add(
					header +
					'=' +
					normalizeValue(cellText)
					)
		}

		return values.join(' | ')
	}


	private String normalizeHeader(
			String value) {

		return safeText(value)
				.replace('\u00A0', ' ')
				.replaceAll('\\s+', ' ')
				.trim()
				.toLowerCase()
	}


	private String normalizeValue(
			String value) {

		return safeText(value)
				.replace('\u00A0', ' ')
				.replaceAll('\\s+', ' ')
				.trim()
	}


	// ======================================================
	// CELL HELPERS
	// ======================================================

	private String getCellText(
			Row row,
			int col,
			DataFormatter formatter,
			FormulaEvaluator evaluator) {

		if (
		row == null ||
				col < 0
				) {
			return ''
		}

		Cell cell =
				row.getCell(col)

		if (cell == null) {
			return ''
		}

		try {

			return formatter
					.formatCellValue(
					cell,
					evaluator
					)
					.trim()
		} catch (Exception ignored) {

			return formatter
					.formatCellValue(cell)
					.trim()
		}
	}


	private BigDecimal getCellNumber(
			Row row,
			int col,
			DataFormatter formatter,
			FormulaEvaluator evaluator) {

		if (
		row == null ||
				col < 0
				) {
			return null
		}

		Cell cell =
				row.getCell(col)

		if (cell == null) {
			return null
		}

		try {

			CellType cellType =
					cell.getCellType()

			if (cellType == CellType.NUMERIC) {

				return BigDecimal.valueOf(
						cell.getNumericCellValue()
						)
			}

			if (
			cellType ==
					CellType.FORMULA
					) {

				CellValue evaluatedValue =
						evaluator.evaluate(cell)

				if (
				evaluatedValue != null &&
						evaluatedValue.getCellType() ==
						CellType.NUMERIC
						) {

					return BigDecimal.valueOf(
							evaluatedValue
							.getNumberValue()
							)
				}
			}

			return parseNumber(
					getCellText(
					row,
					col,
					formatter,
					evaluator
					)
					)
		} catch (Exception ignored) {

			return parseNumber(
					getCellText(
					row,
					col,
					formatter,
					evaluator
					)
					)
		}
	}


	private ComparisonResult compareAmountValues(
			Row row,
			int amountCcyCol,
			int amountBaseCol,
			DataFormatter formatter,
			FormulaEvaluator evaluator) {

		String amountCcyText =
				getCellText(
				row,
				amountCcyCol,
				formatter,
				evaluator
				)

		String amountBaseText =
				getCellText(
				row,
				amountBaseCol,
				formatter,
				evaluator
				)

		BigDecimal amountCcy =
				getCellNumber(
				row,
				amountCcyCol,
				formatter,
				evaluator
				)

		BigDecimal amountBase =
				getCellNumber(
				row,
				amountBaseCol,
				formatter,
				evaluator
				)

		if (
		amountCcy != null &&
				amountBase != null
				) {

			BigDecimal ccy =
					round2(amountCcy)

			BigDecimal base =
					round2(amountBase)

			return new ComparisonResult(
					true,
					ccy.compareTo(base) == 0,
					false,
					'numeric: ' +
					ccy +
					' vs ' +
					base
					)
		}

		String normalizedCcy =
				normalizeComparableAmountText(
				amountCcyText
				)

		String normalizedBase =
				normalizeComparableAmountText(
				amountBaseText
				)

		return new ComparisonResult(
				true,
				normalizedCcy.equalsIgnoreCase(
				normalizedBase
				),
				true,
				'text fallback: ' +
				normalizedCcy +
				' vs ' +
				normalizedBase
				)
	}


	private String normalizeComparableAmountText(
			String value) {

		String text =
				safeText(value)

		if (text.isEmpty()) {
			return ''
		}

		BigDecimal number =
				parseNumber(text)

		if (number != null) {

			return round2(number)
					.toPlainString()
		}

		return text
				.replace('\u00A0', ' ')
				.replace('\u202F', ' ')
				.replaceAll('\\s+', '')
				.trim()
	}


	// ======================================================
	// NUMBER HELPERS
	// ======================================================

	private BigDecimal parseNumber(
			String value) {

		String text =
				safeText(value)

		if (text.isEmpty()) {
			return null
		}

		text = text
				.replace('\u00A0', ' ')
				.replace('\u202F', ' ')
				.replace('\u2212', '-')
				.replace('\u2012', '-')
				.replace('\u2013', '-')
				.replace('\u2014', '-')
				.replace('\u2015', '-')
				.trim()

		boolean negativeByParentheses =
				text.startsWith('(') &&
				text.endsWith(')')

		boolean negativeByTrailingMinus =
				text.endsWith('-')

		text = text
				.replaceAll(
				'[^0-9,\\.\\-\\(\\)]',
				''
				)
				.replace('(', '')
				.replace(')', '')

		if (
		negativeByTrailingMinus &&
				text.endsWith('-')
				) {

			text = text.substring(
					0,
					text.length() - 1
					)
		}

		boolean hasNegativeSign =
				text.startsWith('-') ||
				negativeByParentheses ||
				negativeByTrailingMinus

		text = text.replace('-', '')

		if (text.isEmpty()) {
			return null
		}

		String normalized =
				normalizeNumericSeparators(
				text
				)

		if (normalized.isEmpty()) {
			return null
		}

		try {

			BigDecimal result =
					new BigDecimal(normalized)

			if (
			hasNegativeSign &&
					result.compareTo(
					BigDecimal.ZERO
					) > 0
					) {

				result =
						result.multiply(
						BigDecimal.valueOf(-1)
						)
			}

			return result
		} catch (Exception ignored) {

			return null
		}
	}


	private String normalizeNumericSeparators(
			String text) {

		String value =
				safeText(text)

		if (value.isEmpty()) {
			return ''
		}

		int commaCount =
				countOccurrences(
				value,
				','
				)

		int dotCount =
				countOccurrences(
				value,
				'.'
				)

		if (
		commaCount > 0 &&
				dotCount > 0
				) {

			int lastComma =
					value.lastIndexOf(',')

			int lastDot =
					value.lastIndexOf('.')

			if (lastComma > lastDot) {

				value =
						value.replace('.', '')

				value =
						value.replace(',', '.')
			} else {

				value =
						value.replace(',', '')
			}

			return value
		}

		if (commaCount > 0) {

			return normalizeSingleSeparatorNumber(
					value,
					','
					)
		}

		if (dotCount > 0) {

			return normalizeSingleSeparatorNumber(
					value,
					'.'
					)
		}

		return value
	}


	private String normalizeSingleSeparatorNumber(
			String value,
			String separator) {

		int separatorCount =
				countOccurrences(
				value,
				separator
				)

		if (separatorCount == 0) {
			return value
		}

		if (separatorCount > 1) {

			int lastSeparator =
					value.lastIndexOf(
					separator
					)

			String decimals =
					value.substring(
					lastSeparator + 1
					)

			if (
			decimals.length() == 1 ||
					decimals.length() == 2
					) {

				String integerPart =
						value
						.substring(
						0,
						lastSeparator
						)
						.replace(
						separator,
						''
						)

				return integerPart +
						'.' +
						decimals
			}

			return value.replace(
					separator,
					''
					)
		}

		int separatorIndex =
				value.indexOf(separator)

		String before =
				value.substring(
				0,
				separatorIndex
				)

		String after =
				value.substring(
				separatorIndex + 1
				)

		if (
		after.length() == 3 &&
				before.length() >= 1 &&
				before.length() <= 3
				) {

			return before + after
		}

		if (separator == ',') {

			return before +
					'.' +
					after
		}

		return value
	}


	private BigDecimal round2(
			BigDecimal value) {

		if (value == null) {
			return null
		}

		return value.setScale(
				2,
				RoundingMode.HALF_UP
				)
	}


	// ======================================================
	// ROW HELPERS
	// ======================================================

	private boolean isRowEmpty(
			Row row,
			DataFormatter formatter,
			FormulaEvaluator evaluator) {

		if (row == null) {
			return true
		}

		short lastCellNum =
				row.getLastCellNum()

		if (lastCellNum <= 0) {
			return true
		}

		for (
		int i = 0;
				i < lastCellNum;
				i++
				) {

			Cell cell =
					row.getCell(i)

			if (cell == null) {
				continue
			}

			String value

			try {

				value =
						formatter
						.formatCellValue(
						cell,
						evaluator
						)
						.trim()
			} catch (Exception ignored) {

				value =
						formatter
						.formatCellValue(cell)
						.trim()
			}

			if (!value.isEmpty()) {
				return false
			}
		}

		return true
	}


	// ======================================================
	// GENERAL HELPERS
	// ======================================================

	private int parseIntOrZero(
			String value) {

		try {

			return Integer.parseInt(
					safeText(value)
					)
		} catch (Exception ignored) {

			return 0
		}
	}


	private int countOccurrences(
			String text,
			String token) {

		int count = 0
		int index = 0

		while (index >= 0) {

			index =
					text.indexOf(
					token,
					index
					)

			if (index >= 0) {

				count++

				index =
						index +
						token.length()
			}
		}

		return count
	}


	private boolean isTrue(
			String value) {

		String text =
				safeText(value)
				.toLowerCase()

		return text == 'true' ||
				text == 'yes' ||
				text == 'y' ||
				text == '1' ||
				text == 'sim'
	}


	private String safeText(
			Object value) {

		if (value == null) {
			return ''
		}

		return value
				.toString()
				.trim()
	}


	private void closeWorkbook(
			Workbook workbook) {

		try {

			if (workbook != null) {
				workbook.close()
			}
		} catch (Exception ignored) {
		}
	}


	private void closeInput(
			FileInputStream input) {

		try {

			if (input != null) {
				input.close()
			}
		} catch (Exception ignored) {
		}
	}


	private static class ComparisonResult {

		boolean comparable
		boolean equals
		boolean usedTextFallback
		String message

		ComparisonResult(
		boolean comparable,
		boolean equals,
		boolean usedTextFallback,
		String message) {

			this.comparable = comparable
			this.equals = equals
			this.usedTextFallback =
					usedTextFallback
			this.message = message
		}
	}
}




















