import com.kms.katalon.core.annotation.AfterTestCase
import com.kms.katalon.core.annotation.BeforeTestCase
import com.kms.katalon.core.annotation.BeforeTestSuite
import com.kms.katalon.core.context.TestCaseContext
import com.kms.katalon.core.context.TestSuiteContext
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil

import java.io.File
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale

class ematchReport {

    private static final SimpleDateFormat TRACE_TIME =
        new SimpleDateFormat('yyyy-MM-dd HH:mm:ss.SSS', Locale.ENGLISH)

    private static final Map<String, Long> CASE_START_MS = [:].asSynchronized()

    @BeforeTestSuite
    def beforeSuite(TestSuiteContext testSuiteContext) {
        try {
            File traceFile = getTraceFile()
            if (traceFile.exists()) {
                traceFile.delete()
            }

            traceFile.parentFile?.mkdirs()
            traceFile.createNewFile()

            appendTrace('REPORT_SUITE_START', testSuiteContext?.getTestSuiteId(), now())
        } catch (Throwable t) {
            KeywordUtil.logInfo('Report listener beforeSuite failed: ' + safe(t.message))
        }
    }

    @BeforeTestCase
    def beforeCase(TestCaseContext testCaseContext) {
        try {
            String caseId = safe(testCaseContext?.getTestCaseId())
            long startMs = System.currentTimeMillis()

            CASE_START_MS[caseId] = startMs

            appendTrace('REPORT_CASE_START', caseId, formatTime(startMs))

            try {
                CustomKeywords.'jiraIntegration.ImagesEvidence.startCase'(caseId)
            } catch (Throwable ignored) {
            }
        } catch (Throwable t) {
            KeywordUtil.logInfo('Report listener beforeCase failed: ' + safe(t.message))
        }
    }

    @AfterTestCase
    def afterCase(TestCaseContext testCaseContext) {
        try {
            String caseId = safe(testCaseContext?.getTestCaseId())
            String rawStatus = safe(testCaseContext?.getTestCaseStatus())
            String reportStatus = normalizeStatus(rawStatus)

            long endMs = System.currentTimeMillis()
            long startMs = CASE_START_MS.containsKey(caseId) ? (CASE_START_MS[caseId] as long) : endMs
            long durationMs = Math.max(0L, endMs - startMs)

            List<Map> steps = extractReportSteps(caseId)
            steps.each { Map row ->
                appendTrace(
                    'REPORT_STEP',
                    caseId,
                    formatTime(asLong(row.timeMs)),
                    safe(row.detail)
                )
            }

            appendTrace('REPORT_CASE_END', caseId, formatTime(endMs))
            appendTrace('REPORT_STATUS', caseId, reportStatus)
            appendTrace('REPORT_DURATION', caseId, String.valueOf(durationMs))

            String failure = buildFailureSummary(safe(testCaseContext?.getMessage()))
            if (!failure.isEmpty()) {
                appendTrace('REPORT_FAILURE', caseId, failure)
            }

            if (reportStatus == 'FAILED') {
                try {
                    CustomKeywords.'jiraIntegration.ImagesEvidence.autoFailure'(caseId)
                } catch (Throwable ignored) {
                }
            }

            try {
                CustomKeywords.'jiraIntegration.ImagesEvidence.finishCase'()
            } catch (Throwable ignored) {
            }
        } catch (Throwable t) {
            KeywordUtil.logInfo('Report listener afterCase failed: ' + safe(t.message))
        }
    }

    private List<Map> extractReportSteps(String caseId) {
        List<Map> result = []
        List<File> logFiles = collectExecutionLogs()

        logFiles.each { File logFile ->
            boolean insideCase = false

            readLines(logFile).each { String rawLine ->
                String line = safe(rawLine)
                if (line.isEmpty()) {
                    return
                }

                def startMatcher = line =~ /START (Test Cases\/.+)$/
                if (startMatcher.find()) {
                    insideCase = safe(startMatcher.group(1)) == safe(caseId)
                    return
                }

                if (!insideCase) {
                    return
                }

                def endMatcher = line =~ /END (Test Cases\/.+)$/
                if (endMatcher.find()) {
                    if (safe(endMatcher.group(1)) == safe(caseId)) {
                        insideCase = false
                    }
                    return
                }

                int markerIndex = line.indexOf('[REPORT_STEP]')
                if (markerIndex >= 0) {
                    String detail = safe(line.substring(markerIndex + '[REPORT_STEP]'.length()))
                    long timeMs = parseExecutionLogMillis(line)

                    if (!detail.isEmpty()) {
                        result << [
                            timeMs : timeMs,
                            detail : detail
                        ]
                    }
                }
            }
        }

        result = result.unique { Map row ->
            String.valueOf(asLong(row.timeMs)) + '|' + safe(row.detail)
        }

        result.sort { Map a, Map b ->
            asLong(a.timeMs) <=> asLong(b.timeMs)
        }

        return result
    }

    private List<File> collectExecutionLogs() {
        File root = new File(RunConfiguration.getReportFolder())
        List<File> files = []

        if (!root.exists()) {
            return files
        }

        root.eachFileRecurse { File file ->
            if (!file.isFile()) {
                return
            }

            String lower = file.name.toLowerCase(Locale.ENGLISH)
            if (lower == 'execution0.log' || lower == 'execution.log' || (lower.startsWith('execution') && lower.endsWith('.log'))) {
                files << file
            }
        }

        files = files.unique { File file -> file.absolutePath }

        files.sort { File a, File b ->
            priority(a.name) <=> priority(b.name)
        }

        return files
    }

    private int priority(String name) {
        String lower = safe(name).toLowerCase(Locale.ENGLISH)
        if (lower == 'execution0.log') {
            return 0
        }
        if (lower == 'execution.log') {
            return 1
        }
        return 10
    }

    private long parseExecutionLogMillis(String line) {
        def matcher = safe(line) =~ /^(\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d{3})/
        if (matcher.find()) {
            try {
                return TRACE_TIME.parse(matcher.group(1)).time
            } catch (Throwable ignored) {
                return 0L
            }
        }
        return 0L
    }

    private String buildFailureSummary(String rawMessage) {
        String text = safe(rawMessage)
        if (text.isEmpty()) {
            return ''
        }

        List<String> meaningful = []

        text.readLines().each { String line ->
            String clean = safe(line)
            if (clean.isEmpty()) {
                return
            }
            if (clean.equalsIgnoreCase('Reason:')) {
                return
            }
            if (clean.startsWith('at ')) {
                return
            }
            if (clean.startsWith('Build info:')) {
                return
            }
            if (clean.startsWith('System info:')) {
                return
            }
            if (clean.startsWith('Driver info:')) {
                return
            }
            meaningful << clean
        }

        return meaningful.take(3).join(' | ')
    }

    private void appendTrace(String tag, Object... values) {
        File traceFile = getTraceFile()
        traceFile.parentFile?.mkdirs()

        String line = '[' + safe(tag) + ']|' + values.collect { Object item ->
            sanitizeTraceValue(item)
        }.join('|')

        traceFile.append(line + System.lineSeparator(), 'UTF-8')
    }

    private File getTraceFile() {
        return new File(RunConfiguration.getReportFolder(), 'report_trace.log')
    }

    private String now() {
        return formatTime(System.currentTimeMillis())
    }

    private String formatTime(long millis) {
        return TRACE_TIME.format(new Date(millis))
    }

    private String normalizeStatus(String rawStatus) {
        String lower = safe(rawStatus).toUpperCase(Locale.ENGLISH)

        if (lower == 'PASSED' || lower == 'PASS' || lower == 'SUCCESS') {
            return 'PASSED'
        }

        if (lower == 'FAILED' || lower == 'FAIL' || lower == 'ERROR') {
            return 'FAILED'
        }

        return 'BLOCKED'
    }

    private List<String> readLines(File file) {
        try {
            return file.readLines('UTF-8')
        } catch (Throwable ignored) {
            try {
                return file.readLines()
            } catch (Throwable ignoredAgain) {
                return []
            }
        }
    }

    private long asLong(Object value) {
        if (value instanceof Number) {
            return ((Number) value).longValue()
        }

        try {
            return Long.parseLong(safe(value))
        } catch (Throwable ignored) {
            return 0L
        }
    }

    private String sanitizeTraceValue(Object value) {
        return safe(value)
            .replace('\r', ' ')
            .replace('\n', ' ')
            .replace('|', ' / ')
    }

    private String safe(Object value) {
        return value == null ? '' : String.valueOf(value).trim()
    }
}
