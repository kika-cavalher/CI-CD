pipeline {
    agent { label 'GI5_SWDCFRNXGI55817' }

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 95, unit: 'MINUTES')
    }

    environment {
        CMD_FILE = 'run-ematch-command.cmd'
        REPORTS_DIR = "${WORKSPACE}\\Reports"
        NEXT_JOB_NAME = 'BDR Module des Responsabilite'
    }

    stages {
        stage('Clean reports') {
            steps {
                bat '''
                if exist "%REPORTS_DIR%" rmdir /s /q "%REPORTS_DIR%"
                mkdir "%REPORTS_DIR%"
                '''
            }
        }

        stage('Run suites') {
            steps {
                script {
                    def suites = [
                        'Test Suites/Archive Mode/Archive Mode'
                    ]

                    runSuitesAndValidate(suites)
                }
            }
        }

        stage('Publish reports') {
            steps {
                junit testResults: 'Reports/**/JUnit_Report.xml', allowEmptyResults: false, skipMarkingBuildUnstable: true
                archiveArtifacts artifacts: 'Reports/**/*', allowEmptyArchive: true
            }
        }

        stage('Trigger next job') {
            steps {
                build job: "${NEXT_JOB_NAME}", wait: false, propagate: false
            }
        }
    }
}

def runSuitesAndValidate(List<String> suites) {
    def notExecutedSuites = []

    suites.eachWithIndex { suitePath, index ->
        def suiteKey = "suite_${index + 1}"
        def suiteReportDir = "${env.REPORTS_DIR}\\${suiteKey}"

        bat """
        if exist "${suiteReportDir}" rmdir /s /q "${suiteReportDir}"
        mkdir "${suiteReportDir}"
        call "%WORKSPACE%\\%CMD_FILE%" "${suitePath}" "${suiteReportDir}"
        exit /b 0
        """

        def junitFile = "${suiteReportDir}\\JUnit_Report.xml"

        if (!fileExists(junitFile)) {
            notExecutedSuites.add("${suitePath} - JUnit report not generated")
            return
        }

        def xml = readFile(junitFile)
        def matcher = xml =~ /tests="(\\d+)"/

        if (!matcher.find()) {
            notExecutedSuites.add("${suitePath} - tests attribute not found")
            return
        }

        int executedTests = matcher.group(1).toInteger()

        if (executedTests <= 0) {
            notExecutedSuites.add("${suitePath} - zero tests executed")
        } else {
            echo "Executed suite: ${suitePath} | Tests: ${executedTests}"
        }
    }

    if (!notExecutedSuites.isEmpty()) {
        error("Some expected suites were not executed:\n" + notExecutedSuites.join('\n'))
    }
}
