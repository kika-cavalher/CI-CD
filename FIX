	private List<Map> buildScenariosFromJUnit(File junitFile, File reportRoot, Map<String, Map> traceByCase) {
		List<Map> scenarios = []
		Document xml = parseXml(junitFile)

		if (xml == null) {
			return scenarios
		}

		NodeList testcases = xml.getElementsByTagName('testcase')

		for (int i = 0; i < testcases.getLength(); i++) {
			Node node = testcases.item(i)
			if (!(node instanceof Element)) {
				continue
			}

			Element testcase = (Element) node

			String rawName = safe(testcase.getAttribute('name'))
			String className = safe(testcase.getAttribute('classname'))
			String displayName = buildDisplayName(className, rawName)
			String scenarioId = buildScenarioId(displayName, i + 1)

			String status = 'passed'
			String junitMessage = ''
			String junitErrorBody = ''

			NodeList children = testcase.getChildNodes()
			for (int c = 0; c < children.getLength(); c++) {
				Node child = children.item(c)
				if (!(child instanceof Element)) {
					continue
				}

				String childName = safe(child.getNodeName()).toLowerCase(Locale.ENGLISH)

				if ('failure'.equals(childName) || 'error'.equals(childName)) {
					status = 'failed'
					junitMessage = safe(((Element) child).getAttribute('message'))
					junitErrorBody = safe(child.getTextContent())
					break
				}

				if ('skipped'.equals(childName)) {
					status = 'blocked'
					junitMessage = safe(((Element) child).getAttribute('message'))
					junitErrorBody = safe(child.getTextContent())
				}
			}

			long junitDurationMs = toDurationMillis(safe(testcase.getAttribute('time')))
			Map trace = resolveTrace(traceByCase, displayName)

			long startMs = asLong(trace.startMs)
			long endMs = asLong(trace.endMs)
			long durationMs = 0L

			if (startMs > 0L && endMs >= startMs) {
				durationMs = endMs - startMs
			} else {
				durationMs = junitDurationMs
			}

			if (safe(trace.status).equalsIgnoreCase('FAILED')) {
				status = 'failed'
			}
			if (safe(trace.status).equalsIgnoreCase('BLOCKED') || safe(trace.status).equalsIgnoreCase('SKIPPED')) {
				status = 'blocked'
			}

			String htmlError = findDetailedErrorFromHtml(reportRoot, displayName, rawName, className)
			String traceFailure = safe(trace.failure)
			String traceFullFailure = safe(trace.fullFailure)

			String fullError = firstNonBlank(
					normalizeFullError(junitErrorBody),
					normalizeFullError(traceFullFailure),
					normalizeFullError(htmlError),
					normalizeFullError(traceFailure),
					normalizeFullError(junitMessage)
					)

			String visualError = buildShortError(
					firstNonBlank(junitMessage, traceFailure),
					fullError,
					displayName
					)

			List<Map> steps = normalizeStepRows(trace.steps)
			if (steps.isEmpty() && 'failed'.equals(status) && !visualError.isEmpty()) {
				steps << [
					status    : 'failed',
					timestamp : endMs > 0L ? formatClock(endMs) : '--',
					detail    : visualError,
					icon      : resolveStepIcon(visualError, 'failed')
				]
			}

			List<Map> evidence = collectEvidence(
					reportRoot,
					displayName,
					trace.evidencePaths as List<String>,
					startMs,
					endMs
					)

			scenarios << [
				id            : scenarioId,
				name          : displayName,
				scenarioName  : displayName,
				status        : status,
				result        : status,
				durationMs    : durationMs,
				durationLabel : formatDuration(durationMs),
				startTime     : startMs > 0L ? formatDateTime(startMs) : '',
				endTime       : endMs > 0L ? formatDateTime(endMs) : '',
				startLabel    : startMs > 0L ? formatDateTime(startMs) : '--',
				endLabel      : endMs > 0L ? formatDateTime(endMs) : '--',
				startShort    : startMs > 0L ? formatDateTime(startMs) : '--',
				endShort      : endMs > 0L ? formatDateTime(endMs) : '--',
				startLong     : startMs > 0L ? formatDateTime(startMs) : '--',
				endLong       : endMs > 0L ? formatDateTime(endMs) : '--',
				visualError   : visualError,
				errorSummary  : visualError,
				fullError     : fullError,
				errorDetail   : fullError,
				reportFolder  : reportRoot.absolutePath,
				steps         : steps,
				evidence      : evidence
			]
		}

		return scenarios
	}

	private List<Map> buildFallbackFromTrace(File reportRoot, Map<String, Map> traceByCase) {
		List<Map> scenarios = []

		traceByCase.eachWithIndex { String caseId, Map trace, int index ->
			long startMs = asLong(trace.startMs)
			long endMs = asLong(trace.endMs)
			long durationMs = startMs > 0L && endMs >= startMs ? (endMs - startMs) : 0L

			String rawStatus = safe(trace.status)
			String status = normalizeScenarioStatus(rawStatus)
			List<Map> steps = normalizeStepRows(trace.steps)
			String fullError = firstNonBlank(
					normalizeFullError(trace.fullFailure),
					normalizeFullError(trace.failure)
					)

			List<Map> evidence = collectEvidence(
					reportRoot,
					caseId,
					trace.evidencePaths as List<String>,
					startMs,
					endMs
					)

			scenarios << [
				id            : buildScenarioId(caseId, index + 1),
				name          : caseId,
				scenarioName  : caseId,
				status        : status,
				result        : status,
				durationMs    : durationMs,
				durationLabel : formatDuration(durationMs),
				startTime     : startMs > 0L ? formatDateTime(startMs) : '',
				endTime       : endMs > 0L ? formatDateTime(endMs) : '',
				startLabel    : startMs > 0L ? formatDateTime(startMs) : '--',
				endLabel      : endMs > 0L ? formatDateTime(endMs) : '--',
				startShort    : startMs > 0L ? formatDateTime(startMs) : '--',
				endShort      : endMs > 0L ? formatDateTime(endMs) : '--',
				startLong     : startMs > 0L ? formatDateTime(startMs) : '--',
				endLong       : endMs > 0L ? formatDateTime(endMs) : '--',
				visualError   : firstMeaningfulLine(fullError),
				errorSummary  : firstMeaningfulLine(fullError),
				fullError     : fullError,
				errorDetail   : fullError,
				reportFolder  : reportRoot.absolutePath,
				steps         : steps,
				evidence      : evidence
			]
		}

		return scenarios
	}

	private Map<String, Map> readTrace(File root) {
		Map<String, Map> result = new LinkedHashMap<String, Map>()

		TRACE_FILE_NAMES.each { String traceName ->
			File traceFile = new File(root, traceName)

			if (!traceFile.exists()) {
				return
			}

			eachLineSafely(traceFile) { String line ->
				List<String> parts = line.split('\t', 4) as List<String>
				if (parts.size() < 4) {
					return
				}

				String type = ''
				long millis = 0L
				String caseId = ''
				String payload = ''

				if (parts[1]?.isLong()) {
					type = safe(parts[0])
					millis = asLong(parts[1])
					caseId = safe(parts[2])
					payload = decode64(parts[3])
				} else {
					millis = parseDateToMillis(parts[0])
					type = safe(parts[1])
					caseId = decode64(parts[2])
					payload = decode64(parts[3])
				}

				if (caseId.isEmpty()) {
					return
				}

				Map row = result.containsKey(caseId) ? result[caseId] : [
					startMs       : 0L,
					endMs         : 0L,
					status        : '',
					failure       : '',
					fullFailure   : '',
					steps         : [],
					evidencePaths : []
				]

				switch (type) {
					case 'CASE_START':
						row.startMs = millis
						break

					case 'CASE_END':
						row.endMs = millis
						break

					case 'STATUS':
						row.status = safe(payload)
						break

					case 'STEP':
					case 'REPORT_STEP':
						row.steps << [
							status    : 'passed',
							timestamp : formatClock(millis),
							timeMs    : millis,
							detail    : safe(payload),
							icon      : resolveStepIcon(safe(payload), 'passed')
						]
						break

					case 'STEP_FAIL':
						row.failure = safe(payload)
						row.status = 'FAILED'
						row.steps << [
							status    : 'failed',
							timestamp : formatClock(millis),
							timeMs    : millis,
							detail    : safe(payload),
							icon      : resolveStepIcon(safe(payload), 'failed')
						]
						break

					case 'ERROR':
					case 'FULL_ERROR':
					case 'FAILURE_FULL':
						row.fullFailure = safe(payload)
						if (row.failure == null || safe(row.failure).isEmpty()) {
							row.failure = firstMeaningfulLine(payload)
						}
						row.status = 'FAILED'
						break

					case 'IMAGE':
					case 'EVIDENCE':
						if (!safe(payload).isEmpty()) {
							row.evidencePaths << safe(payload)
						}
						break
				}

				result[caseId] = row
			}
		}

		return result
	}

	private List<Map> normalizeStepRows(def rawSteps) {
		List<Map> result = []

		if (!(rawSteps instanceof Collection)) {
			return result
		}

		(rawSteps as Collection).each { def item ->
			if (!(item instanceof Map)) {
				return
			}

			String detail = safe(item.detail)
			if (detail.isEmpty()) {
				return
			}

			String status = normalizeStepStatus(safe(item.status))
			String timestamp = safe(item.timestamp)
			long timeMs = asLong(item.timeMs)

			result << [
				status    : status,
				timestamp : !timestamp.isEmpty() ? timestamp : (timeMs > 0L ? formatClock(timeMs) : '--'),
				detail    : detail,
				icon      : resolveStepIcon(detail, status),
				timeMs    : timeMs
			]
		}

		result = result
				.unique { Map row -> safe(row.status) + '|' + safe(row.timestamp) + '|' + safe(row.detail) }
				.sort { Map a, Map b -> asLong(a.timeMs) <=> asLong(b.timeMs) }

		return result
	}

	private Map resolveTrace(Map<String, Map> traceByCase, String displayName) {
		if (traceByCase.containsKey(displayName)) {
			return traceByCase[displayName]
		}

		String normalizedTarget = normalizeKey(displayName)

		for (Map.Entry<String, Map> entry : traceByCase.entrySet()) {
			if (normalizeKey(entry.key) == normalizedTarget) {
				return entry.value
			}
		}

		return [
			startMs       : 0L,
			endMs         : 0L,
			status        : '',
			failure       : '',
			fullFailure   : '',
			steps         : [],
			evidencePaths : []
		]
	}

	private List<Map> collectEvidence(File reportRoot, String scenarioName, List<String> tracedPaths, long startMs, long endMs) {
		List<File> searchRoots = collectImageRoots(reportRoot)
		List<File> images = []
		Set<String> seen = new LinkedHashSet<String>()

		searchRoots.each { File root ->
			if (root == null || !root.exists() || !root.isDirectory()) {
				return
			}

			root.eachFileRecurse { File file ->
				if (!isUsefulImage(file)) {
					return
				}

				if (seen.add(file.absolutePath)) {
					images << file
				}
			}
		}

		(tracedPaths ?: []).each { String path ->
			File file = new File(path)
			if (isUsefulImage(file) && seen.add(file.absolutePath)) {
				images << file
			}
		}

		String scenarioKey = normalizeKey(scenarioName)
		List<String> tokens = tokenize(scenarioName)
		long effectiveEnd = endMs > 0L ? endMs : System.currentTimeMillis()

		List<Map> scored = []
		images.each { File image ->
			String pathKey = normalizeKey(image.absolutePath)
			String lowerPath = safe(image.absolutePath).toLowerCase(Locale.ENGLISH)
			long fileMs = image.lastModified()
			int score = 0

			if ((tracedPaths ?: []).any { String p -> safe(p) == image.absolutePath }) {
				score += 1000
			}

			if (!scenarioKey.isEmpty() && pathKey.contains(scenarioKey)) {
				score += 300
			}

			tokens.each { String token ->
				if (lowerPath.contains(token)) {
					score += 50
				}
			}

			if (startMs > 0L && fileMs >= (startMs - IMAGE_TIME_BUFFER_MS) && fileMs <= (effectiveEnd + IMAGE_TIME_BUFFER_MS)) {
				score += 250
			}

			if (lowerPath.contains('evidence') || lowerPath.contains('screenshot') || lowerPath.contains('failure')) {
				score += 40
			}

			scored << [
				file  : image,
				score : score
			]
		}

		scored = scored.sort { Map a, Map b ->
			int byScore = (b.score as int) <=> (a.score as int)
			if (byScore != 0) {
				return byScore
			}
			return ((b.file as File).lastModified()) <=> ((a.file as File).lastModified())
		}

		List<Map> result = []
		scored.each { Map row ->
			File file = row.file as File
			int score = row.score as int

