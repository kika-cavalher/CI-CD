def executeSingleSuiteHeadless(suiteConfig) {
    def projectPath = "${env.WORKSPACE}\\${env.PROJECT_FILE}"
    def reportDir = "${env.WORKSPACE}\\Reports\\${suiteConfig.name}\\${env.BUILD_NUMBER}"
    
    echo "Starting execution of suite: ${suiteConfig.name}"
    
    bat "if not exist \"${reportDir}\" mkdir \"${reportDir}\""
    def chromeArgs = "--config -webui.chrome.args='--headless=new --window-size=${env.DISPLAY_WIDTH},${env.DISPLAY_HEIGHT} --no-sandbox --disable-gpu'"
    
    def katalonArgs = "-projectPath=\"${projectPath}\" " +
                      "-executionProfile=\"${env.EXECUTION_PROFILE}\" " +
                      "-browserType=\"${env.BROWSER_TYPE}\" " +
                      "-testSuitePath=\"${suiteConfig.path}\" " +
                      "-consoleLog " +
                      chromeArgs

    def katalonError = null
    try {
        executeKatalon(
            location: "${env.KATALON_HOME}",
            executeArgs: katalonArgs,
            version: '', x11Display: '', xvfbConfiguration: ''
        )
    } catch (Exception e) {
        katalonError = e.getMessage()
        echo "Katalon execution error: ${katalonError}"
    }
    
    sleep(time: 3, unit: 'SECONDS')
    
    bat """
        @echo off
        echo.
        echo ========================================
        echo Moving generated files to suite folder: ${suiteConfig.name}
        echo ========================================
        
        REM Move CSV files
        echo Moving CSV files...
        for %%f in ("${env.WORKSPACE}\\ExecutionResults_*.csv") do (
            if exist "%%f" (
                echo   Moving CSV: %%~nxf
                move "%%f" "${reportDir}\\"
            )
        )
        
        REM Move any report folders with timestamps to the suite folder
        echo Moving report folders...
        for /d %%d in ("${env.WORKSPACE}\\Reports\\202*") do (
            if exist "%%d" (
                echo   Moving report folder: %%~nxd
                robocopy "%%d" "${reportDir}" /E /MOVE /NFL /NDL /NJH /NJS >nul 2>&1
                if exist "%%d" rmdir "%%d" 2>nul
            )
        )
        
        REM Move any other files that might be generated
        echo Moving other generated files...
        for %%f in ("${env.WORKSPACE}\\*.log" "${env.WORKSPACE}\\*.html" "${env.WORKSPACE}\\*.json") do (
            if exist "%%f" (
                echo   Moving: %%~nxf
                move "%%f" "${reportDir}\\" >nul 2>&1
            )
        )
        
        echo.
        echo Files in suite report directory:
        dir "${reportDir}" 2>nul || echo   (No files found)
        echo ========================================
    """
    
    generateSummary(suiteConfig, reportDir, katalonError)
}

def buildHeadlessChromeArgs() {
    def args = [
        '--headless=new',
        "--window-size=${env.DISPLAY_WIDTH},${env.DISPLAY_HEIGHT}",
        '--no-sandbox',
        '--disable-gpu',
        '--disable-dev-shm-usage'
    ]
    
    return "--config -webui.chrome.args='${args.join(' ')}'"
}

def generateSummary(suiteConfig, reportDir, katalonError) {
    def threwVal = katalonError ? "1" : "0"
