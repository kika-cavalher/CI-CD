package jenkinsIntegration

def run(script, cfg) {

    def taskLogger = load('jenkinsIntegration/JenkinsDesktopTaskLogger.groovy')
    def consoleView = load('jenkinsIntegration/JenkinsConsoleView.groovy')
    def resultStore = load('jenkinsIntegration/JenkinsResultStore.groovy')

    def reportsRoot = "${script.pwd()}\\Reports"

    script.stage(cfg.executionStageName ?: 'Run Test Assets') {

        cfg.assets.each { asset ->

            script.stage("Run - ${asset.name}") {

                consoleView.printSuiteHeader(script, asset.name, asset.path, asset.timeoutMinutes ?: cfg.defaultTimeoutMinutes)

                int exitCode = taskLogger.runAsset(script, [
                    katalonExe      : cfg.katalonExe,
                    projectPath     : "${script.pwd()}\\${cfg.projectFileName}",
                    reportsRoot     : reportsRoot,
                    defaultTimeoutMinutes : cfg.defaultTimeoutMinutes,
                    winDriverTask   : cfg.winDriverTask
                ], asset)

                def result = [
                    name   : asset.name,
                    status : exitCode == 0 ? 'PASSED' : 'FAILED'
                ]

                consoleView.printSuiteResult(script, result)

                if (result.status != 'PASSED') {
                    script.error("${asset.name} failed")
                }
            }
        }
    }
}
