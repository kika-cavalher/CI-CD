		KeywordUtil.logInfo(
			'[GUI FAVORITE CLEANUP]\n' +
			'Application cleanup failed.\n' +
			'Reason: ' +
			(
				closeFailure.getMessage() == null ||
				closeFailure.getMessage().trim().isEmpty()
					? closeFailure.getClass().getSimpleName()
					: closeFailure.getMessage()
			)
		)

		if (executionFailure == null) {
			executionFailure = closeFailure
		}
	}
}


// ======================================================
// FINAL RESULT
// ======================================================

if (executionFailure != null) {

	KeywordUtil.markFailedAndStop(
		targetEnvironment +
		' favorite create, open, export, validate and delete flow failed.\n' +
		'Reason: ' +
		(
			executionFailure.getMessage() == null ||
			executionFailure.getMessage().trim().isEmpty()
				? executionFailure.getClass().getSimpleName()
				: executionFailure.getMessage()
		)
	)

	return
}

KeywordUtil.markPassed(
	targetEnvironment +
	' favorite create, open, export, validate and delete flow completed successfully.'
)







































