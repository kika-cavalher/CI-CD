        html.append('</span>')
        html.append('</a>')
        html.append('</div>')
        html.append('</details>')
        return html.toString()
    }

    private String renderErrorBlock(Map scenario) {
        String errorLine = safeValue(scenario.errorLine)
        String fullError = safeValue(scenario.fullError)

        if (errorLine.isEmpty() && fullError.isEmpty()) {
            return ''
        }

        StringBuilder html = new StringBuilder()
        html.append('<div class="error-summary-box">')
        html.append('<div class="error-summary-title">Visual Error Log</div>')
        html.append('<div class="error-summary-line">')
        html.append(htmlEscape(oneLine(errorLine ?: fullError, 220)))
        html.append('</div>')

        if (!fullError.isEmpty()) {
            html.append('<details class="more-block open-space">')
            html.append('<summary>🔎 View full error</summary>')
            html.append('<pre>')
            html.append(htmlEscape(fullError))
            html.append('</pre>')
            html.append('</details>')
        }

        html.append('</div>')
        return html.toString()
    }

    private String renderScenarioPanels(Map model) {
        List<Map> scenarios = model.scenarios instanceof List ? model.scenarios : []
        StringBuilder html = new StringBuilder()

        html.append('<div id="tests-content-view" class="content-view active">')

        if (scenarios.isEmpty()) {
            html.append('<div class="empty-view">No test scenario data was found.</div>')
            html.append('</div>')
            return html.toString()
        }

        scenarios.eachWithIndex { Map scenario, int index ->
            String scenarioId = safeValue(scenario.id)
            String activeClass = index == 0 ? ' active' : ''

            html.append('<section class="scenario-panel')
            html.append(activeClass)
            html.append('" id="panel-')
            html.append(htmlEscape(scenarioId))
            html.append('">')

            html.append('<div class="scenario-header">')
            html.append('<div class="scenario-title-wrap">')
            html.append('<h1 class="scenario-title">')
            html.append(htmlEscape(REPORT_TITLE_PREFIX + safeValue(model.suiteName)))
            html.append('</h1>')

            html.append('<div class="scenario-description">')
            html.append(htmlEscape(oneLine(safeValue(scenario.name), 140)))
            html.append('</div>')
            html.append(renderTags(model, scenario))
            html.append('</div>')
            html.append('</div>')

            html.append('<div class="section-label">Steps</div>')
            html.append(renderStepTable(scenario.steps instanceof List ? scenario.steps : []))
            html.append(renderErrorBlock(scenario))
            html.append(renderEvidenceSection(scenario))
            html.append('</section>')
        }

        html.append('</div>')
        return html.toString()
    }

