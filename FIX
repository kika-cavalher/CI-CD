	def getReportPath() {

		//Reads the file created on ExecutionSet, to get the report folder from last Test Suite
		FileInputStream fis = new FileInputStream(RunConfiguration.projectDir + '\\LastRun.xlsx');
		XSSFWorkbook wb = new XSSFWorkbook(fis);
		XSSFSheet sheet =  wb.getSheetAt(0);
		XSSFRow row = sheet.getRow(0);
		String result = row.getCell(0).stringCellValue;
		wb.close();
		fis.close();

		//Returns the path of last test suite execution
		return result;
	}

