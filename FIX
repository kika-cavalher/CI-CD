// =========================================================================
// TEST EXECUTION UPDATE
// =========================================================================

Map updateTestExecution(String testExecutionKey, String executionTitle, String executionDescription = '') {
	String issueKey = textOrEmpty(testExecutionKey)
	String summary = textOrEmpty(executionTitle)
	String description = textOrEmpty(executionDescription)

	if (blankText(issueKey)) {
		return [
			status : 0,
			body   : 'Skipped update because testExecutionKey is empty'
		]
	}

	Map fields = [:]

	if (!blankText(summary)) {
		fields.summary = summary
	}

	if (!blankText(description)) {
		fields.description = description
	}

	if (fields.isEmpty()) {
		return [
			status : 0,
			body   : 'Skipped update because there are no fields to update'
		]
	}

	String endpoint = JIRA_BASE_URL + '/rest/api/2/issue/' + encodePath(issueKey)
	String payload = groovy.json.JsonOutput.toJson([fields: fields])

	HttpURLConnection connection = null

	try {
		connection = openConnection(endpoint, 'PUT')
		connection.setDoOutput(true)
		connection.setRequestProperty('Content-Type', 'application/json')
		connection.setRequestProperty('Accept', 'application/json')

		connection.outputStream.withWriter('UTF-8') { writer ->
			writer.write(payload)
		}

		int status = connection.responseCode
		String body = readResponseBody(connection)

		return [
			status : status,
			body   : body
		]
	} finally {
		connection?.disconnect()
	}
}

// =========================================================================
// INTERNAL HELPERS FOR UPDATE
// =========================================================================

private String textOrEmpty(Object value) {
	return value == null ? '' : String.valueOf(value).trim()
}

private boolean blankText(Object value) {
	return textOrEmpty(value).isEmpty()
}

private String encodePath(String value) {
	return java.net.URLEncoder.encode(textOrEmpty(value), 'UTF-8').replace('+', '%20')
}

private String readResponseBody(HttpURLConnection connection) {
	if (connection == null) {
		return ''
	}

	InputStream stream = null

	try {
		stream = connection.responseCode >= 400 ? connection.getErrorStream() : connection.getInputStream()

		if (stream == null) {
			return ''
		}

		return stream.getText('UTF-8')
	} catch (Exception ignored) {
		return ''
	} finally {
		try {
			stream?.close()
		} catch (Exception ignored) {
		}
	}
}






gateway.updateTestExecution(
