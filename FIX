package keywords

import static com.kms.katalon.core.testobject.ObjectRepository.findTestObject

import java.util.List

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI

public class ButtonKeyword {

    @Keyword
    void checkButtonsExists(List<String> buttons) {
        buttons.each { button ->
            boolean buttonObj = WebUI.waitForElementVisible(
                findTestObject('Object Repository/Table/Common Button', [('title') : button]),
                3
            )

            if (buttonObj) {
                KeywordUtil.logInfo("The ${button} button is visible!")
            } else {
                KeywordUtil.markFailedAndStop("The ${button} button should be visible and it's not!")
            }
        }
    }

    @Keyword
    void closeDropdownImport(String table) {
        try {
            def importOption = findTestObject(
                'Object Repository/Correction/B2C CM/Correction Details/Import Table Option',
                [('Option') : table]
            )

            if (WebUI.verifyElementVisible(importOption, FailureHandling.OPTIONAL)) {
                WebUI.clickOffset(importOption, 90, 50)
            }
        } catch (Exception e) {
            KeywordUtil.logInfo("The element for table option '${table}' was found but not visible as expected. Error: ${e.getMessage()}")
        }
    }

    @Keyword
    void closeDropdownExport() {
        try {
            def exportOption = findTestObject('Object Repository/Settings/Context/With Data')

            if (WebUI.verifyElementVisible(exportOption, FailureHandling.OPTIONAL)) {
                WebUI.clickOffset(exportOption, 90, 50)
            }
        } catch (Exception e) {
            KeywordUtil.logInfo("Element found but not visible: ${e.getMessage()}")
        }
    }
}
