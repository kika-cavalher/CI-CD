			description + ' was found.',
			description + ' was not found.',
			errors
		)
	}


	private void validateEnabledState(
		String objectKey,
		String description,
		boolean expectedEnabled,
		Integer timeout,
		List<String> errors
	) {

		logObjectSearch(
			objectKey,
			description +
			' | Expected enabled: ' +
			expectedEnabled
		)

		WindowsTestObject targetObject =
			object(objectKey)

		boolean present =
			Windows.waitForElementPresent(
				targetObject,
				timeout,
				FailureHandling.OPTIONAL
			)

		if (!present) {
			String message =
				description +
				' was not found.'

			errors.add(message)

			KeywordUtil.logInfo(
				'[FAIL] ' + message
			)

			return
		}

		String enabledAttribute =
			safeText(
				Windows.getAttribute(
					targetObject,
					'IsEnabled',
					FailureHandling.OPTIONAL
				)
			)

		boolean actualEnabled =
			enabledAttribute.equalsIgnoreCase('True')

		if (actualEnabled == expectedEnabled) {
			KeywordUtil.logInfo(
				'[PASS] ' +
				description +
				' enabled state is correct.\n' +
				'Expected: ' +
				expectedEnabled +
				'\nActual: ' +
				actualEnabled
			)
		} else {
			String message =
				description +
				' enabled state is incorrect.\n' +
				'Expected: ' +
				expectedEnabled +
				'\nActual: ' +
				actualEnabled

			errors.add(message)

			KeywordUtil.logInfo(
				'[FAIL] ' + message
			)
		}
	}


