    KATALON_EXE = 'C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0\\katalonc.exe'
    BROWSER     = 'Windows'
    RETRY       = '0'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Prepare Context') {
      steps {
        script {
          def ws = env.WORKSPACE
          def projectPath = "${ws}\\eMatch POC.prj"
          def markerFile  = "${ws}\\Reports\\__jenkins_task_exitcode.txt"

          def collectionPath = 'Test Suites/Archive Mode/Archive Mode Collection'

          bat """
            @echo off
            if not exist "${ws}\\Reports" mkdir "${ws}\\Reports"
            del /f /q "${markerFile}" >nul 2>&1

            echo WORKSPACE=${ws}> "${env.CTX_FILE}"
            echo PROJECT_PATH=${projectPath}>> "${env.CTX_FILE}"
            echo KATALON_EXE=${env.KATALON_EXE}>> "${env.CTX_FILE}"
            echo COLLECTION_PATH=${collectionPath}>> "${env.CTX_FILE}"
            echo BROWSER_TYPE=${env.BROWSER}>> "${env.CTX_FILE}"
            echo RETRY=${env.RETRY}>> "${env.CTX_FILE}"
            echo MARKER_FILE=${markerFile}>> "${env.CTX_FILE}"

            echo [INFO] Context written to: ${env.CTX_FILE}
            type "${env.CTX_FILE}"
          """
        }
      }
    }

    stage('Run Desktop (Task Scheduler)') {
      steps {
        script {
          bat """
            @echo off
            echo [INFO] Running Task Scheduler: ${env.TASK_NAME}
            schtasks /run /tn "${env.TASK_NAME}"
            if errorlevel 1 (
              echo [ERROR] schtasks failed to run task
              exit /b 10
            )
          """

          def marker = "${env.WORKSPACE}\\Reports\\__jenkins_task_exitcode.txt"

          int maxLoops = 240
          int sleepSec = 3
          boolean found = false

          for (int i = 1; i <= maxLoops; i++) {
            if (fileExists(marker)) {
              found = true
              break
            }
            sleep time: sleepSec, unit: 'SECONDS'
          }

          if (!found) {
            error("Marker not found: ${marker}. Task did not write exit code.")
          }

          def exitCode = readFile(marker).trim()
          echo "✅ Marker exit code: ${exitCode}"

          if (!exitCode.isInteger()) {
            error("Invalid exit code in marker: ${exitCode}")
          }

          int code = exitCode.toInteger()
          if (code != 0) {
            error("Katalon finished with exit code: ${code}")
          }
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'Reports/**/*, **/*.log', allowEmptyArchive: true
    }
  }
}
