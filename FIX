        String current = safe(RunConfiguration.getReportFolder())
        if (!isBlank(current) && !isImportReportFolder(current)) {
            File currentDir = new File(current)
            if (currentDir.exists() && currentDir.isDirectory()) {
                return currentDir.absolutePath
            }
        }

        String latest = getLatestLeafReportFolderFromReportsRootExcludingImport()
        return safe(latest)
    }

    String getLatestLeafReportFolderFromReportsRootExcludingImport() {
        File reportsRoot = new File(getReportsRootPath())
        if (!reportsRoot.exists() || !reportsRoot.isDirectory()) {
            return ''
        }

        List<File> candidates = new ArrayList<File>()
        collectLeafReportFolders(reportsRoot, candidates)

        candidates = candidates.findAll { File dir ->
