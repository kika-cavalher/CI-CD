	private boolean rightClickImageWithinTimeout(
			String imagePath,
			Integer timeoutSeconds
	) {

		Integer timeout =
				safeTimeout(
				timeoutSeconds,
				5
				)

		for (
		Integer second = 1;
				second <= timeout;
				second++
				) {
			try {
				def found =
						WindowsImageKeywords.findImage(
						imagePath
						)

				if (found != null && found != false) {
					WindowsImageKeywords.rightClickImage(
							imagePath
							)

					KeywordUtil.logInfo(
							'Favorite image found. Right click completed.'
							)

					return true
				}
			} catch (Throwable ignored) {
			}

			if (second < timeout) {
				Windows.delay(1)
			}
		}

		return false
	}


	private boolean waitForImageToDisappear(
			String imagePath,
			Integer timeoutSeconds
	) {

		Integer timeout =
				safeTimeout(
				timeoutSeconds,
				5
				)

		for (
		Integer second = 1;
				second <= timeout;
				second++
				) {

			boolean visible = false

			try {
				def found =
						WindowsImageKeywords.findImage(
						imagePath
						)

				visible =
						found != null &&
						found != false
			} catch (Throwable ignored) {
				visible = false
			}

			if (!visible) {
				return true
			}

			if (second < timeout) {
				Windows.delay(1)
			}
		}

		return false
	}


