	@Keyword
	void waitForNonOpenBtnPopUp(Integer interval,maxTimes,ct) {

		try {

			//Click no to not open the file
			String non = new File(RunConfiguration.getProjectDir(), GlobalVariable.language.equals('fr')?'Images/General/No.PNG':'Images/General/NoEN.PNG').getAbsolutePath();
			Windows.delay(interval);
			WindowsImageKeywords.clickImage(non);
		} catch (Exception e) {
			ct=ct++
			if(ct<=maxTimes) {
				waitForNonOpenBtnPopUp(interval,maxTimes,ct)
			}else {
				KeywordUtil.markFailed('Not possible to download file')
			}
		}
	}


