	@Keyword
	boolean validateTabOpenedByName(
			String openedTabName,
			Integer timeoutSeconds,
			String evidencePrefix
		) {
		String tabName =
				openedTabName == null
					? ''
					: openedTabName.trim()

		int effectiveTimeout =
				timeoutSeconds == null || timeoutSeconds <= 0
					? 20
					: timeoutSeconds.intValue()

		if (tabName.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Opened tab name cannot be empty.'
			)

			return false
		}

		String safeEvidencePrefix =
				buildSafeEvidencePrefix(
						evidencePrefix,
						tabName
				)

		WindowsTestObject tabObject =
				buildNameObject(
						tabName
				)

		boolean tabOpened = false

		try {
			tabOpened =
				Windows.waitForElementPresent(
						tabObject,
						effectiveTimeout,
						FailureHandling.OPTIONAL
				)
		} catch (Exception e) {
			takeEvidence(
					safeEvidencePrefix +
					'_TabValidationError.png'
			)

			KeywordUtil.markFailedAndStop(
					'Opened tab text could not be validated.\n' +
					'Expected tab: ' + tabName + '\n' +
					'Locator strategy: NAME\n' +
					'Reason: ' + e.getMessage()
			)

			return false
		}

		if (!tabOpened) {
			takeEvidence(
					safeEvidencePrefix +
					'_TabNotOpened.png'
			)

			KeywordUtil.markFailedAndStop(
					'Tab was not opened.\n' +
					'Expected tab text: ' + tabName + '\n' +
					'Timeout: ' + effectiveTimeout + ' seconds'
			)

			return false
		}

		takeEvidence(
				safeEvidencePrefix +
				'_TabOpened.png'
		)

		KeywordUtil.logInfo(
				'[PASS] Tab opened successfully.\n' +
				'Opened tab text: ' + tabName
		)

		return true
	}


	private boolean searchAndOpenMenuByTextInternal(
			String menuName,
			String menuResultName,
			int timeoutSeconds,
			String matchMode
		) {
		if (menuName == null || menuName.trim().isEmpty()) {
			KeywordUtil.markFailedAndStop('Menu search text is empty.')
			return false
		}

		if (menuResultName == null || menuResultName.trim().isEmpty()) {
			KeywordUtil.markFailedAndStop('Menu result text is empty.')
			return false
		}

		int effectiveTimeout = timeoutSeconds <= 0 ? 20 : timeoutSeconds
		int maxAttempts = 3
		String safeMatchMode = normalizeMatchMode(matchMode)

		KeywordUtil.logInfo(
				'Searching and opening menu by text.\n' +
				'Search text: ' + menuName + '\n' +
				'Result text: ' + menuResultName + '\n' +
				'Match mode: ' + safeMatchMode + '\n' +
				'Timeout per attempt: ' + effectiveTimeout + ' seconds\n' +
				'Max attempts: ' + maxAttempts
				)

		WindowsTestObject searchBox = resolveSearchBox()

		for (int attempt = 1; attempt <= maxAttempts; attempt++) {
			KeywordUtil.logInfo('Starting menu open by text attempt ' + attempt + ' of ' + maxAttempts + '.')

			clickElementCenterByCoordinates(searchBox)
			Thread.sleep(300)

			clearFocusedField()
			pasteText(menuName)
			Thread.sleep(1000)

			if (tryOpenByMenuResult(menuResultName, effectiveTimeout, safeMatchMode)) {
				KeywordUtil.logInfo(
						'Menu opened by result text.\n' +
						'Search text: ' + menuName + '\n' +
						'Result text: ' + menuResultName + '\n' +
						'Match mode: ' + safeMatchMode
						)
				return true
			}

			KeywordUtil.logInfo(
					'Menu result was not found in this attempt.\n' +
					'Search text: ' + menuName + '\n' +
					'Result text: ' + menuResultName + '\n' +
					'Match mode: ' + safeMatchMode + '\n' +
					'Attempt: ' + attempt + '/' + maxAttempts
					)
		}

		takeEvidence('MenuResultNotOpenedByText.png')

		KeywordUtil.markFailedAndStop(
				'Menu result was not opened by text.\n' +
				'Search text: ' + menuName + '\n' +
				'Result text: ' + menuResultName + '\n' +
				'Match mode: ' + safeMatchMode + '\n' +
				'Attempts: ' + maxAttempts
				)

		return false
	}

