/*
 * Responsibility:
 * Centralize path calculations used by Jenkins desktop pipeline files.
 */

def workspace(script) {
    return script.pwd()
}

def projectPath(script, String projectFileName) {
    return "${workspace(script)}\\${projectFileName}"
}

def reportsRoot(script) {
    return "${workspace(script)}\\Reports"
}

def logsRoot(script) {
    return "${reportsRoot(script)}\\logs"
}

def desktopLogsRoot(script) {
    return "${reportsRoot(script)}\\_desktop_logs"
}

def desktopCurrentLogFile(script) {
    return "${desktopLogsRoot(script)}\\katalon_current.log"
}

def desktopResultFile(script) {
    return "${desktopLogsRoot(script)}\\desktop-run-result.json"
}

def artifactsRoot(script) {
    return "${reportsRoot(script)}\\suite-artifacts"
}

return this
