	@Keyword
	void loginThroughNativeControls(String env) {
		KeywordUtil.logInfo("Logging through native controls with simple image flow")

		focusLoginWindow(detectedWindowTitle)
		sleepMs(800)

		selectEnvironment('REC')
		sleepMs(1000)

		clickConnectButton()
		sleepMs(1500)

		boolean mainScreenLoaded = waitForMainScreen()

		if (!mainScreenLoaded) {
			KeywordUtil.markFailedAndStop("eMatch main screen was not loaded")
		}

		activateHomeTab()
		KeywordUtil.logInfo("eMatch startup flow completed successfully")
	}








