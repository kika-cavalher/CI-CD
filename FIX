package jiraIntegration

import java.text.SimpleDateFormat

import com.kms.katalon.core.annotation.Keyword

class JiraReportSteps {

    private static final Object LOCK = new Object()
    private static final Map<String, Map> CASES = new LinkedHashMap<String, Map>()
    private static final ThreadLocal<String> CURRENT_CASE = new ThreadLocal<String>()
    private static String SUITE_NAME = ''

    @Keyword
    def reset() {
        synchronized (LOCK) {
            CASES.clear()
            SUITE_NAME = ''
            CURRENT_CASE.remove()
        }
    }

    @Keyword
    def setSuiteName(String suiteName) {
        synchronized (LOCK) {
            SUITE_NAME = safe(suiteName)
        }
    }

    @Keyword
    def startCase(String caseId) {
        synchronized (LOCK) {
            String id = safe(caseId)
            CURRENT_CASE.set(id)
            ensureCase(id)
        }
    }

    @Keyword
    def note(String message) {
        synchronized (LOCK) {
            String text = safe(message)
            if (text.isEmpty()) {
                return
            }

            String caseId = currentCaseId()
            Map record = ensureCase(caseId)

            finalizePendingStep(record, 'PASSED')

            record.steps << [
                status   : 'PENDING',
                timestamp: timeNow(),
                details  : text
            ]
        }
    }

    @Keyword
    def fail(String rawError) {
        synchronized (LOCK) {
            String caseId = currentCaseId()
            Map record = ensureCase(caseId)

            String fullError = normalizeErrorText(rawError, caseId)
            record.fullError = fullError
            record.shortError = buildCompactError(fullError)
            record.status = 'FAILED'

            boolean updatedPending = markLastPendingStep(record, 'FAILED')

            if (!updatedPending) {
                String fallbackStepText = record.steps ? safe(record.steps[-1].details) : 'Execution failed'
                record.steps << [
                    status   : 'FAILED',
                    timestamp: timeNow(),
                    details  : fallbackStepText
                ]
            }
        }
    }

    @Keyword
    def finishCase(String rawStatus) {
        synchronized (LOCK) {
            String caseId = currentCaseId()
            Map record = ensureCase(caseId)

            String requestedStatus = normalizeRequestedStatus(rawStatus)
            String finalStatus = decideFinalStatus(record, requestedStatus)

            if ('PASSED'.equals(finalStatus)) {
                finalizePendingStep(record, 'PASSED')
            } else if ('FAILED'.equals(finalStatus)) {
                if (!markLastPendingStep(record, 'FAILED') && !hasFailedStep(record) && record.steps) {
                    record.steps[-1].status = 'FAILED'
                }
                markAllPendingAs(record, 'BLOCKED')
            } else {
                markAllPendingAs(record, 'BLOCKED')
            }

            record.status = finalStatus
            record.endedAt = System.currentTimeMillis()
            record.endText = dateTimeNow()
            record.durationText = formatDuration((record.endedAt as long) - (record.startedAt as long))
        }
    }

    @Keyword
    boolean caseHasFailure(String caseId) {
        return caseHasFailureStatic(caseId)
    }

    @Keyword
    def registerEvidence(String caseId, String fileName, String relativePath, String absolutePath) {
        registerEvidenceStatic(caseId, fileName, relativePath, absolutePath)
    }

    @Keyword
    List<Map> getCases() {
        return snapshotCases()
    }

    @Keyword
    Map getCase(String caseId) {
        return snapshotCase(caseId)
    }

    @Keyword
    String getSuiteName() {
        return suiteNameStatic()
    }

    static boolean caseHasFailureStatic(String caseId) {
        synchronized (LOCK) {
            Map record = CASES[safe(caseId)]
            return record != null && (
                'FAILED'.equals(record.status) ||
                hasFailedStep(record) ||
                !safe(record.fullError).isEmpty()
            )
        }
    }

    static void registerEvidenceStatic(String caseId, String fileName, String relativePath, String absolutePath) {
        synchronized (LOCK) {
            Map record = ensureCase(safe(caseId))
            record.evidence << [
                name        : safe(fileName),
                relativePath: normalizePath(relativePath),
                absolutePath: normalizePath(absolutePath)
            ]
        }
    }

    static List<Map> snapshotCases() {
        synchronized (LOCK) {
            return CASES.values().collect { deepCopyCase(it) }
        }
    }

    static Map snapshotCase(String caseId) {
        synchronized (LOCK) {
            Map record = CASES[safe(caseId)]
            return record ? deepCopyCase(record) : [:]
        }
    }

    static String suiteNameStatic() {
        synchronized (LOCK) {
            return SUITE_NAME
        }
    }

    private static Map ensureCase(String caseId) {
        String id = safe(caseId)

        if (!CASES.containsKey(id)) {
            long startedAt = System.currentTimeMillis()

            CASES[id] = [
                caseId      : id,
                displayName : displayNameFromCaseId(id),
                steps       : [],
                evidence    : [],
                status      : 'PASSED',
                fullError   : '',
                shortError  : '',
                startedAt   : startedAt,
                endedAt     : startedAt,
                startText   : dateTimeNow(),
                endText     : '',
                durationText: '00h 00m 00s'
            ]
        }

        return CASES[id]
    }

    private static Map deepCopyCase(Map record) {
        return [
            caseId      : safe(record.caseId),
            displayName : safe(record.displayName),
            steps       : (record.steps ?: []).collect { [status: safe(it.status), timestamp: safe(it.timestamp), details: safe(it.details)] },
            evidence    : (record.evidence ?: []).collect { [name: safe(it.name), relativePath: safe(it.relativePath), absolutePath: safe(it.absolutePath)] },
            status      : safe(record.status),
            fullError   : safe(record.fullError),
            shortError  : safe(record.shortError),
            startedAt   : record.startedAt ?: 0L,
            endedAt     : record.endedAt ?: 0L,
            startText   : safe(record.startText),
            endText     : safe(record.endText),
            durationText: safe(record.durationText)
        ]
    }

    private static String decideFinalStatus(Map record, String requestedStatus) {
        if (hasFailedStep(record) || !safe(record.fullError).isEmpty()) {
            return 'FAILED'
        }

        if ('FAILED'.equals(requestedStatus)) {
            return 'FAILED'
        }

        if ('BLOCKED'.equals(requestedStatus)) {
            return 'BLOCKED'
        }

        return 'PASSED'
    }

    private static String normalizeRequestedStatus(String rawStatus) {
        String value = safe(rawStatus).toUpperCase(Locale.ENGLISH)

        if (value in ['FAILED', 'FAIL', 'ERROR']) {
            return 'FAILED'
        }

        if (value in ['SKIPPED', 'BLOCKED']) {
            return 'BLOCKED'
        }

        return 'PASSED'
    }

    private static void finalizePendingStep(Map record, String finalStatus) {
        for (int i = record.steps.size() - 1; i >= 0; i--) {
            if ('PENDING'.equals(record.steps[i].status)) {
                record.steps[i].status = finalStatus
                return
            }
        }
    }

    private static boolean markLastPendingStep(Map record, String finalStatus) {
        for (int i = record.steps.size() - 1; i >= 0; i--) {
            if ('PENDING'.equals(record.steps[i].status)) {
                record.steps[i].status = finalStatus
                return true
            }
        }
        return false
    }

    private static void markAllPendingAs(Map record, String finalStatus) {
        (record.steps ?: []).each { Map step ->
            if ('PENDING'.equals(step.status)) {
                step.status = finalStatus
            }
        }
    }

    private static boolean hasFailedStep(Map record) {
        return (record.steps ?: []).any { 'FAILED'.equals(safe(it.status)) }
    }

    private static String normalizeErrorText(String rawError, String caseId) {
        String text = safe(rawError)
        String header = displayNameFromCaseId(caseId) + ' FAILED.'

        if (text.isEmpty()) {
            return header + '\nReason:\nNo error message was returned.'
        }

        text = text.replace('\r\n', '\n').replace('\r', '\n').trim()

        if (!text.startsWith(header)) {
            return header + '\nReason:\n' + text
        }

        return text
    }

    private static String buildCompactError(String fullError) {
        List<String> lines = safe(fullError)
            .replace('\r\n', '\n')
            .replace('\r', '\n')
            .readLines()
            .collect { safe(it) }
            .findAll { !it.isEmpty() }

        if (lines.isEmpty()) {
            return ''
        }

        int maxLines = Math.min(3, lines.size())
        return lines.take(maxLines).join('\n')
    }

    private static String currentCaseId() {
        String caseId = CURRENT_CASE.get()
        if (!safe(caseId).isEmpty()) {
            return caseId
        }

        if (!CASES.isEmpty()) {
            return CASES.keySet().last()
        }

        return 'Unknown Test Case'
    }

    private static String displayNameFromCaseId(String caseId) {
        String value = safe(caseId)
        if (value.startsWith('Test Cases/')) {
            return value
        }
        return value.isEmpty() ? 'Unknown Test Case' : value
    }

    private static String dateTimeNow() {
        return new SimpleDateFormat('dd/MM/yyyy HH:mm:ss').format(new Date())
    }

    private static String timeNow() {
        return new SimpleDateFormat('HH:mm:ss').format(new Date())
    }

    private static String formatDuration(long millis) {
        long totalSeconds = Math.max(0L, Math.round(millis / 1000.0d))
        long hours = (long) (totalSeconds / 3600)
        long minutes = (long) ((totalSeconds % 3600) / 60)
        long seconds = (long) (totalSeconds % 60)

        return String.format('%02dh %02dm %02ds', hours, minutes, seconds)
    }

    private static String normalizePath(String path) {
        return safe(path).replace('\\', '/')
    }

    private static String safe(Object value) {
        return value == null ? '' : String.valueOf(value).trim()
    }
}
