						sourceValues.size()
				)
			}

			return [
				fileName            : mainFile.name,
				sourceValues        : sourceValues,
				uniqueSourceValues  : uniqueValues,
				nonEmptySourceRows  : sourceValues.size(),
				ignoredBlankRows    :
					Math.max(
						0,
						sheet.lastRowNum -
							sourceHeader.rowIndex -
							sourceValues.size()
					)
			]
		} finally {
