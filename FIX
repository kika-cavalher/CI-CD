	@Keyword
	void dragAndDropImage(
			String sourceImageKey,
			String targetImageKey,
			Integer waitSeconds
	) {

		Integer waitTime = safeTimeout(waitSeconds, 2)

		logStep(
				'DRAG AND DROP',
				'Source: ' + sourceImageKey + '\n' +
				'Target: ' + targetImageKey
				)

		try {
			WindowsImageKeywords.dragAndDrop(
					image(GUI_IMAGE_GROUP, sourceImageKey),
					image(GUI_IMAGE_GROUP, targetImageKey)
					)

			Windows.delay(waitTime)

			KeywordUtil.logInfo(
					'[PASS] Drag and drop completed.'
					)
		} catch (Exception e) {
			takeEvidence(
					'GUI_DragAndDropFailed_' +
					sourceImageKey +
					'.png'
					)

			KeywordUtil.markFailedAndStop(
					'Drag and drop failed.\n' +
					'Source: ' + sourceImageKey + '\n' +
					'Target: ' + targetImageKey + '\n' +
					'Reason: ' + safeMessage(e)
					)
		}
	}


	@Keyword
	void validateGroupByResult(Integer timeoutSeconds) {

		Integer timeout = safeTimeout(timeoutSeconds, 5)
		List<String> errors = []

		String expectedSecondRowPrefix =
				'Ecart bilan vs. compte de résultat ccy'

		logStep(
				'GROUP BY RESULT',
				'Double-click the first Group By result row\n' +
				'Validate that line 2 starts with: ' +
				expectedSecondRowPrefix
				)

		boolean firstRowOpenedByImage =
				openFirstGroupByRowByImage()

		if (!firstRowOpenedByImage) {
			KeywordUtil.logInfo(
					'[INFO] First row image was not found. ' +
					'Trying the Windows element.'
					)

			openFirstGroupByRowByElement(
					timeout,
					errors
					)
		}

		if (errors.isEmpty()) {
			Windows.delay(1)
		}

		boolean secondRowFoundByImage = false

		if (errors.isEmpty()) {
			secondRowFoundByImage =
					validateSecondGroupByRowByImage()
		}

		if (
		errors.isEmpty() &&
				!secondRowFoundByImage
				) {
			KeywordUtil.logInfo(
					'[INFO] Second row image was not found. ' +
					'Trying the Windows element.'
					)

			validateSecondGroupByRowByElement(
					expectedSecondRowPrefix,
					timeout,
					errors
					)
		}

		takeEvidence(
				'GUI_GroupByResultValidated.png'
				)

		finishValidation(
				'Group By result validation',
				errors
				)
	}


	private boolean openFirstGroupByRowByImage() {

		try {
			String imagePath =
					image(
					GUI_IMAGE_GROUP,
					'firstGroupResultRow'
					)

			WindowsImageKeywords.clickImage(imagePath)
			WindowsImageKeywords.clickImage(imagePath)

			KeywordUtil.logInfo(
					'[PASS] First Group By row was opened ' +
					'using the image.'
					)

			return true
		} catch (Exception e) {
			KeywordUtil.logInfo(
					'[INFO] Could not open the first Group By row ' +
					'using image.\n' +
					'Image: firstGroupResultRow\n' +
					'Reason: ' + safeMessage(e)
					)

			return false
		}
	}


	private void openFirstGroupByRowByElement(
			Integer timeout,
			List<String> errors
	) {

		WindowsTestObject firstRowObject =
				object('firstGroupResultRow')

		boolean firstRowPresent =
				Windows.waitForElementPresent(
				firstRowObject,
				timeout,
				FailureHandling.OPTIONAL
				)

		if (!firstRowPresent) {
			errors.add(
					'First Group By result row was not found.\n' +
					'Image: firstGroupResultRow\n' +
					'Object: firstGroupResultRow'
					)

			return
		}

		try {
			Windows.doubleClick(
					firstRowObject,
					FailureHandling.STOP_ON_FAILURE
					)

			KeywordUtil.logInfo(
					'[PASS] First Group By row was opened ' +
					'using the Windows element.'
					)
		} catch (Exception e) {
			errors.add(
					'Could not double-click the first ' +
					'Group By result row.\n' +
					'Object: firstGroupResultRow\n' +
					'Reason: ' + safeMessage(e)
					)
		}
	}


