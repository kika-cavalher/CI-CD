import com.kms.katalon.core.annotation.AfterTestCase
import com.kms.katalon.core.annotation.BeforeTestCase
import com.kms.katalon.core.context.TestCaseContext
import com.kms.katalon.core.util.KeywordUtil

import java.util.Locale

class ematchReport {

	@BeforeTestCase
	def beforeCase(TestCaseContext testCaseContext) {
		String caseId = safe(testCaseContext != null ? testCaseContext.getTestCaseId() : '')

		if (caseId.isEmpty()) {
			return
		}

		try {
			CustomKeywords.'jiraIntegration.JiraReportSteps.startCase'(caseId)
		} catch (Throwable t) {
			KeywordUtil.logInfo('Report listener startCase failed: ' + safe(t.message))
		}

		try {
			CustomKeywords.'jiraIntegration.JiraImagesEvidence.startCase'(caseId)
		} catch (Throwable t) {
			KeywordUtil.logInfo('Evidence listener startCase failed: ' + safe(t.message))
		}
	}

	@AfterTestCase
	def afterCase(TestCaseContext testCaseContext) {
		String caseId = safe(testCaseContext != null ? testCaseContext.getTestCaseId() : '')
		String status = normalizeStatus(testCaseContext != null ? testCaseContext.getTestCaseStatus() : '')
		String rawFailureMessage = safe(testCaseContext != null ? testCaseContext.getMessage() : '')

		if ('FAILED'.equals(status) && !rawFailureMessage.isEmpty()) {
			try {
				// Important:
				// Send the COMPLETE message, not only the first line.
				CustomKeywords.'jiraIntegration.JiraReportSteps.fail'(rawFailureMessage)
			} catch (Throwable t) {
				KeywordUtil.logInfo('Report listener fail() failed: ' + safe(t.message))
			}
		}

		if ('FAILED'.equals(status) && !caseId.isEmpty()) {
			try {
				CustomKeywords.'jiraIntegration.JiraImagesEvidence.autoFailure'(caseId, rawFailureMessage)
			} catch (Throwable t) {
				KeywordUtil.logInfo('Evidence listener autoFailure failed: ' + safe(t.message))
			}
		}

		try {
			CustomKeywords.'jiraIntegration.JiraReportSteps.finishCase'(status)
		} catch (Throwable t) {
			KeywordUtil.logInfo('Report listener finishCase failed: ' + safe(t.message))
		}

		try {
			CustomKeywords.'jiraIntegration.JiraImagesEvidence.finishCase'()
		} catch (Throwable t) {
			KeywordUtil.logInfo('Evidence listener finishCase failed: ' + safe(t.message))
		}
	}

	private String normalizeStatus(String rawStatus) {
		String upper = safe(rawStatus).toUpperCase(Locale.ENGLISH)

		if (upper == 'PASSED' || upper == 'PASS' || upper == 'SUCCESS') {
			return 'PASSED'
		}

		if (upper == 'FAILED' || upper == 'FAIL' || upper == 'ERROR') {
			return 'FAILED'
		}

		if (upper == 'SKIPPED' || upper == 'SKIP') {
			return 'BLOCKED'
		}

		return upper.isEmpty() ? 'UNKNOWN' : upper
	}

	private String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}
}
