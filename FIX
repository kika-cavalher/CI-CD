	private String resolveStepEmoji(String title) {
		String lower = safeValue(title).toLowerCase(Locale.ENGLISH)

		if (lower.contains('wait') || lower.contains('search') || lower.contains('find')) return '🔎'
		if (lower.contains('click') || lower.contains('select')) return '🖱️'
		if (lower.contains('fill') || lower.contains('input') || lower.contains('settext') || lower.contains('write')) return '⌨️'
		if (lower.contains('open') || lower.contains('navigate') || lower.contains('calltestcase')) return '🌐'
		if (lower.contains('verify') || lower.contains('assert')) return '✅'
		return '🔹'
	}

	private String resolveImageMime(String fileName) {
		String lower = safeValue(fileName).toLowerCase(Locale.ENGLISH)

		if (lower.endsWith('.png')) return 'image/png'
		if (lower.endsWith('.jpg') || lower.endsWith('.jpeg')) return 'image/jpeg'
		if (lower.endsWith('.webp')) return 'image/webp'
		if (lower.endsWith('.gif')) return 'image/gif'
		if (lower.endsWith('.bmp')) return 'image/bmp'

		return 'image/png'
	}

	private boolean isImageFile(String fileName) {
		String lower = safeValue(fileName).toLowerCase(Locale.ENGLISH)
		return lower.endsWith('.png') ||
				lower.endsWith('.jpg') ||
				lower.endsWith('.jpeg') ||
				lower.endsWith('.webp') ||
				lower.endsWith('.gif') ||
				lower.endsWith('.bmp')
	}

	private String escapeXml(String value) {
		return safeValue(value)
				.replace('&', '&amp;')
				.replace('<', '&lt;')
				.replace('>', '&gt;')
				.replace('"', '&quot;')
				.replace("'", '&apos;')
	}

	private String safeValue(def value) {
		return value == null ? '' : String.valueOf(value).trim()
	}

	private boolean isBlank(def value) {
		return safeValue(value).isEmpty()
	}

	private long toLong(def value) {
		String raw = safeValue(value)
		if (raw.isEmpty()) {
			return 0L
		}

		try {
			return Long.parseLong(raw)
		} catch (Exception ignored) {
		}

		try {
			String normalized = raw.replace(',', '.')
			return Math.round(Double.parseDouble(normalized))
		} catch (Exception ignored) {
			return 0L
		}
	}
}
