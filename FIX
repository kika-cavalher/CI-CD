import java.io.File

import com.kms.katalon.core.util.KeywordUtil


// ======================================================
// COMPARISON CONFIG
// ======================================================

String recEnvironment = 'REC'
String prdEnvironment = 'PRD'

String exportLabel = 'ExclusionBooks'

String scenarioName =
    'REC x PRD - Exclusion Books - Validate Row Count'


// ======================================================
// RESOLVE REC EXPORT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
    'Resolve REC Exclusion Books export\n' +
    'Environment: ' + recEnvironment +
    '\nExport label: ' + exportLabel
)

Map recExportValidation =
    CustomKeywords.
    'commands.ExportFileValidationKeywords.validateExportedFileExistsAndHasRows'(
        recEnvironment,
        exportLabel
    )

String recExportPath =
    new File(
        recExportValidation.folderPath.toString(),
        recExportValidation.fileName.toString()
    ).absolutePath

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
    'REC Exclusion Books export resolved successfully\n' +
    'File: ' + recExportValidation.fileName +
    '\nPath: ' + recExportPath +
    '\nData rows: ' + recExportValidation.dataRows +
    '\nFile size: ' + recExportValidation.fileSize + ' bytes'
)


// ======================================================
// RESOLVE PRD EXPORT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
    'Resolve PRD Exclusion Books export\n' +
    'Environment: ' + prdEnvironment +
    '\nExport label: ' + exportLabel
)

Map prdExportValidation =
    CustomKeywords.
    'commands.ExportFileValidationKeywords.validateExportedFileExistsAndHasRows'(
        prdEnvironment,
        exportLabel
    )

String prdExportPath =
    new File(
        prdExportValidation.folderPath.toString(),
        prdExportValidation.fileName.toString()
    ).absolutePath

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
    'PRD Exclusion Books export resolved successfully\n' +
    'File: ' + prdExportValidation.fileName +
    '\nPath: ' + prdExportPath +
    '\nData rows: ' + prdExportValidation.dataRows +
    '\nFile size: ' + prdExportValidation.fileSize + ' bytes'
)


// ======================================================
// COMPARE ROW COUNT ONLY
// ======================================================

Integer recRows =
    recExportValidation.dataRows == null
        ? 0
        : Integer.valueOf(recExportValidation.dataRows.toString())

Integer prdRows =
    prdExportValidation.dataRows == null
        ? 0
        : Integer.valueOf(prdExportValidation.dataRows.toString())

Boolean success =
    recRows == prdRows

String errors =
    success
        ? ''
        : '[ERROR] REC and PRD Exclusion Books row counts are different.\n' +
          'REC rows: ' + recRows +
          '\nPRD rows: ' + prdRows


// ======================================================
// REPORT RESULT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
    (success ? '[PASS] ' : '[FAIL] ') +
    'Exclusion Books REC x PRD row count comparison\n' +
    'REC file: ' + recExportValidation.fileName +
    '\nPRD file: ' + prdExportValidation.fileName +
    '\nREC rows: ' + recRows +
    '\nPRD rows: ' + prdRows
)


// ======================================================
// FINAL RESULT
// ======================================================

if (!success) {

    CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
        '[FAIL] Final Exclusion Books validation result\n' +
        errors
    )

    KeywordUtil.markFailed(
        scenarioName +
        ' failed.\n' +
        errors
    )

} else {

    CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
        '[PASS] Final Exclusion Books validation result\n' +
        'REC x PRD row count validation completed successfully.'
    )

    KeywordUtil.markPassed(
        scenarioName +
        ' completed successfully.'
    )
}



