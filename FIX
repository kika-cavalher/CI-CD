class ExportFileComparator {

	private static final int MAX_MISMATCHES_PER_COLUMN = 30
	private static final int MAX_COLLECTION_LENGTH = 20
	private static final int MAX_FEATURE_LENGTH = 28
	private static final int MAX_EXECUTION_LENGTH = 48
	private static final String SHORT_EXPORT_ROOT = 'C:\\KatalonExports'

	@Keyword
	String validateRecProdExportFiles(Integer threshold) {
		Map result = compareRecProdExportFiles(threshold)
		return result.errorsText
	}

	@Keyword
	Map compareRecProdExportFiles(Integer threshold) {
		int safeThreshold = threshold == null ? 0 : threshold
		String featureName = resolveCurrentFeatureName()
		String collectionName = resolveCurrentCollectionName()
		String sanitizedFeatureName = sanitizeFileName(featureName)
		File sharedExportFolder = resolveComparisonExportFolder()
		File recFile = findLatestExportFile(sharedExportFolder, 'REC', sanitizedFeatureName)
		File prdFile = findLatestExportFile(sharedExportFolder, 'PRD', sanitizedFeatureName)

		Map result = [
			collectionName   : collectionName,
			featureName      : featureName,
			threshold        : safeThreshold,
			sharedFolder     : sharedExportFolder.getAbsolutePath(),
			recFileName      : recFile == null ? 'NOT FOUND' : recFile.getName(),
			recFilePath      : recFile == null ? 'NOT FOUND' : recFile.getAbsolutePath(),
			prdFileName      : prdFile == null ? 'NOT FOUND' : prdFile.getName(),
			prdFilePath      : prdFile == null ? 'NOT FOUND' : prdFile.getAbsolutePath(),
			validations      : [],
			differences      : [],
			errors           : [],
			errorsText       : '',
			totalValidations : 0,
			passedValidations: 0,
			failedValidations: 0
		]

		if (recFile == null) {
			addValidation(result, 'Validate REC exported file exists', false,
					'Expected folder: ' + sharedExportFolder.getAbsolutePath() + '\n' +
					'Expected format: REC_yyyyMMdd_HHmmss_' + sanitizedFeatureName + '_*.xlsx')
			result.errors.add('REC exported file was not found in current suite execution folder: ' + sharedExportFolder.getAbsolutePath())
		} else {
			addValidation(result, 'Validate REC exported file exists', true,
					'REC file selected: ' + recFile.getName() + '\nPath: ' + recFile.getAbsolutePath())
		}

		if (prdFile == null) {
			addValidation(result, 'Validate PRD exported file exists', false,
					'Expected folder: ' + sharedExportFolder.getAbsolutePath() + '\n' +
					'Expected format: PRD_yyyyMMdd_HHmmss_' + sanitizedFeatureName + '_*.xlsx')
			result.errors.add('PRD exported file was not found in current suite execution folder: ' + sharedExportFolder.getAbsolutePath())
		} else {
			addValidation(result, 'Validate PRD exported file exists', true,
					'PRD file selected: ' + prdFile.getName() + '\nPath: ' + prdFile.getAbsolutePath())
		}

		if (recFile != null && prdFile != null) {
			compareExcelFiles(recFile, prdFile, safeThreshold, result)
		}

		refreshResultCounters(result)
		result.errorsText = result.errors.join('\n')

		KeywordUtil.logInfo('REC/PRD comparison collection: ' + collectionName)
		KeywordUtil.logInfo('REC/PRD comparison feature: ' + featureName)
		KeywordUtil.logInfo('REC/PRD comparison current folder: ' + result.sharedFolder)
		KeywordUtil.logInfo('REC file selected: ' + result.recFilePath)
		KeywordUtil.logInfo('PRD file selected: ' + result.prdFilePath)
		KeywordUtil.logInfo('REC/PRD comparison errors: ' + result.errors.size())

		return result
	}

	private File resolveComparisonExportFolder() {
		File executionFolder = resolveCurrentSuiteExecutionFolder()
		String collectionName = shortenFilePart(sanitizeFileName(resolveCurrentCollectionName()), MAX_COLLECTION_LENGTH)
		String featureName = shortenFilePart(sanitizeFileName(resolveCurrentFeatureName()), MAX_FEATURE_LENGTH)
		return new File(new File(executionFolder, collectionName), featureName)
	}

	private File resolveCurrentSuiteExecutionFolder() {
		File baseRoot = resolveWritableBaseExportRoot()
		File executionRoot = resolveExecutionRootFolder()
		String executionName = executionRoot == null ? '' : executionRoot.getName()

		if (executionName == null || executionName.trim().isEmpty()) {
			executionName = 'Unknown_Execution'
		}

		return new File(baseRoot, shortenFilePart(sanitizeFileName(executionName), MAX_EXECUTION_LENGTH))
	}

	private File resolveWritableBaseExportRoot() {
		File preferredRoot = new File(SHORT_EXPORT_ROOT)

		try {
			if (!preferredRoot.exists()) {
				preferredRoot.mkdirs()
			}

			if (preferredRoot.exists() && preferredRoot.isDirectory() && preferredRoot.canWrite()) {
				return preferredRoot
			}
		} catch (Exception ignored) {
		}

		File temporaryRoot = new File(System.getProperty('java.io.tmpdir'), 'KatalonExports')

		if (!temporaryRoot.exists()) {
			temporaryRoot.mkdirs()
		}

		return temporaryRoot
	}

	private File resolveExecutionRootFolder() {
		String reportFolderPath = RunConfiguration.getReportFolder()

		if (reportFolderPath == null || reportFolderPath.trim().isEmpty()) {
			return new File(RunConfiguration.getProjectDir(), 'Reports\\Unknown_Execution')
		}

		File current = new File(reportFolderPath)

		while (current != null) {
			File parent = current.getParentFile()

			if (parent != null && parent.getName().equalsIgnoreCase('Reports')) {
				return current
			}

			current = parent
		}

		return new File(reportFolderPath)
	}

	private String resolveCurrentCollectionName() {
		List<String> validParts = getValidReportFolderParts()
		return validParts.isEmpty() ? 'Collection' : validParts[0]
	}

	private String resolveCurrentFeatureName() {
		List<String> validParts = getValidReportFolderParts()
		return validParts.isEmpty() ? 'Export' : validParts.last()
	}

	private List<String> getValidReportFolderParts() {
		List<String> validParts = []
		String reportFolderPath = RunConfiguration.getReportFolder()

		if (reportFolderPath == null || reportFolderPath.trim().isEmpty()) {
			return validParts
		}

		File executionRootFolder = resolveExecutionRootFolder()
		String fullPath = new File(reportFolderPath).getAbsolutePath()
		String rootPath = executionRootFolder.getAbsolutePath()

		if (!fullPath.toLowerCase().startsWith(rootPath.toLowerCase())) {
			return validParts
		}

		String relativePath = fullPath.substring(rootPath.length()).replaceAll('^\\\\+', '')

		if (relativePath.trim().isEmpty()) {
			return validParts
		}

		List<String> parts = relativePath.replace('/', '\\').split('\\\\') as List<String>

		for (String part : parts) {
			if (isValidFeatureNamePart(part)) {
				validParts.add(part.trim())
			}
		}

		return validParts
	}

	private boolean isValidFeatureNamePart(String part) {
		if (part == null || part.trim().isEmpty()) {
			return false
		}

		String value = part.trim()
		String lower = value.toLowerCase()

		if (value ==~ /\d{8}_\d{6}/ || value ==~ /\d{14}/ || value ==~ /^\d+\.\s*.*/) {
			return false
		}

		List<String> ignoredExactValues = [
			'reports',
			'evidences',
			'exports',
			'test cases',
			'test suites',
			'connection',
			'authentication',
			'login rec',
			'login prd',
			'katalon',
			'temp'
		]

		if (ignoredExactValues.contains(lower)) {
			return false
		}

		List<String> ignoredContainsValues = [
			'export',
			'validation',
			'validations',
			'validate',
			'compare',
			'close application',
			'open module',
			'login'
		]

		for (String ignored : ignoredContainsValues) {
			if (lower.contains(ignored)) {
				return false
			}
		}

		return true
	}

	private File findLatestExportFile(File folder, String environment, String sanitizedFeatureName) {
		if (folder == null || !folder.exists() || !folder.isDirectory()) {
			return null
		}

		File[] files = folder.listFiles()

		if (files == null) {
			return null
		}

		String expectedPrefix = normalizeText(environment) + '_'
		List<File> candidates = []

		for (File file : files) {
			if (!file.isFile() || file.length() <= 0) {
				continue
			}

			String fileName = file.getName()

			if (!fileName.toLowerCase().endsWith('.xlsx') || fileName.startsWith('~$')) {
				continue
			}

			if (!normalizeText(fileName).startsWith(expectedPrefix)) {
				continue
			}

			candidates.add(file)
		}

		if (candidates.isEmpty()) {
			return null
		}

		File selectedFile = candidates.sort { File file -> file.lastModified() }.last()

		KeywordUtil.logInfo(
				environment + ' files found in current suite feature folder: ' + candidates.size() + '\n' +
				'Selected file: ' + selectedFile.getAbsolutePath()
				)

		return selectedFile
	}

	private void compareExcelFiles(File recFile, File prdFile, int threshold, Map result) {
		Workbook recWorkbook = null
		Workbook prdWorkbook = null

		try {
			recWorkbook = WorkbookFactory.create(recFile)
			prdWorkbook = WorkbookFactory.create(prdFile)

			FormulaEvaluator recEvaluator = recWorkbook.getCreationHelper().createFormulaEvaluator()
			FormulaEvaluator prdEvaluator = prdWorkbook.getCreationHelper().createFormulaEvaluator()
			DataFormatter formatter = new DataFormatter()

			Sheet recSheet = recWorkbook.getSheetAt(0)
			Sheet prdSheet = prdWorkbook.getSheetAt(0)

			SheetData recData = readSheetData(recSheet, recEvaluator, formatter)
			SheetData prdData = readSheetData(prdSheet, prdEvaluator, formatter)

			compareNumberOfHeaders(recData, prdData, result)
			compareHeadersStructure(recData, prdData, result)
			compareNumberOfRows(recData, prdData, result)

			compareColumnBetweenFiles('Year', ['year', 'annee', 'année'], recData, prdData, threshold, result)
			compareColumnBetweenFiles('Nombre', ['nombre'], recData, prdData, threshold, result)
			compareColumnBetweenFiles('Solde Transac CCY', [
				'solde transac ccy',
				'solde transac',
				'transac ccy'
			], recData, prdData, threshold, result)
			compareColumnBetweenFiles('Solde Base CCY', ['solde base ccy', 'base ccy'], recData, prdData, threshold, result)
			compareColumnBetweenFiles('Solde Solde Fixing Base CCY', [
				'solde solde fixing base ccy',
				'solde fixing base ccy',
				'fixing base ccy'
			], recData, prdData, threshold, result)
		} catch (Exception e) {
			String message = 'Error while comparing REC and PRD exported files: ' + e.getMessage()
			addValidation(result, 'Open and read REC/PRD Excel files', false, message)
			result.errors.add(message)
		} finally {
			try {
				if (recWorkbook != null) {
					recWorkbook.close()
				}
			} catch (Exception ignored) {
			}

			try {
				if (prdWorkbook != null) {
					prdWorkbook.close()
				}
			} catch (Exception ignored) {
			}
		}
	}

	private void compareNumberOfHeaders(SheetData recData, SheetData prdData, Map result) {
		boolean passed = recData.headers.size() == prdData.headers.size()
		String details = 'REC headers: ' + recData.headers.size() + '\nPRD headers: ' + prdData.headers.size()
		addValidation(result, 'Compare Number of Table headers', passed, details)

		if (!passed) {
			result.errors.add('Compare Number of Table headers failed. ' + details.replace('\n', ' | '))
		}
	}

	private void compareHeadersStructure(SheetData recData, SheetData prdData, Map result) {
		int maxHeaders = Math.max(recData.headers.size(), prdData.headers.size())
		List<String> mismatches = []

		for (int i = 0; i < maxHeaders; i++) {
			String recHeader = i < recData.headers.size() ? recData.headers[i] : ''
			String prdHeader = i < prdData.headers.size() ? prdData.headers[i] : ''

			if (normalizeText(recHeader) != normalizeText(prdHeader)) {
				mismatches.add('Column ' + (i + 1) + ': REC "' + recHeader + '" | PRD "' + prdHeader + '"')
			}
		}

		boolean passed = mismatches.isEmpty()
		String details = passed ?
				'All REC headers match PRD headers in the same order.' :
				'Mismatched headers: ' + mismatches.size() + '\n' + mismatches.join('\n')

		addValidation(result, 'Compare table headers structure', passed, details)

		if (!passed) {
			result.errors.add('Table headers structure mismatch.\n' + mismatches.join('\n'))
		}
	}

	private void compareNumberOfRows(SheetData recData, SheetData prdData, Map result) {
		boolean passed = recData.rows.size() == prdData.rows.size()
		String details = 'REC rows: ' + recData.rows.size() + '\nPRD rows: ' + prdData.rows.size()
		addValidation(result, 'Compare number of rows', passed, details)

		if (!passed) {
			result.errors.add('Compare number of rows failed. ' + details.replace('\n', ' | '))
		}
	}

	private void compareColumnBetweenFiles(
			String displayName,
			List<String> aliases,
			SheetData recData,
			SheetData prdData,
			int threshold,
			Map result
	) {
		Integer recColumnIndex = findColumnIndex(recData.headers, aliases)
		Integer prdColumnIndex = findColumnIndex(prdData.headers, aliases)

		if (recColumnIndex == null) {
			String message = displayName + ' column was not found in REC file.'
			addValidation(result, displayName + ' column comparison', false, message)
			result.errors.add(message)
			return
		}

		if (prdColumnIndex == null) {
			String message = displayName + ' column was not found in PRD file.'
			addValidation(result, displayName + ' column comparison', false, message)
			result.errors.add(message)
			return
		}

		int maxRows = Math.max(recData.rows.size(), prdData.rows.size())
		int mismatches = 0
		List<String> examples = []

		for (int rowIndex = 0; rowIndex < maxRows; rowIndex++) {
			String recValue = getCellValue(recData.rows, rowIndex, recColumnIndex)
			String prdValue = getCellValue(prdData.rows, rowIndex, prdColumnIndex)

			if (valuesAreEquivalent(recValue, prdValue, threshold)) {
				continue
			}

			mismatches++
			String diff = displayName + ' | Row ' + (rowIndex + 1) +
					' | REC: "' + recValue + '" | PRD: "' + prdValue + '" | Allowed difference: ' + threshold

			if (examples.size() < MAX_MISMATCHES_PER_COLUMN) {
				examples.add(diff)
				result.differences.add(diff)
			}
		}

		boolean passed = mismatches == 0
		String details =
				'REC column: ' + (recColumnIndex + 1) + '\n' +
				'PRD column: ' + (prdColumnIndex + 1) + '\n' +
				'Rows compared: ' + maxRows + '\n' +
				'Allowed numeric difference: ' + threshold + '\n' +
				'Differences found: ' + mismatches

		if (!passed && !examples.isEmpty()) {
			details += '\n\nFirst differences:\n' + examples.join('\n')
		}

		addValidation(result, displayName + ' column comparison', passed, details)

		if (!passed) {
			result.errors.add(displayName + ' column comparison failed. Differences found: ' + mismatches)
			result.errors.addAll(examples)
		}
	}

	private void addValidation(Map result, String name, boolean passed, String details) {
		result.validations.add([name: name, status: passed ? 'PASS' : 'FAILED', details: details])
	}

	private void refreshResultCounters(Map result) {
		List<Map> validations = result.validations as List<Map>
		result.totalValidations = validations.size()
		result.passedValidations = validations.findAll { Map validation -> validation.status == 'PASS' }.size()
		result.failedValidations = validations.findAll { Map validation -> validation.status == 'FAILED' }.size()
	}

	private boolean valuesAreEquivalent(String recValue, String prdValue, int threshold) {
		String rec = recValue == null ? '' : recValue.trim()
		String prd = prdValue == null ? '' : prdValue.trim()

		if (rec.isEmpty() && prd.isEmpty()) {
			return true
		}

		BigDecimal recNumber = parseNumber(rec)
		BigDecimal prdNumber = parseNumber(prd)

		if (recNumber != null && prdNumber != null) {
			BigDecimal difference = recNumber.subtract(prdNumber).abs()
			return difference.compareTo(new BigDecimal(threshold)) <= 0
		}

		return normalizeText(rec) == normalizeText(prd)
	}

	private BigDecimal parseNumber(String value) {
		if (value == null || value.trim().isEmpty()) {
			return null
		}

		String normalized = value.replaceAll('\\s', '').replace(',', '.').replaceAll('[^0-9.\\-]', '')

		if (normalized.isEmpty() || normalized == '-' || normalized == '.') {
			return null
		}

		try {
			return new BigDecimal(normalized)
		} catch (Exception ignored) {
			return null
		}
	}

	private SheetData readSheetData(Sheet sheet, FormulaEvaluator evaluator, DataFormatter formatter) {
		int headerRowIndex = findHeaderRowIndex(sheet, evaluator, formatter)
		Row headerRow = sheet.getRow(headerRowIndex)
		List<String> headers = readRowValues(headerRow, evaluator, formatter)
		List<List<String>> rows = []

		for (int rowIndex = headerRowIndex + 1; rowIndex <= sheet.getLastRowNum(); rowIndex++) {
			Row row = sheet.getRow(rowIndex)

			if (row == null) {
				continue
			}

			List<String> values = readRowValues(row, evaluator, formatter)

			if (!isEmptyRow(values)) {
				rows.add(values)
			}
		}

		return new SheetData(headers, rows)
	}

	private int findHeaderRowIndex(Sheet sheet, FormulaEvaluator evaluator, DataFormatter formatter) {
		int bestRowIndex = 0
		int bestFilledCells = 0
		int maxSearchRow = Math.min(sheet.getLastRowNum(), 30)

		for (int rowIndex = 0; rowIndex <= maxSearchRow; rowIndex++) {
			Row row = sheet.getRow(rowIndex)

			if (row == null) {
				continue
			}

			List<String> values = readRowValues(row, evaluator, formatter)
			int filledCells = values.findAll { String value -> value != null && !value.trim().isEmpty() }.size()

			if (filledCells > bestFilledCells) {
				bestFilledCells = filledCells
				bestRowIndex = rowIndex
			}
		}

		return bestRowIndex
	}

	private List<String> readRowValues(Row row, FormulaEvaluator evaluator, DataFormatter formatter) {
		List<String> values = []

		if (row == null || row.getLastCellNum() < 0) {
			return values
		}

		for (int cellIndex = 0; cellIndex < row.getLastCellNum(); cellIndex++) {
			values.add(readCellValue(row.getCell(cellIndex), evaluator, formatter))
		}

		return values
	}

	private String readCellValue(Cell cell, FormulaEvaluator evaluator, DataFormatter formatter) {
		if (cell == null) {
			return ''
		}

		try {
			if (cell.getCellType() == CellType.FORMULA) {
				return formatter.formatCellValue(cell, evaluator).trim()
			}

			return formatter.formatCellValue(cell).trim()
		} catch (Exception ignored) {
			return ''
		}
	}

	private boolean isEmptyRow(List<String> values) {
		return values == null || values.isEmpty() || values.every { String value -> value == null || value.trim().isEmpty() }
	}

	private String getCellValue(List<List<String>> rows, int rowIndex, int columnIndex) {
		if (rowIndex >= rows.size() || columnIndex >= rows[rowIndex].size()) {
			return ''
		}

		return rows[rowIndex][columnIndex]
	}

	private Integer findColumnIndex(List<String> headers, List<String> aliases) {
		for (int i = 0; i < headers.size(); i++) {
			String normalizedHeader = normalizeText(headers[i])

			for (String alias : aliases) {
				String normalizedAlias = normalizeText(alias)

				if (normalizedHeader == normalizedAlias || normalizedHeader.contains(normalizedAlias)) {
					return i
				}
			}
		}

		return null
	}

	private String normalizeText(String text) {
		if (text == null) {
			return ''
		}

		return Normalizer.normalize(text, Normalizer.Form.NFD)
				.replaceAll('\\p{InCombiningDiacriticalMarks}+', '')
				.toLowerCase()
				.trim()
				.replaceAll('[^a-z0-9]+', '_')
				.replaceAll('_+', '_')
				.replaceAll('^_|_$', '')
	}

	private String sanitizeFileName(String text) {
		if (text == null || text.trim().isEmpty()) {
			return 'Export'
		}

		String normalized = Normalizer.normalize(text, Normalizer.Form.NFD)
				.replaceAll('\\p{InCombiningDiacriticalMarks}+', '')

		String cleaned = normalized
				.replaceAll('[\\\\/:*?"<>|]', '_')
				.replaceAll('\\s+', '_')
				.replaceAll('_+', '_')
				.replaceAll('^_|_$', '')
				.trim()

		return cleaned.isEmpty() ? 'Export' : cleaned
	}

	private String shortenFilePart(String value, Integer maximumLength) {
		if (value == null || value.trim().isEmpty()) {
			return ''
		}

		int safeMaximum = maximumLength == null || maximumLength <= 0 ? 20 : maximumLength
		String cleanValue = sanitizeFileName(value)
		return cleanValue.length() <= safeMaximum ? cleanValue : cleanValue.substring(0, safeMaximum)
	}

	private static class SheetData {
		List<String> headers
		List<List<String>> rows

		SheetData(List<String> headers, List<List<String>> rows) {
			this.headers = headers
			this.rows = rows
		}
	}
}
















