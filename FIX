em-link id=\"raven-plan-create-te-link\"\n\t\t\t\t\t\t\t\t\t\t   title=\"All tests\">\n\t\t\t\t\t\t\t\tAll tests\n\t\t\t\t\t\t\t</aui-item-link>\n\t\t\t\t\t\t\t<aui-item-link id=\"raven-plan-create-te-status-link\"\n\t\t\t\t\t\t\t\t\t\t   title=\"With status\">\n\t\t\t\t\t\t\t\tWith status\n\t\t\t\t\t\t\t</aui-item-link>\n\t\t\t\t\t\t</aui-dropdown-menu>\n\t\t\t\t\t\t<!--Trigger Build button-->\n\t\t\t\t\t\t<div id=\"raven-testplan-trigger-build\" class=\"aui-buttons\">\n\t\t\t\t\t\t\t<a id=\"raven-add-trigger-build\"\n\t\t\t\t\t\t\t\ttitle=\"Trigger -Build\"\n\t\t\t\t\t\t\t   class=\"aui-dropdown2-trigger aui-style-default aui-button\"\n\t\t\t\t\t\t\t   aria-owns=\"raven-testplan-trigger-build-dropdown\"\n\t\t\t\t\t\t\t   aria-haspopup=\"true\"\n\t\t\t\t\t\t\t   aria-disabled=true\n\t\t\t\t\t\t\t   href=\"#raven-testplan-trigger-build-dropdown\">\n\t\t\t\t\t\t\t\t<span>Trigger Build</span>\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<aui-dropdown-menu id=\"raven-testplan-trigger-build-dropdown\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t</aui-dropdown-menu>\n\t\t\t\t\t\t<!-- Create archived Tests icon and inline message -->\n\t\t\t\t\t\t<a id=\"raven-archived-testplan-tests-warning\" data-aui-trigger\n\t\t\t\t\t\t   aria-controls=\"raven-archived-testplan-tests-inline-dialog-message\"\n\t\t\t\t\t\t   class=\"aui-button aui-button-subtle\" style=\"margin-top:5px; display: none\" disabled>\n\t\t\t\t\t\t\t\t<span class=\"aui-icon aui-icon-small aui-iconfont-warning\" style=\"color:#ffab00;\">\n\t\t\t\t\t\t\t\t\tThere are archived Tests not being displayed in this section\n\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t\t<aui-inline-dialog id=\"raven-archived-testplan-tests-inline-dialog-message\" responds-to=\"hover\">\n\t\t\t\t\t\t\t<p>There are archived Tests not being displayed in this section</p>\n\t\t\t\t\t\t</aui-inline-dialog>\n\t\t\t\t\t\t\t\t\t\t<section id=\"trigger-build-dialog-success-testplan\" class=\"aui-dialog2 aui-dialog2-small  aui-layer\" role=\"dialog\" aria-hidden=\"true\">\n\t\t\t\t\t\t<header class=\"aui-dialog2-header\">\n\t\t\t\t\t\t\t<h2 class=\"aui-dialog2-header-main\">Remote job configuration trigger</h2>\n\t\t\t\t\t\t</header>\n\t\t\t\t\t\t<div class=\"aui-dialog2-content\">\n\t\t\t\t\t\t\t<p>The remote job configuration was triggered with success.</p>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<footer class=\"aui-dialog2-footer\">\n\t\t\t\t\t\t\t<div class=\"aui-dialog2-footer-actions\">\n\t\t\t\t\t\t\t\t  <button id = \"trigger-build-okay-button-testplan\" class=\"aui-button aui-button-primary\">Ok</button>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</footer>\n\t\t\t\t\t\t</section>\n\t\t\t\t\t\t<section id=\"trigger-build-dialog-fail-testplan\" class=\"aui-dialog2 aui-dialog2-small  aui-layer\" role=\"dialog\" aria-hidden=\"true\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t <header class=\"aui-dialog2-header\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t <h2 class=\"aui-dialog2-header-main\">Remote job configuration trigger</h2>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t </header>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t <div class=\"aui-dialog2-content\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t <p>The remote job configuration was triggered with failure.</p>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t </div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t <footer class=\"aui-dialog2-footer\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t <div class=\"aui-dialog2-footer-actions\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   <button id = \"trigger-build-okay-button-fail-testplan\" class=\"aui-button aui-button-primary\">Ok</button>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t </div>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t </footer>\n\t\t\t\t\t\t </section>\n\t\t\t\t\t\t<section id=\"trigger-build-ssl-fail-testplan\" class=\"aui-dialog2 aui-dialog2-small  aui-layer\" role=\"dialog\" aria-hidden=\"true\">\n\t\t\t\t\t\t\t<header class=\"aui-dialog2-header\">\n\t\t\t\t\t\t\t\t<h2 class=\"aui-dialog2-header-main\">Remote job configuration trigger</h2>\n\t\t\t\t\t\t\t</header>\n\t\t\t\t\t\t\t<div class=\"aui-dialog2-content\">\n\t\t\t\t\t\t\t\t<p>Invalid SSL certificate</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<footer class=\"aui-dialog2-footer\">\n\t\t\t\t\t\t\t\t<div class=\"aui-dialog2-footer-actions\">\n\t\t\t\t\t\t\t\t\t<button id = \"trigger-build-okay-button-ssl-fail-testplan\" class=\"aui-button aui-button-primary\">Ok</button>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</footer>\n\t\t\t\t\t\t</section>\n\t\t\t\t\t\t<section id=\"trigger-build-auth-fail-testplan\" class=\"aui-dialog2 aui-dialog2-small  aui-layer\" role=\"dialog\" aria-hidden=\"true\">\n\t\t\t\t\t\t\t<header class=\"aui-dialog2-header\">\n\t\t\t\t\t\t\t\t<h2 class=\"aui-dialog2-header-main\">Remote job configuration trigger</h2>\n\t\t\t\t\t\t\t</header>\n\t\t\t\t\t\t\t<div class=\"aui-dialog2-content\">\n\t\t\t\t\t\t\t\t<p>Authentication Failed</p>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<footer class=\"aui-dialog2-footer\">\n\t\t\t\t\t\t\t\t<div class=\"aui-dialog2-footer-actions\">\n\t\t\t\t\t\t\t\t\t<button id = \"trigger-build-okay-button-auth-fail-testplan\" class=\"aui-button aui-button-primary\">Ok</button>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</footer>\n\t\t\t\t\t\t</section>\n\t\t\t\t\t\t\t\t<div id=\"raven-test-dataset-dialog\"></div>\n\t\t\t</div>\n\t\t\t<div class=\"aui-toolbar2-secondary\" style=\"display: flex; align-items: center;\">\n\t\t\t\t<!-- Test Plan Filter -->\n\t\t\t\t\t\t\t\t<!--Test Plan Board button-->\n\t\t\t\t\t\t\t\t\t<div id=\"raven-tesplan-repository\" class=\"aui-buttons raven-test-plan-button-set\">\n\t\t\t\t\t\t<a id=\"testplan-repository\"\n\t\t\t\t\t\t   class=\"aui-button aui-button-link raven-test-plan-board-button\"\n\t\t\t\t\t\t   title=\"Test Plan Board\"\n\t\t\t\t\t\t   href=\"/secure/XrayTestPlanRepositoryAction!default.jspa?entityKey=GI5PRD-9883\">\n\t\t\t\t\t\t\t<span class=\"raven-test-plan-board-button-name\">Test Plan Board</span>\n\t\t\t\t\t\t</a>\n\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t</div>\n\t</div>\n\t<div id=\"plan-tests-section\" style=\"display:none;\">\n\t\t\t\t\t<div id=\"plan-tests-progressbar\">\n\t\t\t\t\t\t\t\t\t<h5>Overall Execution Status</h5><ul class=\"testplan-progress-bar\"></ul><div class=\"testplan-status-info\"></div><h6>Total Tests: 0</h6>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div id=\"testplan-tests-filter\" class=\"testplan-tests-filter module toggle-wrap expanded\" style=\"display: none;\">\n\t\t\t</div>\n\t\t\t<div id=\"raven-plan-filter-message-bar\"></div>\n\t\t\t<div id=\"testplan-tests-table-wrapper\" style=\"display: none;\">\n\t\t\t</div>\n\t\t\t</div>\n</div>\n\n<script>\nvar dropdown2 = document.getElementById('raven-testplan-trigger-build-dropdown');\n\nif(dropdown2!=null){\n    dropdown2.addEventListener('click', function (e) {\n        var targetTextContext = e.target.textContent;\n\n        targetTextContext = targetTextContext.replace(/(\\r\\n|\\n|\\r|\\t)/gm,\"\");\n\n        axios.post(`${AJS.contextPath()}/rest/raven/1.0/remotejobstrigger/triggerBuild`, {\n                       projectKey: `GI5PRD`,\n                       selectedConfig: targetTextContext,\n                       testplanIssueKey: `GI5PRD-9883`,\n                       customFieldValuesMap: \"{}\",\n                       testsKey: `[]`,\n                       username: `cavalherer`\n                        }\n                        ).then((response) => {\n                            if (response.data.responseCode <= 300 && response.data.responseCode >= 200) {\n                                AJS.dialog2(\"#trigger-build-dialog-success-testplan\").show();\n                            }\n                            else if (response.data.responseCode == 501) {\n                                AJS.dialog2('#trigger-build-ssl-fail-testplan').show();\n                            }\n                            else if (response.data.responseCode == 401) {\n                                AJS.dialog2('#trigger-build-auth-fail-testplan').show();\n                            }\n                            else {\n                                AJS.dialog2(\"#trigger-build-dialog-fail-testplan\").show();\n                            }\n\n\n                        }\n                        ).catch((error)=>{\n                            AJS.dialog2(\"#trigger-build-dialog-fail-testplan\").show();\n                        });\n        });\n\nAJS.$(\"#trigger-build-okay-button-testplan\").click(function(e){\n    AJS.dialog2(\"#trigger-build-dialog-success-testplan\").hide();\n});\n\nAJS.$(\"#trigger-build-okay-button-fail-testplan\").click(function(e){\n    AJS.dialog2(\"#trigger-build-dialog-fail-testplan\").hide();\n});\n\nAJS.$(\"#trigger-build-okay-button-ssl-fail-testplan\").click(function(e){\n     AJS.dialog2(\"#trigger-build-ssl-fail-testplan\").hide();\n});\n\nAJS.$(\"#trigger-build-okay-button-auth-fail-testplan\").click(function(e){\n     AJS.dialog2(\"#trigger-build-auth-fail-testplan\").hide();\n});\n\n}\n</script>\n\n",
