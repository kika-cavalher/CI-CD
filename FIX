    @Keyword
    boolean waitForMainScreen() {
        String refreshIconPath = getRefreshIconPath()

        for (int i = 1; i <= WAIT_MAIN_SCREEN_SECONDS; i++) {
            try {
                if (!loginDialogExists()) {
                    bringWindowToFront(attachedWindowTitle)
                    try {
                        WindowsImageKeywords.clickImage(refreshIconPath)
                        KeywordUtil.logInfo("Main screen confirmed by image at attempt ${i}")
                    } catch (Throwable ignored) {
                    }
                    return true
                }
            } catch (Throwable ignored) {
            }

            Windows.delay(1)
        }

        return false
    }

