package reporting

import com.aventstack.extentreports.ExtentReports
import com.aventstack.extentreports.ExtentTest

/**
 * Shared Extent context accessible from Listeners (no package) and Keywords (packaged).
 * The listener sets these; keywords read them.
 */

class ExtentContext {
	static ExtentReports extent
	static ExtentTest test

	// Collapsible step group node (for Log.step)
	static ExtentTest currentStepGroup

	// Failure tracking
	static boolean failed = false
	static String failMessage = null
	static String failAt = null
}

 package reporting

import org.openqa.selenium.OutputType
import org.openqa.selenium.TakesScreenshot

import com.aventstack.extentreports.MediaEntityBuilder
import com.kms.katalon.core.context.TestCaseContext
import com.kms.katalon.core.webui.driver.DriverFactory


public class ReportHelpers {

	/**
	 * Takes a screenshot and attaches it to the current Extent test
	 * by embedding it as a Base64 string.
	 *
	 * The resulting HTML report is fully self-contained and does not
	 * require any external image files.
	 */
	static void attachFailureScreenshot(TestCaseContext ctx) {
		if (ExtentContext.test == null) return

			try {
				// 1. Get the current WebDriver instance from Katalon.
				def driver = DriverFactory.getWebDriver()

				// 2. Use the underlying Selenium 'TakesScreenshot' interface to get Base64 data.
				String base64Image = ((TakesScreenshot) driver).getScreenshotAs(OutputType.BASE64)

				// 3. Attach the Base64 string to the Extent report.
				ExtentContext.test.fail(
						"📷 Screenshot on failure",
						MediaEntityBuilder
						.createScreenCaptureFromBase64String(base64Image)
						.build()
						)
			} catch (Exception e) {
				// Fallback if screenshot fails for any reason
				ExtentContext.test.warning("⚠ Could not capture screenshot: " + e.message)
			}
	}
}


