def startGaiaProcesses(script) {
    script.echo '============================================================'
    script.echo '🚀 STARTING GAIA BACKEND AND FRONTEND'
    script.echo '🪟 BACK and FRONT CMD windows will stay open during the whole pipeline'
    script.echo "⏳ Waiting up to ${script.params.STARTUP_WAIT_SECONDS}s for ports ${script.env.BACK_PORT} and ${script.env.FRONT_PORT}"
    script.echo '============================================================'

    def exitCode = script.withEnv([
        "BACK_BAT=${script.env.BACK_BAT}",
        "FRONT_BAT=${script.env.FRONT_BAT}",
        "BACK_PORT=${script.env.BACK_PORT}",
        "FRONT_PORT=${script.env.FRONT_PORT}",
        "BACK_CMD_TITLE=${script.env.BACK_CMD_TITLE}",
        "FRONT_CMD_TITLE=${script.env.FRONT_CMD_TITLE}",
        "STARTUP_WAIT_SECONDS=${script.params.STARTUP_WAIT_SECONDS}"
    ]) {
        script.powershell(
            returnStatus: true,
            script: '''
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

function Stop-CmdTreeByTitle {
    param([string]$Title)
    cmd /c "taskkill /FI ""WINDOWTITLE eq $Title"" /T /F" | Out-Null 2>&1
}

function Test-PortListening {
    param([int]$Port)

    try {
        $conn = Get-NetTCPConnection -LocalPort $Port -State Listen -ErrorAction SilentlyContinue
        return $null -ne $conn
    }
    catch {
        return $false
    }
}

Stop-CmdTreeByTitle -Title $env:BACK_CMD_TITLE
Stop-CmdTreeByTitle -Title $env:FRONT_CMD_TITLE
Start-Sleep -Seconds 1

Start-Process -FilePath 'cmd.exe' -ArgumentList "/k title $env:BACK_CMD_TITLE && call `"$env:BACK_BAT`"" -WindowStyle Normal
Start-Process -FilePath 'cmd.exe' -ArgumentList "/k title $env:FRONT_CMD_TITLE && call `"$env:FRONT_BAT`"" -WindowStyle Normal

$timeoutAt = (Get-Date).AddSeconds([int]$env:STARTUP_WAIT_SECONDS)
$backReady = $false
$frontReady = $false

while ((Get-Date) -lt $timeoutAt) {
    $backReady = Test-PortListening -Port ([int]$env:BACK_PORT)
    $frontReady = Test-PortListening -Port ([int]$env:FRONT_PORT)

    if ($backReady -and $frontReady) {
        Write-Host '[OK] Backend and frontend are ready'
        exit 0
    }

    Start-Sleep -Seconds 3
}

Write-Host '[ERROR] Gaia services did not become ready in time'
Write-Host ('[INFO] Backend ready: ' + $backReady)
Write-Host ('[INFO] Frontend ready: ' + $frontReady)
exit 1
'''
        )
    }

    if (exitCode != 0) {
        script.error('Gaia backend/frontend did not start correctly')
    }

    script.echo '✅ Gaia backend/frontend started'
}

