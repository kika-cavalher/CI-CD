package jiraIntegration

import java.io.File
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale

import groovy.json.JsonSlurper
import groovy.util.Node
import groovy.util.XmlParser

class JiraGaiaReportBuilder {

    JiraFlowCoordinator flow

    JiraGaiaReportBuilder(JiraFlowCoordinator flow) {
        this.flow = flow
    }

    private String safeValue(def value) {
        return value == null ? '' : String.valueOf(value).trim()
    }

    private boolean isBlank(def value) {
        return safeValue(value).isEmpty()
    }

    private long toMillis(def secondsValue) {
        String raw = safeValue(secondsValue).replace(',', '.')
        if (raw.isEmpty()) {
            return 0L
        }

        try {
            BigDecimal seconds = new BigDecimal(raw)
            return seconds.multiply(new BigDecimal('1000')).longValue()
        } catch (Exception ignored) {
            return 0L
        }
    }

    private long nanosToMillis(def nanosValue) {
        if (nanosValue == null) {
            return 0L
        }

        try {
            return (long) Math.round((safeValue(nanosValue).toBigDecimal() / 1000000G) as double)
        } catch (Exception ignored) {
            return 0L
        }
    }

    private String oneLine(def value, int max = 105) {
        String text = safeValue(value).replaceAll(/[\\r\\n]+/, ' ').replaceAll(/\\s+/, ' ').trim()
        if (text.length() <= max) {
            return text
        }
        return text.substring(0, Math.max(0, max - 3)).trim() + '...'
    }

    private String firstLine(def value) {
        String text = safeValue(value)
        if (text.isEmpty()) {
            return ''
        }

        for (String line : text.readLines()) {
            String clean = safeValue(line)
            if (!clean.isEmpty()) {
                return clean
            }
        }

        return ''
    }

    private String formatHeaderDate(Date date) {
        if (date == null) {
            return ''
        }
        return new SimpleDateFormat('MMM d, yyyy h:mm:ss a', Locale.ENGLISH).format(date)
    }

    private String formatTime(Date date) {
        if (date == null) {
            return ''
        }
        return new SimpleDateFormat('hh:mm:ss a', Locale.ENGLISH).format(date)
    }

    private String formatDurationMillis(long millis) {
        long hours = millis / 3600000L
        long minutes = (millis % 3600000L) / 60000L
        long seconds = (millis % 60000L) / 1000L
        long ms = millis % 1000L

        if (hours > 0) {
            return "${hours}h ${minutes}m ${seconds}s ${ms}ms"
        }
        if (minutes > 0) {
            return "${minutes}m ${seconds}s ${ms}ms"
        }
        if (seconds > 0) {
            return "${seconds}s ${ms}ms"
        }
        return "${ms}ms"
    }

    private String normalizeStatus(String rawStatus) {
        String value = safeValue(rawStatus).toLowerCase()

        if (value in ['failed', 'fail', 'error', 'undefined', 'pending', 'ambiguous']) {
            return 'fail'
        }
        if (value in ['skipped', 'skip']) {
            return 'skip'
        }
        if (value in ['passed', 'pass']) {
            return 'pass'
        }
        return 'info'
    }

    private List<File> findFilesRecursively(File root, Closure<Boolean> matcher) {
        List<File> result = []

        if (root == null || !root.exists()) {
            return result
        }

        root.eachFileRecurse { File f ->
            if (f.isFile() && matcher.call(f)) {
                result << f
            }
        }

        return result
    }

    private File findBestCucumberJson(String reportFolder) {
        File baseDir = new File(reportFolder)
        if (!baseDir.exists()) {
            return null
        }

        List<File> candidates = findFilesRecursively(baseDir) { File f ->
            String lower = f.name.toLowerCase()
            return lower == 'cucumber.json' || lower == 'k-cucumber.json'
        }

        if (candidates.isEmpty()) {
            return null
        }

        candidates.sort { a, b -> b.lastModified() <=> a.lastModified() }
        return candidates[0]
    }

    private List<File> collectEvidenceImages(String reportFolder) {
        File baseDir = new File(reportFolder)
        if (!baseDir.exists()) {
            return []
        }

        List<File> images = findFilesRecursively(baseDir) { File f ->
            String path = f.absolutePath.toLowerCase().replace('\\', '/')
            boolean allowedExt = path.endsWith('.png') || path.endsWith('.jpg') || path.endsWith('.jpeg') || path.endsWith('.webp')
            boolean ignoredFolder = path.contains('/requests/') || path.contains('/cucumber_report/') || path.contains('/html/')
            return allowedExt && !ignoredFolder
        }

        images.sort { a, b -> a.name <=> b.name }
        return images
    }

    private String relativePath(File fromDir, File targetFile) {
        try {
            return fromDir.toPath().relativize(targetFile.toPath()).toString().replace('\\', '/')
        } catch (Exception ignored) {
            return targetFile.name
        }
    }

    private List<Map> parseXmlFallback(String xmlPath, Date suiteStart) {
        List<Map> scenarios = []

        if (isBlank(xmlPath)) {
            return scenarios
        }

        File xmlFile = new File(xmlPath)
        if (!xmlFile.exists()) {
            return scenarios
        }

        Node root
        try {
            root = new XmlParser().parse(xmlFile)
        } catch (Exception ignored) {
            return scenarios
        }

        List<Node> testcaseNodes = []
        String rootName = safeValue(root.name())

        if (rootName == 'testsuite') {
            testcaseNodes.addAll(root.children().findAll { it instanceof Node && safeValue(((Node) it).name()) == 'testcase' } as List<Node>)
        } else if (rootName == 'testsuites') {
            root.children().findAll { it instanceof Node && safeValue(((Node) it).name()) == 'testsuite' }.each { Node suite ->
                testcaseNodes.addAll(suite.children().findAll { it instanceof Node && safeValue(((Node) it).name()) == 'testcase' } as List<Node>)
            }
        }

        long cursor = suiteStart.time
        int index = 1

        testcaseNodes.each { Node tc ->
            String className = safeValue(tc.attribute('classname'))
            String testName = safeValue(tc.attribute('name'))
            long durationMs = toMillis(tc.attribute('time'))

            Node failureNode = (tc.children().find { it instanceof Node && safeValue(((Node) it).name()) == 'failure' } as Node)
            Node errorNode = (tc.children().find { it instanceof Node && safeValue(((Node) it).name()) == 'error' } as Node)
            Node skippedNode = (tc.children().find { it instanceof Node && safeValue(((Node) it).name()) == 'skipped' } as Node)

            String status = 'pass'
            if (failureNode != null || errorNode != null) {
                status = 'fail'
            } else if (skippedNode != null) {
                status = 'skip'
            }

            String details = ''
            String message = ''

            if (failureNode != null) {
                message = safeValue(failureNode.attribute('message'))
                details = safeValue(failureNode.text())
            } else if (errorNode != null) {
                message = safeValue(errorNode.attribute('message'))
                details = safeValue(errorNode.text())
            } else if (skippedNode != null) {
                message = safeValue(skippedNode.attribute('message'))
                details = safeValue(skippedNode.text())
            }

            String scenarioName = !isBlank(testName) ? testName : className
            String displayName = !isBlank(className) && !isBlank(testName) ? "${className}/${testName}" : scenarioName

            Date scenarioStart = new Date(cursor)
            Date scenarioEnd = new Date(cursor + durationMs)

            List<Map> steps = []
            steps << [
                status       : 'info',
                statusLabel  : 'Info',
                time         : formatTime(scenarioStart),
                detail       : 'Test execution started',
                fullDetail   : 'Test execution started'
            ]

            if (status == 'pass') {
                steps << [
                    status       : 'pass',
                    statusLabel  : 'Pass',
                    time         : formatTime(scenarioEnd),
                    detail       : 'Test passed',
                    fullDetail   : 'Test passed'
                ]
            } else if (status == 'skip') {
                steps << [
                    status       : 'skip',
                    statusLabel  : 'Skip',
                    time         : formatTime(scenarioEnd),
                    detail       : oneLine(message ?: 'Test skipped'),
                    fullDetail   : details ?: message ?: 'Test skipped'
                ]
            } else {
                steps << [
                    status       : 'fail',
                    statusLabel  : 'Fail',
                    time         : formatTime(scenarioEnd),
                    detail       : oneLine(firstLine(details ?: message ?: 'Test failed')),
                    fullDetail   : details ?: message ?: 'Test failed'
                ]
            }

            scenarios << [
                id            : "scenario-${index}",
                name          : displayName,
                listName      : oneLine(displayName, 58),
                summary       : oneLine(displayName, 96),
                status        : status,
                statusLabel   : status == 'pass' ? 'Passed' : (status == 'fail' ? 'Failed' : 'Skipped'),
                durationMs    : durationMs,
                durationText  : formatDurationMillis(durationMs),
                startAt       : formatHeaderDate(scenarioStart),
                endAt         : formatHeaderDate(scenarioEnd),
                startTime     : formatTime(scenarioStart),
                endTime       : formatTime(scenarioEnd),
                errorLine     : oneLine(firstLine(details ?: message), 140),
                fullError     : safeValue(details),
                steps         : steps,
                imagePath     : '',
                imageName     : ''
            ]

            cursor += durationMs
            index++
        }

        return scenarios
    }

    private List<Map> parseCucumberScenarios(String reportFolder, Date suiteStart) {
        List<Map> scenarios = []
        File cucumberFile = findBestCucumberJson(reportFolder)

        if (cucumberFile == null || !cucumberFile.exists()) {
            return scenarios
        }

        def parsed
        try {
            parsed = new JsonSlurper().parse(cucumberFile)
        } catch (Exception ignored) {
            return scenarios
        }

        if (!(parsed instanceof List)) {
            return scenarios
        }

        long suiteCursor = suiteStart.time
        int index = 1

        parsed.each { feature ->
            List elements = feature?.elements instanceof List ? feature.elements : []

            elements.each { scenario ->
                List rawSteps = scenario?.steps instanceof List ? scenario.steps : []
                if (rawSteps.isEmpty()) {
                    return
                }

                String scenarioName = safeValue(scenario?.name)
                String featureName = safeValue(feature?.name)
                String displayName = !isBlank(featureName) ? "${featureName} - ${scenarioName}" : scenarioName

                long durationMs = 0L
                String scenarioStatus = 'pass'
                String firstError = ''
                String fullError = ''
                List<Map> stepRows = []

                long scenarioCursor = suiteCursor

                rawSteps.each { step ->
                    String keyword = safeValue(step?.keyword)
                    String stepName = safeValue(step?.name)
                    String detailText = (keyword + stepName).trim()

                    String rawStatus = safeValue(step?.result?.status)
                    String normalizedStatus = normalizeStatus(rawStatus)
                    long stepMs = nanosToMillis(step?.result?.duration)
                    String errorMessage = safeValue(step?.result?.error_message)

                    if (normalizedStatus == 'fail') {
                        scenarioStatus = 'fail'
                        if (firstError.isEmpty()) {
                            firstError = firstLine(errorMessage)
                            fullError = errorMessage
                        }
                    } else if (normalizedStatus == 'skip' && scenarioStatus != 'fail') {
                        scenarioStatus = 'skip'
                    }

                    String stepShort = oneLine(detailText, 150)
                    if (normalizedStatus == 'fail' && !isBlank(errorMessage)) {
                        stepShort = oneLine("${detailText} | ${firstLine(errorMessage)}", 150)
                    }

                    stepRows << [
                        status      : normalizedStatus,
                        statusLabel : normalizedStatus == 'pass' ? 'Pass' : (normalizedStatus == 'fail' ? 'Fail' : (normalizedStatus == 'skip' ? 'Skip' : 'Info')),
                        time        : formatTime(new Date(scenarioCursor)),
                        detail      : stepShort,
                        fullDetail  : !isBlank(errorMessage) ? errorMessage : detailText
                    ]

                    durationMs += stepMs
                    scenarioCursor += stepMs
                }

                Date scenarioStart = new Date(suiteCursor)
                Date scenarioEnd = new Date(suiteCursor + durationMs)

                scenarios << [
                    id            : "scenario-${index}",
                    name          : displayName,
                    listName      : oneLine(scenarioName, 58),
                    summary       : oneLine(displayName, 96),
                    status        : scenarioStatus,
                    statusLabel   : scenarioStatus == 'pass' ? 'Passed' : (scenarioStatus == 'fail' ? 'Failed' : 'Skipped'),
                    durationMs    : durationMs,
                    durationText  : formatDurationMillis(durationMs),
                    startAt       : formatHeaderDate(scenarioStart),
                    endAt         : formatHeaderDate(scenarioEnd),
                    startTime     : formatTime(scenarioStart),
                    endTime       : formatTime(scenarioEnd),
                    errorLine     : oneLine(firstError, 140),
                    fullError     : safeValue(fullError),
                    steps         : stepRows,
                    imagePath     : '',
                    imageName     : ''
                ]

                suiteCursor += durationMs
                index++
            }
        }

        return scenarios
    }

    String createGaiaHtmlReport(String reportFolder, String suiteName, String xmlPath) {
        if (isBlank(reportFolder)) {
            return ''
        }

        File baseDir = new File(reportFolder)
        if (!baseDir.exists()) {
            return ''
        }

        Date suiteEnd = new Date(baseDir.lastModified())
        Date suiteStart = new Date(Math.max(0L, suiteEnd.time - 1000L))

        List<Map> scenarios = parseCucumberScenarios(reportFolder, suiteStart)
        if (scenarios.isEmpty()) {
            scenarios = parseXmlFallback(xmlPath, suiteStart)
        }

        long totalDurationMs = 0L
        scenarios.each { Map scenario ->
            totalDurationMs += (scenario.durationMs ?: 0L) as long
        }

        suiteStart = new Date(Math.max(0L, suiteEnd.time - totalDurationMs))

        long currentStart = suiteStart.time
        scenarios.each { Map scenario ->
            long durationMs = (scenario.durationMs ?: 0L) as long
            Date scenarioStart = new Date(currentStart)
            Date scenarioEnd = new Date(currentStart + durationMs)

            scenario.startAt = formatHeaderDate(scenarioStart)
            scenario.endAt = formatHeaderDate(scenarioEnd)
            scenario.startTime = formatTime(scenarioStart)
            scenario.endTime = formatTime(scenarioEnd)

            long stepCursor = scenarioStart.time
            List<Map> steps = scenario.steps instanceof List ? scenario.steps : []
            steps.each { Map step ->
                step.time = formatTime(new Date(stepCursor))
                stepCursor += 400L
            }

            currentStart += durationMs
        }

        List<File> images = collectEvidenceImages(reportFolder)
        List<Map> failedScenarios = scenarios.findAll { safeValue(it.status) == 'fail' }

        for (int i = 0; i < failedScenarios.size(); i++) {
            if (i < images.size()) {
                File img = images[i]
                failedScenarios[i].imagePath = relativePath(baseDir, img)
                failedScenarios[i].imageName = img.name
            }
        }

        int passed = scenarios.count { safeValue(it.status) == 'pass' }
        int failed = scenarios.count { safeValue(it.status) == 'fail' }
        int skipped = scenarios.count { safeValue(it.status) == 'skip' }

        List<Map> allImages = images.collect { File img ->
            [
                path : relativePath(baseDir, img),
                name : img.name
            ]
        }

        String logoUri = ''
        File projectLogo = new File(System.getProperty('user.dir'), 'Image/gaia-logo.png')
        if (projectLogo.exists()) {
            logoUri = projectLogo.toURI().toString()
        }

        Map model = [
            appName       : 'GAIA',
            subtitle      : 'GAIA execution overview',
            reportTitle   : "Test report - ${safeValue(suiteName)}",
            suiteName     : safeValue(suiteName),
            generatedAt   : formatHeaderDate(new Date()),
            startAt       : formatHeaderDate(suiteStart),
            endAt         : formatHeaderDate(suiteEnd),
            durationText  : formatDurationMillis(totalDurationMs),
            total         : scenarios.size(),
            passed        : passed,
            failed        : failed,
            skipped       : skipped,
            scenarios     : scenarios,
            evidences     : allImages,
            logoSrc       : logoUri
        ]

        String html = new JiraGaiaHtmlTemplateBuilder().buildHtml(model)

        File htmlFile = new File(baseDir, safeValue(flow?.GAIA_REPORT_FILE_NAME) ?: 'gaiaReport.html')
        htmlFile.setText(html, 'UTF-8')
        return htmlFile.absolutePath
    }
