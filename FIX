					'using image.\n' +
					'Image: secondGroupResultPrefix\n' +
					'Reason: ' + safeMessage(e)
					)

			return false
		}
	}


	private void validateSecondGroupByRowByElement(
			String expectedPrefix,
			Integer timeout,
			List<String> errors
	) {

		WindowsTestObject secondRowObject =
				object('secondGroupResultPrefix')

		boolean secondRowPresent =
				Windows.waitForElementPresent(
				secondRowObject,
				timeout,
				FailureHandling.OPTIONAL
				)

		if (!secondRowPresent) {
			errors.add(
					'Second Group By result row was not found.\n' +
					'Expected prefix: ' + expectedPrefix + '\n' +
					'Image: secondGroupResultPrefix\n' +
					'Object: secondGroupResultPrefix'
					)

			return
		}

		String actualText =
				readGroupByRowText(
				secondRowObject
				)

		String normalizedExpected =
				safeText(expectedPrefix)
				.replaceAll(/\s+/, ' ')
				.trim()

		String normalizedActual =
				safeText(actualText)
				.replaceAll(/\s+/, ' ')
				.trim()

		boolean startsWithExpectedPrefix =
				normalizedActual.length() >=
				normalizedExpected.length() &&
				normalizedActual.regionMatches(
				true,
				0,
				normalizedExpected,
				0,
				normalizedExpected.length()
				)

		if (!startsWithExpectedPrefix) {
			errors.add(
					'Unexpected text on the second Group By row.\n' +
					'Expected prefix: ' + normalizedExpected + '\n' +
					'Actual: ' + normalizedActual
					)

			return
		}

		KeywordUtil.logInfo(
				'[PASS] Line 2 starts with: ' +
				normalizedExpected
				)
	}


	private String readGroupByRowText(
			WindowsTestObject targetObject
	) {

		String value =
				safeText(
				Windows.getAttribute(
				targetObject,
				'Name',
				FailureHandling.OPTIONAL
				)
				)

		if (!value.isEmpty()) {
			return value
		}

		value =
				safeText(
				Windows.getAttribute(
				targetObject,
				'LegacyValue',
				FailureHandling.OPTIONAL
				)
				)

		return value
	}


	@Keyword
	void validateGroupByHierarchy(Integer timeoutSeconds) {

		Integer timeout = safeTimeout(timeoutSeconds, 5)
		List<String> errors = []

		logStep(
				'GROUP BY',
				'Validate Grappe and Ecart hierarchy'
				)

		dragAndDropImage(
				'grappeHeader',
				'emptyGroupSection',
				2
				)

		takeEvidence('GUI_GroupByGrappe.png')

		dragAndDropImage(
				'ecartBilanVSCompteResultatCCY',
				'filledGroupSection',
				2
				)

		takeEvidence('GUI_GroupByGrappeAndEcart.png')

		String firstLevelValue =
				readLegacyValue(
				'firstLevelGroupBy',
				timeout,
				errors
				)

		validateGroupLabel(
				firstLevelValue,
				'Grappe',
				true,
				errors
				)

		if (errors.isEmpty()) {
			Windows.doubleClick(
					object('firstLevelGroupBy'),
					FailureHandling.STOP_ON_FAILURE
					)
		}

		String secondLevelValue =
				readLegacyValue(
				'secondLevelGroupBy',
				timeout,
				errors
				)

		validateGroupLabel(
				secondLevelValue,
				'Ecart bilan vs. compte de résultat ccy',
				false,
				errors
				)

		if (errors.isEmpty()) {
			Windows.doubleClick(
					object('secondLevelGroupBy'),
					FailureHandling.STOP_ON_FAILURE
					)

			validatePresent(
					'detailsRow',
					'Group By detail row',
					timeout,
					errors
					)
		}

		takeEvidence('GUI_GroupByDetails.png')

		finishValidation(
				'Group By hierarchy validation',
				errors
				)
	}


	private String readLegacyValue(
			String objectKey,
			Integer timeout,
			List<String> errors
	) {

		WindowsTestObject targetObject =
				object(objectKey)

		if (!Windows.waitForElementPresent(
				targetObject,
				timeout,
				FailureHandling.OPTIONAL
				)) {
			errors.add(
					'Object was not found: ' +
					objectKey
					)

			return ''
		}

		String value =
				safeText(
				Windows.getAttribute(
				targetObject,
				'LegacyValue',
				FailureHandling.OPTIONAL
				)
				)

		if (value.isEmpty()) {
			errors.add(
					'LegacyValue is empty for: ' +
					objectKey
					)
		}

		return value
	}


	private void validateGroupLabel(
			String rawValue,
			String expectedLabel,
			boolean requirePositiveInteger,
			List<String> errors
	) {

		String normalizedValue =
				safeText(rawValue)
				.replaceAll(/\s+/, ' ')

		Integer separatorIndex =
				normalizedValue.lastIndexOf(':')

		if (separatorIndex <= 0) {
			errors.add(
					'Invalid Group By format.\n' +
					'Expected: ' + expectedLabel + ': NUMBER\n' +
					'Actual: ' + normalizedValue
					)

			return
		}

		String actualLabel =
				normalizedValue
				.substring(0, separatorIndex)
				.trim()

		String numericText =
				normalizedValue
				.substring(separatorIndex + 1)
				.trim()
				.replace(',', '.')

		if (!actualLabel.equalsIgnoreCase(expectedLabel)) {
			errors.add(
					'Unexpected Group By label.\n' +
					'Expected: ' + expectedLabel + '\n' +
					'Actual: ' + actualLabel
					)
		}

		try {
			BigDecimal numericValue =
					new BigDecimal(numericText)

			if (
			requirePositiveInteger &&
					numericValue <= BigDecimal.ZERO
					) {
				errors.add(
						expectedLabel +
						' value must be greater than zero.\n' +
						'Actual: ' + numericValue
						)
			}
		} catch (Exception ignored) {
			errors.add(
					expectedLabel +
					' numeric value is invalid.\n' +
					'Actual: ' + numericText
					)
		}
	}




