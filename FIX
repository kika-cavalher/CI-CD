	// Zip the reports created by Katalon
	def zipReports() {
		String path = getReportPath()
		String zippedFile = path + File.separator + 'Results.zip'

		def output = new ZipOutputStream(new FileOutputStream(zippedFile))
		KeywordUtil.logInfo("ZipOutputStream created for: " + zippedFile)

		new File(path).eachFile { file ->
			if (!file.isFile()) {
				return // Skip directories
			}

			if (!file.toString().equalsIgnoreCase(zippedFile)) {
				// Create ZIP entry for each file
				output.putNextEntry(new ZipEntry(file.name))
				KeywordUtil.logInfo("Adding file to ZIP: " + file.name)

				// Read the file and write its content to the ZIP output stream
				def zipInput = new FileInputStream(file)
				byte[] buffer = new byte[1024]
				int bytesRead
				while ((bytesRead = zipInput.read(buffer)) != -1) {
					output.write(buffer, 0, bytesRead)
				}

				// Close the current entry
				output.closeEntry()
				zipInput.close()
			}
		}
		output.close()

		KeywordUtil.logInfo("ZIP file created successfully: " + zippedFile)
		return zippedFile
	}

	// Zip Evidences taken during the execution
	def zipEvidences() {
		String path = getReportPath() + File.separator + 'Evidences'
		String zippedFile = path + File.separator + 'Evidences.zip'

		def output = new ZipOutputStream(new FileOutputStream(zippedFile))
		KeywordUtil.logInfo("ZipOutputStream created for: " + zippedFile)

		new File(path).eachFile { file ->
			if (!file.isFile()) {
				return // Skip directories
			}

			if (!file.toString().equalsIgnoreCase(zippedFile)) {
				try {
					// Create a ZIP entry for each file
					output.putNextEntry(new ZipEntry(file.name))
					KeywordUtil.logInfo("Adding file to ZIP: " + file.name)

					// Read the file and write its content to the ZIP output stream
					def zipInput = new FileInputStream(file)
					byte[] buffer = new byte[1024]
					int bytesRead
					while ((bytesRead = zipInput.read(buffer)) != -1) {
						output.write(buffer, 0, bytesRead)
					}

					// Close the current ZIP entry
					output.closeEntry()
					zipInput.close()
				} catch (IOException e) {
					KeywordUtil.logError("Error processing file: " + file.name + " - " + e.message)
				}
			}
		}
		output.close()

		KeywordUtil.logInfo("ZIP file created successfully: " + zippedFile)
		return zippedFile
	}

