import com.kms.katalon.core.annotation.AfterTestCase
import com.kms.katalon.core.annotation.BeforeTestCase
import com.kms.katalon.core.context.TestCaseContext
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.configuration.RunConfiguration

import java.nio.charset.StandardCharsets
import java.util.concurrent.ConcurrentHashMap
import java.util.regex.Pattern

class ematchReport {

    private static final Map<String, Long> CASE_START_MS = new ConcurrentHashMap<>()
    private static final ThreadLocal<Boolean> AFTER_CASE_RUNNING = ThreadLocal.withInitial({ false })

    private static final int MAX_LOG_FILES = 8
    private static final int MAX_LINES_PER_FILE = 12000
    private static final int MAX_STEPS_PER_CASE = 300

    private static final Pattern START_CASE_PATTERN = Pattern.compile('/START \\(Test Cases/(.+?)\\)')
    private static final Pattern END_CASE_PATTERN   = Pattern.compile('/END \\(Test Cases/(.+?)\\)')

    @BeforeTestCase
    def beforeCase(TestCaseContext testCaseContext) {
        try {
            String caseId = safe(testCaseContext?.getTestCaseId())
            CASE_START_MS.put(caseId, System.currentTimeMillis())
        } catch (Throwable t) {
            KeywordUtil.logInfo('Report listener beforeCase failed: ' + safe(t.message))
        }
    }

    @AfterTestCase
    def afterCase(TestCaseContext testCaseContext) {
        if (Boolean.TRUE == AFTER_CASE_RUNNING.get()) {
            return
        }

        AFTER_CASE_RUNNING.set(true)

        try {
            String caseId = safe(testCaseContext?.getTestCaseId())
            String rawStatus = safe(testCaseContext?.getTestCaseStatus())
            String reportStatus = normalizeStatus(rawStatus)

            long endMs = System.currentTimeMillis()
            long startMs = CASE_START_MS.containsKey(caseId) ? asLong(CASE_START_MS[caseId]) : endMs
            long durationMs = Math.max(0L, endMs - startMs)

            List<Map> steps = []
            try {
                steps = extractReportSteps(caseId)
            } catch (Throwable stepError) {
                KeywordUtil.logInfo('Step extraction skipped for case [' + caseId + ']: ' + safe(stepError.message))
                steps = []
            }

            steps.each { Map row ->
                try {
                    appendTrace(
                        'REPORT_STEP',
                        caseId,
                        formatTime(asLong(row.timeMs)),
                        safe(row.detail)
                    )
                } catch (Throwable ignored) {
                }
            }

            appendTrace('REPORT_CASE_END', caseId, formatTime(endMs))
            appendTrace('REPORT_STATUS', caseId, reportStatus)
            appendTrace('REPORT_DURATION', caseId, String.valueOf(durationMs))

            String failure = buildFailureSummary(safe(testCaseContext?.getMessage()))
            if (!failure.isEmpty()) {
                appendTrace('REPORT_FAILURE', caseId, failure)
            }

            if (reportStatus == 'FAILED') {
                try {
                    CustomKeywords.'jiraIntegration.JiraImagesEvidence.autoFailure'(caseId)
                } catch (Throwable ignored) {
                }
            }

            try {
                CustomKeywords.'jiraIntegration.JiraImagesEvidence.finishCase'()
            } catch (Throwable ignored) {
            }

        } catch (Throwable t) {
            KeywordUtil.logInfo('Report listener afterCase failed: ' + safe(t.message))
        } finally {
            try {
                String caseId = safe(testCaseContext?.getTestCaseId())
                CASE_START_MS.remove(caseId)
            } catch (Throwable ignored) {
            }
            AFTER_CASE_RUNNING.set(false)
        }
    }

    private List<Map> extractReportSteps(String caseId) {
        List<Map> result = []
        List<File> logFiles = collectExecutionLogs()

        if (logFiles == null || logFiles.isEmpty()) {
            return result
        }

        logFiles.each { File logFile ->
            if (result.size() >= MAX_STEPS_PER_CASE) {
                return
            }

            boolean insideCase = false
            int readCount = 0

            eachLineSafely(logFile) { String rawLine ->
                if (readCount >= MAX_LINES_PER_FILE || result.size() >= MAX_STEPS_PER_CASE) {
                    return
                }
                readCount++

                String line = safe(rawLine)
                if (line.isEmpty()) {
                    return
                }

                if (shouldIgnoreLogLine(line)) {
                    return
                }

                def startMatcher = START_CASE_PATTERN.matcher(line)
                if (startMatcher.find()) {
                    insideCase = safe(startMatcher.group(1)) == safe(caseId)
                    return
                }

                def endMatcher = END_CASE_PATTERN.matcher(line)
                if (endMatcher.find()) {
                    if (safe(endMatcher.group(1)) == safe(caseId)) {
                        insideCase = false
                    }
                    return
                }

                if (!insideCase) {
                    return
                }

                int markerIndex = line.indexOf('[REPORT_STEP]')
                if (markerIndex >= 0) {
                    String detail = safe(line.substring(markerIndex + '[REPORT_STEP]'.length()))
                    if (!detail.isEmpty()) {
                        long timeMs = parseExecutionLogMillis(line)
                        result << [
                            timeMs: timeMs,
                            detail: detail
                        ]
                    }
                    return
                }

                String inferredStep = inferStepFromExecutionLine(line)
                if (!inferredStep.isEmpty()) {
                    long timeMs = parseExecutionLogMillis(line)
                    result << [
                        timeMs: timeMs,
                        detail: inferredStep
                    ]
                }
            }
        }

        result = result
            .findAll { it != null && !safe(it.detail).isEmpty() }
            .unique { Map row -> String.valueOf(asLong(row.timeMs)) + '|' + safe(row.detail) }
            .sort { Map a, Map b -> asLong(a.timeMs) <=> asLong(b.timeMs) }

        return result.take(MAX_STEPS_PER_CASE)
    }

    private List<File> collectExecutionLogs() {
        File root = new File(RunConfiguration.getReportFolder())
        if (!root.exists()) {
            return []
        }

        List<File> files = []
        root.eachFileRecurse { File file ->
            if (file == null || !file.isFile()) {
                return
            }

            String name = safe(file.name).toLowerCase(Locale.ENGLISH)

            if (!(name.endsWith('.log') || name == 'execution0.log')) {
                return
            }

            if (name.contains('ktr') || name.contains('temp') || name.contains('debug')) {
                return
            }

            files << file
        }

        files = files
            .findAll { it.exists() && it.isFile() && it.length() > 0L }
            .sort { File a, File b -> b.lastModified() <=> a.lastModified() }
            .take(MAX_LOG_FILES)

        return files
    }

    private void eachLineSafely(File file, Closure consumer) {
        if (file == null || !file.exists() || !file.isFile()) {
            return
        }

        BufferedReader reader = null
        try {
            reader = new BufferedReader(new InputStreamReader(new FileInputStream(file), StandardCharsets.UTF_8))
            String line
            while ((line = reader.readLine()) != null) {
                consumer.call(line)
            }
        } catch (Throwable ignored) {
        } finally {
            try {
                reader?.close()
            } catch (Throwable ignored) {
            }
        }
    }

    private boolean shouldIgnoreLogLine(String line) {
        String lower = safe(line).toLowerCase(Locale.ENGLISH)

        return lower.contains('report listener aftercase failed')
            || lower.contains('collectexecutionlogs')
            || lower.contains('extractreportsteps')
            || lower.contains('buildfailuresummary')
            || lower.contains('return (value == null)')
            || lower.contains('java.lang.string.valueof(value).trim()')
            || lower.contains('root.eachfilerecurse')
            || lower.contains('files = files.unique')
            || lower.contains('files.sort')
            || lower.contains('logfiles.each')
            || lower.contains('safe(rawstatus)')
            || lower.contains('normalizestatus(rawstatus)')
            || lower.contains('jiraimagesevidence.finishcase')
            || lower.contains('jiraimagesevidence.autofailure')
    }

    private String inferStepFromExecutionLine(String line) {
        String cleaned = safe(line)

        if (cleaned.isEmpty()) {
            return ''
        }

        if (cleaned.contains('[REPORT_STEP]')) {
            return ''
        }

        String lower = cleaned.toLowerCase(Locale.ENGLISH)

        if (lower.contains('click(') || lower.contains('.click(')) {
            return cleaned
        }
        if (lower.contains('settext(') || lower.contains('sendkeys(') || lower.contains('setencryptedtext(')) {
            return cleaned
        }
        if (lower.contains('verify') || lower.contains('waitforelement') || lower.contains('findtestobject')) {
            return cleaned
        }
        if (lower.contains('navigate') || lower.contains('openbrowser') || lower.contains('closebrowser')) {
            return cleaned
        }
        if (lower.contains('windowsimagekeywords.clickimage')) {
            return cleaned
        }
        if (lower.contains('delay(') || lower.contains('comment(') || lower.contains('loginfo(')) {
            return cleaned
        }

        return ''
    }

    private long parseExecutionLogMillis(String line) {
        try {
            return System.currentTimeMillis()
        } catch (Throwable ignored) {
            return 0L
        }
    }

    private long asLong(def value) {
        try {
            return Long.parseLong(String.valueOf(value))
        } catch (Throwable ignored) {
            return 0L
        }
    }

    private String safe(def value) {
        return value == null ? '' : String.valueOf(value).trim()
    }

    private String normalizeStatus(String rawStatus) {
        String lower = safe(rawStatus).toUpperCase(Locale.ENGLISH)
        if (lower == 'PASSED' || lower == 'PASS' || lower == 'SUCCESS') {
            return 'PASSED'
        }
        if (lower == 'FAILED' || lower == 'FAIL' || lower == 'ERROR') {
            return 'FAILED'
        }
        if (lower == 'SKIPPED' || lower == 'SKIP') {
            return 'SKIPPED'
        }
        return lower.isEmpty() ? 'UNKNOWN' : lower
    }

    private String formatTime(long millis) {
        return String.valueOf(millis)
    }

    private String buildFailureSummary(String message) {
        return safe(message)
    }

    private void appendTrace(String type, String caseId, String value1) {
        try {
            KeywordUtil.logInfo('[' + safe(type) + '] ' + safe(caseId) + ' | ' + safe(value1))
        } catch (Throwable ignored) {
        }
    }

    private void appendTrace(String type, String caseId, String value1, String value2) {
        try {
            KeywordUtil.logInfo('[' + safe(type) + '] ' + safe(caseId) + ' | ' + safe(value1) + ' | ' + safe(value2))
        } catch (Throwable ignored) {
        }
    }
}
