	@Keyword
	boolean isGroupVisible(String groupName) {
		return isGroupVisible(groupName, 0)
	}

	@Keyword
	boolean isGroupVisible(String groupName, Integer timeoutSeconds) {
		Map<String, String> images = getImages(groupName)

		int safeTimeout = timeoutSeconds == null || timeoutSeconds < 0 ? 0 : timeoutSeconds
		int elapsedSeconds = 0

		while (true) {
			for (String imageKey : images.keySet()) {
				try {
					if (isVisible(groupName, imageKey)) {
						KeywordUtil.logInfo(
							'At least one image from group is visible.\n' +
							'Group: ' + groupName + '\n' +
							'Visible key: ' + imageKey
						)
						return true
					}
				} catch (Exception ignored) {
				}
			}

			if (elapsedSeconds >= safeTimeout) {
				return false
			}

			Windows.delay(1)
			elapsedSeconds++
		}
	}
