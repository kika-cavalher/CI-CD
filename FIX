	@Keyword
	String resolveWindowTitle() {
		String version = safe(resolveGlobalValue([
			'version',
			'VERSION'
		]))

		String versionProd = safe(resolveGlobalValue([
			'versionProd',
			'VERSION_PROD'
		]))

		if (version) {
			return version
		}

		if (versionProd) {
			return versionProd
		}

		KeywordUtil.markFailedAndStop('GlobalVariable.version and GlobalVariable.versionProd are both empty.')
		return ''
	}

	@Keyword
	void runResolutionScriptIfAvailable() {
		String resolutionScriptPath = resolveResolutionScriptPath()

		if (blank(resolutionScriptPath)) {
			KeywordUtil.logInfo('Resolution script path is empty. Skipping resolution script.')
			return
		}

		try {
			File resolutionScript = new File(resolutionScriptPath)

			if (!resolutionScript.exists()) {
				KeywordUtil.logInfo("Resolution script not found at: ${resolutionScriptPath}")
				return
			}

			KeywordUtil.logInfo("Running resolution script: ${resolutionScriptPath}")

			new ProcessBuilder(
					'powershell.exe',
					'-ExecutionPolicy',
					'Bypass',
					'-File',
					resolutionScriptPath
					).start()
		}
		catch (Exception e) {
			KeywordUtil.logInfo("Resolution script failed but flow will continue: ${safe(e.getMessage())}")
		}
	}

	@Keyword
	void ensureWinAppDriverIsReady() {
		if (isWinAppDriverRunning()) {
			KeywordUtil.logInfo('WinAppDriver is already running.')
			return
		}

		String exePath = resolveWinAppDriverExePath()

		if (!blank(exePath) && new File(exePath).exists()) {
			try {
				KeywordUtil.logInfo("Starting WinAppDriver from: ${exePath}")
				new ProcessBuilder(exePath).start()
				Windows.delay(AFTER_WINAPPDRIVER_START_DELAY_SEC)

				if (isWinAppDriverRunning()) {
					KeywordUtil.logInfo('WinAppDriver started successfully.')
					return
				}
			}
			catch (Exception e) {
				KeywordUtil.logInfo("Failed to start WinAppDriver from EXE: ${safe(e.getMessage())}")
			}
		}

		String bundledMsi = resolveBundledWinAppDriverMsiPath()

		KeywordUtil.markFailedAndStop(
				'WinAppDriver.exe was not found. ' +
				'Install WinAppDriver first. ' +
				'Expected EXE paths: ' + WINAPPDRIVER_EXE_CANDIDATES.join(' | ') + '. ' +
				'Bundled MSI found at: ' + (blank(bundledMsi) ? '[not found]' : bundledMsi)
				)
	}

	@Keyword
	void startEmatch(String currentUser, String targetWindowTitle) {
		String shortcutPath = resolveShortcutPath()
		String applicationPath = resolveApplicationPath()

		KeywordUtil.logInfo('============================================================')
		KeywordUtil.logInfo('Starting eMatch')
		KeywordUtil.logInfo("Current Windows user : ${safe(currentUser)}")
		KeywordUtil.logInfo("Target window title  : ${safe(targetWindowTitle)}")
		KeywordUtil.logInfo("Shortcut path        : ${safe(shortcutPath)}")
		KeywordUtil.logInfo("Application path     : ${safe(applicationPath)}")
		KeywordUtil.logInfo("WinAppDriver EXE     : ${safe(resolveWinAppDriverExePath())}")
		KeywordUtil.logInfo("WinAppDriver MSI     : ${safe(resolveBundledWinAppDriverMsiPath())}")
		KeywordUtil.logInfo('============================================================')

		try {
			ensureWinAppDriverIsReady()

			if (sameUserAsExecution(currentUser)) {
				runResolutionScriptIfAvailable()
			}

			boolean started = false

			if (!blank(shortcutPath) && new File(shortcutPath).exists()) {
				try {
					KeywordUtil.logInfo("Starting eMatch from shortcut with title: ${shortcutPath}")
					Windows.startApplicationWithTitle(shortcutPath, targetWindowTitle)
					started = true
				}
				catch (Exception firstStartError) {
					KeywordUtil.logInfo("startApplicationWithTitle failed for shortcut. Trying plain startApplication. Reason: ${safe(firstStartError.getMessage())}")

					try {
						Windows.startApplication(shortcutPath)
						started = true
					}
					catch (Exception secondStartError) {
						KeywordUtil.logInfo("startApplication also failed for shortcut. Reason: ${safe(secondStartError.getMessage())}")
					}
				}
			}

			if (!started && !blank(applicationPath)) {
				try {
					KeywordUtil.logInfo("Starting eMatch from application path: ${applicationPath}")
					Windows.startApplication(applicationPath)
					started = true
				}
				catch (Exception applicationError) {
					KeywordUtil.logInfo("startApplication failed for application path. Reason: ${safe(applicationError.getMessage())}")
				}
			}

			if (!started) {
				KeywordUtil.markFailedAndStop(
						'Failed to start eMatch. ' +
						'Neither shortcut nor application path could be launched. ' +
						'Shortcut=' + safe(shortcutPath) + ' | Application=' + safe(applicationPath)
						)
			}

			Windows.delay(AFTER_APP_START_DELAY_SEC)
		}
		catch (Exception e) {
			KeywordUtil.markFailed("Failed to start eMatch.")
			KeywordUtil.markFailed("Exception: ${e.getClass().getName()} - ${safe(e.getMessage())}")
			KeywordUtil.markFailedAndStop("Stopping test case due to startup failure.")
		}
	}

	@Keyword
	void attachToLoginWindow(String targetWindowTitle) {
		WindowsTestObject targetWindow = new WindowsTestObject()
		targetWindow.setLocatorStrategy(LocatorStrategy.NAME)
		targetWindow.setLocator(targetWindowTitle)

		int elapsedTime = 0
		boolean windowFound = false

		while (elapsedTime < WINDOW_ATTACH_TIMEOUT_SEC) {
			try {
				Windows.switchToDesktop()
				Windows.switchToWindow(targetWindow)
				windowFound = true
				break
			}
			catch (Exception e) {
				Windows.delay(WINDOW_ATTACH_RETRY_SEC)
				elapsedTime += WINDOW_ATTACH_RETRY_SEC
			}
		}

		if (!windowFound) {
			KeywordUtil.markFailedAndStop("Target window '${targetWindowTitle}' could not be found within ${WINDOW_ATTACH_TIMEOUT_SEC} seconds.")
		}
	}

	@Keyword
	void openEnvironmentDropdown() {
