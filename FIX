	private String buildShortVisualError(String visualError, String fullError) {
		String firstFromFull = firstMeaningfulLine(fullError)
		String firstFromVisual = firstMeaningfulLine(visualError)

		if (!firstFromFull.isEmpty()) {
			return firstFromFull
		}

		if (!firstFromVisual.isEmpty()) {
			return firstFromVisual
		}

		return ''
	}

	private String firstMeaningfulLine(String text) {
		List<String> lines = safeValue(text)
				.readLines()
				.collect { String line -> safeValue(line) }
				.findAll { String line -> !line.isEmpty() }

		if (lines.isEmpty()) {
			return ''
		}

		for (String line : lines) {
			String lower = line.toLowerCase(Locale.ENGLISH)
			if (lower == 'reason:' || lower == 'message:') {
				continue
			}
			return line
		}

		return lines[0]
	}

