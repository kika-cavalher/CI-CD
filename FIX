class RechercheFilterKeywords {

	private static final String IMAGE_GROUP = 'General'
	private static final String RECHERCHE_IMAGE_KEY = 'rechercheTab'

	private ImageLoader imageLoader = new ImageLoader()
	private Robot robot = new Robot()

	// ======================================================
	// EXISTING SECTION FILTER
	// Keep this method unchanged for the other test cases
	// ======================================================

	@Keyword
	void applyFilterTestCase(
			String filterTestCase,
			String filterValue
	) {
		if (filterValue == null || filterValue.trim().isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Filter value is empty.'
					)
		}

		String safeFilterValue = filterValue.trim()

		addNote(
				'Apply Recherche filter\n' +
				'Filter value: ' + safeFilterValue + '\n' +
				'Input method: direct keyword execution\n' +
				'Note: the old FilterSection test case is not called to avoid focus issues with Katalon.'
				)

		applySectionFilter(
				safeFilterValue
				)
	}

	@Keyword
	void applySectionFilter(String sectionValue) {
		if (sectionValue == null || sectionValue.trim().isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Section value is empty.'
					)
		}

		String safeSectionValue = sectionValue.trim()

		robot.setAutoDelay(120)

		addNote(
				'Step 1. Focus eMatch application before opening Recherche tab'
				)

		focusEmatchApplication()

		addNote(
				'Step 2. Open Recherche tab'
				)

		openRechercheTab()

		addNote(
				'Step 3. Move focus to Section field using TAB\n' +
				'TAB count: 18'
				)

		focusEmatchApplication()
		pressTabTimes(18)

		addNote(
				'Step 4. Fill Section field\n' +
				'Value: ' + safeSectionValue
				)

		clearFocusedField()
		pasteText(safeSectionValue)

		addNote(
				'Step 5. Click Rechercher button'
				)

		clickRechercherButton()

		Windows.delay(10)

		imageLoader.takeEvidence(
				'Recherche_Filter_Applied.png'
				)
	}

	// ======================================================
	// ELEMENT VALORISE FILTER
	// This is a separate flow and does not change other tests
	// ======================================================

	@Keyword
	void applyElementValoriseAsOfDateFilter(
			String asOfDateValue,
			Integer timeoutSeconds
	) {
		if (asOfDateValue == null || asOfDateValue.trim().isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'As Of Date value is empty.'
					)
		}

		String safeAsOfDateValue = asOfDateValue.trim()

		int safeTimeout =
				timeoutSeconds == null || timeoutSeconds <= 0
				? 5
				: timeoutSeconds

		robot.setAutoDelay(120)

		addNote(
				'Apply Element Valorise As Of Date filter\n' +
				'Value: ' + safeAsOfDateValue
				)

		// ==================================================
		// STEP 1. OPEN ONLY THE RECHERCHE TAB
		// Exact Name Recherche, not Rechercher
		// ==================================================

		addNote(
				'Step 1. Open Recherche tab'
				)

		openElementValoriseRechercheTab()

		Windows.delay(1)

		// ==================================================
		// STEP 2. MOVE TO AS OF DATE FIELD
		// Two TABs after opening Recherche
		// ==================================================

		addNote(
				'Step 2. Move focus to As Of Date field\n' +
				'TAB count: 2'
				)

		pressTabTimes(2)

		Windows.delay(1)

		// ==================================================
		// STEP 3. REPLACE DATE
		// Uses only explicit number and slash key codes
		// ==================================================

		addNote(
				'Step 3. Fill As Of Date field\n' +
				'Value: ' + safeAsOfDateValue
				)

		clearFocusedField()
		typeDateWithRobot(safeAsOfDateValue)

		Windows.delay(1)

		// ==================================================
		// STEP 4. CLICK ONLY THE RECHERCHER BUTTON
		// Exact Name Rechercher, not Recherche
		// ==================================================

		addNote(
				'Step 4. Click Rechercher button'
				)

		clickElementValoriseRechercherButton(safeTimeout)

		Windows.delay(safeTimeout)

		imageLoader.takeEvidence(
				'Recherche_ElementValorise_AsOfDate_Applied.png'
				)

		addNote(
				'Element Valorise filter applied successfully\n' +
				'As Of Date: ' + safeAsOfDateValue
				)
	}

	// ======================================================
	// ELEMENT VALORISE EXACT RECHERCHE TAB
	// ======================================================

	private void openElementValoriseRechercheTab() {
		WindowsTestObject rechercheTabButton = buildXpathObject(
				"//*[@Name='Recherche' and " +
				"(@LocalizedControlType='button' or contains(@ControlType,'Button'))]"
				)

		boolean rechercheTabFound = Windows.verifyElementPresent(
				rechercheTabButton,
				5,
				FailureHandling.OPTIONAL
				)

		if (!rechercheTabFound) {
			imageLoader.takeEvidence(
					'ElementValorise_RechercheTabNotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					'Element Valorise Recherche tab was not found.\n' +
					"Expected exact element: button with Name='Recherche'"
					)

			return
		}

		KeywordUtil.logInfo(
				"Exact Recherche tab found: Name='Recherche'."
				)

		Windows.click(
				rechercheTabButton,
				FailureHandling.STOP_ON_FAILURE
				)

		Windows.delay(2)

		WindowsTestObject recherchePane = buildXpathObject(
				"//*[@Name='Recherche' and " +
				"(@LocalizedControlType='pane' or contains(@ControlType,'Pane'))]"
				)

		boolean recherchePaneOpened = Windows.verifyElementPresent(
				recherchePane,
				3,
				FailureHandling.OPTIONAL
				)

		if (!recherchePaneOpened) {
			imageLoader.takeEvidence(
					'ElementValorise_RecherchePaneNotOpened.png'
					)

			KeywordUtil.markFailedAndStop(
					'Recherche tab was clicked, but the Recherche panel was not opened.'
					)

			return
		}

		KeywordUtil.logInfo(
				'Recherche panel opened successfully.'
				)
	}

	// ======================================================
	// ELEMENT VALORISE EXACT RECHERCHER BUTTON
	// ======================================================

	private void clickElementValoriseRechercherButton(Integer timeoutSeconds) {
		int safeTimeout =
				timeoutSeconds == null || timeoutSeconds <= 0
				? 5
				: timeoutSeconds

		WindowsTestObject rechercherButton = buildXpathObject(
				"//*[@Name='Recherche' and " +
				"(@LocalizedControlType='pane' or contains(@ControlType,'Pane'))]" +
				"//*[@Name='Rechercher' and " +
				"(@LocalizedControlType='button' or contains(@ControlType,'Button'))]"
				)

		boolean rechercherButtonFound = Windows.verifyElementPresent(
				rechercherButton,
				safeTimeout,
				FailureHandling.OPTIONAL
				)

		if (!rechercherButtonFound) {
			// Fallback using the exact button name only
			rechercherButton = buildXpathObject(
					"//*[@Name='Rechercher' and " +
					"(@LocalizedControlType='button' or contains(@ControlType,'Button'))]"
					)

			rechercherButtonFound = Windows.verifyElementPresent(
					rechercherButton,
					2,
					FailureHandling.OPTIONAL
					)
		}

		if (!rechercherButtonFound) {
			imageLoader.takeEvidence(
					'ElementValorise_RechercherButtonNotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					'Element Valorise Rechercher button was not found.\n' +
					"Expected exact element: button with Name='Rechercher'"
					)

			return
		}

		KeywordUtil.logInfo(
				"Exact Rechercher button found: Name='Rechercher'."
				)

		Windows.click(
				rechercherButton,
				FailureHandling.STOP_ON_FAILURE
				)

		Windows.delay(2)

		KeywordUtil.logInfo(
				'Rechercher button clicked successfully.'
				)
	}

	// ======================================================
	// EXISTING GENERIC RECHERCHE TAB
	// Kept for existing test cases
	// ======================================================

	private void openRechercheTab() {
		focusEmatchApplication()

		WindowsTestObject rechercheTabObject = buildXpathObject(
				"//*[@Name='Recherche' and " +
				"(@LocalizedControlType='button' or contains(@ControlType,'Button'))]"
				)

		if (Windows.verifyElementPresent(
				rechercheTabObject,
				3,
				FailureHandling.OPTIONAL
				)) {
			Windows.click(
					rechercheTabObject,
					FailureHandling.STOP_ON_FAILURE
					)

			Windows.delay(2)
			return
		}

		addNote(
				'Recherche tab was not found by element. Trying image fallback inside eMatch.'
				)

		if (!imageLoader.waitForImage(
				IMAGE_GROUP,
				RECHERCHE_IMAGE_KEY,
				5
				)) {
			imageLoader.takeEvidence(
					'RechercheTabNotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					'Recherche tab was not found.\n' +
					'Expected element name: Recherche\n' +
					'Expected image key: ' + RECHERCHE_IMAGE_KEY
					)
		}

		String rechercheImagePath = imageLoader.getImage(
				IMAGE_GROUP,
				RECHERCHE_IMAGE_KEY
				)

		WindowsImageKeywords.clickImage(
				rechercheImagePath
				)

		Windows.delay(2)

		focusEmatchApplication()
	}

