	// ======================================================
	// LOCAL HELPERS
	// ======================================================

	private void clickElementCenterByCoordinates(
		WindowsTestObject object
	) {
		def rect =
			Windows.getElementRect(
				object
			)

		int x =
			rect.getX() +
			Math.floor(
				rect.getWidth() / 2
			).intValue()

		int y =
			rect.getY() +
			Math.floor(
				getSafeHeight(rect) / 2
			).intValue()

		mouseClick(
			x,
			y
		)
	}

	private void mouseClick(
		int x,
		int y
	) {
		Robot robot =
			new Robot()

		robot.setAutoDelay(
			80
		)

		robot.mouseMove(
			x,
			y
		)

		Thread.sleep(80)

		robot.mousePress(
			InputEvent.BUTTON1_DOWN_MASK
		)

		Thread.sleep(80)

		robot.mouseRelease(
			InputEvent.BUTTON1_DOWN_MASK
		)

		Thread.sleep(150)
	}

	private int getSafeHeight(
		def rect
	) {
		int height =
			rect.getHeight()

		if (height <= 0) {
			return 20
		}

		return height
	}

	private void takeEvidence(
		String fileName
	) {
		try {
			String evidenceDirectory =
				RunConfiguration.getReportFolder() +
				'\\Evidences\\'

			new File(
				evidenceDirectory
			).mkdirs()

			WindowsActionHelper
				.create(
					WindowsDriverFactory.getWindowsSession()
				)
				.takeScreenshot(
					evidenceDirectory +
						fileName
				)

			KeywordUtil.logInfo(
				'Evidence captured: ' +
					evidenceDirectory +
					fileName
			)
		} catch (Exception evidenceError) {
			KeywordUtil.logInfo(
				'Could not capture evidence.\n' +
					'Reason: ' +
					evidenceError.getMessage()
			)
		}
	}
