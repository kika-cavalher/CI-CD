	@Keyword
	String getLastOpeningDate(String closingDate) {
		SimpleDateFormat dateFormat=new SimpleDateFormat("dd-MM-yyyy")
		Calendar calendar=Calendar.getInstance()
		try {
			Date date=dateFormat.parse(closingDate)
			calendar.setTime(date)
			int dayOfWeek=calendar.get(Calendar.DAY_OF_WEEK)
			int saturdayDayOfWeek=Calendar.SATURDAY
			if (dayOfWeek==Calendar.SATURDAY|| dayOfWeek==Calendar.SUNDAY) {
				// If the given date is Saturday or Sunday, find the last Friday
				while (calendar.get(Calendar.DAY_OF_WEEK) != Calendar.FRIDAY) {
					calendar.add(Calendar.DAY_OF_MONTH, -1)
				}
				return date.format(calendar.getTime().getDateString() )
			}else {
				// If the given date is not a weekend, return the original date
				return closingDate
			}
		} catch (Exception e) {
			return null
		}
	}

