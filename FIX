	private String collectDiscrepanciesFromFile(
			File file,
			String validationType,
			int sheetIndex,
			List<String> keyHeaders,
			List<String> compareHeaders,
			Map<String, String> expectedValuesByKey,
			Map<String, String> sourceByKey) {

		StringBuilder errors =
			new StringBuilder()

		FileInputStream input = null
		Workbook workbook = null

		try {

			input =
				new FileInputStream(file)

			workbook =
				WorkbookFactory.create(input)

			if (
				workbook.getNumberOfSheets() <=
				sheetIndex
			) {

				errors.append(
					"[ERROR] File '"
				)
				.append(file.getName())
				.append(
					"' does not contain sheet index "
				)
				.append(sheetIndex)
				.append('.\n')

			} else {

				Sheet sheet =
					workbook.getSheetAt(
						sheetIndex
					)

				DataFormatter formatter =
					new DataFormatter()

				FormulaEvaluator evaluator =
					workbook
						.getCreationHelper()
						.createFormulaEvaluator()

				Map<String, Integer> keyColumns =
					resolveHeaderColumns(
						sheet,
						keyHeaders,
						formatter
					)

				Map<String, Integer> compareColumns =
					resolveHeaderColumns(
						sheet,
						compareHeaders,
						formatter
					)

				if (
					keyColumns.size() !=
					keyHeaders.size() ||
					compareColumns.size() !=
					compareHeaders.size()
				) {

					errors.append(
						"[ERROR] File '"
					)
					.append(file.getName())
					.append(
						"' cannot run discrepancy validation because one or more configured headers were not found.\n"
					)

				} else {

					for (
						int i = 1;
						i <= sheet.getLastRowNum();
						i++
					) {

						Row row =
							sheet.getRow(i)

						if (
							row == null ||
							isRowEmpty(
								row,
								formatter,
								evaluator
							)
						) {
							continue
						}

						String key =
							buildValueByHeaders(
								row,
								keyHeaders,
								keyColumns,
								formatter,
								evaluator
							)

						String value =
							buildValueByHeaders(
								row,
								compareHeaders,
								compareColumns,
								formatter,
								evaluator
							)

						if (
							!expectedValuesByKey
								.containsKey(key)
						) {

							expectedValuesByKey.put(
								key,
								value
							)

							sourceByKey.put(
								key,
								file.getName() +
								' row ' +
								(i + 1)
							)

						} else {

							String expectedValue =
								expectedValuesByKey.get(
									key
								)

							if (
								!safeText(expectedValue)
									.equals(
										safeText(value)
									)
							) {

								errors.append(
									'[ERROR] Discrepancy found for key ['
								)
								.append(key)
								.append(
									']. Expected from '
								)
								.append(
									sourceByKey.get(key)
								)
								.append(': ')
								.append(expectedValue)
								.append(' | Found in ')
								.append(file.getName())
								.append(' row ')
								.append(i + 1)
								.append(': ')
								.append(value)
								.append('\n')
							}
						}
					}
				}
			}

		} catch (Exception e) {

			errors.append(
				"[ERROR] Discrepancy validation failed for file '"
			)
			.append(file.getName())
			.append("': ")
			.append(
				e.getClass()
					.getSimpleName()
			)
			.append(' | ')
			.append(e.getMessage())
			.append('\n')

		} finally {

			closeWorkbook(workbook)
			closeInput(input)
		}

		return errors.toString()
	}


