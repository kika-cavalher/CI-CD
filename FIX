@Keyword
void dragAndDropImage(
		String sourceImageKey,
		String targetImageKey,
		Integer timeoutSeconds
	) {

	Integer timeout = safeTimeout(timeoutSeconds, 10)

	logStep(
			'DRAG AND DROP',
			'Source: ' + sourceImageKey + '\n' +
			'Target: ' + targetImageKey + '\n' +
			'Timeout: ' + timeout + ' seconds'
			)

	boolean sourceVisible = waitForGroupByImage(
			sourceImageKey,
			timeout
			)

	boolean targetVisible = waitForGroupByImage(
			targetImageKey,
			timeout
			)

	if (!sourceVisible || !targetVisible) {
		takeEvidence(
				'GUI_DragAndDropImagesNotFound_' +
				sourceImageKey +
				'.png'
				)

		KeywordUtil.markFailedAndStop(
				'Drag and drop images were not found.\n' +
				'Source: ' + sourceImageKey + '\n' +
				'Source visible: ' + sourceVisible + '\n' +
				'Target: ' + targetImageKey + '\n' +
				'Target visible: ' + targetVisible
				)

		return
	}

	try {
		WindowsImageKeywords.dragAndDrop(
				image(
				GUI_IMAGE_GROUP,
				sourceImageKey
				),
				image(
				GUI_IMAGE_GROUP,
				targetImageKey
				)
				)

		KeywordUtil.logInfo(
				'[INFO] Drag and drop command executed.\n' +
				'Source: ' + sourceImageKey + '\n' +
				'Target: ' + targetImageKey
				)
	} catch (Exception e) {
		/*
		 * Katalon can throw an image recognition exception after
		 * the mouse operation has already moved the column.
		 *
		 * Do not repeat the drag here because that can undo or
		 * corrupt a Group By state that was already created.
		 *
		 * The real result is validated by validateGroupByResult.
		 */
		KeywordUtil.logInfo(
				'[INFO] Drag and drop command returned an exception.\n' +
				'The command will not be repeated.\n' +
				'The final Group By state will be validated afterwards.\n' +
				'Source: ' + sourceImageKey + '\n' +
				'Target: ' + targetImageKey + '\n' +
				'Reason: ' + safeMessage(e)
				)
	}

	Windows.delay(2)
}


private boolean waitForGroupByImage(
		String imageKey,
		Integer timeoutSeconds
	) {

	try {
		boolean imageVisible =
				imageLoader.waitForImage(
				GUI_IMAGE_GROUP,
				imageKey,
				timeoutSeconds
				)

		KeywordUtil.logInfo(
				'[INFO] Group By image recognition result.\n' +
				'Image: ' + imageKey + '\n' +
				'Visible: ' + imageVisible
				)

		return imageVisible
	} catch (Exception e) {
		KeywordUtil.logInfo(
				'[INFO] Group By image was not recognised.\n' +
				'Image: ' + imageKey + '\n' +
				'Reason: ' + safeMessage(e)
				)

		return false
	}
}


@Keyword
void validateGroupByResult(Integer timeoutSeconds) {

	Integer timeout = safeTimeout(timeoutSeconds, 10)
	List<String> errors = []

	String expectedFirstLevelLabel = 'Grappe'

	String expectedSecondLevelLabel =
			'Ecart bilan vs. compte de résultat ccy'

	logStep(
			'GROUP BY RESULT',
			'Validate first Group By level\n' +
			'Open the first Grappe row\n' +
			'Validate the first child row\n' +
			'Expected first level: ' +
				expectedFirstLevelLabel +
				': POSITIVE INTEGER\n' +
			'Expected child level: ' +
				expectedSecondLevelLabel +
				': NUMBER'
			)

	WindowsTestObject firstLevelObject =
			object(
			'firstLevelGroupBy'
			)

	WindowsTestObject secondLevelObject =
			object(
			'secondLevelGroupBy'
			)

	// ======================================================
	// VALIDATE FIRST GRAPPE ROW
	// ======================================================

	boolean firstLevelPresent =
			Windows.waitForElementPresent(
			firstLevelObject,
			timeout,
			FailureHandling.OPTIONAL
			)

	if (!firstLevelPresent) {
		errors.add(
				'The first Group By row was not found.\n' +
				'Expected format: Grappe: POSITIVE INTEGER\n' +
				'Object: firstLevelGroupBy'
				)
	} else {
		String firstLevelText =
				readGroupByRowText(
				firstLevelObject
				)

		KeywordUtil.logInfo(
				'[INFO] First Group By row found.\n' +
				'Actual text: ' + firstLevelText
				)

		validateGroupLabel(
				firstLevelText,
				expectedFirstLevelLabel,
				true,
				errors
				)
	}

	// ======================================================
	// OPEN FIRST GRAPPE ROW
	// ======================================================

	if (errors.isEmpty()) {
		boolean childAlreadyVisible =
				Windows.waitForElementPresent(
				secondLevelObject,
				1,
				FailureHandling.OPTIONAL
				)

		if (childAlreadyVisible) {
			KeywordUtil.logInfo(
					'[INFO] The first Grappe row is already open.'
					)
		} else {
			try {
				Windows.doubleClick(
						firstLevelObject,
						FailureHandling.STOP_ON_FAILURE
						)

				KeywordUtil.logInfo(
						'[PASS] The first Grappe row was opened.'
						)
			} catch (Exception e) {
				errors.add(
						'Could not open the first Grappe row.\n' +
						'Object: firstLevelGroupBy\n' +
						'Reason: ' + safeMessage(e)
						)
			}
		}
	}

	// ======================================================
	// VALIDATE FIRST CHILD ROW
	// ======================================================

	if (errors.isEmpty()) {
		boolean secondLevelPresent =
				Windows.waitForElementPresent(
				secondLevelObject,
				timeout,
				FailureHandling.OPTIONAL
				)

		if (!secondLevelPresent) {
			errors.add(
					'The first child row was not found after opening Grappe.\n' +
					'Expected format: ' +
					expectedSecondLevelLabel +
					': NUMBER\n' +
					'Object: secondLevelGroupBy'
					)
		} else {
			String secondLevelText =
					readGroupByRowText(
					secondLevelObject
					)

			KeywordUtil.logInfo(
					'[INFO] First opened child row found.\n' +
					'Actual text: ' + secondLevelText
					)

			validateGroupLabel(
					secondLevelText,
					expectedSecondLevelLabel,
					false,
					errors
					)

			if (errors.isEmpty()) {
				KeywordUtil.logInfo(
						'[PASS] The first opened child row is valid.\n' +
						'Expected label: ' +
						expectedSecondLevelLabel + '\n' +
						'Actual text: ' +
						secondLevelText
						)
			}
		}
	}

	takeEvidence(
			'GUI_GroupByResultValidated.png'
			)

	finishValidation(
			'Group By result validation',
			errors
			)
}


private String readGroupByRowText(
		WindowsTestObject targetObject
	) {

	String value =
			safeText(
			Windows.getAttribute(
			targetObject,
			'Name',
			FailureHandling.OPTIONAL
			)
			)

	if (!value.isEmpty()) {
		return value
	}

	value =
			safeText(
			Windows.getAttribute(
			targetObject,
			'LegacyValue',
			FailureHandling.OPTIONAL
			)
			)

	if (!value.isEmpty()) {
		return value
	}

	value =
			safeText(
			Windows.getAttribute(
			targetObject,
			'Value.Value',
			FailureHandling.OPTIONAL
			)
			)

	return value
}


private void validateGroupLabel(
		String rawValue,
		String expectedLabel,
		boolean requirePositiveInteger,
		List<String> errors
	) {

	String normalizedValue =
			safeText(rawValue)
			.replace('\u00A0', ' ')
			.replaceAll(/\s+/, ' ')
			.trim()

	if (normalizedValue.isEmpty()) {
		errors.add(
				'Group By row text is empty.\n' +
				'Expected label: ' + expectedLabel
				)

		return
	}

	Integer separatorIndex =
			normalizedValue.lastIndexOf(':')

	if (separatorIndex <= 0) {
		errors.add(
				'Invalid Group By format.\n' +
				'Expected: ' + expectedLabel + ': NUMBER\n' +
				'Actual: ' + normalizedValue
				)

		return
	}

	String actualLabel =
			normalizedValue
			.substring(
			0,
			separatorIndex
			)
			.trim()

	String numericText =
			normalizedValue
			.substring(
			separatorIndex + 1
			)
			.trim()
			.replace('\u00A0', '')
			.replace(' ', '')
			.replace(',', '.')

	if (!actualLabel.equalsIgnoreCase(expectedLabel)) {
		errors.add(
				'Unexpected Group By label.\n' +
				'Expected: ' + expectedLabel + '\n' +
				'Actual: ' + actualLabel
				)

		return
	}

	if (numericText.isEmpty()) {
		errors.add(
				expectedLabel +
				' numeric value is empty.\n' +
				'Actual row: ' + normalizedValue
				)

		return
	}

	if (requirePositiveInteger) {
		if (!(numericText ==~ /\d+/)) {
			errors.add(
					expectedLabel +
					' value must be a positive integer.\n' +
					'Actual: ' + numericText
					)

			return
		}

		try {
			BigInteger numericValue =
					new BigInteger(
					numericText
					)

			if (numericValue <= BigInteger.ZERO) {
				errors.add(
						expectedLabel +
						' value must be greater than zero.\n' +
						'Actual: ' + numericValue
						)

				return
			}
		} catch (Exception e) {
			errors.add(
					expectedLabel +
					' integer value is invalid.\n' +
					'Actual: ' + numericText
					)

			return
		}

		KeywordUtil.logInfo(
				'[PASS] Group By row is valid.\n' +
				'Label: ' + actualLabel + '\n' +
				'Value: ' + numericText
				)

		return
	}

	try {
		BigDecimal numericValue =
				new BigDecimal(
				numericText
				)

		KeywordUtil.logInfo(
				'[PASS] Group By row is valid.\n' +
				'Label: ' + actualLabel + '\n' +
				'Value: ' + numericValue
				)
	} catch (Exception e) {
		errors.add(
				expectedLabel +
				' numeric value is invalid.\n' +
				'Actual: ' + numericText
				)
	}
}
