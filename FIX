package jiraIntegration

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.driver.WindowsDriverFactory
import com.kms.katalon.core.webui.driver.DriverFactory

import org.openqa.selenium.OutputType

import javax.imageio.ImageIO
import java.awt.GraphicsConfiguration
import java.awt.GraphicsDevice
import java.awt.GraphicsEnvironment
import java.awt.MouseInfo
import java.awt.Rectangle
import java.awt.Robot
import java.awt.Toolkit
import java.awt.image.BufferedImage
import java.nio.charset.StandardCharsets
import java.text.SimpleDateFormat
import java.util.Base64
import java.util.Date

class JiraImagesEvidence {

	private static final String EVIDENCE_FOLDER_NAME = 'Evidences'
	private static final String TRACE_FILE_NAME = 'jira_images_evidence.tsv'

	private static final ThreadLocal<String> CURRENT_CASE_ID = new ThreadLocal<String>()

	@Keyword
	void startCase(String caseId) {
		String effectiveCaseId = resolveCaseId(caseId)
		CURRENT_CASE_ID.set(effectiveCaseId)

		File reportFolder = resolveReportFolder()
		File evidenceRoot = new File(reportFolder, EVIDENCE_FOLDER_NAME)
		File caseFolder = new File(evidenceRoot, sanitizeForPath(effectiveCaseId))

		ensureFolder(evidenceRoot)
		ensureFolder(caseFolder)

		KeywordUtil.logInfo('[JIRA_EVIDENCE] startCase=' + effectiveCaseId)
		KeywordUtil.logInfo('[JIRA_EVIDENCE] reportFolder=' + reportFolder.absolutePath)
		KeywordUtil.logInfo('[JIRA_EVIDENCE] caseFolder=' + caseFolder.absolutePath)
	}

	@Keyword
	String autoFailure(String caseId) {
		String effectiveCaseId = resolveCaseId(caseId)

		if (effectiveCaseId.isEmpty()) {
			KeywordUtil.logInfo('[JIRA_EVIDENCE] autoFailure skipped because caseId is empty.')
			return ''
		}

		File reportFolder = resolveReportFolder()
		File evidenceRoot = new File(reportFolder, EVIDENCE_FOLDER_NAME)
		File caseFolder = new File(evidenceRoot, sanitizeForPath(effectiveCaseId))

		ensureFolder(evidenceRoot)
		ensureFolder(caseFolder)

		String timestamp = new SimpleDateFormat('yyyyMMdd_HHmmss_SSS').format(new Date())
		String fileName = timestamp + '__' + sanitizeForPath(effectiveCaseId) + '__auto_failure.png'
		File targetFile = new File(caseFolder, fileName)

		KeywordUtil.logInfo('[JIRA_EVIDENCE] autoFailure case=' + effectiveCaseId)
		KeywordUtil.logInfo('[JIRA_EVIDENCE] reportFolder=' + reportFolder.absolutePath)
		KeywordUtil.logInfo('[JIRA_EVIDENCE] evidenceRoot=' + evidenceRoot.absolutePath)
		KeywordUtil.logInfo('[JIRA_EVIDENCE] caseFolder=' + caseFolder.absolutePath)
		KeywordUtil.logInfo('[JIRA_EVIDENCE] targetFile=' + targetFile.absolutePath)

		boolean captured = captureFailureScreenshot(targetFile)

		if (!captured || !targetFile.exists() || targetFile.length() <= 0L) {
			KeywordUtil.logInfo('[JIRA_EVIDENCE] Evidence capture failed for case=' + effectiveCaseId)
			return ''
		}

		appendTrace(reportFolder, effectiveCaseId, targetFile)

		KeywordUtil.logInfo('[JIRA_EVIDENCE] Evidence saved: ' + targetFile.absolutePath)
		return targetFile.absolutePath
	}

	@Keyword
	void finishCase() {
		CURRENT_CASE_ID.remove()
	}

	private boolean captureFailureScreenshot(File targetFile) {
		if (tryDriverScreenshot(targetFile)) {
			KeywordUtil.logInfo('[JIRA_EVIDENCE] Capture strategy=DRIVER_SCREENSHOT')
			return true
		}

		if (tryDriverWindowScreenshot(targetFile)) {
			KeywordUtil.logInfo('[JIRA_EVIDENCE] Capture strategy=DRIVER_WINDOW_BOUNDS')
			return true
		}

		if (tryCurrentMonitorScreenshot(targetFile)) {
			KeywordUtil.logInfo('[JIRA_EVIDENCE] Capture strategy=CURRENT_MONITOR')
			return true
		}

		if (tryPrimaryMonitorScreenshot(targetFile)) {
			KeywordUtil.logInfo('[JIRA_EVIDENCE] Capture strategy=PRIMARY_MONITOR')
			return true
		}

		return false
	}

	private boolean tryDriverScreenshot(File targetFile) {
		def driver = resolveActiveDriver()

		if (driver == null) {
			return false
		}

		try {
			byte[] pngBytes = driver.getScreenshotAs(OutputType.BYTES) as byte[]

			if (pngBytes == null || pngBytes.length == 0) {
				return false
			}

			targetFile.bytes = pngBytes
			return targetFile.exists() && targetFile.length() > 0L
		} catch (Throwable ignored) {
			return false
		}
	}

	private boolean tryDriverWindowScreenshot(File targetFile) {
		def driver = resolveActiveDriver()
		Rectangle bounds = resolveDriverWindowBounds(driver)

		if (bounds == null || bounds.width <= 0 || bounds.height <= 0) {
			return false
		}

		return captureWithRobot(bounds, targetFile)
	}

	private boolean tryCurrentMonitorScreenshot(File targetFile) {
		try {
			def pointerInfo = MouseInfo.pointerInfo
			GraphicsDevice device = pointerInfo != null ? pointerInfo.device : null
			GraphicsConfiguration configuration = device != null ? device.defaultConfiguration : null
			Rectangle bounds = configuration != null ? configuration.bounds : null

			if (bounds == null || bounds.width <= 0 || bounds.height <= 0) {
				return false
			}

			return captureWithRobot(bounds, targetFile)
		} catch (Throwable ignored) {
			return false
		}
	}

	private boolean tryPrimaryMonitorScreenshot(File targetFile) {
		try {
			def size = Toolkit.defaultToolkit.screenSize
			Rectangle bounds = new Rectangle(0, 0, size.width as int, size.height as int)
			return captureWithRobot(bounds, targetFile)
		} catch (Throwable ignored) {
			return false
		}
	}

	private boolean captureWithRobot(Rectangle bounds, File targetFile) {
		try {
			Robot robot = new Robot()
			BufferedImage image = robot.createScreenCapture(bounds)
			ImageIO.write(image, 'png', targetFile)
			return targetFile.exists() && targetFile.length() > 0L
		} catch (Throwable ignored) {
			return false
		}
	}

	private Rectangle resolveDriverWindowBounds(def driver) {
		if (driver == null) {
			return null
		}

		try {
			def rect = driver.getWindowRect()
			if (rect != null && rect.width > 0 && rect.height > 0) {
				return new Rectangle(rect.x as int, rect.y as int, rect.width as int, rect.height as int)
			}
		} catch (Throwable ignored) {
		}

		try {
			def window = driver.manage()?.window()
			def position = window?.position
			def size = window?.size

			if (position != null && size != null && size.width > 0 && size.height > 0) {
				return new Rectangle(position.x as int, position.y as int, size.width as int, size.height as int)
			}
		} catch (Throwable ignored) {
		}

		return null
	}

	private def resolveActiveDriver() {
		try {
			def windowsDriver = WindowsDriverFactory.getWindowsDriver()
			if (windowsDriver != null) {
				return windowsDriver
			}
		} catch (Throwable ignored) {
		}

		try {
			def webDriver = DriverFactory.getWebDriver()
			if (webDriver != null) {
				return webDriver
			}
		} catch (Throwable ignored) {
		}

		return null
	}

	private void appendTrace(File reportFolder, String caseId, File file) {
		File traceFile = new File(reportFolder, TRACE_FILE_NAME)
		String line =
				System.currentTimeMillis() + '\t' +
				encode64(caseId) + '\t' +
				encode64(file.absolutePath) + System.lineSeparator()

		traceFile << line
	}

	private String resolveCaseId(String caseId) {
		String direct = safe(caseId)

		if (!direct.isEmpty()) {
			return direct
		}

		String current = safe(CURRENT_CASE_ID.get())

		if (!current.isEmpty()) {
			return current
		}

		return ''
	}

	private File resolveReportFolder() {
		String reportPath = safe(RunConfiguration.getReportFolder())

		if (!reportPath.isEmpty()) {
			File fromRunConfiguration = new File(reportPath)
			ensureFolder(fromRunConfiguration)
			return fromRunConfiguration
		}

		File reportsRoot = new File(RunConfiguration.getProjectDir(), 'Reports')
		ensureFolder(reportsRoot)

		File latest = findLatestFolder(reportsRoot)
		if (latest != null) {
			return latest
		}

		return reportsRoot
	}

	private File findLatestFolder(File root) {
		if (root == null || !root.exists()) {
			return null
		}

		List<File> folders = root.listFiles()?.findAll { File file ->
			file.isDirectory()
		} ?: []

		if (folders.isEmpty()) {
			return null
		}

		folders = folders.sort { File a, File b ->
			b.lastModified() <=> a.lastModified()
		}

		return folders[0]
	}

	private void ensureFolder(File folder) {
		if (folder != null && !folder.exists()) {
			folder.mkdirs()
		}
	}

	private String sanitizeForPath(String value) {
		String text = safe(value)
				.replace('\\', '_')
				.replace('/', '_')
				.replace(':', '_')
				.replace('*', '_')
				.replace('?', '_')
				.replace('"', '_')
				.replace('<', '_')
				.replace('>', '_')
				.replace('|', '_')
				.replaceAll(/\s+/, '_')
				.replaceAll(/_+/, '_')
				.trim()

		return text.isEmpty() ? 'unknown_case' : text
	}

	private String encode64(String value) {
		return Base64.encoder.encodeToString(safe(value).getBytes(StandardCharsets.UTF_8))
	}

	private String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}
}
