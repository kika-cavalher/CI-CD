	private String badgeClassFor(String status) {
		switch (normalizeStatus(status)) {
			case 'PASS':
				return 'pass'
			case 'FAIL':
				return 'fail'
			case 'SKIP':
				return 'skip'
			default:
				return 'info'
		}
	}

	private String normalizeStatus(Object value) {
		String text = safe(value).toUpperCase(Locale.ENGLISH)
		if (text == 'PASSED') return 'PASS'
		if (text == 'FAILED') return 'FAIL'
		if (text == 'ERROR') return 'FAIL'
		if (text == 'SKIPPED') return 'SKIP'
		if (text == 'SKIP') return 'SKIP'
		if (text == 'PASS') return 'PASS'
		return text.isEmpty() ? 'INFO' : text
	}

	private String esc(Object value) {
		String text = safe(value)
		return text
			.replace('&', '&amp;')
			.replace('<', '&lt;')
			.replace('>', '&gt;')
			.replace('"', '&quot;')
			.replace("'", '&#39;')
	}

	private String safe(Object value) {
		return value == null ? '' : String.valueOf(value)
	}
