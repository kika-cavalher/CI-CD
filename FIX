	private String combineValidationResults(Object... values) {
		List<String> results = []

		if (values == null) {
			return ''
		}

		for (Object value : values) {
			String text = safeText(value)

			if (!text.isEmpty()) {
				results.add(text)
			}
		}

		return results.join('\n')
	}

	private Boolean hasValidationFailure(String validationResult) {
		String result = safeText(validationResult)

		if (result.isEmpty() || isSkippedResult(result)) {
			return false
		}

		String upper = result.toUpperCase(Locale.ENGLISH)

		if (upper == 'PASS' ||
				upper == 'PASSED' ||
				upper == 'SUCCESS') {

			return false
		}

		if (upper.startsWith('[PASS]') ||
				upper.startsWith('[PASSED]') ||
				upper.startsWith('[SUCCESS]')) {

			return false
		}

		return !upper.contains('RESULT: PASSED')
	}

	private Boolean isSkippedResult(String validationResult) {
		String result = safeText(validationResult)
		result = result.replaceFirst('^\\s*[^A-Za-z0-9\\[]+\\s*', '')
		return result.startsWith('[SKIPPED]')
	}

	private List<String> parseHeaderList(String text) {
		return splitText(text)
	}

	private List<String> extractErrorLines(String validationResult) {
		List<String> lines = []
		String result = safeText(validationResult)

		if (result.isEmpty()) {
			return lines
		}

		String normalized = result
				.replace('\r\n', '\n')
				.replace('\r', '\n')

		String[] parts = normalized.split('\n')

		for (String part : parts) {
			String clean = safeText(part)

			if (!clean.isEmpty()) {
				lines.add(clean)
			}
		}

		if (lines.isEmpty()) {
			lines.add(result)
		}

		return lines
	}

	private List<String> limitLines(
			List<String> lines,
			Integer limit) {

		List<String> result = []

		if (lines == null || lines.isEmpty()) {
			return result
		}

		Integer safeLimit = limit == null || limit <= 0 ? 999 : limit

		for (int i = 0; i < lines.size() && i < safeLimit; i++) {
			result.add(lines[i])
		}

		return result
	}

	private String cleanErrorLineForReport(
			String errorLine,
			List<File> files) {

		String line = safeText(errorLine)

		line = line.replace('[ERROR]', '').trim()
		line = line.replace('[FAIL]', '').trim()
		line = line.replace('[FAILED]', '').trim()
		line = line.replace('[PASS]', '').trim()
		line = line.replace('[PASSED]', '').trim()
		line = line.replace('[SKIPPED]', '').trim()
		line = line.replaceFirst('^\\s*[^A-Za-z0-9\\[]+\\s*', '').trim()
		line = line.replaceAll(
				'^com\\.kms\\.katalon\\.core\\.exception\\.StepFailedException:\\s*',
				''
				).trim()
		line = line.replaceAll(
				'^Reason:\\s*com\\.kms\\.katalon\\.core\\.exception\\.StepFailedException:\\s*',
				'Reason: '
				).trim()

		for (File file : files ?: []) {
			line = line.replace(file.getAbsolutePath(), file.getName())
			line = line.replace(file.getPath(), file.getName())
		}

		return stripPathsKeepingFileNames(line).trim()
	}

	private String stripPathsKeepingFileNames(String value) {
		String line = safeText(value).replace('\\', '/')
		line = line.replaceAll(
				'[A-Za-z]:/[^\\s|"]*/([^/\\s|"]+\\.xlsx)',
				'$1'
				)
		line = line.replaceAll(
				'[A-Za-z]:/[^\\s|"]*/([^/\\s|"]+\\.xls)',
				'$1'
				)
		return line
	}

	private BigDecimal parseDecimalOrNull(String value) {
		String text = safeText(value)

		if (text.isEmpty() || text == '-') {
			return null
		}

		String clean = text.replace(' ', '').replace("'", '')

		if (clean.startsWith('(') && clean.endsWith(')')) {
			clean = '-' + clean.substring(1, clean.length() - 1)
		}

		if (clean.contains(',') && clean.contains('.')) {
			Integer lastComma = clean.lastIndexOf(',')
			Integer lastDot = clean.lastIndexOf('.')

			if (lastComma > lastDot) {
				clean = clean.replace('.', '').replace(',', '.')
			} else {
				clean = clean.replace(',', '')
			}
		} else if (clean.contains(',') && !clean.contains('.')) {
			clean = clean.replace(',', '.')
		}

		try {
			return new BigDecimal(clean)
		} catch (Throwable ignored) {
			return null
		}
	}

	private BigDecimal parseDecimalOrDefault(
			String value,
			BigDecimal defaultValue) {

		BigDecimal parsed = parseDecimalOrNull(value)
		return parsed == null ? defaultValue : parsed
	}

	private String extractByRegex(
			String text,
			String pattern) {

		try {
			def matcher = text =~ pattern

			if (matcher.find()) {
				return matcher.group(1).trim()
			}
		} catch (Throwable ignored) {
		}

		return ''
	}

	private String formatDecimal(BigDecimal value) {
		if (value == null) {
			return '-'
		}

		BigDecimal normalized = value
				.setScale(4, RoundingMode.HALF_UP)
				.stripTrailingZeros()

		return normalized.toPlainString()
	}

	private String tableValue(Object value) {
		String text = safeText(value)
		return text.isEmpty() ? '-' : text.replace('|', '/')
	}

	private Integer parseIntOrDefault(
			String value,
			Integer defaultValue) {

		try {
			return Integer.parseInt(safeText(value))
		} catch (Exception ignored) {
			return defaultValue
		}
	}


