import internal.GlobalVariable

class authentication {

	private String gv(String name) {
		try {
			def value = GlobalVariable."${name}"
			return value == null ? '' : value.toString().trim()
		} catch (Throwable ignored) {
			return ''
		}
	}

	private String firstNonBlank(String... values) {
		for (String value : values) {
			if (value != null && value.toString().trim()) {
				return value.toString().trim()
			}
		}
		return ''
	}

	private String currentEnv() {
		String raw = firstNonBlank(
			gv('env'),
			gv('environment'),
			'REC'
		).toUpperCase()

		if (raw == 'PRD') {
			return 'PROD'
		}

		return raw ?: 'REC'
	}

	private boolean safeVerifyPresent(String objectId, int timeoutSeconds = 1) {
		try {
			return Windows.verifyElementPresent(
				findWindowsObject(objectId),
				timeoutSeconds,
				FailureHandling.OPTIONAL
			)
		} catch (Throwable ignored) {
			return false
		}
	}

	private boolean safeClick(String objectId, int timeoutSeconds = 2) {
		try {
			Windows.waitForElementPresent(
				findWindowsObject(objectId),
				timeoutSeconds,
				FailureHandling.OPTIONAL
			)
			Windows.click(findWindowsObject(objectId))
			return true
		} catch (Throwable ignored) {
			return false
		}
	}

	private boolean processExists(String imageName) {
		try {
			Process process = new ProcessBuilder(
				'cmd',
				'/c',
				"tasklist /FI \"IMAGENAME eq ${imageName}\""
			).redirectErrorStream(true).start()

			String output = process.inputStream.getText('CP1252')
			process.waitFor()

			return output != null && output.toLowerCase().contains(imageName.toLowerCase())
		} catch (Throwable ignored) {
			return false
		}
	}

	private void killProcessIfExists(String imageName) {
		try {
			if (!processExists(imageName)) {
				return
			}

			new ProcessBuilder(
				'cmd',
				'/c',
				"taskkill /F /T /IM \"${imageName}\""
			).redirectErrorStream(true).start().waitFor()
			Windows.delay(2)
		} catch (Throwable e) {
			KeywordUtil.logInfo("Unable to kill process ${imageName}: ${e.message}")
		}
	}

	private void runResolutionScriptIfNeeded() {
		String scriptPath = getResolutionScriptPath()
		if (!scriptPath) {
			return
		}

		File script = new File(scriptPath)
		if (!script.exists()) {
			KeywordUtil.logInfo("Resolution script not found: ${scriptPath}")
			return
		}

		try {
			new ProcessBuilder(
				'Powershell.exe',
				'-executionpolicy',
				'remotesigned',
				'-File',
				scriptPath
			).redirectErrorStream(true).start()
			Windows.delay(2)
		} catch (Throwable e) {
			KeywordUtil.logInfo("Unable to execute resolution script: ${e.message}")
		}
	}

	private void startWinAppDriver() {
		String exePath = getWinAppDriverPath()
		if (!exePath) {
			throw new Exception('WinAppDriver path is empty.')
		}

		File exe = new File(exePath)
		if (!exe.exists()) {
			throw new Exception("WinAppDriver executable not found at: ${exePath}")
		}

		try {
			new ProcessBuilder(exePath).inheritIO().start()
			Windows.delay(4)
		} catch (Throwable e) {
			throw new Exception("Unable to start WinAppDriver from: ${exePath}. Error: ${e.message}")
		}
	}

	private boolean waitForLoginWindowObjects(int timeoutSeconds) {
		List<String> candidateObjects = [
			'Login Page/optEnv',
			'Object Repository/Login Page/optEnv',
			'Login Page/btnConnect',
			'Object Repository/Login Page/btnConnect',
			'Login Page/btnConnecter'
		]

		for (String objectId : candidateObjects) {
			try {
				Windows.waitForElementPresent(
					findWindowsObject(objectId),
					timeoutSeconds,
					FailureHandling.OPTIONAL
				)
				if (safeVerifyPresent(objectId, 1)) {
					KeywordUtil.logInfo("Login object detected: ${objectId}")
					return true
				}
			} catch (Throwable ignored) {
			}
		}

		return false
	}

	private void attachWindowByTitle(String title) {
		WindowsTestObject targetWindow = new WindowsTestObject()
		targetWindow.setLocatorStrategy(LocatorStrategy.NAME)
		targetWindow.setLocator(title)

		Windows.switchToDesktop()
		Windows.switchToWindow(targetWindow)
	}

	private void keyPress(int keyCode) {
		Robot robot = new Robot()
		robot.setAutoDelay(120)
		robot.keyPress(keyCode)
		robot.keyRelease(keyCode)
	}

	@Keyword
	String getCurrentWindowsUser() {
		return firstNonBlank(
			System.getProperty('user.name'),
			System.getenv('USERNAME')
		)
	}

	@Keyword
	String resolveWindowTitle() {
		String title = firstNonBlank(
			gv('version'),
			gv('versionRec'),
			gv('versionREC'),
			gv('versionProd'),
			gv('versionPRD'),
			gv('versionPROD'),
			gv('versionPts'),
			gv('versionPTS')
		)

		if (!title) {
			throw new Exception("No version variable found for environment '${currentEnv()}'.")
		}

		return title
	}

	@Keyword
	String getShortcutPath() {
		String env = currentEnv()
		String user = firstNonBlank('BGS32GG', gv('username'), getCurrentWindowsUser())

		switch (env) {
			case 'PROD':
				return firstNonBlank(
					gv('shortcutPathProd'),
					gv('shortcutPathPRD'),
					gv('shortcutPathPROD'),
					"C:\\Users\\${user}\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\NATIXIS\\eMatch PROD.appref-ms"
				)
			case 'PTS':
				return firstNonBlank(
					gv('shortcutPathPts'),
					gv('shortcutPathPTS'),
					"C:\\Users\\${user}\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\NATIXIS\\eMatch PTS.appref-ms"
				)
			default:
				return firstNonBlank(
					gv('shortcutPathRec'),
					gv('shortcutPathREC'),
					"C:\\Users\\${user}\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\NATIXIS\\eMatch REC.appref-ms"
				)
		}
	}

	@Keyword
	String getRemoteShortcutPath() {
		String env = currentEnv()

		switch (env) {
			case 'PROD':
				return firstNonBlank(
					gv('remoteShortcutPathProd'),
					gv('remoteShortcutPathPRD'),
					gv('remoteShortcutPathPROD'),
					'D:\\RunAseMatchPrd\\eMatch.lnk'
				)
			case 'PTS':
				return firstNonBlank(
					gv('remoteShortcutPathPts'),
					gv('remoteShortcutPathPTS'),
					'D:\\RunAseMatchPts\\eMatch.lnk'
				)
			default:
				return firstNonBlank(
					gv('remoteShortcutPathRec'),
					gv('remoteShortcutPathREC'),
					'D:\\RunAseMatchReq\\eMatch.lnk'
				)
		}
	}

	@Keyword
	String getResolutionScriptPath() {
		return firstNonBlank(
			gv('resolutionScriptPath'),
			'D:\\setResolution.ps1'
		)
	}

	@Keyword
	String getWinAppDriverPath() {
		return firstNonBlank(
			gv('winAppDriverPath'),
			'C:\\Program Files (x86)\\Windows Application Driver\\WinAppDriver.exe'
		)
	}

	@Keyword
	boolean startEMatch(String currentUser, String targetWindowTitle) {
		String localShortcutPath = getShortcutPath()
		String remoteShortcutPath = getRemoteShortcutPath()
		File localShortcut = new File(localShortcutPath)
		File remoteShortcut = new File(remoteShortcutPath)
		boolean localFlow = localShortcut.exists()

		KeywordUtil.logInfo("Current user: ${currentUser}")
		KeywordUtil.logInfo("Configured user: ${gv('username')}")
		KeywordUtil.logInfo("Window title: ${targetWindowTitle}")
		KeywordUtil.logInfo("Local shortcut: ${localShortcutPath}")
		KeywordUtil.logInfo("Remote shortcut: ${remoteShortcutPath}")
		KeywordUtil.logInfo("Local shortcut exists: ${localShortcut.exists()}")
		KeywordUtil.logInfo("Remote shortcut exists: ${remoteShortcut.exists()}")
		KeywordUtil.logInfo("Local flow: ${localFlow}")

		killProcessIfExists('IXIS.eMatch.IHM.exe')

		if (localFlow) {
			runResolutionScriptIfNeeded()
			Windows.startApplicationWithTitle(localShortcutPath, targetWindowTitle)
			Windows.delay(8)
			return true
		}

		startWinAppDriver()
		if (!remoteShortcut.exists()) {
			throw new Exception("Remote shortcut does not exist: ${remoteShortcutPath}")
		}

		new ProcessBuilder(
			'cmd',
			'/c',
			"start \"\" \"${remoteShortcutPath}\""
		).redirectErrorStream(true).start()

		Windows.delay(10)
		return true
	}

	@Keyword
	boolean attachToLoginWindow(String targetWindowTitle) {
		Exception lastError = null

		for (int i = 1; i <= 8; i++) {
			try {
				attachWindowByTitle(targetWindowTitle)
				if (waitForLoginWindowObjects(15)) {
					KeywordUtil.logInfo("Attached to login window '${targetWindowTitle}' at attempt ${i}")
					return true
				}
			} catch (Throwable e) {
				lastError = e
			}
			Windows.delay(2)
		}

		throw new Exception("Unable to attach to login window '${targetWindowTitle}'. Last error: ${lastError?.message}")
	}

	@Keyword
	boolean openEnvironmentDropdown() {
		List<String> candidateObjects = [
			'Login Page/optEnv',
			'Object Repository/Login Page/optEnv'
		]

		Exception lastError = null
		for (String objectId : candidateObjects) {
			try {
				Windows.click(findWindowsObject(objectId))
				Windows.delay(1)
				return true
			} catch (Throwable e) {
				lastError = e
			}
		}

		throw new Exception("Unable to open environment dropdown. Last error: ${lastError?.message}")
	}

	@Keyword
	int resolveEnvironmentIndex(String envName) {
		String env = (envName ?: '').trim().toUpperCase()

		switch (env) {
			case 'PROD':
			case 'PRD':
				return 1
			case 'PREX':
			case 'PREQ':
			case 'BENCH':
				return 2
			case 'REC2':
			case 'QUAL':
			case 'QUALIFICATION':
				return 3
			case 'REC':
			case 'RECETTE':
				return 4
			case 'DEV2':
			case 'SIM':
			case 'SIMULATION':
				return 5
			case 'DEV':
			case 'DEVELOPMENT':
				return 6
			default:
				return 4
		}
	}

	@Keyword
	boolean selectEnvironment(String envName) {
		int envIndex = resolveEnvironmentIndex(envName)
		List<String> candidateObjects = [
			'Login Page/optEnv',
			'Object Repository/Login Page/optEnv'
		]

		Exception lastError = null
		for (String objectId : candidateObjects) {
			try {
				for (int i = 0; i < envIndex; i++) {
					Windows.sendKeys(findWindowsObject(objectId), Keys.chord(Keys.ARROW_DOWN))
				}
				Windows.sendKeys(findWindowsObject(objectId), Keys.chord(Keys.ENTER))
				Windows.delay(2)
				return true
			} catch (Throwable e) {
				lastError = e
			}
		}

		throw new Exception("Unable to select environment '${envName}'. Last error: ${lastError?.message}")
	}

	@Keyword
	boolean isConnectButtonPresent() {
		return safeVerifyPresent('Login Page/btnConnecter', 1) ||
			safeVerifyPresent('Object Repository/Login Page/btnConnect', 1) ||
			safeVerifyPresent('Login Page/btnConnect', 1)
	}

	@Keyword
	boolean clickConnectButton() {
		List<String> candidateObjects = [
			'Login Page/btnConnecter',
			'Object Repository/Login Page/btnConnect',
			'Login Page/btnConnect'
		]

		Exception lastError = null
		for (String objectId : candidateObjects) {
			try {
				Windows.click(findWindowsObject(objectId))
				Windows.delay(1)
				return true
			} catch (Throwable e) {
				lastError = e
			}
		}

		throw new Exception("Unable to click connect button. Last error: ${lastError?.message}")
	}

	@Keyword
	boolean waitForMainScreen() {
		try {
			Windows.waitForElementPresent(findWindowsObject('General/txtSearch'), 60)
			return true
		} catch (Throwable ignored) {
		}

		try {
			Windows.waitForElementPresent(findWindowsObject('Object Repository/General/txtSearch'), 60)
			return true
		} catch (Throwable ignored) {
		}

		return false
	}

	@Keyword
	boolean activateHomeTab() {
		if (safeClick('Object Repository/General/tabHome', 2)) {
			return true
		}

		if (safeClick('General/tabHome', 2)) {
			return true
		}

		keyPress(KeyEvent.VK_ESCAPE)
		return true
	}
}
