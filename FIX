		List<File> failureImages = findFailureImages(reportFolder)
		int failureImageIndex = 0

		List<Map> failedCases = []
		List<Map> passedCases = []
		List<Map> skippedCases = []

		def testCases = xml.depthFirst().findAll { it.name() == 'testcase' }
		long totalMillis = 0L

		testCases.each { tc ->
			String name = safe(tc.@name)
			String classname = safe(tc.@classname)
			String displayName = isBlank(classname) ? name : "${classname}/${name}"

			BigDecimal seconds = 0
			try {
				seconds = new BigDecimal(safe(tc.@time ?: '0'))
			} catch (Exception ignored) {
				seconds = 0
			}

			long durationMillis = (long) (seconds * 1000)
			totalMillis += durationMillis

			boolean hasFailure = tc.failure.size() > 0 || tc.error.size() > 0
			boolean hasSkipped = tc.skipped.size() > 0

			String fullError = ''
			if (hasFailure) {
