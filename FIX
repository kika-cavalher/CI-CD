	private Robot robot() {
		if (cachedRobot == null) {
			cachedRobot = new Robot()
			cachedRobot.setAutoDelay(100)
		}
		return cachedRobot
	}

	private void robotKey(int keyCode) {
		Robot r = robot()
		r.keyPress(keyCode)
		r.keyRelease(keyCode)
		sleepMs(150)
	}

	private void focusLoginWindow(String title) {
		String targetTitle = normalizeTitle(safe(title) ?: safe(detectedWindowTitle) ?: resolveWindowTitle())

		try {
			Windows.switchToDesktop()
		} catch (Throwable ignored) {
		}

		try {
			Windows.switchToWindow(appWindowObj(targetTitle))
			sleepMs(700)
		} catch (Throwable ignored) {
		}
	}

	// =========================================================================
	// SECTION 12 - IMAGE ACTIONS
	// =========================================================================

	private boolean clickImageWithAttempts(String imagePath, int attempts, long delayMs, String actionLabel) {
		String path = safe(imagePath)

		if (!path) {
			return false
		}

		if (!imageFileExists(path)) {
			KeywordUtil.logInfo("Image file was not found for action: ${actionLabel} :: ${path}")
			return false
		}

		for (int i = 1; i <= attempts; i++) {
			try {
				KeywordUtil.logInfo("${actionLabel}. Attempt ${i}/${attempts} using ${path}")
				WindowsImageKeywords.clickImage(path)
				sleepMs(delayMs)
				return true
			} catch (Throwable ignored) {
				sleepMs(delayMs)
			}
		}

		return false
	}

	// =========================================================================
	// SECTION 13 - GENERIC UTILS
	// =========================================================================

	private void sleepMs(long ms) {
		try {
			Thread.sleep(ms)
		} catch (InterruptedException ignored) {
			Thread.currentThread().interrupt()
		}
	}

	private String normalizeTitle(String value) {
		return safe(value).replaceAll('\\s+', ' ').trim()
	}

	private String safe(Object value) {
		return value == null ? '' : value.toString().trim()
	}

	private String escapePowerShell(String value) {
		return safe(value).replace("'", "''")
	}

	private String xpathLiteral(String value) {
		String v = safe(value)

		if (!v.contains("'")) {
			return "'${v}'"
		}

		if (!v.contains('"')) {
			return "\"${v}\""
		}

		List<String> parts = v.split("'").collect { "'${it}'" }
		return "concat(${parts.join(", \"'\", ")})"
	}
