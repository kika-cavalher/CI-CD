package commands

import java.awt.Robot
import java.awt.event.KeyEvent

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

class DimensionsNavigator {

	private ImageLoader imageLoader = new ImageLoader()

	@Keyword
	void validateDimensionsImagesExist(String imageGroup) {
		Map<String, String> images = imageLoader.getImages(imageGroup)

		List<String> requiredKeys = [
			'firstDimension',
			'lastDimension',
			'lastDimensionOpen',
			'firstPageRef'
		]

		List<String> missingKeys = []

		requiredKeys.each { String key ->
			if (!images.containsKey(key)) {
				missingKeys.add(key)
			}
		}

		if (!missingKeys.isEmpty()) {
			KeywordUtil.markFailedAndStop(
				'Dimensions image group is missing required keys.\n' +
				'Image group: ' + imageGroup + '\n' +
				'Missing keys: ' + missingKeys.join(', ')
			)
		}

		KeywordUtil.logInfo('All dimensions images exist for group: ' + imageGroup)
	}

	@Keyword
	void validateMeasuresOpen(String imageGroup, Integer timeoutSeconds) {
		waitForDimensionImageOrStop(imageGroup, 'firstDimension', timeoutSeconds)
	}

	@Keyword
	void clickFirstDimension(String imageGroup) {
		waitForDimensionImageOrStop(imageGroup, 'firstDimension', 15)
		imageLoader.clickImageOrStop(imageGroup, 'firstDimension')
		Windows.delay(1)
	}

	@Keyword
	void openDimensionsUntilProvic(String imageGroup, Integer maxCycles) {
		int safeCycles = maxCycles == null || maxCycles <= 0 ? 65 : maxCycles

		boolean foundBottom = navigateUntilLastDimensionVisible(imageGroup, safeCycles)

		if (!foundBottom) {
			imageLoader.takeEvidence('DimensionsLastDimensionNotFound.png')

			KeywordUtil.markFailedAndStop(
				'Could not navigate until last dimension image became visible.\n' +
				'Image group: ' + imageGroup + '\n' +
				'Expected image: lastDimension\n' +
				'Max cycles: ' + safeCycles
			)
		}

		boolean opened = forceOpenProvic(imageGroup, 5)

		if (!opened) {
			imageLoader.takeEvidence('DimensionsProvicOpenNotFound.png')

			KeywordUtil.markFailedAndStop(
				'Provic row was reached, but it did not open correctly.\n' +
				'Image group: ' + imageGroup + '\n' +
				'Expected image: lastDimensionOpen'
			)
		}
	}

	@Keyword
	void validateProvicOpen(String imageGroup, Integer timeoutSeconds) {
		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 15 : timeoutSeconds

		if (imageLoader.isVisible(imageGroup, 'lastDimensionOpen')) {
			KeywordUtil.logInfo('Provic open image is already visible.')
			return
		}

		boolean opened = forceOpenProvic(imageGroup, 3)

		if (!opened) {
			imageLoader.takeEvidence('DimensionsProvicOpenNotFound.png')

			KeywordUtil.markFailedAndStop(
				'Image was not found before timeout.\n' +
				'Group: ' + imageGroup + '\n' +
				'Key: lastDimensionOpen\n' +
				'Path: ' + imageLoader.getImage(groupNameOrSame(imageGroup), 'lastDimensionOpen') + '\n' +
				'Timeout: ' + safeTimeout
			)
		}
	}

	@Keyword
	void validateLastDimension(String imageGroup, Integer timeoutSeconds) {
		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 15 : timeoutSeconds

		if (imageLoader.waitForImage(imageGroup, 'lastDimension', safeTimeout)) {
			KeywordUtil.logInfo('Last dimension image validated: lastDimension')
			return
		}

		if (imageLoader.waitForImage(imageGroup, 'lastDimensionOpen', 3)) {
			KeywordUtil.logInfo('Last dimension row validated using opened state image: lastDimensionOpen')
			return
		}

		imageLoader.takeEvidence('DimensionsLastDimensionValidationFailed.png')

		KeywordUtil.markFailedAndStop(
			'Last dimension image was not validated.\n' +
			'Image group: ' + imageGroup + '\n' +
			'Expected images: lastDimension or lastDimensionOpen'
		)
	}

	@Keyword
	void scrollDimensionsToTop(String imageGroup) {
		boolean found = scrollUntilImageVisible(imageGroup, 'firstPageRef', true, 40)

		if (!found) {
			imageLoader.takeEvidence('DimensionsFirstPageRefNotFound.png')

			KeywordUtil.markFailedAndStop(
				'Could not scroll to top dimensions reference.\n' +
				'Image group: ' + imageGroup + '\n' +
				'Expected image: firstPageRef'
			)
		}
	}

	@Keyword
	void validateFirstPageReference(String imageGroup, Integer timeoutSeconds) {
		waitForDimensionImageOrStop(imageGroup, 'firstPageRef', timeoutSeconds)
	}

	@Keyword
	void validateLastPageReference(String imageGroup, Integer timeoutSeconds) {
		waitForDimensionImageOrStop(imageGroup, 'lastPageRef', timeoutSeconds)
	}

	@Keyword
	void validateDimensionsCompleteFlow(String imageGroup, Integer maxCycles, Integer maxScrollMoves) {
		int safeCycles = maxCycles == null || maxCycles <= 0 ? 65 : maxCycles
		int safeScrollMoves = maxScrollMoves == null || maxScrollMoves <= 0 ? 40 : maxScrollMoves

		validateDimensionsImagesExist(imageGroup)

		KeywordUtil.logInfo('Step 1. Validate Measures image.')
		validateMeasuresOpen(imageGroup, 15)

		KeywordUtil.logInfo('Step 2. Click Measures image to focus dimensions tree.')
		clickFirstDimension(imageGroup)

		KeywordUtil.logInfo('Step 3. Navigate until Provic line becomes visible.')
		boolean foundBottom = navigateUntilLastDimensionVisible(imageGroup, safeCycles)

		if (!foundBottom) {
			imageLoader.takeEvidence('DimensionsLastDimensionNotFound.png')

			KeywordUtil.markFailedAndStop(
				'Could not navigate until last dimension image became visible.\n' +
				'Image group: ' + imageGroup + '\n' +
				'Expected image: lastDimension\n' +
				'Max cycles: ' + safeCycles
			)
		}

		KeywordUtil.logInfo('Step 4. Validate last dimension image at bottom.')
		validateLastDimension(imageGroup, 10)

		KeywordUtil.logInfo('Step 5. Force open Provic and validate open image.')
		boolean opened = forceOpenProvic(imageGroup, 5)

		if (!opened) {
			imageLoader.takeEvidence('DimensionsProvicOpenNotFound.png')

			KeywordUtil.markFailedAndStop(
				'Could not validate Provic open image after reaching the last dimension.\n' +
				'Image group: ' + imageGroup
			)
		}

		validateProvicOpen(imageGroup, 10)

		KeywordUtil.logInfo('Step 6. Scroll to top.')
		boolean firstPageFound = scrollUntilImageVisible(imageGroup, 'firstPageRef', true, safeScrollMoves)

		if (!firstPageFound) {
			imageLoader.takeEvidence('DimensionsFirstPageRefNotFound.png')

			KeywordUtil.markFailedAndStop(
				'Could not find first page dimensions image after scrolling to top.\n' +
				'Image group: ' + imageGroup + '\n' +
				'Expected image: firstPageRef\n' +
				'Max scroll moves: ' + safeScrollMoves
			)
		}

		KeywordUtil.logInfo('Step 7. Validate first page image after scrolling to top.')
		validateFirstPageReference(imageGroup, 15)

		KeywordUtil.logInfo('Dimensions flow validated successfully.')
	}

	private void waitForDimensionImageOrStop(String imageGroup, String imageKey, Integer timeoutSeconds) {
		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 15 : timeoutSeconds
		imageLoader.waitForImageOrStop(imageGroup, imageKey, safeTimeout)
	}

	private boolean navigateUntilLastDimensionVisible(String imageGroup, int maxCycles) {
		if (imageLoader.isVisible(imageGroup, 'lastDimension') || imageLoader.isVisible(imageGroup, 'lastDimensionOpen')) {
			KeywordUtil.logInfo('Last dimension state is already visible before navigation.')
			return true
		}

		for (int cycle = 1; cycle <= maxCycles; cycle++) {
			boolean firstCycle = cycle == 1
			int rightMoves = firstCycle ? 3 : 1

			KeywordUtil.logInfo(
				'Dimensions navigation cycle ' + cycle + '/' + maxCycles + '. Sequence: ' +
				(firstCycle ? 'RIGHT, RIGHT, RIGHT, DOWN' : 'RIGHT, DOWN')
			)

			for (int i = 0; i < rightMoves; i++) {
				pressRight()
				Windows.delay(1)

				if (imageLoader.isVisible(imageGroup, 'lastDimension') || imageLoader.isVisible(imageGroup, 'lastDimensionOpen')) {
					KeywordUtil.logInfo('Last dimension became visible after RIGHT move ' + (i + 1) + '.')
					return true
				}
			}

			pressDown()
			Windows.delay(1)

			if (imageLoader.isVisible(imageGroup, 'lastDimension') || imageLoader.isVisible(imageGroup, 'lastDimensionOpen')) {
				KeywordUtil.logInfo('Last dimension became visible after DOWN.')
				return true
			}
		}

		Windows.delay(2)

		return imageLoader.isVisible(imageGroup, 'lastDimension') || imageLoader.isVisible(imageGroup, 'lastDimensionOpen')
	}

	private boolean forceOpenProvic(String imageGroup, int maxAttempts) {
		if (imageLoader.isVisible(imageGroup, 'lastDimensionOpen')) {
			return true
		}

		for (int attempt = 1; attempt <= maxAttempts; attempt++) {
			if (imageLoader.isVisible(imageGroup, 'lastDimensionOpen')) {
				return true
			}

			KeywordUtil.logInfo('Trying to open Provic. Attempt ' + attempt + '/' + maxAttempts)

			pressRight()
			Windows.delay(1)

			if (imageLoader.isVisible(imageGroup, 'lastDimensionOpen')) {
				KeywordUtil.logInfo('Provic open image became visible after RIGHT.')
				return true
			}
		}

		return imageLoader.isVisible(imageGroup, 'lastDimensionOpen')
	}

	private boolean scrollUntilImageVisible(String imageGroup, String imageKey, boolean scrollUp, int maxScrollMoves) {
		for (int i = 0; i < maxScrollMoves; i++) {
			if (imageLoader.isVisible(imageGroup, imageKey)) {
				KeywordUtil.logInfo(
					'Image found during scroll.\n' +
					'Image group: ' + imageGroup + '\n' +
					'Image key: ' + imageKey + '\n' +
					'Scroll direction: ' + (scrollUp ? 'UP' : 'DOWN') + '\n' +
					'Scroll step: ' + i
				)
				return true
			}

			scrollOneStep(scrollUp)
			Windows.delay(1)
		}

		return false
	}

	private void pressRight() {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_RIGHT)
		robot.keyRelease(KeyEvent.VK_RIGHT)
	}

	private void pressDown() {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(KeyEvent.VK_DOWN)
		robot.keyRelease(KeyEvent.VK_DOWN)
	}

	private void scrollOneStep(boolean scrollUp) {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		if (scrollUp) {
			robot.mouseWheel(-3)
		} else {
			robot.mouseWheel(3)
		}
	}

	private String groupNameOrSame(String imageGroup) {
		return imageGroup
	}
}
