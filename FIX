	private String resolveStepIcon(String detail, String status) {
		return resolveStepIconStatic(detail, status)
	}

	private static String resolveStepIconStatic(String detail, String status) {
		String lower = safeValueStatic(detail).toLowerCase(Locale.ENGLISH)

		if (status == 'failed') {
			return '❌'
		}
		if (status == 'skipped') {
			return '⏭️'
		}
		if (lower.contains('wait') || lower.contains('find') || lower.contains('search')) {
			return '🔎'
		}
		if (lower.contains('click') || lower.contains('select') || lower.contains('doubleclick')) {
			return '🖱️'
		}
		if (lower.contains('settext') || lower.contains('type') || lower.contains('input') || lower.contains('write')) {
			return '⌨️'
		}
		if (lower.contains('open') || lower.contains('navigate') || lower.contains('launch')) {
			return '🌐'
		}
		if (lower.contains('verify') || lower.contains('assert') || lower.contains('validate')) {
			return '✅'
		}
		return 'ℹ️'
	}

