🎯 Esse é o file que faz “igual antes”: abre o app e executa na sessão interativa porque ele roda via Task Scheduler.

@echo off
setlocal EnableExtensions EnableDelayedExpansion

rem =========================================================
rem eMatch Desktop Runner (Task Scheduler entrypoint)
rem Reads: D:\Projects\eMatchStarters\run-context.properties
rem Runs Katalon collection and writes:
rem   - %REPORTS_DIR%\_jenkins_task_exitcode.txt
rem   - Logs under %LOG_DIR%
rem =========================================================

set "CTX=D:\Projects\eMatchStarters\run-context.properties"

if not exist "%CTX%" (
  echo [ERROR] run-context.properties not found: %CTX%
  exit /b 10
)

rem --- Read properties file ---
for /f "usebackq tokens=1,* delims==" %%A in ("%CTX%") do (
  set "K=%%A"
  set "V=%%B"
  if not "!K!"=="" (
    set "!K!=!V!"
  )
)

rem --- Validate required keys ---
if "%WORKSPACE%"=="" (
  echo [ERROR] WORKSPACE missing in %CTX%
  exit /b 11
)
if "%PROJECT_FILE%"=="" (
  echo [ERROR] PROJECT_FILE missing in %CTX%
  exit /b 12
)
if "%KATALON_EXE%"=="" (
  echo [ERROR] KATALON_EXE missing in %CTX%
  exit /b 13
)
if "%COLLECTION_PATH%"=="" (
  echo [ERROR] COLLECTION_PATH missing in %CTX%
  exit /b 14
)
if "%REPORTS_DIR%"=="" (
  echo [ERROR] REPORTS_DIR missing in %CTX%
  exit /b 15
)

if "%BROWSER_TYPE%"=="" set "BROWSER_TYPE=Windows"
if "%RETRY%"=="" set "RETRY=0"
if "%LOG_DIR%"=="" set "LOG_DIR=D:\Projects\eMatchStarters\logs"

rem --- Ensure folders ---
if not exist "%REPORTS_DIR%" mkdir "%REPORTS_DIR%" >nul 2>nul
if not exist "%LOG_DIR%" mkdir "%LOG_DIR%" >nul 2>nul

rem --- Build timestamp ---
for /f %%i in ('powershell -NoProfile -Command "Get-Date -Format yyyyMMdd_HHmmss"') do set "TS=%%i"

set "LOG_FILE=%LOG_DIR%\katalon_%TS%.log"
set "EXIT_FILE=%REPORTS_DIR%\_jenkins_task_exitcode.txt"

rem --- Clear previous exit file ---
if exist "%EXIT_FILE%" del /f /q "%EXIT_FILE%" >nul 2>nul

set "PROJECT_PATH=%WORKSPACE%\%PROJECT_FILE%"

echo ================================================================>>"%LOG_FILE%"
echo START KATALON %TS%>>"%LOG_FILE%"
echo WORKSPACE=%WORKSPACE%>>"%LOG_FILE%"
echo PROJECT_PATH=%PROJECT_PATH%>>"%LOG_FILE%"
echo COLLECTION=%COLLECTION_PATH%>>"%LOG_FILE%"
echo REPORTS_DIR=%REPORTS_DIR%>>"%LOG_FILE%"
echo ================================================================>>"%LOG_FILE%"

rem --- Run Katalon ---
rem IMPORTANT:
rem - This is console mode but it still runs in the interactive session (Task Scheduler)
rem - Reports are forced to %REPORTS_DIR% so Jenkins can collect them

"%KATALON_EXE%" ^
  -noSplash ^
  -runMode=console ^
  -retry=%RETRY% ^
  -projectPath="%PROJECT_PATH%" ^
  -testSuiteCollectionPath="%COLLECTION_PATH%" ^
  -browserType="%BROWSER_TYPE%" ^
  -reportFolder="%REPORTS_DIR%" ^
  -reportFileName="JUnit_Report" ^
  -reportFormat="JUnit" ^
  -consoleLog ^
  > "%LOG_FILE%" 2>&1

set "RC=%ERRORLEVEL%"

echo %RC%>"%EXIT_FILE%"

echo ================================================================>>"%LOG_FILE%"
echo END KATALON RC=%RC%>>"%LOG_FILE%"
echo EXIT_FILE=%EXIT_FILE%>>"%LOG_FILE%"
echo ================================================================>>"%LOG_FILE%"

exit /b %RC%
