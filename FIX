class JiraExecutionPublisher {

	private final JiraFlowCoordinator flow
	private final JiraGateway gateway

	JiraExecutionPublisher(JiraFlowCoordinator flow, JiraGateway gateway) {
		this.flow = flow
		this.gateway = gateway
	}

	Map publishExecution(String xmlPath, String executionSummary, String testPlanKey, String customReportPath) {
		Map result = [
			executionKey         : '',
			customReportStatus   : 'SKIPPED',
			evidencesStatus      : 'SKIPPED',
			resultsStatus        : 'SKIPPED',
			updateExecutionStatus: 'SKIPPED'
		]

		File junitFile = new File(xmlPath)
		if (!junitFile.exists()) {
			result.executionKey = 'ERROR_JUNIT_NOT_FOUND'
			return result
		}

		Map importResponse = gateway.importExecutionResults(junitFile, flow.PROJECT_KEY, testPlanKey)
		if (!importResponse.ok) {
			result.executionKey = 'ERROR_IMPORT_EXECUTION'
			return result
		}

		String executionKey = resolveExecutionKey(importResponse.json)
		if (flow.isBlank(executionKey)) {
			result.executionKey = 'ERROR_IMPORT_EXECUTION'
			return result
		}

		result.executionKey = executionKey

		Map fields = [
			summary: executionSummary
		]

		List<String> labels = flow.splitLabels()
		if (!labels.isEmpty()) {
			fields.labels = labels
		}

		Map updateResponse = gateway.updateIssueFields(executionKey, fields)
		result.updateExecutionStatus = updateResponse.ok ? 'OK' : 'FAILED'

		if (!flow.isBlank(flow.ASSIGNEE_NAME)) {
			gateway.assignIssue(executionKey, flow.ASSIGNEE_NAME)
		}

		File reportFolder = junitFile.parentFile
		File customReport = flow.isBlank(customReportPath) ? null : new File(customReportPath)
		File resultsZip = zipFlatFiles(reportFolder)
		File evidencesZip = zipFolderIfHasFiles(new File(reportFolder, flow.EVIDENCE_FOLDER_NAME), flow.EVIDENCE_ZIP_NAME)

		if (customReport != null && customReport.exists()) {
			Map customUpload = gateway.uploadAttachment(executionKey, customReport)
			result.customReportStatus = customUpload.ok ? 'OK' : 'FAILED'
		}

		if (resultsZip != null && resultsZip.exists()) {
			Map resultsUpload = gateway.uploadAttachment(executionKey, resultsZip)
			result.resultsStatus = resultsUpload.ok ? 'OK' : 'FAILED'
		}

		if (evidencesZip != null && evidencesZip.exists()) {
			Map evidencesUpload = gateway.uploadAttachment(executionKey, evidencesZip)
			result.evidencesStatus = evidencesUpload.ok ? 'OK' : 'FAILED'
		}

		return result
	}

	private String resolveExecutionKey(def json) {
		String key = flow.safe(json?.testExecIssue?.key)
		if (!flow.isBlank(key)) {
			return key
		}

		key = flow.safe(json?.key)
		if (!flow.isBlank(key)) {
			return key
		}

		return ''
	}

	private File zipFlatFiles(File reportFolder) {
		if (reportFolder == null || !reportFolder.exists() || !reportFolder.isDirectory()) {
			return null
		}

		File zipFile = new File(reportFolder, flow.RESULT_ZIP_NAME)
		if (zipFile.exists()) {
			zipFile.delete()
		}

		ZipOutputStream output = null
		try {
			output = new ZipOutputStream(new FileOutputStream(zipFile))

			File[] files = reportFolder.listFiles()
			if (files == null) {
				return null
			}

			for (File file : files) {
				if (file == null || !file.isFile()) {
					continue
				}

				if (file.name.equalsIgnoreCase(zipFile.name)) {
					continue
				}

				addFileToZip(output, file, file.name)
			}

			return zipFile
		} catch (Exception e) {
			KeywordUtil.logInfo("Results.zip creation skipped: ${e.message}")
			return null
		} finally {
			try { output?.close() } catch (Exception ignored) {}
		}
	}

	private File zipFolderIfHasFiles(File folder, String zipName) {
		if (folder == null || !folder.exists() || !folder.isDirectory()) {
			return null
		}

		File[] files = folder.listFiles()
		if (files == null) {
			return null
		}

		List<File> onlyFiles = []
		for (File file : files) {
			if (file != null && file.isFile()) {
				onlyFiles << file
			}
		}

		if (onlyFiles.isEmpty()) {
			return null
		}

		File zipFile = new File(folder, zipName)
		if (zipFile.exists()) {
			zipFile.delete()
		}

		ZipOutputStream output = null
		try {
			output = new ZipOutputStream(new FileOutputStream(zipFile))
			for (File file : onlyFiles) {
				if (file.name.equalsIgnoreCase(zipFile.name)) {
					continue
				}
				addFileToZip(output, file, file.name)
			}
			return zipFile
		} catch (Exception e) {
			KeywordUtil.logInfo("${zipName} creation skipped: ${e.message}")
			return null
		} finally {
			try { output?.close() } catch (Exception ignored) {}
		}
	}

	private void addFileToZip(ZipOutputStream output, File file, String entryName) {
		FileInputStream input = null
		try {
			output.putNextEntry(new ZipEntry(entryName))
			input = new FileInputStream(file)
			byte[] buffer = new byte[8192]
			int read = 0
			while ((read = input.read(buffer)) != -1) {
				output.write(buffer, 0, read)
			}
			output.closeEntry()
		} finally {
			try { input?.close() } catch (Exception ignored) {}
		}
	}
