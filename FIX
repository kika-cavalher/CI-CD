    void collectXmlFiles(File currentDir, List<File> preferred, List<File> secondary, List<File> fallback) {
        if (currentDir == null || !currentDir.exists() || !currentDir.isDirectory()) {
            return
        }

        File[] children = currentDir.listFiles()
        if (children == null) {
            return
        }

        String primary = safe(PRIMARY_XML_FILE_NAME).toLowerCase(Locale.ENGLISH)
        String secondaryName = safe(SECONDARY_XML_FILE_NAME).toLowerCase(Locale.ENGLISH)

        for (File child : children) {
            if (child == null) {
                continue
            }

            if (child.isDirectory()) {
                collectXmlFiles(child, preferred, secondary, fallback)
                continue
            }

            String lower = safe(child.name).toLowerCase(Locale.ENGLISH)
            if (lower == primary) {
                preferred.add(child)
            } else if (lower == secondaryName) {
                secondary.add(child)
            } else if (lower.endsWith('.xml')) {
                fallback.add(child)
            }
        }
    }

    String findXmlFile(String reportFolder) {
        if (isBlank(reportFolder)) {
            return ''
        }

        File root = new File(reportFolder)
        if (!root.exists() || !root.isDirectory()) {
            return ''
        }

        List<File> preferred = new ArrayList<File>()
        List<File> secondary = new ArrayList<File>()
        List<File> fallback = new ArrayList<File>()

        collectXmlFiles(root, preferred, secondary, fallback)

        if (!preferred.isEmpty()) {
            preferred.sort { File a, File b -> b.lastModified() <=> a.lastModified() }
            return preferred[0].absolutePath
        }

        if (!secondary.isEmpty()) {
            secondary.sort { File a, File b -> b.lastModified() <=> a.lastModified() }
            return secondary[0].absolutePath
        }

        if (!fallback.isEmpty()) {
            fallback = fallback.findAll { File file ->
                String lowerPath = safe(file.absolutePath).toLowerCase(Locale.ENGLISH)
                return !lowerPath.contains(File.separator.toLowerCase(Locale.ENGLISH) + 'requests' + File.separator.toLowerCase(Locale.ENGLISH)) &&
                       !lowerPath.contains(File.separator.toLowerCase(Locale.ENGLISH) + 'videos' + File.separator.toLowerCase(Locale.ENGLISH))
            }
            if (!fallback.isEmpty()) {
                fallback.sort { File a, File b -> b.lastModified() <=> a.lastModified() }
                return fallback[0].absolutePath
            }
        }

        return ''
    }

