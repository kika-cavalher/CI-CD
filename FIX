	boolean waitUntilFileReady(String filePath, int maxAttempts = 12, int sleepMillis = 500) {
		if (isBlank(filePath)) {
			return false
		}

		File file = new File(filePath)
		if (!file.exists()) {
			return false
		}

		for (int i = 0; i < maxAttempts; i++) {
			RandomAccessFile raf = null
			try {
				raf = new RandomAccessFile(file, 'r')
				raf.length()
				return true
			} catch (Exception ignored) {
			} finally {
				try { if (raf != null) raf.close() } catch (Exception ignored) {}
			}
			Thread.sleep(sleepMillis)
		}

		return false
	}

	String createSafeUploadCopy(String originalFilePath, String preferredName) {
		if (isBlank(originalFilePath)) {
			return ''
		}

		File original = new File(originalFilePath)
		if (!original.exists() || original.length() == 0) {
			return ''
		}

		waitUntilFileReady(original.absolutePath, 12, 500)

		File tmpFolder = new File(getResolvedReportPath() + File.separator + '_jira_upload_tmp')
		if (!tmpFolder.exists()) {
			tmpFolder.mkdirs()
		}

		String finalName = isBlank(preferredName) ? original.name : preferredName
		File copied = new File(tmpFolder, finalName)

		if (copied.exists()) {
			copied.delete()
		}

		Files.copy(original.toPath(), copied.toPath(), StandardCopyOption.REPLACE_EXISTING)
		waitUntilFileReady(copied.absolutePath, 12, 500)

		return copied.absolutePath
	}

	String zipReports() {
		String reportPath = getResolvedReportPath()
		if (isBlank(reportPath)) {
			return ''
		}

		String zippedFile = reportPath + File.separator + REPORT_ZIP_NAME
		File zipFile = new File(zippedFile)
		if (zipFile.exists()) {
			zipFile.delete()
		}

		ZipOutputStream output = new ZipOutputStream(new FileOutputStream(zipFile))
		try {
			new File(reportPath).eachFile { File file ->
				if (!file.isFile()) return
				if (file.name.equalsIgnoreCase(REPORT_ZIP_NAME)) return
				if (file.name.equalsIgnoreCase(GAIA_REPORT_FILE_NAME)) return
				output.putNextEntry(new ZipEntry(file.name))
				FileInputStream input = new FileInputStream(file)
				try {
					byte[] buffer = new byte[4096]
					int read
					while ((read = input.read(buffer)) != -1) {
						output.write(buffer, 0, read)
					}
				} finally {
					input.close()
				}
				output.closeEntry()
			}
		} finally {
			output.close()
		}

		return zipFile.absolutePath
	}

	String zipEvidences() {
		String reportPath = getResolvedReportPath()
		if (isBlank(reportPath)) {
			return ''
		}

		File evidenceFolder = new File(reportPath + File.separator + EVIDENCE_FOLDER_NAME)
		if (!evidenceFolder.exists()) {
			return ''
		}

		File zipFile = new File(evidenceFolder.absolutePath + File.separator + EVIDENCE_ZIP_NAME)
		if (zipFile.exists()) {
			zipFile.delete()
		}

		ZipOutputStream output = new ZipOutputStream(new FileOutputStream(zipFile))
		try {
			evidenceFolder.eachFileRecurse(FileType.FILES) { File file ->
				if (file.name.equalsIgnoreCase(EVIDENCE_ZIP_NAME)) return
				String relativeName = evidenceFolder.toPath().relativize(file.toPath()).toString().replace('\\', '/')
				output.putNextEntry(new ZipEntry(relativeName))
				FileInputStream input = new FileInputStream(file)
				try {
					byte[] buffer = new byte[4096]
					int read
					while ((read = input.read(buffer)) != -1) {
						output.write(buffer, 0, read)
					}
				} finally {
					input.close()
				}
				output.closeEntry()
			}
		} finally {
			output.close()
		}

		return zipFile.absolutePath
	}

