def stopGaiaProcesses(script, String reason) {
    script.echo "🧹 Stopping Gaia processes | ${reason}"

    script.withEnv([
        "BACK_CMD_TITLE=${script.env.BACK_CMD_TITLE}",
        "FRONT_CMD_TITLE=${script.env.FRONT_CMD_TITLE}",
        "BACK_PORT=${script.env.BACK_PORT}",
        "FRONT_PORT=${script.env.FRONT_PORT}"
    ]) {
        script.powershell(
            returnStatus: true,
            script: '''
$ErrorActionPreference = 'SilentlyContinue'
$ProgressPreference = 'SilentlyContinue'

function Stop-CmdTreeByTitle {
    param([string]$Title)
    cmd /c "taskkill /FI ""WINDOWTITLE eq $Title"" /T /F" | Out-Null 2>&1
}

function Stop-ProcessListeningOnPort {
    param([int]$Port)

    try {
        $owners = Get-NetTCPConnection -LocalPort $Port -ErrorAction SilentlyContinue |
            Select-Object -ExpandProperty OwningProcess -Unique

        foreach ($ownerPid in $owners) {
            if ($ownerPid) {
                Stop-Process -Id $ownerPid -Force -ErrorAction SilentlyContinue
            }
        }
    }
    catch {
    }
}

function Stop-ExtraGaiaProcesses {
    $targets = Get-CimInstance Win32_Process -ErrorAction SilentlyContinue | Where-Object {
        $cmd = [string]$_.CommandLine
        $name = [string]$_.Name

        ($cmd -match 'gaia-start-back\\.bat') -or
        ($cmd -match 'gaia-start-front\\.bat') -or
        ($cmd -match 'web_portal_back') -or
        ($cmd -match 'web_portal') -or
        ($cmd -match 'mvn spring-boot:run') -or
        ($cmd -match 'npm start') -or
        ($cmd -match $env:BACK_CMD_TITLE) -or
        ($cmd -match $env:FRONT_CMD_TITLE) -or
        (($name -match 'cmd\\.exe|java\\.exe|node\\.exe') -and ($cmd -match 'gaia'))
    }

    foreach ($proc in ($targets | Sort-Object ProcessId -Descending)) {
        try {
            Stop-Process -Id $proc.ProcessId -Force -ErrorAction SilentlyContinue
        }
        catch {
        }
    }
}

Stop-CmdTreeByTitle -Title $env:BACK_CMD_TITLE
Stop-CmdTreeByTitle -Title $env:FRONT_CMD_TITLE

Start-Sleep -Seconds 1

Stop-ProcessListeningOnPort -Port ([int]$env:BACK_PORT)
Stop-ProcessListeningOnPort -Port ([int]$env:FRONT_PORT)

Start-Sleep -Seconds 1

Stop-ExtraGaiaProcesses

Write-Host '[OK] Gaia CMD windows and child processes stopped'
exit 0
'''
        )
    }
}

