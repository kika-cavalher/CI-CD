def streamCurrentLogUntilMarker(script, Map cfg) {
    script.withEnv([
        "MARKER_FILE=${cfg.markerFile}",
        "CURRENT_LOG_FILE=${cfg.currentLogFile}",
        "RUN_TIMEOUT_MINUTES=${cfg.timeoutMinutes.toString()}"
    ]) {
        script.timeout(time: cfg.timeoutMinutes as int, unit: 'MINUTES') {
            script.powershell(
                script: '''
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

function Clean-Text {
    param([string]$Value)

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return ''
    }

    return (($Value -replace '[\\r\\n]+', ' ') -replace '\\s+', ' ').Trim()
}

function Read-NewContent {
    param(
        [string]$Path,
        [ref]$Offset
    )

    if (-not (Test-Path -LiteralPath $Path)) {
        return @()
    }

    $fs = $null
    $sr = $null

    try {
        $fs = [System.IO.File]::Open($Path, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, [System.IO.FileShare]::ReadWrite)
        [void]$fs.Seek($Offset.Value, [System.IO.SeekOrigin]::Begin)
        $sr = New-Object System.IO.StreamReader($fs)
        $content = $sr.ReadToEnd()
        $Offset.Value = $fs.Position

        if ([string]::IsNullOrWhiteSpace($content)) {
            return @()
        }

        return @($content -split "`r?`n")
    }
    catch {
        return @()
    }
    finally {
        if ($sr) { $sr.Close() }
        if ($fs) { $fs.Close() }
    }
}

$logPath = $env:CURRENT_LOG_FILE
$markerPath = $env:MARKER_FILE
$timeoutMinutes = [int]$env:RUN_TIMEOUT_MINUTES

$offset = 0L
$deadline = (Get-Date).AddMinutes($timeoutMinutes)
$lastHeartbeat = Get-Date

Write-Host "[INFO] Waiting for desktop execution..."
Write-Host "[INFO] Live log file : $logPath"
Write-Host "[INFO] Marker file   : $markerPath"

while ((Get-Date) -lt $deadline) {
    $newLines = Read-NewContent -Path $logPath -Offset ([ref]$offset)

    if ($newLines.Count -gt 0) {
        foreach ($line in $newLines) {
            $text = Clean-Text $line
            if (-not [string]::IsNullOrWhiteSpace($text)) {
                Write-Host ("[KATALON] " + $text)
            }
        }
        $lastHeartbeat = Get-Date
    }
    else {
        if ((New-TimeSpan -Start $lastHeartbeat -End (Get-Date)).TotalSeconds -ge 15) {
            Write-Host "[WAIT] Desktop run is still active. Waiting for new log lines..."
            $lastHeartbeat = Get-Date
        }
    }

    if (Test-Path -LiteralPath $markerPath) {
        break
    }

    Start-Sleep -Seconds 2
}

$newLines = Read-NewContent -Path $logPath -Offset ([ref]$offset)
if ($newLines.Count -gt 0) {
    foreach ($line in $newLines) {
        $text = Clean-Text $line
        if (-not [string]::IsNullOrWhiteSpace($text)) {
            Write-Host ("[KATALON] " + $text)
        }
    }
}

if (-not (Test-Path -LiteralPath $markerPath)) {
    throw "Marker file was not created within timeout: $markerPath"
}
'''
            )
        }
    }
}

def readMarkerExitCode(script, String markerFile) {
    def raw = script.withEnv(["MARKER_FILE=${markerFile}"]) {
        script.powershell(
            returnStdout: true,
            script: '''
$path = $env:MARKER_FILE
$maxAttempts = 15

for ($i = 1; $i -le $maxAttempts; $i++) {
    try {
        if (Test-Path -LiteralPath $path) {
            $content = Get-Content -LiteralPath $path -ErrorAction Stop | Select-Object -First 1
            if ($null -ne $content -and $content.ToString().Trim() -ne '') {
                Write-Output $content.ToString().Trim()
                exit 0
            }
        }
    }
    catch {
    }

    Start-Sleep -Seconds 2
}

throw "Unable to read marker file: $path"
'''
        ).trim()
    }

    try {
        return Integer.parseInt(raw)
    } catch (Exception ignored) {
        return 999
    }
}

def readJunitSummary(script, String reportsDir) {
    def raw = script.powershell(
        returnStdout: true,
        script: """
\$root = '${reportsDir}'
\$result = [ordered]@{
    path = ''
    executed = 0
    failed = 0
    skipped = 0
    passed = 0
}

\$junit = Get-ChildItem -Path \$root -Filter 'JUnit_Report.xml' -File -Recurse -ErrorAction SilentlyContinue |
    Sort-Object LastWriteTime -Descending |
    Select-Object -First 1

if (\$junit) {
    \$result.path = \$junit.FullName

    try {
        [xml]\$xml = Get-Content -LiteralPath \$junit.FullName -Raw
        \$testcases = @()

        if (\$xml.testsuite) {
            \$testcases = @(\$xml.testsuite.testcase)
        }
        elseif (\$xml.testsuites) {
            foreach (\$ts in @(\$xml.testsuites.testsuite)) {
                \$testcases += @(\$ts.testcase)
            }
        }

        \$testcases = @(\$testcases | Where-Object { \$_ })
        \$result.executed = \$testcases.Count
        \$result.failed = @(\$testcases | Where-Object { \$_.failure -or \$_.error }).Count
        \$result.skipped = @(\$testcases | Where-Object { \$_.skipped }).Count
        \$result.passed = \$result.executed - \$result.failed - \$result.skipped
    }
    catch {
    }
}

\$result | ConvertTo-Json -Compress
"""
    ).trim()

    if (!raw) {
        return [path: '', executed: 0, failed: 0, skipped: 0, passed: 0]
    }

    return new JsonSlurperClassic().parseText(raw) as Map
}

def runDesktopSuite(script, Map cfg) {
    script.bat """
@echo off
echo ------------------------------------------------------------
echo START ASSET: ${cfg.suiteName}
echo TASK: ${cfg.taskName}
echo ------------------------------------------------------------
schtasks /run /tn "${cfg.taskName}"
exit /b %ERRORLEVEL%
"""

    streamCurrentLogUntilMarker(script, cfg)

    int exitCode = readMarkerExitCode(script, cfg.markerFile)
    Map junit = readJunitSummary(script, cfg.reportsDir)

    script.echo '============================================================'
    script.echo "📦 Suite    : ${cfg.suiteName}"
    script.echo "📄 JUnit    : ${junit.path ?: 'not found'}"
    script.echo "🧪 Executed : ${junit.executed ?: 0}"
    script.echo "✅ Passed   : ${junit.passed ?: 0}"
    script.echo "❌ Failed   : ${junit.failed ?: 0}"
    script.echo "⏭️ Skipped  : ${junit.skipped ?: 0}"
    script.echo "🔢 ExitCode : ${exitCode}"
    script.echo '============================================================'

    boolean junitGreen = ((junit.executed ?: 0) > 0) && ((junit.failed ?: 0) == 0)
    boolean softPass = cfg.allowExit3WhenJunitGreen && exitCode == 3 && junitGreen

    if (softPass) {
        script.currentBuild.description = "${cfg.suiteName} | ✅ JUnit OK | Exit=3"
        script.echo "⚠️ Exit code 3 ignored because JUnit is green."
        return
    }

    script.currentBuild.description = "${cfg.suiteName} | Exit=${exitCode}"

    if (exitCode != 0 || (junit.failed ?: 0) > 0) {
        script.error("Desktop execution failed. Check Reports\\_desktop_logs\\katalon_current.log")
    }
}

pipeline {
    agent {
        node {
            label SUITE.NODE_LABEL
            customWorkspace SUITE.CUSTOM_WORKSPACE_PATH
        }
    }

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        timeout(time: 4, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '20', daysToKeepStr: '30'))
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "Workspace: ${pwd()}"
            }
        }

        stage('Prepare Context + Reports') {
            steps {
                script {
                    def cfg = buildSuiteConfig(this)
                    prepareContext(this, cfg)
                }
            }
        }

        stage('Run Desktop') {
            steps {
                script {
                    def cfg = buildSuiteConfig(this)
                    runDesktopSuite(this, cfg)
                }
            }
        }
    }

    post {
        always {
            script {
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    archiveArtifacts artifacts: 'Reports/**', allowEmptyArchive: true
                }

                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    junit allowEmptyResults: true, testResults: 'Reports/**/JUnit_Report.xml,Reports/**/JUnit*.xml,Reports/**/junit*.xml'
                }
            }
        }
    }
}





