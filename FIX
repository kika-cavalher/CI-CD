	private List<RemoteWebElement> waitForDefaultDateElements(
			Integer timeoutSeconds
		) {

		WindowsTestObject datesObject =
			new WindowsTestObject('investigationsDefaultDates')

		datesObject.setLocatorStrategy(LocatorStrategy.XPATH)
		datesObject.setLocator("//*[@AutomationId='LstSelection']/*")

		long endTime = System.currentTimeMillis() +
			(timeoutSeconds * 1000L)

		List<RemoteWebElement> latestElements = []

		while (System.currentTimeMillis() <= endTime) {
			try {
				List<WindowsTestObject> elements =
					Windows.findElements(datesObject)

				if (elements != null && !elements.isEmpty()) {
					latestElements = elements.collect {
						it as RemoteWebElement
					}

					if (latestElements.size() == 2) {
						return latestElements
					}
				}
			} catch (Throwable ignored) {
			}

			Windows.delay(POLLING_DELAY_SECONDS)
		}

		if (!latestElements.isEmpty()) {
			return latestElements
		}

		KeywordUtil.markFailedAndStop(
			'Default selected dates were not displayed in the popup.'
		)

		return []
	}

	private String resolveClosingDate() {
		String closingDate = safeText(GlobalVariable.arreteDate)

		if (closingDate.isEmpty()) {
			closingDate = safeText(
				new MenuHandling().getArreteDateWithSlash()
			)

			GlobalVariable.arreteDate = closingDate
		}

		if (closingDate.isEmpty()) {
			KeywordUtil.markFailedAndStop(
				'Closing date could not be resolved for popup validation.'
			)
		}

		return closingDate
	}

	private Boolean isQuarterDate(String dateText) {
		return safeText(dateText) ==~ /.*\/(03|06|09|12)\/.*/
	}


	// ======================================================
	// INTERNAL EXCEL HELPERS
	// ======================================================

	private BigDecimal readMainTotalCcy(File file) {
		Workbook workbook = null
		FileInputStream inputStream = null

		try {
			inputStream = new FileInputStream(file)
			workbook = WorkbookFactory.create(inputStream)

			if (workbook.numberOfSheets <= 0) {
				KeywordUtil.markFailedAndStop(
					'Main investigations export has no worksheet: ' +
					file.name
				)
			}

			Sheet sheet = workbook.getSheetAt(0)
			HeaderLocation header = findHeader(
				sheet,
				'Total (ccy)'
			)

			if (header == null) {
				KeywordUtil.markFailedAndStop(
					'Column Total (ccy) was not found in main export: ' +
					file.name
				)
			}

			FormulaEvaluator evaluator =
				workbook.creationHelper.createFormulaEvaluator()

			for (Integer rowIndex = header.rowIndex + 1;
				rowIndex <= sheet.lastRowNum;
				rowIndex++) {

				Row row = sheet.getRow(rowIndex)

				if (row == null) {
					continue
				}

				BigDecimal value = numericCellValue(
					row.getCell(header.columnIndex),
					evaluator
				)

				if (value != null) {
					return value
				}
			}

			KeywordUtil.markFailedAndStop(
				'No numeric value was found below Total (ccy) in main export: ' +
				file.name
			)
		} finally {
			try {
				workbook?.close()
			} catch (Throwable ignored) {
			}

			try {
				inputStream?.close()
			} catch (Throwable ignored) {
			}
		}

		return null
	}

	private Boolean detailContainsMontantCcy(
			File file,
			BigDecimal reference
		) {

		Workbook workbook = null
		FileInputStream inputStream = null

		try {
			inputStream = new FileInputStream(file)
			workbook = WorkbookFactory.create(inputStream)

			if (workbook.numberOfSheets <= 0) {
				KeywordUtil.markFailedAndStop(
					'Detail export has no worksheet: ' + file.name
				)
			}

			Sheet sheet = workbook.getSheetAt(0)
			HeaderLocation header = findHeader(
				sheet,
				'Montant ccy'
			)

			if (header == null) {
				KeywordUtil.markFailedAndStop(
					'Column Montant ccy was not found in detail export: ' +
					file.name
				)
			}

			FormulaEvaluator evaluator =
				workbook.creationHelper.createFormulaEvaluator()

			BigDecimal expected = reference.abs().setScale(
				0,
				RoundingMode.HALF_UP
			)

			for (Integer rowIndex = header.rowIndex + 1;
				rowIndex <= sheet.lastRowNum;
				rowIndex++) {

				Row row = sheet.getRow(rowIndex)

				if (row == null) {
					continue
				}

				BigDecimal value = numericCellValue(
					row.getCell(header.columnIndex),
					evaluator
				)

				if (value == null) {
					continue
				}

				BigDecimal actual = value.abs().setScale(
					0,
					RoundingMode.HALF_UP
				)

				if (actual.compareTo(expected) == 0) {
					return true
				}
			}

			return false
		} finally {
			try {
				workbook?.close()
			} catch (Throwable ignored) {
			}

			try {
				inputStream?.close()
			} catch (Throwable ignored) {
			}
		}
	}

	private HeaderLocation findHeader(
			Sheet sheet,
			String expectedHeader
		) {

		DataFormatter formatter =
			new DataFormatter(Locale.ROOT)

		Integer maxRow = Math.min(
			sheet.lastRowNum,
			20
		)

		for (Integer rowIndex = 0;
			rowIndex <= maxRow;
			rowIndex++) {

			Row row = sheet.getRow(rowIndex)

			if (row == null) {
				continue
			}

			for (Cell cell : row) {
				String headerText = safeText(
					formatter.formatCellValue(cell)
				)

				if (headerText.equalsIgnoreCase(expectedHeader)) {
					return new HeaderLocation(
						rowIndex,
						cell.columnIndex
					)
				}
			}
		}

		return null
	}

	private BigDecimal numericCellValue(
			Cell cell,
			FormulaEvaluator evaluator
		) {

		if (cell == null) {
			return null
		}

		try {
			if (cell.cellType == CellType.NUMERIC) {
				return BigDecimal.valueOf(
					cell.numericCellValue
				)
			}

			if (cell.cellType == CellType.FORMULA) {
				CellValue evaluated = evaluator.evaluate(cell)

				if (evaluated != null &&
					evaluated.cellType == CellType.NUMERIC) {

					return BigDecimal.valueOf(
						evaluated.numberValue
					)
				}

				if (evaluated != null &&
					evaluated.cellType == CellType.STRING) {

					return parseBigDecimal(
						evaluated.stringValue
					)
				}
			}

			if (cell.cellType == CellType.STRING) {
				return parseBigDecimal(
					cell.stringCellValue
				)
			}

			DataFormatter formatter =
				new DataFormatter(Locale.ROOT)

			return parseBigDecimal(
				formatter.formatCellValue(cell, evaluator)
			)
		} catch (Throwable ignored) {
			return null
		}
	}

	private BigDecimal parseBigDecimal(Object rawValue) {
		String value = safeText(rawValue)

		if (value.isEmpty()) {
			return null
		}

		value = value
			.replace('\u00A0', '')
			.replace(' ', '')
			.replaceAll('[^0-9,.-]', '')

		if (value.isEmpty() ||
			value.equals('-') ||
			value.equals('.') ||
			value.equals(',')) {

			return null
		}

		Integer lastComma = value.lastIndexOf(',')
		Integer lastDot = value.lastIndexOf('.')

		if (lastComma >= 0 && lastDot >= 0) {
			if (lastComma > lastDot) {
				value = value.replace('.', '')
				value = value.replace(',', '.')
			} else {
				value = value.replace(',', '')
			}
		} else if (lastComma >= 0) {
			value = value.replace(',', '.')
		}

		try {
			return new BigDecimal(value)
		} catch (Throwable ignored) {
			return null
		}
	}


