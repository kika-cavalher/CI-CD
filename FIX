package commands

import java.nio.charset.Charset
import java.nio.file.Files
import java.text.Normalizer

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration

import internal.GlobalVariable

class TestToolValidationKeywords {

	private static final String TEST_TOOL_RELATIVE_FOLDER = 'Data Files/TestTool'
	private static final String FILE_PREFIX = 'outputfileSqlServerRNR_'
	private static final String FILE_EXTENSION = '.csv'
	private static final String EXPECTED_RESULT = 'OK'

	private static final String SOURCE_TABLE_KEY = 'sourceTable'
	private static final String RESULT_TEST_TOP_KEY = 'resultTestTop'
	private static final String RESULT_TEST_DISTINCT_KEY = 'resultTestDistinct'
	private static final String RESULT_TEST_COUNT_KEY = 'resultTestCount'

	// ======================================================
	// PUBLIC KEYWORD
	// ======================================================

	@Keyword
	Map validateSourceTable(String expectedSourceTable) {
		Map result = createInitialResult(expectedSourceTable)

		if (safeText(expectedSourceTable).isEmpty()) {
			return failResult(
				result,
				'Expected source table is empty.',
				'CONFIGURATION',
				'VALID SOURCE TABLE',
				'EMPTY',
				0
			)
		}

		String version = safeText(GlobalVariable.version)

		if (version.isEmpty()) {
			return failResult(
				result,
				'GlobalVariable.version is empty.',
				'GLOBAL VARIABLE',
				'RELEASE VERSION',
				'EMPTY',
				0
			)
		}

		File sourceFile = resolveTestToolFile(version)

		result.version = version
		result.fileName = sourceFile.getName()
		result.filePath = sourceFile.getAbsolutePath()

		if (!sourceFile.exists() || !sourceFile.isFile()) {
			return failResult(
				result,
				'Test Tool result file was not found.',
				'FILE',
				sourceFile.getAbsolutePath(),
				'NOT FOUND',
				0
			)
		}

		if (sourceFile.length() <= 0) {
			return failResult(
				result,
				'Test Tool result file is empty.',
				'FILE',
				'NON-EMPTY FILE',
				'EMPTY',
				0
			)
		}

		try {
			return validateCsvFile(sourceFile, result, expectedSourceTable)
		} catch (Throwable error) {
			return failResult(
				result,
				'Test Tool validation could not be completed. Reason: ' + getErrorMessage(error),
				'VALIDATION EXECUTION',
				'SUCCESS',
				getErrorMessage(error),
				0
			)
		}
	}

	// ======================================================
	// CSV VALIDATION
	// ======================================================

	private Map validateCsvFile(File sourceFile, Map result, String expectedSourceTable) {
		List<String> lines = readCsvLines(sourceFile)

		if (lines.isEmpty()) {
			return failResult(
				result,
				'The Test Tool CSV file does not contain data.',
				'CSV CONTENT',
				'NON-EMPTY FILE',
				'EMPTY',
				0
			)
		}

		Character separator = detectSeparator(lines)
		Integer headerLineIndex = -1
		Map<String, Integer> headerIndexes = [:]
		Integer maximumHeaderLine = Math.min(lines.size() - 1, 20)

		for (Integer lineIndex = 0; lineIndex <= maximumHeaderLine; lineIndex++) {
			List<String> values = parseDelimitedLine(lines.get(lineIndex), separator)
			Map<String, Integer> currentIndexes = findHeaderIndexes(values)

			if (currentIndexes.containsKey(SOURCE_TABLE_KEY)) {
				headerLineIndex = lineIndex
				headerIndexes = currentIndexes
				break
			}
		}

		if (headerLineIndex < 0) {
			return failResult(
				result,
				'Test Tool header was not found.',
				'SETTING : Source_Table',
				'EXISTING COLUMN',
				'NOT FOUND',
				1
			)
		}

		String missingColumn = findMissingColumn(headerIndexes)

		if (!missingColumn.isEmpty()) {
			return failResult(
				result,
				'Required Test Tool column was not found.',
				missingColumn,
				'EXISTING COLUMN',
				'NOT FOUND',
				headerLineIndex + 1
			)
		}

		for (Integer lineIndex = headerLineIndex + 1; lineIndex < lines.size(); lineIndex++) {
			List<String> values = parseDelimitedLine(lines.get(lineIndex), separator)

			String completeSourceTable = getListValue(
				values,
				headerIndexes.get(SOURCE_TABLE_KEY)
			)

			String sourceTable = removeSourceTablePrefix(completeSourceTable)

			if (!isSameText(sourceTable, expectedSourceTable)) {
				continue
			}

			return validateResultRow(
				result,
				lineIndex + 1,
				completeSourceTable,
				sourceTable,
				getListValue(values, headerIndexes.get(RESULT_TEST_TOP_KEY)),
				getListValue(values, headerIndexes.get(RESULT_TEST_DISTINCT_KEY)),
				getListValue(values, headerIndexes.get(RESULT_TEST_COUNT_KEY))
			)
		}

		return failResult(
			result,
			'Expected source table was not found in the Test Tool file.',
			'SETTING : Source_Table',
			expectedSourceTable,
			'NOT FOUND',
			0
		)
	}

	// ======================================================
	// RESULT VALIDATION
	// ======================================================

	private Map validateResultRow(
			Map result,
			Integer rowNumber,
			String completeSourceTable,
			String sourceTable,
			String resultTestTop,
			String resultTestDistinct,
			String resultTestCount) {

		result.completeSourceTable = completeSourceTable
		result.sourceTable = sourceTable
		result.rowNumber = rowNumber
		result.resultTestTop = resultTestTop
		result.resultTestDistinct = resultTestDistinct
		result.resultTestCount = resultTestCount

		List<Map> validations = [
			[column: 'RESULT TEST_TOP', value: resultTestTop],
			[column: 'RESULT TEST_DISTINCT', value: resultTestDistinct],
			[column: 'RESULT TEST_COUNT', value: resultTestCount]
		]

		for (Map validation : validations) {
			String columnName = safeText(validation.column)
			String actualValue = safeText(validation.value)

			if (!isSameText(actualValue, EXPECTED_RESULT)) {
				return failResult(
					result,
					'Test Tool result column does not contain the expected value.',
					columnName,
					EXPECTED_RESULT,
					actualValue.isEmpty() ? 'EMPTY' : actualValue,
					rowNumber
				)
			}
		}

		result.success = true
		result.errors = ''
		result.failedColumn = ''
		result.expectedValue = EXPECTED_RESULT
		result.actualValue = ''
		result.message = 'All required Test Tool result columns contain OK.'

		return result
	}

	// ======================================================
	// HEADER RESOLUTION
	// ======================================================

	private Map<String, Integer> findHeaderIndexes(List<String> headerValues) {
		Map<String, Integer> indexes = [:]

		for (Integer index = 0; index < headerValues.size(); index++) {
			String headerKey = resolveHeaderKey(headerValues.get(index))

			if (!headerKey.isEmpty() && !indexes.containsKey(headerKey)) {
				indexes.put(headerKey, index)
			}
		}

		return indexes
	}

	private String resolveHeaderKey(String headerValue) {
		String normalizedHeader = normalizeHeader(headerValue)

		if (normalizedHeader == 'setting source table' ||
			normalizedHeader == 'source table') {

			return SOURCE_TABLE_KEY
		}

		if (normalizedHeader == 'result test top') {
			return RESULT_TEST_TOP_KEY
		}

		if (normalizedHeader == 'result test distinct') {
			return RESULT_TEST_DISTINCT_KEY
		}

		if (normalizedHeader == 'result test count') {
			return RESULT_TEST_COUNT_KEY
		}

		return ''
	}

	private String findMissingColumn(Map<String, Integer> headerIndexes) {
		List<Map> requiredColumns = [
			[key: SOURCE_TABLE_KEY, name: 'SETTING : Source_Table'],
			[key: RESULT_TEST_TOP_KEY, name: 'RESULT TEST_TOP'],
			[key: RESULT_TEST_DISTINCT_KEY, name: 'RESULT TEST_DISTINCT'],
			[key: RESULT_TEST_COUNT_KEY, name: 'RESULT TEST_COUNT']
		]

		for (Map requiredColumn : requiredColumns) {
			String key = requiredColumn.key as String

			if (!headerIndexes.containsKey(key)) {
				return requiredColumn.name as String
			}
		}

		return ''
	}

	// ======================================================
	// FILE RESOLUTION
	// ======================================================

	private File resolveTestToolFile(String version) {
		String fileName = FILE_PREFIX + version + FILE_EXTENSION

		String relativeFolder = TEST_TOOL_RELATIVE_FOLDER
			.replace('/', File.separator)
			.replace('\\', File.separator)

		return new File(
			RunConfiguration.getProjectDir(),
			relativeFolder + File.separator + fileName
		)
	}

	private List<String> readCsvLines(File sourceFile) {
		List<Charset> charsets = [
			Charset.forName('UTF-8'),
			Charset.forName('windows-1252'),
			Charset.defaultCharset()
		]

		Throwable lastError = null

		for (Charset charset : charsets) {
			try {
				return Files.readAllLines(sourceFile.toPath(), charset)
			} catch (Throwable error) {
				lastError = error
			}
		}

		throw lastError
	}

	// ======================================================
	// CSV SUPPORT
	// ======================================================

	private Character detectSeparator(List<String> lines) {
		String sample = ''

		for (String line : lines) {
			if (!safeText(line).isEmpty()) {
				sample = line
				break
			}
		}

		List<Character> separators = [
			',' as Character,
			';' as Character,
			'\t' as Character,
			'|' as Character
		]

		Character selectedSeparator = ',' as Character
		Integer highestCount = -1

		for (Character separator : separators) {
			Integer count = countSeparator(sample, separator)

			if (count > highestCount) {
				highestCount = count
				selectedSeparator = separator
			}
		}

		return selectedSeparator
	}

	private Integer countSeparator(String line, Character separator) {
		Integer count = 0
		boolean insideQuotes = false

		for (Integer index = 0; index < line.length(); index++) {
			Character currentCharacter = line.charAt(index)

			if (currentCharacter == '"') {
				if (insideQuotes &&
					index + 1 < line.length() &&
					line.charAt(index + 1) == '"') {

					index++
					continue
				}

				insideQuotes = !insideQuotes
				continue
			}

			if (!insideQuotes && currentCharacter == separator) {
				count++
			}
		}

		return count
	}

	private List<String> parseDelimitedLine(String line, Character separator) {
		List<String> values = []
		StringBuilder currentValue = new StringBuilder()
		boolean insideQuotes = false

		for (Integer index = 0; index < line.length(); index++) {
			Character currentCharacter = line.charAt(index)

			if (currentCharacter == '"') {
				if (insideQuotes &&
					index + 1 < line.length() &&
					line.charAt(index + 1) == '"') {

					currentValue.append('"')
					index++
				} else {
					insideQuotes = !insideQuotes
				}

				continue
			}

			if (!insideQuotes && currentCharacter == separator) {
				values.add(currentValue.toString().trim())
				currentValue.setLength(0)
				continue
			}

			currentValue.append(currentCharacter)
		}

		values.add(currentValue.toString().trim())

		return values
	}

	private String getListValue(List<String> values, Integer index) {
		if (values == null ||
			index == null ||
			index < 0 ||
			index >= values.size()) {

			return ''
		}

		return safeText(values.get(index))
	}

	// ======================================================
	// RESULT CREATION
	// ======================================================

	private Map createInitialResult(String expectedSourceTable) {
		return [
			success             : false,
			version             : '',
			fileName            : '',
			filePath            : '',
			expectedSourceTable : safeText(expectedSourceTable),
			completeSourceTable : 'NOT FOUND',
			sourceTable         : 'NOT FOUND',
			rowNumber           : 0,
			resultTestTop       : '',
			resultTestDistinct  : '',
			resultTestCount     : '',
			failedColumn        : '',
			expectedValue       : EXPECTED_RESULT,
			actualValue         : '',
			errors              : '',
			message             : ''
		]
	}

	private Map failResult(
			Map result,
			String errors,
			String failedColumn,
			String expectedValue,
			String actualValue,
			Integer rowNumber) {

		result.success = false
		result.errors = errors
		result.message = errors
		result.failedColumn = failedColumn
		result.expectedValue = expectedValue
		result.actualValue = actualValue

		if (rowNumber != null && rowNumber > 0) {
			result.rowNumber = rowNumber
		}

		return result
	}

	// ======================================================
	// TEXT SUPPORT
	// ======================================================

	private String removeSourceTablePrefix(String value) {
		String text = safeText(value)

		if (text.isEmpty()) {
			return ''
		}

		Integer separatorIndex = text.lastIndexOf('.')

		if (separatorIndex < 0 || separatorIndex >= text.length() - 1) {
			return text
		}

		return text.substring(separatorIndex + 1).trim()
	}

	private boolean isSameText(String firstValue, String secondValue) {
		return normalizeText(firstValue) == normalizeText(secondValue)
	}

	private String normalizeHeader(String value) {
		return normalizeText(value)
			.replace('_', ' ')
			.replace(':', ' ')
			.replace('-', ' ')
			.replaceAll('\\s+', ' ')
			.trim()
	}

	private String normalizeText(String value) {
		if (value == null) {
			return ''
		}

		return Normalizer
			.normalize(value, Normalizer.Form.NFD)
			.replaceAll('\\p{M}', '')
			.replace('\uFEFF', '')
			.trim()
			.toLowerCase()
			.replaceAll('\\s+', ' ')
	}

	private String safeText(Object value) {
		if (value == null) {
			return ''
		}

		return value.toString().replace('\uFEFF', '').trim()
	}

	private String getErrorMessage(Throwable error) {
		if (error == null) {
			return 'Unknown error.'
		}

		String message = error.getMessage()

		if (message == null || message.trim().isEmpty()) {
			return error.getClass().getSimpleName()
		}

		return message.trim()
	}
}

