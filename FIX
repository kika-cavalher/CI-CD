}
.evidence-links a {
    color: #5a1ea6;
    text-decoration: none;
    font-weight: 700;
}
.evidence-image {
    display: block;
    width: auto;
    max-width: calc(100% - 28px);
    max-height: 520px;
    margin: 0 14px 14px 14px;
    border-radius: 10px;
    border: 1px solid #dde5ef;
    object-fit: contain;
    background: #ffffff;
}
.chart-side-wrap {
    padding: 18px;
}
.chart-side-title {
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 12px;
    color: #15212b;
}
.donut-card {
    display: flex;
    justify-content: center;
    padding: 12px 0 18px 0;
}
