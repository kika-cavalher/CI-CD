	private String switchToAnyWindowTitle(
			List<String> titles,
			Integer timeoutSeconds
		) {

		long endTime = System.currentTimeMillis() +
			(timeoutSeconds * 1000L)

		while (System.currentTimeMillis() <= endTime) {
			for (String title : titles) {
				try {
					Windows.switchToWindowTitle(title)
					return title
				} catch (Throwable ignored) {
				}
			}

			Windows.delay(POLLING_DELAY_SECONDS)
		}

		return ''
	}

	private void waitForImagePresent(
			String imagePath,
			Integer timeoutSeconds,
			String failureMessage
		) {

		validateImageFile(imagePath)

		long endTime = System.currentTimeMillis() +
			(timeoutSeconds * 1000L)

		while (System.currentTimeMillis() <= endTime) {
			try {
				if (WindowsImageKeywords.findImage(imagePath)) {
					return
				}
			} catch (Throwable ignored) {
			}

			Windows.delay(POLLING_DELAY_SECONDS)
		}

		KeywordUtil.markFailedAndStop(
			failureMessage + '\nImage: ' +
			new File(imagePath).name
		)
	}

	private void takeEvidence(String fileName) {
		File evidenceFolder = new File(
			RunConfiguration.getReportFolder(),
			'Evidences'
		)

		if (!evidenceFolder.exists()) {
			evidenceFolder.mkdirs()
		}

		WindowsActionHelper.create(
			WindowsDriverFactory.getWindowsSession()
		).takeScreenshot(
			new File(evidenceFolder, fileName).absolutePath
		)
	}

	private File validateExcelFile(
			String filePath,
			String description
		) {

		String path = safeText(filePath)
		File file = new File(path)

		if (path.isEmpty() ||
			!file.exists() ||
			!file.isFile()) {

			KeywordUtil.markFailedAndStop(
				description + ' was not found:\n' +
				file.absolutePath
			)
		}

		if (file.length() <= 0L) {
			KeywordUtil.markFailedAndStop(
				description + ' is empty: ' + file.name
			)
		}

		return file
	}

	private void validateImageFile(String imagePath) {
		File imageFile = new File(safeText(imagePath))

		if (!imageFile.exists() || !imageFile.isFile()) {
			KeywordUtil.markFailedAndStop(
				'Image was not found:\n' + imageFile.absolutePath
			)
		}
	}

	private String image(String imageName) {
		return new File(
			RunConfiguration.getProjectDir(),
			IMAGE_FOLDER + '/' + imageName
		).absolutePath
	}

	private String normalizeSource(String sourceValue) {
		String value = safeText(sourceValue)
			.toLowerCase(Locale.ROOT)

		value = java.text.Normalizer.normalize(
			value,
			java.text.Normalizer.Form.NFD
		).replaceAll('\\p{M}', '')

		return value
	}

	private Integer safeTimeout(Integer timeoutSeconds) {
		return timeoutSeconds != null && timeoutSeconds > 0 ?
			timeoutSeconds : DEFAULT_TIMEOUT
	}

	private String safeText(Object value) {
		return value == null ? '' : value.toString().trim()
	}


	private static class HeaderLocation {
		final Integer rowIndex
		final Integer columnIndex

		HeaderLocation(
				Integer rowIndex,
				Integer columnIndex
			) {

			this.rowIndex = rowIndex
			this.columnIndex = columnIndex
		}
	}
}










