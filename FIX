package testTool

import java.text.Normalizer

import org.apache.poi.ss.usermodel.DataFormatter
import org.apache.poi.ss.usermodel.Row
import org.apache.poi.ss.usermodel.Sheet
import org.apache.poi.ss.usermodel.Workbook
import org.apache.poi.ss.usermodel.WorkbookFactory

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil

class TestToolValidationKeywords {

	@Keyword
	Map validateSourceTable(
			String dataFileRelativePath,
			String expectedScreenName,
			String expectedSourceTable
	) {
		validateRequiredParameter(
				'Data file relative path',
				dataFileRelativePath
				)

		validateRequiredParameter(
				'Expected screen name',
				expectedScreenName
				)

		validateRequiredParameter(
				'Expected source table',
				expectedSourceTable
				)

		String safeDataFileRelativePath = normalizeRelativePath(
				dataFileRelativePath
				)

		String safeExpectedScreenName = expectedScreenName.trim()
		String safeExpectedSourceTable = expectedSourceTable.trim()

		File sourceFile = new File(
				RunConfiguration.getProjectDir(),
				safeDataFileRelativePath
				)

		Map result = [
			passed             : false,
			fileName           : sourceFile.getName(),
			screenName         : safeExpectedScreenName,
			expectedSourceTable: safeExpectedSourceTable,
			actualSourceTable  : 'NOT FOUND',
			screenOccurrences  : 0,
			totalDataRows      : 0,
			message            : ''
		]

		addNote(
				'[INFO] Test Tool validation started\n' +
				'File: ' + sourceFile.getName() + '\n' +
				'Screen: ' + safeExpectedScreenName + '\n' +
				'Expected source table: ' + safeExpectedSourceTable
				)

		if (!sourceFile.exists() || !sourceFile.isFile()) {
			result.message =
					'Test Tool source file was not found.\n' +
					'File: ' + sourceFile.getName()

			takeEvidence(
					'TestTool_SourceFileNotFound.png'
					)

			addNote(
					'[FAIL] Test Tool source file validation\n' +
					result.message
					)

			KeywordUtil.markFailedAndStop(
					result.message
					)

			return result
		}

		if (sourceFile.length() <= 0) {
			result.message =
					'Test Tool source file is empty.\n' +
					'File: ' + sourceFile.getName()

			takeEvidence(
					'TestTool_SourceFileEmpty.png'
					)

			addNote(
					'[FAIL] Test Tool source file validation\n' +
					result.message
					)

			KeywordUtil.markFailedAndStop(
					result.message
					)

			return result
		}

		addNote(
				'[PASS] Test Tool source file validation\n' +
				'File found: ' + sourceFile.getName() + '\n' +
				'File size: ' + sourceFile.length() + ' bytes'
				)

		Workbook workbook = null

		try {
			workbook = WorkbookFactory.create(sourceFile)

			if (workbook.getNumberOfSheets() <= 0) {
				result.message =
						'Test Tool source file does not contain worksheets.\n' +
						'File: ' + sourceFile.getName()

				takeEvidence(
						'TestTool_NoWorksheetFound.png'
						)

				addNote(
						'[FAIL] Workbook validation\n' +
						result.message
						)

				KeywordUtil.markFailedAndStop(
						result.message
						)

				return result
			}

			Sheet sheet = workbook.getSheetAt(0)
			DataFormatter formatter = new DataFormatter()

			Map<String, Integer> headerIndexes = findHeaderIndexes(
					sheet,
					formatter
					)

			if (!headerIndexes.containsKey('screenName')) {
				result.message =
						'Required header was not found.\n' +
						'Expected header: Screen Name\n' +
						'File: ' + sourceFile.getName()

				takeEvidence(
						'TestTool_ScreenNameHeaderNotFound.png'
						)

				addNote(
						'[FAIL] Header validation\n' +
						result.message
						)

				KeywordUtil.markFailedAndStop(
						result.message
						)

				return result
			}

			if (!headerIndexes.containsKey('sourceTable')) {
				result.message =
						'Required header was not found.\n' +
						'Expected header: Source Table\n' +
						'File: ' + sourceFile.getName()

				takeEvidence(
						'TestTool_SourceTableHeaderNotFound.png'
						)

				addNote(
						'[FAIL] Header validation\n' +
						result.message
						)

				KeywordUtil.markFailedAndStop(
						result.message
						)

				return result
			}

			addNote(
					'[PASS] Header validation\n' +
					'Header found: Screen Name\n' +
					'Header found: Source Table'
					)

			Integer screenNameColumnIndex = headerIndexes.screenName
			Integer sourceTableColumnIndex = headerIndexes.sourceTable

			List<Map> matchingRows = []
			Integer totalDataRows = 0

			for (int rowIndex = 1; rowIndex <= sheet.getLastRowNum(); rowIndex++) {
				Row row = sheet.getRow(rowIndex)

				if (row == null) {
					continue
				}

				String currentScreenName = getCellText(
						row,
						screenNameColumnIndex,
						formatter
						)

				String currentSourceTable = getCellText(
						row,
						sourceTableColumnIndex,
						formatter
						)

				if (!currentScreenName.isEmpty() || !currentSourceTable.isEmpty()) {
					totalDataRows++
				}

				if (isSameText(
						currentScreenName,
						safeExpectedScreenName
						)) {
					matchingRows.add(
							[
								rowNumber  : rowIndex + 1,
								screenName : currentScreenName,
								sourceTable: currentSourceTable
							]
							)
				}
			}

			result.totalDataRows = totalDataRows
			result.screenOccurrences = matchingRows.size()

			addNote(
					'[PASS] Test Tool data reading\n' +
					'Worksheet: ' + sheet.getSheetName() + '\n' +
					'Rows with data: ' + totalDataRows + '\n' +
					'Occurrences found for screen: ' + matchingRows.size()
					)

			if (matchingRows.isEmpty()) {
				result.message =
						'Screen was not found in the Test Tool source file.\n' +
						'Screen: ' + safeExpectedScreenName + '\n' +
						'File: ' + sourceFile.getName()

				takeEvidence(
						'TestTool_ScreenNotFound.png'
						)

				addNote(
						'[FAIL] Screen validation\n' +
						result.message
						)

				KeywordUtil.markFailedAndStop(
						result.message
						)

				return result
			}

			if (matchingRows.size() > 1) {
				result.message =
						'Screen was found more than once in the Test Tool source file.\n' +
						'Screen: ' + safeExpectedScreenName + '\n' +
						'Occurrences: ' + matchingRows.size() + '\n' +
						'Rows: ' + buildRowNumbersText(matchingRows)

				takeEvidence(
						'TestTool_DuplicateScreenFound.png'
						)

				addNote(
						'[FAIL] Duplicate screen validation\n' +
						result.message
						)

				KeywordUtil.markFailedAndStop(
						result.message
						)

				return result
			}

			Map matchingRow = matchingRows.first()

			String actualSourceTable = safeText(
					matchingRow.sourceTable
					)

			result.actualSourceTable = actualSourceTable

			addNote(
					'[PASS] Screen validation\n' +
					'Screen found: ' + safeExpectedScreenName + '\n' +
					'Excel row: ' + matchingRow.rowNumber
					)

			if (actualSourceTable.isEmpty()) {
				result.message =
						'Source Table is empty for the selected screen.\n' +
						'Screen: ' + safeExpectedScreenName + '\n' +
						'Excel row: ' + matchingRow.rowNumber

				takeEvidence(
						'TestTool_SourceTableEmpty.png'
						)

				addNote(
						'[FAIL] Source Table validation\n' +
						result.message
						)

				KeywordUtil.markFailedAndStop(
						result.message
						)

				return result
			}

			if (!isSameText(
					actualSourceTable,
					safeExpectedSourceTable
					)) {
				result.message =
						'Source Table does not match the expected value.\n' +
						'Screen: ' + safeExpectedScreenName + '\n' +
						'Expected: ' + safeExpectedSourceTable + '\n' +
						'Actual: ' + actualSourceTable + '\n' +
						'Excel row: ' + matchingRow.rowNumber

				takeEvidence(
						'TestTool_SourceTableMismatch.png'
						)

				addNote(
						'[FAIL] Source Table validation\n' +
						result.message
						)

				KeywordUtil.markFailedAndStop(
						result.message
						)

				return result
			}

			result.passed = true
			result.message =
					'Test Tool Source Table validation completed successfully.'

			takeEvidence(
					'TestTool_SourceTableValidationPassed.png'
					)

			addNote(
					'[PASS] Source Table validation\n' +
					'Screen: ' + safeExpectedScreenName + '\n' +
					'Expected: ' + safeExpectedSourceTable + '\n' +
					'Actual: ' + actualSourceTable + '\n' +
					'Excel row: ' + matchingRow.rowNumber
					)

			addNote(
					'[PASS] Final result\n' +
					'Test Tool validation completed successfully.\n' +
					'Screen: ' + safeExpectedScreenName + '\n' +
					'Source Table: ' + actualSourceTable
					)

			return result
		} catch (Exception e) {
			result.message =
					'Test Tool validation could not be completed.\n' +
					'File: ' + sourceFile.getName() + '\n' +
					'Reason: ' + safeExceptionMessage(e)

			takeEvidence(
					'TestTool_ValidationError.png'
					)

			addNote(
					'[FAIL] Test Tool validation error\n' +
					result.message
					)

			KeywordUtil.markFailedAndStop(
					result.message
					)

			return result
		} finally {
			try {
				if (workbook != null) {
					workbook.close()
				}
			} catch (Exception ignored) {
			}
		}
	}

	private Map<String, Integer> findHeaderIndexes(
			Sheet sheet,
			DataFormatter formatter
	) {
		Map<String, Integer> indexes = [:]

		Row headerRow = sheet.getRow(0)

		if (headerRow == null) {
			return indexes
		}

		int lastCellNumber = headerRow.getLastCellNum()

		if (lastCellNumber < 0) {
			return indexes
		}

		for (int cellIndex = 0; cellIndex < lastCellNumber; cellIndex++) {
			String headerValue = getCellText(
					headerRow,
					cellIndex,
					formatter
					)

			String normalizedHeader = normalizeText(
					headerValue
					)

			if (normalizedHeader == 'screen name' ||
					normalizedHeader == 'screenname') {
				indexes.screenName = cellIndex
			}

			if (normalizedHeader == 'source table' ||
					normalizedHeader == 'sourcetable') {
				indexes.sourceTable = cellIndex
			}
		}

		return indexes
	}

	private String getCellText(
			Row row,
			Integer cellIndex,
			DataFormatter formatter
	) {
		if (row == null || cellIndex == null || cellIndex < 0) {
			return ''
		}

		def cell = row.getCell(cellIndex)

		if (cell == null) {
			return ''
		}

		String value = formatter.formatCellValue(cell)

		return value == null ? '' : value.trim()
	}

	private String buildRowNumbersText(List<Map> matchingRows) {
		List<String> rows = []

		matchingRows.each { Map row ->
			rows.add(
					String.valueOf(row.rowNumber)
					)
		}

		return rows.join(', ')
	}

	private Boolean isSameText(
			String firstValue,
			String secondValue
	) {
		return normalizeText(firstValue) == normalizeText(secondValue)
	}

	private String normalizeText(String value) {
		if (value == null) {
			return ''
		}

		return Normalizer
				.normalize(
				value,
				Normalizer.Form.NFD
				)
				.replaceAll('\\p{M}', '')
				.trim()
				.toLowerCase()
				.replaceAll('\\s+', ' ')
	}

	private String normalizeRelativePath(String path) {
		String normalizedPath = path
				.trim()
				.replace('/', File.separator)
				.replace('\\', File.separator)

		while (normalizedPath.startsWith(File.separator)) {
			normalizedPath = normalizedPath.substring(1)
		}

		return normalizedPath
	}

	private void validateRequiredParameter(
			String parameterName,
			String parameterValue
	) {
		if (parameterValue == null ||
				parameterValue.trim().isEmpty()) {
			KeywordUtil.markFailedAndStop(
					parameterName + ' is empty.'
					)
		}
	}

	private String safeText(Object value) {
		if (value == null) {
			return ''
		}

		return String.valueOf(value).trim()
	}

	private String safeExceptionMessage(Throwable error) {
		if (error == null) {
			return 'Unknown error.'
		}

		String message = error.getMessage()

		if (message == null || message.trim().isEmpty()) {
			return error.getClass().getSimpleName()
		}

		return message.trim()
	}

	private void takeEvidence(String evidenceName) {
		try {
			CustomKeywords.'commands.ImageLoader.takeEvidence'(
					evidenceName
					)
		} catch (Throwable ignored) {
			KeywordUtil.logInfo(
					'Could not capture evidence: ' + evidenceName
					)
		}
	}

	private void addNote(String message) {
		try {
			new jiraIntegration.JiraReportSteps().note(
					message
					)
		} catch (Throwable ignored) {
			KeywordUtil.logInfo(
					message
					)
		}
	}
}
