Insira este código logo depois de dragAndDropImage:

	@Keyword
	void validateGroupByResult(
			String firstRowImageKey,
			String firstRowObjectKey,
			String secondRowImageKey,
			String secondRowObjectKey,
			String expectedSecondRowPrefix,
			Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds, 5)
		List<String> errors = []

		logStep(
				'GROUP BY RESULT',
				'Double-click first result row\n' +
				'Expected line 2 prefix: ' +
				expectedSecondRowPrefix
				)

		boolean firstRowOpenedByImage =
				tryDoubleClickGroupByImage(
						firstRowImageKey
						)

		if (!firstRowOpenedByImage) {

			KeywordUtil.logInfo(
					'[INFO] First row image was not found. ' +
					'Trying Windows element: ' +
					firstRowObjectKey
					)

			WindowsTestObject firstRowObject =
					object(firstRowObjectKey)

			boolean firstRowPresent =
					Windows.waitForElementPresent(
							firstRowObject,
							timeout,
							FailureHandling.OPTIONAL
							)

			if (!firstRowPresent) {
				errors.add(
						'First Group By result row was not found.\n' +
						'Image: ' + firstRowImageKey + '\n' +
						'Object: ' + firstRowObjectKey
						)
			} else {
				try {
					Windows.doubleClick(
							firstRowObject,
							FailureHandling.STOP_ON_FAILURE
							)

					KeywordUtil.logInfo(
							'[PASS] First Group By row was opened ' +
							'using the Windows element.'
							)
				} catch (Exception e) {
					errors.add(
							'Could not double-click the first ' +
							'Group By result row.\n' +
							'Object: ' + firstRowObjectKey + '\n' +
							'Reason: ' + safeMessage(e)
							)
				}
			}
		}

		if (errors.isEmpty()) {
			Windows.delay(1)
		}

		boolean secondRowValidatedByImage = false

		if (errors.isEmpty()) {
			secondRowValidatedByImage =
					tryClickGroupByImage(
							secondRowImageKey
							)
		}

		if (
		errors.isEmpty() &&
				!secondRowValidatedByImage
				) {

			KeywordUtil.logInfo(
					'[INFO] Second row image was not found. ' +
					'Trying Windows element: ' +
					secondRowObjectKey
					)

			WindowsTestObject secondRowObject =
					object(secondRowObjectKey)

			boolean secondRowPresent =
					Windows.waitForElementPresent(
							secondRowObject,
							timeout,
							FailureHandling.OPTIONAL
							)

			if (!secondRowPresent) {
				errors.add(
						'The expected second Group By row ' +
						'was not found.\n' +
						'Expected prefix: ' +
						expectedSecondRowPrefix + '\n' +
						'Image: ' + secondRowImageKey + '\n' +
						'Object: ' + secondRowObjectKey
						)
			} else {

				String actualName =
						safeText(
								Windows.getAttribute(
										secondRowObject,
										'Name',
										FailureHandling.OPTIONAL
										)
								)
						.replaceAll(/\s+/, ' ')
						.trim()

				String expectedPrefix =
						safeText(expectedSecondRowPrefix)
						.replaceAll(/\s+/, ' ')
						.trim()

				boolean startsWithExpectedPrefix =
						actualName.length() >=
						expectedPrefix.length() &&
						actualName.regionMatches(
								true,
								0,
								expectedPrefix,
								0,
								expectedPrefix.length()
								)

				if (!startsWithExpectedPrefix) {
					errors.add(
							'Unexpected second Group By row.\n' +
							'Expected prefix: ' +
							expectedPrefix + '\n' +
							'Actual: ' + actualName
							)
				} else {
					KeywordUtil.logInfo(
							'[PASS] Line 2 starts with: ' +
							expectedPrefix
							)
				}
			}
		}

		takeEvidence(
				'GUI_GroupByResultValidated.png'
				)

		finishValidation(
				'Group By result validation',
				errors
				)
	}


	private boolean tryDoubleClickGroupByImage(
			String imageKey
	) {

		try {
			String imagePath =
					image(
							GUI_IMAGE_GROUP,
							imageKey
							)

			boolean doubleClickExecuted =
					invokeImageKeywordIfAvailable(
							'doubleClick',
							imagePath
							)

			if (!doubleClickExecuted) {
				doubleClickExecuted =
						invokeImageKeywordIfAvailable(
								'doubleClickImage',
								imagePath
								)
			}

			if (!doubleClickExecuted) {

				boolean firstClickExecuted =
						invokeImageKeywordIfAvailable(
								'click',
								imagePath
								)

				if (!firstClickExecuted) {
					firstClickExecuted =
							invokeImageKeywordIfAvailable(
									'clickImage',
									imagePath
									)
				}

				if (!firstClickExecuted) {
					throw new IllegalStateException(
							'No image click keyword is available.'
							)
				}

				boolean secondClickExecuted =
						invokeImageKeywordIfAvailable(
								'click',
								imagePath
								)

				if (!secondClickExecuted) {
					secondClickExecuted =
							invokeImageKeywordIfAvailable(
									'clickImage',
									imagePath
									)
				}

				if (!secondClickExecuted) {
					throw new IllegalStateException(
							'Could not execute the second image click.'
							)
				}
			}

			KeywordUtil.logInfo(
					'[PASS] First Group By row was opened ' +
					'using image: ' + imageKey
					)

			return true
		} catch (Exception e) {
			KeywordUtil.logInfo(
					'[INFO] Image double-click was not possible.\n' +
					'Image: ' + imageKey + '\n' +
					'Reason: ' + safeMessage(e)
					)

			return false
		}
	}


	private boolean tryClickGroupByImage(
			String imageKey
	) {

		try {
			String imagePath =
					image(
							GUI_IMAGE_GROUP,
							imageKey
							)

			boolean clickExecuted =
					invokeImageKeywordIfAvailable(
							'click',
							imagePath
							)

			if (!clickExecuted) {
				clickExecuted =
						invokeImageKeywordIfAvailable(
								'clickImage',
								imagePath
								)
			}

			if (!clickExecuted) {
				throw new IllegalStateException(
						'No image click keyword is available.'
						)
			}

			KeywordUtil.logInfo(
					'[PASS] Expected second Group By row ' +
					'was found using image: ' +
					imageKey
					)

			return true
		} catch (Exception e) {
			KeywordUtil.logInfo(
					'[INFO] Second row image was not found.\n' +
					'Image: ' + imageKey + '\n' +
					'Reason: ' + safeMessage(e)
					)

			return false
		}
	}


	private boolean invokeImageKeywordIfAvailable(
			String methodName,
			String imagePath
	) {

		java.lang.reflect.Method imageMethod =
				WindowsImageKeywords.methods.find {
					java.lang.reflect.Method method ->

					method.name == methodName &&
					method.parameterTypes.length == 1 &&
					method.parameterTypes[0]
							.isAssignableFrom(
									imagePath.getClass()
									)
				}

		if (imageMethod == null) {
			return false
		}

		imageMethod.invoke(
				null,
				imagePath
				)

		return true
	}
