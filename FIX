class FilterKeywords {

	private static final Integer DEFAULT_TIMEOUT = 10
	private static final Integer POLLING_DELAY_SECONDS = 1

	private final ImageLoader imageLoader =
	new ImageLoader()


	// ======================================================
	// OPEN FILTER
	// ======================================================

	@Keyword
	void openFilter(
			String imageGroup,
			String filterFieldImageKey,
			String filterButtonImageKey,
			Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds)

		waitForImagePresent(
				imageGroup,
				filterFieldImageKey,
				timeout,
				'Filter field was not displayed.'
				)

		WindowsImageKeywords.clickImage(
				image(imageGroup, filterFieldImageKey)
				)

		waitForImagePresent(
				imageGroup,
				filterButtonImageKey,
				timeout,
				'Filter button was not displayed after opening the filter field.'
				)

		WindowsImageKeywords.clickImage(
				image(imageGroup, filterButtonImageKey)
				)
	}


	// ======================================================
	// CLEAR CURRENT SELECTION
	// ======================================================

	@Keyword
	void clearCurrentSelection(
			String imageGroup,
			String selectAllImageKey,
			String emptySelectionImageKey,
			String closeFilterImageKey,
			Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds)

		waitForImagePresent(
				imageGroup,
				selectAllImageKey,
				timeout,
				'Select all option was not displayed.'
				)

		WindowsImageKeywords.doubleClickImage(
				image(imageGroup, selectAllImageKey)
				)

		Windows.delay(POLLING_DELAY_SECONDS)

		waitForImagePresent(
				imageGroup,
				emptySelectionImageKey,
				timeout,
				'Empty selection option was not displayed.'
				)

		WindowsImageKeywords.doubleClickImage(
				image(imageGroup, emptySelectionImageKey)
				)

		Windows.delay(POLLING_DELAY_SECONDS)

		waitForImagePresent(
				imageGroup,
				closeFilterImageKey,
				timeout,
				'Close filter button was not displayed.'
				)

		WindowsImageKeywords.clickImage(
				image(imageGroup, closeFilterImageKey)
				)

		Windows.delay(POLLING_DELAY_SECONDS)
	}


	// ======================================================
	// APPLY TEXT FILTER WITH CHECKBOX
	// ======================================================

	@Keyword
	void applyTextCheckboxFilter(
			String imageGroup,
			String filterFieldImageKey,
			String filterButtonImageKey,
			String textInputImageKey,
			String checkboxImageKey,
			String closeFilterImageKey,
			String appliedFilterImageKey,
			String filterValue,
			Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds)
		String value = safeText(filterValue)

		if (value.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Filter value cannot be empty.'
					)

			return
		}

		openFilter(
				imageGroup,
				filterFieldImageKey,
				filterButtonImageKey,
				timeout
				)

		waitForImagePresent(
				imageGroup,
				textInputImageKey,
				timeout,
				'Filter text input was not displayed.'
				)

		replaceTextOnImage(
				image(imageGroup, textInputImageKey),
				value
				)

		Windows.delay(2)

		waitForImagePresent(
				imageGroup,
				checkboxImageKey,
				timeout,
				'Filter checkbox was not displayed for value: ' +
				value
				)

		WindowsImageKeywords.clickImage(
				image(imageGroup, checkboxImageKey)
				)

		Windows.delay(POLLING_DELAY_SECONDS)

		waitForImagePresent(
				imageGroup,
				closeFilterImageKey,
				timeout,
				'Close filter button was not displayed.'
				)

		WindowsImageKeywords.clickImage(
				image(imageGroup, closeFilterImageKey)
				)

		waitForImagePresent(
				imageGroup,
				appliedFilterImageKey,
				timeout,
				'Filter was not applied correctly for value: ' +
				value
				)

		KeywordUtil.logInfo(
				'[PASS] Text filter applied successfully. Value: ' +
				value
				)
	}


	// ======================================================
	// APPLY SINGLE RESULT TEXT FILTER
	// ======================================================

	@Keyword
	void applySingleResultTextFilter(
			String imageGroup,
			String objectGroup,
			String hoverImageKey,
			String hoverObjectKey,
			String filterButtonImageKey,
			String filterButtonObjectKey,
			String textInputImageKey,
			String textInputObjectKey,
			String resultCheckboxImageKey,
			String resultCheckboxObjectKey,
			String closeButtonImageKey,
			String closeButtonObjectKey,
			String appliedFilterImageKey,
			String filterValue,
			Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds)
		String value = safeText(filterValue)

		if (value.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Filter value cannot be empty.'
					)

			return
		}

		// Hover over target header to display the gray filter button
		hoverImageFirstThenObject(
				imageGroup,
				objectGroup,
				hoverImageKey,
				hoverObjectKey,
				timeout
				)

		Windows.delay(POLLING_DELAY_SECONDS)

		// Open filter
		clickImageFirstThenObject(
				imageGroup,
				objectGroup,
				filterButtonImageKey,
				filterButtonObjectKey,
				'Filter button',
				timeout
				)

		// Fill search input
		replaceTextImageFirstThenObject(
				imageGroup,
				objectGroup,
				textInputImageKey,
				textInputObjectKey,
				value,
				timeout
				)

		Windows.delay(2)

		// Select returned result
		clickImageFirstThenObject(
				imageGroup,
				objectGroup,
				resultCheckboxImageKey,
				resultCheckboxObjectKey,
				'Filter result checkbox',
				timeout
				)

		Windows.delay(POLLING_DELAY_SECONDS)

		// Close filter
		clickImageFirstThenObject(
				imageGroup,
				objectGroup,
				closeButtonImageKey,
				closeButtonObjectKey,
				'Close filter button',
				timeout
				)

		KeywordUtil.logInfo(
				'[PASS] Single result text filter applied successfully. Value: ' +
				value
				)
	}


	// ======================================================
	// SELECT ONLY ONE FILTER VALUE
	// ======================================================

	@Keyword
	void selectOnlyFilterValue(
			String imageGroup,
			String objectGroup,
			String hoverImageKey,
			String hoverObjectKey,
			List<String> filterButtonImageKeys,
			String filterButtonObjectKey,
			String valuesTitleImageKey,
			String valuesTitleObjectKey,
			String selectAllCheckedImageKey,
			String selectAllObjectKey,
			String textInputImageKey,
			String textInputObjectKey,
			String resultCheckboxImageKey,
			String resultCheckboxObjectKey,
			String closeButtonImageKey,
			String closeButtonObjectKey,
			String filterValue,
			Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds)
		String value = safeText(filterValue)

		if (value.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Filter value cannot be empty.'
					)

			return
		}

		// Keep the existing hover behavior.
		// The image is checked first and the exact header object is used
		// only to place the mouse on the requested header.
		hoverImageFirstThenObject(
				imageGroup,
				objectGroup,
				hoverImageKey,
				hoverObjectKey,
				timeout
				)

		// Click immediately inside the right side of the SAME header.
		// No global filterButton image search and no second hover.
		clickFilterButtonInsideSameHeader(
				objectGroup,
				hoverObjectKey,
				timeout
				)

		// Search before touching any checkbox.
		replaceTextImageFirstThenObject(
				imageGroup,
				objectGroup,
				textInputImageKey,
				textInputObjectKey,
				value,
				timeout
				)

		Windows.delay(2)

		// Confirm the requested result image first, then click the
		// checkbox square of the existing result object.
		clickResultCheckboxSquareImageFirst(
				imageGroup,
				objectGroup,
				resultCheckboxImageKey,
				resultCheckboxObjectKey,
				'Filter result checkbox: ' + value,
				timeout
				)

		Windows.delay(POLLING_DELAY_SECONDS)

		// Close and continue directly to the export.
		clickImageFirstThenObject(
				imageGroup,
				objectGroup,
				closeButtonImageKey,
				closeButtonObjectKey,
				'Close filter button',
				timeout
				)

		Windows.delay(POLLING_DELAY_SECONDS)

		KeywordUtil.logInfo(
				'[PASS] Source filter interaction completed. Value: ' +
				value
				)
	}

	// ======================================================
	// CLEAR ACTIVE FILTER ON CURRENT HEADER
	// ======================================================

	@Keyword
	void clearActiveHeaderFilter(
			String imageGroup,
			String objectGroup,
			String hoverImageKey,
			String hoverObjectKey,
			String clearFilterImagePath,
			String textInputImageKey,
			String textInputObjectKey,
			String resultCheckboxImageKey,
			String resultCheckboxObjectKey,
			String closeButtonImageKey,
			String closeButtonObjectKey,
			String nextFilterValue,
			Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds)
		String clearImagePath = safeText(clearFilterImagePath)
		String value = safeText(nextFilterValue)

		if (clearImagePath.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Clear filter image path cannot be empty.'
					)
			return
		}

		if (value.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Next filter value cannot be empty.'
					)
			return
		}

		File clearImageFile = new File(clearImagePath)

		if (!clearImageFile.exists() ||
				!clearImageFile.isFile()) {

			KeywordUtil.markFailedAndStop(
					'Clear filter image was not found:\n' +
					clearImageFile.absolutePath
					)
			return
		}

		// Open Source filter once.
		hoverImageFirstThenObject(
				imageGroup,
				objectGroup,
				hoverImageKey,
				hoverObjectKey,
				timeout
				)

		clickFilterButtonInsideSameHeader(
				objectGroup,
				hoverObjectKey,
				timeout
				)

		Windows.delay(POLLING_DELAY_SECONDS)

		// Clear BILAN.
		WindowsImageKeywords.clickImage(
				clearImageFile.absolutePath
				)

		Windows.delay(POLLING_DELAY_SECONDS)

		// Popup remains open. Continue directly with RESULTAT.
		// No new hover and no new filter-button click.
		replaceTextImageFirstThenObject(
				imageGroup,
				objectGroup,
				textInputImageKey,
				textInputObjectKey,
				value,
				timeout
				)

		Windows.delay(2)

		clickResultCheckboxSquareImageFirst(
				imageGroup,
				objectGroup,
				resultCheckboxImageKey,
				resultCheckboxObjectKey,
				'Filter result checkbox: ' + value,
				timeout
				)

		Windows.delay(POLLING_DELAY_SECONDS)

		clickImageFirstThenObject(
				imageGroup,
				objectGroup,
				closeButtonImageKey,
				closeButtonObjectKey,
				'Close filter button',
				timeout
				)

		Windows.delay(POLLING_DELAY_SECONDS)

		KeywordUtil.logInfo(
				'[PASS] Previous Source filter was cleared and replaced with: ' +
				value
				)
	}

	// ======================================================
	// DRAG FILTER TO TARGET AREA
	// ======================================================

