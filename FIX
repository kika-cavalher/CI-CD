package pageObject

import static com.kms.katalon.core.testobject.ObjectRepository.findTestObject

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.ConditionType
import com.kms.katalon.core.testobject.TestObject
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI

import cucumber.api.java.en.And
import cucumber.api.java.en.Given
import cucumber.api.java.en.Then
import cucumber.api.java.en.When
import internal.GlobalVariable

class Login {

	private static final int DEFAULT_TIMEOUT = 60
	private static final int SHORT_TIMEOUT = 5

	@Keyword
	@Given("user opens DEV login page")
	def userOpensHueLoginPage() {
		KeywordUtil.logInfo("Opening DEV login page")

		validateRequiredVariable('DEV_URL', GlobalVariable.DEV_URL)

		closeBrowserIfAlreadyOpened()

		WebUI.openBrowser('')
		WebUI.maximizeWindow()
		WebUI.navigateToUrl(GlobalVariable.DEV_URL.toString())

		WebUI.waitForPageLoad(DEFAULT_TIMEOUT)
		waitForPageToBeReady(DEFAULT_TIMEOUT)

		waitForLoginOrHueApplication(DEFAULT_TIMEOUT)
	}

	@Keyword
	@When("the user logs in with the correct profile credentials.")
	def userLogsInWithDefaultProfileCredentials() {
		KeywordUtil.logInfo("Checking if login is required")

		if (!isLoginScreenVisible(SHORT_TIMEOUT)) {
			KeywordUtil.logInfo("Login screen was not displayed. User is already authenticated or SSO completed automatically.")
			waitForHueApplication(DEFAULT_TIMEOUT)
			return
		}

		KeywordUtil.logInfo("Login screen is visible. Filling credentials.")

		validateRequiredVariable('DEV_USERNAME', GlobalVariable.DEV_USERNAME)
		validateRequiredVariable('DEV_PASSWORD', GlobalVariable.DEV_PASSWORD)

		WebUI.waitForElementVisible(
			findTestObject('Login/input_Username'),
			DEFAULT_TIMEOUT,
			FailureHandling.STOP_ON_FAILURE
		)

		WebUI.clearText(
			findTestObject('Login/input_Username'),
			FailureHandling.OPTIONAL
		)

		WebUI.setText(
			findTestObject('Login/input_Username'),
			GlobalVariable.DEV_USERNAME.toString()
		)

		WebUI.setEncryptedText(
			findTestObject('Login/input_Password'),
			GlobalVariable.DEV_PASSWORD.toString()
		)

		WebUI.click(findTestObject('Login/button_SignIn'))

		WebUI.waitForPageLoad(DEFAULT_TIMEOUT)
		waitForPageToBeReady(DEFAULT_TIMEOUT)

		waitForHueApplication(DEFAULT_TIMEOUT)
	}

	@Keyword
	@Then("Hue home should be opened")
	def hueHomeShouldBeOpened() {
		KeywordUtil.logInfo("Verifying Hue application was opened")

		waitForPageToBeReady(DEFAULT_TIMEOUT)
		waitForHueApplication(DEFAULT_TIMEOUT)

		KeywordUtil.logInfo("Hue application was opened successfully")
		KeywordUtil.logInfo("Current URL: " + WebUI.getUrl())
	}

	@Keyword
	@Then("editor should be opened")
	def legacyEditorShouldBeOpened() {
		KeywordUtil.logInfo("Legacy step detected: editor should be opened")
		KeywordUtil.logInfo("Login feature now only validates that Hue is opened.")

		hueHomeShouldBeOpened()
	}

	@Keyword
	@And("default database should be selected")
	def legacyDefaultDatabaseShouldBeSelected() {
		KeywordUtil.logInfo("Legacy step detected: default database should be selected")
		KeywordUtil.logInfo("Database navigation must be validated in navigation.feature.")

		hueHomeShouldBeOpened()
	}

	private void closeBrowserIfAlreadyOpened() {
		try {
			WebUI.closeBrowser(FailureHandling.OPTIONAL)
			WebUI.delay(1)
		} catch (Exception ignored) {
			KeywordUtil.logInfo("No browser was opened before starting the test.")
		}
	}

	private void waitForLoginOrHueApplication(int timeoutInSeconds) {
		KeywordUtil.logInfo("Waiting for login screen or Hue application")

		for (int i = 0; i < timeoutInSeconds; i++) {
			if (isLoginScreenVisible(1)) {
				KeywordUtil.logInfo("Login screen was found")
				return
			}

			if (isHueApplicationVisible(1)) {
				KeywordUtil.logInfo("Hue application was found")
				return
			}

			WebUI.delay(1)
		}

		KeywordUtil.markFailedAndStop("Neither login screen nor Hue application was found. Current URL: " + safeGetUrl())
	}

	private void waitForHueApplication(int timeoutInSeconds) {
		KeywordUtil.logInfo("Waiting for Hue application")

		for (int i = 0; i < timeoutInSeconds; i++) {
			if (isHueApplicationVisible(1)) {
				KeywordUtil.logInfo("Hue application is visible")
				return
			}

			if (isLoginScreenVisible(1)) {
				KeywordUtil.markFailedAndStop("Login screen is still visible after login attempt. Current URL: " + safeGetUrl())
			}

			WebUI.delay(1)
		}

		KeywordUtil.markFailedAndStop("Hue application was not opened within timeout. Current URL: " + safeGetUrl())
	}

	private boolean isLoginScreenVisible(int timeoutInSeconds) {
		try {
			return WebUI.verifyElementPresent(
				findTestObject('Login/input_Username'),
				timeoutInSeconds,
				FailureHandling.OPTIONAL
			)
		} catch (Exception ignored) {
			return false
		}
	}

	private boolean isHueApplicationVisible(int timeoutInSeconds) {
		try {
			return WebUI.verifyElementPresent(
				getHueApplicationMarker(),
				timeoutInSeconds,
				FailureHandling.OPTIONAL
			)
		} catch (Exception ignored) {
			return false
		}
	}

	private TestObject getHueApplicationMarker() {
		TestObject marker = new TestObject('Hue_Application_Marker')

		marker.addProperty(
			'xpath',
			ConditionType.EQUALS,
			"//*[normalize-space()='Documents' or normalize-space()='Editor' or normalize-space()='Databases' or normalize-space()='Tables' or contains(normalize-space(.),'My documents') or contains(@class,'assist-panel') or contains(@class,'hue-logo')]"
		)

		return marker
	}

	private void waitForPageToBeReady(int timeoutInSeconds) {
		for (int i = 0; i < timeoutInSeconds; i++) {
			try {
				Object readyState = WebUI.executeJavaScript('return document.readyState', null)

				if (readyState != null && readyState.toString() == 'complete') {
					return
				}
			} catch (Exception ignored) {
				KeywordUtil.logInfo("Page ready state is not available yet.")
			}

			WebUI.delay(1)
		}

		KeywordUtil.logInfo("Page ready state did not become complete within timeout.")
	}

	private void validateRequiredVariable(String variableName, Object variableValue) {
		if (variableValue == null || variableValue.toString().trim().length() == 0) {
			KeywordUtil.markFailedAndStop("Required global variable is empty: " + variableName)
		}
	}

	private String safeGetUrl() {
		try {
			return WebUI.getUrl()
		} catch (Exception ignored) {
			return 'URL not available'
		}
	}
}
