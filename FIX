	) {
		if (text == null ||
				text.trim().isEmpty()) {
			return false
		}

		String upperText =
				text
				.trim()
				.toUpperCase()

		try {
			WindowsTestObject object =
					new WindowsTestObject(
					'visibleText_' +
					sanitizeObjectName(
					upperText
					)
					)

			object.setLocatorStrategy(
					LocatorStrategy.XPATH
					)

			object.setLocator(
					"//*[contains(" +
					"translate(@Name, " +
					"'abcdefghijklmnopqrstuvwxyz', " +
					"'ABCDEFGHIJKLMNOPQRSTUVWXYZ'), " +
					"'" + upperText + "')]"
					)

			return Windows.verifyElementPresent(
					object,
					1,
					FailureHandling.OPTIONAL
					)
		} catch (Exception ignored) {
		}

		return false
	}

	private String getGlobalVariableValue(
			String variableName
	) {
		try {
			def value =
					GlobalVariable."${variableName}"

			if (value != null &&
					!value.toString().trim().isEmpty()) {
