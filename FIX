			try {
				if (imageLoader.waitForImage(
						IMAGE_GROUP,
						RECHERCHER_IMAGE_KEY,
						timeoutSeconds
						)) {

					WindowsImageKeywords.clickImage(
							imageLoader.getImage(
							IMAGE_GROUP,
							RECHERCHER_IMAGE_KEY
							)
							)

					KeywordUtil.logInfo(
							'[PASS] Rechercher button clicked by image.'
							)

					return true
				}
			} catch (Throwable exception) {
				KeywordUtil.logInfo(
						'[RECHERCHER BUTTON] Image lookup or click failed.\n' +
						'Reason: ' +
						safeMessage(
						exception
						)
						)
			}

			delayBeforeNextAttempt(
					attempt,
					maximumAttempts
					)
		}

		return false
	}


	private void delayBeforeNextAttempt(
			Integer currentAttempt,
			Integer maximumAttempts
	) {

		if (currentAttempt < maximumAttempts) {
			Windows.delay(
					RETRY_DELAY_SECONDS
					)
		}
	}


	private String safeMessage(
			Throwable exception
	) {

		if (exception == null ||
			exception.getMessage() == null) {

			return exception == null
					? ''
					: exception
						.getClass()
						.getSimpleName()
		}

		return exception
				.getMessage()
				.trim()
	}


