	private boolean tryStartWinAppDriver(String exePath) {
		try {
			KeywordUtil.logInfo("Starting WinAppDriver minimized from ${exePath}")
			new ProcessBuilder(
				'cmd',
				'/c',
				"start \"\" /min \"${exePath}\""
			).redirectErrorStream(true).start()
			return true
		} catch (Throwable firstError) {
			KeywordUtil.logInfo("Minimized WinAppDriver start failed: ${firstError.message}")

			try {
				new ProcessBuilder(exePath)
					.redirectErrorStream(true)
					.start()
				return true
			} catch (Throwable secondError) {
				KeywordUtil.logInfo("Direct WinAppDriver start failed: ${secondError.message}")
				return false
			}
		}
	}

	private void restartWinAppDriver() {
		killProcessIfExists('WinAppDriver.exe')
		ensureWinAppDriverStarted()
	}

	private void ensureWinAppDriverStarted() {
		if (isPortOpen('127.0.0.1', 4723, 1000) && waitForWinAppDriverStatus(3)) {
			KeywordUtil.logInfo('WinAppDriver already running and healthy on 127.0.0.1:4723')
			return
		}

		String exePath = getWinAppDriverPath()
		if (!exePath) {
			throw new Exception('WinAppDriver path is empty.')
		}

		File exe = new File(exePath)
		if (!exe.exists()) {
			throw new Exception("WinAppDriver executable not found at: ${exePath}")
		}

		if (processExists('WinAppDriver.exe')) {
			KeywordUtil.logInfo('WinAppDriver process exists but is not healthy. Restarting it.')
			killProcessIfExists('WinAppDriver.exe')
		}

		boolean launched = tryStartWinAppDriver(exePath)
		if (!launched) {
			throw new Exception("Unable to launch WinAppDriver from: ${exePath}")
		}

		boolean portReady = waitForPort('127.0.0.1', 4723, 10)
		if (!portReady) {
			throw new Exception("WinAppDriver did not open port 4723 after startup. Path used: ${exePath}")
		}

		boolean healthy = waitForWinAppDriverStatus(15)
		if (!healthy) {
			throw new Exception("WinAppDriver opened port 4723 but /status never became healthy. Path used: ${exePath}")
		}

		Windows.delay(2)
		KeywordUtil.logInfo('WinAppDriver is ready on 127.0.0.1:4723')
	}

	private boolean launchPathWithShell(String pathToLaunch) {
		try {
			KeywordUtil.logInfo("Launching path with shell: ${pathToLaunch}")
			new ProcessBuilder(
				'cmd',
				'/c',
				"start \"\" \"${pathToLaunch}\""
			).redirectErrorStream(true).start()
			return true
		} catch (Throwable e) {
			KeywordUtil.logInfo("Shell launch failed for '${pathToLaunch}': ${e.message}")
			return false
		}
	}

	private boolean launchExecutable(String exePath) {
		boolean launched = launchPathWithShell(exePath)
		if (launched) {
			return true
		}

		try {
			KeywordUtil.logInfo("Falling back to direct executable launch: ${exePath}")
			new ProcessBuilder(exePath).redirectErrorStream(true).start()
			return true
		} catch (Throwable e) {
			KeywordUtil.logInfo("Direct executable launch failed for '${exePath}': ${e.message}")
			return false
		}
	}

	private boolean launchClickOnceApplication(String applicationPath) {
		boolean launched = launchPathWithShell(applicationPath)
		if (launched) {
			return true
		}

		try {
			KeywordUtil.logInfo("Falling back to dfshim for ClickOnce application: ${applicationPath}")
			new ProcessBuilder(
				'cmd',
				'/c',
				"rundll32.exe dfshim.dll,ShOpenVerbApplication \"${applicationPath}\""
			).redirectErrorStream(true).start()
			return true
		} catch (Throwable e) {
			KeywordUtil.logInfo("dfshim launch failed for '${applicationPath}': ${e.message}")
			return false
		}
	}

	private boolean launchShortcutWithShell(String shortcutPath) {
		return launchPathWithShell(shortcutPath)
	}

	private String searchInstalledExePath() {
		String user = getCurrentWindowsUser()
		String rootPath = "C:\\Users\\${user}\\AppData\\Local\\Apps\\2.0"
		File root = new File(rootPath)

		if (!root.exists()) {
			KeywordUtil.logInfo("Local Apps root does not exist: ${rootPath}")
			return ''
		}

		List<File> matches = []

		try {
			root.eachFileRecurse(FileType.FILES) { File file ->
				if (file.name.equalsIgnoreCase('IXIS.eMatch.IHM.exe')) {
					matches << file
				}
			}
		} catch (Throwable e) {
			KeywordUtil.logInfo("Installed exe search failed: ${e.message}")
		}

		if (matches.isEmpty()) {
			KeywordUtil.logInfo("No installed IXIS.eMatch.IHM.exe found under ${rootPath}")
			return ''
		}

		matches.sort { a, b -> b.lastModified() <=> a.lastModified() }
		String bestMatch = matches[0].absolutePath
		KeywordUtil.logInfo("Installed exe detected dynamically: ${bestMatch}")
		return bestMatch
	}

	private boolean launchAndAttach(String launchPath, boolean executableLaunch, String sourceLabel) {
		boolean launched = executableLaunch ? launchExecutable(launchPath) : launchShortcutWithShell(launchPath)
		if (!launched) {
			KeywordUtil.logInfo("Launch failed for ${sourceLabel}: ${launchPath}")
			return false
		}

		boolean processReady = waitForProcess('IXIS.eMatch.IHM.exe', 30)
		if (!processReady) {
			KeywordUtil.logInfo("eMatch process did not appear after ${sourceLabel} launch.")
			return false
		}

		Windows.delay(4)
		ensureWinAppDriverStarted()

		boolean attached = attachToLoginByWindowIndex(30, 5)
		if (!attached) {
			KeywordUtil.logInfo("Login window could not be attached after ${sourceLabel} launch.")
			return false
		}

		boolean loginReady = waitForLoginWindowReady(15)
		if (!loginReady) {
			KeywordUtil.logInfo("Login objects were not detected after ${sourceLabel} launch.")
			return false
		}

		return true
	}

