	@Keyword
	String downloadCurrentView(String downloadLabel) {
		List<String> files = getDownloadedFiles()
		int beforeDownload = files.size()

		String downloadedFile = safeText(
			ematchHelper.downloadFileFromMainScreenWithCopyPaste(
				20,
				30,
				safeText(downloadLabel)
			)
		)

		if (downloadedFile.isEmpty()) {
			KeywordUtil.markFailedAndStop(
				'Download helper returned an empty file name.\n' +
				'Label: ' + safeText(downloadLabel)
			)
		}

		files.add(downloadedFile)
		GlobalVariable.compareFiles = files

		if (files.size() != beforeDownload + 1) {
			KeywordUtil.markFailedAndStop(
				'Downloaded file was not added to compareFiles.\n' +
				'File: ' + downloadedFile
			)
		}

		KeywordUtil.markPassed(
			'File downloaded successfully: ' + downloadedFile
		)

		return downloadedFile
	}

