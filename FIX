package pageObject

import static com.kms.katalon.core.testobject.ObjectRepository.findTestObject

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI

import cucumber.api.java.en.And
import cucumber.api.java.en.Given
import cucumber.api.java.en.Then
import cucumber.api.java.en.When
import internal.GlobalVariable

class Navigation {

private static final int DEFAULT_TIMEOUT = 60

@Keyword
@Given(“Hue home is opened”)
def hueHomeIsOpened() {
KeywordUtil.logInfo(“Verifying Hue home is already opened”)

WebUI.waitForPageLoad(DEFAULT_TIMEOUT)
waitForPageToBeReady(DEFAULT_TIMEOUT)

boolean hueVisible = isObjectVisible(‘Home/hue_ApplicationMarker’, DEFAULT_TIMEOUT)

if (!hueVisible) {
KeywordUtil.markFailedAndStop(“Hue home is not opened. Current URL: “ + WebUI.getUrl())
}

KeywordUtil.logInfo(“Hue home is opened”)
}

@Keyword
@When(“user searches for the configured default database”)
def userSearchesForConfiguredDefaultDatabase() {
String databaseName = GlobalVariable.EXPECTED_DATABASE.toString().trim()

KeywordUtil.logInfo(“Searching database: “ + databaseName)

if (databaseName == null || databaseName.length() == 0) {
KeywordUtil.markFailedAndStop(“GlobalVariable.EXPECTED_DATABASE is empty”)
}

WebUI.waitForElementVisible(
findTestObject(‘Home/input_DatabaseSearch’),
DEFAULT_TIMEOUT,
FailureHandling.STOP_ON_FAILURE
)

WebUI.click(findTestObject(‘Home/input_DatabaseSearch’))

WebUI.clearText(
findTestObject(‘Home/input_DatabaseSearch’),
FailureHandling.OPTIONAL
)

WebUI.setText(
findTestObject(‘Home/input_DatabaseSearch’),
databaseName
)

waitForSearchResult(databaseName)
}

@Keyword
@And(“user selects the first database result”)
def userSelectsFirstDatabaseResult() {
KeywordUtil.logInfo(“Selecting the first database result”)

WebUI.waitForElementVisible(
findTestObject(‘Home/option_FirstDatabaseSearchResult’),
DEFAULT_TIMEOUT,
FailureHandling.STOP_ON_FAILURE
)

WebUI.click(findTestObject(‘Home/option_FirstDatabaseSearchResult’))

WebUI.delay(2)
waitForPageToBeReady(DEFAULT_TIMEOUT)
}

@Keyword
@Then(“selected database title should be displayed”)
def selectedDatabaseTitleShouldBeDisplayed() {
String expectedDatabase = GlobalVariable.EXPECTED_DATABASE.toString().trim()

KeywordUtil.logInfo(“Verifying selected database title”)
KeywordUtil.logInfo(“Expected database title: “ + expectedDatabase)

WebUI.waitForElementVisible(
findTestObject(‘Home/title_SelectedDatabase’),
DEFAULT_TIMEOUT,
FailureHandling.STOP_ON_FAILURE
)

String actualTitle = WebUI.getText(findTestObject(‘Home/title_SelectedDatabase’)).trim()

KeywordUtil.logInfo(“Actual database title: “ + actualTitle)

if (!actualTitle.equals(expectedDatabase)) {
KeywordUtil.markFailedAndStop(“Wrong database selected. Expected: “ + expectedDatabase + “ | Actual: “ + actualTitle)
}

KeywordUtil.logInfo(“Database was selected successfully: “ + actualTitle)
}

private void waitForSearchResult(String databaseName) {
KeywordUtil.logInfo(“Waiting for database search result: “ + databaseName)

for (int i = 0; i < DEFAULT_TIMEOUT; i++) {
boolean resultVisible = isObjectVisible(‘Home/option_FirstDatabaseSearchResult’, 1)

if (resultVisible) {
String firstResultText = WebUI.getText(findTestObject(‘Home/option_FirstDatabaseSearchResult’)).trim()
KeywordUtil.logInfo(“First result found: “ + firstResultText)
return
}

WebUI.delay(1)
}

KeywordUtil.markFailedAndStop(“No database result was found after searching: “ + databaseName)
}

private void waitForPageToBeReady(int timeoutInSeconds) {
for (int i = 0; i < timeoutInSeconds; i++) {
try {
String readyState = WebUI.executeJavaScript(‘return document.readyState’, null)

if (readyState == ‘complete’) {
return
}
} catch (Exception ignored) {
KeywordUtil.logInfo(“Page ready state is not available yet”)
}

WebUI.delay(1)
}

KeywordUtil.logInfo(“Page ready state did not become complete within timeout”)
}

private boolean isObjectVisible(String objectPath, int timeoutInSeconds) {
try {
return WebUI.verifyElementPresent(
findTestObject(objectPath),
timeoutInSeconds,
FailureHandling.OPTIONAL
)
} catch (Exception ignored) {
return false
}
}
}

