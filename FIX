import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import java.awt.Robot
import java.awt.event.KeyEvent

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.driver.WindowsDriverFactory
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows
import com.kms.katalon.core.windows.keyword.helper.WindowsActionHelper

String menu = 'PL économique Brut';
Robot robot = new Robot()

CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Wait for search field to be available for menu: ${menu}")
Windows.waitForElementPresent(findWindowsObject('General/txtSearch'), 10)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Clear search field before searching menu: ${menu}")
Windows.clearText(findWindowsObject('General/txtSearch'))

CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Type menu name in search field: ${menu}")
Windows.setText(findWindowsObject('General/txtSearch'), menu)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Load target image for menu result: ${menu}")
String temp = new File(RunConfiguration.getProjectDir(), ('Images/Archive Mode/' + menu + '.PNG')).getAbsolutePath();

CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Wait briefly before clicking menu result: ${menu}")
Windows.delay(1)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Click menu result image: ${menu}")
WindowsImageKeywords.clickImage(temp)

Windows.delay(10);
try {
	Windows.click(findWindowsObject('Archive Mode/btnApplique'));
	Windows.delay(1)
	Windows.waitForElementPresent(findWindowsObject('Archive Mode/btnApplique'), 30)
	Windows.click(findWindowsObject('Archive Mode/btnApplique'));
} catch (Exception e) {
	CustomKeywords.'com.katalon.keywords.windows.WindowsImprovedKeywords.errorWindow'(menu);
}


try {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Wait for tab to open successfully for menu: ${menu}")
	Windows.waitForElementPresent(findWindowsObject('Object Repository/Archive Mode/tabName'), 160)

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Capture success evidence for opened menu tab: ${menu}")
	WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession()).takeScreenshot(
		RunConfiguration.getReportFolder() + '\\Evidences\\' + menu + '.PNG'
	)

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Close opened tab for menu: ${menu}")
	Windows.click(findWindowsObject('Archive Mode/btnFermer'))

	KeywordUtil.markPassed('[SUCCESS] Tab of menu ' + menu + ' was opened sucessfully.')
} catch (Exception e) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Tab did not open as expected. Capturing failure evidence for menu: ${menu}")
	Windows.delay(2)

	WindowsActionHelper.create(WindowsDriverFactory.getWindowsSession()).takeScreenshot(
		RunConfiguration.getReportFolder() + '\\Evidences\\' + '[ERROR] ' + menu + '.PNG'
	)

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'("Click confirmation button on failure dialog for menu: ${menu}")
	Windows.click(findWindowsObject('Object Repository/Justification des Comptes de Latent/confirmBtn'))

	KeywordUtil.markFailed('\n[ERROR] Tab of menu ' + menu + ' was not opened.')
}
