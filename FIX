	@Keyword
	String getImage(String imageGroup, String imageKey) {
		validateImageKey(imageGroup, imageKey)

		String relativePath = IMAGE_GROUPS[imageGroup][imageKey]
		File imageFile = resolveImageFileOrStop(imageGroup, imageKey, relativePath)

		return imageFile.getAbsolutePath()
	}

	@Keyword
	Map<String, String> getImages(String imageGroup) {
		validateGroup(imageGroup)

		Map<String, String> images = [:]

		IMAGE_GROUPS[imageGroup].each { String imageKey, String relativePath ->
			images[imageKey] = resolveImageFileOrStop(
				imageGroup,
				imageKey,
				relativePath
			).getAbsolutePath()
		}

		return images
	}

	@Keyword
	void validateGroupImagesExist(String imageGroup) {
		validateGroup(imageGroup)

		IMAGE_GROUPS[imageGroup].each { String imageKey, String relativePath ->
			resolveImageFileOrStop(
				imageGroup,
				imageKey,
				relativePath
			)
		}

		KeywordUtil.logInfo('All images exist for group: ' + imageGroup)
	}

	@Keyword
	boolean isVisible(String imageGroup, String imageKey) {
		String imagePath = getImage(imageGroup, imageKey)

		try {
			return isImageFound(WindowsImageKeywords.findImage(imagePath))
		} catch (Exception e) {
			KeywordUtil.logInfo(
				'Image visibility check failed.\n' +
				'Group: ' + imageGroup + '\n' +
				'Key: ' + imageKey + '\n' +
				'Path: ' + imagePath + '\n' +
				'Reason: ' + e.getMessage()
			)

			return false
		}
	}

	@Keyword
	boolean isGroupVisible(String imageGroup) {
		validateGroup(imageGroup)

		for (String imageKey : IMAGE_GROUPS[imageGroup].keySet()) {
			if (isVisible(imageGroup, imageKey)) {
				KeywordUtil.logInfo(
					'Visible image found.\n' +
					'Group: ' + imageGroup + '\n' +
					'Key: ' + imageKey
				)

				return true
			}
		}

		return false
	}

	@Keyword
	boolean waitForImage(String imageGroup, String imageKey, int timeoutSeconds) {
		String imagePath = getImage(imageGroup, imageKey)

		try {
			return WindowsImageKeywords.waitForImage(
				imagePath,
				getSafeTimeout(timeoutSeconds)
			)
		} catch (Exception e) {
			KeywordUtil.logInfo(
				'Wait for image failed.\n' +
				'Group: ' + imageGroup + '\n' +
				'Key: ' + imageKey + '\n' +
				'Path: ' + imagePath + '\n' +
				'Reason: ' + e.getMessage()
			)

			return false
		}
	}

	@Keyword
	void waitForImageOrStop(String imageGroup, String imageKey, int timeoutSeconds) {
		boolean found = waitForImage(
			imageGroup,
			imageKey,
			timeoutSeconds
		)

		if (!found) {
			takeEvidence('ImageNotVisible_' + sanitizeFileName(imageGroup + '_' + imageKey) + '.png')

			KeywordUtil.markFailedAndStop(
				'Image was found on disk, but was not visible on screen before timeout.\n' +
				'Group: ' + imageGroup + '\n' +
				'Key: ' + imageKey + '\n' +
				'Timeout: ' + timeoutSeconds + ' seconds\n' +
				'Path: ' + getImage(imageGroup, imageKey)
			)
		}
	}

	@Keyword
	boolean clickVisible(String imageGroup, String imageKey) {
		String imagePath = getImage(imageGroup, imageKey)

		try {
			if (isImageFound(WindowsImageKeywords.findImage(imagePath))) {
				WindowsImageKeywords.clickImage(imagePath)
				Windows.delay(1)

				KeywordUtil.logInfo(
					'Clicked image.\n' +
					'Group: ' + imageGroup + '\n' +
					'Key: ' + imageKey
				)

				return true
			}
		} catch (Exception e) {
			KeywordUtil.logInfo(
				'Click image failed.\n' +
				'Group: ' + imageGroup + '\n' +
				'Key: ' + imageKey + '\n' +
				'Path: ' + imagePath + '\n' +
				'Reason: ' + e.getMessage()
			)
		}

		return false
	}

	@Keyword
	void clickImageOrStop(String imageGroup, String imageKey) {
		boolean clicked = clickVisible(
			imageGroup,
			imageKey
		)

		if (!clicked) {
			takeEvidence('ImageClickFailed_' + sanitizeFileName(imageGroup + '_' + imageKey) + '.png')

			KeywordUtil.markFailedAndStop(
				'Image was found on disk, but could not be clicked on screen.\n' +
				'Group: ' + imageGroup + '\n' +
				'Key: ' + imageKey + '\n' +
				'Path: ' + getImage(imageGroup, imageKey)
			)
		}
	}

	@Keyword
	boolean clickFirstVisibleInGroup(String imageGroup) {
		validateGroup(imageGroup)

		for (String imageKey : IMAGE_GROUPS[imageGroup].keySet()) {
			if (clickVisible(imageGroup, imageKey)) {
				return true
			}
		}

		return false
	}

	@Keyword
	void clickFirstVisibleInGroupOrStop(String imageGroup) {
		boolean clicked = clickFirstVisibleInGroup(imageGroup)

		if (!clicked) {
			takeEvidence('ImageGroupClickFailed_' + sanitizeFileName(imageGroup) + '.png')

			KeywordUtil.markFailedAndStop(
				'No visible image from group could be clicked.\n' +
				'Group: ' + imageGroup + '\n' +
				'Images in group: ' + IMAGE_GROUPS[imageGroup].keySet()
			)
		}
	}

	@Keyword
	boolean waitAndClickFirstVisibleInGroup(String imageGroup, int timeoutSeconds) {
		validateGroup(imageGroup)

		int timeout = getSafeTimeout(timeoutSeconds)
		int elapsedSeconds = 0

		while (elapsedSeconds < timeout) {
			for (String imageKey : IMAGE_GROUPS[imageGroup].keySet()) {
				String imagePath = getImage(imageGroup, imageKey)

				try {
					if (isImageFound(WindowsImageKeywords.findImage(imagePath))) {
						KeywordUtil.logInfo(
							'Visible image found. Clicking image.\n' +
							'Group: ' + imageGroup + '\n' +
							'Key: ' + imageKey + '\n' +
							'Path: ' + imagePath
						)

						WindowsImageKeywords.clickImage(imagePath)
						Windows.delay(2)

						return true
					}
				} catch (Exception e) {
					KeywordUtil.logInfo(
						'Image was not clickable yet.\n' +
						'Group: ' + imageGroup + '\n' +
						'Key: ' + imageKey + '\n' +
						'Reason: ' + e.getMessage()
					)
				}
			}

			Windows.delay(1)
			elapsedSeconds = elapsedSeconds + 1
		}

		return false
	}

	@Keyword
	boolean waitAndDoubleClickFirstVisibleInGroup(String imageGroup, int timeoutSeconds) {
		validateGroup(imageGroup)

		int timeout = getSafeTimeout(timeoutSeconds)
		int elapsedSeconds = 0

		while (elapsedSeconds < timeout) {
			for (String imageKey : IMAGE_GROUPS[imageGroup].keySet()) {
				String imagePath = getImage(imageGroup, imageKey)

				try {
					if (isImageFound(WindowsImageKeywords.findImage(imagePath))) {
						KeywordUtil.logInfo(
							'Visible image found. Double clicking image.\n' +
							'Group: ' + imageGroup + '\n' +
							'Key: ' + imageKey + '\n' +
							'Path: ' + imagePath
						)

						WindowsImageKeywords.doubleClickImage(imagePath)
						Windows.delay(2)

						return true
					}
				} catch (Exception e) {
					KeywordUtil.logInfo(
						'Image was not double clickable yet.\n' +
						'Group: ' + imageGroup + '\n' +
						'Key: ' + imageKey + '\n' +
						'Reason: ' + e.getMessage()
					)
				}
			}

			Windows.delay(1)
			elapsedSeconds = elapsedSeconds + 1
		}

		return false
	}

	@Keyword
	boolean tryClickFirstVisibleInGroup(String imageGroup) {
		if (!IMAGE_GROUPS.containsKey(imageGroup)) {
			KeywordUtil.logInfo('Image group not found for optional click: ' + imageGroup)
			return false
		}

		for (String imageKey : IMAGE_GROUPS[imageGroup].keySet()) {
			File imageFile = resolveImageFileOptional(IMAGE_GROUPS[imageGroup][imageKey])

			if (imageFile == null || !imageFile.exists()) {
				KeywordUtil.logInfo(
					'Optional image file not resolved.\n' +
					'Group: ' + imageGroup + '\n' +
					'Key: ' + imageKey
				)

				continue
			}

			try {
				if (isImageFound(WindowsImageKeywords.findImage(imageFile.getAbsolutePath()))) {
					WindowsImageKeywords.clickImage(imageFile.getAbsolutePath())
					Windows.delay(1)

					KeywordUtil.logInfo(
						'Clicked optional visible image.\n' +
						'Group: ' + imageGroup + '\n' +
						'Key: ' + imageKey
					)

					return true
				}
			} catch (Exception e) {
				KeywordUtil.logInfo(
					'Optional image click failed.\n' +
					'Group: ' + imageGroup + '\n' +
					'Key: ' + imageKey + '\n' +
					'Reason: ' + e.getMessage()
				)
			}
		}

		return false
	}

	@Keyword
	void clickImageInsideImageOrStop(String imageGroup, String parentImageKey, String childImageKey) {
		String parentImage = getImage(imageGroup, parentImageKey)
		String childImage = getImage(imageGroup, childImageKey)

		try {
			WindowsImageKeywords.clickImageInImage(parentImage, childImage)
			Windows.delay(1)

			KeywordUtil.logInfo(
				'Clicked image inside image.\n' +
				'Group: ' + imageGroup + '\n' +
				'Parent image: ' + parentImageKey + '\n' +
				'Child image: ' + childImageKey
			)
		} catch (Exception e) {
			takeEvidence('ImageInsideImageClickFailed_' + sanitizeFileName(imageGroup + '_' + parentImageKey + '_' + childImageKey) + '.png')

			KeywordUtil.markFailedAndStop(
				'Could not click image inside image.\n' +
				'Group: ' + imageGroup + '\n' +
				'Parent image: ' + parentImageKey + '\n' +
				'Child image: ' + childImageKey + '\n' +
				'Parent path: ' + parentImage + '\n' +
				'Child path: ' + childImage + '\n' +
				'Reason: ' + e.getMessage()
			)
		}
	}

	@Keyword
	void takeEvidence(String fileName) {
		try {
			String evidenceDir = RunConfiguration.getReportFolder() + '\\Evidences\\'
			new File(evidenceDir).mkdirs()

			WindowsActionHelper
				.create(WindowsDriverFactory.getWindowsSession())
				.takeScreenshot(evidenceDir + fileName)

			KeywordUtil.logInfo('Evidence captured: ' + evidenceDir + fileName)
		} catch (Exception e) {
			KeywordUtil.logInfo('Could not capture evidence: ' + e.getMessage())
		}
	}

	private File resolveImageFileOrStop(String imageGroup, String imageKey, String relativePath) {
		File imageFile = resolveImageFileOptional(relativePath)

		if (imageFile != null && imageFile.exists()) {
			return imageFile
		}

		File expectedFile = new File(
			RunConfiguration.getProjectDir(),
			normalizeRelativePath(relativePath)
		)

		KeywordUtil.markFailedAndStop(
			'Image file not found.\n' +
			'Group: ' + imageGroup + '\n' +
			'Key: ' + imageKey + '\n' +
			'Expected relative path: ' + relativePath + '\n' +
			'Resolved absolute path: ' + expectedFile.getAbsolutePath() + '\n' +
			'Project dir: ' + RunConfiguration.getProjectDir() + '\n' +
			'Available files in folder:\n' + getAvailableFilesFromImageFolder(expectedFile)
		)

		return null
	}

	private File resolveImageFileOptional(String relativePath) {
		String normalizedRelativePath = normalizeRelativePath(relativePath)

		File exactFile = new File(
			RunConfiguration.getProjectDir(),
			normalizedRelativePath
		)

		if (exactFile.exists()) {
			return exactFile
		}

		File parentFolder = exactFile.getParentFile()

		if (parentFolder == null || !parentFolder.exists() || !parentFolder.isDirectory()) {
			return null
		}

		String expectedName = normalizeLooseName(exactFile.getName())
		File[] files = parentFolder.listFiles()

		if (files == null) {
			return null
		}

		for (File file : files) {
			if (normalizeLooseName(file.getName()).equals(expectedName)) {
				KeywordUtil.logInfo(
					'Image path corrected automatically.\n' +
					'Expected: ' + exactFile.getAbsolutePath() + '\n' +
					'Resolved: ' + file.getAbsolutePath()
				)

				return file
			}
		}

		return null
	}

	private String getAvailableFilesFromImageFolder(File expectedFile) {
		try {
			File parentFolder = expectedFile.getParentFile()

			if (parentFolder == null || !parentFolder.exists()) {
				return 'Folder not found: ' + parentFolder
			}

			File[] files = parentFolder.listFiles()

			if (files == null || files.length == 0) {
				return 'Folder is empty: ' + parentFolder.getAbsolutePath()
			}

			return files.collect { File file -> file.getName() }.sort().join('\n')
		} catch (Exception e) {
			return 'Could not list available files. Reason: ' + e.getMessage()
		}
	}

	private String normalizeRelativePath(String relativePath) {
		return relativePath
			.replace('/', File.separator)
			.replace('\\', File.separator)
			.trim()
	}

	private String normalizeLooseName(String name) {
		String normalized = Normalizer
			.normalize(name, Normalizer.Form.NFD)
			.replaceAll('\\p{InCombiningDiacriticalMarks}+', '')

		normalized = normalized
			.toLowerCase()
			.replace('dimensions', 'dimension')
			.replaceAll('[^a-z0-9]', '')

		return normalized
	}

	private String sanitizeFileName(String value) {
		return value.replaceAll('[^a-zA-Z0-9_\\-]', '_')
	}

	private int getSafeTimeout(int timeoutSeconds) {
		if (timeoutSeconds <= 0) {
			return 1
		}

		return timeoutSeconds
	}

	private boolean isImageFound(def imageResult) {
		return imageResult != null && imageResult != false
	}

	private void validateGroup(String imageGroup) {
		if (imageGroup == null || imageGroup.trim().isEmpty()) {
			KeywordUtil.markFailedAndStop('Image group is empty.')
		}

		if (!IMAGE_GROUPS.containsKey(imageGroup)) {
			KeywordUtil.markFailedAndStop(
				'Image group not found: ' + imageGroup + '\n' +
				'Available groups: ' + IMAGE_GROUPS.keySet()
			)
		}
	}

	private void validateImageKey(String imageGroup, String imageKey) {
		validateGroup(imageGroup)

		if (imageKey == null || imageKey.trim().isEmpty()) {
			KeywordUtil.markFailedAndStop(
				'Image key is empty.\n' +
				'Group: ' + imageGroup
			)
		}

		if (!IMAGE_GROUPS[imageGroup].containsKey(imageKey)) {
			KeywordUtil.markFailedAndStop(
				'Image key not found: ' + imageKey + '\n' +
				'Group: ' + imageGroup + '\n' +
				'Available keys: ' + IMAGE_GROUPS[imageGroup].keySet()
			)
		}
	}
}
