import java.io.FileInputStream
import java.text.Normalizer

import org.apache.poi.ss.usermodel.Workbook
import org.apache.poi.ss.usermodel.WorkbookFactory

import com.kms.katalon.core.util.KeywordUtil


// ======================================================
// VALIDATION CONFIG
// ======================================================

String validationName = 'Emission Valorisation Brute'

String exportRootFolder = 'C:\\KatalonExports'
String exportGroupFolder = 'JV_Emissions'
String exportFeatureFolder = 'Emission_Valorisation_Brute'


// ======================================================
// TEST FLOW
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Start REC x PRD validation\n' +
	'Feature: ' + validationName + '\n' +
	'Validation: Number of rows\n' +
	'Export root: ' + exportRootFolder + '\n' +
	'Export folder: ' +
	exportGroupFolder + '\\' + exportFeatureFolder
)

Map selectedFiles = resolveLatestRecPrdFiles(
	new File(exportRootFolder),
	exportGroupFolder,
	exportFeatureFolder
)

File recFile = selectedFiles.recFile as File
File prdFile = selectedFiles.prdFile as File
File selectedFolder = selectedFiles.selectedFolder as File

String recFileName =
	recFile == null
		? 'NOT FOUND'
		: recFile.getName()

String prdFileName =
	prdFile == null
		? 'NOT FOUND'
		: prdFile.getName()

String selectedFolderPath =
	selectedFolder == null
		? 'NOT FOUND'
		: selectedFolder.getAbsolutePath()


// ======================================================
// VALIDATE FILES
// ======================================================

if (recFile == null || prdFile == null) {

	String errorMessage =
		'REC x PRD validation cannot be executed.\n' +
		'Feature: ' + validationName + '\n' +
		'REC file: ' + recFileName + '\n' +
		'PRD file: ' + prdFileName + '\n' +
		'Search root: ' + exportRootFolder + '\n' +
		'Expected folder: ' +
		exportGroupFolder + '\\' + exportFeatureFolder

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[FAIL] Files selected for validation\n' +
		errorMessage
	)

	KeywordUtil.markFailedAndStop(errorMessage)
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'[PASS] Files selected for validation\n' +
	'Folder: ' + selectedFolderPath + '\n' +
	'REC file: ' + recFileName + '\n' +
	'PRD file: ' + prdFileName
)


// ======================================================
// READ ROW COUNTS
// ======================================================

Map recResult = readRowCount(recFile, 'REC')
Map prdResult = readRowCount(prdFile, 'PRD')

String recError = safeText(recResult.error)
String prdError = safeText(prdResult.error)

if (!recError.isEmpty() || !prdError.isEmpty()) {

	String errorMessage =
		'Excel row validation could not be executed.\n' +
		(recError.isEmpty() ? '' : recError + '\n') +
		(prdError.isEmpty() ? '' : prdError)

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[FAIL] Excel validation result\n' +
		errorMessage
	)

	KeywordUtil.markFailedAndStop(errorMessage)
}

Integer recRows = recResult.rows as Integer
Integer prdRows = prdResult.rows as Integer

boolean success = recRows == prdRows


// ======================================================
// REPORT EXCEL RESULT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	(success ? '[PASS] ' : '[FAIL] ') +
	'Excel validation result\n' +
	'Feature: ' + validationName + '\n' +
	'REC file: ' + recFileName + '\n' +
	'PRD file: ' + prdFileName + '\n' +
	'REC rows: ' + recRows + '\n' +
	'PRD rows: ' + prdRows
)


// ======================================================
// FINAL RESULT
// ======================================================

if (!success) {

	String errorMessage =
		'[ERROR] Number of rows is different between environments.\n' +
		'REC: ' + recRows + '\n' +
		'PRD: ' + prdRows

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[FAIL] Final validation result\n' +
		errorMessage
	)

	KeywordUtil.markFailed(
		'REC x PRD validation failed for ' +
		validationName + '.\n' +
		errorMessage
	)

} else {

	String passedMessage =
		'[PASS] Number of rows is equal between environments.\n' +
		'REC: ' + recRows + '\n' +
		'PRD: ' + prdRows

	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'[PASS] Final validation result\n' +
		'REC x PRD validation completed successfully.\n' +
		passedMessage
	)

	KeywordUtil.markPassed(
		'REC x PRD validation completed successfully for ' +
		validationName + '.'
	)
}


// ======================================================
// FILE SEARCH HELPERS
// ======================================================

Map resolveLatestRecPrdFiles(
		File exportRoot,
		String expectedGroupFolder,
		String expectedFeatureFolder) {

	Map result = [
		recFile        : null,
		prdFile        : null,
		selectedFolder : null
	]

	if (exportRoot == null ||
		!exportRoot.exists() ||
		!exportRoot.isDirectory()) {

		return result
	}

	List<File> matchingFeatureFolders = []

	collectMatchingFeatureFolders(
		exportRoot,
		expectedGroupFolder,
		expectedFeatureFolder,
		matchingFeatureFolders
	)

	List<Map> validPairs = []

	for (File featureFolder : matchingFeatureFolders) {

		File[] folderFiles = featureFolder.listFiles()

		if (folderFiles == null) {
			continue
		}

		List<File> recFiles = folderFiles.findAll { File file ->
			isEnvironmentExcelFile(file, 'REC')
		}

		List<File> prdFiles = folderFiles.findAll { File file ->
			isEnvironmentExcelFile(file, 'PRD')
		}

		if (recFiles.isEmpty() || prdFiles.isEmpty()) {
			continue
		}

		recFiles.sort { File first, File second ->
			second.lastModified() <=> first.lastModified()
		}

		prdFiles.sort { File first, File second ->
			second.lastModified() <=> first.lastModified()
		}

		File latestRecFile = recFiles.get(0)
		File latestPrdFile = prdFiles.get(0)

		validPairs.add([
			recFile        : latestRecFile,
			prdFile        : latestPrdFile,
			selectedFolder : featureFolder,
			lastUpdate     : Math.max(
				latestRecFile.lastModified(),
				latestPrdFile.lastModified()
			)
		])
	}

	if (validPairs.isEmpty()) {
		return result
	}

	validPairs.sort { Map first, Map second ->
		(second.lastUpdate as Long) <=>
		(first.lastUpdate as Long)
	}

	Map latestPair = validPairs.get(0)

	result.recFile = latestPair.recFile
	result.prdFile = latestPair.prdFile
	result.selectedFolder = latestPair.selectedFolder

	return result
}


void collectMatchingFeatureFolders(
		File currentFolder,
		String expectedGroupFolder,
		String expectedFeatureFolder,
		List<File> result) {

	if (currentFolder == null ||
		!currentFolder.exists() ||
		!currentFolder.isDirectory()) {

		return
	}

	File parentFolder = currentFolder.getParentFile()

	boolean featureMatches =
		normalizeFolderName(currentFolder.getName()) ==
		normalizeFolderName(expectedFeatureFolder)

	boolean groupMatches =
		parentFolder != null &&
		normalizeFolderName(parentFolder.getName()) ==
		normalizeFolderName(expectedGroupFolder)

	if (featureMatches && groupMatches) {
		result.add(currentFolder)
		return
	}

	File[] children = currentFolder.listFiles()

	if (children == null) {
		return
	}

	for (File child : children) {

		if (child != null && child.isDirectory()) {

			collectMatchingFeatureFolders(
				child,
				expectedGroupFolder,
				expectedFeatureFolder,
				result
			)
		}
	}
}


boolean isEnvironmentExcelFile(
		File file,
		String environment) {

	if (file == null ||
		!file.exists() ||
		!file.isFile()) {

		return false
	}

	String fileName = file.getName()

	if (fileName.startsWith('~$')) {
		return false
	}

	String normalizedFileName = fileName.toUpperCase()
	String expectedPrefix = safeText(environment).toUpperCase() + '_'

	return normalizedFileName.startsWith(expectedPrefix) &&
		isExcelFileName(fileName)
}


boolean isExcelFileName(String fileName) {

	String normalizedName = safeText(fileName).toLowerCase()

	return normalizedName.endsWith('.xlsx') ||
		normalizedName.endsWith('.xls') ||
		normalizedName.endsWith('.xlsm')
}


// ======================================================
// EXCEL HELPERS
// ======================================================

Map readRowCount(
		File excelFile,
		String environment) {

	Map result = [
		rows  : 0,
		error : ''
	]

	FileInputStream input = null
	Workbook workbook = null

	try {

		input = new FileInputStream(excelFile)
		workbook = WorkbookFactory.create(input)

		if (workbook.getNumberOfSheets() == 0) {

			result.error =
				'[ERROR] ' + environment +
				' workbook does not contain worksheets.\n' +
				'File: ' + excelFile.getName()

			return result
		}

		result.rows =
			workbook
				.getSheetAt(0)
				.getLastRowNum()

	} catch (Exception exception) {

		result.error =
			'[ERROR] Failed to read ' +
			environment + ' Excel file.\n' +
			'File: ' + excelFile.getName() + '\n' +
			'Exception: ' +
			exception.getClass().getSimpleName() + '\n' +
			'Message: ' +
			safeText(exception.getMessage())

	} finally {

		try {
			if (workbook != null) {
				workbook.close()
			}
		} catch (Exception ignored) {
		}

		try {
			if (input != null) {
				input.close()
			}
		} catch (Exception ignored) {
		}
	}

	return result
}


// ======================================================
// GENERAL HELPERS
// ======================================================

String normalizeFolderName(Object value) {

	String text = safeText(value)

	if (text.isEmpty()) {
		return ''
	}

	text = Normalizer.normalize(
		text,
		Normalizer.Form.NFD
	)

	text = text.replaceAll(
		'\\p{InCombiningDiacriticalMarks}+',
		''
	)

	return text
		.toLowerCase()
		.replace(' ', '_')
		.replace('-', '_')
		.replaceAll('_+', '_')
		.trim()
}


String safeText(Object value) {

	if (value == null) {
		return ''
	}

	return value.toString().trim()
}

