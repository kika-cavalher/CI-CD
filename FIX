/*
 * Responsibility:
 * Shared runner for desktop Jenkins pipelines.
 *
 * Jenkins controls only:
 * - validate environment
 * - prepare reports folder
 * - execute suite/collection list
 * - archive reports
 * - trigger next Jenkins job when configured
 *
 * Katalon keeps the REC/PRD opening and closing logic internally.
 */

def loadPaths(script) {
    return script.load('jenkinsIntegration/JenkinsPaths.groovy')
}

def loadConsoleView(script) {
    return script.load('jenkinsIntegration/JenkinsConsoleView.groovy')
}

def loadResultStore(script) {
    return script.load('jenkinsIntegration/JenkinsResultStore.groovy')
}

def loadDesktopTaskLogger(script) {
    return script.load('jenkinsIntegration/JenkinsDesktopTaskLogger.groovy')
}

def validateEnvironment(script, Map cfg, def paths) {
    script.bat """
@echo off
echo ------------------------------------------------------------
echo VALIDATING ENVIRONMENT
echo ------------------------------------------------------------

if not exist "${cfg.execution.katalonExe}" (
    echo [ERROR] Katalon executable not found
    echo ${cfg.execution.katalonExe}
    exit /b 1
)

if not exist "${paths.projectPath(script, cfg.execution.projectFileName)}" (
    echo [ERROR] Project file not found
    echo ${paths.projectPath(script, cfg.execution.projectFileName)}
    exit /b 1
)

echo [OK] Environment validated
echo ------------------------------------------------------------
"""
}

def prepareArtifacts(script, def paths, def resultStore) {
    script.bat """
@echo off
if exist "${paths.reportsRoot(script)}" rmdir /s /q "${paths.reportsRoot(script)}"
mkdir "${paths.reportsRoot(script)}"
mkdir "${paths.logsRoot(script)}"
mkdir "${paths.artifactsRoot(script)}"
"""

    resultStore.saveResults(script, paths.reportsRoot(script), [])
}

def buildResultFromMeta(def resultStore, script, String reportsRoot, Map asset, int exitCode) {
    def meta = resultStore.readAssetMeta(script, reportsRoot, asset.name)

    return [
        name            : asset.name,
        type            : meta['ASSET_TYPE'] ?: asset.type,
        path            : meta['ASSET_PATH'] ?: asset.path,
        status          : meta['STATUS'] ?: (exitCode == 0 ? 'PASSED' : (exitCode == 124 ? 'TIMEOUT' : 'FAILED')),
        icon            : meta['ICON'] ?: (exitCode == 0 ? '✅' : (exitCode == 124 ? '⏰' : '❌')),
        exitCode        : meta['EXIT_CODE'] ?: "${exitCode}",
        executed        : meta['EXECUTED'] ?: '0',
        passed          : meta['PASSED'] ?: '0',
        failed          : meta['FAILED'] ?: '0',
        skipped         : meta['SKIPPED'] ?: '0',
        durationSeconds : meta['DURATION_SECONDS'] ?: '0',
        reason          : meta['REASON'] ?: '',
        logRel          : meta['LOG_REL'] ?: '',
        caseSummary     : resultStore.splitSummary(meta['CASE_SUMMARY'] ?: '')
    ]
}

def run(script, Map cfg) {
    def paths = loadPaths(script)
    def consoleView = loadConsoleView(script)
    def resultStore = loadResultStore(script)
    def taskLogger = loadDesktopTaskLogger(script)

    def results = []

    script.stage('Validate Environment') {
        validateEnvironment(script, cfg, paths)
    }

    script.stage('Prepare Artifacts') {
        prepareArtifacts(script, paths, resultStore)
    }

    script.stage(cfg.execution.stageName ?: 'Run Test Assets') {
        cfg.assets.each { asset ->
            script.stage("Run - ${asset.name}") {
                def timeoutMinutes = (asset.timeoutMinutes ?: cfg.execution.defaultTimeoutMinutes).toString()

                consoleView.printAssetHeader(script, asset, timeoutMinutes)

                int exitCode = taskLogger.runAsset(script, [
                    katalonExe            : cfg.execution.katalonExe,
                    projectPath           : paths.projectPath(script, cfg.execution.projectFileName),
                    reportsRoot           : paths.reportsRoot(script),
                    defaultTimeoutMinutes : cfg.execution.defaultTimeoutMinutes,
                    winDriverTask         : cfg.execution.winDriverTask
                ], asset)

                def result = buildResultFromMeta(resultStore, script, paths.reportsRoot(script), asset, exitCode)

                results << result
                resultStore.saveResults(script, paths.reportsRoot(script), results)

                consoleView.printAssetResult(script, result)
                consoleView.printRunningSummary(script, results)

                if (result.status != 'PASSED' && asset.stopPipelineOnFailure == true) {
                    script.error("${asset.name} finished with status ${result.status} and stopPipelineOnFailure=true")
                }

                if (result.status != 'PASSED') {
                    script.currentBuild.result = 'FAILURE'
                }
            }
        }
    }

    try {
        consoleView.printFinalSummary(script, results, script.currentBuild.currentResult)
    }
    catch (ignored) {
    }

    script.catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
        script.junit allowEmptyResults: true, testResults: 'Reports/**/JUnit_Report.xml,Reports/logs/*.junit.xml'
    }

    script.catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
        script.archiveArtifacts artifacts: 'Reports/**/*', allowEmptyArchive: true
    }

    if (script.currentBuild.currentResult == 'SUCCESS') {
        def nextJobName = (cfg.nextJobName ?: '').trim()

        if (nextJobName) {
            script.echo "Triggering next Jenkins job as a separate build: ${nextJobName}"

            script.build job: nextJobName,
                         wait: false,
                         propagate: false

            script.echo "Next Jenkins job triggered successfully: ${nextJobName}"
        }
        else {
            script.echo 'No next Jenkins job configured.'
        }
    }
}

