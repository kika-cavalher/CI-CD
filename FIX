// GROUP BY
// ======================================================

@Keyword
void dragAndDropImage(
		String sourceImageKey,
		String targetImageKey,
		Integer timeoutSeconds
	) {

	Integer timeout = safeTimeout(timeoutSeconds, 10)

	logStep(
			'DRAG AND DROP',
			'Source: ' + sourceImageKey + '\n' +
			'Target: ' + targetImageKey
			)

	boolean sourceVisible = false
	boolean targetVisible = false

	try {
		sourceVisible =
				imageLoader.waitForImage(
				GUI_IMAGE_GROUP,
				sourceImageKey,
				timeout
				)
	} catch (Exception ignored) {
		sourceVisible = false
	}

	try {
		targetVisible =
				imageLoader.waitForImage(
				GUI_IMAGE_GROUP,
				targetImageKey,
				timeout
				)
	} catch (Exception ignored) {
		targetVisible = false
	}

	/*
	 * Quando o Group By já foi aplicado, a origem e o destino
	 * deixam de ter a mesma aparência.
	 *
	 * Não falhar aqui.
	 * validateGroupByResult confirma o estado real depois.
	 */
	if (!sourceVisible || !targetVisible) {
		KeywordUtil.logInfo(
				'[INFO] Drag and drop images are no longer both visible.\n' +
				'The Group By may already be applied.\n' +
				'Source: ' + sourceImageKey + '\n' +
				'Source visible: ' + sourceVisible + '\n' +
				'Target: ' + targetImageKey + '\n' +
				'Target visible: ' + targetVisible + '\n' +
				'Continuing to final Group By validation.'
				)

		return
	}

	try {
		WindowsImageKeywords.dragAndDrop(
				image(
				GUI_IMAGE_GROUP,
				sourceImageKey
				),
				image(
				GUI_IMAGE_GROUP,
				targetImageKey
				)
				)

		KeywordUtil.logInfo(
				'[PASS] Drag and drop command executed.\n' +
				'Source: ' + sourceImageKey + '\n' +
				'Target: ' + targetImageKey
				)
	} catch (Exception e) {
		/*
		 * Não repetir o drag.
		 * O comando pode mover a coluna e ainda lançar uma exceção.
		 */
		KeywordUtil.logInfo(
				'[INFO] Drag and drop command returned an exception.\n' +
				'The command will not be repeated.\n' +
				'The final state will be validated afterwards.\n' +
				'Source: ' + sourceImageKey + '\n' +
				'Target: ' + targetImageKey + '\n' +
				'Reason: ' + safeMessage(e)
				)
	}

	Windows.delay(2)
}


@Keyword
void validateGroupByResult(Integer timeoutSeconds) {

	Integer timeout = safeTimeout(timeoutSeconds, 10)
	List<String> errors = []

	String expectedFirstLevelLabel = 'Grappe'

	String expectedSecondLevelLabel =
			'Ecart bilan vs. compte de résultat ccy'

	logStep(
			'GROUP BY RESULT',
			'Validate the first Grappe row\n' +
			'Open the first Grappe row\n' +
			'Validate the first row displayed inside it\n' +
			'Expected child label: ' +
			expectedSecondLevelLabel
			)

	WindowsTestObject firstLevelObject =
			object(
			'firstLevelGroupBy'
			)

	// ======================================================
	// FIND AND VALIDATE FIRST GRAPPE ROW
	// ======================================================

	boolean firstLevelPresent =
			Windows.waitForElementPresent(
			firstLevelObject,
			timeout,
			FailureHandling.OPTIONAL
			)

	if (!firstLevelPresent) {
		errors.add(
				'The first Grappe row was not found.\n' +
				'Expected format: Grappe: POSITIVE INTEGER\n' +
				'Object: firstLevelGroupBy'
				)
	}

	String firstLevelText = ''

	if (errors.isEmpty()) {
		firstLevelText =
				readGroupByRowText(
				firstLevelObject
				)

		KeywordUtil.logInfo(
				'[INFO] First Grappe row found.\n' +
				'Actual text: ' + firstLevelText
				)

		validateGroupLabel(
				firstLevelText,
				expectedFirstLevelLabel,
				true,
				errors
				)
	}

	// ======================================================
	// OPEN FIRST GRAPPE ROW
	// ======================================================

	if (errors.isEmpty()) {
		try {
			Windows.doubleClick(
					firstLevelObject,
					FailureHandling.STOP_ON_FAILURE
					)

			KeywordUtil.logInfo(
					'[PASS] First Grappe row opened.\n' +
					'Row: ' + firstLevelText
					)
		} catch (Exception e) {
			errors.add(
					'Could not open the first Grappe row.\n' +
					'Object: firstLevelGroupBy\n' +
					'Reason: ' + safeMessage(e)
					)
		}
	}

	// ======================================================
	// FIND FIRST ROW INSIDE OPENED GRAPPE
	// ======================================================

	if (errors.isEmpty()) {
		Windows.delay(1)

		WindowsTestObject secondLevelObject =
				object(
				'secondLevelGroupBy'
				)

		boolean secondLevelPresent =
				Windows.waitForElementPresent(
				secondLevelObject,
				timeout,
				FailureHandling.OPTIONAL
				)

		if (!secondLevelPresent) {
			errors.add(
					'The first row inside the opened Grappe was not found.\n' +
					'Expected format: ' +
					expectedSecondLevelLabel +
					': NUMBER\n' +
					'Object: secondLevelGroupBy'
					)
		} else {
			String secondLevelText =
					readGroupByRowText(
					secondLevelObject
					)

			KeywordUtil.logInfo(
					'[INFO] First row inside Grappe found.\n' +
					'Actual text: ' + secondLevelText
					)

			validateGroupLabel(
					secondLevelText,
					expectedSecondLevelLabel,
					false,
					errors
					)

			if (errors.isEmpty()) {
				KeywordUtil.logInfo(
						'[PASS] First row inside Grappe is valid.\n' +
						'Expected label: ' +
						expectedSecondLevelLabel + '\n' +
						'Actual text: ' +
						secondLevelText
						)
			}
		}
	}

	takeEvidence(
			'GUI_GroupByResultValidated.png'
			)

	finishValidation(
			'Group By result validation',
			errors
			)
}


private String readGroupByRowText(
		WindowsTestObject targetObject
	) {

	List<String> attributes = [
		'Name',
		'LegacyValue',
		'Value.Value'
	]

	for (String attributeName : attributes) {
		try {
			String value =
					safeText(
					Windows.getAttribute(
					targetObject,
					attributeName,
					FailureHandling.OPTIONAL
					)
					)

			if (!value.isEmpty()) {
				KeywordUtil.logInfo(
						'[INFO] Group By row text read.\n' +
						'Attribute: ' + attributeName + '\n' +
						'Value: ' + value
						)

				return value
			}
		} catch (Exception ignored) {
		}
	}

	return ''
}


private void validateGroupLabel(
		String rawValue,
		String expectedLabel,
		boolean requirePositiveInteger,
		List<String> errors
	) {

	String normalizedValue =
			safeText(rawValue)
			.replace('\u00A0', ' ')
			.replaceAll(/\s+/, ' ')
			.trim()

	if (normalizedValue.isEmpty()) {
		errors.add(
				'Group By row text is empty.\n' +
				'Expected label: ' + expectedLabel
				)

		return
	}

	Integer separatorIndex =
			normalizedValue.lastIndexOf(':')

	if (separatorIndex <= 0) {
		errors.add(
				'Invalid Group By format.\n' +
				'Expected: ' + expectedLabel + ': NUMBER\n' +
				'Actual: ' + normalizedValue
				)

		return
	}

	String actualLabel =
			normalizedValue
			.substring(
			0,
			separatorIndex
			)
			.trim()

	String numericText =
			normalizedValue
			.substring(
			separatorIndex + 1
			)
			.trim()
			.replace('\u00A0', '')
			.replace(' ', '')
			.replace(',', '.')

	if (!actualLabel.equalsIgnoreCase(expectedLabel)) {
		errors.add(
				'Unexpected Group By label.\n' +
				'Expected: ' + expectedLabel + '\n' +
				'Actual: ' + actualLabel
				)

		return
	}

	if (numericText.isEmpty()) {
		errors.add(
				expectedLabel +
				' numeric value is empty.\n' +
				'Actual row: ' + normalizedValue
				)

		return
	}

	if (requirePositiveInteger) {
		if (!(numericText ==~ /\d+/)) {
			errors.add(
					expectedLabel +
					' value must be an integer.\n' +
					'Actual: ' + numericText
					)

			return
		}

		try {
			BigInteger numericValue =
					new BigInteger(
					numericText
					)

			if (numericValue <= BigInteger.ZERO) {
				errors.add(
						expectedLabel +
						' value must be greater than zero.\n' +
						'Actual: ' + numericValue
						)

				return
			}

			KeywordUtil.logInfo(
					'[PASS] First Group By level is valid.\n' +
					'Label: ' + actualLabel + '\n' +
					'Value: ' + numericValue
					)
		} catch (Exception e) {
			errors.add(
					expectedLabel +
					' integer value is invalid.\n' +
					'Actual: ' + numericText
					)
		}

		return
	}

	try {
		BigDecimal numericValue =
				new BigDecimal(
				numericText
				)

		KeywordUtil.logInfo(
				'[PASS] Second Group By level is valid.\n' +
				'Label: ' + actualLabel + '\n' +
				'Value: ' + numericValue
				)
	} catch (Exception e) {
		errors.add(
				expectedLabel +
				' numeric value is invalid.\n' +
				'Actual: ' + numericText
				)
	}
}
