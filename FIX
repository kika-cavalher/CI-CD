	// ======================================================
	// PRIVATE GROUP BY HELPERS
	// ======================================================

	private void validateGroupByValue(
		String objectPath,
		String expectedLabel,
		boolean integerOnly,
		boolean strictlyPositive,
		Integer timeoutSeconds
	) {
		int safeTimeout = safeTimeout(timeoutSeconds, 10)
		WindowsTestObject groupObject = findWindowsObject(objectPath)

		boolean present = Windows.waitForElementPresent(
			groupObject,
			safeTimeout,
			FailureHandling.OPTIONAL
		)

		if (!present) {
			KeywordUtil.markFailedAndStop(
				'Group By element was not found.\n' +
				'Object: ' + objectPath
			)
		}

		String legacyValue = safeText(
			Windows.getAttribute(groupObject, 'LegacyValue')
		)

		int separatorIndex = legacyValue.lastIndexOf(':')

		if (separatorIndex <= 0 || separatorIndex >= legacyValue.length() - 1) {
			KeywordUtil.markFailedAndStop(
				'Group By text has an invalid format.\n' +
				'Expected: ' + expectedLabel + ':NUMBER\n' +
				'Actual: ' + legacyValue
			)
		}

		String actualLabel = legacyValue.substring(0, separatorIndex).trim()
		String numericText = legacyValue.substring(separatorIndex + 1).trim()

		if (normalizeComparableText(actualLabel) !=
			normalizeComparableText(expectedLabel)) {
			KeywordUtil.markFailedAndStop(
				'Group By label is incorrect.\n' +
				'Expected: ' + expectedLabel + '\n' +
				'Actual: ' + actualLabel
			)
		}

		BigDecimal numericValue = parseNumber(numericText, integerOnly)

		if (numericValue == null) {
			KeywordUtil.markFailedAndStop(
				'Group By numeric value is invalid.\n' +
				'Expected format: ' +
				(integerOnly ? 'INTEGER' : 'NUMBER') + '\n' +
				'Actual: ' + numericText
			)
		}

		if (strictlyPositive && numericValue.compareTo(BigDecimal.ZERO) <= 0) {
			KeywordUtil.markFailedAndStop(
				'Group By numeric value must be greater than zero.\n' +
				'Actual: ' + numericText
			)
		}

		KeywordUtil.markPassed(
			'Group By value validated successfully.\n' +
			'Label: ' + actualLabel + '\n' +
			'Value: ' + numericText
		)
	}

