schtasks /run /tn "startWinDriver"
schtasks /run /tn "\eMatch Automation\ContreVal"
:loop
for /f "tokens=2 delims=: " %%f in ('schtasks /query /tn "\eMatch Automation\ContreVal" /fo list ^| find "Status:"' ) do (
    if "%%f"=="Running" (
        ping -n 6 localhost >nul 2>nul
        goto loop
    )
)
schtasks /end /tn "startWinDriver"
