package pageObject

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.util.KeywordUtil
import internal.GlobalVariable
import io.appium.java_client.windows.WindowsDriver
import org.openqa.selenium.By
import org.openqa.selenium.Keys
import org.openqa.selenium.WebElement
import org.openqa.selenium.remote.DesiredCapabilities

import java.net.Socket
import java.net.URL
import java.time.Duration

class authentication {

    private static final String WIN_APP_DRIVER_URL = 'http://127.0.0.1:4723'
    private static final String DEFAULT_WINDOW_TITLE = 'eMatch 26.1.1.3'
    private static final String DEFAULT_WIN_APP_DRIVER_PATH = 'C:\\Program Files (x86)\\Windows Application Driver\\WinAppDriver.exe'

    private static WindowsDriver desktopSession
    private static WindowsDriver appSession

    @Keyword
    String getCurrentWindowsUser() {
        return System.getProperty('user.name') ?: ''
    }

    @Keyword
    String resolveWindowTitle() {
        return DEFAULT_WINDOW_TITLE
    }

    @Keyword
    String getShortcutPath() {
        String env = ((GlobalVariable.env ?: 'REC') as String).trim().toUpperCase()
        String user = getCurrentWindowsUser()

        return "C:\\Users\\${user}\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\NATIXIS\\eMatch ${env}.appref-ms"
    }

    @Keyword
    String getApplicationPath() {
        return ''
    }

    @Keyword
    String getLauncherBat() {
        String env = ((GlobalVariable.env ?: 'REC') as String).trim().toUpperCase()

        List<String> candidates = [
            "D:\\Projects\\eMatchStarters\\runAsMatch${env}\\eMatch.bat",
            "D:\\Projects\\eMatchStarters\\runAsMatch${env}\\run-ematch-command.bat",
            "D:\\Projects\\eMatchStarters\\eMatch.bat"
        ]

        for (String candidate : candidates) {
            if (candidate && new File(candidate).exists()) {
                return candidate
            }
        }

        return ''
    }

    @Keyword
    String getResolutionScriptPath() {
        List<String> candidates = [
            'D:\\Projects\\eMatchStarters\\set-resolution.ps1',
            'D:\\Projects\\eMatchStarters\\resolution.ps1'
        ]

        for (String candidate : candidates) {
            if (candidate && new File(candidate).exists()) {
                return candidate
            }
        }

        return ''
    }

    @Keyword
    String getWinAppDriverPath() {
        return DEFAULT_WIN_APP_DRIVER_PATH
    }

    @Keyword
    String getInstalledExePath() {
        File appsRoot = new File(System.getenv('LOCALAPPDATA') + '\\Apps\\2.0')

        if (!appsRoot.exists()) {
            return ''
        }

        File matchExe = findFileByName(appsRoot, 'IXIS.eMatch.HIM.exe', 6)

        return matchExe != null ? matchExe.absolutePath : ''
    }

    @Keyword
    def startMatch(String currentUser, String targetWindowTitle) {
        KeywordUtil.logInfo("Starting eMatch for environment ${(GlobalVariable.env ?: 'REC')}")
        ensureWinAppDriverRunning()
        closeStaleMatchProcesses()

        String installedExePath = getInstalledExePath()
        String shortcutPath = getShortcutPath()
        String launcherBat = getLauncherBat()

        boolean launched = false

        if (installedExePath?.trim() && new File(installedExePath).exists()) {
            KeywordUtil.logInfo("Launching installed exe first: ${installedExePath}")
            runCommand("cmd /c start \"\" \"${installedExePath}\"")
            launched = true
        } else if (shortcutPath?.trim() && new File(shortcutPath).exists()) {
            KeywordUtil.logInfo("Launching shortcut: ${shortcutPath}")
            runCommand("cmd /c start \"\" \"${shortcutPath}\"")
            launched = true
        } else if (launcherBat?.trim() && new File(launcherBat).exists()) {
            KeywordUtil.logInfo("Launching launcher bat: ${launcherBat}")
            runCommand("cmd /c start \"\" \"${launcherBat}\"")
            launched = true
        }

        if (!launched) {
            throw new IllegalStateException('Could not launch eMatch. Installed exe, shortcut and launcher bat were not found.')
        }

        waitForWindowTitle(targetWindowTitle, 90)
        return true
    }

    @Keyword
    def attachToLoginWindow(String targetWindowTitle) {
        ensureDesktopSession()

        WebElement matchWindow = waitAndFindWindow(targetWindowTitle, 90)

        if (matchWindow == null) {
            throw new IllegalStateException("Could not find eMatch window with title '${targetWindowTitle}'")
        }

        String nativeHandle = readNativeHandle(matchWindow)

        if (!nativeHandle?.trim()) {
            throw new IllegalStateException("NativeWindowHandle was not found for '${targetWindowTitle}'")
        }

        String hexHandle = decimalToHex(nativeHandle)
        KeywordUtil.logInfo("Attaching by native handle. dec=${nativeHandle} hex=${hexHandle}")

        recreateAppSession(hexHandle)

        waitUntilTrue(30, 500) {
            appSession != null
        }

        KeywordUtil.logInfo("Attached to login window successfully")
        return true
    }

    @Keyword
    def loginThroughNativeControls(String env) {
        ensureAppSession()

        String envLabel = resolveEnvironmentLabel(env)
        KeywordUtil.logInfo("Logging through native controls. env=${env} label=${envLabel}")

        openEnvironmentDropdown()
        selectEnvironment(env)

        if (isConnectButtonPresent()) {
            clickConnectButton()
        } else {
            throw new IllegalStateException('Connect button was not found on login window')
        }

        return true
    }

    @Keyword
    def openEnvironmentDropdown() {
        ensureAppSession()

        WebElement envCombo = waitForEnvironmentCombo(30)
        envCombo.click()
        sleepMs(800)

        return true
    }

    @Keyword
    int resolveEnvironmentIndex(String env) {
        return 0
    }

    @Keyword
    def selectEnvironment(String env) {
        ensureAppSession()

        String envLabel = resolveEnvironmentLabel(env)
        WebElement envCombo = waitForEnvironmentCombo(30)

        List<WebElement> directOption = appSession.findElements(By.name(envLabel))

        if (directOption != null && !directOption.isEmpty()) {
            directOption[0].click()
            KeywordUtil.logInfo("Environment option clicked by name: ${envLabel}")
            sleepMs(700)
            return true
        }

        envCombo.click()
        sleepMs(500)
        envCombo.sendKeys(Keys.chord(Keys.CONTROL, 'a'))
        envCombo.sendKeys(envLabel)
        envCombo.sendKeys(Keys.ENTER)
        KeywordUtil.logInfo("Environment option typed into combo: ${envLabel}")
        sleepMs(700)

        return true
    }

    @Keyword
    boolean isConnectButtonPresent() {
        ensureAppSession()
        return findConnectButton() != null
    }

    @Keyword
    def clickConnectButton() {
        ensureAppSession()

        WebElement connectButton = waitForConnectButton(20)
        connectButton.click()
        KeywordUtil.logInfo('Connect button clicked')

        sleepMs(1200)
        return true
    }

    @Keyword
    boolean waitForMainScreen() {
        try {
            waitUntilTrue(120, 1000) {
                try {
                    if (isAnyElementPresentByName(['Rafraîchir', 'Refresh', 'Modifier la disposition', 'Personnaliser mon accueil'])) {
                        return true
                    }

                    if (!isAnyElementPresentByName(['Se connecter', 'Connect'])) {
                        tryReattachMainWindow()
                    }

                    return isAnyElementPresentByName(['Rafraîchir', 'Refresh', 'Modifier la disposition', 'Personnaliser mon accueil'])
                } catch (Throwable ignored) {
                    tryReattachMainWindow()
                    return isAnyElementPresentByName(['Rafraîchir', 'Refresh', 'Modifier la disposition', 'Personnaliser mon accueil'])
                }
            }

            return true
        } catch (Throwable t) {
            KeywordUtil.logInfo("Main screen was not detected: ${t.message}")
            return false
        }
    }

    @Keyword
    def activateHomeTab() {
        ensureAppSession()

        List<String> names = ['Accueil', 'Home', 'Rafraîchir']

        for (String name : names) {
            List<WebElement> elements = appSession.findElements(By.name(name))
            if (elements != null && !elements.isEmpty()) {
                try {
                    elements[0].click()
                    KeywordUtil.logInfo("Activated home area using '${name}'")
                    sleepMs(500)
                    return true
                } catch (Throwable ignored) {
                }
            }
        }

        KeywordUtil.logInfo('Home tab activation skipped because no dedicated home control was found')
        return true
    }

    private void tryReattachMainWindow() {
        try {
            WebElement mainWindow = waitAndFindWindow(resolveWindowTitle(), 20)
            if (mainWindow != null) {
                String nativeHandle = readNativeHandle(mainWindow)
                if (nativeHandle?.trim()) {
                    recreateAppSession(decimalToHex(nativeHandle))
                }
            }
        } catch (Throwable ignored) {
        }
    }

    private WebElement waitForEnvironmentCombo(int timeoutSeconds) {
        waitUntilTrue(timeoutSeconds, 500) {
            List<WebElement> comboBoxes = appSession.findElements(By.className('ComboBox'))
            comboBoxes != null && !comboBoxes.isEmpty()
        }

        List<WebElement> comboBoxes = appSession.findElements(By.className('ComboBox'))

        if (comboBoxes == null || comboBoxes.isEmpty()) {
            throw new IllegalStateException('No ComboBox found on login window')
        }

        return comboBoxes[0]
    }

    private WebElement waitForConnectButton(int timeoutSeconds) {
        waitUntilTrue(timeoutSeconds, 500) {
            findConnectButton() != null
        }

        WebElement connectButton = findConnectButton()

        if (connectButton == null) {
            throw new IllegalStateException('Connect button was not found')
        }

        return connectButton
    }

    private WebElement findConnectButton() {
        List<String> candidates = ['Se connecter', 'Connect']

        for (String name : candidates) {
            List<WebElement> elements = appSession.findElements(By.name(name))
            if (elements != null && !elements.isEmpty()) {
                return elements[0]
            }
        }

        return null
    }

    private boolean isAnyElementPresentByName(List<String> names) {
        ensureAppSession()

        for (String name : names) {
            List<WebElement> elements = appSession.findElements(By.name(name))
            if (elements != null && !elements.isEmpty()) {
                return true
            }
        }

        return false
    }

    private void ensureWinAppDriverRunning() {
        if (isPortOpen('127.0.0.1', 4723)) {
            KeywordUtil.logInfo('WinAppDriver is already running on 127.0.0.1:4723')
            return
        }

        String winAppDriverPath = getWinAppDriverPath()

        if (!new File(winAppDriverPath).exists()) {
            throw new IllegalStateException("WinAppDriver.exe was not found at '${winAppDriverPath}'")
        }

        KeywordUtil.logInfo("Starting WinAppDriver minimized from ${winAppDriverPath}")
        runCommand("cmd /c start \"\" /min \"${winAppDriverPath}\"")

        waitUntilTrue(20, 500) {
            isPortOpen('127.0.0.1', 4723)
        }

        KeywordUtil.logInfo('WinAppDriver is ready on 127.0.0.1:4723')
    }

    private void closeStaleMatchProcesses() {
        try {
            runCommand('cmd /c taskkill /F /T /IM IXIS.eMatch.HIM.exe')
            sleepMs(1500)
        } catch (Throwable ignored) {
        }
    }

    private void ensureDesktopSession() {
        if (desktopSession != null) {
            try {
                desktopSession.getTitle()
                return
            } catch (Throwable ignored) {
                safeQuit(desktopSession)
                desktopSession = null
            }
        }

        DesiredCapabilities caps = new DesiredCapabilities()
        caps.setCapability('app', 'Root')

        desktopSession = new WindowsDriver(new URL(WIN_APP_DRIVER_URL), caps)
        desktopSession.manage().timeouts().implicitlyWait(Duration.ofSeconds(1))
    }

    private void recreateAppSession(String hexHandle) {
        safeQuit(appSession)
        appSession = null

        DesiredCapabilities caps = new DesiredCapabilities()
        caps.setCapability('appTopLevelWindow', hexHandle)
        caps.setCapability('ms:waitForAppLaunch', '60')

        appSession = new WindowsDriver(new URL(WIN_APP_DRIVER_URL), caps)
        appSession.manage().timeouts().implicitlyWait(Duration.ofSeconds(1))
    }

    private void ensureAppSession() {
        if (appSession == null) {
            throw new IllegalStateException('App session is null. attachToLoginWindow must run before interacting with controls.')
        }

        try {
            appSession.getTitle()
        } catch (Throwable t) {
            throw new IllegalStateException('App session is no longer valid', t)
        }
    }

    private void waitForWindowTitle(String expectedTitle, int timeoutSeconds) {
        WebElement window = waitAndFindWindow(expectedTitle, timeoutSeconds)

        if (window == null) {
            throw new IllegalStateException("Window '${expectedTitle}' was not detected within ${timeoutSeconds}s")
        }
    }

    private WebElement waitAndFindWindow(String expectedTitle, int timeoutSeconds) {
        ensureDesktopSession()

        final WebElement[] found = [null] as WebElement[]

        waitUntilTrue(timeoutSeconds, 1000) {
            found[0] = findWindowByTitle(expectedTitle)
            return found[0] != null
        }

        return found[0]
    }

    private WebElement findWindowByTitle(String expectedTitle) {
        List<WebElement> exact = desktopSession.findElements(By.name(expectedTitle))
        if (exact != null && !exact.isEmpty()) {
            return exact[0]
        }

        List<WebElement> generic = desktopSession.findElements(By.xpath("//*[contains(@Name,'eMatch')]"))
        if (generic != null && !generic.isEmpty()) {
            for (WebElement element : generic) {
                try {
                    String name = element.getAttribute('Name')
                    if (name != null && name.trim().startsWith('eMatch')) {
                        return element
                    }
                } catch (Throwable ignored) {
                }
            }
        }

        return null
    }

    private String readNativeHandle(WebElement element) {
        String value = ''

        try {
            value = element.getAttribute('NativeWindowHandle')
        } catch (Throwable ignored) {
        }

        if (!value?.trim()) {
            try {
                value = element.getAttribute('nativeWindowHandle')
            } catch (Throwable ignored) {
            }
        }

        return value ?: ''
    }

    private String decimalToHex(String decimalValue) {
        int handle = Integer.parseInt(decimalValue)
        return Integer.toHexString(handle).toUpperCase()
    }

    private String resolveEnvironmentLabel(String env) {
        String normalized = (env ?: '').trim().toUpperCase()

        switch (normalized) {
            case 'REC':
                return 'Recette (REC)'
            case 'REC2':
                return 'Qualification (REC2)'
            case 'PRE':
                return 'Bench (PRE)'
            case 'DEV':
                return 'Développement (DEV)'
            case 'PROD':
                return 'Production (PROD)'
            default:
                return env
        }
    }

    private boolean isPortOpen(String host, int port) {
        Socket socket = null

        try {
            socket = new Socket(host, port)
            return true
        } catch (Throwable ignored) {
            return false
        } finally {
            try {
                socket?.close()
            } catch (Throwable ignored) {
            }
        }
    }

    private void runCommand(String command) {
        new ProcessBuilder('cmd', '/c', command).start()
    }

    private File findFileByName(File root, String fileName, int maxDepth) {
        if (root == null || !root.exists() || maxDepth < 0) {
            return null
        }

        File[] files = root.listFiles()

        if (files == null) {
            return null
        }

        for (File file : files) {
            if (file.isFile() && file.name.equalsIgnoreCase(fileName)) {
                return file
            }
        }

        for (File file : files) {
            if (file.isDirectory()) {
                File found = findFileByName(file, fileName, maxDepth - 1)
                if (found != null) {
                    return found
                }
            }
        }

        return null
    }

    private void safeQuit(WindowsDriver driver) {
        if (driver == null) {
            return
        }

        try {
            driver.quit()
        } catch (Throwable ignored) {
        }
    }

    private void sleepMs(long millis) {
        try {
            Thread.sleep(millis)
        } catch (InterruptedException ignored) {
            Thread.currentThread().interrupt()
        }
    }

    private void waitUntilTrue(int timeoutSeconds, int sleepMillis, Closure<Boolean> condition) {
        long endTime = System.currentTimeMillis() + (timeoutSeconds * 1000L)
        Throwable lastError = null

        while (System.currentTimeMillis() < endTime) {
            try {
                if (condition.call()) {
                    return
                }
            } catch (Throwable t) {
                lastError = t
            }

            sleepMs(sleepMillis)
        }

        if (lastError != null) {
            throw new IllegalStateException("Condition not met within ${timeoutSeconds}s", lastError)
        }

        throw new IllegalStateException("Condition not met within ${timeoutSeconds}s")
    }
}
