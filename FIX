			'GUI behavior/favoriteTittleTopBar': [
				value: 'False',
				error: 'Favorite Title is enabled at landing.'
			],
			'GUI behavior/favoriteSaveTopBar': [
				value: 'False',
				error: 'Favorite Save is enabled at landing.'
			],
			'GUI behavior/refreshTopBar': [
				value: 'True',
				error: 'Refresh is disabled at landing.'
			],
			'GUI behavior/modifyDispositionTopBar': [
				value: 'True',
				error: 'Modify Disposition is disabled at landing.'
			],
			'GUI behavior/customizeMyDashTopBar': [
				value: 'True',
				error: 'Customize MyDash is disabled at landing.'
			]
		]

		controls.each {
			String objectPath,
			Map<String, String> configuration ->

			validateTopBarAttribute(
				objectPath,
				configuration.value,
				configuration.error,
				timeoutSeconds,
				errors
			)
		}
	}

	private void validateTopBarAttribute(
		String objectPath,
		String expectedValue,
		String errorMessage,
		Integer timeoutSeconds,
		List<String> errors
	) {
		boolean valid = Windows.verifyElementAttributeValue(
			findWindowsObject(objectPath),
			'IsEnabled',
			expectedValue,
			safeTimeout(timeoutSeconds, 4),
			FailureHandling.OPTIONAL
		)

		if (!valid) {
			errors.add(errorMessage)
		}
	}


