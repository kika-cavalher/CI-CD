    String createRuntimeJunitXml(String reportFolder, String suiteName) {
        if (blank(reportFolder)) {
            return ''
        }

        File reportDir = new File(reportFolder)
        if (!reportDir.exists() || !reportDir.isDirectory()) {
            return ''
        }

        List<Map> cases = parseCaseModels(reportFolder, suiteName)
        if (cases.isEmpty()) {
            cases << [
                path        : suiteName,
                displayName : suiteName,
                className   : suiteName,
                testName    : suiteName,
                status      : 'PASSED',
                durationMs  : 0L,
                errorSummary: '',
                fullError   : '',
                steps       : []
            ]
        }

        int tests = cases.size()
        int failures = cases.count { Map item -> safe(item.status) == 'FAILED' }
        int skipped = cases.count { Map item -> safe(item.status) == 'SKIPPED' }

        StringBuilder xml = new StringBuilder()
        xml.append('<?xml version="1.0" encoding="UTF-8"?>\n')
        xml.append('<testsuite name="')
        xml.append(xmlEscape(suiteName))
        xml.append('" tests="')
        xml.append(String.valueOf(tests))
        xml.append('" failures="')
        xml.append(String.valueOf(failures))
        xml.append('" skipped="')
        xml.append(String.valueOf(skipped))
        xml.append('">\n')

        cases.each { Map item ->
            String className = safe(item.className)
            String testName = safe(item.testName)
            if (blank(testName)) {
                testName = safe(item.displayName)
            }
            if (blank(className)) {
                className = suiteName
            }

            xml.append('  <testcase classname="')
            xml.append(xmlEscape(className))
            xml.append('" name="')
            xml.append(xmlEscape(testName))
            xml.append('" time="')
            xml.append(formatSeconds((item.durationMs ?: 0L) as long))
            xml.append('">')

            String status = safe(item.status)
            if (status == 'FAILED') {
                xml.append('<failure message="')
                xml.append(xmlEscape(safe(item.errorSummary)))
                xml.append('">')
                xml.append(xmlEscape(safe(item.fullError)))
                xml.append('</failure>')
            } else if (status == 'SKIPPED') {
                xml.append('<skipped/>')
            }

            xml.append('</testcase>\n')
        }

        xml.append('</testsuite>\n')

        File output = new File(reportDir, owner.RUNTIME_XML_FILE_NAME)
        output.setText(xml.toString(), 'UTF-8')
        return output.absolutePath
    }

