package jiraIntegration

import java.nio.file.Files
import java.text.SimpleDateFormat
import java.util.Base64

import com.kms.katalon.core.configuration.RunConfiguration

class JiraReportBuilder {

	File buildReport() {
		return buildReport(resolveReportFolder(), '', '')
	}

	File buildReport(String reportFolderPath) {
		return buildReport(new File(safe(reportFolderPath).isEmpty() ? '.' : reportFolderPath), '', '')
	}

	File buildReport(String reportFolderPath, String suiteName, String executionTitle) {
		return buildReport(new File(safe(reportFolderPath).isEmpty() ? '.' : reportFolderPath), suiteName, executionTitle)
	}

	File buildReport(File reportFolder) {
		return buildReport(reportFolder, '', '')
	}

	File buildReport(File reportFolder, String suiteName, String executionTitle) {
		File root = reportFolder ?: resolveReportFolder()
		ensureFolder(root)

		List<Map> snapshot = JiraReportSteps.snapshotCases()
		List<Map> cases = snapshot.collect { Map row ->
			normalizeCase(row, root)
		}

		cases = cases.sort { Map a, Map b ->
			int byStatus = statusOrder(a.status) <=> statusOrder(b.status)
			if (byStatus != 0) {
				return byStatus
			}
			return safe(a.displayName).compareToIgnoreCase(safe(b.displayName))
		}

		String effectiveSuiteName = !safe(suiteName).isEmpty() ? safe(suiteName) : resolveSuiteName(root)
		String effectiveTitle = !safe(executionTitle).isEmpty() ? safe(executionTitle) : effectiveSuiteName
		String generatedAt = new SimpleDateFormat('dd/MM/yyyy HH:mm:ss').format(new Date())
		String logoDataUri = resolveLogoDataUri()

		String html = buildHtml(cases, effectiveSuiteName, effectiveTitle, generatedAt, logoDataUri)

		File mainFile = new File(root, 'eMatchReport.html')
		mainFile.setText(html, 'UTF-8')

		File secondaryFile = new File(root, 'index.html')
		secondaryFile.setText(html, 'UTF-8')

		return mainFile
	}

	private Map normalizeCase(Map row, File reportFolder) {
		List<Map> steps = (row.steps ?: []).collect { Map step ->
			[
				status    : normalizeStepStatus(step.status),
				timestamp : safe(step.timestamp),
				details   : safe(step.details)
			]
		}

		List<Map> evidence = []
		(row.evidence ?: []).each { Map ev ->
			Map normalized = normalizeEvidence(ev, reportFolder)
			if (normalized != null) {
				evidence << normalized
			}
		}

		String fullError = safe(row.fullError)
		String shortError = buildCompactError(fullError)

		return [
			caseId       : safe(row.caseId),
			displayName  : safe(row.displayName),
			status       : normalizeCaseStatus(row.status),
			startText    : safe(row.startText),
			endText      : safe(row.endText),
			durationText : safe(row.durationText),
			steps        : steps,
			shortError   : shortError,
			fullError    : fullError,
			evidence     : evidence
		]
	}

	private Map normalizeEvidence(Map ev, File reportFolder) {
		File source = resolveEvidenceFile(ev, reportFolder)

		if (source == null || !source.exists() || !source.isFile() || source.length() <= 0L) {
			return null
		}

		String dataUri = fileToDataUri(source)
		if (dataUri.isEmpty()) {
			return null
		}

		return [
			name    : safe(ev.name).isEmpty() ? source.name : safe(ev.name),
			openPath: dataUri,
			preview : dataUri
		]
	}

	private File resolveEvidenceFile(Map ev, File reportFolder) {
		String absolutePath = safe(ev.absolutePath)
		String relativePath = safe(ev.relativePath)

		if (!absolutePath.isEmpty()) {
			File absoluteFile = new File(absolutePath)
			if (absoluteFile.exists()) {
				return absoluteFile
			}
		}

		if (!relativePath.isEmpty()) {
			File relativeFile = new File(reportFolder, relativePath)
			if (relativeFile.exists()) {
				return relativeFile
			}
		}

		return null
	}

	private String buildCompactError(String fullError) {
		List<String> lines = safe(fullError)
			.replace('\r\n', '\n')
			.replace('\r', '\n')
			.readLines()
			.collect { String line -> safe(line) }
			.findAll { String line -> !line.isEmpty() }

		if (lines.isEmpty()) {
			return ''
		}

		List<String> compact = []

		for (String line : lines) {
			if (line.startsWith('Original error:')) {
				break
			}

			if (line.startsWith('at ')) {
				break
			}

			compact << line

			if (line.startsWith('Expected window title:')) {
				break
			}
		}

		if (compact.isEmpty()) {
			compact = lines.take(Math.min(3, lines.size()))
		}

		return compact.join('\n')
	}

	private int statusOrder(String status) {
		String upper = safe(status).toUpperCase(Locale.ENGLISH)

		if ('FAILED'.equals(upper)) {
			return 0
		}

		if ('BLOCKED'.equals(upper)) {
			return 1
		}

		return 2
	}

	private String normalizeStepStatus(Object rawStatus) {
		String upper = safe(rawStatus).toUpperCase(Locale.ENGLISH)

		if (upper in ['FAILED', 'FAIL']) {
			return 'FAILED'
		}

		if (upper in ['BLOCKED', 'SKIPPED']) {
			return 'BLOCKED'
		}

		return 'PASSED'
	}

	private String normalizeCaseStatus(Object rawStatus) {
		String upper = safe(rawStatus).toUpperCase(Locale.ENGLISH)

		if (upper in ['FAILED', 'FAIL', 'ERROR']) {
			return 'FAILED'
		}

		if (upper in ['BLOCKED', 'SKIPPED']) {
			return 'BLOCKED'
		}

		return 'PASSED'
	}

	private File resolveReportFolder() {
		String reportFolder = safe(RunConfiguration.getReportFolder())

		if (!reportFolder.isEmpty()) {
			File direct = new File(reportFolder)
			ensureFolder(direct)
			return direct
		}

		File reportsRoot = new File(RunConfiguration.getProjectDir(), 'Reports')
		ensureFolder(reportsRoot)
		return reportsRoot
	}

	private String resolveSuiteName(File reportFolder) {
		String suiteName = JiraReportSteps.suiteNameStatic()
		if (!suiteName.isEmpty()) {
			return suiteName
		}

		File parent = reportFolder != null ? reportFolder.parentFile : null
		return parent != null ? parent.name : 'Execution Report'
	}

	private String resolveLogoDataUri() {
		File projectDir = new File(RunConfiguration.getProjectDir())

		List<File> candidates = [
			new File(projectDir, 'Images/General/logo.png'),
			new File(projectDir, 'Images/logo.png'),
			new File(projectDir, 'Images/eMatch-logo.png'),
			new File(projectDir, 'Include/resources/logo.png')
		]

		File logo = candidates.find { File file ->
			file.exists() && file.isFile()
		}

		return logo != null ? fileToDataUri(logo) : ''
	}

	private String fileToDataUri(File file) {
		try {
			byte[] bytes = Files.readAllBytes(file.toPath())
			String base64 = Base64.encoder.encodeToString(bytes)
			String ext = extension(file.name).toLowerCase(Locale.ENGLISH)

			String mimeType = 'image/png'
			if (ext in ['jpg', 'jpeg']) {
				mimeType = 'image/jpeg'
			} else if ('gif'.equals(ext)) {
				mimeType = 'image/gif'
			} else if ('bmp'.equals(ext)) {
				mimeType = 'image/bmp'
			}

			return 'data:' + mimeType + ';base64,' + base64
		} catch (Throwable ignored) {
			return ''
		}
	}

	private String extension(String fileName) {
		String value = safe(fileName)
		int idx = value.lastIndexOf('.')
		return idx >= 0 ? value.substring(idx + 1) : ''
	}

	private void ensureFolder(File folder) {
		if (folder != null && !folder.exists()) {
			folder.mkdirs()
		}
	}

	private String esc(String value) {
		return safe(value)
			.replace('\\', '\\\\')
			.replace("'", "\\'")
			.replace('\r', '')
			.replace('\n', '\\n')
	}

	private String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}

