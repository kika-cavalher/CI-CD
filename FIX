package commands

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.driver.WindowsDriverFactory
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows
import com.kms.katalon.core.windows.keyword.helper.WindowsActionHelper

class ImageLoader {

	private static final Map<String, Map<String, String>> IMAGE_GROUPS = [

		'General': [
			'envImage'      : 'Images/General/envImage.png',
			'envImagr'      : 'Images/General/envImage.png',
			'homeGrey'      : 'Images/General/HomeGrey.png',
			'homeWhite'     : 'Images/General/HomeWhite.png',
			'home'          : 'Images/General/Home.PNG',
			'exports'       : 'Images/General/Exports.PNG',
			'exports2'      : 'Images/General/Exports2.PNG',
			'outils'        : 'Images/General/Outils.PNG',
			'outilsMenu'    : 'Images/General/OutilsMenu.png',
			'exportButton'  : 'Images/General/ExportButton.png',
			'yes'           : 'Images/General/Yes.PNG',
			'yesEn'         : 'Images/General/yesEn.png',
			'yesUnderline'  : 'Images/General/yesUnderline.png',
			'no'            : 'Images/General/No.PNG',
			'noEn'          : 'Images/General/NoEN.PNG',
			'saveDialog'    : 'Images/General/saveDialog.png',
			'fileName'      : 'Images/General/FileName.png'
		],

		'authentication': [
			'homeGrey'      : 'Images/General/HomeGrey.png',
			'homeWhite'     : 'Images/General/HomeWhite.png',
			'home'          : 'Images/General/Home.PNG'
		],

		'ModuleDesResponsabilite': [
			'menuImage'         : 'Images/BDR/CubeBalanceDesResponsabilites.png',
			'openedTab'         : 'Images/BDR/CubeBalanceDesResponsabilitesTab.png',
			'firstDimension'    : 'Images/BDR/measures.PNG',
			'lastDimension'     : 'Images/BDR/provic.png',
			'lastDimensionOpen' : 'Images/BDR/provicOpen.png',
			'firstPageRef'      : 'Images/BDR/FirstPageOfDimensions.PNG',
			'lastPageRef'       : 'Images/BDR/LastPageOfDimensions.PNG',
			'zoneLignes'        : 'Images/BDR/ZoneLignes.PNG',
			'updateLastPageRef' : 'Images/BDR/updateLastPageOfDimensions.png'
		],
	]

	@Keyword
	Map<String, String> getImages(String groupName) {
		Map<String, String> group = IMAGE_GROUPS[groupName]

		if (group == null) {
			KeywordUtil.markFailedAndStop(
					'Image group not found: ' + groupName + '\n' +
					'Available groups: ' + IMAGE_GROUPS.keySet()
					)
		}

		Map<String, String> resolved = [:]

		group.each { String key, String relativePath ->
			resolved[key] = resolveExistingProjectPath(relativePath)
		}

		return resolved
	}

	@Keyword
	String getImage(String groupName, String imageKey) {
		Map<String, String> images = getImages(groupName)

		if (!images.containsKey(imageKey)) {
			KeywordUtil.markFailedAndStop(
					'Image key not found.\n' +
					'Group: ' + groupName + '\n' +
					'Key: ' + imageKey + '\n' +
					'Available keys: ' + images.keySet()
					)
		}

		return images[imageKey]
	}

	@Keyword
	void validateGroupImagesExist(String groupName) {
		Map<String, String> images = getImages(groupName)

		images.each { String key, String imagePath ->
			File imageFile = new File(imagePath)

			if (!imageFile.exists()) {
				KeywordUtil.markFailedAndStop(
						'Image file not found.\n' +
						'Group: ' + groupName + '\n' +
						'Key: ' + key + '\n' +
						'Resolved path: ' + imagePath
						)
			}
		}

		KeywordUtil.logInfo('All image files exist for group: ' + groupName)
	}

	@Keyword
	boolean isVisible(String groupName, String imageKey) {
		String imagePath = getImage(groupName, imageKey)

		try {
			def found = WindowsImageKeywords.findImage(imagePath)
			return found != null && found != false
		} catch (Exception ignored) {
			return false
		}
	}

	@Keyword
	boolean waitForImage(String groupName, String imageKey, Integer timeoutSeconds) {
		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 10 : timeoutSeconds
		int elapsedSeconds = 0

		while (elapsedSeconds < safeTimeout) {
			if (isVisible(groupName, imageKey)) {
				return true
			}

			Windows.delay(1)
			elapsedSeconds++
		}

		return isVisible(groupName, imageKey)
	}

	@Keyword
	void waitForImageOrStop(String groupName, String imageKey, Integer timeoutSeconds) {
		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 10 : timeoutSeconds
		boolean found = waitForImage(groupName, imageKey, safeTimeout)

		if (!found) {
			takeEvidence('ImageNotFound_' + imageKey + '.png')

			KeywordUtil.markFailedAndStop(
					'Image was not found before timeout.\n' +
					'Group: ' + groupName + '\n' +
					'Key: ' + imageKey + '\n' +
					'Path: ' + getImage(groupName, imageKey) + '\n' +
					'Timeout: ' + safeTimeout
					)
		}
	}

	@Keyword
	boolean isGroupVisible(String groupName) {
		return isGroupVisible(groupName, 0)
	}

	@Keyword
	boolean isGroupVisible(String groupName, Integer timeoutSeconds) {
		Map<String, String> images = getImages(groupName)

		int safeTimeout = timeoutSeconds == null || timeoutSeconds < 0 ? 0 : timeoutSeconds
		int elapsedSeconds = 0

		while (true) {
			for (String imageKey : images.keySet()) {
				try {
					if (isVisible(groupName, imageKey)) {
						KeywordUtil.logInfo(
								'At least one image from group is visible.\n' +
								'Group: ' + groupName + '\n' +
								'Visible key: ' + imageKey
								)
						return true
					}
				} catch (Exception ignored) {
				}
			}

			if (elapsedSeconds >= safeTimeout) {
				return false
			}

			Windows.delay(1)
			elapsedSeconds++
		}
	}

	@Keyword
	boolean clickFirstVisibleInGroup(String groupName) {
		return clickFirstVisibleInGroup(groupName, 10)
	}

	@Keyword
	boolean clickFirstVisibleInGroup(String groupName, Integer timeoutSeconds) {
		Map<String, String> images = getImages(groupName)

		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 10 : timeoutSeconds
		int elapsedSeconds = 0

		while (elapsedSeconds <= safeTimeout) {
			for (String imageKey : images.keySet()) {
				String imagePath = images[imageKey]

				try {
					def found = WindowsImageKeywords.findImage(imagePath)

					if (found != null && found != false) {
						try {
							WindowsImageKeywords.clickImage(imagePath)

							KeywordUtil.logInfo(
									'First visible image clicked successfully.\n' +
									'Group: ' + groupName + '\n' +
									'Key: ' + imageKey + '\n' +
									'Path: ' + imagePath
									)

							return true
						} catch (Exception clickError) {
							try {
								WindowsImageKeywords.doubleClickImage(imagePath)

								KeywordUtil.logInfo(
										'First visible image double clicked successfully.\n' +
										'Group: ' + groupName + '\n' +
										'Key: ' + imageKey + '\n' +
										'Path: ' + imagePath
										)

								return true
							} catch (Exception doubleClickError) {
								KeywordUtil.logInfo(
										'Image was found but click failed.\n' +
										'Group: ' + groupName + '\n' +
										'Key: ' + imageKey + '\n' +
										'Reason: ' + doubleClickError.getMessage()
										)
							}
						}
					}
				} catch (Exception ignored) {
				}
			}

			if (elapsedSeconds == safeTimeout) {
				break
			}

			Windows.delay(1)
			elapsedSeconds++
		}

		takeEvidence('FirstVisibleImageNotFound_' + groupName + '.png')
		return false
	}

	@Keyword
	void clickImageOrStop(String groupName, String imageKey) {
		String imagePath = getImage(groupName, imageKey)

		waitForImageOrStop(groupName, imageKey, 10)

		try {
			WindowsImageKeywords.clickImage(imagePath)
			KeywordUtil.logInfo('Image clicked successfully: ' + imageKey)
		} catch (Exception e) {
			takeEvidence('ClickImageFailed_' + imageKey + '.png')

			KeywordUtil.markFailedAndStop(
					'Could not click image.\n' +
					'Group: ' + groupName + '\n' +
					'Key: ' + imageKey + '\n' +
					'Path: ' + imagePath + '\n' +
					'Reason: ' + e.getMessage()
					)
		}
	}

	@Keyword
	void clickImageInsideImageOrStop(String groupName, String parentImageKey, String childImageKey) {
		String parentPath = getImage(groupName, parentImageKey)
		String childPath = getImage(groupName, childImageKey)

		waitForImageOrStop(groupName, parentImageKey, 10)
		waitForImageOrStop(groupName, childImageKey, 10)

		try {
			WindowsImageKeywords.clickImageInImage(parentPath, childPath)
			KeywordUtil.logInfo(
					'clickImageInImage executed successfully.\n' +
					'Parent: ' + parentImageKey + '\n' +
					'Child: ' + childImageKey
					)
		} catch (Exception e) {
			takeEvidence('ClickInsideImageFailed_' + childImageKey + '.png')

			KeywordUtil.markFailedAndStop(
					'Could not click child image inside parent image.\n' +
					'Group: ' + groupName + '\n' +
					'Parent: ' + parentImageKey + '\n' +
					'Child: ' + childImageKey + '\n' +
					'Reason: ' + e.getMessage()
					)
		}
	}

	@Keyword
	void takeEvidence(String fileName) {
		try {
			String evidenceDir = RunConfiguration.getReportFolder() + '\\Evidences\\'
			new File(evidenceDir).mkdirs()

			WindowsActionHelper
					.create(WindowsDriverFactory.getWindowsSession())
					.takeScreenshot(evidenceDir + fileName)

			KeywordUtil.logInfo('Evidence captured: ' + evidenceDir + fileName)
		} catch (Exception e) {
			KeywordUtil.logInfo('Could not capture evidence: ' + e.getMessage())
		}
	}

	private String resolveExistingProjectPath(String relativePath) {
		File directFile = new File(RunConfiguration.getProjectDir(), relativePath)

		if (directFile.exists()) {
			return directFile.getAbsolutePath()
		}

		File parentFolder = directFile.getParentFile()

		if (parentFolder != null && parentFolder.exists()) {
			File[] candidates = parentFolder.listFiles()

			if (candidates != null) {
				String targetName = directFile.getName()

				File exactIgnoreCase = candidates.find { File candidate ->
					candidate.getName().equalsIgnoreCase(targetName)
				}

				if (exactIgnoreCase != null) {
					return exactIgnoreCase.getAbsolutePath()
				}
			}
		}

		return directFile.getAbsolutePath()
	}
