				)
	}


	private File resolveShortExportRoot() {

		File baseRoot =
				resolveWritableBaseExportRoot()

		File executionRoot =
				resolveExecutionRootFolder()

		String executionName =
				executionRoot == null
				? ''
				: executionRoot.getName()

		if (executionName == null ||
				executionName.trim().isEmpty()) {

			executionName = 'Unknown_Execution'
		}

		File executionDirectory = new File(
				baseRoot,
				shortenFilePart(
				sanitizeFileName(
				executionName
				),
				48
				)
				)

		if (!executionDirectory.exists()) {

			boolean created =
					executionDirectory.mkdirs()

			if (!created &&
					!executionDirectory.exists()) {

				KeywordUtil.markFailedAndStop(
						'Could not create suite execution export directory. Directory: ' +
						executionDirectory.getAbsolutePath()
						)

				return null
			}
		}

		return executionDirectory
	}


	private File resolveWritableBaseExportRoot() {

		File preferredRoot =
				new File(
				SHORT_EXPORT_ROOT
				)

		try {
			if (!preferredRoot.exists()) {
				preferredRoot.mkdirs()
			}

			if (preferredRoot.exists() &&
					preferredRoot.isDirectory() &&
					preferredRoot.canWrite()) {

				logInfo(
						'Using preferred export root: ' +
						preferredRoot.getAbsolutePath()
						)

				return preferredRoot
			}
		} catch (Exception exception) {

			logInfo(
					'Preferred export root could not be used. Message: ' +
					safeExceptionMessage(
					exception
					)
					)
		}

		File temporaryRoot = new File(
				System.getProperty(
				'java.io.tmpdir'
				),
				'KatalonExports'
				)

		if (!temporaryRoot.exists()) {
			temporaryRoot.mkdirs()
		}

		logInfo(
				'Using temporary export root: ' +
				temporaryRoot.getAbsolutePath()
				)

		return temporaryRoot
	}


	private File resolveExecutionRootFolder() {

		String reportFolderPath =
				RunConfiguration.getReportFolder()

		if (reportFolderPath == null ||
				reportFolderPath.trim().isEmpty()) {

			return new File(
					RunConfiguration.getProjectDir(),
					'Reports\\Unknown_Execution'
					)
		}

		File current =
				new File(
				reportFolderPath
				)

		while (current != null) {

			File parent =
					current.getParentFile()

			if (parent != null &&
					parent.getName()
					.equalsIgnoreCase(
					'Reports'
					)) {

				return current
			}

			current = parent
		}

		return new File(
				reportFolderPath
				)
	}


	private File ensurePathIsShortEnough(
			File proposedFile,
			String environment,
			String exportLabelSuffix) {

		if (proposedFile
				.getAbsolutePath()
				.length() <=
				MAX_WINDOWS_PATH_LENGTH) {

			return proposedFile
		}

		String timestamp =
				new SimpleDateFormat(
				'yyyyMMdd_HHmmss'
				).format(
				new Date()
				)

		String shortEnvironment = shortenFilePart(
				sanitizeFileName(
				environment
				),
				6
				)

		String shortLabel = shortenFilePart(
				sanitizeFileName(
				exportLabelSuffix
				),
				12
				)

		String shortFileName =
				shortEnvironment +
				'_' +
				timestamp

		if (shortLabel != null &&
				!shortLabel.trim().isEmpty()) {

			shortFileName +=
					'_' +
					shortLabel
		}

		File shortFile = new File(
				proposedFile.getParentFile(),
				shortFileName +
				'.xlsx'
				)

		if (shortFile
				.getAbsolutePath()
				.length() >
				MAX_WINDOWS_PATH_LENGTH) {

			KeywordUtil.markFailedAndStop(
					'Could not create an export path shorter than the configured limit. Path: ' +
					shortFile.getAbsolutePath()
					)

			return null
		}

		return shortFile
	}


	private String buildAutomaticExportFileName(
			String environment,
			String featureName,
			String exportLabelSuffix) {

		String timestamp =
				new SimpleDateFormat(
				'yyyyMMdd_HHmmss'
				).format(
				new Date()
				)

		String safeEnvironment = shortenFilePart(
				sanitizeFileName(
				environment == null ||
				environment.trim().isEmpty()
				? 'REC'
				: environment
				),
				6
				)

		String safeFeatureName = shortenFilePart(
				sanitizeFileName(
				featureName == null ||
				featureName.trim().isEmpty()
				? 'Export'
				: featureName
				),
				MAX_FEATURE_LENGTH
				)

		String safeExportLabelSuffix = shortenFilePart(
				sanitizeFileName(
				exportLabelSuffix == null
				? ''
				: exportLabelSuffix
				),
				MAX_LABEL_LENGTH
				)

		String baseFileName =
				safeEnvironment +
				'_' +
				timestamp +
				'_' +
				safeFeatureName

		if (safeExportLabelSuffix != null &&
				!safeExportLabelSuffix.trim().isEmpty() &&
				safeExportLabelSuffix != 'Export') {

			baseFileName +=
					'_' +
					safeExportLabelSuffix
		}

		return baseFileName +
				'.xlsx'
	}


	private String resolveExportLabelSuffixForFileName(
			String exportLabel) {

		if (exportLabel == null ||
				exportLabel.trim().isEmpty()) {

			return ''
		}

		String value =
				sanitizeFileName(
				exportLabel
				)

		value = value.replaceFirst(
				'(?i)^REC_',
				''
				)

		value = value.replaceFirst(
				'(?i)^PRD_',
				''
				)

		value = value.replaceFirst(
				'(?i)^REC-',
				''
				)

		value = value.replaceFirst(
				'(?i)^PRD-',
				''
				)

		value = value.replaceFirst(
				'(?i)^REC ',
				''
				)

		value = value.replaceFirst(
				'(?i)^PRD ',
				''
				)

		return value == null ||
				value.trim().isEmpty()
				? ''
				: value
	}


	private String resolveEnvironmentName(
			String targetEnvironment,
			String exportLabel) {

		String environment =
				normalizeEnvironmentNameStrict(
				targetEnvironment
				)

		if (environment != null) {
			return environment
		}

		List<String> globalVariableNames = [
			'targetEnvironment',
			'currentEnvironment',
			'environment',
			'env',
			'ENV',
			'currentEnv',
			'environmentName'
		]

		for (String variableName : globalVariableNames) {

			environment = normalizeEnvironmentNameStrict(
					getGlobalVariableValue(
					variableName
					)
					)

			if (environment != null) {
				return environment
			}
		}

		environment = normalizeEnvironmentNameStrict(
				RunConfiguration.getExecutionProfile()
				)

		if (environment != null) {
			return environment
		}

		environment = normalizeEnvironmentNameStrict(
				exportLabel
				)

		return environment == null
				? 'REC'
				: environment
	}


	private String normalizeEnvironmentNameStrict(
			String rawEnvironment) {

		if (rawEnvironment == null ||
				rawEnvironment.trim().isEmpty()) {

			return null
		}

		String value =
				rawEnvironment
				.trim()
				.toUpperCase()

		if (value == 'PRD' ||
				value == 'PROD' ||
				value == 'PRODUCTION' ||
				value.startsWith('PRD_') ||
				value.startsWith('PRD-') ||
				value.startsWith('PRD ')) {

			return 'PRD'
		}

		if (value == 'REC' ||
				value == 'RECETTE' ||
				value.startsWith('REC_') ||
				value.startsWith('REC-') ||
				value.startsWith('REC ')) {

			return 'REC'
		}

		return null
	}


	private String getGlobalVariableValue(
			String variableName) {

		try {
			def value =
					GlobalVariable."${variableName}"

			if (value != null &&
					!value
					.toString()
					.trim()
					.isEmpty()) {

				return value.toString()
			}
		} catch (Exception ignored) {
		}

		return null
	}


	private String resolveCurrentCollectionName() {

		List<String> validParts =
				getValidReportFolderParts()

		return validParts.isEmpty()
				? 'Collection'
				: validParts[0]
	}


	private String resolveCurrentFeatureName() {

		List<String> validParts =
				getValidReportFolderParts()

		return validParts.isEmpty()
				? 'Export'
				: validParts.last()
	}


	private List<String> getValidReportFolderParts() {

		List<String> validParts = []

		String reportFolderPath =
				RunConfiguration.getReportFolder()

		if (reportFolderPath == null ||
				reportFolderPath.trim().isEmpty()) {

			return validParts
		}

		File executionRootFolder =
				resolveExecutionRootFolder()

		String fullPath =
				new File(
				reportFolderPath
				)
				.getAbsolutePath()

		String rootPath =
				executionRootFolder
				.getAbsolutePath()

		if (!fullPath
				.toLowerCase()
				.startsWith(
				rootPath.toLowerCase()
				)) {

			return validParts
		}

		String relativePath =
				fullPath
				.substring(
				rootPath.length()
				)
				.replaceAll(
				'^\\\\+',
				''
				)

		if (relativePath.trim().isEmpty()) {
			return validParts
		}

		List<String> parts =
				relativePath
				.replace(
				'/',
				'\\'
				)
				.split(
				'\\\\'
				) as List<String>

		for (String part : parts) {

			if (isValidFeatureNamePart(
					part
					)) {

				validParts.add(
						part.trim()
						)
			}
		}

		return validParts
	}


	private boolean isValidFeatureNamePart(
			String part) {

		if (part == null ||
				part.trim().isEmpty()) {

			return false
		}

		String value =
				part.trim()

		String lower =
				value.toLowerCase()

		if (value ==~ /\d{8}_\d{6}/ ||
				value ==~ /\d{14}/ ||
				value ==~ /^\d+\.\s*.*/) {

			return false
		}

		List<String> ignoredExactValues = [
			'reports',
			'evidences',
			'exports',
			'test cases',
			'test suites',
			'connection',
			'authentication',
			'login rec',
			'login prd',
			'katalon',
			'temp'
		]

		if (ignoredExactValues.contains(
				lower
				)) {

			return false
		}

		List<String> ignoredContainsValues = [
			'filter export and validate',
			'validation compare rec x prd',
			'test tool validation',
			'close application',
			'open module',
			'login'
		]

		for (String ignored : ignoredContainsValues) {

			if (lower.contains(
					ignored
					)) {

				return false
			}
		}

		return true
	}


