class authentication {

    private static final String WINAPPDRIVER_URL = 'http://127.0.0.1:4723'
    private static final int DEFAULT_ATTACH_TIMEOUT_SECONDS = 120
    private static final int DEFAULT_SHORT_TIMEOUT_SECONDS = 30
    private static final int STARTUP_SIGNAL_TIMEOUT_SECONDS = 25

    private static WindowsDriver<WebElement> desktopSession
    private static WindowsDriver<WebElement> appSession

    @Keyword
    String getCurrentWindowsUser() {
        return System.getProperty('user.name')
    }

    @Keyword
    String resolveWindowTitle() {
        String version = ''
        try {
            version = String.valueOf(GlobalVariable.version ?: '').trim()
        } catch (Throwable ignored) {
        }

        if (version) {
            return "eMatch ${version}"
        }

        return 'eMatch 26.1.1.3'
    }

    @Keyword
    String getShortcutPath() {
        String env = normalizeEnv(readEnv())
        String userHome = System.getProperty('user.home')
        String appDataRoaming = userHome + '\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\NATIXIS'

        List<String> candidates = [
            "${appDataRoaming}\\eMatch ${env}.appref-ms",
            "${appDataRoaming}\\eMatch ${env}.appref-ms".replace('REC2', 'Qualification'),
            "${appDataRoaming}\\eMatch ${env}.appref-ms".replace('PREPROD', 'Bench'),
            "${appDataRoaming}\\eMatch ${env}.appref-ms".replace('DEV2', 'Simulation'),
            "${appDataRoaming}\\eMatch ${env}.appref-ms".replace('DEV', 'Développement')
        ]

        return firstExistingFile(candidates)
    }

    @Keyword
    String getApplicationPath() {
        String env = normalizeEnv(readEnv())

        List<String> candidates = [
            "\\\\icb.net\\shareparis\\Soft\\ematch\\HIM\\Livraisons\\${env}\\IXIS.eMatch.HIM.application",
            "\\\\icb.net\\shareparis\\Soft\\ematch\\HIM\\Livraisons\\REC\\IXIS.eMatch.HIM.application",
            "\\\\icb.net\\shareparis\\Soft\\ematch\\HIM\\Livraisons\\PREPROD\\IXIS.eMatch.HIM.application"
        ]

        return firstExistingFile(candidates)
    }

    @Keyword
    String getLauncherBat() {
        String env = normalizeEnv(readEnv())
        String baseDir = 'D:\\Projects\\eMatchStarters'

        List<String> candidates = [
            "${baseDir}\\runAsEmatch${env}\\eMatch.bat",
            "${baseDir}\\runAsMatch${env}\\eMatch.bat",
            "${baseDir}\\runAsEmatchREC\\eMatch.bat",
            "${baseDir}\\runAsMatchREC\\eMatch.bat",
