	//Gets last file in the directory (file name as input)
	def downloadedFile(String dir, String file) {
		File path = new File(dir);
		ArrayList<File> dirContents = new ArrayList<File>(path.listFiles().toList());
		ArrayList<File> selectedContents = new ArrayList<File>();

		for (int i = 0; i < dirContents.size(); i++) {
			if (dirContents[i].getName().contains(file)) selectedContents.add(dirContents[i]);
		}

		dirContents = path.listFiles().sort({
			it.lastModified();
		})

		if (selectedContents.size() > 0) {
			return selectedContents.last();
		}
	}

