import java.nio.file.Paths

def run(script, cfg) {

    stageSafe(script, 'Validate Environment') {
        script.echo('------------------------------------------------------------')
        script.echo('VALIDATING TOOLS AND SUPPORT FILES')
        script.echo('------------------------------------------------------------')

        assertNotBlank(script, cfg.winDriverTask, 'winDriverTask')
        assertNotBlank(script, cfg.desktopRunnerTask, 'desktopRunnerTask')
        assertNotBlank(script, cfg.projectFileName, 'projectFileName')
        assertNotBlank(script, cfg.executionStageName, 'executionStageName')

        if (!cfg.assets || cfg.assets.size() == 0) {
            script.error('No assets configured to run.')
        }

        script.echo('[OK] Support files and scheduled tasks found')
        script.echo('------------------------------------------------------------')
    }

    stageSafe(script, 'Prepare Run Context') {
        // This file is NOT a Scheduled Task. It is just a context file read by your runner BAT.
        // Keep it in the fixed location so the Task Scheduler always finds it.
        def contextFile = 'D:\\Projects\\eMatchStarters\\run-context.properties'

        def workspacePath = script.pwd()
        def projectFileAbs = Paths.get(workspacePath, cfg.projectFileName).toString()

        def content = []
        content << "WORKSPACE=${workspacePath}"
        content << "PROJECT_FILE=${projectFileAbs}"
        content << "PROJECT_FILE_NAME=${cfg.projectFileName}"
        content << "DEFAULT_TIMEOUT_MINUTES=${cfg.defaultTimeoutMinutes ?: 30}"

        // We only run 1 asset per job in this pipeline (Archive Mode). If you later add more, we can loop.
        def asset = cfg.assets[0]
        content << "ASSET_NAME=${asset.name}"
        content << "ASSET_TYPE=${asset.type}"
        content << "COLLECTION_PATH=${asset.path}"
        content << "ASSET_TIMEOUT_MINUTES=${asset.timeoutMinutes ?: (cfg.defaultTimeoutMinutes ?: 30)}"

        script.writeFile file: contextFile, text: content.join('\r\n') + '\r\n'
        script.echo("✅ run-context.properties written: ${contextFile}")
    }

    stageSafe(script, cfg.executionStageName) {

        cfg.assets.each { asset ->

            stageSafe(script, "Run - ${asset.name}") {

                banner(script, "START ASSET: ${asset.name}")
                script.echo("TASK: ${cfg.desktopRunnerTask}")

                // Start WinAppDriver task
                runTask(script, cfg.winDriverTask)

                // Start Desktop runner task
                runTask(script, cfg.desktopRunnerTask)

                // Wait the Desktop runner to finish (Status becomes Ready)
                waitTaskFinish(script, cfg.desktopRunnerTask, (asset.timeoutMinutes ?: (cfg.defaultTimeoutMinutes ?: 30)))

                // Stop WinAppDriver task
                endTask(script, cfg.winDriverTask)
            }
        }
    }

    stageSafe(script, 'Collect Reports') {

        // Try common patterns. Your project sometimes creates nested folders like "Archive Mode@2".
        def junitFiles = script.findFiles(glob: '**/Reports/**/JUnit_Report.xml')
        def anyReports = script.findFiles(glob: '**/Reports/**/*')

        if (junitFiles && junitFiles.size() > 0) {
            script.echo("✅ JUnit reports found: ${junitFiles.size()}")
        } else {
            script.echo("⚠️ No JUnit_Report.xml found under **/Reports/**")
        }

        // Publish results (won't fail the build if empty)
        script.catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
            script.junit allowEmptyResults: true, testResults: '**/Reports/**/JUnit_Report.xml'
        }

        // Archive whatever exists (won't fail the build if empty)
        script.catchError(buildResult: 'SUCCESS', stageResult: 'SUCCESS') {
            script.archiveArtifacts allowEmptyArchive: true, artifacts: '**/Reports/**/*'
        }

        if (!anyReports || anyReports.size() == 0) {
            script.echo('⚠️ Reports folder not found in workspace. That means the Scheduled Task is generating reports somewhere else.')
            script.echo('📌 Next action: open the Scheduled Task action and confirm the "Start in" (working directory) points to the Jenkins workspace before running katalonc.')
        }
    }

    stageSafe(script, 'Trigger Next Job') {
        def nextJob = (cfg.nextJobName ?: '').trim()
        if (nextJob.length() > 0) {
            script.echo("Triggering next Jenkins job: ${nextJob}")
            script.build job: nextJob, wait: false
        } else {
            script.echo('Next job is empty. Skipping trigger.')
        }
    }
}

private void banner(script, String title) {
    script.echo('============================================================')
    script.echo(title)
    script.echo('============================================================')
}

private void stageSafe(script, String name, Closure body) {
    script.stage(name) {
        body.call()
    }
}

private void assertNotBlank(script, Object value, String fieldName) {
    def v = value == null ? '' : value.toString().trim()
    if (v.length() == 0) {
        script.error("Missing required config: ${fieldName}")
    }
}

private void runTask(script, String taskName) {
    def tn = normalizeTaskName(taskName)
    script.bat """
        @echo off
        schtasks /run /tn "${tn}"
        exit /b %errorlevel%
    """.stripIndent()
    script.echo("SUCCESS: Attempted to run the scheduled task \"${tn}\".")
}

private void endTask(script, String taskName) {
    def tn = normalizeTaskName(taskName)
    script.bat """
        @echo off
        schtasks /end /tn "${tn}"
        exit /b 0
    """.stripIndent()
    script.echo("STOPPING TASK: ${tn}")
}

private void waitTaskFinish(script, String taskName, int timeoutMinutes) {
    def tn = normalizeTaskName(taskName)

    script.echo("WAITING DESKTOP TASK TO FINISH: ${tn}")

    // Poll status until "Ready" (or not Running)
    // Timeout implemented in minutes
    def maxLoops = Math.max(1, (timeoutMinutes * 60) / 6)

    script.bat """
        @echo off
        setlocal EnableExtensions EnableDelayedExpansion

        set "TASK_NAME=${tn}"
        set /a MAX_LOOPS=${maxLoops}
        set /a COUNT=0

        :loop
        set /a COUNT+=1
        if !COUNT! GTR !MAX_LOOPS! (
            echo ERROR: Timeout waiting task to finish: %TASK_NAME%
            exit /b 1
        )

        for /f "tokens=2 delims=: " %%f in ('schtasks /query /tn "%TASK_NAME%" /fo list ^| find "Status:"') do (
            set "STATUS=%%f"
        )

        if /i "!STATUS!"=="Running" (
            ping -n 6 127.0.0.1 >nul 2>nul
            goto loop
        )

        echo DESKTOP TASK FINISHED. STATUS=!STATUS!
        exit /b 0
    """.stripIndent()
}

private String normalizeTaskName(String taskName) {
    // Accept both:
    // startWinDriver
    // \\eMatch Automation\\RunEMatchDesktop
    def t = taskName.trim()
    if (t.startsWith('\\\\')) {
        t = t.substring(1)
    }
    return t
}

