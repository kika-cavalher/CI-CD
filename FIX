	@Keyword
	String findLatestExportedFilePath(
			String targetEnvironment,
			String exportLabel) {

		String environment = resolveEnvironmentName(
				targetEnvironment,
				exportLabel
				)

		String exportFolderPath = getCurrentExportFolderPath(
				targetEnvironment,
				exportLabel
				)

		File exportFolder = new File(
				exportFolderPath
				)

		if (!exportFolder.exists() ||
				!exportFolder.isDirectory()) {

			logInfo(
					'Export folder was not found. Folder: ' +
					exportFolderPath
					)

			return ''
		}

		String expectedSuffix = shortenFilePart(
				resolveExportLabelSuffixForFileName(
				exportLabel
				),
				MAX_LABEL_LENGTH
				)

		File[] folderFiles = exportFolder.listFiles()
		List<File> matchingFiles = []

		if (folderFiles != null) {
			for (File file : folderFiles) {

				if (file == null ||
						!file.exists() ||
						!file.isFile() ||
						file.length() <= 0 ||
						file.getName().startsWith('~$')) {

					continue
				}

				String lowerName =
						file.getName().toLowerCase()

				boolean excelFile =
						lowerName.endsWith('.xlsx') ||
						lowerName.endsWith('.xlsm') ||
						lowerName.endsWith('.xls')

				boolean environmentMatches =
						file.getName()
						.toUpperCase()
						.startsWith(
						environment +
						'_'
						)

				boolean suffixMatches =
						expectedSuffix == null ||
						expectedSuffix.trim().isEmpty() ||
						removeExcelExtension(
						file.getName()
						)
						.toLowerCase()
						.endsWith(
						'_' +
						expectedSuffix.toLowerCase()
						)

				if (excelFile &&
						environmentMatches &&
						suffixMatches) {

					matchingFiles.add(
							file
							)
				}
			}
		}

		if (matchingFiles.isEmpty()) {

			logInfo(
					'No exported file matched the expected values.\n' +
					'Environment: ' + environment + '\n' +
					'Export label: ' + safeLogText(exportLabel) + '\n' +
					'Expected suffix: ' + safeLogText(expectedSuffix) + '\n' +
					'Folder: ' + exportFolderPath
					)

			return ''
		}

		matchingFiles.sort { File first, File second ->

			second.lastModified() <=>
					first.lastModified()
		}

		File latestExportedFile =
				matchingFiles.first()

		logInfo(
				'Latest exported file resolved.\n' +
				'File: ' + latestExportedFile.getName() + '\n' +
				'Path: ' + latestExportedFile.getAbsolutePath() + '\n' +
				'Size bytes: ' + latestExportedFile.length()
				)

		return latestExportedFile.getAbsolutePath()
	}


	private void clickObjectFirstThenImage(
			String buttonDescription,
			String imageKey,
			String objectKey) {

		long startedAt =
				System.currentTimeMillis()

		logInfo(
				'Searching for ' +
				buttonDescription +
				' button using Windows object first.\n' +
				'Object key: ' + objectKey + '\n' +
				'Functional timeout: ' + ELEMENT_BUTTON_TIMEOUT_SECONDS + ' seconds\n' +
				'Hard timeout: ' + ELEMENT_HARD_TIMEOUT_SECONDS + ' seconds'
				)

		boolean clickedByObject =
				tryClickWindowsObjectProtected(
				objectKey,
				buttonDescription + ' button',
				ELEMENT_BUTTON_TIMEOUT_SECONDS
				)

		if (clickedByObject) {

			logInfo(
					buttonDescription +
					' button clicked using Windows object. Elapsed milliseconds: ' +
					elapsedMilliseconds(
					startedAt
					)
					)

			return
		}

		logInfo(
				buttonDescription +
				' Windows object was not available or did not answer before the hard timeout.\n' +
				'Trying image fallback.\n' +
				'Image key: ' + imageKey + '\n' +
				'Timeout: ' + IMAGE_BUTTON_TIMEOUT_SECONDS + ' seconds'
				)

		boolean imageFound = false

		try {
			imageFound = imageLoader.waitForImage(
					GENERAL_IMAGE_GROUP,
					imageKey,
					IMAGE_BUTTON_TIMEOUT_SECONDS
					)
		} catch (Throwable throwable) {

			logInfo(
					buttonDescription +
					' image search returned an exception.\n' +
					'Image key: ' + imageKey + '\n' +
					'Message: ' +
					safeExceptionMessage(
					throwable
					)
					)
		}

		if (imageFound) {

			try {
				imageLoader.clickImageOrStop(
						GENERAL_IMAGE_GROUP,
						imageKey
						)

				logInfo(
						buttonDescription +
						' button clicked using image fallback. Elapsed milliseconds: ' +
						elapsedMilliseconds(
						startedAt
						)
						)

				return
			} catch (Throwable throwable) {

				logInfo(
						buttonDescription +
						' image was found but could not be clicked.\n' +
						'Image key: ' + imageKey + '\n' +
						'Message: ' +
						safeExceptionMessage(
						throwable
						)
						)
			}
		}

		imageLoader.takeEvidence(
				buttonDescription +
				'ButtonNotFound.png'
				)

		KeywordUtil.markFailedAndStop(
				buttonDescription +
				' button was not found or could not be clicked.\n' +
				'Windows object key: ' + objectKey + '\n' +
				'Windows hard timeout: ' + ELEMENT_HARD_TIMEOUT_SECONDS + ' seconds\n' +
				'Image key: ' + imageKey + '\n' +
				'Image timeout: ' + IMAGE_BUTTON_TIMEOUT_SECONDS + ' seconds'
				)
	}


	private File saveToShortExportFolder(
			String exportLabel,
			String targetEnvironment) {

		long startedAt =
				System.currentTimeMillis()

		String environment = resolveEnvironmentName(
				targetEnvironment,
				exportLabel
				)

		String collectionName = shortenFilePart(
				sanitizeFileName(
				resolveCurrentCollectionName()
				),
				MAX_COLLECTION_LENGTH
				)

		String featureName = shortenFilePart(
				sanitizeFileName(
				resolveCurrentFeatureName()
				),
				MAX_FEATURE_LENGTH
				)

		String exportLabelSuffix = shortenFilePart(
				resolveExportLabelSuffixForFileName(
				exportLabel
				),
				MAX_LABEL_LENGTH
				)

		File directory = resolveShortExportDirectory(
				environment,
				collectionName,
				featureName
				)

		if (!directory.exists()) {

			logInfo(
					'Export directory does not exist. Creating directory: ' +
					directory.getAbsolutePath()
					)

			boolean created =
					directory.mkdirs()

			if (!created &&
					!directory.exists()) {

				KeywordUtil.markFailedAndStop(
						'Could not create export directory. Directory: ' +
						directory.getAbsolutePath()
						)

				return null
			}
		}

		String fileName = buildAutomaticExportFileName(
				environment,
				featureName,
				exportLabelSuffix
				)

		File exportedFile = new File(
				directory,
				fileName
				)

		exportedFile = ensurePathIsShortEnough(
				exportedFile,
				environment,
				exportLabelSuffix
				)

		String exportDirectory =
				exportedFile
				.getParentFile()
				.getAbsolutePath()

		logInfo(
				'Save dialog configuration prepared.\n' +
				'Environment: ' + environment + '\n' +
				'Collection: ' + collectionName + '\n' +
				'Feature: ' + featureName + '\n' +
				'Export label: ' + exportLabelSuffix + '\n' +
				'Directory: ' + exportDirectory + '\n' +
				'File name: ' + exportedFile.getName() + '\n' +
				'Full path length: ' + exportedFile.getAbsolutePath().length()
				)

		waitForSaveDialog()

		setSaveDialogDirectory(
				exportDirectory
				)

		setSaveDialogFileName(
				exportedFile.getName()
				)

		clickRequiredWindowsObject(
				'saveButton',
				'Save button',
				SAVE_DIALOG_TIMEOUT_SECONDS
				)

		Windows.delay(
				SAVE_DIALOG_OPEN_DELAY_SECONDS
				)

		logInfo(
				'Save button clicked. Waiting for exported file. Timeout: ' +
				EXPORT_FILE_TIMEOUT_SECONDS +
				' seconds. Expected path: ' +
				exportedFile.getAbsolutePath()
				)

		waitForExportedFileOrStop(
				exportedFile,
				EXPORT_FILE_TIMEOUT_SECONDS
				)

		logInfo(
				'Save flow completed. Elapsed milliseconds: ' +
				elapsedMilliseconds(
				startedAt
				)
				)

		return exportedFile
	}


	private void waitForSaveDialog() {

		logInfo(
				'Waiting for Save dialog using Windows object first.\n' +
				'Object: export/fileNameField\n' +
				'Functional timeout: ' + SAVE_DIALOG_TIMEOUT_SECONDS + ' seconds\n' +
				'Hard timeout: ' + ELEMENT_HARD_TIMEOUT_SECONDS + ' seconds'
				)

		boolean foundByObject =
				isWindowsObjectPresentProtected(
				'fileNameField',
				'Save dialog file name field',
				SAVE_DIALOG_TIMEOUT_SECONDS
				)

		if (foundByObject) {

			logInfo(
					'Save dialog found using Windows object.'
					)

			return
		}

		logInfo(
				'Save dialog Windows object was not found or did not answer.\n' +
				'Trying image fallback using folderNew and folderOld.'
				)

		String detectedImage =
				waitForFirstVisibleImage(
				[
					'folderNew',
					'folderOld'
				],
				SAVE_DIALOG_IMAGE_TIMEOUT_SECONDS
				)

		if (detectedImage != null) {

			logInfo(
					'Save dialog found using image fallback.\n' +
					'Image key: ' + detectedImage
					)

			return
		}

		imageLoader.takeEvidence(
				'SaveDialogNotFound.png'
				)

		KeywordUtil.markFailedAndStop(
				'Save dialog was not found.\n' +
				'Windows object: export/fileNameField\n' +
				'Windows hard timeout: ' + ELEMENT_HARD_TIMEOUT_SECONDS + ' seconds\n' +
