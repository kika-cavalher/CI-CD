	private BigDecimal parseNumber(
		String numericText,
		boolean integerOnly
	) {
		String clean = safeText(numericText)
			.replace(' ', '')
			.replace(',', '.')

		if (integerOnly && !(clean ==~ /[-+]?\d+/)) {
			return null
		}

		try {
			return new BigDecimal(clean)
		} catch (Throwable ignored) {
			return null
		}
	}

	private String normalizeComparableText(String value) {
		String text = safeText(value)

		return Normalizer.normalize(
			text,
			Normalizer.Form.NFD
		)
		.replaceAll('\\p{InCombiningDiacriticalMarks}+', '')
		.toLowerCase()
		.replaceAll('[^a-z0-9]+', ' ')
		.trim()
		.replaceAll('\\s+', ' ')
	}

	private void validateNotEmpty(
		List<String> values,
		Integer index,
		String errorMessage,
		List<String> errors
	) {
		if (valueAt(values, index).isEmpty()) {
			errors.add(errorMessage)
		}
	}

	private String valueAt(
		List<String> values,
		Integer index
	) {
		if (values == null || index == null) {
			return ''
		}

		if (index < 0 || index >= values.size()) {
			return ''
		}

		return safeText(values[index])
	}

	private void failIfErrors(
		String title,
		List<String> errors
	) {
		if (errors == null || errors.isEmpty()) {
			return
		}

		String message = title + '\n' +
			errors.collect {
				String error -> '- ' + error
			}.join('\n')

		KeywordUtil.markFailedAndStop(message)
	}

	private boolean isFrench(String language) {
		return safeText(language).equalsIgnoreCase('fr')
	}

	private int safeTimeout(
		Integer value,
		Integer defaultValue
	) {
		if (value == null || value <= 0) {
			return defaultValue
		}

		return value
	}

	private String safeText(Object value) {
		if (value == null) {
			return ''
		}

		return value.toString().trim()
	}
