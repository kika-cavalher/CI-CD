public class Steps {
	public static final String MARK = "[STEP]"

	@Keyword
	static void note(String msg) {
		KeywordUtil.logInfo("${MARK} ${msg}")
	}

	@Keyword
	static void snap(String message) {
		try {
			note("📸 ${message}")

			// Build controlled screenshot path (.png first)
			String suiteName = RunConfiguration.getExecutionSourceName()
			String timestamp = RunConfiguration.getExecutionTimestamp()
			String baseName = System.currentTimeMillis().toString()
			String pngPath = "Reports/${suiteName}/${timestamp}/Screenshots/${baseName}.png"
			String jpgPath = "Reports/${suiteName}/${timestamp}/Screenshots/${baseName}.jpg"

			// Take screenshot as PNG
			WebUI.takeScreenshot(pngPath)

			// Convert PNG → JPG
			File pngFile = new File(pngPath)
			if (pngFile.exists()) {
				BufferedImage image = ImageIO.read(pngFile)
				File jpgFile = new File(jpgPath)
				ImageIO.write(image, "jpg", jpgFile)
				pngFile.delete() // remove original PNG

				note("🖼️ Saved at: ${jpgPath}")
			} else {
				note("⚠️ Screenshot file not found: ${pngPath}")
			}
		} catch (Exception e) {
			println "[snap] Failed to capture or convert screenshot: ${e.message}"
		}
	}
}
