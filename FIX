pipeline {
    agent { label 'GI5_SWDCFRNXGI55817' }

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        timeout(time: 4, unit: 'HOURS')
    }

    environment {
        TASK_NAME   = '\\eMatch Automation\\RunEMatchDesktop'
        STARTER_DIR = 'D:\\Projects\\eMatchStarters'
        CTX_FILE    = 'D:\\Projects\\eMatchStarters\\run-context.properties'
        LOG_DIR     = 'D:\\Projects\\eMatchStarters\\logs'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Prepare Context') {
            steps {
                script {
                    def ws = pwd()
                    def buildTagSafe = (env.BUILD_TAG ?: "build_${env.BUILD_NUMBER}").replaceAll('[^a-zA-Z0-9._-]', '_')

                    def markerFile = "${env.LOG_DIR}\\__jenkins_task_exitcode_${buildTagSafe}.txt"
                    env.MARKER_FILE = markerFile

                    bat """
                        if not exist "${env.LOG_DIR}" mkdir "${env.LOG_DIR}"

                        del /f /q "${markerFile}" 2>nul

                        echo WORKSPACE=${ws}>"${env.CTX_FILE}"
                        echo PROJECT_PATH=${ws}\\eMatch POC.prj>>"${env.CTX_FILE}"
                        echo KATALON_EXE=C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0\\katalonc.exe>>"${env.CTX_FILE}"
                        echo COLLECTION_PATH=Test Suites/Archive Mode/Archive Mode Collection>>"${env.CTX_FILE}"
                        echo BROWSER_TYPE=Windows>>"${env.CTX_FILE}"
                        echo RETRY=0>>"${env.CTX_FILE}"
                        echo MARKER_FILE=${markerFile}>>"${env.CTX_FILE}"

                        type "${env.CTX_FILE}"
                    """
                }
            }
        }

        stage('Run Desktop (Task Scheduler)') {
            steps {
                script {
                    bat """
                        echo [INFO] Running Task Scheduler: ${env.TASK_NAME}
                        schtasks /run /tn "${env.TASK_NAME}"
                        echo [INFO] Task triggered.
                    """

                    timeout(time: 3, unit: 'HOURS') {
                        waitUntil {
                            sleep(time: 3, unit: 'SECONDS')
                            return fileExists(env.MARKER_FILE)
                        }
                    }

                    def exitCodeRaw = readFile(env.MARKER_FILE).trim()
                    echo "[INFO] Marker file: ${env.MARKER_FILE}"
                    echo "[INFO] Exit code read: '${exitCodeRaw}'"

                    int exitCode = 1
                    try {
                        exitCode = Integer.parseInt(exitCodeRaw)
                    } catch (ignored) {
                        exitCode = 1
                    }

                    if (exitCode != 0) {
                        error("Desktop execution failed. ExitCode=${exitCode}")
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                echo '[INFO] Archiving artifacts (safe mode)'
            }

            archiveArtifacts artifacts: 'Reports/**/*', allowEmptyArchive: true
            archiveArtifacts artifacts: 'logs/**/*', allowEmptyArchive: true
            archiveArtifacts artifacts: 'D:/Projects/eMatchStarters/logs/**/*', allowEmptyArchive: true

            script {
                echo '[INFO] Skipping fragile video patterns to avoid post failure'
            }
        }
    }
}



