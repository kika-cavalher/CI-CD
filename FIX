@echo off
setlocal EnableExtensions EnableDelayedExpansion

rem ============================================================
rem  eMatch Desktop Runner (Triggered by Windows Task Scheduler)
rem  Reads: D:\Projects\eMatchStarters\run-context.properties
rem  Writes: EXITCODE_FILE (configured in properties)
rem ============================================================

set "CTX_FILE=D:\Projects\eMatchStarters\run-context.properties"

if not exist "%CTX_FILE%" (
  echo [ERROR] Context file not found: %CTX_FILE%
  exit /b 99
)

rem --- Load properties (key=value) into environment variables ---
for /f "usebackq tokens=1* delims==" %%A in ("%CTX_FILE%") do (
  set "K=%%A"
  set "V=%%B"
  if not "!K!"=="" (
    set "!K!=!V!"
  )
)

rem --- Mandatory fields validation ---
if "%WORKSPACE%"=="" (
  echo [ERROR] WORKSPACE not set in %CTX_FILE%
  exit /b 98
)
if "%KATALON_EXE%"=="" (
  echo [ERROR] KATALON_EXE not set in %CTX_FILE%
  exit /b 97
)
if "%PROJECT_PATH%"=="" (
  echo [ERROR] PROJECT_PATH not set in %CTX_FILE%
  exit /b 96
)
if "%TEST_COLLECTION_PATH%"=="" (
  echo [ERROR] TEST_COLLECTION_PATH not set in %CTX_FILE%
  exit /b 95
)
if "%BROWSER_TYPE%"=="" (
  echo [ERROR] BROWSER_TYPE not set in %CTX_FILE%
  exit /b 94
)
if "%REPORT_FOLDER%"=="" (
  echo [ERROR] REPORT_FOLDER not set in %CTX_FILE%
  exit /b 93
)
if "%EXITCODE_FILE%"=="" (
  echo [ERROR] EXITCODE_FILE not set in %CTX_FILE%
  exit /b 92
)

rem --- Ensure report folder exists ---
if not exist "%REPORT_FOLDER%" (
  mkdir "%REPORT_FOLDER%" >nul 2>nul
)

rem --- Move to workspace so relative paths work ---
cd /d "%WORKSPACE%"

echo ============================================================
echo [INFO] WORKSPACE           = %WORKSPACE%
echo [INFO] PROJECT_PATH        = %PROJECT_PATH%
echo [INFO] TEST_COLLECTION     = %TEST_COLLECTION_PATH%
echo [INFO] BROWSER_TYPE        = %BROWSER_TYPE%
echo [INFO] REPORT_FOLDER       = %REPORT_FOLDER%
echo [INFO] EXITCODE_FILE       = %EXITCODE_FILE%
echo ============================================================

rem --- Execute Katalon ---
"%KATALON_EXE%" ^
  -noSplash ^
  -runMode=console ^
  -retry=0 ^
  -projectPath="%PROJECT_PATH%" ^
  -testSuiteCollectionPath="%TEST_COLLECTION_PATH%" ^
  -browserType="%BROWSER_TYPE%" ^
  -reportFolder="%REPORT_FOLDER%"

set "RC=%ERRORLEVEL%"

rem --- Persist exit code for Jenkins to read ---
rem (Jenkins uses this to know if the task really failed)
echo %RC% > "%EXITCODE_FILE%"

echo ============================================================
echo [INFO] Katalon finished with exit code: %RC%
echo ============================================================

exit /b %RC%












def CFG = [
  agentLabel: 'GI5_SWDCFRNXGI55817',

  katalonExe: 'C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0\\katalonc.exe',

  projectFileName: 'eMatch POC.prj',
  testCollectionPath: 'Test Suites/Archive Mode/Archive Mode Collection',
  browserType: 'Windows',

  contextFile: 'D:\\Projects\\eMatchStarters\\run-context.properties',

  winDriverTask: 'startWinDriver',
  desktopTask: '\\eMatch Automation\\RunEMatchDesktop',

  nextJobName: 'Passerelle Bilan'
]

node(CFG.agentLabel) {
  timestamps {
    ansiColor('xterm') {

      stage('Checkout') {
        checkout scm
      }

      stage('Validate Scheduled Tasks') {
        bat """
          @echo off
          echo ============================================================
          echo VALIDATING TOOLS AND SUPPORT FILES
          echo ============================================================
          schtasks /query /tn "${CFG.winDriverTask}" >nul 2>nul
          if errorlevel 1 (
            echo [ERROR] Scheduled task not found: ${CFG.winDriverTask}
            exit /b 1
          )
          schtasks /query /tn "${CFG.desktopTask}" >nul 2>nul
          if errorlevel 1 (
            echo [ERROR] Scheduled task not found: ${CFG.desktopTask}
            exit /b 1
          )
          echo [OK] Support files and scheduled tasks found
          echo ============================================================
        """
      }

      stage('Prepare Run Context') {
        def wsPath = pwd()
        def projectPath = "${wsPath}\\${CFG.projectFileName}"
        def reportFolder = "${wsPath}\\Reports"
        def exitCodeFile = "${wsPath}\\Reports\\_jenkins_task_exitcode.txt"

        writeFile file: CFG.contextFile, text: """WORKSPACE=${wsPath}
KATALON_EXE=${CFG.katalonExe}
PROJECT_PATH=${projectPath}
TEST_COLLECTION_PATH=${CFG.testCollectionPath}
BROWSER_TYPE=${CFG.browserType}
REPORT_FOLDER=${reportFolder}
EXITCODE_FILE=${exitCodeFile}
"""
        echo "✅ run-context.properties written: ${CFG.contextFile}"
      }

      stage('Run - Archive Mode Collection') {
        bat """
          @echo off
          echo ============================================================
          echo START ASSET: Archive Mode Collection
          echo TASK: ${CFG.desktopTask}
          echo ============================================================

          schtasks /run /tn "${CFG.winDriverTask}"
          if errorlevel 1 exit /b 1

          schtasks /run /tn "${CFG.desktopTask}"
          if errorlevel 1 exit /b 1

          :loop
          for /f "tokens=2 delims=: " %%f in ('schtasks /query /tn "${CFG.desktopTask}" /fo list ^| find "Status:"') do (
              if "%%f"=="Running" (
                  ping -n 6 localhost >nul 2>nul
                  goto loop
              )
          )

          schtasks /end /tn "${CFG.winDriverTask}" >nul 2>nul
          exit /b 0
        """
      }

      stage('Collect Reports') {
        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {

          if (fileExists('Reports/_jenkins_task_exitcode.txt')) {
            def exitCode = readFile('Reports/_jenkins_task_exitcode.txt').trim()
            echo "📌 Desktop task exit code: ${exitCode}"
          } else {
            echo "⚠️ Desktop task exit code file not found: ${pwd()}\\Reports\\_jenkins_task_exitcode.txt"
          }

          if (!fileExists('Reports')) {
            error("❌ Reports folder not found after execution. The scheduled task likely ran with a wrong PROJECT_PATH/WORKSPACE.")
          }

          junit allowEmptyResults: true, testResults: 'Reports/**/JUnit_Report.xml'
          archiveArtifacts allowEmptyArchive: true, artifacts: 'Reports/**/*'
        }
      }

      stage('Trigger Next Job') {
        echo "Triggering next Jenkins job: ${CFG.nextJobName}"
        build job: CFG.nextJobName, wait: false
      }
    }
  }
}











