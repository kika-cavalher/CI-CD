import java.util.Locale

import com.kms.katalon.core.util.KeywordUtil

Integer threshold = 3
Integer maxDifferencesToShow = 999
Integer maxErrorsToShow = 999

String acceptedDifferenceText = '<= ' + threshold + '%'

def addNote = { String message ->
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(message)
}

Map result = CustomKeywords.'commands.ExportFileComparator.compareRecProdExportFiles'(
		threshold
)

String featureName = safeText(result.featureName, 'Not available')
String sharedFolderName = folderNameOnly(result.sharedFolder)

String recFileName = fileNameOnly(result.recFileName)
String prdFileName = fileNameOnly(result.prdFileName)

String recFileStatus = isNotFound(recFileName) ? 'FAILED' : 'PASSED'
String prdFileStatus = isNotFound(prdFileName) ? 'FAILED' : 'PASSED'

Integer totalValidations = toInteger(result.totalValidations, 0)
Integer passedValidations = toInteger(result.passedValidations, 0)
Integer failedValidations = toInteger(result.failedValidations, 0)

List<Map> validations = result.validations == null ? [] : result.validations as List<Map>
List<String> differences = result.differences == null ? [] : result.differences as List<String>

String errorsText = safeText(result.errorsText, '')
Boolean hasFailure = failedValidations > 0 || !differences.isEmpty() || !errorsText.isEmpty()

addNote(
		'[PASS] REC x PRD Export Validation setup\n' +
		'Feature: ' + featureName + '\n' +
		'Accepted numeric difference: ' + acceptedDifferenceText + '\n' +
		'Shared folder: ' + sharedFolderName + '\n' +
		'Goal: compare the REC exported file against the PRD exported file.'
)

addNote(
		((recFileStatus == 'PASSED' && prdFileStatus == 'PASSED') ? '[PASS] ' : '[FAIL] ') +
		'Files selected for comparison\n' +
		'Expected files: 2\n' +
		'Files ready: ' + countReadyFiles(recFileName, prdFileName) + '\n\n' +
		'REC file: ' + recFileStatus + ' - ' + recFileName + '\n' +
		'PRD file: ' + prdFileStatus + ' - ' + prdFileName
)

addNote(
		(hasFailure ? '[FAIL] ' : '[PASS] ') +
		'Validation summary\n' +
		'Total validations: ' + totalValidations + '\n' +
		'Passed: ' + passedValidations + '\n' +
		'Failed: ' + failedValidations + '\n' +
		'Accepted numeric difference: ' + acceptedDifferenceText + '\n' +
		'Differences listed: ' + differences.size()
)

if (validations.isEmpty()) {
	addNote(
			'[SKIPPED] Validation details\n' +
			'No validation detail was returned by the comparator keyword.'
	)
} else {
	validations.eachWithIndex { Map validation, int index ->
		String validationName = safeText(validation.name, 'Validation ' + (index + 1))
		String validationStatus = normalizeStatus(validation.status)
		String validationDetails = cleanReportText(validation.details)

		String statusPrefix = validationStatus == 'PASS' ? '[PASS] ' : '[FAIL] '

		addNote(
				statusPrefix +
				'Validation ' + (index + 1) + ' - ' + validationName + '\n' +
				'Status: ' + validationStatus + '\n' +
				formatValidationDetails(validationDetails, acceptedDifferenceText)
		)
	}
}

if (!differences.isEmpty()) {
	addNote(
			'[FAIL] Differences found\n' +
			'Total differences returned: ' + differences.size() + '\n' +
			'Differences displayed: ' + Math.min(differences.size(), maxDifferencesToShow) + '\n' +
			'Accepted numeric difference: ' + acceptedDifferenceText + '\n\n' +
			buildDifferencesReport(differences, maxDifferencesToShow, acceptedDifferenceText)
	)
} else {
	addNote(
			'[PASS] Differences check\n' +
			'Accepted numeric difference: ' + acceptedDifferenceText + '\n' +
			'No differences were returned by the comparator keyword.'
	)
}

if (!errorsText.isEmpty()) {
	addNote(
			'[FAIL] Comparator errors\n' +
			'Accepted numeric difference: ' + acceptedDifferenceText + '\n\n' +
			buildErrorsReport(errorsText, maxErrorsToShow, acceptedDifferenceText)
	)
}

if (hasFailure) {
	addNote(
			'[FAIL] Final result\n' +
			'REC x PRD export validation finished with mismatches.\n' +
			'Feature: ' + featureName + '\n' +
			'Accepted numeric difference: ' + acceptedDifferenceText + '\n' +
			'REC file: ' + recFileName + '\n' +
			'PRD file: ' + prdFileName
	)

	KeywordUtil.markFailed(
			'REC x PRD export validation failed. Check the comparison report above.'
	)
} else {
	addNote(
			'[PASS] Final result\n' +
			'REC x PRD export validation completed successfully.\n' +
			'Feature: ' + featureName + '\n' +
			'Accepted numeric difference: ' + acceptedDifferenceText + '\n' +
			'REC file: ' + recFileName + '\n' +
			'PRD file: ' + prdFileName + '\n' +
			'Result: no mismatches were found between REC and PRD files.'
	)

	KeywordUtil.markPassed(
			'REC x PRD export validation completed successfully.'
	)
}

String formatValidationDetails(String details, String acceptedDifferenceText) {
	String text = safeText(details, '')

	if (text.isEmpty()) {
		return 'Details: not available.'
	}

	List<String> lines = []

	text.replace('\r\n', '\n')
			.replace('\r', '\n')
			.split('\n')
			.each { String line ->
				String clean = safeText(line, '')

				if (!clean.isEmpty() && !isPathLine(clean)) {
					lines.add(normalizeToleranceText(clean, acceptedDifferenceText))
				}
			}

	return lines.isEmpty() ? 'Details: not available.' : lines.join('\n')
}

String buildDifferencesReport(List<String> differences, Integer maxToShow, String acceptedDifferenceText) {
	List<String> lines = []

	Integer limit = maxToShow == null || maxToShow <= 0 ? differences.size() : maxToShow
	Integer index = 1

	for (String difference : differences.take(limit)) {
		String cleanDifference = normalizeToleranceText(cleanReportText(difference), acceptedDifferenceText)

		if (!cleanDifference.isEmpty()) {
			lines.add('Difference ' + index + ': ' + cleanDifference)
			index++
		}
	}

	if (differences.size() > limit) {
		lines.add('')
		lines.add('... and ' + (differences.size() - limit) + ' more difference(s).')
	}

	if (lines.isEmpty()) {
		lines.add('Differences were returned, but no readable detail was available.')
	}

	return lines.join('\n')
}

String buildErrorsReport(String errorsText, Integer maxToShow, String acceptedDifferenceText) {
	List<String> lines = []

	String text = normalizeToleranceText(cleanReportText(errorsText), acceptedDifferenceText)

	if (text.isEmpty()) {
		return 'No readable error detail was available.'
	}

	List<String> rawLines = []

	text.replace('\r\n', '\n')
			.replace('\r', '\n')
			.split('\n')
			.each { String line ->
				String clean = safeText(line, '')

				if (!clean.isEmpty() && !isPathLine(clean)) {
					rawLines.add(normalizeToleranceText(clean, acceptedDifferenceText))
				}
			}

	Integer limit = maxToShow == null || maxToShow <= 0 ? rawLines.size() : maxToShow

	Integer index = 1

	for (String line : rawLines.take(limit)) {
		lines.add('Error ' + index + ': ' + line)
		index++
	}

	if (rawLines.size() > limit) {
		lines.add('')
		lines.add('... and ' + (rawLines.size() - limit) + ' more error line(s).')
	}

	return lines.join('\n')
}

String cleanReportText(Object value) {
	String text = safeText(value, '')

	if (text.isEmpty()) {
		return ''
	}

	text = text.replace('\\', '/')

	text = text.replaceAll('[A-Za-z]:/[^\\s|"]*/([^/\\s|"]+\\.xlsx)', '$1')
	text = text.replaceAll('[A-Za-z]:/[^\\s|"]*/([^/\\s|"]+\\.xls)', '$1')
	text = text.replaceAll('[A-Za-z]:/[^\\s|"]*/([^/\\s|"]+\\.csv)', '$1')
	text = text.replaceAll('[A-Za-z]:/[^\\s|"]*/([^/\\s|"]+\\.txt)', '$1')

	text = text.replaceAll('[A-Za-z]:/[^\\n\\r]*Shared_REC_PRD_Exports/?', 'Shared_REC_PRD_Exports')
	text = text.replaceAll('[A-Za-z]:/[^\\n\\r]*Reports/?', 'Reports')

	text = text.replaceAll('^com\\.kms\\.katalon\\.core\\.exception\\.StepFailedException:\\s*', '').trim()
	text = text.replaceAll('^Reason:\\s*com\\.kms\\.katalon\\.core\\.exception\\.StepFailedException:\\s*', 'Reason: ').trim()

	return text.trim()
}

String normalizeToleranceText(String value, String acceptedDifferenceText) {
	String text = safeText(value, '')

	if (text.isEmpty()) {
		return ''
	}

	text = text.replaceAll(
			'(?i)Allowed numeric difference\\s*:\\s*([0-9]+(?:[\\.,][0-9]+)?)\\s*%?',
			'Accepted numeric difference: ' + acceptedDifferenceText
	)

	text = text.replaceAll(
			'(?i)Allowed difference\\s*:\\s*([0-9]+(?:[\\.,][0-9]+)?)\\s*%?',
			'Allowed difference: ' + acceptedDifferenceText
	)

	text = text.replaceAll(
			'(?i)Allowed difference is\\s*([0-9]+(?:[\\.,][0-9]+)?)\\s*%?',
			'Accepted difference: ' + acceptedDifferenceText
	)

	text = text.replaceAll(
			'(?i)Accepted difference\\s*:\\s*<=\\s*([0-9]+(?:[\\.,][0-9]+)?)\\s*%?',
			'Accepted difference: ' + acceptedDifferenceText
	)

	return text.trim()
}

Boolean isPathLine(String value) {
	String text = safeText(value, '').replace('\\', '/').trim()

	return text ==~ /(?i)^Path\s*:.*$/ ||
			text ==~ /(?i)^REC path\s*:.*$/ ||
			text ==~ /(?i)^PRD path\s*:.*$/
}

String fileNameOnly(Object value) {
	String text = safeText(value, 'NOT FOUND')

	if (text.isEmpty()) {
		return 'NOT FOUND'
	}

	if (isNotFound(text)) {
		return 'NOT FOUND'
	}

	text = text.replace('\\', '/')

	if (text.contains('/')) {
		return text.substring(text.lastIndexOf('/') + 1)
	}

	return text
}

String folderNameOnly(Object value) {
	String text = safeText(value, 'Not available')

	if (text.isEmpty() || isNotFound(text)) {
		return 'Not available'
	}

	text = text.replace('\\', '/')

	if (text.endsWith('/')) {
		text = text.substring(0, text.length() - 1)
	}

	if (text.contains('/')) {
		return text.substring(text.lastIndexOf('/') + 1)
	}

	return text
}

String normalizeStatus(Object value) {
	String status = safeText(value, 'FAIL').toUpperCase(Locale.ENGLISH)

	if (status == 'PASSED') {
		return 'PASS'
	}

	if (status == 'FAILED') {
		return 'FAIL'
	}

	if (status != 'PASS' && status != 'FAIL') {
		return status
	}

	return status
}

Boolean isNotFound(Object value) {
	String text = safeText(value, '').toUpperCase(Locale.ENGLISH)

	return text.isEmpty() ||
			text == 'NOT FOUND' ||
			text.contains('NOT_FOUND') ||
			text.contains('NOT FOUND')
}

Integer countReadyFiles(String recFileName, String prdFileName) {
	Integer count = 0

	if (!isNotFound(recFileName)) {
		count++
	}

	if (!isNotFound(prdFileName)) {
		count++
	}

	return count
}

Integer toInteger(Object value, Integer defaultValue) {
	try {
		return Integer.parseInt(String.valueOf(value).trim())
	} catch (Throwable ignored) {
		return defaultValue
	}
}

String safeText(Object value, String defaultValue) {
	if (value == null) {
		return defaultValue
	}

	String text = String.valueOf(value).trim()

	return text.isEmpty() ? defaultValue : text
}










package commands

import java.text.Normalizer

import org.apache.poi.ss.usermodel.Cell
import org.apache.poi.ss.usermodel.CellType
import org.apache.poi.ss.usermodel.DataFormatter
import org.apache.poi.ss.usermodel.FormulaEvaluator
import org.apache.poi.ss.usermodel.Row
import org.apache.poi.ss.usermodel.Sheet
import org.apache.poi.ss.usermodel.Workbook
import org.apache.poi.ss.usermodel.WorkbookFactory

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil

class ExportFileComparator {

	private static final int MAX_MISMATCHES_PER_COLUMN = 30

	@Keyword
	String validateRecProdExportFiles(Integer threshold) {
		Map result = compareRecProdExportFiles(threshold)
		return result.errorsText
	}

	@Keyword
	Map compareRecProdExportFiles(Integer threshold) {
		int safeThreshold = threshold == null ? 0 : threshold

		File sharedExportFolder = resolveExecutionRecPrdExportFolder()
		String featureName = resolveCurrentFeatureName()
		String collectionName = resolveCurrentCollectionName()
		String sanitizedFeatureName = sanitizeFileName(featureName)

		File recFile = findLatestExportFile(sharedExportFolder, 'REC', sanitizedFeatureName)
		File prdFile = findLatestExportFile(sharedExportFolder, 'PRD', sanitizedFeatureName)

		Map result = [
			collectionName   : collectionName,
			featureName      : featureName,
			threshold        : safeThreshold,
			sharedFolder     : sharedExportFolder.getAbsolutePath(),
			recFileName      : recFile == null ? 'NOT FOUND' : recFile.getName(),
			recFilePath      : recFile == null ? 'NOT FOUND' : recFile.getAbsolutePath(),
			prdFileName      : prdFile == null ? 'NOT FOUND' : prdFile.getName(),
			prdFilePath      : prdFile == null ? 'NOT FOUND' : prdFile.getAbsolutePath(),
			validations      : [],
			differences      : [],
			errors           : [],
			errorsText       : '',
			totalValidations : 0,
			passedValidations: 0,
			failedValidations: 0
		]

		if (recFile == null) {
			addValidation(
					result,
					'Validate REC exported file exists',
					false,
					'Expected folder: ' + sharedExportFolder.getAbsolutePath() + '\n' +
					'Expected format: REC_yyyyMMdd_HHmmss_' + sanitizedFeatureName + '.xlsx'
					)

			result.errors.add('REC exported file was not found in shared folder: ' + sharedExportFolder.getAbsolutePath())
		} else {
			addValidation(
					result,
					'Validate REC exported file exists',
					true,
					'REC file selected: ' + recFile.getName() + '\n' +
					'Path: ' + recFile.getAbsolutePath()
					)
		}

		if (prdFile == null) {
			addValidation(
					result,
					'Validate PRD exported file exists',
					false,
					'Expected folder: ' + sharedExportFolder.getAbsolutePath() + '\n' +
					'Expected format: PRD_yyyyMMdd_HHmmss_' + sanitizedFeatureName + '.xlsx'
					)

			result.errors.add('PRD exported file was not found in shared folder: ' + sharedExportFolder.getAbsolutePath())
		} else {
			addValidation(
					result,
					'Validate PRD exported file exists',
					true,
					'PRD file selected: ' + prdFile.getName() + '\n' +
					'Path: ' + prdFile.getAbsolutePath()
					)
		}

		if (recFile != null && prdFile != null) {
			compareExcelFiles(recFile, prdFile, safeThreshold, result)
		}

		refreshResultCounters(result)

		result.errorsText = result.errors.join('\n')

		KeywordUtil.logInfo('REC/PRD comparison collection: ' + collectionName)
		KeywordUtil.logInfo('REC/PRD comparison feature: ' + featureName)
		KeywordUtil.logInfo('REC/PRD comparison shared folder: ' + result.sharedFolder)
		KeywordUtil.logInfo('REC file selected: ' + result.recFilePath)
		KeywordUtil.logInfo('PRD file selected: ' + result.prdFilePath)
		KeywordUtil.logInfo('REC/PRD comparison errors: ' + result.errors.size())

		return result
	}

	private File resolveExecutionRecPrdExportFolder() {
		File executionRootFolder = resolveExecutionRootFolder()
		String collectionName = sanitizeFileName(resolveCurrentCollectionName())
		String featureName = sanitizeFileName(resolveCurrentFeatureName())

		return new File(
				executionRootFolder,
				'Shared_REC_PRD_Exports\\' + collectionName + '\\' + featureName
				)
	}

	private File resolveExecutionRootFolder() {
		String reportFolderPath = RunConfiguration.getReportFolder()

		if (reportFolderPath == null || reportFolderPath.trim().isEmpty()) {
			return new File(RunConfiguration.getProjectDir(), 'Reports\\Unknown_Execution')
		}

		File current = new File(reportFolderPath)

		while (current != null) {
			File parent = current.getParentFile()

			if (parent != null && parent.getName().equalsIgnoreCase('Reports')) {
				return current
			}

			current = parent
		}

		return new File(reportFolderPath)
	}

	private String resolveCurrentCollectionName() {
		List<String> validParts = getValidReportFolderParts()

		if (!validParts.isEmpty()) {
			return validParts[0]
		}

		return 'Collection'
	}

	private String resolveCurrentFeatureName() {
		List<String> validParts = getValidReportFolderParts()

		if (!validParts.isEmpty()) {
			return validParts.last()
		}

		return 'Export'
	}

	private List<String> getValidReportFolderParts() {
		List<String> validParts = []
		String reportFolderPath = RunConfiguration.getReportFolder()

		if (reportFolderPath == null || reportFolderPath.trim().isEmpty()) {
			return validParts
		}

		File executionRootFolder = resolveExecutionRootFolder()
		String fullPath = new File(reportFolderPath).getAbsolutePath()
		String rootPath = executionRootFolder.getAbsolutePath()

		if (!fullPath.toLowerCase().startsWith(rootPath.toLowerCase())) {
			return validParts
		}

		String relativePath = fullPath.substring(rootPath.length())
		relativePath = relativePath.replaceAll('^\\\\+', '')

		if (relativePath.trim().isEmpty()) {
			return validParts
		}

		List<String> parts = relativePath.replace('/', '\\').split('\\\\') as List<String>

		for (String part : parts) {
			if (isValidFeatureNamePart(part)) {
				validParts.add(part.trim())
			}
		}

		return validParts
	}

	private boolean isValidFeatureNamePart(String part) {
		if (part == null || part.trim().isEmpty()) {
			return false
		}

		String value = part.trim()
		String lower = value.toLowerCase()

		if (value ==~ /\d{8}_\d{6}/ || value ==~ /\d{14}/) {
			return false
		}

		if (value ==~ /^\d+\.\s*.*/) {
			return false
		}

		List<String> ignoredExactValues = [
			'reports',
			'evidences',
			'exports',
			'test cases',
			'test suites',
			'connection',
			'authentication',
			'login rec',
			'login prd'
		]

		if (ignoredExactValues.contains(lower)) {
			return false
		}

		List<String> ignoredContainsValues = [
			'export',
			'validation',
			'validations',
			'validate',
			'compare',
			'close application',
			'open module',
			'login'
		]

		for (String ignored : ignoredContainsValues) {
			if (lower.contains(ignored)) {
				return false
			}
		}

		return true
	}

	private File findLatestExportFile(File folder, String environment, String sanitizedFeatureName) {
		if (folder == null || !folder.exists() || !folder.isDirectory()) {
			return null
		}

		List<File> candidates = []
		File[] files = folder.listFiles()

		if (files == null) {
			return null
		}

		for (File file : files) {
			if (!file.isFile()) {
				continue
			}

			String fileName = file.getName()

			if (!fileName.toLowerCase().endsWith('.xlsx')) {
				continue
			}

			if (fileName.startsWith('~$')) {
				continue
			}

			String normalizedFileName = normalizeText(fileName)
			String normalizedEnvironment = normalizeText(environment)
			String normalizedFeatureName = normalizeText(sanitizedFeatureName)

			if (!normalizedFileName.startsWith(normalizedEnvironment + '_')) {
				continue
			}

			if (!normalizedFileName.contains(normalizedFeatureName)) {
				continue
			}

			candidates.add(file)
		}

		if (candidates.isEmpty()) {
			return null
		}

		return candidates.sort { File file -> file.lastModified() }.last()
	}

	private void compareExcelFiles(File recFile, File prdFile, int threshold, Map result) {
		Workbook recWorkbook = null
		Workbook prdWorkbook = null

		try {
			recWorkbook = WorkbookFactory.create(recFile)
			prdWorkbook = WorkbookFactory.create(prdFile)

			FormulaEvaluator recEvaluator = recWorkbook.getCreationHelper().createFormulaEvaluator()
			FormulaEvaluator prdEvaluator = prdWorkbook.getCreationHelper().createFormulaEvaluator()
			DataFormatter formatter = new DataFormatter()

			Sheet recSheet = recWorkbook.getSheetAt(0)
			Sheet prdSheet = prdWorkbook.getSheetAt(0)

			SheetData recData = readSheetData(recSheet, recEvaluator, formatter)
			SheetData prdData = readSheetData(prdSheet, prdEvaluator, formatter)

			compareNumberOfHeaders(recData, prdData, result)
			compareHeadersStructure(recData, prdData, result)
			compareNumberOfRows(recData, prdData, result)

			compareColumnBetweenFiles('Year', ['year', 'annee', 'année'], recData, prdData, threshold, result)
			compareColumnBetweenFiles('Nombre', ['nombre'], recData, prdData, threshold, result)
			compareColumnBetweenFiles('Solde Transac CCY', [
				'solde transac ccy',
				'solde transac',
				'transac ccy'
			], recData, prdData, threshold, result)
			compareColumnBetweenFiles('Solde Base CCY', ['solde base ccy', 'base ccy'], recData, prdData, threshold, result)
			compareColumnBetweenFiles('Solde Solde Fixing Base CCY', [
				'solde solde fixing base ccy',
				'solde fixing base ccy',
				'fixing base ccy'
			], recData, prdData, threshold, result)
		} catch (Exception e) {
			String message = 'Error while comparing REC and PRD exported files: ' + e.getMessage()

			addValidation(
					result,
					'Open and read REC/PRD Excel files',
					false,
					message
					)

			result.errors.add(message)
		} finally {
			try {
				if (recWorkbook != null) {
					recWorkbook.close()
				}
			} catch (Exception ignored) {
			}

			try {
				if (prdWorkbook != null) {
					prdWorkbook.close()
				}
			} catch (Exception ignored) {
			}
		}
	}

	private void compareNumberOfHeaders(SheetData recData, SheetData prdData, Map result) {
		boolean passed = recData.headers.size() == prdData.headers.size()

		String details =
				'REC headers: ' + recData.headers.size() + '\n' +
				'PRD headers: ' + prdData.headers.size()

		addValidation(result, 'Compare Number of Table headers', passed, details)

		if (!passed) {
			result.errors.add('Compare Number of Table headers failed. ' + details.replace('\n', ' | '))
		}
	}

	private void compareHeadersStructure(SheetData recData, SheetData prdData, Map result) {
		int maxHeaders = Math.max(recData.headers.size(), prdData.headers.size())
		List<String> mismatches = []

		for (int i = 0; i < maxHeaders; i++) {
			String recHeader = i < recData.headers.size() ? recData.headers[i] : ''
			String prdHeader = i < prdData.headers.size() ? prdData.headers[i] : ''

			if (normalizeText(recHeader) != normalizeText(prdHeader)) {
				mismatches.add(
						'Column ' + (i + 1) + ': REC "' + recHeader + '" | PRD "' + prdHeader + '"'
						)
			}
		}

		boolean passed = mismatches.isEmpty()

		String details = passed ?
				'All REC headers match PRD headers in the same order.' :
				'Mismatched headers: ' + mismatches.size() + '\n' + mismatches.join('\n')

		addValidation(result, 'Compare table headers structure', passed, details)

		if (!passed) {
			result.errors.add('Table headers structure mismatch.\n' + mismatches.join('\n'))
		}
	}

	private void compareNumberOfRows(SheetData recData, SheetData prdData, Map result) {
		boolean passed = recData.rows.size() == prdData.rows.size()

		String details =
				'REC rows: ' + recData.rows.size() + '\n' +
				'PRD rows: ' + prdData.rows.size()

		addValidation(result, 'Compare number of rows', passed, details)

		if (!passed) {
			result.errors.add('Compare number of rows failed. ' + details.replace('\n', ' | '))
		}
	}

	private void compareColumnBetweenFiles(
			String displayName,
			List<String> aliases,
			SheetData recData,
			SheetData prdData,
			int threshold,
			Map result
	) {
		Integer recColumnIndex = findColumnIndex(recData.headers, aliases)
		Integer prdColumnIndex = findColumnIndex(prdData.headers, aliases)

		if (recColumnIndex == null) {
			String message = displayName + ' column was not found in REC file.'

			addValidation(result, displayName + ' column comparison', false, message)
			result.errors.add(message)

			return
		}

		if (prdColumnIndex == null) {
			String message = displayName + ' column was not found in PRD file.'

			addValidation(result, displayName + ' column comparison', false, message)
			result.errors.add(message)

			return
		}

		int maxRows = Math.max(recData.rows.size(), prdData.rows.size())
		int mismatches = 0
		List<String> examples = []

		for (int rowIndex = 0; rowIndex < maxRows; rowIndex++) {
			String recValue = getCellValue(recData.rows, rowIndex, recColumnIndex)
			String prdValue = getCellValue(prdData.rows, rowIndex, prdColumnIndex)

			if (valuesAreEquivalent(recValue, prdValue, threshold)) {
				continue
			}

			mismatches++

			String diff =
					displayName + ' | Row ' + (rowIndex + 1) +
					' | REC: "' + recValue + '"' +
					' | PRD: "' + prdValue + '"' +
					' | Allowed difference: ' + threshold

			if (examples.size() < MAX_MISMATCHES_PER_COLUMN) {
				examples.add(diff)
				result.differences.add(diff)
			}
		}

		boolean passed = mismatches == 0

		String details =
				'REC column: ' + (recColumnIndex + 1) + '\n' +
				'PRD column: ' + (prdColumnIndex + 1) + '\n' +
				'Rows compared: ' + maxRows + '\n' +
				'Allowed numeric difference: ' + threshold + '\n' +
				'Differences found: ' + mismatches

		if (!passed && !examples.isEmpty()) {
			details += '\n\nFirst differences:\n' + examples.join('\n')
		}

		addValidation(result, displayName + ' column comparison', passed, details)

		if (!passed) {
			result.errors.add(displayName + ' column comparison failed. Differences found: ' + mismatches)
			result.errors.addAll(examples)
		}
	}

	private void addValidation(Map result, String name, boolean passed, String details) {
		result.validations.add([
			name   : name,
			status : passed ? 'PASS' : 'FAILED',
			details: details
		])
	}

	private void refreshResultCounters(Map result) {
		List<Map> validations = result.validations as List<Map>

		result.totalValidations = validations.size()
		result.passedValidations = validations.findAll { Map validation -> validation.status == 'PASS' }.size()
		result.failedValidations = validations.findAll { Map validation -> validation.status == 'FAILED' }.size()
	}

	private boolean valuesAreEquivalent(String recValue, String prdValue, int threshold) {
		String rec = recValue == null ? '' : recValue.trim()
		String prd = prdValue == null ? '' : prdValue.trim()

		if (rec.isEmpty() && prd.isEmpty()) {
			return true
		}

		BigDecimal recNumber = parseNumber(rec)
		BigDecimal prdNumber = parseNumber(prd)

		if (recNumber != null && prdNumber != null) {
			BigDecimal difference = recNumber.subtract(prdNumber).abs()
			return difference.compareTo(new BigDecimal(threshold)) <= 0
		}

		return normalizeText(rec) == normalizeText(prd)
	}

	private BigDecimal parseNumber(String value) {
		if (value == null || value.trim().isEmpty()) {
			return null
		}

		String normalized = value
				.replaceAll('\\s', '')
				.replace(',', '.')
				.replaceAll('[^0-9.\\-]', '')

		if (normalized.isEmpty() || normalized == '-' || normalized == '.') {
			return null
		}

		try {
			return new BigDecimal(normalized)
		} catch (Exception ignored) {
			return null
		}
	}

	private SheetData readSheetData(Sheet sheet, FormulaEvaluator evaluator, DataFormatter formatter) {
		int headerRowIndex = findHeaderRowIndex(sheet, evaluator, formatter)

		Row headerRow = sheet.getRow(headerRowIndex)
		List<String> headers = readRowValues(headerRow, evaluator, formatter)

		List<List<String>> rows = []

		for (int rowIndex = headerRowIndex + 1; rowIndex <= sheet.getLastRowNum(); rowIndex++) {
			Row row = sheet.getRow(rowIndex)

			if (row == null) {
				continue
			}

			List<String> values = readRowValues(row, evaluator, formatter)

			if (isEmptyRow(values)) {
				continue
			}

			rows.add(values)
		}

		return new SheetData(headers, rows)
	}

	private int findHeaderRowIndex(Sheet sheet, FormulaEvaluator evaluator, DataFormatter formatter) {
		int bestRowIndex = 0
		int bestFilledCells = 0
		int maxSearchRow = Math.min(sheet.getLastRowNum(), 30)

		for (int rowIndex = 0; rowIndex <= maxSearchRow; rowIndex++) {
			Row row = sheet.getRow(rowIndex)

			if (row == null) {
				continue
			}

			List<String> values = readRowValues(row, evaluator, formatter)
			int filledCells = values.findAll { String value -> value != null && !value.trim().isEmpty() }.size()

			if (filledCells > bestFilledCells) {
				bestFilledCells = filledCells
				bestRowIndex = rowIndex
			}
		}

		return bestRowIndex
	}

	private List<String> readRowValues(Row row, FormulaEvaluator evaluator, DataFormatter formatter) {
		List<String> values = []

		if (row == null) {
			return values
		}

		int lastCellNumber = row.getLastCellNum()

		if (lastCellNumber < 0) {
			return values
		}

		for (int cellIndex = 0; cellIndex < lastCellNumber; cellIndex++) {
			Cell cell = row.getCell(cellIndex)
			values.add(readCellValue(cell, evaluator, formatter))
		}

		return values
	}

	private String readCellValue(Cell cell, FormulaEvaluator evaluator, DataFormatter formatter) {
		if (cell == null) {
			return ''
		}

		try {
			if (cell.getCellType() == CellType.FORMULA) {
				return formatter.formatCellValue(cell, evaluator).trim()
			}

			return formatter.formatCellValue(cell).trim()
		} catch (Exception ignored) {
			return ''
		}
	}

	private boolean isEmptyRow(List<String> values) {
		if (values == null || values.isEmpty()) {
			return true
		}

		return values.every { String value -> value == null || value.trim().isEmpty() }
	}

	private String getCellValue(List<List<String>> rows, int rowIndex, int columnIndex) {
		if (rowIndex >= rows.size()) {
			return ''
		}

		List<String> row = rows[rowIndex]

		if (columnIndex >= row.size()) {
			return ''
		}

		return row[columnIndex]
	}

	private Integer findColumnIndex(List<String> headers, List<String> aliases) {
		for (int i = 0; i < headers.size(); i++) {
			String normalizedHeader = normalizeText(headers[i])

			for (String alias : aliases) {
				String normalizedAlias = normalizeText(alias)

				if (normalizedHeader == normalizedAlias || normalizedHeader.contains(normalizedAlias)) {
					return i
				}
			}
		}

		return null
	}

	private String normalizeText(String text) {
		if (text == null) {
			return ''
		}

		return Normalizer.normalize(text, Normalizer.Form.NFD)
				.replaceAll('\\p{InCombiningDiacriticalMarks}+', '')
				.toLowerCase()
				.trim()
				.replaceAll('[^a-z0-9]+', '_')
				.replaceAll('_+', '_')
				.replaceAll('^_|_$', '')
	}

	private String sanitizeFileName(String text) {
		if (text == null || text.trim().isEmpty()) {
			return 'Export'
		}

		String normalized = Normalizer.normalize(text, Normalizer.Form.NFD)
				.replaceAll('\\p{InCombiningDiacriticalMarks}+', '')

		return normalized
				.replaceAll('[\\\\/:*?"<>|]', '_')
				.replaceAll('\\s+', '_')
				.replaceAll('_+', '_')
				.replaceAll('^_|_$', '')
				.trim()
	}

	private static class SheetData {
		List<String> headers
		List<List<String>> rows

		SheetData(List<String> headers, List<List<String>> rows) {
			this.headers = headers
			this.rows = rows
		}
	}
}
