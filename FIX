    boolean AUTO_RESOLVE_EPIC_BY_NAME  = false
    String AUTO_EPIC_PREFIX            = 'Automated Tests - '
    String TEST_PLAN_SUFFIX            = ' Test Plan'

    String PRIMARY_XML_FILE_NAME       = 'JUnit_Report.xml'
    String SECONDARY_XML_FILE_NAME     = 'cucumber.xml'
    String RUNTIME_XML_FILE_NAME       = 'JUnit_Runtime.xml'
    String REPORT_FILE_NAME            = 'jiraReport.html'
