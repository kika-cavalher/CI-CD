package component

import java.awt.Robot
import java.awt.Toolkit
import java.awt.datatransfer.StringSelection
import java.awt.event.KeyEvent

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import commands.ImageLoader
import commands.WindowsObjectLoader


class RechercheKeywords {

	private static final Integer DEFAULT_TIMEOUT = 20
	private static final Integer POLLING_DELAY_SECONDS = 1

	private static final String RECHERCHE_IMAGE_GROUP =
		'General'

	private static final String RECHERCHE_OBJECT_GROUP =
		'filter'

	private static final String RECHERCHE_BUTTON_IMAGE_KEY =
		'rechercheTab'

	private static final String RECHERCHE_BUTTON_OBJECT_KEY =
		'rechercheButton'

	private static final String RECHERCHER_BUTTON_IMAGE_KEY =
		'rechercherButton'

	private static final String RECHERCHER_BUTTON_OBJECT_KEY =
		'rechercherButton'

	private final ImageLoader imageLoader =
	new ImageLoader()


	// ======================================================
	// APPLY RECHERCHE FILTER USING KEYBOARD NAVIGATION
	// ======================================================

	@Keyword
	Map applyRechercheFilterWithTabs(
			String imageGroup,
			String objectGroup,
			String rechercheButtonImageKey,
			String rechercheButtonObjectKey,
			String rechercherButtonImageKey,
			String rechercherButtonObjectKey,
			String filterValue,
			Integer tabsToInput,
			Integer timeoutSeconds
	) {

		Integer timeout =
				safeTimeout(timeoutSeconds)

		Integer tabCount =
				tabsToInput != null &&
				tabsToInput >= 0
				? tabsToInput
				: 2

		String value =
				safeText(filterValue)

		if (value.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Recherche filter value cannot be empty.'
					)

			return [:]
		}

		clickImageFirstThenObject(
				imageGroup,
				objectGroup,
				rechercheButtonImageKey,
				rechercheButtonObjectKey,
				'Recherche button',
				timeout
				)

		Windows.delay(
				POLLING_DELAY_SECONDS
				)

		focusInputWithTabsAndReplaceText(
				value,
				tabCount
				)

		Windows.delay(
				POLLING_DELAY_SECONDS
				)

		clickImageFirstThenObject(
				imageGroup,
				objectGroup,
				rechercherButtonImageKey,
				rechercherButtonObjectKey,
				'Rechercher button',
				timeout
				)

		Windows.delay(2)

		KeywordUtil.logInfo(
				'[PASS] Recherche filter applied successfully.\n' +
				'Value: ' +
				value +
				'\nTabs used to reach input: ' +
				tabCount
				)

		return [
			value      : value,
			tabsToInput: tabCount,
			objectGroup: objectGroup
		]
	}


	// ======================================================
	// APPLY MULTIPLE RECHERCHE FILTERS
	// ======================================================

	@Keyword
	Map applySequentialRechercheFiltersWithTabs(
			List<String> filterValues,
			Integer tabsToFirstInput,
			Integer tabsBetweenInputs,
			Integer timeoutSeconds
	) {

		Integer timeout =
				safeTimeout(timeoutSeconds)

		Integer firstInputTabs =
				tabsToFirstInput != null &&
				tabsToFirstInput >= 0
				? tabsToFirstInput
				: 2

		Integer betweenInputTabs =
				tabsBetweenInputs != null &&
				tabsBetweenInputs > 0
				? tabsBetweenInputs
				: 1

		List<String> values =
				filterValues == null
					? []
					: filterValues.collect {
						Object value ->
							safeText(value)
						}

		if (values.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Recherche filter values cannot be empty.'
					)

			return [:]
		}

		Integer emptyValueIndex =
				values.findIndexOf {
					String value ->
						value.isEmpty()
					}

		if (emptyValueIndex >= 0) {
			KeywordUtil.markFailedAndStop(
					'Recherche filter value cannot be empty.\n' +
					'Position: ' +
					(emptyValueIndex + 1)
					)

			return [:]
		}

		clickImageFirstThenObject(
				RECHERCHE_IMAGE_GROUP,
				RECHERCHE_OBJECT_GROUP,
				RECHERCHE_BUTTON_IMAGE_KEY,
				RECHERCHE_BUTTON_OBJECT_KEY,
				'Recherche button',
				timeout
				)

		Windows.delay(
				POLLING_DELAY_SECONDS
				)

		focusFirstInputAndFillSequence(
				values,
				firstInputTabs,
				betweenInputTabs
				)

		Windows.delay(
				POLLING_DELAY_SECONDS
				)

		clickImageFirstThenObject(
				RECHERCHE_IMAGE_GROUP,
				RECHERCHE_OBJECT_GROUP,
				RECHERCHER_BUTTON_IMAGE_KEY,
				RECHERCHER_BUTTON_OBJECT_KEY,
				'Rechercher button',
				timeout
				)

		Windows.delay(2)

		KeywordUtil.logInfo(
				'[PASS] Sequential Recherche filters applied successfully.\n' +
				'Values: ' +
				values +
				'\nTabs to first input: ' +
				firstInputTabs +
				'\nTabs between inputs: ' +
				betweenInputTabs
				)

		return [
			values           : values,
			filterCount      : values.size(),
			tabsToFirstInput : firstInputTabs,
			tabsBetweenInputs: betweenInputTabs
		]
	}


	// ======================================================
	// INTERNAL HELPERS
	// ======================================================

	private void focusFirstInputAndFillSequence(
			List<String> values,
			Integer tabsToFirstInput,
			Integer tabsBetweenInputs
	) {

		Robot robot =
				new Robot()

		pressTabs(
				robot,
				tabsToFirstInput
				)

		for (Integer index = 0;
				index < values.size();
				index++) {

			replaceFocusedText(
					robot,
					values.get(index)
					)

			if (index < values.size() - 1) {
				pressTabs(
						robot,
						tabsBetweenInputs
						)
			}
		}
	}


	private void focusInputWithTabsAndReplaceText(
			String value,
			Integer tabsToInput
	) {

		Robot robot =
				new Robot()

		pressTabs(
				robot,
				tabsToInput
				)

		replaceFocusedText(
				robot,
				value
				)
	}


	private void pressTabs(
			Robot robot,
			Integer tabCount
	) {

		for (Integer index = 0;
				index < tabCount;
				index++) {

			robot.keyPress(
					KeyEvent.VK_TAB
					)
			robot.keyRelease(
					KeyEvent.VK_TAB
					)

			Thread.sleep(200L)
		}
	}


	private void replaceFocusedText(
			Robot robot,
			String value
	) {

		robot.keyPress(
				KeyEvent.VK_CONTROL
				)
		robot.keyPress(
				KeyEvent.VK_A
				)
		robot.keyRelease(
				KeyEvent.VK_A
				)
		robot.keyRelease(
				KeyEvent.VK_CONTROL
				)

		robot.keyPress(
				KeyEvent.VK_BACK_SPACE
				)
		robot.keyRelease(
				KeyEvent.VK_BACK_SPACE
				)

		Toolkit
				.getDefaultToolkit()
				.getSystemClipboard()
				.setContents(
				new StringSelection(value),
				null
				)

		robot.keyPress(
				KeyEvent.VK_CONTROL
				)
		robot.keyPress(
				KeyEvent.VK_V
				)
		robot.keyRelease(
				KeyEvent.VK_V
				)
		robot.keyRelease(
				KeyEvent.VK_CONTROL
				)

		Thread.sleep(300L)
	}


	private void clickImageFirstThenObject(
			String imageGroup,
			String objectGroup,
			String imageKey,
			String objectKey,
			String description,
			Integer timeoutSeconds
	) {

		Integer timeout =
				safeTimeout(timeoutSeconds)

		Integer imageTimeout =
				Math.min(
				timeout,
				5
				)

		try {
			if (imageLoader.waitForImage(
					imageGroup,
					imageKey,
					imageTimeout
					)) {
				WindowsImageKeywords.clickImage(
						imageLoader.getImage(
						imageGroup,
						imageKey
						)
						)

				KeywordUtil.logInfo(
						'[IMAGE] ' +
						description +
						' clicked.'
						)

				return
			}
		} catch (Throwable imageError) {
			KeywordUtil.logInfo(
					'[IMAGE] Could not click ' +
					description +
					'. Trying Windows object.\n' +
					'Reason: ' +
					safeText(imageError.message)
					)
		}

		WindowsTestObject targetObject =
				WindowsObjectLoader.getObject(
				objectGroup,
				objectKey
				)

		if (!Windows.waitForElementPresent(
				targetObject,
				timeout,
				FailureHandling.OPTIONAL
				)) {
			KeywordUtil.markFailedAndStop(
					description +
					' was not found by image or Windows object.\n' +
					'Image group: ' +
					imageGroup +
					'\nImage key: ' +
					imageKey +
					'\nObject group: ' +
					objectGroup +
					'\nObject key: ' +
					objectKey
					)

			return
		}

		Windows.click(
				targetObject,
				FailureHandling.STOP_ON_FAILURE
				)

		KeywordUtil.logInfo(
				'[OBJECT] ' +
				description +
				' clicked.'
				)
	}


	private Integer safeTimeout(
			Integer timeoutSeconds
	) {

		return timeoutSeconds != null &&
				timeoutSeconds > 0
				? timeoutSeconds
				: DEFAULT_TIMEOUT
	}


	private String safeText(
			Object value
	) {

		return value == null
				? ''
				: value.toString().trim()
	}
}


































