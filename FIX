package jiraIntegration

import java.io.File
import java.net.URI
import java.text.SimpleDateFormat
import java.util.Date
import java.util.Locale

class JiraHtmlTemplateBuilder {

	private static final String APP_NAME = 'EMATCH'
	private static final String REPORT_TITLE_PREFIX = 'Test report - '
	private static final String LOGO_SRC = 'Images/General/logo.png'

	private static final String STATUS_PASS = '#68b84b'
	private static final String STATUS_FAIL = '#e05b4d'
	private static final String STATUS_SKIP = '#d7b436'
	private static final String STATUS_INFO = '#5b21b6'

	String build(Map model) {
		return buildHtml(model)
	}

	String render(Map model) {
		return buildHtml(model)
	}

	String buildHtml(Map model) {
		Map view = normalizeModel(model)
		StringBuilder html = new StringBuilder()

		html.append('<!DOCTYPE html>\n')
		html.append('<html lang="en">\n')
		html.append('<head>\n')
		html.append('<meta charset="UTF-8">\n')
		html.append('<meta name="viewport" content="width=device-width, initial-scale=1.0">\n')
		html.append('<title>').append(htmlEscape(view.reportTitle)).append('</title>\n')
		html.append(buildStyles())
		html.append('</head>\n')
		html.append('<body>\n')

		html.append('<header class="top-banner">\n')
		html.append('  <div class="top-banner-left">\n')
		html.append('    <img class="brand-logo" src="').append(htmlEscape(resolveLogoHref(view))).append('" alt="EMATCH logo">\n')
		html.append('    <div class="brand-copy">\n')
		html.append('      <div class="banner-title">').append(htmlEscape(view.reportTitle)).append('</div>\n')
		html.append('      <div class="banner-subtitle">EMATCH execution overview</div>\n')
		html.append('    </div>\n')
		html.append('  </div>\n')
		html.append('  <div class="top-banner-right">\n')
		html.append('    <div>').append(htmlEscape(view.generatedLabel)).append('</div>\n')
		html.append('    <div>Project ').append(htmlEscape(APP_NAME)).append('</div>\n')
		html.append('  </div>\n')
		html.append('</header>\n')

		html.append('<div class="page">\n')

		html.append('  <aside class="sidebar">\n')
		html.append('    <div class="sidebar-tabs">\n')
		html.append('      <button id="tab-tests" class="sidebar-tab active" type="button" onclick="showTab(\'tests\')">Tests</button>\n')
		html.append('      <button id="tab-charts" class="sidebar-tab" type="button" onclick="showTab(\'charts\')">Charts</button>\n')
		html.append('    </div>\n')

		html.append('    <div id="tests-sidebar-block">\n')
		html.append('      <div class="search-wrap">\n')
		html.append('        <input id="scenarioSearch" class="search-input" type="text" placeholder="Search test name, path, or status." onkeyup="filterScenarios()">\n')
		html.append('      </div>\n')
		html.append('      <div id="scenarioList" class="scenario-list">\n')

		if (view.scenarios.isEmpty()) {
			html.append('<div class="empty-state">No scenarios were found for this execution.</div>')
		} else {
			view.scenarios.eachWithIndex { Map scenario, int index ->
				html.append(buildScenarioListItem(scenario, index == 0))
			}
		}

		html.append('      </div>\n')
		html.append('    </div>\n')

		html.append('    <div id="charts-sidebar-block" class="hidden">\n')
		html.append(buildChartsSidebar(view))
		html.append('    </div>\n')

		html.append('  </aside>\n')

		html.append('  <main class="content">\n')

		if (view.scenarios.isEmpty()) {
			html.append('<section class="scenario-panel active"><div class="scenario-title">No execution data found</div></section>')
		} else {
			view.scenarios.eachWithIndex { Map scenario, int index ->
				html.append(buildScenarioPanel(scenario, view, index == 0))
			}
		}

		html.append(buildChartsPanel(view))
		html.append('  </main>\n')
		html.append('</div>\n')

		html.append(buildScripts())
		html.append('</body>\n')
		html.append('</html>\n')

		return html.toString()
	}

	private Map normalizeModel(Map model) {
		Map safeModel = model ?: [:]

		String suiteName = pickFirst(
			safeModel.suiteName,
			safeModel.executionName,
			safeModel.title,
			'Execution'
		)

		List<Map> scenarios = []
		asList(safeModel.scenarios).eachWithIndex { def rawItem, int index ->
			Map item = rawItem instanceof Map ? (rawItem as Map) : [:]

			String status = normalizeStatus(pickFirst(item.status, item.result, 'info'))
			List<Map> steps = normalizeSteps(item.steps)

			scenarios << [
				id            : pickFirst(item.id, "scenario-${index + 1}"),
				name          : pickFirst(item.name, item.scenarioName, item.title, "Scenario ${index + 1}"),
				status        : status,
				durationLabel : pickFirst(item.durationLabel, formatDurationLabel(item.durationMs), '00h 00m 00s'),
				startLabel    : pickFirst(item.startLabel, item.startLong, item.startShort, item.startTime, '--'),
				endLabel      : pickFirst(item.endLabel, item.endLong, item.endShort, item.endTime, '--'),
				visualError   : pickFirst(item.visualError, item.errorSummary, ''),
				fullError     : pickFirst(item.fullError, item.errorDetail, ''),
				steps         : steps,
				evidence      : normalizeEvidence(item.evidence, safeModel),
				summary       : pickFirst(item.visualError, item.errorSummary, '')
			]
		}

		int passedCount = scenarios.count { it.status == 'passed' }
		int failedCount = scenarios.count { it.status == 'failed' }
		int skippedCount = scenarios.count { it.status == 'blocked' }
		int totalCount = scenarios.size()

		return [
			reportTitle   : REPORT_TITLE_PREFIX + suiteName,
			suiteName     : suiteName,
			generatedLabel: buildGeneratedLabel(safeModel),
			reportFolder  : pickFirst(safeModel.reportFolder, safeModel.baseFolder, safeModel.executionFolder),
			logoSrc       : pickFirst(safeModel.logoSrc, LOGO_SRC),
			scenarios     : scenarios,
			passedCount   : passedCount,
			failedCount   : failedCount,
			skippedCount  : skippedCount,
			totalCount    : totalCount
		]
	}

	private List<Map> normalizeSteps(def rawSteps) {
		List<Map> result = []

		asList(rawSteps).each { def raw ->
			Map row = raw instanceof Map ? (raw as Map) : [detail: safeValue(raw)]

			String detail = pickFirst(row.detail, row.message, row.text, row.title, row.name)
			if (detail.isEmpty()) {
				return
			}

			String status = normalizeStatus(pickFirst(row.status, row.result, 'info'))
			String timestamp = pickFirst(row.timestamp, row.time, '')

			result << [
				status   : status,
				timestamp: timestamp,
				detail   : detail,
				icon     : pickFirst(row.icon, resolveStepIcon(detail, status))
			]
		}

		return result
	}

	private List<Map> normalizeEvidence(def rawEvidence, Map model) {
		List<Map> result = []

		asList(rawEvidence).each { def raw ->
			if (raw instanceof Map) {
				Map item = raw as Map
				result << [
					name  : pickFirst(item.name, item.fileName, 'Evidence'),
					href  : pickFirst(item.href, item.url, item.path, ''),
					image : Boolean.valueOf(String.valueOf(item.image)),
					imgSrc: pickFirst(item.imgSrc, item.imageSrc, item.href, item.url, '')
				]
			} else if (!safeValue(raw).isEmpty()) {
				String href = safeValue(raw)
				result << [
					name  : new File(href).name,
					href  : href,
					image : isImageFile(href),
					imgSrc: isImageFile(href) ? href : ''
				]
			}
		}

		return result
	}

	private String buildScenarioListItem(Map scenario, boolean selected) {
		String itemClass = selected ? 'scenario-list-item selected' : 'scenario-list-item'

		StringBuilder sb = new StringBuilder()
		sb.append('<button type="button" class="').append(itemClass).append('" data-sid="')
			.append(htmlEscape(scenario.id)).append('" onclick="showScenario(\'')
			.append(jsEscape(scenario.id)).append('\')">')

		sb.append('<div class="scenario-list-main">')
		sb.append('<div class="scenario-list-title">').append(htmlEscape(scenario.name)).append('</div>')
		sb.append('</div>')

		sb.append('<div class="scenario-list-side">')
		sb.append('<span class="status-pill ').append(htmlEscape(scenario.status)).append('">')
			.append(htmlEscape(statusLabel(scenario.status))).append('</span>')
		sb.append('<div class="scenario-list-duration">').append(htmlEscape(scenario.durationLabel)).append('</div>')
		sb.append('</div>')

		sb.append('</button>')
		return sb.toString()
	}

	private String buildScenarioPanel(Map scenario, Map view, boolean selected) {
		String panelClass = selected ? 'scenario-panel active' : 'scenario-panel'
		boolean failed = scenario.status == 'failed'
		List<Map> evidenceList = scenario.evidence instanceof List ? (scenario.evidence as List<Map>) : []

		StringBuilder sb = new StringBuilder()

		sb.append('<section class="').append(panelClass).append('" id="panel-')
			.append(htmlEscape(scenario.id)).append('">')

		sb.append('<div class="scenario-header">')
		sb.append('<div class="scenario-title">').append(htmlEscape(scenario.name)).append('</div>')
		sb.append('<div class="scenario-meta-row">')
		sb.append(buildMetaChip('Suite', view.suiteName, 'plain'))
		sb.append(buildMetaChip('Status', statusLabel(scenario.status), scenario.status))
		sb.append(buildMetaChip('Start', pickFirst(scenario.startLabel, '--'), 'gradient'))
		sb.append(buildMetaChip('End', pickFirst(scenario.endLabel, '--'), 'gradient'))
		sb.append(buildMetaChip('Duration', pickFirst(scenario.durationLabel, '00h 00m 00s'), 'gradient'))
		sb.append('</div>')
		sb.append('</div>')

		sb.append('<div class="section-title">Steps</div>')
		sb.append('<div class="steps-table">')
		sb.append('<div class="steps-head">')
		sb.append('<div class="col-status">STATUS</div>')
		sb.append('<div class="col-time">TIMESTAMP</div>')
		sb.append('<div class="col-detail">DETAILS</div>')
		sb.append('</div>')

		List<Map> steps = scenario.steps instanceof List ? (scenario.steps as List<Map>) : []

		if (steps.isEmpty()) {
			sb.append('<div class="step-row empty">')
			sb.append('<div class="col-status">—</div>')
			sb.append('<div class="col-time">—</div>')
			sb.append('<div class="col-detail">No step details available.</div>')
			sb.append('</div>')
		} else {
			steps.each { Map step ->
				sb.append(buildStepRow(step))
			}
		}

		sb.append('</div>')

		if (failed) {
			sb.append('<div class="error-block">')
			sb.append('<div class="error-title">Visual Error Log</div>')

			if (!safeValue(scenario.visualError).isEmpty()) {
				sb.append('<div class="error-summary">').append(htmlEscape(scenario.visualError)).append('</div>')
			}

			if (!safeValue(scenario.fullError).isEmpty()) {
				sb.append('<details class="details-box">')
				sb.append('<summary>🔎 View full error</summary>')
				sb.append('<pre>').append(htmlEscape(scenario.fullError)).append('</pre>')
				sb.append('</details>')
			}

			sb.append('</div>')

			sb.append('<div class="evidence-block">')
			sb.append('<div class="evidence-title">Evidence</div>')

			if (evidenceList.isEmpty()) {
				sb.append('<div class="evidence-empty">No evidence was found for this scenario.</div>')
			} else {
				evidenceList.each { Map evidence ->
					sb.append('<details class="evidence-item" open>')
					sb.append('<summary>🖼 ').append(htmlEscape(pickFirst(evidence.name, 'Open evidence'))).append('</summary>')

					if (!pickFirst(evidence.href, '').isEmpty()) {
						sb.append('<div class="evidence-links">')
						sb.append('<a href="').append(htmlEscape(evidence.href))
							.append('" target="_blank" rel="noopener noreferrer">🔎 Open evidence</a>')
						sb.append('</div>')
					}

					if (Boolean.TRUE.equals(evidence.image) && !pickFirst(evidence.imgSrc, '').isEmpty()) {
						sb.append('<img class="evidence-image" src="')
							.append(htmlEscape(evidence.imgSrc))
							.append('" alt="Evidence">')
					}

					sb.append('</details>')
				}
			}

			sb.append('</div>')
		}

		sb.append('</section>')
		return sb.toString()
	}

	private String buildStepRow(Map step) {
		StringBuilder sb = new StringBuilder()

		sb.append('<div class="step-row">')
		sb.append('<div class="col-status"><span class="status-pill ')
			.append(htmlEscape(step.status)).append('">')
			.append(htmlEscape(statusLabel(step.status))).append('</span></div>')

		sb.append('<div class="col-time">')
			.append(htmlEscape(pickFirst(step.timestamp, '--')))
			.append('</div>')

		sb.append('<div class="col-detail"><span class="step-icon">')
			.append(htmlEscape(pickFirst(step.icon, 'ℹ️')))
			.append('</span> ')
			.append(htmlEscape(pickFirst(step.detail, '')))
			.append('</div>')

		sb.append('</div>')
		return sb.toString()
	}

	private String buildMetaChip(String label, String value, String type) {
		StringBuilder sb = new StringBuilder()
		sb.append('<div class="meta-chip ').append(htmlEscape(type)).append('">')
		sb.append('<span class="meta-label">').append(htmlEscape(label)).append(':</span> ')
		sb.append('<span class="meta-value">').append(htmlEscape(value)).append('</span>')
		sb.append('</div>')
		return sb.toString()
	}

	private String buildChartsSidebar(Map view) {
		StringBuilder sb = new StringBuilder()

		sb.append('<div class="chart-side-wrap">')
		sb.append('<div class="chart-side-title">Execution Status</div>')
		sb.append('<div class="legend-list">')
		sb.append(buildLegendLine('Passed', STATUS_PASS, view.passedCount as int))
		sb.append(buildLegendLine('Failed', STATUS_FAIL, view.failedCount as int))
		sb.append(buildLegendLine('Blocked', STATUS_SKIP, view.skippedCount as int))
		sb.append('</div>')
		sb.append('</div>')

		return sb.toString()
	}

	private String buildChartsPanel(Map view) {
		double failPercent = percent(view.failedCount as int, view.totalCount as int)
		double passPercent = percent(view.passedCount as int, view.totalCount as int)
		double skipPercent = percent(view.skippedCount as int, view.totalCount as int)

		String donutStyle = 'background: conic-gradient(' +
			STATUS_FAIL + ' 0 ' + String.format(Locale.ENGLISH, '%.2f', failPercent) + '%,' +
			STATUS_PASS + ' ' + String.format(Locale.ENGLISH, '%.2f', failPercent) + '% ' +
			String.format(Locale.ENGLISH, '%.2f', failPercent + passPercent) + '%,' +
			STATUS_SKIP + ' ' + String.format(Locale.ENGLISH, '%.2f', failPercent + passPercent) + '% 100%);'

		StringBuilder sb = new StringBuilder()

		sb.append('<section id="charts-panel" class="charts-panel hidden">')
		sb.append('<div class="chart-main-title">Global Overview</div>')
		sb.append('<div class="charts-layout">')

		sb.append('<div>')
		sb.append('<div class="donut-card">')
		sb.append('<div class="donut" style="').append(donutStyle).append('">')
		sb.append('<div class="donut-center">')
		sb.append('<div class="donut-number">').append(String.valueOf(view.totalCount)).append('</div>')
		sb.append('<div class="donut-label">Tests</div>')
		sb.append('</div>')
		sb.append('</div>')
		sb.append('</div>')
		sb.append('</div>')

		sb.append('<div>')
		sb.append('<div class="chart-bars">')
		sb.append(buildBarRow('Passed', view.passedCount as int, view.totalCount as int, STATUS_PASS))
		sb.append(buildBarRow('Failed', view.failedCount as int, view.totalCount as int, STATUS_FAIL))
		sb.append(buildBarRow('Blocked', view.skippedCount as int, view.totalCount as int, STATUS_SKIP))
		sb.append('</div>')
		sb.append('</div>')

		sb.append('</div>')
		sb.append('</section>')

		return sb.toString()
	}

	private String buildLegendLine(String label, String color, int value) {
		StringBuilder sb = new StringBuilder()
		sb.append('<div class="legend-line">')
		sb.append('<span class="legend-dot" style="background:').append(color).append('"></span>')
		sb.append('<span class="legend-text">').append(htmlEscape(label)).append('</span>')
		sb.append('<span class="legend-value">').append(String.valueOf(value)).append('</span>')
		sb.append('</div>')
		return sb.toString()
	}

	private String buildBarRow(String label, int value, int total, String color) {
		double width = percent(value, total)

		StringBuilder sb = new StringBuilder()
		sb.append('<div class="bar-row">')
		sb.append('<div class="bar-row-top">')
		sb.append('<span class="bar-label">').append(htmlEscape(label)).append('</span>')
		sb.append('<span class="bar-value">').append(String.valueOf(value)).append('</span>')
		sb.append('</div>')
		sb.append('<div class="bar-track"><div class="bar-fill" style="width:')
			.append(String.format(Locale.ENGLISH, '%.2f', width))
			.append('%; background:').append(color).append('"></div></div>')
		sb.append('<div class="bar-foot">').append(String.valueOf(total == 0 ? 0 : Math.round(width))).append('% of execution</div>')
		sb.append('</div>')
		return sb.toString()
	}

	private String buildGeneratedLabel(Map model) {
		String raw = pickFirst(model.generatedAt, model.generatedLabel, model.createdAt, model.executionDate)
		if (!raw.isEmpty()) {
			return 'Generated ' + raw
		}
		return 'Generated ' + new SimpleDateFormat('dd/MM/yyyy HH:mm:ss').format(new Date())
	}

	private String resolveStepIcon(String detail, String status) {
		String lower = safeValue(detail).toLowerCase(Locale.ENGLISH)

		if (status == 'failed') {
			return '❌'
		}
		if (status == 'passed') {
			return '✅'
		}
		if (status == 'blocked') {
			return '⏭️'
		}
		if (lower.contains('open') || lower.contains('login') || lower.contains('screen') || lower.contains('page')) {
			return '🌐'
		}
		if (lower.contains('select') || lower.contains('click') || lower.contains('modal')) {
			return '🖱️'
		}
		if (lower.contains('verify') || lower.contains('validate')) {
			return '🔎'
		}
		if (lower.contains('save') || lower.contains('confirm')) {
			return '💾'
		}
		if (lower.contains('wait')) {
			return '⏳'
		}
		return 'ℹ️'
	}

	private String normalizeStatus(String raw) {
		String text = safeValue(raw).toLowerCase(Locale.ENGLISH)

		switch (text) {
			case 'pass':
			case 'passed':
			case 'success':
				return 'passed'
			case 'fail':
			case 'failed':
			case 'error':
				return 'failed'
			case 'skip':
			case 'skipped':
			case 'blocked':
				return 'blocked'
			default:
				return 'info'
		}
	}

	private String statusLabel(String status) {
		switch (safeValue(status)) {
			case 'passed':
				return 'Passed'
			case 'failed':
				return 'Failed'
			case 'blocked':
				return 'Blocked'
			default:
				return 'Info'
		}
	}

	private String resolveLogoHref(Map view) {
		File logoFile = resolveFile(pickFirst(view.logoSrc, LOGO_SRC), pickFirst(view.reportFolder))
		if (logoFile != null && logoFile.exists()) {
			return logoFile.toURI().toString()
		}
		return pickFirst(view.logoSrc, LOGO_SRC)
	}

	private File resolveFile(String path, String baseFolder) {
		String raw = safeValue(path)
		if (raw.isEmpty()) {
			return null
		}

		try {
			if (raw.toLowerCase(Locale.ENGLISH).startsWith('file:/')) {
				File uriFile = new File(new URI(raw))
				if (uriFile.exists()) {
					return uriFile
				}
			}
		} catch (Exception ignored) {
		}

		File direct = new File(raw)
		if (direct.exists()) {
			return direct
		}

		if (!safeValue(baseFolder).isEmpty()) {
			File byBase = new File(baseFolder, raw)
			if (byBase.exists()) {
				return byBase
			}
		}

		return direct
	}

	private boolean isImageFile(String fileName) {
		String lower = safeValue(fileName).toLowerCase(Locale.ENGLISH)
		return lower.endsWith('.png') ||
			lower.endsWith('.jpg') ||
			lower.endsWith('.jpeg') ||
			lower.endsWith('.gif') ||
			lower.endsWith('.webp') ||
			lower.endsWith('.bmp')
	}

	private List asList(def value) {
		if (value == null) {
			return []
		}
		if (value instanceof Collection) {
			return new ArrayList(value as Collection)
		}
		if (value.getClass().isArray()) {
			return (value as Object[]).toList()
		}
		return [value]
	}

	private double percent(int value, int total) {
		if (total <= 0) {
			return 0d
		}
		return ((double) value / (double) total) * 100d
	}

	private String formatDurationLabel(def durationMs) {
		try {
			long ms = Long.parseLong(String.valueOf(durationMs ?: '0'))
			long totalSeconds = Math.round(ms / 1000d)
			long hours = (long) (totalSeconds / 3600L)
			long minutes = (long) ((totalSeconds % 3600L) / 60L)
			long seconds = (long) (totalSeconds % 60L)
			return String.format(Locale.ENGLISH, '%02dh %02dm %02ds', hours, minutes, seconds)
		} catch (Throwable ignored) {
			return ''
		}
	}

	private String safeValue(def value) {
		return value == null ? '' : String.valueOf(value).trim()
	}

	private String pickFirst(Object... values) {
		if (values == null) {
			return ''
		}

		for (Object value : values) {
			String text = safeValue(value)
			if (!text.isEmpty()) {
				return text
			}
		}

		return ''
	}

	private String htmlEscape(def value) {
		String text = safeValue(value)
		return text
			.replace('&', '&amp;')
			.replace('<', '&lt;')
			.replace('>', '&gt;')
			.replace('"', '&quot;')
			.replace("'", '&#39;')
	}

	private String jsEscape(def value) {
		String text = safeValue(value)
		return text
			.replace('\\', '\\\\')
			.replace("'", "\\'")
			.replace('\r', '')
			.replace('\n', '\\n')
	}

