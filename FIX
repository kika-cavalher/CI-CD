import commands.DimensionsNavigator
import commands.ExportFile
import commands.ImageLoader
import commands.MenuNavigator

class ModuleDesResponsabiliteKeywords {

	private static final String MENU_NAME = 'cube balance des responsabilités'
	private static final String MENU_IMAGE_GROUP = 'ModuleDesResponsabilite'
	private static final String EXPECTED_TAB = 'BDR/BalanceDesResponsabilitesTab'
	private static final String EXPORT_LABEL = 'ExportExpandedTable'

	private ImageLoader imageLoader = new ImageLoader()
	private MenuNavigator menuNavigator = new MenuNavigator()
	private DimensionsNavigator dimensionsNavigator = new DimensionsNavigator()
	private ExportFile exportFile = new ExportFile()

	@Keyword
	String getMenuName() {
		return MENU_NAME
	}

	@Keyword
	String getExportLabel() {
		return EXPORT_LABEL
	}

	@Keyword
	String getDimensionsImageGroup() {
		return MENU_IMAGE_GROUP
	}

	@Keyword
	void openMenu(Integer timeoutSeconds) {
		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 60 : timeoutSeconds

		menuNavigator.searchAndOpenMenu(
				MENU_NAME,
				MENU_IMAGE_GROUP,
				EXPECTED_TAB,
				safeTimeout
				)
	}

	@Keyword
	void validateOpenedMenu(Integer timeoutSeconds) {
		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 60 : timeoutSeconds

		boolean tabPresent = false

		try {
			tabPresent = Windows.verifyElementPresent(
					findWindowsObject(EXPECTED_TAB),
					safeTimeout,
					FailureHandling.OPTIONAL
					)
		} catch (Exception ignored) {
		}

		if (!tabPresent && !imageLoader.waitForImage(MENU_IMAGE_GROUP, 'openedTab', 5)) {
			imageLoader.takeEvidence('OpenedMenuNotValidated.png')

			KeywordUtil.markFailedAndStop(
					'Opened menu was not validated.\n' +
					'Menu: ' + MENU_NAME + '\n' +
					'Expected tab object: ' + EXPECTED_TAB
					)
		}

		KeywordUtil.logInfo('Opened menu validated successfully: ' + MENU_NAME)
	}

	@Keyword
	void takeEvidence(String fileName) {
		imageLoader.takeEvidence(fileName)
	}

	@Keyword
	void validateDimensionsImagesExist(String imageGroup) {
		dimensionsNavigator.validateDimensionsImagesExist(imageGroup)
	}

	@Keyword
	void validateMeasuresOpen(String imageGroup, Integer timeoutSeconds) {
		dimensionsNavigator.validateMeasuresOpen(imageGroup, timeoutSeconds)
	}

	@Keyword
	void clickFirstDimension(String imageGroup) {
		dimensionsNavigator.clickFirstDimension(imageGroup)
	}

	@Keyword
	void openDimensionsUntilProvic(String imageGroup, Integer maxCycles) {
		dimensionsNavigator.openDimensionsUntilProvic(imageGroup, maxCycles)
	}

	@Keyword
	void validateProvicOpen(String imageGroup, Integer timeoutSeconds) {
		dimensionsNavigator.validateProvicOpen(imageGroup, timeoutSeconds)
	}

	@Keyword
	void validateLastDimension(String imageGroup, Integer timeoutSeconds) {
		dimensionsNavigator.validateLastDimension(imageGroup, timeoutSeconds)
	}

	@Keyword
	void scrollDimensionsToTop(String imageGroup) {
		dimensionsNavigator.scrollDimensionsToTop(imageGroup)
	}

	@Keyword
	void scrollDimensionsToTop(String imageGroup, Integer maxScrollMoves) {
		dimensionsNavigator.scrollDimensionsToTop(imageGroup, maxScrollMoves)
	}

	@Keyword
	void validateFirstPageReference(String imageGroup, Integer timeoutSeconds) {
		dimensionsNavigator.validateFirstPageReference(imageGroup, timeoutSeconds)
	}

	@Keyword
	void validateDimensionsCompleteFlow(String imageGroup, Integer maxCycles, Integer maxScrollMoves) {
		dimensionsNavigator.validateDimensionsCompleteFlow(imageGroup, maxCycles, maxScrollMoves)
	}

	@Keyword
	void prepareExpandedTableForExport(String imageGroup) {
		imageLoader.validateGroupImagesExist(imageGroup)

		KeywordUtil.logInfo('Step 1. Validate Phase image on current screen.')
		imageLoader.waitForImageOrStop(imageGroup, 'phase', 15)

		KeywordUtil.logInfo('Step 2. Click Measures and capture target position.')
		imageLoader.clickImageOrStop(imageGroup, 'firstDimension')
		Windows.delay(1)
		Point measuresPoint = getCurrentMouseLocation()

		KeywordUtil.logInfo(
				'Measures position captured.\n' +
				'X: ' + measuresPoint.x + '\n' +
				'Y: ' + measuresPoint.y
				)

		KeywordUtil.logInfo('Step 3. Click Phase.')
		imageLoader.clickImageOrStop(imageGroup, 'phase')
		Windows.delay(1)

		KeywordUtil.logInfo('Step 4. Press DOWN 3 times from Phase.')
		pressDownTimes(3)

		KeywordUtil.logInfo('Step 5. Validate moisDArrete becomes visible.')
		imageLoader.waitForImageOrStop(imageGroup, 'moisDArrete', 15)

		KeywordUtil.logInfo('Step 6. Click moisDArrete and capture source position.')
		imageLoader.clickImageOrStop(imageGroup, 'moisDArrete')
		Windows.delay(1)
		Point moisDArretePoint = getCurrentMouseLocation()

		KeywordUtil.logInfo(
				'Mois d arrete position captured.\n' +
				'X: ' + moisDArretePoint.x + '\n' +
				'Y: ' + moisDArretePoint.y
				)

		KeywordUtil.logInfo('Step 7. Drag moisDArrete to Measures.')
		dragAndDrop(moisDArretePoint.x, moisDArretePoint.y, measuresPoint.x, measuresPoint.y)
		Windows.delay(3)

		KeywordUtil.logInfo('Step 8. Scroll current page to the very end.')
		scrollCurrentPageToBottom(35)

		KeywordUtil.logInfo('Step 9. Validate updated last page image at page end.')
		imageLoader.waitForImageOrStop(imageGroup, 'updatedLastPageRef', 15)
	}

	@Keyword
	void exportExpandedTableWithoutOpeningFile(String exportLabel) {
		exportFile.exportFromOutilsToNo(exportLabel)
	}

	private void pressDownTimes(int count) {
		Robot robot = new Robot()
		robot.setAutoDelay(150)

		for (int i = 0; i < count; i++) {
			robot.keyPress(KeyEvent.VK_DOWN)
			robot.keyRelease(KeyEvent.VK_DOWN)
			sleepMs(500)
		}
	}

	private Point getCurrentMouseLocation() {
		return MouseInfo.getPointerInfo().getLocation()
	}

	private void dragAndDrop(int startX, int startY, int endX, int endY) {
		Robot robot = new Robot()
		robot.setAutoDelay(120)

		robot.mouseMove(startX, startY)
		sleepMs(700)

		robot.mousePress(InputEvent.BUTTON1_DOWN_MASK)
		sleepMs(700)

		int steps = 25

		for (int i = 1; i <= steps; i++) {
			int currentX = (int) Math.round(startX + ((endX - startX) * i / (double) steps))
			int currentY = (int) Math.round(startY + ((endY - startY) * i / (double) steps))

			robot.mouseMove(currentX, currentY)
			sleepMs(50)
		}

		robot.mouseRelease(InputEvent.BUTTON1_DOWN_MASK)
		Windows.delay(2)
	}

	private void scrollCurrentPageToBottom(int maxMoves) {
		moveMouseToMainPageScrollArea()
		sleepMs(700)

		for (int i = 0; i < maxMoves; i++) {
			scrollWheel(4)
			sleepMs(300)
		}
	}

	private void moveMouseToMainPageScrollArea() {
		Dimension screenSize = Toolkit.getDefaultToolkit().getScreenSize()

		int x = (int) Math.round(screenSize.width * 0.78)
		int y = (int) Math.round(screenSize.height * 0.72)

		moveMouse(x, y)
	}

	private void moveMouse(int x, int y) {
		Robot robot = new Robot()
		robot.setAutoDelay(100)
		robot.mouseMove(x, y)
	}

	private void scrollWheel(int amount) {
		Robot robot = new Robot()
		robot.setAutoDelay(100)
		robot.mouseWheel(amount)
	}

	private void sleepMs(long milliseconds) {
		try {
			Thread.sleep(milliseconds)
		} catch (InterruptedException ignored) {
			Thread.currentThread().interrupt()
		}
	}
}









package commands

import java.awt.Dimension
import java.awt.Robot
import java.awt.Toolkit
import java.awt.event.InputEvent
import java.awt.event.KeyEvent

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

class DimensionsNavigator {

	private static final int DEFAULT_TIMEOUT = 15
	private static final int DEFAULT_NAVIGATION_CYCLES = 65
	private static final int DEFAULT_SCROLL_MOVES = 100

	private static final double DIMENSIONS_PANEL_X_RATIO = 0.18
	private static final double DIMENSIONS_PANEL_Y_RATIO = 0.52

	private static final List<String> REQUIRED_IMAGE_KEYS = [
		'firstDimension',
		'lastDimension',
		'lastDimensionOpen',
		'firstPageRef',
		'lastPageRef'
	]

	private static final List<String> FOCUS_IMAGE_KEYS = [
		'firstPageRef',
		'firstDimension',
		'lastPageRef',
		'lastDimensionOpen',
		'lastDimension'
	]

	private ImageLoader imageLoader = new ImageLoader()

	@Keyword
	void validateDimensionsImagesExist(String imageGroup) {
		Map<String, String> images = imageLoader.getImages(imageGroup)
		List<String> missingKeys = []

		REQUIRED_IMAGE_KEYS.each { String key ->
			if (!images.containsKey(key)) {
				missingKeys.add(key)
			}
		}

		if (!missingKeys.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Dimensions image group is missing required keys.\n' +
					'Image group: ' + imageGroup + '\n' +
					'Missing keys: ' + missingKeys.join(', ')
					)
		}

		KeywordUtil.logInfo('All dimensions images exist for group: ' + imageGroup)
	}

	@Keyword
	void validateMeasuresOpen(String imageGroup, Integer timeoutSeconds) {
		waitForDimensionImageOrStop(imageGroup, 'firstDimension', timeoutSeconds)
	}

	@Keyword
	void clickFirstDimension(String imageGroup) {
		waitForDimensionImageOrStop(imageGroup, 'firstDimension', DEFAULT_TIMEOUT)

		imageLoader.clickImageOrStop(imageGroup, 'firstDimension')
		sleepMs(700)

		KeywordUtil.logInfo('First dimension clicked and dimensions tree focused.')
	}

	@Keyword
	void openDimensionsUntilProvic(String imageGroup, Integer maxCycles) {
		int safeCycles = maxCycles == null || maxCycles <= 0 ? DEFAULT_NAVIGATION_CYCLES : maxCycles

		validateDimensionsImagesExist(imageGroup)

		if (isImageVisibleWithSmallWait(imageGroup, 'lastDimensionOpen')) {
			KeywordUtil.logInfo('Provic open image is already visible before navigation.')
			return
		}

		focusDimensionsTree(imageGroup)

		boolean opened = navigateUntilProvicOpen(imageGroup, safeCycles)

		if (!opened) {
			imageLoader.takeEvidence('DimensionsProvicOpenNotFound.png')

			KeywordUtil.markFailedAndStop(
					'Could not open dimensions tree until Provic open image became visible.\n' +
					'Image group: ' + imageGroup + '\n' +
					'Expected image: lastDimensionOpen\n' +
					'Max cycles: ' + safeCycles
					)
		}
	}

	@Keyword
	void validateProvicOpen(String imageGroup, Integer timeoutSeconds) {
		waitForDimensionImageOrStop(imageGroup, 'lastDimensionOpen', timeoutSeconds)
	}

	@Keyword
	void validateLastDimension(String imageGroup, Integer timeoutSeconds) {
		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? DEFAULT_TIMEOUT : timeoutSeconds

		if (imageLoader.waitForImage(imageGroup, 'lastPageRef', safeTimeout)) {
			KeywordUtil.logInfo('Bottom dimensions image validated using lastPageRef.')
			return
		}

		if (imageLoader.waitForImage(imageGroup, 'lastDimensionOpen', 3)) {
			KeywordUtil.logInfo('Bottom dimensions image validated using lastDimensionOpen.')
			return
		}

		if (imageLoader.waitForImage(imageGroup, 'lastDimension', 3)) {
			KeywordUtil.logInfo('Bottom dimensions image validated using lastDimension.')
			return
		}

		imageLoader.takeEvidence('DimensionsBottomValidationFailed.png')

		KeywordUtil.markFailedAndStop(
				'Bottom dimensions image was not validated.\n' +
				'Image group: ' + imageGroup + '\n' +
				'Expected images: lastPageRef or lastDimensionOpen or lastDimension'
				)
	}

	@Keyword
	void scrollDimensionsToTop(String imageGroup) {
		scrollDimensionsToTop(imageGroup, DEFAULT_SCROLL_MOVES)
	}

	@Keyword
	void scrollDimensionsToTop(String imageGroup, Integer maxScrollMoves) {
		int safeScrollMoves = maxScrollMoves == null || maxScrollMoves <= 0 ? DEFAULT_SCROLL_MOVES : maxScrollMoves

		validateDimensionsImagesExist(imageGroup)

		if (isTopReferenceVisible(imageGroup)) {
			KeywordUtil.logInfo('Dimensions tree is already at the top.')
			return
		}

		KeywordUtil.logInfo('Starting stable scroll to top for dimensions tree.')

		focusDimensionsTree(imageGroup)

		if (tryKeyboardMoveToTop(imageGroup)) {
			KeywordUtil.logInfo('Top dimensions reference found using keyboard navigation.')
			return
		}

		if (tryMouseWheelMoveToTop(imageGroup, safeScrollMoves)) {
			KeywordUtil.logInfo('Top dimensions reference found using mouse wheel navigation.')
			return
		}

		if (tryMixedRecoveryMoveToTop(imageGroup, safeScrollMoves)) {
			KeywordUtil.logInfo('Top dimensions reference found using mixed recovery navigation.')
			return
		}

		imageLoader.takeEvidence('DimensionsFirstPageRefNotFound.png')

		KeywordUtil.markFailedAndStop(
				'Could not scroll to top dimensions reference.\n' +
				'Image group: ' + imageGroup + '\n' +
				'Expected image: firstPageRef\n' +
				'Max scroll moves: ' + safeScrollMoves
				)
	}

	@Keyword
	void validateFirstPageReference(String imageGroup, Integer timeoutSeconds) {
		waitForDimensionImageOrStop(imageGroup, 'firstPageRef', timeoutSeconds)
	}

	@Keyword
	void validateLastPageReference(String imageGroup, Integer timeoutSeconds) {
		waitForDimensionImageOrStop(imageGroup, 'lastPageRef', timeoutSeconds)
	}

	@Keyword
	void validateDimensionsCompleteFlow(String imageGroup, Integer maxCycles, Integer maxScrollMoves) {
		int safeCycles = maxCycles == null || maxCycles <= 0 ? DEFAULT_NAVIGATION_CYCLES : maxCycles
		int safeScrollMoves = maxScrollMoves == null || maxScrollMoves <= 0 ? DEFAULT_SCROLL_MOVES : maxScrollMoves

		validateDimensionsImagesExist(imageGroup)

		KeywordUtil.logInfo('Step 1. Validate Measures image.')
		validateMeasuresOpen(imageGroup, DEFAULT_TIMEOUT)

		KeywordUtil.logInfo('Step 2. Click Measures image to focus dimensions tree.')
		clickFirstDimension(imageGroup)

		KeywordUtil.logInfo('Step 3. Navigate until Provic open image becomes visible.')
		openDimensionsUntilProvic(imageGroup, safeCycles)

		KeywordUtil.logInfo('Step 4. Validate Provic open image.')
		validateProvicOpen(imageGroup, DEFAULT_TIMEOUT)

		KeywordUtil.logInfo('Step 5. Validate bottom dimensions image.')
		validateLastDimension(imageGroup, DEFAULT_TIMEOUT)

		KeywordUtil.logInfo('Step 6. Scroll dimensions tree to top.')
		scrollDimensionsToTop(imageGroup, safeScrollMoves)

		KeywordUtil.logInfo('Step 7. Validate top dimensions image.')
		validateFirstPageReference(imageGroup, DEFAULT_TIMEOUT)

		KeywordUtil.logInfo('Dimensions flow validated successfully.')
	}

	private void waitForDimensionImageOrStop(String imageGroup, String imageKey, Integer timeoutSeconds) {
		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? DEFAULT_TIMEOUT : timeoutSeconds
		imageLoader.waitForImageOrStop(imageGroup, imageKey, safeTimeout)
	}

	private boolean navigateUntilProvicOpen(String imageGroup, int maxCycles) {
		for (int cycle = 1; cycle <= maxCycles; cycle++) {
			boolean firstCycle = cycle == 1
			int rightMoves = firstCycle ? 3 : 1

			KeywordUtil.logInfo(
					'Dimensions navigation cycle ' + cycle + '/' + maxCycles + '. Sequence: ' +
					(firstCycle ? 'RIGHT, RIGHT, RIGHT, DOWN' : 'RIGHT, DOWN')
					)

			if (cycle == 1 || cycle % 8 == 0) {
				focusDimensionsTree(imageGroup)
			}

			for (int i = 0; i < rightMoves; i++) {
				pressKey(KeyEvent.VK_RIGHT)
				sleepMs(500)

				if (isImageVisibleWithSmallWait(imageGroup, 'lastDimensionOpen')) {
					KeywordUtil.logInfo('Provic open image became visible after RIGHT move.')
					return true
				}
			}

			pressKey(KeyEvent.VK_DOWN)
			sleepMs(500)

			if (isImageVisibleWithSmallWait(imageGroup, 'lastDimensionOpen')) {
				KeywordUtil.logInfo('Provic open image became visible after DOWN.')
				return true
			}
		}

		sleepMs(1000)
		return isImageVisibleWithSmallWait(imageGroup, 'lastDimensionOpen')
	}

	private boolean tryKeyboardMoveToTop(String imageGroup) {
		for (int attempt = 1; attempt <= 3; attempt++) {
			KeywordUtil.logInfo('Trying keyboard move to top. Attempt: ' + attempt + '/3')

			focusDimensionsTree(imageGroup)

			pressModifiedKey(KeyEvent.VK_CONTROL, KeyEvent.VK_HOME)
			sleepMs(1200)

			if (isTopReferenceVisible(imageGroup)) {
				return true
			}

			pressKey(KeyEvent.VK_HOME)
			sleepMs(1200)

			if (isTopReferenceVisible(imageGroup)) {
				return true
			}

			for (int i = 0; i < 8; i++) {
				pressKey(KeyEvent.VK_PAGE_UP)
				sleepMs(250)

				if (isTopReferenceVisible(imageGroup)) {
					return true
				}
			}
		}

		return false
	}

	private boolean tryMouseWheelMoveToTop(String imageGroup, int maxScrollMoves) {
		KeywordUtil.logInfo('Trying mouse wheel move to top. Max moves: ' + maxScrollMoves)

		focusDimensionsTree(imageGroup)
		moveMouseToDimensionsPanel()

		for (int i = 1; i <= maxScrollMoves; i++) {
			scrollWheel(-5)
			sleepMs(220)

			if (i % 5 == 0 && isTopReferenceVisible(imageGroup)) {
				KeywordUtil.logInfo('Top reference found after mouse wheel move: ' + i)
				return true
			}

			if (i % 15 == 0) {
				focusDimensionsTree(imageGroup)
				moveMouseToDimensionsPanel()
			}
		}

		return isTopReferenceVisible(imageGroup)
	}

	private boolean tryMixedRecoveryMoveToTop(String imageGroup, int maxScrollMoves) {
		KeywordUtil.logInfo('Trying mixed recovery move to top.')

		int blocks = Math.max(4, Math.ceil(maxScrollMoves / 20.0).intValue())

		for (int block = 1; block <= blocks; block++) {
			KeywordUtil.logInfo('Mixed recovery block: ' + block + '/' + blocks)

			focusDimensionsTree(imageGroup)

			pressModifiedKey(KeyEvent.VK_CONTROL, KeyEvent.VK_HOME)
			sleepMs(900)

			if (isTopReferenceVisible(imageGroup)) {
				return true
			}

			for (int i = 0; i < 10; i++) {
				pressKey(KeyEvent.VK_PAGE_UP)
				sleepMs(200)

				if (isTopReferenceVisible(imageGroup)) {
					return true
				}
			}

			moveMouseToDimensionsPanel()
			clickMouse()
			sleepMs(300)

			for (int i = 0; i < 15; i++) {
				scrollWheel(-6)
				sleepMs(180)

				if (i % 5 == 0 && isTopReferenceVisible(imageGroup)) {
					return true
				}
			}
		}

		return isTopReferenceVisible(imageGroup)
	}

	private void focusDimensionsTree(String imageGroup) {
		boolean clickedVisibleReference = clickAnyVisibleTreeReference(imageGroup)

		if (clickedVisibleReference) {
			sleepMs(500)
			return
		}

		moveMouseToDimensionsPanel()
		clickMouse()
		sleepMs(500)
	}

	private boolean clickAnyVisibleTreeReference(String imageGroup) {
		for (String imageKey : FOCUS_IMAGE_KEYS) {
			try {
				if (imageLoader.isVisible(imageGroup, imageKey)) {
					imageLoader.clickImageOrStop(imageGroup, imageKey)

					KeywordUtil.logInfo(
							'Dimensions tree focused using visible image.\n' +
							'Image group: ' + imageGroup + '\n' +
							'Image key: ' + imageKey
							)

					return true
				}
			} catch (Throwable ignored) {
			}
		}

		return false
	}

	private boolean isTopReferenceVisible(String imageGroup) {
		if (imageLoader.isVisible(imageGroup, 'firstPageRef')) {
			return true
		}

		return imageLoader.waitForImage(imageGroup, 'firstPageRef', 1)
	}

	private boolean isImageVisibleWithSmallWait(String imageGroup, String imageKey) {
		if (imageLoader.isVisible(imageGroup, imageKey)) {
			return true
		}

		return imageLoader.waitForImage(imageGroup, imageKey, 1)
	}

	private void moveMouseToDimensionsPanel() {
		Dimension screenSize = Toolkit.getDefaultToolkit().getScreenSize()

		int x = (int) Math.round(screenSize.width * DIMENSIONS_PANEL_X_RATIO)
		int y = (int) Math.round(screenSize.height * DIMENSIONS_PANEL_Y_RATIO)

		Robot robot = new Robot()
		robot.setAutoDelay(80)
		robot.mouseMove(x, y)

		KeywordUtil.logInfo(
				'Mouse moved to dimensions panel approximation.\n' +
				'X: ' + x + '\n' +
				'Y: ' + y
				)
	}

	private void clickMouse() {
		Robot robot = new Robot()
		robot.setAutoDelay(80)

		robot.mousePress(InputEvent.BUTTON1_DOWN_MASK)
		sleepMs(100)
		robot.mouseRelease(InputEvent.BUTTON1_DOWN_MASK)
	}

	private void scrollWheel(int amount) {
		Robot robot = new Robot()
		robot.setAutoDelay(80)
		robot.mouseWheel(amount)
	}

	private void pressKey(int keyCode) {
		Robot robot = new Robot()
		robot.setAutoDelay(120)

		robot.keyPress(keyCode)
		robot.keyRelease(keyCode)
	}

	private void pressModifiedKey(int modifierKeyCode, int keyCode) {
		Robot robot = new Robot()
		robot.setAutoDelay(120)

		robot.keyPress(modifierKeyCode)
		robot.keyPress(keyCode)
		robot.keyRelease(keyCode)
		robot.keyRelease(modifierKeyCode)
	}

	private void sleepMs(long milliseconds) {
		try {
			Thread.sleep(milliseconds)
		} catch (InterruptedException ignored) {
			Thread.currentThread().interrupt()
		}












