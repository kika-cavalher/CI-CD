	private boolean clickFirstVisibleImage(
			String groupName,
			List<String> imageKeys,
			Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds, 3)

		Map<String, String> availableImages = [:]

		for (String imageKey : imageKeys) {
			String imagePath =
					optionalImage(
					groupName,
					imageKey
					)

			if (!imagePath.isEmpty()) {
				availableImages.put(
						imageKey,
						imagePath
						)
			}
		}

		if (availableImages.isEmpty()) {
			KeywordUtil.logInfo(
					'[IMAGE] No valid image file was resolved.\n' +
					'Group: ' + groupName + '\n' +
					'Keys: ' + imageKeys
					)

			return false
		}

		long deadline =
				System.currentTimeMillis() +
				(timeout * 1000L)

		while (System.currentTimeMillis() < deadline) {
			for (Map.Entry<String, String> imageEntry : availableImages.entrySet()) {
				try {
					def found =
							WindowsImageKeywords.findImage(
							imageEntry.getValue()
							)

					if (found != null && found != false) {
						WindowsImageKeywords.clickImage(
								imageEntry.getValue()
								)

						KeywordUtil.logInfo(
								'[IMAGE] Clicked: ' +
								groupName +
								'.' +
								imageEntry.getKey()
								)

						return true
					}
				} catch (Throwable ignored) {
				}
			}

			Windows.delay(1)
		}

		return false
	}


