import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.windows.driver.WindowsDriverFactory
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows
import com.kms.katalon.core.windows.keyword.helper.WindowsActionHelper

String errors = ''

String menuName = 'cube balance des responsabilités'
String imageGroup = 'ModuleDesResponsabilite'
String menuImage = CustomKeywords.'general.ImageLoader.getImage'(imageGroup, 'menuImage')
String expectedTab = 'BDR/BalanceDesResponsabilitesTab'

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Search and open menu: ' + menuName)

CustomKeywords.'general.MenuNavigator.searchAndOpenMenu'(
	menuName,
	menuImage,
	expectedTab,
	60
)

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Validate opened menu screen: ' + menuName)

try {
	Windows.waitForElementPresent(findWindowsObject(expectedTab), 60)
} catch (Exception e) {
	CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
		'First validation failed for opened menu screen. Waiting 60 seconds and trying again. Reason: ' + e.getMessage()
	)

	Windows.delay(60)
	Windows.waitForElementPresent(findWindowsObject(expectedTab), 60)
}

CustomKeywords.'jiraIntegration.JiraReportSteps.note'('Take screenshot of opened menu screen: ' + menuName)

WindowsActionHelper
	.create(WindowsDriverFactory.getWindowsSession())
	.takeScreenshot(RunConfiguration.getReportFolder() + '\\Evidences\\' + 'OpenedScreen.PNG')





'ModuleDesResponsabilite': [
	'menuImage': 'Images/BDR/CubeBalanceDesResponsabilites.PNG'
]





