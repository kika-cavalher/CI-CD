package jiraIntegration

import java.util.Locale

class JiraHtmlTemplateBuilder {

	String build(Map model) {
		Map summary = model?.summary instanceof Map ? model.summary as Map : [:]
		List<Map> scenarios = model?.scenarios instanceof List ? model.scenarios as List<Map> : []

		StringBuilder html = new StringBuilder()

		html << '<!DOCTYPE html>'
		html << '<html lang="en">'
		html << '<head>'
		html << '<meta charset="UTF-8">'
		html << '<meta name="viewport" content="width=device-width, initial-scale=1.0">'
		html << '<title>' << escape(model?.reportTitle ?: 'Test report') << '</title>'
		html << buildStyle()
		html << '</head>'
		html << '<body>'

		html << '<div class="report-page">'
		html << buildHeader(model)
		html << buildReportBody(model, summary, scenarios)
		html << '</div>'

		html << buildScript()
		html << '</body>'
		html << '</html>'

		return html.toString()
	}

	private String buildHeader(Map model) {
		StringBuilder html = new StringBuilder()

		String logoSrc = safe(model?.logoSrc)
		String reportTitle = safe(model?.reportTitle ?: 'Test report')
		String subtitle = safe(model?.subtitle ?: 'Execution overview')
		String generatedAt = safe(model?.generatedAt)

		html << '<header class="report-hero">'
		html << '<div class="hero-left">'

		html << '<div class="project-logo-box">'
		if (!isBlank(logoSrc)) {
			html << '<img src="' << attr(logoSrc) << '" alt="Project logo" class="project-logo-img">'
		} else {
			html << '<div class="project-logo-text">Hue</div>'
		}
		html << '</div>'

		html << '<div class="hero-title-block">'
		html << '<div class="hero-kicker">'
		html << '<span class="hero-dot"></span>'
		html << '<span>Hue automation report</span>'
		html << '</div>'
		html << '<h1>' << escape(reportTitle) << '</h1>'
		html << '<p>' << escape(subtitle) << '</p>'
		html << '</div>'

		html << '</div>'

		if (!isBlank(generatedAt)) {
			html << '<div class="hero-generated">'
			html << '<span>Generated</span>'
			html << '<strong>' << escape(generatedAt) << '</strong>'
			html << '</div>'
		}

		html << '</header>'

		return html.toString()
	}

	private String buildReportBody(Map model, Map summary, List<Map> scenarios) {
		StringBuilder html = new StringBuilder()

		html << '<main class="report-body">'
		html << buildSidebar(model, scenarios)
		html << '<section class="report-content">'
		html << buildSummary(summary)
		html << buildScenarioDetails(model, scenarios)
		html << '</section>'
		html << '</main>'

		return html.toString()
	}

	private String buildSidebar(Map model, List<Map> scenarios) {
		StringBuilder html = new StringBuilder()

		html << '<aside class="left-panel">'

		html << '<div class="panel-tabs">'
		html << '<button type="button" class="tab-button active" data-tab-button="tests">Tests</button>'
		html << '<button type="button" class="tab-button" data-tab-button="charts">Charts</button>'
		html << '</div>'

		html << '<div class="tab-panel active" data-tab-panel="tests">'
		html << '<div class="search-box">'
		html << '<input type="text" id="scenarioSearch" placeholder="Search test name, path, or status...">'
		html << '</div>'

		html << '<div class="scenario-nav-list">'

		if (scenarios == null || scenarios.isEmpty()) {
			html << '<div class="empty-sidebar">No tests found</div>'
		} else {
			scenarios.eachWithIndex { Map scenario, int index ->
				html << buildSidebarItem(scenario, index + 1)
			}
		}

		html << '</div>'
		html << '</div>'

		html << '<div class="tab-panel" data-tab-panel="charts">'
		html << buildChartsPanel(model?.summary instanceof Map ? model.summary as Map : [:], scenarios)
		html << '</div>'

		html << '</aside>'

		return html.toString()
	}

	private String buildSidebarItem(Map scenario, int index) {
		StringBuilder html = new StringBuilder()

		String title = safe(scenario?.title)
		String status = normalizeStatus(scenario?.status)
		String duration = safe(scenario?.durationLabel)
		String searchValue = title + ' ' + status

		html << '<a class="scenario-nav-item ' << attr(status) << '" href="#scenario-' << index << '" data-search="' << attr(searchValue.toLowerCase(Locale.ENGLISH)) << '">'
		html << '<div class="scenario-nav-main">'
		html << '<strong>' << escape(title) << '</strong>'
		if (!isBlank(duration)) {
			html << '<span>' << escape(duration) << '</span>'
		}
		html << '</div>'
		html << '<em class="' << attr(status) << '">' << escape(status) << '</em>'
		html << '</a>'

		return html.toString()
	}

	private String buildChartsPanel(Map summary, List<Map> scenarios) {
		StringBuilder html = new StringBuilder()

		int total = toInt(summary?.total)
		int passed = toInt(summary?.passed)
		int failed = toInt(summary?.failed)
		int skipped = toInt(summary?.skipped)
		int info = toInt(summary?.info)

		if (total <= 0 && scenarios != null) {
			total = scenarios.size()
		}

		html << '<div class="charts-wrapper">'
		html << '<h3>Execution overview</h3>'
		html << '<p>Summary by result status.</p>'

		html << buildChartRow('Passed', passed, total, 'passed')
		html << buildChartRow('Failed', failed, total, 'failed')
		html << buildChartRow('Skipped', skipped, total, 'skipped')

		if (info > 0) {
			html << buildChartRow('Info', info, total, 'info')
		}

		html << '</div>'

		return html.toString()
	}

	private String buildChartRow(String label, int value, int total, String status) {
		StringBuilder html = new StringBuilder()

		int percent = total > 0 ? Math.round((value * 100f) / total) as int : 0

		html << '<div class="chart-row ' << attr(status) << '">'
		html << '<div class="chart-label">'
		html << '<span>' << escape(label) << '</span>'
		html << '<strong>' << value << '</strong>'
		html << '</div>'
		html << '<div class="chart-track">'
		html << '<div class="chart-fill ' << attr(status) << '" style="width:' << percent << '%"></div>'
		html << '</div>'
		html << '<small>' << percent << '%</small>'
		html << '</div>'

		return html.toString()
	}

	private String buildSummary(Map summary) {
		StringBuilder html = new StringBuilder()

		html << '<section class="summary-grid">'
		html << buildSummaryCard('Total tests', summary?.total, 'total')
		html << buildSummaryCard('Passed', summary?.passed, 'passed')
		html << buildSummaryCard('Failed', summary?.failed, 'failed')
		html << buildSummaryCard('Skipped', summary?.skipped, 'skipped')
		html << buildSummaryCard('Duration', summary?.durationLabel, 'duration')
		html << buildSummaryCard('Start', summary?.startLabel, 'date')
		html << buildSummaryCard('End', summary?.endLabel, 'date')
		html << '</section>'

		return html.toString()
	}

	private String buildSummaryCard(String label, def value, String type) {
		String displayValue = safe(value)

		if (isBlank(displayValue)) {
			displayValue = '0'
		}

		StringBuilder html = new StringBuilder()
		html << '<article class="summary-card ' << attr(type) << '">'
		html << '<span>' << escape(label) << '</span>'
		html << '<strong>' << escape(displayValue) << '</strong>'
		html << '</article>'

		return html.toString()
	}

	private String buildScenarioDetails(Map model, List<Map> scenarios) {
		StringBuilder html = new StringBuilder()

		html << '<section class="details-heading">'
		html << '<span>Execution details</span>'
		html << '<h2>Tests</h2>'
		html << '</section>'

		html << '<section class="scenario-details-list">'

		if (scenarios == null || scenarios.isEmpty()) {
			html << '<article class="empty-state">'
			html << '<h3>No scenarios were found</h3>'
			html << '<p>The report could not read scenarios from the execution log or XML result.</p>'
			html << '</article>'
		} else {
			scenarios.eachWithIndex { Map scenario, int index ->
				html << buildScenarioCard(model, scenario, index + 1)
			}
		}

		html << '</section>'

		return html.toString()
	}

	private String buildScenarioCard(Map model, Map scenario, int index) {
		StringBuilder html = new StringBuilder()

		String suiteName = safe(model?.suiteName)
		String status = normalizeStatus(scenario?.status)
		String title = safe(scenario?.title)
		String duration = safe(scenario?.durationLabel)
		String start = safe(scenario?.startLabel)
		String end = safe(scenario?.endLabel)
		String errorShort = safe(scenario?.errorShort)
		String errorFull = safe(scenario?.errorFull)

		List<Map> steps = scenario?.steps instanceof List ? scenario.steps as List<Map> : []
		List<Map> evidences = scenario?.evidences instanceof List ? scenario.evidences as List<Map> : []

		html << '<article id="scenario-' << index << '" class="scenario-card ' << attr(status) << '">'

		html << '<div class="scenario-card-header">'
		html << '<div>'
		html << '<div class="scenario-index">Scenario #' << index << '</div>'
		html << '<h3>' << escape(title) << '</h3>'
		html << '</div>'
		html << '<span class="scenario-status-badge ' << attr(status) << '">' << escape(statusIcon(status) + ' ' + status.toUpperCase(Locale.ENGLISH)) << '</span>'
		html << '</div>'

		html << '<div class="scenario-meta-pills">'
		html << buildMetaPill('Suite', suiteName, 'suite')
		html << buildMetaPill('Status', status.toUpperCase(Locale.ENGLISH), status)
		html << buildMetaPill('Start', start, 'date')
		html << buildMetaPill('End', end, 'date')
		html << buildMetaPill('Duration', duration, 'date')
		html << '</div>'

		if (!isBlank(errorShort)) {
			html << '<div class="error-summary">'
			html << '<strong>Error summary</strong>'
			html << '<p>' << escape(errorShort) << '</p>'
			html << '</div>'
		}

		if (!isBlank(errorFull)) {
			html << '<details class="details-box">'
			html << '<summary>Full error details</summary>'
			html << '<pre>' << escape(errorFull) << '</pre>'
			html << '</details>'
		}

		html << buildEvidenceBlock(evidences)
		html << buildStepsBlock(steps)

		html << '</article>'

		return html.toString()
	}

	private String buildMetaPill(String label, String value, String type) {
		if (isBlank(value)) {
			return ''
		}

		StringBuilder html = new StringBuilder()
		html << '<div class="meta-pill ' << attr(type) << '">'
		html << '<span>' << escape(label) << '</span>'
		html << '<strong>' << escape(value) << '</strong>'
		html << '</div>'

		return html.toString()
	}

	private String buildEvidenceBlock(List<Map> evidences) {
		if (evidences == null || evidences.isEmpty()) {
			return ''
		}

		StringBuilder html = new StringBuilder()

		html << '<div class="evidence-section">'
		html << '<h4>Visual evidence</h4>'
		html << '<div class="evidence-grid">'

		evidences.each { Map evidence ->
			html << buildEvidenceItem(evidence)
		}

		html << '</div>'
		html << '</div>'

		return html.toString()
	}

	private String buildEvidenceItem(Map evidence) {
		StringBuilder html = new StringBuilder()

		String name = safe(evidence?.name ?: evidence?.fileName ?: 'Evidence')
		String href = safe(evidence?.href)
		String imgSrc = safe(evidence?.imgSrc ?: evidence?.imageSrc ?: evidence?.imageDataUri)

		html << '<figure class="evidence-item">'

		if (!isBlank(href)) {
			html << '<a href="' << attr(href) << '" target="_blank">'
		}

		if (!isBlank(imgSrc)) {
			html << '<img src="' << attr(imgSrc) << '" alt="' << attr(name) << '">'
		} else {
			html << '<div class="evidence-placeholder">Image evidence</div>'
		}

		if (!isBlank(href)) {
			html << '</a>'
		}

		html << '<figcaption>' << escape(name) << '</figcaption>'
		html << '</figure>'

		return html.toString()
	}

	private String buildStepsBlock(List<Map> steps) {
		StringBuilder html = new StringBuilder()

		html << '<div class="steps-section">'
		html << '<h4>Steps</h4>'

		if (steps == null || steps.isEmpty()) {
			html << '<p class="muted">No step details were found.</p>'
		} else {
			html << '<div class="steps-table">'
			html << '<div class="steps-header">'
			html << '<span>Status</span>'
			html << '<span>Timestamp</span>'
			html << '<span>Details</span>'
			html << '</div>'

			steps.eachWithIndex { Map step, int index ->
				html << buildStepRow(step, index + 1)
			}

			html << '</div>'
		}

		html << '</div>'

		return html.toString()
	}

	private String buildStepRow(Map step, int index) {
		StringBuilder html = new StringBuilder()

		String status = normalizeStatus(step?.status)
		String title = safe(step?.title)
		String emoji = safe(step?.emoji)
		String time = safe(step?.timeLabel)
		String duration = safe(step?.durationLabel)
		String shortError = safe(step?.shortError)
		String detailText = safe(step?.detailText)
		String errorFull = safe(step?.errorFull)

		if (isBlank(emoji)) {
			emoji = '🔹'
		}

		html << '<div class="steps-row ' << attr(status) << '">'

		html << '<div class="step-status-column">'
		html << '<span class="step-status ' << attr(status) << '">' << escape(status) << '</span>'
		html << '</div>'

		html << '<div class="step-time-column">'
		html << '<strong>' << escape(time) << '</strong>'
		if (!isBlank(duration)) {
			html << '<small>' << escape(duration) << '</small>'
		}
		html << '</div>'

		html << '<div class="step-detail-column">'
		html << '<strong>' << escape(emoji) << ' ' << index << '. ' << escape(title) << '</strong>'

		if (!isBlank(shortError)) {
			html << '<p class="step-error">' << escape(shortError) << '</p>'
		}

		if (!isBlank(errorFull)) {
			html << '<details class="step-details">'
			html << '<summary>Error details</summary>'
			html << '<pre>' << escape(errorFull) << '</pre>'
			html << '</details>'
		} else if (!isBlank(detailText)) {
			html << '<details class="step-details">'
			html << '<summary>Step details</summary>'
			html << '<pre>' << escape(detailText) << '</pre>'
			html << '</details>'
		}

		html << '</div>'
		html << '</div>'

		return html.toString()
	}

	private String normalizeStatus(def value) {
		String status = safe(value).toLowerCase(Locale.ENGLISH)

		if (status == 'passed') return 'passed'
		if (status == 'failed') return 'failed'
		if (status == 'skipped') return 'skipped'
		if (status == 'info') return 'info'

		return 'skipped'
	}

	private String statusIcon(String status) {
		if (status == 'passed') return '✓'
		if (status == 'failed') return '✕'
		if (status == 'skipped') return '↷'
		if (status == 'info') return 'i'
		return 'i'
	}

	private int toInt(def value) {
		try {
			return Integer.parseInt(safe(value))
		} catch (Exception ignored) {
			return 0
		}
	}

	private String safe(def value) {
		return value == null ? '' : String.valueOf(value).trim()
	}

	private boolean isBlank(def value) {
		return safe(value).isEmpty()
	}

	private String escape(def value) {
		String text = safe(value)
		return text
				.replace('&', '&amp;')
				.replace('<', '&lt;')
				.replace('>', '&gt;')
				.replace('"', '&quot;')
				.replace("'", '&#39;')
	}

	private String attr(def value) {
		return escape(value)
	}

	private String buildScript() {
		return '''
<script>
	document.addEventListener('DOMContentLoaded', function () {
		var search = document.getElementById('scenarioSearch');
		var items = document.querySelectorAll('.scenario-nav-item');

		if (search) {
			search.addEventListener('input', function () {
				var value = search.value.toLowerCase().trim();

				items.forEach(function (item) {
					var content = item.getAttribute('data-search') || '';
					item.style.display = content.indexOf(value) >= 0 ? '' : 'none';
				});
			});
		}

		var buttons = document.querySelectorAll('[data-tab-button]');
		var panels = document.querySelectorAll('[data-tab-panel]');

		buttons.forEach(function (button) {
			button.addEventListener('click', function () {
				var target = button.getAttribute('data-tab-button');

				buttons.forEach(function (item) {
					item.classList.remove('active');
				});

				panels.forEach(function (panel) {
					panel.classList.remove('active');
				});

				button.classList.add('active');

				var panel = document.querySelector('[data-tab-panel="' + target + '"]');
				if (panel) {
					panel.classList.add('active');
				}
			});
		});
	});
</script>
'''
	}

