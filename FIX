			('token')    : JIRA_TOKEN
		]))

		int status = WS.getResponseStatusCode(response)
		String body = response.getResponseBodyContent()

		KeywordUtil.logInfo("Import Results status: ${status}")
		KeywordUtil.logInfo("Import Results response: ${body}")

		if (status == 200 || status == 204) {
			def parsed = new JsonSlurper().parseText(body)
			if (parsed?.testExecIssue?.key) {
				return parsed.testExecIssue.key.toString()
			}
		}

		return "ERROR${status}"
	}

	String findExistingTestPlanByName(String testPlanName) {
		if (FORCE_CREATE_NEW_TEST_PLAN) {
			return ''
		}

		def response = WS.sendRequest(findTestObject('Jira Integration/Get Test Plan', [
			('project') : PROJECT_KEY,
			('token')   : JIRA_TOKEN,
			('summary') : testPlanName.replace('[', '\\\\[').replace(']', '\\\\]'),
			('parent')  : EPIC_KEY
		]))

		int status = WS.getResponseStatusCode(response)
		String body = response.getResponseBodyContent()

		KeywordUtil.logInfo("Get Test Plan status: ${status}")
		KeywordUtil.logInfo("Get Test Plan response: ${body}")

		if (status != 200) {
			return ''
		}

		def parsed = new JsonSlurper().parseText(body)
		if ((parsed?.total ?: 0) > 0 && parsed?.issues?.size() > 0) {
			return parsed.issues[0].key.toString()
		}

		return ''
	}

	String createTestPlan(String testPlanName) {
		def response = WS.sendRequest(findTestObject('Jira Integration/Create Test Plan', [
			('token')   : JIRA_TOKEN,
			('project') : PROJECT_KEY,
			('summary') : testPlanName,
			('epic')    : EPIC_KEY
		]))

		int status = WS.getResponseStatusCode(response)
		String body = response.getResponseBodyContent()

		KeywordUtil.logInfo("Create Test Plan status: ${status}")
		KeywordUtil.logInfo("Create Test Plan response: ${body}")

		if (status == 200 || status == 201) {
			def parsed = new JsonSlurper().parseText(body)
			if (parsed?.key) {
				return parsed.key.toString()
			}
		}

		return "ERROR${status}"
	}

	String getOrCreateTestPlan() {
		String testPlanName = getTestPlanName()

		String existing = findExistingTestPlanByName(testPlanName)
		if (!isBlank(existing)) {
			return existing
		}

		return createTestPlan(testPlanName)
	}

	int updateTestPlan(String testPlanKey, List<String> executionKeys) {
		def jsonBody = JsonOutput.toJson([
			addTestsToPlan: true,
			add           : executionKeys
		])

		def response = WS.sendRequest(findTestObject('Jira Integration/Update Test Plan', [
			('token')       : JIRA_TOKEN,
			('testPlanKey') : testPlanKey,
			('jsonBody')    : jsonBody
		]))

		return WS.getResponseStatusCode(response)
	}

	int updateTestExecution(String executionKey) {
		def response = WS.sendRequest(findTestObject('Jira Integration/Update Test Execution Name', [
			('issueID') : executionKey,
			('token')   : JIRA_TOKEN,
			('summary') : getExecutionSummary(),
			('labels')  : LABELS,
			('env')     : ENVIRONMENT
		]))

		return WS.getResponseStatusCode(response)
	}

	int uploadAttachment(String issueKey, String filePath) {
		if (isBlank(filePath)) return 0

		File file = new File(filePath)
		if (!file.exists() || file.length() == 0) {
			KeywordUtil.logInfo("Skipping attachment upload because file path is empty or file does not exist: ${filePath}")
			return 0
		}

		def response = WS.sendRequest(findTestObject('Jira Integration/Evidence attachment', [
			('token')     : JIRA_TOKEN,
			('evidences') : file,
			('execID')    : issueKey
		]))

		int status = WS.getResponseStatusCode(response)
		KeywordUtil.logInfo("Upload attachment status: ${status}")
		KeywordUtil.logInfo("Upload attachment response: ${response.getResponseBodyContent()}")

		return status
	}

	int updateIssueStatus(String issueKey, String transitionId) {
		if (isBlank(transitionId)) {
			return 0
		}

		def response = WS.sendRequest(findTestObject('Jira Integration/Transition Issue Status', [
			('token')       : JIRA_TOKEN,
			('issueID')     : issueKey,
			('transitionID'): transitionId
		]))

		return WS.getResponseStatusCode(response)
	}

	// =========================================================
	// MAIN FLOW
	// =========================================================

	@Keyword
	def jiraImport() {
		logSection('Starting Jira import flow')

		String suiteName = getCurrentSuiteName()
		String executionSummary = getExecutionSummary()
		String testPlanName = getTestPlanName()

		KeywordUtil.logInfo("Using report folder: ${getResolvedReportPath()}")
		KeywordUtil.logInfo("Suite name used: ${suiteName}")
		KeywordUtil.logInfo("Execution title used: ${executionSummary}")
		KeywordUtil.logInfo("Test Plan title used: ${testPlanName}")

		String xmlFile = getXmlFilePath()
		if (isBlank(xmlFile)) {
			KeywordUtil.markFailed('No XML file found for Jira import.')
			return
		}

		String gaiaReportFile = buildGaiaReport()
		String resultsZip = zipReports()
		String evidencesZip = zipEvidences()

		String executionKey = importResults(xmlFile)
		if (isBlank(executionKey) || executionKey.startsWith('ERROR')) {
			KeywordUtil.markFailed("Test Execution creation failed: ${executionKey}")
			return
		}

		String testPlanKey = getOrCreateTestPlan()
		if (isBlank(testPlanKey) || testPlanKey.startsWith('ERROR')) {
			KeywordUtil.markFailed("Test Plan could not be created or resolved: ${testPlanKey}")
			return
		}

		int updateTestPlanStatus = updateTestPlan(testPlanKey, [executionKey])
		int updateExecutionStatus = updateTestExecution(executionKey)

		int gaiaReportAttachmentStatus = uploadAttachment(executionKey, gaiaReportFile)
		int resultsAttachmentStatus = uploadAttachment(executionKey, resultsZip)
		int evidencesAttachmentStatus = uploadAttachment(executionKey, evidencesZip)

		int transitionExecutionStatus = updateIssueStatus(executionKey, EXECUTION_TRANSITION_ID)
		int transitionTestPlanStatus = updateIssueStatus(testPlanKey, TEST_PLAN_TRANSITION_ID)

		logSection('Jira import finished')

		KeywordUtil.logInfo("Execution key: ${executionKey}")
		KeywordUtil.logInfo("Execution title used: ${executionSummary}")
		KeywordUtil.logInfo("Test Plan key: ${testPlanKey}")
		KeywordUtil.logInfo("Test Plan title used: ${testPlanName}")
		KeywordUtil.logInfo("Gaia report attachment status: ${gaiaReportAttachmentStatus}")
		KeywordUtil.logInfo("Results.zip attachment status: ${resultsAttachmentStatus}")
		KeywordUtil.logInfo("Evidences.zip attachment status: ${evidencesAttachmentStatus}")
		KeywordUtil.logInfo("Update Test Plan status: ${updateTestPlanStatus}")
		KeywordUtil.logInfo("Update Test Execution status: ${updateExecutionStatus}")
		KeywordUtil.logInfo("Transition Execution status: ${transitionExecutionStatus}")
		KeywordUtil.logInfo("Transition Test Plan status: ${transitionTestPlanStatus}")
	}
}
