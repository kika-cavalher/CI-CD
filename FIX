import com.kms.katalon.core.annotation.BeforeTestSuite
import com.kms.katalon.core.configuration.RunConfiguration

class DriverSetup {

  @BeforeTestSuite
  def setChromeDriverPath() {
    def projectDir = RunConfiguration.getProjectDir()
    def driverPath = projectDir + '/Drivers/chromedriver.exe'   // Windows
    // def driverPath = projectDir + '/Drivers/chromedriver'     // Mac/Linux

    System.setProperty('webdriver.chrome.driver', driverPath)
    println("ChromeDriver forced path: " + driverPath)
  }
}
