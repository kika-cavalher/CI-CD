	@Keyword
	void compareDownloadedFiles() {
		List<String> files = getDownloadedFiles()

		if (files.size() != 2) {
			KeywordUtil.markFailedAndStop(
				'Exactly two files are required for favorite comparison.\n' +
				'Files found: ' + files.size() + '\n' +
				'Content: ' + files
			)
		}

		File file1 = resolveDownloadedFile(files[0])
		File file2 = resolveDownloadedFile(files[1])

		if (!file1.exists() || !file2.exists()) {
			KeywordUtil.markFailedAndStop(
				'Files for favorite comparison were not found.\n' +
				'File 1: ' + file1.getAbsolutePath() +
				' | exists: ' + file1.exists() + '\n' +
				'File 2: ' + file2.getAbsolutePath() +
				' | exists: ' + file2.exists()
			)
		}

		String errors = safeText(
			excelValidations.compareSubFilesNoExceptions(
				file1.getAbsolutePath(),
				file2.getAbsolutePath(),
				''
			)
		)

		if (!errors.isEmpty()) {
			KeywordUtil.markFailedAndStop(
				'Favorite file comparison failed.\n' +
				'Files: ' + file1.getName() + ' and ' + file2.getName() + '\n' +
				errors
			)
		}

		KeywordUtil.markPassed(
			'Favorite file comparison completed successfully.\n' +
			'Files: ' + file1.getName() + ' and ' + file2.getName()
		)
	}

