def mirrorDashboardToRuntimeWorkspace(scriptRef) {
    def runtimePublish = "${scriptRef.env.WORKSPACE}\\${scriptRef.env.RUNTIME_PUBLISH_DIR}"
    def runtimeArchive = "${scriptRef.env.WORKSPACE}\\${scriptRef.env.RUNTIME_ARCHIVE_DIR}"

    scriptRef.powershell """
        \$publish = "${runtimePublish}"
        \$archive = "${runtimeArchive}"
        \$fixedReports = "${scriptRef.env.REPORTS_ROOT}"
        \$fixedDashboard = "${scriptRef.env.DASHBOARD_FIXED_DIR}"

        if (Test-Path \$publish) { Remove-Item \$publish -Recurse -Force -ErrorAction SilentlyContinue }
        if (Test-Path \$archive) { Remove-Item \$archive -Recurse -Force -ErrorAction SilentlyContinue }

        New-Item -ItemType Directory -Path \$publish | Out-Null
        New-Item -ItemType Directory -Path \$archive | Out-Null

        if (Test-Path \$fixedDashboard) {
            Copy-Item -Path (Join-Path \$fixedDashboard '*') -Destination \$publish -Recurse -Force
        }

        if (Test-Path \$fixedReports) {
            Copy-Item -Path (Join-Path \$fixedReports '*') -Destination \$archive -Recurse -Force
        }
    """
}

def saveSuiteSummary(scriptRef, String key, Map summary) {
    def current = loadSuiteResults(scriptRef)
    current[key] = summary
    writeFile file: scriptRef.env.RESULTS_JSON, text: JsonOutput.prettyPrint(JsonOutput.toJson(current))
}

def loadSuiteResults(scriptRef) {
    if (!scriptRef.fileExists(scriptRef.env.RESULTS_JSON)) {
        return [:]
    }
    def txt = scriptRef.readFile(file: scriptRef.env.RESULTS_JSON).trim()
    if (!txt) {
        return [:]
    }
    return new JsonSlurperClassic().parseText(txt) as Map
}

def findLatestSuiteArtifacts(scriptRef, String suiteLabel, long startedAt) {
    def encoded = suiteLabel.replace("'", "''")
    def json = scriptRef.powershell(
        returnStdout: true,
        script: """
            \$root = "${scriptRef.env.REPORTS_ROOT}"
            \$suite = '${encoded}'
            \$start = [DateTimeOffset]::FromUnixTimeMilliseconds(${startedAt}).DateTime

            if (!(Test-Path \$root)) {
                Write-Output '{}'
                exit 0
            }

            \$dirs = Get-ChildItem -Path \$root -Recurse -Directory -ErrorAction SilentlyContinue |
                    Where-Object {
                        \$_.FullName -like "*\\\\\$suite\\\\*" -and \$_.LastWriteTime -ge \$start.AddMinutes(-2)
                    } |
                    Sort-Object LastWriteTime -Descending

            \$baseDir = \$null
            \$reportFile = \$null
            \$junitFile = \$null

            foreach (\$dir in \$dirs) {
                \$reportCandidate = Get-ChildItem -Path \$dir.FullName -Recurse -File -Include *.html -ErrorAction SilentlyContinue |
                    Where-Object { \$_.Name -match '^(?i)(index|report|HarmonyReport).*\\.html$' } |
                    Select-Object -First 1

                \$junitCandidate = Get-ChildItem -Path \$dir.FullName -Recurse -File -Include 'JUnit_Report.xml','junit*.xml','JUnit*.xml','TEST-*.xml' -ErrorAction SilentlyContinue |
                    Select-Object -First 1

                if (\$reportCandidate -or \$junitCandidate) {
                    \$baseDir = \$dir.FullName
                    if (\$reportCandidate) { \$reportFile = \$reportCandidate.FullName }
                    if (\$junitCandidate) { \$junitFile = \$junitCandidate.FullName }
                    break
                }
            }

            \$obj = @{
                baseDir = if (\$baseDir) { \$baseDir } else { '' }
                report  = if (\$reportFile) { \$reportFile } else { '' }
                junit   = if (\$junitFile) { \$junitFile } else { '' }
            }

            \$obj | ConvertTo-Json -Compress
        """
    ).trim()

    def parsed = json ? new JsonSlurperClassic().parseText(json) : [:]

    def reportRelative = ''
    if (parsed.report) {
        reportRelative = makeRelativeForDashboard(parsed.report.toString())
    }

    return [
        baseDir : parsed.baseDir?.toString() ?: '',
        report  : reportRelative ?: '',
        junit   : parsed.junit?.toString() ?: ''
    ]
}

@NonCPS
def parseJUnitFromFile(String xmlText) {
    if (!xmlText?.trim()) {
        return defaultJUnitSummary()
    }

    def executed = countMatches(xmlText, '<testcase\\b')
    def failedByFailure = countMatches(xmlText, '<failure\\b')
    def failedByError = countMatches(xmlText, '<error\\b')
    def skipped = countMatches(xmlText, '<skipped\\b')
    def failed = failedByFailure + failedByError
    def passed = Math.max(0, executed - failed - skipped)

    return [
        executed: executed,
        passed  : passed,
        failed  : failed,
        skipped : skipped
    ]
}

@NonCPS
def defaultJUnitSummary() {
    return [executed: 0, passed: 0, failed: 0, skipped: 0]
}

@NonCPS
def countMatches(String text, String regex) {
    def matcher = Pattern.compile(regex).matcher(text)
    int count = 0
    while (matcher.find()) {
        count++
    }
    return count
}

@NonCPS
def extractShortReason(String logText, boolean timedOut) {
    if (timedOut) {
        return 'Execution timed out | Suite exceeded allowed time | Review timeout or slow steps'
    }

    if (!logText?.trim()) {
        return 'Execution failed | No detailed log message found | Open suite report for details'
    }

    def lines = logText
        .replace('\r', '\n')
        .split('\n')
        .collect { it.trim() }
        .findAll { it }

    def candidates = []
    lines.each { line ->
        def lower = line.toLowerCase()
        if (
            lower.contains('stepfailedexception') ||
            lower.contains('unable to recognize image') ||
            lower.contains('not found') ||
            lower.contains('invalidconsoleargumentexception') ||
            lower.contains('executionexception') ||
            lower.contains('error') ||
            lower.contains('exception') ||
            lower.contains('failed')
        ) {
            candidates << line
        }
    }

    def joined = candidates.take(3).join(' | ')
    return shortenReason(joined ?: lines.take(3).join(' | '))
}

@NonCPS
def shortenReason(String raw) {
    if (!raw) {
        return 'Execution failed | Open suite report for details'
    }

    def text = raw.replaceAll('\\s+', ' ').trim()

    if (text.toLowerCase().contains('timed out')) {
        return 'Execution timed out | Suite exceeded allowed time | Review timeout or slow steps'
    }
    if (text.toLowerCase().contains('not found')) {
        return 'Required item not found | A file, element, or object was missing | Review locators or test data'
    }
    if (text.toLowerCase().contains('unable to recognize image')) {
        return 'Visual validation failed | Expected image was not recognized | Review image baseline or screen state'
    }
    if (text.toLowerCase().contains('invalidconsoleargumentexception')) {
        return 'Invalid suite configuration | Test suite path was not accepted | Review suite path in Jenkins'
    }
    if (text.toLowerCase().contains('stepfailedexception')) {
        return 'Validation step failed | One mandatory verification did not pass | Open suite report for details'
    }
    if (text.toLowerCase().contains('files for the test not found')) {
        return 'Missing test files | Required input files were not found | Review test data and file paths'
    }

    def parts = text.split('\\|').collect { it.trim() }.findAll { it }
    return parts.take(3).join(' | ')
}

@NonCPS
def fitLine(String raw) {
    def s = raw ?: ''
    if (s.length() > 58) {
        s = s.substring(0, 57)
    }
    return s.padRight(60) + '║'
}

@NonCPS
def escapeHtml(String value) {
    if (value == null) {
        return ''
    }
    return value
        .replace('&', '&amp;')
        .replace('<', '&lt;')
        .replace('>', '&gt;')
        .replace('"', '&quot;')
        .replace("'", '&#39;')
}

@NonCPS
def makeRelativeForDashboard(String absoluteReportPath) {
    if (!absoluteReportPath) {
        return ''
    }

    def normalized = absoluteReportPath.replace('/', '\\')
    def idx = normalized.indexOf('\\Reports\\')
    if (idx < 0) {
        return ''
    }

    def rel = normalized.substring(idx + '\\Reports\\'.length()).replace('\\', '/')
    return "../${rel}"
}

def stopGaiaProcessesFast(scriptRef, String reason) {
    scriptRef.echo "🧹 Stopping Gaia processes | ${reason}"

    scriptRef.powershell """
        \$patterns = @(
            'gaia-start-back.bat',
            'gaia-start-front.bat',
            'gaia_web_portal_back',
            'gaia_web_portal',
            'spring-boot:run',
            'NODE_ENV=development',
            '--port 4200'
        )

        \$processes = Get-CimInstance Win32_Process -ErrorAction SilentlyContinue | Where-Object {
            \$cmd = (\$_.CommandLine | Out-String)
            if ([string]::IsNullOrWhiteSpace(\$cmd)) { return \$false }
            foreach (\$p in \$patterns) {
                if (\$cmd -like "*\$p*") { return \$true }
            }
            return \$false
        }

        foreach (\$proc in \$processes) {
            try {
                Stop-Process -Id \$proc.ProcessId -Force -ErrorAction SilentlyContinue
            } catch {}
        }

        try {
            schtasks /end /tn "${scriptRef.env.GAIA_START_TASK}" > \$null 2>&1
        } catch {}

        exit 0
    """
}
