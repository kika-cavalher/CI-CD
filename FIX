1. PL Économique com filtro e validação
import static com.kms.katalon.core.testcase.TestCaseFactory.findTestCase

import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows


// ======================================================
// EXPORT CONFIG
// ======================================================

String targetEnvironment = 'REC'
String exportLabel = 'EUR'
String filterValue = '228'

String loginTestCase =
	'Component/Authentication/Login ' + targetEnvironment

String closeApplicationTestCase =
	'Component/Authentication/Close Application'

String filterTestCase =
	'Feature/Contre-valorisation IHM/PLEconomique/FilterSection'

String menuName = 'PL Économique'
String menuResultName = 'PL Économique'

String scenarioName =
	targetEnvironment +
	' Cotre Parameters ' +
	exportLabel +
	' Filter Export'


// ======================================================
// VALIDATION CONFIG
// ======================================================

String requiredHeaders =
	'Devise|Devise de ref.|Montant ccy|Montant base ccy'

String currencyHeaders =
	'Devise|Devise de ref.'

String amountHeaders =
	'Montant ccy|Montant base ccy'


// ======================================================
// TIMEOUT CONFIG
// ======================================================

Integer menuTimeout = 60
Integer screenLoadDelay = 40


// ======================================================
// AUTHENTICATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Authenticate and open application\n' +
	'Environment: ' + targetEnvironment
)

WebUI.callTestCase(
	findTestCase(loginTestCase),
	[:],
	FailureHandling.STOP_ON_FAILURE
)


// ======================================================
// COTRE PARAMETERS
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Configure Cotre Parameters\n' +
	'Currency: ' + exportLabel
)

CustomKeywords.'pageObject.CotreParametersKeywords.configureCurrency'(
	exportLabel
)


// ======================================================
// MENU NAVIGATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Open PL Economique menu\n' +
	'Search: ' + menuName + '\n' +
	'Result: ' + menuResultName
)

CustomKeywords.'component.MenuNavigator.searchAndOpenExactMenuByText'(
	menuName,
	menuResultName,
	menuTimeout
)

Windows.delay(screenLoadDelay)


// ======================================================
// FILTER
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Apply Recherche filter\n' +
	'Filter test case: ' + filterTestCase + '\n' +
	'Filter value: ' + filterValue
)

CustomKeywords.'component.RechercheFilterKeywords.applyFilterTestCase'(
	filterTestCase,
	filterValue
)


// ======================================================
// EXPORT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Export PL Economique file\n' +
	'Export label: ' + exportLabel + '\n' +
	'Environment: ' + targetEnvironment
)

CustomKeywords.'commands.ExportFile.exportFromTwoExportImagesToNo'(
	exportLabel,
	targetEnvironment
)


// ======================================================
// CLOSE APPLICATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Close application\n' +
	'Environment: ' + targetEnvironment
)

WebUI.callTestCase(
	findTestCase(closeApplicationTestCase),
	[:],
	FailureHandling.STOP_ON_FAILURE
)


// ======================================================
// FILE VALIDATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
	'Validate exported file\n' +
	'Environment: ' + targetEnvironment + '\n' +
	'Export label: ' + exportLabel
)

WebUI.callTestCase(
	findTestCase('Component/Export Files/Export File Validation'),
	[
		('targetEnvironment') : targetEnvironment,
		('exportLabel')       : exportLabel,
		('requiredHeaders')   : requiredHeaders,
		('currencyHeaders')   : currencyHeaders,
		('amountHeaders')     : amountHeaders
	],
	FailureHandling.STOP_ON_FAILURE
)

KeywordUtil.markPassed(
	scenarioName + ' completed successfully.'
)
