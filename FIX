def startGaiaProcesses(script) {
    script.bat """
@echo off
echo ============================================================
echo 🚀 STARTING GAIA BACKEND AND FRONTEND
echo ============================================================

schtasks /query /tn "${script.env.START_TASK}" >nul 2>&1
if errorlevel 1 (
    echo ❌ Scheduled task not found: ${script.env.START_TASK}
    exit /b 1
)

schtasks /run /tn "${script.env.START_TASK}"
if errorlevel 1 (
    echo ❌ Failed to start scheduled task: ${script.env.START_TASK}
    exit /b 1
)

echo ✅ Scheduled task started: ${script.env.START_TASK}
echo ============================================================
"""

    def total = script.params.STARTUP_WAIT_SECONDS.toInteger()
    for (int i = total; i > 0; i--) {
        if (i == total || i % 10 == 0 || i <= 5) {
            script.echo "⏳ Waiting Gaia startup... ${i}s remaining"
        }
        script.sleep(time: 1, unit: 'SECONDS')
    }

    script.echo '✅ Gaia startup wait finished'
}

