	) {

		Integer timeout = 10

		String cleanFavoriteTitle =
				safeText(
				favoriteTitle
				)

		String cleanFavoriteImageKey =
				safeText(
				favoriteImageKey
				)

		if (cleanFavoriteTitle.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Favorite title is empty.'
					)

			return
		}

		if (cleanFavoriteImageKey.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Favorite image key is empty.\n' +
					'Favorite: ' + cleanFavoriteTitle
					)

			return
		}

		logStep(
				'DELETE FAVORITE',
				'Favorite: ' + cleanFavoriteTitle + '\n' +
				'Favorite image key: ' + cleanFavoriteImageKey + '\n' +
				'Timeout for each required action: 10 seconds'
				)

		String favoriteImagePath =
				optionalImage(
				GUI_IMAGE_GROUP,
				cleanFavoriteImageKey
				)

		String deleteFavoriteImagePath =
				optionalImage(
				GUI_IMAGE_GROUP,
				'deleteFavoriteBtn'
				)

		if (favoriteImagePath.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Favorite image file was not found in ImageLoader.\n' +
					'Favorite: ' + cleanFavoriteTitle + '\n' +
					'Image key: ' + cleanFavoriteImageKey
					)

			return
		}

		if (deleteFavoriteImagePath.isEmpty()) {
			KeywordUtil.markFailedAndStop(
					'Delete Favorite image file was not found in ImageLoader.\n' +
					'Image key: deleteFavoriteBtn'
					)

			return
		}

		KeywordUtil.logInfo(
				'Closing all opened tabs before deleting the favorite.'
				)

		closeAllTabs(
				timeout
				)

		KeywordUtil.logInfo(
				'Opening Favorites.'
				)

		clickRequiredObject(
				'favoritesTab',
				'Favorites tab',
				timeout,
				'GUI_FavoritesTabNotFoundForDelete.png'
				)

		Windows.delay(1)

		KeywordUtil.logInfo(
				'Searching for the favorite image and right-clicking it.\n' +
				'Favorite: ' + cleanFavoriteTitle + '\n' +
				'Timeout: 10 seconds'
				)

		boolean favoriteRightClicked =
				rightClickImageWithinTimeout(
				favoriteImagePath,
				timeout
				)

		if (!favoriteRightClicked) {
			takeEvidence(
					'GUI_FavoriteNotFoundForDelete.png'
					)

			KeywordUtil.markFailedAndStop(
					'Favorite image was not found for right click within 10 seconds.\n' +
					'Favorite: ' + cleanFavoriteTitle + '\n' +
					'Image key: ' + cleanFavoriteImageKey
					)

			return
		}

		KeywordUtil.logInfo(
				'Favorite context menu opened. Searching for Supprimer le favori.\n' +
				'Timeout: 10 seconds'
				)

		boolean deleteFavoriteClicked =
				clickFirstVisibleImage(
				GUI_IMAGE_GROUP,
				[
					'deleteFavoriteBtn'
				],
				timeout
				)

		if (!deleteFavoriteClicked) {
			takeEvidence(
					'GUI_DeleteFavoriteButtonNotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					'Supprimer le favori image was not found within 10 seconds.\n' +
					'Image key: deleteFavoriteBtn'
					)

			return
		}

		KeywordUtil.logInfo(
				'Supprimer le favori clicked. Waiting for the favorite image to disappear.\n' +
				'Timeout: 10 seconds'
				)

		boolean favoriteDeleted =
				waitForImageToDisappear(
				favoriteImagePath,
				timeout
				)

		takeEvidence(
				'GUI_FavoriteAfterDelete.png'
				)

		if (!favoriteDeleted) {
			KeywordUtil.markFailedAndStop(
					'Favorite is still displayed after 10 seconds.\n' +
					'Favorite: ' + cleanFavoriteTitle + '\n' +
					'Image key: ' + cleanFavoriteImageKey
					)

			return
		}

		KeywordUtil.markPassed(
				'Favorite deleted successfully.\n' +
				'Favorite: ' + cleanFavoriteTitle + '\n' +
				'Favorite image is no longer displayed.'
				)
	}


