    scriptRef.writeFile file: scriptRef.env.DASHBOARD_HTML, text: html
}

def updateBuildDescription(scriptRef) {
    def results = loadSuiteResults(scriptRef)

    def links = getTestSuites().collect { suite ->
        def r = results[suite.name]
        if (r?.html) {
            return "• <a href='artifact/Reports/${r.html}'>${suite.name}</a>"
        }
        return "• ${suite.name}"
    }.join('<br/>')

    scriptRef.currentBuild.description = """
📊 <a href='artifact/Reports/index.html'>Last Report</a><br/>
📁 Suite Reports<br/>
${links}
"""
}

def escapeHtml(String value) {
    if (value == null) {
        return ''
    }
    return value
        .replace('&', '&amp;')
        .replace('<', '&lt;')
        .replace('>', '&gt;')
        .replace('"', '&quot;')
        .replace("'", '&#39;')
}

def cleanupTimestampReportFolders(scriptRef) {
    scriptRef.powershell """
        \$reportsRoot = "${scriptRef.env.REPORTS_DIR}"

        if (-not (Test-Path \$reportsRoot)) {
            exit 0
        }

        Get-ChildItem -Path \$reportsRoot -Directory -ErrorAction SilentlyContinue |
            Where-Object { \$_.Name -match '^\\d{8}_\\d{6}\$' } |
            ForEach-Object {
                Remove-Item -Path \$_.FullName -Recurse -Force -ErrorAction SilentlyContinue
            }
    """
}

def stopGaiaProcesses(scriptRef, String reason) {
    scriptRef.echo "Stopping Gaia processes | ${reason}"

    scriptRef.bat """
        @echo off
        schtasks /end /tn "${scriptRef.env.GAIA_START_TASK}" >nul 2>&1

        taskkill /f /t /im katalonc.exe >nul 2>&1
        taskkill /f /t /im KatalonStudio.exe >nul 2>&1
        taskkill /f /t /im chromedriver.exe >nul 2>&1
        taskkill /f /t /im chrome.exe >nul 2>&1

        taskkill /f /t /im notepad.exe >nul 2>&1

        taskkill /f /fi "IMAGENAME eq cmd.exe" /fi "WINDOWTITLE eq GAIA_BACK_CMD*" >nul 2>&1
        taskkill /f /fi "IMAGENAME eq cmd.exe" /fi "WINDOWTITLE eq GAIA_FRONT_CMD*" >nul 2>&1

        exit /b 0
    """

    scriptRef.powershell """
        \$patterns = @(
            'gaia-web_portal_back',
            'spring-boot:run',
            'webportal_react',
            'cross-env NODE_ENV=development',
            'localhost:4200',
            'gaia-start-back.bat',
            'gaia-start-front.bat',
            'GAIA_BACK_CMD',
            'GAIA_FRONT_CMD'
        )

        \$procs = Get-CimInstance Win32_Process -ErrorAction SilentlyContinue | Where-Object {
            \$cmd = [string]\$_.CommandLine
            if ([string]::IsNullOrWhiteSpace(\$cmd)) { return \$false }
            foreach (\$p in \$patterns) {
                if (\$cmd -like "*\$p*") { return \$true }
            }
            return \$false
        }

        foreach (\$proc in \$procs) {
            try {
                Stop-Process -Id \$proc.ProcessId -Force -ErrorAction SilentlyContinue
            } catch {
            }
        }
    """
}
