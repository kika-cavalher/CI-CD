        }
    }

    @Keyword
    int resolveEnvironmentIndex(String envName) {
        String env = (envName ?: '').trim().toUpperCase()

        switch (env) {
            case 'PROD':
            case 'PRD':
                return 1
            case 'PREQ':
            case 'BENCH':
                return 2
            case 'QUAL':
            case 'QUALIFICATION':
                return 3
            case 'REC':
            case 'RECETTE':
                return 4
            case 'SIM':
            case 'SIMULATION':
                return 5
            case 'DEV':
            case 'DEVELOPMENT':
                return 6
            default:
                return 4
        }
    }

    @Keyword
    boolean selectEnvironment(String envName) {
        int envIndex = resolveEnvironmentIndex(envName)

        KeywordUtil.logInfo("Selecting environment ${envName} with index ${envIndex}")

        keyPress(KeyEvent.VK_HOME)
        Windows.delay(1)

        if (envIndex > 1) {
            keyPressMultiple(KeyEvent.VK_DOWN, envIndex - 1)
            Windows.delay(1)
        }

        keyPress(KeyEvent.VK_ENTER)
        Windows.delay(1)

        return true
    }

