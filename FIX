	private void validatePresent(
		String objectKey,
		String description,
		Integer timeout,
		List<String> errors
	) {

		logObjectSearch(
			objectKey,
			description
		)

		boolean present =
			Windows.waitForElementPresent(
				object(objectKey),
				timeout,
				FailureHandling.OPTIONAL
			)

		reportBooleanResult(
			present,
			description + ' was found.',
			description + ' was not found.',
			errors
		)
	}


	private void validateEnabledState(
		String objectKey,
		String description,
		boolean expectedEnabled,
		Integer timeout,
		List<String> errors
	) {

		logObjectSearch(
			objectKey,
			description +
			' | Expected enabled: ' +
			expectedEnabled
		)

		WindowsTestObject targetObject =
			object(objectKey)

		boolean present =
			Windows.waitForElementPresent(
				targetObject,
				timeout,
				FailureHandling.OPTIONAL
			)

		if (!present) {
			String message =
				description +
				' was not found.'

			errors.add(message)

			KeywordUtil.logInfo(
				'[FAIL] ' + message
			)

			return
		}

		String enabledAttribute =
			safeText(
				Windows.getAttribute(
					targetObject,
					'IsEnabled',
					FailureHandling.OPTIONAL
				)
			)

		boolean actualEnabled =
			enabledAttribute.equalsIgnoreCase('True')

		if (actualEnabled == expectedEnabled) {
			KeywordUtil.logInfo(
				'[PASS] ' +
				description +
				' enabled state is correct.\n' +
				'Expected: ' +
				expectedEnabled +
				'\nActual: ' +
				actualEnabled
			)
		} else {
			String message =
				description +
				' enabled state is incorrect.\n' +
				'Expected: ' +
				expectedEnabled +
				'\nActual: ' +
				actualEnabled

			errors.add(message)

			KeywordUtil.logInfo(
				'[FAIL] ' + message
			)
		}
	}


	private void clickImage(
		String groupName,
		String imageKey,
		Integer timeout
	) {

		KeywordUtil.logInfo(
			'[IMAGE] Searching and clicking\n' +
			'Group: ' + groupName + '\n' +
			'Key: ' + imageKey + '\n' +
			'Timeout: ' + timeout + ' seconds'
		)

		boolean found =
			imageLoader.waitForImage(
				groupName,
				imageKey,
				timeout
			)

		if (!found) {
			takeEvidence(
				'GUI_ImageNotFound_' +
					imageKey +
					'.png'
			)

			KeywordUtil.markFailedAndStop(
				'Image was not found.\n' +
				'Group: ' + groupName + '\n' +
				'Key: ' + imageKey + '\n' +
				'Path: ' +
				image(groupName, imageKey)
			)

			return
		}

		try {
			WindowsImageKeywords.clickImage(
				image(groupName, imageKey)
			)

			KeywordUtil.logInfo(
				'[PASS] Image clicked: ' +
				imageKey
			)
		} catch (Exception e) {
			takeEvidence(
				'GUI_ImageClickFailed_' +
					imageKey +
					'.png'
			)

			KeywordUtil.markFailedAndStop(
				'Image click failed.\n' +
				'Group: ' + groupName + '\n' +
				'Key: ' + imageKey + '\n' +
				'Reason: ' + safeMessage(e)
			)
		}
	}


	private void typeOnImage(
		String groupName,
		String imageKey,
		String value,
		Integer timeout
	) {

		KeywordUtil.logInfo(
			'[IMAGE] Searching input image\n' +
			'Group: ' + groupName + '\n' +
			'Key: ' + imageKey + '\n' +
			'Value: ' + value + '\n' +
			'Timeout: ' + timeout + ' seconds'
		)

		boolean found =
			imageLoader.waitForImage(
				groupName,
				imageKey,
				timeout
			)

		if (!found) {
			takeEvidence(
				'GUI_InputImageNotFound_' +
					imageKey +
					'.png'
			)

			KeywordUtil.markFailedAndStop(
				'Input image was not found.\n' +
				'Group: ' + groupName + '\n' +
				'Key: ' + imageKey
			)

			return
		}

		try {
			WindowsImageKeywords.typeOnImage(
				image(groupName, imageKey),
				value
			)

			KeywordUtil.logInfo(
				'[PASS] Value entered using image: ' +
				imageKey
			)
		} catch (Exception e) {
			takeEvidence(
				'GUI_TypeOnImageFailed_' +
					imageKey +
					'.png'
			)

			KeywordUtil.markFailedAndStop(
				'Could not enter value using image.\n' +
				'Image: ' + imageKey + '\n' +
				'Reason: ' + safeMessage(e)
			)
		}
	}


	private WindowsTestObject object(
		String objectKey
	) {

		return WindowsObjectLoader.getObject(
			GUI_OBJECT_GROUP,
			objectKey
		)
	}


	private String image(
		String groupName,
		String imageKey
	) {

		return imageLoader.getImage(
			groupName,
			imageKey
		)
	}


	private void takeEvidence(
		String fileName
	) {

		imageLoader.takeEvidence(
			fileName
		)
	}


	private void reportBooleanResult(
		boolean success,
		String successMessage,
		String failureMessage,
		List<String> errors
	) {

		if (success) {
			KeywordUtil.logInfo(
				'[PASS] ' + successMessage
			)

			return
		}

		errors.add(failureMessage)

		KeywordUtil.logInfo(
			'[FAIL] ' + failureMessage
		)
	}


	private void finishValidation(
		String validationName,
		List<String> errors
	) {

		if (!errors.isEmpty()) {
			KeywordUtil.markFailedAndStop(
				validationName +
					' failed.\n' +
					errors.collect {
						String error ->
							'- ' + error
					}.join('\n')
			)

			return
		}

		KeywordUtil.markPassed(
			validationName +
				' completed successfully.'
		)
	}


	private void logStep(
		String title,
		String details
	) {

		KeywordUtil.logInfo(
			'\n========================================\n' +
			'[START] ' + title + '\n' +
			details + '\n' +
			'========================================'
		)
	}


	private void logObjectSearch(
		String objectKey,
		String description
	) {

		KeywordUtil.logInfo(
			'[OBJECT] Searching\n' +
			'Group: ' + GUI_OBJECT_GROUP + '\n' +
			'Key: ' + objectKey + '\n' +
			'Validation: ' + description
		)
	}


	private Integer safeTimeout(
		Integer requestedTimeout,
		Integer defaultTimeout
	) {

		if (
			requestedTimeout == null ||
			requestedTimeout <= 0
		) {
			return defaultTimeout
		}

		return Math.min(
			requestedTimeout,
			5
		)
	}


	private String safeText(
		Object value
	) {

		return value == null
			? ''
			: value.toString().trim()
	}


	private String safeMessage(
		Exception exception
	) {

		String message =
			safeText(exception?.getMessage())

		return message.isEmpty()
			? exception?.getClass()?.getSimpleName()
			: message
	}
	
	private void pasteTextIntoFocusedField(
		String value
	) {
	
		StringSelection selection =
			new StringSelection(
				safeText(value)
			)
	
		Toolkit
			.getDefaultToolkit()
			.getSystemClipboard()
			.setContents(
				selection,
				null
			)
	
		Robot robot = new Robot()
		robot.setAutoDelay(80)
	
		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_CONTROL)
	
		robot.keyPress(KeyEvent.VK_BACK_SPACE)
		robot.keyRelease(KeyEvent.VK_BACK_SPACE)
	
		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_V)
		robot.keyRelease(KeyEvent.VK_V)
		robot.keyRelease(KeyEvent.VK_CONTROL)
	}
	
	
	private void pressKeyboardKey(
		Integer keyCode
	) {
	
		Robot robot = new Robot()
		robot.setAutoDelay(80)
	
		robot.keyPress(keyCode)
		robot.keyRelease(keyCode)
	}
}





