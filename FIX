
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.util.KeywordUtil

import java.awt.Rectangle
import java.awt.Robot
import java.awt.Toolkit
import java.awt.image.BufferedImage

import javax.imageio.ImageIO


String evidenceFolder = RunConfiguration.getReportFolder() + File.separator + 'Evidences'
new File(evidenceFolder).mkdirs()

String evidenceName = 'login_screen_' + System.currentTimeMillis() + '.png'
String evidencePath = evidenceFolder + File.separator + evidenceName

Robot robot = new Robot()
Rectangle screenRect = new Rectangle(Toolkit.getDefaultToolkit().getScreenSize())
BufferedImage image = robot.createScreenCapture(screenRect)
ImageIO.write(image, 'png', new File(evidencePath))

KeywordUtil.logInfo('[REPORT_SCREENSHOT] ' + evidencePath + '|Login screen')




KeywordUtil.logInfo('[REPORT_STEP] Opened login screen')
KeywordUtil.logInfo('[REPORT_STEP] Clicked confirm button')
KeywordUtil.logInfo('[REPORT_FAIL] Error message displayed')
KeywordUtil.logInfo('[REPORT_BLOCKED] Scenario did not continue because environment was unavailable')
