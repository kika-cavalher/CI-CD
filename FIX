class JiraReportBuilder {

    JiraFlowCoordinator owner
    JiraHtmlTemplateBuilder templateBuilder

    JiraReportBuilder(JiraFlowCoordinator owner) {
        this.owner = owner
        this.templateBuilder = new JiraHtmlTemplateBuilder()
    }

    String createHtmlReport(String reportFolder, String suiteName, String executionSummary) {
        if (blank(reportFolder)) {
            return ''
        }

        File reportDir = new File(reportFolder)
        if (!reportDir.exists() || !reportDir.isDirectory()) {
            return ''
        }

        String resolvedSuiteName = blank(suiteName) ? safe(reportDir.parentFile?.name) : safe(suiteName)
        List<Map> scenarios = parseExecutionLog(reportDir)

        if (scenarios.isEmpty()) {
            scenarios = buildFallbackScenarioList(resolvedSuiteName)
        }

        attachEvidence(reportDir, scenarios)

        Map model = [
            appName         : resolveAppName(),
            suiteName       : resolvedSuiteName,
            subtitle        : resolveSubtitle(),
            generatedAt     : new SimpleDateFormat('dd.MM.yyyy HH:mm:ss', Locale.ENGLISH).format(new Date()),
            reportFolder    : reportDir.absolutePath,
            logoSrc         : resolveLogoPath(reportDir),
            headerBackground: '#4C1D95',
            accentColor     : '#6D28D9',
            accentSoftColor : '#F3E8FF',
            infoColor       : '#7C3AED',
            scenarios       : scenarios
        ]

        String html = templateBuilder.build(model)

        File output = new File(reportDir, resolveOutputFileName())
        output.setText(html, 'UTF-8')
        return output.absolutePath
    }

    // =========================================================================
    // LOG PARSING
    // =========================================================================

    private List<Map> parseExecutionLog(File reportDir) {
        File logFile = findExecutionLog(reportDir)
        if (logFile == null || !logFile.exists() || !logFile.isFile()) {
            return []
        }

        List<String> lines = readLinesSafe(logFile)
        if (lines.isEmpty()) {
            return []
        }

        List<Map> scenarios = []
        Map currentScenario = null

        for (String rawLine : lines) {
            String originalLine = safe(rawLine)
            if (blank(originalLine)) {
                continue
            }

            String dateTimeLabel = extractDateTimeLabel(originalLine)
            String timeLabel = extractTimeLabel(originalLine)
            String message = stripLogPrefix(originalLine)

            if (blank(message)) {
                continue
            }

            String scenarioFromStart = extractScenarioFromStart(message)
            if (!blank(scenarioFromStart)) {
                if (currentScenario != null) {
                    finalizeScenario(currentScenario)
                    scenarios << sanitizeScenario(currentScenario)
                }

                currentScenario = newScenarioMap(scenarioFromStart)
                if (!blank(timeLabel)) {
                    currentScenario.startShort = timeLabel
                }
                if (!blank(dateTimeLabel)) {
                    currentScenario.startLong = dateTimeLabel
                }
                continue
            }

            Map compactScenario = parseCompactScenarioLine(message)
            if (compactScenario != null) {
                if (currentScenario != null) {
                    finalizeScenario(currentScenario)
                    scenarios << sanitizeScenario(currentScenario)
                }

                currentScenario = newScenarioMap(safe(compactScenario.name))
                currentScenario.durationMs = compactScenario.durationMs
                currentScenario.durationLabel = formatDuration(compactScenario.durationMs)
                if (!blank(timeLabel)) {
                    currentScenario.startShort = timeLabel
                    currentScenario.endShort = timeLabel
                }
                if (!blank(dateTimeLabel)) {
                    currentScenario.startLong = dateTimeLabel
                    currentScenario.endLong = dateTimeLabel
                }
                continue
            }

            if (currentScenario == null) {
                continue
            }

            if (message.toLowerCase(Locale.ENGLISH).startsWith('elapsed time:')) {
                String elapsedRaw = safe(message.substring('Elapsed time:'.length()))
                long elapsedMs = parseDurationToMillis(elapsedRaw)
                if (elapsedMs > 0L) {
                    currentScenario.durationMs = elapsedMs
                    currentScenario.durationLabel = formatDuration(elapsedMs)
                } else if (!blank(elapsedRaw)) {
                    currentScenario.durationLabel = elapsedRaw
                }

                if (!blank(timeLabel)) {
                    currentScenario.endShort = timeLabel
                }
                if (!blank(dateTimeLabel)) {
                    currentScenario.endLong = dateTimeLabel
                }
                continue
            }

            Map step = parseStepLine(message, timeLabel)
            if (step != null) {
                currentScenario.steps << step
                if (!blank(timeLabel)) {
                    currentScenario.endShort = timeLabel
                }
                if (!blank(dateTimeLabel)) {
                    currentScenario.endLong = dateTimeLabel
                }
                continue
            }

            if (looksLikeError(message)) {
                currentScenario.status = 'failed'
                currentScenario.errorLines << message

                if (blank(currentScenario.summary)) {
                    currentScenario.summary = shorten(message, 120)
                }

                if (!currentScenario.steps.isEmpty()) {
                    Map lastStep = currentScenario.steps.last()
                    lastStep.status = 'failed'
                } else {
                    currentScenario.steps << [
                        status   : 'failed',
                        timestamp: safe(timeLabel),
                        detail   : shorten(message, 240),
                        icon     : '❌'
                    ]
                }

                if (!blank(timeLabel)) {
                    currentScenario.endShort = timeLabel
                }
                if (!blank(dateTimeLabel)) {
                    currentScenario.endLong = dateTimeLabel
                }
                continue
            }

            if (shouldCaptureInfoLine(message)) {
                currentScenario.steps << [
                    status   : 'info',
                    timestamp: safe(timeLabel),
                    detail   : message,
                    icon     : resolveStepIcon(message, 'info')
                ]

                if (!blank(timeLabel)) {
                    currentScenario.endShort = timeLabel
                }
                if (!blank(dateTimeLabel)) {
                    currentScenario.endLong = dateTimeLabel
                }
            }
        }

        if (currentScenario != null) {
            finalizeScenario(currentScenario)
            scenarios << sanitizeScenario(currentScenario)
        }

        return scenarios
    }

    private Map newScenarioMap(String scenarioName) {
        return [
            id           : safe(scenarioName).replaceAll(/[^A-Za-z0-9]+/, '-').toLowerCase(Locale.ENGLISH),
            name         : safe(scenarioName),
            summary      : '',
            status       : 'info',
            startShort   : '',
            endShort     : '',
            startLong    : '',
            endLong      : '',
            durationMs   : 0L,
            durationLabel: '00h 00m 00s',
            visualError  : '',
            fullError    : '',
            steps        : [],
            evidence     : [],
            errorLines   : []
        ]
    }

    private void finalizeScenario(Map scenario) {
        List<Map> steps = scenario.steps instanceof List ? (scenario.steps as List<Map>) : []

        if (scenario.durationMs == null || ((long) scenario.durationMs) <= 0L) {
            long total = 0L
            steps.each { Map step ->
                if (step.containsKey('durationMs')) {
                    total += toLong(step.durationMs)
                }
            }
            if (total > 0L) {
                scenario.durationMs = total
            }
        }

        scenario.durationLabel = formatDuration(toLong(scenario.durationMs))

        boolean hasFailed = steps.any { Map step -> safe(step.status).equalsIgnoreCase('failed') }
        boolean hasPassed = steps.any { Map step -> safe(step.status).equalsIgnoreCase('passed') }
        boolean hasSkipped = steps.any { Map step -> safe(step.status).equalsIgnoreCase('skipped') }

        if (safe(scenario.status) == 'failed' || hasFailed) {
            scenario.status = 'failed'
        } else if (hasPassed) {
            scenario.status = 'passed'
        } else if (hasSkipped) {
            scenario.status = 'skipped'
        } else {
            scenario.status = 'info'
        }

        String fullError = ''
        if (scenario.errorLines instanceof List && !scenario.errorLines.isEmpty()) {
            fullError = (scenario.errorLines as List<String>).join('\n')
        }

        scenario.fullError = fullError
        scenario.visualError = !blank(fullError) ? extractVisualError(fullError) : safe(scenario.summary)

        if (blank(scenario.summary)) {
            if (scenario.status == 'failed' && !blank(scenario.visualError)) {
                scenario.summary = scenario.visualError
            } else if (!steps.isEmpty()) {
                scenario.summary = shorten(safe(steps.last().detail), 120)
            } else {
                scenario.summary = scenario.status.capitalize()
            }
        }
    }

    private Map sanitizeScenario(Map scenario) {
        List<Map> cleanSteps = []
        List<Map> sourceSteps = scenario.steps instanceof List ? (scenario.steps as List<Map>) : []

        sourceSteps.each { Map step ->
            cleanSteps << [
                status   : safe(step.status),
                timestamp: safe(step.timestamp),
                detail   : safe(step.detail),
                icon     : safe(step.icon)
            ]
        }

        return [
            id           : safe(scenario.id),
            name         : safe(scenario.name),
            summary      : safe(scenario.summary),
            status       : safe(scenario.status),
            startShort   : safe(scenario.startShort),
            endShort     : safe(scenario.endShort),
            startLong    : safe(scenario.startLong),
            endLong      : safe(scenario.endLong),
            durationLabel: safe(scenario.durationLabel),
            visualError  : safe(scenario.visualError),
            fullError    : safe(scenario.fullError),
            steps        : cleanSteps,
            evidence     : scenario.evidence instanceof List ? scenario.evidence : []
        ]
    }

    private String extractScenarioFromStart(String message) {
        def matcher = (safe(message) =~ /^(?:START|Start)\s+(Test Cases\/.+)$/)
        return matcher.find() ? safe(matcher.group(1)) : ''
    }

    private Map parseCompactScenarioLine(String message) {
        def matcher = (safe(message) =~ /^(Test Cases\/.+?)\s+\(([\d.,]+s)\)$/)
        if (!matcher.find()) {
            return null
        }

        return [
            name      : safe(matcher.group(1)),
            durationMs: parseDurationToMillis(matcher.group(2))
        ]
    }

    private Map parseStepLine(String message, String timeLabel) {
        def matcher = (safe(message) =~ /^(\d+)\s*-\s*(.+?)(?:\s+\(([\d.,]+s)\))?$/)
        if (!matcher.find()) {
            return null
        }

        String detail = safe(matcher.group(2))
        if (blank(detail)) {
            return null
        }

        String durationRaw = safe(matcher.group(3))
        long durationMs = parseDurationToMillis(durationRaw)
        String status = inferStepStatus(detail)

        return [
            status   : status,
            timestamp: safe(timeLabel),
            detail   : detail,
            icon     : resolveStepIcon(detail, status),
            durationMs: durationMs
        ]
    }

    private String inferStepStatus(String detail) {
        String lower = safe(detail).toLowerCase(Locale.ENGLISH)

        if (lower.contains('failed') || lower.contains('error')) {
            return 'failed'
        }
        if (lower.contains('skipped')) {
            return 'skipped'
        }
        if (lower.contains('passed')) {
            return 'passed'
        }

        return 'info'
    }

    private boolean looksLikeError(String message) {
        String lower = safe(message).toLowerCase(Locale.ENGLISH)

        if (lower.startsWith('reason:')) return true
        if (lower.startsWith('caused by:')) return true
        if (lower.contains('exception')) return true
        if (lower.contains('stepfailexception')) return true
        if (lower.contains('root cause')) return true
        if (lower.contains('unable to')) return true
        if (lower.contains('error:')) return true
        if (lower.startsWith('at ')) return true

        return false
    }

    private boolean shouldCaptureInfoLine(String message) {
        String lower = safe(message).toLowerCase(Locale.ENGLISH)

        if (lower.startsWith('starting jira import flow')) return true
        if (lower.startsWith('using report folder:')) return true
        if (lower.startsWith('suite name detected from report path:')) return true
        if (lower.startsWith('execution title used:')) return true
        if (lower.startsWith('test plan title used:')) return true
        if (lower.startsWith('new test plan created successfully:')) return true
        if (lower.startsWith('execution key:')) return true
        if (lower.startsWith('test plan key:')) return true

        return false
    }

    private String extractVisualError(String value) {
        List<String> lines = safe(value).readLines().collect { safe(it) }.findAll { !blank(it) }
        if (lines.isEmpty()) {
            return ''
        }

        String preferred = lines.find { String line ->
            String lower = line.toLowerCase(Locale.ENGLISH)
            return lower.contains('exception') ||
                   lower.contains('unable to') ||
                   lower.contains('error') ||
                   lower.contains('root cause') ||
                   lower.contains('stepfailexception')
        }

        return shorten(safe(preferred ?: lines.first()), 160)
    }

    // =========================================================================
    // EVIDENCE
    // =========================================================================

    private void attachEvidence(File reportDir, List<Map> scenarios) {
        List<File> images = collectFailureImages(reportDir)
        if (images.isEmpty()) {
            return
        }

        List<Map> failedScenarios = scenarios.findAll { Map scenario ->
            safe(scenario.status).equalsIgnoreCase('failed')
        }

        for (int i = 0; i < failedScenarios.size(); i++) {
            if (i >= images.size()) {
                break
            }

            File img = images[i]
            String dataUri = toDataUri(img)
            if (blank(dataUri)) {
                continue
            }

            failedScenarios[i].evidence = [[
                name  : img.name,
                href  : '',
                image : true,
                imgSrc: dataUri
            ]]
        }
    }

    private List<File> collectFailureImages(File reportDir) {
        Set<String> seen = new LinkedHashSet<String>()
        List<File> images = new ArrayList<File>()

        collectImagesRecursively(reportDir, images, seen)

        File nativeHtml = findNativeKatalonHtml(reportDir)
        if (nativeHtml != null) {
            List<File> referenced = collectImagesFromHtml(nativeHtml)
            referenced.each { File file ->
                if (file != null && file.exists()) {
                    String key = canonical(file)
                    if (!seen.contains(key)) {
                        seen.add(key)
                        images << file
                    }
                }
            }
        }

        images.sort { File a, File b -> a.lastModified() <=> b.lastModified() }
        return images
    }

    private void collectImagesRecursively(File current, List<File> images, Set<String> seen) {
        if (current == null || !current.exists()) {
            return
        }

        if (current.isFile()) {
            if (isImageFile(current.name) && !shouldSkipImage(current)) {
                String key = canonical(current)
                if (!seen.contains(key)) {
                    seen.add(key)
                    images << current
                }
            }
            return
        }

        File[] children = current.listFiles()
        if (children == null) {
            return
        }

        for (File child : children) {
            collectImagesRecursively(child, images, seen)
        }
    }

    private boolean shouldSkipImage(File file) {
        String lowerPath = safe(file.absolutePath).toLowerCase(Locale.ENGLISH)
        String lowerName = safe(file.name).toLowerCase(Locale.ENGLISH)

        if (lowerPath.contains(File.separator.toLowerCase() + 'videos' + File.separator.toLowerCase())) return true
        if (lowerPath.contains(File.separator.toLowerCase() + 'requests' + File.separator.toLowerCase())) return true
        if (lowerName.contains('logo')) return true
        if (lowerName.endsWith('.svg')) return true

        return false
    }

    private File findNativeKatalonHtml(File reportDir) {
        File[] htmlFiles = reportDir.listFiles(new FilenameFilter() {
            @Override
            boolean accept(File dir, String name) {
                return safe(name).toLowerCase(Locale.ENGLISH).endsWith('.html')
            }
        })

        if (htmlFiles == null || htmlFiles.length == 0) {
            return null
        }

        List<File> candidates = htmlFiles.findAll { File file ->
            String lower = safe(file.name).toLowerCase(Locale.ENGLISH)
            return lower != safe(resolveOutputFileName()).toLowerCase(Locale.ENGLISH)
        }

        if (candidates.isEmpty()) {
            return null
        }

        candidates.sort { File a, File b -> b.lastModified() <=> a.lastModified() }
        return candidates[0]
    }

    private List<File> collectImagesFromHtml(File htmlFile) {
        List<File> files = []
        if (htmlFile == null || !htmlFile.exists()) {
            return files
        }

        String html = readTextSafe(htmlFile)
        if (blank(html)) {
            return files
        }

        def matcher = (html =~ /(?i)(?:src|href)\s*=\s*["']([^"']+\.(png|jpg|jpeg|gif|bmp|webp))["']/)
        while (matcher.find()) {
            String path = safe(matcher.group(1))
            if (blank(path)) {
                continue
            }

            File candidate = resolveFileFromHtml(htmlFile.parentFile, path)
            if (candidate != null && candidate.exists() && candidate.isFile()) {
                files << candidate
            }
        }

        return files
    }

    private File resolveFileFromHtml(File baseDir, String rawPath) {
        String path = safe(rawPath)
        if (blank(path)) {
            return null
        }

        try {
            if (path.startsWith('file:/')) {
                return new File(new URI(path))
            }
        } catch (Exception ignored) {
        }

        File direct = new File(path)
        if (direct.exists()) {
            return direct
        }

        File byBase = new File(baseDir, path)
        if (byBase.exists()) {
            return byBase
        }

        return null
    }

    private String toDataUri(File image) {
        try {
            byte[] bytes = Files.readAllBytes(image.toPath())
            String mime = resolveMimeType(image.name)
            String encoded = Base64.getEncoder().encodeToString(bytes)
            return "data:${mime};base64,${encoded}"
        } catch (Exception ignored) {
            return ''
        }
    }

    private String resolveMimeType(String fileName) {
        String lower = safe(fileName).toLowerCase(Locale.ENGLISH)

        if (lower.endsWith('.png')) return 'image/png'
        if (lower.endsWith('.jpg') || lower.endsWith('.jpeg')) return 'image/jpeg'
        if (lower.endsWith('.gif')) return 'image/gif'
        if (lower.endsWith('.bmp')) return 'image/bmp'
        if (lower.endsWith('.webp')) return 'image/webp'

        return 'image/png'
    }

