	private static final Integer DEFAULT_TIMEOUT = 10
	private static final Integer POLLING_DELAY_SECONDS = 1

	private final ImageLoader imageLoader =
		new ImageLoader()


	// ======================================================
	// OPEN FILTER
	// ======================================================

	@Keyword
	void openFilter(
			String imageGroup,
			String filterFieldImageKey,
			String filterButtonImageKey,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)

		waitForImagePresent(
			imageGroup,
			filterFieldImageKey,
			timeout,
			'Filter field was not displayed.'
		)

		WindowsImageKeywords.clickImage(
			image(imageGroup, filterFieldImageKey)
		)

		waitForImagePresent(
			imageGroup,
			filterButtonImageKey,
			timeout,
			'Filter button was not displayed after opening the filter field.'
		)

		WindowsImageKeywords.clickImage(
			image(imageGroup, filterButtonImageKey)
		)
	}


	// ======================================================
	// CLEAR CURRENT SELECTION
	// ======================================================

	@Keyword
	void clearCurrentSelection(
			String imageGroup,
			String selectAllImageKey,
			String emptySelectionImageKey,
			String closeFilterImageKey,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)

		waitForImagePresent(
			imageGroup,
			selectAllImageKey,
			timeout,
			'Select all option was not displayed.'
		)

		WindowsImageKeywords.doubleClickImage(
			image(imageGroup, selectAllImageKey)
		)

		Windows.delay(POLLING_DELAY_SECONDS)

		waitForImagePresent(
			imageGroup,
			emptySelectionImageKey,
			timeout,
			'Empty selection option was not displayed.'
		)

		WindowsImageKeywords.doubleClickImage(
			image(imageGroup, emptySelectionImageKey)
		)

		Windows.delay(POLLING_DELAY_SECONDS)

		waitForImagePresent(
			imageGroup,
			closeFilterImageKey,
			timeout,
			'Close filter button was not displayed.'
		)

		WindowsImageKeywords.clickImage(
			image(imageGroup, closeFilterImageKey)
		)

		Windows.delay(POLLING_DELAY_SECONDS)
	}


	// ======================================================
	// APPLY TEXT FILTER WITH CHECKBOX
	// ======================================================

	@Keyword
	void applyTextCheckboxFilter(
			String imageGroup,
			String filterFieldImageKey,
			String filterButtonImageKey,
			String textInputImageKey,
			String checkboxImageKey,
			String closeFilterImageKey,
			String appliedFilterImageKey,
			String filterValue,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)
		String value = safeText(filterValue)

		if (value.isEmpty()) {
			KeywordUtil.markFailedAndStop(
				'Filter value cannot be empty.'
			)

			return
		}

		openFilter(
			imageGroup,
			filterFieldImageKey,
			filterButtonImageKey,
			timeout
		)

		waitForImagePresent(
			imageGroup,
			textInputImageKey,
			timeout,
			'Filter text input was not displayed.'
		)

		replaceTextOnImage(
			image(imageGroup, textInputImageKey),
			value
		)

		Windows.delay(2)

		waitForImagePresent(
			imageGroup,
			checkboxImageKey,
			timeout,
			'Filter checkbox was not displayed for value: ' +
			value
		)

		WindowsImageKeywords.clickImage(
			image(imageGroup, checkboxImageKey)
		)

		Windows.delay(POLLING_DELAY_SECONDS)

		waitForImagePresent(
			imageGroup,
			closeFilterImageKey,
			timeout,
			'Close filter button was not displayed.'
		)

		WindowsImageKeywords.clickImage(
			image(imageGroup, closeFilterImageKey)
		)

		waitForImagePresent(
			imageGroup,
			appliedFilterImageKey,
			timeout,
			'Filter was not applied correctly for value: ' +
			value
		)

		KeywordUtil.logInfo(
			'[PASS] Text filter applied successfully. Value: ' +
			value
		)
	}


	// ======================================================
	// APPLY SINGLE RESULT TEXT FILTER
	// ======================================================

	@Keyword
	void applySingleResultTextFilter(
			String imageGroup,
			String objectGroup,
			String hoverImageKey,
			String hoverObjectKey,
			String filterButtonImageKey,
			String filterButtonObjectKey,
			String textInputImageKey,
			String textInputObjectKey,
			String resultCheckboxImageKey,
			String resultCheckboxObjectKey,
			String closeButtonImageKey,
			String closeButtonObjectKey,
			String appliedFilterImageKey,
			String filterValue,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)
		String value = safeText(filterValue)

		if (value.isEmpty()) {
			KeywordUtil.markFailedAndStop(
				'Filter value cannot be empty.'
			)

			return
		}

		// Hover over target header to display the gray filter button
		hoverImageFirstThenObject(
			imageGroup,
			objectGroup,
			hoverImageKey,
			hoverObjectKey,
			timeout
		)

		Windows.delay(POLLING_DELAY_SECONDS)

		// Open filter
		clickImageFirstThenObject(
			imageGroup,
			objectGroup,
			filterButtonImageKey,
			filterButtonObjectKey,
			'Filter button',
			timeout
		)

		// Fill search input
		replaceTextImageFirstThenObject(
			imageGroup,
			objectGroup,
			textInputImageKey,
			textInputObjectKey,
			value,
			timeout
		)

		Windows.delay(2)

		// Select returned result
		clickImageFirstThenObject(
			imageGroup,
			objectGroup,
			resultCheckboxImageKey,
			resultCheckboxObjectKey,
			'Filter result checkbox',
			timeout
		)

		Windows.delay(POLLING_DELAY_SECONDS)

		// Close filter
		clickImageFirstThenObject(
			imageGroup,
			objectGroup,
			closeButtonImageKey,
			closeButtonObjectKey,
			'Close filter button',
			timeout
		)

		KeywordUtil.logInfo(
			'[PASS] Single result text filter applied successfully. Value: ' +
				value
		)
	}


	// ======================================================
	// SELECT ONLY ONE FILTER VALUE
	// ======================================================

	@Keyword
	void selectOnlyFilterValue(
			String imageGroup,
			String objectGroup,
			String hoverImageKey,
			String hoverObjectKey,
			List<String> filterButtonImageKeys,
			String filterButtonObjectKey,
			String valuesTitleImageKey,
			String valuesTitleObjectKey,
			String selectAllCheckedImageKey,
			String selectAllObjectKey,
			String textInputImageKey,
			String textInputObjectKey,
			String resultCheckboxImageKey,
			String resultCheckboxObjectKey,
			String closeButtonImageKey,
			String closeButtonObjectKey,
			String filterValue,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)
		String value = safeText(filterValue)

		if (value.isEmpty()) {
			KeywordUtil.markFailedAndStop(
				'Filter value cannot be empty.'
			)

			return
		}

		// Hover over target header
		hoverImageFirstThenObject(
			imageGroup,
			objectGroup,
			hoverImageKey,
			hoverObjectKey,
			timeout
		)

		Windows.delay(POLLING_DELAY_SECONDS)

		// Open filter using the first available filter icon
		clickFirstAvailableImageThenObject(
			imageGroup,
			objectGroup,
			filterButtonImageKeys,
			filterButtonObjectKey,
			'Filter button',
			timeout
		)

		// Validate Values tab
		waitForImageOrObjectPresent(
			imageGroup,
			objectGroup,
			valuesTitleImageKey,
			valuesTitleObjectKey,
			'Values tab was not displayed after opening the filter.',
			timeout
		)

		// Ensure all values are deselected
		clearAllFilterValues(
			imageGroup,
			objectGroup,
			selectAllCheckedImageKey,
			selectAllObjectKey,
			timeout
		)

		// Search requested value
		replaceTextImageFirstThenObject(
			imageGroup,
			objectGroup,
			textInputImageKey,
			textInputObjectKey,
			value,
			timeout
		)

		Windows.delay(2)

		// Select requested result
		clickImageFirstThenObject(
			imageGroup,
			objectGroup,
			resultCheckboxImageKey,
			resultCheckboxObjectKey,
			'Filter result checkbox: ' + value,
			timeout
		)

		Windows.delay(POLLING_DELAY_SECONDS)

		// Close filter
		clickImageFirstThenObject(
			imageGroup,
			objectGroup,
			closeButtonImageKey,
			closeButtonObjectKey,
			'Close filter button',
			timeout
		)

		Windows.delay(POLLING_DELAY_SECONDS)

		KeywordUtil.logInfo(
			'[PASS] Only the requested filter value was selected: ' +
				value
		)
	}


	// ======================================================
	// DRAG FILTER TO TARGET AREA
	// ======================================================

	@Keyword
	void dragFilterToTargetAndValidate(
			String imageGroup,
			String sourceFilterImageKey,
			String targetAreaImageKey,
			String appliedFilterImageKey,
			String availableFiltersValidationImageKey,
			Integer timeoutSeconds
		) {

		Integer timeout = safeTimeout(timeoutSeconds)

		waitForImagePresent(
			imageGroup,
			sourceFilterImageKey,
			timeout,
			'Source filter was not displayed before drag and drop.'
		)

		waitForImagePresent(
			imageGroup,
			targetAreaImageKey,
			timeout,
			'Filter target area was not displayed.'
		)

		WindowsImageKeywords.dragAndDrop(
			image(imageGroup, sourceFilterImageKey),
			image(imageGroup, targetAreaImageKey)
		)

		waitForImagePresent(
			imageGroup,
			appliedFilterImageKey,
			timeout,
			'Filter was not applied to the target area.'
		)

		waitForImagePresent(
			imageGroup,
			availableFiltersValidationImageKey,
			timeout,
			'Available filter list was not updated after drag and drop.'
		)

		KeywordUtil.logInfo(
			'[PASS] Filter drag and drop completed and validated.'
		)
	}


