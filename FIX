@echo off
setlocal EnableExtensions EnableDelayedExpansion

REM ==========================================================
REM  eMatch - Katalon Runner (Desktop) - Visible session friendly
REM  Reads: D:\Projects\eMatchStarters\run-context.properties
REM  Writes:
REM   - %LOG_DIR%\katalon_YYYYMMDD_HHMMSS.log
REM   - %REPORTS_DIR%\_jenkins_task_exitcode.txt
REM ==========================================================

set "CTX=D:\Projects\eMatchStarters\run-context.properties"

if not exist "%CTX%" (
  echo [ERROR] run-context.properties not found: "%CTX%"
  exit /b 2
)

REM ---------- Defaults ----------
set "WORKSPACE="
set "PROJECT_FILE="
set "KATALON_EXE="
set "COLLECTION_PATH="
set "REPORTS_DIR="
set "LOG_DIR="
set "BROWSER_TYPE=Windows"
set "RETRY=0"

REM ---------- Load properties (key=value) ----------
for /f "usebackq tokens=1,* delims==" %%A in ("%CTX%") do (
  set "K=%%A"
  set "V=%%B"
  if not "!K!"=="" (
    set "!K!=!V!"
  )
)

REM ---------- Validate required ----------
if "%WORKSPACE%"=="" (
  echo [ERROR] WORKSPACE is empty in "%CTX%"
  exit /b 3
)
if "%PROJECT_FILE%"=="" (
  echo [ERROR] PROJECT_FILE is empty in "%CTX%"
  exit /b 3
)
if "%KATALON_EXE%"=="" (
  echo [ERROR] KATALON_EXE is empty in "%CTX%"
  exit /b 3
)
if "%COLLECTION_PATH%"=="" (
  echo [ERROR] COLLECTION_PATH is empty in "%CTX%"
  exit /b 3
)
if "%REPORTS_DIR%"=="" (
  echo [ERROR] REPORTS_DIR is empty in "%CTX%"
  exit /b 3
)
if "%LOG_DIR%"=="" (
  echo [ERROR] LOG_DIR is empty in "%CTX%"
  exit /b 3
)

REM ---------- Prep folders ----------
if not exist "%REPORTS_DIR%" mkdir "%REPORTS_DIR%" 2>nul
if not exist "%LOG_DIR%" mkdir "%LOG_DIR%" 2>nul

set "EXITFILE=%REPORTS_DIR%\_jenkins_task_exitcode.txt"
if exist "%EXITFILE%" del /f /q "%EXITFILE%" 2>nul

REM ---------- Local timestamp ----------
for /f "tokens=1-3 delims=/- " %%a in ("%date%") do (
  set "D1=%%a"
  set "D2=%%b"
  set "D3=%%c"
)
for /f "tokens=1-3 delims=:." %%a in ("%time%") do (
  set "T1=%%a"
  set "T2=%%b"
  set "T3=%%c"
)
set "TS=%D3%%D2%%D1%_%T1%%T2%%T3%"
set "TS=%TS: =0%"

set "KLOG=%LOG_DIR%\katalon_%TS%.log"

echo ==========================================================
echo [INFO] WORKSPACE      = %WORKSPACE%
echo [INFO] PROJECT_FILE   = %PROJECT_FILE%
echo [INFO] KATALON_EXE    = %KATALON_EXE%
echo [INFO] COLLECTION     = %COLLECTION_PATH%
echo [INFO] REPORTS_DIR    = %REPORTS_DIR%
echo [INFO] LOG_DIR        = %LOG_DIR%
echo [INFO] LOG_FILE       = %KLOG%
echo ==========================================================

REM ---------- Run in workspace (important for relative paths) ----------
pushd "%WORKSPACE%" || (
  echo [ERROR] Cannot cd to WORKSPACE: "%WORKSPACE%"
  exit /b 4
)

REM ---------- Execute Katalon ----------
REM NOTE: Using cmd /c keeps it clean for Task Scheduler.
REM If you want the window to stay open for debugging, swap /c to /k.
cmd /c ^
  "\"%KATALON_EXE%\" -noSplash -runMode=console -retry=%RETRY% ^
  -projectPath=\"%WORKSPACE%\%PROJECT_FILE%\" ^
  -testSuiteCollectionPath=\"%COLLECTION_PATH%\" ^
  -browserType=\"%BROWSER_TYPE%\" ^
  -reportFolder=\"%REPORTS_DIR%\" ^" ^
  1>>"%KLOG%" 2>&1

set "EC=%ERRORLEVEL%"

popd

echo %EC%>"%EXITFILE%"

echo ==========================================================
echo [INFO] KATALON FINISHED - EXITCODE=%EC%
echo [INFO] Exitcode file: %EXITFILE%
echo [INFO] Log file     : %KLOG%
echo ==========================================================

exit /b %EC%
