@echo off
setlocal EnableExtensions EnableDelayedExpansion

REM ============================================================
REM  eMatch desktop runner
REM  Reads  : D:\Projects\eMatchStarters\run-context.properties
REM  Writes : CURRENT_LOG_FILE and MARKER_FILE
REM ============================================================

set "CTX_FILE=D:\Projects\eMatchStarters\run-context.properties"

if not exist "%CTX_FILE%" (
    echo [ERROR] Context file not found: "%CTX_FILE%"
    exit /b 90
)

for /f "usebackq tokens=1,* delims==" %%A in ("%CTX_FILE%") do (
    set "K=%%A"
    set "V=%%B"

    if /I "!K!"=="WORKSPACE"                set "WORKSPACE=!V!"
    if /I "!K!"=="PROJECT_PATH"             set "PROJECT_PATH=!V!"
    if /I "!K!"=="KATALON_EXE"              set "KATALON_EXE=!V!"
    if /I "!K!"=="ASSET_TYPE"               set "ASSET_TYPE=!V!"
    if /I "!K!"=="ASSET_PATH"               set "ASSET_PATH=!V!"
    if /I "!K!"=="BROWSER_TYPE"             set "BROWSER_TYPE=!V!"
    if /I "!K!"=="RETRY"                    set "RETRY=!V!"
    if /I "!K!"=="REPORTS_DIR"              set "REPORTS_DIR=!V!"
    if /I "!K!"=="LOG_DIR"                  set "LOG_DIR=!V!"
    if /I "!K!"=="CURRENT_LOG_FILE"         set "CURRENT_LOG_FILE=!V!"
    if /I "!K!"=="MARKER_FILE"              set "MARKER_FILE=!V!"
    if /I "!K!"=="RUN_LABEL"                set "RUN_LABEL=!V!"
    if /I "!K!"=="RUNNER_WINDOW_TITLE"      set "RUNNER_WINDOW_TITLE=!V!"
    if /I "!K!"=="WINAPPDRIVER_EXE"         set "WINAPPDRIVER_EXE=!V!"
    if /I "!K!"=="AUTO_START_WINAPPDRIVER"  set "AUTO_START_WINAPPDRIVER=!V!"
    if /I "!K!"=="APP_EXE_PATH"             set "APP_EXE_PATH=!V!"
    if /I "!K!"=="APP_LNK_PATH"             set "APP_LNK_PATH=!V!"
)

if "%PROJECT_PATH%"=="" (
    echo [ERROR] PROJECT_PATH is empty
    exit /b 91
)

if "%KATALON_EXE%"=="" (
    echo [ERROR] KATALON_EXE is empty
    exit /b 92
)

if "%ASSET_PATH%"=="" (
    echo [ERROR] ASSET_PATH is empty
    exit /b 93
)

if "%REPORTS_DIR%"=="" (
    set "REPORTS_DIR=%WORKSPACE%\\Reports"
)

if "%LOG_DIR%"=="" (
    set "LOG_DIR=%REPORTS_DIR%\\_desktop_logs"
)

if "%CURRENT_LOG_FILE%"=="" (
    set "CURRENT_LOG_FILE=%LOG_DIR%\\katalon_current.log"
)

if "%MARKER_FILE%"=="" (
    echo [ERROR] MARKER_FILE is empty
    exit /b 94
)

if "%BROWSER_TYPE%"=="" (
    set "BROWSER_TYPE=Windows"
)

if "%RETRY%"=="" (
    set "RETRY=0"
)

if "%ASSET_TYPE%"=="" (
    set "ASSET_TYPE=COLLECTION"
)

if not exist "%REPORTS_DIR%" mkdir "%REPORTS_DIR%" >nul 2>&1
if not exist "%LOG_DIR%" mkdir "%LOG_DIR%" >nul 2>&1

for %%F in ("%CURRENT_LOG_FILE%") do (
    if not exist "%%~dpF" mkdir "%%~dpF" >nul 2>&1
)

for %%F in ("%MARKER_FILE%") do (
    if not exist "%%~dpF" mkdir "%%~dpF" >nul 2>&1
)

if exist "%MARKER_FILE%" del /f /q "%MARKER_FILE%" >nul 2>&1
if exist "%MARKER_FILE%.tmp" del /f /q "%MARKER_FILE%.tmp" >nul 2>&1
if exist "%CURRENT_LOG_FILE%" del /f /q "%CURRENT_LOG_FILE%" >nul 2>&1

for /f %%I in ('powershell -NoProfile -Command "Get-Date -Format yyyyMMdd_HHmmss"') do set "TS=%%I"
set "FINAL_LOG_FILE=%LOG_DIR%\\katalon_%TS%.log"

call :log ============================================================
call :log [INFO] RUN_LABEL            = %RUN_LABEL%
call :log [INFO] WORKSPACE            = %WORKSPACE%
call :log [INFO] PROJECT_PATH         = %PROJECT_PATH%
call :log [INFO] KATALON_EXE          = %KATALON_EXE%
call :log [INFO] ASSET_TYPE           = %ASSET_TYPE%
call :log [INFO] ASSET_PATH           = %ASSET_PATH%
call :log [INFO] BROWSER_TYPE         = %BROWSER_TYPE%
call :log [INFO] REPORTS_DIR          = %REPORTS_DIR%
call :log [INFO] CURRENT_LOG_FILE     = %CURRENT_LOG_FILE%
call :log [INFO] MARKER_FILE          = %MARKER_FILE%
call :log [INFO] APP_EXE_PATH         = %APP_EXE_PATH%
call :log [INFO] APP_LNK_PATH         = %APP_LNK_PATH%
call :log ============================================================

if /I "%AUTO_START_WINAPPDRIVER%"=="true" (
    call :log [INFO] Starting WinAppDriver if needed...

    tasklist /FI "IMAGENAME eq WinAppDriver.exe" | find /I "WinAppDriver.exe" >nul
    if errorlevel 1 (
        if exist "%WINAPPDRIVER_EXE%" (
            start "" "%WINAPPDRIVER_EXE%" 127.0.0.1 4723/wd/hub
            timeout /t 3 /nobreak >nul
            call :log [INFO] WinAppDriver started.
        ) else (
            call :log [WARN] WINAPPDRIVER_EXE not found: %WINAPPDRIVER_EXE%
        )
    ) else (
        call :log [INFO] WinAppDriver already running.
    )
)

call :open_app

cd /d "%WORKSPACE%"

call :log [INFO] Starting Katalon...

if /I "%ASSET_TYPE%"=="COLLECTION" (
    "%KATALON_EXE%" ^
      -noSplash ^
      -runMode=console ^
      -consoleLog ^
      -projectPath="%PROJECT_PATH%" ^
      -retry=%RETRY% ^
      -testSuiteCollectionPath="%ASSET_PATH%" ^
      -browserType="%BROWSER_TYPE%" ^
      -reportFolder="%REPORTS_DIR%" >> "%CURRENT_LOG_FILE%" 2>&1
) else (
    "%KATALON_EXE%" ^
      -noSplash ^
      -runMode=console ^
      -consoleLog ^
      -projectPath="%PROJECT_PATH%" ^
      -retry=%RETRY% ^
      -testSuitePath="%ASSET_PATH%" ^
      -browserType="%BROWSER_TYPE%" ^
      -reportFolder="%REPORTS_DIR%" >> "%CURRENT_LOG_FILE%" 2>&1
)

set "EXITCODE=%ERRORLEVEL%"

call :log [INFO] Katalon ExitCode=%EXITCODE%
call :log [INFO] Writing marker file...

(
    echo %EXITCODE%
) > "%MARKER_FILE%.tmp"

move /Y "%MARKER_FILE%.tmp" "%MARKER_FILE%" >nul 2>&1

copy /Y "%CURRENT_LOG_FILE%" "%FINAL_LOG_FILE%" >nul 2>&1

call :log [INFO] Marker file written: %MARKER_FILE%
call :log [INFO] Final log saved   : %FINAL_LOG_FILE%
call :log [INFO] Runner finished

exit /b %EXITCODE%

:open_app
if not "%APP_EXE_PATH%"=="" (
    if exist "%APP_EXE_PATH%" (
        call :log [INFO] Opening app from APP_EXE_PATH...
        start "" "%APP_EXE_PATH%"
        timeout /t 10 /nobreak >nul
        goto :eof
    ) else (
        call :log [WARN] APP_EXE_PATH not found: %APP_EXE_PATH%
    )
)

if not "%APP_LNK_PATH%"=="" (
    if exist "%APP_LNK_PATH%" (
        call :log [INFO] Opening app from APP_LNK_PATH...
        powershell -NoProfile -ExecutionPolicy Bypass -Command ^
            "Start-Process -FilePath '%APP_LNK_PATH%'" >> "%CURRENT_LOG_FILE%" 2>&1
        timeout /t 10 /nobreak >nul
        goto :eof
    ) else (
        call :log [WARN] APP_LNK_PATH not found: %APP_LNK_PATH%
    )
)

call :log [WARN] No APP_EXE_PATH or APP_LNK_PATH configured.
goto :eof

:log
echo %*>> "%CURRENT_LOG_FILE%"
goto :eof
