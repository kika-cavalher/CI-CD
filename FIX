String tryClickImage(Integer time,String img) {
	String file=''
	Integer limit=100
	if(time<limit) {
	try {
		
		WindowsImageKeywords.clickImage(img);
		return file
	} catch (Exception e) {
		Windows.delay(40)
		tryClickImage(time++,img)
	}
	}else {
		Windows.delay(60)
		WindowsImageKeywords.clickImage(img);
	}
	
	
	
}

String getFileName(Integer time) {
	String file=''
	Integer limit=100
	if(time<limit) {
	try {
		Robot robot = new Robot();
		robot.keyPress(KeyEvent.VK_CONTROL);
		robot.keyPress(KeyEvent.VK_C);
		Windows.delay(2)
		robot.keyRelease(KeyEvent.VK_CONTROL);
		robot.keyRelease(KeyEvent.VK_C);
		Clipboard sysClipboard=Toolkit.getDefaultToolkit().getSystemClipboard()
		DataFlavor dataflavour=DataFlavor.stringFlavor
		Object text=sysClipboard.getData(dataflavour)
		
		file=(String)text
		if (file.contains('REC')||file.contains('PROD')) {
			return file
		}else {
			getFileName(time++)
		}
		
		
		
		//Windows.delay(60)
		//file = Windows.getText(findWindowsObject('General/txtFileName'));
		//return file
	} catch (Exception e) {
		Robot robot = new Robot();
		robot.keyPress(KeyEvent.VK_CONTROL);
		robot.keyPress(KeyEvent.VK_C);
		Windows.delay(2)
		robot.keyRelease(KeyEvent.VK_CONTROL);
		robot.keyRelease(KeyEvent.VK_C);
		Clipboard sysClipboard=Toolkit.getDefaultToolkit().getSystemClipboard()
		DataFlavor dataflavour=DataFlavor.stringFlavor
		Object text=sysClipboard.getData(dataflavour)
		
		file=(String)text
		if (file.contains('REC')||file.contains('PROD')) {
			return file
		}else {
			getFileName(time++)
		}
	}
	}
	
	
	
}


