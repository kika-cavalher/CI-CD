					'.' +
					imageKey +
					'\nObject: ' +
					OBJECT_GROUP +
					'.' +
					objectKey
					)

			return
		}

		Windows.click(
				targetObject,
				FailureHandling.STOP_ON_FAILURE
				)

		KeywordUtil.logInfo(
				'[OBJECT] ' +
				description +
				' clicked.\n' +
				'Group: ' +
				OBJECT_GROUP +
				'\nKey: ' +
				objectKey
				)
	}

