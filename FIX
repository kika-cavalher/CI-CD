// Delay time and timeout setup
int timeoutSec = 30
int delayInterval = 2
int elapsedTime = 0
boolean windowFound = false

while (elapsedTime < timeoutSec) {
	try {
		Windows.switchToDesktop()
		Windows.switchToWindow(targetWindow) 
		windowFound = true 
		break 
	} catch (Exception e) {
		KeywordUtil.logInfo("Unable to switch to the window: " + e.getMessage())
		Windows.delay(delayInterval) 
		elapsedTime += delayInterval 
	}
}

if (!windowFound) {
	KeywordUtil.markFailed("Target window '" + targetWindow.getLocator() + "' could not be found within " + timeoutSec + " seconds.")
}


