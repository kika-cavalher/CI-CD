import static com.kms.katalon.core.testobject.ObjectRepository.findWindowsObject

import java.awt.Robot
import java.awt.Toolkit
import java.awt.datatransfer.StringSelection
import java.awt.event.KeyEvent

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.WindowsTestObject
import com.kms.katalon.core.testobject.WindowsTestObject.LocatorStrategy
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

String sectionValue = '228'

Robot robot = new Robot()
robot.setAutoDelay(150)

String projectDir = RunConfiguration.getProjectDir()

String rechercheImagePath = new File(projectDir, 'Images/General/Recherche.PNG').getAbsolutePath()
String filtresImagePath = new File(projectDir, 'Images/General/Filtres.PNG').getAbsolutePath()

Closure clickImageOrStop = { String imagePath, String imageName ->
	File imageFile = new File(imagePath)

	if (!imageFile.exists()) {
		KeywordUtil.markFailedAndStop(
				'Image not found.\n' +
				'Image: ' + imageName + '\n' +
				'Path: ' + imagePath
				)
	}

	try {
		KeywordUtil.logInfo('Click image: ' + imageName + ' -> ' + imagePath)
		WindowsImageKeywords.clickImage(imagePath)
		Windows.delay(1)
	} catch (Exception e) {
		KeywordUtil.markFailedAndStop(
				'Could not click image.\n' +
				'Image: ' + imageName + '\n' +
				'Path: ' + imagePath + '\n' +
				'Reason: ' + e.getMessage()
				)
	}
}

Closure pasteText = { String text ->
	StringSelection selection = new StringSelection(text)
	Toolkit.getDefaultToolkit().getSystemClipboard().setContents(selection, null)

	Windows.delay(1)

	robot.keyPress(KeyEvent.VK_CONTROL)
	robot.keyPress(KeyEvent.VK_V)
	robot.keyRelease(KeyEvent.VK_V)
	robot.keyRelease(KeyEvent.VK_CONTROL)
}

Closure clearFocusedField = {
	robot.keyPress(KeyEvent.VK_CONTROL)
	robot.keyPress(KeyEvent.VK_A)
	robot.keyRelease(KeyEvent.VK_A)
	robot.keyRelease(KeyEvent.VK_CONTROL)

	Windows.delay(1)

	robot.keyPress(KeyEvent.VK_BACK_SPACE)
	robot.keyRelease(KeyEvent.VK_BACK_SPACE)
}

Closure clickOptionalRepositoryObject = { String objectPath ->
	try {
		Windows.click(findWindowsObject(objectPath), FailureHandling.OPTIONAL)
		Windows.delay(1)
		KeywordUtil.logInfo('Clicked optional object: ' + objectPath)
		return true
	} catch (Exception ignored) {
		return false
	}
}

Closure buildDynamicObjectByText = { String objectId, String text ->
	WindowsTestObject object = new WindowsTestObject(objectId)
	object.setLocatorStrategy(LocatorStrategy.XPATH)
	object.setLocator(
			"//*[contains(translate(@Name, 'abcdefghijklmnopqrstuvwxyz', 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'), '" + text.toUpperCase() + "') " +
			"or contains(translate(@AutomationId, 'abcdefghijklmnopqrstuvwxyz', 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'), '" + text.toUpperCase() + "')]"
			)

	return object
}

Closure focusSectionField = {
	List<String> repositoryCandidates = [
		'Object Repository/Contre-valorisation IHM/txtSection',
		'Contre-valorisation IHM/txtSection',
		'Object Repository/General/txtSection',
		'General/txtSection'
	]

	for (String objectPath : repositoryCandidates) {
		if (clickOptionalRepositoryObject(objectPath)) {
			return true
		}
	}

	try {
		WindowsTestObject sectionObject = buildDynamicObjectByText('dynamicSectionField', 'Section')

		if (Windows.verifyElementPresent(sectionObject, 2, FailureHandling.OPTIONAL)) {
			Windows.click(sectionObject)
			Windows.delay(1)
			KeywordUtil.logInfo('Section field focused using dynamic Windows object.')
			return true
		}
	} catch (Exception ignored) {
	}

	KeywordUtil.logInfo('Section field object not found. Using current focus after Recherche tab.')
	return true
}

KeywordUtil.logInfo('Step 1. Open Recherche tab.')
clickImageOrStop(rechercheImagePath, 'Recherche tab')
Windows.delay(2)

KeywordUtil.logInfo('Step 2. Fill section filter with value: ' + sectionValue)
focusSectionField()
clearFocusedField()
pasteText(sectionValue)
Windows.delay(1)

KeywordUtil.logInfo('Step 3. Click Filtres button.')
clickImageOrStop(filtresImagePath, 'Filtres button')
Windows.delay(10)

KeywordUtil.markPassed('Comparatif Inter filter applied successfully. Section: ' + sectionValue)
