                border-radius: 12px;
                background: #122236;
                color: #f1f5f9;
                font-family: Consolas, "Courier New", monospace;
                font-size: 12px;
                line-height: 1.55;
                white-space: pre-wrap;
                overflow-x: auto;
                max-width: 100%;
            }

            .visual-error {
                margin-top: 22px;
                background: #ffffff;
                border: 1px solid #f0d0d0;
                border-left: 4px solid ''' + STATUS_FAIL + ''';
                border-radius: 14px;
                padding: 16px 18px;
                box-shadow: var(--shadow);
            }

            .visual-error-title {
                font-size: 14px;
                font-weight: 700;
                color: #7f2d2d;
                margin-bottom: 8px;
            }

            .visual-error-line {
                font-size: 13px;
                line-height: 1.5;
                color: #455468;
