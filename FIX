def executeSuite(scriptRef, Map suite, int timeoutMinutes) {
    scriptRef.env.CURRENT_SUITE_NAME = suite.name

    scriptRef.catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
        def exitCode = 999
        def consoleLog = "${scriptRef.env.LOGS_DIR}\\${suite.name}.log"

        try {
            scriptRef.echo '╔════════════════════════════════════════════════════════════╗'
            scriptRef.echo "║ STARTING SUITE: ${suite.name}".padRight(60) + '║'
            scriptRef.echo "║ PATH: ${suite.path}".padRight(60) + '║'
            scriptRef.echo "║ TIMEOUT: ${timeoutMinutes} min".padRight(60) + '║'
            scriptRef.echo '╚════════════════════════════════════════════════════════════╝'

            scriptRef.timeout(time: timeoutMinutes, unit: 'MINUTES') {
                exitCode = runKatalonSuite(scriptRef, suite.name, suite.path, consoleLog)
            }
        } finally {
            collectLatestKatalonReport(scriptRef, suite.name)
            recordSuiteResult(scriptRef, suite.name, suite.path, exitCode, consoleLog)
            cleanupTimestampReportFolders(scriptRef)

            printSuiteCaseSummary(scriptRef, suite.name)

            def results = loadSuiteResults(scriptRef)
            def current = results[suite.name] ?: [:]
            scriptRef.echo '------------------------------------------------------------'
            scriptRef.echo "FINAL SUITE STATUS: ${suite.name} -> ${current.status ?: (exitCode == 0 ? 'PASSED' : 'FAILED')}"
            scriptRef.echo '------------------------------------------------------------'

            printExecutionSummary(scriptRef)
        }

        if (exitCode != 0) {
            def results = loadSuiteResults(scriptRef)
            def err = results[suite.name]?.error ?: ''

            scriptRef.echo '------------------------------------------------------------'
            scriptRef.echo "SUITE FAILED: ${suite.name}"
            scriptRef.echo "Exit code: ${exitCode}"
            if (err?.trim()) {
                scriptRef.echo 'Error summary:'
                scriptRef.echo err
            } else {
                scriptRef.echo 'No extracted error lines found'
            }
            scriptRef.echo '------------------------------------------------------------'

            scriptRef.error("Suite ${suite.name} failed with exit code ${exitCode}")
        } else {
            scriptRef.echo '------------------------------------------------------------'
            scriptRef.echo "SUITE PASSED: ${suite.name}"
            scriptRef.echo '------------------------------------------------------------'
        }
    }
}

def runKatalonSuite(scriptRef, String suiteName, String suitePath, String consoleLog) {
    def exitCode = scriptRef.bat(
        returnStatus: true,
        script: """
            @echo off
            if exist "${consoleLog}" del /f /q "${consoleLog}" >nul 2>&1

            call "${scriptRef.env.KATALON_EXE}" ^
            -noSplash ^
            -runMode=console ^
            -consoleLog ^
            -projectPath="${scriptRef.env.PROJECT_PATH}" ^
            -retry=0 ^
            -testSuitePath="${suitePath}" ^
            -browserType="${scriptRef.env.BROWSER_TYPE}" ^
            -executionProfile="${scriptRef.env.EXEC_PROFILE}" ^
            -reportFolder="${scriptRef.env.REPORTS_DIR}" ^
            -reportFileName="${suiteName}" > "${consoleLog}" 2>&1

            exit /b %%ERRORLEVEL%%
        """
    )

    scriptRef.echo "Finished ${suiteName} with exit code ${exitCode}"
    return exitCode
}

def collectLatestKatalonReport(scriptRef, String suiteName) {
    scriptRef.powershell """
        \$reportsRoot = "${scriptRef.env.REPORTS_DIR}"
        \$suiteName = "${suiteName}"
        \$stableDir = Join-Path \$reportsRoot \$suiteName

        \$timestampFolders = Get-ChildItem -Path \$reportsRoot -Directory -ErrorAction SilentlyContinue |
            Where-Object { \$_.Name -match '^\\d{8}_\\d{6}\$' } |
            Sort-Object LastWriteTime -Descending

        if (-not \$timestampFolders) {
            Write-Host "No timestamp report folder found for suite \$suiteName"
            exit 0
        }

        \$latestFolder = \$timestampFolders[0]

        if (Test-Path \$stableDir) {
            Remove-Item -Path \$stableDir -Recurse -Force -ErrorAction SilentlyContinue
        }

        New-Item -ItemType Directory -Path \$stableDir -Force | Out-Null

        robocopy "\$([string]\$latestFolder.FullName)" "\$stableDir" /E /NFL /NDL /NJH /NJS /NC /NS | Out-Null

        if (\$LASTEXITCODE -gt 7) {
            Write-Host "WARNING: Robocopy failed while collecting report for suite \$suiteName"
            exit 0
        }

        Write-Host "Stable report ready for suite \$suiteName"
    """
}

def recordSuiteResult(scriptRef, String suiteName, String suitePath, int exitCode, String consoleLog) {
    def results = loadSuiteResults(scriptRef)
    def htmlFile = findMainHtmlReport(scriptRef, "${scriptRef.env.REPORTS_DIR}\\${suiteName}")
    def junitFile = findFirstRelativeFile(scriptRef, "${scriptRef.env.REPORTS_DIR}\\${suiteName}", 'JUnit_Report.xml')
    def errorText = extractImportantErrors(scriptRef, consoleLog, 18)
    def caseSummary = extractJUnitSummary(scriptRef, "${scriptRef.env.REPORTS_DIR}\\${suiteName}")

    results[suiteName] = [
        name      : suiteName,
        path      : suitePath,
        exitCode  : exitCode,
        status    : exitCode == 0 ? 'PASSED' : 'FAILED',
        html      : htmlFile,
        junit     : junitFile,
        error     : errorText,
        executed  : caseSummary.executed,
        passed    : caseSummary.passed,
        failed    : caseSummary.failed,
        skipped   : caseSummary.skipped,
        failItems : caseSummary.failItems
    ]

    saveSuiteResults(scriptRef, results)
}

def updateSuiteResultAfterAbort(scriptRef, String suiteName) {
    def results = loadSuiteResults(scriptRef)
    def htmlFile = findMainHtmlReport(scriptRef, "${scriptRef.env.REPORTS_DIR}\\${suiteName}")
    def existing = results[suiteName] instanceof Map ? results[suiteName] : [:]

    existing.putAll([
        name    : suiteName,
        status  : 'ABORTED',
        exitCode: 130,
        html    : htmlFile
    ])

    results[suiteName] = existing
    saveSuiteResults(scriptRef, results)
}

def extractJUnitSummary(scriptRef, String suiteDir) {
    def raw = scriptRef.powershell(
        returnStdout: true,
        script: """
            \$suiteDir = "${suiteDir}"

            \$result = @{
                executed = 0
                passed   = 0
                failed   = 0
                skipped  = 0
                failItems = @()
            }

            if (-not (Test-Path \$suiteDir)) {
                \$result | ConvertTo-Json -Depth 5
                exit 0
            }

            \$junit = Get-ChildItem -Path \$suiteDir -Recurse -File -Include 'JUnit_Report.xml','junit*.xml','JUnit*.xml','TEST-*.xml' -ErrorAction SilentlyContinue | Select-Object -First 1
            if (-not \$junit) {
                \$result | ConvertTo-Json -Depth 5
                exit 0
            }

            [xml]\$xml = Get-Content \$junit.FullName -Raw -ErrorAction SilentlyContinue

            \$testcases = @(\$xml.SelectNodes('//testcase'))
            \$failedCases = @(\$xml.SelectNodes('//testcase[failure or error]'))
            \$skippedCases = @(\$xml.SelectNodes('//testcase[skipped]'))

            \$result.executed = \$testcases.Count
            \$result.failed = \$failedCases.Count
            \$result.skipped = \$skippedCases.Count
            \$result.passed = [Math]::Max(0, \$result.executed - \$result.failed - \$result.skipped)

            foreach (\$tc in \$failedCases | Select-Object -First 5) {
                \$msg = ''
                if (\$tc.failure) {
                    \$msg = [string]\$tc.failure.message
                    if ([string]::IsNullOrWhiteSpace(\$msg)) { \$msg = [string]\$tc.failure.'#text' }
                } elseif (\$tc.error) {
                    \$msg = [string]\$tc.error.message
                    if ([string]::IsNullOrWhiteSpace(\$msg)) { \$msg = [string]\$tc.error.'#text' }
                }

                \$result.failItems += @{
                    name = [string]\$tc.name
                    reason = [string]\$msg
                }
            }

            \$result | ConvertTo-Json -Depth 6
        """
    ).trim()

    if (!raw) {
        return [executed:0, passed:0, failed:0, skipped:0, failItems:[]]
    }

    def parsed = new JsonSlurperClassic().parseText(raw)
    if (!(parsed.failItems instanceof List)) {
        parsed.failItems = parsed.failItems ? [parsed.failItems] : []
    }
    return parsed
}

def loadSuiteResults(scriptRef) {
    if (!scriptRef.fileExists(scriptRef.env.RESULTS_JSON)) {
        return [:]
    }

    def txt = scriptRef.readFile(scriptRef.env.RESULTS_JSON).trim()
    if (!txt) {
        return [:]
    }

    return new JsonSlurperClassic().parseText(txt) as Map
}

def saveSuiteResults(scriptRef, Map results) {
    scriptRef.writeFile file: scriptRef.env.RESULTS_JSON, text: JsonOutput.prettyPrint(JsonOutput.toJson(results ?: [:]))
}

def findMainHtmlReport(scriptRef, String baseDir) {
    return scriptRef.powershell(
        returnStdout: true,
        script: """
            \$baseDir = "${baseDir}"
            if (-not (Test-Path \$baseDir)) {
                exit 0
            }

            \$preferred = Get-ChildItem -Path \$baseDir -Recurse -File -Include 'report.html','index.html' -ErrorAction SilentlyContinue |
                Select-Object -First 1

            if (-not \$preferred) {
                \$preferred = Get-ChildItem -Path \$baseDir -Recurse -File -Include *.html -ErrorAction SilentlyContinue |
                    Select-Object -First 1
            }

            if (\$preferred) {
                \$root = "${scriptRef.env.REPORTS_DIR}\\"
                \$full = [string]\$preferred.FullName
                if (\$full.StartsWith(\$root)) {
                    \$rel = \$full.Substring(\$root.Length)
                    Write-Output \$rel.Replace('\\\\','/')
                }
            }
        """
    ).trim()
}

def findFirstRelativeFile(scriptRef, String baseDir, String pattern) {
    return scriptRef.powershell(
        returnStdout: true,
        script: """
            \$baseDir = "${baseDir}"
            if (-not (Test-Path \$baseDir)) {
                exit 0
            }

            \$file = Get-ChildItem -Path \$baseDir -Recurse -File -Include "${pattern}" -ErrorAction SilentlyContinue |
                Select-Object -First 1

            if (\$file) {
                \$root = "${scriptRef.env.REPORTS_DIR}\\"
                \$full = [string]\$file.FullName
                if (\$full.StartsWith(\$root)) {
                    \$rel = \$full.Substring(\$root.Length)
                    Write-Output \$rel.Replace('\\\\','/')
                }
            }
        """
    ).trim()
}

def extractImportantErrors(scriptRef, String consoleLog, int maxLines) {
    return scriptRef.powershell(
        returnStdout: true,
        script: """
            \$log = "${consoleLog}"
            if (-not (Test-Path \$log)) {
                exit 0
            }

            \$patterns = @(
                'ERROR',
                'FAILED',
                'StepFailedException',
                'AssertionError',
                'Caused by:',
                'not found',
                'timed out',
                'InvalidConsoleArgumentException',
                'Unable',
                'Exception'
            )

            \$matches = @()
            Get-Content \$log -ErrorAction SilentlyContinue | ForEach-Object {
                \$line = [string]\$_
                foreach (\$p in \$patterns) {
                    if (\$line -match \$p) {
                        \$matches += \$line.Trim()
                        break
                    }
                }
            }

            \$matches | Select-Object -Unique | Select-Object -First ${maxLines}
        """
    ).trim()
}

def printExecutionSummary(scriptRef) {
    def results = loadSuiteResults(scriptRef)
    def passed  = results.values().count { it.status == 'PASSED' }
    def failed  = results.values().count { it.status == 'FAILED' }
    def aborted = results.values().count { it.status == 'ABORTED' }
    def total   = results.size()

    scriptRef.echo '╔════════════════════════════════════════════════════════════╗'
    scriptRef.echo "║ EXECUTION SUMMARY".padRight(60) + '║'
    scriptRef.echo "║ Passed : ${passed}".padRight(60) + '║'
    scriptRef.echo "║ Failed : ${failed}".padRight(60) + '║'
    scriptRef.echo "║ Aborted: ${aborted}".padRight(60) + '║'
    scriptRef.echo "║ Executed: ${total}".padRight(60) + '║'
    scriptRef.echo '╠════════════════════════════════════════════════════════════╣'

    getTestSuites().each { suite ->
        if (results[suite.name]) {
            def r = results[suite.name]
            scriptRef.echo "• ${r.name} | ${r.status} | exit ${r.exitCode}"
        }
    }

    scriptRef.echo '╚════════════════════════════════════════════════════════════╝'
}

def printSuiteCaseSummary(scriptRef, String suiteName) {
    def results = loadSuiteResults(scriptRef)
    def r = results[suiteName]
    if (!r) {
        return
    }

    scriptRef.echo '╔════════════════════════════════════════════════════════════╗'
    scriptRef.echo "║ TEST CASE SUMMARY: ${suiteName}".padRight(60) + '║'
    scriptRef.echo "║ Executed: ${r.executed ?: 0}".padRight(60) + '║'
    scriptRef.echo "║ Passed  : ${r.passed ?: 0}".padRight(60) + '║'
    scriptRef.echo "║ Failed  : ${r.failed ?: 0}".padRight(60) + '║'
    scriptRef.echo "║ Skipped : ${r.skipped ?: 0}".padRight(60) + '║'
    scriptRef.echo '╠════════════════════════════════════════════════════════════╣'

    if ((r.failItems ?: []).size() > 0) {
        r.failItems.each { item ->
            scriptRef.echo "FAIL: ${item.name ?: 'Unknown test case'}"
            if (item.reason) {
                scriptRef.echo "↪ ${item.reason}"
            }
        }
    } else {
        scriptRef.echo 'All visible test cases passed or no failed cases were found in JUnit'
    }

    scriptRef.echo '╚════════════════════════════════════════════════════════════╝'
}

