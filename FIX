/*
 * Responsibility:
 * 1) Run one desktop suite through Windows Scheduled Tasks
 * 2) Start and stop WinDriver automatically
 * 3) Wait until the desktop task finishes
 * 4) Scan Reports folder and write suite metadata
 * 5) Create synthetic JUnit when needed
 */

def safeFileName(String value) {
    return (value ?: '').replaceAll(/[^A-Za-z0-9._ -]/, '').replace(' ', '_')
}

def runSuite(script, Map cfg, Map suite) {
    def suiteKey = safeFileName(suite.name)

    return script.withEnv([
        "REPORTS_ROOT=${cfg.reportsRoot}",
        "SUITE_NAME=${suite.name}",
        "SUITE_KEY=${suiteKey}",
        "TASK_NAME=${suite.taskName}",
        "TASK_FOLDER=${cfg.taskFolder}",
        "WIN_DRIVER_TASK=${cfg.winDriverTask}",
        "SUITE_TIMEOUT_MINUTES=${(suite.timeoutMinutes ?: cfg.suiteTimeoutMinutes).toString()}",
        "POLL_SECONDS=${(cfg.pollSeconds ?: 5).toString()}"
    ]) {
        script.powershell(
            returnStatus: true,
            script: '''
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'

function Clean-Text {
    param([string]$Value)

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return ''
    }

    $text = $Value -replace '[\\r\\n]+', ' '
    $text = $text -replace '\\s+', ' '
    return $text.Trim()
}

function Short-Text {
    param(
        [string]$Value,
        [int]$Max = 180
    )

    $text = Clean-Text $Value

    if ($text.Length -gt $Max) {
        return $text.Substring(0, $Max - 3) + '...'
    }

    return $text
}

function To-RelativePath {
    param(
        [string]$Root,
        [string]$FullPath
    )

    if ([string]::IsNullOrWhiteSpace($FullPath)) {
        return ''
    }

    if (-not $FullPath.StartsWith($Root)) {
        return ''
    }

    $rel = $FullPath.Substring($Root.Length)

    if ($rel.StartsWith('\\')) {
        $rel = $rel.Substring(1)
    }

    return $rel.Replace('\\', '/')
}

function Read-TaskStatus {
    param([string]$TaskFullName)

    $status = ''
    $lastRunResult = ''
    $rawLines = schtasks /query /tn $TaskFullName /fo list 2>$null

    foreach ($line in $rawLines) {
        if ($line -match '^Status:\\s*(.+)$') {
            $status = $Matches[1].Trim()
        }
        elseif ($line -match '^Last Run Result:\\s*(.+)$') {
            $lastRunResult = $Matches[1].Trim()
        }
    }

    return [ordered]@{
        Status        = $status
        LastRunResult = $lastRunResult
    }
}

function Start-SafeScheduledTask {
    param([string]$TaskName)

    if ([string]::IsNullOrWhiteSpace($TaskName)) {
        throw 'Scheduled task name was not provided'
    }

    schtasks /run /tn $TaskName | Out-Host
}

function End-SafeScheduledTask {
    param([string]$TaskName)

    if ([string]::IsNullOrWhiteSpace($TaskName)) {
        return
    }

    try {
        schtasks /end /tn $TaskName 1>$null 2>$null
    }
    catch {
    }
}

function Parse-TaskExitCode {
    param([string]$Value)

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return 1
    }

    $text = $Value.Trim()

    if ($text -match '^0x[0-9A-Fa-f]+$') {
        return [Convert]::ToInt32($text, 16)
    }

    if ($text -match '^-?[0-9]+$') {
        return [int]$text
    }

    return 1
}

function Find-SuiteOutputDir {
    param(
        [string]$Root,
        [datetime]$StartedAt
    )

    if (-not (Test-Path $Root)) {
        return ''
    }

    $candidate = Get-ChildItem -Path $Root -Directory -Recurse -ErrorAction SilentlyContinue |
        Where-Object {
            $full = $_.FullName.Replace('\\', '/')
            ($full -notmatch '/logs($|/)') -and
            ($full -notmatch '/suite-artifacts($|/)') -and
            ($_.LastWriteTime -ge $StartedAt.AddMinutes(-1))
        } |
        Where-Object {
            (Test-Path (Join-Path $_.FullName 'JUnit_Report.xml')) -or
            (Test-Path (Join-Path $_.FullName 'execution0.log')) -or
            (Get-ChildItem -Path $_.FullName -Filter '*.png' -File -Recurse -ErrorAction SilentlyContinue | Select-Object -First 1)
        } |
        Sort-Object LastWriteTime -Descending |
        Select-Object -First 1

    if ($candidate) {
        return $candidate.FullName
    }

    return ''
}

function Find-BestScreenshot {
    param([string]$SuiteOutputDir)

    if ([string]::IsNullOrWhiteSpace($SuiteOutputDir) -or -not (Test-Path $SuiteOutputDir)) {
        return ''
    }

    $allPngs = @(Get-ChildItem -Path $SuiteOutputDir -Filter '*.png' -File -Recurse -ErrorAction SilentlyContinue)

    if ($allPngs.Count -eq 0) {
        return ''
    }

    $preferred = @(
        $allPngs |
        Where-Object {
            $_.Name -match '^[0-9]+\\.png$' -and $_.Length -gt 10KB
        } |
        Sort-Object @{Expression='Length';Descending=$true}, @{Expression='LastWriteTime';Descending=$true}
    )

    if ($preferred.Count -gt 0) {
        return $preferred[0].FullName
    }

    $fallback = @(
        $allPngs |
        Where-Object { $_.Length -gt 10KB } |
        Sort-Object @{Expression='Length';Descending=$true}, @{Expression='LastWriteTime';Descending=$true}
    )

    if ($fallback.Count -gt 0) {
        return $fallback[0].FullName
    }

    $last = $allPngs | Sort-Object LastWriteTime -Descending | Select-Object -First 1
    if ($last) {
        return $last.FullName
    }

    return ''
}

function Find-LatestJUnit {
    param([string]$SuiteOutputDir)

    if ([string]::IsNullOrWhiteSpace($SuiteOutputDir) -or -not (Test-Path $SuiteOutputDir)) {
        return ''
    }

    $candidate = Get-ChildItem -Path $SuiteOutputDir -Filter 'JUnit_Report.xml' -File -Recurse -ErrorAction SilentlyContinue |
        Sort-Object LastWriteTime -Descending |
        Select-Object -First 1

    if ($candidate) {
        return $candidate.FullName
    }

    return ''
}

function Find-LatestExecutionLog {
    param([string]$SuiteOutputDir)

    if ([string]::IsNullOrWhiteSpace($SuiteOutputDir) -or -not (Test-Path $SuiteOutputDir)) {
        return ''
    }

    $candidate = Get-ChildItem -Path $SuiteOutputDir -Filter 'execution0.log' -File -Recurse -ErrorAction SilentlyContinue |
        Sort-Object LastWriteTime -Descending |
        Select-Object -First 1

    if ($candidate) {
        return $candidate.FullName
    }

    return ''
}

function Get-JUnitSummary {
    param([string]$JunitFile)

    $result = [ordered]@{
        Executed = 0
        Passed   = 0
        Failed   = 0
        Skipped  = 0
        Reason   = ''
        Cases    = @()
    }

    if ([string]::IsNullOrWhiteSpace($JunitFile) -or -not (Test-Path $JunitFile)) {
        return $result
    }

    try {
        [xml]$xml = Get-Content $JunitFile

        $testcases = @()

        if ($xml.testsuite) {
            $testcases = @($xml.testsuite.testcase)
        }
        elseif ($xml.testsuites) {
            foreach ($ts in @($xml.testsuites.testsuite)) {
                $testcases += @($ts.testcase)
            }
        }

        $testcases = @($testcases | Where-Object { $_ })
        $result.Executed = $testcases.Count

        $failedNodes = @($testcases | Where-Object { $_.failure -or $_.error })
        $skippedNodes = @($testcases | Where-Object { $_.skipped })

        $result.Failed = $failedNodes.Count
        $result.Skipped = $skippedNodes.Count
        $result.Passed = $result.Executed - $result.Failed - $result.Skipped

        foreach ($tc in ($testcases | Select-Object -First 5)) {
            $caseName = Short-Text $tc.name 90

            if ($tc.failure -or $tc.error) {
                $msg = ''
                if ($tc.failure) {
                    $msg = Short-Text (($tc.failure.message + ' ' + $tc.failure.InnerText)) 90
                }
                elseif ($tc.error) {
                    $msg = Short-Text (($tc.error.message + ' ' + $tc.error.InnerText)) 90
                }

                $result.Cases += ('❌ ' + $caseName + ' | ' + $msg)
            }
            elseif ($tc.skipped) {
                $result.Cases += ('⏭️ ' + $caseName + ' | skipped')
            }
            else {
                $result.Cases += ('✅ ' + $caseName + ' | passed')
            }
        }

        if ($failedNodes.Count -gt 0) {
            $firstBad = $failedNodes[0]

            if ($firstBad.failure) {
                $result.Reason = Short-Text (($firstBad.failure.message + ' ' + $firstBad.failure.InnerText)) 150
            }
            elseif ($firstBad.error) {
                $result.Reason = Short-Text (($firstBad.error.message + ' ' + $firstBad.error.InnerText)) 150
            }
        }
    }
    catch {
        $result.Reason = Short-Text $_.Exception.Message 150
    }

    return $result
}

function Get-ExecutionStepSummary {
    param([string]$ExecutionLog)

    $steps = New-Object System.Collections.ArrayList

    if ([string]::IsNullOrWhiteSpace($ExecutionLog) -or -not (Test-Path $ExecutionLog)) {
        return @()
    }

    try {
        $lines = Get-Content -Path $ExecutionLog -ErrorAction SilentlyContinue

        foreach ($line in $lines) {
            $text = Clean-Text $line

            if ([string]::IsNullOrWhiteSpace($text)) {
                continue
            }

            if (
                $text -match 'Start scenario' -or
                $text -match 'STEP' -or
                $text -match 'Navigate' -or
                $text -match 'Click' -or
                $text -match 'Import' -or
                $text -match 'Save' -or
                $text -match 'Unable to' -or
                $text -match 'not found' -or
                $text -match 'FAILED' -or
                $text -match 'ERROR'
            ) {
                [void]$steps.Add((Short-Text $text 180))
            }
        }
    }
    catch {
    }

    if ($steps.Count -gt 10) {
        return @($steps | Select-Object -Last 10)
    }

    return @($steps)
}

function Write-SyntheticJunit {
    param(
        [string]$FilePath,
        [string]$SuiteName,
        [string]$Reason
    )

    $escapedReason = [System.Security.SecurityElement]::Escape($Reason)
    if ([string]::IsNullOrWhiteSpace($escapedReason)) {
        $escapedReason = 'Suite failed without JUnit report'
    }

    $xml = @"
<?xml version="1.0" encoding="UTF-8"?>
<testsuite name="$SuiteName" tests="1" failures="1" errors="0" skipped="0">
  <testcase classname="$SuiteName" name="$SuiteName">
    <failure message="$escapedReason">$escapedReason</failure>
  </testcase>
</testsuite>
"@

    Set-Content -Path $FilePath -Value $xml -Encoding UTF8
}

$SuiteStartedAt = Get-Date
$LogsDir = Join-Path $env:REPORTS_ROOT 'logs'
$MetaFile = Join-Path $LogsDir ($env:SUITE_KEY + '.meta.properties')
$SyntheticJunit = Join-Path $LogsDir ($env:SUITE_KEY + '.junit.xml')
$TaskLog = Join-Path $LogsDir ($env:SUITE_KEY + '.task.log')

if (-not (Test-Path $LogsDir)) {
    New-Item -ItemType Directory -Path $LogsDir -Force | Out-Null
}

Remove-Item $MetaFile -Force -ErrorAction SilentlyContinue
Remove-Item $SyntheticJunit -Force -ErrorAction SilentlyContinue
Remove-Item $TaskLog -Force -ErrorAction SilentlyContinue

$fullTaskName = if ([string]::IsNullOrWhiteSpace($env:TASK_FOLDER)) { $env:TASK_NAME } else { $env:TASK_FOLDER + '\\' + $env:TASK_NAME }
$winDriverTask = $env:WIN_DRIVER_TASK
$timeoutAt = (Get-Date).AddMinutes([int]$env:SUITE_TIMEOUT_MINUTES)
$pollSeconds = [int]$env:POLL_SECONDS
$exitCode = 0
$status = 'PASSED'
$icon = '✅'
$reason = ''
$taskLastRunResult = ''
$lastPrintedSecond = -1

Write-Host '------------------------------------------------------------'
Write-Host ('🚀 SUITE START | ' + $env:SUITE_NAME)
Write-Host ('🖥️ TASK       | ' + $fullTaskName)
Write-Host ('🧰 WINDRIVER  | ' + $winDriverTask)
Write-Host ('📂 REPORTS    | ' + $env:REPORTS_ROOT)
Write-Host '------------------------------------------------------------'

try {
    if (-not [string]::IsNullOrWhiteSpace($winDriverTask)) {
        Write-Host ('[INFO] Starting WinDriver task: ' + $winDriverTask)
        Start-SafeScheduledTask -TaskName $winDriverTask
        Start-Sleep -Seconds 3
    }

    Write-Host ('[INFO] Starting desktop task: ' + $fullTaskName)
    Start-SafeScheduledTask -TaskName $fullTaskName
    Start-Sleep -Seconds 3

    while ($true) {
        $taskState = Read-TaskStatus -TaskFullName $fullTaskName
        $taskLastRunResult = $taskState.LastRunResult

        $elapsed = [int]((Get-Date) - $SuiteStartedAt).TotalSeconds
        if ($elapsed -ge 0 -and ($elapsed % 30 -eq 0) -and $lastPrintedSecond -ne $elapsed) {
            Write-Host ('[INFO] Task status: ' + $taskState.Status + ' | elapsed=' + $elapsed + 's')
            $lastPrintedSecond = $elapsed
        }

        if ((Get-Date) -ge $timeoutAt) {
            Write-Host ('[TIMEOUT] Suite exceeded ' + $env:SUITE_TIMEOUT_MINUTES + ' minutes')
            End-SafeScheduledTask -TaskName $fullTaskName
            $exitCode = 124
            break
        }

        if ($taskState.Status -ne 'Running') {
            $exitCode = Parse-TaskExitCode -Value $taskLastRunResult
            break
        }

        Start-Sleep -Seconds $pollSeconds
    }
}
catch {
    $exitCode = 1
    $reason = Short-Text $_.Exception.Message 150
}
finally {
    if (-not [string]::IsNullOrWhiteSpace($winDriverTask)) {
        Write-Host ('[INFO] Stopping WinDriver task: ' + $winDriverTask)
        End-SafeScheduledTask -TaskName $winDriverTask
    }
}

$SuiteOutputDir = Find-SuiteOutputDir -Root $env:REPORTS_ROOT -StartedAt $SuiteStartedAt
$junitFile = Find-LatestJUnit -SuiteOutputDir $SuiteOutputDir
$executionLog = Find-LatestExecutionLog -SuiteOutputDir $SuiteOutputDir
$firstScreenshot = Find-BestScreenshot -SuiteOutputDir $SuiteOutputDir
$junitSummary = Get-JUnitSummary -JunitFile $junitFile
$stepSummary = Get-ExecutionStepSummary -ExecutionLog $executionLog

if ($exitCode -eq 124) {
    $status = 'TIMEOUT'
    $icon = '⏰'
}
elseif ($junitSummary.Failed -gt 0 -or $exitCode -ne 0) {
    $status = 'FAILED'
    $icon = '❌'
}

if ([string]::IsNullOrWhiteSpace($reason)) {
    $reason = $junitSummary.Reason
}

if ([string]::IsNullOrWhiteSpace($reason) -and $status -eq 'TIMEOUT') {
    $reason = 'Suite execution exceeded timeout'
}

if ([string]::IsNullOrWhiteSpace($reason) -and $status -eq 'FAILED') {
    if ($exitCode -ne 0) {
        $reason = 'Desktop scheduled task finished with non-zero result'
    }
    else {
        $reason = 'Suite failed without explicit reason in JUnit'
    }
}

if (([string]::IsNullOrWhiteSpace($junitFile) -or -not (Test-Path $junitFile)) -and $status -ne 'PASSED') {
    Write-SyntheticJunit -FilePath $SyntheticJunit -SuiteName $env:SUITE_NAME -Reason $reason
}

$screenshotRel = To-RelativePath -Root $env:REPORTS_ROOT -FullPath $firstScreenshot
$logRel = To-RelativePath -Root $env:REPORTS_ROOT -FullPath $executionLog
$durationSeconds = [math]::Max(0, [int]((Get-Date) - $SuiteStartedAt).TotalSeconds)

$taskLogLines = @()
$taskLogLines += ('TASK_FULL_NAME=' + $fullTaskName)
$taskLogLines += ('LAST_RUN_RESULT=' + $taskLastRunResult)
$taskLogLines += ('EXIT_CODE=' + $exitCode)
Set-Content -Path $TaskLog -Value $taskLogLines -Encoding UTF8

$metaLines = @()
$metaLines += ('SUITE_NAME=' + $env:SUITE_NAME)
$metaLines += ('TASK_NAME=' + $env:TASK_NAME)
$metaLines += ('STATUS=' + $status)
$metaLines += ('ICON=' + $icon)
$metaLines += ('EXIT_CODE=' + $exitCode)
$metaLines += ('DURATION_SECONDS=' + $durationSeconds)
$metaLines += ('EXECUTED=' + $junitSummary.Executed)
$metaLines += ('PASSED=' + $junitSummary.Passed)
$metaLines += ('FAILED=' + $junitSummary.Failed)
$metaLines += ('SKIPPED=' + $junitSummary.Skipped)
$metaLines += ('REASON=' + (Short-Text $reason 150))
$metaLines += ('SCREENSHOT_REL=' + $screenshotRel)
$metaLines += ('LOG_REL=' + $logRel)
$metaLines += ('CASE_SUMMARY=' + (($junitSummary.Cases -join ' || ')))
$metaLines += ('STEP_SUMMARY=' + (($stepSummary -join ' || ')))

Set-Content -Path $MetaFile -Value $metaLines -Encoding UTF8

Write-Host '------------------------------------------------------------'
Write-Host ('🏁 SUITE END   | ' + $env:SUITE_NAME)
Write-Host ('📌 STATUS      | ' + $status)
Write-Host ('🖥️ TASK        | ' + $fullTaskName)
Write-Host ('⏱️ DURATION    | ' + $durationSeconds + ' seconds')
Write-Host ('📊 EXECUTED    | ' + $junitSummary.Executed)
Write-Host ('✅ PASSED      | ' + $junitSummary.Passed)
Write-Host ('❌ FAILED      | ' + $junitSummary.Failed)
Write-Host ('⏭️ SKIPPED     | ' + $junitSummary.Skipped)
Write-Host ('🔢 EXIT CODE   | ' + $exitCode)
if (-not [string]::IsNullOrWhiteSpace($reason)) {
    Write-Host ('🧾 REASON      | ' + $reason)
}
if (-not [string]::IsNullOrWhiteSpace($screenshotRel)) {
    Write-Host ('🖼️ SCREENSHOT  | Reports/' + $screenshotRel)
}
if (-not [string]::IsNullOrWhiteSpace($logRel)) {
