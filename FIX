    /*
     * Overload kept on purpose to avoid the exact mismatch shown in your screenshot.
     */
    @Keyword
    def startMatch() {
        String currentUser = getCurrentWindowsUser()
        String targetWindowTitle = resolveWindowTitle()
        return startMatch(currentUser, targetWindowTitle)
    }

    @Keyword
    def startMatch(String currentUser, String targetWindowTitle) {
        KeywordUtil.logInfo("Starting eMatch for environment ${safeEnv()}")
        KeywordUtil.logInfo("Current Windows user: ${currentUser}")
        KeywordUtil.logInfo("Target window title: ${targetWindowTitle}")
        KeywordUtil.logInfo("Shortcut path = ${getShortcutPath()}")
        KeywordUtil.logInfo("Application path = ${getApplicationPath()}")
        KeywordUtil.logInfo("Installed exe path = ${getInstalledExePath()}")
        KeywordUtil.logInfo("Launcher bat = ${getLauncherBat()}")
        KeywordUtil.logInfo("WinAppDriver path = ${getWinAppDriverPath()}")

        closeAppDriverQuietly()
        closeRootDriverQuietly()

        killExistingEmatchProcesses()
        ensureWinAppDriver()

        String launchTarget = resolveLaunchTarget()
        if (!launchTarget) {
            KeywordUtil.markFailedAndStop('No valid eMatch launch target was found.')
        }

        launchApplication(launchTarget)

        String foundTitle = waitForAnyWindowTitle([
            targetWindowTitle,
            'eMatch 26.1.1.3',
            'eMatch'
        ], APP_START_TIMEOUT_SECONDS)

        if (!foundTitle) {
            KeywordUtil.markFailedAndStop("eMatch did not open. Expected title ${targetWindowTitle}")
        }

        KeywordUtil.logInfo("Main window title detected = ${foundTitle}")
        activateWindow(foundTitle)

        return true
    }

    @Keyword
    def attachToLoginWindow() {
        return attachToLoginWindow(resolveWindowTitle())
    }

    @Keyword
    def attachToLoginWindow(String targetWindowTitle) {
        KeywordUtil.logInfo("Attaching to login window. Expected title ${targetWindowTitle}")

        closeAppDriverQuietly()
        ensureWinAppDriver()

        String foundTitle = waitForAnyWindowTitle([
            targetWindowTitle,
            'eMatch 26.1.1.3',
            'eMatch'
        ], TITLE_WAIT_SECONDS)

        if (!foundTitle) {
            KeywordUtil.markFailedAndStop("Could not find eMatch window title. Expected ${targetWindowTitle}")
        }

        activateWindow(foundTitle)

        String handle = findWindowHandleByTitle(foundTitle)
        if (!handle) {
            KeywordUtil.markFailedAndStop("Could not resolve NativeWindowHandle for ${foundTitle}")
        }

        KeywordUtil.logInfo("Detected main window title at handle ${handle}")

        appDriver = createDriverByTopLevelHandle(handle)

        if (!waitForLoginWindowReady(LOGIN_WAIT_SECONDS)) {
            closeAppDriverQuietly()
            activateWindow(foundTitle)
            sleepSeconds(2)

            handle = findWindowHandleByTitle(foundTitle)
            if (!handle) {
                KeywordUtil.markFailedAndStop("Could not re-resolve NativeWindowHandle for ${foundTitle}")
            }

            appDriver = createDriverByTopLevelHandle(handle)

            if (!waitForLoginWindowReady(LOGIN_WAIT_SECONDS)) {
                KeywordUtil.markFailedAndStop("App opened but login controls were not found inside ${foundTitle}")
            }
        }

        KeywordUtil.logInfo('Attached to eMatch login window successfully.')
        return true
    }

    @Keyword
    def openEnvironmentDropdown() {
        ensureAppDriver()

        List<WebElement> comboBoxes = findComboBoxes()
        if (comboBoxes.isEmpty()) {
            KeywordUtil.markFailedAndStop('Environment combo box was not found.')
        }

        comboBoxes[0].click()
        sleepSeconds(1)
        return true
    }

    @Keyword
    int resolveEnvironmentIndex(String envName) {
        String env = safeUpper(envName)

        switch (env) {
            case 'PROD':
                return 0
            case 'PREPO':
            case 'PREPRO':
                return 1
            case 'RECQ':
                return 2
            case 'REC':
                return 3
            case 'DEV2':
                return 4
            case 'DEV':
                return 5
            default:
                return 3
        }
    }

    @Keyword
    def selectEnvironment(String envName) {
        ensureAppDriver()

        List<WebElement> comboBoxes = findComboBoxes()
        if (comboBoxes.isEmpty()) {
            KeywordUtil.markFailedAndStop('No combo box found to select environment.')
        }

        String displayValue = environmentDisplayValue(envName)
        WebElement combo = comboBoxes[0]

        combo.click()
        sleepSeconds(1)
        combo.sendKeys(Keys.chord(Keys.CONTROL, 'a'))
        combo.sendKeys(displayValue)
        sleepSeconds(1)
        combo.sendKeys(Keys.ENTER)
        sleepSeconds(1)

        KeywordUtil.logInfo("Environment selected = ${displayValue}")
        return true
    }

    @Keyword
    boolean isConnectButtonPresent() {
        ensureAppDriver()
        return findConnectButton() != null
    }

    @Keyword
    def clickConnectButton() {
        ensureAppDriver()

        WebElement connectButton = findConnectButton()
        if (connectButton == null) {
            KeywordUtil.markFailedAndStop('Connect button was not found.')
        }

        connectButton.click()
        sleepSeconds(1)
        return true
    }

    @Keyword
    boolean waitForMainScreen() {
        ensureAppDriver()

        for (int i = 1; i <= APP_START_TIMEOUT_SECONDS; i++) {
            if (findConnectButton() == null) {
                if (hasElementByName('Accueil') || hasElementByName('Rafraîchir') || hasElementByName('Refresh')) {
                    KeywordUtil.logInfo("Main screen detected at attempt ${i}")
                    return true
                }
            }
            sleepSeconds(1)
        }

        return false
    }

    @Keyword
    def activateHomeTab() {
        ensureAppDriver()

        WebElement home = findFirstElementByNames(['Accueil', 'Home'])
        if (home != null) {
            home.click()
            sleepSeconds(1)
        }

        return true
    }

    private static String safeEnv() {
        try {
            String env = (GlobalVariable.env ?: '').toString().trim().toUpperCase()
            return env ? env : 'REC'
        } catch (Throwable ignored) {
            return 'REC'
        }
    }

    private static String safeUpper(String value) {
        return value == null ? '' : value.trim().toUpperCase()
    }

    private static String environmentDisplayValue(String envName) {
        String env = safeUpper(envName)

        switch (env) {
            case 'PROD':
                return 'Production (PROD)'
            case 'PREPO':
            case 'PREPRO':
                return 'Bench (PREPO)'
            case 'RECQ':
                return 'Qualification (RECQ)'
            case 'REC':
                return 'Recette (REC)'
            case 'DEV2':
                return 'Simulation (DEV2)'
            case 'DEV':
                return 'Development (DEV)'
            default:
                return 'Recette (REC)'
        }
    }

    private static String firstExisting(List<String> candidates) {
        for (String candidate : candidates) {
            if (candidate && new File(candidate).exists()) {
                return candidate
            }
        }
        return ''
    }

    private static String findInstalledExePath() {
        String localAppData = System.getenv('LOCALAPPDATA')
        if (!localAppData) {
            return ''
        }

        File baseDir = new File(localAppData, 'Apps\\2.0')
        if (!baseDir.exists()) {
            return ''
        }

        String found = ''

        try {
            baseDir.eachFileRecurse(FileType.FILES) { File file ->
                if (!found && file.name.equalsIgnoreCase('IXIS.eMatch.IHM.exe')) {
                    found = file.absolutePath
                }
            }
        } catch (Throwable ignored) {
            found = ''
        }

        return found ?: ''
    }

    private static String resolveLaunchTarget() {
        String installedExe = findInstalledExePath()
        if (installedExe) {
            return installedExe
        }

        String shortcut = new authentication().getShortcutPath()
        if (shortcut) {
            return shortcut
        }

        String launcherBat = new authentication().getLauncherBat()
        if (launcherBat) {
            return launcherBat
        }

        String applicationPath = new authentication().getApplicationPath()
        if (applicationPath) {
            return applicationPath
        }

        return ''
    }

    private static void launchApplication(String launchTarget) {
        KeywordUtil.logInfo("Launching eMatch using ${launchTarget}")

        if (launchTarget.toLowerCase().endsWith('.bat')) {
            new ProcessBuilder('cmd.exe', '/c', 'call', launchTarget).start()
        } else {
            new ProcessBuilder('cmd.exe', '/c', 'start', '""', launchTarget).start()
        }

        sleepSeconds(2)
    }

    private static void killExistingEmatchProcesses() {
        List<List<String>> commands = [
            ['cmd.exe', '/c', 'taskkill /F /IM IXIS.eMatch.IHM.exe /T'],
            ['cmd.exe', '/c', 'taskkill /F /IM eMatch.exe /T']
        ]

        commands.each { List<String> cmd ->
            try {
                new ProcessBuilder(cmd).start().waitFor()
            } catch (Throwable ignored) {
            }
        }

        sleepSeconds(2)
    }

    private static void ensureWinAppDriver() {
        if (isPortOpen('127.0.0.1', WINAPPDRIVER_PORT, 1000)) {
            KeywordUtil.logInfo("WinAppDriver already running on ${WINAPPDRIVER_URL}")
            return
        }

        String winAppDriverPath = new authentication().getWinAppDriverPath()
        if (!winAppDriverPath) {
            KeywordUtil.markFailedAndStop('WinAppDriver.exe was not found.')
        }

        KeywordUtil.logInfo("Starting WinAppDriver from ${winAppDriverPath}")
        new ProcessBuilder('cmd.exe', '/c', 'start', '""', '/min', winAppDriverPath).start()

        for (int i = 1; i <= 20; i++) {
            if (isPortOpen('127.0.0.1', WINAPPDRIVER_PORT, 1000)) {
                KeywordUtil.logInfo("WinAppDriver is ready on 127.0.0.1:${WINAPPDRIVER_PORT} at attempt ${i}")
                return
            }
            sleepSeconds(1)
        }

        KeywordUtil.markFailedAndStop('WinAppDriver did not start on port 4723.')
    }

    private static boolean isPortOpen(String host, int port, int timeoutMillis) {
        try {
            Socket socket = new Socket()
            socket.connect(new InetSocketAddress(host, port), timeoutMillis)
            socket.close()
            return true
        } catch (Throwable ignored) {
            return false
        }
    }

    private static WindowsDriver<WebElement> createRootSession() {
        DesiredCapabilities capabilities = new DesiredCapabilities()
        capabilities.setCapability('app', 'Root')

        WindowsDriver<WebElement> driver = new WindowsDriver<WebElement>(new URL(WINAPPDRIVER_URL), capabilities)
        driver.manage().timeouts().implicitlyWait(1, TimeUnit.SECONDS)
        return driver
    }

    private static WindowsDriver<WebElement> createDriverByTopLevelHandle(String nativeHandle) {
        String normalizedHandle = normalizeHandle(nativeHandle)

        DesiredCapabilities capabilities = new DesiredCapabilities()
        capabilities.setCapability('appTopLevelWindow', normalizedHandle)
        capabilities.setCapability('ms:waitForAppLaunch', '60')

        WindowsDriver<WebElement> driver = new WindowsDriver<WebElement>(new URL(WINAPPDRIVER_URL), capabilities)
        driver.manage().timeouts().implicitlyWait(1, TimeUnit.SECONDS)
        return driver
    }

    private static String normalizeHandle(String handle) {
        String value = (handle ?: '').trim()
        if (!value) {
            return ''
        }

        if (value.toLowerCase().startsWith('0x')) {
            value = value.substring(2)
        } else {
            try {
                value = Long.toHexString(Long.parseLong(value))
            } catch (Throwable ignored) {
            }
        }

        return value.toUpperCase()
    }

    private static String waitForAnyWindowTitle(List<String> titles, int timeoutSeconds) {
        closeRootDriverQuietly()
        rootDriver = createRootSession()

        for (int round = 1; round <= timeoutSeconds; round++) {
            for (String title : titles) {
                if (!title?.trim()) {
                    continue
                }

                List<WebElement> found = safeFindElements(rootDriver, By.name(title))
                if (!found.isEmpty()) {
                    KeywordUtil.logInfo("Detected main window title at attempt ${round}: ${title}")
                    return title
                }
            }
            sleepSeconds(1)
        }

        return ''
    }

    private static String findWindowHandleByTitle(String title) {
        if (!rootDriver) {
            rootDriver = createRootSession()
        }

        List<WebElement> found = safeFindElements(rootDriver, By.name(title))
        if (found.isEmpty()) {
            return ''
        }

        try {
            return (found[0].getAttribute('NativeWindowHandle') ?: '').trim()
        } catch (Throwable ignored) {
            return ''
        }
    }

    private static void activateWindow(String title) {
        if (!title?.trim()) {
            return
        }

        try {
            String ps = "\$ws = New-Object -ComObject WScript.Shell; [void]\$ws.AppActivate('${title}')"
            new ProcessBuilder('powershell.exe', '-NoProfile', '-ExecutionPolicy', 'Bypass', '-Command', ps).start().waitFor()
            sleepSeconds(1)
        } catch (Throwable ignored) {
        }
    }

    private static boolean waitForLoginWindowReady(int timeoutSeconds) {
        for (int i = 1; i <= timeoutSeconds; i++) {
            List<WebElement> comboBoxes = findComboBoxes()
            WebElement connectButton = findConnectButton()

            if (!comboBoxes.isEmpty() && connectButton != null) {
                KeywordUtil.logInfo("Login window detected at attempt ${i}")
                return true
            }

            sleepSeconds(1)
        }

        return false
    }

    private static List<WebElement> findComboBoxes() {
        if (appDriver == null) {
            return []
        }

        List<WebElement> found = safeFindElements(appDriver, By.className('ComboBox'))
        if (!found.isEmpty()) {
            return found
        }

        found = safeFindElements(appDriver, By.xpath("//*[contains(@ClassName,'ComboBox')]"))
        if (!found.isEmpty()) {
            return found
        }

        return []
    }

    private static WebElement findConnectButton() {
        if (appDriver == null) {
            return null
        }

        WebElement button = findFirstElementByNames([
            'Se connecter',
            'Connect'
        ])

        if (button != null) {
            return button
        }

        List<WebElement> buttons = safeFindElements(appDriver, By.className('Button'))
        for (WebElement current : buttons) {
            try {
                String name = (current.getAttribute('Name') ?: '').trim().toLowerCase()
                if (name.contains('connect')) {
                    return current
                }
            } catch (Throwable ignored) {
            }
        }

        return null
    }

    private static WebElement findFirstElementByNames(List<String> names) {
        if (appDriver == null) {
            return null
        }

        for (String name : names) {
            List<WebElement> found = safeFindElements(appDriver, By.name(name))
            if (!found.isEmpty()) {
                return found[0]
            }
        }

        return null
    }

    private static boolean hasElementByName(String name) {
        if (appDriver == null) {
            return false
        }

        return !safeFindElements(appDriver, By.name(name)).isEmpty()
    }

    private static List<WebElement> safeFindElements(WindowsDriver<WebElement> driver, By by) {
        try {
            List<WebElement> elements = driver.findElements(by)
            return elements ?: []
        } catch (Throwable ignored) {
            return []
        }
    }

    private static void ensureAppDriver() {
        if (appDriver == null) {
            KeywordUtil.markFailedAndStop('App driver session is not initialized.')
        }
    }

    private static void closeAppDriverQuietly() {
        if (appDriver != null) {
            try {
                appDriver.quit()
            } catch (Throwable ignored) {
            }
            appDriver = null
        }
    }

    private static void closeRootDriverQuietly() {
        if (rootDriver != null) {
            try {
                rootDriver.quit()
            } catch (Throwable ignored) {
            }
            rootDriver = null
        }
    }

    private static void sleepSeconds(int seconds) {
        try {
            Thread.sleep(seconds * 1000L)
        } catch (Throwable ignored) {
        }
    }
}
