				'Image could not be clicked.\n' +
				'Image: ' + relativePath + '\n' +
				'Reason: ' + safeText(error.message)
			)
		}
	}

	private void rightClickImageOrStop(String relativePath) {
		String imagePath = image(relativePath)

		try {
			WindowsImageKeywords.rightClickImage(imagePath)
		} catch (Throwable error) {
			KeywordUtil.markFailedAndStop(
				'Image could not be right clicked.\n' +
				'Image: ' + relativePath + '\n' +
				'Reason: ' + safeText(error.message)
			)
		}
	}

	private void typeOnImageOrStop(
		String relativePath,
		String text
	) {
		String imagePath = image(relativePath)

		try {
			WindowsImageKeywords.typeOnImage(
				imagePath,
				text
			)
		} catch (Throwable error) {
			KeywordUtil.markFailedAndStop(
				'Text could not be entered using the image.\n' +
				'Image: ' + relativePath + '\n' +
				'Text: ' + text + '\n' +
				'Reason: ' + safeText(error.message)
			)
		}
	}

	private boolean isImageVisible(String relativePath) {
		String imagePath = image(relativePath)

		try {
			def found = WindowsImageKeywords.findImage(imagePath)
			return found != null && found != false
		} catch (Throwable ignored) {
			return false
		}
	}

	private String image(String requestedKey) {
		String key = safeText(requestedKey)

		if (key.isEmpty()) {
			KeywordUtil.markFailedAndStop('Image key is empty.')
		}

		Map<String, String> aliases = [
			'filterBtn'       : 'filterButton',
			'textFilter'      : 'textFilterFR',
			'closeFiltersBtn' : 'closeFiltersButtonFR',
			'deleteFavoriteBtn': 'deleteFavoriteButton',
			'frenchSetting'   : 'frenchOption',
			'english'         : 'englishOption'
		]

		String resolvedKey = aliases.containsKey(key)
			? aliases[key]
			: key

		Set<String> generalKeys = [
			'configs',
			'closeTabs',
			'settings',
			'home'
		] as Set<String>

		String groupName = generalKeys.contains(resolvedKey)
			? 'General'
			: 'guiBehavior'

		Map<String, String> images = ImageLoader.getImages(groupName)
		String configuredPath = safeText(images[resolvedKey])

		if (configuredPath.isEmpty()) {
			KeywordUtil.markFailedAndStop(
				'Image key was not found in ImageLoader.\n' +
				'Group: ' + groupName + '\n' +
				'Key: ' + resolvedKey
			)
		}

		File configuredFile = new File(configuredPath)
		File imageFile = configuredFile.isAbsolute()
			? configuredFile
			: new File(RunConfiguration.getProjectDir(), configuredPath)

		if (!imageFile.exists() || !imageFile.isFile()) {
			KeywordUtil.markFailedAndStop(
				'Image file was not found.\n' +
				'Group: ' + groupName + '\n' +
				'Key: ' + resolvedKey + '\n' +
				'Configured path: ' + configuredPath + '\n' +
				'Resolved path: ' + imageFile.getAbsolutePath()
			)
		}

		return imageFile.getAbsolutePath()
	}

	private WindowsTestObject object(String objectKey) {
		String key = safeText(objectKey)

		if (key.isEmpty()) {
			KeywordUtil.markFailedAndStop('Windows object key is empty.')
		}

		String groupName = key == 'searchBox'
			? 'menu'
			: 'guiBehavior'

		WindowsTestObject testObject = WindowsObjectLoader.getObject(
			groupName,
			key
		)

		if (testObject == null) {
			KeywordUtil.markFailedAndStop(
				'Object key was not found in WindowsObjectLoader.\n' +
				'Group: ' + groupName + '\n' +
				'Key: ' + key
			)
		}

		return testObject
	}

	private List<String> getDownloadedFiles() {
		List<String> files = []

		if (GlobalVariable.compareFiles instanceof Collection) {
			files.addAll(
				(GlobalVariable.compareFiles as Collection).collect {
					Object value -> safeText(value)
				}.findAll {
					String value -> !value.isEmpty()
				}
			)
		}

		return files
	}

	private File resolveDownloadedFile(String storedValue) {
		File directFile = new File(storedValue)

		if (directFile.isAbsolute()) {
			return directFile
		}

		File evidenceFolder = new File(
			RunConfiguration.getReportFolder(),
			'Evidences'
		)

		return new File(evidenceFolder, storedValue)
	}


	// ======================================================
	// PRIVATE GENERIC HELPERS
	// ======================================================

	private BigDecimal parseNumber(
		String numericText,
		boolean integerOnly
	) {
		String clean = safeText(numericText)
			.replace(' ', '')
			.replace(',', '.')

		if (integerOnly && !(clean ==~ /[-+]?\d+/)) {
			return null
		}

		try {
			return new BigDecimal(clean)
		} catch (Throwable ignored) {
			return null
		}
	}

	private String normalizeComparableText(String value) {
		String text = safeText(value)

		return Normalizer.normalize(
			text,
			Normalizer.Form.NFD
		)
		.replaceAll('\\p{InCombiningDiacriticalMarks}+', '')
		.toLowerCase()
		.replaceAll('[^a-z0-9]+', ' ')
		.trim()
		.replaceAll('\\s+', ' ')
	}

	private void validateNotEmpty(
		List<String> values,
		Integer index,
		String errorMessage,
		List<String> errors
	) {
		if (valueAt(values, index).isEmpty()) {
			errors.add(errorMessage)
		}
	}

	private String valueAt(
		List<String> values,
		Integer index
	) {
		if (values == null || index == null) {
			return ''
		}

		if (index < 0 || index >= values.size()) {
			return ''
		}

		return safeText(values[index])
	}

	private void failIfErrors(
		String title,
		List<String> errors
	) {
		if (errors == null || errors.isEmpty()) {
			return
		}

		String message = title + '\n' +
			errors.collect {
				String error -> '- ' + error
			}.join('\n')

		KeywordUtil.markFailedAndStop(message)
	}

	private boolean isFrench(String language) {
		return safeText(language).equalsIgnoreCase('fr')
	}

	private int safeTimeout(
		Integer value,
		Integer defaultValue
	) {
		if (value == null || value <= 0) {
			return defaultValue
		}

		return value
	}

	private String safeText(Object value) {
		if (value == null) {
			return ''
		}

		return value.toString().trim()
	}
}






































