class RecPrdExportValidationKeywords {

	@Keyword
	Map validateLatestRecPrdExport(
			String exportRootFolder,
			String exportGroupFolder,
			String exportFeatureFolder,
			Integer columnIndex,
			String expectedColumnName) {

		return validateLatestRecPrdExportInternal(
				exportRootFolder,
				exportGroupFolder,
				exportFeatureFolder,
				columnIndex,
				expectedColumnName,
				false
				)
	}


	@Keyword
	Map validateLatestRecPrdExportTreatBlankAsZero(
			String exportRootFolder,
			String exportGroupFolder,
			String exportFeatureFolder,
			Integer columnIndex,
			String expectedColumnName) {

		return validateLatestRecPrdExportInternal(
				exportRootFolder,
				exportGroupFolder,
				exportFeatureFolder,
				columnIndex,
				expectedColumnName,
				true
				)
	}


	private Map validateLatestRecPrdExportInternal(
			String exportRootFolder,
			String exportGroupFolder,
			String exportFeatureFolder,
			Integer columnIndex,
			String expectedColumnName,
			boolean treatBlankCellsAsZero) {

		Map result = createEmptyResult(
				exportRootFolder,
				exportGroupFolder,
				exportFeatureFolder,
				columnIndex,
				expectedColumnName,
				treatBlankCellsAsZero
				)

		StringBuilder errors = new StringBuilder()
		StringBuilder passedDetails = new StringBuilder()

		File recFile = null
		File prdFile = null

		try {
			File exportRoot = new File(safeText(exportRootFolder))
			int validatedColumnIndex =
					columnIndex == null
					? -1
					: columnIndex.intValue()

			if (!exportRoot.exists()) {
				errors.append('[ERROR] Export root folder does not exist.\n')
						.append('Folder: ')
						.append(exportRoot.getAbsolutePath())

				return finalizeResult(
						result,
						errors,
						passedDetails
						)
			}

			if (!exportRoot.isDirectory()) {
				errors.append('[ERROR] Export root path is not a folder.\n')
						.append('Path: ')
						.append(exportRoot.getAbsolutePath())

				return finalizeResult(
						result,
						errors,
						passedDetails
						)
			}

			if (validatedColumnIndex < 0) {
				errors.append('[ERROR] Invalid column index.\n')
						.append('Column index: ')
						.append(validatedColumnIndex)

				return finalizeResult(
						result,
						errors,
						passedDetails
						)
			}

			KeywordUtil.logInfo(
					'[REC X PRD SEARCH] root=' +
					exportRoot.getAbsolutePath() +
					' | group=' +
					safeText(exportGroupFolder) +
					' | feature=' +
					safeText(exportFeatureFolder)
					)

			Map selectedFiles = resolveLatestRecPrdFiles(
					exportRoot,
					exportGroupFolder,
					exportFeatureFolder
					)

			recFile = selectedFiles.recFile as File
			prdFile = selectedFiles.prdFile as File

			File selectedFolder =
					selectedFiles.selectedFolder as File

			result.recFileName =
					recFile == null
					? 'NOT FOUND'
					: recFile.getName()

			result.prdFileName =
					prdFile == null
					? 'NOT FOUND'
					: prdFile.getName()

			result.selectedFolderPath =
					selectedFolder == null
					? ''
					: selectedFolder.getAbsolutePath()

			result.filesResolved =
					recFile != null &&
					prdFile != null &&
					selectedFolder != null

			if (recFile == null) {
				errors.append('[ERROR] REC exported file was not found.\n')
						.append('Search root: ')
						.append(exportRoot.getAbsolutePath())
						.append('\nExpected folder: ')
						.append(safeText(exportGroupFolder))
						.append('\\')
						.append(safeText(exportFeatureFolder))
						.append('\n')
			}

			if (prdFile == null) {
				errors.append('[ERROR] PRD exported file was not found.\n')
						.append('Search root: ')
						.append(exportRoot.getAbsolutePath())
						.append('\nExpected folder: ')
						.append(safeText(exportGroupFolder))
						.append('\\')
						.append(safeText(exportFeatureFolder))
						.append('\n')
			}

			if (errors.length() > 0) {
				return finalizeResult(
						result,
						errors,
						passedDetails
						)
			}

			KeywordUtil.logInfo(
					'[REC X PRD SEARCH] selectedFolder=' +
					selectedFolder.getAbsolutePath() +
					' | REC=' +
					recFile.getName() +
					' | PRD=' +
					prdFile.getName()
					)

			Map recData = readFileData(
					recFile,
					validatedColumnIndex,
					expectedColumnName,
					'REC',
					treatBlankCellsAsZero
					)

			System.gc()

			Map prdData = readFileData(
					prdFile,
					validatedColumnIndex,
					expectedColumnName,
					'PRD',
					treatBlankCellsAsZero
					)

			System.gc()

			result.recColumnName = safeText(recData.columnName)
			result.prdColumnName = safeText(prdData.columnName)

			result.columnName =
					!safeText(recData.columnName).isEmpty()
					? safeText(recData.columnName)
					: safeText(expectedColumnName)

			result.recRows = recData.rows
			result.prdRows = prdData.rows
			result.recHeaders = recData.headers
			result.prdHeaders = prdData.headers
			result.recHeaderCount = recData.headerCount
			result.prdHeaderCount = prdData.headerCount
			result.recNumericValues = recData.numericValues
			result.prdNumericValues = prdData.numericValues
			result.recZeroValues = recData.zeroValues
			result.prdZeroValues = prdData.zeroValues
			result.recNonZeroValues = recData.nonZeroValues
			result.prdNonZeroValues = prdData.nonZeroValues
			result.recBlankValues = recData.blankValues
			result.prdBlankValues = prdData.blankValues
			result.recBlankValuesTreatedAsZero =
					recData.blankValuesTreatedAsZero
			result.prdBlankValuesTreatedAsZero =
					prdData.blankValuesTreatedAsZero
			result.recUnreadableValues = recData.unreadableValues
			result.prdUnreadableValues = prdData.unreadableValues
			result.recNonNumericDigest = recData.nonNumericDigest
			result.prdNonNumericDigest = prdData.nonNumericDigest
			result.recNonNumericRawDigest = recData.nonNumericRawDigest
			result.prdNonNumericRawDigest = prdData.nonNumericRawDigest
			result.recNonNumericValueCounts = recData.nonNumericValueCounts
			result.prdNonNumericValueCounts = prdData.nonNumericValueCounts
			result.recNonNumericSamples = recData.nonNumericSamples
			result.prdNonNumericSamples = prdData.nonNumericSamples
			result.recUnreadableSamples = recData.unreadableSamples
			result.prdUnreadableSamples = prdData.unreadableSamples
			result.recOnlyZeroValues = recData.onlyZeroValues
			result.prdOnlyZeroValues = prdData.onlyZeroValues
			result.recColumnStatus = recData.columnStatus
			result.prdColumnStatus = prdData.columnStatus
			result.recSum = recData.sum
			result.prdSum = prdData.sum
			result.recMinimum = recData.minimum
			result.prdMinimum = prdData.minimum
			result.recMaximum = recData.maximum
			result.prdMaximum = prdData.maximum
			result.excelAnalysisCompleted = true
			result.validationMode = 'FULL_COLUMN_VALIDATION'

			if (!safeText(recData.errors).isEmpty()) {
				errors.append(safeText(recData.errors)).append('\n')
			}

			if (!safeText(prdData.errors).isEmpty()) {
				errors.append(safeText(prdData.errors)).append('\n')
			}

			if (errors.length() > 0) {
				return finalizeResult(result, errors, passedDetails)
			}

			if (!normalizeText(result.recColumnName).equals(
					normalizeText(result.prdColumnName))) {

				errors.append(
						'[ERROR] REC and PRD column headers are different.\n'
						)
						.append('REC: ')
						.append(result.recColumnName)
						.append('\nPRD: ')
						.append(result.prdColumnName)
						.append('\n')
			}

			List<String> tableHeaderErrors = []
			List<String> tableHeaderPassed = []

			appendSyntheseHeaderComparison(
					result.recHeaders as List<String>,
					result.prdHeaders as List<String>,
					tableHeaderErrors,
					tableHeaderPassed
					)

			if (!tableHeaderErrors.isEmpty()) {
				errors.append(
						tableHeaderErrors.join('\n')
						)
						.append('\n')
			}

			if (!tableHeaderPassed.isEmpty()) {
				passedDetails.append(
						tableHeaderPassed.join('\n')
						)
						.append('\n')
			}

			if ((result.recRows as int) !=
					(result.prdRows as int)) {

				errors.append('[ERROR] Number of rows is different.\n')
						.append('REC: ')
						.append(result.recRows)
						.append('\nPRD: ')
						.append(result.prdRows)
						.append('\n')
			} else {
				passedDetails.append(
						'[PASS] Number of rows is equal.\n'
						)
						.append('REC: ')
						.append(result.recRows)
						.append('\nPRD: ')
						.append(result.prdRows)
						.append('\n')
			}

			appendColumnContentComparison(
					errors,
					passedDetails,
					result.columnName as String,
					result.recNumericValues as Integer,
					result.prdNumericValues as Integer,
					result.recUnreadableValues as Integer,
					result.prdUnreadableValues as Integer,
					result.recNonNumericDigest as String,
					result.prdNonNumericDigest as String,
					result.recNonNumericRawDigest as String,
					result.prdNonNumericRawDigest as String,
					result.recNonNumericValueCounts as Map,
					result.prdNonNumericValueCounts as Map,
					result.recNonNumericSamples as Map,
					result.prdNonNumericSamples as Map,
					result.recColumnStatus as String,
					result.prdColumnStatus as String
					)

			appendColumnValueSummary(
					passedDetails,
					'REC',
					result.columnName as String,
					result.recColumnStatus as String,
					result.recNumericValues as Integer,
					result.recZeroValues as Integer,
					result.recNonZeroValues as Integer,
					result.recBlankValues as Integer,
					result.recBlankValuesTreatedAsZero as Integer,
					result.recUnreadableValues as Integer,
					result.recOnlyZeroValues == true,
					result.recSum as BigDecimal,
					result.recMinimum as BigDecimal,
					result.recMaximum as BigDecimal
					)

			appendColumnValueSummary(
					passedDetails,
					'PRD',
					result.columnName as String,
					result.prdColumnStatus as String,
					result.prdNumericValues as Integer,
					result.prdZeroValues as Integer,
					result.prdNonZeroValues as Integer,
					result.prdBlankValues as Integer,
					result.prdBlankValuesTreatedAsZero as Integer,
					result.prdUnreadableValues as Integer,
					result.prdOnlyZeroValues == true,
					result.prdSum as BigDecimal,
					result.prdMinimum as BigDecimal,
					result.prdMaximum as BigDecimal
					)

			appendComparison(
					errors,
					passedDetails,
					'Column sum',
					result.columnName as String,
					result.recSum as BigDecimal,
					result.prdSum as BigDecimal
					)

			appendComparison(
					errors,
					passedDetails,
					'Minimum value',
					result.columnName as String,
					result.recMinimum as BigDecimal,
					result.prdMinimum as BigDecimal
					)

			appendComparison(
					errors,
					passedDetails,
					'Maximum value',
					result.columnName as String,
					result.recMaximum as BigDecimal,
					result.prdMaximum as BigDecimal
					)
		} catch (OutOfMemoryError error) {
			KeywordUtil.logInfo(
					'Complete Excel validation exceeded the available JVM memory.\n' +
					'Fallback validation will compare only the number of rows.\n' +
					'Reason: ' +
					safeText(error.getMessage())
					)

			errors.setLength(0)
			passedDetails.setLength(0)
			clearStatistics(result)

			try {
				System.gc()
				Thread.sleep(1000)
			} catch (Exception ignored) {
			}

			if (recFile == null || prdFile == null) {
				errors.append(
						'[ERROR] Row-count fallback could not be executed because REC or PRD file was not resolved.'
						)
			} else {
				int recRows = readRowCountStreaming(recFile, 'REC')
				int prdRows = readRowCountStreaming(prdFile, 'PRD')

				result.recRows = recRows
				result.prdRows = prdRows
				result.fallbackUsed = true
				result.validationMode = 'ROW_COUNT_FALLBACK'

				passedDetails.append(
						'[INFO] Full column validation was replaced by row-count validation because the Excel file exceeded available memory.\n'
						)

				if (recRows != prdRows) {
					errors.append(
							'[ERROR] Number of rows is different.\n'
							)
							.append('REC: ')
							.append(recRows)
							.append('\nPRD: ')
							.append(prdRows)
				} else {
					passedDetails.append(
							'[PASS] Number of rows is equal.\n'
							)
							.append('REC: ')
							.append(recRows)
							.append('\nPRD: ')
							.append(prdRows)
				}
			}
		} catch (Exception exception) {
			errors.append(
					'[ERROR] REC x PRD export validation failed.\n'
					)
					.append('Exception: ')
					.append(exception.getClass().getSimpleName())
					.append('\nMessage: ')
					.append(safeText(exception.getMessage()))
		}

		return finalizeResult(result, errors, passedDetails)
	}


	private int readRowCountStreaming(
			File file,
			String environment) {

		String lowerName = file.getName().toLowerCase()

		if (!lowerName.endsWith('.xlsx') &&
				!lowerName.endsWith('.xlsm')) {

			return readRowCountWithWorkbook(file, environment)
		}

		OPCPackage opcPackage = null
		InputStream sheetInput = null

		try {
			opcPackage = OPCPackage.open(file)

			XSSFReader reader = new XSSFReader(opcPackage)
			StylesTable styles = reader.getStylesTable()

			ReadOnlySharedStringsTable sharedStrings =
					new ReadOnlySharedStringsTable(opcPackage)

			Iterator<InputStream> sheets = reader.getSheetsData()

			if (!sheets.hasNext()) {
				throw new IllegalStateException(
				environment +
				' workbook does not contain worksheets.'
				)
			}

			sheetInput = sheets.next()

			RowCountStreamingHandler rowHandler =
					new RowCountStreamingHandler()

			XSSFSheetXMLHandler sheetHandler =
					new XSSFSheetXMLHandler(
					styles,
					null,
					sharedStrings,
					rowHandler,
					new DataFormatter(),
					false
					)

			SAXParserFactory parserFactory =
					SAXParserFactory.newInstance()

			parserFactory.setNamespaceAware(true)

			XMLReader parser =
					parserFactory
					.newSAXParser()
					.getXMLReader()

			parser.setContentHandler(sheetHandler)
			parser.parse(new InputSource(sheetInput))

			return rowHandler.rows
		} finally {
			try {
				if (sheetInput != null) {
					sheetInput.close()
				}
			} catch (Exception ignored) {
			}

			try {
				if (opcPackage != null) {
					opcPackage.close()
				}
			} catch (Exception ignored) {
			}
		}
	}


	private int readRowCountWithWorkbook(
			File file,
			String environment) {

		FileInputStream input = null
		Workbook workbook = null

		try {
			input = new FileInputStream(file)
			workbook = WorkbookFactory.create(input)

			if (workbook.getNumberOfSheets() == 0) {
				throw new IllegalStateException(
				environment +
				' workbook does not contain worksheets.'
				)
			}

			Sheet sheet = workbook.getSheetAt(0)
			DataFormatter formatter = new DataFormatter()
			int rows = 0

			for (int rowIndex = 1;
					rowIndex <= sheet.getLastRowNum();
					rowIndex++) {

				Row row = sheet.getRow(rowIndex)

				if (row != null &&
						!isRowEmpty(row, formatter)) {

					rows++
				}
			}

			return rows
		} finally {
			closeWorkbook(workbook)
			closeInput(input)
		}
	}


