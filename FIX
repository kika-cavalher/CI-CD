REC - Floors Grecques - Filter Export And Validate


import static com.kms.katalon.core.testcase.TestCaseFactory.findTestCase

import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows


// ======================================================
// MODULE CONFIG
// ======================================================

String targetEnvironment = 'REC'

String menuName = 'Retournement des internes'
String menuListName = 'Détail - Caps Grecques'
String menuResultName = 'Floors Grecques'
String openedTabName = 'Floors Grecques'

String exportLabel = 'FloorsGrecques'

String loginTestCase =
    'Component/Authentication/Login ' +
    targetEnvironment

String closeApplicationTestCase =
    'Component/Authentication/Close Application'


// ======================================================
// RECHERCHE DATA
// ======================================================

String asOfDateValue = '30/06/2026'


// ======================================================
// RECHERCHE LOADER CONFIG
// ======================================================

String rechercheImageGroup = 'General'
String rechercheObjectGroup = 'filter'

String rechercheTabImageKey = 'rechercheTab'
String rechercheTabObjectKey = 'rechercheButton'

String rechercherButtonImageKey = 'rechercherButton'
String rechercherButtonObjectKey = 'rechercherButton'

Integer tabsToAsOfDate = 2


// ======================================================
// TIMEOUT CONFIG
// ======================================================

Integer menuTimeout = 90
Integer openedTabTimeout = 120
Integer rechercheTimeout = 30
Integer filteredContentDelay = 20


// ======================================================
// AUTHENTICATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
    'Authenticate and open application\n' +
    'Environment: ' +
    targetEnvironment
)

WebUI.callTestCase(
    findTestCase(
        loginTestCase
    ),
    [:],
    FailureHandling.STOP_ON_FAILURE
)


// ======================================================
// OPEN SUBMENU
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
    'Open Floors Grecques using submenu navigation\n' +
    'Search: ' +
    menuName +
    '\nOpen list: ' +
    menuListName +
    '\nResult: ' +
    menuResultName
)

CustomKeywords.
'component.MenuNavigator.searchAndOpenMenuOpeningListByText'(
    menuName,
    menuListName,
    menuResultName,
    menuTimeout
)


// ======================================================
// VALIDATE OPENED TAB
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
    'Validate opened tab\n' +
    'Expected tab: ' +
    openedTabName
)

CustomKeywords.
'component.MenuNavigator.validateTabOpenedByName'(
    openedTabName,
    openedTabTimeout,
    targetEnvironment +
    '_FloorsGrecques'
)


// ======================================================
// APPLY AS OF DATE FILTER
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
    'Apply Recherche As Of Date filter\n' +
    'Value: ' +
    asOfDateValue +
    '\nTAB count to As Of Date: ' +
    tabsToAsOfDate +
    '\nStrategy: Windows object first, image fallback'
)

Map rechercheResult =
    CustomKeywords.
    'component.RechercheKeywords.applyRechercheFilterWithTabs'(
        rechercheImageGroup,
        rechercheObjectGroup,
        rechercheTabImageKey,
        rechercheTabObjectKey,
        rechercherButtonImageKey,
        rechercherButtonObjectKey,
        asOfDateValue,
        tabsToAsOfDate,
        rechercheTimeout
    )


// ======================================================
// WAIT FOR FILTERED CONTENT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
    'Wait for filtered Floors Grecques content\n' +
    'Delay: ' +
    filteredContentDelay +
    ' seconds'
)

Windows.delay(
    filteredContentDelay
)

CustomKeywords.'commands.ImageLoader.takeEvidence'(
    targetEnvironment +
    '_FloorsGrecques_FilterApplied.png'
)


// ======================================================
// EXPORT
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
    'Export filtered Floors Grecques table\n' +
    'Flow: Exports tab > Export button > Save > Non\n' +
    'Environment: ' +
    targetEnvironment +
    '\nExport label: ' +
    exportLabel
)

CustomKeywords.
'commands.ExportFile.exportFromTwoExportImagesToNo'(
    exportLabel,
    targetEnvironment
)


// ======================================================
// VALIDATE DOWNLOADED FILE
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
    'Validate exported Floors Grecques file\n' +
    'Environment: ' +
    targetEnvironment +
    '\nExport label: ' +
    exportLabel +
    '\nValidations:\n' +
    '- File exists\n' +
    '- File is not empty\n' +
    '- Data row quantity is greater than zero'
)

Map exportValidation =
    CustomKeywords.
    'commands.ExportFileValidationKeywords.validateExportedFileExistsAndHasRows'(
        targetEnvironment,
        exportLabel
    )

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
    'Floors Grecques export validation passed\n' +
    'File: ' +
    exportValidation.fileName +
    '\nData rows: ' +
    exportValidation.dataRows +
    '\nFile size: ' +
    exportValidation.fileSize +
    ' bytes\nFolder: ' +
    exportValidation.folderPath
)


// ======================================================
// CLOSE APPLICATION
// ======================================================

CustomKeywords.'jiraIntegration.JiraReportSteps.note'(
    'Close application\n' +
    'Environment: ' +
    targetEnvironment
)

WebUI.callTestCase(
    findTestCase(
        closeApplicationTestCase
    ),
    [:],
    FailureHandling.STOP_ON_FAILURE
)

KeywordUtil.markPassed(
    targetEnvironment +
    ' Floors Grecques As Of Date filter, export and file validation completed successfully.\n' +
    'Exported file: ' +
    exportValidation.fileName
)
