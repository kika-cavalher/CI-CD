    // ============================================================
    // HTTP HELPERS
    // ============================================================
    private Map<String, String> defaultHeaders() {
        return [
            'Authorization': 'Bearer ' + resolveToken(),
            'Accept'       : 'application/json'
        ]
    }

    private Map<String, String> jsonHeaders() {
        return [
            'Authorization': 'Bearer ' + resolveToken(),
            'Accept'       : 'application/json'
        ]
    }

    private Map sendRequest(String method, String urlText, String contentType, byte[] body, Map<String, String> headers) {
        HttpURLConnection connection = null
        try {
            URL url = new URL(urlText)
            connection = (HttpURLConnection) url.openConnection()
            connection.setRequestMethod(method)
            connection.setConnectTimeout(30000)
            connection.setReadTimeout(120000)
            connection.setUseCaches(false)
            connection.setDoInput(true)

            headers?.each { String key, String value ->
                connection.setRequestProperty(key, value)
            }

            if (!isBlank(contentType)) {
                connection.setRequestProperty('Content-Type', contentType)
            }

            if (body != null) {
                connection.setDoOutput(true)
                BufferedOutputStream output = new BufferedOutputStream(connection.getOutputStream())
                try {
                    output.write(body)
                    output.flush()
                } finally {
                    output.close()
                }
            }

            int status = connection.getResponseCode()
            String responseBody = readResponseBody(connection, status)

            return [status: status, body: responseBody]
        } finally {
            try {
                connection?.disconnect()
            } catch (Exception ignored) {
            }
        }
    }

    private Map sendMultipartFile(String urlText, File file) {
        HttpURLConnection connection = null
        String boundary = '----ChatGPTBoundary' + System.currentTimeMillis()
        byte[] lineBreak = '\r\n'.getBytes(StandardCharsets.UTF_8)

        try {
            URL url = new URL(urlText)
            connection = (HttpURLConnection) url.openConnection()
            connection.setRequestMethod('POST')
            connection.setConnectTimeout(30000)
            connection.setReadTimeout(120000)
            connection.setUseCaches(false)
            connection.setDoInput(true)
            connection.setDoOutput(true)

            connection.setRequestProperty('Authorization', 'Bearer ' + resolveToken())
            connection.setRequestProperty('Accept', 'application/json')
            connection.setRequestProperty('X-Atlassian-Token', 'no-check')
            connection.setRequestProperty('Content-Type', 'multipart/form-data; boundary=' + boundary)

            DataOutputStream output = new DataOutputStream(connection.getOutputStream())
            try {
                output.write(('--' + boundary + '\r\n').getBytes(StandardCharsets.UTF_8))
                output.write(('Content-Disposition: form-data; name="file"; filename="' + file.name + '"\r\n').getBytes(StandardCharsets.UTF_8))
                output.write(('Content-Type: application/octet-stream\r\n\r\n').getBytes(StandardCharsets.UTF_8))

                BufferedInputStream input = new BufferedInputStream(new FileInputStream(file))
                try {
                    byte[] buffer = new byte[8192]
                    int len = 0
                    while ((len = input.read(buffer)) != -1) {
                        output.write(buffer, 0, len)
                    }
                } finally {
                    input.close()
                }

                output.write(lineBreak)
                output.write(('--' + boundary + '--\r\n').getBytes(StandardCharsets.UTF_8))
                output.flush()
            } finally {
                output.close()
            }

            int status = connection.getResponseCode()
            String responseBody = readResponseBody(connection, status)
            return [status: status, body: responseBody]
        } finally {
            try {
                connection?.disconnect()
            } catch (Exception ignored) {
            }
        }
    }

    private String readResponseBody(HttpURLConnection connection, int status) {
        try {
            InputStream stream = status >= 400 ? connection.getErrorStream() : connection.getInputStream()
            if (stream == null) {
                return ''
            }

            ByteArrayOutputStream baos = new ByteArrayOutputStream()
            BufferedInputStream input = new BufferedInputStream(stream)
            try {
                byte[] buffer = new byte[8192]
                int len = 0
                while ((len = input.read(buffer)) != -1) {
                    baos.write(buffer, 0, len)
                }
            } finally {
                input.close()
            }

            return new String(baos.toByteArray(), StandardCharsets.UTF_8)
        } catch (Exception ignored) {
            return ''
        }
    }

    private Object parseJson(String body) {
        if (isBlank(body)) {
            return [:]
        }

        try {
            return jsonSlurper.parseText(body)
        } catch (Exception ignored) {
            return [:]
        }
    }
