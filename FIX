String getShortErrorLog(String stackTrace) {
	if (isBlank(stackTrace)) {
		return ''
	}

	List<String> lines = stackTrace
		.readLines()
		.findAll { !isBlank(it) }
		.collect { it.trim() }

	if (lines.isEmpty()) {
		return ''
	}

	List<String> important = []

	for (String line : lines) {
		if (important.size() >= 3) {
			break
		}

		if (
			line.toLowerCase().contains('exception')
			|| line.toLowerCase().contains('error')
			|| line.toLowerCase().contains('caused by')
			|| line.toLowerCase().contains('stepfailedexception')
			|| line.toLowerCase().contains('assert')
			|| line.toLowerCase().contains('unable')
			|| line.toLowerCase().contains('not found')
			|| line.toLowerCase().contains('not clickable')
		) {
			important.add(line)
		}
	}

	if (important.isEmpty()) {
		important = lines.take(3)
	}

	return important.join('\n')
}

String buildFailureCard(Map item) {
	String fullStack = item.stackTrace as String
	String shortStack = getShortErrorLog(fullStack)

	StringBuilder card = new StringBuilder()

	card.append('<div class="case-block failed">')
	card.append('<div class="case-title">')
	card.append(safeHtml((item.className ?: '') + '/' + (item.testName ?: '')))
	card.append('</div>')

	card.append('<div class="case-line">❗ Mandatory failure</div>')

	if (!isBlank(item.failureMessage as String)) {
		card.append('<div class="case-line error-message">')
		card.append(safeHtml(item.failureMessage as String))
		card.append('</div>')
	}

	if (!isBlank(shortStack)) {
		card.append('<pre class="short-log">')
		card.append(safeHtml(shortStack))
		card.append('</pre>')
	}

	card.append('<div class="case-line duration">Duration: ')
	card.append(safeHtml(formatDurationSeconds(item.timeSeconds as BigDecimal)))
	card.append('</div>')

	card.append('<details class="details-block">')
	card.append('<summary>See full error log</summary>')
	card.append('<pre>')
	card.append(safeHtml(fullStack))
	card.append('</pre>')
	card.append('</details>')

	if (!isBlank(item.imageData as String)) {
		card.append('<div class="image-wrap">')
		card.append('<img src="')
		card.append(item.imageData as String)
		card.append('" alt="Failure evidence" class="failure-image"/>')
		card.append('</div>')
	}

	card.append('</div>')

	return card.toString()
}

String buildPassedCard(Map item) {
	StringBuilder card = new StringBuilder()

	card.append('<div class="case-block passed">')
	card.append('<div class="case-title">')
	card.append(safeHtml((item.className ?: '') + '/' + (item.testName ?: '')))
	card.append('</div>')

	card.append('<div class="case-line">✔ Test Passed</div>')
	card.append('<div class="case-line duration">Duration: ')
	card.append(safeHtml(formatDurationSeconds(item.timeSeconds as BigDecimal)))
	card.append('</div>')
	card.append('</div>')

	return card.toString()
}

