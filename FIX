
'createFavoriteIcon': 'Images/General/icomFavorite.png',
'saveFavoriteIcon'  : 'Images/General/enregistreLeFavori.png',






// ======================================================
// CREATE FAVORITE
// Create Favorite and Save Favorite use image recognition.
// ======================================================

@Keyword
void createFavoriteFromCurrentModule(
	String favoriteTitle,
	Integer controlTimeoutSeconds,
	Integer popupTimeoutSeconds
) {

	Integer controlTimeout = safeTimeout(
		controlTimeoutSeconds,
		5
	)

	Integer popupTimeout = safeTimeout(
		popupTimeoutSeconds,
		5
	)

	logStep(
		'CREATE FAVORITE',
		'Favorite title: ' + favoriteTitle
	)

	KeywordUtil.logInfo(
		'[FAVORITE][01] Method started.'
	)

	Windows.delay(2)

	// ==================================================
	// CLICK CREATE FAVORITE BY IMAGE
	// ==================================================

	KeywordUtil.logInfo(
		'[FAVORITE][02] Searching Create Favorite image.\n' +
		'Image group: ' + GENERAL_IMAGE_GROUP + '\n' +
		'Image key: createFavoriteIcon\n' +
		'Expected file: Images/General/icomFavorite.png\n' +
		'Timeout: ' + controlTimeout + ' seconds'
	)

	long createFavoriteSearchStart =
		System.currentTimeMillis()

	boolean createFavoriteClicked =
		clickFirstVisibleImage(
			GENERAL_IMAGE_GROUP,
			[
				'createFavoriteIcon'
			],
			controlTimeout
		)

	long createFavoriteSearchDuration =
		System.currentTimeMillis() -
		createFavoriteSearchStart

	KeywordUtil.logInfo(
		'[FAVORITE][03] Create Favorite image search finished.\n' +
		'Found and clicked: ' + createFavoriteClicked + '\n' +
		'Duration: ' + createFavoriteSearchDuration + ' ms'
	)

	if (!createFavoriteClicked) {
		KeywordUtil.logInfo(
			'[FAVORITE][04] Create Favorite image was not found. ' +
			'Stopping test immediately.'
		)

		takeEvidence(
			'GUI_CreateFavoriteImageNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Create Favorite image was not found.\n' +
			'Image group: ' + GENERAL_IMAGE_GROUP + '\n' +
			'Image key: createFavoriteIcon\n' +
			'Expected file: Images/General/icomFavorite.png\n' +
			'Timeout: ' + controlTimeout + ' seconds\n' +
			'Search duration: ' +
			createFavoriteSearchDuration +
			' ms'
		)

		return
	}

	KeywordUtil.logInfo(
		'[FAVORITE][05] Create Favorite clicked successfully by image.'
	)

	Windows.delay(1)

	// ==================================================
	// FAVORITE TITLE
	// ==================================================

	KeywordUtil.logInfo(
		'[FAVORITE][06] Filling favorite title.\n' +
		'Image group: ' + GUI_IMAGE_GROUP + '\n' +
		'Image key: favoriteFilterField\n' +
		'Title: ' + favoriteTitle
	)

	long favoriteTitleStart =
		System.currentTimeMillis()

	try {
		typeOnImage(
			GUI_IMAGE_GROUP,
			'favoriteFilterField',
			favoriteTitle,
			controlTimeout
		)
	} catch (Throwable error) {
		String errorMessage =
			error.getMessage() == null ?
			error.getClass().getSimpleName() :
			error.getMessage()

		takeEvidence(
			'GUI_FavoriteTitleNotFilled.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorite title could not be filled.\n' +
			'Image group: ' + GUI_IMAGE_GROUP + '\n' +
			'Image key: favoriteFilterField\n' +
			'Favorite title: ' + favoriteTitle + '\n' +
			'Error: ' + errorMessage
		)

		return
	}

	KeywordUtil.logInfo(
		'[FAVORITE][07] Favorite title filled successfully.\n' +
		'Duration: ' +
		(System.currentTimeMillis() - favoriteTitleStart) +
		' ms'
	)

	Windows.delay(1)

	// ==================================================
	// SAVE FAVORITE BY IMAGE
	// ==================================================

	KeywordUtil.logInfo(
		'[FAVORITE][08] Searching Save Favorite image.\n' +
		'Image group: ' + GENERAL_IMAGE_GROUP + '\n' +
		'Image key: saveFavoriteIcon\n' +
		'Expected file: Images/General/enregistreLeFavori.png\n' +
		'Timeout: ' + controlTimeout + ' seconds'
	)

	long saveFavoriteSearchStart =
		System.currentTimeMillis()

	boolean saveFavoriteClicked =
		clickFirstVisibleImage(
			GENERAL_IMAGE_GROUP,
			[
				'saveFavoriteIcon'
			],
			controlTimeout
		)

	long saveFavoriteSearchDuration =
		System.currentTimeMillis() -
		saveFavoriteSearchStart

	KeywordUtil.logInfo(
		'[FAVORITE][09] Save Favorite image search finished.\n' +
		'Found and clicked: ' + saveFavoriteClicked + '\n' +
		'Duration: ' + saveFavoriteSearchDuration + ' ms'
	)

	if (!saveFavoriteClicked) {
		KeywordUtil.logInfo(
			'[FAVORITE][10] Save Favorite image was not found. ' +
			'Stopping test immediately.'
		)

		takeEvidence(
			'GUI_SaveFavoriteImageNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Save Favorite image was not found.\n' +
			'Image group: ' + GENERAL_IMAGE_GROUP + '\n' +
			'Image key: saveFavoriteIcon\n' +
			'Expected file: Images/General/enregistreLeFavori.png\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'Timeout: ' + controlTimeout + ' seconds\n' +
			'Search duration: ' +
			saveFavoriteSearchDuration +
			' ms'
		)

		return
	}

	KeywordUtil.logInfo(
		'[FAVORITE][11] Save Favorite clicked successfully by image.'
	)

	// ==================================================
	// CONFIRMATION
	// ==================================================

	KeywordUtil.logInfo(
		'[FAVORITE][12] Waiting for favorite confirmation.\n' +
		'Favorite: ' + favoriteTitle + '\n' +
		'Timeout: ' + popupTimeout + ' seconds'
	)

	long confirmationStart =
		System.currentTimeMillis()

	String modalDetection =
		waitForFavoriteConfirmation(
			favoriteTitle,
			popupTimeout
		)

	long confirmationDuration =
		System.currentTimeMillis() -
		confirmationStart

	KeywordUtil.logInfo(
		'[FAVORITE][13] Confirmation search finished.\n' +
		'Detected by: ' + modalDetection + '\n' +
		'Duration: ' + confirmationDuration + ' ms'
	)

	if (modalDetection.isEmpty()) {
		takeEvidence(
			'GUI_FavoriteConfirmationModalNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorite confirmation modal was not found.\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'Timeout: ' + popupTimeout + ' seconds\n' +
			'Search duration: ' + confirmationDuration + ' ms'
		)

		return
	}

	takeEvidence(
		'GUI_FavoriteConfirmationModal.png'
	)

	Windows.delay(5)

	// ==================================================
	// CLOSE CONFIRMATION
	// ==================================================

	KeywordUtil.logInfo(
		'[FAVORITE][14] Closing favorite confirmation.'
	)

	boolean confirmationClosed =
		clickFirstVisibleImage(
			GENERAL_IMAGE_GROUP,
			[
				'okModal',
				'okModal2Version'
			],
			3
		)

	KeywordUtil.logInfo(
		'[FAVORITE][15] Confirmation closed by image: ' +
		confirmationClosed
	)

	if (!confirmationClosed) {
		KeywordUtil.logInfo(
			'[FAVORITE][16] OK image was not found. Pressing ENTER.'
		)

		pressKeyboardKey(
			KeyEvent.VK_ENTER
		)
	}

	Windows.delay(2)

	KeywordUtil.markPassed(
		'Favorite created successfully.\n' +
		'Title: ' + favoriteTitle + '\n' +
		'Confirmation detected by: ' + modalDetection
	)
}
