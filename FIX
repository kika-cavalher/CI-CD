
package pageObject

import static com.kms.katalon.core.testobject.ObjectRepository.findTestObject

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.testobject.ConditionType
import com.kms.katalon.core.testobject.TestObject
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.webui.keyword.WebUiBuiltInKeywords as WebUI

import cucumber.api.java.en.Given
import cucumber.api.java.en.Then
import cucumber.api.java.en.When
import internal.GlobalVariable

class Login {

	private static final int DEFAULT_TIMEOUT = 60

	@Keyword
	@Given("user opens DEV login page")
	def userOpensHueLoginPage() {
		KeywordUtil.logInfo("Opening Chrome browser")

		WebUI.openBrowser('')
		WebUI.maximizeWindow()

		String devUrl = GlobalVariable.DEV_URL == null ? '' : GlobalVariable.DEV_URL.toString().trim()

		KeywordUtil.logInfo("DEV_URL value: " + devUrl)

		if (devUrl.length() == 0) {
			KeywordUtil.markFailedAndStop("DEV_URL is empty in the selected execution profile. Please check Profiles/default.")
		}

		KeywordUtil.logInfo("Navigating to DEV URL")
		WebUI.navigateToUrl(devUrl)

		WebUI.waitForPageLoad(DEFAULT_TIMEOUT)
		waitForPageToBeReady(DEFAULT_TIMEOUT)

		waitForLoginOrHue(DEFAULT_TIMEOUT)
	}

	@Keyword
	@When("the user logs in with the correct profile credentials.")
	def userLogsInWithDefaultProfileCredentials() {
		KeywordUtil.logInfo("Checking if login is required")

		boolean loginVisible = isLoginVisible(5)

		if (!loginVisible) {
			KeywordUtil.logInfo("Login screen is not visible. User is already authenticated.")
			waitForHue(DEFAULT_TIMEOUT)
			return
		}

		KeywordUtil.logInfo("Login screen is visible. Filling credentials.")

		String username = GlobalVariable.DEV_USERNAME == null ? '' : GlobalVariable.DEV_USERNAME.toString().trim()
		String password = GlobalVariable.DEV_PASSWORD == null ? '' : GlobalVariable.DEV_PASSWORD.toString().trim()

		if (username.length() == 0) {
			KeywordUtil.markFailedAndStop("DEV_USERNAME is empty in the selected execution profile.")
		}

		if (password.length() == 0) {
			KeywordUtil.markFailedAndStop("DEV_PASSWORD is empty in the selected execution profile.")
		}

		WebUI.waitForElementVisible(
			findTestObject('Login/input_Username'),
			DEFAULT_TIMEOUT,
			FailureHandling.STOP_ON_FAILURE
		)

		WebUI.setText(findTestObject('Login/input_Username'), username)
		WebUI.setEncryptedText(findTestObject('Login/input_Password'), password)

		WebUI.click(findTestObject('Login/button_SignIn'))

		WebUI.waitForPageLoad(DEFAULT_TIMEOUT)
		waitForPageToBeReady(DEFAULT_TIMEOUT)

		waitForHue(DEFAULT_TIMEOUT)
	}

	@Keyword
	@Then("Hue home should be opened")
	def hueHomeShouldBeOpened() {
		KeywordUtil.logInfo("Validating Hue application is opened")

		waitForPageToBeReady(DEFAULT_TIMEOUT)
		waitForHue(DEFAULT_TIMEOUT)

		KeywordUtil.logInfo("Hue application opened successfully")
		KeywordUtil.logInfo("Current URL: " + WebUI.getUrl())
	}

	private void waitForLoginOrHue(int timeoutInSeconds) {
		KeywordUtil.logInfo("Waiting for login page or Hue application")

		for (int i = 0; i < timeoutInSeconds; i++) {
			if (isLoginVisible(1)) {
				KeywordUtil.logInfo("Login page was found")
				return
			}

			if (isHueVisible(1)) {
				KeywordUtil.logInfo("Hue application was found")
				return
			}

			WebUI.delay(1)
		}

		KeywordUtil.markFailedAndStop("Login page or Hue application was not found. Current URL: " + getCurrentUrlSafely())
	}

	private void waitForHue(int timeoutInSeconds) {
		KeywordUtil.logInfo("Waiting for Hue application")

		for (int i = 0; i < timeoutInSeconds; i++) {
			if (isHueVisible(1)) {
				KeywordUtil.logInfo("Hue application is visible")
				return
			}

			WebUI.delay(1)
		}

		KeywordUtil.markFailedAndStop("Hue application was not opened. Current URL: " + getCurrentUrlSafely())
	}

	private boolean isLoginVisible(int timeoutInSeconds) {
		try {
			return WebUI.verifyElementPresent(
				findTestObject('Login/input_Username'),
				timeoutInSeconds,
				FailureHandling.OPTIONAL
			)
		} catch (Exception ignored) {
			return false
		}
	}

	private boolean isHueVisible(int timeoutInSeconds) {
		try {
			return WebUI.verifyElementPresent(
				getHueMarker(),
				timeoutInSeconds,
				FailureHandling.OPTIONAL
			)
		} catch (Exception ignored) {
			return false
		}
	}

	private TestObject getHueMarker() {
		TestObject marker = new TestObject('Hue_Marker')

		marker.addProperty(
			'xpath',
			ConditionType.EQUALS,
			"//*[normalize-space()='Documents' or normalize-space()='Editor' or normalize-space()='Databases' or normalize-space()='Tables' or contains(@class,'assist-panel') or contains(@class,'hue-logo')]"
		)

		return marker
	}

	private void waitForPageToBeReady(int timeoutInSeconds) {
		for (int i = 0; i < timeoutInSeconds; i++) {
			try {
				Object readyState = WebUI.executeJavaScript('return document.readyState', null)

				if (readyState != null && readyState.toString().equals('complete')) {
					return
				}
			} catch (Exception ignored) {
				KeywordUtil.logInfo("Page ready state is not available yet")
			}

			WebUI.delay(1)
		}

		KeywordUtil.logInfo("Page ready state did not become complete within timeout")
	}

	private String getCurrentUrlSafely() {
		try {
			return WebUI.getUrl()
		} catch (Exception ignored) {
			return 'URL not available'
		}
	}
}
