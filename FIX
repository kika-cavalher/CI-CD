			)
		} else {
			KeywordUtil.logInfo(
				'[FAVORITE][09] Save Favorite image was not found.\n' +
				'Using keyboard fallback: TAB + ENTER.'
			)
	
			takeEvidence(
				'GUI_SaveFavoriteImageNotFound_UsingKeyboard.png'
			)
	
			KeywordUtil.logInfo(
				'[FAVORITE][10] Pressing TAB.'
			)
	
			pressKeyboardKey(
				KeyEvent.VK_TAB
			)
	
			Windows.delay(1)
	
			KeywordUtil.logInfo(
				'[FAVORITE][11] Pressing ENTER.'
			)
	
			pressKeyboardKey(
				KeyEvent.VK_ENTER
			)
	
			KeywordUtil.logInfo(
				'[FAVORITE][12] TAB + ENTER fallback completed.'
			)
		}
	
		Windows.delay(20)
	
		// ==================================================
		// CONFIRMATION
		// ==================================================
	    // ==================================================
	
		KeywordUtil.logInfo(
			'[FAVORITE][16] Closing favorite confirmation.'
		)
	
