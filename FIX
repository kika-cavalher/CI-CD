@Keyword
void openEnvironmentDropdown() {
	KeywordUtil.logInfo("Opening environment dropdown by click")

	focusLoginWindow()
	sleepMs(800)

	WindowsTestObject combo = envComboObj()

	if (!waitPresent(combo, 5)) {
		KeywordUtil.markFailedAndStop("Environment combo was not found")
	}

	Windows.click(combo)
	sleepMs(1200)
}

@Keyword
String resolveEnvironmentDisplayValue(String env) {
	String value = safe(env).toUpperCase()

	switch (value) {
		case 'PROD':
			return 'Production (PROD)'
		case 'PREX':
		case 'PREPO':
			return 'Bench (PREX)'
		case 'REC2':
			return 'Qualification (REC2)'
		case 'REC':
			return 'Recette (REC)'
		case 'DEV2':
			return 'Simulation (DEV2)'
		case 'DEV':
			return 'Developpement (DEV)'
		default:
			return 'Recette (REC)'
	}
}

@Keyword
void selectEnvironment(String env) {
	String displayValue = resolveEnvironmentDisplayValue(env)

	KeywordUtil.logInfo("Selecting environment by direct click: ${displayValue}")

	focusLoginWindow()
	openEnvironmentDropdown()

	WindowsTestObject item = envListItemObj(displayValue)

	if (!waitPresent(item, 5)) {
		KeywordUtil.markFailedAndStop("Environment option was not found: ${displayValue}")
	}

	Windows.click(item)
	sleepMs(1500)
}

@Keyword
boolean isConnectButtonPresent() {
	return waitPresent(connectBtnObj(), 3)
}

@Keyword
void clickConnectButton() {
	KeywordUtil.logInfo("Clicking connect button")

	focusLoginWindow()
	sleepMs(500)

	WindowsTestObject btn = connectBtnObj()

	if (waitPresent(btn, 5)) {
		Windows.click(btn)
		sleepMs(1500)
		return
	}

	KeywordUtil.logInfo("Connect button not found. Using ENTER fallback.")

	Robot r = new Robot()
	r.setAutoDelay(100)
	r.keyPress(KeyEvent.VK_ENTER)
	sleepMs(150)
	r.keyRelease(KeyEvent.VK_ENTER)
	sleepMs(1500)
}

@Keyword
boolean waitForMainScreen() {
	KeywordUtil.logInfo("Waiting for main eMatch screen")

	try {
		if (waitPresent(mainSearchObj(), 60)) {
			return true
		}
	} catch (Throwable ignored) {
	}

	try {
		if (waitPresent(homeTabObj(), 60)) {
			return true
		}
	} catch (Throwable ignored) {
	}

	return false
}

@Keyword
void activateHomeTab() {
	try {
		WindowsTestObject homeTab = homeTabObj()
		if (waitPresent(homeTab, 5)) {
			Windows.click(homeTab)
			sleepMs(1000)
			return
		}
	} catch (Throwable ignored) {
	}

	try {
		String homeImg = new File(RunConfiguration.getProjectDir(), 'Images/General/Home.PNG').getAbsolutePath()
		if (new File(homeImg).exists()) {
			WindowsImageKeywords.clickImage(homeImg)
			sleepMs(1000)
		}
	} catch (Throwable ignored) {
	}
}

@Keyword
void loginThroughNativeControls() {
	loginThroughNativeControls(safe(GlobalVariable.env) ?: 'REC')
}

@Keyword
void loginThroughNativeControls(String env) {
	String resolvedEnv = safe(env) ?: safe(GlobalVariable.env) ?: 'REC'

	KeywordUtil.logInfo("Logging through native controls for env ${resolvedEnv}")

	focusLoginWindow()
	selectEnvironment(resolvedEnv)

	focusLoginWindow()
	clickConnectButton()

	boolean mainScreenLoaded = waitForMainScreen()

	if (!mainScreenLoaded) {
		KeywordUtil.markFailedAndStop("eMatch main screen was not loaded. Object 'General/txtSearch' not found.")
	}

	activateHomeTab()
	KeywordUtil.logInfo("eMatch startup flow completed successfully for environment ${resolvedEnv}")
}







private WindowsTestObject envComboObj() {
	try {
		WindowsTestObject repoObj = findWindowsObject('Login Page/optEnv')
		if (repoObj != null) {
			return repoObj
		}
	} catch (Throwable ignored) {
	}

	return winObj(
		'envCombo',
		"(//*[@LocalizedControlType='combo box' or contains(@ClassName,'ComboBox')])[1]"
	)
}

private WindowsTestObject envListItemObj(String visibleText) {
	return winObj(
