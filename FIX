def deleteIfExists(String path) {
  bat """@echo off
if exist "${path}" del /f /q "${path}"
exit /b 0
"""
}

def writeRunContextFile(String targetFile, Map ctx) {
  def content = ctx.collect { k, v -> "${k}=${v}" }.join("\r\n") + "\r\n"
  echo "Writing run-context.properties to: ${targetFile}"

  def safePath = targetFile.replace("\\", "\\\\")
  def ps = """
\$p = '${safePath}'
\$dir = Split-Path -Parent \$p
if (!(Test-Path \$dir)) { New-Item -ItemType Directory -Force -Path \$dir | Out-Null }
Set-Content -Path \$p -Value @'
${content}
'@ -Encoding ASCII
""".trim()

  bat """@echo off
powershell -NoProfile -ExecutionPolicy Bypass -Command "${escapeForCmd(ps)}"
"""
}

def runScheduledTaskAndWaitMarker(String taskName, String markerPath, int timeoutMinutes) {
  echo "Running Task Scheduler: ${taskName}"
  bat """@echo off
schtasks /run /tn "${taskName}"
if errorlevel 1 exit /b 1
"""

  timeout(time: timeoutMinutes, unit: 'MINUTES') {
    echo "Waiting marker file: ${markerPath}"
    while (true) {
      if (fileExists(markerPath)) break
      sleep time: 3, unit: 'SECONDS'
    }
  }

  def ecText = readFile(markerPath).trim()
  int ec = 1
  try { ec = Integer.parseInt(ecText) } catch (ignored) { ec = 1 }

  echo "Desktop task finished. ExitCode=${ec}"
  return ec
}

def escapeForCmd(String s) {
  return s
    .replace("^", "^^")
    .replace("&", "^&")
    .replace("<", "^<")
    .replace(">", "^>")
    .replace("|", "^|")
    .replace("\"", "\\\"")
    .replace("\r", "")
    .replace("\n", " ")
}

return this
