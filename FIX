	private List<File> collectExcelFiles(
			File folder,
			boolean includeSubFolders) {

		List<File> result = []
		File[] children = folder.listFiles()

		if (children == null) {
			return result
		}

		for (File child : children) {
			if (child.isFile() &&
					isExcelFile(child.getName()) &&
					!child.getName().startsWith('~$')) {

				result.add(child)
			} else if (includeSubFolders && child.isDirectory()) {
				result.addAll(
						collectExcelFiles(child, includeSubFolders)
						)
			}
		}

		return result
	}

	private List<File> parseFiles(String filesToValidate) {
		List<File> result = []
		List<String> paths = splitText(filesToValidate)

		for (String path : paths) {
			String cleanPath = safeText(path)

			if (!cleanPath.isEmpty()) {
				result.add(new File(cleanPath))
			}
		}

		return result.unique { File file ->
			file.getAbsolutePath().toLowerCase()
		}
	}

	private List<String> splitText(String value) {
		List<String> result = []

		String text = safeText(value)
				.replace('\r\n', LIST_SEPARATOR)
				.replace('\n', LIST_SEPARATOR)
				.replace(';', LIST_SEPARATOR)

		if (!text.isEmpty()) {
			String[] parts = text.split('\\|')

			for (String part : parts) {
				String clean = safeText(part)

				if (!clean.isEmpty()) {
					result.add(clean)
				}
			}
		}

		return result.unique()
	}

	private boolean isExcelFile(String fileName) {
		String name = safeText(fileName).toLowerCase()

		return name.endsWith('.xlsx') ||
				name.endsWith('.xls') ||
				name.endsWith('.xlsm')
	}


