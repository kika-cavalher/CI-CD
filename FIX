3) Jenkinsfile inteiro corrigido (Archive Mode) ✅

Motivo do teu erro de “no nodes / offline”:

o Jenkins estava tentando rodar em label que não existe ou em node errado
no teu print existe o node Windows GIS_SWDCFRNXGI55817

Substitui Jenkinsfile_ArchiveMode.groovy por este:

pipeline {
  agent { label 'GIS_SWDCFRNXGI55817' }

  options {
    timestamps()
    ansiColor('xterm')
    disableConcurrentBuilds()
    timeout(time: 4, unit: 'HOURS')
  }

  environment {
    CTX_FILE     = 'D:\\Projects\\eMatchStarters\\run-context.properties'
    TASK_NAME    = '\\eMatch Automation\\RunEMatchDesktop'
    PROJECT_FILE = 'eMatch POC.prj'
    KATALON_EXE  = 'C:\\Users\\adgi5appjenkins\\Documents\\Katalon_Studio_Engine_Windows_64-8.1.0\\katalonc.exe'
    COLLECTION   = 'Test Suites/Archive Mode/Archive Mode Collection'
    BROWSER_TYPE = 'Windows'
    RETRY        = '0'
  }

  stages {
    stage('Prepare Context') {
      steps {
        script {
          def runner = load 'jenkinsIntegration/JenkinsDesktopPipelineRunner.groovy'

          // Always ensure Reports folder exists before marker checks
          bat '@echo off\r\nif not exist "Reports" mkdir "Reports"\r\nexit /b 0'

          def marker = "${env.WORKSPACE}\\Reports\\__jenkins_task_exitcode.txt"
          runner.deleteIfExists(marker)

          runner.writeRunContextFile(env.CTX_FILE, [
            WORKSPACE        : env.WORKSPACE,
            PROJECT_FILE     : env.PROJECT_FILE,
            KATALON_EXE       : env.KATALON_EXE,
            COLLECTION_PATH  : env.COLLECTION,
            BROWSER_TYPE     : env.BROWSER_TYPE,
            RETRY            : env.RETRY
          ])

          env.DESKTOP_MARKER = marker
        }
      }
    }

    stage('Run Desktop') {
      steps {
        script {
          def runner = load 'jenkinsIntegration/JenkinsDesktopPipelineRunner.groovy'
          int ec = runner.runScheduledTaskAndWaitMarker(env.TASK_NAME, env.DESKTOP_MARKER, 180)
          if (ec != 0) {
            error("Desktop execution failed. ExitCode=${ec}")
          }
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'Reports/**', allowEmptyArchive: true
    }
  }
}
