        def linkHtml = r.html ? "<a class='link' href='${escapeHtml(r.html)}' target='_blank'>🔗 Open suite report</a>" : "<span class='muted'>No HTML report</span>"
        def errorHtml = r.error ? "<pre>${escapeHtml(r.error)}</pre>" : "<div class='muted'>No extracted error lines</div>"

        return """
            <div class="card ${css}">
                <div class="title">${escapeHtml(r.name)}</div>
                <div class="path">${escapeHtml(r.path ?: '')}</div>
                <div class="status">${escapeHtml(r.status)} | exit ${escapeHtml(String.valueOf(r.exitCode))}</div>
                <div class="report">${linkHtml}</div>
                <div class="error-block">
