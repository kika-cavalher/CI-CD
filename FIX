	@Keyword
	boolean searchAndOpenMenu(String menuName, String imageGroup, String expectedObjectPath, int timeoutSeconds) {
		int effectiveTimeout = timeoutSeconds <= 0 ? 20 : timeoutSeconds
		int maxAttempts = 3

		KeywordUtil.logInfo(
				'Searching and opening menu.\n' +
				'Menu name: ' + menuName + '\n' +
				'Image group: ' + imageGroup + '\n' +
				'Expected object path/key: ' + expectedObjectPath + '\n' +
				'Timeout per attempt: ' + effectiveTimeout + ' seconds\n' +
				'Max attempts: ' + maxAttempts
				)

		WindowsTestObject searchBox = resolveSearchBox()

		for (int attempt = 1; attempt <= maxAttempts; attempt++) {
			KeywordUtil.logInfo('Starting menu open attempt ' + attempt + ' of ' + maxAttempts + '.')

			clickElementCenterByCoordinates(searchBox)
			Thread.sleep(300)

			clearFocusedField()
			pasteText(menuName)
			Thread.sleep(700)

			boolean openedByObject = tryOpenByObject(expectedObjectPath, imageGroup)

			if (openedByObject) {
				KeywordUtil.logInfo('Menu opened successfully by Windows object.')
				return true
			}

			boolean openedByImage = tryOpenByImage(imageGroup, expectedObjectPath, effectiveTimeout)

			if (openedByImage) {
				KeywordUtil.logInfo('Menu opened successfully by image fallback.')
				return true
			}

			KeywordUtil.logInfo(
					'Attempt finished and menu is still not open.\n' +
					'Attempt: ' + attempt + '/' + maxAttempts
					)
		}

		takeEvidence('MenuNotOpened.png')

		KeywordUtil.markFailedAndStop(
				'Menu was not opened after maximum retry attempts.\n' +
				'Menu name: ' + menuName + '\n' +
				'Image group: ' + imageGroup + '\n' +
				'Expected object path/key: ' + expectedObjectPath + '\n' +
				'Attempts: ' + maxAttempts
				)

		return false
	}

	private boolean tryOpenByMenuResult(String menuResultName, int timeoutSeconds, String matchMode) {
		return tryOpenByMenuResult(menuResultName, timeoutSeconds, matchMode, false)
	}

	private boolean tryOpenByMenuResult(String menuResultName, int timeoutSeconds, String matchMode, boolean preferLastMatch) {
		List<WindowsTestObject> candidates = buildMenuResultCandidates(menuResultName, matchMode, preferLastMatch)

		int elapsedSeconds = 0

		while (elapsedSeconds < timeoutSeconds) {
			for (WindowsTestObject candidate : candidates) {
				try {
					boolean isPresent = Windows.verifyElementPresent(
							candidate,
							1,
							FailureHandling.OPTIONAL
							)

					if (isPresent) {
						KeywordUtil.logInfo(
								'Menu result found. Clicking result.\n' +
								'Result text: ' + menuResultName + '\n' +
								'Match mode: ' + matchMode + '\n' +
								'Prefer last match: ' + preferLastMatch
								)

						clickElementCenterByCoordinates(candidate)
						Thread.sleep(500)

						pressKey(KeyEvent.VK_ENTER)
						Thread.sleep(1500)

						return true
					}
				} catch (Exception ignored) {
				}
			}

			Thread.sleep(500)
			elapsedSeconds = elapsedSeconds + 1
		}

		return false
	}

