/*
 * Responsibility:
 * Clean Jenkins console output for desktop asset execution.
 */

def cleanText(String value) {
    return (value ?: '').replaceAll(/\s+/, ' ').trim()
}

private long safeLong(def rawValue) {
    try {
        return (rawValue ?: '0').toString().trim().toLong()
    }
    catch (ignored) {
        return 0L
    }
}

private String normalizeStatus(def rawValue) {
    String value = (rawValue ?: '').toString().trim().toUpperCase()

    if (!value) {
        return 'FAILED'
    }

    return value
}

def formatDurationSeconds(def rawValue) {
    long total = safeLong(rawValue)

    long hours = (long) (total / 3600)
    long minutes = (long) ((total % 3600) / 60)
    long seconds = (long) (total % 60)

    return String.format('%02d:%02d:%02d', hours, minutes, seconds)
}

def sumDurationSeconds(List results) {
    long total = 0L

    (results ?: []).each { item ->
        total += safeLong(item?.durationSeconds)
    }

    return total
}

def printAssetHeader(script, Map asset, String timeoutMinutes) {
    script.echo '------------------------------------------------------------'
    script.echo '🚀 [START ASSET]'
    script.echo "📛 Name    : ${asset?.name ?: ''}"
    script.echo "🧪 Type    : ${asset?.type ?: ''}"
    script.echo "📁 Path    : ${asset?.path ?: ''}"
    script.echo "⏱️ Timeout : ${timeoutMinutes ?: ''} min"
    script.echo '------------------------------------------------------------'
}

def printAssetResult(script, Map result) {
    Map safeResult = result ?: [:]

    script.echo '------------------------------------------------------------'
    script.echo "${safeResult.icon ?: '❔'} ${safeResult.name ?: ''}"
    script.echo "🧪 Type    : ${safeResult.type ?: ''}"
    script.echo "⏱️ Time    : ${formatDurationSeconds(safeResult.durationSeconds)}"
    script.echo "📊 Stats   : Executed=${safeResult.executed ?: 0} | Passed=${safeResult.passed ?: 0} | Failed=${safeResult.failed ?: 0} | Skipped=${safeResult.skipped ?: 0}"

    if (safeResult.reason) {
        script.echo "🧾 Reason  : ${cleanText(safeResult.reason.toString())}"
    }

    if (safeResult.logRel) {
        script.echo "📄 Log     : Reports/${safeResult.logRel}"
    }

    (safeResult.caseSummary ?: []).take(3).each { line ->
        script.echo "🧪 Case    : ${cleanText(line.toString())}"
    }

    script.echo '------------------------------------------------------------'
}

def printRunningSummary(script, List results) {
    List safeResults = results ?: []

    def passed = safeResults.count { normalizeStatus(it?.status) == 'PASSED' }
    def failed = safeResults.count { normalizeStatus(it?.status) == 'FAILED' }
    def timeout = safeResults.count { normalizeStatus(it?.status) == 'TIMEOUT' }
    def totalTime = formatDurationSeconds(sumDurationSeconds(safeResults))

    script.currentBuild.description = "✅ ${passed} | ❌ ${failed + timeout} | ${totalTime}"

    script.echo '------------------------------------------------------------'
    script.echo "📌 RUNNING SUMMARY | ✅=${passed} | ❌=${failed} | ⏰=${timeout} | ⏱️=${totalTime}"
    script.echo '------------------------------------------------------------'
}

def printFinalSummary(script, List results, String currentResult) {
    List safeResults = results ?: []

    def passed = safeResults.count { normalizeStatus(it?.status) == 'PASSED' }
    def failed = safeResults.count { normalizeStatus(it?.status) == 'FAILED' }
    def timeout = safeResults.count { normalizeStatus(it?.status) == 'TIMEOUT' }
    def totalTime = formatDurationSeconds(sumDurationSeconds(safeResults))
    def total = safeResults.size()

    script.currentBuild.description = "✅ ${passed} | ❌ ${failed + timeout} | ${totalTime}"

    script.echo '============================================================'

    if (total == 0) {
        script.echo '⚠️ PIPELINE STOPPED BEFORE ANY ASSET WAS EXECUTED'
    }
    else if ((currentResult ?: '').toUpperCase() == 'ABORTED') {
        script.echo '🛑 PIPELINE ABORTED'
    }
    else if (failed > 0 || timeout > 0) {
        script.echo '❌ PIPELINE FINISHED WITH ERRORS'
    }
    else {
        script.echo '✅ PIPELINE FINISHED SUCCESSFULLY'
    }

    script.echo "📌 FINAL SUMMARY | ✅=${passed} | ❌=${failed} | ⏰=${timeout} | ⏱️=${totalTime}"
    script.echo '============================================================'

    safeResults.each { result ->
        printAssetResult(script, result as Map)
    }
}

return this
