    @Keyword
    void startEmatch(String currentUser, String targetWindowTitle) {
        String env = resolveEnvironment()
        String shortcutPath = getShortcutPath(env)
        String launcherBat = getLauncherBat(env)

        KeywordUtil.logInfo("Starting eMatch for environment: ${env}")
        KeywordUtil.logInfo("Current Windows user: ${currentUser}")
        KeywordUtil.logInfo("Target window title: ${targetWindowTitle}")
        KeywordUtil.logInfo("Shortcut path: ${shortcutPath}")
        KeywordUtil.logInfo("Application path: ${getApplicationPath(env)}")
        KeywordUtil.logInfo("Launcher BAT: ${launcherBat}")

        runResolutionScriptIfExists()

        boolean launchAttempted = false

        if (new File(shortcutPath).exists()) {
            KeywordUtil.logInfo('Trying shortcut first...')
            startDetachedCommand("start \"\" \"${shortcutPath}\"")
            launchAttempted = true
            Windows.delay(AFTER_START_DELAY_SEC)
        }

        if (!launchAttempted && new File(launcherBat).exists()) {
            KeywordUtil.logInfo('Shortcut not found. Trying launcher BAT...')
            Map launcherResult = runCommand("call \"${launcherBat}\"", COMMAND_TIMEOUT_SEC)

            if (launcherResult.exitCode != 0) {
                KeywordUtil.logInfo("Launcher BAT output:\n${launcherResult.output}")
                KeywordUtil.markFailedAndStop("Launcher BAT failed for environment '${env}'.")
            }

            launchAttempted = true
            Windows.delay(AFTER_START_DELAY_SEC)
        }

        if (!launchAttempted) {
            KeywordUtil.markFailedAndStop("Could not launch eMatch. Shortcut and launcher BAT were both unavailable.")
        }

        KeywordUtil.logInfo('Launch command executed. Ensuring WinAppDriver is available...')
        ensureWinAppDriverRunning()
    }

    @Keyword
    void attachToLoginWindow(String targetWindowTitle) {
        String exactWindow = targetWindowTitle
        String containsWindow = targetWindowTitle?.contains(' - ') ? targetWindowTitle.split(' - ')[0] : targetWindowTitle

        boolean windowFound = false
        int elapsedTime = 0

        while (!windowFound && elapsedTime < WINDOW_ATTACH_TIMEOUT_SEC) {
            try {
                try {
                    Windows.startExistingApplication(exactWindow)
                } catch (Exception ignored) {
                    Windows.startExistingApplication(containsWindow)
                }

                windowFound = true
                KeywordUtil.logInfo("Attached to target window: ${targetWindowTitle}")
                break
            } catch (Exception e) {
                Windows.delay(WINDOW_ATTACH_RETRY_SEC)
                elapsedTime += WINDOW_ATTACH_RETRY_SEC
            }
        }

        if (!windowFound) {
            KeywordUtil.markFailedAndStop("Target window '${targetWindowTitle}' could not be found within ${WINDOW_ATTACH_TIMEOUT_SEC} seconds.")
        }
    }

    @Keyword
    void openEnvironmentDropdown() {
        clickWithRetry('Login Page/optEnv', 3, 10)
        Windows.delay(AFTER_ENV_DROPDOWN_DELAY_SEC)
    }

    @Keyword
    int resolveEnvironmentIndex(String environment) {
        String envName = (environment ?: '').trim().toUpperCase()
        int env = 3

        switch (envName) {
            case 'PRD':
            case 'PROD':
                env = 1
                break
            case 'PREX':
                env = 2
                break
            case 'REC2':
                env = 3
                break
            case 'REC':
                env = 4
                break
            case 'DEV2':
                env = 5
                break
            case 'DEV':
                env = 6
                break
            default:
                env = 4
                break
        }

        return env
    }

    @Keyword
    void selectEnvironment(String environment) {
        int env = resolveEnvironmentIndex(environment)

        for (int i = 0; i < env; i++) {
            Windows.sendKeys(findWindowsObject('Login Page/optEnv'), Keys.chord(Keys.ARROW_DOWN))
        }

        Windows.sendKeys(findWindowsObject('Login Page/optEnv'), Keys.chord(Keys.ENTER))
        Windows.delay(AFTER_ENV_SELECTION_DELAY_SEC)
    }

