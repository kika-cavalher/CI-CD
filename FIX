function Clean-Text {
    param([string]$Value)

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return ''
    }

    return (($Value -replace '[\\r\\n]+', ' ') -replace '\\s+', ' ').Trim()
}

function Short-Text {
    param(
        [string]$Value,
        [int]$Max = 220
    )

    $text = Clean-Text $Value

    if ($text.Length -gt $Max) {
        return $text.Substring(0, $Max - 3) + '...'
    }

    return $text
}

function Ensure-ParentDirectory {
    param([string]$Path)

    $parent = Split-Path -Path $Path -Parent
    if (-not [string]::IsNullOrWhiteSpace($parent) -and -not (Test-Path -LiteralPath $parent)) {
        New-Item -ItemType Directory -Path $parent -Force | Out-Null
    }
}

function Read-NewContent {
    param(
        [string]$Path,
        [ref]$Offset
    )

    if (-not (Test-Path -LiteralPath $Path)) {
        return @()
    }

    $fs = $null
    $sr = $null

    try {
        $fs = [System.IO.File]::Open($Path, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, [System.IO.FileShare]::ReadWrite)
        [void]$fs.Seek($Offset.Value, [System.IO.SeekOrigin]::Begin)
        $sr = New-Object System.IO.StreamReader($fs)
        $content = $sr.ReadToEnd()
        $Offset.Value = $fs.Position

        if ([string]::IsNullOrWhiteSpace($content)) {
            return @()
        }

        return @($content -split "`r?`n")
    }
    catch {
        return @()
    }
    finally {
        if ($sr) { $sr.Close() }
        if ($fs) { $fs.Close() }
    }
}

function Find-LatestJunit {
    param([string]$Root)

    if (-not (Test-Path -LiteralPath $Root)) {
        return ''
    }

    $candidate = Get-ChildItem -Path $Root -Filter 'JUnit_Report.xml' -File -Recurse -ErrorAction SilentlyContinue |
        Sort-Object LastWriteTime -Descending |
        Select-Object -First 1

    if ($candidate) {
        return $candidate.FullName
    }

    return ''
}

function Get-JUnitSummary {
    param([string]$JunitFile)

    $result = [ordered]@{
        Executed = 0
        Passed   = 0
        Failed   = 0
        Skipped  = 0
        Reason   = ''
    }

    if ([string]::IsNullOrWhiteSpace($JunitFile) -or -not (Test-Path -LiteralPath $JunitFile)) {
        return $result
    }

    try {
        [xml]$xml = Get-Content -LiteralPath $JunitFile -Raw

        $testcases = @()

        if ($xml.testsuite) {
            $testcases = @($xml.testsuite.testcase)
        }
        elseif ($xml.testsuites) {
            foreach ($ts in @($xml.testsuites.testsuite)) {
                $testcases += @($ts.testcase)
            }
        }

        $testcases = @($testcases | Where-Object { $_ })
        $result.Executed = $testcases.Count

        $failedNodes  = @($testcases | Where-Object { $_.failure -or $_.error })
        $skippedNodes = @($testcases | Where-Object { $_.skipped })

        $result.Failed  = $failedNodes.Count
        $result.Skipped = $skippedNodes.Count
        $result.Passed  = $result.Executed - $result.Failed - $result.Skipped

        if ($failedNodes.Count -gt 0) {
            $firstBad = $failedNodes[0]

            if ($firstBad.failure) {
                $message = ''
                if ($firstBad.failure.message) {
                    $message = [string]$firstBad.failure.message
                }
                $inner = ''
                if ($firstBad.failure.InnerText) {
                    $inner = [string]$firstBad.failure.InnerText
                }
                $result.Reason = Short-Text ($message + ' ' + $inner)
            }
            elseif ($firstBad.error) {
                $message = ''
                if ($firstBad.error.message) {
                    $message = [string]$firstBad.error.message
                }
                $inner = ''
                if ($firstBad.error.InnerText) {
                    $inner = [string]$firstBad.error.InnerText
                }
                $result.Reason = Short-Text ($message + ' ' + $inner)
            }
        }
    }
    catch {
        $result.Reason = Short-Text $_.Exception.Message
    }

    return $result
}

function Get-LogRelativePath {
    param(
        [string]$ReportsRoot,
        [string]$CurrentLogFile
    )

    $reportsRootValue = [string]$ReportsRoot
    $currentLogValue  = [string]$CurrentLogFile

    if ([string]::IsNullOrWhiteSpace($reportsRootValue) -or [string]::IsNullOrWhiteSpace($currentLogValue)) {
        return 'Reports/_desktop_logs/katalon_current.log'
    }

    try {
        $reportsRootClean = $reportsRootValue.TrimEnd('\\')
        if ($currentLogValue.ToLower().StartsWith($reportsRootClean.ToLower())) {
            $relative = $currentLogValue.Substring($reportsRootClean.Length).TrimStart('\\')
            return ('Reports/' + ($relative -replace '\\\\', '/'))
        }
    }
    catch {
    }

    return 'Reports/_desktop_logs/katalon_current.log'
}

