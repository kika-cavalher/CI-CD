	@Keyword
	Map validateLatestRecPrdExport(
			String exportRootFolder,
			String exportGroupFolder,
			String exportFeatureFolder,
			Integer columnIndex,
			String expectedColumnName) {

		Map result = createEmptyResult(
				exportRootFolder,
				exportGroupFolder,
				exportFeatureFolder,
				columnIndex,
				expectedColumnName
				)

		StringBuilder errors = new StringBuilder()
		StringBuilder passedDetails = new StringBuilder()

		File recFile = null
		File prdFile = null

		try {
			File exportRoot = new File(safeText(exportRootFolder))
			int validatedColumnIndex =
					columnIndex == null
					? -1
					: columnIndex.intValue()

			if (!exportRoot.exists()) {
				errors.append('[ERROR] Export root folder does not exist.\n')
						.append('Folder: ')
						.append(exportRoot.getAbsolutePath())

				return finalizeResult(
						result,
						errors,
						passedDetails
						)
			}

			if (!exportRoot.isDirectory()) {
				errors.append('[ERROR] Export root path is not a folder.\n')
						.append('Path: ')
						.append(exportRoot.getAbsolutePath())

				return finalizeResult(
						result,
						errors,
						passedDetails
						)
			}

			if (validatedColumnIndex < 0) {
				errors.append('[ERROR] Invalid column index.\n')
						.append('Column index: ')
						.append(validatedColumnIndex)

				return finalizeResult(
						result,
						errors,
						passedDetails
						)
			}

			KeywordUtil.logInfo(
					'[REC X PRD SEARCH] root=' +
					exportRoot.getAbsolutePath() +
					' | group=' +
					safeText(exportGroupFolder) +
					' | feature=' +
					safeText(exportFeatureFolder)
					)

			Map selectedFiles = resolveLatestRecPrdFiles(
					exportRoot,
					exportGroupFolder,
					exportFeatureFolder
					)

			recFile = selectedFiles.recFile as File
			prdFile = selectedFiles.prdFile as File

			File selectedFolder =
					selectedFiles.selectedFolder as File

			result.recFileName =
					recFile == null
					? 'NOT FOUND'
					: recFile.getName()

			result.prdFileName =
					prdFile == null
					? 'NOT FOUND'
					: prdFile.getName()

			result.selectedFolderPath =
					selectedFolder == null
					? ''
					: selectedFolder.getAbsolutePath()

			if (recFile == null) {
				errors.append('[ERROR] REC exported file was not found.\n')
						.append('Search root: ')
						.append(exportRoot.getAbsolutePath())
						.append('\nExpected folder: ')
						.append(safeText(exportGroupFolder))
						.append('\\')
						.append(safeText(exportFeatureFolder))
						.append('\n')
			}

			if (prdFile == null) {
				errors.append('[ERROR] PRD exported file was not found.\n')
						.append('Search root: ')
						.append(exportRoot.getAbsolutePath())
						.append('\nExpected folder: ')
						.append(safeText(exportGroupFolder))
						.append('\\')
						.append(safeText(exportFeatureFolder))
						.append('\n')
			}

			if (errors.length() > 0) {
				return finalizeResult(
						result,
						errors,
						passedDetails
						)
			}

			KeywordUtil.logInfo(
					'[REC X PRD SEARCH] selectedFolder=' +
					selectedFolder.getAbsolutePath() +
					' | REC=' +
					recFile.getName() +
					' | PRD=' +
					prdFile.getName()
					)

			/*
			 * Read REC and PRD sequentially.
			 * This avoids keeping both large workbooks
			 * in memory at the same time.
			 */
			Map recData = readFileData(
					recFile,
					validatedColumnIndex,
					expectedColumnName,
					'REC'
					)

			System.gc()

			Map prdData = readFileData(
					prdFile,
					validatedColumnIndex,
					expectedColumnName,
					'PRD'
					)

			System.gc()

			result.recColumnName =
					safeText(recData.columnName)

			result.prdColumnName =
					safeText(prdData.columnName)

			result.columnName =
					!safeText(recData.columnName).isEmpty()
					? safeText(recData.columnName)
					: safeText(expectedColumnName)

			result.recRows = recData.rows
			result.prdRows = prdData.rows

			result.recNumericValues =
					recData.numericValues

			result.prdNumericValues =
					prdData.numericValues

			result.recSum = recData.sum
			result.prdSum = prdData.sum

			result.recMinimum =
					recData.minimum

			result.prdMinimum =
					prdData.minimum

			result.recMaximum =
					recData.maximum

			result.prdMaximum =
					prdData.maximum

			if (!safeText(recData.errors).isEmpty()) {
				errors.append(
						safeText(recData.errors)
						)
						.append('\n')
			}

			if (!safeText(prdData.errors).isEmpty()) {
				errors.append(
						safeText(prdData.errors)
						)
						.append('\n')
			}

			if (errors.length() > 0) {
				return finalizeResult(
						result,
						errors,
						passedDetails
						)
			}

			if (!normalizeText(result.recColumnName).equals(
					normalizeText(result.prdColumnName))) {

				errors.append(
						'[ERROR] REC and PRD column headers are different.\n'
						)
						.append('REC: ')
						.append(result.recColumnName)
						.append('\nPRD: ')
						.append(result.prdColumnName)
						.append('\n')
			}

			if ((result.recRows as int) !=
					(result.prdRows as int)) {

				errors.append('[ERROR] Number of rows is different.\n')
						.append('REC: ')
						.append(result.recRows)
						.append('\nPRD: ')
						.append(result.prdRows)
						.append('\n')
			} else {
				passedDetails.append(
						'[PASS] Number of rows is equal.\n'
						)
						.append('REC: ')
						.append(result.recRows)
						.append('\nPRD: ')
						.append(result.prdRows)
						.append('\n')
			}

			appendComparison(
					errors,
					passedDetails,
					'Column sum',
					result.columnName as String,
					result.recSum as BigDecimal,
					result.prdSum as BigDecimal
					)

			appendComparison(
					errors,
					passedDetails,
					'Minimum value',
					result.columnName as String,
					result.recMinimum as BigDecimal,
					result.prdMinimum as BigDecimal
					)

			appendComparison(
					errors,
					passedDetails,
					'Maximum value',
					result.columnName as String,
					result.recMaximum as BigDecimal,
					result.prdMaximum as BigDecimal
					)
		} catch (OutOfMemoryError error) {
			KeywordUtil.logInfo(
					'Complete Excel validation exceeded the available JVM memory.\n' +
					'Fallback validation will compare only the number of rows.\n' +
					'Reason: ' +
					safeText(error.getMessage())
					)

			errors.setLength(0)
			passedDetails.setLength(0)
			clearStatistics(result)

			try {
				System.gc()
				Thread.sleep(1000)
			} catch (Exception ignored) {
			}

			if (recFile == null ||
					prdFile == null) {

				errors.append(
						'[ERROR] Row-count fallback could not be executed because REC or PRD file was not resolved.'
						)
			} else {
				int recRows =
						readRowCountStreaming(
						recFile,
						'REC'
						)

				int prdRows =
						readRowCountStreaming(
						prdFile,
						'PRD'
						)

				result.recRows = recRows
				result.prdRows = prdRows
				result.fallbackUsed = true
				result.validationMode =
						'ROW_COUNT_FALLBACK'

				passedDetails.append(
						'[INFO] Full column validation was replaced by row-count validation because the Excel file exceeded available memory.\n'
						)

				if (recRows != prdRows) {
					errors.append(
							'[ERROR] Number of rows is different.\n'
							)
							.append('REC: ')
							.append(recRows)
							.append('\nPRD: ')
							.append(prdRows)
				} else {
					passedDetails.append(
							'[PASS] Number of rows is equal.\n'
							)
							.append('REC: ')
							.append(recRows)
							.append('\nPRD: ')
							.append(prdRows)
				}
			}
		} catch (Exception exception) {
			errors.append(
					'[ERROR] REC x PRD export validation failed.\n'
					)
					.append('Exception: ')
					.append(
					exception
					.getClass()
					.getSimpleName()
					)
					.append('\nMessage: ')
					.append(
					safeText(
					exception.getMessage()
					)
					)
		}

		return finalizeResult(
				result,
				errors,
				passedDetails
				)
	}


	private int readRowCountStreaming(
			File file,
			String environment) {

		String lowerName =
				file.getName().toLowerCase()

		if (!lowerName.endsWith('.xlsx') &&
				!lowerName.endsWith('.xlsm')) {

			return readRowCountWithWorkbook(
					file,
					environment
					)
		}

		OPCPackage opcPackage = null
		InputStream sheetInput = null

		try {
			opcPackage = OPCPackage.open(file)

			XSSFReader reader =
					new XSSFReader(opcPackage)

			StylesTable styles =
					reader.getStylesTable()

			ReadOnlySharedStringsTable sharedStrings =
					new ReadOnlySharedStringsTable(
					opcPackage
					)

			Iterator<InputStream> sheets =
					reader.getSheetsData()

			if (!sheets.hasNext()) {
				throw new IllegalStateException(
				environment +
				' workbook does not contain worksheets.'
				)
			}

			sheetInput = sheets.next()

			RowCountStreamingHandler rowHandler =
					new RowCountStreamingHandler()

			XSSFSheetXMLHandler sheetHandler =
					new XSSFSheetXMLHandler(
					styles,
					null,
					sharedStrings,
					rowHandler,
					new DataFormatter(),
					false
					)

			SAXParserFactory parserFactory =
					SAXParserFactory.newInstance()

			parserFactory.setNamespaceAware(true)

			XMLReader parser =
					parserFactory
					.newSAXParser()
					.getXMLReader()

			parser.setContentHandler(sheetHandler)
			parser.parse(
					new InputSource(sheetInput)
					)

			return rowHandler.rows
		} finally {
			try {
				if (sheetInput != null) {
					sheetInput.close()
				}
			} catch (Exception ignored) {
			}

			try {
				if (opcPackage != null) {
					opcPackage.close()
				}
			} catch (Exception ignored) {
			}
		}
	}


	private int readRowCountWithWorkbook(
			File file,
			String environment) {

		FileInputStream input = null
		Workbook workbook = null

		try {
			input = new FileInputStream(file)

			workbook =
					WorkbookFactory.create(input)

			if (workbook.getNumberOfSheets() == 0) {
				throw new IllegalStateException(
				environment +
				' workbook does not contain worksheets.'
				)
			}

			Sheet sheet =
					workbook.getSheetAt(0)

			DataFormatter formatter =
					new DataFormatter()

			int rows = 0

			for (int rowIndex = 1;
					rowIndex <= sheet.getLastRowNum();
					rowIndex++) {

				Row row =
						sheet.getRow(rowIndex)

				if (row != null &&
						!isRowEmpty(
						row,
						formatter
						)) {

					rows++
				}
			}

			return rows
		} finally {
			try {
				if (workbook != null) {
					workbook.close()
				}
			} catch (Exception ignored) {
			}

			try {
				if (input != null) {
					input.close()
				}
			} catch (Exception ignored) {
			}
		}
	}


	private void clearStatistics(Map result) {

		result.recColumnName = ''
		result.prdColumnName = ''

		result.recRows = null
		result.prdRows = null

		result.recNumericValues = null
		result.prdNumericValues = null

		result.recSum = null
		result.prdSum = null

		result.recMinimum = null
		result.prdMinimum = null

		result.recMaximum = null
		result.prdMaximum = null
	}


	private static class RowCountStreamingHandler
	implements XSSFSheetXMLHandler.SheetContentsHandler {

		int rows = 0

		private boolean rowHasValue = false

		@Override
		void startRow(int rowNum) {
			rowHasValue = false
		}

		@Override
		void endRow(int rowNum) {

			if (rowNum > 0 &&
					rowHasValue) {

				rows++
			}
		}

		@Override
		void cell(
				String cellReference,
				String formattedValue,
				XSSFComment comment) {

			if (formattedValue != null &&
					!formattedValue
					.trim()
					.isEmpty()) {

				rowHasValue = true
			}
		}

		@Override
		void headerFooter(
				String text,
				boolean isHeader,
				String tagName) {
		}
	}


	private Map readFileData(
			File file,
			int columnIndex,
			String expectedColumnName,
			String environment) {

		Map result = [
			columnName   : '',
			rows         : 0,
			numericValues: 0,
			sum          : null,
			minimum      : null,
			maximum      : null,
			errors       : ''
		]

		StringBuilder errors =
				new StringBuilder()

		FileInputStream input = null
		Workbook workbook = null

		try {
			input = new FileInputStream(file)

			workbook =
					WorkbookFactory.create(input)

			if (workbook.getNumberOfSheets() == 0) {
				errors.append('[ERROR] ')
						.append(environment)
						.append(
						' workbook does not contain worksheets.\n'
						)
						.append('File: ')
						.append(file.getName())

				result.errors =
						errors.toString()

				return result
			}

			Sheet sheet =
					workbook.getSheetAt(0)

			DataFormatter formatter =
					new DataFormatter()

			FormulaEvaluator evaluator =
					workbook
					.getCreationHelper()
					.createFormulaEvaluator()

			String columnName =
					readHeaderName(
					sheet,
					columnIndex,
					formatter
					)

			result.columnName = columnName

			if (columnName.isEmpty()) {
				errors.append('[ERROR] ')
						.append(environment)
						.append(
						' column header was not found.\n'
						)
						.append('Column index: ')
						.append(columnIndex)
						.append('\n')
			} else if (!normalizeText(columnName).equals(
					normalizeText(expectedColumnName))) {

				errors.append('[ERROR] Unexpected ')
						.append(environment)
						.append(
						' column header.\n'
						)
						.append('Expected: ')
						.append(
						safeText(
						expectedColumnName
						)
						)
						.append('\nFound: ')
						.append(columnName)
						.append('\n')
			}

			BigDecimal sum =
					BigDecimal.ZERO

			BigDecimal minimum = null
			BigDecimal maximum = null

			int numericValues = 0
			int rows = 0

			for (int rowIndex = 1;
					rowIndex <= sheet.getLastRowNum();
					rowIndex++) {

				Row row =
						sheet.getRow(rowIndex)

				if (row == null ||
						isRowEmpty(
						row,
						formatter
						)) {

					continue
				}

				rows++

				BigDecimal value =
						getCellNumber(
						row,
						columnIndex,
						formatter,
						evaluator
						)

				if (value == null) {
					continue
				}

				sum = sum.add(value)

				if (minimum == null ||
						value.compareTo(minimum) < 0) {

					minimum = value
				}

				if (maximum == null ||
						value.compareTo(maximum) > 0) {

					maximum = value
				}

				numericValues++
			}

			result.rows = rows

			result.numericValues =
					numericValues

			if (numericValues == 0) {
				errors.append('[ERROR] ')
						.append(environment)
						.append(
						' column does not contain numeric values.\n'
						)
						.append('Column: ')
						.append(columnName)
						.append('\n')
			} else {
				result.sum =
						round2(sum)

				result.minimum =
						round2(minimum)

				result.maximum =
						round2(maximum)
			}

			result.errors =
					errors
					.toString()
					.trim()

			return result
		} finally {
			closeWorkbook(workbook)
			closeInput(input)
		}
	}


