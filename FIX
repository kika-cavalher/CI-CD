	String findFirstFileRecursively(String rootPath, List<String> exactNames) {
		if (isBlank(rootPath)) {
			return ''
		}

		File root = new File(rootPath)
		if (!root.exists()) {
			return ''
		}

		File found = null

		root.eachFileRecurse(FileType.FILES) { File file ->
			if (found != null) return
			if (exactNames.any { it.equalsIgnoreCase(file.name) }) {
				found = file
			}
		}

		return found != null ? found.absolutePath : ''
	}

	String getXmlFilePath() {
		String reportPath = getResolvedReportPath()

		String xml = findFirstFileRecursively(reportPath, ['JUnit_Report.xml', 'cucumber.xml'])
		if (!isBlank(xml)) {
			KeywordUtil.logInfo("XML file found: ${xml}")
		}
		return xml
	}

	List<File> getFailureImages(String reportPath) {
		List<File> images = []

		if (isBlank(reportPath)) {
			return images
		}

		File root = new File(reportPath)
		if (!root.exists()) {
			return images
		}

		root.eachFileRecurse(FileType.FILES) { File file ->
			String lower = file.name.toLowerCase()

			if (
				(lower.endsWith('.png') || lower.endsWith('.jpg') || lower.endsWith('.jpeg'))
				&& !lower.contains('logo')
				&& !lower.contains('icon')
			) {
				images.add(file)
			}
		}

		images.sort { a, b -> a.lastModified() <=> b.lastModified() }
		return images
	}

