package jiraIntegration

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration

import java.util.Base64
import java.util.Collections
import java.util.LinkedHashSet
import java.util.Locale

class JiraImagesEvidence {

	private static final String TRACE_FILE_NAME = '_jira_images_evidence.tsv'
	private static final int TIME_BUFFER_MS = 60000

	private static final Map<String, Long> CASE_STARTS =
	Collections.synchronizedMap(new LinkedHashMap<String, Long>())

	@Keyword
	static void startCase(Object caseRef) {
		String caseId = resolveCaseId(caseRef)
		if (caseId.isEmpty()) {
			return
		}

		long now = System.currentTimeMillis()
		CASE_STARTS[caseId] = now
		appendTrace('CASE_START', caseId, '')
	}

	@Keyword
	static void beforeCase(Object caseRef) {
		startCase(caseRef)
	}

	@Keyword
	static void endCase(Object caseRef) {
		String caseId = resolveCaseId(caseRef)
		if (caseId.isEmpty()) {
			return
		}

		long startMs = CASE_STARTS.containsKey(caseId) ? (CASE_STARTS[caseId] as long) : System.currentTimeMillis()
		long endMs = System.currentTimeMillis()

		autoRegisterImages(caseId, startMs, endMs)
		appendTrace('CASE_END', caseId, '')

		CASE_STARTS.remove(caseId)
	}

	@Keyword
	static void afterCase(Object caseRef) {
		endCase(caseRef)
	}

	@Keyword
	static void failCase(Object caseRef, Object reason) {
		String caseId = resolveCaseId(caseRef)
		if (caseId.isEmpty()) {
			return
		}

		String fullError = toFullError(reason)
		if (!fullError.isEmpty()) {
			appendTrace('ERROR', caseId, fullError)
		}
	}

	@Keyword
	static void captureFailure(Object caseRef, Object reason) {
		failCase(caseRef, reason)
	}

	@Keyword
	static void addEvidence(Object caseRef, Object imagePath) {
		String caseId = resolveCaseId(caseRef)
		String path = safe(imagePath)

		if (caseId.isEmpty() || path.isEmpty()) {
			return
		}

		appendTrace('IMAGE', caseId, path)
	}

	@Keyword
	static void registerImage(Object caseRef, Object imagePath) {
		addEvidence(caseRef, imagePath)
	}

	private static void autoRegisterImages(String caseId, long startMs, long endMs) {
		List<File> roots = collectSearchRoots()
		Set<String> alreadyAdded = new LinkedHashSet<String>()
		List<String> tokens = tokenize(caseId)
		String normalizedCase = normalize(caseId)

		roots.each { File root ->
			if (root == null || !root.exists() || !root.isDirectory()) {
				return
			}

			root.eachFileRecurse { File file ->
				if (!isUsefulImage(file)) {
					return
				}

				String pathKey = normalize(file.absolutePath)
				long fileMs = file.lastModified()

				boolean matchesTime =
						fileMs >= (startMs - TIME_BUFFER_MS) &&
						fileMs <= (endMs + TIME_BUFFER_MS)

				boolean matchesCase = !normalizedCase.isEmpty() && pathKey.contains(normalizedCase)
				boolean matchesTokens = tokens.any { String token -> pathKey.contains(token) }

				if (matchesTime || matchesCase || matchesTokens) {
					if (alreadyAdded.add(file.absolutePath)) {
						appendTrace('IMAGE', caseId, file.absolutePath)
					}
				}
			}
		}
	}

	private static List<File> collectSearchRoots() {
		List<File> roots = []
		File reportFolder = resolveReportFolder()

		if (reportFolder != null) {
			roots << reportFolder
			if (reportFolder.parentFile != null) {
				roots << reportFolder.parentFile
			}
			if (reportFolder.parentFile?.parentFile != null) {
				roots << reportFolder.parentFile.parentFile
			}
		}

		return roots
				.findAll { File it -> it != null && it.exists() && it.isDirectory() }
				.unique { File it -> it.absolutePath }
	}

	private static File resolveReportFolder() {
		try {
			String reportFolderPath = safe(RunConfiguration.getReportFolder())
			if (!reportFolderPath.isEmpty()) {
				File reportFolder = new File(reportFolderPath)
				if (reportFolder.exists()) {
					return reportFolder
				}
			}
		} catch (Exception ignored) {
		}

		try {
			File reportsRoot = new File(RunConfiguration.getProjectDir(), 'Reports')
			if (reportsRoot.exists()) {
				return reportsRoot
			}
		} catch (Exception ignored) {
		}

		return null
	}

	private static File resolveTraceFile() {
		File reportFolder = resolveReportFolder()
		if (reportFolder == null) {
			return null
		}

		return new File(reportFolder, TRACE_FILE_NAME)
	}

	private static void appendTrace(String type, String caseId, String payload) {
		File traceFile = resolveTraceFile()
		if (traceFile == null) {
			return
		}

		try {
			if (traceFile.parentFile != null && !traceFile.parentFile.exists()) {
				traceFile.parentFile.mkdirs()
			}

			String encodedPayload = Base64.encoder.encodeToString(safe(payload).getBytes('UTF-8'))
			String line = safe(type) + '\t' + System.currentTimeMillis() + '\t' + safe(caseId) + '\t' + encodedPayload + System.lineSeparator()
			traceFile << line
		} catch (Exception ignored) {
		}
	}

	private static boolean isUsefulImage(File file) {
		if (file == null || !file.exists() || !file.isFile() || file.length() <= 0L) {
			return false
		}

		String lower = safe(file.name).toLowerCase(Locale.ENGLISH)

		boolean image =
				lower.endsWith('.png') ||
				lower.endsWith('.jpg') ||
				lower.endsWith('.jpeg') ||
				lower.endsWith('.gif') ||
				lower.endsWith('.bmp') ||
				lower.endsWith('.webp')

		if (!image) {
			return false
		}

		return !lower.contains('logo')
	}

	private static String resolveCaseId(Object caseRef) {
		if (caseRef == null) {
			return ''
		}

		try {
			if (caseRef.metaClass?.respondsTo(caseRef, 'getTestCaseId')) {
				String id = safe(caseRef.getTestCaseId())
				if (!id.isEmpty()) {
					return id
				}
			}
		} catch (Exception ignored) {
		}

		return safe(caseRef)
	}

	private static String toFullError(Object reason) {
		if (reason == null) {
			return ''
		}

		if (reason instanceof Throwable) {
			StringWriter sw = new StringWriter()
			PrintWriter pw = new PrintWriter(sw)
			((Throwable) reason).printStackTrace(pw)
			pw.flush()
			return safe(sw.toString())
		}

		return safe(reason)
	}

	private static List<String> tokenize(String value) {
		return safe(value)
				.toLowerCase(Locale.ENGLISH)
				.split('[^a-z0-9]+')
				.findAll { String token -> token != null && token.trim().length() >= 4 }
	}

	private static String normalize(String value) {
		return safe(value)
				.toLowerCase(Locale.ENGLISH)
				.replaceAll('[^a-z0-9]+', '')
	}

	private static String safe(Object value) {
		return value == null ? '' : String.valueOf(value).trim()
	}
}
