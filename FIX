        html.append('</div>\n')

        html.append('<div id="testsSidebarPanel" class="sidebar-panel">\n')
        html.append('<div class="search-wrap">\n')
        html.append('<input id="scenarioSearch" class="search-input" type="text" placeholder="Search test name, path, or status." oninput="filterScenarios()">\n')
        html.append('</div>\n')
        html.append('<div id="scenarioList" class="scenario-list">\n')
        page.scenarios.each { Map scenario ->
            html.append(buildScenarioSidebarItem(scenario))
        }
        html.append('</div>\n')
        html.append('</div>\n')

        html.append('<div id="chartsSidebarPanel" class="sidebar-panel hidden">\n')
        html.append('<div class="sidebar-section-title">Execution Status</div>\n')
        html.append('<div class="sidebar-status-summary">\n')
