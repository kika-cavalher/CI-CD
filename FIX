	private File saveToShortExportFolder(
			String exportLabel,
			String targetEnvironment
	) {
		String environment = resolveEnvironmentName(
				targetEnvironment,
				exportLabel
				)

		String collectionName = shortenFilePart(
				sanitizeFileName(
				resolveCurrentCollectionName()
				),
				MAX_COLLECTION_LENGTH
				)

		String featureName = shortenFilePart(
				sanitizeFileName(
				resolveCurrentFeatureName()
				),
				MAX_FEATURE_LENGTH
				)

		String exportLabelSuffix = shortenFilePart(
				resolveExportLabelSuffixForFileName(
				exportLabel
				),
				MAX_LABEL_LENGTH
				)

		File directory = resolveShortExportDirectory(
				environment,
				collectionName,
				featureName
				)

		if (!directory.exists()) {
			boolean created = directory.mkdirs()

			if (!created && !directory.exists()) {
				KeywordUtil.markFailedAndStop(
						'Could not create short export directory.\n' +
						'Directory: ' + directory.getAbsolutePath()
						)
			}
		}

		String fileName = buildAutomaticExportFileName(
				environment,
				featureName,
				exportLabelSuffix
				)

		File exportedFile = new File(
				directory,
				fileName
				)

		exportedFile = ensurePathIsShortEnough(
				exportedFile,
				environment,
				exportLabelSuffix
				)

		KeywordUtil.logInfo(
				'Short export configuration.\n' +
				'Environment: ' + environment + '\n' +
				'Collection: ' + collectionName + '\n' +
				'Feature: ' + featureName + '\n' +
				'Export label: ' + exportLabelSuffix + '\n' +
				'Directory: ' + exportedFile.getParentFile().getAbsolutePath() + '\n' +
				'File name: ' + exportedFile.getName() + '\n' +
				'Full path length: ' + exportedFile.getAbsolutePath().length() + '\n' +
				'Maximum allowed by automation: ' + MAX_WINDOWS_PATH_LENGTH
				)

		Windows.click(
				findWindowsObject(
				'Object Repository/Acapulco/filePath'
				)
				)

		Windows.delay(1)

		clearFocusedField()

		pasteAndEnter(
				exportedFile.getParentFile().getAbsolutePath()
				)

		Windows.delay(2)

		setFileName(
				exportedFile.getName()
				)

		Windows.click(
				findWindowsObject(
				'General/btnSave'
				)
				)

		Windows.delay(3)

		waitForExportedFileOrStop(
				exportedFile,
				20
				)

		return exportedFile
	}

	private File resolveShortExportDirectory(
			String environment,
			String collectionName,
			String featureName
	) {
		File rootDirectory = resolveShortExportRoot()

		File environmentDirectory = new File(
				rootDirectory,
				shortenFilePart(
				sanitizeFileName(environment),
				8
				)
				)

		File collectionDirectory = new File(
				environmentDirectory,
				collectionName
				)

		return new File(
				collectionDirectory,
				featureName
				)
	}

	private File resolveShortExportRoot() {
		File preferredRoot = new File(
				SHORT_EXPORT_ROOT
				)

		try {
			if (!preferredRoot.exists()) {
				preferredRoot.mkdirs()
			}

			if (preferredRoot.exists() &&
					preferredRoot.isDirectory() &&
					preferredRoot.canWrite()) {
				return preferredRoot
			}
		} catch (Exception ignored) {
		}

		File temporaryRoot = new File(
				System.getProperty('java.io.tmpdir'),
				'KatalonExports'
				)

		if (!temporaryRoot.exists()) {
			temporaryRoot.mkdirs()
		}

		return temporaryRoot
	}

	private File ensurePathIsShortEnough(
			File proposedFile,
			String environment,
			String exportLabelSuffix
	) {
		if (proposedFile.getAbsolutePath().length() <= MAX_WINDOWS_PATH_LENGTH) {
			return proposedFile
		}

		String timestamp = new SimpleDateFormat(
				'yyyyMMdd_HHmmss'
				).format(
				new Date()
				)

		String shortEnvironment = shortenFilePart(
				sanitizeFileName(environment),
				6
				)

		String shortLabel = shortenFilePart(
				sanitizeFileName(exportLabelSuffix),
				12
				)

		File shortDirectory = new File(
				resolveShortExportRoot(),
				shortEnvironment
				)

		if (!shortDirectory.exists()) {
			shortDirectory.mkdirs()
		}

		String shortFileName =
				shortEnvironment +
				'_' +
				timestamp

		if (shortLabel != null && !shortLabel.trim().isEmpty()) {
			shortFileName =
					shortFileName +
					'_' +
					shortLabel
		}

		shortFileName =
				shortFileName +
				'.xlsx'

		File shortFile = new File(
				shortDirectory,
				shortFileName
				)

		if (shortFile.getAbsolutePath().length() > MAX_WINDOWS_PATH_LENGTH) {
			KeywordUtil.markFailedAndStop(
					'Could not create an export path shorter than the configured limit.\n' +
					'Path: ' + shortFile.getAbsolutePath() + '\n' +
					'Length: ' + shortFile.getAbsolutePath().length()
					)
		}

		KeywordUtil.logInfo(
				'Original export path was too long.\n' +
				'Fallback short path selected: ' +
				shortFile.getAbsolutePath()
				)

		return shortFile
	}

	private void waitForExportedFileOrStop(
			File exportedFile,
			Integer timeoutSeconds
	) {
		int safeTimeout =
				timeoutSeconds == null ||
				timeoutSeconds <= 0 ?
				20 :
				timeoutSeconds

		int elapsedSeconds = 0

		while (elapsedSeconds < safeTimeout) {
			if (exportedFile.exists() &&
					exportedFile.isFile() &&
					exportedFile.length() > 0) {
				KeywordUtil.logInfo(
						'Exported file found.\n' +
						'Path: ' + exportedFile.getAbsolutePath() + '\n' +
						'Size bytes: ' + exportedFile.length()
						)

				return
			}

			Windows.delay(1)
			elapsedSeconds = elapsedSeconds + 1
		}

		imageLoader.takeEvidence(
				'ExportedFileNotFound.png'
				)

		KeywordUtil.markFailedAndStop(
				'Exported file was not found or is empty after save.\n' +
				'Expected path: ' + exportedFile.getAbsolutePath() + '\n' +
				'Path length: ' + exportedFile.getAbsolutePath().length() + '\n' +
				'Timeout seconds: ' + safeTimeout
				)
	}

	private void closeOpenFileModal() {
		KeywordUtil.logInfo(
				'Waiting for open-file modal image.'
				)

		boolean modalVisible = imageLoader.waitForImage(
				'General',
				'iconeModal',
				5
				)

		if (!modalVisible) {
			Windows.delay(1)

			modalVisible = imageLoader.waitForImage(
					'General',
					'iconeModal',
					3
					)
		}

		if (!modalVisible) {
			imageLoader.takeEvidence(
					'OpenFileModalNotFound.png'
					)

			KeywordUtil.markFailedAndStop(
					'Open-file modal was not found.\n' +
					'Expected image: General/iconeModal'
					)
		}

		KeywordUtil.logInfo(
				'Open-file modal detected. Pressing TAB and ENTER to select Non.'
				)

		Robot robot = new Robot()
		robot.setAutoDelay(150)

		robot.keyPress(
				KeyEvent.VK_TAB
				)

		robot.keyRelease(
				KeyEvent.VK_TAB
				)

		Thread.sleep(300)

		robot.keyPress(
				KeyEvent.VK_ENTER
				)

		robot.keyRelease(
				KeyEvent.VK_ENTER
				)

		Windows.delay(1)

		if (imageLoader.isVisible(
				'General',
				'iconeModal'
				)) {
			imageLoader.takeEvidence(
					'OpenFileModalStillVisible.png'
					)

			KeywordUtil.markFailedAndStop(
					'Open-file modal is still visible after TAB and ENTER.'
					)
		}

		KeywordUtil.logInfo(
				'Open-file modal closed successfully.'
				)
	}

	private void validateExportedExcelFileHasRowsAndValues(
			File exportedFile
	) {
		if (exportedFile == null ||
				!exportedFile.exists() ||
				!exportedFile.isFile()) {
			KeywordUtil.markFailedAndStop(
					'Exported file does not exist for validation.\n' +
					'Path: ' +
					(exportedFile == null ?
					'null' :
					exportedFile.getAbsolutePath())
					)
		}

		if (exportedFile.length() <= 0) {
			KeywordUtil.markFailedAndStop(
					'Exported file is empty.\n' +
					'Path: ' +
					exportedFile.getAbsolutePath()
					)
		}

		Workbook workbook = null

		try {
			workbook = WorkbookFactory.create(
					exportedFile
					)

			if (workbook.getNumberOfSheets() <= 0) {
				KeywordUtil.markFailedAndStop(
						'Exported Excel file has no sheets.\n' +
						'Path: ' +
						exportedFile.getAbsolutePath()
						)
			}

			Sheet sheet = workbook.getSheetAt(0)

			FormulaEvaluator evaluator =
					workbook
					.getCreationHelper()
					.createFormulaEvaluator()

			DataFormatter formatter =
					new DataFormatter()

			int nonEmptyRows = 0
			int nonEmptyCells = 0

			for (int rowIndex = 0;
					rowIndex <= sheet.getLastRowNum();
					rowIndex++) {
				Row row = sheet.getRow(
						rowIndex
						)

				if (row == null) {
					continue
				}

				boolean rowHasValue = false
				int lastCellNumber = row.getLastCellNum()

				if (lastCellNumber < 0) {
					continue
				}

				for (int cellIndex = 0;
						cellIndex < lastCellNumber;
						cellIndex++) {
					Cell cell = row.getCell(
							cellIndex
							)

					if (cell == null) {
						continue
					}

					String value =
							formatter.formatCellValue(
							cell,
							evaluator
							)

					if (value != null &&
							!value.trim().isEmpty()) {
						nonEmptyCells =
								nonEmptyCells + 1

						rowHasValue = true
					}
				}

				if (rowHasValue) {
					nonEmptyRows =
							nonEmptyRows + 1
				}
			}

			KeywordUtil.logInfo(
					'Exported Excel validation result.\n' +
					'File: ' + exportedFile.getName() + '\n' +
					'Non-empty rows: ' + nonEmptyRows + '\n' +
					'Non-empty cells: ' + nonEmptyCells
					)

			if (nonEmptyRows <= 1) {
				KeywordUtil.markFailedAndStop(
						'Exported Excel file does not have enough rows with values.\n' +
						'File: ' + exportedFile.getName() + '\n' +
						'Non-empty rows: ' + nonEmptyRows
						)
			}

			if (nonEmptyCells <= 0) {
				KeywordUtil.markFailedAndStop(
						'Exported Excel file does not have values.\n' +
						'File: ' + exportedFile.getName()
						)
			}
		} catch (Exception e) {
			KeywordUtil.markFailedAndStop(
					'Could not validate exported Excel file.\n' +
					'File: ' + exportedFile.getName() + '\n' +
					'Reason: ' + e.getMessage()
					)
		} finally {
			try {
				if (workbook != null) {
					workbook.close()
				}
			} catch (Exception ignored) {
			}
		}
	}

	private String buildAutomaticExportFileName(
			String environment,
			String featureName,
			String exportLabelSuffix
	) {
		String timestamp = new SimpleDateFormat(
				'yyyyMMdd_HHmmss'
				).format(
				new Date()
				)

		String safeEnvironment = shortenFilePart(
				sanitizeFileName(
				environment == null ||
				environment.trim().isEmpty() ?
				'REC' :
				environment
				),
				6
				)

		String safeFeatureName = shortenFilePart(
				sanitizeFileName(
				featureName == null ||
				featureName.trim().isEmpty() ?
				'Export' :
				featureName
				),
				MAX_FEATURE_LENGTH
				)

		String safeExportLabelSuffix = shortenFilePart(
				sanitizeFileName(
				exportLabelSuffix == null ?
				'' :
				exportLabelSuffix
				),
				MAX_LABEL_LENGTH
				)

		String baseFileName =
				safeEnvironment +
				'_' +
				timestamp +
				'_' +
				safeFeatureName

		if (safeExportLabelSuffix != null &&
				!safeExportLabelSuffix.trim().isEmpty() &&
				safeExportLabelSuffix != 'Export') {
			baseFileName =
					baseFileName +
					'_' +
					safeExportLabelSuffix
		}

		return baseFileName + '.xlsx'
	}

	private String resolveExportLabelSuffixForFileName(
			String exportLabel
	) {
		if (exportLabel == null ||
				exportLabel.trim().isEmpty()) {
			return ''
		}

		String value = sanitizeFileName(
				exportLabel
				)

		value = value.replaceFirst(
				'(?i)^REC_',
				''
				)

		value = value.replaceFirst(
				'(?i)^PRD_',
				''
				)

		value = value.replaceFirst(
				'(?i)^REC-',
				''
				)

		value = value.replaceFirst(
				'(?i)^PRD-',
				''
				)

		value = value.replaceFirst(
				'(?i)^REC ',
				''
				)

		value = value.replaceFirst(
				'(?i)^PRD ',
				''
				)

		if (value == null ||
				value.trim().isEmpty()) {
			return ''
		}

		return value
	}

	private String resolveEnvironmentName(
			String targetEnvironment,
			String exportLabel
	) {
		String environmentFromParameter =
				normalizeEnvironmentNameStrict(
				targetEnvironment
				)

		if (environmentFromParameter != null) {
			KeywordUtil.logInfo(
					'Environment resolved from targetEnvironment parameter: ' +
					environmentFromParameter
					)

			return environmentFromParameter
		}

		List<String> globalVariableNames = [
			'targetEnvironment',
			'currentEnvironment',
			'environment',
			'env',
			'ENV',
			'currentEnv',
			'environmentName'
		]

		for (String variableName : globalVariableNames) {
			String globalValue =
					getGlobalVariableValue(
					variableName
					)

			String normalizedValue =
					normalizeEnvironmentNameStrict(
					globalValue
					)

			if (normalizedValue != null) {
				KeywordUtil.logInfo(
						'Environment resolved from GlobalVariable.' +
						variableName +
						': ' +
						normalizedValue
						)

				return normalizedValue
			}
		}

		String environmentFromProfile =
				normalizeEnvironmentNameStrict(
				RunConfiguration.getExecutionProfile()
				)

		if (environmentFromProfile != null) {
			KeywordUtil.logInfo(
					'Environment resolved from execution profile: ' +
					environmentFromProfile
					)

			return environmentFromProfile
		}

		String environmentFromVisibleScreen =
				getEnvironmentFromVisibleScreen()

		if (environmentFromVisibleScreen != null) {
			KeywordUtil.logInfo(
					'Environment resolved from visible screen: ' +
					environmentFromVisibleScreen
					)

			return environmentFromVisibleScreen
		}

		String environmentFromLabel =
				normalizeEnvironmentNamePrefixOnly(
				exportLabel
				)

		if (environmentFromLabel != null) {
			KeywordUtil.logInfo(
					'Environment resolved from export label prefix: ' +
					environmentFromLabel
					)

			return environmentFromLabel
		}

		KeywordUtil.logInfo(
				'Environment not resolved. Defaulting to REC.'
				)

		return 'REC'
	}

	private String normalizeEnvironmentNameStrict(
			String rawEnvironment
	) {
		if (rawEnvironment == null ||
				rawEnvironment.trim().isEmpty()) {
			return null
		}

		String value =
				rawEnvironment
				.trim()
				.toUpperCase()

		if (value == 'PRD' ||
				value == 'PROD' ||
				value == 'PRODUCTION') {
			return 'PRD'
		}

		if (value == 'REC' ||
				value == 'RECETTE') {
			return 'REC'
		}

		if (value.startsWith('PRD_') ||
				value.startsWith('PRD-') ||
				value.startsWith('PRD ')) {
			return 'PRD'
		}

		if (value.startsWith('REC_') ||
				value.startsWith('REC-') ||
				value.startsWith('REC ')) {
			return 'REC'
		}

		return null
	}

	private String normalizeEnvironmentNamePrefixOnly(
			String rawEnvironment
	) {
		if (rawEnvironment == null ||
				rawEnvironment.trim().isEmpty()) {
			return null
		}

		String value =
				rawEnvironment
				.trim()
				.toUpperCase()

		if (value == 'PRD' ||
				value.startsWith('PRD_') ||
				value.startsWith('PRD-') ||
				value.startsWith('PRD ')) {
			return 'PRD'
		}

		if (value == 'REC' ||
				value.startsWith('REC_') ||
				value.startsWith('REC-') ||
				value.startsWith('REC ')) {
			return 'REC'
		}

		return null
	}

	private String getEnvironmentFromVisibleScreen() {
		if (isAnyTextVisibleOnCurrentWindow(
				[
					'PROD',
					'PRODUCTION',
					'PRD'
				]
				)) {
			return 'PRD'
		}

		if (isAnyTextVisibleOnCurrentWindow(
				[
					'RECETTE',
					'REC'
				]
				)) {
			return 'REC'
		}

		return null
	}

	private boolean isAnyTextVisibleOnCurrentWindow(
			List<String> texts
	) {
		for (String text : texts) {
			if (isTextVisibleOnCurrentWindow(
					text
					)) {
				return true
			}
		}

		return false
	}

	private boolean isTextVisibleOnCurrentWindow(
			String text
	) {
		if (text == null ||
				text.trim().isEmpty()) {
			return false
		}

		String upperText =
				text
				.trim()
				.toUpperCase()

		try {
			WindowsTestObject object =
					new WindowsTestObject(
					'visibleText_' +
					sanitizeObjectName(
					upperText
					)
					)

			object.setLocatorStrategy(
					LocatorStrategy.XPATH
					)

			object.setLocator(
					"//*[contains(" +
					"translate(@Name, " +
					"'abcdefghijklmnopqrstuvwxyz', " +
					"'ABCDEFGHIJKLMNOPQRSTUVWXYZ'), " +
					"'" + upperText + "')]"
					)

			return Windows.verifyElementPresent(
					object,
					1,
					FailureHandling.OPTIONAL
					)
		} catch (Exception ignored) {
		}

		return false
	}

