package commands

import java.awt.Robot
import java.awt.Toolkit
import java.awt.datatransfer.StringSelection
import java.awt.event.KeyEvent
import java.io.File
import java.text.SimpleDateFormat

import com.katalon.keywords.windows.WindowsImageKeywords
import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.configuration.RunConfiguration
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.util.KeywordUtil

import internal.GlobalVariable

class ExportFile {

	private static final String GENERAL = 'General'
	private static final int DEFAULT_TIMEOUT = 30

	/**
	 * Usado pelos TC atuais de Cotre Parameters.
	 * Fluxo correto:
	 * Outils/Menu -> Exports -> ExportButton -> salvar -> clicar No/Non por imagem
	 */
	@Keyword
	String exportFrontboExportPageStore(String exportLabel) {
		return exportFromExportsAndExportButtonToNo(exportLabel)
	}

	/**
	 * Alias de segurança caso algum TC esteja chamando com B maiúsculo.
	 */
	@Keyword
	String exportFrontBoExportPageStore(String exportLabel) {
		return exportFromExportsAndExportButtonToNo(exportLabel)
	}

	/**
	 * Novo comando correto para este fluxo.
	 * NÃO usa exports2.
	 */
	@Keyword
	String exportFromExportsAndExportButtonToNo(String exportLabel) {
		KeywordUtil.logInfo("Starting export flow using exports + exportButton. Label: ${exportLabel}")

		openExportsScreen()
		clickGeneralImage('exportButton', DEFAULT_TIMEOUT)

		String exportedFilePath = saveToExecutionRecPrdExportFolder(exportLabel)

		clickNoUntilOpenFileModalCloses(4, 5)

		KeywordUtil.logInfo("Export finished: ${exportedFilePath}")
		return exportedFilePath
	}

	/**
	 * Mantido para não quebrar outros testes que já usam este keyword antigo.
	 */
	@Keyword
	String exportFromOutilsToNo(String exportLabel) {
		KeywordUtil.logInfo("Starting legacy export flow using outilsMenu + exportButton. Label: ${exportLabel}")

		clickGeneralImage('outilsMenu', DEFAULT_TIMEOUT)
		clickGeneralImage('exportButton', DEFAULT_TIMEOUT)

		String exportedFilePath = saveToExecutionRecPrdExportFolder(exportLabel)

		clickNoUntilOpenFileModalCloses(4, 5)

		KeywordUtil.logInfo("Legacy export finished: ${exportedFilePath}")
		return exportedFilePath
	}

	/**
	 * Abre a tela de Exports usando as imagens existentes no ImageLoader:
	 * - outilsMenu
	 * - exports
	 */
	private void openExportsScreen() {
		clickGeneralImage('outilsMenu', DEFAULT_TIMEOUT)
		sleepMs(800)

		clickGeneralImage('exports', DEFAULT_TIMEOUT)
		sleepMs(1200)
	}

	private void clickGeneralImage(String key, int timeout) {
		String imagePath = ImageLoader.getImagePath(GENERAL, key)

		KeywordUtil.logInfo("Click image: ${GENERAL}/${key} -> ${imagePath}")

		try {
			WindowsImageKeywords.waitForImagePresent(imagePath, timeout, FailureHandling.OPTIONAL)
		} catch (Throwable ignored) {
			KeywordUtil.logInfo("waitForImagePresent ignored for image: ${key}")
		}

		try {
			WindowsImageKeywords.click(imagePath, FailureHandling.STOP_ON_FAILURE)
		} catch (MissingMethodException ignored) {
			WindowsImageKeywords.click(imagePath)
		}
	}

	private boolean clickOptionalGeneralImage(String key, int timeout) {
		try {
			String imagePath = ImageLoader.getImagePath(GENERAL, key)

			KeywordUtil.logInfo("Try optional click image: ${GENERAL}/${key} -> ${imagePath}")

			try {
				WindowsImageKeywords.waitForImagePresent(imagePath, timeout, FailureHandling.OPTIONAL)
			} catch (Throwable ignored) {
				KeywordUtil.logInfo("Optional wait ignored for image: ${key}")
			}

			try {
				WindowsImageKeywords.click(imagePath, FailureHandling.OPTIONAL)
			} catch (MissingMethodException ignored) {
				WindowsImageKeywords.click(imagePath)
			}

			sleepMs(700)
			return true
		} catch (Throwable ignored) {
			return false
		}
	}

	private String saveToExecutionRecPrdExportFolder(String exportLabel) {
		File targetDirectory = resolveTargetExportFolder(exportLabel)

		if (!targetDirectory.exists()) {
			targetDirectory.mkdirs()
		}

		String fileName = buildExportFileName(targetDirectory, exportLabel)
		File exportedFile = new File(targetDirectory, fileName)

		KeywordUtil.logInfo("Export target folder: ${targetDirectory.absolutePath}")
		KeywordUtil.logInfo("Export file name: ${fileName}")
		KeywordUtil.logInfo("Export full path: ${exportedFile.absolutePath}")

		sleepMs(1500)

		pasteText(exportedFile.absolutePath)
		pressEnter()

		sleepMs(2500)

		return exportedFile.absolutePath
	}

	private File resolveTargetExportFolder(String exportLabel) {
		File executionRoot = resolveExecutionRootFolder()
		File sharedExportFolder = new File(executionRoot, 'Shared_REC_PRD_Exports')

		String exportContextName = resolveExportContextName(exportLabel)

		return new File(sharedExportFolder, exportContextName)
	}

	private File resolveExecutionRootFolder() {
		File reportsFolder = new File(RunConfiguration.getProjectDir(), 'Reports')

		if (!reportsFolder.exists()) {
			return reportsFolder
		}

		File[] folders = reportsFolder.listFiles()

		if (folders == null || folders.length == 0) {
			return reportsFolder
		}

		List<File> validFolders = folders.findAll { File file ->
			file.isDirectory()
		}

		if (validFolders == null || validFolders.isEmpty()) {
			return reportsFolder
		}

		validFolders.sort { File a, File b ->
			b.lastModified() <=> a.lastModified()
		}

		return validFolders.first()
	}

	private String buildExportFileName(File targetDirectory, String exportLabel) {
		String environment = resolveEnvironmentName(exportLabel)
		String timestamp = new SimpleDateFormat('yyyyMMdd_HHmmss').format(new Date())
		String cleanLabel = cleanFileName(exportLabel)

		if (cleanLabel == null || cleanLabel.trim().isEmpty()) {
			cleanLabel = targetDirectory.name
		}

		if (cleanLabel.toUpperCase().startsWith(environment + '_')) {
			cleanLabel = cleanLabel.substring(environment.length() + 1)
		}

		return "${environment}_${timestamp}_${cleanLabel}.xlsx"
	}

	private String resolveEnvironmentName(String exportLabel) {
		String envFromLabel = normalizeEnvironmentName(exportLabel)

		if (envFromLabel != null && !envFromLabel.isEmpty()) {
			KeywordUtil.logInfo("Environment resolved from export label: ${envFromLabel}")
			return envFromLabel
		}

		String envFromGlobal = normalizeEnvironmentName(getGlobalVariableValue('targetEnvironment'))

		if (envFromGlobal != null && !envFromGlobal.isEmpty()) {
			KeywordUtil.logInfo("Environment resolved from GlobalVariable.targetEnvironment: ${envFromGlobal}")
			return envFromGlobal
		}

		envFromGlobal = normalizeEnvironmentName(getGlobalVariableValue('ENVIRONMENT'))

		if (envFromGlobal != null && !envFromGlobal.isEmpty()) {
			KeywordUtil.logInfo("Environment resolved from GlobalVariable.ENVIRONMENT: ${envFromGlobal}")
			return envFromGlobal
		}

		KeywordUtil.logInfo("Environment not found. Defaulting to REC.")
		return 'REC'
	}

	private String normalizeEnvironmentName(Object value) {
		if (value == null) {
			return ''
		}

		String text = value.toString().toUpperCase()

		if (text.contains('PRD')) {
			return 'PRD'
		}

		if (text.contains('REC')) {
			return 'REC'
		}

		return ''
	}

	private Object getGlobalVariableValue(String name) {
		try {
			return GlobalVariable."${name}"
		} catch (Throwable ignored) {
			return null
		}
	}

	private String resolveExportContextName(String exportLabel) {
		if (exportLabel == null || exportLabel.trim().isEmpty()) {
			return 'Exports'
		}

		String label = exportLabel.trim()

		String withoutEnvironment = label.replaceFirst('(?i)^(REC|PRD)_', '')
		String withoutCurrency = withoutEnvironment.replaceFirst('(?i)_(EUR|USD|MIXTE)$', '')

		String clean = cleanFileName(withoutCurrency)

		if (clean == null || clean.trim().isEmpty()) {
			return 'Exports'
		}

		return clean
	}

	private String cleanFileName(String value) {
		if (value == null) {
			return ''
		}

		return value
			.trim()
			.replaceAll('[\\\\/:*?"<>|]', '_')
			.replaceAll('\\s+', '_')
	}

	private void clickNoUntilOpenFileModalCloses(int maxAttempts, int timeoutPerAttempt) {
		for (int attempt = 1; attempt <= maxAttempts; attempt++) {
			KeywordUtil.logInfo("Trying to close open file modal. Attempt ${attempt}/${maxAttempts}")

			boolean clickedNo = clickOptionalGeneralImage('no', timeoutPerAttempt)

			if (clickedNo) {
				sleepMs(800)
				continue
			}

			boolean clickedNoEn = clickOptionalGeneralImage('noEn', timeoutPerAttempt)

			if (clickedNoEn) {
				sleepMs(800)
				continue
			}

			KeywordUtil.logInfo("No/NoEn modal image not found anymore.")
			break
		}
	}

	private void pasteText(String text) {
		StringSelection selection = new StringSelection(text)
		Toolkit.getDefaultToolkit().getSystemClipboard().setContents(selection, null)

		Robot robot = new Robot()
		robot.setAutoDelay(80)

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_A)
		robot.keyRelease(KeyEvent.VK_CONTROL)

		sleepMs(200)

		robot.keyPress(KeyEvent.VK_CONTROL)
		robot.keyPress(KeyEvent.VK_V)
		robot.keyRelease(KeyEvent.VK_V)
		robot.keyRelease(KeyEvent.VK_CONTROL)
	}

	private void pressEnter() {
		Robot robot = new Robot()
		robot.setAutoDelay(80)

		robot.keyPress(KeyEvent.VK_ENTER)
		robot.keyRelease(KeyEvent.VK_ENTER)
	}

	private void sleepMs(long milliseconds) {
		try {
			Thread.sleep(milliseconds)
		} catch (InterruptedException ignored) {
			Thread.currentThread().interrupt()
		}
	}
}
