package component

import com.kms.katalon.core.annotation.Keyword
import com.kms.katalon.core.model.FailureHandling
import com.kms.katalon.core.util.KeywordUtil
import com.kms.katalon.core.windows.keyword.WindowsBuiltinKeywords as Windows

import commands.ImageLoader
import commands.WindowsObjectLoader

class SettingsArchiveModeKeywords {

	private ImageLoader imageLoader = new ImageLoader()

	@Keyword
	void enableArchiveModeFromSettings(Integer timeoutSeconds) {
		int safeTimeout = timeoutSeconds == null || timeoutSeconds <= 0 ? 30 : timeoutSeconds

		addNote(
			'Configure Archive Mode\n' +
			'Screen: Settings\n' +
			'Option: Donnees d archive\n' +
			'Expected value: Oui'
		)

		openSettingsMenu()
		openArchiveModeSettings(safeTimeout)

		boolean wasChanged = ensureArchiveModeIsEnabled()

		if (wasChanged) {
			addNote(
				'Archive Mode was changed from Non to Oui\n' +
				'Application returned to Home automatically\n' +
				'Reload Settings to validate final value'
			)

			Windows.delay(4)

			openSettingsMenu()
			openArchiveModeSettings(safeTimeout)
			validateArchiveModeIsOui()
		}

		returnToHome()

		addNote(
			'Archive Mode configuration completed\n' +
			'Final value: Oui'
		)
	}

	private void openSettingsMenu() {
		addNote(
			'Open Settings menu'
		)

		imageLoader.clickImageOrStop(
			'General',
			'settings'
		)

		Windows.delay(3)
	}

	private void openArchiveModeSettings(Integer timeoutSeconds) {
		addNote(
			'Open Archive Mode settings option\n' +
			'Expected item: Donnees d archive'
		)

		if (!Windows.waitForElementPresent(
				WindowsObjectLoader.getObject('settingsArchiveMode', 'archiveDataMenu'),
				timeoutSeconds,
				FailureHandling.OPTIONAL
		)) {
			imageLoader.takeEvidence(
				'ArchiveModeSettingsOptionNotFound.png'
			)

			KeywordUtil.markFailedAndStop(
				'Archive Mode settings option was not found.\n' +
				'Expected item: Donnees d archive'
			)
		}

		Windows.click(
			WindowsObjectLoader.getObject('settingsArchiveMode', 'archiveDataMenu')
		)

		Windows.delay(2)
	}

	private boolean ensureArchiveModeIsEnabled() {
		addNote(
			'Validate Archive Mode toggle\n' +
			'If value is Non, change to Oui\n' +
			'If value is already Oui, continue'
		)

		boolean isNoVisible = imageLoader.isVisible(
			'General',
			'archiveModeSettingsNo'
		)

		if (isNoVisible) {
			addNote(
				'Archive Mode current value: Non\n' +
				'Action: change to Oui'
			)

			imageLoader.clickImageOrStop(
				'General',
				'archiveModeSettingsNo'
			)

			Windows.delay(3)

			return true
		}

		boolean isOuiVisible = imageLoader.isVisible(
			'General',
			'archiveModeSettingsOui'
		)

		if (isOuiVisible) {
			addNote(
				'Archive Mode already enabled\n' +
				'Current value: Oui'
			)

			return false
		}

		imageLoader.takeEvidence(
			'ArchiveModeToggleNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Archive Mode toggle was not found.\n' +
			'Expected image key: archiveModeSettingsNo or archiveModeSettingsOui'
		)

		return false
	}

	private void validateArchiveModeIsOui() {
		addNote(
			'Validate Archive Mode final value after reload\n' +
			'Expected value: Oui'
		)

		boolean isOuiVisible = imageLoader.waitForImage(
			'General',
			'archiveModeSettingsOui',
			10
		)

		if (isOuiVisible) {
			addNote(
				'Archive Mode final value confirmed\n' +
				'Current value: Oui'
			)

			return
		}

		boolean isNoVisible = imageLoader.isVisible(
			'General',
			'archiveModeSettingsNo'
		)

		imageLoader.takeEvidence(
			'ArchiveModeFinalValueNotOui.png'
		)

		if (isNoVisible) {
			KeywordUtil.markFailedAndStop(
				'Archive Mode final value is still Non.\n' +
				'Expected value: Oui'
			)
		}

		KeywordUtil.markFailedAndStop(
			'Archive Mode final value could not be validated.\n' +
			'Expected image key: archiveModeSettingsOui'
		)
	}

	private void returnToHome() {
		addNote(
			'Return to Home tab'
		)

		imageLoader.clickImageOrStop(
			'General',
			'home'
		)

		Windows.delay(3)
	}

	private void addNote(String message) {
		try {
			new jiraIntegration.JiraReportSteps().note(message)
		} catch (Throwable ignored) {
			KeywordUtil.logInfo(message)
		}
	}
}
