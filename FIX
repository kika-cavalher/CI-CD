properties([
	disableConcurrentBuilds(),
	buildDiscarder(logRotator(numToKeepStr: '15'))
])

/*
====================================================================
CONFIG BLOCK
Only change this block for each module.
====================================================================
*/

def NODE_LABEL = 'GI5_SNDCFRNXGTSS817'
def SHORT_WORKSPACE = 'ARCH_MODE'
def RUN_NEXT_JOB = true
def NEXT_JOB = 'GI5/eMatch_Regression/BDR_Module des Responsabilite'
def COLLECTION_TIMEOUT_HOURS = 5

def COLLECTIONS = [
	[stage: 'Archive Mode Collection', cmd: 'ArchiveMode.cmd']
]

/*
====================================================================
FIXED LOGIC
Do not change below this line.
====================================================================
*/

def executionFailed = false
def manualAborted = false
def testsWereExecuted = false

def asErrorText = { Throwable err ->
	def parts = []
	def current = err

	while (current != null) {
		parts << "${current.getClass().getName()}: ${current.getMessage() ?: ''}"
		current = current.getCause()
	}

	return parts.join(' | ').toLowerCase()
}

def isTimeoutError = { Throwable err ->
	def text = asErrorText(err)

	return text.contains('timeout') ||
			text.contains('exceededtimeout') ||
			text.contains('org.jenkinsci.plugins.workflow.steps.timeout')
}

def isManualAbortError = { Throwable err ->
	def text = asErrorText(err)

	return text.contains('flowinterruptedexception') ||
			text.contains('aborted') ||
			text.contains('userinterruption')
}

def runCollection = { Map collection ->

	def cmdFile = collection.cmd
	def stageName = collection.stage

	stage(stageName) {
		timeout(time: COLLECTION_TIMEOUT_HOURS, unit: 'HOURS') {
			node(NODE_LABEL) {

				ws("${env.WORKSPACE}\\${SHORT_WORKSPACE}") {

					echo "[INFO] Starting stage: ${stageName}"
					echo "[INFO] Command file: ${cmdFile}"
					echo "[INFO] Workspace: ${pwd()}"

					checkout scm

					if (!fileExists("jenkins/${cmdFile}")) {
						executionFailed = true
						error("[ERROR] Command file was not found: jenkins/${cmdFile}")
					}

					def startedMarker = "jenkins_started_${stageName.replaceAll('[^A-Za-z0-9]', '_')}.txt"
					def finishedMarker = "jenkins_finished_${stageName.replaceAll('[^A-Za-z0-9]', '_')}.txt"

					bat(
						script: """
							@echo off
							if exist "${startedMarker}" del /f /q "${startedMarker}"
							if exist "${finishedMarker}" del /f /q "${finishedMarker}"
							echo started > "${startedMarker}"
						""",
						returnStatus: true
					)

					def exitCode = bat(
						script: """
							@echo off
							echo [INFO] Executing test command...
							call "jenkins\\${cmdFile}"
							set TEST_EXIT_CODE=%ERRORLEVEL%
							echo finished > "${finishedMarker}"
							echo [INFO] Test command finished with exit code %TEST_EXIT_CODE%
							exit /b %TEST_EXIT_CODE%
						""",
						returnStatus: true
					)

					def started = fileExists(startedMarker)
					def finished = fileExists(finishedMarker)

					echo "[INFO] Command exit code: ${exitCode}"
					echo "[INFO] Started marker exists: ${started}"
					echo "[INFO] Finished marker exists: ${finished}"

					if (!started || !finished) {
						executionFailed = true
						error("[ERROR] Tests were not executed correctly for stage: ${stageName}")
					}

					testsWereExecuted = true

					echo "[INFO] Tests were executed for stage: ${stageName}"
					echo "[INFO] Jenkins status rule: test failures do not fail the stage."
					echo "[INFO] Ignoring test exit code for Jenkins stage status: ${exitCode}"

					currentBuild.result = 'SUCCESS'
				}
			}
		}
	}
}

try {

	COLLECTIONS.each { collection ->
		runCollection(collection)
	}

} catch (Throwable err) {

	if (isManualAbortError(err)) {
		manualAborted = true
		currentBuild.result = 'ABORTED'
		throw err
	}

	if (isTimeoutError(err)) {
		executionFailed = true
		currentBuild.result = 'FAILURE'
		throw err
	}

	executionFailed = true
	currentBuild.result = 'FAILURE'
	throw err

} finally {

	stage('Final status') {
		echo "[INFO] Tests were executed: ${testsWereExecuted}"
		echo "[INFO] Execution failed: ${executionFailed}"
		echo "[INFO] Manual aborted: ${manualAborted}"

		if (manualAborted) {
			currentBuild.result = 'ABORTED'
			echo '[INFO] Build was manually aborted.'
		} else if (!testsWereExecuted || executionFailed) {
			currentBuild.result = 'FAILURE'
			echo '[ERROR] Jenkins result: FAILURE because tests were not executed correctly.'
		} else {
			currentBuild.result = 'SUCCESS'
			echo '[INFO] Jenkins result: SUCCESS because tests were executed.'
			echo '[INFO] Test case failures are ignored for Jenkins status.'
		}
	}

	if (RUN_NEXT_JOB && NEXT_JOB?.trim() && currentBuild.result == 'SUCCESS') {
		stage('Trigger next pipeline') {
			echo "[INFO] Triggering next pipeline: ${NEXT_JOB}"

			build job: NEXT_JOB,
					wait: false,
					propagate: false

			echo '[INFO] Next pipeline triggered.'
		}
	}
}
