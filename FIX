@echo off
setlocal EnableExtensions EnableDelayedExpansion

rem ============================================================
rem  eMatch Desktop Runner (Task Scheduler entrypoint)
rem  Reads: D:\Projects\eMatchStarters\run-context.properties
rem  Writes:
rem    - LOG_FILE (katalon_*.log) inside D:\Projects\eMatchStarters\logs
rem    - MARKER_FILE (exitcode) inside D:\Projects\eMatchStarters\logs
rem ============================================================

set "CTX_FILE=D:\Projects\eMatchStarters\run-context.properties"

if not exist "%CTX_FILE%" (
    echo [ERROR] CTX_FILE not found: "%CTX_FILE%"
    exit /b 2
)

rem ============================================================
rem  Load context key=value into env vars
rem ============================================================

for /f "usebackq tokens=1,* delims==" %%A in ("%CTX_FILE%") do (
    set "K=%%A"
    set "V=%%B"
    if not "!K!"=="" (
        set "!K!=!V!"
    )
)

echo.
echo [INFO] WORKSPACE      = "%WORKSPACE%"
echo [INFO] PROJECT_PATH   = "%PROJECT_PATH%"
echo [INFO] KATALON_EXE    = "%KATALON_EXE%"
echo [INFO] COLLECTION_PATH= "%COLLECTION_PATH%"
echo [INFO] BROWSER_TYPE   = "%BROWSER_TYPE%"
echo [INFO] RETRY          = "%RETRY%"
echo [INFO] LOG_FILE       = "%LOG_FILE%"
echo [INFO] MARKER_FILE    = "%MARKER_FILE%"
echo [INFO] EMATCH_APP_PATH= "%EMATCH_APP_PATH%"
echo.

rem ============================================================
rem  Basic validation
rem ============================================================

if "%PROJECT_PATH%"=="" (
    echo [ERROR] PROJECT_PATH is empty in run-context.properties
    call :WriteMarker 2
    exit /b 2
)

if "%KATALON_EXE%"=="" (
    echo [ERROR] KATALON_EXE is empty in run-context.properties
    call :WriteMarker 2
    exit /b 2
)

if "%COLLECTION_PATH%"=="" (
    echo [ERROR] COLLECTION_PATH is empty in run-context.properties
    call :WriteMarker 2
    exit /b 2
)

if "%MARKER_FILE%"=="" (
    echo [ERROR] MARKER_FILE is empty in run-context.properties
    exit /b 2
)

if "%LOG_FILE%"=="" (
    echo [ERROR] LOG_FILE is empty in run-context.properties
    call :WriteMarker 2
    exit /b 2
)

rem ============================================================
rem  Ensure logs dir exists
rem ============================================================

for %%D in ("%LOG_FILE%") do set "LOG_DIR=%%~dpD"
if not exist "%LOG_DIR%" (
    mkdir "%LOG_DIR%" >nul 2>&1
)

rem ============================================================
rem  Validate eMatch app path reachability (UNC issues in TS session)
rem ============================================================

if "%EMATCH_APP_PATH%"=="" (
    echo [WARN] EMATCH_APP_PATH is empty. App launch may fail if test uses UNC hardcode.
) else (
    echo [INFO] Validating EMATCH_APP_PATH from Task Scheduler session...
    powershell -NoProfile -ExecutionPolicy Bypass -Command ^
        "if (-not (Test-Path -LiteralPath '%EMATCH_APP_PATH%')) { exit 9 } else { exit 0 }"
    if %ERRORLEVEL% NEQ 0 (
        echo [ERROR] EMATCH_APP_PATH not reachable from Task Scheduler session
        echo [ERROR] %EMATCH_APP_PATH%
        call :WriteMarker 9
        exit /b 9
    )
)

rem ============================================================
rem  Build Katalon command
rem ============================================================

set "KATALON_CMD="%KATALON_EXE%" -runMode=console -projectPath="%PROJECT_PATH%" -retry=%RETRY% -testSuiteCollectionPath="%COLLECTION_PATH%" -browserType="%BROWSER_TYPE%""

rem Pass-through to GlobalVariables
if not "%EMATCH_APP_PATH%"=="" (
    set "KATALON_CMD=%KATALON_CMD% -g_ematchAppPath=""%EMATCH_APP_PATH%"""
)

echo.
echo [INFO] Starting Katalon...
echo [INFO] %KATALON_CMD%
echo.

rem ============================================================
rem  Execute and tee output to LOG_FILE
rem ============================================================

call :RunAndLog
set "KATALON_EXIT=%ERRORLEVEL%"

echo.
echo [INFO] KATALON_EXIT=%KATALON_EXIT%
echo.

call :WriteMarker %KATALON_EXIT%

exit /b %KATALON_EXIT%

rem ============================================================
rem  Functions
rem ============================================================

:RunAndLog
    rem Using PowerShell to capture stdout+stderr into LOG_FILE while still printing
    powershell -NoProfile -ExecutionPolicy Bypass -Command ^
        "$p = Start-Process -FilePath 'cmd.exe' -ArgumentList '/c', %KATALON_CMD% -NoNewWindow -Wait -PassThru -RedirectStandardOutput '%LOG_FILE%' -RedirectStandardError '%LOG_FILE%'; exit $p.ExitCode"
    exit /b %ERRORLEVEL%

:WriteMarker
    set "CODE=%~1"

    rem Atomic write to avoid Jenkins reading partial content
    > "%MARKER_FILE%.tmp" echo %CODE%
    move /Y "%MARKER_FILE%.tmp" "%MARKER_FILE%" >nul 2>&1

    exit /b 0
