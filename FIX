	// ======================================================
	// REC X PRD COLUMN STATISTICS
	// ======================================================

	@Keyword
	Map validateRecPrdColumnStatistics(
			List filesToValidate,
			Integer columnIndex,
			String expectedColumnName) {

		Map result = [
			success       : false,
			errors        : '',
			passedDetails : '',
			recFileName   : '',
			prdFileName   : '',
			columnName    : safeText(expectedColumnName),
			recRows       : null,
			prdRows       : null,
			recSum        : null,
			prdSum        : null,
			recMinimum    : null,
			prdMinimum    : null,
			recMaximum    : null,
			prdMaximum    : null
		]

		StringBuilder errors =
				new StringBuilder()

		StringBuilder passedDetails =
				new StringBuilder()

		FileInputStream inputRec = null
		FileInputStream inputPrd = null

		Workbook workbookRec = null
		Workbook workbookPrd = null

		try {

			if (
			filesToValidate == null ||
					filesToValidate.size() < 2
					) {

				errors.append(
						'[ERROR] REC x PRD validation needs 2 files.\n'
						)
						.append('Expected files: 2\n')
						.append('Available files: ')
						.append(
						filesToValidate == null
						? 0
						: filesToValidate.size()
						)

				result.errors =
						errors.toString()

				return result
			}

			int validatedColumnIndex =
					columnIndex == null
					? -1
					: columnIndex.intValue()

			if (validatedColumnIndex < 0) {

				errors.append(
						'[ERROR] Invalid column index.\n'
						)
						.append('Column index: ')
						.append(validatedColumnIndex)

				result.errors =
						errors.toString()

				return result
			}

			File recFile = null
			File prdFile = null

			for (Object fileValue : filesToValidate) {

				if (fileValue == null) {
					continue
				}

				File candidate =
						fileValue instanceof File
						? fileValue as File
						: new File(
						safeText(fileValue)
						)

				String candidateName =
						candidate
						.getName()
						.toUpperCase()

				if (
				candidateName.startsWith(
						'REC_'
						)
						) {
					recFile = candidate
				}

				if (
				candidateName.startsWith(
						'PRD_'
						)
						) {
					prdFile = candidate
				}
			}

			if (
			recFile == null &&
					filesToValidate.size() > 0
					) {

				Object recValue =
						filesToValidate.get(0)

				recFile =
						recValue instanceof File
						? recValue as File
						: new File(
						safeText(recValue)
						)
			}

			if (
			prdFile == null &&
					filesToValidate.size() > 1
					) {

				Object prdValue =
						filesToValidate.get(1)

				prdFile =
						prdValue instanceof File
						? prdValue as File
						: new File(
						safeText(prdValue)
						)
			}

			result.recFileName =
					recFile == null
					? 'NOT FOUND'
					: recFile.getName()

			result.prdFileName =
					prdFile == null
					? 'NOT FOUND'
					: prdFile.getName()

			if (
			recFile == null ||
					!recFile.exists() ||
					!recFile.isFile()
					) {

				errors.append(
						'[ERROR] REC exported file was not found.\n'
						)
						.append('File: ')
						.append(result.recFileName)
						.append('\n')
			}

			if (
			prdFile == null ||
					!prdFile.exists() ||
					!prdFile.isFile()
					) {

				errors.append(
						'[ERROR] PRD exported file was not found.\n'
						)
						.append('File: ')
						.append(result.prdFileName)
						.append('\n')
			}

			if (errors.length() > 0) {

				result.errors =
						errors.toString().trim()

				return result
			}

			if (!isExcelFile(recFile.getName())) {

				errors.append(
						'[ERROR] REC file is not a supported Excel file.\n'
						)
						.append('File: ')
						.append(recFile.getName())
						.append('\n')
			}

			if (!isExcelFile(prdFile.getName())) {

				errors.append(
						'[ERROR] PRD file is not a supported Excel file.\n'
						)
						.append('File: ')
						.append(prdFile.getName())
						.append('\n')
			}

			if (errors.length() > 0) {

				result.errors =
						errors.toString().trim()

				return result
			}

			KeywordUtil.logInfo(
					'📊 [REC X PRD STATISTICS] ' +
					'REC=' + recFile.getName() +
					' | PRD=' + prdFile.getName() +
					' | columnIndex=' +
					validatedColumnIndex
					)

			inputRec =
					new FileInputStream(recFile)

			inputPrd =
					new FileInputStream(prdFile)

			workbookRec =
					WorkbookFactory.create(inputRec)

			workbookPrd =
					WorkbookFactory.create(inputPrd)

			if (
			workbookRec.getNumberOfSheets() ==
					0
					) {

				errors.append(
						'[ERROR] REC workbook does not contain sheets.\n'
						)
						.append('File: ')
						.append(recFile.getName())
						.append('\n')
			}

			if (
			workbookPrd.getNumberOfSheets() ==
					0
					) {

				errors.append(
						'[ERROR] PRD workbook does not contain sheets.\n'
						)
						.append('File: ')
						.append(prdFile.getName())
						.append('\n')
			}

			if (errors.length() > 0) {

				result.errors =
						errors.toString().trim()

				return result
			}

			Sheet sheetRec =
					workbookRec.getSheetAt(0)

			Sheet sheetPrd =
					workbookPrd.getSheetAt(0)

			DataFormatter formatter =
					new DataFormatter()

			FormulaEvaluator recEvaluator =
					workbookRec
					.getCreationHelper()
					.createFormulaEvaluator()

			FormulaEvaluator prdEvaluator =
					workbookPrd
					.getCreationHelper()
					.createFormulaEvaluator()

			String configuredColumnName =
					safeText(expectedColumnName)

			String recColumnName =
					readHeaderName(
					sheetRec,
					validatedColumnIndex,
					formatter
					)

			String prdColumnName =
					readHeaderName(
					sheetPrd,
					validatedColumnIndex,
					formatter
					)

			String resolvedColumnName =
					!recColumnName.isEmpty()
					? recColumnName
					: configuredColumnName

			result.columnName =
					resolvedColumnName

			if (recColumnName.isEmpty()) {

				errors.append(
						'[ERROR] REC column was not found.\n'
						)
						.append('Column index: ')
						.append(validatedColumnIndex)
						.append('\n')
			}

			if (prdColumnName.isEmpty()) {

				errors.append(
						'[ERROR] PRD column was not found.\n'
						)
						.append('Column index: ')
						.append(validatedColumnIndex)
						.append('\n')
			}

			if (
			!configuredColumnName.isEmpty() &&
					!recColumnName.isEmpty() &&
					!normalizeHeader(recColumnName)
					.equals(
					normalizeHeader(
					configuredColumnName
					)
					)
					) {

				errors.append(
						'[ERROR] Unexpected REC column.\n'
						)
						.append('Expected: ')
						.append(configuredColumnName)
						.append('\n')
						.append('Found: ')
						.append(recColumnName)
						.append('\n')
			}

			if (
			!configuredColumnName.isEmpty() &&
					!prdColumnName.isEmpty() &&
					!normalizeHeader(prdColumnName)
					.equals(
					normalizeHeader(
					configuredColumnName
					)
					)
					) {

				errors.append(
						'[ERROR] Unexpected PRD column.\n'
						)
						.append('Expected: ')
						.append(configuredColumnName)
						.append('\n')
						.append('Found: ')
						.append(prdColumnName)
						.append('\n')
			}

			if (
			!recColumnName.isEmpty() &&
					!prdColumnName.isEmpty() &&
					!normalizeHeader(recColumnName)
					.equals(
					normalizeHeader(
					prdColumnName
					)
					)
					) {

				errors.append(
						'[ERROR] REC and PRD column names are different.\n'
						)
						.append('REC: ')
						.append(recColumnName)
						.append('\n')
						.append('PRD: ')
						.append(prdColumnName)
						.append('\n')
			}

			int recRows =
					countNonEmptyDataRows(
					sheetRec,
					formatter,
					recEvaluator
					)

			int prdRows =
					countNonEmptyDataRows(
					sheetPrd,
					formatter,
					prdEvaluator
					)

			result.recRows = recRows
			result.prdRows = prdRows

			if (recRows != prdRows) {

				errors.append(
						'[ERROR] Number of rows is different.\n'
						)
						.append('REC: ')
						.append(recRows)
						.append('\n')
						.append('PRD: ')
						.append(prdRows)
						.append('\n')
			} else {

				passedDetails.append(
						'[PASS] Number of rows is equal.\n'
						)
						.append('REC: ')
						.append(recRows)
						.append('\n')
						.append('PRD: ')
						.append(prdRows)
						.append('\n')
			}

			Map recStatistics =
					calculateColumnStatistics(
					sheetRec,
					validatedColumnIndex,
					formatter,
					recEvaluator
					)

			Map prdStatistics =
					calculateColumnStatistics(
					sheetPrd,
					validatedColumnIndex,
					formatter,
					prdEvaluator
					)

			int recNumericValues =
					recStatistics.numericValues as int

			int prdNumericValues =
					prdStatistics.numericValues as int

			if (recNumericValues == 0) {

				errors.append(
						'[ERROR] REC column does not contain numeric values.\n'
						)
						.append('Column: ')
						.append(resolvedColumnName)
						.append('\n')
			}

			if (prdNumericValues == 0) {

				errors.append(
						'[ERROR] PRD column does not contain numeric values.\n'
						)
						.append('Column: ')
						.append(resolvedColumnName)
						.append('\n')
			}

			if (
			recNumericValues == 0 ||
					prdNumericValues == 0
					) {

				result.errors =
						errors.toString().trim()

				result.passedDetails =
						passedDetails
						.toString()
						.trim()

				return result
			}

			BigDecimal recSum =
					round2(
					recStatistics.sum as BigDecimal
					)

			BigDecimal prdSum =
					round2(
					prdStatistics.sum as BigDecimal
					)

			BigDecimal recMinimum =
					round2(
					recStatistics.minimum as BigDecimal
					)

			BigDecimal prdMinimum =
					round2(
					prdStatistics.minimum as BigDecimal
					)

			BigDecimal recMaximum =
					round2(
					recStatistics.maximum as BigDecimal
					)

			BigDecimal prdMaximum =
					round2(
					prdStatistics.maximum as BigDecimal
					)

			result.recSum = recSum
			result.prdSum = prdSum

			result.recMinimum = recMinimum
			result.prdMinimum = prdMinimum

			result.recMaximum = recMaximum
			result.prdMaximum = prdMaximum

			appendComparisonResult(
					errors,
					passedDetails,
					'Column sum',
					resolvedColumnName,
					recSum,
					prdSum
					)

			appendComparisonResult(
					errors,
					passedDetails,
					'Minimum value',
					resolvedColumnName,
					recMinimum,
					prdMinimum
					)

			appendComparisonResult(
					errors,
					passedDetails,
					'Maximum value',
					resolvedColumnName,
					recMaximum,
					prdMaximum
					)

			result.success =
					errors.length() == 0

			result.errors =
					errors.toString().trim()

			result.passedDetails =
					passedDetails
					.toString()
					.trim()
		} catch (Exception e) {

			errors.append(
					'[ERROR] REC x PRD column statistics validation failed.\n'
					)
					.append('Exception: ')
					.append(
					e.getClass()
					.getSimpleName()
					)
					.append('\n')
					.append('Message: ')
					.append(
					safeText(e.getMessage())
					)

			result.success = false

			result.errors =
					errors.toString().trim()

			result.passedDetails =
					passedDetails
					.toString()
					.trim()
		} finally {

			closeWorkbook(workbookRec)
			closeWorkbook(workbookPrd)

			closeInput(inputRec)
			closeInput(inputPrd)
		}

		return result
	}


