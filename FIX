	@Keyword
	void openConfigurationModule(
		String menuName,
		String menuImageKey,
		String expectedFormObjectKey,
		Integer timeoutSeconds
	) {

		Integer timeout = safeTimeout(timeoutSeconds, 5)

		logStep(
			'CONFIGURATION MODULE',
			'Open configuration menu: ' + menuName
		)

		clickImage(
			GENERAL_IMAGE_GROUP,
			'settings',
			3
		)

		Windows.delay(1)

		WindowsTestObject searchBox =
			WindowsObjectLoader.getObject(
				'menu',
				'searchBox'
			)

		if (!Windows.waitForElementPresent(
			searchBox,
			timeout,
			FailureHandling.OPTIONAL
		)) {
			takeEvidence(
				'GUI_Configuration_SearchBoxNotFound.png'
			)

			KeywordUtil.markFailedAndStop(
				'Configuration search field was not found.'
			)

			return
		}

		Windows.click(
			searchBox,
			FailureHandling.STOP_ON_FAILURE
		)

		Windows.setText(
			searchBox,
			menuName,
			FailureHandling.STOP_ON_FAILURE
		)

		Windows.delay(1)

		clickImage(
			GUI_IMAGE_GROUP,
			menuImageKey,
			3
		)

		WindowsTestObject expectedForm = object(
			expectedFormObjectKey
		)

		if (!Windows.waitForElementPresent(
			expectedForm,
			timeout,
			FailureHandling.OPTIONAL
		)) {
			takeEvidence(
				'GUI_Configuration_FormNotOpened.png'
			)

			KeywordUtil.markFailedAndStop(
				'Configuration form was not opened.\n' +
				'Menu: ' + menuName + '\n' +
				'Expected object: ' +
				expectedFormObjectKey
			)

			return
		}

		takeEvidence(
			'GUI_Configuration_FormOpened.png'
		)

		KeywordUtil.markPassed(
			'Configuration form opened successfully: ' +
			menuName
		)
	}


