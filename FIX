		String resolvedSuiteName = resolveSuiteName(reportDir, suiteName)

		int failures = scenarios.count { safeValue(it.status) == 'failed' }
		int skipped = scenarios.count { safeValue(it.status) == 'skipped' }
		double totalSeconds = scenarios.collect { toLong(it.durationMs) }.sum(0L) / 1000d

		StringBuilder xml = new StringBuilder()
		xml.append('<?xml version="1.0" encoding="UTF-8"?>\n')
		xml.append('<testsuite')
		xml.append(' name="').append(escapeXml(resolvedSuiteName)).append('"')
		xml.append(' tests="').append(String.valueOf(scenarios.size())).append('"')
		xml.append(' failures="').append(String.valueOf(failures)).append('"')
		xml.append(' skipped="').append(String.valueOf(skipped)).append('"')
		xml.append(' time="').append(String.format(Locale.ENGLISH, '%.3f', totalSeconds)).append('">\n')

		scenarios.each { Map scenario ->
			double seconds = toLong(scenario.durationMs) / 1000d
			String testName = safeValue(scenario.title)

			xml.append('  <testcase')
			xml.append(' classname="').append(escapeXml(resolvedSuiteName)).append('"')
			xml.append(' name="').append(escapeXml(testName)).append('"')
			xml.append(' time="').append(String.format(Locale.ENGLISH, '%.3f', seconds)).append('">')

			if (safeValue(scenario.status) == 'failed') {
				xml.append('\n')
				xml.append('    <failure message="').append(escapeXml(safeValue(scenario.errorShort))).append('"><![CDATA[')
				xml.append(safeValue(scenario.errorFull).replace(']]>', ']]]]><![CDATA[>'))
				xml.append(']]></failure>\n')
				xml.append('  </testcase>\n')
			} else if (safeValue(scenario.status) == 'skipped') {
