                    <th class="steps-col-status">Status</th>
                    <th class="steps-col-time">Timestamp</th>
                    <th class="steps-col-detail">Details</th>
                </tr>
            </thead>
            <tbody>
                ${rowsHtml || '<tr><td colspan="3" class="no-data">No steps found.</td></tr>'}
            </tbody>
        </table>

        ${errorBlock}
        ${evidenceBlock}
    `;
}

function percent(value, total){
    if(!total){
        return 0;
    }
    return Math.round((value / total) * 100);
}

function renderChartsView(){
