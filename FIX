<script>
(function () {
    const tabs = Array.from(document.querySelectorAll('[data-sidebar-tab]'));
    const sidebarTests = document.getElementById('sidebar-tests');
    const sidebarCharts = document.getElementById('sidebar-charts');
    const searchBox = document.getElementById('scenarioSearch');
    const testLines = Array.from(document.querySelectorAll('.test-line'));
    const panels = Array.from(document.querySelectorAll('.detail-panel'));
    const noResults = document.getElementById('noResults');

    function openSidebarTab(name) {
        tabs.forEach(tab => {
            tab.classList.toggle('active', tab.getAttribute('data-sidebar-tab') === name);
        });

        sidebarTests.classList.toggle('active', name === 'tests');
        sidebarCharts.classList.toggle('active', name === 'charts');

        if (searchBox) {
            searchBox.style.display = name === 'tests' ? '' : 'none';
        }
    }

    function activateTest(targetId) {
        testLines.forEach(line => {
            line.classList.toggle('active', line.getAttribute('data-target') === targetId);
        });

        panels.forEach(panel => {
            panel.classList.toggle('active', panel.id === targetId);
        });
    }

    tabs.forEach(tab => {
        tab.addEventListener('click', function () {
            openSidebarTab(tab.getAttribute('data-sidebar-tab'));
        });
    });

    testLines.forEach(line => {
        line.addEventListener('click', function () {
            activateTest(line.getAttribute('data-target'));
        });
    });

    if (searchBox) {
        searchBox.addEventListener('input', function () {
            const term = (searchBox.value || '').trim().toLowerCase();
            let visibleCount = 0;
            let firstVisibleTarget = null;

            testLines.forEach(line => {
                const searchable = (line.getAttribute('data-search') || '').toLowerCase();
                const match = !term || searchable.indexOf(term) >= 0;

                line.style.display = match ? '' : 'none';

                if (match) {
                    visibleCount++;
                    if (!firstVisibleTarget) {
                        firstVisibleTarget = line.getAttribute('data-target');
                    }
                }
            });

            if (noResults) {
                noResults.style.display = visibleCount === 0 ? 'block' : 'none';
            }

            const activeLine = document.querySelector('.test-line.active');
            const activeHidden = activeLine && activeLine.style.display === 'none';

            if (activeHidden && firstVisibleTarget) {
                activateTest(firstVisibleTarget);
            }
        });
    }

    openSidebarTab('tests');

    if (testLines.length > 0) {
        activateTest(testLines[0].getAttribute('data-target'));
    }
})();
</script>
