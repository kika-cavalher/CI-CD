@Keyword
void attachToLoginWindow(String targetWindowTitle) {
	String expectedTitle = normalizeTitle(safe(detectedWindowTitle) ?: safe(targetWindowTitle))

	KeywordUtil.logInfo("Attaching to login window. Expected title ${expectedTitle}")

	ensureWinAppDriverRunning()

	Map<String, String> found = waitForWindow(expectedTitle, 45)
	if (!safe(found.title) || !safe(found.handle)) {
		KeywordUtil.markFailedAndStop("Could not find eMatch window with title ${expectedTitle}")
	}

	detectedWindowTitle = normalizeTitle(found.title)
	detectedWindowHandle = safe(found.handle)

	KeywordUtil.logInfo("Detected main window title ${detectedWindowTitle}")
	KeywordUtil.logInfo("Detected main window handle ${detectedWindowHandle}")

	waitForStableMainWindow(detectedWindowTitle, detectedWindowHandle, 6)

	attachExistingWindowByHandle(detectedWindowHandle)
	sleepMs(1500)

	detectedLoginDialogHandle = tryAttachLoginDialogChild()
}

private String tryAttachLoginDialogChild() {
	try {
		WebDriver rawDriver = DriverFactory.getWebDriver()

		List<String> xpaths = [
			"//*[@ClassName='#32770' and (@Name='Se connecter à eMatch' or contains(@Name,'eMatch'))]",
			"//*[@Name='Se connecter à eMatch']"
		]

		for (String xpath : xpaths) {
			def elements = rawDriver.findElements(By.xpath(xpath))
			if (elements != null && !elements.isEmpty()) {
				String handle = safe(elements[0].getAttribute('NativeWindowHandle'))

				if (handle) {
					KeywordUtil.logInfo("Detected login dialog handle ${handle}")
					attachExistingWindowByHandle(handle)
					sleepMs(1200)
					KeywordUtil.logInfo("Attached directly to login dialog")
					return handle
				}
			}
		}
	} catch (Throwable t) {
		KeywordUtil.logInfo("Login dialog child attach skipped: ${safe(t.message)}")
	}

	KeywordUtil.logInfo("Login dialog child handle not found. Keeping main window attachment.")
	return ''
}

private void reattachMainWindowAfterLogin() {
	if (!safe(detectedWindowHandle)) {
		return
	}

	KeywordUtil.logInfo("Reattaching to main eMatch window after login")
	attachExistingWindowByHandle(detectedWindowHandle)
	sleepMs(1500)
}
