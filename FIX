	private void attachEvidenceFromNativeHtml(File reportDir, List<Map> scenarios) {
		File nativeHtml = findNativeKatalonHtmlReport(reportDir)
		if (nativeHtml == null || !nativeHtml.exists()) {
			return
		}

		String html = readFileText(nativeHtml)
		if (isBlank(html)) {
			return
		}

		List<String> globalImages = extractAllImageSources(html)
		int sequentialIndex = 0

		scenarios.each { Map scenario ->
			if (safeValue(scenario.status) != 'failed') {
				return
			}

			Map found = findEvidenceForScenarioInHtml(html, scenario, reportDir)
			if (found != null) {
				scenario.evidence = [found]
				return
			}

			if (sequentialIndex < globalImages.size()) {
				Map sequential = buildEvidenceEntry(globalImages[sequentialIndex], reportDir, safeFileName(leafTitle(scenario.title)))
				if (sequential != null) {
					scenario.evidence = [sequential]
					sequentialIndex++
				}
			}
		}
	}

	private void attachEvidenceFromFiles(File reportDir, List<Map> scenarios) {
		List<File> imageFiles = []
		reportDir.eachFileRecurse { File file ->
			if (file != null && file.isFile() && isImageFile(file.name)) {
				imageFiles << file
			}
		}

		imageFiles.sort { File a, File b -> a.lastModified() <=> b.lastModified() }

		int index = 0
		scenarios.each { Map scenario ->
			if (safeValue(scenario.status) != 'failed') {
				return
			}

			List current = scenario.evidence instanceof List ? (scenario.evidence as List) : []
			if (!current.isEmpty()) {
				return
			}

			if (index >= imageFiles.size()) {
				return
			}

			File source = imageFiles[index]
			File bundled = ensureEvidenceInReportFolder(reportDir, source)
			String href = buildEvidenceHref(bundled, reportDir)
			String imgSrc = buildEvidencePreviewSrc(bundled)

			scenario.evidence = [[
				name : bundled.name,
				href : href,
				imgSrc: imgSrc,
				image: true
			]]

			index++
		}
	}

	private File findNativeKatalonHtmlReport(File reportDir) {
		if (reportDir == null || !reportDir.exists() || !reportDir.isDirectory()) {
			return null
		}

		String customName = safeValue(resolveReportFileName()).toLowerCase(Locale.ENGLISH)
		List<File> htmlFiles = []

		File[] files = reportDir.listFiles()
		if (files != null) {
			for (File file : files) {
				if (file != null && file.isFile()) {
					String lower = safeValue(file.name).toLowerCase(Locale.ENGLISH)
					if (lower.endsWith('.html') && lower != customName) {
						htmlFiles << file
					}
				}
			}
		}

		if (htmlFiles.isEmpty()) {
			return null
		}

		File preferred = htmlFiles.find { File file ->
			String lower = safeValue(file.name).toLowerCase(Locale.ENGLISH)
			return lower != customName && lower != 'index.html' && isTimestampHtml(lower)
		}

		if (preferred != null) {
			return preferred
		}

		htmlFiles.sort { File a, File b -> a.lastModified() <=> b.lastModified() }
		return htmlFiles.last()
	}

	private boolean isTimestampHtml(String lowerName) {
		return Pattern.matches('\\d{8,}_\\d+\\.html', safeValue(lowerName))
	}

	private String readFileText(File file) {
		try {
			return new String(Files.readAllBytes(file.toPath()), StandardCharsets.UTF_8)
		} catch (Exception ignored) {
			try {
				return file.getText('UTF-8')
			} catch (Exception ignoredAgain) {
				return ''
			}
		}
	}

	private List<String> extractAllImageSources(String html) {
		List<String> result = []

		Matcher imgMatcher = Pattern.compile('<img[^>]+src=["\\\']([^"\\\']+)["\\\']', Pattern.CASE_INSENSITIVE).matcher(html)
		while (imgMatcher.find()) {
			String src = safeValue(imgMatcher.group(1))
			if (!isBlank(src)) {
				result << src
			}
		}

		return result.unique()
	}

	private Map findEvidenceForScenarioInHtml(String html, Map scenario, File reportDir) {
		List<String> candidates = []
		candidates << safeValue(scenario.title)
		candidates << leafTitle(scenario.title)
		candidates = candidates.findAll { String value -> !isBlank(value) }.unique()

		for (String title : candidates) {
			Map found = findEvidenceAroundTitle(html, title, reportDir)
			if (found != null) {
				return found
			}
		}

		return null
	}

	private Map findEvidenceAroundTitle(String html, String title, File reportDir) {
		String lowerHtml = html.toLowerCase(Locale.ENGLISH)
		String lowerTitle = title.toLowerCase(Locale.ENGLISH)

		int startIndex = lowerHtml.indexOf(lowerTitle)
		if (startIndex < 0) {
			return null
		}

		int endIndex = Math.min(html.length(), startIndex + 120000)
		String snippet = html.substring(startIndex, endIndex)

		Matcher dataUriMatcher = Pattern.compile('(data:image/[a-zA-Z0-9.+-]+;base64,[A-Za-z0-9+/=\\r\\n]+)').matcher(snippet)
		if (dataUriMatcher.find()) {
			return buildEvidenceEntry(cleanDataUri(dataUriMatcher.group(1)), reportDir, safeFileName(title))
		}

		Matcher imgMatcher = Pattern.compile('<img[^>]+src=["\\\']([^"\\\']+)["\\\']', Pattern.CASE_INSENSITIVE).matcher(snippet)
		if (imgMatcher.find()) {
			return buildEvidenceEntry(safeValue(imgMatcher.group(1)), reportDir, safeFileName(title))
		}

		return null
	}

	private String cleanDataUri(String value) {
		return safeValue(value).replaceAll(/\s+/, '')
	}

	private Map buildEvidenceEntry(String src, File reportDir, String fallbackName) {
		if (isBlank(src)) {
			return null
		}

		if (src.startsWith('data:image')) {
			return [
				name : fallbackName + '.png',
				href : src,
				imgSrc: src,
				image: true
			]
		}

		File resolved = resolveRelativeFile(reportDir, src)
		if (resolved != null && resolved.exists()) {
			File bundled = ensureEvidenceInReportFolder(reportDir, resolved)
			String href = buildEvidenceHref(bundled, reportDir)
			String imgSrc = buildEvidencePreviewSrc(bundled)

			return [
				name : bundled.name,
				href : href,
				imgSrc: imgSrc,
				image: true
			]
		}

		return null
	}

	private File resolveRelativeFile(File reportDir, String path) {
		if (reportDir == null || isBlank(path)) {
			return null
		}

		String normalized = safeValue(path).replace('\\', '/')
		if (normalized.startsWith('http://') || normalized.startsWith('https://') || normalized.startsWith('data:')) {
			return null
		}

		File direct = new File(normalized)
		if (direct.exists()) {
			return direct
		}

		File byBase = new File(reportDir, normalized)
		if (byBase.exists()) {
			return byBase
		}

		return null
	}

	private File ensureEvidenceInReportFolder(File reportDir, File source) {
		if (source == null || !source.exists()) {
			return source
		}

		File evidenceDir = new File(reportDir, 'evidence')
		if (!evidenceDir.exists()) {
			evidenceDir.mkdirs()
		}

		File target = new File(evidenceDir, source.name)

		try {
			if (!target.exists() || target.length() != source.length()) {
				Files.copy(source.toPath(), target.toPath(), StandardCopyOption.REPLACE_EXISTING)
				target.setLastModified(source.lastModified())
			}
		} catch (Exception ignored) {
			return source
		}

		return target
	}

	private String buildEvidenceHref(File file, File reportDir) {
		if (file == null || !file.exists()) {
			return ''
		}

		try {
			String reportBase = reportDir.canonicalPath.replace('\\', '/') + '/'
			String filePath = file.canonicalPath.replace('\\', '/')

			if (filePath.startsWith(reportBase)) {
				return filePath.substring(reportBase.length())
			}
		} catch (Exception ignored) {
		}

		return file.toURI().toString()
	}

	private String buildEvidencePreviewSrc(File file) {
		if (file == null || !file.exists() || !isImageFile(file.name)) {
			return ''
		}

		try {
			byte[] content = Files.readAllBytes(file.toPath())
			String mime = resolveImageMime(file.name)
			return 'data:' + mime + ';base64,' + Base64.encoder.encodeToString(content)
		} catch (Exception ignored) {
			return file.toURI().toString()
		}
	}

	private String resolveImageMime(String fileName) {
		String lower = safeValue(fileName).toLowerCase(Locale.ENGLISH)

		if (lower.endsWith('.png')) return 'image/png'
		if (lower.endsWith('.jpg') || lower.endsWith('.jpeg')) return 'image/jpeg'
		if (lower.endsWith('.webp')) return 'image/webp'
		if (lower.endsWith('.gif')) return 'image/gif'
		if (lower.endsWith('.bmp')) return 'image/bmp'

		return 'image/png'
	}

	private boolean isImageFile(String fileName) {
		String lower = safeValue(fileName).toLowerCase(Locale.ENGLISH)
		return lower.endsWith('.png') ||
				lower.endsWith('.jpg') ||
				lower.endsWith('.jpeg') ||
				lower.endsWith('.webp') ||
				lower.endsWith('.gif') ||
				lower.endsWith('.bmp')
	}

	// ============================================================
	// TIMING
	// ============================================================

	private void normalizeScenarioTimings(File reportDir, List<Map> scenarios) {
		if (scenarios == null || scenarios.isEmpty()) {
			return
		}

		long totalDurationMs = 0L
		scenarios.each { Map scenario ->
			totalDurationMs += toLong(scenario.durationMs)
			scenario.durationLabel = formatDurationFull(toLong(scenario.durationMs))
		}

		Date suiteEnd = new Date(reportDir.lastModified())
		long cursor = suiteEnd.time - totalDurationMs

		scenarios.each { Map scenario ->
			long durationMs = toLong(scenario.durationMs)
			if (durationMs < 0L) {
				durationMs = 0L
			}

			if (isBlank(scenario.startLabel)) {
				scenario.startLabel = formatTimeOnly(new Date(cursor))
			}
			if (isBlank(scenario.endLabel)) {
				scenario.endLabel = formatTimeOnly(new Date(cursor + durationMs))
			}

			List<Map> steps = scenario.steps instanceof List ? (scenario.steps as List<Map>) : []
			long stepCursor = cursor
			steps.each { Map step ->
				step.timeLabel = isBlank(step.timeLabel) ? formatTimeOnly(new Date(stepCursor)) : safeValue(step.timeLabel)
				stepCursor += Math.max(1000L, toLong(step.durationMs))
			}

			cursor += durationMs
		}
	}

	private String formatDisplayDate(Date value) {
		return new SimpleDateFormat('MM.dd.yyyy hh:mm:ss a', Locale.ENGLISH).format(value)
	}

	private String formatTimeOnly(Date value) {
		return new SimpleDateFormat('HH:mm:ss', Locale.ENGLISH).format(value)
	}

	private long toMillisFromSeconds(String rawValue) {
		return toMillisFromCompactSeconds(rawValue)
	}

	private long toMillisFromCompactSeconds(String rawValue) {
		String raw = safeValue(rawValue).replace(',', '.').replace('s', '').trim()
		if (isBlank(raw)) {
			return 0L
		}

		try {
			double seconds = Double.parseDouble(raw)
			return Math.round(seconds * 1000d)
		} catch (Exception ignored) {
			return 0L
		}
	}

	private String formatDurationFull(long durationMs) {
		long totalSeconds = durationMs > 0L ? Math.round(durationMs / 1000d) : 0L
		long hours = (long) Math.floor(totalSeconds / 3600L)
		long minutes = (long) Math.floor((totalSeconds % 3600L) / 60L)
		long seconds = totalSeconds % 60L
		return String.format(Locale.ENGLISH, '%02dh %02dm %02ds', hours, minutes, seconds)
	}

	// ============================================================
	// ERROR / TEXT
	// ============================================================

	private String extractShortError(def source) {
		String text = safeValue(source)
		if (isBlank(text)) {
			return ''
		}

		List<String> lines = text.readLines().collect { safeValue(it) }.findAll { !isBlank(it) }
		if (lines.isEmpty()) {
			return ''
		}

		String preferred = lines.find { String line ->
			String lower = line.toLowerCase(Locale.ENGLISH)
			boolean match = false
			match = match || lower.contains('unable to ')
			match = match || lower.contains('element click intercepted')
			match = match || lower.contains('no such element')
			match = match || lower.contains('timeout')
			match = match || lower.contains('steperrorexception')
			match = match || lower.contains('stepfailedexception')
			return match
		}

		String value = safeValue(preferred ?: lines.first())
		value = value.replace('com.kms.katalon.core.exception.StepFailedException:', '').trim()

		int atIndex = value.indexOf(' at ')
		if (atIndex > 0) {
			value = value.substring(0, atIndex).trim()
		}

		if (value.length() > 220) {
			value = value.substring(0, 217) + '...'
		}

		return value
	}

	private String normalizeKey(String value) {
		return safeValue(value)
				.toLowerCase(Locale.ENGLISH)
				.replace('\\', '/')
				.replaceAll(/\s+/, '')
				.trim()
	}

	private String leafTitle(String value) {
		String text = safeValue(value).replace('\\', '/')
		if (text.contains('/')) {
			return text.substring(text.lastIndexOf('/') + 1)
		}
		return text
	}

	private String safeFileName(String value) {
		return safeValue(value).replaceAll(/[\\\\\\/:*?"<>|]/, '_')
	}

	private String stripHtmlTags(String value) {
		return safeValue(value)
				.replaceAll(/<br\s*\/?>/i, '\n')
				.replaceAll(/<[^>]+>/, ' ')
				.replace('&nbsp;', ' ')
				.replace('&amp;', '&')
				.replace('&lt;', '<')
				.replace('&gt;', '>')
				.replace('&quot;', '"')
				.trim()
	}

	private String resolveAssetUrl(File reportDir, String relativePath) {
		if (isBlank(relativePath)) {
			return ''
		}

		File projectRoot = findProjectRoot(reportDir)
		File asset = new File(projectRoot, relativePath)
		if (asset.exists()) {
			return asset.toURI().toString()
		}
		return ''
	}

	private File findProjectRoot(File reportDir) {
		File current = reportDir
		while (current != null) {
			if ('Reports'.equalsIgnoreCase(current.name)) {
				return current.parentFile != null ? current.parentFile : current
			}
			current = current.parentFile
		}
		return reportDir
	}
