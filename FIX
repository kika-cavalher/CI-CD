	private List<Map> parseStepsFromRawText(String rawText) {
		List<Map> result = []

		if (rawText.isEmpty()) {
			return result
		}

		rawText.readLines().each { String rawLine ->
			String line = safeValue(rawLine)
			if (line.isEmpty()) {
				return
			}

			def matcherA = (line =~ /^(\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{3})?)\\s+(PASSED|FAILED|ERROR|INFO|SKIPPED)\\s+(.*)$/)
			if (matcherA.find()) {
				String status = normalizeStatus(matcherA.group(2))
				String detail = safeValue(matcherA.group(3))

				result << [
					status   : status,
					timestamp: cleanClock(matcherA.group(1)),
					detail   : detail,
					icon     : resolveStepIcon(detail, status)
				]
				return
			}

			def matcherB = (line =~ /^(Given|When|Then|And)\\s+(.+?)(?:\\.{2,}|\\s+)(passed|failed|skipped)$/)
			if (matcherB.find()) {
				String detail = matcherB.group(1) + ' ' + matcherB.group(2)
				String status = normalizeStatus(matcherB.group(3))

				result << [
					status   : status,
					timestamp: '',
					detail   : detail,
					icon     : resolveStepIcon(detail, status)
				]
			}
		}

		return result
	}

