// ======================================================
// SELECT SUPPRIMER LE FAVORI
// ======================================================

boolean deleteFavoriteImageFound =
	isOptionalImageVisible(
		GUI_IMAGE_GROUP,
		'deleteFavoriteBtn'
	)

if (!deleteFavoriteImageFound) {
	takeEvidence(
		'GUI_DeleteFavoriteButtonNotFound.png'
	)

	KeywordUtil.markFailedAndStop(
		'Delete Favorite menu was not found.\n' +
		'Expected image: deleteFavoriteBtn\n' +
		'Expected text: Supprimer le favori'
	)

	return
}

KeywordUtil.logInfo(
	'[DELETE FAVORITE] Delete menu image was found.\n' +
	'Image key: deleteFavoriteBtn\n' +
	'Selecting the last menu option: Supprimer le favori.'
)

pressKeyboardKey(
	KeyEvent.VK_END
)

Windows.delay(1)

pressKeyboardKey(
	KeyEvent.VK_ENTER
)

KeywordUtil.logInfo(
	'[DELETE FAVORITE] Supprimer le favori was selected.'
)


// ======================================================
// VERIFY FAVORITE IS NO LONGER DISPLAYED
// ======================================================

Integer maximumDeleteChecks = 5
Integer waitPerDeleteCheckSeconds = 20

boolean favoriteDeleted = false

for (
	Integer deleteCheckAttempt = 1;
	deleteCheckAttempt <= maximumDeleteChecks;
	deleteCheckAttempt++
) {

	KeywordUtil.logInfo(
		'[DELETE FAVORITE] Waiting before checking the favorite image.\n' +
		'Favorite: ' + favoriteTitle + '\n' +
		'Image key: ' + favoriteImageKey + '\n' +
		'Attempt: ' +
			deleteCheckAttempt +
			'/' +
			maximumDeleteChecks + '\n' +
		'Wait time: ' +
			waitPerDeleteCheckSeconds +
			' seconds'
	)

	Windows.delay(
		waitPerDeleteCheckSeconds
	)

	boolean favoriteStillDisplayed =
		isOptionalImageVisible(
			GUI_IMAGE_GROUP,
			favoriteImageKey
		)

	if (!favoriteStillDisplayed) {
		favoriteDeleted = true

		KeywordUtil.logInfo(
			'[PASS] Favorite image is no longer displayed.\n' +
			'Favorite: ' + favoriteTitle + '\n' +
			'Attempt: ' +
				deleteCheckAttempt +
				'/' +
				maximumDeleteChecks
		)

		break
	}

	KeywordUtil.logInfo(
		'[DELETE FAVORITE] Favorite image is still displayed.\n' +
		'Favorite: ' + favoriteTitle
	)

	if (deleteCheckAttempt < maximumDeleteChecks) {
		KeywordUtil.logInfo(
			'[DELETE FAVORITE] The image will be checked again after 20 seconds.'
		)
	}
}

takeEvidence(
	'GUI_FavoriteAfterDelete.png'
)

if (!favoriteDeleted) {
	KeywordUtil.markFailedAndStop(
		'Favorite is still displayed after deletion.\n' +
		'Favorite: ' + favoriteTitle + '\n' +
		'Image key: ' + favoriteImageKey + '\n' +
		'Attempts: ' + maximumDeleteChecks + '\n' +
		'Wait per attempt: ' +
			waitPerDeleteCheckSeconds +
			' seconds'
	)

	return
}

KeywordUtil.markPassed(
	'Favorite deleted successfully.\n' +
	'Favorite: ' + favoriteTitle + '\n' +
	'Favorite image is no longer displayed.'
)
