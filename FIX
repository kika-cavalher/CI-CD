// ======================================================
// CREATE FAVORITE
// Only favoriteFilterField uses image recognition.
// ======================================================

@Keyword
void createFavoriteFromCurrentModule(
	String favoriteTitle,
	Integer controlTimeoutSeconds,
	Integer popupTimeoutSeconds
) {

	Integer controlTimeout = safeTimeout(
		controlTimeoutSeconds,
		5
	)

	Integer popupTimeout = safeTimeout(
		popupTimeoutSeconds,
		5
	)

	String normalizedFavoriteTitle = safeText(
		favoriteTitle
	)

	if (normalizedFavoriteTitle.isEmpty()) {
		KeywordUtil.markFailedAndStop(
			'Favorite title cannot be empty.'
		)

		return
	}

	logStep(
		'CREATE FAVORITE',
		'Favorite title: ' + normalizedFavoriteTitle
	)

	/*
	 * The formulaire filter updates the current module.
	 * Wait briefly before interacting with the top bar.
	 */
	Windows.delay(2)

	// ==================================================
	// CREATE FAVORITE BUTTON
	// ==================================================

	WindowsTestObject createFavoriteButton =
		object('createFavoriteTopBar')

	boolean createFavoritePresent =
		Windows.waitForElementPresent(
			createFavoriteButton,
			controlTimeout,
			FailureHandling.OPTIONAL
		)

	if (!createFavoritePresent) {
		takeEvidence(
			'GUI_CreateFavoriteButtonNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Create Favorite button was not found.'
		)

		return
	}

	boolean createFavoriteEnabled =
		Windows.waitForElementAttributeValue(
			createFavoriteButton,
			'IsEnabled',
			'True',
			controlTimeout,
			FailureHandling.OPTIONAL
		)

	if (!createFavoriteEnabled) {
		String enabledValue = safeText(
			Windows.getAttribute(
				createFavoriteButton,
				'IsEnabled',
				FailureHandling.OPTIONAL
			)
		)

		takeEvidence(
			'GUI_CreateFavoriteButtonDisabled.png'
		)

		KeywordUtil.markFailedAndStop(
			'Create Favorite button is disabled.\n' +
			'IsEnabled: ' + enabledValue
		)

		return
	}

	KeywordUtil.logInfo(
		'[CREATE FAVORITE] Clicking Create Favorite icon.'
	)

	/*
	 * In Katalon 10.4.2, offset 0,0 clicks the center
	 * of the Windows element.
	 */
	Windows.clickElementOffset(
		createFavoriteButton,
		0,
		0,
		FailureHandling.STOP_ON_FAILURE
	)

	Windows.delay(1)

	KeywordUtil.logInfo(
		'[CREATE FAVORITE] Create Favorite icon clicked.'
	)

	// ==================================================
	// FAVORITE TITLE
	// Only this field uses image recognition.
	// ==================================================

	typeOnImage(
		GUI_IMAGE_GROUP,
		'favoriteFilterField',
		normalizedFavoriteTitle,
		controlTimeout
	)

	Windows.delay(1)

	// ==================================================
	// SAVE FAVORITE BUTTON
	// ==================================================

	WindowsTestObject saveFavoriteButton =
		object('favoriteSaveTopBar')

	boolean saveFavoritePresent =
		Windows.waitForElementPresent(
			saveFavoriteButton,
			controlTimeout,
			FailureHandling.OPTIONAL
		)

	if (!saveFavoritePresent) {
		takeEvidence(
			'GUI_SaveFavoriteButtonNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Save Favorite button was not found.'
		)

		return
	}

	boolean saveFavoriteEnabled =
		Windows.waitForElementAttributeValue(
			saveFavoriteButton,
			'IsEnabled',
			'True',
			controlTimeout,
			FailureHandling.OPTIONAL
		)

	if (!saveFavoriteEnabled) {
		String enabledValue = safeText(
			Windows.getAttribute(
				saveFavoriteButton,
				'IsEnabled',
				FailureHandling.OPTIONAL
			)
		)

		takeEvidence(
			'GUI_SaveFavoriteButtonDisabled.png'
		)

		KeywordUtil.markFailedAndStop(
			'Save Favorite button is disabled after filling the title.\n' +
			'Favorite: ' + normalizedFavoriteTitle + '\n' +
			'IsEnabled: ' + enabledValue
		)

		return
	}

	KeywordUtil.logInfo(
		'[CREATE FAVORITE] Clicking Save Favorite button.'
	)

	Windows.clickElementOffset(
		saveFavoriteButton,
		0,
		0,
		FailureHandling.STOP_ON_FAILURE
	)

	// ==================================================
	// FAVORITE CONFIRMATION
	// ==================================================

	String modalDetection =
		waitForFavoriteConfirmation(
			normalizedFavoriteTitle,
			popupTimeout
		)

	if (modalDetection.isEmpty()) {
		takeEvidence(
			'GUI_FavoriteConfirmationModalNotFound.png'
		)

		KeywordUtil.markFailedAndStop(
			'Favorite confirmation modal was not found.\n' +
			'Favorite: ' + normalizedFavoriteTitle
		)

		return
	}

	takeEvidence(
		'GUI_FavoriteConfirmationModal.png'
	)

	Windows.delay(5)

	boolean confirmationClosed =
		clickFirstVisibleImage(
			GENERAL_IMAGE_GROUP,
			[
				'okModal',
				'okModal2Version'
			],
			3
		)

	if (!confirmationClosed) {
		pressKeyboardKey(
			KeyEvent.VK_ENTER
		)
	}

	Windows.delay(2)

	KeywordUtil.markPassed(
		'Favorite created successfully.\n' +
		'Title: ' + normalizedFavoriteTitle + '\n' +
		'Confirmation detected by: ' + modalDetection
	)
}
