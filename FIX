Este é o único helper groovy. Ele:

escreve run-context.properties
dispara a task scheduler
espera o marker existir
lê o exitcode e falha o build se precisar
package jenkinsIntegration

class EMatchDesktopRunner {

  static void run(def steps, Map cfg) {

    String suiteKey       = cfg.suiteKey as String
    String taskName       = cfg.taskName as String
    String projectPath    = cfg.projectPath as String
    String katalonExe     = cfg.katalonExe as String
    String collectionPath = cfg.collectionPath as String

    String workspace = steps.pwd()

    String markerFile = "${workspace}\\Reports\\_jenkins_task_exitcode_${suiteKey}.txt"
    String ctxFile    = "D:\\Projects\\eMatchStarters\\run-context.properties"

    steps.echo "[INFO] WORKSPACE=${workspace}"
    steps.echo "[INFO] suiteKey=${suiteKey}"
    steps.echo "[INFO] Task Scheduler=${taskName}"
    steps.echo "[INFO] markerFile=${markerFile}"
    steps.echo "[INFO] ctxFile=${ctxFile}"

    steps.bat """
      @echo off

      if exist "${markerFile}" del /f /q "${markerFile}" >nul 2>&1

      echo WORKSPACE=${workspace}>"${ctxFile}"
      echo PROJECT_PATH=${projectPath}>>"${ctxFile}"
      echo KATALON_EXE=${katalonExe}>>"${ctxFile}"
      echo COLLECTION_PATH=${collectionPath}>>"${ctxFile}"
      echo BROWSER_TYPE=Windows>>"${ctxFile}"
      echo MARKER_FILE=${markerFile}>>"${ctxFile}"

      type "${ctxFile}"
    """

    steps.bat """
      @echo off
      schtasks /run /tn "${taskName}"
      echo [INFO] Task triggered.
    """

    steps.timeout(time: 180, unit: 'MINUTES') {

      steps.waitUntil {
        steps.sleep 3
        return steps.fileExists(markerFile)
      }

      String markerText = ""
      int retries = 0

      while (retries < 5) {
        try {
          markerText = steps.readFile(markerFile).trim()
          if (markerText) break
        } catch (ignored) {
        }
        retries++
        steps.sleep 2
      }

      if (!markerText) {
        steps.error("[ERROR] Marker file exists but empty or unreadable: ${markerFile}")
      }

      def lines = markerText.readLines()
      int exitCode = 1
      String logFile = ""

      try {
        exitCode = Integer.parseInt(lines[0].trim())
      } catch (ignored) {
        exitCode = 1
      }

      if (lines.size() > 1) {
        logFile = lines[1].trim()
      }

      steps.echo "[INFO] Exit code read: ${exitCode}"
      if (logFile) steps.echo "[INFO] Katalon log file: ${logFile}"

      if (exitCode != 0) {
        steps.error("[ERROR] Katalon failed. ExitCode=${exitCode}")
      }
    }
  }
}
