def executeSuite(Map suite, int timeoutMinutes) {
    env.CURRENT_SUITE_NAME = suite.name

    catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE') {
        def exitCode = 999
        def consoleLog = "${env.LOGS_DIR}\\${suite.name}.log"

        try {
            echo '╔════════════════════════════════════════════════════════════╗'
            echo "║ 🧪 STARTING SUITE: ${suite.name}".padRight(60) + '║'
            echo "║ 📂 PATH: ${suite.path}".padRight(60) + '║'
            echo "║ ⏱️ TIMEOUT: ${timeoutMinutes} min".padRight(60) + '║'
            echo '╚════════════════════════════════════════════════════════════╝'

            timeout(time: timeoutMinutes, unit: 'MINUTES') {
                exitCode = runKatalonSuite(suite.name, suite.path, consoleLog)
            }
        } finally {
            collectLatestKatalonReport(suite.name)
            recordSuiteResult(suite.name, suite.path, exitCode, consoleLog)
            cleanupTimestampReportFolders()
            printExecutionSummary()
        }

        if (exitCode != 0) {
            def results = loadSuiteResults()
            def err = results[suite.name]?.error ?: ''

            echo '────────────────────────────────────────────────────────────'
            echo "❌ SUITE FAILED: ${suite.name}"
            echo "↪ Exit code: ${exitCode}"
            if (err?.trim()) {
                echo '📌 Error summary:'
                echo err
            } else {
                echo '📌 No extracted error lines found'
            }
            echo '────────────────────────────────────────────────────────────'

            error("Suite ${suite.name} failed with exit code ${exitCode}")
        } else {
            echo '────────────────────────────────────────────────────────────'
            echo "✅ SUITE PASSED: ${suite.name}"
            echo '────────────────────────────────────────────────────────────'
        }
    }
}

def runKatalonSuite(String suiteName, String suitePath, String consoleLog) {
    def exitCode = bat(
        returnStatus: true,
        script: """
            @echo off
            if exist "${consoleLog}" del /f /q "${consoleLog}" >nul 2>&1

            call "${env.KATALON_EXE}" ^
            -noSplash ^
            -runMode=console ^
            -consoleLog ^
            -projectPath="${env.PROJECT_PATH}" ^
            -retry=0 ^
            -testSuitePath="${suitePath}" ^
            -browserType="${env.BROWSER_TYPE}" ^
            -executionProfile="${env.EXEC_PROFILE}" ^
            -reportFolder="${env.REPORTS_DIR}" ^
            -reportFileName="${suiteName}" > "${consoleLog}" 2>&1

            exit /b %%ERRORLEVEL%%
        """
    )

    echo "🏁 Finished ${suiteName} with exit code ${exitCode}"
    return exitCode
}

def collectLatestKatalonReport(String suiteName) {
    powershell """
        \$reportsRoot = "${env.REPORTS_DIR}"
        \$suiteName = "${suiteName}"
        \$stableDir = Join-Path \$reportsRoot \$suiteName

        \$timestampFolders = Get-ChildItem -Path \$reportsRoot -Directory -ErrorAction SilentlyContinue |
            Where-Object { \$_.Name -match '^\\d{8}_\\d{6}\$' } |
            Sort-Object LastWriteTime -Descending

        if (-not \$timestampFolders) {
            Write-Host "No timestamp report folder found for suite \$suiteName"
            exit 0
        }

        \$latestFolder = \$timestampFolders[0]

        if (Test-Path \$stableDir) {
            Remove-Item -Path \$stableDir -Recurse -Force -ErrorAction SilentlyContinue
        }

        New-Item -ItemType Directory -Path \$stableDir -Force | Out-Null

        robocopy "\$([string]\$latestFolder.FullName)" "\$stableDir" /E /NFL /NDL /NJH /NJS /NC /NS | Out-Null

        if (\$LASTEXITCODE -gt 7) {
            Write-Host "WARNING: Robocopy failed while collecting report for suite \$suiteName"
            exit 0
        }

        Write-Host "Stable report ready for suite \$suiteName"
    """
}

def recordSuiteResult(String suiteName, String suitePath, int exitCode, String consoleLog) {
    def results = loadSuiteResults()
    def htmlFile = findMainHtmlReport("${env.REPORTS_DIR}\\${suiteName}")
    def junitFile = findFirstRelativeFile("${env.REPORTS_DIR}\\${suiteName}", 'JUnit_Report.xml')
    def errorText = extractImportantErrors(consoleLog, 18)

    results[suiteName] = [
        name    : suiteName,
        path    : suitePath,
        exitCode: exitCode,
        status  : exitCode == 0 ? 'PASSED' : 'FAILED',
        html    : htmlFile,
        junit   : junitFile,
        error   : errorText
    ]

    saveSuiteResults(results)
}

def updateSuiteResultAfterAbort(String suiteName) {
    def results = loadSuiteResults()
    def htmlFile = findMainHtmlReport("${env.REPORTS_DIR}\\${suiteName}")

    def existing = results[suiteName] instanceof Map ? results[suiteName] : [:]
    existing.putAll([
        name    : suiteName,
        status  : 'ABORTED',
        exitCode: 130,
        html    : htmlFile
    ])

    results[suiteName] = existing
    saveSuiteResults(results)
}

def loadSuiteResults() {
    if (!fileExists(env.RESULTS_JSON)) {
        return [:]
    }

    def txt = readFile(env.RESULTS_JSON).trim()
    if (!txt) {
        return [:]
    }

    return new JsonSlurperClassic().parseText(txt) as Map
}

def saveSuiteResults(Map results) {
    writeFile file: env.RESULTS_JSON, text: JsonOutput.prettyPrint(JsonOutput.toJson(results ?: [:]))
}

def findMainHtmlReport(String baseDir) {
    return powershell(
        returnStdout: true,
        script: """
            \$baseDir = "${baseDir}"
            if (-not (Test-Path \$baseDir)) {
                exit 0
            }

            \$preferred = Get-ChildItem -Path \$baseDir -Recurse -File -Include 'report.html','index.html' -ErrorAction SilentlyContinue |
                Select-Object -First 1

            if (-not \$preferred) {
                \$preferred = Get-ChildItem -Path \$baseDir -Recurse -File -Include *.html -ErrorAction SilentlyContinue |
                    Select-Object -First 1
            }

            if (\$preferred) {
                \$root = "${env.REPORTS_DIR}\\"
                \$full = [string]\$preferred.FullName
                if (\$full.StartsWith(\$root)) {
                    \$rel = \$full.Substring(\$root.Length)
                    Write-Output \$rel.Replace('\\\\','/')
                }
            }
        """
    ).trim()
}

def findFirstRelativeFile(String baseDir, String pattern) {
    return powershell(
        returnStdout: true,
        script: """
            \$baseDir = "${baseDir}"
            if (-not (Test-Path \$baseDir)) {
                exit 0
            }

            \$file = Get-ChildItem -Path \$baseDir -Recurse -File -Filter "${pattern}" -ErrorAction SilentlyContinue |
                Select-Object -First 1

            if (\$file) {
                \$root = "${env.REPORTS_DIR}\\"
                \$full = [string]\$file.FullName
                if (\$full.StartsWith(\$root)) {
                    \$rel = \$full.Substring(\$root.Length)
                    Write-Output \$rel.Replace('\\\\','/')
                }
            }
        """
    ).trim()
}

def extractImportantErrors(String consoleLog, int maxLines) {
    return powershell(
        returnStdout: true,
        script: """
            \$log = "${consoleLog}"
            if (-not (Test-Path \$log)) {
                exit 0
            }

            \$patterns = @(
                'ERROR',
                'FAILED',
                'StepFailedException',
                'AssertionError',
                'Caused by:',
                'not found',
                'timed out',
                'InvalidConsoleArgumentException',
                'Unable',
                'Exception'
            )

            \$matches = @()
            Get-Content \$log -ErrorAction SilentlyContinue | ForEach-Object {
                \$line = [string]\$_
                foreach (\$p in \$patterns) {
                    if (\$line -match \$p) {
                        \$matches += \$line.Trim()
                        break
                    }
                }
            }

            \$matches | Select-Object -Unique | Select-Object -First ${maxLines}
        """
    ).trim()
}

def printExecutionSummary() {
    def results = loadSuiteResults()
    def passed  = results.values().count { it.status == 'PASSED' }
    def failed  = results.values().count { it.status == 'FAILED' }
    def aborted = results.values().count { it.status == 'ABORTED' }
    def total   = results.size()

    echo '╔════════════════════════════════════════════════════════════╗'
    echo "║ 📊 EXECUTION SUMMARY".padRight(60) + '║'
    echo "║ ✅ Passed : ${passed}".padRight(60) + '║'
    echo "║ ❌ Failed : ${failed}".padRight(60) + '║'
    echo "║ 🛑 Aborted: ${aborted}".padRight(60) + '║'
    echo "║ 🧪 Executed: ${total}".padRight(60) + '║'
    echo '╠════════════════════════════════════════════════════════════╣'

    TEST_SUITES.each { suite ->
        if (results[suite.name]) {
            def r = results[suite.name]
            def line = "• ${r.name}  |  ${r.status}  |  exit ${r.exitCode}"
            echo line
        }
    }

    echo '╚════════════════════════════════════════════════════════════╝'
}

