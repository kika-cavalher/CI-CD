package jenkinsIntegration

class JenkinsDesktopPipelineRunner {

    static Map runDesktopViaTaskScheduler(def script, Map cfg, Map asset) {
        def logger = script.load('jenkinsIntegration/JenkinsDesktopTaskLogger.groovy')
        return logger.runAsset(script, cfg, asset)
    }

    static void archiveSafeArtifacts(def script) {
        try {
            script.archiveArtifacts(
                allowEmptyArchive: true,
                artifacts: 'Reports/**/*'
            )
        }
        catch (Exception ex) {
            script.echo "[WARN] archiveArtifacts failed but build will continue: ${ex.getMessage()}"
        }
    }
}
